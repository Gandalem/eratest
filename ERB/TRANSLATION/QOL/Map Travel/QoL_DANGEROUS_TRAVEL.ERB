; Modular ERB: QOL/Map Travel/QoL_DANGEROUS_TRAVEL.ERB

@QOL_CHECK_DANGEROUS_TRAVEL(TSP)
#DIM TSP
#DIM LUCK
#DIM ROLL
PRINTFORMDL 시간 절약을 위해 지하의 터널 중 일부를 가로지르는 지름길을 택한다.
LUCK = 300
LUCK += CFLAG:MASTER:今日の運勢
LUCK += TFLAG:幸運補正 * 100 ;daily fortune
LUCK += TFLAG:DangerousTravelBonus
SIF DAY:3 == 13 && YOUBI_MATCH(DAY, "金")
	LUCK -= 750
LUCK += LEVEL_TO_RANK(ABL:MASTER:教養) * 50
LUCK = MAX(LUCK, 1)
ROLL = RAND:LUCK
IF ROLL < (20 * MAX(TFLAG:DangerousTravelDisaster, 1)) ;very bad result, odds increase with a specific daily travel fortune
	CALL QOL_TRAVEL_MAJOR_ACCIDENT(TSP)
ELSEIF ROLL < 100 ;minor incident
	CALL QOL_TRAVEL_MINOR_ACCIDENT(TSP)
ENDIF

@QOL_TRAVEL_MINOR_ACCIDENT(TSP)
#DIM TSP
SELECTCASE RAND:5
	CASE 0
		PRINTFORMDL 당신은 지하의 좁고 어두운 복도를 지나가던 중 발가락을 바위에 부딪친다.
		CALL RECOVER(MASTER, -MAX(100, QOL_UNBUFFED_MAXBASE(BASE_体力) / 20), "体力", "Ow!")
		WAIT
	CASE 1
		PRINTFORMDL 지하의 희미하게 불이 켜진 터널을 가로지르던 당신은 무언가에 걸려 바닥으로 그대로 쓰러진다.
		CALL RECOVER(MASTER, -MAX(150, QOL_UNBUFFED_MAXBASE(BASE_体力) / 15), "体力", "Ow!")
		CALL RECOVER(MASTER, -MAX(150, QOL_UNBUFFED_MAXBASE(BASE_気力) / 15), "気力", "Ow!")
		IF TSP
			CALL RECOVER(MASTER, -30, "TSP", "Ow!")
		ELSE
			TIME += 10
		ENDIF
		WAIT
	CASE 2
		PRINTFORMDL 지하의 잘 알려지지 않은 터널들을 지나가던 중, 당신은 실수로 무언가를 떨어뜨린다.
		SELECTCASE RAND:3
			CASE 0
				CALL LOST_MONEY_YEN(2000, 2)
			CASE 1
				CALL LOST_MONEY_CM(20, 2)
			CASE 2
				IF TSP
					CALL RECOVER(MASTER, -45, "TSP", "어둠 속을 수색한다.")
				ELSE
					TIME += 15
				ENDIF
				PRINTFORMDW 꽤 중요하기 때문에 그것을 찾는 데 시간이 좀 걸린다.
		ENDSELECT
	CASE 3
		IF TSP
			CALL RECOVER(MASTER, -60, "TSP", "길을 잃었다")
		ELSE
			TIME += 20
		ENDIF
		PRINTFORMDW 동굴을 통과하는 동안 길을 잃었고, 탈출하기까지 시간이 걸렸다.
	CASE 4
		PRINTFORMDL 당신이 깊은 곳을 가로지르자 동굴 전체에 크고 울음소리 같은 메아리가 들린다.
		PRINTFORMDL 그것을 조사하고 싶습니까?
		CALL ASK_YN
		IF RESULT
			PRINTFORMDW 당신은 명백한 함정을 무시하고 목적지를 향해 곧장 간다.
		ELSE
			PRINTFORMDL 소리를 따라 그 근원지를 찾자, 에이텐이의 토끼 한 마리가 무릎을 꿇고 눈물을 흘리며 울고 있었다.
			PRINTFORMDL 그녀를 진정시키는 데 성공하자, %CALLNAME:72%가 요괴 산에 약을 전달하라고 자신에게 임무를 맡겼다고 설명했다.
			PRINTFORMDL 일정이 밀렸기 때문에 지름길로 지하를 통과하기로 했으나 결국 길을 잃었다.
			PRINTFORMDL 그녀가 안쓰러워져, 당신은 그녀를 도와 목적지까지 안내하기로 결정한다.
			PRINTFORMDL 표면에 도착하자, 토끼 소녀는 달아나기 전에 당신에게 따뜻한 포옹을 해준다.
			PRINTFORMDL 다시 자신의 목적지를 향해 나아가던 중, 토끼가 떠나기 전에 무언가를 당신의 주머니에 넣었음을 깨닫는다.
			SELECTCASE RAND:4
				CASE 0
					CALL GET_ITEM("栄養ドリンク", 1, 2)
				CASE 1
					CALL GET_ITEM("精力剤", 1, 2)
				CASE 2
					CALL GET_ITEM("ギンギンＺ", 1, 2)
				CASE 3
					CALL GET_ITEM("ギンギラギンＸ", 1, 2)
			ENDSELECT
			CALL CHANGE_CFLAG(4,[[永琳]],10)
			CALL CHANGE_CFLAG(4,[[輝夜]],10)
			CALL CHANGE_CFLAG(4,[[てゐ]],10)
			CALL CHANGE_CFLAG(4,[[鈴仙]],10)
			WAIT
			TIME += 20
		ENDIF
ENDSELECT

@QOL_TRAVEL_MAJOR_ACCIDENT(TSP)
#DIM TSP
SELECTCASE RAND:3
	CASE 0
		CALL QOL_TRAVEL_MEET_ONI(TSP)
	CASE 1
		IF TSP
			CALL RECOVER(MASTER, -540, "TSP", "길을 잃었다")
		ELSE
			TIME += 180
		ENDIF
		PRINTFORMDL 동굴을 탐험하던 중, 완전히 길을 잃고 만다.
		PRINTFORMDW 빠져나오기까지 엄청난 시간을 허비하게 된다.
	CASE 2
		PRINTFORML 동굴에서 뭔가 일어나고 있다.
		CALL COLORMESSAGE("!!! 동굴이다 !!!",C_RED,2,1)
		PRINTFORML 
		;NAS Teleporting ESP and physical damage
		CALL YoujutsuMagicCanDo(MASTER,6,0)
		IF RESULT
			PRINTFORMW 다행히 당신의 유쥬츠 능력으로 어떤 피해도 입기 전에 안전한 곳으로 순간 이동할 수 있었다.
		ELSE
			CALLF BroadDamage(MASTER,"fullbody",MAX(10000, MULTIPLY(QOL_UNBUFFED_MAXBASE(BASE_体力), 90)),6,MASTER,"cave in")
			CALL CrippleEffects(MASTER)
			IF !IsDead:MASTER:0
				PRINTFORMW 다섯 시간의 고된 후, 당신은 기어 나와 벗어나지만 고통이 엄청나다...
				TIME += 300
				CALL RECOVER(MASTER, -MAX(10000, MULTIPLY(QOL_UNBUFFED_MAXBASE(BASE_体力), 90)), "体力", "Ow!")
				CALL RECOVER(MASTER, -MAX(10000, MULTIPLY(QOL_UNBUFFED_MAXBASE(BASE_気力), 90)), "気力", "Ow!")
			ENDIF
		ENDIF
ENDSELECT

@QOL_TRAVEL_MEET_ONI(TSP)
#DIM TSP
#DIM DYNAMIC PROTECTORS = [[萃香]], [[勇儀]], [[さとり]]
#DIM DYNAMIC PROTECTORS_WEIGHTS, 3
#DIM CHARA
FOR LOCAL, 0, 3
CHARA = PROTECTORS:LOCAL
PROTECTORS_WEIGHTS:LOCAL += CBRT(CFLAG:CHARA:好感度)
SIF TALENT:CHARA:恋人
	PROTECTORS_WEIGHTS:LOCAL += 20
PROTECTORS_WEIGHTS:LOCAL += 5 * TALENT:CHARA:恋慕
PROTECTORS_WEIGHTS:LOCAL += 5 * TALENT:CHARA:愛欲
NEXT
CALL MAKE_YUKIZURI(FREE_MOB_SLOT(), "鬼", 1)
CFLAG:(FREE_MOB_SLOT(1)):デート中 = -1 ;bug fix, disable dating flag
IF TSP
	PRINTFORMDL 미로 같은 통로를 걸어가는 도중 균형을 잃고 땅바닥에 그대로 쓰러진다. 
	PRINTFORMDW 그 충격으로 정지된 시간을 제어할 수 없게 된다.
	SIF FLAG:70
		RESETBGCOLOR
	PRINTFORMDL 당신이 다시 일어서자, 갑자기 당신 앞에 서 있는 큰 체형을 알아차린다.
	CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「너 누구고, 어찌 여기에 왔지?」/「여긴 인간들이 있을 곳이 아니라고, 알겠나?」", 1
ELSE
	PRINTFORMDW 터널을 지나가면서, 당신은 갑자기 눈앞에 서 있는 크고 위압적인 체형을 발견한다.
	CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「인간이라니, 여기 있나?」/「길을 잃은 건가?」", 1
ENDIF
CALL SPTALK, FREE_MOB_SLOT(1), "笑顔", 1, @"「음, 네가 여기서 뭘 하든 난 별로 신경 안 쓰지만, 여긴 오니의 영역이야。」/「통과하고 싶다면 통행료를 내야 해, 친구.」", 1
WAIT
IF RAND:300 < MIN(SUMARRAY(PROTECTORS_WEIGHTS), 100)
	;friends in low places
	CHARA = PROTECTORS:ARRAY_HIT(PROTECTORS_WEIGHTS, 3)
	SELECTCASE CHARA
		CASE [[さとり]]
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「잠깐, 너 저 사토리 애의 반려동물 인간이야?」", 1
			CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「가라. 그녀랑 엮이고 싶지 않아.」", 1
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「그냥 가거라, 얘야. 아무것도 못 봤다.」", 1
			WAIT
			PRINTFORMDL 오니가 마음을 바꿀 때까지 기다리지 않고, 다시 시간을 멈추고 목적지를 향해 나아간다.
		CASEELSE
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「'old on, %CALLNAME:CHARA%의 친구냐?'」/「내가 그녀의 친구를 건드린다면 아마 엄청 화낼 거야.」/「오늘은 운 좋은 날이야. 지나가도 좋다.」", 1
			IF FLAG:70
				CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔", 1, @"「내가 심지어 너를 도와줄게. 어디에 있었니-」", 1
				CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「어이, 어디로 갔지?」", 1
				PRINTFORMDL 오니가 말을 끝내기도 전에, 당신은 다시 시간을 멈추고 목적지를 향해 나아간다.
			ELSE
				;get escorted out
				CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔", 1, @"「내가 심지어 도와줄게. 어디로 가고 있었어?」", 1
				PRINTFORMDL 오니가 당신을 터널로 이끌고, 그녀의 도움으로 예상보다 훨씬 빨리 목적지에 도착한다.
				TIME -= 10
			ENDIF
	ENDSELECT
	PRINTFORMDW 여기 아래에 친구들이 있는 것이 이득인 것 같다.
ELSE
	SELECTCASE RAND:5
		CASE 0
			;money
			LOCAL = QOL_GET_YEAR(DAY) * 10000 ;increases every year
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「술값이 좀 필요해서 말인데, {LOCAL}엔으로 통과시켜 주지.」", 1
			CALL ASK_YN("수락", "거절하다")
			IF RESULT
				CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「'강한 척하는군, 응? 오니의 공포를 좀 느끼게 해주고 네 시체에서 돈을 챙겨야겠어.'」", 1
				CALL QOL_TRAVEL_ONI_FIGHT(3)
			ELSE
				IF MONEY < LOCAL
					CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「너 그렇게 많이 가진 것도 없냐?」/「흥. 그거 나 열받게 하네.」/「아마 오니가 얼마나 무서운지 상기시켜 줄 필요가 있는 모양이군.」", 1
					CALL QOL_TRAVEL_ONI_FIGHT(2)
				ELSE
					CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔", 1, @"「이해해 주니 기쁘군. 이제 가거라.」", 1
					CALL LOST_MONEY_YEN(LOCAL, 2)
				ENDIF
			ENDIF
		CASE 1
			;charisma
			LOCAL = MIN(QOL_GET_YEAR(DAY) * 30, 2000) ;increases every year
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「도박이라도 해보고 싶으니까, 너에게 {LOCAL} 매력을 넘어가 줄게.」", 1
			CALL ASK_YN("수락한다", "거절한다")
			IF RESULT
				CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「'강한 척하는군, 응? 오니에 대한 공포를 좀 심어주고 네 시체에서 물건을 가져가야겠어.'」", 1
				CALL QOL_TRAVEL_ONI_FIGHT(3)
			ELSE
				IF MONEY:2 < LOCAL
					CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「너 그렇게 많이 가진 것도 없나?」/「흥. 그게 나를 화나게 해.」/「네가 얼마나 무서운 오니일 수 있는지 잘 상기시켜 줄 필요가 있는 것 같군.」", 1
					CALL QOL_TRAVEL_ONI_FIGHT(3)
				ELSE
					CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔", 1, @"「이해해 줘서 기쁘군. 이제 가보렴.」", 1
					CALL LOST_MONEY_CM(LOCAL, 2)
				ENDIF
			ENDIF
		CASE 2
			;booze
			LOCAL = QOL_GET_ITEMID_FROM_ALCOHOL_ID(QOL_GET_RANDOM_DRINK())
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「나 목말해서 그런데, 만약 %ITEMNAME_TR(LOCAL)%를 준다면 지나가게 해줄게.」", 1
			CALL ASK_YN("수락", "거절하다")
			IF RESULT
				$REFUSE_BOOZE
				CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「'강한 척하는군, 응? 오니의 공포를 좀 느끼게 해주고 네 시체에서 물건을 가져가야겠어.'」", 1
				CALL QOL_TRAVEL_ONI_FIGHT(4, LOCAL)
			ELSE
				IF ITEM:LOCAL >= 1
					$ACCEPT_BOOZE
					CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔", 1, @"「좋은 선택을 했어.」/「이걸로 할게.」", 1
					CALL LOST_ITEM(ITEMNAME:LOCAL, 1, 2)
				ELSE
					LOCAL:1 = LOCAL
					WHILE LOCAL:1 == LOCAL
					LOCAL:1 = QOL_GET_ITEMID_FROM_ALCOHOL_ID(QOL_GET_RANDOM_DRINK())
					WEND
					CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「그런 건 하나도 없나?」/「좋아 그럼. 대신 %ITEMNAME_TR(LOCAL:1)% 한 병을 갖겠어.」", 1
					CALL ASK_YN("수락한다", "거절하다")
					IF RESULT
						LOCAL = LOCAL:1
						GOTO REFUSE_BOOZE
					ELSE
						IF ITEM:(LOCAL:1) >= 1
							LOCAL = LOCAL:1
							GOTO ACCEPT_BOOZE
						ELSE
							LOCAL:2 = LOCAL:1
							WHILE LOCAL:2 == LOCAL:1 || LOCAL:2 == LOCAL
							LOCAL:2 = QOL_GET_ITEMID_FROM_ALCOHOL_ID(QOL_GET_RANDOM_DRINK())
							WEND
							CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「너도 그런 거 없어?」/「좋아. 대신 %ITEMNAME_TR(LOCAL:2)%(으)로 만족할게.」", 1
							CALL ASK_YN("수락한다", "거절하다")
							IF RESULT
								LOCAL = LOCAL:2
								GOTO REFUSE_BOOZE
							ELSE
								IF ITEM:(LOCAL:2) >= 1
									LOCAL = LOCAL:2
									GOTO ACCEPT_BOOZE
								ELSE
									CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「너 그런 거조차 없다고?」/「흥. 이 오니들에게 좀 가르쳐줘야겠군, 어때!」", 1
									CALL QOL_TRAVEL_ONI_FIGHT(4, 52)
								ENDIF
							ENDIF
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		CASE 3
			;sex
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「오랜만에 해본 게 아니야, 그리고 그 배트하우스가 마지막 싸움 후에 아직도 나를 들여보내지 않아.」/「네가 내 갈증을 풀어주면, 내가 너를 보내줄게.」", 1
			CALL ASK_YN("수락한다", "거절한다")
			IF RESULT
				CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「네가 나한테 너무 잘난 줄 아나 보지? 그냥 때려 부수고 내가 원하는 걸 강제로 빼앗을 거야.」", 1
				CALL QOL_TRAVEL_ONI_FIGHT(1)
			ELSE
				;accept
				CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔", 1, @"「기쁘군. 자, 시작하자.」", 1
				CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「아, 나를 그냥 %CALLNAME:(FREE_MOB_SLOT(1))%라고 불러도 돼.」", 1
				PRINTFORMDL 오니가 당신을 터널 중 하나에 있는 작지만 대체로 평평한 지역으로 안내한다.
				PRINTFORMDW %CALLNAME:(FREE_MOB_SLOT(1))%는 재빨리 옷을 벗고 땅에 앉는다.
				CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔:裸", 1, @"「자, 자, 벌써 시작하자!」", 1
				SELECTCASE RAND:1
					CASE 0
						PRINTFORMDL %CALLNAME:(FREE_MOB_SLOT(1))%은 다리를 벌리고 당신에게 자신의 %SLIT((FREE_MOB_SLOT(1)))%을 보여준다.
						CALL SPTALK, (FREE_MOB_SLOT(1)), "通常:裸", 1, @"「뭐 기다려? 네 혀를 움직여 봐.」", 1
						PRINTFORMDW 오니의 재촉에, 너는 그녀를 먹기 시작한다.
						CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔:裸", 1, @"「%MOAN()%... 응, 딱 내가 필요했던 거야.」", 1
						PRINTFORMDL %CALLNAME:(FREE_MOB_SLOT(1))%은 계속 그녀를 즐기면서 동굴 시스템 전체에 크게 신음한다.
						IF ABL:MASTER:舌 > 3
							CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔:裸", 1, @"「%MOAN("m")%… 너 '이것' 정말 잘하는구나。」/「아가씨들이 사랑할 수밖에 없지.」", 1
						ELSE
							CALL SPTALK, (FREE_MOB_SLOT(1)), "通常:裸", 1, @"「자, 힘내봐.」/「너 이 정도는 할 수 있다는 거 알아.」", 1
							CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔:裸", 1, @"「%MOAN("m")%… '이게 더 나아. 계속 이렇게 가.'」", 1
						ENDIF
						WAIT
						CALL SPTALK, (FREE_MOB_SLOT(1)), "通常:裸", 1, @"「나도 기분 좋게 해 줄게.」/「내가 혼자만 재미있으면 불공평하잖아, 안 그래?」", 1
						WAIT
						PRINTFORMDL %CALLNAME:(FREE_MOB_SLOT(1))%은 갑자기 당신의 허리를 잡고 뒤집어 공중에 다리를 넣는다.
						IF HAS_PENIS(MASTER)
							CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔:裸", 1, @"「이미 착하네.」/「\@ TALENT:MASTER:形状 >= 3 ? 모양도 정말 좋네. # 아주 귀여운 작은 것이네. \@」", 1
							PRINTFORMDW 오니는 당신의 %TINKO()%을 입에 넣고 믿을 수 없는 힘으로 빨기 시작한다.
						ELSE
							CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔:裸", 1, @"「벌써 그렇게 젖었어.」/「너 좀 맛보게 해줘.」", 1
							PRINTFORMDW 오니는 당신의 %SLIT(MASTER)%를 핥기 시작한다. 그녀가 이 일에 꽤 경험이 많다는 것이 분명하다.
						ENDIF
						PRINTFORMDL 당신과 %CALLNAME:(FREE_MOB_SLOT(1))%은 서로의 은밀한 부위를 문지르고 핥으며 계속해서 서로에게 즐거움을 준다.
						IF HAS_PENIS(MASTER)
							PRINTFORMDL 오니의 숙련된 빨아들이는 행위가 당신을 한계까지 몰고 가고, 그녀는 당신의 %SEMEN(MASTER, 1)%를 간절히 삼킨다.
							PRINTFORMDW 이것 또한 그녀를 선을 넘게 만들었고, 그녀는 강력하게 당신의 얼굴 위로 %FSYN("squirt:s")%한다.
							CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔:裸", 1, @"「%MOAN("r",,3)%.」", 1
						ELSE
							PRINTFORMDL 오니는 곧 한계에 도달하고 %FSYN("squirt:s")% 당 얼굴 전체에
							CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔:裸", 1, @"「%MOAN("r",,3)%.」", 1
							PRINTFORMDL 하지만 그녀는 여전히 멈추지 않고, 그녀의 계속되는 손길은 당신을 동시에 절정에 이르게 한다.
						ENDIF
						PRINTFORMDW 당신이 끝낸 후, 두 사람은 절정에 대한 회복을 하며 거친 숨을 몰아쉬며 서로에게 누워 있었다. 
				ENDSELECT
				PRINTL
				PRINTFORMDL 당신의 교환이 끝났다. 당신과 %CALLNAME:(FREE_MOB_SLOT(1))%은 서로 놓아주고 옷을 다시 입었다.
				CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔", 1, @"「너랑 정말 즐거운 시간 보냈어。」 / 「나가는 길 조심해. 너처럼 멋진 %PRINT_MALE("guy_:gal", MASTER)%을 잃는 건 후회할 거야.」", 1
				PRINTFORMDL 만족했다, 그 오니는 마침내 너를 놓아준다.
				TIME += 30
			ENDIF
		CASE 4
			;fight
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「나 여기서 좀 지루해졌는데, 우리 가볍게 시합이라 할까?」", 1
			CALL ASK_YN("수락한다", "거절한다")
			IF RESULT
				CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「미안하지만 '그건 질문이 아니었어.' / '너는 어떻게든 나를 즐겁게 해줘야 할 거야.'」", 1
			ELSE
				CALL SPTALK, (FREE_MOB_SLOT(1)), "笑顔", 1, @"「들어서 기쁘군。」/「시작해 볼까, 친구야.」", 1
			ENDIF
			CALL QOL_TRAVEL_ONI_FIGHT(0)
	ENDSELECT
	SIF TSP
		PRINTFORMDL 오니가 마침내 사라진 후, 당신은 다시 시간을 멈추고 원래 목적지를 향해 계속 나아간다.
ENDIF
IF FLAG:70
	SETBGCOLOR C_THE_WORLD
ENDIF
CALL Add_HideMob()

@QOL_TRAVEL_ONI_FIGHT(DESIRED_REWARD, DESIRED_TYPE)
#DIM モブ残機
#DIM DESIRED_REWARD
#DIM DESIRED_TYPE
TARGET = (FREE_MOB_SLOT(1))
TIME += 60
CFLAG:面識 = 1
HANDICAP_FIXED = RAND:(ABL:戦闘能力 * 8 + 1) + 10
HANDICAP_RAND = ABL:戦闘能力 * 50
CALL KOJO_MESSAGE_SEND("DANMAKU", 0, TARGET, 1, -1, "戦闘前")
DRAWLINE
PRINTFORML 
;PRINTFORMW Game Start!!!
CALL KNIFE_FIGHT(MASTER, TARGET, 1, 1) ;replace with eraNAS battle
モブ残機 = !(lcWarResult == CurrentBattle:Battle_PlayerSide); a result over 0 is LOSE for this so we need to invert this
; モブ残機 = RESULT
; CALL RECOVER(MASTER, -500, "体力")
; CALL RECOVER(MASTER, -500, "気力")
CALL KOJO_MESSAGE_SEND("DANMAKU", モブ残機, TARGET, 1, -1, "戦闘後")
SIF モブ残機 < 3
	EXP:MASTER:戦闘経験 += ABL:戦闘能力 * 3
SIF モブ残機 < 1
	EXP:MASTER:戦闘経験 += ABL:戦闘能力
IF モブ残機 > 0
	Qol_Info_Count_Array:MASTER:Qol_Count_EncountLost++
	SELECTCASE DESIRED_REWARD
		CASE 0
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「아마 내가 좀 오버했나 봐.」/「뭐 어때. 그게 문제지.」", 1
			PRINTFORMDW 즐거워하며, 그 오니는 아무렇지 않게 걸어 나가 당신이 상처를 돌보도록 내버려 두었다.
		CASE 1
			PRINTFORMDW 더 이상 움직일 수 없게 된 %조사처리(CALLNAME:TARGET,"가")% 너를 제압한다.
			PRINTFORMDW 방어할 힘도 없는 네 목덜미에 따뜻하고 거의 김 나는 듯한 한숨이 내려오는 것을 느낀다...
			CALL Add_LOST_GYAKURE_EX(TARGET, 0)
			SIF RESULT
				GOTO GYAKURE_END
			PRINTFORMDW 막 끝났다고 생각했을 때, 매우 뜨거운 무언가가 당신의 가랑이를 감싸는 것을 느낀다.
			PRINTFORMDW 조심스럽게 아래를 내려다보니, %CALLNAME:TARGET%이 만족스러운 미소를 짓고 있다. 네 %FSYN("penis")%는 그녀의 %FSYN("vagina",,TARGET)% %FSYN("base")% 깊숙이 단단히 박혀 있다.
			PRINTFORMDW 
			PRINTFORMD %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 몸을 가치 있는 모든 것으로 여겨 난폭하게 탐하고 고통스럽게 하며 범함으로써 그녀의 야만적인 갈증을 해소한다...
			CALL PRINT_BREAK,,"wait"
			CALL TRIPLEDOT("reverse:timed")
			PRINTFORMDW %BREAKENG(@"%조사처리(CALLNAME:TARGET,"가")% 완전한 만족감으로 영원처럼 느껴지는 동안 당신을 유린한 후, 당신은 지하 세계를 벗어나 목적지에 가까운 곳에 있음을 알게 된다.")%
			$GYAKURE_END
			TIME += 60
			FLAG:気絶中断 = 100 + CFLAG:MASTER:現在位置 / 100
			CFLAG:MASTER:デート中 = CFLAG:MASTER:現在位置 / 100
			CALL LOST_GYAKURE(TARGET)
		CASE 2
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「졌으니 보상이나 받으러 가야겠다.」", 1
			CALL LOST_MONEY_YEN(QOL_GET_YEAR(DAY) * 50000, 2) ;increases every year
		CASE 3
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「졌군, 그럼 이제 보상을 받겠다.」", 1
			CALL LOST_MONEY_CM(QOL_GET_YEAR(DAY) * 150, 2) ;increases every year
		CASE 4
			CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「졌네, 그럼 이제 내 보상을 받겠어.」", 1
			IF !ITEM:DESIRED_TYPE
				CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「마실 만한 거 하나도 없어?」/「정말 한심하구나, %PRINT_MALE("guy_:gal", MASTER)%。」/「당장 여기서 꺼져!」", 1
			ELSE
				CALL LOST_ITEM(ITEMNAME:DESIRED_TYPE, ITEM:DESIRED_TYPE, 2)
			ENDIF
	ENDSELECT
	RETURN 1
ELSE
	;NAS: dead or unconscious challenger, should not talk.
	SIF !SHIRAHU(FREE_MOB_SLOT(1))
		RETURN
	IF DESIRED_REWARD == 0
		CALL SPTALK, (FREE_MOB_SLOT(1)), "通常", 1, @"「꽤 강하구나. 너 우리 오니들과 잘 어울 거야.」/「만약 파티를 찾고 있다면, 아래의 '언더그라운드'로 내려가 봐야 해.」", 1
		PRINTFORMDW 패배에도 불구하고 그 오니는 다시 일어서며 얼굴에 커다란 미소를 짓는다.
	ELSE
		CALL SPTALK, (FREE_MOB_SLOT(1)), "怒り", 1, @"「크윽. 네가 생각했던 것보다 강하군。」/「나 이제 갈게.」", 1
		PRINTFORMDW 그 오니는 지하에 여기저기 널려 있는 수많은 터널 중 하나를 통해 빠르게 탈출한다.
	ENDIF
ENDIF
