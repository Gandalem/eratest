; Modular ERB: QOL/QoL_COMF418 家庭菜園.ERB
;NOTE
;The original function this _TR variant was based on has been changed.
;This _TR variant will be disabled until the changes have been reflected.
;-------------------------------------------------
;家庭菜園
;日常系コマンド、レベル1
;custom qol
;-------------------------------------------------

@COM418_TR
#DIM DYNAMIC nTimeInit ;for time taken calculation during your work in the garden
#DIM DYNAMIC nTimeTaken
#DIM DYNAMIC nWitheredCount ;amount of withered plants
#DIM DYNAMIC nDryCount ;amount of dry plants for water all
#DIM DYNAMIC nSprinkle ;check whether sprinkler is available or not
#DIM DYNAMIC nHarvest ;amount of ripe plants for harvest all
;NAS: Gray out gardening command if no gardening tools
IF !ITEM:150
	PRINTFORML 당신은 원예를 할 데 필요한 장비가 없다.
	PRINTFORMW 먼저 인간 마을에서 【%ITEMNAME_TR(150)%】을/를 얻어라.
	RETURN 0
ENDIF
nSprinkle = ITEM:簡易プール && GETBIT (FLAG:プール, 2)
DRAWLINE
gLineCount = LINECOUNT
nTimeInit = TIME
REDRAW 0
;main menu
DO
SIF LINECOUNT - gLineCount > 0
	CLEARLINE LINECOUNT - gLineCount
nTimeTaken = TIME - nTimeInit
;reset flags
nWitheredCount = 0
nHarvest = 0
nDryCount = 0
SIF FLAG:水やり代行
	CALL COLORMESSAGE("물주기 대행 서비스",C_YELLOW,1,1)
SIF FLAG:天滴坤神
	CALL COLORMESSAGE("지상의 신의 축복",C_YELLOW,1,1)
CALL COLORMESSAGE(@"비료: x{ITEM:こやし}",C_YELLOW,1,1)
SIF nTimeTaken
	PRINTFORML 소요 시간: {nTimeTaken}
PRINTFORML
LOCAL:1 = Qol_GETUNELENGTH418() ;set the garden plot size
FOR LOCAL,0, LOCAL:1
CALL SHOW_PLANT_TR(LOCAL)
PRINTFORML
SIF PLANT_WITHERED(LOCAL)
	nWitheredCount ++
SIF PLANT_DRY:LOCAL > 0
	nDryCount ++
SIF PLANT_GROW:LOCAL == 10
	nHarvest ++
NEXT
DRAWLINE
IF !FLAG:70
	SIF nWitheredCount
		PRINTFORML [9996] 시든 것 제거
	SIF nHarvest
		PRINTFORML [9997] 모든 것 수확하기 (익은 것만)
	SIF (nSprinkle || VAR_WATER != "") && nDryCount
		PRINTFORML [9998] 전체 물 \@ nSprinkle ? %" "%으로 #  \@
ENDIF
PRINTFORML [9999] \@ nTimeTaken ? 적용한다 # 취소한다 \@
INPUT
IF FLAG:70
	;don't allow to operate the garden during time stop
	RETURN 0
ELSE
	IF INRANGE(RESULT / 100, 0, LOCAL:1)
		CALL FARMING_TR(RESULT / 100, RESULT % 100)
	ELSEIF RESULT == 9996 && nWitheredCount
		FOR LOCAL, 0, LOCAL:1
		SIF PLANT_WITHERED(LOCAL)
			CALL PLANT_REMOVE(LOCAL)
		NEXT
	ELSEIF RESULT == 9997 && nHarvest
		FOR LOCAL, 0, LOCAL:1
		SIF PLANT_GROW:LOCAL == 10
			CALL PLANT_HARVEST(LOCAL)
		NEXT
	ELSEIF RESULT == 9998 && (nSprinkle || VAR_WATER != "") && nDryCount
		FOR LOCAL, 0, LOCAL:1
		SIF PLANT_DRY:LOCAL > 0 && !PLANT_WITHERED(LOCAL)
			CALL PLANT_WATER(LOCAL, nSprinkle ? "sprinkler" # "")
		NEXT
	ELSE
		CALLF Add_Apply_Fairy_Title_Bonus("gardening") ;don't apply any buffs, but do trigger a chance to show the message
		RETURN nTimeTaken ? 1 # -1
	ENDIF
ENDIF
SIF MESSKIP()
	FORCEWAIT
LOOP 1
;processing controls

@FARMING_TR(ARG, 行動番号)
#DIM 行動番号
LOCALS '= PLANT_TR(HATAKE_NAME:ARG)
IF 行動番号 == 0
	IF PLANT_TYPE:ARG > 0
		PRINTFORMW %PLURALIZER(LOCALS, 2)%가 이미 심겼다.
	ELSE
		PRINTL 무엇을 심을지 선택해라. 
		CALL INPLANT_TR(ARG)
		SIF RESULT
			TIME += 10
	ENDIF
ELSEIF 行動番号 == 1
	CALL PLANT_WATER(ARG)
ELSEIF 行動番号 == 2
	CALL PLANT_HARVEST(ARG)
ELSEIF 行動番号 == 3
	IF PLANT_DRY:ARG <= 4 && PLANT_GROW:ARG <= 10
		IF 収穫可能(ARG)
			PRINTFORML 대신 %LOCALS%를 수확하시겠습니까? 
			CALL ASK_YN
			IF !RESULT
				CALL PLANT_HARVEST(ARG)
				RETURN 1
			ENDIF
		ENDIF
		PRINTFORML 정말로 %LOCALS%를 제거하고 싶나요?
		CALL ASK_YN
		SIF RESULT
			RETURN 0
	ENDIF
	CALL PLANT_REMOVE(ARG)
	;畑が拡張されたら全体にします
ELSEIF 行動番号 == 4 && ITEM:簡易プール && GETBIT (FLAG:プール, 2)
	CALL PLANT_WATER(ARG, "sprinkler")
ELSEIF 行動番号 == 5 && ITEM:こやし
	CALL PLANT_FERTILIZE(ARG)
ELSE
	RETURN 0
ENDIF

@INPLANT_TR(ARG)
#DIM 苗番号開始
#DIM 苗番号終了
CALL QoL_Function_GardenOverhaul_Extra("veggies")
FOR LOCAL, 0, VARSIZE("ITEM") ;qol custom code
;苗以外をを除外
SIF ITEM:LOCAL && NAS_IS_SEED(LOCAL)
	PRINTFORMLC 　[{LOCAL}] %ITEMNAME_TR(LOCAL), 21, LEFT%× {ITEM:(LOCAL), 2, RIGHT}
NEXT
PRINTL
DRAWLINE
PRINTL [999] 리턴
$INPUT_LOOP
INPUT
IF ITEM:RESULT && NAS_IS_SEED(RESULT)
	PRINTFORMW %ITEMNAME_TR(RESULT)%가 필드 번호{ARG}에 심어졌다!
	ITEM:RESULT -= 1
	PLANT_TYPE:ARG = RESULT
	PLANT_DRY:ARG = 1
	;三粒の天滴を持っている場合、植えてすぐに施肥、水撒き完了状態に
	IF ITEM:三粒の天滴
		PLANT_DRY:ARG = 0
		PLANT_FOOD:ARG = 1
		FLAG:天滴坤神 = 1
	ENDIF
	HATAKE_NAME:ARG = %ITEMNAME_TR(NAS_HARVEST_GET(PLANT_TYPE:ARG))%
	RETURN 1
ELSE
	RETURN 0
ENDIF

@SHOW_PLANT_TR(ARG)
PRINTFORM 필드 번호{ARG}:
IF PLANT_TYPE:ARG > 0
	SETCOLOR 0x00FF00
	PRINTFORM %PLURALIZER(PLANT_TR(HATAKE_NAME:ARG), 2)%들이 자라고 있다. 
	IF PLANT_WITHERED(ARG)
		SETCOLOR 0x994C00
		PRINT 시든
	ELSE
		SELECTCASE PLANT_GROW:ARG
			CASE 10
				SETCOLOR 0xFF0000
				PRINT (익은)
			CASE 8,9
				SETCOLOR 0xFF8000
				PRINT (과일)
			CASE 6,7
				SETCOLOR 0xFFFF00
				PRINT (꽃)
			CASE 4,5
				PRINT (잎)
			CASEELSE
				PRINT (모종)
		ENDSELECT
	ENDIF
	IF !PLANT_DRY:ARG
		SETCOLOR C_AQUA
		PRINT 　물을 주었다.
	ENDIF
	IF PLANT_FOOD:ARG
		SETCOLOR C_CREAM
		IF ITEM:三粒の天滴
			PRINT 　대지의 신의 축복을 받는다
		ELSE
			PRINT 　비료 처리됨
		ENDIF
	ENDIF
	RESETCOLOR
	;show extra info if you're not dum dum
	SIF ABL:MASTER:教養 >= 3
		CALL QoL_Function_GardenOverhaul_Extra("info", ARG)
	PRINTL
	;時間停止中は菜園の状態を見るだけ
	SIF FLAG:70 == 1
		RETURN
	;水撒き
	IF PLANT_DRY:ARG
		LOCAL = ARG * 100 + 1
		LOCALS '= @"[%TOSTR(LOCAL, "000")%] - 물 주기"
		PRINTBUTTONLC LOCALS, LOCAL
	ELSE
		PRINTLC 　
	ENDIF
	;収穫
	IF 収穫可能(ARG)
		LOCAL = ARG * 100 + 2
		LOCALS '= @"[%TOSTR(LOCAL, "000")%] - 수확"
		SIF PLANT_GROW:ARG == 10
			SETCOLOR 0xFF0000
		PRINTBUTTONLC LOCALS, LOCAL
		RESETCOLOR
	ELSE
		PRINTLC 　
	ENDIF
	;整地
	LOCAL = ARG * 100 + 3
	LOCALS '= @"[%TOSTR(LOCAL, "000")%] - 제거"
	PRINTBUTTONLC LOCALS, ARG * 100 + 03
	;スプリンクラー
	IF ITEM:簡易プール && GETBIT (FLAG:プール, 2) && PLANT_DRY:ARG
		LOCAL = ARG * 100 + 4
		LOCALS '= @"[%TOSTR(LOCAL, "000")%] - 스프링클러 사용"
		PRINTBUTTONLC LOCALS, LOCAL
	ELSE
		PRINTLC 　
	ENDIF
	;肥料を撒く
	IF ITEM:こやし && PLANT_FOOD:ARG == 0
		LOCAL = ARG * 100 + 5
		LOCALS '= @"[%TOSTR(LOCAL, "000")%] - 비료 뿌리기"
		PRINTBUTTONLC LOCALS, LOCAL
	ELSE
		PRINTLC 　
	ENDIF
ELSE
	PRINTL 비어 있음
	;時間停止中は菜園の状態を見るだけ
	SIF FLAG:70 == 1
		RETURN
	;苗植え
	LOCAL = ARG * 100 + 0
	LOCALS '= @"[%TOSTR(LOCAL, "000")%] - 모종 심기"
	PRINTBUTTONLC LOCALS, LOCAL
ENDIF
PRINTL

@PLANT_HARVEST(ARG)
#DIM DYNAMIC COMPOST
;八百屋で購入できるようになったため収穫条件の厳格化
IF 収穫可能(ARG) == 0
	PRINTW 아직 수확할 수 없다.
	RETURN 0
ENDIF
SIF PLANT_DAYS:ARG > 9
	PLANT_GROW:ARG += 2
SIF PLANT_FOOD:ARG
	PLANT_GROW:ARG ++
SIF FLAG:天滴坤神 && RAND:2
	PLANT_GROW:ARG += 2
;大豊作…天滴とこやし補正でないと到達不能
IF PLANT_GROW:ARG > 12
	PRINTFORML 풍성한 수확이다!
	IF PLANT_FOOD:ARG
		LOCAL = 20 + RAND:6 + RAND:4
	ELSE
		LOCAL = 20
	ENDIF
	LOCAL:1 = 1 + RAND:3 + RAND:2 + RAND:2
	LOCAL += Add_Apply_Fairy_Title_Bonus("harvesting20")
ELSEIF PLANT_GROW:ARG > 10
	PRINTFORML 풍성한 수확이다.
	IF PLANT_FOOD:ARG
		LOCAL = 14 + RAND:4 + RAND:3
	ELSE
		LOCAL = 14
	ENDIF
	LOCAL:1 = RAND:2 + RAND:2 + RAND:2
	LOCAL += Add_Apply_Fairy_Title_Bonus("harvesting14")
ELSEIF PLANT_GROW:ARG > 7
	IF PLANT_FOOD:ARG
		LOCAL = 7 + RAND:3 + RAND:2
	ELSE
		LOCAL = 7
	ENDIF
	LOCAL:1 = RAND:2
	LOCAL += Add_Apply_Fairy_Title_Bonus("harvesting7")
ELSE
	LOCAL = 5
	LOCAL:1 = 0
	LOCAL += Add_Apply_Fairy_Title_Bonus("harvesting5")
ENDIF
IF TCVAR:MASTER:豊穣
	LOCAL += LOCAL / 5
	LOCAL:1 += LOCAL:1 / 8
ENDIF
;ローター一強を崩すため収穫量ダウン
IF NAS_HARVEST_GET(PLANT_TYPE:ARG) == 0
	LOCAL /= 2
	LOCAL:1 = 0
ENDIF
LOCAL:1 = LIMIT(LOCAL:1, 0, 所持数制限 - ITEM:(NAS_HARVEST_GET(PLANT_TYPE:ARG)))
PRINTFORMW %PRINT_PLUR(PLANT_TR(HATAKE_NAME:ARG), LOCAL)%을/를 수확했다.
ITEM:(NAS_HARVEST_GET(PLANT_TYPE:ARG)) += LOCAL
;manage overflow
IF ITEM:(苗対応作物番号取得(PLANT_TYPE:ARG)) > 所持数制限
	COMPOST = MAX((ITEM:(苗対応作物番号取得(PLANT_TYPE:ARG)) - 所持数制限) / 3, 1)
	ITEM:(苗対応作物番号取得(PLANT_TYPE:ARG)) = 所持数制限
	IF PLANT_TYPE:ARG == GETNUM(ITEM, "ローターの苗")
		PRINTFORMDL 당신은 더 이상 %PLNOUN(HATAKE_NAME:ARG, 2)%를 들 수 없으므로 나머지를 버린다.
	ELSE
		PRINTFORMDL 당신은 더 이상 %PLNOUN(HATAKE_NAME:ARG, 2)%을 휴대할 수 없습니다.
		IF ITEM:こやし + COMPOST > 所持数制限
			IF ITEM:こやし >= 所持数制限
				PRINTFORMD 퇴비 더미가 이미 가득 차서 남은 %PLNOUN(HATAKE_NAME:ARG, 2)%는 
			ELSE
				COMPOST = 所持数制限 - ITEM:こやし
				ITEM:こやし = MAX(ITEM:こやし, 所持数制限)
				PRINTFORMDL 당신은 남는 것들을 퇴비 더미에 버리고 {COMPOST} 비료를 얻는다.
				PRINTFORMD 퇴비 더미가 넘치자 나머지 %PLNOUN(HATAKE_NAME:ARG, 2)%는 
			ENDIF
			PRINTDATAL
				DATAFORM 마을에 준다.
				DATAFORM 버린다.
				DATAFORM 새들을 위해 밖에 둔다.
				DATAFORM 이웃에게 준다.
				DATAFORM 배고픈 요정들의 개선을 위해 사회로 보낸다.
				DATAFORM 썩도록 내버려 둔다.
				DATAFORM 토끼들에게 보낸다.
				DATAFORM 폐기한다.
				DATAFORM 유유코에게 보낸다.
				DATAFORM 유우마에게 보낸다.
				DATAFORM 지옥에 던져진다.
				DATAFORM 제물로 사용된다.
			ENDDATA
		ELSE
			PRINTFORMDL 당신은 남는 것들을 퇴비 더미에 버리고 {COMPOST} 비료를 얻는다.
			ITEM:こやし += COMPOST
		ENDIF
	ENDIF
	WAIT
ENDIF
;qol addition, recover some usable seeds from good harvests
IF LOCAL:1
	PRINTFORMW 씨앗 {LOCAL:1}개를 회수했다!
	ITEM:(PLANT_TYPE:ARG) += LOCAL:1
ENDIF
PLANT_TYPE:ARG = 0
PLANT_DAYS:ARG = 0
PLANT_GROW:ARG = 0
PLANT_DRY:ARG = 0
HATAKE_NAME:ARG =
PLANT_FOOD:ARG = 0
TIME += 20

@PLANT_WATER(ARG, ARGS)
IF PLANT_WITHERED(ARG)
	PRINTFORMW 식물은 이미 시들어 버렸다...
ELSEIF !PLANT_DRY:ARG
	PRINTFORMW 오늘 하루는 그걸로 충분할 것이다.
ELSEIF ARGS != "sprinkler" && VAR_WATER == "" ;!TFLAG:水汲み
	PRINTFORMW 먼저 물을 좀 길러야 한다.
ELSE
	PLANT_DRY:ARG = 0
	PRINTFORMW %PLURALIZER(PLANT_TR(HATAKE_NAME:ARG), 2)%가 물을 받았다.
	SIF ITEM:三粒の天滴
		FLAG:天滴坤神 = 1
	TIME += 5
ENDIF

@PLANT_FERTILIZE(ARG)
IF 収穫可能(ARG)
	PRINTFORMW 식물이 너무 늙었다!
ELSEIF PLANT_WITHERED(ARG)
	PRINTFORMW 식물은 이미 시들었다...
ELSEIF PLANT_FOOD:ARG
	PRINTFORMW 비료를 너무 많이 사용하지 마라.
ELSE
	PLANT_FOOD:ARG = 1
	PRINTFORMW %PLURALIZER(PLANT_TR(HATAKE_NAME:ARG), 2)%들이 비료를 받았다.
	TIME += 20
	ITEM:こやし --
ENDIF

@PLANT_REMOVE(ARG)
PRINTFORMW %PLURALIZER(PLANT_TR(HATAKE_NAME:ARG), 2)%가 제거되었다.
PLANT_TYPE:ARG = 0
PLANT_DAYS:ARG = 0
PLANT_GROW:ARG = 0
PLANT_DRY:ARG = 0
HATAKE_NAME:ARG =
PLANT_FOOD:ARG = 0
TIME += 10

@PLANT_COUNT(ARGS)
#FUNCTION
LOCAL = 0
FOR LOCAL,0, Qol_GETUNELENGTH418()
SELECTCASE ARGS
	CASE "withered"
		SIF PLANT_WITHERED(LOCAL)
			LOCAL ++
	CASE "ripe"
		SIF PLANT_GROW:LOCAL == 10
			LOCAL ++
	CASE "harvest"
		SIF PLANT_GROW:LOCAL > 7
			LOCAL ++
	CASE "dry"
		SIF PLANT_DRY:LOCAL > 0
			LOCAL ++
	CASE "growing"
		SIF HATAKE_NAME:LOCAL != "" && PLANT_TYPE:LOCAL > 0
			LOCAL ++
ENDSELECT
NEXT
RETURNF LOCAL

@PLANT_WITHERED(ARG)
#FUNCTION
RETURNF (PLANT_DRY:ARG > 4 || PLANT_GROW:ARG > 10)

@QoL_Function_GardenOverhaul_Extra(ARGS, ARG)
SELECTCASE ARGS
	CASE "info"
		PRINTFORM 　재배: {PLANT_DAYS:ARG}일, 건조: {PLANT_DRY:ARG}
	CASE "reactions"
	CASE "ripewarn"
		LOCAL:1 = 0
		FOR LOCAL,0, Qol_GETUNELENGTH418()
		SIF PLANT_GROW:LOCAL == 10 && (++LOCAL:1)
			CALL COLORMESSAGE(@"%PLURALIZER(PLANT_TR(HATAKE_NAME:LOCAL), 2)%들이 수확할 준비가 되었다!",C_GREEN,2,1)
		NEXT
		SIF LOCAL:1
			CALL COLORMESSAGE("상하지 전에 오늘 꼭 수확해라!",C_GREEN,2,1)
	CASE "veggies"
		DRAWLINE
		PRINTFORML 보유 채소:
		CALL LIST_ITEM("野菜")
		CALL LIST_ITEM("ローター")
		DRAWLINE
ENDSELECT

@EVENTTRAIN
#LATER
CALL QoL_Function_GardenOverhaul_Extra("ripewarn")

@UNWITHER()
#FUNCTION
FOR LOCAL, 0, Qol_GETUNELENGTH418()
IF PLANT_WITHERED(LOCAL)
	PLANT_DRY:LOCAL = 0
	PLANT_GROW:LOCAL = 10
ENDIF
NEXT

@Qol_FieldList
FOR LOCAL,0, Qol_GETUNELENGTH418()
SIF PLANT_TYPE:LOCAL <= 0
	CONTINUE
SIF PLANT_WITHERED(LOCAL)
	SETCOLOR C_L_GRAY
SIF PLANT_GROW:LOCAL == 10
	SETCOLOR C_GREEN
PRINTFORM %PLANT_TR(HATAKE_NAME:LOCAL)% 식물 
IF PLANT_WITHERED(LOCAL)
	PRINTL 시들었다.
	RESETCOLOR
ELSE
	SELECTCASE PLANT_GROW:LOCAL
		CASE 10
			IF GROUPMATCH(HATAKE_NAME:LOCAL, "ローター", "Rotor")
				PRINT 익어서 건강하게 진동하는 소리가 들린다.
			ELSE
				PRINT 익었고 수확할 준비가 되었다.
			ENDIF
		CASE 8,9
			PRINT 열매를 맺기 시작했다.
		CASE 6,7
			PRINT 꽃들이 피고 있다.
		CASE 4,5
			PRINT 잎이 자라기 시작했다.
		CASEELSE
			PRINT 모종들이 싹을 틔운다
	ENDSELECT
	PRINT .
	RESETCOLOR
	IF PLANT_DRY:LOCAL == 2
		PRINT  토양이 마르고 있다.
	ELSEIF PLANT_DRY:LOCAL == 0
		SETCOLOR C_AQUA
		PRINT  토양은 축축하다.
		RESETCOLOR
	ENDIF
	IF PLANT_FOOD:LOCAL
		SETCOLOR C_CREAM
		IF FLAG:天滴坤神
			PRINT  토양은 대지의 신의 축복을 받고 있다.
		ELSE
			PRINT  토양이 비옥해졌다.
		ENDIF
		RESETCOLOR
	ENDIF
	PRINTL
ENDIF
NEXT
TFLAG:描写中の子供 = 0

@Qol_GETUNELENGTH418()
#FUNCTION
#DIM 畝サイズ
; IF TALENT:MASTER:採集Lv > 5
; 	畝サイズ = 1 + 4
; ELSEIF TALENT:MASTER:採集Lv > 4
; 	畝サイズ = 1 + 3
; ELSEIF TALENT:MASTER:採集Lv > 2
; 	畝サイズ = 1 + 2
; ELSEIF TALENT:MASTER:採集Lv > 0
; 	畝サイズ = 1 + 1
; ELSE
; 	畝サイズ = 1
; ENDIF
畝サイズ = 1 + LEVEL_TO_RANK(TALENT:MASTER:採集Lv); nas: replaced
RETURNF 畝サイズ + nGardenPlots
