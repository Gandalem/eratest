@QoL_Stall(ARGS, CHARA, NAS_SALES:1, ARG)
#DIM REF CHARA
SELECTCASE ARGS
	CASE "SetUp"
		;Group date stuff, prioritize target date instead of lastest date invite
		IF MOREDATE
			IF IS_IN_GROUP_DATE(TARGET)
				CHARA = TARGET
			ENDIF
		ELSEIF FLAG:デート相手 != MASTER
			CHARA = FLAG:デート相手
		ELSEIF TARGET && ABL:TARGET:親密 >= 10 && SHIRAHU(TARGET) && CFLAG:TARGET:行動 != 5
			CHARA = TARGET
		ELSE
			CHARA = 0
		ENDIF
		;商人パワー設定
		NAS_SALES:2 = LEVEL_TO_RANK(ABL:MASTER:話術技能) * 10 + LEVEL_TO_RANK(ABL:MASTER:教養) * 5 + TFLAG:幸運補正 * 10
		SIF CHARA != MASTER
			NAS_SALES:3 = LEVEL_TO_RANK(ABL:CHARA:話術技能) * 10 + LEVEL_TO_RANK(ABL:CHARA:教養) * 5
		;参加者で最もパワーが高いものを基準に、1/2したもう１人のパワーを足す
		IF NAS_SALES:2 >= NAS_SALES:3
			NAS_SALES:1 = NAS_SALES:2 + (NAS_SALES:3 / 2)
		ELSE
			NAS_SALES:1 = NAS_SALES:3 + (NAS_SALES:2 / 2)
		ENDIF
		SIF SaveAchievementClaimed("sell10M")
			NAS_SALES:1 += 25
		IF FLAG:デート相手 != MASTER
			PRINTFORML 데이트 중일 때, %CALLNAME:(FLAG:デート相手)%은(는) 조수로서 당신을 도와주기로 결정한다!
		ELSEIF TARGET != MASTER
			PRINTFORML \@ CHARA != MASTER ? %조사처리(CALLNAME:TARGET,"는")%(는) 노점 설치를 도와줄 생각이 없는 것 같다... # %조사처리(CALLNAME:TARGET,"는")%(는) 조수로 당신을 돕기로 결정한다! \@
		ENDIF
		PRINTFORML 흥정력: {NAS_SALES:1}\%
		SELECTCASE NAS_SALES:1
			CASE 0 TO 99
				PRINTFORML 하지만 당신은 흥정 기술에 대해 별로 자신 없어 보인다.
			CASE 100 TO 199
				PRINTFORML 당신의 흥정 기술은 충분히 적절한 것 같군.
			CASE 200 TO 299
				PRINTFORML 당신은 흥정 기술로 누구에게든 무엇이든 팔 수 있을 만큼 자신감이 넘친다!
			CASEELSE
				PRINTFORML 당신의 능숙한 흥정 기술이라면, 거의 사기를 치는 것만 같군요...
		ENDSELECT
	CASE "Place"
		IF ABL:MASTER:教養 + (CHARA > 0 ? ABL:CHARA:教養 # 0) >= UniversalRank("B")
			SELECTCASE STALL_SHOPPER(STALL_SPOT(CFLAG:MASTER:現在位置))
				CASE IS <= 0
					LOCALS = dreadful
				CASE 1 TO 5
					LOCALS = poor
				CASE 6 TO 10
					LOCALS = fairly average
				CASE 11 TO 20
					LOCALS = rather promising
				CASE 21 TO 30
					LOCALS = quite prosperous
				CASEELSE
					LOCALS = very favorable
			ENDSELECT
			PRINTFORM 사업은 ~인 것 같다. 
			CALL COLORMESSAGE(LOCALS,C_YELLOW)
			PRINTFORML  이 장소에서 지금...
		ENDIF
	CASE "Estimate"
		SIF ABL:MASTER:話術技能 + ABL:MASTER:教養 <= 4
			RETURN 0
		PRINTFORM 당신의 개인적인 기술 덕분에 추정할 수 있습니다. 
		SIF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 4
			CALL COLORMESSAGE("수익성 있는 ",C_AQUA)
		SIF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 6
			CALL COLORMESSAGE("가난한 ",C_YELLOW)
		SIF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 9
			CALL COLORMESSAGE("매우 수익성이 좋다 ",C_GREEN)
		SIF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 15
			CALL COLORMESSAGE("매우 수익성이 높다 ",C_P_PURPLE)
		SIF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 19; QU speech and knowledge
			CALL COLORMESSAGE("엄청나게 수익성이 좋고 정확한 값들을 ",C_PINK)
		PRINTFORML 아이템!
	CASE "Guess"
		RESETCOLOR
		;SELECTCASE GETPERCENT(STALL_PRICE_SET(商人パワー, ARG, 1, 2), ITEMPRICE:ARG) ;the problem is that a lot of low costing items still don't sell for much even with best modifiers
		SELECTCASE STALL_PRICE_SET(NAS_SALES:1, ARG, 1, 2)
			CASE IS >= 1000000
				SIF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 19
					SETCOLOR C_PINK
			CASE IS >= 100000
				SIF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 15
					SETCOLOR C_P_PURPLE
			CASE IS >= 10000
				SIF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 9
					SETCOLOR C_GREEN
			CASE IS >= 5000
				SIF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 4
					SETCOLOR C_AQUA
			CASE IS < 1000
				SIF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 6
					SETCOLOR C_YELLOW
		ENDSELECT
ENDSELECT

@Qol_GiftReview(nScore, nCost)
#FUNCTIONS
#DIM nScore
#DIM nCost
#DIM nRankReq = 3, 4, 5, 6, 7, 8 ;knowledge req for most accurate approximate
#DIM nRankTier = 10000, 50000, 100000, 500000, 1000000 ;cost for determining the rank
#DIM DYNAMIC nRank
#DIM nApproximate
RESULT = 0
SIF nHideGiftScores
	RETURNF
SIF ABL:MASTER:教養 < 3
	RETURNF
SIF ABL:親密 < 5
	RETURNF
;find out rank
SELECTCASE nCost
	CASE IS <= nRankTier:0 ;0~10k
		nRank = 0
	CASE IS <= nRankTier:1 ;10k~50k
		nRank = 1
	CASE IS <= nRankTier:2 ;50k~100k
		nRank = 2
	CASE IS <= nRankTier:3 ;100k~500k
		nRank = 3
	CASE IS <= nRankTier:4 ;500k~1m
		nRank = 4
	CASEELSE
		nRank = 5
ENDSELECT
SELECTCASE ABL:MASTER:教養 - nRankReq:nRank
	CASE IS >= 0 ;closest approximate when meeting the req or exceeding it
		nApproximate = nScore + RAND:10 - RAND:10
	CASE -1
		nApproximate = nScore + RAND:100 - RAND:100
	CASE -2
		nApproximate = nScore + RAND:200 - RAND:200
	CASEELSE
		;can't see if the difference is too high
		nApproximate = 0
		RETURNF
ENDSELECT
RESULT = nApproximate
;RETURNF @"　　～{nApproximate}pts (Real Score {nScore} Rank {nRank} Identify {ABL:MASTER:教養 - nRankReq:nRank})"
RETURNF @"　　～{nApproximate}pts"

