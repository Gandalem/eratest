			CASE GET_MAP_REPLACEMENT(P855虹龍洞)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[百々世]])
		ENDSELECT
	CASE "logging"
		SELECTCASE LOCATION
			CASE GET_MAP_REPLACEMENT(P25鎮守の森)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[霊夢]])
			CASE GET_MAP_REPLACEMENT(P433斜角の竹林)
