	CALL PRINT_GIFTDATA(GIFT_GOT:CHARA:LOCAL, CHARA, "キャラの")
NEXT
IF START_INDEX2 >= 0
	FOR LOCAL, START_INDEX2, END_INDEX2
	SIF GIFT_GOT:CHARA:LOCAL && GIFT_GOT:CHARA:LOCAL != CFLAG:CHARA:貰った贈り物
		CALL PRINT_GIFTDATA(GIFT_GOT:CHARA:LOCAL, CHARA, "キャラの")
	NEXT
ENDIF
