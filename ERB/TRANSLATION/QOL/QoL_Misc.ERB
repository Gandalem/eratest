#DIM nSkill
#DIM nSkillLv
#DIM nXp
#DIM nChara
IF nSkillLv < MaxNonHLevel
	PRINTFORML
	CALLF Qol_XpProgressToNextLevel(nSkill, nSkillLv, nXp, nChara)
	CALL PRINTLEVELBAR(RESULT:0, RESULT:1, nSkillLv, nSkillLv+1)
ENDIF
;returnvalues
;RESULT:0 = xp into current level
;RESULT:1 = xp difference between current level and next level
;RESULT:2 = xp required total

@Qol_XpProgressToNextLevel(nSkill, nSkillLv, nXp, nChara)
#FUNCTION
#DIM nSkill
#DIM nSkillLv
#DIM nXp
#DIM nEffective
#DIM nChara
nEffective = MAX(nSkillLv + 3 - TALENT:nChara:50,1)
SELECTCASE nSkill
	CASE GETNUM(EXP, "学習経験"), GETNUM(EXP, "戦闘経験"), GETNUM(EXP, "料理経験"), GETNUM(EXP, "伐採経験"), GETNUM(EXP, "釣り経験"), GETNUM(EXP, "採集経験"), GETNUM(EXP, "調合経験"), 96, 97, 98, 66, 66600 TO 66663
		IF nSkillLv == 0
			RESULT = nXp, 6, 6
		ELSEIF nSkillLv == 1
			RESULT = nXp - 6, EXPLV:(nEffective) - 6, EXPLV:(nEffective)
		ELSE
			RESULT = nXp - EXPLV:(nEffective - 1), EXPLV:(nEffective) - EXPLV:(nEffective - 1), EXPLV:(nEffective)
		ENDIF
	CASE GETNUM(EXP, "会話経験"), GETNUM(EXP, "清掃経験")
		IF nSkillLv == 0
			RESULT = nXp, EXPLV:(nEffective), EXPLV:(nEffective)
		ELSE
			RESULT = nXp - EXPLV:(nEffective - 1), EXPLV:(nEffective) - EXPLV:(nEffective - 1), EXPLV:(nEffective)
		ENDIF
	CASE GETNUM(EXP, "演奏経験"), GETNUM(EXP, "歌唱経験"), GETNUM(EXP, "舞踏経験")
		IF nSkillLv == 0
			RESULT = nXp, 21, 21
		ELSEIF nSkillLv == 1
			RESULT = nXp - 21, (EXPLV:(nEffective) * 2) - 21, (EXPLV:(nEffective) * 2)
		ELSE
			RESULT = nXp - (EXPLV:(nEffective - 1) * 2), (EXPLV:(nEffective) * 2) - (EXPLV:(nEffective - 1) * 2), (EXPLV:(nEffective) * 2)
		ENDIF
	CASEELSE
		; [AUTO-NEUTRALIZED] THROW @Qol_XpProgressToNextLevel: No case defined for {nSkill}
ENDSELECT
;DEBUGPRINTFORML nSkill = {nSkill} nSkillLv = {nSkillLv} nXp = {nXp}|Current XP = {RESULT:0} Xp for next = {RESULT:1} Xp total = {RESULT:2}
