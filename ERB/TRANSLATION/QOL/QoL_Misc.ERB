@QOL_INGREDIENTS_FOR_RECIPE(R_ID, INGREDIENTS_ID, INGREDIENTS_COUNT)
#FUNCTION
#DIM R_ID
#DIM REF INGREDIENTS_ID
#DIM REF INGREDIENTS_COUNT
#DIM INGREDIENT
#DIM ARRAY_INDEX
VARSET INGREDIENTS_ID, -1
