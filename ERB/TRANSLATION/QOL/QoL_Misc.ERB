			CASE GET_MAP_REPLACEMENT(P805頂上)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[文]], [[はたて]], [[龍]])
		ENDSELECT
	CASE "trapping"
		SELECTCASE LOCATION
			CASE GET_MAP_REPLACEMENT(P25鎮守の森)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[霊夢]])
			CASE GET_MAP_REPLACEMENT(P433斜角の竹林)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[妹紅]], [[てゐ]], [[輝夜]], [[永琳]])
			CASE GET_MAP_REPLACEMENT(P805頂上)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[文]], [[はたて]], [[龍]])
		ENDSELECT
	CASE "stall"
		SELECTCASE LOCATION
			CASE GET_MAP_REPLACEMENT(P2境内)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[霊夢]])
			CASE GET_MAP_REPLACEMENT(P102境内)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[白蓮]])
			CASE GET_MAP_REPLACEMENT(P401永遠亭入口)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[永琳]], [[輝夜]])
			CASE GET_MAP_REPLACEMENT(P703玄武の沢)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[にとり]])
			CASE GET_MAP_REPLACEMENT(P805頂上)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[文]], [[はたて]], [[龍]])
			CASE GET_MAP_REPLACEMENT(P811境内)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[早苗]], [[神奈子]], [[諏訪子]])
			CASE GET_MAP_REPLACEMENT(P832有頂天街)
				RETURNF QOL_PERMISSION_CHARA(PERMISSION_TYPE, [[天子]])
		ENDSELECT
ENDSELECT
