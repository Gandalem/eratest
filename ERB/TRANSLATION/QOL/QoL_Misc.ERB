@QOL_DISTANT_WATCHERS
#DIMS DYNAMIC CHARACTERS
#DIM DYNAMIC TOTAL_CHARACTERS
#DIM DYNAMIC LAST_CHARACTER
SIF GET_MAPID(CFLAG:MASTER:現在位置) != MAIN_MAP || CFLAG:MASTER:現在位置 == OMANEKIBEYA()
	RETURN
FOR LOCAL, 0, GRAPH_NEIGHBORS_VISIBLE_FROM_INDEX:(CFLAG:MASTER:現在位置 % 100)
LOCAL:1 = GRAPH_NEIGHBORS_VISIBLE_FROM:(CFLAG:MASTER:現在位置 % 100):LOCAL
FOR LOCAL:2, 1, CHARANUM
IF CFLAG:(LOCAL:2):現在位置 == LOCAL:1
	CHARACTERS += @"%CALLNAME:(LOCAL:2)%、"
	TOTAL_CHARACTERS++
	LAST_CHARACTER = LOCAL:2
ENDIF
NEXT
NEXT
SIF !TOTAL_CHARACTERS
	RETURN
PRINTFORM ◆
IF CFLAG:MASTER:うふふ && GETBIT(FLAG:潜伏,0)
	PRINTFORMDL %BREAKENG(@"당신은 멀리서 %LIST_IN_STRING(CHARACTERS)%을 본다.")%
ELSEIF TOTAL_CHARACTERS == 1 && !FLAG:時間停止
	IF CFLAG:MASTER:うふふ
		IF TALENT:LAST_CHARACTER:無知
			PRINTFORMDL %CALLNAME:LAST_CHARACTER%은(는) 큰 흥미를 가지고 당신을 응시하고 있다.
		ELSEIF TALENT:LAST_CHARACTER:無関心 || TALENT:LAST_CHARACTER:感情乏しい
			PRINTFORMDL 당신은 멀리서 무관심하게 있는 %CALLNAME:LAST_CHARACTER%을(를) 본다.
		ELSEIF INRANGE(RELATION:LAST_CHARACTER:TARGET, 1, 99)
			PRINTFORMDL 당신은 멀리서 %CALLNAME:LAST_CHARACTER%가 엄청난 혐오감을 담아 당신을 바라보는 것을 본다.
		ELSEIF (TALENT:LAST_CHARACTER:思慕 || TALENT:LAST_CHARACTER:恋慕) && GET_UWAKI_HISTORY(LAST_CHARACTER, TARGET) == 2
			PRINTFORMDL 당신은 멀리서 %CALLNAME:LAST_CHARACTER%을 보는데, 그 얼굴에는 아련한 표정이 떠 있다.
		ELSEIF TALENT:LAST_CHARACTER:恋人 && GET_UWAKI_HISTORY(LAST_CHARACTER, TARGET) < 2
			PRINTFORMDL 당신은 멀리서, %CALLNAME:LAST_CHARACTER%이 %HIS_HER(LAST_CHARACTER)%의 얼굴에 실망한 표정으로 있는 것을 본다.
		ELSEIF (TALENT:LAST_CHARACTER:思慕 || TALENT:LAST_CHARACTER:恋慕)
			PRINTFORMDL 멀리서 당신은 %CALLNAME:LAST_CHARACTER%을 본다. %HIS_HER(LAST_CHARACTER)%의 얼굴에는 아련한 표정이 떠 있다.
		ELSEIF (TALENT:LAST_CHARACTER:セフレ || TALENT:LAST_CHARACTER:愛欲)
			PRINTFORMDL 당신은 멀리서 응원하는 %CALLNAME:LAST_CHARACTER%를 본다.
		ELSE
			PRINTFORMDL 당신은 멀리서 %CALLNAME:LAST_CHARACTER%를 본다.
		ENDIF
	ELSE
		;expand on this later
		PRINTFORMDL 멀리서 %CALLNAME:LAST_CHARACTER%가 보인다.
	ENDIF
ELSE
	PRINTFORMDL %BREAKENG(@"당신은 멀리서 %LIST_IN_STRING(CHARACTERS)%을 본다.")%
ENDIF
