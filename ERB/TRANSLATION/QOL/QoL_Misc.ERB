@QOL_SHOW_GATHERING_ITEM(PLACE)
#DIM PLACE
#DIM nItem
LOCAL:1 = 0
LOCAL:2 = 0 ;set to 1 if there's anything the player can gather
FOR LOCAL,0,VARSIZE("ITEM")
IF GATHERING_PRODUCT(LOCAL, PLACE)
	LOCALS = %ITEMNAME_TR(LOCAL)%
	IF ITEMPRICE:LOCAL >= 1000
		SETCOLOR C_YELLOW
		SIF ABL:MASTER:教養 < UniversalRank("D")
			LOCALS = ？？？
	ENDIF
	IF ITEMPRICE:LOCAL >= 3000
		SETCOLOR C_P_GREEN
		SIF ABL:MASTER:教養 < UniversalRank("C")
			LOCALS = ？？？
	ENDIF
	IF ITEMPRICE:LOCAL >= 10000
		SETCOLOR C_AQUA
		SIF ABL:MASTER:教養 < UniversalRank("B")
			LOCALS = ？？？
	ENDIF
	;季節条件を満たしていない場合は灰色表記に
	SIF !GATHERING_SEASON(LOCAL, PLACE)
		SETCOLOR 0x606060
	LOCAL:3 = LOCALS != "？？？" ? (ITEM:LOCAL > 9 ? 4 # 3) # 0 ;additional length to show quantity
	;Custom code, line breaking
	LOCAL:1 += STRLENS(LOCALS)+2+LOCAL:3
	IF LOCAL:1 > 149
		PRINTFORML 
		LOCAL:1 = STRLENS(LOCALS)+2+LOCAL:3
	ENDIF
	PRINTFORM %LOCALS%
	IF GATHERING_SEASON(LOCAL, PLACE)
		IF ITEM:LOCAL >= 99
			SETCOLOR C_GREEN
		ELSE
			LOCAL:2 = 1;player can gather it
			RESETCOLOR
		ENDIF
	ELSE
		SETCOLOR 0x606060
	ENDIF
	SIF LOCALS != "？？？"
		PRINTFORM ({ITEM:LOCAL})
	PRINTFORM 　
ENDIF
RESETCOLOR
NEXT
;weapons
FOR LOCAL,3000,4999
nItem = LOCAL-3000
SIF BLACKLISTED_WEAPON(nITEM)
	CONTINUE
IF LOCAL > 3000
	LOCAL:6 = nItem%VAR_TEMP_MAX
	LOCAL:5 = GET_INT(,"WeaponPreset",LOCAL:6,"Base Weapon")
ELSE
	LOCAL:5 = nItem
	LOCAL:6 = 0
ENDIF
IF GATHERING_PRODUCT(LOCAL, PLACE)
	LOCALS = %GET_STR(0, "Weapon", nItem, "名前")%
	IF WeaponRankCache:nItem >= UniversalRank("B")
		SETCOLOR C_YELLOW
		SIF ABL:MASTER:教養 < UniversalRank("B")
			LOCALS = ？？？
	ENDIF
	IF WeaponRankCache:nItem >= UniversalRank("S")
		SETCOLOR C_P_GREEN
		SIF ABL:MASTER:教養 < UniversalRank("S")
			LOCALS = ？？？
	ENDIF
	IF WeaponRankCache:nItem >= UniversalRank("OverDrive")
		SETCOLOR C_AQUA
		SIF ABL:MASTER:教養 < UniversalRank("OverDrive")
			LOCALS = ？？？
	ENDIF
	;季節条件を満たしていない場合は灰色表記に
	;SIF !GATHERING_SEASON(LOCAL, PLACE)
	;	SETCOLOR 0x606060
	LOCAL:4 = DT_SELECT("WeaponInventory",@"def = {LOCAL:5} and detectedPreset = {LOCAL:6}")
	LOCAL:3 = LOCALS != "？？？" ? (LOCAL:4 > 9 ? 4 # 3) # 0 ;additional length to show quantity
	;Custom code, line breaking
	LOCAL:1 += STRLENS(LOCALS)+2+LOCAL:3
	IF LOCAL:1 > 149
		PRINTFORML 
		LOCAL:1 = STRLENS(LOCALS)+2+LOCAL:3
	ENDIF
	PRINTFORM %LOCALS%
	IF GATHERING_SEASON(LOCAL, PLACE)
		IF LOCAL:4 >= 9999
			SETCOLOR C_GREEN
		ELSE
			LOCAL:2 = 1;player can gather it
			RESETCOLOR
		ENDIF
	ELSE
		SETCOLOR 0x606060
	ENDIF
	SIF LOCALS != "？？？"
		PRINTFORM ({LOCAL:4})
	PRINTFORM 　
ENDIF
RESETCOLOR
NEXT
IF !LOCAL:2
	PRINTFORML
	PRINTFORM 지금은 여기서 아무것도 수집할 수 없다
ENDIF
