		HAPPENING_TYPE = 1
	;風呂に入ってきた場合
	ELSEIF CAN_MOVE(CFLAG:MASTER:前ターン位置, CFLAG:ARG:前ターン位置) < 2 && CFLAG:ARG:前ターン位置 != CFLAG:MASTER:前ターン位置 && BATHCHECK(CFLAG:MASTER:現在位置)
		CALL PRINT_FACE, ARG, "通常" ;custom code, apply proper clothes
		PRINTFORMW %CALLNAME:ARG% enters the bathroom...
		IF BATH_REMOVE_COND(ARG)
			IF CFLAG:ARG:弱み握り && HETEROSEX(MASTER,ARG)
				PRINTFORMW %CALLNAME:ARG% drives you out...
				CFLAG:MASTER:現在位置 = KICKOUT()
				HAPPENING_TYPE = 5
				CALL TARGETSET_CHACK
				CFLAG:ARG:同室 = 0
			ELSE
				PRINTFORMW Your eyes meet for a brief moment before %CALLNAME:ARG% runs off...
				CFLAG:ARG:現在位置 = CFLAG:ARG:前ターン位置
				CALL TARGETSET_CHACK
				CFLAG:ARG:同室 = 0
				HAPPENING_TYPE = 4
			ENDIF
		ELSE
			PRINTFORMW Seems like %CALLNAME:ARG% wants to join you.
			SIF !TCVAR:ARG:今日会ったか && !cMorningGreeting:ARG:0 ;custom code, hide the line if the morning event was seen
				PRINTFORML You realize you haven't greeted %HIM_HER(ARG)% today.
			HAPPENING_TYPE = 3
		ENDIF
	;トイレに入ってきた場合
	ELSEIF CAN_MOVE(CFLAG:MASTER:前ターン位置, CFLAG:ARG:前ターン位置) < 2 && CFLAG:ARG:前ターン位置 != CFLAG:MASTER:前ターン位置 && IN_TOILET(CFLAG:MASTER:現在位置)
		PRINTW Someone knocks on the toilet door.
		$TOILET_INPUT_LOOP
		PRINTL [0]Tell them it's occupied　[1]Let them in
		INPUT
		IF RESULT == 1
			PRINTFORM %CALLNAME:ARG% enters the 
			PRINTFORMS NAME_FROM_PLACE(CFLAG:ARG:現在位置)
			PRINTFORMW .
			HAPPENING_TYPE = 2
		ELSEIF RESULT == 0
			PRINTW The footsteps grow quiet.
			CFLAG:ARG:現在位置 = CFLAG:ARG:前ターン位置
			CALL TARGETSET_CHACK
			CFLAG:ARG:同室 = 0
			HAPPENING_TYPE = -1
		ELSE
			GOTO TOILET_INPUT_LOOP
		ENDIF
	;addition custom code, if door is locked, and it's not target's place either they knock on the door or leave
	ELSEIF FLAG:自室施錠 && CAN_MOVE(CFLAG:MASTER:前ターン位置, CFLAG:ARG:前ターン位置) < 2 && CFLAG:ARG:前ターン位置 != CFLAG:MASTER:前ターン位置 && CFLAG:MASTER:現在位置 != CFLAG:ARG:初期位置
		IF CFLAG:ARG:2 >= 500
			PRINTFORML Someone knocks on the door.
			IF CFLAG:ARG:2 >= 1000
				PRINTFORML You can tell it's %CALLNAME:ARG%'s voice...
			ELSE
				PRINTFORML You take a moment to see who that is... It's %CALLNAME:ARG%.
			ENDIF
			CALL ASK_YN("Don't open", @"Let %HIM_HER(ARG)% in")
			IF RESULT
				PRINTFORM %CALLNAME:ARG% enters the 
				PRINTFORMS NAME_FROM_PLACE(CFLAG:ARG:現在位置)
				PRINTFORMW .
				HAPPENING_TYPE = 2
				GOTO CAMEIN
			ELSE
				PRINTW The footsteps grow quiet.
			ENDIF
		ELSE
			PRINTFORML %CALLNAME:ARG% tries to come in, but the door was locked so %HE_SHE(ARG)% leaves.
		ENDIF
		CFLAG:ARG:現在位置 = CFLAG:ARG:前ターン位置
		CALL TARGETSET_CHACK
		CFLAG:ARG:同室 = 0
		HAPPENING_TYPE = -1
		$CAMEIN
	;---------------------------------------------------------------------------------------------------------------
	;ELSEIF CAN_MOVE(CFLAG:MASTER:前ターン位置, CFLAG:ARG:前ターン位置) < 2 && CFLAG:ARG:前ターン位置 != CFLAG:MASTER:前ターン位置
	;↑の条件では来訪時に初対面口上が出ない場合があるので変更
	ELSEIF CFLAG:ARG:前ターン位置 != CFLAG:MASTER:前ターン位置
		;bugfix custom code, apply proper clothes
		CALL CHANGE_CLOTHES(ARG, "衣装リセット")
		CALL CLOTHES_SETTING_TRAIN(ARG)
		CALL PRINT_FACE, ARG, "通常"
		IF CFLAG:ARG:前ターン位置 != MAXROOM && CFLAG:ARG:前ターン位置 != OMANEKIBEYA()
			;Custom code
			PRINTFORMW %CALLNAME:ARG% comes to %NAME_FROM_PLACE_THE(CFLAG:ARG:現在位置, 1)%.
		ENDIF
		SIF !TCVAR:ARG:今日会ったか && !cMorningGreeting:ARG:0 ;custom code, hide the line if the morning event was seen
			PRINTFORML You realize you haven't greeted %HIM_HER(ARG)% today.
		HAPPENING_TYPE = 2
	ENDIF
	IF !FLAG:70 && CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置
		IF !NOZOKI && HAPPENING_TYPE >= 0
		;初対面
			IF CFLAG:(NO:ARG):面識 == 0
				CALL SYOTAIMEN(ARG)
			ELSEIF CFLAG:ARG:情事目撃 && CFLAG:(CFLAG:ARG:情事目撃):現在位置 != CFLAG:ARG:現在位置
				PRINTFORMW %CALLNAME:ARG% confronts you about what you did with %CALLNAME:(CFLAG:ARG:情事目撃)% earlier.
				;CALL KOJO_EVENT(0, ARG, 2)
				CALL KOJO_MESSAGE_SEND("EVENT",8,ARG,CFLAG:ARG:情事目撃,1)
				CFLAG:ARG:情事目撃 = 0
			ELSEIF CFLAG:ARG:情事目撃 && CFLAG:(CFLAG:ARG:情事目撃):現在位置 == CFLAG:ARG:現在位置
				PRINTFORMW %CALLNAME:ARG% scolds you and %CALLNAME:(CFLAG:ARG:情事目撃)% for what you did earlier...
				CALL KOJO_MESSAGE_SEND("EVENT",8,ARG,CFLAG:ARG:情事目撃,2)
				CFLAG:ARG:情事目撃 = 0
			ELSE
				IF !TCVAR:ARG:今日会ったか && CFLAG:ARG:同室
					CALL KOJO_MESSAGE_SEND("EVENT",1,ARG,8,0)
				ENDIF
				;通常遭遇口上
				CALL KOJO_MESSAGE_SEND("EVENT",1,ARG,HAPPENING_TYPE,0)
			ENDIF
		ENDIF
		CALL FirstMeetToday(ARG)
		SIF GROUPMATCH(HAPPENING_TYPE, 2, 3, 6, 7, 8)
			CALL EXHIBITIONIST_NUDIST_REACTION(ARG) ;custom code
	ENDIF
ENDIF
IF (WORKING(ARG, 1) && !GROUPMATCH(CFLAG:ARG:職種, JOB_宴会参加, JOB_酔いつぶれる)) || GROUPMATCH(CFLAG:ARG:職種, JOB_宴会準備, JOB_宴会の片づけ) && !CFLAG:ARG:同室 ;qol custom code, show if they're working when you see them
	CALL 仕事情景描写(ARG)
	SIF FLAG:70
		PRINTFORMW ...At least, that's what it looks like in Time Stop.
	PRINTFORML
ENDIF
