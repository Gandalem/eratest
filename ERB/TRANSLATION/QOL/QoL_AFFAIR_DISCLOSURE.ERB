				PRINTFORMW %NAME_FROM_PLACE_THE(CFLAG:ARG:現在位置)% %CALLNAME:ARG%가 당신의 불륜을 바라본다 \@ TALENT:ARG:羞恥心 > 0 ? 숨기면서 %HIS_HER(ARG)%의 홍당무 같은 얼굴 # 호기심으로 가득 찬 \@...
			ELSE
				PRINTFORMW %CALLNAME:ARG%은(는) \@ TALENT:ARG:恋慕 ? 실망한다 # 부끄러워하며 외면한다 \@...
				IF TALENT:ARG:恋慕 && !CFLAG:ARG:情事目撃
					IF TCVAR:ARG:馴れ合い < 3
						TALENT:ARG:機嫌 = MIN(TALENT:ARG:機嫌, 0)
						BASE:ARG:怒り += MAXBASE:ARG:怒り / 4
					ENDIF
					CFLAG:ARG:情事目撃 = WITNESSED ;can sadly only set this to one target
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ENDIF
IF FORCE_STOP
	SIF CFLAG:MASTER:イタズラ
		CALL SET_PRANK(0,TARGET,2)
	CALL ENDUFUFU_ALL
	TARGET = TARGET:1
	IF FORCE_GETOUT
		SIF !FORCE_GETOUT_SPARE_MASTER ;Custom code, spare the player from ejection.
			CALL GETOUT(MASTER)
		FOR LOCAL, 0, WITNESSED_COUNT
		CALL GETOUT(WITNESSED_ALL:LOCAL)
		NEXT
		CALL TARGETSET_CHACK
	ENDIF
	CFLAG:MASTER:今忙しくて手が離せない = 0
	TFLAG:106 = 0
	RETURN 0
ENDIF
;通常遭遇
;experimental bug fix: modified below, TIME != TIME:3 removed because girls won't greet you right after waking up with tsp movement enabled (time doesn't change therefore this gets ignored)
IF !CFLAG:ARG:睡眠 && (!NOZOKI || CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置) && !FLAG:時間停止 && !CHK_DATENOW(CFLAG:ARG:デート中) && !GETBIT(FLAG:潜伏,0)
	;デート中に偶然遭遇
	IF CHK_DATENOW(CFLAG:MASTER:デート中)
		CALL PRINT_FACE, ARG, "通常"
		IF !CFLAG:(NO:ARG):面識 && TALENT:ARG:行きずり
			PRINTFORMW 당신은 %CALLNAME:ARG%에게 부른다.
		ELSEIF CFLAG:TARGET:同室 ;custom code, don't "come across" someone if you resumed time with them
			PRINTFORMW %CALLNAME:ARG%가 여기 있다.
		ELSE
			IF !TCVAR:ARG:今日会ったか && !cMorningGreeting:ARG:0 ;custom code, hide the line if the morning event was seen
				PRINTFORMW 당신은 %CALLNAME:ARG%를 마주친다.
			ELSE
				PRINTFORMW 당신은 다시 %CALLNAME:ARG%을(를) 마주친다.
			ENDIF
		ENDIF
		IF CFLAG:(NO:ARG):面識 == 0
			CALL SYOTAIMEN(ARG)
		ELSE
			;IF MOREDATE && NumberOfDates > 1 && !IS_IN_GROUP_DATE(ARG) ; If seen while dating more than one person
			;	IF !TCVAR:ARG:今日会ったか
			;		CALL KOJO_MESSAGE_SEND("EVENT",1,ARG,9,GET_RANDOM_DATE)
			;	ENDIF
			;	CALL KOJO_MESSAGE_SEND("EVENT",1,ARG,1007,GET_RANDOM_DATE)
			;ELSE
			FOR LOCAL:4,1,CHARANUM
			IF CHK_DATENOW(CFLAG:(LOCAL:4):デート中)
				IF !TCVAR:ARG:今日会ったか
					CALL KOJO_MESSAGE_SEND("EVENT",1,ARG,9,LOCAL:4)
				ENDIF
				CALL KOJO_MESSAGE_SEND("EVENT",1,ARG,7,LOCAL:4)
				BREAK
			ELSEIF LOCAL:4 == CHARANUM - 1
				IF !TCVAR:ARG:今日会ったか
					CALL KOJO_MESSAGE_SEND("EVENT",1,ARG,9,0)
				ENDIF
				CALL KOJO_MESSAGE_SEND("EVENT",1,ARG,6,0)
			ENDIF
			NEXT
		ENDIF
		;さっきから居るのは分かっていたか否か
	ELSEIF CFLAG:ARG:前ターン位置 == CFLAG:ARG:現在位置
		CALL PRINT_FACE, ARG
		IF CFLAG:TARGET:同室 ;custom code, if you've already seen them while time is stopped or they're asleep
			PRINTFORMW %CALLNAME:ARG%가 여기에 있다.
			SIF !TCVAR:ARG:今日会ったか && !cMorningGreeting:ARG:0
				PRINTFORML 당신은 오늘 %HIM_HER(ARG)%에게 인사하지 않았다는 것을 깨닫는다.
		ELSE
			PRINTFORMW %CALLNAME:ARG%은(는) \@ CAN_MOVE(CFLAG:MASTER:前ターン位置, CFLAG:ARG:現在位置) == 2 ? 이다 # 이었다 \@%AT_IN_ON(CFLAG:ARG:現在位置)%에서.
			SIF !TCVAR:ARG:今日会ったか && !cMorningGreeting:ARG:0 ;custom code, hide the line if the morning event was seen
				PRINTFORML %CALLNAME:ARG%를 본 당신은 오늘 %HIM_HER(ARG)%에게 인사하지 않았다는 것을 깨닫는다.
		ENDIF
		HAPPENING_TYPE = 1
		;風呂に入ってきた場合
	ELSEIF CAN_MOVE(CFLAG:MASTER:前ターン位置, CFLAG:ARG:前ターン位置) < 2 && CFLAG:ARG:前ターン位置 != CFLAG:MASTER:前ターン位置 && BATHCHECK(CFLAG:MASTER:現在位置)
		CALL PRINT_FACE, ARG, "通常" ;custom code, apply proper clothes
		PRINTFORMW %CALLNAME:ARG%은(는) 욕실에 들어간다...
		IF BATH_REMOVE_COND(ARG)
			IF CFLAG:ARG:弱み握り && HETEROSEX(MASTER,ARG)
				PRINTFORMW %CALLNAME:ARG%이/가 당신을 내쫓는다...
				CFLAG:MASTER:現在位置 = KICKOUT()
				HAPPENING_TYPE = 5
				CALL TARGETSET_CHACK
				CFLAG:ARG:同室 = 0
			ELSE
				PRINTFORMW 당신의 눈이 잠시 마주치지만, 그 후 %CALLNAME:ARG%은(는) 달려간다...
				CFLAG:ARG:現在位置 = CFLAG:ARG:前ターン位置
				CALL TARGETSET_CHACK
				CFLAG:ARG:同室 = 0
				HAPPENING_TYPE = 4
			ENDIF
		ELSE
			PRINTFORMW %CALLNAME:ARG%가 당신과 함께하고 싶어 하는 것 같다.
			SIF !TCVAR:ARG:今日会ったか && !cMorningGreeting:ARG:0 ;custom code, hide the line if the morning event was seen
				PRINTFORML 당신은 오늘 %HIM_HER(ARG)%에게 인사하지 않았다는 것을 깨닫는다.
			HAPPENING_TYPE = 3
		ENDIF
		;トイレに入ってきた場合
	ELSEIF CAN_MOVE(CFLAG:MASTER:前ターン位置, CFLAG:ARG:前ターン位置) < 2 && CFLAG:ARG:前ターン位置 != CFLAG:MASTER:前ターン位置 && IN_TOILET(CFLAG:MASTER:現在位置)
		PRINTW 누군가 화장실 문을 두드린다.
		$TOILET_INPUT_LOOP
		PRINTL [0]그곳이 사용 중이라고 말해라 [1]들어가게 해라
		INPUT
		IF RESULT == 1
			PRINTFORM %CALLNAME:ARG%은(는) ~에 들어간다 
			PRINTFORMS NAME_FROM_PLACE(CFLAG:ARG:現在位置)
			PRINTFORMW .
			HAPPENING_TYPE = 2
		ELSEIF RESULT == 0
			PRINTW 발소리가 조용해진다.
			CFLAG:ARG:現在位置 = CFLAG:ARG:前ターン位置
			CALL TARGETSET_CHACK
			CFLAG:ARG:同室 = 0
			HAPPENING_TYPE = -1
		ELSE
			GOTO TOILET_INPUT_LOOP
		ENDIF
		;addition custom code, if door is locked, and it's not target's place either they knock on the door or leave
	ELSEIF FLAG:自室施錠 && CAN_MOVE(CFLAG:MASTER:前ターン位置, CFLAG:ARG:前ターン位置) < 2 && CFLAG:ARG:前ターン位置 != CFLAG:MASTER:前ターン位置 && CFLAG:MASTER:現在位置 != CFLAG:ARG:初期位置
		IF CFLAG:ARG:2 >= 500
			PRINTFORML 누군가 문을 두드린다.
			IF CFLAG:ARG:2 >= 1000
				PRINTFORML 당신은 그것이 %CALLNAME:ARG%의 목소리라는 것을 알 수 있다...
			ELSE
				PRINTFORML 당신은 잠시 누군지를 본다... 그것은 %CALLNAME:ARG%다.
			ENDIF
			CALL ASK_YN("열지 마라", @"%HIM_HER(ARG)%이/가 안에 있다")
			IF RESULT
				PRINTFORM %CALLNAME:ARG%이(가) 들어간다 
				PRINTFORMS NAME_FROM_PLACE(CFLAG:ARG:現在位置)
				PRINTFORMW .
				HAPPENING_TYPE = 2
				GOTO CAMEIN
			ELSE
				PRINTW 발소리가 조용해진다.
			ENDIF
		ELSE
			PRINTFORML %CALLNAME:ARG%은 들어오려 하지만 문이 잠겨 있어서 %HE_SHE(ARG)%는 떠난다.
		ENDIF
		CFLAG:ARG:現在位置 = CFLAG:ARG:前ターン位置
		CALL TARGETSET_CHACK
		CFLAG:ARG:同室 = 0
		HAPPENING_TYPE = -1
		$CAMEIN
		;---------------------------------------------------------------------------------------------------------------
		;ELSEIF CAN_MOVE(CFLAG:MASTER:前ターン位置, CFLAG:ARG:前ターン位置) < 2 && CFLAG:ARG:前ターン位置 != CFLAG:MASTER:前ターン位置
		;↑の条件では来訪時に初対面口上が出ない場合があるので変更
	ELSEIF CFLAG:ARG:前ターン位置 != CFLAG:MASTER:前ターン位置
		;bugfix custom code, apply proper clothes
		CALL CHANGE_CLOTHES(ARG, "衣装リセット")
		CALL CLOTHES_SETTING_TRAIN(ARG)
		CALL PRINT_FACE, ARG, "通常"
		IF CFLAG:ARG:前ターン位置 != MAXROOM && CFLAG:ARG:前ターン位置 != OMANEKIBEYA()
			;Custom code
			PRINTFORMW %CALLNAME:ARG%은(는) %NAME_FROM_PLACE_THE(CFLAG:ARG:現在位置, 1)%에 온다.
		ENDIF
		SIF !TCVAR:ARG:今日会ったか && !cMorningGreeting:ARG:0 ;custom code, hide the line if the morning event was seen
			PRINTFORML 당신은 오늘 %HIM_HER(ARG)%에게 인사하지 않았다는 것을 깨닫는다.
		HAPPENING_TYPE = 2
	ENDIF
	IF !FLAG:70 && CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置
		IF !NOZOKI && HAPPENING_TYPE >= 0
			;初対面
			IF CFLAG:(NO:ARG):面識 == 0
				CALL SYOTAIMEN(ARG)
			ELSEIF CFLAG:ARG:情事目撃 && CFLAG:(CFLAG:ARG:情事目撃):現在位置 != CFLAG:ARG:現在位置
				PRINTFORMW %CALLNAME:ARG%은(는) 당신이 아까 %CALLNAME:(CFLAG:ARG:情事目撃)%와 했던 일에 대해 추궁한다.
				;CALL KOJO_EVENT(0, ARG, 2)
				CALL KOJO_MESSAGE_SEND("EVENT",8,ARG,CFLAG:ARG:情事目撃,1)
				CFLAG:ARG:情事目撃 = 0
			ELSEIF CFLAG:ARG:情事目撃 && CFLAG:(CFLAG:ARG:情事目撃):現在位置 == CFLAG:ARG:現在位置
				PRINTFORMW %CALLNAME:ARG%은(는) 당신에게 그리고 %CALLNAME:(CFLAG:ARG:情事目撃)%에게 아까 한 일에 대해 꾸짖는다...
				CALL KOJO_MESSAGE_SEND("EVENT",8,ARG,CFLAG:ARG:情事目撃,2)
				CFLAG:ARG:情事目撃 = 0
			ELSE
				IF !TCVAR:ARG:今日会ったか && CFLAG:ARG:同室
					CALL KOJO_MESSAGE_SEND("EVENT",1,ARG,8,0)
				ENDIF
				;通常遭遇口上
				CALL KOJO_MESSAGE_SEND("EVENT",1,ARG,HAPPENING_TYPE,0)
			ENDIF
		ENDIF
		CALL FirstMeetToday(ARG)
		SIF GROUPMATCH(HAPPENING_TYPE, 2, 3, 6, 7, 8)
			CALL EXHIBITIONIST_NUDIST_REACTION(ARG) ;custom code
	ENDIF
ENDIF
IF (WORKING(ARG, 1) && !GROUPMATCH(CFLAG:ARG:職種, JOB_宴会参加, JOB_酔いつぶれる)) || GROUPMATCH(CFLAG:ARG:職種, JOB_宴会準備, JOB_宴会の片づけ) && !CFLAG:ARG:同室 ;qol custom code, show if they're working when you see them
	CALL 仕事情景描写(ARG)
	SIF FLAG:70
		PRINTFORMW 적어도, 시간 정지 상태에서는 그렇게 보인다.
	PRINTFORML
ENDIF
