@QOL_HOME_BATHROOM(ARG)
#FUNCTION
#DIM CHARA_ROOM_MAP
#DIM CURRENT_MAP
;must be a bathroom
SIF !BATHROOM(CFLAG:ARG:現在位置)
	RETURNF 0
CHARA_ROOM_MAP = MAP_AREASELECT(MAIN_MAP, CFLAG:ARG:神社在住)
CURRENT_MAP = MAP_AREASELECT(MAIN_MAP, CFLAG:ARG:現在位置)
SELECTCASE MAIN_MAP ;special cases
	CASE 3 ;sdm has two floors
		SIF GROUPMATCH(CHARA_ROOM_MAP, 2, 3) && GROUPMATCH(CURRENT_MAP, 2, 3)
			RETURNF 1
	CASE 7 ;kasen's home has two floors
		SIF GROUPMATCH(CHARA_ROOM_MAP, 3, 4) && GROUPMATCH(CURRENT_MAP, 3, 4)
			RETURNF 1
	CASEELSE
		SIF CHARA_ROOM_MAP == CURRENT_MAP
			RETURNF 1
ENDSELECT
RETURNF 0
