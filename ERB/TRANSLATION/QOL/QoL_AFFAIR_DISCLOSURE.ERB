@AFFAIR_DISCLOSURE_TR(ARG, NOZOKI)
#DIM PREV_TARGET
#DIM IRAI_ABLE
#DIM NOZOKI
#DIM FORCE_STOP
#DIM FORCE_GETOUT
#DIM WITNESSED
#DIM WITNESSED_ALL, キャラクタ数上限
#DIM WITNESSED_COUNT
#DIMS WITNESSED_TEXT
#DIM HAPPENING_TYPE
#DIM VICTIMS_STATE
#DIM MOLESTATION_TYPE
#DIM JOIN_RESULT
#DIM DYNAMIC REACTING_PARTICIPANT
#DIM DYNAMIC FORCE_GETOUT_SPARE_MASTER ;Custom code, flag for sparing the player when others are ejected.
SIF NO:ARG == MASTER ;addition custom code
	RETURN
WITNESSED_COUNT = 0
VARSET LOCALS
FOR LOCAL, 1, GET_TARGETNUM() + 1
SIF TARGET:LOCAL == ARG
	CONTINUE
IF (CFLAG:(TARGET:LOCAL):うふふ || CFLAG:(TARGET:LOCAL):イタズラ) && !GETBIT(FLAG:潜伏,0)
	WITNESSED_ALL:(WITNESSED_COUNT++) = TARGET:LOCAL
	LOCALS += @"%CALLNAME:(TARGET:LOCAL)%、"
ENDIF
NEXT
IF CFLAG:MASTER:今忙しくて手が離せない
	WITNESSED_ALL:(WITNESSED_COUNT++) = MASTER
	LOCALS += @"당신은"
ENDIF
WITNESSED_TEXT '= LIST_IN_STRING(LOCALS)
VARSET LOCAL
FORCE_STOP = 0
FORCE_GETOUT = 0
HAPPENING_TYPE = 0
WITNESSED = TFLAG:現在のTARGET
SIF CFLAG:MASTER:イタズラ
	WITNESSED = TARGET
IF WITNESSED_COUNT > 0 && !FLAG:70 ;bugfix, don't do this if time is stopped
	VICTIMS_STATE = QOL_ANY_DRUNK_OR_SLEEPING(WITNESSED_ALL, WITNESSED_COUNT)
	DRAWLINE
	;NAS: masturbating
	IF CFLAG:MASTER:今忙しくて手が離せない
		PRINTFORML %CALLNAME:ARG%가 당신이 자위하는 것을 목격했다!
		JOIN_RESULT = QOL_VOYEUR_JOINS(ARG, WITNESSED_ALL, WITNESSED_COUNT)
		SELECTCASE JOIN_RESULT
			CASE 1
				IF TALENT:ARG:SexKnow == -1
					PRINTFORML %CALLNAME:ARG%은 당신의 자위를 본다 \@ TALENT:ARG:羞恥心 > 0 ? 숨기고 있음에도 %HIS_HER(ARG)%의 홍당무 같은 얼굴 # 호기심으로 가득 찬 \@...
					PRINTFORMW 당신은 혼란스러운 %CALLNAME:ARG%를 지나쳐 간다.
					CALL GETOUT(ARG)
					CALL TARGETSET_CHACK
					CFLAG:ARG:同室 = 0
					RETURN 1
				ENDIF
				PRINTFORMW %CALLNAME:ARG%는 역겹다는 듯한 표정을 짓는다.
				GOTO VOYEUR_LEAVES
			CASE 2
				IF CharaDiaperChecker(ARG)
					PRINTFORML %CALLNAME:ARG%은(는) 일이 끝나기 전에 자위를 했다고 당신을 비난한다 %AT_IN_ON(CFLAG:MASTER:現在位置)%
