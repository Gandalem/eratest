@QOL_LANDLORD_AT_HOME(ARG)
#FUNCTION
#DIM CHARA_ROOM_MAP
;only valid on main_map
SIF MAIN_MAP != GET_MAPID(CFLAG:ARG:現在位置)
	RETURNF 0
CHARA_ROOM_MAP = MAP_AREASELECT(MAIN_MAP, CFLAG:ARG:神社在住)
;special cases
SELECTCASE ARG
	;reimu/marisa is not marked as landlord because they're the default for their maps
	CASE [[霊夢]], [[魔理沙]]
		RETURNF MAP_AREASELECT(MAIN_MAP, CFLAG:ARG:現在位置) == CHARA_ROOM_MAP
		;sunny, luna, and star all count as landlord
	CASE [[サニー]], [[ルナ]], [[スター]]
		RETURNF MAP_AREASELECT(MAIN_MAP, CFLAG:ARG:現在位置) == CHARA_ROOM_MAP
		;akyuu only counts as owner of the hieda residence
	CASE [[阿求]]
		RETURNF GROUPMATCH(CFLAG:ARG:現在位置, P221稗田邸, P229阿求私室)
	CASE [[レミリア]] ;SDM is split into two maps
		RETURNF GROUPMATCH(MAP_AREASELECT(MAIN_MAP, CFLAG:ARG:現在位置), 2, 3)
		;prismrivers share ownership
	CASE [[リリカ]], [[メルラン]], [[ルナサ]]
		RETURNF MAP_AREASELECT(MAIN_MAP, CFLAG:ARG:現在位置) == CHARA_ROOM_MAP
		;kasen's home is split into two maps (3,4)
	CASE [[華扇]]
		RETURNF GROUPMATCH(MAP_AREASELECT(MAIN_MAP, CFLAG:ARG:現在位置), 3, 4)
		;aki sisters share ownership
	CASE [[静葉]], [[穣子]]
		RETURNF MAP_AREASELECT(MAIN_MAP, CFLAG:ARG:現在位置) == CHARA_ROOM_MAP
		;both watatsuki sisters count
	CASE [[依姫]], [[豊姫]]
		RETURNF MAP_AREASELECT(MAIN_MAP, CFLAG:ARG:現在位置) == CHARA_ROOM_MAP
		;eiki does not have so much authority over the ministry
	CASE [[映姫]]
		RETURNF 0
		;animal matriarchs in their homes
	CASE [[八千慧]]
		RETURNF GROUPMATCH(CFLAG:ARG:現在位置, P646八千慧宅の風呂, P647八千慧宅のリビング, P648八千慧宅の寝室)
	CASE [[早鬼]]
		RETURNF GROUPMATCH(CFLAG:ARG:現在位置, P650早鬼宅のリビング, P651早鬼宅の寝室, P652早鬼宅の風呂)
	CASE [[尤魔]]
		RETURNF GROUPMATCH(CFLAG:ARG:現在位置, P653尤魔宅のリビング, P654尤魔宅の寝室, P655尤魔宅の風呂)
	CASE [[袿姫]]
		RETURNF INRANGE(CFLAG:ARG:現在位置, P642霊長園, P645磨弓の部屋)
	CASEELSE
		;must be landlord
		SIF !CFLAG:ARG:大家候補
			RETURNF 0
		;is on home submap
		RETURNF MAP_AREASELECT(MAIN_MAP, CFLAG:ARG:現在位置) == CHARA_ROOM_MAP
ENDSELECT
RETURNF 0

