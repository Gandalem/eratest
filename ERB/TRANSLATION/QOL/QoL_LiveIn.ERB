; Modular ERB: QOL/QoL_LiveIn.ERB

@恋慕ルーム_TR
#DIM nMode
#DIMS strChoices = "Choose a different room", "Choose a landlord"
#DIMS strLandlord
CALL LS_RESTRICT_PRINT("Change room") ;Custom code, restrict moving during Lunatic Survival.
SIF RESULT
	RETURN
DRAWLINE
PRINTL 이곳에서는 자신의 방을 바꿀 수 있다.
;check if you can change the landlord on the current map
LOCAL:1 = 0
FOR LOCAL,1,CHARANUM
;Custom code, bugfix, prevents people from asking to stay over multiple times in a row
IF CFLAG:LOCAL:神社在住 && !CFLAG:LOCAL:出禁 && FLAG:一時滞在 != LOCAL
	SIF CFLAG:LOCAL:大家候補
		LOCAL:1 ++
ENDIF
NEXT
IF LOCAL:1
	CALL ASK_CHOICES(strChoices, 100, "취소")
	SIF RESULT == 100
		RETURN 1
	nMode = RESULT
	DRAWLINE
ELSE
	nMode = 0
ENDIF
IF !nMode
	SIF 拠点_大家 > 0
		PRINTFORML 여기서 움직여도 집주인은 변하지 않는다 (현재: %CALLNAME:拠点_大家%)
	SIF CFLAG:MASTER:初期位置 == デフォルト初期位置
		SETCOLOR C_AQUA
	PRINTFORML [  0] %NAME_FROM_PLACE(デフォルト初期位置)%은(는) (기본)
	RESETCOLOR
	FOR LOCAL,1,CHARANUM
	SIF !CFLAG:LOCAL:神社在住
		CONTINUE
	SIF CFLAG:MASTER:初期位置 == CFLAG:LOCAL:初期位置
		SETCOLOR C_AQUA
	SIF IS_LOVER(LOCAL)
		PRINTFORML [{LOCAL, 3}] - %NAME_FROM_PLACE(CFLAG:LOCAL:初期位置)%
	RESETCOLOR
	NEXT
	DRAWLINE
	PRINTFORML [999] - 취소
	$INPUT_LOOP2
	INPUT
	IF RESULT == 999
		RETURN 1
	ELSEIF RESULT < 0 || RESULT >= CHARANUM
		CLEARLINE 1
		GOTO INPUT_LOOP2
	ELSEIF RESULT == 0
		;初期あなた私室
		CFLAG:MASTER:初期位置 = デフォルト初期位置
	ELSEIF CFLAG:RESULT:初期位置 == P54小人の虫かご && TALENT:MASTER:体型 >= -4 && IS_LOVER(RESULT) ;qol custom code
		PRINTFORMW 당신이 작은 아이가 아니므로 함께 살 수 없다.
		CLEARLINE 2
		GOTO INPUT_LOOP2
	ELSEIF IS_LOVER(RESULT) && CFLAG:RESULT:神社在住
		CFLAG:MASTER:初期位置 = CFLAG:RESULT:初期位置
		CALL KOJO_MESSAGE_SEND("EVENT", 19, RESULT, 3, 0)
	ELSE
		CLEARLINE 1
		GOTO INPUT_LOOP2
	ENDIF
	PRINTFORML %NAME_FROM_PLACE(CFLAG:MASTER:初期位置)%로 설정한다.
	PRINTFORMW 생활 공간 변경은 내일부터 적용된다.
ELSE
	;extract default landlord of the map
	LOCAL:0 = 拠点_大家
	LOCAL:1 = デフォルト初期位置
	TRYCCALLFORM DEFAULT_OWNER_{MAIN_MAP}
	strLandlord '= CALLNAME:拠点_大家
	拠点_大家 = LOCAL:0
	;デフォルト初期位置 = LOCAL:1
	CATCH
	ENDCATCH
	PRINTFORML %PRINT_COLOR("이 지도에는 선택할 수 있는 방이 둘 이상 있습니다: ", C_WHITE) + PRINT_COLOR("방 선택", C_ORANGE) + PRINT_COLOR(".", C_WHITE)%
	PRINTFORML 현재: %NAME_FROM_PLACE(CFLAG:MASTER:初期位置)% 지주: %CALLNAME:拠点_大家%
	SIF DAY <= 1
		PRINTFORML 첫날에는 신뢰도에 상관없이 어떤 방이라도 선택할 수 있다.
	PRINTL
	FOR LOCAL, 1, CHARANUM
	IF CFLAG:LOCAL:神社在住 && CFLAG:LOCAL:大家候補
		SIF CFLAG:LOCAL:住み込み必要信頼度 > CFLAG:LOCAL:信頼度 && DAY > 1
			SETCOLOR C_L_GRAY
		PRINTBUTTON @"[{CFLAG:LOCAL:大家候補 % 100, 3}] - %NAME_FROM_PLACE(CFLAG:LOCAL:大家候補), 36, LEFT%　집주인:%CALLNAME:LOCAL, 15, LEFT%　신뢰 요구치:{CFLAG:LOCAL:住み込み必要信頼度, 4}현재: {CFLAG:LOCAL:信頼度}", LOCAL
		PRINTL
		RESETCOLOR
	ENDIF
	NEXT
	PRINTFORML [  0] - ({デフォルト初期位置 % 100, 2}) %NAME_FROM_PLACE(デフォルト初期位置)%(기본 방) 기본 집주인: %strLandlord%
	gLineCount = LINECOUNT
	DO
	SIF LINECOUNT - gLineCount > 0
		CLEARLINE LINECOUNT - gLineCount
	INPUT
	IF RESULT == 0
		CALL デフォルト引っ越し
		CFLAG:MASTER:初期位置 = デフォルト初期位置
		RETURN 1
	ELSEIF RESULT < CHARANUM && CFLAG:RESULT:神社在住 && CFLAG:RESULT:大家候補
		LOCAL = RESULT
		IF LOCAL != 0 && CFLAG:LOCAL:住み込み必要信頼度 > CFLAG:LOCAL:信頼度 && DAY > 1
			PRINTFORMW %CALLNAME:LOCAL%는 당신를 충분히 신뢰하지 않는다...
		ELSE
			拠点_大家 = LOCAL
			デフォルト初期位置 = CFLAG:LOCAL:大家候補
			CFLAG:MASTER:初期位置 = デフォルト初期位置
			ROOMDATA:(デフォルト初期位置 % 100) |= 場所_布団
			ROOMDATA:(デフォルト初期位置 % 100) |= 場所_プライベート
			PRINTFORML %NAME_FROM_PLACE(CFLAG:LOCAL:大家候補)%로 이사했다.
			PRINTFORML 집주인은 %CALLNAME:拠点_大家%로 설정되었다.
			RETURN 1
		ENDIF
	ENDIF
	LOOP 1
ENDIF

@Qol_MoveIn_Omikuji
;mirrors the section from 日時天候管理.ERB
IF FLAG:おみくじ契約
	FLAG:おみくじ契約 = 0
	LOCAL = 50
	SIF !MAIN_MAP
		LOCAL = 30
	PRINTFORML 일단 이동하면, 오미쿠지 계약은 종료된다.
	PRINTFORML 오미쿠지 계약을 갱신할까? (CM{LOCAL}, 현재 카리스마:CM%三桁区切(MONEY:2)%)
	CALL ASK_YN
	IF !RESULT
		IF MONEY:2 < LOCAL
			PRINTFORML 카리스마가 부족해서 오미쿠지 계약이 종료되었다.
		ELSE
			PRINTFORML 계약이 갱신되었다.
			CALL PAY_MONEY_CM(LOCAL, 2)
			FLAG:おみくじ契約 = 1
		ENDIF
	ENDIF
ELSE
	FLAG:おみくじ契約 = 0
ENDIF
