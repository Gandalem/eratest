@服装着せ替え_TR(C_ID)
#DIM C_ID
#DIM LINESTART2
#DIM LINESTART3

;become aware of underwear state
CALLF 上半身下着チェック(C_ID)
CALLF 下半身下着チェック(C_ID)

LINESTART = LINECOUNT

PRINTFORMDL %CALLNAME:C_ID%'s current outfit:
CALL SHOW_CLOTHES(C_ID, "現在の衣装")
{
CALL ASK_M(
    "Check clothes", 1, 
    "Change sleepwear", C_ID != MASTER ? 1 # -1, 
    "Change casual wear", 1, 
    "Change clothes temporarily", 1, 
    "Change favorite underwear", 1, 
    "Return", 1)
}
LINESTART2 = LINECOUNT
SELECTCASE RESULT
    CASE 0
        CALL SHOW_ALL_CHARA_CLOTHES(C_ID)
		CLEARLINE LINECOUNT - LINESTART
		RESTART
    CASE 1
		$SET_SLEEPWEAR
		CALL SHOW_CLOTHES(C_ID, "今日のパジャマ")
		PRINTFORMDL Changing %CALLNAME:C_ID%'s sleepwear.
		PRINTFORMDL 
        {
            CALL ASK_M(
                @"Reset %HIS_HER(C_ID)% sleepwear to the default", 1,
                @"Set %HIS_HER(C_ID)% sleepwear", 1,
                @"Have %HIM_HER(C_ID)% sleep naked", 1,
                @"Have %HIM_HER(C_ID)% sleep in just underwear", 1,
                @"Return", 1)
        }

        SELECTCASE RESULT
            CASE 0
                IF C_ID != MASTER
                    CFLAG:C_ID:パジャマ指定 = OBJNAME_TO_ID(C_ID, "GET", "衣装セット", GET_STR(C_ID, "キャラデータ", NO:C_ID, "今日のパジャマ"))
                ELSEIF FLAG:なりきり
                    CFLAG:C_ID:パジャマ指定 = OBJNAME_TO_ID(C_ID, "GET", "衣装セット", GET_STR(C_ID, "キャラデータ", NO:(FLAG:なりきり), "今日のパジャマ"))
                ENDIF
                SIF !CFLAG:C_ID:パジャマ指定
                    CFLAG:C_ID:パジャマ指定 = OBJNAME_TO_ID(C_ID, "GET", "衣装セット", "パジャマ（襦袢）セット")
				PRINTFORMDW %HIS_HER(C_ID,1)% sleepwear has been reset to the default.
            CASE 1
				CALL COSPLAY_SELECT(C_ID, "パジャマ", "パジャマセット")
            CASE 2
				CALL CTRL_CLOTHES_SET(C_ID, "パジャマの変更_全裸")
                PRINTFORMDW %HE_SHE(C_ID,1)% now sleeps naked.
            CASE 3
				CALL CTRL_CLOTHES_SET(C_ID, "パジャマの変更_パンイチ")
                PRINTFORMDW %HE_SHE(C_ID,1)% now sleeps in %HIS_HER(C_ID)% underwear.
            CASE 4
				CLEARLINE LINECOUNT - LINESTART
				RESTART
        ENDSELECT
        CLEARLINE LINECOUNT - LINESTART2
        GOTO SET_SLEEPWEAR
    CASE 2
        $SET_CASUALWEAR
        CALL SHOW_CLOTHES(C_ID, "今日の衣装")
		PRINTFORMDL Changing %CALLNAME:C_ID%'s casual wear.

        {
            CALL ASK_M(
                @"Reset %HIS_HER(C_ID)% casual wear to the default", 1,
                @"Change costume", 1,
                @"Select individual clothing pieces", 1,
                @"Return", 1)
        }

        SELECTCASE RESULT
            CASE 0
				PRINTFORMDW %HIS_HER(C_ID,1)% casual wear has been reset to the default.
                IF C_ID == MASTER
                    IF IS_MALE(C_ID)
                        CFLAG:C_ID:基本服装セット = 1
                    ELSE
                        CFLAG:C_ID:基本服装セット = 2
                    ENDIF
                ELSE
                    CFLAG:C_ID:基本服装セット = 100 + C_ID
                ENDIF
                CALL CHANGE_CLOTHES(C_ID, "衣装リセット") ;qol custom code
            CASE 1
				CALL COSPLAY_SET_TR(C_ID, "普段着")
            CASE 2
				CALL INDIVIDUAL_SELECT(C_ID, "普段着")
            CASE 3
				CLEARLINE LINECOUNT - LINESTART
				RESTART
        ENDSELECT
        CLEARLINE LINECOUNT - LINESTART2
        GOTO SET_CASUALWEAR
    CASE 3
		$SET_TEMPORARY
		CALL SHOW_CLOTHES(C_ID, "現在の衣装")
		PRINTFORML Temporarily change for %CALLNAME:C_ID%'s current clothes.

        {
            CALL ASK_M(
                @"Wear normal outfit", 1,
                @"Change costume", 1,
                @"Select individual clothing pieces", 1,
                @"Return", 1)
        }

        SELECTCASE RESULT
            CASE 0
				PRINTFORMW %CALLNAME:C_ID% put on %HIS_HER(C_ID)% regular outfit.
				CALL CTRL_CLOTHES_SET(C_ID, "現在衣装の変更_普段着")
            CASE 1
				CALL COSPLAY_SET_TR(C_ID, "現在の衣装")
            CASE 2
				CALL INDIVIDUAL_SELECT(C_ID, "現在の衣装")
            CASE 3
				CLEARLINE LINECOUNT - LINESTART
				RESTART
        ENDSELECT
        CLEARLINE LINECOUNT - LINESTART2
        GOTO SET_TEMPORARY
    CASE 4
        $SET_PANTY
        PRINTFORMDL %CALLNAME:C_ID%'s underwear:
		PRINTFORMDL Current underwear: %CLOTHES_TR(GET_STR(C_ID, "下半身下着_ずらし可能", EQUIP:C_ID:下半身下着２, "名前"),1)%
        PRINTFORMD Current favorite underwear: 

		SELECTCASE CFLAG:C_ID:指定パンツ
		CASE 0
			PRINTFORMDL Not set
		CASE 100
			PRINTFORMDL Nothing
        CASE 101
			PRINTFORMDL Selected daily
		CASEELSE
			PRINTFORMDL %CLOTHES_TR(GET_STR(C_ID, "下半身下着_ずらし可能", CFLAG:C_ID:指定パンツ, "名前"),1)%
		ENDSELECT
		PRINTFORML 

        {
            CALL ASK_M(
                @"Take them off", C_ID == MASTER ? 1 # -1,
                @"Set current as favorite", C_ID == MASTER ? -1 # 1,
                @"Select favorite underwear", C_ID == MASTER ? 1 # -1,
                @"Select current underwear", C_ID == MASTER ? 1 # -1,
                @"Reset favorite underwear", 1,
                @"Return", 1)
        }

        SELECTCASE RESULT
            CASE 0
				PRINTFORMDW You take off the currently worn underwear.
				EQUIP:C_ID:下半身下着２ = 100
            CASE 1
				PRINTFORMDW Current underwear set as favorite.
				CFLAG:C_ID:指定パンツ = EQUIP:C_ID:下半身下着２
				SIF !CFLAG:C_ID:指定パンツ
					CFLAG:C_ID:指定パンツ = 100
            CASE 2
                LINESTART3 = LINECOUNT
                $SET_FAVORITE
		        CLEARLINE LINECOUNT - LINESTART3

                PRINTFORMDL Select the type of underwear you want to select as your favorite:
                CALL QOL_PANTY_SELECTION_MENU(C_ID)
                PRINTL
                PRINTFORMDL [-4] - Select at the start of each day
                PRINTFORMDL [-3] - Select randomly
                PRINTFORMDL [-2] - None
                PRINTFORMDL [-1] - Cancel

                INPUT
                SELECTCASE RESULT
                    CASE -4
                        CFLAG:C_ID:指定パンツ = 101
                        PRINTFORMDW You will be asked every morning what kind of underwear you want to wear.
                    CASE -3
                        CFLAG:C_ID:指定パンツ = 0
                        PRINTFORMDW Your underwear will be randomly selected in the morning.
                    CASE -2
                        CFLAG:C_ID:指定パンツ = 100
                        PRINTFORMDW You will not put on any underwear in the morning.
                    CASE -1
                    CASEELSE
                        SIF !QOL_PANTY_VALID(C_ID, RESULT)
                            GOTO SET_FAVORITE
                        CFLAG:C_ID:指定パンツ = RESULT
                        PRINTFORMDW Your favorite underwear is now set to %CLOTHES_TR(GET_STR(C_ID, "下半身下着_ずらし可能", RESULT, "名前"),1)%.
                ENDSELECT
            CASE 3
                LINESTART3 = LINECOUNT
                $SET_CURRENT
		        CLEARLINE LINECOUNT - LINESTART3
                PRINTFORMDL Which underwear do you want to change into?
                ;TODO: change to use eraNAS menu
                CALL QOL_PANTY_SELECTION_MENU(C_ID)
                PRINTL
                PRINTFORMDL [-1] - Cancel

                INPUT
                SELECTCASE RESULT
                    CASE -1
                    CASEELSE
                        SIF !QOL_PANTY_VALID(C_ID, RESULT)
                            GOTO SET_FAVORITE
                        CFLAG:C_ID:きょうのぱんつ = RESULT
                        CFLAG:C_ID:206 = RESULT
                        LOCALS '= CLOTHES_TR(GET_STR(C_ID, "下半身下着_ずらし可能", RESULT, "名前"))
                        PRINTFORMDW You changed into \@ PLURAL_PANTIES(LOCALS) ? a pair of # a \@ %LOCALS%.
                ENDSELECT
            CASE 4
				PRINTFORMDW Favorite underwear has been reset.
				CFLAG:C_ID:指定パンツ = 0
            CASE 5
				CLEARLINE LINECOUNT - LINESTART
				RESTART
        ENDSELECT
        CLEARLINE LINECOUNT - LINESTART2
        GOTO SET_PANTY
ENDSELECT

;衣装セットのカテゴリ選択
@COSPLAY_SET_TR(C_ID, TYPE)
#DIM  C_ID
#DIM  SET_ID
#DIMS TYPE
#DIMS DYNAMIC CATEGORY
CALL SHOW_CLOTHES(C_ID, TYPE)
PRINTFORML Changing %CALLNAME:C_ID%'s %CLOTHES_TYPE_TR(TYPE)%
PRINTFORML Select costume type
PRINTFORML 

{
    CALL ASK_M(
        @"Normal costumes", 1,
        @"Cosplay costumes", 1,
        @"Special character costumes", 1,
        @"Imitate another character's wear", 1,
        @"Select individual clothing pieces", 1,
        @"Return", 1)
}

SELECTCASE RESULT
    CASE 0
		CATEGORY '= "基本衣装セット"
    CASE 1
		CATEGORY '= "コスプレ衣装セット"
    CASE 2
		CATEGORY '= "キャラ特殊衣装セット"
    CASE 3
        CALL COSPLAY_CHARA(C_ID, TYPE)
    ;NAS custom outfit
    CASE 4
        CALL INDIVIDUAL_SELECT(C_ID, TYPE)
    ;///////////////////
    CASE 5
        RETURN
ENDSELECT
SIF CATEGORY != ""
    CALL COSPLAY_SELECT(C_ID, TYPE, CATEGORY)
SIF !RESULT
    RESTART

@SHOW_ALL_CHARA_CLOTHES(C_ID)
#DIM  CONST CURRENT_OUTFIT = 0
#DIM  CONST TEMP_OUTFIT = 1
#DIM  CONST CASUAL_OUTFIT = 2
#DIM  CONST PAJAMA_OUTFIT = 3
#DIM  CONST FAVORITE_PANTY = 4
#DIM  CONST MAX_OUTFIT_TYPES = 5
#DIM  C_ID
#DIMS DYNAMIC OUTFITS, 5, 23
#DIM  DYNAMIC OUTFIT_PIECE_COUNT, 5
#DIM  DYNAMIC COLUMNS_FOR_DISPLAY, 3
#DIM  DYNAMIC MAX_COLUMN_WIDTH
#DIM  DYNAMIC DISPLAY_COLUMNS
#DIM  DYNAMIC PRINTED_COLUMN_COUNT
#DIM  ROW
#DIM  SACC_COLUMN

;current
CALL GET_CURRENT_CLOTHES(C_ID)
OUTFIT_PIECE_COUNT:CURRENT_OUTFIT = RESULT
FOR LOCAL, 0, VARSIZE("OUTFITS", 1)
    OUTFITS:CURRENT_OUTFIT:LOCAL '= RESULTS:LOCAL
NEXT
OUTFITS:CURRENT_OUTFIT:0 = Current clothes:

;temp
IF CFLAG:C_ID:衣装一時変更
    CALL GET_FULL_CLOTHES_SET(C_ID, CFLAG:C_ID:衣装一時変更)
    OUTFIT_PIECE_COUNT:TEMP_OUTFIT = RESULT
    FOR LOCAL, 0, VARSIZE("OUTFITS", 1)
        OUTFITS:TEMP_OUTFIT:LOCAL '= RESULTS:LOCAL
    NEXT
    OUTFITS:TEMP_OUTFIT:0 = Temporary set: %OUTFITS:TEMP_OUTFIT:0%
ENDIF

;normal wear
CALL GET_FULL_CLOTHES_SET(C_ID, CFLAG:C_ID:基本服装セット)
OUTFIT_PIECE_COUNT:CASUAL_OUTFIT = RESULT
FOR LOCAL, 0, VARSIZE("OUTFITS", 1)
    OUTFITS:CASUAL_OUTFIT:LOCAL '= RESULTS:LOCAL
NEXT
OUTFITS:CASUAL_OUTFIT:0 = Casual wear: %OUTFITS:CASUAL_OUTFIT:0%

;pajama
SELECTCASE CFLAG:C_ID:パジャマ指定
    CASE 301 ;underwear
        OUTFIT_PIECE_COUNT:PAJAMA_OUTFIT = 1
        OUTFITS:PAJAMA_OUTFIT:0 = Pajama set: Underwear
    CASE 302 ;nude
        OUTFIT_PIECE_COUNT:PAJAMA_OUTFIT = 1
        OUTFITS:PAJAMA_OUTFIT:0 = Pajama set: Nude
    CASEELSE
        CALL GET_FULL_CLOTHES_SET(C_ID, CFLAG:C_ID:パジャマ指定)
        OUTFIT_PIECE_COUNT:PAJAMA_OUTFIT = RESULT
        FOR LOCAL, 0, VARSIZE("OUTFITS", 1)
            OUTFITS:PAJAMA_OUTFIT:LOCAL '= RESULTS:LOCAL
        NEXT
        OUTFITS:PAJAMA_OUTFIT:0 = Pajama set: %OUTFITS:PAJAMA_OUTFIT:0%
ENDSELECT

OUTFIT_PIECE_COUNT:FAVORITE_PANTY = 1
SELECTCASE CFLAG:C_ID:指定パンツ
    CASE 0
        OUTFITS:FAVORITE_PANTY:0 = Current set underwear: N/A
    CASE 100
        OUTFITS:FAVORITE_PANTY:0 = Current set underwear: Nothing
    CASE 101
        OUTFITS:FAVORITE_PANTY:0 = Current set underwear: Selected daily
    CASEELSE
        OUTFITS:FAVORITE_PANTY:0 = Current set underwear: %UNDIES_NAME_WITH_BRAND(C_ID,CFLAG:C_ID:指定パンツ,1)%
ENDSELECT

;NAS: weapons
IF EQUIP:C_ID:Weapon
OUTFITS:FAVORITE_PANTY:0 '= @"Current weapon: %PrintWeaponName(C_ID,,1)%\n"+OUTFITS:FAVORITE_PANTY:0
ELSE
OUTFITS:FAVORITE_PANTY:0 '= @"Current weapon: Nothing\n"+OUTFITS:FAVORITE_PANTY:0
ENDIF


FOR LOCAL, 0, MAX_OUTFIT_TYPES
    FOR LOCAL:1, 0, 23
        MAX_COLUMN_WIDTH = MAX(MAX_COLUMN_WIDTH, STRLENS(OUTFITS:LOCAL:(LOCAL:1)))
    NEXT
NEXT
MAX_COLUMN_WIDTH += 4
DISPLAY_COLUMNS = MIN(MAXWIDTH() / (MAX_COLUMN_WIDTH), 3)
PRINTFORMDL %CALLNAME:C_ID%'s outfits:
PRINTL

VARSET COLUMNS_FOR_DISPLAY, -1
WHILE PRINTED_COLUMN_COUNT < MAX_OUTFIT_TYPES
    IF !OUTFIT_PIECE_COUNT:PRINTED_COLUMN_COUNT
        PRINTED_COLUMN_COUNT++
        SIF PRINTED_COLUMN_COUNT == MAX_OUTFIT_TYPES && COLUMNS_FOR_DISPLAY:0 > -1
            GOTO PRINT_COLUMNS
        CONTINUE
    ENDIF

    LOCAL = FINDELEMENT(COLUMNS_FOR_DISPLAY, -1)
    COLUMNS_FOR_DISPLAY:LOCAL = PRINTED_COLUMN_COUNT
    PRINTED_COLUMN_COUNT++
    SIF LOCAL < DISPLAY_COLUMNS - 1 && PRINTED_COLUMN_COUNT < MAX_OUTFIT_TYPES
        CONTINUE

    $PRINT_COLUMNS
    FOR ROW, 0, 23
        LOCALS =
        LOCAL = 0
        FOR SACC_COLUMN, 0, DISPLAY_COLUMNS
            SIF COLUMNS_FOR_DISPLAY:SACC_COLUMN < 0
                CONTINUE
            LOCALS += @"%OUTFITS:(COLUMNS_FOR_DISPLAY:SACC_COLUMN):ROW, MAX_COLUMN_WIDTH, LEFT%"
            SIF OUTFITS:(COLUMNS_FOR_DISPLAY:SACC_COLUMN):ROW != ""
                LOCAL = 1
        NEXT
        SIF !LOCAL
            BREAK
        PRINTFORML %LOCALS%
    NEXT
    PRINTL

    VARSET COLUMNS_FOR_DISPLAY, -1
WEND
WAIT


@GET_FULL_CLOTHES_SET(C_ID, SET_ID)
#DIM C_ID
#DIM SET_ID
#DIM CLOTHES
#DIM 装備部位
#DIMS 表示内容
#DIM DYNAMIC ARRAY_INDEX = 1
#DIM DYNAMIC IS_CHARA_SET
#DIM DYNAMIC IS_FAVORITE_SET

VARSET RESULTS
VARSET RESULT
IF SET_ID > 100 && SET_ID != 300
    IS_CHARA_SET = 1
    SET_ID = SET_ID - 100
ELSEIF SET_ID == 100
    ;old favorites system, only kept for compatibility
    IS_FAVORITE_SET = 1
ENDIF

IF IS_FAVORITE_SET
    LOCALS '= @"%CALLNAME:C_ID%'s favorite outfit"
ELSEIF SET_ID == 300
    LOCALS '= @"%CALLNAME:C_ID%'s custom outfit"
ELSEIF IS_CHARA_SET
    LOCALS '= @"%CALLNAME:SET_ID%'s outfit"
ELSE
    LOCALS '= GET_STR(C_ID, "衣装セット" , SET_ID, "名前")
ENDIF
SIF LOCALS == ""
    THROW Detected a reference to non-existent clothes {SET_ID}.

RESULTS:0 '= LISTING_TR(LOCALS)
FOR LOCAL, 1, 23
    ;装備部位のID取得
    装備部位 = FINDELEMENT(EQUIPNAME, 表示部位:LOCAL)
    SIF 装備部位 < 0
        THROW Non-Existent Equipment: %表示部位:LOCAL%
    IF IS_FAVORITE_SET
        CLOTHES = CFLAG:C_ID:(600 + 装備部位)
    ELSEIF IS_CHARA_SET
        CLOTHES = GET_INT(C_ID, "キャラデータ", SET_ID, @"普段着：%表示部位:LOCAL%")
    ELSE
        CLOTHES = GET_INT(C_ID, "衣装セット", SET_ID, 表示部位:LOCAL)
    ENDIF

    IF 表示部位:LOCAL == "下半身下着２"
        SIF IS_FAVORITE_SET || IS_CHARA_SET ;these don't have underwear attached
            CONTINUE
        SIF !GET_INT(C_ID, "衣装セット", SET_ID, "OVERRIDE_UNDERWEAR_BOTTOM")
            CONTINUE
    ENDIF
    IF !CLOTHES
        CONTINUE
    ELSE
        表示内容 '= CLOTHES_TR(GET_STR(C_ID, CLOTHES_PARTS_TO_CATEGORY(表示部位:LOCAL), CLOTHES, "名前"),1)
    ENDIF
    RESULTS:(ARRAY_INDEX++) = %表示ラベル:LOCAL%：%表示内容%
NEXT

RETURN ARRAY_INDEX

@GET_CURRENT_CLOTHES(C_ID)
#DIM  C_ID
#DIM  SET_ID
#DIM  装備部位
#DIM  CLOTHES
#DIMS 表示内容
#DIM DYNAMIC ARRAY_INDEX = 1

FOR LOCAL, 1, 23
    ;装備部位のID取得
    装備部位 = FINDELEMENT(EQUIPNAME, 表示部位:LOCAL)
    SIF 装備部位 < 0
        THROW Non-Existent Equipment: %表示部位:LOCAL%
    
    ;ノーブラ、ノーパン用の例外処理
    ;ここから
    IF 表示部位:LOCAL == "上半身下着１" && TALENT:C_ID:性別 != 2 && EQUIP:C_ID:上半身下着２ == 0 && EQUIP:C_ID:上半身下着１ == 0 && EQUIP:C_ID:ボディースーツ == 0 && EQUIP:C_ID:レオタード == 0 && EQUIP:C_ID:0
        IF 上半身下着表示(C_ID) == 1
            RESULTS:(ARRAY_INDEX++) '= "　Underwear(top)      [None]"
        ELSEIF 下半身下着表示(C_ID) == 1
            RESULTS:(ARRAY_INDEX++) '= " 　Underwear(top)      [？？？？？]"
        ENDIF
    ENDIF
    IF 表示部位:LOCAL == "下半身下着１" && EQUIP:C_ID:下半身下着２ == 0 && EQUIP:C_ID:下半身下着１ == 0 && EQUIP:C_ID:ボディースーツ == 0 && EQUIP:C_ID:レオタード == 0 && EQUIP:C_ID:0
        IF !上半身下着表示(C_ID) && !下半身下着表示(C_ID)
            RESULTS:(ARRAY_INDEX++) '= " 　Underwear           [？？？？？]"
            CONTINUE
        ELSEIF !下半身下着表示(C_ID)
            RESULTS:(ARRAY_INDEX++) '= " 　Underwear(bot)      [？？？？？]"
        ELSE
            RESULTS:(ARRAY_INDEX++) '= @" 　Underwear(bot)      [\@ CFLAG:C_ID:きょうのぱんつ == 0 || !CFLAG:C_ID:ノーパン ? None # Pilfered \@] "
        ENDIF
    ENDIF
    
    SIF !EQUIP:C_ID:装備部位 
        CONTINUE
    IF STRLENS(CSTR:C_ID:(50 + 装備部位)) && !CFLAG:C_ID:パジャマ && CSTR:C_ID:(50 + 装備部位) != "/" ;bug fix
        表示内容 '= CSTR:C_ID:(50 + 装備部位)
    ;パンツは専用処理が必要
    ELSEIF 表示部位:LOCAL == "上半身下着１" && !(C_ID == MASTER) && !上半身下着表示(C_ID)
        SIF !下半身下着表示(C_ID)
            CONTINUE
        表示内容 '= "？？？？？"
    ELSEIF 表示部位:LOCAL == "下半身下着２" && !(C_ID == MASTER) && !下半身下着表示(C_ID)
        IF !上半身下着表示(C_ID)
            RESULTS:(ARRAY_INDEX++) '= " 　Underwear           [？？？？？]"
            CONTINUE
        ELSE
            表示内容 '= "？？？？？"
        ENDIF
    ELSE
        IF 表示部位:LOCAL == "上半身下着１"
            表示内容 '= CAPITALIZE(BRANAME(EQUIP:C_ID:上半身下着１, C_ID))
        ELSEIF 表示部位:LOCAL == "下半身下着２"
            表示内容 '= CAPITALIZE(PANTSNAME(EQUIP:C_ID:下半身下着２, C_ID))
        ELSE
            表示内容 '= CAPITALIZE(CLOTHNAME(装備部位, EQUIP:C_ID:装備部位))
        ENDIF
    ENDIF
    
    RESULTS:(ARRAY_INDEX++) '= @"%表示ラベル:LOCAL%[%表示内容%]"
NEXT
RETURN ARRAY_INDEX

@EVENTLOAD
FOR LOCAL, 0, CHARANUM
    SIF CFLAG:LOCAL:おきにいり衣装
        CALL CTRL_CLOTHES_SET(LOCAL, "おきにいり衣装のリセット")
    IF CFLAG:LOCAL:基本服装セット == 100
        IF LOCAL == MASTER
            IF IS_MALE(LOCAL)
                CFLAG:LOCAL:基本服装セット = 1
            ELSE
                CFLAG:LOCAL:基本服装セット = 2
            ENDIF
        ELSE
            CFLAG:LOCAL:基本服装セット = 100 + LOCAL
        ENDIF
        PRINTFORMDL %CALLNAME:LOCAL%'s casual wear has been reset to the default.
    ENDIF
NEXT

@QOL_PANTY_SELECTION_MENU(C_ID)
#DIM C_ID
IF IS_MALE(C_ID)
    LOCAL:1 = CLOTHES_ID("下半身下着２", "トランクス")
    LOCAL:2 = CLOTHES_ID("下半身下着２", "ふんどし")
    LOCAL:3 = CLOTHES_ID("下半身下着２", "ブリーフ")

    FOR LOCAL, 1, 4
        PRINTFORMDL [{LOCAL:LOCAL, 2, RIGHT}] - %CLOTHES_TR(GET_STR(C_ID, "下半身下着_ずらし可能", LOCAL:LOCAL, "名前"),1)%
    NEXT
ELSE
    FOR LOCAL, 1, MAXPANTS
        SIF GROUPMATCH(LOCAL, 1, 18, 27, 28, 29, 30, 31, 32, 35, 36, 37, 38, 39) ;invalid options
            CONTINUE
        SIF HAS_PENIS(C_ID) && GROUPMATCH(LOCAL, 40)
            CONTINUE
        LOCALS '= GET_STR(C_ID, "下半身下着_ずらし可能", LOCAL, "名前")
        SIF LOCALS == ""
            CONTINUE
        PRINTFORMDL [{LOCAL, 2, RIGHT}] - %CLOTHES_TR(LOCALS,1)%
    NEXT
ENDIF

