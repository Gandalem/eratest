; Modular ERB: QOL/QoL_DishFilter.ERB

@DISH_SPECIAL_FILTER(SEARCH_INPUT, SEARCH_TYPE)
#FUNCTION
#DIMS DYNAMIC SEARCH_INPUT
#DIM DYNAMIC SEARCH_TYPE
SIF SEARCH_INPUT == "" || !SEARCH_TYPE
	RETURNF 1
IF SEARCH_TYPE == 1
	SIF STRFIND(TOLOWER(DISHNAME_TR(DISH_NAME)), TOLOWER(SEARCH_INPUT)) > -1
		RETURNF 1
ENDIF
RETURNF 0
