; Modular ERB: QOL/QoL_COM3.ERB
;fingering command is replaced by pounding with a vibrator when one is inserted

@COM3_Vibrator
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1
CSTR:TARGET:10 += @"{PLAYER}/"
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
TCVAR:TARGET:2 = 13
;強度
TCVAR:TARGET:4 = 1100
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70
	BASE:MASTER:TSP -= 30
	SOURCE:快Ｖ = 250
	SOURCE:苦痛 = 300
ELSE
	DOWNBASE:体力 += 30
	DOWNBASE:気力 += 30
	SOURCE:快Ｖ = 250
	SOURCE:苦痛 = 600
	SOURCE:露出 = 40
	SOURCE:逸脱 = 60
	SOURCE:反感 = 80
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 20
ENDIF
;Vへの苦痛は先に処理しておく
CALL PAIN_CHECK_V(TARGET)
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;挿入時はＶ経験+
EXP:Ｖ経験 ++
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF HETEROSEX(TARGET,PLAYER)
	SIF !FLAG:70
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
ENDIF
EXP:PLAYER:道具使用経験 ++
RETURN 1
;g spot tease with vibrator if "fingering" was the last action

@SCOM3_Vibrator
;-------------------------------------------------
