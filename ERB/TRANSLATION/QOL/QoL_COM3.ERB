	SOURCE:快Ｖ = 350
	SOURCE:苦痛 = 600
	SOURCE:露出 = 150
	SOURCE:逸脱 = 80
	SOURCE:反感 = 120
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 50
