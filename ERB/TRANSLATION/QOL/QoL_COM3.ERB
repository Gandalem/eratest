;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70
	BASE:MASTER:TSP -= 30
	SOURCE:快Ｖ = 350
	SOURCE:苦痛 = 300
ELSE
