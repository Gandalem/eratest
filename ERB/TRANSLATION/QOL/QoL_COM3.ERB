	SIF !FLAG:70
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
ENDIF
EXP:PLAYER:道具使用経験 ++
RETURN 1
;g spot tease for fingering when it was the last action

@SCOM3_Fingering
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽
TCVAR:PLAYER:108 = 1
;破瓜抑制
TFLAG:2 = 1
;強度
TCVAR:TARGET:4 = 500
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70
	BASE:MASTER:TSP -= 20
	IF TALENT:処女 || TALENT:処女 == -1
		SOURCE:快Ｖ = 160
		SOURCE:苦痛 = 30
	ELSE
		SOURCE:快Ｖ = 80
		SOURCE:苦痛 = 5
	ENDIF
	SIF TALENT:PLAYER:器用な指
		SOURCE:快Ｖ += 30
	SOURCE:快Ｖ += ABL:PLAYER:指 * 6
	;Vへの苦痛
	CALL PAIN_CHECK_V(TARGET)
	;奴隷の膣内⇔調教者の指の汚れが移動
	STAIN:6 |= STAIN:PLAYER:1
	STAIN:PLAYER:1 |= STAIN:6
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
	EXP:Ｖ経験 ++
	EXP:PLAYER:手淫経験 ++
ELSE
	DOWNBASE:体力 += 20
	DOWNBASE:気力 += 70
	IF TALENT:処女 || TALENT:処女 == -1
		SOURCE:快Ｖ = 200
		SOURCE:苦痛 = 15
		SOURCE:露出 = 30
		SOURCE:逸脱 = 40
		SOURCE:反感 = 30
		;V経験が0の時はV経験を伴わない物に派生
		;Vの珠は入らないが、快Vが高いと慣らしてあるため処女喪失時に影響
	ELSE
		SOURCE:快Ｖ = 100
		SOURCE:苦痛 = 10
		SOURCE:露出 = 60
		SOURCE:逸脱 = 50
		SOURCE:反感 = 50
	ENDIF
	SIF TALENT:PLAYER:器用な指
		SOURCE:快Ｖ += 30
	SOURCE:快Ｖ += ABL:PLAYER:指 * 6
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	IF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 40
		;処女
		SIF TALENT:処女
			SOURCE:鬱屈 += 20
	ENDIF
	;Vへの苦痛
	CALL PAIN_CHECK_V(TARGET)
	;-------------------------------------------------
	;汚れの処理
	;-------------------------------------------------
	;奴隷の膣内⇔調教者の指の汚れが移動
	STAIN:6 |= STAIN:PLAYER:1
	STAIN:PLAYER:1 |= STAIN:6
	;-------------------------------------------------
	;経験の処理
	;-------------------------------------------------
	;同性愛　レズなら戻り値1ゲイなら戻り値2
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
	EXP:Ｖ経験 ++
	EXP:PLAYER:手淫経験 ++
ENDIF
RETURN 1
