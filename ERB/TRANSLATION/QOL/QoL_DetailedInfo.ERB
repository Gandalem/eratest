@Qol_Info_ChildList(ARG, SHOW_ALL)
#DIM SHOW_ALL
#DIM CHILD_NUM
PRINTFORM 　• 임신 기간: {CFLAG:ARG:903}
;CFLAG:ARG:903 = 40
;PRINTL
;PRINTFORM 自覚 : {CFLAG:(ARG):910}
;PRINTL
;PRINTFORM 無自覚妊娠 : {CFLAG:ARG:無自覚妊娠}
PRINTL
PRINTFORML 현재 돌보고 있는 아이 수: {CFLAG:ARG:育児人数}명
PRINTFORML 육아에 현재 사용한 시간: {CFLAG:ARG:908}
PRINTFORML 아이 수: {CFLAG:ARG:子供人数}명
IF CFLAG:ARG:子供人数
	IF !SHOW_ALL
		FOR LOCAL,MAX(CFLAG:ARG:子供人数 - 5, 1),CFLAG:ARG:子供人数 + 1
		CHILD_NUM = CHILD_INDEX(LOCAL)
		IF CHILDNAME:ARG:CHILD_NUM != ""
			PRINTFORML %ORDINAL(LOCAL), 4%자식: %CHILDNAME:ARG:CHILD_NUM, 15, LEFT%　\@ CHILD_SEX:ARG:CHILD_NUM == 1 ? ♀ # ♂ \@ %PRINT_DATE_F(CHILD_BIRTHDAY:ARG:CHILD_NUM, 1)% (생일 {CHILD_BIRTHDAY:ARG:CHILD_NUM}) 태어남 %CHILD_WEATHER_TR(CHILD_WEATHER:ARG:CHILD_NUM)%. 애정: {CHILD_LOVE:ARG:CHILD_NUM}.
			PRINTFORM %BL(34)%
			CALL QoL_DetailedInfo(Qol_Info_Child, ARG, CHILD_NUM)
		ENDIF
		NEXT
		IF CFLAG:ARG:子供人数 > 5
			PRINTFORM 　
			PRINTBUTTON "[모든 아이 보기]", 9997
		ENDIF
	ELSE
		FOR LOCAL,MAX(CFLAG:ARG:子供人数 - MAXCHILD + 1, 1),CFLAG:ARG:子供人数 + 1
		CHILD_NUM = CHILD_INDEX(LOCAL)
		IF CHILDNAME:ARG:CHILD_NUM != ""
			PRINTFORML %ORDINAL(LOCAL), 4%자식: %CHILDNAME:ARG:CHILD_NUM, 15, LEFT%　\@ CHILD_SEX:ARG:CHILD_NUM == 1 ? ♀ # ♂ \@ %PRINT_DATE_F(CHILD_BIRTHDAY:ARG:CHILD_NUM, 1)% (생일 {CHILD_BIRTHDAY:ARG:CHILD_NUM}) 태어남 %CHILD_WEATHER_TR(CHILD_WEATHER:ARG:CHILD_NUM)%. 애정: {CHILD_LOVE:ARG:CHILD_NUM}.
			PRINTFORM %BL(34)%
			CALL QoL_DetailedInfo(Qol_Info_Child, ARG, CHILD_NUM)
		ENDIF
		NEXT
	ENDIF
ENDIF
