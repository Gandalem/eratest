@Qol_Info_Hours(ARG)
PRINT 활성 시간: 
IF CFLAG:ARG:神社在住 || CFLAG:MASTER:現在位置 == OMANEKIBEYA()
	CALL 滞在時間表示(ARG)
	PRINT 기상 시간: 
	CALL 起床時間表示(ARG)
ELSE
	CALL 滞在時間表示(ARG)
	IF CFLAG:ARG:2 >= 1500
		PRINT 깨어있는 시간: 
		CALL 起床時間表示(ARG)
	ENDIF
ENDIF

@Qol_Info_House(ARG)
IF CFLAG:ARG:自宅位置 && (STR:(CFLAG:ARG:自宅位置/ 10 + 6000) != "") && !CFLAG:ARG:神社在住
	LOCAL = CFLAG:ARG:自宅位置 / 10 + 6000
	PRINT 집: 
	;Custom code translation(added _TR) QoL(added the 'at' part)
	PRINTFORML %STR_TR(LOCAL)%이/가 %GET_MAPNAME(GET_MAPID(CFLAG:ARG:自宅位置))%에 있다.
ELSEIF CFLAG:ARG:神社在住
	PRINT 집: 
	;custom code QoL(added the part before the %GET_MAPNAME)
	PRINTFORML %STR_TR(((MAIN_MAP != 0) ? 8000 # 0) + CFLAG:ARG:神社在住)%가 %GET_MAPNAME(MAIN_MAP)%에서
ELSE
	PRINTL 홈: ■■■■■ 【 ■■■■■ 】
ENDIF

@Qol_Info_Dialogue(ARG)
RESULTS:1 =
CALL KOJO_ACTIVE_INFO(ARG)
SIF !RESULT
	RETURN
IF RESULT ;&& ((CFLAG:ARG:口上セレクタ == 0 && RESULTS:1 != "") || CFLAG:ARG:口上セレクタ)
	SIF CFLAG:ARG:口上セレクタ == 0 && RESULTS:1 == ""
		RESULTS:1 = Default
	LOCALS = Used dialogue: [{CFLAG:ARG:口上セレクタ}]\@ RESULTS:1 != "" ? %" " + CALLNAME:(NO:ARG)% %RESULTS:1% # \@
	CALL CHARACTER_DIALOG_STATUS(NO:ARG) ;addition custom code, duplicated characters
	IF STRLENS(RESULTS:(CFLAG:ARG:口上セレクタ))
		LOCALS:1 = (Translated By %RESULTS:(CFLAG:ARG:口上セレクタ)%)
	ELSE
		LOCALS:1 = (Translated By %RESULTS%)
	ENDIF
	SIF STRCOUNT(LOCALS:1, "Untranslated") || STRCOUNT(LOCALS:1, "Eng Dialogue") || STRCOUNT(LOCALS:1, "OC by") || STRCOUNT(LOCALS:1, "Original")
		LOCALS:1 '= REPLACE(LOCALS:1, "Translated By ", "")
	PRINTPLAINFORM %LOCALS%\@ STRLENS(RESULTS) ? %" "%%LOCALS:1%#\@
ENDIF

@Qol_Info_AverageFavor
#DIM TE_TOTAL
#DIM TE_COUNT
#DIM TE_AVERAGE
TE_COUNT = 0
TE_TOTAL = 0
FOR LOCAL, 1, CHARANUM
TE_TOTAL += CFLAG:LOCAL:好感度
TE_COUNT += 1
NEXT
TE_TOTAL = TE_TOTAL / TE_COUNT
TE_AVERAGE = TE_TOTAL * CHARANUM
TE_AVERAGE = TE_AVERAGE / DAY
PRINTFORML 평균 호의: {TE_TOTAL}
PRINTFORML 하루당 얻는 평균 호의: %PRINT_PLUR("day", DAY)% 동안 {TE_AVERAGE}

