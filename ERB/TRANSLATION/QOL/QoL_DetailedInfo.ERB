; Modular ERB: QOL/QoL_DetailedInfo.ERB
;detailed info for print_state2

@QoL_DetailedInfo(nType = -1, ARG:1, ARG:2)
#DIM nType
SELECTCASE nType
	CASE Qol_Info_Dates
		CALL Qol_Info_Dates(ARG:1)
	CASE Qol_Info_House
		CALL Qol_Info_House(ARG:1)
	CASE Qol_Info_Hours
		CALL Qol_Info_Hours(ARG:1)
	CASE Qol_Info_Dialogue
		CALL Qol_Info_Dialogue(ARG:1)
	CASE Qol_Info_Child
		CALL Qol_Info_Child(ARG:1, ARG:2)
		;CASE Qol_Info_Penis
		;	CALL Qol_Info_Penis(ARG:1, ARG:2)
	CASEELSE
		PRINTFORML QoL_DetailedInfo 오류 - 인식할 수 없는 {nType}이다!
ENDSELECT

@Qol_Info_Child(ARG, ARG:1)
;age in days
A = DAY + ((StartingYear)*YearLength) - CharaAge:(ARG:1):2
IF A < YearLength
	PRINTFORM %TOSTR_LifeStage(CharaAge:(ARG:1):0)%
	LOCALS:0 = 
	SELECTCASE A
		CASE IS < CHILD_離乳
			LOCALS:0 = 보살핌을 받고 모유 수유를 받았다.
		CASE IS  < CHILD_玩具
			LOCALS:0 = 이유식, 고형 음식에 익숙해지는 과정이다.
		CASE IS  < CHILD_つかまり立ち
			LOCALS:0 = 첫 번째 장난감과 놀고 있다.
		CASE IS  < CHILD_よちよち
			LOCALS:0 = 서서 걷는 것을 배우기.
		CASE IS  < CHILD_喋る
			LOCALS:0 = 걸어 다니고 탐험한다.
		CASE IS  < CHILD_語彙
			LOCALS:0 = 첫 단어들, 말하기를 배우는 것.
		CASE IS  < CHILD_しつけ
			LOCALS:0 = 말하기를 연습하고 발전시킨다.
		CASE IS  < CHILD_就学
			LOCALS:0 = 단련되고 예의를 가르침.
		CASE IS  < CHILD_自立前
			LOCALS:0 = 학교에 다닌다.
		CASE IS  < CHILD_自立-3
			LOCALS:0 = 자라면서 독립하는 법을 배운다.
		CASEELSE
			LOCALS:0 = 성인이 되기 직전이다.
	ENDSELECT
	PRINTFORML ({A}). 현재: %LOCALS:0%
ELSE
	PRINTFORML 현재 {CharaAge:(ARG:1):0}세이다. \@ A / YearLength > 0 ? %PRINT_PLUR("year", (DAY - CHILD_BIRTHDAY:(ARG:1):LOCAL) / YearLength)% 독립 이후부터 # 올해 독립했다 \@.
	; PRINTFORM Currently {14 + (DAY - CHILD_BIRTHDAY:ARG:LOCAL) / 124} years old. \@ (DAY - CHILD_BIRTHDAY:ARG:LOCAL) / 124 > 0 ? %PRINT_PLUR("year", (DAY - CHILD_BIRTHDAY:ARG:LOCAL) / 124)% since independence # Became independent this year\@.
	; SIF GET_MAPID(CHILD_AREA:ARG:LOCAL) != MAIN_MAP ;exclude main map for now as children cannot appear there
	; 	PRINTFORM  Lives at %STR_TR(6000 + (CHILD_AREA:ARG:LOCAL / 10))%.
	; PRINTL
ENDIF
