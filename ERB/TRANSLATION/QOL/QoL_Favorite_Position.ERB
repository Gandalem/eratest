;matches the requested favorite position number to its associated exp index
@QOL_FAV_POSITION_TO_EXP(ARG)
#FUNCTION
IF INRANGE(ARG, 1, 10) ;v+a normal poses
    RETURNF 100 + ARG
ELSEIF INRANGE(ARG, 11, 15) ;double penetration normal poses
    RETURNF 180 + ARG - 10
ELSEIF ARG == 16 ;inchling onahole
    RETURNF 191
ELSEIF ARG == 17 ;reverse cowgirl
    RETURNF 192
ELSE ;added poses
    RETURNF 100 + ARG ;effectively starts from 151
ENDIF

;returns the pose associated with the favorite position number
@QOL_FAV_POSITION_TO_POSE(ARG)
#FUNCTION
SELECTCASE ARG
    CASE 1 TO 5 ;v normal
        RETURNF ARG
    CASE 6 TO 10 ;a normal
        RETURNF ARG - 5
    CASE 11 TO 15 ;dp normal
        RETURNF ARG - 10
    CASE 16 ;inchling
        RETURNF POSE_ONAHOLE
    CASE 17 ;rev cowgirl
        RETURNF POSE_REV_COWGIRL
    CASE 51 TO 55 ;v standing
        RETURNF ARG - 43
    CASE 56 TO 60 ;a standing
        RETURNF ARG - 48
    CASE 61 TO 65 ;dp standing
        RETURNF ARG - 53
    CASE 66
        RETURNF POSE_STANDING_ONAHOLE
ENDSELECT

;returns the position number for the character's current pose
@QOL_FAV_POSITION_CHECK(ARG)
#FUNCTION
IF TEQUIP:ARG:体位 > 6 ;added poses
    IF TEQUIP:ARG:Ｖセックス > -1 && TEQUIP:ARG:Ａセックス > -1 ;dp
        RETURNF 60 + TEQUIP:ARG:体位 - 7
    ELSEIF TEQUIP:ARG:体位 == POSE_STANDING_ONAHOLE
        RETURNF 66
    ELSEIF TEQUIP:ARG:Ｖセックス > -1
        RETURNF 50 + TEQUIP:ARG:体位 - 7
    ELSEIF TEQUIP:ARG:Ａセックス > -1
        RETURNF 55 + TEQUIP:ARG:体位 - 7
    ENDIF
ELSE
    IF TEQUIP:ARG:Ｖセックス > -1 && TEQUIP:ARG:Ａセックス > -1 ;dp
        RETURNF 10 + TEQUIP:ARG:体位
    ELSEIF TEQUIP:ARG:体位 == POSE_ONAHOLE
        RETURNF 16
    ELSEIF TEQUIP:ARG:体位 == POSE_REV_COWGIRL
        RETURNF 17
    ELSEIF TEQUIP:ARG:Ｖセックス > -1
        RETURNF 0 + TEQUIP:ARG:体位 ;v
    ELSEIF TEQUIP:ARG:Ａセックス > -1
        RETURNF 5 + TEQUIP:ARG:体位 ;a
    ENDIF
ENDIF
RETURNF 0

