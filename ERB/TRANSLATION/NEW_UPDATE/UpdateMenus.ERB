; Modular ERB: NEW_UPDATE/UpdateMenus.ERB

@Update_Menu
#DIM nLineCnt_Head
#DIMS FormerNames, 20
LOADGLOBAL
FOR LOCAL, 0, 100
PRINTL
NEXT
PRINTFORML 업데이트 메뉴 2: 슈퍼 하이퍼 울트라 얼티밋 디럭스 퍼펙트 어메이징 샤이닝 고 신 유파 동방불패
CUSTOMDRAWLINE -
nLineCnt_Head = LINECOUNT
REDRAW 0
;bring all names from csv for them to get translated via (formerly) trchara
FOR LOCAL, 0, CHARANUM
SIF EXISTCSV(LOCAL) < 1 ;failsafe
	CONTINUE
SIF CFLAG:LOCAL:出禁 == 2 || TALENT:LOCAL:BornChild || TALENT:LOCAL:CustomChara ;skip randos
	CONTINUE
;not character ID 0
IF LOCAL
	FOR N, 0, VARSIZE("nameArray")
	FormerNames:N '= nameArray:LOCAL:N
	NEXT
	CALL IndividualNameSet(LOCAL)
	FOR N, 0, VARSIZE("nameArray")
	SIF FormerNames:N != nameArray:LOCAL:N
		SETBIT UpdateForceShow:LOCAL, 1
	nameArray:LOCAL:N '= FormerNames:N
	NEXT
	IF nameArray:LOCAL:na_Name != ""
		;set name
		NAME:LOCAL '= nameArray:LOCAL:na_Name
		;set callname
		CALLNAME:LOCAL '= nameArray:LOCAL:na_Callname
	ELSE
		NAME:LOCAL = %CSVNAME(LOCAL)%
		CALLNAME:LOCAL = %CSVCALLNAME(LOCAL)%
	ENDIF
ENDIF
;endurance adjustments
;these stats are grabbed from TRANSLATION/OMOGATARI/Omogatari_Set.erb
IF !GETBIT(CFLAG:LOCAL:OmoStatsDone,0)
	CALL SetOmoStats(LOCAL)
ELSE
	CALL SetOmoStats_Update(LOCAL)
ENDIF
;reset name back to the namechecker one.
NAME:LOCAL = %NameChecker(LOCAL)%
NEXT
DO
SIF LINECOUNT - nLineCnt_Head > 0
	CLEARLINE LINECOUNT - nLineCnt_Head
CALL UPDATE_STATE
SELECTCASE RESULT
	CASE 0
		SAVEGLOBAL
		RETURN
	CASEELSE
ENDSELECT
LOOP 1

