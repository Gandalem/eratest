; Modular ERB: NEW_UPDATE/NAS Factions.ERB

@UPDATE_PAGE_3(NASP3_PAGE)
#DIM NASP3_PAGE
#DIMS NASP3_OPTION
#DIMS NASP3_DESC
VARSET NASP3_OPTION
VARSET NASP3_DESC
NASP3_OPTION '= @"[300] 모든 세력을 초기화한다"
NASP3_DESC '= @"※모든 세력을 기본 설정으로 초기화한다. 세력에 대한 캐릭터의 호감도에는 영향을 주지 않는다.\n"
NASP3_DESC += @"특별히 필요 없다. 파벌을 초기화하거나 새 게임을 시작하는 경우가 아니라면 말이다."
HTML_PRINT HTML_PRINT_NAS(NASP3_OPTION,NASP3_DESC,,,,300)
NASP3_OPTION '= @"[301] 모든 진영 유닛 초기화한다."
NASP3_DESC '= @"모든 진영 유닛을 기본 상태로 초기화한다."
HTML_PRINT HTML_PRINT_NAS(NASP3_OPTION,NASP3_DESC,,,,301)
NASP3_OPTION '= @"[302] 진영을 초기화한다 "
NASP3_DESC '= @"※세력을 기본값으로 초기화한다. 세력에 대한 캐릭터의 친밀도에는 영향을 주지 않는다\n"
NASP3_DESC += @"특별히 필요 없다. 파벌을 초기화하거나 새 게임을 시작하는 경우가 아니라면 말이다."
HTML_PRINT HTML_PRINT_NAS(NASP3_OPTION,NASP3_DESC,,,,302)

@UPDATE_INPUT_3(nInput, SelectionMode, Update_Selected)
#DIM nInput
#DIM C_ID
#DIM REF SelectionMode
#DIM REF Update_Selected
#DIM UNAS_ABL_NO
#DIM UNAS_ABL
SELECTCASE nInput
	CASE 300
		PRINTFORML 정말로 확실한가?
		PRINTFORML 이것은 모든 진영을 기본값으로 되돌릴 것이다!
		PRINTFORML 모든 진영의 진행 상황이 사라지며, 유닛과 연구도 기본값으로 초기화된다.
		CALL ASK_YN
		SELECTCASE RESULT
			CASE 0
				CALL CLEAR_ALL_FACTION_DATA
				CALL INIT_FACTIONS
				PRINTFORMW 진영이 초기화되었다.
		ENDSELECT
	CASE 301
		PRINTFORML 정말로 확실한가?
		PRINTFORML 이것은 모든 진영 유닛을 기본 상태로 초기화할 것이다.
		CALL ASK_YN
		SELECTCASE RESULT
			CASE 0
				FOR LOCAL,0,MaxFactions
				CALL CLEAR_FACTION_UNITS(LOCAL)
				CALL ADDFACTION_INIT_UNITS(LOCAL)
				NEXT
				PRINTFORMW 진영 유닛들이 초기화되었다.
		ENDSELECT
	CASE 302
		PRINTFORML 초기화할 진영을 선택하라. 
		FOR LOCAL,0,MaxFactions
		SIF !STRLENS(FactionName(LOCAL))
			CONTINUE
		PRINTFORML [{LOCAL,3}] - %FactionName(LOCAL)%
		NEXT
		INPUT
		PRINTL
		PRINTFORML [999] - 취소
		LOCAL = RESULT
		SELECTCASE RESULT
			CASE 0 TO MaxFactions
				PRINTFORML 정말로 재설정하시겠습니까 (ID {LOCAL})
		ENDSELECT
ENDSELECT

@CLEAR_ALL_FACTION_DATA
DT_RELEASE "FactionUnits"
FOR LOCAL,0,MaxFactions
IF LOCAL == 99
	PRINTFORML 플레이어의 진영도 지우고 싶으신가요?
	CALL ASK_YN()
	SIF RESULT
		CONTINUE
ENDIF
CALL CLEAR_FACTION_DATA(LOCAL)
NEXT
VARSET FacionPropagandaSign, -1

@CLEAR_FACTION_DATA(nFaction)
#DIM nFaction
#DIM nFOneMore
nFOneMore = nFaction+1
VARSET FactionNames          ,"",nFaction,nFOneMore
VARSET FactionAbbreviation   ,"",nFaction,nFOneMore
VARSET FactionMemberName     ,"",nFaction,nFOneMore
VARSET FactionReligion       ,0 ,nFaction,nFOneMore
VARSET FactionDisabled       ,0 ,nFaction,nFOneMore
VARSET FactionWealth         ,0 ,nFaction,nFOneMore
;can't use VARSET for these
FOR LOCAL,0,VARSIZE("FactionUnits",1)
FactionUnits:nFaction:LOCAL = 0
NEXT
FOR LOCAL,0,VARSIZE("FactionTeamFame",1)
FactionTeamFame:nFaction:LOCAL = 0
NEXT
FOR LOCAL,0,VARSIZE("FactionTeamInfamy",1)
FactionTeamInfamy:nFaction:LOCAL = 0
NEXT
FOR LOCAL,0,VARSIZE("FactionWarring",1)
FactionWarring:nFaction:LOCAL = 0
NEXT
FOR LOCAL,0,VARSIZE("FactionWarringAreas",1)
FactionWarringAreas:nFaction:LOCAL = 0
NEXT
FOR LOCAL,0,VARSIZE("FactionAreaControl",1)
FactionAreaControl:nFaction:LOCAL = 0
NEXT
VARSET FactionNonMemberFame  ,0 ,nFaction,nFOneMore
VARSET FactionNonMemberInfamy,0 ,nFaction,nFOneMore
VARSET FactionPatrolArea     ,0 ,nFaction,nFOneMore
VARSET FactionTech           ,0 ,nFaction,nFOneMore
FOR LOCAL,0,VARSIZE("FactionMainArea")
SIF FactionMainArea:LOCAL == nFaction
	FactionMainArea:LOCAL = -1
NEXT
CALL CLEAR_FACTION_UNITS(nFaction)
CALL CLEAR_FACTION_RESEARCH(nFaction)

@CLEAR_ALL_FACTION_UNITS
FOR LOCAL,0,MaxFactions
CALL CLEAR_FACTION_UNITS(LOCAL)
NEXT

@CLEAR_FACTION_UNITS(nFaction)
#DIM nFaction
#DIM CFD_TOTAL
#DIM CFD_ARRAY, 100
;units
CFD_TOTAL = DT_SELECT("FactionUnits", @"faction = {nFaction}", "", CFD_ARRAY)
FOR LOCAL,0,CFD_TOTAL
SIF DT_CELL_GET("FactionUnits", CFD_ARRAY:LOCAL, "faction",1) == nFaction
	DT_ROW_REMOVE "FactionUnits", CFD_ARRAY:LOCAL
NEXT

@CLEAR_FACTION_RESEARCH(nFaction)
#DIM nFaction
;units
$LOOP
FOR LOCAL,0,DT_ROW_LENGTH("ResearchProgress")
IF DT_CELL_GET("ResearchProgress", LOCAL, "faction") == nFaction
	DT_ROW_REMOVE "ResearchProgress", DT_CELL_GET("ResearchProgress", LOCAL, "id")
	; go back to the start of the loop
	; we don't want to go to a null pointer.
	GOTO LOOP
ENDIF
NEXT
