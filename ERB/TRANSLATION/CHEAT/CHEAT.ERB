#DIM DYNAMIC GrowthStage
#DIM DYNAMIC GrowthNewLength
#DIM DYNAMIC GrowthDifference
$TOP
PRINTFORMDL
CALL COLORMESSAGE(@"경고: 이 설정은 기존 자녀들의 연령을 변경합니다!",C_YELLOW,1,1)
PRINTFORMDL
PRINTFORMDL [0] "모유 수유" 단계 길이: {CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(0)-1} %PLNOUN("day",CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(0)-1)%
PRINTFORMDL [1] "이유식 중단" 단계 길이: {CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(1)} %PLNOUN("day",CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(1))%
PRINTFORMDL [2] "장난감 가지고 놀기" 단계 길이: {CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(2)} %PLNOUN("day",CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(2))%
PRINTFORMDL [3] "걷는 법 배우기" 단계 길이: {CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(3)} %PLNOUN("day",CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(3))%
PRINTFORMDL [4] "걷기" 단계 길이: {CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(4)} %PLNOUN("day",CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(4))%
PRINTFORMDL [5] "말하기 배우기" 단계 길이: {CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(5)} %PLNOUN("day",CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(5))%
PRINTFORMDL [6] "언어 발달" 단계 길이: {CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(6)} %PLNOUN("day",CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(6))%
PRINTFORMDL [7] "예절 배우기" 단계 길이: {CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(7)} %PLNOUN("day",CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(7))%
PRINTFORMDL [8] "학교 다니기" 단계 길이: {CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(8)} %PLNOUN("day",CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(8))%
PRINTFORMDL [9] "독립심 배우기" 단계 길이: {CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(9)} %PLNOUN("day",CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(9))%
PRINTFORMDL
PRINTFORMDL [10] 모든 것을 기본값으로 초기화한다.
PRINTFORMDL
PRINTFORMDL [11] 반환
INPUT
GrowthStage = RESULT
SELECTCASE GrowthStage
	CASE IS < 0
		GOTO TOP
	CASE IS < 10
		PRINTFORMDL 일수 단위로 입력한다. (최소 1)
		INPUT
		GrowthNewLength = RESULT
		SIF GrowthStage == 0
			GrowthNewLength++
		IF GrowthNewLength > 0
			GrowthDifference = (CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(GrowthStage)-GrowthNewLength)*-1
			FOR LOCAL,GrowthStage,10
			CALL CHEAT_CHILD_GROWTH_SPEED_SET_STAGE_LENGTH(LOCAL,CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(LOCAL)+GrowthDifference)
			NEXT
		ELSE
			PRINTFORMDW 잘못된 입력입니다.
		ENDIF
		GOTO TOP
	CASE 10
		CHILD_離乳 = 10
		CHILD_玩具 = 11
		CHILD_つかまり立ち = 13
		CHILD_よちよち = 15
		CHILD_喋る = 20
		CHILD_語彙 = 25
		CHILD_しつけ = 30
		CHILD_就学 = 35
		CHILD_自立前 = 90
		CHILD_自立 = 120
		GOTO TOP
	CASE 11
	CASEELSE
		GOTO TOP
ENDSELECT

@CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(ARG)
;Returns the length of the specified childhood growth stage by subtracting its start date from that of the next stage.
#FUNCTION
SELECTCASE ARG
	CASE 0
		;Breastfeeding.
		RETURNF CHILD_離乳
	CASE 1
		;Weaning.
		RETURNF CHILD_玩具-CHILD_離乳
	CASE 2
		;Playing with toys.
		RETURNF CHILD_つかまり立ち-CHILD_玩具
	CASE 3
		;Learning to walk.
		RETURNF CHILD_よちよち-CHILD_つかまり立ち
	CASE 4
		;Walking.
		RETURNF CHILD_喋る-CHILD_よちよち
	CASE 5
		;Learning to talk.
		RETURNF CHILD_語彙-CHILD_喋る
	CASE 6
		;Developing speech.
		RETURNF CHILD_しつけ-CHILD_語彙
	CASE 7
		;Learning manners.
		RETURNF CHILD_就学-CHILD_しつけ
	CASE 8
		;Attending school.
		RETURNF CHILD_自立前-CHILD_就学
	CASE 9
		;Learning to be independent.
		RETURNF CHILD_自立-CHILD_自立前
ENDSELECT

@CHEAT_CHILD_GROWTH_SPEED_SET_STAGE_LENGTH(ARG,ARG:1)
;Sets the length of the stage given as ARG to the value given as ARG:1 by changing the start date of the stage after it.
SELECTCASE ARG
	CASE 0
		;Breastfeeding.
		CHILD_離乳 = ARG:1
	CASE 1
		;Weaning.
		CHILD_玩具 = CHILD_離乳+ARG:1
	CASE 2
		;Playing with toys.
		CHILD_つかまり立ち = CHILD_玩具+ARG:1
	CASE 3
		;Learning to walk.
		CHILD_よちよち = CHILD_つかまり立ち+ARG:1
	CASE 4
		;Walking.
		CHILD_喋る = CHILD_よちよち+ARG:1
	CASE 5
		;Learning to talk.
		CHILD_語彙 = CHILD_喋る+ARG:1
	CASE 6
		;Developing speech.
		CHILD_しつけ = CHILD_語彙+ARG:1
	CASE 7
		;Learning manners.
		CHILD_就学 = CHILD_しつけ+ARG:1
	CASE 8
		;Attending school.
		CHILD_自立前 = CHILD_就学+ARG:1
	CASE 9
		;Learning to be independent.
		CHILD_自立 = CHILD_自立前+ARG:1
ENDSELECT

