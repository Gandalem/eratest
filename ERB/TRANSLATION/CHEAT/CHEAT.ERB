		ELSE
			LOCALS:1 = …
			SETCOLOR 150,150,150
		ENDIF
		LOCALS += LOCALS:1
	ENDSELECT
	PRINTFORM %LOCALS,50,LEFT%
	LOCAL:1 ++
	SIF LOCAL:1 % 2 == 0
