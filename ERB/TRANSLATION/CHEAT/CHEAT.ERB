			SETCOLOR 150,150,150
		ELSE
			SETCOLOR C_AQUA
		ENDIF
		LOCALS = [{LOCAL,3}] - %TALENT_TR(LOCAL)%
	;量的素質
	CASEELSE
		$SELECT
		IF !TALENT:ARG:LOCAL
			SETCOLOR 150,150,150
		ELSE
			SETCOLOR C_AQUA
		ENDIF
		LOCALS =  [{LOCAL,3}] - %TALENT_TR(LOCAL)%
