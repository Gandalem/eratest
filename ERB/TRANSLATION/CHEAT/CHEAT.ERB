	SELECTCASE TALENTNAME:LOCAL
	;TALENT.CSVに登録されていない
	CASE ""
		CONTINUE
	;オンオフ型の素質(TALENTNAMEと素質表示が一致)
	CASE GET_TALENTNAME(LOCAL,1)
		SIF GROUPMATCH(LOCAL, 108, 143, 162, 164, 185, 190, 191, 193, 194, 196, 197, 198, 220, 225, 274, 295, 297) ;exceptions
