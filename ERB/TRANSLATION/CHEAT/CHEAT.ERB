; Modular ERB: CHEAT/CHEAT.ERB

@CHEAT_MENU
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
DRAWLINE
SETCOLOR C_RED
PRINTL 치트 메뉴
PRINTL   ◎ 디버그 옵션을 건드리면 게임이 망가질 수 있습니다.
PRINTL   ◎ 치트를 남용하면 게임의 재미를 해칠 수 있습니다.
PRINTL   위의 내용을 이해한 경우에만 사용해 주십시오.
RESETCOLOR
PRINTL
PRINTFORML [ 0] 돈 설정하기
PRINTFORML [ 1] 팬티 얻기
PRINTFORML [ 2] 하루가 끝날 때 상세 임신 확률 표시하기: \@ FLAG:PREG_SHOW_PROB ? ON # OFF \@
PRINTFORML [ 3] 임신 확률 배율: x{FLAG:PREG_PROB_MULT == 0 ? 1 # FLAG:PREG_PROB_MULT}
;tweaked to make this option actually works
PRINTFORML [ 4] 튜토리얼 텍스트의 속도를 변경한다.
PRINTL
PRINTL [10] 캐릭터 편집하기
PRINTL [11] 캐릭터 편집하기 (더 많은 커스터마이징 제공)
PRINTL [12] 캐릭터 초기화
PRINTL
LOCALS:2 =
IF !FLAG:甲斐性無 && !FLAG:LUSTMODE
	LOCALS:2 '= @"꺼짐"
ELSEIF FLAG:甲斐性無 && !FLAG:LUSTMODE
	LOCALS:2 '= @"무능한 모드 x{FLAG:甲斐性無}"
ELSEIF FLAG:甲斐性無 && FLAG:LUSTMODE
	LOCALS:2 '= @"욕망 모드 x{FLAG:甲斐性無}"
ELSE
	LOCALS:2 '= @"에러"
ENDIF
PRINTFORML [30] 무능/욕망 모드 토글 (현재: %LOCALS:2%)
PRINTFORML [32] 시간 압축 토글 (현재: \@ FLAG:TIME_COMPRESSION ? ON # OFF \@)
PRINTL
;ERANAS CUSTOMS
LOCALS:1 =
IF FLAG:POSTAL == -1
	LOCALS:1 '= @"리버모드"
ELSEIF !FLAG:POSTAL
	LOCALS:1 '= @"정상"
ELSEIF FLAG:POSTAL == 1
	LOCALS:1 '= @"헤스턴월드"
ELSEIF FLAG:POSTAL == 2
	LOCALS:1 '= @"광기-0"
ELSEIF FLAG:POSTAL == 3
	LOCALS:1 '= @"그들은 나를 싫어한다"
ELSEIF FLAG:POSTAL == 4
	LOCALS:1 '= @"우편"
ENDIF
PRINTFORML [33] 우편 모드 변경하기 (현재: %LOCALS:1%)
PRINTL
LOCALS:0 =
IF PermaDeath == -1
	LOCALS:0 '= @"모두 리스폰"
ELSEIF !PermaDeath
	LOCALS:0 '= @"정상"
ELSEIF PermaDeath == 1
	LOCALS:0 '= @"리스폰 없음"
ELSEIF PermaDeath == 2
	LOCALS:0 '= @"영구적"
ENDIF
PRINTFORML [34] 영구 사망 모드 변경 (현재: %LOCALS:0%)
;//////////////
PRINTL
PRINTFORML [50] 캐릭터 속성 변경하기 (모두 처녀, 후타 등으로 만들기)
PRINTL
PRINTFORML [60] 임신 정보
;Disabled starting from 4.943 due to implemented by the upstream, check commit history when needed
;PRINTFORML [62] Set pregnancy speed (Currently: \@FLAG:PREG_SPEED? {FLAG:PREG_SPEED}x # 1x\@)
PRINTFORML [63] 자식 성장 속도 설정
PRINTL
PRINTFORML [70] 카리스마는 실시간 일자를 사용하여 코스를 계산한다(현재: \@ FLAG:CHARISMA_INGAME_DAY ? ON # OFF \@). 게임 내 사용은 권장되지 않는다.
PRINTL
PRINTFORML [80] 아이템 편집
;custom code: Debug
PRINTL [90] 게임 내 디버그 메뉴를 연다
PRINTL
PRINTL [99] 나가기
INPUT
SELECTCASE RESULT
	CASE 0
		PRINTL
		PRINTFORML 원하는 돈 레벨을 입력해 주세요. (현재 보유 금액은 ¥{MONEY}입니다.)
		INPUT
		IF RESULT < 0
			PRINTFORML 미안하지만 당신이 빚진 채로 있는 걸 보고 싶지 않아.
			GOTO REPRINT
		ELSE
			MONEY = RESULT
			PRINTFORML 자, 이제 당신은 %金額表示(MONEY)%를 소지하게 되었습니다.
		ENDIF
	CASE 1
		LOCAL = FLAG:700
		CALL ROLL_PANTIES
		LOCAL = (LOCAL - FLAG:700) * -1
		PRINTFORMW 날씨가 가장 이상해 보인다, 갑자기 {LOCAL} 팬티가 폭우처럼 쏟아졌다.
	CASE 2
		FLAG:PREG_SHOW_PROB = !FLAG:PREG_SHOW_PROB
	CASE 3
		PRINTL
		PRINTFORML 임신 배율(또는 목록에 없는 다른 숫자)을 입력하라.
		PRINTFORML [  1]    x1
		PRINTFORML [ 10]   x10
		PRINTFORML [ 50]   x50
		PRINTFORML [100]  x100
		INPUT
		IF RESULT > 0
			FLAG:PREG_PROB_MULT = RESULT
		ENDIF
	CASE 4
		;tweaked to make this option actually works
		CALL ASK_YN("즉시", "정상")
		IF !RESULT
			PRINTFORMW 튜토리얼 텍스트 지연이 이제 제거되었다.
			FLAG:TUTORIAL_INITIAL_D = 1
		ELSE
			PRINTFORMW 튜토리얼 텍스트가 의도한 대로 작동한다.
			FLAG:TUTORIAL_INITIAL_D = 0
		ENDIF
	CASE 10
		CALL CHEAT_EDIT_CHARA
	CASE 11
		CALL CHEAT_EDIT_CHARA_MULTI
	CASE 12
		CALL CHEAT_EDIT_CHARARESET
	CASE 30
		IF !FLAG:甲斐性無 && !FLAG:LUSTMODE
			FLAG:甲斐性無 = 1
			PRINTFORML 무능력 모드가 켜졌다
			PRINTFORMW 당신은 이제 %PARSE("have")% 연약한 성격을 가졌지만 다른 캐릭터들은 더 공격적이다.
		ELSEIF FLAG:甲斐性無 <= 4 && !FLAG:LUSTMODE
			FLAG:甲斐性無 ++
		ELSEIF FLAG:甲斐性無 > 4 && !FLAG:LUSTMODE
			FLAG:甲斐性無 = 1
			FLAG:LUSTMODE = 1
			PRINTL 욕망 모드가 켜졌다
			PRINTW 여자들은 무능력 모드처럼 적극적일 것이지만, 고백 같은 행동은 막히지 않는다.
		ELSEIF FLAG:甲斐性無 <= 4 && FLAG:LUSTMODE
			FLAG:甲斐性無 ++
		ELSE
			FLAG:甲斐性無 = 0
			FLAG:LUSTMODE = 0
			PRINTW 무능력/욕망 모드가 꺼졌다.
		ENDIF
	CASE 32
		IF FLAG:TIME_COMPRESSION
			PRINTW 시간 압축이 꺼졌다.
		ELSE
			PRINTW 시간 압축이 켜졌다.
			PRINTW 일부 행동은 더 적은 시간이 걸린다.
		ENDIF
		FLAG:TIME_COMPRESSION = !FLAG:TIME_COMPRESSION
	CASE 33
		CALL OPEN_CARY_SET
	CASE 34
		CALL PERMADEATH_SET
	CASE 50
		CALL VIRGIN_SET
		;Disabled starting from 4.943 due to implemented by the upstream, check commit history when needed
	CASE 60
		CALL CHEAT_PREGNANCY_CHECK
	CASE 63
		CALL CHEAT_CHILD_GROWTH_SPEED
	CASE 70
		FLAG:CHARISMA_INGAME_DAY = !FLAG:CHARISMA_INGAME_DAY
		FLAG:前回カリスマ設定月 = 0
	CASE 80
		CALL CHEAT_ITEMS
	CASE 90
		;custom code: Debug Menu
		CALL DEBUG_MENU
	CASE 99
		RETURN
ENDSELECT
GOTO REPRINT

@CHEAT_EDIT_CHARA
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
DRAWLINE
PRINTL 캐릭터를 선택해 주세요.
PRINTL
LOCAL:1 = 0
FOR LOCAL, 0, CHARANUM
SIF CFLAG:LOCAL:出禁 == 2
	CONTINUE
IF LOCAL == STALKED && STALKED != 0
	CALL COLOR_PRINT(@"[{LOCAL,3}] %CALLNAME:LOCAL,14,LEFT%", "C_PINK")
ELSE
	PRINTFORM [{LOCAL,3}] %CALLNAME:LOCAL,14,LEFT%
ENDIF
SIF (LOCAL:1+1) % 4 == 0
	PRINTL
LOCAL:1++
NEXT
PRINTL
PRINTL [999] 뒤로가기
INPUT
SELECTCASE RESULT
	CASE 0 TO CHARANUM-1
		CALL CHEAT_OTHERS(RESULT)
	CASE CHARANUM
		PRINTFORMW 죄송하지만, 저는 "모브코"가 누구인지 혹은 무엇인지 전혀 모르겠습니다.
	CASE 999
		RETURN
ENDSELECT
GOTO REPRINT

@CHEAT_EDIT_CHARA_MULTI
#DIM FIRST_LINE
#DIM SELECTED_CHARA, キャラクタ数上限
#DIM SELECTED_CHARA_NUM
VARSET SELECTED_CHARA
FIRST_LINE = LINECOUNT
SELECTED_CHARA_NUM = 0
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
REDRAW 0
DRAWLINE
PRINTL 수정할 캐릭터를 선택해 주세요. 이 경우 모든 보증은 무효가 됩니다.
PRINTL
LOCAL:1 = 0
FOR LOCAL, 0, CHARANUM
SIF CFLAG:LOCAL:出禁 == 2
	CONTINUE
SIF SELECTED_CHARA:LOCAL
	SETCOLOR C_YELLOW
PRINTFORM [{LOCAL,3}] %CALLNAME:LOCAL,14,LEFT%
RESETCOLOR
SIF (LOCAL:1+1) % 4 == 0
	PRINTL
LOCAL:1++
NEXT
PRINTL
PRINTL  [995] 선택 반전 [996] 모두 선택 [997] 모두 선택 해제
SIF SELECTED_CHARA_NUM > 0
	PRINTFORM  [998] 이 {SELECTED_CHARA_NUM}명의 캐릭터를 선택한다.
PRINTL  [999] 돌아가기
INPUT
SELECTCASE RESULT
	CASE 0 TO CHARANUM-1
		SIF CFLAG:RESULT:出禁 == 2
			CONTINUE
		SIF SELECTED_CHARA:RESULT
			SELECTED_CHARA_NUM --
		SIF !SELECTED_CHARA:RESULT
			SELECTED_CHARA_NUM ++
		SELECTED_CHARA:RESULT = !SELECTED_CHARA:RESULT
		;CALL CHEAT_OTHERS(RESULT)
	CASE 995
		FOR LOCAL, 0, CHARANUM
		SIF CFLAG:LOCAL:出禁 == 2
			CONTINUE
		SIF SELECTED_CHARA:LOCAL
			SELECTED_CHARA_NUM --
		SIF !SELECTED_CHARA:LOCAL
			SELECTED_CHARA_NUM ++
		SELECTED_CHARA:LOCAL = !SELECTED_CHARA:LOCAL
		NEXT
	CASE 996
		FOR LOCAL, 0, CHARANUM
		SIF CFLAG:LOCAL:出禁 == 2
			CONTINUE
		SIF !SELECTED_CHARA:LOCAL
			SELECTED_CHARA_NUM ++
		SELECTED_CHARA:LOCAL = 1
		NEXT
	CASE 997
		FOR LOCAL, 0, CHARANUM
		SIF CFLAG:LOCAL:出禁 == 2
			CONTINUE
		SIF SELECTED_CHARA:LOCAL
			SELECTED_CHARA_NUM --
		SELECTED_CHARA:LOCAL = 0
		NEXT
	CASE 998
		CALL CHEAT_MULTI(SELECTED_CHARA)
	CASE 999
		RETURN
ENDSELECT
GOTO REPRINT

@CHEAT_EDIT_CHARARESET
#DIM CREDRAW
#DIM FIRST_LINE
#DIM C_ID
FIRST_LINE = LINECOUNT
PRINTL 이 캐릭터는 마치 새로운 대사를 받고 업데이트된 것처럼 완전히 초기화됩니다.
PRINTL 진행하시겠습니까?
CALL ASK_YN
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
DRAWLINE
SIF RESULT
	RETURN
PRINTL 초기화할 캐릭터를 선택한다.
PRINTL
FOR LOCAL, 0, CHARANUM
SIF CFLAG:LOCAL:出禁 == 2
	CONTINUE
IF LOCAL == STALKED && STALKED != 0
	CALL COLOR_PRINT(@"[{LOCAL,3}] %CALLNAME:LOCAL,14,LEFT%", "C_PINK")
ELSE
	PRINTFORM [{LOCAL,3}] %CALLNAME:LOCAL,14,LEFT%
ENDIF
SIF (LOCAL+1) % 4 == 0
	PRINTL
NEXT
PRINTL
PRINTL [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 0 TO CHARANUM-1
		C_ID = RESULT
		CALL COLORMESSAGE(@"경고: 이 선택은 모든 %HIS_HER(C_ID)%의 능력치와 호의를 %HIS_HER(C_ID)% CSV 값으로 초기화합니다!",C_RED,1,1)
		PRINTFORML 확인하시겠습니까?
		CALL ASK_YN
		IF RESULT
			RESULT = 0
			GOTO REPRINT
		ENDIF
		PRINTFORML 리셋 방법을 선택한다. 전체 리셋은 STA/ENE 값과 모든 특성도 초기화한다.
		CALL ASK_YN("전체", "대화")
		IF !RESULT
			;literally re-add csv, swap old with the new one and delete the old one
			CALL ADDCHARA_INIT(NO:C_ID)
			SWAPCHARA CHARANUM-1, C_ID
			DELCHARA CHARANUM-1
			CALL ADDCHARA_INIT(NO:C_ID, 1) ;apply again to init strings
			CALL CustomTraits(NO:C_ID) ;custom code
			TALENT:C_ID:PREGNANCY_TYPE = PREGNANCY_CHARA_DEFAULT(C_ID) ;custom code
			CALL SetOmoStats(NO:C_ID); eraNAS Customs
		ELSE
			CALL RESET_KOJO_CHARA_TR(C_ID)
		ENDIF
		PRINTFORML 성공!
		PRINTFORML 대사 선택 및 업데이트를 적용한다...
		LOCAL = TARGET
		RESULT = 0
		TARGET = C_ID
		CALL KOJO_MULTIPLE(C_ID)
		IF RESULT
			CALL KOJO_ACTIVE_INFO(C_ID)
			PRINTFORML %CALLNAME:C_ID%의 대화에 %RESULTS:1%를 업데이트하려고 시도한다.
			TRYCALLFORM M_KOJO%RESULTS%_UPDATE_K{NO:C_ID}
			PRINTL
			RESULT = 0
		ENDIF
		PRINTFORMW 완료했다.
	CASE IS >= CSV_CHARANUM()
		PRINTFORMW 죄송하지만, 제가 "스침 캐릭터"가 누구인지 무엇인지 전혀 모르겠습니다.
	CASE 999
		RETURN
ENDSELECT
GOTO REPRINT

@CHEAT_MULTI(SELECTED_CHARA)
#DIM REF SELECTED_CHARA
#DIM FIRST_LINE
#DIM SELECTED_INDEX
#DIM SELECTED_AMOUNT
#DIM SKIP_ALL
#DIMS WHAT
#DIM WHAT_TYPE
#DIM CURRENT_LEVEL
#DIM SKIP_SAME
FIRST_LINE = LINECOUNT
$REPRINT
VARSET LOCAL
VARSET SKIP_ALL
CLEARLINE LINECOUNT - FIRST_LINE
REDRAW 0
PRINTL
PRINTFORML 이 캐릭터들로 무엇을 할지 선택하라.
PRINTL [0] ABL 변경
PRINTL [1] TALENT 변경
PRINTL [2] TCVAR 변경
PRINTL [3] EXP 변경
PRINTL [4] CFLAG 변경
PRINTL [5] 돌아가기
INPUT
SELECTCASE RESULT
	CASE 0 TO 4
		WHAT_TYPE = RESULT
		IF RESULT == 0
			CALL PRINT_ABL_CHEAT()
		ELSEIF RESULT == 1
			CALL PRINT_TALENT_CHEAT()
		ELSEIF RESULT == 2
			CALL PRINT_TCVAR_CHEAT()
		ELSEIF RESULT == 3
			CALL PRINT_EXP_CHEAT()
		ELSEIF RESULT == 4
			CALL PRINT_CFLAG_CHEAT()
		ENDIF
		SELECTED_INDEX = RESULT
		WHAT '= @"%WHAT_TYPE==0?(ABL_TR(SELECTED_INDEX))#(WHAT_TYPE==1?TALENT_TR(SELECTED_INDEX)#(WHAT_TYPE==2?TCVARNAME:SELECTED_INDEX#(WHAT_TYPE==3?EXP_TR(SELECTED_INDEX)#CFLAGNAME_TR(CFLAGNAME:SELECTED_INDEX))))%"
		PRINTFORML 선택된 모든 캐릭터의 %WHAT%에 새로운 값을 입력한다.
		PRINTFORML [-99999] 취소
		INPUT
		IF RESULT == -99999
			PRINTW 취소한다.
			GOTO REPRINT
		ELSE
			SELECTED_AMOUNT = RESULT
			WHAT '= @"%WHAT_TYPE==0?(ABL_TR(SELECTED_INDEX))#(WHAT_TYPE==1?TALENT_TR(SELECTED_INDEX)#(WHAT_TYPE==2?TCVARNAME:SELECTED_INDEX#(WHAT_TYPE==3?EXP_TR(SELECTED_INDEX)#CFLAGNAME_TR(CFLAGNAME:SELECTED_INDEX))))%"
			PRINTFORML 지금 모든 사람의 「%WHAT%」을 {RESULT}로 변경한다.
			FOR LOCAL, 0, CHARANUM
			IF SELECTED_CHARA:LOCAL
				CURRENT_LEVEL = WHAT_TYPE==0?(ABL:LOCAL:SELECTED_INDEX)#(WHAT_TYPE==1?(TALENT:LOCAL:SELECTED_INDEX)#(WHAT_TYPE==2?TCVAR:LOCAL:SELECTED_INDEX#(WHAT_TYPE==3?EXP:LOCAL:SELECTED_INDEX#CFLAG:LOCAL:SELECTED_INDEX)))
				IF SKIP_ALL
					SELECTCASE WHAT_TYPE
						CASE 0
							ABL:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
						CASE 1
							TALENT:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
						CASE 2
							TCVAR:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
						CASE 3
							EXP:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
						CASE 4
							CFLAG:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
					ENDSELECT
				ELSE
					SIF SELECTED_AMOUNT == CURRENT_LEVEL && SKIP_SAME
						CONTINUE
					PRINTFORML %CALLNAME:LOCAL%의「%WHAT%」을(를) {SELECTED_AMOUNT}으로 변경한다 - 현재 {CURRENT_LEVEL}.
					PRINTFORM [0] 예 [1] 아니오 [2] 모두 예 [3] 모두 아니오
					SIF SELECTED_AMOUNT == CURRENT_LEVEL
						PRINTFORM [4] 「%WHAT%」이 이미 {SELECTED_AMOUNT}인 모든 사람을 건너뛴다.
					PRINTL
					INPUT
					SELECTCASE RESULT
						CASE 0
							SELECTCASE WHAT_TYPE
								CASE 0
									ABL:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
								CASE 1
									TALENT:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
								CASE 2
									TCVAR:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
								CASE 3
									EXP:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
								CASE 4
									CFLAG:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
							ENDSELECT
						CASE 1
						CASE 2
							SELECTCASE WHAT_TYPE
								CASE 0
									ABL:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
								CASE 1
									TALENT:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
								CASE 2
									TCVAR:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
								CASE 3
									EXP:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
								CASE 4
									CFLAG:LOCAL:SELECTED_INDEX = SELECTED_AMOUNT
							ENDSELECT
							SKIP_ALL = 1
						CASE 3
							BREAK
						CASE 4
							SKIP_SAME = 1
					ENDSELECT
				ENDIF
			ENDIF
			NEXT
			SKIP_ALL = 0
			SKIP_SAME = 0
			GOTO REPRINT
		ENDIF
	CASE 5
		RETURN
ENDSELECT
;FOR LOCAL, 0, CHARANUM
;	SIF SELECTED_CHARA:LOCAL
;		PRINTFORML %CALLNAME:LOCAL%
;NEXT
;WAIT
GOTO REPRINT

@PRINT_ABL_CHEAT()
#DIM LINE_BREAK_THING
VARSET LINE_BREAK_THING
PRINTFORML 변경할 ABL을 선택한다.
FOR LOCAL, 0, 56
IF INRANGE(LOCAL,0,4) || INRANGE(LOCAL,9,18) || INRANGE(LOCAL,31,35) || INRANGE(LOCAL,40,45) || LOCAL == 47 || INRANGE(LOCAL,50,55)
	LINE_BREAK_THING ++
	PRINTFORM [{LOCAL,2}] %ABL_TR(LOCAL),30,LEFT%
	IF LINE_BREAK_THING > 2
		PRINTFORML
		LINE_BREAK_THING %= 3
	ENDIF
ENDIF
NEXT
INPUT
RETURN RESULT

@PRINT_TALENT_CHEAT()
#DIM LINE_BREAK_THING
VARSET LINE_BREAK_THING
PRINTFORML 변경할 재능을 선택하라. 이것은 보증을 매우 강력하게 무효화한다.
FOR LOCAL, 0, 301
SELECTCASE LOCAL
ENDSELECT
IF IS_TALENT(LOCAL)
	LINE_BREAK_THING ++
	PRINTFORM [{LOCAL,3}] %TALENT_TR(LOCAL),30,LEFT%
	IF LINE_BREAK_THING > 2
		PRINTFORML
		LINE_BREAK_THING %= 3
	ENDIF
ENDIF
NEXT
INPUT
RETURN RESULT
;Returns true if it's a talent listed in talent.csv

@IS_TALENT(ARG)
#FUNCTION
;NAS: replaced with a simple line check
SIF TALENTNAME:ARG == ""
	RETURNF 0
RETURNF 1

@PRINT_TCVAR_CHEAT()
#DIM LINE_BREAK_THING
VARSET LINE_BREAK_THING
PRINTFORML 변경할 TCVAR를 선택한다. 모든 것이 번역되지 않은 것처럼, 영원히 기다려 주길 바란다.
FOR LOCAL, 0, 480
SELECTCASE LOCAL
ENDSELECT
IF IS_TCVAR(LOCAL)
	LINE_BREAK_THING ++
	PRINTFORM [{LOCAL,3}] %TCVARNAME:LOCAL,30,LEFT%
	IF LINE_BREAK_THING > 2
		PRINTFORML
		LINE_BREAK_THING %= 3
	ENDIF
ENDIF
NEXT
INPUT
RETURN RESULT

@IS_TCVAR(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 2 TO 4,12,15,17,20,21,30,40,50,60 TO 62,100 TO 109,111,112,115,117,118,120 TO 123,130 TO 135
	CASE 138 TO 150,160 TO 162,170,180 TO 184,190,191,200,201,250,251,298 TO 305, 308 TO 310, 312, 313 TO 331
