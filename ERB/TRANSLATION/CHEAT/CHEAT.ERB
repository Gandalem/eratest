ENDSELECT

@CHEAT_CHILD_GROWTH_SPEED_STAGE_LENGTH(ARG)
	;Returns the length of the specified childhood growth stage by subtracting its start date from that of the next stage.
#FUNCTION
SELECTCASE ARG
	CASE 0
			;Breastfeeding.
		RETURNF CHILD_離乳
	CASE 1
			;Weaning.
		RETURNF CHILD_玩具-CHILD_離乳
	CASE 2
			;Playing with toys.
		RETURNF CHILD_つかまり立ち-CHILD_玩具
	CASE 3
			;Learning to walk.
		RETURNF CHILD_よちよち-CHILD_つかまり立ち
	CASE 4
			;Walking.
		RETURNF CHILD_喋る-CHILD_よちよち
	CASE 5
			;Learning to talk.
		RETURNF CHILD_語彙-CHILD_喋る
	CASE 6
			;Developing speech.
		RETURNF CHILD_しつけ-CHILD_語彙
	CASE 7
			;Learning manners.
		RETURNF CHILD_就学-CHILD_しつけ
	CASE 8
			;Attending school.
		RETURNF CHILD_自立前-CHILD_就学
	CASE 9
			;Learning to be independent.
		RETURNF CHILD_自立-CHILD_自立前
ENDSELECT

@CHEAT_CHILD_GROWTH_SPEED_SET_STAGE_LENGTH(ARG,ARG:1)
	;Sets the length of the stage given as ARG to the value given as ARG:1 by changing the start date of the stage after it.
SELECTCASE ARG
	CASE 0
			;Breastfeeding.
		CHILD_離乳 = ARG:1
	CASE 1
			;Weaning.
		CHILD_玩具 = CHILD_離乳+ARG:1
	CASE 2
			;Playing with toys.
		CHILD_つかまり立ち = CHILD_玩具+ARG:1
	CASE 3
			;Learning to walk.
		CHILD_よちよち = CHILD_つかまり立ち+ARG:1
	CASE 4
			;Walking.
		CHILD_喋る = CHILD_よちよち+ARG:1
	CASE 5
			;Learning to talk.
		CHILD_語彙 = CHILD_喋る+ARG:1
	CASE 6
			;Developing speech.
		CHILD_しつけ = CHILD_語彙+ARG:1
	CASE 7
			;Learning manners.
		CHILD_就学 = CHILD_しつけ+ARG:1
	CASE 8
			;Attending school.
		CHILD_自立前 = CHILD_就学+ARG:1
	CASE 9
			;Learning to be independent.
		CHILD_自立 = CHILD_自立前+ARG:1
ENDSELECT

