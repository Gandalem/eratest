; Modular ERB: ITEM_MANAGEMENT.ERB
;----------------------------------------------
; Contains functions related to operations on ITEM
; For now only has ITEM_GRANT, a wrapper for receiving items
;----------------------------------------------
;----------------------------------------------
; Grant item within a limit
; ARG = itemnumber, ARG:1 = amount, ARG:2 = limit
; Default limit is 99
;----------------------------------------------

@ITEM_GRANT(ARG,ARG:1,ARG:2 = 99)
#DIM itemamount,1
itemamount = ITEM:ARG
IF itemamount > ARG:2
	PRINTFORMDL {ARG:1}× %ITEMNAME_TR(ARG)%를 담을 공간이 없다.
ELSEIF (itemamount + ARG:1) > ARG:2
	LOCAL:0 = (itemamount + ARG:1) - ARG:2
	PRINTFORMDL %PARSE("You receive")% {ARG:2 - itemamount}× %ITEMNAME_TR(ARG)%.
	PRINTFORMDL {LOCAL}× %ITEMNAME_TR(ARG)%를 담을 공간이 없다.
	ITEM:ARG = ARG:2
ELSE
	PRINTFORMDL %PARSE("You receive")% {ARG:1}× %ITEMNAME_TR(ARG)%.
	ITEM:ARG += ARG:1
ENDIF
