	RESULTS:2 =
	IF !LOCAL
		TRYCALLFORM M_KOJO_K{NO:C_ID}
	ELSE
		TRYCALLFORM M_KOJO_K{NO:C_ID}_{LOCAL}
	ENDIF
	IF RESULT
		LOCALS:(LOCAL + 1) = %RESULTS:1%
		DESCRIPTIONS:LOCAL = \@RESULTS:2 != ""? %RESULTS:2% # No descriptions available.\@
	ENDIF
	NEXT
	LOCALS:0 = Change %CALLNAME:C_ID%'s dialogue?
	PRINTFORML %LOCALS:0%
	FOR LOCAL, 0, 4
	strPrint = <button value='{LOCAL}' title='%HTML_ESCAPE(DESCRIPTIONS:LOCAL)%'>[{LOCAL}] - %LOCALS:(LOCAL + 1)%</button>
	SIF LOCAL == CFLAG:C_ID:口上セレクタ
		strPrint = <font color = '#%TOSTR(C_AQUA, "X6")%'>%strPrint%</font>
	HTML_PRINT strPrint
	RESETCOLOR
	SIF LOCALS:(LOCAL + 2) == ""
		BREAK
	NEXT
	$INPUT_LOOP2
	INPUT
	SELECTCASE RESULT
		CASE 0 TO LOCAL - 1
		CASEELSE
			CLEARLINE 1
			GOTO INPUT_LOOP2
	ENDSELECT
	CFLAG:C_ID:口上セレクタ = RESULT
	SIF !gDialogueUpdateInit
		CALL KOJO_SELECTOR(C_ID, 1)
ELSEIF !RESULT
	RETURN 1
ENDIF
CLEARLINE LINECOUNT - LINESTART
GOTO INPUT_LOOP

@KOJO_COUNT_CHECK(C_ID)
#DIM C_ID
#DIM DYNAMIC 口上カウント
#DIM DYNAMIC 口上数
#DIM DYNAMIC 口上実装数
#DIMS DYNAMIC kojoNamesList, 4
#DIM DYNAMIC kojoIdList, 4
#DIM DYNAMIC vernier
CALL KOJO_PURGED_ALTS_CHECK
;同キャラ口上複数確認 and record the name of kojo
FOR 口上カウント,0,5
RESULT = 0
RESULTS:1 =
IF 口上カウント
	TRYCALLFORM M_KOJO_K{NO:C_ID}_{口上カウント}
ELSE
	TRYCALLFORM M_KOJO_K{NO:C_ID}
ENDIF
IF RESULT
	SIF RESULTS:1 == ""
		RESULTS:1 = Default
	kojoNamesList:vernier = %CALLNAME:C_ID% %RESULTS:1% Dialogue
	kojoIdList:vernier = 口上カウント
	vernier ++
	IF !GETBIT(CFLAG:C_ID:口上実装状況,口上カウント)
		口上数 += 1
		口上実装数 += 1
		SETBIT CFLAG:C_ID:口上実装状況,口上カウント
	ELSEIF GETBIT(CFLAG:C_ID:口上実装状況,口上カウント)
		口上実装数 += 1
	ENDIF
ENDIF
NEXT
IF !口上数
	SIF 口上実装数
		RETURN 1
	RETURN 0
ELSE
	IF 口上実装数 > 1
	ELSE
		RETURN 2
	ENDIF
ENDIF
SIF 口上実装数
	RETURN 1
RETURN 0
;reset the dialogue count flag for some of the merged/removed alt dialogues for older saves (currently reimu/tewi)

@KOJO_PURGED_ALTS_CHECK
IF CHARANUM < 54
	RETURN
ENDIF
IF KojoAltPatch == 0
	TRYCCALLFORM M_KOJO_K[[霊夢]]_1
	CATCH
	CLEARBIT CFLAG:[[霊夢]]:口上実装状況, 1
	ENDCATCH
	TRYCCALLFORM M_KOJO_K[[てゐ]]_1
	CATCH
	CLEARBIT CFLAG:[[てゐ]]:口上実装状況, 1
	ENDCATCH
	KojoAltPatch = 1
ENDIF
;returns true if save file version is lower than VERSIONTOCHECK

@CHECK_UPDATE(VERSIONTOCHECK)
#FUNCTION
#DIMS VERSIONTOCHECK
#DIMS SAVEVERSION, 2
#DIMS CHECKVERSION, 2
SPLIT SAVESTR:本体バージョン, ".", SAVEVERSION
SPLIT VERSIONTOCHECK, ".", CHECKVERSION
FOR LOCAL, 0, 2
SIF TOINT(SAVEVERSION:LOCAL) < TOINT(CHECKVERSION:LOCAL)
	RETURNF 1
NEXT
RETURNF 0
