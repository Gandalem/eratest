@ALTNAME_INITIALIZE_CHARA(CHARA, REGULAR_NAME, REGULAR_CALLNAME, ALTERNATE_CALLNAME)
#DIM CHARA
#DIMS REGULAR_NAME
#DIMS REGULAR_CALLNAME
#DIMS ALTERNATE_CALLNAME
SIF ALTERNATE_CALLNAME == ""
    RETURN
SIF ALTNAME:CHARA:0 == ""
    ALTNAME:CHARA:0 '= ALTERNATE_CALLNAME
SIF ALTNAME:CHARA:1 == ""
    ALTNAME:CHARA:1 '= REGULAR_CALLNAME
IF USE_ALTNAME
	NAME:CHARA '= REGULAR_NAME
	CALLNAME:CHARA '= REGULAR_CALLNAME
ELSE
	NAME:CHARA '= nameArray:CHARA:na_Name
	CALLNAME:CHARA '= nameArray:CHARA:na_Callname
ENDIF

@ALTNAME_OR_CALLNAME(ARG, CONDITION = 1)
#FUNCTIONS
#DIM CONDITION
;use titles in LoG?
SIF SaveIsEZB && CONDITION
    RETURNF EZB_TITLES(LoG_RivalID(ARG))
SIF USE_ALTNAME && CONDITION && ALTNAME:ARG:0 != ""
    RETURNF ALTNAME:ARG:0
RETURNF CALLNAME:ARG

;prints their regular name, regardless or situation
@ALTNAME_REGULAR(ARG)
#FUNCTIONS
SIF USE_ALTNAME && ALTNAME:ARG:1 != ""
    RETURNF ALTNAME:ARG:1
RETURNF CALLNAME:ARG

@CUSTOM_OPTION_304
PRINTFORML [304] - Use unique descriptors to dynamically distinguish between characters with the same name：\@ USE_ALTNAME ? Use descriptor # Place apostrophe in name \@

@CUSTOM_OPTION_RESULT_304
USE_ALTNAME = !USE_ALTNAME
CALL ALTNAME_INITIALIZE
