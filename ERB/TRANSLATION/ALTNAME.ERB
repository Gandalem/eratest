@ALTNAME_CHECK
#DIMS CHARA_STR
#DIM CHARA

IF SaveIsEZB
    FOR CHARA, 0, CHARANUM
        SIF !STRLENS(ALTNAME:CHARA:0)
            ALTNAME:CHARA:0 '= CALLNAME:CHARA
        ALTNAME:CHARA:1 '= EZB_TITLES(LoG_RivalID(CHARA))
        CALLNAME:CHARA '= ALTNAME:CHARA:1
    NEXT
ENDIF

VARSET LOCALS
FOR LOCAL, 1, GET_TARGETNUM() + 1
    LOCALS += @" {TARGET:LOCAL}、"
NEXT

IF CHARA_STR != LOCALS
    FOR LOCAL, 1, GET_TARGETNUM() + 1
        CHARA = TARGET:LOCAL
        SIF CALLNAME:CHARA != ALTNAME:CHARA:0
            ALTNAME_CALLNAME:CHARA:0 '= CALLNAME:CHARA
        LOCALS:1 += @" %ALTNAME_CALLNAME:CHARA:0%、"
    NEXT

    FOR CHARA, 1, CHARANUM
        IF ALTNAME:CHARA:0 != ""
            IF IS_HERE(CHARA)
                IF STRCOUNT(LOCALS:1, @" %ALTNAME_CALLNAME:CHARA:0%、") > 1
                    CALLNAME:CHARA '= ALTNAME:CHARA:0
                ELSEIF CALLNAME:CHARA == ALTNAME:CHARA:0
                    CALLNAME:CHARA '= ALTNAME_CALLNAME:CHARA:0
                ENDIF
            ELSE
                IF CALLNAME:CHARA == ALTNAME:CHARA:0
                    CALLNAME:CHARA '= ALTNAME_CALLNAME:CHARA:0
                ENDIF
            ENDIF
        ENDIF
    NEXT

    CHARA_STR '= LOCALS
ENDIF

@EVENTEND
#PRI
FOR LOCAL, 1, CHARANUM
    IF ALTNAME:LOCAL:0 != "" && CALLNAME:LOCAL == ALTNAME:LOCAL:0
        CALLNAME:LOCAL '= ALTNAME_CALLNAME:LOCAL:0
    ENDIF
NEXT

