; Modular ERB: TITLE_MOD/SAVELOAD.ERB
;[ライセンス]パブリックドメイン
;本ファイルに係る著作権を放棄する。
;本ファイルに係る著作人格権は行使しない。
;2009/3/28 MinorShift(Emuera作者)
;2010/4/2 MinorShift(Emuera作者) ver 1.736に合わせて一部修正。
;独自のセーブ・ロードシステムの例（Emuera  ver 1.736以降対象）
;LOADGAMEの代わりにCALL LOADGAME_EX、SAVEGAMEの代わりにCALL SAVEGAME_EXを実行してください。
;実際に使用するには旧来の@SAVEINFOに合わせて@SAVEINFO_EXを編集する必要があります。
;使用している命令の詳細については下記のEmueraWikiを参照してください。
;http://sourceforge.jp/projects/emuera/wiki/FrontPage
;========================================================
;セーブ時の設定
;;========================================================

@SAVEGAME_EX
#DIM LCOUNT
LOADGLOBAL
SIF GLOBAL:999 < 0
	GLOBAL:999 = 0
SIF GLOBAL:999 > 30
	GLOBAL:999 = 29
DRAWLINE
PRINTFORML 저장할 슬롯을 선택하세요. 페이지 {GLOBAL:999+1}/10
DRAWLINE
CALL PRINT_SAVEDATA
PRINTFORMLC \@ (GLOBAL:999 == 0) ? [1000] 마지막 페이지 # [1000] 이전 페이지 \@ 
PRINTFORMLC [999] 돌아가기
PRINTFORMLC \@ GLOBAL:999 == 9 ? [1002] 첫 번째 페이지 # [1002] 다음 페이지 \@ 
INPUT
IF (RESULT == 999)
	RETURN
ELSEIF RESULT == 1000
	IF GLOBAL:999 > 0 && GLOBAL:999 < 10
		GLOBAL:999 -= 1
	ELSEIF GLOBAL:999 == 0
		GLOBAL:999 = 9
	ENDIF
	CLEARLINE 25
	SAVEGLOBAL
	RESTART
ELSEIF RESULT == 1002
	IF GLOBAL:999 < 9
		GLOBAL:999 += 1
	ELSEIF GLOBAL:999 == 9
		GLOBAL:999 = 0
	ENDIF
	CLEARLINE 25
	SAVEGLOBAL
	RESTART
ELSEIF ((RESULT < 0) || (RESULT >= 200)) && (RESULT != 300)
	PRINTFORMW 유효하지 않은 값입니다.
	RESTART
ELSE
	LCOUNT = RESULT
	CHKDATA LCOUNT
	;RESULT == 1は"ファイルが存在しない"
	IF RESULT != 1
		DRAWLINE
		PRINTL 저장된 파일이 이미 존재합니다. 덮어쓰시겠습니까?
		PRINTL  　[0] 예
		PRINTL  　[1] 아니요
		$INPUT_LOOP
		INPUT
		IF RESULT == 1
			RESTART
		ELSEIF RESULT != 0
			GOTO INPUT_LOOP
		ENDIF
	ENDIF
	GLOBAL:998 = LCOUNT
	SAVEGLOBAL
	CALL SAVEINFO_EX
	SAVEDATA LCOUNT, RESULTS
ENDIF
DRAWLINE
PRINTFORMW 성공적으로 저장했습니다.
;========================================================
;ロード時の設定
;;========================================================

@LOADGAME_EX
#DIM LCOUNT
LOADGLOBAL
SIF GLOBAL:999 < 0
	GLOBAL:999 = 0
SIF GLOBAL:999 > 30
	GLOBAL:999 = 29
DRAWLINE
PRINTFORML 로드할 파일을 선택하시오. 페이지 {GLOBAL:999+1}/10
DRAWLINE
CALL PRINT_SAVEDATA
CHKDATA 300
SETCOLOR COLOR("aqua")
PRINTBUTTON @"[자동] %RESULTS:0%", 300
RESETCOLOR
PRINTL
;PRINTFORM  [999] %"- Return",18,LEFT%
PRINTFORMLC \@ (GLOBAL:999 == 0) ? [1000] 마지막 페이지 # [1000] 이전 페이지 \@ 
PRINTFORMLC [998] 삭제
PRINTFORMLC [999] 돌아가기
PRINTFORMLC \@ GLOBAL:999 == 9 ? [1002] 첫 번째 페이지 # [1002] 다음 페이지 \@ 
INPUT
IF RESULT == 999
	RETURN
	;CALL SYSTEM_TITLE
ELSEIF RESULT == 998
ELSEIF RESULT == 1000
	IF GLOBAL:999 > 0 && GLOBAL:999 < 10
		GLOBAL:999 -= 1
	ELSEIF GLOBAL:999 == 0
		GLOBAL:999 = 9
	ENDIF
	CLEARLINE 26
	SAVEGLOBAL
	RESTART
ELSEIF RESULT == 1002
	IF GLOBAL:999 < 9
		GLOBAL:999 += 1
	ELSEIF GLOBAL:999 == 9
		GLOBAL:999 = 0
	ENDIF
	CLEARLINE 26
	SAVEGLOBAL
	RESTART
ELSEIF ((RESULT < 0) || (RESULT >= 200)) && (RESULT != 300)
	PRINTFORMW 유효하지 않은 값입니다.
	RESTART
ELSE
	LCOUNT = RESULT
	CHKDATA LCOUNT
	;RESULT == 0ならロード可能
	IF RESULT != 0
		RESTART
	ENDIF
	GLOBAL:998 = LCOUNT
	SAVEGLOBAL
	LOADDATA LCOUNT
ENDIF
;========================================================
;セーブ時のテキストの設定
;;========================================================

@PRINT_SAVEDATA
#DIM LCOUNT
LOADGLOBAL
;呼び出し元でCOUNTを使っているかも知れないのでCOUNTを保護
LCOUNT = COUNT
;REPEAT GLOBAL:999 * 20
; LOCAL:1 = GLOBAL:999 < (ViewingTitlePage ? EZB_PAGE_OFFSET+10 # 10) ? GLOBAL:999 * 20  # (ViewingTitlePage ? EZB_PAGE_OFFSET*100+200 # 200)
LOCAL:1 = GLOBAL:999 * 20
FOR LOCAL, LOCAL:1 , LOCAL:1 + 20
CHKDATA LOCAL
SIF LOCAL == GLOBAL:998
	SETCOLOR COLOR("orange")
PRINTFORML 　[{LOCAL,2}] %RESULTS:0%
RESETCOLOR
;REND
NEXT
COUNT = LCOUNT
RETURN

@SAVEINFO_EX
;SAVEDATA命令は@SAVEINFO関数を呼ばないのでPUTFORMの代わりの文字列を用意する必要がある
;GETTIME命令でRESULTSに現在時刻を代入
CALL SAVEINFO_EX_NAS() ;NAS: REPLACED
RETURN 1
RESULTS:0 =
GETTIME
RESULTS:0 += @" {DAY,5,LEFT}일차  %GET_MAPNAME(MAIN_MAP),28,LEFT%  %NAME:MASTER,14,LEFT%  %ATWVersionName()%\@ FLAG:周回数 ? %" "%NG:{FLAG:周回数}#\@"

@SYSTEM_AUTOSAVE
;オートセーブの処理を独自に行う場合、@SYSTEM_AUTOSAVEを定義する
;@SYSTEM_AUTOSAVEが定義されていると、標準のオートセーブの代わりにSYSTEM_AUTOSAVEが呼ばれる。
CALL SAVEINFO_EX
SAVEDATA 300, RESULTS
CALL SET_SAVE_PREVIEWS(300)

@LOAD_SAVE(ARG,ARG:1 = 0)
#DIM TYPE
#DIM LCOUNT
#DIM CREDRAW
#DIM FIRST_LINE
;NAS: REPLACED
CALL LOAD_SAVE_NAS(ARG,ARG:1)
RETURN RESULT
LOADGLOBAL
FIRST_LINE = LINECOUNT
TYPE = ARG
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
SIF GLOBAL:999 < 0
	GLOBAL:999 = 0
SIF GLOBAL:999 > 30
	GLOBAL:999 = 29
DRAWLINE
SELECTCASE TYPE
	CASE 0
		LOCALS:0 = 불러올 슬롯을 선택한다.
	CASE 1
		LOCALS:0 = 저장할 슬롯을 선택해라
	CASE 2
		LOCALS:0 = 저장 파일을 선택하여 삭제한다
ENDSELECT
PRINTFORML %LOCALS% - 페이지 ({GLOBAL:999+1}/10)
CALL PRINT_SAVEDATA
CHKDATA 300
SETCOLOR COLOR("aqua")
PRINTBUTTON @"[자동] %RESULTS:0%", 300
RESETCOLOR
PRINTL
PRINTFORM %@"\@ (GLOBAL:999 == 0) ? [1000] 마지막 페이지 # [1000] 이전 페이지\@",28,LEFT%
PRINTFORM %@"[997] %TYPE == 0?"삭제"#(TYPE==1 ? "불러오기" # "저장")%",28,LEFT%
PRINTFORM %@"[999] 돌아가기",28,LEFT%
PRINTFORM %@"[998] %TYPE == 0?"저장"#(TYPE==1 ? "삭제" # "불러오기")%",28,LEFT%
PRINTFORM %@"\@ GLOBAL:999 == 9 ? [1002] 첫 번째 페이지 # [1002] 다음 페이지\@",28,LEFT%
INPUT
IF RESULT == 997
	TYPE--
	SIF TYPE == -1
		TYPE = 2
	GOTO REPRINT
ELSEIF RESULT == 998
	TYPE++
	TYPE%=3
	GOTO REPRINT
ELSEIF (RESULT == 999)
	RETURN
ELSEIF RESULT == 1000
	IF GLOBAL:999 > 0 && GLOBAL:999 < 10
		GLOBAL:999 -= 1
	ELSEIF GLOBAL:999 == 0
		GLOBAL:999 = 9
	ENDIF
	SAVEGLOBAL
	GOTO REPRINT
ELSEIF RESULT == 1002
	IF GLOBAL:999 < 9
		GLOBAL:999 += 1
	ELSEIF GLOBAL:999 == 9
		GLOBAL:999 = 0
	ENDIF
	SAVEGLOBAL
	GOTO REPRINT
ELSEIF ((RESULT < 0) || (RESULT >= 200)) && (RESULT != 300)
	PRINTFORMW 유효하지 않은 값입니다.
	GOTO REPRINT
ELSEIF TYPE == 1 && ARG:1 != 1
	LCOUNT = RESULT
	CHKDATA LCOUNT
	;RESULT == 1は"ファイルが存在しない"
	IF RESULT != 1
		DRAWLINE
		PRINTL 저장된 파일이 이미 존재합니다. 덮어쓰시겠습니까?
		PRINTL  　[0] 예
		PRINTL  　[1] 아니요
		$INPUT_LOOP
		INPUT
		IF RESULT == 1
			GOTO REPRINT
		ELSEIF RESULT != 0
			GOTO INPUT_LOOP
		ENDIF
	ENDIF
	GLOBAL:998 = LCOUNT
	SAVEGLOBAL
	CALL SAVEINFO_EX
	;NAS custom code
	;save TCVARS for mid-save
	CALL SET_SAVE_PREVIEWS(LCOUNT)
	CALL TempVarSave
	PLAYSOUND "se/セーブ音.m4a"
	;=========================
	SAVEDATA LCOUNT, RESULTS
ELSEIF TYPE == 0
	LCOUNT = RESULT
	CHKDATA LCOUNT
	;RESULT == 0ならロード可能
	IF RESULT != 0
		GOTO REPRINT
	ENDIF
	;NAS CUSTOM
	;=========================
	CALL LOAD_WITH_HEADER(LCOUNT)
	PRINTFORML 불러오기?
	CALL ASK_YN()
	SIF RESULT
		GOTO REPRINT
	;=========================
	GLOBAL:998 = LCOUNT
	SAVEGLOBAL
	LOADDATA LCOUNT
ELSE
	LCOUNT = RESULT
	CHKDATA LCOUNT
	;RESULT == 0ならロード可能
	IF RESULT != 0
		GOTO REPRINT
	ENDIF
	PRINTL 삭제를 확인한다.
	PRINTL  　[0] 네, 세이브 파일을 삭제합니다.
	PRINTL  　[1] 아니요
	$INPUT_LOOP_DEL
	INPUT
	IF RESULT == 1
		GOTO REPRINT
	ELSEIF RESULT != 0
		GOTO INPUT_LOOP_DEL
	ENDIF
	SAVEGLOBAL
	DELDATA LCOUNT
	PRINTFORMW 성공적으로 삭제했습니다.
	GOTO REPRINT
ENDIF
DRAWLINE
PRINTFORMW 성공적으로 %TYPE == 0?"불러왔습니다"#(TYPE==1 ? "저장했습니다" # "삭제했습니다")%.
