; Modular ERB: GIFT.ERB
;translated version of @GIFT_ORDER_MADE_FROM_MASTER

@GIFT_ORDER_MADE_FROM_MASTER_TR(CHARA)
#DIM CHARA
#DIM START,20
#DIM ページ
#DIM 最後のページ
#DIM 本体
#DIM 形容詞
#DIMS 本体名称
#DIMS 形容詞名称
#DIMS 本体センス
#DIMS 形容詞センス
#DIMS GIFT_NAME
#DIMS SENSE
#DIM 全体価格
#DIM GIFT_ID
#DIM 点数
#DIM 貰った回数
#DIM 渡した回数
#DIMS TRSTR
IF TCVAR:CHARA:今日の贈り物
	PRINTFORMW ※참고: 이 함수를 호출하기 전에 "TCVAR:오늘의 선물"을 지워야 하며, 그렇지 않으면 오류가 발생할 수 있습니다.
	RETURN
ENDIF
;▼本体部分
;各ページの頭番を設定する
IF !START
	VARSET LOCAL
	FOR LOCAL, 11, 550
	CALL GIFTDATA_MAIN(LOCAL)
	SIF RESULTS == ""
		CONTINUE
	LOCAL:1 ++
	IF LOCAL:1 == 21
		LOCAL:2 ++
		START:(LOCAL:2) = LOCAL
		LOCAL:1 = 1
	ENDIF
	LOCAL:3 = LOCAL
	NEXT
	START = 1
	ページ = 1
	;最後のページと最後のページの頭番を設定
	最後のページ = LOCAL:2 + 1
	START:最後のページ = LOCAL:3 + 1
ENDIF
VARSET LOCAL
PRINTFORML 선물을 만들자 \@ CHARA ? 를 %CALLNAME:CHARA%에게 주기 위한 것 #  \@! (사용 가능 금액: %金額表示(MONEY)% )
DRAWLINE
FOR LOCAL, START, START:ページ
CALL GIFTDATA_MAIN(LOCAL)
SIF RESULTS == ""
	CONTINUE
TRSTR = %GIFT_NOUN_TR(RESULTS)%
PRINTFORML [{LOCAL, 3}] %TRSTR, 28, LEFT%%金額表示(RESULT:1), 9%
LOCAL:1 ++
NEXT
WHILE LOCAL:1 < 20
PRINTL 
LOCAL:1 ++
WEND
DRAWLINE
PRINTL [999] 다음 페이지
PRINTL [998] 이전 페이지
PRINTFORML [997] 커스텀 아이템 (%金額表示(30000)%)
PRINTL [  0] 처음부터 다시 시작
INPUT
;やめる
IF !RESULT
	VARSET START
	RETURN -1
	;Next page
ELSEIF RESULT == 999
	ページ ++
	IF ページ > 最後のページ
		ページ = 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
	;Prev page
ELSEIF RESULT == 998
	ページ --
	IF ページ < 1
		ページ = 最後のページ
		START = START:(最後のページ - 1)
	ELSEIF ページ == 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
	;Original
ELSEIF RESULT == 997
	PRINTFORML 커스텀 선물(주요 아이템)의 이름을 입력해 주세요.
	PRINTL [ 0] 처음부터 다시 시작
	INPUTS
	IF RESULTS == "0"
		RESTART
	ELSE
		本体 = 999
		本体名称 = %RESULTS%
		CALL GIFT_ORDER_MADE_ORIGINAL_DESIGN_TR("本体", 本体名称)
		本体センス = %RESULTS%
		;違法チェック
		FOR LOCAL, 11, 550
		CALL GIFTDATA_MAIN(LOCAL)
		IF RESULTS == 本体名称
			本体センス += "粗悪/粗悪/粗悪/"
			BREAK
		ENDIF
		NEXT
	ENDIF
	;選択
ELSEIF INRANGE(RESULT, 11, 550)
	LOCAL = RESULT
	CALL GIFTDATA_MAIN(RESULT)
	IF RESULTS != ""
		本体 = LOCAL
		本体名称 = %RESULTS%
		本体センス = %RESULTS:1%
	ENDIF
ENDIF
IF !本体
	CLEARLINE 28
	RESTART
ENDIF
;▼形容詞部分
CALL GIFT_ORDER_MADE_FROM_MASTER_2_TR(CHARA, 本体, 本体名称)
SIF RESULT == -1
	RESTART
VARSET START
形容詞 = RESULT
全体価格 = RESULT:1
形容詞名称 = %RESULTS%
形容詞センス = %RESULTS:1%
GIFT_NAME = %CREATE_GIFT_NAME_TR(本体名称, 形容詞名称)%
SENSE = %本体センス + 形容詞センス%
GIFT_ID = 形容詞 * 1000 + 本体
DRAWLINE
PRINTFORML 【%GIFT_NAME%】 %金額表示(全体価格)%
PRINTL 
IF MONEY < 全体価格
	CALL COLORMESSAGE(@"돈이 부족합니다!", C_ORANGE, 1)
	CALL COLORMESSAGE(@"다시 시작한다!", C_ORANGE, 1)
	FORCEWAIT
	RESTART
ELSE
	PRINTFORML 이 선물을 가지고 진행하시겠습니까?
	PRINTL [1] 진행하기
	PRINTL [0] 처음부터 다시 시작하기
	INPUT
	SIF !RESULT
		RESTART
ENDIF
MONEY -= 全体価格
貰った回数 = GET_GIFTDATA(CFLAG:CHARA:贈り物ストック, "回数") + 1
渡した回数 = CFLAG:MASTER:渡した贈り物 / 1000 + 1
CALL REVIEW_GIFT(CHARA, GIFT_ID, SENSE, 全体価格)
点数 = RESULT
GIFT_ID = 貰った回数 * 10000000000000000 + 点数 * 10000000000000 + DAY * 1000000000 + 99 * 10000000 + GIFT_ID
;ストックにGIFT_IDを保存
CFLAG:CHARA:贈り物ストック = GIFT_ID
;ストレージにも保存
GIFT_GOT:CHARA:(貰った回数 % 100) = CFLAG:CHARA:贈り物ストック
;CHARAはID,MASTERは渡したキャラを保存
TCVAR:CHARA:今日の贈り物 = CFLAG:CHARA:贈り物ストック
TCVAR:MASTER:今日の贈り物 = CHARA
;MASTERは渡した回数と渡したキャラを保存
CFLAG:MASTER:渡した贈り物 = 渡した回数 * 1000 + CHARA
;オリジナル名称を設定
GIFT_GOT_ORI_ADJECT:CHARA:(貰った回数 % 100) = %形容詞名称%
GIFT_GOT_ORI_MAIN:CHARA:(貰った回数 % 100) = %本体名称%
;点数
RESULT:1 = 点数
;名前
RESULTS = %GIFT_NAME%
[IF_DEBUG]
CALL PRINT_GIFTDATA(GIFT_ID, CHARA, "デバッグ")
PRINTFORMW 당신은 【%GIFT_NAME%】을 선물로 주었다!
[ENDIF]
RETURN 1
;translated version of @GIFT_ORDER_MADE_FROM_MASTER_2

@GIFT_ORDER_MADE_FROM_MASTER_2_TR(CHARA, 本体, 本体名称)
#DIM CHARA
#DIM START,50
#DIM ページ
#DIM 最後のページ
#DIM 本体
#DIM 形容詞
#DIMS 本体名称
#DIMS 形容詞名称
#DIM 本体価格
#DIM 全体価格
#DIMS 形容詞センス
#DIMS TRSTR
;各ページの頭番を設定する
IF !START
	VARSET LOCAL
	FOR LOCAL, 101, 2200
	CALL GIFTDATA_ADJECT(LOCAL)
	SIF RESULTS == ""
		CONTINUE
	LOCAL:1 ++
	IF LOCAL:1 == 21
		LOCAL:2 ++
		START:(LOCAL:2) = LOCAL
		LOCAL:1 = 1
	ENDIF
	LOCAL:3 = LOCAL
	NEXT
	START = 1
	ページ = 1
	;最後のページと最後のページの頭番を設定
	最後のページ = LOCAL:2 + 1
	START:最後のページ = LOCAL:3 + 1
ENDIF
VARSET LOCAL
PRINTFORML 선물을 마무리하자 \@ CHARA ? %CALLNAME:CHARA%에게 주려고 #  \@! (사용 가능한 금액:%金額表示(MONEY)%이다).
CALL GIFTDATA_MAIN(本体)
本体価格 = RESULT:1
本体名称 = \@ 本体 == 999 ? %本体名称% # %RESULTS% \@
DRAWLINE
FOR LOCAL, START, START:ページ
CALL GIFTDATA_ADJECT(LOCAL)
SIF RESULTS == ""
	CONTINUE
TRSTR = %CREATE_GIFT_NAME_TR(本体名称, RESULTS)%
PRINTFORML [{LOCAL, 4}] %TRSTR, 38, LEFT%%金額表示(本体価格 * RESULT:1 / 100), 12%
LOCAL:1 ++
NEXT
WHILE LOCAL:1 < 20
PRINTL 
LOCAL:1 ++
WEND
DRAWLINE
PRINTL [ 999] 다음 페이지
PRINTL [ 998] 이전 페이지
PRINTFORML [ 997] 커스텀 아이템(%金額表示(本体価格 * 300 / 100)%)
PRINTL [   0] 뒤로 가기
INPUT
;戻る
IF !RESULT
	VARSET START
	RETURN -1
	;次のページ
ELSEIF RESULT == 999
	ページ ++
	IF ページ > 最後のページ
		ページ = 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
	;前のページ
ELSEIF RESULT == 998
	ページ --
	IF ページ < 1
		ページ = 最後のページ
		START = START:(最後のページ - 1)
	ELSEIF ページ == 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
	;オリジナル
ELSEIF RESULT == 997
	PRINTFORML 당신의 커스텀 선물에 대한 설명을 입력해 주세요.
	PRINTL [ 0] 처음부터 다시 시작
	INPUTS
	IF RESULTS == "0"
		RESTART
	ELSE
		形容詞 = 9999
		形容詞名称 = %RESULTS%
		CALL GIFT_ORDER_MADE_ORIGINAL_DESIGN_TR("形容詞", 形容詞名称 + " " + 本体名称)
		形容詞センス = %RESULTS%
		全体価格 = 本体価格 * 300 / 100
		;違法チェック
		FOR LOCAL, 101, 2200
		CALL GIFTDATA_ADJECT(LOCAL)
		IF RESULTS == 形容詞名称
			形容詞センス += "粗悪/粗悪/粗悪/"
			BREAK
		ENDIF
		NEXT
	ENDIF
	;選択
ELSEIF INRANGE(RESULT, 101, 2200)
	LOCAL = RESULT
	CALL GIFTDATA_ADJECT(RESULT)
	IF RESULTS != ""
		形容詞 = LOCAL
		形容詞名称 = %RESULTS%
		形容詞センス = %RESULTS:1%
		全体価格 = 本体価格 * RESULT:1 / 100
	ENDIF
ENDIF
IF !形容詞
	CLEARLINE 28
	RESTART
ENDIF
VARSET START
RESULT:1 = 全体価格
RESULTS = %形容詞名称%
RESULTS:1 = %形容詞センス%
RETURN 形容詞
;translated version of @GIFT_ORDER_MADE_ORIGINAL_DESIGN

@GIFT_ORDER_MADE_ORIGINAL_DESIGN_TR(ARGS, 名称)
#DIMS 名称
VARSET LOCALS
IF ARGS == "本体"
	PRINTFORML 【%名称%】이 어떤 느낌을 전달하길 바라나요?
	PRINTL [ 1] 보기 좋은 무언가
	PRINTL [ 2] 손에 잡았을 때 기분이 좋은 무언가
	PRINTL [ 3] 안고 싶은 무언가
	PRINTL [ 4] 입고 싶은 무언가
	INPUT
	IF RESULT == 2
		LOCALS:1 = 握る/
	ELSEIF RESULT == 3
		LOCALS:1 = 抱く/
	ELSEIF RESULT == 4
		LOCALS:1 = 身につける/
	ELSE
		LOCALS:1 = 眺める/
	ENDIF
	PRINTFORML ◆ 【%名称%】은(는) 어떤 종류의 물건인가?
	PRINTL [ 1] 도구           [ 2] 장식품      [ 3] 꾸밈물
	PRINTL [ 4] 인형           [ 5] 책           [ 6] 식기류
	PRINTL [ 7] 악기         [ 8] 칼          [ 9] 총알
	PRINTL [10] 예술품        [11] 살아있는 생명    
	INPUT
	IF RESULT == 2
		LOCALS:2 = 置物/
	ELSEIF RESULT == 3
		LOCALS:2 = 装飾/
	ELSEIF RESULT == 4
		LOCALS:2 = 人形/
	ELSEIF RESULT == 5
		LOCALS:2 = 書物/
	ELSEIF RESULT == 6
		LOCALS:2 = 食器/
	ELSEIF RESULT == 7
		LOCALS:2 = 楽器/
	ELSEIF RESULT == 8
		LOCALS:2 = 刃物/
	ELSEIF RESULT == 9
		LOCALS:2 = 弾/
	ELSEIF RESULT == 10
		LOCALS:2 = 美術品/
	ELSEIF RESULT == 11
		LOCALS:2 = 生体品/
	ELSE
		LOCALS:2 = 道具/
	ENDIF
	PRINTFORML ◆ 【%名称%】은(는) 더 구체적으로 무엇인가? (선택 사항)
	PRINTL [ 1] 부적             [ 2] 의식 도구     [ 3] 기념품
	PRINTL [ 4] 안경           [ 5] 가면            [ 6] 시계
	PRINTL [ 7] 문구류        [ 8] 광원           [ 9] 접이식 부채
	PRINTL [ 0] 위의 어느 것도 아님
	INPUT
	IF RESULT == 1
		LOCALS:3 = 護符/
	ELSEIF RESULT == 2
		LOCALS:3 = 法具/
	ELSEIF RESULT == 3
		LOCALS:3 = 遺物/
	ELSEIF RESULT == 4
		LOCALS:3 = 眼鏡/
	ELSEIF RESULT == 5
		LOCALS:3 = 面/
	ELSEIF RESULT == 6
		LOCALS:3 = 時計/
	ELSEIF RESULT == 7
		LOCALS:3 = 文具/
	ELSEIF RESULT == 8
		LOCALS:3 = 照明/
	ELSEIF RESULT == 9
		LOCALS:3 = 扇/
	ENDIF
	RESULTS = %LOCALS:1 + LOCALS:2 + LOCALS:3%
ELSEIF ARGS == "形容詞"
	PRINTFORML ◆ 【%名称%】은 어떤 색인가?
	PRINTL [ 1] 흰색 [ 2] 검은색
	PRINTL [ 3] 빨간색 [ 4] 파란색 [ 5] 녹색
	PRINTL [ 6] 노란색 [ 7] 보라색 [ 8] 진홍색
	PRINTL [ 9] 분홍색 [10] 갈색 [11] 회색
	PRINTL [12] 금색 [13] 은색 [14] 무지개색
	INPUT
	IF RESULT == 2
		LOCALS:1 = 黒/黒/
	ELSEIF RESULT == 3
		LOCALS:1 = 赤/赤/
	ELSEIF RESULT == 4
		LOCALS:1 = 青/青/
	ELSEIF RESULT == 5
		LOCALS:1 = 緑/緑/
	ELSEIF RESULT == 6
		LOCALS:1 = 黄/黄/
	ELSEIF RESULT == 7
		LOCALS:1 = 紫/紫/
	ELSEIF RESULT == 8
		LOCALS:1 = 朱/朱/
	ELSEIF RESULT == 9
		LOCALS:1 = ピンク/ピンク/
	ELSEIF RESULT == 10
		LOCALS:1 = 茶/茶/
	ELSEIF RESULT == 11
		LOCALS:1 = 灰/灰/
	ELSEIF RESULT == 12
		LOCALS:1 = 金/金/
	ELSEIF RESULT == 13
		LOCALS:1 = 銀/銀/
	ELSEIF RESULT == 14
		LOCALS:1 = 虹/虹/
	ELSE
		LOCALS:1 = 白/白/
	ENDIF
	PRINTFORML 【%名称%】은(는) 어떤 인상을 주는가?
	PRINTL [ 1] 귀여움
	PRINTL [ 2] 멋짐
	PRINTL [ 3] 우아함
	PRINTL [ 4] 무서움
	INPUT
	IF RESULT == 2
		LOCALS:2 = かっこいい/かっこいい/かっこいい/
	ELSEIF RESULT == 3
		LOCALS:2 = 美しい/美しい/美しい/
	ELSEIF RESULT == 4
		LOCALS:2 = 怖い/怖い/怖い/
	ELSE
		LOCALS:2 = かわいい/かわいい/かわいい/
	ENDIF
	PRINTFORML ◆ 【%名称%】은(는) 어떻게 생겼나요? (선택 사항)
	PRINTL [ 1] 단순하다
	PRINTL [ 2] 이상하다
	PRINTL [ 3] 기교가 있다
	PRINTL [ 4] 스타일리시하다
	PRINTL [ 0] 위에 해당 없음
	INPUT
	IF RESULT == 1
		LOCALS:3 = シンプル/シンプル/
	ELSEIF RESULT == 2
		LOCALS:3 = 奇妙/奇妙/
	ELSEIF RESULT == 3
		LOCALS:3 = 芸術的/芸術的/
	ELSEIF RESULT == 4
		LOCALS:3 = オシャレ/オシャレ/
	ENDIF
	PRINTFORML 【%名称%】은(는) 어떤 분위기를 가지고 있는가? (선택 사항)
	PRINTL [ 1] 평범한               [ 2] 화려한
	PRINTL [ 3] 섬세한            [ 4] 강력한
	PRINTL [ 5] 유치한            [ 6] 지적인
	PRINTL [ 7] 신비로운          [ 8] 거친
	PRINTL [ 9] 장엄한            [10] 광적인
	PRINTL [ 0] 위에 해당 없음
	INPUT
	IF RESULT == 1
		LOCALS:4 = シック/シック/
	ELSEIF RESULT == 2
		LOCALS:4 = 派手/派手/
	ELSEIF RESULT == 3
		LOCALS:4 = 繊細/繊細/
	ELSEIF RESULT == 4
		LOCALS:4 = パワフル/パワフル/
	ELSEIF RESULT == 5
		LOCALS:4 = ロリータ/ロリータ/
	ELSEIF RESULT == 6
		LOCALS:4 = 知的/知的/
	ELSEIF RESULT == 7
		LOCALS:4 = 不思議/ 不思議/
	ELSEIF RESULT == 8
		LOCALS:4 = 威厳/威厳/
	ELSEIF RESULT == 9
		LOCALS:4 = 壮大/壮大/
	ELSEIF RESULT == 10
		LOCALS:4 = マニアック/マニアック/
	ENDIF
	RESULTS = %LOCALS:1 + LOCALS:2 + LOCALS:3 + LOCALS:4%
ENDIF
RETURN 1
