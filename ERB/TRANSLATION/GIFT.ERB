;translated version of @GIFT_ORDER_MADE_FROM_MASTER
@GIFT_ORDER_MADE_FROM_MASTER_TR(CHARA)
#DIM CHARA
#DIM START,20
#DIM ページ
#DIM 最後のページ
#DIM 本体
#DIM 形容詞
#DIMS 本体名称
#DIMS 形容詞名称
#DIMS 本体センス
#DIMS 形容詞センス
#DIMS GIFT_NAME
#DIMS SENSE
#DIM 全体価格
#DIM GIFT_ID
#DIM 点数
#DIM 貰った回数
#DIM 渡した回数
#DIMS TRSTR
IF TCVAR:CHARA:今日の贈り物
	PRINTFORMW ※Note: please clear the "TCVAR:今日の贈り物" before calling this function, or errors may result.
	RETURN
ENDIF
;▼本体部分
;各ページの頭番を設定する
IF !START
	VARSET LOCAL
	FOR LOCAL, 11, 550
		CALL GIFTDATA_MAIN(LOCAL)
		SIF RESULTS == ""
			CONTINUE
		LOCAL:1 ++
		IF LOCAL:1 == 21
			LOCAL:2 ++
			START:(LOCAL:2) = LOCAL
			LOCAL:1 = 1
		ENDIF
		LOCAL:3 = LOCAL
	NEXT
	START = 1
	ページ = 1
	;最後のページと最後のページの頭番を設定
	最後のページ = LOCAL:2 + 1
	START:最後のページ = LOCAL:3 + 1
ENDIF
VARSET LOCAL
PRINTFORML Let's create the gift \@ CHARA ? to give to %CALLNAME:CHARA% # \@! (Money available: %金額表示(MONEY)%)
DRAWLINE
FOR LOCAL, START, START:ページ
	CALL GIFTDATA_MAIN(LOCAL)
	SIF RESULTS == ""
		CONTINUE
	TRSTR = %GIFT_NOUN_TR(RESULTS)%
	PRINTFORML [{LOCAL, 3}] %TRSTR, 28, LEFT%%金額表示(RESULT:1), 9%
	LOCAL:1 ++
NEXT
WHILE LOCAL:1 < 20
	PRINTL 
	LOCAL:1 ++
WEND
DRAWLINE
PRINTL [999] Next page
PRINTL [998] Prev page
PRINTFORML [997] Custom item (%金額表示(30000)%)
PRINTL [  0] Start over
INPUT
;やめる
IF !RESULT
	VARSET START
	RETURN -1
;Next page
ELSEIF RESULT == 999
	ページ ++
	IF ページ > 最後のページ
		ページ = 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
;Prev page
ELSEIF RESULT == 998
	ページ --
	IF ページ < 1
		ページ = 最後のページ
		START = START:(最後のページ - 1)
	ELSEIF ページ == 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
;Original
ELSEIF RESULT == 997
	PRINTFORML Please enter the name of your custom present (the main item)
	PRINTL [ 0] Start over
	INPUTS
	IF RESULTS == "0"
		RESTART
	ELSE
		本体 = 999
		本体名称 = %RESULTS%
		CALL GIFT_ORDER_MADE_ORIGINAL_DESIGN_TR("本体", 本体名称)
		本体センス = %RESULTS%
		;違法チェック
		FOR LOCAL, 11, 550
			CALL GIFTDATA_MAIN(LOCAL)
			IF RESULTS == 本体名称
				本体センス += "粗悪/粗悪/粗悪/"
				BREAK
			ENDIF
		NEXT
	ENDIF
;選択
ELSEIF INRANGE(RESULT, 11, 550)
	LOCAL = RESULT
	CALL GIFTDATA_MAIN(RESULT)
	IF RESULTS != ""
		本体 = LOCAL
		本体名称 = %RESULTS%
		本体センス = %RESULTS:1%
	ENDIF
ENDIF
IF !本体
	CLEARLINE 28
	RESTART
ENDIF
;▼形容詞部分
CALL GIFT_ORDER_MADE_FROM_MASTER_2_TR(CHARA, 本体, 本体名称)
SIF RESULT == -1
	RESTART
VARSET START
形容詞 = RESULT
全体価格 = RESULT:1
形容詞名称 = %RESULTS%
形容詞センス = %RESULTS:1%
GIFT_NAME = %CREATE_GIFT_NAME_TR(本体名称, 形容詞名称)%
SENSE = %本体センス + 形容詞センス%
GIFT_ID = 形容詞 * 1000 + 本体
DRAWLINE
PRINTFORML 【%GIFT_NAME%】 %金額表示(全体価格)%
PRINTL 
IF MONEY < 全体価格
	CALL COLORMESSAGE(@"Insufficient money!", C_ORANGE, 1)
	CALL COLORMESSAGE(@"Starting over!", C_ORANGE, 1)
	FORCEWAIT
	RESTART
ELSE
	PRINTFORML Would you like to proceed with this present?
	PRINTL [1] Proceed
	PRINTL [0] Start over
	INPUT
	SIF !RESULT
		RESTART
ENDIF
MONEY -= 全体価格
貰った回数 = GET_GIFTDATA(CFLAG:CHARA:贈り物ストック, "回数") + 1
渡した回数 = CFLAG:MASTER:渡した贈り物 / 1000 + 1
CALL REVIEW_GIFT(CHARA, GIFT_ID, SENSE, 全体価格)
点数 = RESULT
GIFT_ID = 貰った回数 * 10000000000000000 + 点数 * 10000000000000 + DAY * 1000000000 + 99 * 10000000 + GIFT_ID
;ストックにGIFT_IDを保存
CFLAG:CHARA:贈り物ストック = GIFT_ID
;ストレージにも保存
GIFT_GOT:CHARA:(貰った回数 % 100) = CFLAG:CHARA:贈り物ストック
;CHARAはID,MASTERは渡したキャラを保存
TCVAR:CHARA:今日の贈り物 = CFLAG:CHARA:贈り物ストック
TCVAR:MASTER:今日の贈り物 = CHARA
;MASTERは渡した回数と渡したキャラを保存
CFLAG:MASTER:渡した贈り物 = 渡した回数 * 1000 + CHARA
;オリジナル名称を設定
GIFT_GOT_ORI_ADJECT:CHARA:(貰った回数 % 100) = %形容詞名称%
GIFT_GOT_ORI_MAIN:CHARA:(貰った回数 % 100) = %本体名称%
;点数
RESULT:1 = 点数
;名前
RESULTS = %GIFT_NAME%
[IF_DEBUG]
	CALL PRINT_GIFTDATA(GIFT_ID, CHARA, "デバッグ")
	PRINTFORMW You gave the 【%GIFT_NAME%】 as a present!
[ENDIF]
RETURN 1

;translated version of @GIFT_ORDER_MADE_FROM_MASTER_2
@GIFT_ORDER_MADE_FROM_MASTER_2_TR(CHARA, 本体, 本体名称)
#DIM CHARA
#DIM START,50
#DIM ページ
#DIM 最後のページ
#DIM 本体
#DIM 形容詞
#DIMS 本体名称
#DIMS 形容詞名称
#DIM 本体価格
#DIM 全体価格
#DIMS 形容詞センス
#DIMS TRSTR
;各ページの頭番を設定する
IF !START
	VARSET LOCAL
	FOR LOCAL, 101, 2200
		CALL GIFTDATA_ADJECT(LOCAL)
		SIF RESULTS == ""
			CONTINUE
		LOCAL:1 ++
		IF LOCAL:1 == 21
			LOCAL:2 ++
			START:(LOCAL:2) = LOCAL
			LOCAL:1 = 1
		ENDIF
		LOCAL:3 = LOCAL
	NEXT
	START = 1
	ページ = 1
	;最後のページと最後のページの頭番を設定
	最後のページ = LOCAL:2 + 1
	START:最後のページ = LOCAL:3 + 1
ENDIF
VARSET LOCAL
PRINTFORML Let's finish the gift \@ CHARA ? to give to %CALLNAME:CHARA% # \@! (Money available:%金額表示(MONEY)%)
CALL GIFTDATA_MAIN(本体)
本体価格 = RESULT:1
本体名称 = \@ 本体 == 999 ? %本体名称% # %RESULTS% \@
DRAWLINE
FOR LOCAL, START, START:ページ
	CALL GIFTDATA_ADJECT(LOCAL)
	SIF RESULTS == ""
		CONTINUE
	TRSTR = %CREATE_GIFT_NAME_TR(本体名称, RESULTS)%
	PRINTFORML [{LOCAL, 4}] %TRSTR, 38, LEFT%%金額表示(本体価格 * RESULT:1 / 100), 12%
	LOCAL:1 ++
NEXT
WHILE LOCAL:1 < 20
	PRINTL 
	LOCAL:1 ++
WEND
DRAWLINE
PRINTL [ 999] Next page
PRINTL [ 998] Prev page
PRINTFORML [ 997] Custom item（%金額表示(本体価格 * 300 / 100)%）
PRINTL [   0] Back
INPUT
;戻る
IF !RESULT
	VARSET START
	RETURN -1
;次のページ
ELSEIF RESULT == 999
	ページ ++
	IF ページ > 最後のページ
		ページ = 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
;前のページ
ELSEIF RESULT == 998
	ページ --
	IF ページ < 1
		ページ = 最後のページ
		START = START:(最後のページ - 1)
	ELSEIF ページ == 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
;オリジナル
ELSEIF RESULT == 997
	PRINTFORML Please enter the descriptor of your custom present
	PRINTL [ 0] Start over
	INPUTS
	IF RESULTS == "0"
		RESTART
	ELSE
		形容詞 = 9999
		形容詞名称 = %RESULTS%
		CALL GIFT_ORDER_MADE_ORIGINAL_DESIGN_TR("形容詞", 形容詞名称 + " " + 本体名称)
		形容詞センス = %RESULTS%
		全体価格 = 本体価格 * 300 / 100
		;違法チェック
		FOR LOCAL, 101, 2200
			CALL GIFTDATA_ADJECT(LOCAL)
			IF RESULTS == 形容詞名称
				形容詞センス += "粗悪/粗悪/粗悪/"
				BREAK
			ENDIF
		NEXT
	ENDIF
;選択
ELSEIF INRANGE(RESULT, 101, 2200)
	LOCAL = RESULT
	CALL GIFTDATA_ADJECT(RESULT)
	IF RESULTS != ""
		形容詞 = LOCAL
		形容詞名称 = %RESULTS%
		形容詞センス = %RESULTS:1%
		全体価格 = 本体価格 * RESULT:1 / 100
	ENDIF
ENDIF
IF !形容詞
	CLEARLINE 28
	RESTART
ENDIF
VARSET START
RESULT:1 = 全体価格
RESULTS = %形容詞名称%
RESULTS:1 = %形容詞センス%
RETURN 形容詞

;translated version of @GIFT_ORDER_MADE_ORIGINAL_DESIGN
@GIFT_ORDER_MADE_ORIGINAL_DESIGN_TR(ARGS, 名称)
#DIMS 名称
VARSET LOCALS
IF ARGS == "本体"
	PRINTFORML ◆ What kind of feeling do you want the 【%名称%】 to convey?
	PRINTL [ 1] Something nice to look at
	PRINTL [ 2] Something that feels good in the hand
	PRINTL [ 3] Something you want to hug
	PRINTL [ 4] Something you want to wear
	INPUT
	IF RESULT == 2
		LOCALS:1 = 握る/
	ELSEIF RESULT == 3
		LOCALS:1 = 抱く/
	ELSEIF RESULT == 4
		LOCALS:1 = 身につける/
	ELSE
		LOCALS:1 = 眺める/
	ENDIF
	PRINTFORML ◆ What kind of thing is the 【%名称%】?
	PRINTL [ 1] Tool           [ 2] Nick-nack      [ 3] Decoration
	PRINTL [ 4] Doll           [ 5] Book           [ 6] Tableware
	PRINTL [ 7] Instrument     [ 8] Blade          [ 9] Bullet
	PRINTL [10] Work of art    [11] Living thing    
	INPUT
	IF RESULT == 2
		LOCALS:2 = 置物/
	ELSEIF RESULT == 3
		LOCALS:2 = 装飾/
	ELSEIF RESULT == 4
		LOCALS:2 = 人形/
	ELSEIF RESULT == 5
		LOCALS:2 = 書物/
	ELSEIF RESULT == 6
		LOCALS:2 = 食器/
	ELSEIF RESULT == 7
		LOCALS:2 = 楽器/
	ELSEIF RESULT == 8
		LOCALS:2 = 刃物/
	ELSEIF RESULT == 9
		LOCALS:2 = 弾/
	ELSEIF RESULT == 10
		LOCALS:2 = 美術品/
	ELSEIF RESULT == 11
		LOCALS:2 = 生体品/
	ELSE
		LOCALS:2 = 道具/
	ENDIF
	PRINTFORML ◆ What is the 【%名称%】 more specifically? (Optional)
	PRINTL [ 1] Charm             [ 2] Ritual tool     [ 3] Memento
	PRINTL [ 4] Glasses           [ 5] Mask            [ 6] Watch
	PRINTL [ 7] Stationery        [ 8] Light           [ 9] Folding fan
	PRINTL [ 0] None of the above
	INPUT
	IF RESULT == 1
		LOCALS:3 = 護符/
	ELSEIF RESULT == 2
		LOCALS:3 = 法具/
	ELSEIF RESULT == 3
		LOCALS:3 = 遺物/
	ELSEIF RESULT == 4
		LOCALS:3 = 眼鏡/
	ELSEIF RESULT == 5
		LOCALS:3 = 面/
	ELSEIF RESULT == 6
		LOCALS:3 = 時計/
	ELSEIF RESULT == 7
		LOCALS:3 = 文具/
	ELSEIF RESULT == 8
		LOCALS:3 = 照明/
	ELSEIF RESULT == 9
		LOCALS:3 = 扇/
	ENDIF
	RESULTS = %LOCALS:1 + LOCALS:2 + LOCALS:3%
ELSEIF ARGS == "形容詞"
	PRINTFORML ◆ What color is the 【%名称%】?
	PRINTL [ 1] White       [ 2] Black
	PRINTL [ 3] Red         [ 4] Blue          [ 5] Green
	PRINTL [ 6] Yellow      [ 7] Purple        [ 8] Vermilion
	PRINTL [ 9] Pink        [10] Brown         [11] Gray
	PRINTL [12] Gold        [13] Silver        [14] Rainbow
	INPUT
	IF RESULT == 2
		LOCALS:1 = 黒/黒/
	ELSEIF RESULT == 3
		LOCALS:1 = 赤/赤/
	ELSEIF RESULT == 4
		LOCALS:1 = 青/青/
	ELSEIF RESULT == 5
		LOCALS:1 = 緑/緑/
	ELSEIF RESULT == 6
		LOCALS:1 = 黄/黄/
	ELSEIF RESULT == 7
		LOCALS:1 = 紫/紫/
	ELSEIF RESULT == 8
		LOCALS:1 = 朱/朱/
	ELSEIF RESULT == 9
		LOCALS:1 = ピンク/ピンク/
	ELSEIF RESULT == 10
		LOCALS:1 = 茶/茶/
	ELSEIF RESULT == 11
		LOCALS:1 = 灰/灰/
	ELSEIF RESULT == 12
		LOCALS:1 = 金/金/
	ELSEIF RESULT == 13
		LOCALS:1 = 銀/銀/
	ELSEIF RESULT == 14
		LOCALS:1 = 虹/虹/
	ELSE
		LOCALS:1 = 白/白/
	ENDIF
	PRINTFORML ◆ What impression does the 【%名称%】 give off?
	PRINTL [ 1] Cute
	PRINTL [ 2] Cool
	PRINTL [ 3] Elegant
	PRINTL [ 4] Scary
	INPUT
	IF RESULT == 2
		LOCALS:2 = かっこいい/かっこいい/かっこいい/
	ELSEIF RESULT == 3
		LOCALS:2 = 美しい/美しい/美しい/
	ELSEIF RESULT == 4
		LOCALS:2 = 怖い/怖い/怖い/
	ELSE
		LOCALS:2 = かわいい/かわいい/かわいい/
	ENDIF
	PRINTFORML ◆ What does the 【%名称%】 look like? (Optional)
	PRINTL [ 1] Simple
	PRINTL [ 2] Strange
	PRINTL [ 3] Artful
	PRINTL [ 4] Stylish
	PRINTL [ 0] None of the above
	INPUT
	IF RESULT == 1
		LOCALS:3 = シンプル/シンプル/
	ELSEIF RESULT == 2
		LOCALS:3 = 奇妙/奇妙/
	ELSEIF RESULT == 3
		LOCALS:3 = 芸術的/芸術的/
	ELSEIF RESULT == 4
		LOCALS:3 = オシャレ/オシャレ/
	ENDIF
	PRINTFORML ◆ What kind of atmosphere does the 【%名称%】 have? (Optional)
	PRINTL [ 1] Plain               [ 2] Flashy
	PRINTL [ 3] Delicate            [ 4] Powerful
	PRINTL [ 5] Childish            [ 6] Intellectual
	PRINTL [ 7] Mysterious          [ 8] Rugged
	PRINTL [ 9] Majestic            [10] Maniac
	PRINTL [ 0] None of the above
	INPUT
	IF RESULT == 1
		LOCALS:4 = シック/シック/
	ELSEIF RESULT == 2
		LOCALS:4 = 派手/派手/
	ELSEIF RESULT == 3
		LOCALS:4 = 繊細/繊細/
	ELSEIF RESULT == 4
		LOCALS:4 = パワフル/パワフル/
	ELSEIF RESULT == 5
		LOCALS:4 = ロリータ/ロリータ/
	ELSEIF RESULT == 6
		LOCALS:4 = 知的/知的/
	ELSEIF RESULT == 7
		LOCALS:4 = 不思議/ 不思議/
	ELSEIF RESULT == 8
		LOCALS:4 = 威厳/威厳/
	ELSEIF RESULT == 9
		LOCALS:4 = 壮大/壮大/
	ELSEIF RESULT == 10
		LOCALS:4 = マニアック/マニアック/
	ENDIF
	RESULTS = %LOCALS:1 + LOCALS:2 + LOCALS:3 + LOCALS:4%
ENDIF
RETURN 1
