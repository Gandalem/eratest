@MONTH_NAME(ARG:0)
#FUNCTIONS
SELECTCASE ARG:0
	CASE 1
		RETURNF "1월"
	CASE 2
		RETURNF "2월"
	CASE 3
		RETURNF "3월"
	CASE 4
		RETURNF "4월"
	CASE 5
		RETURNF "5월"
	CASE 6
		RETURNF "6월"
	CASE 7
		RETURNF "7월"
	CASE 8
		RETURNF "8월"
	CASE 9
		RETURNF "9월"
	CASE 10
		RETURNF "10월"
	CASE 11
		RETURNF "11월"
	CASE 12
		RETURNF "12월"
	CASEELSE
		RETURNF "잘못된 월..."
ENDSELECT

