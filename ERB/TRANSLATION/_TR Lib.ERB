@NAME_MOON_TR(MOON)
#FUNCTIONS
#DIM  MOON;MOONにはDAY:3を渡すこと
#DIMS CONST NAME_MOON = "", "삭", "초승", "차오르는 초승달", "상현", "차오르는 반달", "차오르는 반달", "열사흗날 밤", "열나흗날 밤", "보름달", "열엿샛날 밤", "기우는 반달", "기우는 반달", "하현", "그믐달", "그믐밤"
