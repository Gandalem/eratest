@ALCOHOL_FACE_TR(ARG)
#FUNCTIONS
SIF !nGlobalDrunk && BASE:ARG:酒気 <= 2 ; ATW qol: option to hide the drunk bar if sober
	RETURNF ""
SIF BASE:ARG:酒気 <= 2
	RETURNF ""
SELECTCASE BASE:ARG:酒気
	CASE IS > (MAXBASE:ARG:酒気 / 10) * 10
		RETURNF "필름 끊김"
	CASE IS > (MAXBASE:ARG:酒気 / 10) * 8
		RETURNF " 만취 "
	CASE IS > (MAXBASE:ARG:酒気 / 10) * 7
		RETURNF "곤드레만드레"
	CASE IS > (MAXBASE:ARG:酒気 / 10) * 5
		RETURNF "  취함 "
	CASE IS > (MAXBASE:ARG:酒気 / 10) * 3
		RETURNF "  알딸딸 "
	CASE IS <= (MAXBASE:ARG:酒気 / 10) * 3
		RETURNF "  훈훈함  "
ENDSELECT

@WEAREDPANTIES_TRANSPARENCY_TR(ARGS)
#DIM ぱんつ状況
;パンツを奪ったorもらったor元から穿いてない場合
IF CFLAG:ノーパン || (CFLAG:205 == 0 && CFLAG:206 == 0)
	ぱんつ状況 = 0
	;パンツを一旦脱いでいた場合
ELSEIF !EQUIP:下半身下着１ && !EQUIP:下半身下着２
	ぱんつ状況 = 1
ELSE
	ぱんつ状況 = 2
ENDIF
IF !ぱんつ状況
	PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 입을 속옷이 없다.
	IF ARGS == "SPERM"
		PRINTFORMDL %CALLNAME:TARGET%그것들은 오늘 없어도 견뎌야 하고 그 결과 %HIM_HER(TARGET)% 그것을 막을 것이 없이 %EXPR_VAR("SPERM")% 떨어지는 것을 막을 %HIS_HER(TARGET)% 다리
	ELSE
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")% 오늘 그들 없이 지내야 했고, %HIM_HER(TARGET)%는 숨길 것도 없이 완전히 흠뻑 젖게 되었다 [%HIS_HER(TARGET)% drenched] %EXPR_VAR("CROTCH")%.
	ENDIF
	;パンツがある場合
ELSE
	IF ぱんつ状況 == 1
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%/는 %HIS_HER(TARGET)%의 속옷을 다시 입는다.
		PRINTFORMD 그들은
	ELSE
		PRINTFORMD %조사처리(CALLNAME:TARGET,"의")% 팬티
	ENDIF
	PRINTFORMD 이다
	SELECTCASE RAND:3
		CASE 0
			PRINTFORMD 축축하게 젖은 채로
		CASE 1
			PRINTFORMD 흠뻑 젖은 채로
		CASEELSE
			PRINTFORMD 흠뻑 젖은 채로
	ENDSELECT
	IF ARGS == "SPERM"
		PRINTFORMD %EXPR_VAR("SPERM")%흘러나오는 것
	ELSE
		PRINTFORMD 끝없는 액체의 홍수
	ENDIF
	;パンツが透けうる場合
	IF PANTIES_TRANSPARENCY(TARGET)
		PRINTFORMD  그것들을 투명하게 만들어, %HIS_HER(TARGET)%의 윤곽을 드러낸다 \@ TALENT:TARGET:2 == 2 || TALENT:TARGET:2 == 3 ?  # %TINKO_TR(TARGET)%%SLIT_TR(TARGET,1)% \@.
	ELSE
		PRINTFORMD .
	ENDIF
	CALL PRINT_BREAK,,"dc"
ENDIF
;ARG - whose ass it is
;LONG ensures it stays long
;ARG:1 - stops prevention of duplicates
;Max length - 24 with SHORT, else 60+

@HIP_TR(ARG, LONG = 0, ARG:1)
#FUNCTIONS
#DIM LONG
VARSET LOCALS
;NAS: diapered touhous
IF EQUIP:ARG:6
	SIF IsPadded(ARG, "diaper") || IsPadded(ARG, "pull-up")
		LOCALS += SPLIT_G("패드를 댄:기저귀를 찬:기저귀로 감싼:푹신하게 감싼:패드로 감싼")+" "
ELSE
	SIF !EQUIP:ARG:6 && (STAIN:ARG:4 & Dirt_Scat)
		LOCALS += SPLIT_G(@"\@ GETBIT(nScat,4) ? 대변으로 뒤덮인 # 젤로 번들거리는 \@:\@ GETBIT(nScat,4) ? 진흙투성이인 # 젤이 퍼진 \@")+" "
ENDIF
;///////////////////////////
;Custom code, moved adjective-structure around
IF TALENT:ARG:体型 == -2 && TALENT:ARG:ButtSize <= -2
	SELECTCASE RAND:2
		CASE 0
			LOCALS += "작고 매끈한 엉덩이"
		CASE 1
			LOCALS += "앙증맞은 엉덩이"
	ENDSELECT
ELSEIF TALENT:ARG:ButtSize < 0
	SELECTCASE RAND:3
		CASE 0
			LOCALS += "얇은 엉덩이"
		CASE 1
			LOCALS += "날씬한 엉덩이"
		CASE 2
			LOCALS += "작은 엉덩이"
	ENDSELECT
ELSEIF TALENT:ARG:ButtSize == 4
	SELECTCASE RAND:4
		CASE 0
			LOCALS += "넘쳐흐를 듯한 엉덩이"
		CASE 1
			LOCALS += "입이 떡 벌어질 만큼 거대한 엉덩이"
		CASE 2
			LOCALS += "어마어마한 엉덩이"
		CASE 3
			LOCALS += "산처럼 거대한 엉덩이"
	ENDSELECT
ELSEIF TALENT:ARG:ヒップサイズ == 3
	SELECTCASE RAND:4
		CASE 0
			LOCALS += "엄청난 엉덩이"
		CASE 1
			LOCALS += "육중한 엉덩이"
		CASE 2
			LOCALS += "거대한 엉덩이"
		CASE 3
			LOCALS += "극도로 거대한 엉덩이"
	ENDSELECT
ELSEIF TALENT:ARG:ヒップサイズ == 2
	SELECTCASE RAND:4
		CASE 0
			LOCALS += "극도로 푹신한 엉덩이"
		CASE 1
			LOCALS += "커다란 엉덩이"
		CASE 2
			LOCALS += "인상적일 만큼 큰 엉덩이"
		CASE 3
			LOCALS += "극도로 풍만한 엉덩이"
	ENDSELECT
ELSEIF TALENT:ARG:ヒップサイズ == 1
	SELECTCASE RAND:4
		CASE 0
			LOCALS += "푹신한 엉덩이"
		CASE 1
			LOCALS += "풍성한 엉덩이"
		CASE 2
			LOCALS += "통통한 엉덩이"
		CASE 3
			LOCALS += "풍만한 엉덩이"
			;Removed "child-bearing" since it could sort of duplicate
	ENDSELECT
ELSEIF TALENT:ARG:ヒップサイズ == 0
	SELECTCASE RAND:5
		CASE 0
			IF CFLAG:ARG:乳ランクアップ
				LOCALS += "모성적이고 둥근 엉덩이"
			ELSE
				LOCALS += "균형 잡힌 엉덩이"
			ENDIF
		CASE 1
			LOCALS += "말랑한 엉덩이"
		CASE 2
			LOCALS += "탄탄한 엉덩이"
		CASE 3
			LOCALS += "날씬한 엉덩이"
		CASE 4
			LOCALS += "탐스러운 엉덩이"
	ENDSELECT
ENDIF
IF !LONG
	IF LOCALS == LOCALS:1 && !ARG:1 ;If it is about to return the same thing in a row
		FOR LOCAL, 0, 3
		LOCALS = %HIP_TR(ARG, LONG, 1)%
		SIF LOCALS != LOCALS:1
			BREAK
		NEXT
	ENDIF
	SIF !ARG:1
		LOCALS:1 = LOCALS
	RETURNF LOCALS
ENDIF
IF PALAM:ARG:欲情 >= PALAMLV:4 && !RAND:6
	;Nopan should block this, but somehow doesn't
	IF CFLAG:ARG:ノーパン || STRCOUNT(TOLOWER(PANTSNAME(EQUIP:ARG:下半身下着２, ARG)), "no underwear") >= 1
		LOCALS += " 땀방울이 송골송골 맺힌"
	ELSE
		LOCALS += @"%HIS_HER(ARG)%의 %PANTSNAME(EQUIP:ARG:下半身下着２, ARG)%가 피부에 달라붙어 있고, 땀으로 투명했다."
	ENDIF
ELSEIF !RAND:5 && EXP:ARG:出産経験 && TALENT:ARG:ヒップサイズ <= 0
	LOCALS += @" 그녀가 {EXP:ARG:出産経験} 명의 아이들을 낳았다는 것을 부인하는"
ELSEIF !RAND:5 && TALENT:ARG:ヒップサイズ > 0
	LOCALS += " 아이를 낳기 위해 빚어진 듯한"
ENDIF
IF LOCALS == LOCALS:1 && !ARG:1 ;If it is about to return the same thing in a row
	FOR LOCAL, 0, 3
	LOCALS = %HIP_TR(ARG, LONG, 1)%
	SIF LOCALS != LOCALS:1
		BREAK
	NEXT
ENDIF
SIF !ARG:1
	LOCALS:1 = LOCALS
RETURNF LOCALS

