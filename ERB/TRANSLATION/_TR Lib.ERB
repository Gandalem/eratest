@GET_NAME_WEATHER_TIMEZOME_TR(ARG = -1)
#FUNCTIONS
SIF ARG == -1
	ARG = TIME
SELECTCASE ARG
	;AM0~3
	CASE 0 TO 179
		LOCALS '= @"여명"
		;AM3~6
	CASE 180 TO 359
		LOCALS '= @"새벽"
		;AM6~9
	CASE 360 TO 539
		LOCALS '= @"아침"
		;AM9~12
	CASE 540 TO 719
		LOCALS '= @"정오"
		;PM0~3
	CASE 720 TO 899
		LOCALS '= @"오후"
		;PM3~6
	CASE 900 TO 1079
		LOCALS '= @"저녁"
		;PM6~9
	CASE 1080 TO 1259
		LOCALS '= @"밤"
		;PM9~12
	CASE IS >= 1260
		LOCALS '= @"심야"
	CASEELSE
		LOCALS = TIME ZONE ERROR!
ENDSELECT
SIF ARG:1
	RETURNF CAPITALIZE(LOCALS)
RETURNF LOCALS

