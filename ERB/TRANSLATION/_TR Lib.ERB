@MONTH_NAME(ARG:0)
#FUNCTIONS
SELECTCASE ARG:0
	CASE 1
		RETURNF "January"
	CASE 2
		RETURNF "February"
	CASE 3
		RETURNF "March"
	CASE 4
		RETURNF "April"
	CASE 5
		RETURNF "May"
	CASE 6
		RETURNF "June"
	CASE 7
		RETURNF "July"
	CASE 8
		RETURNF "August"
	CASE 9
		RETURNF "September"
	CASE 10
		RETURNF "October"
	CASE 11
		RETURNF "November"
	CASE 12
		RETURNF "December"
	CASEELSE
		RETURNF "wrong month..."
ENDSELECT

@SEASON_NAME(ARG:0 = -1)
