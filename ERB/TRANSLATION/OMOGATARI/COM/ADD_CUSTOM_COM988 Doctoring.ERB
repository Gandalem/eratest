;tend wounds with this command instead of using items.
@ADD_CUSTOM_COM988
#DIM TendQuality
#DIM SurgerySucc
#DIM TendType = 0
#DIM nPart
#DIM nItem
#DIM nLineCnt_Head ;custom code for correct clearline
#DIM nPartPick
#DIM DYNAMIC PartChoices,100
#DIM DYNAMIC nHasBionicParts
{
#DIM TendItems =
	-1, 607, 1106, 608,
	520, 613, 523, 526
}
{
#DIM TendItemMult =
	30, 60, 85, 90,
	100, 110, 130, 170
}
{
#DIMS TendItemLabel =
	"None", "Herbal", "Fake Bandage", "High Herb",
	"Bandage", "Special Herb", "Medkit", "GC Meds"
}

#DIM DYNAMIC gotHediffs,300
#DIM DYNAMIC hediffCount
#DIM DYNAMIC gotHediffs2,300
#DIM DYNAMIC hediffCount2
nLineCnt_Head = LINECOUNT
TFLAG:194 = 0
REDRAW 0
DO
IF SHIRAHU(TARGET) && TARGET != MASTER && TendType == -5
	TendType = 0
ENDIF

SIF LINECOUNT - nLineCnt_Head > 0
	CLEARLINE LINECOUNT - nLineCnt_Head

[SKIPSTART]
base 20%
8 = 100%
18 = 150%
[SKIPEND]
; IF nLevelRework
; TendQuality = 20 + LIMIT(ABL:MASTER:Medical*10,0,80) + LIMIT((ABL:MASTER:Medical-8)*5,0,50) + MAX((ABL:MASTER:Medical-18)*3,0)
; SurgerySucc = LIMIT(20 + LIMIT(ABL:MASTER:Medical*10,0,60) + LIMIT((ABL:MASTER:Medical-6)*5,0,10) + MAX((ABL:MASTER:Medical-18),0),0,100)
; ELSE
	SELECTCASE ABL:MASTER:Medical
	CASE 0
		TendQuality = 20
	CASE 1
		TendQuality = 50
	CASE 2
		TendQuality = 70
	CASE 3
		TendQuality = 100
	CASE 4
		TendQuality = 115
	CASE 5
		TendQuality = 130
	CASE 6
		TendQuality = 150
	CASE 7
		TendQuality = 155
	CASE 8
		TendQuality = 185
	CASE 9
		TendQuality = 215
	CASE IS >= 10
		TendQuality = 245
	ENDSELECT
	SurgerySucc = TendQuality
; ENDIF
CUSTOMDRAWLINE ━
IF IsDead:TARGET:0
	SETCOLOR C_GRAY
	CUSTOMDRAWLINE ━
	RESETCOLOR
	IF ITEM:Defibrillator
		IF CharWillDieAfterCheck(TARGET) == 1
			PRINTFORML %CALLNAME:TARGET%'s injuries are incompatible with life.
			PRINTFORML Replace all destroyed body parts to resuscitate.
		ELSEIF BASE:TARGET:Blood <= 0
			PRINTFORML %CALLNAME:TARGET% needs blood to resuscitate.
		ELSE
			PRINTFORML %CALLNAME:TARGET% is ready to resuscitate!
			PRINTFORML Use the Defibrillator in the Items menu.
		ENDIF
	ELSE
		PRINTFORML %CALLNAME:TARGET% is too far gone...
		PRINTFORML Using this on %CALLNAME:TARGET% would do nothing...
	ENDIF
	PRINTFORML
	SETCOLOR C_GRAY
	CUSTOMDRAWLINE ━
	RESETCOLOR
ELSEIF BASE:TARGET:0 <= 500
	SETCOLOR C_GRAY
	CUSTOMDRAWLINE ━
	RESETCOLOR
	PRINTFORML %CALLNAME:TARGET% is ready to resuscitate!
	PRINTFORML Use the Defibrillator in the Items menu.
	PRINTFORML
	SETCOLOR C_GRAY
	CUSTOMDRAWLINE ━
	RESETCOLOR
ENDIF
;PRINTFORML Select a body part to tend
PRINTFORML Current target is %PARSE("you",,,TARGET)%.
PRINTFORML Base Treatment Quality: {TendQuality}\%
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
IF TendType == -5
	FOR LOCAL,0,100
		VARSET LOCALS
		SIF BDY_PART_NAME(LOCAL) == ""
			CONTINUE
		SIF !HasBodyPart(TARGET,LOCAL)
			CONTINUE
		SIF IsPartDestroyed(TARGET,LOCAL)
			CONTINUE
		SIF LOCAL == 0
			CONTINUE

		;SIF LOCAL == nPartPick
		;	SETCOLOR C_AQUA
		hediffCount = DT_SELECT(@"Hediff", @"chara = {TARGET} and part = {LOCAL}", , gotHediffs)
		IF !LogicalHarvestPart(LOCAL) && !hediffCount
		ELSEIF BodyPartHealth:TARGET:LOCAL:0 == BodyPartHealth:TARGET:LOCAL:1
		PRINTFORML [{LOCAL,2}] - %BDY_PART_NAME(LOCAL)%
		ELSE
		SETCOLOR C_GRAY
		PRINTPLAINFORM [{LOCAL,2}] - %BDY_PART_NAME(LOCAL)% (Part is damaged)
		PRINTL
		ENDIF
		RESETCOLOR
		
		FOR LOCAL:3,0,hediffCount
			IF DT_CELL_GET(@"Hediff", gotHediffs:(LOCAL:3), "type", 1) > 100
			;find hediffs that aren't bionics (bionics are ID 100+)
				LOCALS += @"       %HediffName(TARGET,LOCAL,LOCAL:3,1, 1)%"
			ENDIF
		NEXT
		HTML_PRINT LOCALS	
	NEXT
	PRINTL
	PRINTFORML [300] - Install Bionics
	PRINTFORML [301] - Install Natural Replacements
	SIF TARGET != MASTER
	PRINTFORML [302] - Mass Harvest
ELSE
FOR LOCAL,0,100
	IF DT_SELECT(@"Hediff", @"chara = {TARGET} and part = {LOCAL} and tended = 0 and type < 100")
	;find hediffs that aren't bionics (bionics are ID 100+)
		PRINTFORML [{LOCAL,2}] - %BDY_PART_NAME(LOCAL)% ({BodyPartHealth:TARGET:LOCAL:0,5}/{BodyPartHealth:TARGET:LOCAL:1,5})
	ENDIF
NEXT
ENDIF
PRINTFORML
CUSTOMDRAWLINE ━
PRINTPLAIN Tend type: 
FONTSTYLE 1
FOR LOCAL, 1000, VARSIZE("TendItems")+1000
	LOCALS '= TendItemLabel:(LOCAL-1000)
	SIF LOCALS == ""
		CONTINUE

	[SKIPSTART]
	IF LOCAL == 4 && 練習不可
		SETCOLOR C_GRAY
	ELSEIF DISH_TYPE_NUM == LOCAL
		SETCOLOR C_AQUA
	ENDIF
	[SKIPEND]
	IF TendType == LOCAL-1000
		SETCOLOR C_AQUA
	ELSEIF TendItems:(LOCAL-1000) != -1
		SIF ITEM:(TendItems:(LOCAL-1000)) <= 0 
			CONTINUE
		;SETCOLOR C_GRAY
	ENDIF
	LOCALS:1 = \@ TendItems:(LOCAL-1000) != -1 ? %"("+TOSTR(ITEM:(TendItems:(LOCAL-1000)))+")"% # \@

	PRINTBUTTON @"[%LOCALS+COND_STR(@" %LOCALS:1%",STRLENS(LOCALS:1))%] ", LOCAL
	RESETCOLOR
NEXT
;Surgery
IF ITEM:532
	IF TendType == -5
		SETCOLOR C_AQUA
	ENDIF
	PRINTBUTTON @"[Surgery] ", -5
	RESETCOLOR
ENDIF

FONTREGULAR
PRINTL 
IF HealthInsuranceLevel
PRINTL
PRINTFORML [-87] - Call for emergency medical support
PRINTL
ENDIF
PRINTFORML [-98] - Change Target
PRINTFORML [-99] - Cancel
INPUT
SELECTCASE RESULT
CASE -87
	IF !HealthInsuranceLevel
		CONTINUE
	ENDIF
	IF IsDead:TARGET:0
		IF PermaDeath == 2 || HealthInsuranceLevel == 1
			LOCAL = 81
		ELSE
			LOCAL = 80
		ENDIF
	ELSEIF !SHIRAHU(TARGET)
		LOCAL = 80
	ELSEIF GETBIT(HealthFlags:TARGET:0,HealthFlags_UnwellHediff)
		LOCAL = 2
	ELSE
		LOCAL = 3
	ENDIF
	CALL MarketeersRecoverChara(TARGET,LOCAL)
CASE -98
PRINTFORML Current target is %CALLNAME:TARGET%.
PRINTL [-1] - Return
FOR LOCAL,0,CHARANUM
	SIF CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置
		PRINTFORML [{LOCAL}] - %CALLNAME:LOCAL% (Favor: {CFLAG:LOCAL:2})
NEXT
INPUT
IF !INRANGE(RESULT,0,CHARANUM)
	CONTINUE
ELSEIF CFLAG:RESULT:現在位置 == CFLAG:MASTER:現在位置
	TFLAG:104 = RESULT
ENDIF
TARGET = TFLAG:104
CASE -99
RETURN 1
CASE -5
	IF !ITEM:SurgeryKit
	PRINTFORML You do not have the surgery kit, and therefore cannot do surgery
	PRINTFORMW Buy one from %CALLNAME:72%, or from the Internet. 
	TendType = 0
	CONTINUE
	ELSEIF SHIRAHU(TARGET) && TARGET != MASTER
	PRINTFORMW %CALLNAME:TARGET% must be unconscious to do surgery
	TendType = 0
	CONTINUE
	ENDIF
	TendType = -5
CASE IS >= 1000
	IF RESULT == 1006 && (ABL:102:親密 < 5 && TALENT:MASTER:234 < 7)
	PRINTFORML You do not know how to use this medicine
	PRINTFORMW Try consulting an expert in %AllTechLevels(7)% technology
	CONTINUE
	ENDIF

	TendType = RESULT-1000
CASE 300

IF TendType == -5
PRINTFORML Select a bionic part that you have

LOCAL:5 = 0
FOR LOCAL, 100, VAR_TEMP_MAX
	IF HasBionic:LOCAL && GET_STR(MASTER, "Hediff", (LOCAL), "名前") != ""
		PRINTFORM %@"[{LOCAL,3}] %GET_STR(MASTER, "Hediff", (LOCAL), "名前")%({HasBionic:LOCAL})", 32, LEFT%
		LOCAL:5 ++
		SIF LOCAL:5 % 4 == 0
			PRINTL 
	ENDIF
NEXT
SIF LOCAL:5 % 4 != 0
	PRINTL 

PRINTFORML [999] - Leave
INPUT
nPart = RESULT
SELECTCASE RESULT
CASE 999
CASEELSE
	CALL BionicConflictMenu(TARGET,nPart)
	IF RESULT
		HasBionic:nPart --
		EXP:MASTER:Medical ++
		SIF ITEM:109
			EXP:MASTER:Medical ++
		SETBIT TFLAG:194, 1
	ENDIF
ENDSELECT
ENDIF

CASE 301
IF TendType == -5
PRINTFORML Select a natural part that you have

LOCAL:5 = 0
FOR LOCAL, 1, 100
	IF HasNaturalPart:LOCAL && BDY_PART_NAME(LOCAL) != ""
		PRINTFORM %@"[{LOCAL,3}] %BDY_PART_NAME(LOCAL)%({HasNaturalPart:LOCAL})", 32, LEFT%
		LOCAL:5 ++
		SIF LOCAL:5 % 4 == 0
			PRINTL 
	ENDIF
NEXT
SIF LOCAL:5 % 4 != 0
	PRINTL 

PRINTFORML [999] - Leave
INPUT
nPart = RESULT
SELECTCASE RESULT
CASE 999
CASEELSE
	nPartPick = nPart
	CALLF ConflictingParts(nPartPick)


	IF ConflictingPartChoices:1
	PRINTFORML There's multiple places where you can put this %BDY_PART_NAME(nPartPick)% in.
	FOR LOCAL,0, 100
		SIF ConflictingPartChoices:LOCAL && BDY_PART_NAME(ConflictingPartChoices:LOCAL) != ""
			PRINTFORML [{ConflictingPartChoices:LOCAL}] - %BDY_PART_NAME(ConflictingPartChoices:LOCAL)%
	NEXT
	PRINTFORML [-1] - Cancel
	INPUT
		IF RESULT != -1
			nPartPick = RESULT
		ELSE
			RETURN 0
		ENDIF
	ENDIF

	LOCALS =
	PRINTFORM Adding a natural part will remove everything in %CALLNAME:TARGET%'s 
	CALLF BodyPartParent(nPart)
	FOR LOCAL:1,0,20
		SIF !BodyPartChildren:(LOCAL:1)
			CONTINUE
		LOCALS += @"%BDY_PART_NAME(BodyPartChildren:(LOCAL:1))%、"
	NEXT
	PRINTFORML %LIST_IN_STRING(LOCALS)%
	PRINTL

	hediffCount = DT_SELECT(@"Hediff", @"chara = {TARGET} and part = {nPartPick}", , gotHediffs)
	FOR LOCAL:3,0,hediffCount
		IF DT_CELL_GET(@"Hediff", gotHediffs:(LOCAL:3), "type", 1) > 100
			IF !nHasBionicParts
				PRINTFORML The following bionic parts will be reclaimed to your inventory:
				FOR LOCAL:1,0,20
					SIF !BodyPartChildren:(LOCAL:1)
						BREAK
					hediffCount2 = DT_SELECT(@"Hediff", @"chara = {TARGET} and part = {BodyPartChildren:(LOCAL:1)}", , gotHediffs2)
					FOR LOCAL:4,0,hediffCount2
						SIF !IsBionicPart(TARGET,(BodyPartChildren:(LOCAL:1)),(LOCAL:4))
							CONTINUE
						PRINTFORML ・%GET_STR(MASTER, "Hediff", DT_CELL_GET(@"Hediff", gotHediffs2:(LOCAL:4), "type", 1), "名前")%
						HasBionic:(DT_CELL_GET(@"Hediff", gotHediffs2:(LOCAL:4), "type", 1)-100) ++
					NEXT
				NEXT
				nHasBionicParts = 1
			ENDIF
		ENDIF	
	NEXT
		FOR LOCAL:1,0,20
			SIF !BodyPartChildren:(LOCAL:1)
				BREAK
			CALLF ClearPartHediff(TARGET,BodyPartChildren:(LOCAL:1),1)
		NEXT
	HasNaturalPart:nPart --
	EXP:MASTER:Medical ++
	SIF ITEM:109
		EXP:MASTER:Medical ++	
	SETBIT TFLAG:194, 2
	IF FLAG:70
	CALL RECOVER(MASTER, -80, "TSP", "Surgery")
	ELSE
	TIME += 15
	ENDIF
	WAIT
ENDSELECT
ENDIF
CASE 302
	IF TendType != -5 || TARGET == MASTER
		CONTINUE
	ENDIF
	PRINTFORML Do you want to harvest every part that's possible?
	PRINTFORML You will gain one of the following:
	LOCAL:18 = 0
	LOCAL:19 = 0
	FOR LOCAL,0,100
		IF BodyPartHealth:TARGET:LOCAL:0 == BodyPartHealth:TARGET:LOCAL:1 && LogicalHarvestPart(LOCAL) && !BodyPartRemoved:TARGET:LOCAL && STRLENS(BDY_PART_NAME(LOCAL))
				PRINTFORML ・%BDY_PART_NAME(LOCAL)%
				LOCAL:18++
		ENDIF
	NEXT
	IF !LOCAL:18
		CLEARLINE 2
		PRINTFORMW %CALLNAME:TARGET% has already been stripped clean of parts.
		CONTINUE
	ENDIF

	IF nNecro
		SETCOLOR C_RED
		PRINTFORML This will KILL %CALLNAME:TARGET%!
		RESETCOLOR
	ENDIF
	IF FLAG:70
		PRINTFORML This will cost {80*(LOCAL:18)} TSP
		IF BASE:MASTER:TSP < 80*(LOCAL:18)
			PRINTFORMW Unfortunately, you do not have enough TSP.
			CONTINUE
		ENDIF
	ELSE
		PRINTFORML This will take {15*(LOCAL:18)} minutes
	ENDIF
	CALL ASK_YN()
	SELECTCASE RESULT
	CASE 0
		IF FLAG:70
		CALL RECOVER(MASTER, -80*(LOCAL:18), "TSP", "Surgery")
		ELSE
		TIME += (15*(LOCAL:18))
		ENDIF
		REPEAT 100
			SIF BodyPartHealth:TARGET:COUNT:0 != BodyPartHealth:TARGET:COUNT:1 || !LogicalHarvestPart(COUNT) || BodyPartRemoved:TARGET:COUNT
				CONTINUE
			SIF !STRLENS(BDY_PART_NAME(COUNT))
				CONTINUE
			REUSELASTLINE  Removing %BDY_PART_NAME(COUNT)% \@ TARGET != MASTER ? from %CALLNAME:TARGET% # from yourself \@.%"." * LOCAL:19%
			TWAIT 150, 1
			CALL HarvestBodyPart(TARGET,COUNT,SurgerySucc,1)
			CLEARLINE 1
			LOCAL:19++
		REND
		IF !IsDead:TARGET:0
			KilledBy:TARGET:0 = MASTER
			KilledWith:TARGET:0 '= "Surgery"
			CALL CrippleEffects(TARGET)
			IF IsDead:TARGET:0
				CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("killSurgery")
			ENDIF
		ENDIF
		SETBIT TFLAG:194, 3
	ENDSELECT

CASEELSE
	nPart = RESULT
	IF !STRLENS(BDY_PART_NAME(nPart))
		CONTINUE
	ENDIF
	IF TendType == -5
		PRINTFORML What are you going to do with this %BDY_PART_NAME(nPart)%?
		PRINTFORML Surgery Success Change: {SurgerySucc}\%
		PRINTL
		SIF LogicalHarvestPart(nPart)
		PRINTFORML [100] - Harvest
		hediffCount = DT_SELECT(@"Hediff", @"chara = {TARGET} and part = {nPart}", , gotHediffs)
		FOR LOCAL:3,0,hediffCount
			IF DT_CELL_GET(@"Hediff", gotHediffs:(LOCAL:3), "type", 1) > 100
				SIF GET_INT(MASTER, "Hediff", DT_CELL_GET(@"Hediff", gotHediffs:(LOCAL:3), "type", 1), "Replaces Other Bionics")
					CONTINUE
				PRINTFORML [{LOCAL:3,3}] - Remove %HediffName(TARGET,nPart,LOCAL:3,1)%
			ENDIF
		NEXT
		PRINTL
		PRINTFORML [200] - Install Part
		PRINTL
		PRINTFORML [999] - Leave
		INPUT
		
		SELECTCASE RESULT
		CASE 100
		IF !LogicalHarvestPart(nPart)
			PRINTFORML This part is not harvestable.
			PRINTFORMW Returning to main doctoring screen...
			CONTINUE
		ENDIF

		CALL HarvestBodyPart(TARGET,nPart,SurgerySucc,0)

		CASE 0 TO 99
			nPartPick = RESULT
			IF FLAG:70
			CALL RECOVER(MASTER, -80, "TSP", "Surgery")
			ELSE
			TIME += 15
			ENDIF
			REPEAT 5
			hediffCount = DT_SELECT(@"Hediff", @"chara = {TARGET} and part = {nPart}", , gotHediffs)

			REUSELASTLINE  Removing %GET_STR(TARGET, "Hediff", (DT_CELL_GET(@"Hediff", gotHediffs:nPartPick, "type", 1)), "名前")% \@ TARGET != MASTER ? from %CALLNAME:TARGET% # from yourself \@.%"." * COUNT%
			TWAIT 150, 1
			REND
			LOCAL:6 = RAND:100
			IF LOCAL:6 < SurgerySucc
				PRINTFORMW The %GET_STR(TARGET, "Hediff", (DT_CELL_GET(@"Hediff", gotHediffs:nPartPick, "type", 1)), "名前")% from %CALLNAME:TARGET% was successfully removed!
				CALL GET_BIONIC((DT_CELL_GET(@"Hediff", gotHediffs:nPartPick, "type", 1)), 1, 1) 
				CALLF ClearHediff(TARGET,nPart,nPartPick)
				PRINTL
				
				EXP:MASTER:Medical ++
				SIF ITEM:109
					EXP:MASTER:Medical ++
				SETBIT TFLAG:194, 3
			ELSE
				CALL SurgeryFailure(TARGET,nPart)
			ENDIF
		ENDSELECT
	ELSE
		IF TendItems:TendType != -1
			IF !ITEM:(TendItems:TendType)
				PRINTFORML You do not have enough %ITEMNAME_TR(TendItems:TendType)% to do this operation.
				PRINTFORML Please pick another item which you have.
				CONTINUE
			ENDIF
			ITEM:(TendItems:TendType) --
		ELSE
		ENDIF

		;PRINTFORML %PARSE("You wrap")% %ITEMNAME_TR(使用アイテム)% around the %BDY_PART_NAME(LOCAL)% to stop the bleeding.
		
		;fake bandages
		IF TendItems:TendType == 1106
			IF RAND(100) < 30
				PRINTDATAL
				DATAFORM The bandage rips as you use it.
				DATAFORM As you're tending to the wound, the bandage rips.
				DATAFORM Before you're able actually apply the bandage, it tears apart.
				DATAFORM The bandage tears after you wrap it around.
				DATAFORM The dressing fails to adhere.
				ENDDATA
				PRINTFORMW These counterfeit bandages aren't very useful.
				CONTINUE
			ENDIF
		ENDIF

		CALLF BodyPartGroup(nPart)
		FOR LOCAL,0,20
			SIF !BodyPartChildren:LOCAL
				CONTINUE
			hediffCount = DT_SELECT(@"Hediff", @"chara = {TARGET} and part = {BodyPartChildren:LOCAL}", , gotHediffs)
			FOR LOCAL:3,0,hediffCount
				SIF IsBionicPart(TARGET,BodyPartChildren:LOCAL,LOCAL:3)
					CONTINUE
				LOCAL:4 = RAND(TendQuality-20,TendQuality+20)

				;apply treatment multiplier
				LOCAL:4 = LOCAL:4*(TendItemMult:TendType)/100

				DT_CELL_SET @"Hediff", gotHediffs:(LOCAL:3), "tended", MAX(1,LOCAL:4), 1
				PRINTFORML %HediffName(TARGET,BodyPartChildren:LOCAL,LOCAL:3)% on %BDY_PART_NAME(BodyPartChildren:LOCAL)% tended. Quality: {LOCAL:4}\%
				EXP:MASTER:Medical ++
				SIF ITEM:109
					EXP:MASTER:Medical ++
				SETBIT TFLAG:194, 0
			NEXT
		NEXT
		SIF ITEM:109
			PRINTFORML With the %ITEMNAME_TR(109)%, you gained an extra experience point per wound tended
		IF FLAG:70
		CALL RECOVER(MASTER, -5, "TSP", "Surgery")
		ELSE
		TIME += 3
		ENDIF
        CALL INTERACTIVE_TUTORIAL_GET(102,203,"Tending",1)
		WAIT
		LOCAL:1 ++
	ENDIF
ENDSELECT
LOOP 1


@HarvestBodyPart(ARG,nPart,SurgerySucc,MassHarvest = 0)
#DIM SurgerySucc
#DIM MassHarvest
#DIM nPart
#DIM hediffCount
#DIM DYNAMIC gotHediffs,300

IF !MassHarvest
	IF FLAG:70
	CALL RECOVER(MASTER, -80, "TSP", "Surgery")
	ELSE
	TIME += 15
	ENDIF
	REPEAT 5
	REUSELASTLINE  Removing %BDY_PART_NAME(nPart)% \@ ARG != MASTER ? from %CALLNAME:ARG% # from yourself \@.%"." * COUNT%
	TWAIT 150, 1
	REND
ENDIF

LOCAL:6 = RAND:100
hediffCount = DT_SELECT(@"Hediff", @"chara = {ARG} and part = {nPart}", , gotHediffs)
IF LOCAL:6 < SurgerySucc
	SIF !IsBionicPart(ARG,(nPart),0)
		CALL GET_BDY_PART(nPart, 1, 1)
	FOR LOCAL:3,0,hediffCount
		IF DT_CELL_GET(@"Hediff", gotHediffs:(LOCAL:3), "type", 1) > 100
			CALL GET_BIONIC((DT_CELL_GET(@"Hediff", gotHediffs:(LOCAL:3), "type", 1)), 1, 1) 
		ENDIF
		CALLF ClearHediff(ARG,nPart,LOCAL:3)
	NEXT
	SELECTCASE nPart
	CASE 67
		BASE:ARG:Poo = 0
	CASE 74
		BASE:ARG:4 = 0
	ENDSELECT

	CALLF BodyPartParent(nPart)
	FOR LOCAL,0,20
		SIF !BodyPartChildren:LOCAL
			CONTINUE
		BodyPartRemoved:ARG:(BodyPartChildren:LOCAL) = 1
	NEXT
	IF !MassHarvest
		PRINTL
		PRINTFORMW The %BDY_PART_NAME(nPart)% from %CALLNAME:ARG% was successfully harvested!
	ENDIF
	IF !MassHarvest
		IF !IsDead:ARG:0
			KilledBy:ARG:0 = MASTER
			KilledWith:ARG:0 '= "Surgery"
			CALL CrippleEffects(ARG)
			IF IsDead:ARG:0
				CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("killSurgery")
			ENDIF
		ENDIF
		SETBIT TFLAG:194, 3
	ENDIF
ELSE
	CALL SurgeryFailure(ARG,nPart)
ENDIF

@SurgeryFailure(ARG,nPart)
#DIM nPart
$SurgeryFail
EXP:MASTER:Medical += 2
SIF ITEM:109
	EXP:MASTER:Medical += 2
SELECTCASE RAND:10
CASE 0 TO 5
	PRINTFORMW You have failed to harvest the %BDY_PART_NAME(nPart)% in a minor manner... 
	CALLF DamageBodyPart(ARG,nPart,200,2,MASTER,"Surgical incompetence")
CASE 6 TO 8
	PRINTFORMW You have failed to harvest the %BDY_PART_NAME(nPart)% in a catastrophic manner... 
	CALLF DamageBodyPart(ARG,nPart,500,2,MASTER,"Surgical incompetence")
CASE 9
	PRINTFORMW You have failed to harvest the %BDY_PART_NAME(nPart)% in a ridiculous manner... 
	CALLF DamageBodyPart(ARG,nPart,1000,2,MASTER,"Surgical incompetence")
ENDSELECT
SETBIT TFLAG:194, 4