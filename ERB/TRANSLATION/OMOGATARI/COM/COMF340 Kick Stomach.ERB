; Modular ERB: OMOGATARI/COM/COMF340 Kick Stomach.ERB
;-------------------------------------------------
;Kick Stomach
;This hypnotizes the character with a saying
;-------------------------------------------------

@ADD_CUSTOM_COM340
#DIM DYNAMIC DMG
DMG = (75*ABL:MASTER:Melee)
DOWNBASE:体力 += DamageMitigate(TARGET,MASTER,DMG,61, 0)
DOWNBASE:気力 += 800
SOURCE:苦痛 = 5000
SIF SHIRAHU(TARGET)
	SOURCE:反感 = 10000
CALLF BroadDamage(TARGET,"stomach",DMG,6,MASTER, "Kick")
CALL CrippleEffects(TARGET)
IF FLAG:70
	BASE:MASTER:TSP -= 20
ELSE
	TIME += 1
ENDIF
RETURN 1

@ADD_CUSTOM_MESSAGE_COM340
PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% 배를 세게 찬다.
PRINTFORML %HE_SHE(TARGET,1)%는 그것이 마음에 들지 않았다...
IF TALENT:妊娠
	CALL COLORMESSAGE(@"당신은 %조사처리(CALLNAME:TARGET,"의")% 배 속의 아기를 죽였다. 얼마나 잔인한가...",C_RED,2,1)
	TALENT:妊娠 = 0
	CFLAG:妊娠経過日数 = 0
ENDIF
IF !FLAG:70 && CFLAG:TARGET:313 && (BASE:TARGET:0) > 500 && !IsDead:TARGET:0
	PRINTFORML %조사처리(CALLNAME:TARGET,"가")%(가) 깨어난다!
	CALLF WAKEUP(TARGET)
ENDIF
IF SHIRAHU(TARGET)
	PRINTFORML %조사처리(CALLNAME:TARGET,"가")%/가 그것을 두고 너와 싸우기 시작한다!
	CALL KNIFE_FIGHT(TARGET,MASTER,1,1)
ENDIF

@ADD_CUSTOM_COM_ABLE340
; Do not allow during ufufu or time stop
SIF GLOBAL_COMABLE(340)
	RETURN RESULT
SIF !TFLAG:100
	RETURN 0
SIF TARGET == MASTER ; doesn't make sense to kick yourself out
	RETURN 0
SIF !nRyona || SaveIsEZB
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
RETURN 1
