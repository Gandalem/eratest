;-------------------------------------------------
;Kick Stomach
;This hypnotizes the character with a saying
;-------------------------------------------------
@ADD_CUSTOM_COM340
#DIM DYNAMIC DMG
DMG = (75*ABL:MASTER:Melee)


DOWNBASE:体力 += DamageMitigate(TARGET,MASTER,DMG,61, 0)
DOWNBASE:気力 += 800

SOURCE:苦痛 = 5000
SIF SHIRAHU(TARGET)
SOURCE:反感 = 10000

CALLF BroadDamage(TARGET,"stomach",DMG,6,MASTER, "Kick")
CALL CrippleEffects(TARGET)

IF FLAG:70
BASE:MASTER:TSP -= 20
ELSE
TIME += 1
ENDIF
RETURN 1

@ADD_CUSTOM_MESSAGE_COM340
PRINTFORML You give a hard kick to %CALLNAME:TARGET%'s belly.
PRINTFORML %HE_SHE(TARGET,1)% didn't like that...

IF TALENT:妊娠
CALL COLORMESSAGE(@"You killed the baby inside %CALLNAME:TARGET%'s belly. How cruel...",C_RED,2,1)
TALENT:妊娠 = 0
CFLAG:妊娠経過日数 = 0
ENDIF

IF !FLAG:70 && CFLAG:TARGET:313 && (BASE:TARGET:0) > 500 && !IsDead:TARGET:0
	PRINTFORML %CALLNAME:TARGET% wakes up!
	CALLF WAKEUP(TARGET)
ENDIF

IF SHIRAHU(TARGET)
	PRINTFORML %CALLNAME:TARGET% begins to fight you for that!
	CALL KNIFE_FIGHT(TARGET,MASTER,1,1)
ENDIF

@ADD_CUSTOM_COM_ABLE340
; Do not allow during ufufu or time stop
SIF GLOBAL_COMABLE(340)
	RETURN RESULT
SIF !TFLAG:100
	RETURN 0  
SIF TARGET == MASTER ; doesn't make sense to kick yourself out
    RETURN 0
SIF !nRyona || SaveIsEZB
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
RETURN 1