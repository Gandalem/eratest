	PRINTFORML This pad is really... really thick...
ENDSELECT

@UndiesMagicPick(ARG)
; #DIM DYNAMIC MagicTypes, 30
; #DIM DYNAMIC MagicTypeCount
PRINTFORML Underwear can be attuned to certain magic types with an MP cost. You need to have enough MP to attune the underwear.
PRINTFORML Depending on the underwear type, the cost to attune can be expensive
PRINTL
PRINTFORML - Self: Will only affect your underwear that you change to. Caregiver changes are unaffected.
PRINTFORML - Other: Any underwear that you change yourself even if not yours
PRINTL
PRINTFORML Current attunement   (Self): %MagicUnderwear_GetName(UNDERWEAR_MAGIC_AUTO_USE_SELF)%
PRINTFORML Current attunement (Others): %MagicUnderwear_GetName(UNDERWEAR_MAGIC_AUTO_USE_OTHER)%
PRINTFORML This will change the attunement of \@ ARG == MASTER ? your underwear # the underwear you give to others. \@
PRINTL
; HTML_PRINT @"<button value='0'>[ 0] - %"Automatic",15,LEFT% %"(Varies)",16%: Automatically pads your underwear depending on your continence level.</button>"
; HTML_PRINT @"<button value='1'>[-1] - %"Unpadded",15,LEFT% %COND_STR("(",nPee||nScat)+PeeAndPoo(nPee,nScat,@"{UNDERWEAR_PAD_TYPES_LIQUID,4}ml",@"{UNDERWEAR_PAD_TYPES_SOLID,4}g"," /")+COND_STR(")",nPee||nScat),16%: No padding. Most discreet but has no accident protection.</button>"

FOR LOCAL, 0, 30
	SIF DT_CELL_GET("DiapeMagic", LOCAL, "id") == 0
		BREAK
	LOCAL:1 = DT_CELL_GET("DiapeMagic", LOCAL, "youjutsuType")
	LOCALS '= ""
	IF !INRANGE(LOCAL:1,0,64)
		GOTO HasMagic
	ELSEIF GETBIT(TALENT:MASTER:ESP,LOCAL:1)
		$HasMagic
		LOCALS += @"<button value='%DT_CELL_GETS("DiapeMagic", LOCAL, "defName")%'>"
	ENDIF
	LOCALS += @"[{LOCAL,2}] - "
	IF !INRANGE(LOCAL:1,0,64)
		LOCALS += @"<font color='#%TOSTR(GETCONFIG("TEXT COLOR"),"X6")%'>"
	ELSE
		LOCALS += @"<font color='#\@ GETBIT(TALENT:MASTER:ESP,LOCAL:1) ? %TOSTR(GETCONFIG("TEXT COLOR"),"X6")% # 666666\@'>"
	ENDIF
	LOCALS += @"%DT_CELL_GETS("DiapeMagic", LOCAL, "label"),15,LEFT% "
	LOCALS += @": %DT_CELL_GETS("DiapeMagic", LOCAL, "description")%</font>"
	IF !INRANGE(LOCAL:1,0,64)
		LOCALS += "</button>"
	ELSEIF GETBIT(TALENT:MASTER:ESP,LOCAL:1)
		LOCALS += "</button>"
	ELSE
		SIF INRANGE(LOCAL:1,0,64)
		TRYCALLFORMF NAS_ESP_{LOCAL:1}
		LOCALS += @"(<font color='#%TOSTR(NAS_ESP_COLOR,"X6")%'>%NAS_ESP_NAME%</font> Youjutsu not learned)"
	ENDIF
	HTML_PRINT LOCALS
NEXT
PRINTL
PRINTBUTTON "[Back]", "[GoBack]"
; PRINTFORML [-9] Back
INPUTS
; SELECTCASE RESULT
; CASE -1 TO VARSIZE("UNDERWEAR_PAD_TYPES")+1
; 	UNDERWEAR_PAD_AUTO_USE = RESULT
; CASEELSE
; ENDSELECT
SELECTCASE RESULTS
CASE "[GoBack]"
	RETURN
CASEELSE
	LOCALS:0 '= RESULTS
	IF !MagicUnderwear_GetID(LOCALS:0)
		REUSELASTLINE Invalid Input
		RESTART
	ENDIF
	IF INRANGE(MagicUnderwear_GetID(LOCALS:0),0,64)
		TRYCALLFORMF NAS_ESP_{MagicUnderwear_GetID(LOCALS:0)}
		IF !GETBIT(TALENT:MASTER:ESP,MagicUnderwear_GetMagicType(LOCALS:0))
			REUSELASTLINE %NAS_ESP_NAME% Youjutsu not learned
			RESTART
		ENDIF
	ENDIF
	IF ARG == MASTER
		UNDERWEAR_MAGIC_AUTO_USE_SELF '= LOCALS:0
	ELSE
		UNDERWEAR_MAGIC_AUTO_USE_OTHER '= LOCALS:0
	ENDIF
ENDSELECT
