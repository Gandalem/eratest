@ADD_CUSTOM_COM194
PRINTFORML 작업 중이다!
CALL Com_DiaperGrab(TARGET)

@Com_DiaperGrab(ARG, ARG:1 = 0, ARG:2 = 0)
#DIM PAGE
#DIM PG_LINECOUNT
#DIM PG_INLINE
#DIM PG_CAN_MAGIC
#DIMS CONST PICKABLE_TYPES = "Underwear", "Open-Crotch", "Pull-Up", "Diaper"
#DIMS CONST PAD_TYPES = "Underwear", "Open-Crotch", "Pull-Up", "Diaper"
CALL COM_DiaperCheck(ARG)
VARSET PAGE
PRINTFORML 속옷을 선택하세요
DRAWLINE
PG_LINECOUNT = LINECOUNT
DO
CLEARLINE LINECOUNT - PG_LINECOUNT
VARSET PG_INLINE
FOR LOCAL:2,0,VAR_TEMP_MAX
CALLF DiapeStats(ARG,LOCAL:2,1,1)
IF PANTSNAME(LOCAL:2, ARG) != "" && (RESULTS == PICKABLE_TYPES:PAGE) && (BoughtClothing:6:(LOCAL:2) || ARG:2)
	CALLF DiapeStats(ARG,LOCAL:2,1,1)
	PRINTBUTTON @"%@"[{LOCAL:2,3}] - "+UNDIES_NAME_WITH_BRAND(ARG,LOCAL:2)+" ("+TOSTR(RESULT:1)+"ml/"+TOSTR(RESULT:2)+@"g%COND_STR(@"/{MagicUnderwear_Cost(ARG,LOCAL:2,ARG == MASTER ? UNDERWEAR_MAGIC_AUTO_USE_SELF # UNDERWEAR_MAGIC_AUTO_USE_OTHER)} MP",ARG == MASTER ? STRLENS(UNDERWEAR_MAGIC_AUTO_USE_SELF) # STRLENS(UNDERWEAR_MAGIC_AUTO_USE_OTHER))%)",62,LEFT%", LOCAL:2
	PG_INLINE ++
	IF PG_INLINE % 3 == 0
		PRINTL
		PG_INLINE = 0
	ENDIF
ENDIF
NEXT
IF PG_INLINE % 3
	PRINTL
ENDIF
DRAWLINE
FOR LOCAL,0,VARSIZE("PICKABLE_TYPES")
IF GROUPMATCH(LOCAL,2,3) && !nOmutsu
	CONTINUE
ENDIF
SIF PAGE == LOCAL
	SETCOLOR C_AQUA
PRINTBUTTON @"%PICKABLE_TYPES:LOCAL%", 8000+LOCAL
PRINTFORM 　　
RESETCOLOR
NEXT
PRINTL
DRAWLINE
PRINTFORML [ -3] 속옷 패드: %UndiesPadName(UNDERWEAR_PAD_AUTO_USE)%
SIF GETBIT(TALENT:MASTER:ESP,2) || GETBIT(TALENT:MASTER:ESP,18)
	PRINTFORML [ -4] 선호 마법 타입: %MagicUnderwear_GetName(ARG == MASTER ? UNDERWEAR_MAGIC_AUTO_USE_SELF # UNDERWEAR_MAGIC_AUTO_USE_OTHER)%
PRINTL
IF ARG:1 == 3
	PRINTFORML [ -1] 속옷을 제거한다.
	PRINTFORML [  0] 자동으로 속옷을 집는다.
ELSE
	PRINTFORML [  0] 속옷을 제거한다.
ENDIF
PRINTFORML [999] 정지
INPUT
SELECTCASE RESULT
	CASE 8000 TO 8000+VARSIZE("PICKABLE_TYPES")
		PAGE = RESULT-8000
	CASE 999
		RETURN
	CASE -3
		CALL UnderwearPadPick
	CASE -4
		SIF GETBIT(TALENT:MASTER:ESP,2) || GETBIT(TALENT:MASTER:ESP,18)
			CALL UndiesMagicPick(ARG)
	CASEELSE
		LOCAL:3 = RESULT
		BREAK
ENDSELECT
LOOP 1
IF !ARG:1
	CALL DiaperChangeDesc(ARG, LOCAL:3, MASTER, UNDERWEAR_PAD_AUTO_USE)
ELSEIF ARG:1 == 2
	CALLF PANTY_REWORK_CHANGE(ARG,LOCAL:3, UNDERWEAR_PAD_AUTO_USE, MASTER, ARG == MASTER ? UNDERWEAR_MAGIC_AUTO_USE_SELF # UNDERWEAR_MAGIC_AUTO_USE_OTHER)
ENDIF
RETURN LOCAL:3

@UnderwearPadPick
PRINTFORML 평소 속옷 안에 어떤 종류의 패딩을 넣을지 선택한다.
PRINTFORML 패딩 두께는 속옷의 은폐에도 영향을 미친다.
HTML_PRINT "Liners are considered thick-enough padding to count as <font color='#9999ff'>diapers</font>."
PRINTL
PRINTFORML 예외 사항:
PRINTFORML - 기저귀는 영향을 받지 않는다.
PRINTFORML - 변경하는 속옷에만 영향을 준다. 간병인의 변경은 영향을 받지 않는다.
PRINTL
PRINTFORML 현재 패드: %UndiesPadName(UNDERWEAR_PAD_AUTO_USE)%
PRINTL
HTML_PRINT @"<button value='0'>[ 0] - %"Automatic",15,LEFT% %"(Varies)",16%: 당신의 요실금 정도에 따라 속옷을 자동으로 패딩 처리한다.</button>"
HTML_PRINT @"<button value='1'>[-1] - %"Unpadded",15,LEFT% %COND_STR("(",nPee||nScat)+PeeAndPoo(nPee,nScat,@"{UNDERWEAR_PAD_TYPES_LIQUID,4}ml",@"{UNDERWEAR_PAD_TYPES_SOLID,4}g"," /")+COND_STR(")",nPee||nScat),16%: No padding. Most discreet but has no accident protection.</button>"
FOR LOCAL, 1, VARSIZE("UNDERWEAR_PAD_TYPES")+1
CALLF UNDERWEAR_PAD_TYPES(UNDERWEAR_PAD_TYPES:(LOCAL-1))
LOCALS '= @"<button value='{LOCAL}'>"
LOCALS += @"[{LOCAL,2}] - <font color='#\@ UNDERWEAR_PAD_TYPES_COUNT_AS_PAD ? 9999FF # %TOSTR(GETCONFIG("TEXT COLOR"),"X6")%\@'>%CAPITALIZE(UNDERWEAR_PAD_TYPES_LABEL),15,LEFT%</font> "
IF nPee||nScat
	;Color_Gradient_PER(C_RED,C_D_RED,100 - (BB_PER*4))
	LOCALS += @"%COND_STR("(",nPee||nScat)+PeeAndPoo(nPee,nScat,@"{UNDERWEAR_PAD_TYPES_LIQUID,4}ml",@"{UNDERWEAR_PAD_TYPES_SOLID,4}g"," /")+COND_STR(")",nPee||nScat),16%"
ENDIF
LOCALS += @": %UNDERWEAR_PAD_TYPES_DESC%"
LOCALS += "</button>"
HTML_PRINT LOCALS
NEXT
PRINTL
PRINTFORML [-9] 등
INPUT
SELECTCASE RESULT
	CASE -1 TO VARSIZE("UNDERWEAR_PAD_TYPES")+1
		UNDERWEAR_PAD_AUTO_USE = RESULT
	CASEELSE
ENDSELECT
;[ 1] - Sanitary pad    (  20ml/  20g): Zero-feel padding intended for periods. Not made to contain pee.
;[ 2] - Thin pad        ( 200ml/ 200g): A light pee pad for small bladder leaks and spurts.
;[ 3] - Bladder pad     ( 400ml/ 200g): Bladder pad for bursts and surges of pee. Not for full on accidents.
;[ 4] - Thick pad       ( 600ml/ 300g): A thicker yet discreet pad. Can contain an accident from a small bladder.
;[ 5] - Thin liner      (1200ml/ 885g): Long yet thin liner that can hold a full-on accident.
;[ 6] - Underwear liner (1600ml/1100g): Diaper-like liner that holds a bladder and bowel loss with some extra.
;[ 7] - Thick liner     (2500ml/1500g): While it may scream "You're padded", this liner can endure multiple accidents with ease.
;[ 8] - Bulky liner     (3400ml/2130g): Like strapping a bulky diaper to your underwear, this liner is made for total incontinence
;[ 1] - Void liner     : Pocket barrier panties that moves your excretions to a pocket dimension

@UndiesPadName(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "Automatic"
	CASE -1
		RETURNF "Unpadded"
	CASE IS > 0
		CALLF UNDERWEAR_PAD_TYPES(UNDERWEAR_PAD_TYPES:(ARG-1))
		RETURNF Capitalize(UNDERWEAR_PAD_TYPES_LABEL)
ENDSELECT

@UndiesPadDesc(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "No padding. Most discreet but has no accident protection."
	CASE -1
		RETURNF "Automatically pads your underwear depending on your continence level."
	CASE IS > 0
		CALLF UNDERWEAR_PAD_TYPES(UNDERWEAR_PAD_TYPES:(ARG-1))
		RETURNF Capitalize(UNDERWEAR_PAD_TYPES_LABEL)
ENDSELECT

