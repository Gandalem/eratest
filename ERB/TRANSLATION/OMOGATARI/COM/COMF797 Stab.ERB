; Modular ERB: OMOGATARI/COM/COMF797 Stab.ERB
;-------------------------------------------------
;Stab
;"Damages" the target affected by it, scales with combat experience
; Failing to "kill" the taget instantly gives a level 3 hate mark
; Useful only if you have other VICTIMcters with level 3 hate mark (they can stab you too)
;-------------------------------------------------

@ADD_CUSTOM_COM797
#DIM 集合, キャラクタ数上限, 4 ;集合:X:Y
;Y=0：キャラ登録番号
;  1：設定、移動可否(1p0:移動不可,1p3:移動対象)
;  2：移動コスト
#DIM 人数                      ;同一マップにいる人数、移動できないキャラも表示され、人数に加算されている
#DIM 入力値                    ;RESULT取得用
HANDICAP_FIXED = 0
HANDICAP_RAND = 0
TFLAG:GipsLV = 0
;if going out
IF GET_MAPID(CFLAG:MASTER:現在位置) != MAIN_MAP
	入力値 = 0
	集合:入力値:0 = TARGET
	GOTO COMBATSTATUS
ENDIF
CALL LCOMBAT_GETDATA(人数, 集合)
IF 人数 == 0
	PRINTW 아무도 여기에 없다.
	RETURN
ENDIF
;全員分のコスト計算を先に行う（たぶん全員集合の頻度が多いので）
CALL LCOMBAT_COST(人数, 集合)
$MENU
PRINTL 누구를 목표로 해야 할까요?
PRINTFORML 당신은 현재 %GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "名前")%을 들고 있습니다...
CALL LCOMBAT_DISPDATA(人数,集合)
;#; PRINTBUTTON "[69420:DEBUG]", 69420
PRINTBUTTON "[999:취소]", 999
INPUT
入力値 = RESULT
SELECTCASE 入力値
	CASE IS <= CHARANUM
		$COMBATSTATUS
		CALL COMBAT_STATUS(集合:入力値:0)
		PRINTFORMDW 당신은 공격하기에 좋은 장소를 찾는다 %CALLNAME:(集合:入力値:0)% 에서...
		PRINTFORMDW 당신은 현재 %GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "名前")%를 들고 있다...
		;#; PRINTFORML [997] - (DEBUG) Fight in the New Comabt system
		PRINTFORML [998] - 싸우기
		PRINTFORML [999] - 물러서라
		INPUT
		SELECTCASE RESULT
			CASE 999
				PRINTFORMDW 물러서라.
				SIF FLAG:223
					FLAG:223 = !FLAG:223
				RETURN
			CASE 997
				CALLF AddCombatant(MASTER,0)
				CALLF AddCombatant((集合:入力値:0),1)
				CALL TGC_CombatInit(1)
			CASEELSE
				CALLF AddCombatant(MASTER,0)
				CALLF AddCombatant((集合:入力値:0),1)
				CALL CompileCharactersToCombatant( (集合:入力値:0),1,IntimidationFactor(MASTER), @"\%name\%은(는) %조사처리(CALLNAME:MASTER,"가")% 다른 사람을 공격하는 것을 목격하고 자기 방어를 한다...", @"「같은 위치」「적 합류 확률 없음」「자위 방어」" )
				; CALL CompileCharactersToCombatant(MASTER,1,IntimidationFactor(MASTER),,"「Same Location」「No Enemy Join RNG」")
				CALL KNIFE_FIGHT(MASTER,集合:入力値:0)
		ENDSELECT
	CASE 69420
		PRINTFORML 누구?
		DRAWLINE
		FOR LOCAL,0,CHARANUM
		PRINTFORMLC [{LOCAL}] %NAME:LOCAL%
		NEXT
		PRINTFORML 
		PRINTFORML 스침 캐릭터
		FOR LOCAL,1000,1100
		CALL MobEnemyArchive(FREE_MOB_SLOT(1),LOCAL-1000)
		SIF TempMobName != ""
			PRINTFORMLC [{LOCAL}] %TempMobName%
		NEXT
		FOR LOCAL,0,DT_ROW_LENGTH("FactionUnits")
		SIF DT_CELL_GETS("FactionUnits", LOCAL, "unit name") != ""
			PRINTFORMLC [{DT_CELL_GET("FactionUnits", LOCAL, "id")}] %DT_CELL_GETS("FactionUnits", LOCAL, "unit name")%
		NEXT
		DRAWLINE
		PRINTFORML [999] 정지
		INPUT
		SELECTCASE RESULT
			CASE 0 TO CHARANUM
				入力値 = 0
				集合:入力値:0 = RESULT
				GOTO COMBATSTATUS
			CASE IS >= 1000
				CALL SpawnMobEnemy(FREE_MOB_SLOT(), RESULT >= 600000000000000000 ? RESULT # RESULT-1000)
				入力値 = 0
				集合:入力値:0 = FREE_MOB_SLOT(1)
				CALL CHARA_STATE_TR(FREE_MOB_SLOT(1))
				DRAWLINE
				CALL COLORMESSAGE(@"처녀 상실 이력: %CSTR:FREE_MOB_SLOT(1):処女喪失履歴%",C_PINK,1)
				PRINTFORML        
				GOTO COMBATSTATUS
		ENDSELECT
	CASE 999
		RETURN
ENDSELECT

@LCOMBAT_DISPDATA(人数,集合)
#DIM REF 集合,,
#DIM 人数
#DIM C_ID
FOR LOCAL, 0, 人数
C_ID = 集合:LOCAL:0
LOCALS = {LOCAL}
LOCALS = [%LOCALS,3,RIGHT%] - %CALLNAME:C_ID,15,LEFT%
IF CFLAG:C_ID:現在位置 == CFLAG:MASTER:初期位置
	LOCALS = %LOCALS%%CALLNAME:MASTER%의 방
ELSE
	LOCALS = %LOCALS%%NAME_FROM_PLACE(CFLAG:C_ID:現在位置)%
ENDIF
SIF CFLAG:C_ID:現在位置 == CFLAG:MASTER:現在位置
	集合:LOCAL:2 = 0
IF 集合:LOCAL:2 > 0
	LOCALS = %LOCALS%%" "*(MAX(62-STRLENS(LOCALS),0))% 거리 {集合:LOCAL:2,2}
ENDIF
SIF 集合:LOCAL:3
	LOCALS += @" ({集合:LOCAL:3}의 선행 요건)"
SIF CFLAG:C_ID:睡眠
	LOCALS += " (수면 중) "
SIF IS_BABY(C_ID)
	LOCALS += " (너무 어림) "
IF 集合:LOCAL:2 > GET_INT(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Range") || 集合:LOCAL:3 > GET_INT(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Penetration") || GETBIT(集合:LOCAL:1, 0) || IS_BABY(C_ID)
	SETCOLOR C_GRAY
	PRINTPLAINFORM %LOCALS%    
ELSE
	PRINTFORM %LOCALS%
ENDIF
PRINTL
RESETCOLOR
NEXT

@LCOMBAT_GETDATA(人数, 集合)
#DIM REF 集合, ,
#DIM REF 人数
#DIM C_ID
VARSET 集合
VARSET 人数
FOR LOCAL, 0, CHARANUM
SIF AT_HOME(LOCAL) == 0
	CONTINUE
SIF CFLAG:LOCAL:現在位置 == MAXROOM && CFLAG:LOCAL:睡眠
	CONTINUE
SIF LOCAL == MASTER
	CONTINUE
集合:人数:0 = LOCAL
C_ID = 集合:人数:0
;選択否
IF CFLAG:C_ID:現在位置 == MAXROOM || CFLAG:C_ID:現在位置 == OMANEKIBEYA()
	SETBIT 集合:人数:1, 0
ELSEIF IsDead:TARGET:0
	SETBIT 集合:人数:1, 0
ENDIF
人数 ++
NEXT
;全キャラを対象に移動コストの算出を行う
;呼び出し元で全キャラループやってるんならコスト算出側で更に全キャラループやるよりも
;算出済みの地点を記憶しておいた方が早いのでは？

@LCOMBAT_COST(人数, 集合)
#DIM 人数
#DIM REF 集合,,
#DIM LIST_ID                 ;参照しているLISTのID
#DIM DYNAMIC DONE_CNT        ;算出済み地点の数
#DIM DYNAMIC DONE_PLACE, 100 ;算出済み地点のPLACE_ID
#DIM DYNAMIC DONE_COST,  100 ;算出済み地点のコスト
#DIM TEMP_PLACE              ;参照用の一時変数
FOR LIST_ID, 0, 人数
;NG処理は先にやっておきましょう
IF GETBIT(集合:LIST_ID:1, 0)
	集合:LIST_ID:2 = -1
	CONTINUE
ENDIF
TEMP_PLACE = FINDELEMENT(DONE_PLACE, CFLAG:(集合:LIST_ID:0):現在位置, 0, DONE_CNT)
;算出済み
IF TEMP_PLACE >= 0
	集合:LIST_ID:2 = DONE_COST:TEMP_PLACE
	;算出まだ
ELSE
	CALL CALC_LCOMBAT_COST(集合, LIST_ID)
	DONE_PLACE:DONE_CNT   = CFLAG:(集合:LIST_ID:0):現在位置
	DONE_COST:DONE_CNT    = 集合:LIST_ID:2
	DONE_CNT ++
ENDIF
NEXT
;集合コストの算出
;F関数化したかったがSKIPMOVE使ってるから断念、残念

@CALC_LCOMBAT_COST(集合, 対象)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM REF 集合,,
#DIM 対象
#DIM 移動コスト
#DIM 暫定目的地
#DIM 最終目的地
#DIM TEMP_現在位置
#DIM C_ID
#DIM PEN_COST
C_ID = 集合:対象:0
PEN_COST = 0
TEMP_現在位置 = CFLAG:MASTER:現在位置
最終目的地 = CFLAG:C_ID:現在位置
暫定目的地 = 最終目的地
[IF_DEBUG]
;PRINTFORML %CALLNAME:C_ID%の移動コストを計算
[ENDIF]
IF CAN_MOVE(TEMP_現在位置, 暫定目的地) & 1
	移動コスト = 1
	集合:LOCAL:3 = 0
ELSE
	FOR 移動コスト, 1, 20
	WHILE !(CAN_MOVE(TEMP_現在位置, 暫定目的地) & 1)
	TRYCALLFORM SKIP_MOVE_{MAIN_MAP}(暫定目的地, TEMP_現在位置)
	SIF !暫定目的地
		THROW 暫定目的地が異常です
	[IF_DEBUG]
	;PRINTFORML {TEMP_現在位置}から{暫定目的地}に直接行けないから{RESULT}を目指すよ
	[ENDIF]
	暫定目的地 = RESULT
	WEND
	SIF !(CAN_MOVE(暫定目的地, 最終目的地) & 2)
		PEN_COST ++
	SIF CAN_MOVE(暫定目的地, 最終目的地) & 1
		BREAK
	TEMP_現在位置 = 暫定目的地
	暫定目的地 = 最終目的地
	NEXT
ENDIF
集合:対象:2 = 移動コスト
集合:対象:3 = PEN_COST
[IF_DEBUG]
;PRINTFORML Shooting %CALLNAME:C_ID% costs {移動コスト} and requires {PEN_COST} penetration power
[ENDIF]

@ADD_CUSTOM_COM_ABLE797
SIF !nRyona || SaveIsEZB
	RETURN 0
SIF inTrain == 3
	RETURN 0
; Do not allow during ufufu or time stop
SIF FLAG:70 == 1
	RETURN 0
SIF CFLAG:うふふ != 0
	RETURN 0
SIF !TFLAG:100
	RETURN 0
SIF GET_MAPID(CFLAG:MASTER:現在位置) == MAIN_MAP
	RETURN 1
SIF CFLAG:睡眠
	RETURN 0
SIF TARGET == MASTER ; doesn't make sense to kick yourself out
	RETURN 0
RETURN 1
