; Modular ERB: OMOGATARI/COM/COMF338 Public Toy Play.ERB
;-------------------------------------------------
;Public Toy Play
;This kicks the selected character from the room the player is in
;-------------------------------------------------

@ADD_CUSTOM_COM338
IF TALENT:SexKnow > -1 && ABL:露出癖 + TALENT:羞恥心 < 3
	DRAWLINE
	PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 여전히 공공장소에서 놀림을 받는다는 생각에 불편해한다.
	TFLAG:193 = -1
	RETURN -1
ENDIF
IF TFLAG:PublicToyPlay > 0
	CALL ENDUFUFU(TARGET)
ELSE
	TFLAG:PublicToyPlay = TARGET
ENDIF
RETURN 1

@ADD_CUSTOM_MESSAGE_COM338
PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"를")%(를) 장난 놀이를 하도록 설득한다.

@ADD_CUSTOM_COM_ABLE338
; Do not allow during ufufu or time stop
SIF FLAG:70 == 1
	RETURN 0
SIF CFLAG:うふふ != 0
	RETURN 0
SIF !TFLAG:100
	RETURN 0
SIF CFLAG:睡眠
	RETURN 0
SIF TARGET == MASTER ; doesn't make sense to kick yourself out
	RETURN 0
SIF TFLAG:PublicToyPlay > 0 && TFLAG:PublicToyPlay != TARGET
	RETURN 0
SIF !CFLAG:TARGET:同行
	RETURN 0
RETURN 1
