@ADD_CUSTOM_COM338
IF TALENT:SexKnow > -1 && ABL:露出癖 + TALENT:羞恥心 < 3
	DRAWLINE
	PRINTFORMW %CALLNAME:TARGET% is still uncomfortable with the idea of being teased in public.
	TFLAG:193 = -1
	RETURN -1
ENDIF

IF TFLAG:PublicToyPlay > 0
CALL ENDUFUFU(TARGET)
ELSE
TFLAG:PublicToyPlay = TARGET
ENDIF

RETURN 1

