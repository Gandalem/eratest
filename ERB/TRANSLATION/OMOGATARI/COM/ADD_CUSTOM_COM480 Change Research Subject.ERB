@ADD_CUSTOM_COM480
#DIM DYNAMIC COM480_FACTION

IF !CurrentFactionForResearch && !FactionRank:MASTER:0
    ;silly game
    CurrentFactionForResearch = 99
    COM480_FACTION = 99
ENDIF


;no factions means automatically go to player's faction.
IF !nFactions
    COM480_FACTION = 99
ELSE
    PRINTFORML Who are you researching for?
    FOR LOCAL,0,MaxFactions
        IF LOCAL == 99
            ;player's faction
            IF FactionExist(99)
            PRINTFORML [ 99] - %FactionName(99)%
            ELSE
            PRINTFORML [ 99] - Personal Research
            ENDIF
            CONTINUE
        ENDIF
        SIF !FactionRank:MASTER:LOCAL
            CONTINUE
        SIF !FactionExist(LOCAL)
            CONTINUE
        PRINTFORML [{LOCAL,3}] - %FactionName(LOCAL)%
    NEXT
    PRINTL
    PRINTFORML [998] - \@ !FactionExist(99) && CurrentFactionForResearch == 99 ? Personal Research # %FactionName(CurrentFactionForResearch)% \@ (Current Target)
    PRINTFORML [999] - Leave
    INPUT
    COM480_FACTION = RESULT
    SIF COM480_FACTION == 998
        COM480_FACTION = CurrentFactionForResearch
ENDIF

SIF !FactionExist(COM480_FACTION) && COM480_FACTION != 99
    RETURN
CurrentFactionForResearch = COM480_FACTION
CALL RESEARCH_MENU(COM480_FACTION)
RETURN 1


