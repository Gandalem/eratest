@ADD_CUSTOM_COM_ABLE480
;勉強実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(412)
	RETURN RESULT
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
;勉強出来る部屋か
IF CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置 && ITEM:ケヤキの机椅子
	;上の条件を満たしたら処理を飛ばす
ELSEIF !勉強可(CFLAG:MASTER:現在位置)
	RETURN 0
ENDIF
;添い寝中
SIF CFLAG:添い寝中
	RETURN 0
;イタズラ中
SIF CFLAG:MASTER:イタズラ
	RETURN 0
;気力0
SIF BASE:MASTER:気力 <= 0
	RETURN 0
SIF CFLAG:MASTER:うふふ
	RETURN 0
RETURN 1