; Modular ERB: OMOGATARI/COM/COMF430 Wear Pilfered Panties.ERB
;-------------------------------------------------
;着替える
;日常系コマンド、レベル1
;-------------------------------------------------

@COM430_PANTY_REWORK
#DIM C_ID
#DIM PANTY
#DIM P_ID
;困ったことに固有はキャラで名称判定しているのであなたが履くと名前が変わる
PRINTW 도둑맞은 팬티 같은 걸 입을까?
DRAWLINE
CALL DISPLAY_ALL_COLLECTION(1,1)
DRAWLINE
PRINTFORML [0] 신경 쓰지 마
$INPUT_LOOP
INPUT
IF RESULT == 0
	RETURN 0
ELSE
	P_ID = RESULT
	C_ID = DT_CELL_GET("PANTS_TEMP", P_ID,  @"chara", 1)
	PANTY = DT_CELL_GET("PANTS_TEMP", P_ID,  @"panty", 1)
	CALL PANTY_REWORK_SPEND_HAVE_COLLECTION(P_ID)
	IF RESULT != 0
		PRINTFORML 바꾸기 전에 그들을 옆에 두기 전에 %PARSE("You")%의 %CALLNAME:(C_ID)%를 %PANTSNAME(PANTY, C_ID)% 정리한다.
		CALL DiaperChangeDesc(MASTER, PANTY, MASTER)
	ELSE
		GOTO INPUT_LOOP
	ENDIF
ENDIF
IF !FLAG:時間停止
	TIME += 3
ELSE
	BASE:MASTER:TSP -= 5
ENDIF
RETURN 1
