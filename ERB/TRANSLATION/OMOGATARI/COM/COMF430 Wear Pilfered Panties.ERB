;-------------------------------------------------
;着替える
;日常系コマンド、レベル1
;-------------------------------------------------
@COM430_PANTY_REWORK
#DIM C_ID
#DIM PANTY
#DIM P_ID

;困ったことに固有はキャラで名称判定しているのであなたが履くと名前が変わる

PRINTW Change into some stolen panties?
DRAWLINE
CALL DISPLAY_ALL_COLLECTION(1,1)
DRAWLINE
PRINTFORML [0] Never mind
$INPUT_LOOP
INPUT
IF RESULT == 0
	RETURN 0
ELSE
	P_ID = RESULT
	C_ID = DT_CELL_GET("PANTS_TEMP", P_ID,  @"chara", 1)
	PANTY = DT_CELL_GET("PANTS_TEMP", P_ID,  @"panty", 1)
	CALL PANTY_REWORK_SPEND_HAVE_COLLECTION(P_ID)
	IF RESULT != 0
		PRINTFORML %PARSE("You")% clean up %CALLNAME:(C_ID)%'s %PANTSNAME(PANTY, C_ID)% before putting them on the side before you change.
		CALL DiaperChangeDesc(MASTER, PANTY, MASTER)
	ELSE
		GOTO INPUT_LOOP
	ENDIF
ENDIF
IF !FLAG:時間停止
	TIME += 3
ELSE
	BASE:MASTER:TSP -= 5
ENDIF
RETURN 1