ELSE


DOWNBASE:ARG:体力 += 10
DOWNBASE:ARG:気力 += 50

SOURCE:ARG:UPleas += 125
SOURCE:ARG:露出 += 10
SOURCE:ARG:逸脱 += 20
PeeHoldExp:ARG:0 += 1
EXP:UExp ++
EXP:USex ++

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	SOURCE:ARG:鬱屈 += 20

;Vへの苦痛は先に処理しておく
;EXP:Ｖ経験をみる（処女はありえない）
LOCAL = 25
LOCAL:1 = 20
IF EXP:ARG:UExp < EXPLV:2
	TIMES LOCAL , 0.80
	TIMES LOCAL:1 , 1.20
ELSEIF EXP:ARG:UExp < EXPLV:3
	TIMES LOCAL , 0.40
ELSEIF EXP:ARG:UExp < EXPLV:4
	TIMES LOCAL , 0.10
ELSEIF EXP:ARG:UExp < EXPLV:5
	TIMES LOCAL , 0.00
ELSEIF EXP:ARG:UExp >= EXPLV:5
	TIMES LOCAL , 0.00
ENDIF

;PALAM:潤滑をみる
IF PALAM:ARG:潤滑 < PALAMLV:1
	TIMES LOCAL , 1.20
	TIMES LOCAL:1 , 1.50
ELSEIF PALAM:ARG:潤滑 < PALAMLV:2
	TIMES LOCAL , 0.70
	TIMES LOCAL:1 , 1.20
ELSEIF PALAM:ARG:潤滑 < PALAMLV:3
	TIMES LOCAL , 0.40
ELSEIF PALAM:ARG:潤滑 < PALAMLV:4
	TIMES LOCAL , 0.10
ELSEIF PALAM:ARG:潤滑 >= PALAMLV:4
	TIMES LOCAL , 0.10
ENDIF
SOURCE:ARG:苦痛 += LOCAL
SOURCE:ARG:反感 += LOCAL:1

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;自慰実行時は経験＋１
SIF EXP_UP(68,TARGET)
	EXP:ARG:UExp += 1
ENDIF
RETURN 1

