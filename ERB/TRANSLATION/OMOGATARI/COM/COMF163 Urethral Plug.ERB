;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1

CSTR:TARGET:10 += @"{PLAYER}/"
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
TCVAR:TARGET:2 = 22
;強度
TCVAR:TARGET:4 = 900
TCVAR:LostVirginU = 1

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 100
	SOURCE:UPleas = 250
	SOURCE:苦痛 = 25

ELSE

	DOWNBASE:体力 += 30
	DOWNBASE:気力 += 100

	SOURCE:UPleas = 250
	SOURCE:苦痛 = 50
	SOURCE:露出 = 20
	SOURCE:逸脱 = 40
	SOURCE:反感 = 40


	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 40

	;give pain and hostility if still urethral virgin
	IF !CFLAG:TARGET:LostVirginUDay
		SOURCE:苦痛 += 2000
		SOURCE:反感 += 3000
	ENDIF
ENDIF
;call pain check
CALL PAIN_CHECK_U(TARGET)

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;give exp
EXP:UExp ++
EXP:USex ++
IF FLAG:70 == 1
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ELSE
	;異常経験
	IF !CFLAG:TARGET:LostVirginUDay && !GETBIT(CFLAG:3,3)
		EXP:異常経験 ++
		SETBIT CFLAG:3,3
	ENDIF

	;同性愛　レズなら戻り値1ゲイなら戻り値2
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ENDIF
EXP:PLAYER:道具使用経験 ++

;bugfix
TIME ++
RETURN 1

;-------------------------------------------------
