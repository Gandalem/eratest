;体力をみる　成長量を評価
;addition custom code, duplicated characters
評価値 = (QOL_UNBUFFED_MAXBASE(GETNUM(BASE, "体力"), ARG) - CSVBASE(NO:ARG,0)) * 2 ;qol custom code, don't count temporary buffs]
IF MAXBASE:ARG:体力 >= 9000
