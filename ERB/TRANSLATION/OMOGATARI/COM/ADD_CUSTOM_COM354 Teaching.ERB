@ADD_CUSTOM_COM354
#DIM teachLineCount
#DIM teachTeacher
#DIM teachStudent
#DIMS STATIC teachCategoryList = "Skills", "Youjutsu" 
#DIMS STATIC teachCategoryListLabel = "skills", "Youjutsu spells" 
#DIMS teachCategory
#DIM teachEffectiveness
#DIM teachEffectivenessMult
#DIM teachEffectivenessPotential
#DIM HasMenu
#DIM PAGE
#DIM teachHit
#DIM teachLevelTeacher
#DIM teachLevelStudent
#DIM teachLessonTime = 15, 45, 120
#DIM teachLessonStrength = 70, 100, 225
#DIMS teachLessonLabel = "Gentle", "Normal", "Intense"
#DIM DYNAMIC teachLessonPick = 1


teachLineCount = LINECOUNT
teachTeacher = TARGET
teachStudent = MASTER
PAGE = 0

;no more time
IF TCVAR:TARGET:TrainingTimeDone >= TrainingTimeCredits(TARGET) && MONEY:2 <= 0
	PRINTFORML %CALLNAME:TARGET% doesn't want to do any more training today.
	PRINTFORMW Try again tomorrow.
	RETURN 0
ENDIF

REDRAW 0
DO
	HasMenu = 0
	PRINTFORML Teaching
	CALL COLOR_LINE
	PRINTFORML Teacher: %CALLNAME:teachTeacher%%COND_STR(" (You)", teachTeacher == MASTER)%
	PRINTFORML Student: %CALLNAME:teachStudent%%COND_STR(" (You)", teachStudent == MASTER)%
	PRINTFORM You have {TrainingTimeCredits(TARGET)-TCVAR:TARGET:TrainingTimeDone} daily training credits
	IF MONEY:2
		PRINTFORM  and %PALAM_NUM_NAS(MONEY:2,1)% Charisma (extra credits).
	ENDIF
	PRINTL
	CALL COLOR_LINE
	SELECTCASE PAGE
	CASE 0
		;Skills
		FOR LOCAL,0,VARSIZE("ABL")
			SIF ABL_TO_EXP(LOCAL) == -1
				CONTINUE
			SELECTCASE LOCAL
			CASE 46 TO 49
				teachLevelTeacher = TALENT:teachTeacher:LOCAL
				teachLevelStudent = TALENT:teachStudent:LOCAL
			CASEELSE
				teachLevelTeacher = ABL:teachTeacher:LOCAL
				teachLevelStudent = ABL:teachStudent:LOCAL
			ENDSELECT
			SIF LEVEL_TO_RANK(teachLevelTeacher) < 3
				CONTINUE
			HasMenu = 1
			;[ 0] - Fire
			PRINTFORM [{LOCAL,2}] %ABL_TR(LOCAL), 15, LEFT% (
			RESETCOLOR
		PRINTFORM \@ teachStudent == MASTER ? You # %CALLNAME:teachStudent% \@ 
			CALL PRINT_RANK(teachLevelStudent,"MAX_6")
			PRINTFORM  {teachLevelStudent,2}
			PRINT  | 
			PRINTFORM \@ teachTeacher == MASTER ? You # %CALLNAME:teachTeacher% \@ 
			CALL PRINT_RANK(teachLevelTeacher,"MAX_6")
			PRINTFORM  {teachLevelTeacher,2}
			PRINTL )

		NEXT
		IF !HasMenu
			PRINTFORML %PARSE("You do",,,teachTeacher)% not know any skill well enough to teach.
		ENDIF
	CASE 1
		;Youjutsu
		FOR LOCAL, 0, 64
			IF GETBIT(TALENT:teachTeacher:ESP, LOCAL) && STRLENS(EsperAbilitySTR(LOCAL))
				SIF LEVEL_TO_RANK(YoujutsuLevel:teachTeacher:LOCAL) < 3
					CONTINUE
				SELECTCASE LOCAL
				CASE 18
					SIF !GETBIT(nPee,1) && !GETBIT(nScat,2)
						CONTINUE
				CASE 19
					SIF !nHypno
						CONTINUE
				CASEELSE
					SIF !EXISTFUNCTION(@"%TOUPPER("EsperMenuPage_")%{LOCAL}")
						CONTINUE
				ENDSELECT
				HasMenu = 1
				;[ 0] - Fire
				TRYCALLFORMF NAS_ESP_{LOCAL}
				PRINTFORM [{LOCAL,2}] %NAS_ESP_NAME, 15, LEFT% (
				RESETCOLOR
				PRINTFORM \@ teachStudent == MASTER ? You # %CALLNAME:teachStudent% \@ 
				IF !GETBIT(TALENT:teachStudent:ESP,LOCAL)
					PRINTFORM Not Learned
				ELSE
					CALL PRINT_RANK(YoujutsuLevel:teachStudent:LOCAL,"MAX_6")
					PRINTFORM  {YoujutsuLevel:teachStudent:LOCAL,2}
				ENDIF
				PRINT  | 
				PRINTFORM \@ teachTeacher == MASTER ? You # %CALLNAME:teachTeacher% \@ 
				IF !GETBIT(TALENT:teachTeacher:ESP,LOCAL)
					PRINTFORM Not Learned
				ELSE
					CALL PRINT_RANK(YoujutsuLevel:teachTeacher:LOCAL,"MAX_6")
					PRINTFORM  {YoujutsuLevel:teachTeacher:LOCAL,2}
				ENDIF
				PRINTL )
			ENDIF
		NEXT
		IF !HasMenu
			PRINTFORML %PARSE("You do",,,teachTeacher)% not know any Youjutsu spells well enough to teach.
		ENDIF
	ENDSELECT

	CALL COLOR_LINE
	FOR LOCAL,0, VARSIZE("teachCategoryList")
		SIF PAGE == LOCAL
			SETCOLOR 0x00FFFF
		PRINTBUTTON teachCategoryList:LOCAL, LOCAL + 8000
		RESETCOLOR
		PRINTFORM 　　
	NEXT
	PRINTL

	CALL COLOR_LINE
	PRINTFORML [-3] - Training Regime: %teachLessonLabel:teachLessonPick% ({teachLessonTime:teachLessonPick} min)
	PRINTFORML [-2] - Switch to \@ teachTeacher == MASTER ? %CALLNAME:TARGET% # %CALLNAME:MASTER% \@
	PRINTFORML [-1] - Back
	INPUT
	teachHit = RESULT
	SELECTCASE teachHit
	CASE -1
	RETURN
	CASE -2
		IF teachStudent == MASTER
			teachStudent = TARGET
			teachTeacher = MASTER
		ELSE
			teachStudent = MASTER
			teachTeacher = TARGET
		ENDIF
	CASE -3
		PRINTFORML Select a training regime.
		PRINTFORML You have {TrainingTimeCredits(TARGET)-TCVAR:TARGET:TrainingTimeDone} training credits (daily).
		FOR LOCAL,0,VARSIZE("teachLessonLabel")
			PRINTFORML [{LOCAL,2}] - %teachLessonLabel:LOCAL% ({teachLessonStrength:LOCAL}\% effectiveness - {teachLessonTime:LOCAL} min)
		NEXT
		PRINTL
		PRINTFORML [-1] - Back
		INPUT
		SELECTCASE RESULT
		CASE 0 TO VARSIZE("teachLessonLabel")
			teachLessonPick = RESULT
		CASEELSE
			CONTINUE
		ENDSELECT
	CASE 0 TO VARSIZE("ABL")
		SELECTCASE PAGE
		CASE 0
			SELECTCASE teachHit
			CASE 46 TO 49
				teachLevelTeacher = TALENT:teachTeacher:teachHit
				teachLevelStudent = TALENT:teachStudent:teachHit
			CASEELSE
				teachLevelTeacher = ABL:teachTeacher:teachHit
				teachLevelStudent = ABL:teachStudent:teachHit
			ENDSELECT
			IF LEVEL_TO_RANK(teachLevelTeacher) < 3
				PRINTFORML Cannot teach this skill as %PARSE("you are",,,teachTeacher)% not skilled enough in it
				PRINTFORMW Try again when you have B level in it or higher.
				CONTINUE
			ENDIF
		CASE 1
			teachLevelTeacher = YoujutsuLevel:teachTeacher:teachHit
			teachLevelStudent = YoujutsuLevel:teachStudent:teachHit
			IF teachHit >= 64
				PRINTFORMW Invalid Youjutsu
				CONTINUE
			ELSEIF !STRLENS(EsperAbilitySTR(teachHit))
				PRINTFORMW Invalid Youjutsu
				CONTINUE
			ELSEIF !GETBIT(TALENT:teachTeacher:ESP, teachHit)
				PRINTFORML Cannot teach this Youjutsu as %PARSE("you do",,,teachTeacher)% not know it.
				CONTINUE
			ELSE
				IF LEVEL_TO_RANK(YoujutsuLevel:teachTeacher:teachHit) < 3
					PRINTFORML Cannot teach this Youjutsu as %PARSE("you are",,,teachTeacher)% not skilled enough in it
					PRINTFORMW Try again when you have B level in it or higher.
					CONTINUE
				ENDIF
			ENDIF
		ENDSELECT
		IF teachLessonTime:teachLessonPick > (TrainingTimeCredits(TARGET)+MONEY:2)-TCVAR:TARGET:TrainingTimeDone
			PRINTFORML Not enough training credits for this regime
			PRINTFORMW Pick a less intensive training regime.
			CONTINUE
		ENDIF

		teachEffectivenessMult = 100
		teachEffectivenessPotential = 1

		SELECTCASE PAGE
		CASE 0
			teachEffectiveness = (LEVEL_TO_RANK(teachLevelTeacher)*150) + (LEVEL_TO_RANK(ABL:teachTeacher:41)*50) + (LEVEL_TO_RANK(ABL:teachTeacher:43)*50)
			PRINTFORML You and %CALLNAME:(teachTeacher == MASTER ? teachStudent # teachTeacher)% begin teaching %ABL_TR(teachHit)% techniques.
		CASE 1
			TRYCALLFORMF NAS_ESP_{teachHit}
			teachEffectiveness = (LEVEL_TO_RANK(YoujutsuLevel:teachTeacher:teachHit)*150) + (LEVEL_TO_RANK(ABL:teachTeacher:41)*50) + (LEVEL_TO_RANK(ABL:teachTeacher:43)*50)
			PRINTFORML You and %CALLNAME:(teachTeacher == MASTER ? teachStudent # teachTeacher)% begin teaching %NAS_ESP_NAME% Youjutsu.
		ENDSELECT
		teachEffectiveness = (teachEffectiveness*teachLessonStrength:teachLessonPick)/100

		SELECTCASE TFLAG:192
			;Normal
			CASE 0
				LOCAL = RAND:100
				LOCAL:1 = MIN(90 + GET_SUCCESS_RATE() / 5, 99)
				;相手が泥酔中だと大成功にも失敗にもならない
				SIF TCVAR:泥酔
					LOCAL = 50
				PRINTFORML {LOCAL}
				IF LOCAL < CriticalSpeakChance()
					;7％で大成功
					;NAS: determined by your speech skill
					TFLAG:193 = 1
					TFLAG:98 = 1
					PRINTFORML The training was very effective.
					teachEffectivenessMult = 225
					teachEffectivenessPotential = 2
				ELSEIF LOCAL >= LOCAL:1
					;10～1％で失敗
					TFLAG:193 = -1
					TFLAG:98 = -1
					PRINTFORML The training didn't go that well.
					teachEffectivenessMult = 60
				ELSE
					;残りは成功
					TFLAG:193 = 0
					TFLAG:98 = 0
					PRINTFORML The training went fine.
				ENDIF
			;Critical Success
			CASE 1
				IF RAND:100 <= 7
					TFLAG:193 = 1
					TFLAG:98 = 1
					EXP:MASTER:会話経験 ++
					PRINTFORML The training was very effective.
					teachEffectivenessMult = 225
					teachEffectivenessPotential = 2
				ELSE
					TFLAG:193 = 0
					TFLAG:98 = 0
				ENDIF
			;Critical Failure
			CASE -1
				TFLAG:193 = -1
				TFLAG:98 = -1
				PRINTFORML The training didn't go well at all.
			;Canceled
			CASE -2
				TFLAG:193 = -1
				RETURN 0
				PRINTFORML Got TFLAG:192 = -2.
		ENDSELECT
		SELECTCASE PAGE
		CASE 0
			VARSET LOCAL, -1

			LOCAL = ABL_TO_EXP(teachHit)
			LOCAL:1 = RESULT:1
			LOCAL:2 = RESULT:2
			FOR LOCAL:3, 0, 3
				SIF LOCAL:(LOCAL:3) > -1
					CALL AddEXP(EXPNAME:(LOCAL:(LOCAL:3)),teachStudent,(teachEffectiveness/50)*teachEffectivenessMult/100)
			NEXT
			FOR LOCAL:3, 0, 3
				SIF LOCAL:(LOCAL:3) > -1
					CALL EXPPotentialChangeMsg(teachStudent,LOCAL:(LOCAL:3),teachEffectivenessPotential)
			NEXT
		CASE 1
			IF GETBIT(TALENT:teachTeacher:ESP, teachHit)
				CALL AddYoujutsuEXP(teachStudent,teachHit,(teachEffectiveness/50)*teachEffectivenessMult/100)
				CALL YoujutsuPotentialChangeMsg(teachStudent,teachHit,teachEffectivenessPotential)
			ELSE
				CALL YoujutsuLearningProgress(teachStudent,teachHit,teachEffectiveness*teachEffectivenessMult/100,"add","teacher")
			ENDIF
		ENDSELECT
		TIME += teachLessonTime:teachLessonPick
		IF TCVAR:TARGET:TrainingTimeDone+teachLessonTime:teachLessonPick > TrainingTimeCredits(TARGET)
			LOCAL = (TCVAR:TARGET:TrainingTimeDone+teachLessonTime:teachLessonPick)-TrainingTimeCredits(TARGET)
			TCVAR:TARGET:TrainingTimeDone = TrainingTimeCredits(TARGET)
			CALL PAY_MONEY_CM(LOCAL, 2)
		ELSE
			TCVAR:TARGET:TrainingTimeDone += teachLessonTime:teachLessonPick
		ENDIF
		DOWNBASE:teachStudent:0 += 250
		DOWNBASE:teachTeacher:0 += 250
		DOWNBASE:teachStudent:1 += 350
		DOWNBASE:teachTeacher:1 += 350
		RETURN 1
	CASE 8000 TO 8000+VARSIZE("teachCategoryList")
		PAGE = RESULT-8000
	ENDSELECT
LOOP 1

@TrainingTimeCredits(ARG)
#FUNCTION
#DIM DYNAMIC pointsMax
;15 minutes
pointsMax = 15

;tier 2
IF TALENT:ARG:7
	pointsMax = 240
ELSEIF SignificantRelationship(ARG)
	pointsMax = 120
;tier 1
ELSEIF HasFallState(ARG)
	pointsMax = 45
ENDIF

;Affinity.
pointsMax += MAX(0,15*(RELATION:ARG:MASTER-100)/10)

RETURNF pointsMax



@ADD_CUSTOM_COM_PRINT354
#DIM CONST COM_ID = 354

IF TrainingTimeCredits(TARGET)-TCVAR:TARGET:TrainingTimeDone >=15
    SETCOLOR C_GREEN
    PRINTFORMC Teaching (TC {TrainingTimeCredits(TARGET)-TCVAR:TARGET:TrainingTimeDone})[{Add_Custom_COM_To_Number(COM_ID),3}]
ELSEIF MONEY:2 >= 15
    PRINTFORMC Teaching (CM %PALAM_NUM_NAS(MONEY:2,1)%)[{Add_Custom_COM_To_Number(COM_ID),3}]
ELSE
	SETCOLOR C_GRAY
    PRINTFORMC Teaching not available[{Add_Custom_COM_To_Number(COM_ID),3}]
ENDIF
RESETCOLOR
RETURN 1

@ADD_CUSTOM_COM_ABLE354
SIF !TFLAG:100
	RETURN 0
SIF !SHIRAHU(TARGET)
	RETURN 0
SIF TARGET == MASTER
    RETURN 0
SIF CFLAG:MASTER:うふふ
	RETURN 0

RETURN 1