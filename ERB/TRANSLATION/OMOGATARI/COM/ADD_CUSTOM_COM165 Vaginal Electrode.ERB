@ADD_CUSTOM_COM165
;着脱の処理
CALL EStimChannelCheck
IF TFLAG:EStim >= FLAG:EStimBox+1 && !TEQUIP:EStimVag
	PRINTFORML 당신의 컨트롤 박스는 {FLAG:EStimBox+1}만 지원할 수 있다 %PLURALIZER("channel",FLAG:EStimBox+1)%. 
	PRINTFORMW 전극을 제거하거나 박스를 업그레이드해 주십시오.
	RETURN -1
ELSEIF !ITEM:EStimBox
	PRINTFORMW %PARSE("You don't")% 이것을 작동시킬 방법이 있다.
	FONTITALIC
	PRINTFORMW 이것을 사용하려면 %ITEMNAME_TR(145)%를 사세요.
	FONTREGULAR
	RETURN -1
ELSE
	TEQUIP:EStimVag = !TEQUIP:EStimVag
	CALL EStimChannelCheck
ENDIF
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1
CSTR:TARGET:10 += @"{PLAYER}/"
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
TCVAR:TARGET:2 = 23
;強度
TCVAR:TARGET:4 = 1500
;破瓜抑制
;TFLAG:2 = 1
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 100
	SOURCE:快Ｖ = 600
	SOURCE:苦痛 = 25
ELSE
	DOWNBASE:体力 += 30
	DOWNBASE:気力 += 100
	SOURCE:快Ｖ = 600
	SOURCE:苦痛 = 50
	SOURCE:露出 = 20
	SOURCE:逸脱 = 40
	SOURCE:反感 = 300
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 40
	;処女だった場合は、苦痛のソースと反発のソースを追加する
	IF TALENT:処女 == 1
		SOURCE:苦痛 += 2000
		SOURCE:反感 += 3000
	ENDIF
	;再生処女だった場合は、苦痛のソースと反発のソースを追加する
	IF TALENT:処女 == 2
		SOURCE:苦痛 += 500
		SOURCE:反感 += 1000
	ENDIF
	;上のほうで計算した汚れデータ
	SOURCE:不潔 = Y*10 + 60
	CALL 特殊ソース処理
ENDIF
;Vへの苦痛は先に処理しておく
CALL PAIN_CHECK_V(TARGET)
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;give exp
EXP:Ｖ経験 ++
IF FLAG:70 == 1
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ELSE
	;同性愛　レズなら戻り値1ゲイなら戻り値2
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
	;異常経験
	IF TALENT:処女 == 1 && !GETBIT(CFLAG:3,3)
		EXP:異常経験 ++
		SETBIT CFLAG:3,3
	ENDIF
ENDIF
EXP:PLAYER:道具使用経験 ++
TIME ++
RETURN 1
;-------------------------------------------------
;装着継続の処理
