;-------------------------------------------------
;Mouth Electrodes
;Pleasures the target's mouth with electrodes. Also gives hypnosis
;Hard training command level: 3
;-------------------------------------------------
@ADD_CUSTOM_COM168
;着脱の処理
CALL EStimChannelCheck

IF TFLAG:EStim >= FLAG:EStimBox+1 && !TEQUIP:EStimMouth
	PRINTFORML Your control box can only support {FLAG:EStimBox+1} %PLURALIZER("channel",FLAG:EStimBox+1)%. 
	PRINTFORMW Please either remove an electrode or upgrade your box.
	RETURN -1
ELSEIF !ITEM:EStimBox
	PRINTFORMW %PARSE("You don't")% have a way to power this.
	FONTITALIC
	PRINTFORMW Buy a %ITEMNAME_TR(145)% to use this.
	FONTREGULAR
	RETURN -1	
ELSE
TEQUIP:EStimMouth = !TEQUIP:EStimMouth
CALL EStimChannelCheck
ENDIF
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1

CSTR:TARGET:10 += @"{PLAYER}/"
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
TCVAR:TARGET:2 = 23
;強度
TCVAR:TARGET:4 = 900

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 100
	SOURCE:快Ｍ = 250
	SOURCE:苦痛 = 25

ELSE

	DOWNBASE:体力 += 30
	DOWNBASE:気力 += 100

	SOURCE:快Ｍ = 250
	SOURCE:苦痛 = 50
	SOURCE:露出 = 20
	SOURCE:逸脱 = 40
	SOURCE:反感 = 40
	LOCAL = 50+(10*ABL:MASTER:教養)+(10*ABL:MASTER:話術技能)-(10*ABL:教養)-(10*ABL:話術技能)+(10*ABL:HypnoAddict)
	BASE:Hypno = LIMIT(BASE:Hypno+LOCAL, 0, MAXBASE:Hypno)	


	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 40
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;give exp
EXP:Ｍ経験 ++
IF FLAG:70 == 1
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ELSE
	;同性愛　レズなら戻り値1ゲイなら戻り値2
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ENDIF
EXP:PLAYER:道具使用経験 ++

RETURN 1

;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@ADD_CUSTOM_EQUIP_COM168(ARG)
;insert plug
PRINTFORML ＜Oral Electrode＞

CSTR:TARGET:10 += @"{PLAYER}/"
TCVAR:TARGET:2 = 23
TCVAR:TARGET:4 = 450

IF FLAG:70 == 1
BASE:MASTER:TSP -= 50
SOURCE:ARG:快Ｍ += 250 + (100*TFLAG:VibePower)

ELSE


DOWNBASE:ARG:体力 += 10
DOWNBASE:ARG:気力 += 50

SOURCE:ARG:快Ｍ += 250
SOURCE:ARG:露出 += 10
SOURCE:ARG:逸脱 += 20
LOCAL = 50+(10*ABL:MASTER:教養)+(10*ABL:MASTER:話術技能)-(10*ABL:教養)-(10*ABL:話術技能)+(10*ABL:HypnoAddict)
BASE:Hypno = LIMIT(BASE:Hypno+LOCAL, 0, MAXBASE:Hypno)	

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
	SOURCE:ARG:鬱屈 += 20

;Vへの苦痛は先に処理しておく
;EXP:Ｖ経験をみる（処女はありえない）
LOCAL = 25
LOCAL:1 = 20
IF EXP:ARG:Ｍ経験 < EXPLV:2
	TIMES LOCAL , 0.80
	TIMES LOCAL:1 , 1.20
ELSEIF EXP:ARG:Ｍ経験 < EXPLV:3
	TIMES LOCAL , 0.40
ELSEIF EXP:ARG:Ｍ経験 < EXPLV:4
	TIMES LOCAL , 0.10
ELSEIF EXP:ARG:Ｍ経験 < EXPLV:5
	TIMES LOCAL , 0.00
ELSEIF EXP:ARG:Ｍ経験 >= EXPLV:5
	TIMES LOCAL , 0.00
ENDIF

;PALAM:潤滑をみる
IF PALAM:ARG:潤滑 < PALAMLV:1
	TIMES LOCAL , 1.20
	TIMES LOCAL:1 , 1.50
ELSEIF PALAM:ARG:潤滑 < PALAMLV:2
	TIMES LOCAL , 0.70
	TIMES LOCAL:1 , 1.20
ELSEIF PALAM:ARG:潤滑 < PALAMLV:3
	TIMES LOCAL , 0.40
ELSEIF PALAM:ARG:潤滑 < PALAMLV:4
	TIMES LOCAL , 0.10
ELSEIF PALAM:ARG:潤滑 >= PALAMLV:4
	TIMES LOCAL , 0.10
ENDIF
SOURCE:ARG:苦痛 += LOCAL
SOURCE:ARG:反感 += LOCAL:1

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;自慰実行時は経験＋１
SIF EXP_UP(68,TARGET)
	EXP:ARG:Ｍ経験 += 1
ENDIF
RETURN 1

@ADD_CUSTOM_MESSAGE_COM168
IF FLAG:70 == 1
	IF !TEQUIP:EStimMouth
	ELSE
	ENDIF
ELSE
	IF !TEQUIP:EStimMouth
	ELSE
	PRINTFORML You put some adhesive electrodes on %CALLNAME:TARGET%'s cheeks before turning on the control box.
	ENDIF
ENDIF	


@ADD_CUSTOM_COM_ABLE168
;バイブ実行判定
SIF !TFLAG:100
	RETURN 0
	
SIF !ITEM:PadElectrode
	RETURN 0	

SIF !CFLAG:MASTER:うふふ && !TFLAG:PublicToyPlay
	RETURN 0			

RETURN 1