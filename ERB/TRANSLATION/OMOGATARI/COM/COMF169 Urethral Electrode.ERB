; Modular ERB: OMOGATARI/COM/COMF169 Urethral Electrode.ERB
;-------------------------------------------------
;Urethral Electrode
;Pleasures the target's urethra by inserting a plug (but electrical)
;Hard training command level: 4
;Flags required: Urination
;-------------------------------------------------

@ADD_CUSTOM_COM169
;着脱の処理
CALL EStimChannelCheck
IF TFLAG:EStim >= FLAG:EStimBox+1 && !TEQUIP:EStimUrethra
	PRINTFORML 당신의 컨트롤 박스는 {FLAG:EStimBox+1}만 지원할 수 있다 %PLURALIZER("channel",FLAG:EStimBox+1)%. 
	PRINTFORMW 전극을 제거하거나 박스를 업그레이드해 주십시오.
	RETURN -1
ELSEIF !ITEM:EStimBox
	PRINTFORMW %PARSE("You don't")% 이것을 작동시킬 방법이 있다.
	FONTITALIC
	PRINTFORMW 이것을 사용하려면 %ITEMNAME_TR(145)%를 사세요.
	FONTREGULAR
	RETURN -1
ELSE
	TEQUIP:EStimUrethra = !TEQUIP:EStimUrethra
	CALL EStimChannelCheck
ENDIF
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1
CSTR:TARGET:10 += @"{PLAYER}/"
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
TCVAR:TARGET:2 = 23
;強度
TCVAR:TARGET:4 = 900
TCVAR:LostVirginU = 1
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 100
	SOURCE:UPleas = 1000
	SOURCE:苦痛 = 2600
ELSE
	DOWNBASE:体力 += 30
	DOWNBASE:気力 += 100
	SOURCE:UPleas = 1000
	SOURCE:苦痛 = 4000
	SOURCE:露出 = 300
	SOURCE:屈従 = 800
	SOURCE:逸脱 = 1200
	SOURCE:反感 = 1200
ENDIF
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:自己愛 < 0 || TALENT:抵抗
	SOURCE:鬱屈 += 40
;give pain and hostility if still urethral virgin
IF !CFLAG:TARGET:LostVirginUDay
	SOURCE:苦痛 += 2000
	SIF !FLAG:70
		SOURCE:反感 += 3000
ENDIF
;call pain check
CALL PAIN_CHECK_U(TARGET)
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;give exp
EXP:UExp ++
EXP:USex ++
IF FLAG:70 == 1
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ELSE
	;異常経験
	IF !CFLAG:TARGET:LostVirginUDay && !GETBIT(CFLAG:3,3)
		EXP:異常経験 ++
		SETBIT CFLAG:3,3
	ENDIF
	;同性愛　レズなら戻り値1ゲイなら戻り値2
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ENDIF
EXP:PLAYER:道具使用経験 ++
RETURN 1
;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------

@ADD_CUSTOM_EQUIP_COM169(ARG)
;insert plug
PRINTL 요도 전극
CSTR:TARGET:10 += @"{PLAYER}/"
TCVAR:TARGET:2 = 22
TCVAR:TARGET:4 = 450
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 50
	SOURCE:ARG:UPleas += 800 + (100*TFLAG:VibePower)
ELSE
	DOWNBASE:ARG:体力 += 10
	DOWNBASE:ARG:気力 += 50
	SOURCE:ARG:UPleas += 800
	SOURCE:ARG:露出 += 10
	SOURCE:ARG:逸脱 += 20
	PeeHoldExp:ARG:0 += 1
	EXP:UExp ++
	EXP:USex ++
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:ARG:自己愛 < 0 || TALENT:ARG:抵抗
		SOURCE:ARG:鬱屈 += 20
	;Vへの苦痛は先に処理しておく
	;EXP:Ｖ経験をみる（処女はありえない）
	LOCAL = 25
	LOCAL:1 = 20
	IF EXP:ARG:UExp < EXPLV:2
		TIMES LOCAL , 0.80
		TIMES LOCAL:1 , 1.20
	ELSEIF EXP:ARG:UExp < EXPLV:3
		TIMES LOCAL , 0.40
	ELSEIF EXP:ARG:UExp < EXPLV:4
		TIMES LOCAL , 0.10
	ELSEIF EXP:ARG:UExp < EXPLV:5
		TIMES LOCAL , 0.00
	ELSEIF EXP:ARG:UExp >= EXPLV:5
		TIMES LOCAL , 0.00
	ENDIF
	;PALAM:潤滑をみる
	IF PALAM:ARG:潤滑 < PALAMLV:1
		TIMES LOCAL , 1.20
		TIMES LOCAL:1 , 1.50
	ELSEIF PALAM:ARG:潤滑 < PALAMLV:2
		TIMES LOCAL , 0.70
		TIMES LOCAL:1 , 1.20
	ELSEIF PALAM:ARG:潤滑 < PALAMLV:3
		TIMES LOCAL , 0.40
	ELSEIF PALAM:ARG:潤滑 < PALAMLV:4
		TIMES LOCAL , 0.10
	ELSEIF PALAM:ARG:潤滑 >= PALAMLV:4
		TIMES LOCAL , 0.10
	ENDIF
	SOURCE:ARG:苦痛 += LOCAL
	SOURCE:ARG:反感 += LOCAL:1
	;-------------------------------------------------
	;経験の処理
	;-------------------------------------------------
	;自慰実行時は経験＋１
	SIF EXP_UP(68,TARGET)
		EXP:ARG:UExp += 1
ENDIF
RETURN 1

