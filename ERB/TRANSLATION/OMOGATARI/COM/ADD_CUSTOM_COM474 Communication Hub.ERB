;-------------------------------------------------
;Communication Hub
;-------------------------------------------------
@ADD_CUSTOM_COM474
#DIM saveTime, 2
gLineCount = LINECOUNT
saveTime = TIME
saveTime:1 = TIME:1
DO
CLEARLINE LINECOUNT - gLineCount
CALL PRINT_RAINBOWL("Communication Hub")
RESETCOLOR
FOR LOCAL,0,CHARANUM
	IF STRLENS(NAME_UNIQUE_COM(LOCAL))
		PRINTFORML [{LOCAL,3}] - %NAME:LOCAL,25,LEFT% - %UNIQUE_COM_TR(NAME_UNIQUE_COM(LOCAL))%
	ENDIF
NEXT
PRINTL
PRINTFORML [999] - Cancel
INPUT
SELECTCASE RESULT
CASE 999
	TIME = saveTime
	TIME:1 = saveTime:1
	RETURN 1
CASEELSE
	SIF STRLENS(NAME_UNIQUE_COM(RESULT))
		TRYCALLFORM UNIQUE_COM_%NAME_UNIQUE_COM(RESULT)%
ENDSELECT
LOOP 1

@ADD_CUSTOM_COM_ABLE474
;押し倒す実行判定
SIF !TFLAG:100
	RETURN 0

SIF GETBIT(HOME_CUSTOM_ROOM(CFLAG:MASTER:300),5)
	RETURN 1
RETURN 0