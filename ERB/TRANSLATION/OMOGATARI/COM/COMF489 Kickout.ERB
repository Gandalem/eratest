; Modular ERB: OMOGATARI/COM/COMF489 Kickout.ERB
;-------------------------------------------------
;Kickout
;This kicks the selected character from the room the player is in
;-------------------------------------------------

@ADD_CUSTOM_COM489
TFLAG:97 -= (50 - ABL:TARGET:親密 * 2)
;SOURCE:TARGET:反感 += 1000
;BASE:TARGET:怒り += (5500 - ABL:TARGET:親密 * 100)
CALL GET_ANGRY(TARGET)
CFLAG:TARGET:現在位置 = KICKOUT()
TIME += 1
RETURN 1
;@ADD_CUSTOM_CAN_COM489

@ADD_CUSTOM_MESSAGE_COM489
PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"를")%(를) %STR_TR(CFLAG:MASTER:現在位置+8000)%에서 내쫓는다.

@ADD_CUSTOM_COM_ABLE489
; Do not allow during ufufu or time stop
SIF FLAG:70 == 1
	RETURN 0
SIF CFLAG:うふふ != 0
	RETURN 0
SIF !TFLAG:100
	RETURN 0
SIF CFLAG:睡眠
	RETURN 0
SIF TARGET == MASTER ; doesn't make sense to kick yourself out
	RETURN 0
RETURN 1
