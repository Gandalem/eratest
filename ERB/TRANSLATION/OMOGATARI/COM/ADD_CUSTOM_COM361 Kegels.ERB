@ADD_CUSTOM_COM361
OrgasmDenyExp:MASTER:0 ++
PeeHoldExp:MASTER:0 ++
PooHoldExp:MASTER:0 ++
SELECTCASE TFLAG:192
	CASE 0
		LOCAL = RAND:100
		LOCAL:1 = (ABL:MASTER:53*13) + GET_SUCCESS_RATE() / 5
		SIF LOCAL:1 > 99
			LOCAL:1 = 99
		IF LOCAL <= 9
			;10％で大成功
			OrgasmDenyExp:MASTER:0 += 2
			PeeHoldExp:MASTER:0 += 2
			PooHoldExp:MASTER:0 += 2
			TFLAG:193 = 1
			TFLAG:98 = 2
		ELSEIF LOCAL >= LOCAL:1
			;10～1％で失敗
			TFLAG:193 = -1
			TFLAG:98 = -2
		ELSE
			;残りは成功
			OrgasmDenyExp:MASTER:0 ++
			PeeHoldExp:MASTER:0 ++
			PooHoldExp:MASTER:0 ++
			TFLAG:193 = 0
			TFLAG:98 = 0
		ENDIF
	CASE 1
		IF RAND:100 <= 9
			;10％で大成功
			OrgasmDenyExp:MASTER:0 += 2
			PeeHoldExp:MASTER:0 += 2
			PooHoldExp:MASTER:0 += 2
			TFLAG:193 = 1
			TFLAG:98 = 2
		ELSE
			;残りは成功
			OrgasmDenyExp:MASTER:0 ++
			PeeHoldExp:MASTER:0 ++
			PooHoldExp:MASTER:0 ++
			TFLAG:193 = 0
			TFLAG:98 = 0
		ENDIF
	CASE -1
		TFLAG:193 = -1
		TFLAG:98 = -1
	CASE -2
		RETURN 0
ENDSELECT
;先制発生時は失敗しない
SIF TCVAR:20
	TFLAG:193 = MAX(TFLAG:193,0)
DOWNBASE:MASTER:気力 += 100
DOWNBASE:MASTER:体力 += 50
TIME += 10
RETURN 1

@ADD_CUSTOM_MESSAGE_COM361
PRINTFORML 당신은 케겔 운동을 몇 초간 하고 항문을 조인 채 유지한 후 풀어준다.
SELECTCASE TFLAG:193
	CASE 1
		PRINTFORML 당신의 움켜쥐고 놓는 동작은 매혹적인 리듬으로 능숙하게 연출되었다.
	CASE 0
		PRINTFORML 너의 움켜쥠은 괜찮아 보이지만, 결국 약간 미끄러지게 돼.
	CASE -1
		PRINTFORML 당신의 클렌치는 꽤 어색하고, 전혀 리듬을 타지 못하는 것 같다.
ENDSELECT

@ADD_CUSTOM_COM_ABLE361
;押し倒す実行判定
SIF !TFLAG:100
	RETURN 0
SIF CFLAG:MASTER:うふふ
	RETURN 0
SIF !nPee && !nScat
	RETURN 0
RETURN 1
