@ADD_CUSTOM_COM361
OrgasmDenyExp:MASTER:0 ++
PeeHoldExp:MASTER:0 ++
PooHoldExp:MASTER:0 ++

SELECTCASE TFLAG:192
	CASE 0
		LOCAL = RAND:100
		LOCAL:1 = (ABL:MASTER:53*13) + GET_SUCCESS_RATE() / 5
		SIF LOCAL:1 > 99
			LOCAL:1 = 99
		IF LOCAL <= 9
			;10％で大成功
			OrgasmDenyExp:MASTER:0 += 2
			PeeHoldExp:MASTER:0 += 2
			PooHoldExp:MASTER:0 += 2
			TFLAG:193 = 1
			TFLAG:98 = 2
		ELSEIF LOCAL >= LOCAL:1
			;10～1％で失敗
			TFLAG:193 = -1
			TFLAG:98 = -2
		ELSE
			;残りは成功
			OrgasmDenyExp:MASTER:0 ++
			PeeHoldExp:MASTER:0 ++
			PooHoldExp:MASTER:0 ++
			TFLAG:193 = 0
			TFLAG:98 = 0
		ENDIF
	CASE 1
		IF RAND:100 <= 9
			;10％で大成功
			OrgasmDenyExp:MASTER:0 += 2
			PeeHoldExp:MASTER:0 += 2
			PooHoldExp:MASTER:0 += 2
			TFLAG:193 = 1
			TFLAG:98 = 2
		ELSE
			;残りは成功
			OrgasmDenyExp:MASTER:0 ++
			PeeHoldExp:MASTER:0 ++
			PooHoldExp:MASTER:0 ++
			TFLAG:193 = 0
			TFLAG:98 = 0
		ENDIF
	CASE -1
		TFLAG:193 = -1
		TFLAG:98 = -1
	CASE -2
		RETURN 0
ENDSELECT

;先制発生時は失敗しない
SIF TCVAR:20
	TFLAG:193 = MAX(TFLAG:193,0)
DOWNBASE:MASTER:気力 += 100
DOWNBASE:MASTER:体力 += 50
TIME += 10
RETURN 1

@ADD_CUSTOM_MESSAGE_COM361
PRINTFORML You do some kegels, holding your crotch for a few seconds before releasing.

SELECTCASE TFLAG:193
CASE 1
PRINTFORML Your clenches and releases are masterfully done in a entrancing rhythm.
CASE 0
PRINTFORML Your clenches seem to be fine, but you end up slipping a bit
CASE -1
PRINTFORML Your clenches are pretty off, and you can't seem to get into a rhythm at all.
ENDSELECT

