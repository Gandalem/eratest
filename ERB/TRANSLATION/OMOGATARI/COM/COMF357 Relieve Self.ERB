	CASE 6
		PRINTDATAW
			DATAFORM 서두르면서 %PARSE("you",,,ARG)% \@ !PottyPants && EQUIP:ARG:6 ? %PARSE("start",,,ARG)% 내려가는 %PARSE("your",5,,ARG)% 젖은 %PeeProtectType(ARG)% 해소하기 전에 # %PARSE("relieve",,,ARG)% \@ %PARSE("your",5,,ARG)% 지친 %PeeandPoo(HasPiss,HasScat, "bladder", "bowels")% 에 %PottyName%.
