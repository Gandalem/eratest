		CALL ImminentAccidentSettings
		RETURN
	CASE 999
		RETURN
	CASEELSE
		IF inTrain == 3
			CALL LucidDreamRelieveSelf(LookingChara,ACC357_Result)
		ELSEIF ACC357_Result != 999
			CALL DumpingShit(LookingChara,ACC357_Result)
		ENDIF
