@COM_TakeClothesBeforePee(ARG)
#DIM ClothingPoints
LOCALS:1 =
ClothingPoints = 12 + (ABL:ARG:指/3)
ClothingPoints -= PeeBarStage(ARG) + PooBarStage(ARG)
IF EQUIP:ARG:スカート
	ClothingPoints -= 2
	LOCALS:1 += @"%CLOTHNAME(15,EQUIP:ARG:スカート)%、"
ENDIF
IF EQUIP:ARG:ズボン
	ClothingPoints -= 2
	LOCALS:1 += @"%CLOTHNAME(11,EQUIP:ARG:ズボン)%、"
ENDIF
IF EQUIP:ARG:ワンピース
	ClothingPoints -= 4
	LOCALS:1 += @"%CLOTHNAME(13,EQUIP:ARG:ワンピース)%、"
ENDIF
IF EQUIP:ARG:着物
	ClothingPoints -= 4
	LOCALS:1 += @"%CLOTHNAME(14,EQUIP:ARG:着物)%、"
ENDIF
IF EQUIP:ARG:レオタード
	ClothingPoints -= 4
	LOCALS:1 += @"%CLOTHNAME(9,EQUIP:ARG:レオタード)%、"
ENDIF
IF EQUIP:ARG:ボディースーツ
	ClothingPoints -= 6
	LOCALS:1 += @"%CLOTHNAME(10,EQUIP:ARG:ボディースーツ)%、"
ENDIF
IF EQUIP:ARG:下半身下着１
	ClothingPoints -= 1
	LOCALS:1 += @"%CLOTHNAME(5,EQUIP:ARG:下半身下着１)%、"
ENDIF
IF EQUIP:ARG:下半身上着
	ClothingPoints -= 1
	LOCALS:1 += @"%CLOTHNAME(12,EQUIP:ARG:下半身上着)%、"
ENDIF
IF EQUIP:ARG:下半身下着２
	ClothingPoints -= 1
	IF IsPadded(ARG, "diaper")
		ClothingPoints -= 2
	ENDIF
	IF IsPadded(ARG, "bulky")
		ClothingPoints -= 2
	ELSEIF IsPadded(ARG, "thick")
		ClothingPoints -= 1
	ELSEIF IsPadded(ARG, "thin")
		ClothingPoints += 1
	ENDIF
	LOCALS:1 += @"%CLOTHES_TR(PANTSNAME(EQUIP:ARG:下半身下着２, ARG))%、"
ENDIF
;naked
SIF !STRLENS(LOCALS:1)
	RETURN 999
SELECTCASE ClothingPoints
	CASE IS >= 10
		PRINTFORML %PARSE("your",,,ARG)% %LIST_IN_STRING(LOCALS:1)%를 벗는 것은 쉬웠다.
	CASE IS >= 7
		PRINTFORML %PARSE("your",,,ARG)% %LIST_IN_STRING(LOCALS:1)%를 벗는 것은 어렵지 않았다.
	CASE IS >= 3
		PRINTFORML %PARSE("You have",,,ARG)% 옷을 벗는 데 약간의 어려움이 있었다 %PARSE("your",5,,ARG)% %LIST_IN_STRING(LOCALS:1)%.
