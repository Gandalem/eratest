			FONTREGULAR
			CanPotty = -1
		ENDIF
		LOCALS '= PeeAndPoo(HasPiss,HasScat,"소변","대변")
		SIF !STRLENS(LOCALS)
			CanPotty = 0
		;uses the clothing difficulty system to simulate taking off the tapes
