				PRINTFORMDW %LOCALS%
			ENDIF
			; SIF !FLAG:70
			CALL OMORASHI_END(BeingPissed, GETBIT(PisseeHasAccident, 1), GETBIT(PisseeHasAccident, 2))
		ENDIF
