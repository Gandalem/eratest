@GoToilet(ARG = -1,HasPiss,HasScat,BypassCheck,DreamSequence,PottyChair=0)
#DIM HasPiss
#DIM HasScat
#DIM BypassCheck
#DIM DreamSequence
#DIM PottyPants
#DIM ExcreteNumbers,2
#DIM PottyChair
#DIMS PottyName
;VARSET ExcreteNumbers
SELECTCASE PottyChair
	CASE 1
		PRINTFORML 변기 의자 설정이 1인 것은 개방 배뇨/배변에만 사용된다!
		PRINTFORML 개방된 배설에는 야외 배설용 함수를 사용해라. 변기 의자는 3이고 화장실은 2다!
		FORCEWAIT
		CALL PottyOutside(ARG,HasPiss,HasScat,BypassCheck,DreamSequence)
		RETURN RESULT
	CASE 2
		PottyName '= "변소"
	CASE 3
		PottyName '= "변기"
	CASEELSE
		PottyName '= "변기"
ENDSELECT
;toilet ban mode
SIF nOmutsu >= 4
	RETURN 0
;universal
SIF ARG == -1
	ARG = MASTER
;universal toileting off
IF ARG != MASTER
	IF !nNPCToileting
		CALL DumpingShit(ARG)
		RETURN
	ENDIF
ENDIF
VARSET LOCAL
SIF BypassCheck
	GOTO BypassPottyPants
IF (PeeBarStage(ARG) >= 7 && HasPiss) || (PooBarStage(ARG) >= 7 && HasScat)
	SIF HasPiss
		LOCAL:6 = 1
	SIF HasScat
		LOCAL:7 = 1
ENDIF
CALL PottyPants(ARG,HasPiss,HasScat)
PottyPants = RESULT
IF !PottyPants
	CALL COM_TakeClothesBeforePee(ARG)
	IF RESULT <= 0
		SIF HasPiss
			LOCAL:6 = 1
		SIF HasScat
			LOCAL:7 = 1
	ENDIF
ENDIF
IF LOCAL:7 || LOCAL:6
	CALL TOILET_OMORASHI(ARG,HasPiss,HasScat,DreamSequence)
	RETURN -1
ENDIF
$BypassPottyPants
SIF BypassCheck == -1
	PottyPants = 1
SELECTCASE MAX(PeeBarStage(ARG),PooBarStage(ARG))
	CASE 6
		PRINTDATAW
			DATAFORM %조사처리(CALLNAME:ARG,"는")% 다급히 %PottyName%에 몸을 맡긴다. \@ !PottyPants && EQUIP:ARG:6 ? 젖은 %PeeProtectType(ARG)%을 내릴 틈조차 없다. # 지칠 대로 지친 몸을 겨우 해방한다. \@
			DATAFORM %조사처리(CALLNAME:ARG,"는")% 배를 움켜쥔 채 비틀거리며 %PottyName%로 향한다.\n간신히 버텨 온 근육이 풀릴 듯 떨리고, 머릿속은 공포로 새하얘진다.\n마침내 도착하자마자 황급히 앉아 힘껏 밀어 낸다.
			DATAFORM 문이 열리자마자 %조사처리(CALLNAME:ARG,"는")% %PottyName%로 뛰어든다. 엉덩이가 자리에 닿기도 전에 힘이 풀릴 지경이다.
			DATAFORM 갑자기 %PeeProtectType(ARG)% 안으로 %FSYN("pee")%해 버릴 것 같은 느낌이 몰려온다.\n더는 갈 곳도, 시간도 없다! %조사처리(CALLNAME:ARG,"는")% 황급히 %PottyName%에 앉아 둑을 열어 버린다...
		ENDDATA
	CASEELSE
		PRINTFORMW %조사처리(CALLNAME:ARG,"는")% %PottyName%에 앉아 볼일을 본다.
ENDSELECT
;new accident scenes
ACCIDENT_CHARA = ARG
ACCIDENT_HasPiss = HasPiss
ACCIDENT_HasScat = HasScat
ACCIDENT_Stand = PottyPants
ACCIDENT_Nude = PottyPants ? 0 # 2
ACCIDENT_LINECOUNT = LINECOUNT
CALL CUTSCENESPEAK_NAS(@"「....」", "発情", ARG, 0)
CALL ACCIDENT_SHOW_BAR_RELIEVE()
CLEARLINE LINECOUNT - ACCIDENT_LINECOUNT
CALL CUTSCENESPEAK_NAS(@"「%MOAN("h")%...」", "笑顔:照れ", ACCIDENT_CHARA, 0)
IF PottyPants
	PRINTFORM %조사처리(CALLNAME:ARG,"는")% %PottyName%에 도착하자 안도의 한숨을 내쉰다.
	IF IsPadded(ARG)
		PRINTFORM 익숙한 온기가 커지면서
		SIF HasPiss
			PRINTFORM 앞
		SIF HasPiss && HasScat
			PRINTFORM 앞과%" "%
		SIF HasScat
			PRINTFORM 뒤로
		PRINTFORML .
	ELSE
		PRINTFORM 들으면서
		SIF HasPiss
			PRINTFORM 방광을 비우는 물줄기가 똑똑 떨어지는 소리
		SIF HasPiss && HasScat
			PRINTFORM ~뿐만 아니라
		SIF HasScat
			PRINTFORM 뒤쪽의 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG,1)%가 늘어나고 있다.
		PRINTFORML .
	ENDIF
	WAIT
	PRINTFORML
	;PRINTFORMW Looking down, it seems like %CALLNAME:ARG% forgot to take off %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG)% before going potty...
	PRINTFORMW 아래를 내려다본 %조사처리(CALLNAME:ARG,"는")% %PeeAndPoo(HasPiss,HasScat,"흠뻑 젖은 채로","대변까지 지린 채로")% %PottyName%에 앉아 있다는 사실을 깨닫고 수치심에 얼굴을 붉힌다.
	PRINTFORMW %PottyName%를 사용하기 전에 %PeeProtectType(ARG,1)%를 벗는 것을 기억하지 못하는 건 무슨 종류의 %TOLOWER(TOSTR_LifeStage(CharaAge:ARG:0))%일까?
	;SIF DreamSequence != 2
	;CALL WetFeelings(ARG)
	IF !DreamSequence
		CALL OMORASHI_END(ARG, HasPiss, HasScat,,-1)
	ELSE
		CALL OMORASHI_END(ARG, HasPiss, HasScat,,-1,1)
	ENDIF
	RETURN -1
ENDIF
PRINTFORML %조사처리(CALLNAME:ARG,"는")% 몸이 훨씬 깨끗하고 상쾌해졌다고 느낀다.
PRINTFORM %PottyName%은 %조사처리(CALLNAME:ARG,"의")%를 가지고 있다.
VARSET LOCALS
SIF HasPiss
	LOCALS += @"%URINE(ARG,1)%、"
SIF HasScat
	LOCALS += @"%SCAT(ARG,1)%、"
PRINTFORML %LIST_IN_STRING(LOCALS)%.
WAIT
IF PottyChair
ELSE
	PLAYSOUND "peestuffs/トイレ.m4a"
	PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 변기를 내려 배설물을 흘려보낸다.
ENDIF
STOPSOUND
SIF !DreamSequence
	CALL TOILETING_END(ARG,HasPiss,HasScat,PottyChair)
RETURN 1
