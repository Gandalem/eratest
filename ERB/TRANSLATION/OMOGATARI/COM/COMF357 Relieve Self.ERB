SELECTCASE MAX(PeeBarStage(ARG),PooBarStage(ARG))
CASE 6
    PRINTDATAW
    DATAFORM In a haste, %PARSE("you",,,ARG)% \@ !PottyPants && EQUIP:ARG:6 ? %PARSE("start",,,ARG)% pulling down %PARSE("your",5,,ARG)% soaked %PeeProtectType(ARG)% before relieving # %PARSE("relieve",,,ARG)% \@ %PARSE("your",5,,ARG)% tired %PeeandPoo(HasPiss,HasScat, "bladder", "bowels")% on the %PottyName%.
    DATAFORM %PARSE("You stumble",,,ARG)% towards the %PottyName%, clutching %PARSE("your",5,,ARG)% %FSYN("belly")%.\nPanic flashes through %PARSE("your",5,,ARG)% mind as %PARSE("your",5,,ARG)% muscles barely hold in the %PeeAndPoo(HasPiss,HasScat, "pee", "mess")%.\nAs %PARSE("you reach",5,,ARG)% the %PottyName%, %PARSE("you",,,ARG)% quickly %PARSE("sit",5,,ARG)% down and push as hard as %PARSE("you",5,,ARG)% can.
    DATAFORM Desperate to make it, %PARSE("you jump",,,ARG)% onto the %PottyName%, letting the floodgates loose as soon as %PARSE("your",5,,ARG)% %PeeProtectType(ARG,1)% hits the seat.
    DATAFORM %PARSE("You",,,ARG)% suddenly %PARSE("feel",,,ARG)% like %PARSE("you're",5,,ARG)% about to %FSYN("pee")% %PARSE("your",5,,ARG)% %PeeProtectType(ARG)%.\n%PARSE("You have",,,ARG)% to go, NOW! %PARSE("You",5,,ARG)% quickly %PARSE("sit",,,ARG)% down on the %PottyName% and let the floodgates open...
    ENDDATA
CASEELSE
    PRINTFORMW %PARSE("You sit",,,ARG)% on a %PottyName% and %PARSE("do",,,ARG)% %PARSE("your",5,,ARG)% business
ENDSELECT


;new accident scenes
ACCIDENT_CHARA = ARG
ACCIDENT_HasPiss = HasPiss
ACCIDENT_HasScat = HasScat
ACCIDENT_Stand = PottyPants
ACCIDENT_Nude = PottyPants ? 0 # 2
