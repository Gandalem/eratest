IF PottyPants
    PRINTFORM %PARSE("You sigh",,,ARG)%, relieved to have made it to the %PottyName%, 
    IF IsPadded(ARG)
        PRINTFORM as a familiar warmth grows in the 
        SIF HasPiss
            PRINTFORM front
        SIF HasPiss && HasScat
            PRINTFORM %" and "%
        SIF HasScat
            PRINTFORM back
        PRINTFORML .
    ELSE
        PRINTFORM as you hear 
        SIF HasPiss
            PRINTFORM a trickling sound as %PARSE("you empty",5,,ARG)% %PARSE("your",5,,ARG)% bladder
        SIF HasPiss && HasScat
            PRINTFORM , as well as 
        SIF HasScat
            PRINTFORM the back of %PARSE("your",5,,ARG)% %PeeProtectType(ARG,1)% becoming stretched
        PRINTFORML .
