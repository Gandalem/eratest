; Modular ERB: OMOGATARI/COM/COMF357 Relieve Self.ERB
;-------------------------------------------------
;Relieve Self
;Allows you to pee in a place and empty your needs.
;Peeing outside requires you to be desperate
;Diapers are also used in the same way
; - Mr Pops alot
;-------------------------------------------------

@ADD_CUSTOM_COM357
#DIM LookingChara
#DIM ACC357_Linecount
#DIM ACC357_Result
LookingChara = MASTER
ACC357_Linecount = LINECOUNT
SIF !FLAG:70
	TIME += 2
DO
CLEARLINE LINECOUNT - ACC357_Linecount
CUSTOMDRAWLINE ━
CALL ACC357_PAGE(LookingChara)
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
FOR LOCAL, 0, GET_TARGETNUM()+1
IF !LOCAL
	LOCAL:1 = MASTER
ELSE
	LOCAL:1 = TARGET:LOCAL
ENDIF
SIF LookingChara == LOCAL:1
	SETCOLOR 0x00FFFF
;exception for player character
PRINTBUTTON CALLNAME:(LOCAL:1), LOCAL + 100000
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTL
CUSTOMDRAWLINE ━
[IF_DEBUG]
PRINTFORML [200] - 변기 괴물 테스트
[ENDIF]
SIF CFLAG:MASTER:300 == CFLAG:MASTER:311
	PRINTFORML [300] - 침대 보호 설정
PRINTFORML [301] - 임박한 사고 설정
PRINTFORML [999] - 나 여기에서 나가게 해줘!
INPUT
ACC357_Result = RESULT
SELECTCASE ACC357_Result
	CASE IS > 100000
		LookingChara = TARGET:(RESULT-100000)
	CASE 100000
		LookingChara = MASTER
	CASE 100
		SIF !HasFallState(LookingChara) && LookingChara != MASTER
			RETURN
		SIF PANTIES_LOCKED(LookingChara)
			RETURN
		CALL Com_DiaperGrab(LookingChara)
		RETURN
	CASE 102
		CALL RandomUnderwearCheck(MASTER,1,TARGET)
		RETURN
	CASE 300
		SIF CFLAG:MASTER:300 == CFLAG:MASTER:311
			CALL BedProtectionSettings
		RETURN
	CASE 301
		CALL ImminentAccidentSettings
		RETURN
	CASE 999
		RETURN
	CASEELSE
		IF inTrain == 3
			CALL LucidDreamRelieveSelf(LookingChara,ACC357_Result)
		ELSEIF ACC357_Result != 999
			CALL DumpingShit(LookingChara,ACC357_Result)
		ENDIF
ENDSELECT
LOOP 1

@PottyPantsFormula(ARG,HasPiss,HasScat)
#FUNCTION
#DIM HasPiss
#DIM HasScat
VARSET LOCAL
LOCAL:5 = LIMIT((-PeeHold:ARG:2) + (-PooHold:ARG:2) + LIMIT(ABL:ARG:PeeAddict * HasPiss,0,25) + LIMIT(ABL:ARG:PooAddict * HasScat,0,25), 0, 100)
IF PeeBarStage(ARG) >= 7
	LOCAL:5 = 100
	LOCAL:6 = 1
ELSEIF PeeBarStage(ARG) >= 6
	LOCAL:5 = LIMIT(LOCAL:5 + ((-(PeeHold:ARG:2)+1)*3),0,100)
ENDIF
IF PooBarStage(ARG) >= 7
	LOCAL:5 = 100
	LOCAL:7 = 1
ELSEIF PooBarStage(ARG) >= 6
	LOCAL:5 = LIMIT(LOCAL:5 + ((-(PeeHold:ARG:2)+1)*3),0,100)
ENDIF
RETURNF LOCAL:5

@PottyPants(ARG,HasPiss,HasScat)
#DIM HasPiss
#DIM HasScat
#DIM PeeSelf
;no undies
SIF !EQUIP:ARG:6
	RETURN 0
PeeSelf = PottyPantsFormula(ARG,HasPiss,HasScat)
IF ABL:MASTER:教養 >= UniversalRank("B"); no numbers if ur dumb dumb
	SETCOLOR C_GRAY
	PRINTFORML %조사처리(CALLNAME:ARG,"는")% %PeeProtectType(ARG,2)% 안에 실수할 확률이 {PeeSelf}％다. (지구력: {PeeHold:ARG:0}/{PooHold:ARG:0}, 중독도: {ABL:ARG:PeeAddict}/{ABL:ARG:PooAddict})
	RESETCOLOR
ENDIF
SIF RAND(100) < PeeSelf
	RETURN 1

@DumpingShit(ARG, nInput = 0)
#DIM HasPiss
#DIM HasScat
#DIM PeePadded; 0 = raw, 1 = diape, 2 = catherer.
#DIM DiapeStand
#DIM PottyPants
#DIM ClothingPoints
#DIM nInput
#DIM PottyMonsterHappen
VARSET LOCAL
CALL FISHER_YATES_SHAFFLE(CHARANUM)
PottyPants = 0
PottyMonsterHappen = 0
VARSET HasPiss
VARSET HasScat
SIF PeeBarStage(ARG) >= 1
	HasPiss = 1
SIF PooBarStage(ARG) >= 2
	HasScat = 1
IF DiapeCharges:ARG:0 >= BASE:ARG:尿意 && !IsPadded(ARG) && nCatheterized:ARG:0 && (HasScat && !CFLAG:ARG:PadCount)
	DiapeStand = -1
ELSEIF (DiapeCharges:ARG:0 >= BASE:ARG:尿意 || !HasPiss) && (DiapePooCharges:ARG:0 >= BASE:ARG:Poo || !HasScat)
	DiapeStand = 1
ELSE
	DiapeStand = 0
ENDIF
IF ARG == MASTER
	$TOILETING
	CALL PottyPants(ARG,HasPiss,HasScat)
	PottyPants = RESULT
	SELECTCASE nInput
		CASE 0
			IF IS_TOILET(CFLAG:ARG:現在位置, ARG)
				IF !PottyMonsterHappen && RAND(1000) <= PottyMonsterChance(ARG)
					CALL POTTY_MONSTER_ENCOUNTER(ARG,HasPiss,HasScat, 0)
					GOTO PottyingMonsterResult
				ENDIF
				CALL MasterGoToilet(HasPiss,HasScat)
			ELSE
				IF LOCAL:6 || LOCAL:7
					CALL CAUSE_OMORASHI(MASTER,HasPiss,HasScat)
					RETURN
				ELSEIF PooBarStage(ARG) >= 4 || PeeBarStage(ARG) >= 4
					IF !INROOM(CFLAG:PLAYER:現在位置)
						$OpenPee
						CALL PottyOutside(ARG,HasPiss,HasScat)
						RETURN
					ELSE
						LOCALS = \@ HasPiss ? %FSYN("pee:ing")% #\@\@ HasPiss && HasScat ?%" "%및%" "%#\@\@ HasScat ? %FSYN("poo:ing")% #\@
						PRINTFORMW %CAPITALIZE(LOCALS)% 실내 바닥에 있으면 심하게 더러워진다!
						PRINTFORML [998] - 그래도 가야지
						PRINTFORML [999] - 참을 수 있어......
						INPUT
						SELECTCASE RESULT
							CASE 998
								GOTO OpenPee
							CASEELSE
								RETURN
						ENDSELECT
					ENDIF
				ELSE
					PRINTFORMW 화장실에 갈 시간이 있는데 밖에 나가서 해방할 필요를 느끼지 못한다.
					RETURN
				ENDIF
			ENDIF
		CASE 1
			;PRINTFORMW You leave your %CLOTHES_TR(PANTSNAME(EQUIP:ARG:下半身下着２, ARG))% to absorb everything.
			$PeePadded
			CALL INTENTIONAL_ACCIDENT(ARG,HasPiss,HasScat)
			RETURN
		CASE 2
			PRINTFORMW 당신은 가는 동안 %PeeProtectType(MASTER)%를 벗어버린다.
			CALLF PANTY_REWORK_CHANGE(MASTER,0)
			nInput = 0
			GOTO TOILETING
		CASE 3
			PRINTFORMW 당신은 압력을 조금 해소하기 위해 자신의 %PeeProtectType(ARG,1)%로 크게 분출한다.
			CALL PEESOUNDS("hs")
			CALLF MessUndies(ARG, "liquid", 0, 50)
			BASE:ARG:尿意 -= 50
			IF PeeBarStage(ARG) >= 7
				PRINTFORMW 하지만 그것만으로는 충분하지 않고, 홍수가 터진다...
				GOTO PeePadded
			ENDIF
			RETURN
		CASE 4
			IF LOCAL:6
				PRINTFORML 아픈 방광을 부여잡은 채 병뚜껑을 열려고 애쓴다...
				PRINTFORMW 온 힘을 다해 병을 열다가 잠깐 정신이 흐트러진 사이, 결국 %FSYN("pee:ing")% 시작해 버린다...
				PRINTFORMW 손에 병을 든 채 어정쩡하게 굳어 서서, 바로 발밑에 전부 쏟아 낸다...
				CALL WetFeelings(ARG)
				PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 그 자리를 벗어나려다 가까스로 %PeeAndPoo(HasPiss,HasScat,FSYN("pee:ing"),FSYN("poo:ing"))%을 멈춘다.
				CALL OMORASHI_END(ARG,HasPiss,HasScat,,-1)
				RETURN
			ELSE
				PRINTFORMW 당신은 자신의 %PeeProtectType(ARG)%를 내리고 병을 %FSYN("crotch")%에 올려 놓고 푸르르르륵...
				ITEM:EmptyBottle --
				CALL GET_ITEM("PeeBottle", 1, 1)
				$END
				CALL TOILETING_END(ARG,HasPiss,HasScat)
			ENDIF
		CASE 104
			CALL TSP_DIAPER_CHANGE_INIT(ARG)
		CASE 200
			CALL POTTY_MONSTER_ENCOUNTER(MASTER,HasPiss,HasScat, 1)
			$PottyingMonsterResult
			nInput = 0
			PottyMonsterHappen = 1
			SELECTCASE RESULT
				CASE -2, -99
					CALL OMORASHI_END(ARG, HasPiss, HasScat)
				CASE -3
					HasPiss = 0
					BASE:ARG:4 = 0
					GOTO TOILETING
				CASE -4
					RETURN
				CASEELSE
					GOTO TOILETING
			ENDSELECT
	ENDSELECT
ELSE
	SELECTCASE nInput
		CASE 5
			;piss on touhou
			CALL PottyOnTouhou(MASTER,ARG)
		CASE 6
			;piss on touhou's undies
			SIF (HasFallState(ARG) || (FLAG:70 && !BASE:ARG:TSP))
				CALL PottyInTouhouUndies(MASTER,ARG,HasPiss,HasScat,1)
		CASE 7
			;take panties and use them
			SIF (HasFallState(ARG) || (FLAG:70 && !BASE:ARG:TSP))
				CALL PottyInTouhouUndies(MASTER,ARG,HasPiss,HasScat,2)
		CASE 40
			SIF (HasFallState(ARG) || (FLAG:70 && !BASE:ARG:TSP))
				CALL PottyInTouhouUndies(ARG,MASTER,HasPiss,HasScat,1)
		CASE 41
			SIF (HasFallState(ARG) || (FLAG:70 && !BASE:ARG:TSP))
				CALL PottyInTouhouUndies(ARG,MASTER,HasPiss,HasScat,2)
		CASEELSE
			CALL TOILETING_END(ARG,HasPiss,HasScat)
	ENDSELECT
ENDIF
;like OMORASHI_END, but for toiletings and not accidents

@TOILETING_END(ARG,HasPiss,HasScat,openRelieve=0)
#DIM HasPiss
#DIM HasScat
#DIM DYNAMIC openRelieve; 0 = toilet, 1 = open, 2 = latrine, 3 = potty
DOWNBASE:ARG:体力 -= 10
DOWNBASE:ARG:気力 -= 200
;bladder diary
VARSET LOCALS
IF CAN_SEE(ARG)
	SIF HasPiss
		CALL INTERACTIVE_TUTORIAL_GET(102,401,"Toileting",2)
	SIF HasScat
		CALL INTERACTIVE_TUTORIAL_GET(102,402,"Toileting",2)
ENDIF
;piss
IF ARG == MASTER
	IF HasPiss
		LOCALS += @"소변을 {BASE:ARG:4}ml,"
	ENDIF
	IF HasScat
		LOCALS += @"배변했다 {BASE:ARG:17}g."
	ENDIF
	SELECTCASE MAX(PeeBarStage(ARG),PooBarStage(ARG))
		CASE 0
			LOCALS:2 '= @"전혀 없는"
		CASE 1
			LOCALS:2 '= @"아주 약한"
		CASE 2
			LOCALS:2 '= @"약한"
		CASE 3
			LOCALS:2 '= @"제법 강한"
		CASE 4
			LOCALS:2 '= @"집중하기 힘든"
		CASE 5
			LOCALS:2 '= @"감당하기 어려운"
		CASE 6
			LOCALS:2 '= @"극심한"
		CASE IS >= 7
			LOCALS:2 '= @"한계에 달한"
	ENDSELECT
	SELECTCASE openRelieve
		CASE 3
			BladderDiary += @"%時刻表示(TIME)%화장실로 갔다 %LOCALS:2% 긴급함%LIST_IN_STRING(LOCALS)%)\n"
		CASE 2
			BladderDiary += @"%時刻表示(TIME)%화장실에서 안도하며 %LOCALS:2% 긴급함%LIST_IN_STRING(LOCALS)%)\n"
		CASE 1
			BladderDiary += @"%時刻表示(TIME)%야외에서 안도하며 %LOCALS:2% 긴급함%LIST_IN_STRING(LOCALS)%)\n"
		CASEELSE
			BladderDiary += @"%時刻表示(TIME)%화장실에 갔다 %LOCALS:2% 급함%LIST_IN_STRING(LOCALS)%)\n"
	ENDSELECT
	BladderDiaryToilet ++
ENDIF
PottyChartToileting:ARG:(DAY % 7) ++
IF openRelieve != 1
	Qol_Info_Count_Array:ARG:Qol_Count_Toiletings ++
	LOCAL = HasScat ? -2 # -1
	SIF ITEM:PottyGuide && ARG == MASTER
		LOCAL --
	IF CAN_SEE(ARG)
		CALL PunishmentPointChange(ARG,LOCAL)
	ELSE
		PunishChange:ARG:0 = LIMIT(PunishChange:ARG:0+(LOCAL),0,124)
	ENDIF
ENDIF
IF HasPiss
	SIF ITEM:PottyGuide && ARG == MASTER
		BASE:ARG:尿意 *= 2
	EXP:ARG:GeneralPeeExp += BASE:ARG:尿意/100
	CALLF ChangeEndurance(ARG,"peehold",BASE:ARG:尿意/25)
	BASE:ARG:尿意 = 0
	TCVAR:ARG:PeeConcentration -= 4
	SIF TCVAR:ARG:PeeConcentration <= 0
		TCVAR:ARG:PeeConcentration = 0
	SIF openRelieve == 1
		Qol_Info_Count_Array:ARG:Qol_Count_OpenPiss ++
ENDIF
IF HasScat
	SIF ITEM:PottyGuide && ARG == MASTER
		BASE:ARG:Poo *= 2
	EXP:ARG:GeneralPoopExp += BASE:ARG:Poo/100
	CALLF ChangeEndurance(ARG,"poohold",BASE:ARG:Poo/25)
	BASE:ARG:Poo = 0
	SIF openRelieve == 1
		Qol_Info_Count_Array:ARG:Qol_Count_OpenPoop ++
	IF !DT_SELECT(@"Hediff", @"chara = {ARG} and type = 54")
		DT_ROW_REMOVE "Hediff", RESULT:1
	ENDIF
ENDIF
PottyChartToileting:ARG:(DAY % 7) ++

@MasterGoToilet(HasPiss,HasScat,BypassCheck,DreamSequence,PottyChair)
#DIM HasPiss
#DIM HasScat
#DIM BypassCheck
#DIM DreamSequence
#DIM PottyPants
