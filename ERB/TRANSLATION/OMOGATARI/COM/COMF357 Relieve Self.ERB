#DIM HasScat
#DIM BypassCheck
#DIM DreamSequence
#DIM PottyPants
#DIM ExcreteNumbers,2
#DIM PottyChair
#DIMS PottyName
;VARSET ExcreteNumbers
SELECTCASE PottyChair
CASE 1
    PRINTFORML PottyChair set to 1 is only used for open urination/defecation!
    PRINTFORML Use PottyOutside instead for open relieving. Potty chairs are 3 and Latrines are 2!
    FORCEWAIT
    CALL PottyOutside(ARG,HasPiss,HasScat,BypassCheck,DreamSequence)
    RETURN RESULT
CASE 2
    PottyName '= "latrine"
CASE 3
    PottyName '= "potty"
CASEELSE
    PottyName '= "toilet"
ENDSELECT

;toilet ban mode
SIF nOmutsu >= 4
    RETURN 0
;universal
SIF ARG == -1
    ARG = MASTER

;universal toileting off
