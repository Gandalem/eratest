		CALL TOILETING_END(Pisser,HasPiss, HasScat,1)
		EQUIP:Pisser:6 = LOCAL:5
		DiapeCharges:Pisser:1 = LOCAL:3
		DiapePooCharges:Pisser:1 = LOCAL:4
		PRINTFORMW 용무를 본 후 %조사처리(CALLNAME:BeingPissed,"의")% %PeeProtectType(BeingPissed,2)%에서, 다시 %조사처리(CALLNAME:Pisser,"의")% %PeeProtectType(Pisser,2)%로 돌아가 이제 더러워진 %PeeProtectType(BeingPissed,2)%를 %CALLNAME:BeingPissed% 위에 놓는다.
ENDSELECT

