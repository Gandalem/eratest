			ELSE
				PRINTFORMDW 결국 %조사처리(CALLNAME:BeingPissed,"는")% 참지 못하고, %CALLNAME:Pisser%에게 내준 %PeeProtectType(BeingPissed,2)% 안에서 함께 %PeeAndPoo(GETBIT(PisseeHasAccident, 1),GETBIT(PisseeHasAccident, 2),FSYN("pee"),FSYN("poo"))%기 시작한다.
				PRINTFORMDW %조사처리(CALLNAME:BeingPissed,"는")% 피부와 \@ IsPadded(BeingPissed) ? 기저귀 # 속옷 \@에 닿는 것이 자기 %PeeAndPoo(GETBIT(PisseeHasAccident,1),GETBIT(PisseeHasAccident,2),"소변","대변")%인지 %CALLNAME:Pisser%의 것인지조차 구분하지 못한 채, 안도감에 얼굴을 붉힌다.
			ENDIF
		ENDIF
		PRINTL
		PRINTFORMDW %조사처리(CALLNAME:Pisser,"는")% %PeeAndPoo(HasPiss,HasScat,FSYN("pee"),FSYN("poo"))%을 계속하며 몸속에 남은 것을 완전히 비워 낸다.
		PRINTL
		PRINTFORMDW %조사처리(CALLNAME:Pisser,"는")% 기분 좋은 한숨을 내쉬며 한결 편안해진 몸을 느낀다.
		IF (GETBIT(PisseeHasAccident, 1) || GETBIT(PisseeHasAccident, 2))
			IF FLAG:70
			ELSE
				VARSET LOCALS
				LOCALS '= @"%CALLNAME:Pisser%: 어째서 "
				IF HasPiss && GETBIT(PisseeHasAccident, 1)
					LOCALS:1 += @"소변을 봤다."
				ELSEIF GETBIT(PisseeHasAccident, 1)
					LOCALS:2 += @"오줌"
