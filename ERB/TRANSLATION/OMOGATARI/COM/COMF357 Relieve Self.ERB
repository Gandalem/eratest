	ELSEIF DiapeStand == -1
		SIF HasPiss
			PRINTFORMW %CAPITALIZE(FSYN("pee:n"))%이(가) %조사처리(CALLNAME:ARG,"의")% 카테터로 흘러 들어가면서 끝에 있는 주머니가 차오르고 부풀어 오른다...
		IF HasScat
			IF GETBIT(nScat,5)
				PRINTFORMW 참을 수 없게 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG,1)%가 땅으로 떨어지기 시작하면서 %FSYN("poo:n")% ...
			ELSE
				PRINTFORMW %조사처리(CALLNAME:ARG,"의")%은(는) %PeeProtectType(ARG,1)%가 %조사처리(CALLNAME:ARG,"의")% %SCAT(ARG)%로 채워지면서, 거의 과도하게 채워진 풍선처럼 보였다.
			ENDIF
		ENDIF
	ELSE
		SIF HasPiss
			PRINTFORMW %CAPITALIZE(FSYN("pee:n"))%가 %조사처리(CALLNAME:ARG,"의")%를 통해 새어 나와 %PeeProtectType(ARG,1)%와 하나의 %PeeColor(ARG)% 웅덩이를 형성한다.
		IF HasScat
			IF GETBIT(nScat,5)
				PRINTFORMW %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG,1)%는 땅으로 떨어지기 시작하면서 %FSYN("poo:n")%를 참을 수 없다...
			ELSE
