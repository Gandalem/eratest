SIF PooBarStage(ARG) >= 2
	HasScat = 1
IF DiapeCharges:ARG:0 >= BASE:ARG:尿意 && !IsPadded(ARG) && nCatheterized:ARG:0 && (HasScat && !CFLAG:ARG:PadCount)
	DiapeStand = -1
