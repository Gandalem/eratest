	CASEELSE
		PRINTFORMW %PARSE("You",,,ARG)%이 제때 %PARSE("your",5,,ARG)%와 %LIST_IN_STRING(LOCALS:1)%에서 이륙하지 못해 사고를 치게 된다.
ENDSELECT
RETURN ClothingPoints

