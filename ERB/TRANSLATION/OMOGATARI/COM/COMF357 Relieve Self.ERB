@TOILETING_END(ARG,HasPiss,HasScat,openRelieve=0)
#DIM HasPiss
#DIM HasScat
#DIM DYNAMIC openRelieve; 0 = toilet, 1 = open, 2 = latrine, 3 = potty
DOWNBASE:ARG:体力 -= 10
DOWNBASE:ARG:気力 -= 200
;bladder diary
VARSET LOCALS
IF CAN_SEE(ARG)
	SIF HasPiss
		CALL INTERACTIVE_TUTORIAL_GET(102,401,"Toileting",2)
	SIF HasScat
		CALL INTERACTIVE_TUTORIAL_GET(102,402,"Toileting",2)
ENDIF
;piss
IF ARG == MASTER
	IF HasPiss
		LOCALS += @"소변을 {BASE:ARG:4}ml,"
	ENDIF
	IF HasScat
		LOCALS += @"배변했다 {BASE:ARG:17}g."
	ENDIF
	SELECTCASE MAX(PeeBarStage(ARG),PooBarStage(ARG))
		CASE 0
			LOCALS:2 = nonexistant
		CASE 1
			LOCALS:2 = minimal
		CASE 2
			LOCALS:2 = mild
		CASE 3
			LOCALS:2 = moderate
		CASE 4
			LOCALS:2 = distracting
		CASE 5
			LOCALS:2 = unmanageable
		CASE 6
			LOCALS:2 = intense
		CASE IS >= 7
			LOCALS:2 = severe
	ENDSELECT
	SELECTCASE openRelieve
		CASE 3
			BladderDiary += @"%時刻表示(TIME)%화장실로 갔다 %LOCALS:2% 긴급함%LIST_IN_STRING(LOCALS)%)\n"
		CASE 2
			BladderDiary += @"%時刻表示(TIME)%화장실에서 안도하며 %LOCALS:2% 긴급함%LIST_IN_STRING(LOCALS)%)\n"
		CASE 1
			BladderDiary += @"%時刻表示(TIME)%야외에서 안도하며 %LOCALS:2% 긴급함%LIST_IN_STRING(LOCALS)%)\n"
		CASEELSE
			BladderDiary += @"%時刻表示(TIME)%화장실에 갔다 %LOCALS:2% 급함%LIST_IN_STRING(LOCALS)%)\n"
	ENDSELECT
	BladderDiaryToilet ++
ENDIF
PottyChartToileting:ARG:(DAY % 7) ++
IF openRelieve != 1
	Qol_Info_Count_Array:ARG:Qol_Count_Toiletings ++
	LOCAL = HasScat ? -2 # -1
	SIF ITEM:PottyGuide && ARG == MASTER
		LOCAL --
	IF CAN_SEE(ARG)
		CALL PunishmentPointChange(ARG,LOCAL)
	ELSE
		PunishChange:ARG:0 = LIMIT(PunishChange:ARG:0+(LOCAL),0,124)
	ENDIF
ENDIF
IF HasPiss
	SIF ITEM:PottyGuide && ARG == MASTER
		BASE:ARG:尿意 *= 2
	EXP:ARG:GeneralPeeExp += BASE:ARG:尿意/100
	CALLF ChangeEndurance(ARG,"peehold",BASE:ARG:尿意/25)
	BASE:ARG:尿意 = 0
	TCVAR:ARG:PeeConcentration -= 4
