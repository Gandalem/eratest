@DumpingShit(ARG, nInput = 0)
#DIM HasPiss
#DIM HasScat
#DIM PeePadded; 0 = raw, 1 = diape, 2 = catherer.
#DIM DiapeStand
#DIM PottyPants
#DIM ClothingPoints
#DIM nInput
#DIM PottyMonsterHappen
VARSET LOCAL
CALL FISHER_YATES_SHAFFLE(CHARANUM)
PottyPants = 0
PottyMonsterHappen = 0

VARSET HasPiss
VARSET HasScat

SIF PeeBarStage(ARG) >= 1
    HasPiss = 1
SIF PooBarStage(ARG) >= 2
    HasScat = 1


IF DiapeCharges:ARG:0 >= BASE:ARG:尿意 && !IsPadded(ARG) && nCatheterized:ARG:0 && (HasScat && !CFLAG:ARG:PadCount)
    DiapeStand = -1
ELSEIF (DiapeCharges:ARG:0 >= BASE:ARG:尿意 || !HasPiss) && (DiapePooCharges:ARG:0 >= BASE:ARG:Poo || !HasScat)
    DiapeStand = 1
ELSE
    DiapeStand = 0
ENDIF

IF ARG == MASTER
    $TOILETING
    CALL PottyPants(ARG,HasPiss,HasScat)
    PottyPants = RESULT

    SELECTCASE nInput
    CASE 0
        IF IS_TOILET(CFLAG:ARG:現在位置, ARG)
            IF !PottyMonsterHappen && RAND(1000) <= PottyMonsterChance(ARG)
                CALL POTTY_MONSTER_ENCOUNTER(ARG,HasPiss,HasScat, 0)
                GOTO PottyingMonsterResult
            ENDIF

            CALL MasterGoToilet(HasPiss,HasScat)
        ELSE
            IF LOCAL:6 || LOCAL:7
                CALL CAUSE_OMORASHI(MASTER,HasPiss,HasScat)
                RETURN
            ELSEIF PooBarStage(ARG) >= 4 || PeeBarStage(ARG) >= 4
                IF !INROOM(CFLAG:PLAYER:現在位置)
                    $OpenPee
                    CALL PottyOutside(ARG,HasPiss,HasScat)
                    RETURN
                ELSE
                    LOCALS = \@ HasPiss ? %FSYN("pee:ing")% #\@\@ HasPiss && HasScat ?%" "%and%" "%#\@\@ HasScat ? %FSYN("poo:ing")% #\@
                    PRINTFORMW %CAPITALIZE(LOCALS)% indoors on the floor will severely dirty it up!
                    PRINTFORML [998] - Go anyway
                    PRINTFORML [999] - I can hold it......
                    INPUT
                    SELECTCASE RESULT
                    CASE 998
                        GOTO OpenPee
                    CASEELSE
                        RETURN
                    ENDSELECT
                ENDIF
            ELSE
                PRINTFORMW You don't feel the need to relieve outside when you have the time to go to the toilet instead.
                RETURN
            ENDIF
        ENDIF
    CASE 1
        ;PRINTFORMW You leave your %CLOTHES_TR(PANTSNAME(EQUIP:ARG:下半身下着２, ARG))% to absorb everything.
        $PeePadded
        CALL INTENTIONAL_ACCIDENT(ARG,HasPiss,HasScat)
        RETURN
    CASE 2
        PRINTFORMW You rip off your %PeeProtectType(MASTER)% as you go.
		CALLF PANTY_REWORK_CHANGE(MASTER,0)
        nInput = 0
        GOTO TOILETING
    CASE 3
        PRINTFORMW You let out a big spurt into your %PeeProtectType(ARG,1)% to relieve some of the pressure.
        CALL PEESOUNDS("hs")
        CALLF MessUndies(ARG, "liquid", 0, 50)
        BASE:ARG:尿意 -= 50
        IF PeeBarStage(ARG) >= 7
            PRINTFORMW It's not enough however, and the floodgates open...
            GOTO PeePadded
        ENDIF
        RETURN
    CASE 4
        IF LOCAL:6
            PRINTFORML %PARSE("You struggle")% to uncap the bottle due to %PARSE("your")% aching bladder...
            PRINTFORMW %PARSE("You zone",1)% out for a bit to open the bottle with all your might, but your distraction was long enough for you to start %FSYN("pee:ing")%...
            PRINTFORMW %PARSE("You")% awkwardly %PARSE("stand")%, bottle in hand, as %PARSE("you")% empty out everything right beneath you...
            CALL WetFeelings(ARG)
            PRINTFORMW \@ ARG == MASTER ? %PARSE("You stop")% # %CALLNAME:ARG% stops\@ \@HasPiss?%FSYN("pee:ing")%#\@\@HasPiss&&HasScat?%" and "%#\@\@HasScat?%FSYN("poo:ing")%#\@ as \@ ARG == MASTER ? %PARSE("you try")% # %HE_SHE(ARG)% tries\@ to walk away from \@ ARG == MASTER ? %PARSE("your")% # %HIS_HER(ARG)%\@ mess.      
            CALL OMORASHI_END(ARG,HasPiss,HasScat,,-1)
            RETURN
        ELSE
        PRINTFORMW You pull down your %PeeProtectType(ARG)%, place the bottle on your %FSYN("crotch")% and peeeeeeeee....
        ITEM:EmptyBottle --
        CALL GET_ITEM("PeeBottle", 1, 1)
        $END
        CALL TOILETING_END(ARG,HasPiss,HasScat)
        ENDIF
    CASE 104
        CALL TSP_DIAPER_CHANGE_INIT(ARG)
    CASE 200
        CALL POTTY_MONSTER_ENCOUNTER(MASTER,HasPiss,HasScat, 1)
        $PottyingMonsterResult
        nInput = 0
        PottyMonsterHappen = 1
        SELECTCASE RESULT
        CASE -2, -99
            CALL OMORASHI_END(ARG, HasPiss, HasScat)
        CASE -3
            HasPiss = 0
            BASE:ARG:4 = 0
            GOTO TOILETING
        CASE -4
            RETURN
        CASEELSE
        GOTO TOILETING
        ENDSELECT
    ENDSELECT
ELSE
    SELECTCASE nInput
    CASE 5
        ;piss on touhou 
            CALL PottyOnTouhou(MASTER,ARG)
    CASE 6
        ;piss on touhou's undies
         SIF (HasFallState(ARG) || (FLAG:70 && !BASE:ARG:TSP))
            CALL PottyInTouhouUndies(MASTER,ARG,HasPiss,HasScat,1)
    CASE 7
        ;take panties and use them
         SIF (HasFallState(ARG) || (FLAG:70 && !BASE:ARG:TSP))
            CALL PottyInTouhouUndies(MASTER,ARG,HasPiss,HasScat,2)
    CASE 40
        SIF (HasFallState(ARG) || (FLAG:70 && !BASE:ARG:TSP))
            CALL PottyInTouhouUndies(ARG,MASTER,HasPiss,HasScat,1)
    CASE 41
        SIF (HasFallState(ARG) || (FLAG:70 && !BASE:ARG:TSP))
            CALL PottyInTouhouUndies(ARG,MASTER,HasPiss,HasScat,2)
    CASEELSE
    CALL TOILETING_END(ARG,HasPiss,HasScat)
    ENDSELECT
ENDIF


;like OMORASHI_END, but for toiletings and not accidents
@TOILETING_END(ARG,HasPiss,HasScat,openRelieve=0)
#DIM HasPiss
#DIM HasScat
#DIM DYNAMIC openRelieve; 0 = toilet, 1 = open, 2 = latrine, 3 = potty
DOWNBASE:ARG:体力 -= 10
DOWNBASE:ARG:気力 -= 200
;bladder diary
VARSET LOCALS
IF CAN_SEE(ARG)
    SIF HasPiss
        CALL INTERACTIVE_TUTORIAL_GET(102,401,"Toileting",2)
    SIF HasScat
        CALL INTERACTIVE_TUTORIAL_GET(102,402,"Toileting",2)
ENDIF
;piss
IF ARG == MASTER
    IF HasPiss
        LOCALS += @"Peed {BASE:ARG:4}ml、"
    ENDIF
    IF HasScat
        LOCALS += @"Pooped {BASE:ARG:17}g、"
    ENDIF
    
    SELECTCASE MAX(PeeBarStage(ARG),PooBarStage(ARG))
    CASE 0
        LOCALS:2 = nonexistant
    CASE 1
        LOCALS:2 = minimal
    CASE 2
        LOCALS:2 = mild
    CASE 3
        LOCALS:2 = moderate
    CASE 4
        LOCALS:2 = distracting
    CASE 5
        LOCALS:2 = unmanageable
    CASE 6
        LOCALS:2 = intense
    CASE IS >= 7
        LOCALS:2 = severe
    ENDSELECT
    SELECTCASE openRelieve
    CASE 3
    BladderDiary += @"%時刻表示(TIME)%: Went to a potty chair with %LOCALS:2% urgency (%LIST_IN_STRING(LOCALS)%)\n"
    CASE 2
    BladderDiary += @"%時刻表示(TIME)%: Relieved in a latrine with %LOCALS:2% urgency (%LIST_IN_STRING(LOCALS)%)\n"
    CASE 1
    BladderDiary += @"%時刻表示(TIME)%: Relieved in the open with %LOCALS:2% urgency (%LIST_IN_STRING(LOCALS)%)\n"
    CASEELSE
    BladderDiary += @"%時刻表示(TIME)%: Went to the toilet with %LOCALS:2% urgency (%LIST_IN_STRING(LOCALS)%)\n"
    ENDSELECT
    BladderDiaryToilet ++
ENDIF
PottyChartToileting:ARG:(DAY % 7) ++
IF openRelieve != 1
    Qol_Info_Count_Array:ARG:Qol_Count_Toiletings ++
    LOCAL = HasScat ? -2 # -1
    SIF ITEM:PottyGuide && ARG == MASTER
        LOCAL --
    IF CAN_SEE(ARG)
        CALL PunishmentPointChange(ARG,LOCAL)
    ELSE
        PunishChange:ARG:0 = LIMIT(PunishChange:ARG:0+(LOCAL),0,124)
    ENDIF
ENDIF

IF HasPiss
    SIF ITEM:PottyGuide && ARG == MASTER
        BASE:ARG:尿意 *= 2
	EXP:ARG:GeneralPeeExp += BASE:ARG:尿意/100
    CALLF ChangeEndurance(ARG,"peehold",BASE:ARG:尿意/25)

    BASE:ARG:尿意 = 0
    TCVAR:ARG:PeeConcentration -= 4
    SIF TCVAR:ARG:PeeConcentration <= 0
        TCVAR:ARG:PeeConcentration = 0 
    SIF openRelieve == 1
        Qol_Info_Count_Array:ARG:Qol_Count_OpenPiss ++
ENDIF
IF HasScat
    SIF ITEM:PottyGuide && ARG == MASTER
        BASE:ARG:Poo *= 2
	EXP:ARG:GeneralPoopExp += BASE:ARG:Poo/100
    CALLF ChangeEndurance(ARG,"poohold",BASE:ARG:Poo/25)

    BASE:ARG:Poo = 0
    SIF openRelieve == 1
        Qol_Info_Count_Array:ARG:Qol_Count_OpenPoop ++
    IF !DT_SELECT(@"Hediff", @"chara = {ARG} and type = 54")
        DT_ROW_REMOVE "Hediff", RESULT:1
    ENDIF
ENDIF
