; SOURCE:Terror = GetWeaponScore(EQUIP:MASTER:Weapon, MASTER)
firedWeapon:ARG:0 = 18
FOR LOCAL,0,CHARANUM
    CALL CrippleEffects(LOCAL)
    IF IsDead:LOCAL:0 && HasBionicPart(LOCAL,132)
        PRINTFORMW The bomb inside %CALLNAME:LOCAL% explodes into a chain reaction!
        CALL SUICIDE_BOMB(LOCAL,232)
    ENDIF
NEXT
CALLF EquipWEapon(ARG,COM481_PREV)
CALL FIRE_WEAPON_CHECK_ALL

