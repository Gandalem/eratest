@ADD_CUSTOM_COM477
#DIM C477_FACTION
PRINTFORML 당신은 모집 게시판을 본다
CALL FACTION_RECRUIT_BOARD

@FACTION_COUNT(ARG,ARGS)
#FUNCTION
#DIM DYNAMIC FC_COUNT
VARSET FC_COUNT
FOR LOCAL,0,maxFactions
SIF !CHECK_FACTION(LOCAL,ARGS, ARG)
	CONTINUE
FC_COUNT ++
NEXT
RETURNF FC_COUNT

@FACTION_RECRUIT_BOARD
#DIM FRB_LINECOUNT
#DIM FRB_INPUT
#DIM FRB_LIST, 100
#DIM FRB_LISTCOUNT
#DIM FRB_PAGE
#DIM LAST_GROUP
#DIM CONST FRB_PER_PAGE = 8
VARSET FRB_PAGE, 1
FRB_LINECOUNT = LINECOUNT
DO
VARSET FRB_LIST, -1
VARSET FRB_LISTCOUNT
;factions
FOR LOCAL,0,MaxFactions
SIF !FactionExist(LOCAL)
	CONTINUE
FRB_LIST:FRB_LISTCOUNT = LOCAL
FRB_LISTCOUNT ++
NEXT
LAST_GROUP = 1 + (FRB_LISTCOUNT - 1) / FRB_PER_PAGE
CLEARLINE LINECOUNT - FRB_LINECOUNT
PRINTFORML  _ _____                _ 
PRINTFORML (_)  __ \              | |
PRINTFORML  _| |  | | ___  ___  __| |
PRINTFORML | | |  | |/ _ \/ _ \/ _` |
PRINTFORML | | |__| |  __/  __/ (_| |
PRINTFORML |_|_____/ \___|\___|\__,_|
PRINTFORML 기회 균등 채용 서비스
PRINTL
PRINTFORML {FACTION_COUNT(MASTER)} 고용주들이 당신을 원한다!
FOR LOCAL,((FRB_PAGE-1)*FRB_PER_PAGE),FRB_PAGE*FRB_PER_PAGE
SIF FRB_LIST:LOCAL < 0
	CONTINUE
SIF !FactionExist(FRB_LIST:LOCAL)
	CONTINUE
FONTBOLD
PRINTBUTTON @"%FACTION_RANK_STRING_INDE((FRB_LIST:LOCAL),GetFactionLevel(MASTER,FRB_LIST:LOCAL))% ({FactionExperience:MASTER:(FRB_LIST:LOCAL)}/{EXP_DEMAND_FACTION_RANK(GetFactionLevel(MASTER,FRB_LIST:LOCAL)+1)})", FRB_LIST:LOCAL
PRINTL
FONTITALIC
FONTREGULAR
PRINTFORM %FactionName(FRB_LIST:LOCAL)%
SETCOLOR C_GREEN
PRINTFORM %COND_STR(" (You are currently employed with this employer)",FactionRank:MASTER:(FRB_LIST:LOCAL))%
RESETCOLOR
PRINTL
PRINTFORML %"━"*20% 
NEXT
PRINTL
PRINTBUTTON @"%"Prev page",15,LEFT%", 8102
PRINTFORM  페이지 {FRB_PAGE} 
PRINTBUTTON @"%"Next page",15,RIGHT%", 8103
PRINTL
PRINTFORML [999] - 탐색 중지
INPUT
FRB_INPUT = RESULT
SELECTCASE RESULT
	CASE 999
		RETURN
	CASE 8102,8103
		SIF LAST_GROUP == 1
			CONTINUE
		FRB_PAGE = PAGE_HANDLE(RESULT, 8102, FRB_PAGE, 1, LAST_GROUP)
	CASE 0 TO MaxFactions
		SIF !FactionExist(FRB_INPUT)
			CONTINUE
		CALL FACTION_RECRUITING(FRB_INPUT)
ENDSELECT
LOOP 1
;level based on experience

@GetFactionLevel(ARG,nFaction)
#FUNCTION
#DIM nFaction
#DIM DYNAMIC GFL
VARSET GFL
SIF !FactionExperience:ARG:nFaction
	RETURNF 1
WHILE FactionExperience:ARG:nFaction >= EXP_DEMAND_FACTION_RANK(GFL+1)
SIF GFL >= 6
	BREAK
GFL ++
WEND
RETURNF GFL

@ADD_CUSTOM_COM_ABLE477
;押し倒す実行判定
SIF !TFLAG:100
	RETURN 0
SIF CFLAG:MASTER:うふふ
	RETURN 0
SIF SaveIsEZB
	RETURN 0
RETURN RECRUITMENT_AREA(CFLAG:MASTER:300)

@RECRUITMENT_AREA(ARG)
#FUNCTION
SELECTCASE ARG
	CASE ENTRANCE
		RETURNF 1
ENDSELECT
RETURNF 0
