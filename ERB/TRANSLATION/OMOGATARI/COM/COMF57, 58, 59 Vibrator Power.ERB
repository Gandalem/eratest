; Modular ERB: OMOGATARI/COM/COMF57, 58, 59 Vibrator Power.ERB
;-------------------------------------------------
;Set Vibe Power
;Give an option to set the vibrator power
;Normal training command level: 1
;-------------------------------------------------

@ADD_CUSTOM_COM59
PRINTFORML 진동기의 강도를 높이고 싶은 레벨을 선택하라. (현재 레벨 {TFLAG:VibePower})
FOR LOCAL, 0, 6
PRINTFORML [{LOCAL}] [LOCAL] - 레벨 {LOCAL}
NEXT
PRINTFORML [999] 나 여기서 나가게 해줘! 
INPUT
SIF RESULT != 999
	TFLAG:VibePower = RESULT
;着脱の処理
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1
TCVAR:TARGET:4 = 900
DOWNBASE:体力 += 30
DOWNBASE:気力 += 50
IF FLAG:70 == 1
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ELSE
	;同性愛　レズなら戻り値1ゲイなら戻り値2
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ENDIF
EXP:PLAYER:道具使用経験 ++
RETURN 1

@ADD_CUSTOM_MESSAGE_COM59
SELECTCASE TFLAG:VibePower
	CASE 0
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) %HE_SHE(TARGET)%가 진동을 거의 느끼지 못하자 지루해 보인다.
	CASE 1
		PRINTFORML 작은 신음이 %CALLNAME:TARGET%에게서 새어 나왔다.
	CASE 2
	CASE 3
	CASE 4
	CASEELSE
		PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 절정 저항하려 애쓰며 관능적인 신음과 함께 배설 댄스를 추고 있다.  
ENDSELECT

@ADD_CUSTOM_COM_ABLE59
