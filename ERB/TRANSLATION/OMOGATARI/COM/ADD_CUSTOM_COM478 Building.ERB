@ADD_CUSTOM_COM478
#DIM COM478_LINECOUNT
#DIM COM478_LOCATION
#DIM COM478_INPUT
COM478_LINECOUNT = LINECOUNT
COM478_LOCATION = CFLAG:MASTER:300
DO
    CLEARLINE LINECOUNT - COM478_LINECOUNT
    PRINTFORM Propaganda Sign: 
    IF FacionPropagandaSign:(COM478_LOCATION) > -1
    PRINTFORML %FactionName(FacionPropagandaSign:(COM478_LOCATION))%
    ELSE
    PRINTFORML None
    ENDIF
    PRINTL
    PRINTFORML [100] - Replace sign
    PRINTFORML [101] - Remove sign
    PRINTL
    PRINTFORML [999] - Exit
    INPUT
    COM478_INPUT = RESULT
    SELECTCASE COM478_INPUT
    CASE 100
        PRINTFORML Select a faction to replace the sign with.
        FOR LOCAL,0,MaxFactions
            SIF !FactionRank:MASTER:LOCAL
                CONTINUE
            PRINTFORML [{LOCAL,3}] - %FactionName(LOCAL)%
        NEXT
        PRINTL
        PRINTFORML [999] - Cancel
        INPUT
        SELECTCASE RESULT
        CASE 0 TO MaxFactions
            SIF !FactionRank:MASTER:RESULT
                CONTINUE
            PRINTFORMW You replace the sign with one for %FactionName(RESULT)%
            FacionPropagandaSign:(COM478_LOCATION) = RESULT
        CASE 999
            CONTINUE
        ENDSELECT
    CASE 101
        PRINTFORMW You remove the propaganda sign
        FacionPropagandaSign:(COM478_LOCATION) = -1
    CASE 999
        RETURN 1
    ENDSELECT
LOOP 1

