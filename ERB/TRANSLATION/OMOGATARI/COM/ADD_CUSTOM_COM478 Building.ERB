; Modular ERB: OMOGATARI/COM/ADD_CUSTOM_COM478 Building.ERB

@ADD_CUSTOM_COM478
#DIM COM478_LINECOUNT
#DIM COM478_LOCATION
#DIM COM478_INPUT
COM478_LINECOUNT = LINECOUNT
COM478_LOCATION = CFLAG:MASTER:300
DO
CLEARLINE LINECOUNT - COM478_LINECOUNT
PRINTFORM 선전 표지 
IF FacionPropagandaSign:(COM478_LOCATION) > -1
	PRINTFORML %FactionName(FacionPropagandaSign:(COM478_LOCATION))%
ELSE
	PRINTFORML 없음
ENDIF
PRINTL
PRINTFORML [100] - 부호 교체
PRINTFORML [101] - 부호 제거
PRINTL
PRINTFORML [999] - 종료
INPUT
COM478_INPUT = RESULT
SELECTCASE COM478_INPUT
	CASE 100
		PRINTFORML 표시를 대체할 진영을 선택한다.
		FOR LOCAL,0,MaxFactions
		SIF !FactionRank:MASTER:LOCAL
			CONTINUE
		PRINTFORML [{LOCAL,3}] - %FactionName(LOCAL)%
		NEXT
		PRINTL
		PRINTFORML [999] - 취소
		INPUT
		SELECTCASE RESULT
			CASE 0 TO MaxFactions
				SIF !FactionRank:MASTER:RESULT
					CONTINUE
				PRINTFORMW 당신은 기호를 %FactionName(RESULT)%의 것으로 바꾼다.
				FacionPropagandaSign:(COM478_LOCATION) = RESULT
			CASE 999
				CONTINUE
		ENDSELECT
	CASE 101
		PRINTFORMW 당신은 선전 간판을 제거한다
		FacionPropagandaSign:(COM478_LOCATION) = -1
	CASE 999
		RETURN 1
ENDSELECT
LOOP 1

@ADD_CUSTOM_COM_ABLE478
;押し倒す実行判定
SIF !TFLAG:100
	RETURN 0
SIF CFLAG:MASTER:うふふ
	RETURN 0
RETURN 1
