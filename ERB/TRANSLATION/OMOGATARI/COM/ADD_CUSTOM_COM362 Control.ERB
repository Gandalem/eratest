@ADD_CUSTOM_COM362
IF TALENT:MASTER:NonSentient
    PRINTFORMW You disconnect from the %NAME:MASTER%.
    CFLAG:MASTER:BeingControledBy = -1
    CALLF SimultaneousMasterSwap(TempUfufuBecome)
    RETURN
ENDIF

PRINTFORMW You take control of the unnamed %NAME:TARGET%.
IF TALENT:TARGET:UnmanedVehicle
    TempUfufuBecome:1 = TARGET
    CFLAG:TARGET:BeingControledBy = MASTER
    CALLF SimultaneousMasterSwap(TempUfufuBecome:1)
ENDIF

@ADD_CUSTOM_COM_PRINT362
#DIM CONST COM_ID = 362
IF CFLAG:MASTER:BeingControledBy == TempUfufuBecome
    PRINTFORMC Stop controlling %CALLNAME:MASTER%[{Add_Custom_COM_To_Number(COM_ID),3}]
ELSE
    PRINTFORMC Control %CALLNAME:TARGET%[{Add_Custom_COM_To_Number(COM_ID),3}]
ENDIF
RESETCOLOR
RETURN 1

@ADD_CUSTOM_COM_ABLE362
;押し倒す実行判定
SIF !TFLAG:100
	RETURN 0
SIF CFLAG:102:300 == CFLAG:MASTER:300
	RETURN 0
;not your car
SIF CFLAG:MASTER:BeingControledBy != TempUfufuBecome && CFLAG:MASTER:BeingControledBy > -1
    RETURN 0
;sentient
SIF !TALENT:TARGET:NonSentient && !TALENT:MASTER:NonSentient
    RETURN 0
RETURN 1