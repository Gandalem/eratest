; Modular ERB: OMOGATARI/COM/COMF299 Execute.ERB
;-------------------------------------------------
;Execute
;Requires gore and character deaths
; Firearm
; ・Mouth -> Neck -> Head
; ・Headshot
; ・Pistol Whip/Stock Bash
; ・Mag Dump
; ・Heart Shot
; Melee
; ・Head Bash
; ・Slit Neck
; ・Heart Stab
; ・Decapitation
; Unarmed
; ・Neck Slap
; ・Choking
; ・Throat Grab
; ・Sitting Choking
; ・Stomp
; Other
; ・Diaper Choking
; ・Lethal Injection
;-------------------------------------------------

@ADD_CUSTOM_COM299
IF FLAG:70
	BASE:MASTER:TSP -= 500
ELSE
	TIME += 1
ENDIF
RETURN 1

@ADD_CUSTOM_MESSAGE_COM299
$Loop
PRINTFORML 어떤 무기로 실행할지 선택해 주세요.
CALL ASK_M( "화기",GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Type") == "Firearm" && EQUIP:MASTER:Weapon, "근접 공격", STRFIND(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Type"),"Melee") > -1, "불꽃 (아직 구현되지 않음)",0, "무장하지 않은",1, "기타 (아직 구현되지 않음)", 0, "떠나기", 1)
TFLAG:143 = RESULT
IF TFLAG:143 == 5
	BASE:MASTER:TSP += 500
	RETURN -1
ENDIF
PRINTFORML 원하는 실행을 선택해 주세요.
SELECTCASE TFLAG:143
	CASE 0
		;firearm
		CALL ASK_M( "입 -> 목 -> 머리",charaWeaponInts:MASTER:Ammo >= 3, "헤드샷", charaWeaponInts:MASTER:Ammo >= 1, "권총 휘두르기",1, "매직 덤프",charaWeaponInts:MASTER:Ammo >= 1 || !charaWeaponInts:MASTER:MagSize)
		firedWeapon:MASTER:0 = charaWeaponInts:MASTER:Loudness
		SELECTCASE RESULT
			CASE 0
				PRINTFORML 당신의 %PrintWeaponName(MASTER,,-1)%을 손에 들고, 당신은 %조사처리(CALLNAME:TARGET,"의")% 입을 벌리고 총열을 %HIS_HER(TARGET)%의 목구멍 안에 밀어 넣는다.
				PRINTFORMW 안전장치를 해제하는 동시에 볼트를 앞뒤로 당기며, 당신은 %조사처리(CALLNAME:TARGET,"를")% 질식시키기 시작한다...
				PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 당신의 행동에 저항하기 시작하자, 당신은 첫 번째 발을 발사한다...
				CALL PlayFireSound(MASTER)
				PRINTFORML 피가 %조사처리(CALLNAME:TARGET,"의")% 입으로 새어 들어가 새로 생긴 구멍을 가득 채웠다.
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 격렬하게 피를 흘렸고, 그 피는 당신 주변 바닥에 빨간 얼룩을 만들며 고였다.
				PRINTFORMW %HE_SHE(TARGET,1)%은 고통 속에 비명을 지르려 하지만, %HIS_HER(TARGET)%의 마비된 입으로는 꿈틀거리거나 피를 토하는 것 외에는 거의 할 수 없었다.
				PRINTFORMW 당신은 다음으로 %조사처리(CALLNAME:TARGET,"의")% 목을 겨누고 두 번째 총알을 발사했다.
				CALL PlayFireSound(MASTER)
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 피의 끝없는 흐름을 막으려 %HIS_HER(TARGET)%의 목 양손을 잡는다.
				PRINTFORML %HIS_HER(TARGET,1)%의 비명은 자주 피를 토하는 기침에 끊기며, %HIS_HER(TARGET)% 얼굴 대부분이 그녀의 생명수로 뒤덮여 있다.
				PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 옷은 핏자국으로 물들어 있고, %HIS_HER(TARGET)%의 목에서는 전례 없는 속도로 피가 흘러내리고 있다.
				PRINTFORMW 세 번째이자 마지막 일격을 위해, 당신은 살해를 목표로 %조사처리(CALLNAME:TARGET,"의")% 머리를 겨눈다.
				CALL PlayFireSound(MASTER)
				PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 마지막으로 한번 끙 소리를 내고 남은 피가 분수처럼 %HIM_HER(TARGET)%에서 뿜어져 나왔다.
				PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 몸은 아직 살아있어서 계속 움찔거렸지만, 플레이어의 공격 때문에 의사소통을 할 수 없었다.
				CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"1",TOSTR(EQUIP:MASTER:Weapon),1)
				CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"12",TOSTR(EQUIP:MASTER:Weapon),0)
				CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"11",TOSTR(EQUIP:MASTER:Weapon),1)
				CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"8",TOSTR(EQUIP:MASTER:Weapon),1)
			CASE 1
				PRINTFORML 당신은 안전장치를 해제하고 볼트를 뒤로 당겨 총을 장전한 후, 당신의 %PrintWeaponName(MASTER,,-1)%를 꺼냈다.
				PRINTFORMW 당신은 섬뜩하게 미소 지으며 방아쇠를 당기기 전에, 당신의 %PrintWeaponName(MASTER,,-1)%를 %조사처리(CALLNAME:TARGET,"의")% 머리에 가져다 댔다.
				CALL PlayFireSound(MASTER)
				PRINTFORMW 총알이 %HIS_HER(TARGET)%의 두개골을 관통하여 새로운 구멍에서 피가 분수처럼 솟구치기 시작하자 뇌를 내장시키고,
				PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 쿵 소리를 내며 쓰러지고 %HIS_HER(TARGET)%의 몸에서 피가 고인다.
				CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"1",TOSTR(EQUIP:MASTER:Weapon),1)
				CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"12",TOSTR(EQUIP:MASTER:Weapon),0)
			CASE 2
				SELECTCASE GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class")
					CASE "Pistol"
						PRINTFORMW 당신은 %PrintWeaponName(MASTER,,-1)%, %조사처리(CALLNAME:TARGET,"를")% 꺼내서 %HIM_HER(TARGET)%을 쏘리라고 예상했다.
						PRINTFORMW 대신, 당신은 권총의 그립으로 %HIM_HER(TARGET)%을 때렸고, 격렬한 충격에 %CALLNAME% 움츠러들었다.
						PRINTFORMW 당신은 %HIM_HER(TARGET)%을 반복적으로 여러 번 때렸고, 매번 피가 더 많이 나다가 결국 %HES_SHES(TARGET)% 피범벅이 되었다.
						REPEAT 3
						CALLF BroadDamage(TARGET,"head",(MAXBASE:MASTER:体力),6,MASTER,@"%PrintWeaponName(MASTER,,-1)%(은/는) 그립")
						REND
					CASEELSE
						PRINTFORMW 당신은 총을 근접 무기처럼 들고 자신의 %PrintWeaponName(MASTER,,-1)%,를 꺼낸다.
						PRINTFORMW 온 힘을 다해 당신은 %CALLNAME%'의 머리를 향해 %PrintWeaponName(MASTER,,-1)%를 휘두르기 시작한다.
						PRINTFORMW 총의 무게가 빠른 속도로 움직이는 개머리판이 %CALLNAME:TARGET%'의 머리에 집중되어 강하게 내리친다.
						PRINTFORMW %HE_SHE(TARGET,1)%은 움츠러들며 바닥으로 쓰러지고, 다시 공격할 준비를 한다.
						PRINTFORMW 당신은 %HIM_HER(TARGET)%에게 몇 번 더 타격을 가하여 %HE_SHE(TARGET)%이 다시는 일어나지 못하게 만든다.
						PRINTFORMW 매번의 타격은 이전보다 더욱 피가 많이 난다.
						REPEAT 3
						CALLF BroadDamage(TARGET,"head",(MAXBASE:MASTER:体力),6,MASTER,@"%PrintWeaponName(MASTER,,-1)%의 재고")
						REND
				ENDSELECT
			CASE 3
				PRINTFORML 당신은 안전장치를 해제하고 볼트를 뒤로 당겨 총을 장전하며 %PrintWeaponName(MASTER,,-1)%를 꺼낸다.
				PRINTFORMW 그런 다음, 당신은 탄약이 떨어질 때까지 무작위로 %HIM_HER(TARGET)%에게 발사하기 시작한다.
				LOCAL = MIN(30,charaWeaponInts:MASTER:Ammo)
				SIF !charaWeaponInts:MASTER:MagSize
					LOCAL = 30
				REPEAT LOCAL
				CALL PlayFireSound(MASTER)
				SELECTCASE RAND(100)
					CASE IS < 25
						CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"head",TOSTR(EQUIP:MASTER:Weapon),1)
					CASE IS < 50
						SELECTCASE RAND:4
							CASE 0
								CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"lleg",TOSTR(EQUIP:MASTER:Weapon),1)
							CASE 1
								CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"rleg",TOSTR(EQUIP:MASTER:Weapon),1)
							CASE 2
								CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"larm",TOSTR(EQUIP:MASTER:Weapon),1)
							CASE 3
								CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"rarm",TOSTR(EQUIP:MASTER:Weapon),1)
						ENDSELECT
					CASEELSE
						SELECTCASE RAND:3
							CASE 0
								CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"stomach",TOSTR(EQUIP:MASTER:Weapon),1)
							CASE 1
								CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"thorax",TOSTR(EQUIP:MASTER:Weapon),1)
							CASE 2
								CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"crotch",TOSTR(EQUIP:MASTER:Weapon),1)
						ENDSELECT
				ENDSELECT
				TWAIT 80, 1
				REND
		ENDSELECT
	CASE 1
		CALL ASK_M( "참수하다", STRFIND(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class"), "2H Blade") > -1, "머리 대시", 1, "목을 가른다", STRFIND(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class"), "Blade") > -1, "심장 관통", STRFIND(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class"), "Blade") > -1 )
		SELECTCASE RESULT
			CASE 0
				PRINTFORMW 당신은 자신의 %PrintWeaponName(MASTER,,-1)%를 꺼내서 %조사처리(CALLNAME:TARGET,"의")% 목을 가로지르는 베기를 준비한다.
				PRINTFORMW 당신은 강력한 일격을 위해 칼날을 겨누고 %조사처리(CALLNAME:TARGET,"의")% 목을 향해 내리친다.
				PRINTFORMW 칼날이 깨끗하게 %HIS_HER(TARGET)%의 목을 가르며 머리를 나머지 %HIS_HER(TARGET)% 신체로부터 분리한다.
				PRINTFORMW %CALLNAME:TARGET%'의 몸은 샘처럼 피를 뿜어내기 시작하고, 몸이 뻣뻣해지면서 우아하게 쓰러진다.
				CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage*10,2,"11",TOSTR(EQUIP:MASTER:Weapon),0)
			CASE 1
				PRINTFORMW 당신은 %PrintWeaponName(MASTER,,-1)%을 꺼낸다.
				PRINTFORMW 모든 힘을 다해, 당신은 %조사처리(CALLNAME:TARGET,"의")% 머리를 향해 %PrintWeaponName(MASTER,,-1)%을 휘두기 시작한다.
				PRINTFORMW 무기의 무게가 빠르게 움직이는 개머리판에 고속으로 충돌하며 %조사처리(CALLNAME:TARGET,"의")% 머리에 집중된다.
				PRINTFORMW %HE_SHE(TARGET,1)%은 움츠러들어 바닥으로 쓰러지지만, 또 다른 공격을 위해 당신의 무기를 준비한다.
				PRINTFORMW 당신은 %HIM_HER(TARGET)%에게 몇 번 더 타격을 가하며, %HE_SHE(TARGET)%이 다시는 일어나지 못하도록 한다.
				PRINTFORMW 매번의 일격은 이전보다 더욱 피가 많이 난다.
				REPEAT 3
				CALLF BroadDamage(TARGET,"head",(MAXBASE:MASTER:体力),6,MASTER,TOSTR(EQUIP:MASTER:Weapon))
				REND
			CASE 2
				PRINTFORMW 너는 팔로 %조사처리(CALLNAME:TARGET,"를")% 붙잡고, %HIS_HER(TARGET)%의 목을 활짝 벌린 채로 놓는다.
				PRINTFORMW 너는 %PrintWeaponName(MASTER,,-1)%을 %조사처리(CALLNAME:TARGET,"의")% 목에 대고, 재빠르게 그곳을 베어내기 시작한다.
				PRINTFORMW 너는 칼날을 %CALLNAME:TARGET%로부터 빼내고, 무기를 허리춤에 다시 넣는다.
				PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 정신없이 쓰러지고, %HIS_HER(TARGET)%의 벌어진 목에서 피가 흘러나오기 시작한다.
				CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,2,"47",TOSTR(EQUIP:MASTER:Weapon),0)
				BASE:TARGET:Blood = 0
			CASE 3
				PRINTFORMW 당신은 당신의 %PrintWeaponName(MASTER,,-1)%을 뽑고 %조사처리(CALLNAME:TARGET,"의")% 심장을 찌를 준비를 한다.
				PRINTFORMW 당신은 칼날을 세우며, 당신의 %PrintWeaponName(MASTER,,-1)% 끝에 힘을 집중한다.
				PRINTFORMW 공격을 시작하며, 당신은 %조사처리(CALLNAME:TARGET,"의")% 심장을 꿰뚫기 시작하고, 피가 %HIS_HER(TARGET)% 부서진 심장에서 분수처럼 뿜어져 나온다.
				PRINTFORMW 칼날이 %HIS_HER(TARGET)%의 몸 안에 박힌 채, %조사처리(CALLNAME:TARGET,"는")% 의식을 잃고 쓰러진다.
				PRINTFORMW 당신은 %CALLNAME:TARGET%에게서 칼을 빼내 피 묻은 무기를 다시 허리춤에 넣는다. 나머지 피가 %HIS_HER(TARGET)%의 상처에서 흘러나오기 시작한다.
				CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage*10,2,"47",TOSTR(EQUIP:MASTER:Weapon),0)
		ENDSELECT
	CASE 3
		CALL ASK_M( "목찰싹", 1, "질식",1, "목 조르기",1, )
		SELECTCASE RESULT
			CASE 0
				PRINTFORMW 당신은 맨몸의 힘으로 %조사처리(CALLNAME:TARGET,"의")% 목을 꺾는다.
				PRINTFORMW 만족스러운 파열음이 %CALLNAME% 몸 뒤에 울리며, 무슨 일이 일어나고 있는지 이해하지 못한다.
				PRINTFORMW %HIS_HER(TARGET,1)%의 머리가 목에서 분리되어 사방으로 흔들리다가, 몸이 '쿵' 소리를 내며 쓰러진다.
				CALLF DamageBodyPart(TARGET,11, MAXBASE:TARGET:0*2, 5, MASTER, "bare hands")
			CASE 1
				IF EQUIP:MASTER:Weapon
					PRINTFORMW 당신은 잡는다 %CALLNAME:TARGET%너의 %PrintWeaponName(MASTER,,-1)%그것을 막으로 삼아 목을 졸라 %CALLNAME:TARGET%
				ELSE
					PRINTFORMW 당신은 팔꿈치로 %조사처리(CALLNAME:TARGET,"를")% 붙잡고, %조사처리(CALLNAME:TARGET,"를")% 목을 조르려고 한다.
				ENDIF
				PRINTFORMW %CALLNAME:TARGET% 당신의 접근을 저항하려 애쓰지만 당신이 목에 손아귀를 조이기 시작하면서 %HIS_HER(TARGET)% 목을
				PRINTFORMW %HE_SHE(TARGET,1)%이 숨을 쉬려 애쓰고 있으며, 너의 악력 클램프가 %HIS_HER(TARGET)%의 기도를 막는다.
				PRINTFORMW 숨을 헐떡이는 것이 점점 짧아지면서 %CALLNAME:TARGET% ~에 순응하기 시작하다 %HIS_HER(TARGET)% 운명에 굴복하고 숨이 끊기기 전에.
				CALLF DamageBodyPart(TARGET, 45, MAXBASE:TARGET:0*2, 34, MASTER, @"질식한다")
				CALLF DamageBodyPart(TARGET, 46, MAXBASE:TARGET:0*2, 34, MASTER, @"질식하는 것")
			CASE 2
				PRINTFORMW 당신의 손을 잡은 채, 당신은 전력을 다해 %조사처리(CALLNAME:TARGET,"의")% 목을 움켜쥔다.
				PRINTFORMW 당신의 손톱이 피부를 찢어 피가 나게 만든다.
				PRINTFORMW 당신은 %조사처리(CALLNAME:TARGET,"의")% 목을 움켜쥐고, 그것을 %HIM_HER(TARGET)%에게서 빼내는 것을 확실히 한다.
				PRINTFORMW %조사처리(CALLNAME:TARGET,"의")% 몸은 여전히 살아있어 경련하지만, 당신의 공격으로 인해 %HIM_HER(TARGET)%는 의사소통을 할 수 없게 되었다.
				CALLF DamageBodyPart(TARGET, 11, MAXBASE:TARGET:0*2, 5, MASTER, @"목이 잡혔다")
		ENDSELECT
	CASEELSE
		;invalid
		RETURN -1
ENDSELECT
PRINTFORMW 만족했다, 이미 죽지 않았다면 당신은 %조사처리(CALLNAME:TARGET,"가")%(가) 자신의 %HIS_HER(TARGET)% 상처로 쓰러져 가는 것을 내버려 두었다.
SOURCE:反感 = 10000
CALL CrippleEffects(TARGET)
IF IsDead:TARGET:0
	PRINTDATAL
		DATAFORM %조사처리(CALLNAME:TARGET,"의")% 영혼이 풀리면서 시간 정지 능력을 방해하고 시간이 다시 흐르게 만든다.
		DATAFORM %조사처리(CALLNAME:TARGET,"의")% 죽음은 멈춘 시간에 혼란을 일으켜 그것이 재개되도록 강제한다.
		DATAFORM %조사처리(CALLNAME:TARGET,"의")% 영혼이 벗어나면서, 시간 역설을 만들지 않기 위해 %HIS_HER(TARGET)%의 몸에서 시간은 다시 흐른다.
	ENDDATA
	FLAG:70 = 0
	RESETBGCOLOR
ENDIF
CALL FIRE_WEAPON_CHECK_ALL

@ADD_CUSTOM_COM_ABLE299
; Do not allow during ufufu or time stop
SIF !TFLAG:100
	RETURN 0
SIF TARGET == MASTER ; doesn't make sense to kick yourself out
	RETURN 0
SIF !nNecro
	RETURN 0
SIF !CFLAG:うふふ && SHIRAHU(TARGET)
	RETURN 0
SIF isDead:TARGET:0
	RETURN 0
SIF inTrain == 3 ;lucid dream
	RETURN 0
IF FLAG:70
	SIF BASE:MASTER:TSP < 500
		RETURN 0
ELSE
ENDIF
RETURN 1
;Shoots the target

@ShootTarget(nVictim,nDealer,DMG,DMG_TYPE,nPart,nItem,nConsume = 1)
#DIM nDealer
#DIM nVictim
#DIMS nItem
#DIM DMG
#DIM DMG_TYPE
#DIM nPerm
#DIMS nPart
#DIM nConsume
SIF nConsume
	charaWeaponInts:nDealer:Ammo --
FOR LOCAL:7, 1, charaWeaponInts:nDealer:Pellets+1
IF TOINT(nPart)
	CALLF DamageBodyPart(nVictim,TOINT(nPart),DMG,DMG_TYPE,nDealer, nItem, nPerm)
ELSE
	CALLF BroadDamage(nVictim,nPart,DMG,DMG_TYPE,(nDealer), nItem, nPerm)
ENDIF
NEXT
