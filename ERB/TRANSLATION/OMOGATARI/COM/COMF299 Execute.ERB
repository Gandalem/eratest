@ADD_CUSTOM_COM299
IF FLAG:70
BASE:MASTER:TSP -= 500
ELSE
TIME += 1
ENDIF
RETURN 1

@ADD_CUSTOM_MESSAGE_COM299
$Loop
PRINTFORML Please select what weapon do you want to execute with.
{
CALL ASK_M(
	"Firearm",GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Type") == "Firearm" && EQUIP:MASTER:Weapon,
	"Melee", STRFIND(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Type"),"Melee") > -1,
	"Fire (Not Implemented Yet)",0,
	"Unarmed",1,
	"Other (Not Implemented Yet)", 0,
	"Leave", 1)
}
TFLAG:143 = RESULT
IF TFLAG:143 == 5
	BASE:MASTER:TSP += 500
	RETURN -1
ENDIF

PRINTFORML Please select what execution you want to do.
SELECTCASE TFLAG:143
CASE 0
	;firearm
	{
	CALL ASK_M(
		"Mouth -> Neck -> Head",charaWeaponInts:MASTER:Ammo >= 3,
		"Headshot", charaWeaponInts:MASTER:Ammo >= 1,
		"Pistol Whip",1,
		"Mag Dump",charaWeaponInts:MASTER:Ammo >= 1 || !charaWeaponInts:MASTER:MagSize)
	}
	firedWeapon:MASTER:0 = charaWeaponInts:MASTER:Loudness
	SELECTCASE RESULT

	CASE 0
		PRINTFORML With your %PrintWeaponName(MASTER,,-1)% in hand, you force %CALLNAME:TARGET%'s mouth open and stick the barrel inside %HIS_HER(TARGET)%'s throat.
		PRINTFORMW Disengaging the safety while also pulling the bolt back and forth, you start choking %CALLNAME:TARGET%...
		PRINTFORMW With %CALLNAME:TARGET% starting to oppose your actions, you fire off the first shot...
		CALL PlayFireSound(MASTER)
		PRINTFORML Blood starts to leak into %CALLNAME:TARGET%'s mouth, filling up the newfound orifice.
		PRINTFORML %CALLNAME:TARGET% bleeds violently as said blood pools into a puddle that stains the floor around you red.
		PRINTFORMW %HE_SHE(TARGET,1)% tries to scream in agony, but %HIS_HER(TARGET)% crippled mouth can barely do anything but writhe and cough up blood.
		PRINTFORMW You aim at %CALLNAME:TARGET%'s neck next, firing off the second shot
		CALL PlayFireSound(MASTER)
		PRINTFORML %CALLNAME:TARGET% grabs both hands on %HIS_HER(TARGET)% neck, trying to stop the neverending flow of blood.
		PRINTFORML %HIS_HER(TARGET,1)% screams are frequently cut up by coughs of blood, the bulk of %HIS_HER(TARGET)% face covered in her life essence.
		PRINTFORMW The clothes on %CALLNAME:TARGET% are stained red, with %HIS_HER(TARGET)% neck bleeding at an unprecedented rate.
		PRINTFORMW For the third and final shot, you aim at %CALLNAME:TARGET%'s head, going for the killing blow.
		CALL PlayFireSound(MASTER)
		PRINTFORMW %CALLNAME:TARGET% grunts one final time, the rest of the blood that hasn't leaked shooting out of %HIM_HER(TARGET)% like a fountain.
		PRINTFORMW %CALLNAME:TARGET%'s body still twitches as it's still alive, but your damage makes it unable to communicate.
		CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"1",TOSTR(EQUIP:MASTER:Weapon),1)
		CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"12",TOSTR(EQUIP:MASTER:Weapon),0)
		CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"11",TOSTR(EQUIP:MASTER:Weapon),1)
		CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"8",TOSTR(EQUIP:MASTER:Weapon),1)
	CASE 1
		PRINTFORML You pull out your %PrintWeaponName(MASTER,,-1)%, disengaging the safety before cocking the gun by pulling the bolt back and fourth.
		PRINTFORMW You place your %PrintWeaponName(MASTER,,-1)% on the head of %CALLNAME%, giving a sinister smile before pulling the trigger.
		CALL PlayFireSound(MASTER)
		PRINTFORMW The bullet penetrates through %HIS_HER(TARGET)% skull, eviscerating the brain as blood begins to gush out of the newly formed orifice.
		PRINTFORMW %CALLNAME% falls down with a thud, blood pooling up from %HIS_HER(TARGET)% body.
		CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"1",TOSTR(EQUIP:MASTER:Weapon),1)
		CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"12",TOSTR(EQUIP:MASTER:Weapon),0)
	CASE 2
		SELECTCASE GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class")
		CASE "Pistol"
			PRINTFORMW You pull out your %PrintWeaponName(MASTER,,-1)%, %CALLNAME% expecting you to shoot %HIM_HER(TARGET)%.
			PRINTFORMW Instead, you smack %HIM_HER(TARGET)% with the grip of your pistol, %CALLNAME% recoiling from the violent impact.
			PRINTFORMW You repeatably smack %HIM_HER(TARGET)% multiple times, each time getting bloodier and bloodier until %HES_SHES(TARGET)% a bloody mess.
			REPEAT 3
			CALLF BroadDamage(TARGET,"head",(MAXBASE:MASTER:体力),6,MASTER,@"%PrintWeaponName(MASTER,,-1)% grip")
			REND
		CASEELSE
			PRINTFORMW You pull out your %PrintWeaponName(MASTER,,-1)%, holding the gun like it's a melee weapon.
			PRINTFORMW With all your might, you start swinging the %PrintWeaponName(MASTER,,-1)% at %CALLNAME%'s head.
			PRINTFORMW The weight of the gun is concentrated on the fast moving stock slamming on %CALLNAME:TARGET%'s head at a high rate of speed.
			PRINTFORMW %HE_SHE(TARGET,1)% recoils and falls down to the ground, before readying up your gun for another strike.
			PRINTFORMW You hit %HIM_HER(TARGET)% a few more times, ensuring that %HE_SHE(TARGET)% won't get up again.
			PRINTFORMW Each strike is more bloody than the last.

			REPEAT 3
			CALLF BroadDamage(TARGET,"head",(MAXBASE:MASTER:体力),6,MASTER,@"%PrintWeaponName(MASTER,,-1)% stock")
			REND
		ENDSELECT
	CASE 3
		PRINTFORML You pull out your %PrintWeaponName(MASTER,,-1)%, disengaging the safety before cocking the gun by pulling the bolt back and fourth.
		PRINTFORMW Then, you start firing randomly at %HIM_HER(TARGET)% until you are out of rounds.
		LOCAL = MIN(30,charaWeaponInts:MASTER:Ammo)
		SIF !charaWeaponInts:MASTER:MagSize
			LOCAL = 30
		REPEAT LOCAL
			CALL PlayFireSound(MASTER)
			SELECTCASE RAND(100)
			CASE IS < 25
				CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"head",TOSTR(EQUIP:MASTER:Weapon),1)
			CASE IS < 50
				SELECTCASE RAND:4
				CASE 0
					CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"lleg",TOSTR(EQUIP:MASTER:Weapon),1)
				CASE 1
					CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"rleg",TOSTR(EQUIP:MASTER:Weapon),1)
				CASE 2
					CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"larm",TOSTR(EQUIP:MASTER:Weapon),1)
				CASE 3
					CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"rarm",TOSTR(EQUIP:MASTER:Weapon),1)
				ENDSELECT
			CASEELSE
				SELECTCASE RAND:3
				CASE 0
					CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"stomach",TOSTR(EQUIP:MASTER:Weapon),1)
				CASE 1
					CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"thorax",TOSTR(EQUIP:MASTER:Weapon),1)
				CASE 2
					CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,1,"crotch",TOSTR(EQUIP:MASTER:Weapon),1)
				ENDSELECT
			ENDSELECT
		TWAIT 80, 1
		REND
	ENDSELECT
CASE 1
	{
	CALL ASK_M(
		"Decapitate", STRFIND(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class"), "2H Blade") > -1,
		"Head Bash", 1,
		"Slit Neck", STRFIND(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class"), "Blade") > -1,
		"Heart Stab", STRFIND(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Class"), "Blade") > -1
		)
	}
	SELECTCASE RESULT
	CASE 0
		PRINTFORMW You pull out your %PrintWeaponName(MASTER,,-1)% and prepare for a slash across %CALLNAME:TARGET%'s neck.
		PRINTFORMW You ready up your blade, going for a powerful blow, before slashing through %CALLNAME:TARGET%'s neck.
		PRINTFORMW The blade cuts cleanly through %HIS_HER(TARGET)% neck, separating the head from the rest of %HIS_HER(TARGET)% body.
		PRINTFORMW %CALLNAME:TARGET%'s body starts spurting out blood like a fountain, as the body goes stiff, falling down gracefully.
		CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage*10,2,"11",TOSTR(EQUIP:MASTER:Weapon),0)
	CASE 1
		PRINTFORMW You pull out your %PrintWeaponName(MASTER,,-1)%.
		PRINTFORMW With all your might, you start swinging the %PrintWeaponName(MASTER,,-1)% at %CALLNAME%'s head.
		PRINTFORMW The weight of the weapon is concentrated on the fast moving stock slamming on %CALLNAME:TARGET%'s head at a high rate of speed.
		PRINTFORMW %HE_SHE(TARGET,1)% recoils and falls down to the ground, before readying up your weapon for another strike.
		PRINTFORMW You hit %HIM_HER(TARGET)% a few more times, ensuring that %HE_SHE(TARGET)% won't get up again.
		PRINTFORMW Each strike is more bloody than the last.

		REPEAT 3
		CALLF BroadDamage(TARGET,"head",(MAXBASE:MASTER:体力),6,MASTER,TOSTR(EQUIP:MASTER:Weapon))
		REND
	CASE 2
		PRINTFORMW You grab %CALLNAME:TARGET% with your arm, leaving %HIS_HER(TARGET)% neck wide open.
		PRINTFORMW You place your %PrintWeaponName(MASTER,,-1)% to the neck of %CALLNAME:TARGET%, before doing a quick slash at it.
		PRINTFORMW You pull the blade away from %CALLNAME:TARGET%, putting the weapon back to your holster.
		PRINTFORMW %CALLNAME:TARGET% falls down unconsciously, blood beginning to pool out of %HIS_HER(TARGET)% slit neck.
		CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage,2,"47",TOSTR(EQUIP:MASTER:Weapon),0)
		BASE:TARGET:Blood = 0
	CASE 3
		PRINTFORMW You pull out your %PrintWeaponName(MASTER,,-1)% and prepare to stab though %CALLNAME:TARGET%'s heart.
		PRINTFORMW You ready up your blade, concentrating your power on the tip of your %PrintWeaponName(MASTER,,-1)%.
		PRINTFORMW Beginning to strike, you begin to stab through %CALLNAME:TARGET%'s heart, a spray of blood shooting out from %HIS_HER(TARGET)% shattered heart.
		PRINTFORMW With your blade inside %HIS_HER(TARGET)% torso, %CALLNAME:TARGET% falls down unconsciously.
		PRINTFORMW You pull the blade out of %CALLNAME:TARGET%, putting the bloody weapon back to your holster, the rest of the blood beginning to pool out of %HIS_HER(TARGET)% wound.
		CALL ShootTarget(TARGET,MASTER,charaWeaponInts:MASTER:Damage*10,2,"47",TOSTR(EQUIP:MASTER:Weapon),0)
	ENDSELECT
CASE 3
	{
	CALL ASK_M(
		"Neck Slap", 1,
		"Choking",1,
		"Throat Grab",1,
		)
	}
	SELECTCASE RESULT
	CASE 0
	PRINTFORMW You snap %CALLNAME:TARGET%'s neck using your bare strength.
	PRINTFORMW A satisfying crack follows %CALLNAME% body, unable to comprehend what's happening.
	PRINTFORMW %HIS_HER(TARGET,1)% head flails about, detached from the neck, before the body falls with a thud.
	CALLF DamageBodyPart(TARGET,11, MAXBASE:TARGET:0*2, 5, MASTER, "bare hands")
	CASE 1
	IF EQUIP:MASTER:Weapon
		PRINTFORMW You grab %CALLNAME:TARGET% with your %PrintWeaponName(MASTER,,-1)%, using it as a bar to choke %CALLNAME:TARGET%
	ELSE
		PRINTFORMW You grab %CALLNAME:TARGET% with your elbow, trying to choke %CALLNAME:TARGET%.
	ENDIF
	PRINTFORMW %CALLNAME:TARGET% struggles to resist your advances as you begin to tighten your grip on %HIS_HER(TARGET)% neck.
	PRINTFORMW %HE_SHE(TARGET,1)% begins to grasp for air, your vice clamp tight grip blocking the airways to %HIS_HER(TARGET)% lungs.
	PRINTFORMW As the gasps of air become shorter and shorter, %CALLNAME:TARGET% begins to resign to %HIS_HER(TARGET)% fate, before running out of breath.
	CALLF DamageBodyPart(TARGET, 45, MAXBASE:TARGET:0*2, 34, MASTER, @"choking")
	CALLF DamageBodyPart(TARGET, 46, MAXBASE:TARGET:0*2, 34, MASTER, @"choking")
	CASE 2
		PRINTFORMW Gripping your hand, you grab %CALLNAME:TARGET%'s neck with all of your strength
		PRINTFORMW Your fingernails tear into the skin, causing it to bleed.
		PRINTFORMW You get a grip on %CALLNAME:TARGET%'s throat, making sure to tear it out of %HIM_HER(TARGET)%.
		PRINTFORMW %CALLNAME:TARGET%'s body still twitches as it's still alive, but your damage makes %HIM_HER(TARGET)% unable to communicate.
		CALLF DamageBodyPart(TARGET, 11, MAXBASE:TARGET:0*2, 5, MASTER, @"throat grabbed")
	ENDSELECT
CASEELSE
	;invalid
	RETURN -1
ENDSELECT
PRINTFORMW Satisfied, you leave the dying, if not already dead %CALLNAME:TARGET% to pass away by %HIS_HER(TARGET)% wounds.

SOURCE:反感 = 10000
CALL CrippleEffects(TARGET)
IF IsDead:TARGET:0
	PRINTDATAL
	DATAFORM The release %CALLNAME:TARGET%'s soul disrupts your time stopping agility, causing time to resume.
	DATAFORM The death of %CALLNAME:TARGET% causes a disruption in stopped time, forcing it to resume.
	DATAFORM As %CALLNAME:TARGET% soul leaves, %HIS_HER(TARGET)% body, time resumes as to not create a time paradox.
	ENDDATA
	FLAG:70 = 0
	RESETBGCOLOR
ENDIF

CALL FIRE_WEAPON_CHECK_ALL

@ADD_CUSTOM_COM_ABLE299
; Do not allow during ufufu or time stop
SIF !TFLAG:100
	RETURN 0  
SIF TARGET == MASTER ; doesn't make sense to kick yourself out
    RETURN 0
SIF !nNecro
	RETURN 0
SIF !CFLAG:うふふ && SHIRAHU(TARGET)
	RETURN 0
SIF isDead:TARGET:0
	RETURN 0
SIF inTrain == 3 ;lucid dream
	RETURN 0
IF FLAG:70
	SIF BASE:MASTER:TSP < 500
		RETURN 0
ELSE
ENDIF
RETURN 1

;Shoots the target
@ShootTarget(nVictim,nDealer,DMG,DMG_TYPE,nPart,nItem,nConsume = 1)
#DIM nDealer
#DIM nVictim
#DIMS nItem
#DIM DMG
#DIM DMG_TYPE
#DIM nPerm
#DIMS nPart
#DIM nConsume

SIF nConsume
charaWeaponInts:nDealer:Ammo --
FOR LOCAL:7, 1, charaWeaponInts:nDealer:Pellets+1
	IF TOINT(nPart)
		CALLF DamageBodyPart(nVictim,TOINT(nPart),DMG,DMG_TYPE,nDealer, nItem, nPerm)
	ELSE
		CALLF BroadDamage(nVictim,nPart,DMG,DMG_TYPE,(nDealer), nItem, nPerm)
	ENDIF
NEXT