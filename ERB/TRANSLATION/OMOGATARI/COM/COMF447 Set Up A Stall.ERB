@NAS_SALES_CLOTHES(CHARA, clothingPage)
#DIM CHARA
#DIM 買うもの
;購入条件設定
#DIM     clothingPage       ;表示中のページ
#DIM CREDRAW
#DIM FL_LINE
FL_LINE = LINECOUNT
clothingPage = MAX(clothingPage,1)
CLEARLINE LINECOUNT - FL_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
TRYCALLFORM NAS_SALES_CLOTHES_LISTING(FINDELEMENT(EQUIPNAME, 表示部位:clothingPage), EquipIDSTR:clothingPage, CHARA)
FOR LOCAL, 0, VARSIZE("表示ラベル")
SIF GROUPMATCH(LOCAL, 10, 19,20,24)
	CONTINUE
[IF_NDEBUG]
SIF LOCAL == VARSIZE("表示ラベル")
	CONTINUE
[ENDIF]
SIF clothingPage == LOCAL
	SETCOLOR 0x00FFFF
;exception for player character
PRINTBUTTON "표시 라벨:LOCAL", LOCAL + 8030
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTFORML 

@NAS_SALES_CLOTHES_LISTING(nGroup, ARGS, CHARA)
#DIM nGroup
#DIM DYNAMIC 表示数
#DIM DYNAMIC 表示行
#DIM DYNAMIC nPrice
#DIM CHARA
#DIM ABRIV
;DRAWLINE
;CALL LIST_ITEM("野菜")
;DRAWLINE
FOR LOCAL,0,1000
SIF CLOTHNAME(nGroup, LOCAL) == ""
	CONTINUE
IF BoughtClothing:nGroup:(LOCAL) > 0 ;bug fix
	ABRIV = 100000+(nGroup*1000)+LOCAL
	IF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 20
		LOCALS:1 '= @" (%PALAM_NUM_NAS(STALL_PRICE_SET(NAS_SALES:1, ABRIV, 1, 2), , 1)%)"
	ELSE
		LOCALS:1 '= ""
	ENDIF
	;Custom code, formatting printing
	IF STRLENS(CLOTHNAME(nGroup, LOCAL)) > 30
		IF LOCAL:10 % 3 == 0 && LOCAL:10 % 3 != 0
			LOCAL:10 ++
			PRINTL
		ENDIF
		LOCALS = %CLOTHNAME(nGroup, LOCAL), STRLENS(CLOTHNAME(nGroup, LOCAL)), LEFT%
		;SIF LOCAL:10 % 4 != 0
		LOCAL:10 ++
	ELSE
		LOCALS = %CLOTHNAME(nGroup, LOCAL), 40, LEFT%
	ENDIF
	LOCALS += LOCALS:1
	LOCALS += @"×{BoughtClothing:nGroup:(LOCAL), 3}"
	;LOCALS += @" ({ABRIV})"
	IF NAS_SALES_HasItem(ABRIV)
		SETCOLOR 0x666666
		PRINTPLAINFORM 　　%LOCALS% 
	ELSE
		CALL QoL_Stall("Guess",CHARA,NAS_SALES:1, ABRIV) ;qol custom code
		PRINTBUTTON @"　　%LOCALS% ", ABRIV
	ENDIF
	RESETCOLOR
	SIF (++LOCAL:10) % 3 == 0
		PRINTFORML 
ENDIF
NEXT
PRINTL

@NAS_SALES_INPUT(nInput)
#DIM nInput
#DIM 候補個数
SELECTCASE nInput
	CASE 999
		RETURN -1
	CASE 1000
		IF (NAS_SALES:6) > 1
			CLEARLINE 2
			;GOTO SET_SALE
		ELSE
			CLEARLINE 1
			RETURN
		ENDIF
		;★売れるアイテムを下のCASEに追加
		;CASE 351 TO 398, 500 TO 512, 600, 611, 616, 626 TO 629, 700 TO 708, 497 ;addition custom code 497 - Hina Doll
	CASE IS < 2000
		;GoodsIDに売りに出すアイテムの番号を流し込む
		PlayerItemsSelling:(NAS_SALES:6):0 = RESULT
		;アイテム名が無名の場合、アイテムを所持してない場合、永遠亭での薬品販売はやり直し
		IF ITEMNAME:(PlayerItemsSelling:(NAS_SALES:6):0) == "" || ITEM:(PlayerItemsSelling:(NAS_SALES:6):0) <= 0  || (STALL_SPOT(CFLAG:MASTER:現在位置) == 5 && INRANGE(LOCAL, 501, 516))
			CLEARLINE 1
			PlayerItemsSelling:(NAS_SALES:6):0 = 0
			RETURN
		ENDIF
		;重複選択防止
		IF (NAS_SALES:6) > 1
			FOR LOCAL, 1, (NAS_SALES:6)
			IF PlayerItemsSelling:(NAS_SALES:6):0 == PlayerItemsSelling:LOCAL:0
				CLEARLINE 1
				PlayerItemsSelling:(NAS_SALES:6):0 = 0
				RETURN
			ENDIF
			NEXT
		ENDIF
		候補個数 = ITEM:(PlayerItemsSelling:(NAS_SALES:6):0)
		SETCOLOR 0x777777
		PRINTFORML 　판매할 %ITEMNAME_TR(PlayerItemsSelling:(NAS_SALES:6):0)%의 개수를 선택하세요. (1～{候補個数}을 입력하거나, 취소하려면 0을 입력하세요.)
		RESETCOLOR
		PRINTL   
		PRINTBUTTON "[0] 멈춰라", 0
		PRINT     
		PRINTBUTTON "[1] 1", 1
		PRINT     
		IF 候補個数 >= 5
			PRINTBUTTON "[5] 5", 5
			PRINT     
		ENDIF
		IF 候補個数 >= 10
			PRINTBUTTON "[10] 10", 10
			PRINT    
		ENDIF
		IF 候補個数 >= 20
			PRINTBUTTON "[20] 20", 20
			PRINT    
		ENDIF
		IF 候補個数 >= 50
			PRINTBUTTON "[50] 50", 50
			PRINT    
		ENDIF
		IF 候補個数 >= 99
			PRINTBUTTON "[99] 99", 99
			PRINT    
		ENDIF
		IF 候補個数 > 1
			PRINTBUTTON @" [{候補個数}] 모두 재고 있음", 候補個数
		ENDIF
		;LinesToErase += 3
		$INPUT_LOOP02
		INPUT
		SELECTCASE RESULT
			CASE 0
				;CLEARLINE 3
				;LinesToErase -= 3
				PlayerItemsSelling:(NAS_SALES:6):0 = 0
				RETURN -1
			CASE 1 TO 候補個数
				;CLEARLINE (LinesToErase + 1)
				;GoodsQtyに売りに出す個数を流し込む
				PlayerItemsSelling:(NAS_SALES:6):1 = RESULT
			CASEELSE
				CLEARLINE 1
				GOTO INPUT_LOOP02
		ENDSELECT
	CASE IS >= 600000000000000000
		;NAS custom code: weapons
		;GoodsIDに売りに出すアイテムの番号を流し込む
		PlayerItemsSelling:(NAS_SALES:6):0 = RESULT
		;アイテム名が無名の場合、アイテムを所持してない場合、永遠亭での薬品販売はやり直し
		IF DT_CELL_GET(@"WeaponInventory",PlayerItemsSelling:(NAS_SALES:6):0, "def", 1) == 0
			CLEARLINE 1
			PlayerItemsSelling:(NAS_SALES:6):0 = 0
			RETURN
		ENDIF
		;重複選択防止
		IF (NAS_SALES:6) > 1
			FOR LOCAL, 1, (NAS_SALES:6)
			IF PlayerItemsSelling:(NAS_SALES:6):0 == PlayerItemsSelling:LOCAL:0
				CLEARLINE 1
				PlayerItemsSelling:(NAS_SALES:6):0 = 0
				RETURN
			ENDIF
			NEXT
		ENDIF
		候補個数 = WeaponStackCount(0,PlayerItemsSelling:(NAS_SALES:6):0)
		SETCOLOR 0x777777
		PRINTFORML 　판매할 %PrintWeaponName(,PlayerItemsSelling:(NAS_SALES:6):0,1)%의 개수를 선택하시오. (1～{候補個数}을 입력, 0은 취소)
		RESETCOLOR
		PRINTL   
		PRINTBUTTON "[0] 정지", 0
		PRINT     
		PRINTBUTTON "[1] 1", 1
		PRINT     
		IF 候補個数 >= 5
			PRINTBUTTON "[5] 5", 5
			PRINT     
		ENDIF
		IF 候補個数 >= 10
			PRINTBUTTON "[10] 10", 10
			PRINT    
		ENDIF
		IF 候補個数 >= 20
			PRINTBUTTON "[20] 20", 20
			PRINT    
		ENDIF
		IF 候補個数 >= 50
			PRINTBUTTON "[50] 50", 50
			PRINT    
		ENDIF
		IF 候補個数 >= 99
			PRINTBUTTON "[99] 99", 99
			PRINT    
		ENDIF
		IF 候補個数 > 1
			PRINTBUTTON @" [{候補個数}] 모두 재고 있음", 候補個数
		ENDIF
		$INPUT_LOOP02_WEAP
		INPUT
		SELECTCASE RESULT
			CASE 0
				;CLEARLINE 3
				;LinesToErase -= 3
				PlayerItemsSelling:(NAS_SALES:6):0 = 0
				PlayerItemsSelling:(NAS_SALES:6):1 = 0
				RETURN -1
			CASE 1 TO 候補個数
				;CLEARLINE (LinesToErase + 1)
				;GoodsQtyに売りに出す個数を流し込む
				PlayerItemsSelling:(NAS_SALES:6):1 = RESULT
			CASEELSE
				CLEARLINE 1
				GOTO INPUT_LOOP02_WEAP
		ENDSELECT
	CASE IS > 100000
		;CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:((ARG:1-100000)/1000)), (ARG:1)-(ARG:1/1000*1000), MASTER
		;NAS custom code: clothes
