; Modular ERB: OMOGATARI/COM/COMF447 Set Up A Stall.ERB
;露店を開く

@NAS_SALES
#DIM CHARA
#DIM LinesToErase
;売却アイテムの種類を増やすときは、★  を検索してください
;管理者がはっきりしている人の敷地での無断での商売はしない
IF STALL_PERMISSION(CFLAG:MASTER:現在位置)
	;DRAWLINE
	;PRINTFORML It's a bit difficult operating without permission... Might be best to get closer to the local boss.
	;RETURN -1
	PRINTFORML 여기서 노점을 열 수는 있지만, %CALLNAME:(STALL_PERMISSION(CFLAG:MASTER:現在位置))%는 그걸 별로 좋아하지 않을 것이다...
	PRINTFORML 지역 보스에게 좀 더 가까이 가는 게 좋을지도 모른다.
ENDIF
;NAS_SALES = 来客数
;商人パワー = 0
NAS_SALES:1 = 0
;商人パワーM = 0
NAS_SALES:2 = 0
;商人パワーT = 0
NAS_SALES:3 = 0
;売却値 = 0
NAS_SALES:4 = 0
;合計売却値 = 0
NAS_SALES:5 = 0
;Lineup = 0
NAS_SALES:6 = 0
VARSET LOCAL
;0 = item ID
;1 = quantity
;2 = sold
VARSET PlayerItemsSelling
DRAWLINE
PRINTL 
CALL QoL_Stall("SetUp", CHARA, NAS_SALES:1) ;qol custom code
;来客数を算出し、にぎわいを可視化
NAS_SALES = STALL_SHOPPER(STALL_SPOT(CFLAG:MASTER:現在位置)) + IN_ROOM_NUMBER(CFLAG:MASTER:現在位置)
;PRINTFORML {来客数}人
IF AT_HOME()
	PRINTFORML %CAPITALIZE(NAME_FROM_PLACE(CFLAG:MASTER:現在位置))%.
ELSE
	PRINTFORML %CAPITALIZE(DATENAME_SPOT())%.
ENDIF
SELECTCASE NAS_SALES
	CASE IS <= 0 ;qol custom code, failsafe
		PRINTFORML 완전히 버려져 있다...
	CASE 1 TO 5
		PRINTFORML 대부분 조용하다...
	CASE 6 TO 10
		PRINTFORML 교통 체증이 심하지 않다.
	CASE 11 TO 20
		PRINTFORML 번영의 조짐들이 있다.
	CASE 21 TO 30
		PRINTFORML 정말 사람이 많다!
	CASEELSE
		PRINTFORML 가득 차 있다!
ENDSELECT
CALL QoL_Stall("Place", CHARA, NAS_SALES:1) ;qol custom code
PRINTL 
PRINTFORML 자, 그럼 뭘 팔까...
CALL QoL_Stall("Estimate", CHARA, NAS_SALES:1) ;qol custom code
DRAWLINE
;１個目のアイテムからスタート
NAS_SALES:6 = 1
;custom code
LinesToErase = LINECOUNT
REDRAW 0
DO
;LinesToErase は消去行数の計算に利用
SIF LINECOUNT - LinesToErase > 0
	CLEARLINE LINECOUNT - LinesToErase
CALL NAS_SALES_CONFIG(CHARA)
SELECTCASE RESULT
	CASE 9998
		CALL NAS_SALE(CHARA)
		RETURN RESULT
	CASE 9999
		RETURN 1
ENDSELECT
LOOP 1

@NAS_SALES_CONFIG(CHARA)
#DIM     PAGE       ;表示中のページ
;#DIMS CONST DISP_NAME = "ITEMS", "WEAPONS", "BIONICS", "ORGANS", "WORN_UNDERWEAR", "CLOTHES"
#DIMS CONST DISP_NAME = "ITEMS", "WEAPONS", "BIONICS", "ORGANS", "CLOTHES"
;#DIMS CONST DISP_NAME = "ITEMS", "WEAPONS"
#DIM CREDRAW
#DIM FIRST_LINE
#DIM CHARA
#DIM clothingPage
;clothingPage = 1
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
RESETCOLOR
DRAWLINE
;IF PAGE == 5
IF PAGE == 4
	TRYCALLFORM NAS_SALES_%DISP_NAME:PAGE%(CHARA,clothingPage)
ELSE
	TRYCALLFORM NAS_SALES_%DISP_NAME:PAGE%(CHARA)
ENDIF
DRAWLINE
FOR LOCAL, 0, VARSIZE("DISP_NAME")
SIF PAGE == LOCAL
	SETCOLOR 0x00FFFF
PRINTBUTTON CAP_PROCESS(TOLOWER(REPLACE(DISP_NAME:LOCAL,"_"," ")),5), LOCAL + 8002
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTFORML
DRAWLINE
PRINTL 　　[9999] 가판대 설치를 중단한다.
;LinesToErase += 3
IF NAS_SALES:6 > 1
	PRINTL 　　[9998] 이 상품으로 좌판을 마련한다
	DRAWLINE
	FOR LOCAL:6,1,100
	SIF !PlayerItemsSelling:(LOCAL:6):0
		CONTINUE
	IF PlayerItemsSelling:(LOCAL:6):0 > 600000000000000000
		LOCALS '= PrintWeaponName(,PlayerItemsSelling:(LOCAL:6):0,1)
	ELSEIF PlayerItemsSelling:(LOCAL:6):0 > 100000
		LOCALS = %CLOTHNAME(((PlayerItemsSelling:(LOCAL:6):0-100000)/1000), (PlayerItemsSelling:(LOCAL:6):0)-(PlayerItemsSelling:(LOCAL:6):0/1000*1000))%
	ELSEIF PlayerItemsSelling:(LOCAL:6):0 > 5000
		LOCALS = %GET_STR(MASTER, "Hediff", PlayerItemsSelling:(LOCAL:6):0-5000, "名前")%
	ELSEIF PlayerItemsSelling:(LOCAL:6):0 > 4000
		LOCALS = %BDY_PART_NAME(PlayerItemsSelling:(LOCAL:6):0-4000)%
	ELSE
		LOCALS = %ITEMNAME_TR(PlayerItemsSelling:(LOCAL:6):0)%
	ENDIF
	PRINTFORML 아이템 번호{LOCAL:6}: %LOCALS%×{PlayerItemsSelling:(LOCAL:6):1}
	NEXT
	DRAWLINE
	;LinesToErase += 3 + (Lineup - 1)
ENDIF
PRINTL
PRINTFORML 판매할 아이템 번호 {NAS_SALES:6}을 선택해 주세요.
DO
INPUT
SELECTCASE RESULT
	CASE 8002 TO VARSIZE("DISP_NAME")+8002
		PAGE = RESULT-8002
	CASE 8030 TO VARSIZE("表示ラベル")+8030
		clothingPage = RESULT-8030
	CASE 9998
		RETURN 9998
	CASE 9999 ;custom code
		RETURN 9999
	CASEELSE
		$RETRY
		TRYCALLFORM NAS_SALES_INPUT(RESULT)
ENDSELECT
BREAK
LOOP 1

@NAS_SALES_HasItem(ARG)
#FUNCTION
FOR LOCAL, 1, 100
SIF ARG == PlayerItemsSelling:LOCAL:0
	RETURNF 1
NEXT
RETURNF 0

@NAS_SALES_SoldOut()
#FUNCTION
#DIM DYNAMIC sellOut
VARSET sellOut
FOR LOCAL, 1, 100
SIF !PlayerItemsSelling:LOCAL:0
	BREAK
SIF PlayerItemsSelling:LOCAL:1 == PlayerItemsSelling:LOCAL:2
	sellOut ++
NEXT
DEBUGPRINTFORML 품목 매진: {sellOut}/{NAS_SALES:6-1}
SIF sellOut >= NAS_SALES:6-1
	RETURNF 1
RETURNF 0

@NAS_SALES_ITEMS(CHARA)
#DIM CHARA
LOCAL:10 = 0
FOR LOCAL, 0, VARSIZE("ITEM")
SELECTCASE LOCAL
	;★売れるアイテムを下のCASEに追加
	;CASE 351 TO 398, 500 TO 512, 600, 611, 616, 626 TO 629, 700 TO 708, 497 ;addition custom code 497 - Hina Doll
	;CASE 0 TO 999
	;some items were never meant to be sold
	CASE 141
	CASE IS < 2000
		;GoodsIDに売りに出すアイテムの番号を流し込む
		;NAS custom code: handle blank items
		SIF !STRLENS(ITEMNAME_TR(LOCAL))
			CONTINUE
		IF ITEM:(LOCAL) > 0 || (STALL_SPOT(CFLAG:MASTER:現在位置) == 5 && INRANGE(LOCAL, 501, 515) && ITEM:(LOCAL) > 0) ;bug fix
			IF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 20
				LOCALS:1 '= @" (%PALAM_NUM_NAS(STALL_PRICE_SET(NAS_SALES:1, LOCAL, 1, 2), , 1)%)"
			ELSE
				LOCALS:1 '= ""
			ENDIF
			;Custom code, formatting printing
			IF STRLENS(ITEMNAME_TR(LOCAL)) > 30
				IF LOCAL:10 % 3 == 0 && LOCAL:10 % 3 != 0
					LOCAL:10 ++
					PRINTL
				ENDIF
				LOCALS = %ITEMNAME_TR(LOCAL), STRLENS(ITEMNAME_TR(LOCAL)), LEFT%
				;SIF LOCAL:10 % 4 != 0
				LOCAL:10 ++
			ELSE
				LOCALS = %ITEMNAME_TR(LOCAL), 40, LEFT%
			ENDIF
			LOCALS += LOCALS:1
			LOCALS += @"×{ITEM:(LOCAL), 3}"
			IF NAS_SALES_HasItem(LOCAL)
				SETCOLOR 0x666666
				PRINTPLAINFORM 　　%LOCALS% 
			ELSE
				CALL QoL_Stall("Guess",CHARA,NAS_SALES:1,LOCAL) ;qol custom code
				PRINTBUTTON @"　　%LOCALS% ", LOCAL
			ENDIF
			RESETCOLOR
			SIF (++LOCAL:10) % 3 == 0
				PRINTFORML 
		ENDIF
	CASEELSE
		CONTINUE
ENDSELECT
NEXT
SIF LOCAL:10 % 5
	PRINTFORML 
PRINTL 
;LinesToErase += 2

@NAS_SALES_WEAPONS(CHARA)
#DIM CHARA
#DIM NSW
#DIM NSW_COUNT
;所持しているアイテムの売却可能物・個数をリスト化
LOCAL:10 = 0
FOR LOCAL,0,DT_ROW_LENGTH("WeaponInventory")
;NAS custom code: weapons
NSW = DT_CELL_GET("WeaponInventory",LOCAL,"id")
NSW_COUNT = WeaponStackCount(0,NSW)
IF (VARSIZE("WeapPartStack")-1)-LOCAL == FINDELEMENT(WeapPartStack, 90)
ELSE
	CONTINUE
ENDIF
IF ABL:MASTER:話術技能 + ABL:MASTER:教養 > 20
	LOCALS:1 '= @" (%PALAM_NUM_NAS(STALL_PRICE_SET(NAS_SALES:1, NSW, 1, 2), , 1)%)"
ELSE
	LOCALS:1 '= ""
ENDIF
;Custom code, formatting printing
IF STRLENS(PrintWeaponName(0,NSW,1)) > 25
	IF LOCAL:10 % 3 == 0 && LOCAL:10 % 4 != 0
		LOCAL:10 ++
		PRINTL
	ENDIF
	LOCALS '= WeaponInventoryName(,NSW,-2,1)
	;SIF LOCAL:10 % 4 != 0
	LOCAL:10 ++
ELSE
	LOCALS '= WeaponInventoryName(,NSW,-1,1)
ENDIF
LOCALS += LOCALS:1
IF NAS_SALES_HasItem(NSW)
	SETCOLOR 0x666666
	PRINTPLAINFORM 　　%LOCALS% 
ELSE
	CALL QoL_Stall("Guess",CHARA,NAS_SALES:1,NSW) ;qol custom code
	PRINTBUTTON @"　　%LOCALS% ", NSW
ENDIF
RESETCOLOR
SIF (++LOCAL:10) % 4 == 0
	PRINTFORML 
NEXT
SIF LOCAL:10 % 5
	PRINTFORML 
PRINTL 

