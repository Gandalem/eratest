;体力・気力減少は来客数によって増減
DOWNBASE:MASTER:体力 = MAX(15 * NAS_SALES, 150)
DOWNBASE:MASTER:気力 = MAX(20 * NAS_SALES, 200)
;参加者のソース,同一コマンド制限を受けないので控えめに,売れないと激減
IF CHARA != MASTER
	;固定で獲得するソース
	SOURCE:CHARA:歓楽 = 300
	SOURCE:CHARA:情愛 = 50
	;ABL:従順をみる
	IF ABL:従順 <= 1
		SOURCE:CHARA:歓楽 += (ABL:従順 * 30)
		SOURCE:CHARA:情愛 += (ABL:親密 * 15)
	ELSEIF ABL:従順 <= 3
		SOURCE:CHARA:歓楽 += 200 + (ABL:従順 * 20)
		SOURCE:CHARA:情愛 += 50 + (ABL:親密 * 15)
	ELSEIF ABL:従順 <= 5
		SOURCE:CHARA:歓楽 += 500 + (ABL:従順 * 20)
		SOURCE:CHARA:情愛 += 200 + (ABL:親密 * 15)
	ELSEIF ABL:従順 <= 8
		SOURCE:CHARA:歓楽 += 750 + (ABL:従順 * 30)
		SOURCE:CHARA:情愛 += 300 + (ABL:親密 * 20)
	ELSEIF ABL:従順 <= 11
		SOURCE:CHARA:歓楽 += 1000 + (ABL:従順 * 30)
		SOURCE:CHARA:情愛 += 600 + (ABL:親密 * 20)
	ELSE
		SOURCE:CHARA:歓楽 += 1600 + (ABL:従順 * 15)
		SOURCE:CHARA:情愛 += 1000 + (ABL:親密 * 10)
	ENDIF
	SIF CHARA != FLAG:デート相手
		SOURCE:CHARA:情愛 = 0
	;好感度はみない
	SOURCE:CHARA:受動 = 200 + 100 * ABL:従順
	SOURCE:CHARA:征服 = 200 + 100 * ABL:サドっ気
	;売却成果をみる、合計売却値に応じてとりあえず設定
	IF 合計売却値
		SELECTCASE 合計売却値
			CASE 1 TO 2000
				TIMES SOURCE:CHARA:歓楽 , 1.00
				TIMES SOURCE:CHARA:受動 , 1.00
				TIMES SOURCE:CHARA:征服 , 1.00
				SOURCE:CHARA:達成 = 80
			CASE 2001 TO 4000
				TIMES SOURCE:CHARA:歓楽 , 1.10
				TIMES SOURCE:CHARA:受動 , 1.10
				TIMES SOURCE:CHARA:征服 , 1.10
				SOURCE:CHARA:達成 = 115
			CASE 4001 TO 7000
				TIMES SOURCE:CHARA:歓楽 , 1.25
				TIMES SOURCE:CHARA:受動 , 1.25
				TIMES SOURCE:CHARA:征服 , 1.15
				SOURCE:CHARA:達成 = 125
			CASE 7001 TO 10000
				TIMES SOURCE:CHARA:歓楽 , 1.50
				TIMES SOURCE:CHARA:受動 , 1.50
				TIMES SOURCE:CHARA:征服 , 1.25
				SOURCE:CHARA:達成 = 150
			CASE 10001 TO 20000
				TIMES SOURCE:CHARA:歓楽 , 1.75
				TIMES SOURCE:CHARA:受動 , 1.75
				TIMES SOURCE:CHARA:征服 , 1.50
				SOURCE:CHARA:達成 = 200
			CASE 20001 TO 40000
				TIMES SOURCE:CHARA:歓楽 , 2.00
				TIMES SOURCE:CHARA:受動 , 2.00
				TIMES SOURCE:CHARA:征服 , 1.75
				SOURCE:CHARA:達成 = 300
			CASEELSE
				TIMES SOURCE:CHARA:歓楽 , 2.25
				TIMES SOURCE:CHARA:受動 , 2.25
				TIMES SOURCE:CHARA:征服 , 2.00
				SOURCE:CHARA:達成 = 350
		ENDSELECT
		;売れなかった
	ELSE
		TIMES SOURCE:CHARA:歓楽 , 0.20
		TIMES SOURCE:CHARA:受動 , 0.20
		TIMES SOURCE:CHARA:征服 , 0.20
	ENDIF
ENDIF
RETURN 1
;-----------------------------------------------------------
;現在位置が露店を開ける場所か判定する
;ARG		現在位置
;RETURN		0 該当なし	1～各露店地点を返す
;COMMENT	場所を追加した場合、CASEを変更の事
;-----------------------------------------------------------

@STALL_SPOT_NAS(ARG)
#FUNCTION
IF !IN_HOME(ARG)
	;サブマップなどでの判定
	SELECTCASE ARG
		CASE 20				;神社境内（博麗神社）
			RETURNF 1
		CASE 130			;命蓮寺境内
			RETURNF 2
		CASE 210			;広場（人里）
			RETURNF 3
		CASE 310			;霧の湖
			RETURNF 4
		CASE 450			;永遠亭
			RETURNF 5
		CASE 510			;森の入り口
			RETURNF 6
		CASE 610			;中有の道
			RETURNF 7
		CASE 720			;玄武の沢
			RETURNF 8
		CASE 820			;絶景の丘
			RETURNF 9
		CASE 840			;守矢神社境内
			RETURNF 10
		CASE 890			;天界
			RETURNF 11
		CASE 930			;旧地獄街道
			RETURNF 12
		CASE 1050			;月の都
			RETURNF 13
	ENDSELECT
ELSE
	;メインマップでの判定
	SELECTCASE MAIN_MAP
		CASE 0
			;博麗神社：境内
			SIF ARG == 2
				RETURNF 1
		CASE 1
			;命蓮寺：境内
			SIF ARG == 102
				RETURNF 2
		CASE 2
			;人里：中央広場
			SIF ARG == 202
				RETURNF 3
		CASE 3
			;紅魔館：湖畔
			SIF ARG == 343
				RETURNF 4
		CASE 4
			;永遠亭：永遠亭入り口
			SIF ARG == 401
				RETURNF 5
		CASE 5
			;魔法の森：魔法の広場
			SIF ARG == 508
				RETURNF 6
		CASE 6
			;冥界：中有の道
			SIF ARG == 601
				RETURNF 7
		CASE 7
			;妖怪の山山麓：玄武の沢
			SIF ARG == 703
				RETURNF 8
		CASE 8
			;妖怪の山山頂：頂上、守矢神社・境内、有頂天街
			SELECTCASE ARG
				CASE 805
					RETURNF 9
				CASE 811
					RETURNF 10
				CASE 832
					RETURNF 11
			ENDSELECT
		CASE 9
			;地底：大通り
			SIF ARG == 931
				RETURNF 12
		CASE PlayerLandID
			SIF GETBIT(HOME_CUSTOM_ROOM(ARG),1)
				RETURNF 12
	ENDSELECT
ENDIF
RETURNF 0
;-----------------------------------------------------------
;現在位置で露店を開く際のざっくりした来客数を割り出す
;祝祭日、天気、時間でも補正をかける
;ARG		STALL_SPOTのRETURN値
;RETURN		来客数
;COMMENT	場所を追加した場合、CASEを変更の事
;-----------------------------------------------------------

@STALL_SHOPPER_NAS(ARG)
#FUNCTION
RANDOMIZE (DAY:0 + TIME:0)
SELECTCASE ARG
	CASE 1	;博麗神社  ケの来客は少なそう  祭日はドンと増える
		LOCAL:0 = RAND:5
		SIF FESTIVAL() == "例大祭"
			LOCAL:0 += MAX(RAND:50, 35)
		SIF GROUPMATCH(FESTIVAL(), "元日", "雛祭り", "七夕", "お盆", "風神「二百十日」", "十五夜", "収穫祭", "節分", "大晦日")
			LOCAL:0 += MAX(RAND:40, 25)
	CASE 2	;命蓮寺  人里に近いので
		LOCAL:0 = MAX(RAND:12, 2)
		SIF GROUPMATCH(FESTIVAL(), "元日", "お盆", "収穫祭", "大晦日")
			LOCAL:0 += MAX(RAND:35, 15)
	CASE 3	;人里  鉄板
		LOCAL:0 = MAX(RAND:35, 10)
		SIF IS_WEEKEND(DAY)
			LOCAL:0 += RAND:15
		SIF GROUPMATCH(FESTIVAL(), "元日", "ホワイトデー", "収穫祭", "バレンタインデー", "クリスマスイヴ", "クリスマス")
			LOCAL:0 += RAND:15
	CASE 4	;霧の湖湖畔  あんまり人通りは…
		LOCAL:0 = RAND:5
		SIF GROUPMATCH(FESTIVAL(), "ホワイトデー", "収穫祭", "ハロウィン", "バレンタインデー", "クリスマスイヴ", "クリスマス")
			LOCAL:0 += MAX(RAND:30, 15)
	CASE 5	;永遠亭入り口  医院なのでそれなりに
		LOCAL:0 = MAX(RAND:14, 3)
	CASE 6	;魔法の森  客は来るのか…？
		LOCAL:0 = RAND:5
		SIF GROUPMATCH(FESTIVAL(), "元日", "七夕", "お盆", "十五夜", "収穫祭", "大晦日")
			LOCAL:0 += MAX(RAND:30, 20)
	CASE 7	;中有の道  他にも露店が出てる設定なので
		LOCAL:0 = MAX(RAND:30, 7)
		SIF GROUPMATCH(FESTIVAL(), "お盆")
			LOCAL:0 += MAX(RAND:30, 20)
	CASE 8	;玄武の沢  商売人の河童たちの経済圏
		LOCAL:0 = MAX(RAND:25, 15)
		SIF IS_WEEKEND(DAY)
			LOCAL:0 += RAND:15
		SIF GROUPMATCH(FESTIVAL(), "元日", "収穫祭")
			LOCAL:0 += RAND:15
	CASE 9	;妖怪の山頂上  天狗の縄張り
		LOCAL:0 = MAX(RAND:20, 5)
		SIF IS_WEEKEND(DAY)
			LOCAL:0 += RAND:15
		SIF GROUPMATCH(FESTIVAL(), "元日", "風神「二百十日」", "収穫祭")
			LOCAL:0 += RAND:15
	CASE 10	;守矢神社  索道のおかげで少しマシになった？
		LOCAL:0 = MAX(RAND:10, 4)
		SIF GROUPMATCH(FESTIVAL(), "元日", "例大祭", "雛祭り", "七夕", "お盆", "風神「二百十日」", "十五夜", "収穫祭", "節分", "大晦日")
			LOCAL:0 += MAX(RAND:30, 20)
	CASE 11	;有頂天街  天人も買い物はするのか…
		LOCAL:0 = MAX(RAND:20, 2)
		SIF IS_WEEKEND(DAY)
			LOCAL:0 += RAND:15
		SIF GROUPMATCH(FESTIVAL(), "元日", "七夕", "十五夜", "収穫祭", "節分", "大晦日")
			LOCAL:0 += RAND:15
	CASE 12	;地底大通り  妖怪たちの吹き溜まり
		LOCAL:0 = MAX(RAND:35, 15)
		SIF GROUPMATCH(FESTIVAL(), "元日", "収穫祭")
			LOCAL:0 += RAND:15
	CASE 13	;月の都  月人の興味があるものって…
		LOCAL:0 = MAX(RAND:25, 2)
ENDSELECT
;時間補正　地底大通りと月の都は時間・天候補正をかけない
IF !GROUPMATCH(ARG, 12, 13)
	;時間補正
	SELECTCASE TIME:2
		CASE 1
			TIMES LOCAL:0, 0.3
		CASE 2
			TIMES LOCAL:0, 0.8
		CASE 3 TO 4
			;補正なし
		CASE 5
			TIMES LOCAL:0, 0.8
		CASE 6
			TIMES LOCAL:0, 0.5
		CASEELSE
			TIMES LOCAL:0, 0.2
	ENDSELECT
	;天候補正
	SELECTCASE TIME:5
		CASE 0 TO 3
			;補正なし
		CASE 4, 6, 7
			TIMES LOCAL:0, 0.4
		CASEELSE
			TIMES LOCAL:0, 0.1
	ENDSELECT
ENDIF
RETURNF LOCAL:0
;-----------------------------------------------------------
;現在位置で露店を開く際の親密許可判定をする
;ARG		現在位置
;RETURN		0 許可	1 不許可
;COMMENT	場所を追加した場合、CASEを変更の事
;-----------------------------------------------------------

@STALL_PERMISSION_NAS(ARG)
#FUNCTION
SIF !QOL_PERMISSION(ARG, "stall")
	RETURNF 1
IF !AT_HOME(MASTER)
	;サブマップなどでの判定
	SELECTCASE ARG
		CASE 20				;神社境内（博麗神社）
			SIF ABL:[[霊夢]]:親密 < 5
				RETURNF [[霊夢]]
		CASE 130			;命蓮寺境内
			SIF ABL:[[白蓮]]:親密 < 5
				RETURNF [[白蓮]]
		CASE 450			;永遠亭
			SIF ABL:[[永琳]]:親密 < 5 && ABL:[[輝夜]]:親密 < 5
				RETURNF [[永琳]]
		CASE 720			;玄武の沢
			SIF ABL:[[にとり]]:親密 < 5
				RETURNF [[にとり]]
		CASE 820			;絶景の丘
			SIF ABL:[[文]]:親密 < 5 && ABL:[[はたて]]:親密 < 5
				RETURNF [[文]]
		CASE 840			;守矢神社境内
			SIF ABL:[[早苗]]:親密 < 5 && ABL:[[神奈子]]:親密 < 5 && ABL:[[諏訪子]]:親密 < 5
				RETURNF [[神奈子]]
		CASE 890			;天界
			SIF ABL:[[天子]]:親密 < 5
				RETURNF [[天子]]
	ENDSELECT
ELSE
	;メインマップでの判定
	SELECTCASE MAIN_MAP
		CASE 0
			;博霊神社：境内
			SIF ARG == 2 && ABL:[[霊夢]]:親密 < 5
				RETURNF [[霊夢]]
		CASE 1
			;命蓮寺：境内
			SIF ARG == 102 && ABL:[[白蓮]]:親密 < 5
				RETURNF [[白蓮]]
		CASE 4
			;永遠亭：永遠亭入り口
			SIF ARG == 401 && (ABL:[[永琳]]:親密 < 5 && ABL:[[輝夜]]:親密 < 5)
				RETURNF [[永琳]]
		CASE 7
			;妖怪の山山麓：玄武の沢
			SIF ARG == 703 && ABL:[[にとり]]:親密 < 5
				RETURNF [[にとり]]
		CASE 8
			;妖怪の山山頂：頂上、守矢神社・境内、有頂天街
			SELECTCASE ARG
				CASE 805
					SIF ABL:[[文]]:親密 < 5 && ABL:[[はたて]]:親密 < 5
						RETURNF [[文]]
				CASE 811
					SIF ABL:[[早苗]]:親密 < 5 && ABL:[[神奈子]]:親密 < 5 && ABL:[[諏訪子]]:親密 < 5
						RETURNF [[神奈子]]
				CASE 832
					SIF ABL:[[天子]]:親密 < 5
						RETURNF [[天子]]
			ENDSELECT
	ENDSELECT
ENDIF
RETURNF 0
;-----------------------------------------------------------
;露店で１人の来客がいくらで買ったかを算出
;ARG:0		商人パワー
;ARG:1		売るアイテム番号
;ARG:2		売れた個数
;ARG:3		0 = 購入額を返す, 1=利率を返す　省略は0
;RETURN		購入額
;-----------------------------------------------------------

@STALL_PRICE_NAS(ARG:0, ARG:1, ARG:2, ARG:3 = 0)
#FUNCTION
#DIM 利率
#DIM 購入額
#DIM 補正価格
IF ARG:0 <= 0
	ARG:0 = 1
ENDIF
;利率をアイテム価格の（商人パワーの半分～商人パワー）％に設定
利率 = MAX(RAND:(ARG:0), (ARG:0 / 2))
;qol custom code, nonrand
SIF ARG:3 == 2
	利率 = ARG:0
;NAS Custom code
;weapons are nerfed to only sell for 1/10th it's research cost
IF ARG:1 > 600000000000000000
	補正価格 = weaponPrice(ARG:1,10)
ELSEIF ARG:1 > 100000
	補正価格 = ClothPrice(CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:((ARG:1-100000)/1000)), (ARG:1)-(ARG:1/1000*1000), MASTER)
ELSEIF ARG:1 > 4000
	補正価格 = organPrice(ARG:1-4000)
ELSE
	補正価格 = ITEMPRICE:(ARG:1) / 2
	;com custom code - double the price for low price items
	SIF ITEMPRICE:(ARG:1) < 1000
		補正価格 = ITEMPRICE:(ARG:1)*2
ENDIF
;補正価格の決定
SELECTCASE ARG:1
	;野菜たちは旬から遠いと価値が上がる
	CASE 351 TO 361
		SIF DAY:2 == 3
			TIMES 補正価格, 1.5
	CASE 362 TO 374
		SIF DAY:2 == 4
			TIMES 補正価格, 1.5
	CASE 375 TO 386
		SIF DAY:2 == 1
			TIMES 補正価格, 1.5
	CASE 387 TO 398
		SIF DAY:2 == 2
			TIMES 補正価格, 1.5
		;価格調整
	CASE 500
		補正価格 += 150
	CASE 600
		補正価格 += 350 ;com custom code
	CASE 611
		補正価格 += 245 ;com custom code
	CASE 616
		補正価格 += 200
	CASE 626
		補正価格 += 225 ;com custom code
	CASE 627
		補正価格 += 200
	CASE 628
		補正価格 += 50
	CASE 707
		補正価格 += 250
	CASE 708
		補正価格 += 350
		;addition custom code, bonus for Hina Doll during Hinamatsuri
	CASE 497
		SIF GROUPMATCH(FESTIVAL(), "雛祭り")
			TIMES 補正価格, 2
ENDSELECT
SIF FESTIVAL() != ""
	TIMES 補正価格, 1.5
;露店の場所による補正
SELECTCASE STALL_SPOT(CFLAG:MASTER:現在位置)
	CASE 1	;博麗神社
	CASE 2	;命蓮寺
	CASE 3	;人里  山の幸系統に補正
		SIF GROUPMATCH(ARG:1, 600, 611, 616, 626, 627, 628, 629, 707, 708)
			TIMES 補正価格, 1.3
		;addition custom code, bonus for Hina Doll at the village
		SIF GROUPMATCH(ARG:1, 497)
			TIMES 補正価格, 1.5
	CASE 4	;霧の湖湖畔
	CASE 5	;永遠亭入り口  にんじん
		SIF GROUPMATCH(ARG:1, 382) ;bug fix
			TIMES 補正価格, 2.0
	CASE 6	;魔法の森
	CASE 7	;中有の道
	CASE 8	;玄武の沢  きゅうり↑  おさかな↓
		SIF GROUPMATCH(ARG:1, 361) ;bug fix
			TIMES 補正価格, 2.5
		SIF GROUPMATCH(ARG:1, 707, 708)
			TIMES 補正価格, 0.5
	CASE 9	;妖怪の山頂上  おさかな
		SIF GROUPMATCH(ARG:1, 707, 708)
			TIMES 補正価格, 1.5
	CASE 10	;守矢神社
		;addition custom code, bonus for Hina Doll at the Moriya shrine
		SIF GROUPMATCH(ARG:1, 497)
			TIMES 補正価格, 1.5
	CASE 11	;有頂天街  山の幸系統
		SIF GROUPMATCH(ARG:1, 600, 611, 616, 626, 627, 628, 629, 707, 708)
			TIMES 補正価格, 1.3
	CASE 12	;地底大通り  野菜
		SIF INRANGE(ARG:1, 351, 398)
			TIMES 補正価格, 1.5
	CASE 13	;月の都  山の幸系統
		SIF GROUPMATCH(ARG:1, 600, 611, 616, 626, 627, 628, 629, 707, 708)
			TIMES 補正価格, 1.3
ENDSELECT
購入額 = 補正価格 * ARG:2 * 利率 / 100
;qol custom code
RESULT:1 = 利率
IF ARG:3 == 0 || ARG:3 == 2
	RETURNF 購入額
ELSE
	RETURNF 利率
ENDIF
