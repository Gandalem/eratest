@ADD_CUSTOM_COM479
CALL COM412
CALL COM_RESEARCH(CurrentFactionForResearch)
RETURN 1


@COM_RESEARCH(ARG)
CALL CHANGE_FACTION_EXP(MASTER,ARG,LEVEL_TO_RANK(ABL:MASTER:43))
CALL CONTRIBUTE_RESEARCH_PROJECT(ARG,RESEARCH_GROWING(MASTER))
RETURN 1

@ADD_CUSTOM_MESSAGE_COM479
PRINTFORML You did some research work.
PRINTFORMW It was pretty exhausting

@ADD_CUSTOM_COM_PRINT479
#DIM CONST COM_ID = 479
#DIM PRINT479_PROJECT
#DIM PRINT479_PROGRESS
#DIM PRINT479_MAX

PRINT479_PROJECT = CURRENT_RESEARCH_PROJECT_FACTION(CurrentFactionForResearch)
SIF !PRINT479_PROJECT
    RETURN 0

PRINT479_PROGRESS = DT_CELL_GET("ResearchProgress", PRINT479_PROJECT, "progress",1)
PRINT479_MAX = DT_CELL_GET("ResearchProject", RESEARCH_PROJECT_FROM_DEFNAME(FactionResearching:CurrentFactionForResearch), "baseCost", 1)

SETCOLOR Color_Gradient_PER(GETCONFIG("TEXT COLOR"),C_AQUA,GETPERCENT(PRINT479_PROGRESS,PRINT479_MAX))
PRINTFORMC Research ({PRINT479_PROGRESS,5}/{PRINT479_MAX,5,LEFT})[{Add_Custom_COM_To_Number(COM_ID),3}]
RESETCOLOR
RETURN 1

