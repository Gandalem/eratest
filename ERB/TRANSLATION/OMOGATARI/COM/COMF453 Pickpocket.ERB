; Modular ERB: OMOGATARI/COM/COMF453 Pickpocket.ERB
;-------------------------------------------------
;Pickpocket
;Loot dead or sleeping bodies
;-------------------------------------------------

@ADD_CUSTOM_COM453
#DIM 採集物
#DIM 採集パワー
#DIM 採集パワーM
#DIM 採集パワーT
#DIM 土地の恵み
#DIM CHARA
#DIM 採集位置
#DIM nResult
PRINTFORML %조사처리(CALLNAME:TARGET,"로")% 무엇을 하고 싶습니까?
CALL ASK_M("지갑 검색",!IsLooted:TARGET:0,"전체 검색",IsLooted:TARGET:0 != 2,"도살자",IsLooted:TARGET:0 != 3 && IsDead:TARGET:0 && nRyona >= 2 && TALENT:MASTER:SexKnow >= 5,"취소",1)
nResult = RESULT
SIF nResult == 3
	RETURN 0
NOSKIP ;addition custom code
REPEAT 5
REUSELASTLINE  Looting.%"." * COUNT%
TWAIT 150, 1
REND
LOCAL = LIMIT((ABL:TARGET:42*5000)+10000,0,100000)
PRINTFORML %PARSE("You loot")%은(는) \@ IsDead:TARGET:0 ? 시체로 # 인지하지 못하는 \@%CALLNAME:TARGET%\@ FLAG:70 ? %" while time is stopped"% # 이다 \@.
IF !IsLooted:TARGET:0
	IF TARGET == 126
		CALL LOST_MONEY_YEN(RAND(LOCAL), 2)
	ELSEIF TALENT:TARGET:幼稚
		PRINTFORMW %조사처리(CALLNAME:TARGET,"가")% 「유치」하기 때문에 돈을 얻지 못했다...
	ELSE
		CALL GET_MONEY_YEN(RAND(LOCAL), 2)
	ENDIF
	IsLooted:TARGET:0 = 1
ENDIF
IF !nResult
	PRINTFORML 더 많은 전리품을 위해 옷을 벗는다?
	CALL ASK_YN()
ENDIF
IF (!RESULT || nResult) && IsLooted:TARGET:0 != 2
	CALL COLORMESSAGE(@"당신은 %조사처리(CALLNAME:TARGET,"의")% 옷을 벗기고 이것들을 소장함에 보관했다.", C_GREEN, 2)
	PRINTFORML 
	FOR LOCAL,1,25
	SIF !EQUIP:TARGET:LOCAL
		CONTINUE
	IF LOCAL == 24 && !GROUPMATCH(EQUIP:TARGET:LOCAL,0,1)
		;steal weapon
		CALL COLORMESSAGE(@"・%GET_STR(TARGET, "Weapon", EQUIP:TARGET:Weapon, "FullName")%", C_GREEN, 1, 1)
		CALLF CREATE_WEAPON_FROM_CHARA(TARGET)
	ELSEIF LOCAL == 6
		IF IsPadded(,"diaper",EQUIP:TARGET:6) || IsPadded(,"pull-up",EQUIP:TARGET:6) || GROUPMATCH(EQUIP:TARGET:6, 13, 14, 15, 16, 17, 18, 22, 23, 24, 25, 26)
			CALL COLORMESSAGE(@"・%undies_name_with_brand(TARGET,EQUIP:TARGET:LOCAL,1)%",C_PINK,1,1)
		ELSE
			PRINTFORML ・%undies_name_with_brand(TARGET,EQUIP:TARGET:LOCAL,1)%
		ENDIF
		BoughtClothing:LOCAL:(EQUIP:TARGET:LOCAL)++
	ELSE
		BoughtClothing:LOCAL:(EQUIP:TARGET:LOCAL)++
		PRINTFORML ・%undies_name_with_brand(TARGET,EQUIP:TARGET:LOCAL,1,LOCAL)%	
	ENDIF
	NEXT
	CALL 脱衣処理(TARGET, "全裸")
	HasClothes:TARGET = 1
	EQUIP:TARGET:Weapon = 0
	IsLooted:TARGET:0 = 2
	;give the respective score
	LOCAL = -1
	LOCAL = 楽譜入手_演奏大成功(TARGET)
	SIF (LOCAL == -1) && (TFLAG:193 != -1)
		RESULT = 楽譜入手_ランダム()
	CALL CLOTHES_SETTING_TRAIN(TARGET)
	IF FLAG:70
		BASE:MASTER:TSP -= 50
	ELSE
		TIME += 3
	ENDIF
ENDIF
;foraging stolen
$TREASURSARCH
CALL Loot_Drawing(TARGET,1000)
採集物 = RESULT:0
TFLAG:194 = RESULT:1
VARSET RESULT
;試行回数を１回増やす
LOCAL:4 ++
;採集物が気に入らない場合は引き直し
IF 採集物 != 0
	IF !FLAG:採集再抽選
		CLEARLINE 3
	ELSE
		PRINTFORM %PARSE("You find")%
		SETCOLOR 0x00FF00
		PRINTFORM  %ITEMNAME_TR(採集物)%
		RESETCOLOR
		PRINTFORML 그것을 채집할까요? (현재 소지품에 {ITEM:(採集物)}이 있음)
		CALL ASK_YN("채집한다","계속 찾아라")
		IF !RESULT
			CLEARLINE 4
		ELSE
			CLEARLINE 4
			採集物 = 0
			TFLAG:194 = 0
			REPEAT 5
			REUSELASTLINE  Gathering\@ CHARA ? %" "%with %CALLNAME:CHARA% #  \@.%"." * COUNT%
			TWAIT 150, 1
			REND
		ENDIF
	ENDIF
ELSE
	PRINTFORML %PARSE("You find")%아무것도 없다...
ENDIF
;試行回数３回以下で採集物が確保されていない場合はループ
SIF LOCAL:4 <= 3 && 採集物 == 0
	GOTO TREASURSARCH
;アイテム入手処理 99個以上にならないようにする
IF 採集物 != 0
	LOCALS = %ITEMNAME:採集物%
	CALL GET_ITEM(LOCALS, TFLAG:194 , 2)
ENDIF
;end of recyled code
IF nResult < 2 && IsDead:TARGET:0 && nRyona >= 2 && TALENT:MASTER:SexKnow >= 5
	PRINTFORML 도살자의 시체를 더 많은 전리품을 위해?
	CALL ASK_YN()
ENDIF
IF (!RESULT || nResult == 2) && IsLooted:TARGET:0 != 3 && IsDead:TARGET:0 && nRyona >= 2 && TALENT:MASTER:SexKnow >= 5
	IF CHECK_CHARA(TARGET, "神霊")
		LOCALS = GodMeat
	ELSEIF CHECK_CHARA(TARGET, "蓬莱人")
		LOCALS = HouraiMeat
	ELSEIF CHECK_CHARA(TARGET, "幽霊")
		LOCALS = GhostMeat
	ELSEIF CHECK_CHARA(TARGET, "鬼")
		LOCALS = OniMeat
	ELSEIF CHECK_CHARA(TARGET, "天狗")
		LOCALS = TenguMeat
	ELSEIF CHECK_CHARA(TARGET, "付喪神")
		LOCALS = TsukumoMeat
	ELSEIF CHECK_CHARA(TARGET, "妖精")
		LOCALS = FairyMeat
	ELSEIF CHECK_CHARA(TARGET, "天人")
		LOCALS = CelestrialMeat
	ELSEIF CHECK_CHARA(TARGET, "仙人")
		LOCALS = HermitMeat
	ELSEIF CHECK_CHARA(TARGET, "妖怪")
		LOCALS = YoukaiMeat
	ELSE
		LOCALS = HumanMeat
	ENDIF
	CALL GET_ITEM(LOCALS, 8 , 2)
	CALLF BroadDamage(TARGET,"fullbody",1500,2,MASTER,"Butchering")
	CALLF BroadDamage(TARGET,"thorax",8000000,2,MASTER,"Butchering")
	IsLooted:TARGET:0 = 3
ENDIF
ENDNOSKIP ;addition custom code
IF !FLAG:70
	TIME += 1
ELSE
	BASE:MASTER:TSP -= 30
ENDIF
RETURN 1

@Loot_Drawing(採集位置, 採集パワー, Modification)
;RESULT:0	採集アイテム
;RESULT:1	採集量
#DIM 採集位置
#DIM 採集パワー
#DIM Chosen
#DIM QTY
#DIM Modification
#DIM start			;抽選開始値
#DIM end			;抽選終了値
#DIM difference		;加算or減算
Chosen = 0
QTY = 0
;採集物の選出
;ランダムで検索スタート位置をずらしたり、検索の向きを変えたりする
SELECTCASE RAND:5
	CASE 0
		start = 600 + RAND:40
		end = 707
		difference = 1
	CASE 1
		start = 706
		end = 599
		difference = -1
	CASE 2
		start = 640 - RAND:40
		end = 599
		difference = -1
	CASEELSE
		start = 600 + (5 * (RAND:9))
		end = 707
		difference = 1
ENDSELECT
FOR LOCAL:0, start, end, difference
;アイテムが無名でなく、出現条件を満たし、所有数上限でない
SIF ITEMNAME:(LOCAL:0) == ""
	CONTINUE
IF ITEM:(LOCAL:0) == 99
	DEBUGPRINTFORML 소지 한계로 %ITEMNAME:(LOCAL:0)%을 스킵한다.
	CONTINUE
ENDIF
IF GATHERING_PRODUCT(LOCAL:0, 採集位置) < 1
	DEBUGPRINTFORML 위치가 부적절하여 %ITEMNAME:(LOCAL:0)%을 건너뛴다.
	CONTINUE
ENDIF
LOCAL:5 = ITEMPRICE:(LOCAL:0) + 1000
;採集パワー＋補正値 が √アイテム費用+1000 を上回ったら入手
IF 採集パワー + Modification < SQRT(LOCAL:5)
	DEBUGPRINTFORML 채집 파워가 부족하여 %ITEMNAME:(LOCAL:0)%을 스킵합니다. 채집 파워 = {採集パワー} + {Modification} 대 {SQRT(LOCAL:5)}
	CONTINUE
ENDIF
DEBUGPRINTFORML %ITEMNAME:(LOCAL:0)%에 결정
Chosen = LOCAL:0
;価格10000を超える希少アイテムは１つしか手に入らない、それ以下の価格帯は採集パワーに応じて複数入手が可能に
SELECTCASE LOCAL:5
	CASE 0 TO 2000
		QTY = MAX((RAND:(SQRT(採集パワー)) - 1), 1)
	CASE 2001 TO 4000
		QTY = MAX((RAND:(SQRT(採集パワー)) - 2), 1)
	CASE 4001 TO 7000
		QTY = MAX((RAND:(SQRT(採集パワー)) - 3), 1)
	CASE 7001 TO 9999
		QTY = MAX((RAND:(SQRT(採集パワー)) - 4), 1)
	CASEELSE
		QTY = 1
ENDSELECT
BREAK
NEXT
RETURN Chosen, QTY

@ADD_CUSTOM_COM_ABLE453
; Do not allow during ufufu
SIF CFLAG:うふふ != 0
	RETURN 0
SIF !TFLAG:100
	RETURN 0
;you can't loot yourself, dumbass
SIF TARGET == MASTER
	RETURN 0
;or delusions
SIF TFLAG:妄想中
	RETURN 0
;Only allow if the character is dead, time is stopped, or the character is sleeping
SIF !IsDead:TARGET:0 && (!FLAG:70 || MAXBASE:TARGET:TSP) && !CFLAG:TARGET:睡眠
	RETURN 0
SIF IsLooted:TARGET:0 == 3
	RETURN 0
RETURN 1
