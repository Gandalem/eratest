; Modular ERB: OMOGATARI/COM/COMF144 Urinate.ERB
;-------------------------------------------------
;Urinate
;Portal command which replaces COM144
;Hard training command level: 2
;Flags required: Urination
;-------------------------------------------------

@COM144_NAS
#DIM Recipient
SIF IsSkip()
	RETURN -1
PRINTFORML 네가 오줌을 싸든지, 아니면 %조사처리(CALLNAME:TARGET,"가")% 하게 할 거냐?
CALL ASK_M("당신 자신", TCVAR:MASTER:利尿剤 || PeeHold:MASTER:2 <= -2 || PeeBarStage(MASTER) >= 2, CALLNAME:TARGET, TCVAR:TARGET:利尿剤 || PeeHold:TARGET:2 <= -2 || PeeBarStage(TARGET) >= 2, "취소", 1)
IF RESULT == 2
	DEBUG_Target = -1
	RETURN -1
ELSEIF RESULT == 0 ;drinking semen yourself
	DEBUG_Target = MASTER
	Recipient = TARGET
ELSE
	DEBUG_Target = TARGET
	Recipient = MASTER
ENDIF
PRINTFORML %CALLNAME:DEBUG_Target%에게 어떤 방식으로 소변을 보게 할까?
PRINTFORML [  0] - 바닥 위
SIF GETBIT(nPee, 1)
	PRINTFORML [  1] - In %HIS_HER(DEBUG_Target)+" "+PeeProtectType(DEBUG_Target,1)%
SIF GETBIT(nPee, 2)
	PRINTFORML [  2] [ 2] - 잔 안에
PRINTFORML [  3] - On \@ DEBUG_Target == MASTER ? %CALLNAME:TARGET% # 당신 \@
SIF GETBIT(nPee, 2)
	PRINTFORML [  4] - \@ DEBUG_Target == MASTER ? %CALLNAME:TARGET%에게 # 당신에게 \@ 마시게 한다
INPUT
TFLAG:144 = RESULT
;effects
SELECTCASE TFLAG:144
	CASE 0
		CALL OMORASHI_END(DEBUG_Target, 1,,1,-1)
	CASE 1
		CALL OMORASHI_END(DEBUG_Target, 1,,,-1)
	CASE 2
		IF TFLAG:PissCupConcentration
			TFLAG:PissCupConcentration = (TFLAG:PissCupConcentration+TCVAR:DEBUG_Target:PeeConcentration)/2
		ELSE
			TFLAG:PissCupConcentration = TCVAR:DEBUG_Target:PeeConcentration
		ENDIF
		TFLAG:PissCup += BASE:DEBUG_Target:尿意
		CALL OMORASHI_END(DEBUG_Target, 1,,1,-1,1)
	CASE 3
		FOR LOCAL, 0, 8
		STAIN:Recipient:LOCAL |= 256
		NEXT
		EXP:Recipient:GeneralPeeExp += BASE:DEBUG_Target:尿意/100
		CALL OMORASHI_END(DEBUG_Target, 1,,1,-1,1)
	CASE 4
		STAIN:Recipient:0 |= 256
		EXP:Recipient:GeneralPeeExp += BASE:DEBUG_Target:尿意/100
		TCVAR:Recipient:LiquidIntake += BASE:DEBUG_Target:尿意
		CALL OMORASHI_END(DEBUG_Target, 1,,1,-1,1)
ENDSELECT
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 200
ELSE
	DOWNBASE:DEBUG_Target:体力 -= 10
	DOWNBASE:DEBUG_Target:気力 -= 200
	SOURCE:DEBUG_Target:恐怖 = 200
	SOURCE:DEBUG_Target:露出 = 800
	SOURCE:DEBUG_Target:屈従 = 500
	SOURCE:DEBUG_Target:逸脱 = 700
	SOURCE:DEBUG_Target:反感 = 700
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:DEBUG_Target:鬱屈 += 700
	;場所によって逸脱のソースが上下
	;野外
	IF TEQUIP:野外プレイ
		TIMES SOURCE:DEBUG_Target:逸脱 , 2.50
		;鏡の前（羞恥プレイ）
	ELSEIF TEQUIP:羞恥プレイ
		TIMES SOURCE:DEBUG_Target:逸脱 , 1.50
		;風呂場
	ELSEIF TEQUIP:お風呂場プレイ
		TIMES SOURCE:DEBUG_Target:逸脱 , 0.50
	ENDIF
ENDIF
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;OMORASHI_END does the trick
;EXP:DEBUG_Target:放尿経験 += BASE:DEBUG_Target:尿意/100
;EXP:DEBUG_Target:GeneralPeeExp += BASE:DEBUG_Target:尿意/100
;BASE:DEBUG_Target:尿意 = 0
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF FLAG:70 == 1
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 2
	ENDIF
ELSE
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 2
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 2
	ENDIF
	;野外放尿で異常経験
	IF TEQUIP:野外プレイ && !GETBIT(CFLAG:3,6)
		EXP:異常経験 += 1
		SETBIT CFLAG:3,6
	ENDIF
ENDIF
RETURN 1

