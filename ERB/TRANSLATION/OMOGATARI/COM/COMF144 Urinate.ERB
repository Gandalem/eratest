SIF TALENT:C_ID:自己愛 < 0 || TALENT:C_ID:抵抗
	SOURCE:C_ID:鬱屈 += 400
RETURN 1

@Com_DrinkPee_COMORDER(ARG)
SKIPDISP ARG
PRINTL Urine Drinking
LOCAL:99 = 0
$START
A = 0
S = 0

;すべての命令に共通の要素を考慮
;(従順が高いと命令に従いやすいなど)
CALL COM_ORDER

;ABL:欲望
IF ABL:欲望
	SIF S
		PRINT  + 
	A += ABL:欲望 * 1
	PRINT Desire
	PRINTV 'LV,ABL:欲望,'(,ABL:欲望 * 1,')
	S = 1
ENDIF
;ABL:奉仕精神
IF ABL:奉仕精神
	SIF S
		PRINT  + 
	A += MIN(ABL:奉仕精神, 10) * 2
	PRINT Servitude
	PRINTV 'LV,ABL:奉仕精神,'(,MIN(ABL:奉仕精神, 10) * 2,')
	S = 1
ENDIF
;ABL:PeeDrinkAddict
IF ABL:PeeDrinkAddict
	SIF S
		PRINT  + 
	A += MIN(ABL:PeeDrinkAddict, 5) * 5
	PRINT Urine Addict
	PRINTV 'LV,ABL:PeeDrinkAddict,'(,MIN(ABL:PeeDrinkAddict, 5) * 5,')
	S = 1
ENDIF

IF MARK:快楽刻印
	SIF S
		PRINT  + 
	A += MARK:快楽刻印 * 1
	PRINT Pleasure Mark
	PRINTV 'LV,MARK:快楽刻印,'(,MARK:快楽刻印 * 1,')
	S = 1
ENDIF
;PALAM:欲情
IF GETPALAMLV(PALAM:欲情,5)
	IF PALAM:欲情 < 3000
		SIF S
			PRINT  - 
		A -= 50
		PRINT Insufficient Desire
		PRINTV '(,50,')
		S = 1
	ELSE
		SIF S
			PRINT  + 
		A += GETPALAMLV(PALAM:欲情,5) * 1
		PRINT Desire
		PRINTV 'LV,GETPALAMLV(PALAM:欲情,5),'(,GETPALAMLV(PALAM:欲情,5) * 1,')
		S = 1
	ENDIF
ENDIF
;恥じらい
IF TALENT:羞恥心 > 0
	PRINT  - 
	A -= 3
	PRINT Shy
	PRINTV '(,3,')
	S = 1
ENDIF
;汚臭鈍感
IF TALENT:汚臭耐性 > 0
	SIF S
		PRINT  + 
	A += 3
	PRINT Smell Resistant
	PRINTV '(,3,')
	S = 1
ENDIF
;献身的
IF TALENT:献身的
	SIF S
		PRINT  + 
	A += 6
	PRINT Devoted
	PRINTV '(,6,')
	S = 1
ENDIF
;快感の否定（淫乱、娼婦で無効）
IF TALENT:快感応答 < 0 && !TALENT:淫乱
	PRINT  - 
	A -= 1
	PRINT Denies Pleasure
	PRINTV '(,1,')
	S = 1
ENDIF
;男嫌い（恋慕、親愛で無効）
IF OTOKOGIRAI(TARGET)
	PRINT  - 
	A -= 12
	PRINT Man Hater
	PRINTV '(,12,')
	S = 1
ENDIF
;恋慕
IF TALENT:恋慕 && ASSIPLAY == 0
	SIF S
		PRINT  + 
	A += 5
	PRINT Love
	PRINTV '(,5,')
	S = 5
ENDIF
;親愛
IF TALENT:恋慕 > 1 && ASSIPLAY == 0
	SIF S
		PRINT  + 
	A += 5
	PRINT Deep Love
	PRINTV '(,5,')
	S = 5
ENDIF
IF CFLAG:負け犬
	SIF S
		PRINT  + 
	A += 20
	PRINT Loser
	PRINTV '(,20,')
	S = 1
ENDIF

Y = 10
Y = Y * (2 - TALENT:汚臭耐性) / 2
;汚れあり
IF Y
	PRINT  - 
	A -= Y
	PRINT Yucky
	;汚臭鈍感
	IF TALENT:汚臭耐性 > 0
		PRINT , Smell Resistant
	ELSEIF TALENT:汚臭耐性 < 0
		PRINT , Smell Sensitive
	ENDIF
	PRINTV '(,Y,')
	S = 1
ENDIF

;amount
IF ABL:PeeDrinkAddict < 3 && !TALENT:PeeDrinker
	PRINT  - 
	SELECTCASE TFLAG:PissCup
		CASE IS > 1000
			Y = 20
			PRINT Lots of urine
		CASE IS > 500
			Y = 10
			PRINT Cupfull of urine
		CASEELSE
			Y = 3
			PRINT Urine
	ENDSELECT
	A -= Y
	PRINTV '(,Y,')
	S = 1
ENDIF

;合計を表示(24以上で実行)
PRINT  = 
PRINTV A

V = 50
SIF A < V
	PRINT  < 
SIF A == V
	PRINT  = 
SIF A > V
	PRINT  > 
PRINT Required Value 
PRINTV V

WAIT
SKIPDISP 0
;実行できない
IF A < V
	IF ABL:PeeDrinkAddict < 3 && !TALENT:PeeDrinker
		PRINTFORML
		DRAWLINE
		IF TFLAG:PissCup > 500
			PRINTFORML Looks like this amount is a little too much for %CALLNAME:TARGET%...
			PRINTFORML Spill out some and try again?
			CALL ASK_YN
			IF !RESULT
				TFLAG:PissCup = 500
				GOTO START
			ENDIF
			LOCAL:99 = 1
		ELSEIF TFLAG:PissCup > 250
			PRINTFORML Looks like this amount is still a bit too much for %CALLNAME:TARGET%...
			PRINTFORML Spill out some and try again?
			CALL ASK_YN
			IF !RESULT
				TFLAG:PissCup = 250
				GOTO START
			ENDIF
			LOCAL:99 = 1
		ELSE
			IF LOCAL:99 == 1
				PRINTFORML You spill out so much, there's nothing left anymore, and %CALLNAME:TARGET% still doesn't want to drink it...
			ELSE
				PRINTFORML You offer just a little bit, and %CALLNAME:TARGET% still doesn't want to drink it...
			ENDIF
			PRINTFORML You give up for now.
		ENDIF
	ENDIF
	RETURN -1
ENDIF
RETURN 1