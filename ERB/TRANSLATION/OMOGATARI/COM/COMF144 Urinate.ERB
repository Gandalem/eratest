IF SHIRAHU(C_ID) && C_ID != MASTER
	CALL Com_DrinkPee_COMORDER
	SIF RESULT < 0
		RETURN -1
ENDIF
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
EXP:C_ID:GeneralPeeExp += TFLAG:PissCup/100
STAIN:C_ID:口 |= 256
; IF FLAG:時間停止 == 1
; 	CFLAG:口に精液 = 2
; ELSE
; 	CFLAG:口に精液 = 1
; ENDIF
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 50
ELSE
	DOWNBASE:C_ID:気力 += 100
ENDIF
IF C_ID == MASTER && !EventForce
	SELECTCASE ABL:MASTER:PeeDrinkAddict
		CASE 0
			PRINTFORML 소변을 너무 잘 처리하지 못해, 대부분 흘려버린다...
			TFLAG:PissCup = MULTIPLY(TFLAG:PissCup, 25)
		CASE 1
			PRINTFORML 소변을 제대로 처리하지 못해서 절반이나 흘려버린다...
			TFLAG:PissCup = MULTIPLY(TFLAG:PissCup, 50)
		CASE 2
			PRINTFORML 소변을 제대로 처리하지 못해, 일부가 흘러나온다...
			TFLAG:PissCup = MULTIPLY(TFLAG:PissCup, 75)
	ENDSELECT
ENDIF
SOURCE:C_ID:達成 = MULTIPLY(ABL:C_ID:マゾっ気*200, 100 + ABL:PLAYER:サドっ気*20)
SOURCE:C_ID:情愛 = MULTIPLY(ABL:C_ID:マゾっ気*200, 100 + ABL:PLAYER:サドっ気*20)
SOURCE:C_ID:情愛 += TFLAG:PissCup / 2
SOURCE:C_ID:性行動 = TFLAG:PissCup / 2
SOURCE:C_ID:達成 += TFLAG:PissCup / 2
SOURCE:C_ID:屈従 = TFLAG:PissCup * 2
SOURCE:C_ID:不潔 = (TFLAG:PissCup + 4)/5 * 10
SOURCE:C_ID:反感 = TFLAG:PissCup
IF C_ID != MASTER
	A = MASTER
ELSE
	A = TARGET
ENDIF
SIF ABL:PeeDrinkAddict >= 3
	SOURCE:C_ID:欲情 = (TFLAG:PissCup + 4)/5 * 100 + 150 * ABL:A:サドっ気
IF SHIRAHU(C_ID)
	SOURCE:C_ID:逸脱 = (TFLAG:PissCup + 4)/5 * 100
	;精液経験をみる
	SELECTCASE EXP:GeneralPeeExp
		CASE IS < 5
			TIMES SOURCE:C_ID:逸脱, 2.00
			TIMES SOURCE:C_ID:不潔, 3.00
			TIMES DOWNBASE:C_ID:気力, 4.00
		CASE IS < 20
			TIMES SOURCE:C_ID:逸脱, 1.50
			TIMES SOURCE:C_ID:不潔, 2.00
			TIMES DOWNBASE:C_ID:気力, 2.00
		CASE IS < 50
			TIMES SOURCE:C_ID:逸脱, 1.25
			TIMES SOURCE:C_ID:不潔, 1.50
			TIMES DOWNBASE:C_ID:気力, 1.50
		CASE IS < 100
			TIMES SOURCE:C_ID:逸脱, 1.00
			TIMES SOURCE:C_ID:不潔, 1.20
			TIMES DOWNBASE:C_ID:気力, 1.20
		CASE IS < 300
			TIMES SOURCE:C_ID:逸脱, 0.50
			TIMES SOURCE:C_ID:不潔, 1.00
		CASEELSE
			TIMES SOURCE:C_ID:逸脱, 0.50
			TIMES SOURCE:C_ID:不潔, 0.50
			TIMES DOWNBASE:C_ID:気力, 0.50
	ENDSELECT
	IF ABL:A:サドっ気 > 3 && C_ID == MASTER
		TIMES SOURCE:A:逸脱, 0.25
		TIMES SOURCE:A:不潔, 0
		SOURCE:A:強要 = (TFLAG:PissCup + 4)/5 * 500
		SOURCE:A:加虐 = (TFLAG:PissCup + 4)/5 * 500
	ENDIF
ENDIF
;ABL:PeeDrinkAddictをみる
SELECTCASE ABL:C_ID:PeeDrinkAddict
	CASE 0
		TIMES SOURCE:C_ID:欲情, 0.10
		TIMES SOURCE:C_ID:屈従, 0.50
	CASE 1
		TIMES SOURCE:C_ID:欲情, 1.00
		TIMES SOURCE:C_ID:屈従, 1.00
	CASE 2
		TIMES SOURCE:C_ID:欲情, 1.20
		TIMES SOURCE:C_ID:屈従, 1.30
	CASE 3
		TIMES SOURCE:C_ID:欲情, 1.40
		TIMES SOURCE:C_ID:屈従, 1.60
	CASE 4
		TIMES SOURCE:C_ID:欲情, 1.80
		TIMES SOURCE:C_ID:屈従, 2.00
	CASEELSE
		TIMES SOURCE:C_ID:欲情, 2.00
		TIMES SOURCE:C_ID:屈従, 3.00
ENDSELECT
;loves semen
IF TALENT:C_ID:PeeDrinker
	SOURCE:C_ID:快Ｍ += (TFLAG:PissCup * 10) / 2
	SOURCE:C_ID:不潔 = 0
	TIMES SOURCE:C_ID:達成 , 2.00
	TIMES SOURCE:C_ID:屈従 , 1.50
	TIMES SOURCE:C_ID:逸脱 , 0.10
ENDIF
; SIF SOURCE:屈従 > 10000
; 	SOURCE:屈従 = 10000
; SIF SOURCE:欲情 > 10000
; 	SOURCE:欲情 = 10000
;SIF SHIRAHU(TARGET)
;	TRYCALL QoL_Info_Write(TARGET, 7) ;qol custom code Qol_Dates_Semen
;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;抑圧、抵抗持ちには、抑鬱ソース追加
SIF TALENT:C_ID:自己愛 < 0 || TALENT:C_ID:抵抗
	SOURCE:C_ID:鬱屈 += 400
RETURN 1

@Com_DrinkPee_COMORDER(ARG)
SKIPDISP ARG
PRINTL 소변 마시기
LOCAL:99 = 0
$START
A = 0
S = 0
;すべての命令に共通の要素を考慮
;(従順が高いと命令に従いやすいなど)
CALL COM_ORDER
;ABL:欲望
IF ABL:欲望
	SIF S
		PRINT  + 
	A += ABL:欲望 * 1
	PRINT 욕정
	PRINTV 'LV,ABL:欲望,'(,ABL:欲望 * 1,')
	S = 1
ENDIF
;ABL:奉仕精神
IF ABL:奉仕精神
	SIF S
		PRINT  + 
	A += MIN(ABL:奉仕精神, 10) * 2
	PRINT 봉사정신
	PRINTV 'LV,ABL:奉仕精神,'(,MIN(ABL:奉仕精神, 10) * 2,')
	S = 1
ENDIF
;ABL:PeeDrinkAddict
IF ABL:PeeDrinkAddict
	SIF S
		PRINT  + 
	A += MIN(ABL:PeeDrinkAddict, 5) * 5
	PRINT 소변 중독자
	PRINTV 'LV,ABL:PeeDrinkAddict,'(,MIN(ABL:PeeDrinkAddict, 5) * 5,')
	S = 1
ENDIF
IF MARK:快楽刻印
	SIF S
		PRINT  + 
	A += MARK:快楽刻印 * 1
	PRINT 쾌락의 낙인
	PRINTV 'LV,MARK:快楽刻印,'(,MARK:快楽刻印 * 1,')
	S = 1
ENDIF
;PALAM:欲情
IF GETPALAMLV(PALAM:欲情,5)
	IF PALAM:欲情 < 3000
		SIF S
			PRINT  - 
		A -= 50
		PRINT 욕정이 부족합니다
		PRINTV '(,50,')
		S = 1
	ELSE
		SIF S
			PRINT  + 
		A += GETPALAMLV(PALAM:欲情,5) * 1
		PRINT 욕정
		PRINTV 'LV,GETPALAMLV(PALAM:欲情,5),'(,GETPALAMLV(PALAM:欲情,5) * 1,')
		S = 1
	ENDIF
ENDIF
;恥じらい
IF TALENT:羞恥心 > 0
	PRINT  - 
	A -= 3
	PRINT 수줍음
	PRINTV '(,3,')
	S = 1
ENDIF
;汚臭鈍感
IF TALENT:汚臭耐性 > 0
	SIF S
		PRINT  + 
	A += 3
	PRINT 악취 내성
	PRINTV '(,3,')
	S = 1
ENDIF
;献身的
IF TALENT:献身的
	SIF S
		PRINT  + 
	A += 6
	PRINT 헌신적
	PRINTV '(,6,')
	S = 1
ENDIF
;快感の否定（淫乱、娼婦で無効）
IF TALENT:快感応答 < 0 && !TALENT:淫乱
	PRINT  - 
	A -= 1
	PRINT 쾌감을 거부한다
	PRINTV '(,1,')
	S = 1
ENDIF
;男嫌い（恋慕、親愛で無効）
IF OTOKOGIRAI(TARGET)
	PRINT  - 
	A -= 12
	PRINT 남자 싫어하는 사람
	PRINTV '(,12,')
	S = 1
ENDIF
;恋慕
IF TALENT:恋慕 && ASSIPLAY == 0
	SIF S
		PRINT  + 
	A += 5
	PRINT 연모
	PRINTV '(,5,')
	S = 5
ENDIF
;親愛
IF TALENT:恋慕 > 1 && ASSIPLAY == 0
	SIF S
		PRINT  + 
	A += 5
	PRINT 깊은 연모
	PRINTV '(,5,')
	S = 5
ENDIF
IF CFLAG:負け犬
	SIF S
		PRINT  + 
	A += 20
	PRINT 패배자
	PRINTV '(,20,')
	S = 1
ENDIF
Y = 10
Y = Y * (2 - TALENT:汚臭耐性) / 2
;汚れあり
IF Y
	PRINT  - 
	A -= Y
	PRINT 역겹다
	;汚臭鈍感
	IF TALENT:汚臭耐性 > 0
		PRINT 악취 내성
	ELSEIF TALENT:汚臭耐性 < 0
		PRINT 악취에 민감함
	ENDIF
	PRINTV '(,Y,')
	S = 1
ENDIF
;amount
IF ABL:PeeDrinkAddict < 3 && !TALENT:PeeDrinker
	PRINT  - 
	SELECTCASE TFLAG:PissCup
		CASE IS > 1000
			Y = 20
			PRINT 많은 소변
		CASE IS > 500
			Y = 10
			PRINT 소변 한 잔 가득
		CASEELSE
			Y = 3
			PRINT 소변
	ENDSELECT
	A -= Y
	PRINTV '(,Y,')
	S = 1
ENDIF
;合計を表示(24以上で実行)
PRINT  =
PRINTV A
V = 50
SIF A < V
	PRINT  < 
SIF A == V
	PRINT  =
SIF A > V
	PRINT  > 
PRINT 필수 값 
PRINTV V
WAIT
SKIPDISP 0
;実行できない
IF A < V
	IF ABL:PeeDrinkAddict < 3 && !TALENT:PeeDrinker
		PRINTFORML
		DRAWLINE
		IF TFLAG:PissCup > 500
			PRINTFORML 이 양은 %조사처리(CALLNAME:TARGET,"에게")% 조금 너무 많은 것 같다...
			PRINTFORML 좀 흘리고 다시 시도해 볼까?
			CALL ASK_YN
			IF !RESULT
				TFLAG:PissCup = 500
				GOTO START
			ENDIF
			LOCAL:99 = 1
		ELSEIF TFLAG:PissCup > 250
			PRINTFORML 이 양은 아직 %CALLNAME:TARGET%에게는 조금 너무 많은 것 같다...
			PRINTFORML 좀 쏟아내고 다시 시도해 볼까?
			CALL ASK_YN
			IF !RESULT
				TFLAG:PissCup = 250
				GOTO START
			ENDIF
			LOCAL:99 = 1
		ELSE
			IF LOCAL:99 == 1
				PRINTFORML 너는 너무 많이 흘려서 이제 아무것도 남지 않았는데, %조사처리(CALLNAME:TARGET,"는")%(는) 여전히 그것을 마시고 싶어 하지 않는다...
			ELSE
				PRINTFORML 당신은 조금만 권하지만, %조사처리(CALLNAME:TARGET,"는")% 여전히 그것을 마시려 하지 않는다...
			ENDIF
			PRINTFORML 지금은 포기한다.
		ENDIF
	ENDIF
	RETURN -1
ENDIF
RETURN 1
