;-------------------------------------------------
;Ask for a Change
;You can ask for a change if your diaper's soiled.
;-------------------------------------------------
@ADD_CUSTOM_COM358
#DIM AFAC_COND,6
VARSET AFAC_COND
AFAC_COND:0 = CAN_ACCIDENT(MASTER,1) || CAN_ACCIDENT(MASTER,2)
AFAC_COND:1 = SoiledDiaper(MASTER,2,,15) || SoiledDiaper(MASTER,1,,33)
AFAC_COND:2 = TCVAR:MASTER:空腹時刻 - TIME:1 < 0
AFAC_COND:3 = PeeBarStage(MASTER) >= 2 || PooBarStage(MASTER) >= 2

PRINTFORML %CALLNAME:TARGET% asks you what's wrong.
{
	CALL ASK_M(
		@"Leave", 1,
		@"Ask for a change", AFAC_COND:1,
		@"Ask for a snack", AFAC_COND:2,
		@"\@ AFAC_COND:0 ? Ask to go potty # ????? \@", AFAC_COND:0 && AFAC_COND:3
	)
}
SIF RESULT == 0
	RETURN -1
TFLAG:144 = RESULT
TIME += 5

RETURN 1


@ADD_CUSTOM_MESSAGE_COM358
SELECTCASE TFLAG:144
CASE 1
	PRINTFORMDW You ask %CALLNAME:TARGET% for a change.
	CALL RandomUnderwearCheck(TARGET,2)
CASE 2
	PRINTFORMDW %CALLNAME:TARGET% gives you a snack.
	PRINTFORMDW It's quite filling.
	SOURCE:TARGET:歓楽 = (100 + ((ABL:TARGET:親密 + 好感度係数(TARGET)) * 50)) * 30
	SOURCE:TARGET:受動 = (60 + ((ABL:TARGET:従順 + 好感度係数(TARGET)) * 30)) * 30
	SOURCE:TARGET:征服 = (60 + (ABL:TARGET:サドっ気 * 10)) * 30
	;TARGETは自由行動処理で食事する
	TCVAR:MASTER:空腹時刻 = 1440 * DAY + TIME + 120
	CALL RECOVER(MASTER, 3 * 30, "体力", "Recover via meal")
	CALL RECOVER(MASTER, 3 * 30, "気力", "Recover via meal")
	TCVAR:MASTER:FoodIntake += (600)
	TFLAG:98 = 2
CASE 3
	PRINTFORMDW You ask %CALLNAME:TARGET% to take you to go potty.
	PRINTFORMDW %HE_SHE(TARGET,1)% takes you to a private location as %HE_SHE(TARGET)% puts down a potty chair and pulls down your %PeeProtectType(MASTER,1)%.
	CALL GoToilet(MASTER,PeeBarStage(MASTER) >= 2, PooBarStage(MASTER) >= 2,,,3)
ENDSELECT
RETURN 1

@ADD_CUSTOM_COM_ABLE358
; Do not allow during ufufu or time stop
SIF FLAG:70 == 1
	RETURN 0
SIF CFLAG:うふふ != 0
	RETURN 0        
SIF !TFLAG:100
	RETURN 0
SIF CFLAG:睡眠
	RETURN 0    
SIF TARGET == MASTER ; doesn't make sense to kick yourself out
    RETURN 0
;not cleaner nor carer
SIF !(TALENT:TARGET:Carer || TALENT:TARGET:掃除係 || TALENT:TARGET:197 == 3)
	RETURN 0

RETURN 1