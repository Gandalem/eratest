;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
;	BASE:MASTER:TSP -= 50
	BASE:MASTER:TSP -= 60
	SOURCE:快Ｂ = 150
	SOURCE:PLAYER:快Ｃ = 220
ELSE
	TIME += 5


	DOWNBASE:体力 += 10
	DOWNBASE:気力 += 100
	SOURCE:PLAYER:快Ｃ = 220
	;性技補正
	SOURCE:PLAYER:快Ｃ += MIN(ABL:胸 * 25,100)

	SOURCE:快Ｂ = 50
	SOURCE:情愛 = 150
	SOURCE:性行動 = 400
	SOURCE:達成 = 200
	SOURCE:屈従 = 1000
	SOURCE:逸脱 = 500
	SOURCE:反感 = 500

	;上のほうで計算した汚れデータ
	SOURCE:不潔 = Y*10 + 60


	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 600
ENDIF
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;奴隷のＢ⇔調教者のＰの汚れが移動
STAIN:5 |= STAIN:PLAYER:2
STAIN:PLAYER:2 |= STAIN:5
;-------------------------------------------------
;経験の処理
;-------------------------------------------------

;同性愛　レズなら戻り値1ゲイなら戻り値2
IF FLAG:70 == 1 || CFLAG:イタズラ
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 7
	ENDIF
ELSE
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 7
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 7
	ENDIF
	EXP:パイズリ経験 += 2
	;愛情経験
	SIF TALENT:恋慕 == 1 && ASSIPLAY == 0
		EXP:愛情経験 ++
ENDIF
RETURN 1

