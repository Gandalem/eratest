;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@ADD_CUSTOM_EQUIP_COM166(ARG)
CALL EQUIP_COM148
RETURN 1

@ADD_CUSTOM_MESSAGE_COM166
CALL MESSAGE_COM148
RETURN 1


;-------------------------------------------------
;実行判定
;-------------------------------------------------
@ADD_CUSTOM_COM_ABLE166
;アナル電極実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(148)
	RETURN RESULT
SIF PANTIES_LOCKED(TARGET)
	RETURN 0
;解除はいつでも可能
SIF TEQUIP:23
	RETURN 1
;アイテムを持っているか、アイテムなし設定でないとダメ
SIF ITEM:24 == 0 && NOITEM == 0
	RETURN 0
;アナルバイブ使用中は不可
SIF TEQUIP:14
	RETURN 0
;アナルビーズ使用中は不可
SIF TEQUIP:15
	RETURN 0
;普通の浣腸使用中は不可
SIF TEQUIP:21
	RETURN 0
;バルーン使用中は不可
SIF TEQUIP:22
	RETURN 0
;お風呂場プレイ中はダメ
SIF TEQUIP:31
	RETURN 0
RETURN 1

