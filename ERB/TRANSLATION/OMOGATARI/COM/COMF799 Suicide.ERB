; Modular ERB: OMOGATARI/COM/COMF799 Suicide.ERB
;-------------------------------------------------
;Commit Suicide
;This forces the day to end by depleting all stamina if used
;-------------------------------------------------

@ADD_CUSTOM_COM799
PRINTFORMDW 당신은 오늘 내린 선택들에 대해 생각한다.
PRINTFORMDW 당신은 오늘을 일찍 끝낼까 고려한다.
PRINTFORML [  0] - 세상을 바꿔라... 나의 마지막 메시지... 안녕
PRINTFORML [ 99] - 개소리, 할 일이 있다
PRINTFORML [100] - 이 버튼은 도대체 뭐야 제발 난 죽고 싶지 않아
$LOOP
INPUT
SELECTCASE RESULT
	CASE 0
		PRINTFORMDW 어떻게 나갈 건데?
		CALL ASK_M("신비한 약",1,@"죽을 때까지 사정할 때까지 \@ BASE:MASTER:精力 >= MAXBASE:MASTER:精力*9/10 || !HAS_PENIS(MASTER) ? %" "%더 많은 정액이 발사될 준비가 필요하다... {BASE:MASTER:精力}/{MAXBASE:MASTER:精力*9/10} #  \@",(BASE:MASTER:精力 >= MAXBASE:MASTER:精力*9/10) && HAS_PENIS(MASTER),"총기",nRyona,"잠깐, 실수했어.", 1)
		SELECTCASE RESULT
			CASE 0
				PRINTFORMDW 당신은 신비로운 알약 하나를 먹는다. 
				PRINTFORMDW 당신의 시야가 암전된다...
				PRINTFORMDW ...
				PRINTFORMDW ..
				PRINTFORMDW .
				PRINTFORMDW
				DOWNBASE:MASTER:体力 += 5000
				FLAG:223 = 1
				TIME += 1
			CASE 1
				PRINTFORMDW 너 스스로 미치도록 자위한다.
				PRINTFORMDW 몇 시간 후, 네 사타구니는 감각이 없어지고 매우 피로해지기 시작한다.
				PRINTFORMDW 목에 숨이 막히기 시작한다.
				PRINTFORMDW 너는 질식하고 기절하며... 네 정액 더미 위에서...
				PRINTFORMDW ...
				PRINTFORMDW ..
				PRINTFORMDW .
				PRINTFORMDW
				CALL AddEXP("Ｃ経験", MASTER, 12)
				CALL AddEXP("絶頂経験", MASTER, 12)
				CALL AddEXP("射精経験", MASTER, 12)
				CALL AddEXP("自慰経験", MASTER, 12)
				BASE:MASTER:精力 = 0
				DOWNBASE:MASTER:体力 += 5000
				FLAG:223 = 1
				TIME += 90
			CASE 2
				FLAG:223 = 1
				CALL KNIFE_FIGHT(MASTER,MASTER,1,1)
			CASE 4
				PRINTFORMDW 당신이 결정한다, 살아가는 것이 옳은 선택이라고.          
		ENDSELECT
	CASE 99
		PRINTFORMDW 당신이 결정한다, 삶은 올바른 선택이라고
		WAIT
	CASE 100
		PRINTFORMDW 당신의 편집증이 당신을 괴롭힌다.
		PRINTFORMDW 너무 일찍 끝낼 수는 없다
		WAIT
		nSuicide = !nSuicide
ENDSELECT
RETURN 1

@ADD_CUSTOM_COM_ABLE799
SIF !nSuicide
	RETURN 0
SIF FLAG:70 == 1
	RETURN 0
SIF CFLAG:うふふ != 0
	RETURN 0
SIF !TFLAG:100
	RETURN 0
SIF CFLAG:睡眠
	RETURN 0
RETURN 1
