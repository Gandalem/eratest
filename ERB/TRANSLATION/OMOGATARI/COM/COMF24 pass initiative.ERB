@COM24_NAS
VARSET LOCAL
;CFLAG:MASTER:うふふ = 2
TFLAG:COMABLE管理 = 3
;bug fix custom code, revised the loop
PRINTFORML 누구에게 이니셔티브를 넘기고 싶으신가요?
FOR LOCAL,1,GET_TARGETNUM() + 1
;SIF TARGET:LOCAL <= 0
;	CONTINUE
SIF TARGET:LOCAL == MASTER
	CONTINUE
SIF !SHIRAHU(TARGET:LOCAL)
	CONTINUE
SIF GETBIT(FLAG:潜伏, 0) && !GETBIT(CFLAG:(TARGET:LOCAL):潜伏状態, 0) ;concealment, only apply to the target
	CONTINUE
PRINTFORML [{LOCAL,3}] %NAME:(TARGET:LOCAL)%
;CFLAG:(TARGET:LOCAL):うふふ = 2
LOCAL:1 ++
NEXT
PRINTFORML [997] 제어권을 포기한다
SIF MASTER != TempUfufuBecome
	PRINTFORML [998] %NAME:(TempUfufuBecome)%로 돌아간다.
PRINTFORML [999] %NAME:(MASTER)%인 채로 머물러라
INPUT
LOCAL:2 = RESULT
SELECTCASE LOCAL:2
	CASE 997
		PRINTFORML 당신은 주도권을 포기하고 %CALLNAME:TARGET%%COND_STR(@" and the others", LOCAL:1 > 1)%가 하고 싶은 대로 하게 둔다.
		CALLF SimultaneousMasterSwap(TempUfufuBecome)
		FOR LOCAL,1,MAX(GET_TARGETNUM() + 1,2)
		;SIF TARGET:LOCAL <= 0
		;	CONTINUE
		;SIF TARGET:LOCAL == MASTER
		;	CONTINUE
		;#; PRINTFORML Checking %CALLNAME:(TARGET:LOCAL)%
		SIF !SHIRAHU(TARGET:LOCAL)
			CONTINUE
		SIF GETBIT(FLAG:潜伏, 0) && !GETBIT(CFLAG:(TARGET:LOCAL):潜伏状態, 0) ;concealment, only apply to the target
			CONTINUE
		CFLAG:(TARGET:LOCAL):うふふ = 2
		NEXT
		CFLAG:MASTER:うふふ = 2
		TARGET = TARGET:1
		RETURN 1
	CASE 998
		PRINTFORML %조사처리(CALLNAME:MASTER,"는")% 주도권을 %CALLNAME:(TempUfufuBecome)%에게 되돌려준다\@ LOCAL:1 > 1 ? %" "%과 다른 이들에게 #  \@.
		CALLF SimultaneousMasterSwap(TempUfufuBecome)
		TIME += 5
		RETURN 1
	CASE 999
		RETURN 0
ENDSELECT
TempUfufuBecome:1 = TARGET:RESULT
TCVAR:(TARGET:RESULT):好きにして = 1
;SIF LOCAL:2 > GET_TARGETNUM() + 1
;	RETURN 0
CALLF SimultaneousMasterSwap(TempUfufuBecome:1)
PRINTFORML 당신은 %CALLNAME:(TempUfufuBecome:1)%에게 \@ LOCAL:1 > 1 ? %" "%와 다른 이들에게 주도권을 준다 #  \@.
TIME += 5
RETURN 1

@SimultaneousMasterSwap(ARG)
#FUNCTION
TFLAG:現在のTARGET = MASTER
TARGET = MASTER
CFLAG:MASTER:同室 = 1
MASTER = ARG
PLAYER = ARG
TFLAG:運搬 = ARG
CFLAG:ARG:同室 = 1
