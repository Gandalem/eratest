;-------------------------------------------------
;攻守交替
;-------------------------------------------------
@COM24_NAS
VARSET LOCAL
;CFLAG:MASTER:うふふ = 2
TFLAG:COMABLE管理 = 3
;bug fix custom code, revised the loop
PRINTFORML Who do you want to pass initiative to?
FOR LOCAL,1,GET_TARGETNUM() + 1
	;SIF TARGET:LOCAL <= 0
	;	CONTINUE
	SIF TARGET:LOCAL == MASTER
		CONTINUE
	SIF !SHIRAHU(TARGET:LOCAL)
		CONTINUE
	SIF GETBIT(FLAG:潜伏, 0) && !GETBIT(CFLAG:(TARGET:LOCAL):潜伏状態, 0) ;concealment, only apply to the target
		CONTINUE
	
	
	PRINTFORML [{LOCAL,3}] %NAME:(TARGET:LOCAL)%
	
	;CFLAG:(TARGET:LOCAL):うふふ = 2
	LOCAL:1 ++
NEXT
PRINTFORML [997] Give up control
SIF MASTER != TempUfufuBecome
PRINTFORML [998] Return to %NAME:(TempUfufuBecome)%
PRINTFORML [999] Stay as %NAME:(MASTER)%
INPUT

LOCAL:2 = RESULT
SELECTCASE LOCAL:2
CASE 997
	PRINTFORML You give up initiative and let %CALLNAME:TARGET%%COND_STR(@" and the others", LOCAL:1 > 1)% do whatever they want.
	CALLF SimultaneousMasterSwap(TempUfufuBecome)	
	FOR LOCAL,1,MAX(GET_TARGETNUM() + 1,2)
		;SIF TARGET:LOCAL <= 0
		;	CONTINUE
		;SIF TARGET:LOCAL == MASTER
		;	CONTINUE
		;#; PRINTFORML Checking %CALLNAME:(TARGET:LOCAL)%
		SIF !SHIRAHU(TARGET:LOCAL)
			CONTINUE
		SIF GETBIT(FLAG:潜伏, 0) && !GETBIT(CFLAG:(TARGET:LOCAL):潜伏状態, 0) ;concealment, only apply to the target
			CONTINUE
		CFLAG:(TARGET:LOCAL):うふふ = 2
	NEXT
	CFLAG:MASTER:うふふ = 2
	TARGET = TARGET:1
	RETURN 1
CASE 998
	PRINTFORML %CALLNAME:MASTER% returns the initiative back to %CALLNAME:(TempUfufuBecome)%\@ LOCAL:1 > 1 ? %" "%and the others #  \@.
	CALLF SimultaneousMasterSwap(TempUfufuBecome)
	TIME += 5
	RETURN 1	
CASE 999
	RETURN 0
ENDSELECT
TempUfufuBecome:1 = TARGET:RESULT
TCVAR:(TARGET:RESULT):好きにして = 1


;SIF LOCAL:2 > GET_TARGETNUM() + 1
;	RETURN 0


CALLF SimultaneousMasterSwap(TempUfufuBecome:1)

PRINTFORML You give the initiative to %CALLNAME:(TempUfufuBecome:1)%\@ LOCAL:1 > 1 ? %" "%and the others #  \@.
TIME += 5

RETURN 1

@SimultaneousMasterSwap(ARG)
#FUNCTION
TFLAG:現在のTARGET = MASTER
TARGET = MASTER
CFLAG:MASTER:同室 = 1
MASTER = ARG
PLAYER = ARG
TFLAG:運搬 = ARG
CFLAG:ARG:同室 = 1
