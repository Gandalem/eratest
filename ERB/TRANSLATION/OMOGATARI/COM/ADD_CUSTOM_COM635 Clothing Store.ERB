@ADD_CUSTOM_COM635
#DIM 買うもの
;購入条件設定
#DIM     PAGE       ;表示中のページ
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
PAGE = 1
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
TRYCALLFORM ClothingListing(FINDELEMENT(EQUIPNAME, 表示部位:PAGE), EquipIDSTR:PAGE)
DRAWLINE
FOR LOCAL, 0, VARSIZE("表示ラベル")
	SIF GROUPMATCH(LOCAL, 10, 19,20,24)
		CONTINUE
	[IF_NDEBUG]
	SIF LOCAL == VARSIZE("表示ラベル")
		CONTINUE
	[ENDIF]
	SIF PAGE == LOCAL
		SETCOLOR 0x00FFFF
	;exception for player character
	PRINTBUTTON 表示ラベル:LOCAL, LOCAL + 2
	RESETCOLOR
	PRINTFORM 　　
NEXT
PRINTFORML
PRINTBUTTON "[0] Return", 0
DO
	INPUT
	SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1
		GOTO RETRY
	CASE 2 TO VARSIZE("表示ラベル")+1
		PAGE = RESULT-2
	CASE IS >= 100
		TRYCALLFORM ClothingBuyPiece(RESULT-((FINDELEMENT(EQUIPNAME, 表示部位:PAGE))*1000),FINDELEMENT(EQUIPNAME, 表示部位:PAGE), EquipIDSTR:PAGE)		
	CASEELSE
		$RETRY
		REUSELASTLINE Invalid Input
		CONTINUE
	ENDSELECT
	BREAK
LOOP 1
GOTO REPRINT


@ClothingListing(nGroup, ARGS)
#DIM nGroup
#DIM DYNAMIC 表示数
#DIM DYNAMIC 表示行
#DIM DYNAMIC nPrice
;DRAWLINE
;CALL LIST_ITEM("野菜")
;DRAWLINE
PRINTFORML Please select items to purchase.（Money: %金額表示(MONEY)%）
DRAWLINE
FOR LOCAL:1,(nGroup == 6 ? 1 # 0),VAR_TEMP_MAX
	SIF CLOTHNAME(nGroup, LOCAL:1) == ""
		CONTINUE
	;diapers require diaper flag
	SIF IsPadded(MASTER, , LOCAL:1) && !nOmutsu && nGroup == 6
		CONTINUE
	nPrice = ClothPrice(ARGS,LOCAL:1,MASTER)
	SIF !nPrice
	nPrice = 250

	IF BoughtClothing:nGroup:(LOCAL:1)
		LOCALS:1 = %金額表示(nPrice)%
		SETCOLOR C_GRAY
    ELSEIF SaveIsEZB && LegendModeStage < GET_INT(MASTER,CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(nGroup)),LOCAL:1,"Grade")
		LOCALS:1 = %LoG_StageName(GET_INT(MASTER,CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(nGroup)),LOCAL:1,"Grade"))%
		SETCOLOR C_GRAY
	ELSEIF MONEY < nPrice
		LOCALS:1 = %金額表示(nPrice)%
		SETCOLOR C_GRAY
	ELSE
		LOCALS:1 = %金額表示(nPrice)%
	ENDIF

	IF nGroup == 6
	LOCALS = [{(LOCAL:1)+(nGroup*1000),4}]%UNDIES_NAME_WITH_BRAND(MASTER,LOCAL:1)%
	ELSE
	LOCALS = [{(LOCAL:1)+(nGroup*1000),4}]%CLOTHES_TR(CLOTHNAME(nGroup, LOCAL:1))%
	ENDIF
	PRINTFORM %LOCALS, 50, LEFT% %LOCALS:1, 11% 
	RESETCOLOR
	表示数 ++
	IF 表示数 % 3 == 0
		PRINTL
		表示行 ++
	ENDIF
NEXT
PRINTL
;TIME += 10

@ClothingDescription(ARG, nGroup, ARGS)
#DIM nGroup
#DIM DYNAMIC nAbsorbancy, 2
#DIM DYNAMIC nBdyPart
#DIMS DS_STORAGE, 3
#DIMS HTML
IF nGroup == 6
CALLF DiapeStats(MASTER,ARG,1,1)
DS_STORAGE:0 '= RESULTS:0
DS_STORAGE:1 '= RESULTS:1
DS_STORAGE:2 '= RESULTS:2
nAbsorbancy = RESULT:1
nAbsorbancy:1 = RESULT:2
ENDIF

PRINTFORMSL TW_PORT_STR(@"\@ GET_STR(MASTER, ARGS, ARG, "FullName") != "" ? %GET_STR(MASTER, ARGS, ARG, "FullName")% # %CLOTHES_TR(CLOTHNAME(nGroup, ARG))%\@")
;;#;PRINTFORML Clothing ID: {ARG} Clothing Type: %ARGS%
PRINTFORML %Clothes_FullDescription(ARGS, ARG, MASTER)%
PRINTFORML
PRINTFORML ───────────────────────────────
IF nAbsorbancy && UndiesCanSoil("liquid",MASTER)
PRINTFORM %"Liquid Absorbancy",20,LEFT% 
CALL PRINT_COLORBAR((nAbsorbancy:0), 5000, 40, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("赤"), RESULT:1)
PRINTFORML  {nAbsorbancy:0}ml 
ENDIF
IF nAbsorbancy:1 && UndiesCanSoil("solid",MASTER)
PRINTFORM %"Solid Containment",20,LEFT% 
CALL PRINT_COLORBAR((nAbsorbancy:1), 5000, 40, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("赤"), RESULT:1)
PRINTFORML  {nAbsorbancy:1}g 
ENDIF
IF nRyona && (GET_INT(MASTER, ARGS, ARG, "Armor"))
PRINTFORM %"Armor Strength",20,LEFT% 
CALL PRINT_COLORBAR((GET_INT(MASTER, ARGS, ARG, "Armor")), 14, 40, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("赤"), RESULT:1)
PRINTFORML  VPAM Level {GET_INT(MASTER, ARGS, ARG, "Armor")}
PRINTFORM %"Armor Durability",20,LEFT% 
CALL PRINT_COLORBAR((GET_INT(MASTER, ARGS, ARG, "Armor Health")), 20000, 40, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("赤"), RESULT:1)
PRINTFORML  {GET_INT(MASTER, ARGS, ARG, "Armor Health")}kJ
PRINTFORM %"Armor Coverage",20,LEFT% 
LOCALS =
	FOR LOCAL,0, 100
	nBdyPart = TOINT(SPLIT_SINGLE(GET_STR(MASTER, ARGS, ARG, "Armor Coverage"), LOCAL, "/"))
	IF !nBdyPart
		IF LOCAL == 0
			LOCALS '= "None, "
		ENDIF
		PRINTFORM %SUBSTRING(LOCALS,0,STRLENS(LOCALS)-2)%
		BREAK
	ENDIF
	LOCALS += @"%BDY_PART_NAME(nBdyPart)%, "
	NEXT
PRINTL
ENDIF
IF nGroup == 6
PRINTFORM %"Underwear Type",20,LEFT% 
PRINTFORML %DS_STORAGE:2% %DS_STORAGE:0%
ELSEIF clothing_UndiesDiscreteness(ARGS, ARG, MASTER) < 99
;showcases what underwear it can hide
PRINTFORM %"Panty Concealment",20,LEFT% 
PRINTFORML %TOSTR_UNDERWEARCONCEAL(clothing_UndiesDiscreteness(ARGS, ARG, MASTER))%
ENDIF
;PRINTL

PRINTFORML ───────────────────────────────


;sample
[SKIPSTART]
Closures:  \n
Comfort:  Soft and comfortable\n
Waist band:  Front and back stretch waistband
Leg Gathers:  Tall standing leg cuffs
Backing:  Strong plastic backing
Printing:  All over, print based off which Touhou you pick.
[SKIPEND]
IF nGroup == 6
	IF DS_STORAGE:0 == "Diaper"
		PRINTFORM %"Closures",20,LEFT%
		IF STRFIND(DS_STORAGE:1,"pinned/") > -1
			T = 2
			PRINTFORML %NUM_COUNT(2,,1)% refastenable hardened steel safety %PLURALIZER("pin",T)% per side
		ELSEIF  STRFIND(DS_STORAGE:1,"belted/") > -1
			PRINTFORML Soft stretch hook and loop belt
		ELSE
			T = STRFIND(DS_STORAGE:1,"four-taped/") > -1 ? 2 # 1
			PRINTFORML %NUM_COUNT(T,,1)% %COND_STR("strong and wide ",!GROUPMATCH(DS_STORAGE:2,"Thin","Average",""))%%COND_STR("refastenable ",STRFIND(DS_STORAGE:1,"refastenable/") > -1)%tape %PLURALIZER("tab",T)% per side
		ENDIF
	ENDIF
	;PRINTFORML Comfort:  Soft and comfortable
	PRINTFORML %"Waist band",20,LEFT% Front and back stretch waistband
	IF IsPadded(MASTER,,ARG)
		IF STRFIND(DS_STORAGE:1,"very tall leak guards/") > -1
			LOCALS = Very tall standing leg cuffs
		ELSEIF STRFIND(DS_STORAGE:1,"tall leak guards/") > -1 
			LOCALS = Tall standing leg cuffs
		ELSEIF STRFIND(DS_STORAGE:1,"leak guards/") > -1 
			LOCALS '= "Standing leg cuffs"
		ELSE 
			LOCALS '= "None"
		ENDIF
		PRINTFORML %"Leg gathers",20,LEFT% %LOCALS%
		PRINTFORML %"Backing",20,LEFT% \@ STRFIND(DS_STORAGE:1,"plastic-back/") > -1 ? Strong plastic backing # Cloth backing \@
	ENDIF
	PRINTFORML %"Printing",20,LEFT% Dependent on design
	IF PANTY_HAS_WETNESS_INDICATOR(ARG)
		HTML_PRINT @"%"Wetness Indicator",20,LEFT% %ACCIDENT_WETNESS_INDICATOR(MASTER,1,2,0)%     %ACCIDENT_WETNESS_INDICATOR(MASTER,1,2,20)%     %ACCIDENT_WETNESS_INDICATOR(MASTER,1,2,50)%     %ACCIDENT_WETNESS_INDICATOR(MASTER,1,2,80)%     %ACCIDENT_WETNESS_INDICATOR(MASTER,1,2,100)%"
	ENDIF
	IF GET_INT(MASTER, ARGS, ARG, "Youjutsu Soil/Liquid/0/Spell") || GET_INT(MASTER, ARGS, ARG, "Youjutsu Soil/Solid/0/Spell")
		HTML_PRINT @"%"Magic Attunement",20,LEFT%"
		;--20%--> Agi --40%--> Agilao --200%--> Agidyne --300%--> Agibarion --600%--> Inferno of God
		IF GET_INT(MASTER, ARGS, ARG, "Youjutsu Soil/Liquid/0/Spell")
			LOCALS '= @"%"・Liquid",20,LEFT%"
			FOR LOCAL,0,10
				IF GET_INT(MASTER, ARGS, ARG, @"Youjutsu Soil/Liquid/{LOCAL}/Level") > 0
					LOCALS += @"--{GET_INT(MASTER, ARGS, ARG, @"Youjutsu Soil/Liquid/{LOCAL}/Level")}\%--> "
				ENDIF
				IF GET_INT(MASTER, ARGS, ARG, @"Youjutsu Soil/Liquid/{LOCAL}/Spell") > 0
					TRYCALLFORM NAS_ESP_{GET_INT(MASTER, ARGS, ARG, @"Youjutsu Soil/Liquid/{LOCAL}/Spell")/100}_{GET_INT(MASTER, ARGS, ARG, @"Youjutsu Soil/Liquid/{LOCAL}/Spell")%100}
					LOCALS += @"%NAS_ESP_NAME% "
				ENDIF
			NEXT
			HTML_PRINT LOCALS
		ENDIF
		IF GET_INT(MASTER, ARGS, ARG, "Youjutsu Soil/Solid/0/Spell")
			LOCALS '= @"%"・Solid",20,LEFT%"
			FOR LOCAL,0,10
				IF GET_INT(MASTER, ARGS, ARG, @"Youjutsu Soil/Solid/{LOCAL}/Level") > 0
					LOCALS += @"--{GET_INT(MASTER, ARGS, ARG, @"Youjutsu Soil/Solid/{LOCAL}/Level")}\%--> "
				ENDIF
				IF GET_INT(MASTER, ARGS, ARG, @"Youjutsu Soil/Solid/{LOCAL}/Spell") > 0
					TRYCALLFORM NAS_ESP_{GET_INT(MASTER, ARGS, ARG, @"Youjutsu Soil/Solid/{LOCAL}/Spell")/100}_{GET_INT(MASTER, ARGS, ARG, @"Youjutsu Soil/Solid/{LOCAL}/Spell")%100}
					LOCALS += @"%NAS_ESP_NAME% "
				ENDIF
			NEXT
			HTML_PRINT LOCALS
		ENDIF
	ENDIF
PRINTFORML ───────────────────────────────
ENDIF

@ClothingBuyPiece(ARG, nGroup, ARGS)
#DIM nGroup
#DIM nPrice
IF GET_INT(MASTER,CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(nGroup)),ARG,"Quest Only")
	PRINTFORMW Insufficient requirements to unlock this quest only clothing.
	RETURN
ELSEIF LegendModeStage < GET_INT(MASTER,CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(nGroup)),ARG,"Grade") && SaveIsEZB
	PRINTFORML This is %LoG_StageName(GET_INT(MASTER,CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(nGroup)),ARG,"Grade"))% clothing!
	PRINTFORMW You are currently only in %LoG_StageName(LegendModeStage)%
	RETURN
ENDIF


nPrice = ClothPrice(ARGS,ARG,MASTER)
SIF !nPrice
nPrice = 250

CALL ClothingDescription(ARG, nGroup, ARGS)
DRAWLINE
IF BoughtClothing:nGroup:ARG
PRINTFORML You already have this
WAIT
RETURN
ENDIF

PRINTFORML Buy the %CLOTHES_TR(CLOTHNAME(nGroup, ARG))%?
CALL PAY_YEN_OR_CM(nPrice,nPrice/CHARISMA_NOW())
IF RESULT
	BoughtClothing:nGroup:ARG ++
	PRINTFORMW Bought the %CLOTHES_TR(CLOTHNAME(nGroup, ARG))%!
	RETURN
ELSE
	RETURN
ENDIF

