	RETURNF 1
SIF ARG == GET_MAP_REPLACEMENT(1119)
	RETURNF 1
SIF GETBIT(HOME_CUSTOM_ROOM(ARG),1)
	RETURNF 1
RETURNF 0

@CLOTHES_ID_TO_STR(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 2
		RETURNF "頭装備"
	CASE 3
		RETURNF "靴"
	CASE 4
		RETURNF "靴下"
	CASE 5
		RETURNF "下半身下着_ずらし不可"
	CASE 6
		RETURNF "下半身下着_ずらし可能"
	CASE 7
		RETURNF "上半身下着_はだけ不可"
	CASE 8
		RETURNF "上半身下着_はだけ可能"
	CASE 9
		RETURNF "レオタード"
	CASE 10
		RETURNF "ボディースーツ"
	CASE 11
		RETURNF "ズボン"
	CASE 12
		;RETURNF "下半身上着"
	CASE 13
		RETURNF "ワンピース"
	CASE 14
		RETURNF "着物"
	CASE 15
		RETURNF "スカート"
	CASE 16
		RETURNF "上半身上着_はだけ不可"
	CASE 17
		RETURNF "上半身上着_はだけ可能"
	CASE 18
		RETURNF "外衣"
	CASE 19, 20, 21
		RETURNF "その他衣装"
	CASE 22
		RETURNF "腕部装束"
	CASE 23
		RETURNF "Back"
ENDSELECT
