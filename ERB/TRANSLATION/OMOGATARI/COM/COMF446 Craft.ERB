;Crafting
@COM446_NAS
#DIM 調合物
#DIM nResult
#DIM nRecipe
#DIM 調合件数
#DIM 調合パワー
#DIM 調合パワーM
#DIM 調合パワーT
#DIM CHARA
#DIM R_ID
#DIM PRODUCTION
#DIM 体力消費
#DIM 気力消費
#DIMS nItemName
#DIM nItemID
#DIM nRankRequired

調合物 = 0
nResult = 0
nRecipe = 0
調合件数 = 0
調合パワーM = 0
調合パワーT = 0

;参加者判定
IF TARGET != MASTER && ABL:TARGET:親密 >= 5 && SHIRAHU(TARGET) && CFLAG:TARGET:行動 != 5
	CHARA = TARGET
ELSE
	CHARA = 0
ENDIF

;調合パワー設定 調合知識と教養、薬学教本を持っていると加算
調合パワーM = TALENT:MASTER:調合Lv * 15 + ABL:MASTER:教養 * 5 + TFLAG:幸運補正 * 5 + TALENT:MASTER:調合知識 * 30
SIF ITEM:薬学教本
	調合パワーM += 10
SIF CHARA
	調合パワーT = TALENT:CHARA:調合Lv * 15 + ABL:CHARA:教養 * 5 + TALENT:CHARA:調合知識 * 30
;参加者で最もパワーが高いものを基準に、1/2したもう１人のパワーを足す
IF 調合パワーM >= 調合パワーT
	調合パワー = 調合パワーM + (調合パワーT / 2)
ELSE
	調合パワー = 調合パワーT + (調合パワーM / 2)
ENDIF

;①調合物選択リスト画面描画、nResultを選択
gLineCount = LINECOUNT
globalLineSave = 0
$INPUT_LOOP_NAS
CLEARLINE LINECOUNT - gLineCount
CALL PHARMACY_LIST

$INPUT_LOOP01
INPUT
nResult = RESULT
IF RESULT == 1000
	RETURN -1
ELSEIF GROUPMATCH(nResult,8000,8001,8002)
	;NAS: paged crafting menu
	globalLineSave = nResult-8000
	GOTO INPUT_LOOP_NAS
ENDIF

;②調合物選択リスト内の能力によるレシピ解放・調合可能かを判定
SELECTCASE nResult
CASE IS >= WeaponOffset
	nItemID = (nResult-WeaponOffset)/10
	nItemName = %PrintWeaponName(,nItemID,1,1)%
	nRankRequired = WEAP_RANK_REQUIRE(nItemID)
CASE IS >= BionicOffset
	nItemID = (nResult-BionicOffset)/10
	nItemName = %GET_STR(MASTER, "Hediff", (nItemID+100), "名前")%
	nRankRequired = BIONIC_RANK(nItemID)
CASEELSE
	nItemID = nResult
	nItemName = %ITEMNAME_TR(nResult)%
	nRankRequired = PHARMACY_RANK(nResult)
    ; SIF nLevelRework
    ;     nRankRequired = RANK_TO_LEVEL(nRankRequired)
ENDSELECT

SELECTCASE nRankRequired
	CASE 0
		CLEARLINE 1
		GOTO INPUT_LOOP01
	CASE 1
		;無条件解放
	CASE UniversalRank("C"), UniversalRank("B")
		IF LEVEL_TO_RANK(TALENT:MASTER:調合Lv) < (PHARMACY_RANK(nItemID) - 3) && ITEM:109 == 0
			CLEARLINE 1
			GOTO INPUT_LOOP01
		ENDIF
	CASE IS >= UniversalRank("A")
		IF LEVEL_TO_RANK(TALENT:MASTER:調合Lv) < (PHARMACY_RANK(nItemID) - 3)
			CLEARLINE 1
			GOTO INPUT_LOOP01
		ENDIF
ENDSELECT
;体質変化薬は【禁断の知識】所有時のみ可
IF PHARMA_VOLATILE(nItemID) && TALENT:MASTER:SexKnow < 3
	CLEARLINE 1
	GOTO INPUT_LOOP01
ENDIF

;③調合レシピリストを出力
DRAWLINE
;★ここにアイテムリストを出す？

;アイテム解説.ERBから説明文を表記



SETCOLOR 0x00FF00
SELECTCASE nResult
CASE IS >= WeaponOffset
	PRINTFORML ●（Currently held: {NumberWeaponOwned(nItemID)}）
	CALL WeaponDescription(nItemID)
	RESETCOLOR
CASE IS >= BionicOffset
	PRINTFORML ●%GET_STR(MASTER, "Hediff", (nItemID+100), "名前")%　（Currently held: {HasBionic:nItemID}）
	HTML_PRINT @"　%BionicDescription(nItemID+100)% "
	RESETCOLOR
CASEELSE
	PRINTFORML ●%ITEMNAME_TR(nItemID)%　（Currently held: {ITEM:nItemID}）
	PRINTFORML 　%ITEM_EXPLANATION(nItemID)% 
	RESETCOLOR
ENDSELECT
PRINTL 
PRINTL Select a recipe to craft.
DRAWLINE

SELECTCASE nResult
CASE IS >= WeaponOffset
	CALL PHARMACY_RECIPELIST(nItemID, "Weapon")
CASE IS >= BionicOffset
	CALL PHARMACY_RECIPELIST(nItemID, "Bionic")
CASEELSE
	CALL PHARMACY_RECIPELIST(nItemID)
ENDSELECT


;④レシピ番号を入力、実行可否を判定
$INPUT_LOOP02
INPUT
SIF RESULT == 0
	RESTART
nRecipe = RESULT

SELECTCASE nResult
CASE IS >= BionicOffset
	R_ID = nResult + nRecipe
CASEELSE
	R_ID = nResult * 10 + nRecipe
ENDSELECT

IF !CAN_PHARMA(R_ID)
	CLEARLINE 1
	GOTO INPUT_LOOP02
ENDIF

;⑤調合回数を入力、可否を判定（70番台の体質変化薬の類は１個限定、他は最大10回まで）
IF PHARMA_VOLATILE(nItemID)
	PRINTFORML You can only make 1 %nItemName% at a time.
ELSE
	PRINTFORML Select how many %nItemName% to make (enter number, 0 to cancel).
ENDIF

;そのレシピで消費する素材の現在の所持数を表記
PRINT 　Number of materials in possession: 

CALL PHARMACY_CONSUME(R_ID, 0, 1)

PRINTBUTTON "[0] Return", 0
PRINT     
PRINTBUTTON "[1] 1", 1
PRINT     
IF !PHARMA_VOLATILE(nResult)
	IF CAN_PHARMA(R_ID, 5)
		PRINTBUTTON "[5] 5", 5
		PRINT   
	ENDIF
	IF CAN_PHARMA(R_ID, 10)
		PRINTBUTTON "[10] 10", 10
		PRINT   
	ENDIF
ENDIF

$INPUT_LOOP03
INPUT
調合件数 = RESULT
SIF RESULT == 0
	RESTART

IF FLAG:70 && BASE:MASTER:TSP < (PHARMACY_TIME(nResult, 調合件数)*3)
	PRINTFORML Crafting {nRecipe} %PLURALIZER("set",nRecipe)% will use more TSP than what you have (need {(PHARMACY_TIME(nResult, 調合件数)*3)} TSP, currently have {BASE:MASTER:TSP})
ENDIF

PRODUCTION = CAN_PHARMA(R_ID, 調合件数)
IF PRODUCTION && 調合件数 <= 10
	CLEARLINE 1
	;体質変化薬は入力回数に関わらず強制的に１回に絞る
	SIF PHARMA_VOLATILE(nResult)
		調合件数 = 1
	PRINTFORM Making {nRecipe} %PLURALIZER("set",nRecipe)% with this recipe will result in {PRODUCTION} %nItemName%.
	;調合時前後での消費アイテムの数を表記
	PRINT 　Consumed raw materials: 
	CALL PHARMACY_CONSUME(R_ID, 調合件数, 1)
	;調合成功時アイテム個数が99を超える場合は警告を出す
	SELECTCASE nResult
	CASE IS >= WeaponOffset
		PRINTFORML 　Will create this many %nItemName%: （{NumberWeaponOwned(nItemID)}→{NumberWeaponOwned(nItemID) + PRODUCTION}）
	CASE IS >= BionicOffset
		PRINTFORML 　Will create this many %nItemName%: （{HasBionic:nItemID}→{HasBionic:nItemID + PRODUCTION}）
	CASEELSE
		IF ITEM:(nResult) + PRODUCTION > 9999
			PRINTFORML 　Making this many %nItemName% at once means {-(PRODUCTION - 9999)} of them will be lost.
		ELSE
			PRINTFORML 　Will create this many %nItemName%: （{ITEM:nResult}→{ITEM:nResult + PRODUCTION}）
		ENDIF
	ENDSELECT
	PRINTFORML 　Time needed: \@ FLAG:70 ? {(PHARMACY_TIME(nResult, 調合件数)*3)} TSP (currently have {BASE:MASTER:TSP}) # {PHARMACY_TIME(nResult, 調合件数)}min. \@



	IF nRankRequired == 1
		PRINTL This is trivial to prepare...
	ELSEIF nRankRequired >= 2
		SELECTCASE (調合パワー - (nRankRequired * 20))
			CASE IS <= -100
				PRINTL The recipe is known, the ingredients are correct but... There is no way this will end well...
			CASE -99 TO -50
				PRINTL This will be extremely difficult to prepare...
			CASE -49 TO -30
				PRINTL There's a high chance of failure...
			CASE -29 TO -10
				PRINTL There is a risk of failure...
			CASE -9 TO -1
				PRINTL There is a slight risk of failure...
			CASEELSE
				PRINTL This is trivial to prepare...
		ENDSELECT
	ENDIF
	PRINTFORML Your power: {調合パワー}, Required: {(nRankRequired * 20)}
	PRINT Prepare it?
	IF PHARMA_VOLATILE(nResult)
		SETCOLOR 0x666666
		PRINTFORML （Using this item without selecting a target will still use it up, wasting the raw material.）
		RESETCOLOR
	ELSE
		PRINTL 
	ENDIF
	CALL ASK_YN
	IF !RESULT
	;先に進む
	ELSE
		調合件数 = 0
		CLEARLINE 8
		RETURN -1
	ENDIF
ELSE
	調合件数 = 0
	CLEARLINE 1
	GOTO INPUT_LOOP03
ENDIF

;ここまでで条件をすべてクリアしている場合は以下に進行
REPEAT 5
	REUSELASTLINE  Preparing%COND_STR(@" with %CALLNAME:CHARA%", CHARA != MASTER)%.%"." * COUNT%
	TWAIT 150, 1
REND
R_ID = 調合物 * 10 + nRecipe
;⑥調合の成功判定
IF nRankRequired != 1
	IF 調合パワー >= RAND:(nRankRequired * 20)
		PRINTFORML The crafting was a success!
		調合物 = nItemID
		;調合後入手個数を流し込む
		TFLAG:194 = PRODUCTION
	ELSE
		PRINTFORML The crafting failed...
		調合物 = 0
	ENDIF
;調合LV1レシピは100％成功
ELSE
	PRINTFORML The crafting was a success!
	調合物 = nItemID
	;調合後入手個数を流し込む
	TFLAG:194 = PRODUCTION
ENDIF

;素材アイテム消費処理をここで
PRINT 　Material consumed: 
SELECTCASE nResult
CASE IS >= BionicOffset
	R_ID = nResult + nRecipe
CASEELSE
	R_ID = nResult * 10 + nRecipe
ENDSELECT

CALL PHARMACY_CONSUME(R_ID, 調合件数)

;⑦アイテム入手処理 99個以上にならないようにする
;  体質改変薬は入手処理の代わりに使用処理に飛ぶ
IF PHARMA_VOLATILE(調合物)
	CALL PHARMACY_CONSTITUTIONAL(調合物)
ELSEIF 調合物 != 0
	SELECTCASE nResult
	CASE IS >= WeaponOffset
		FOR LOCAL,0,TFLAG:194
			CALLF Create_Weapon(調合物)
		NEXT
	CASE IS >= BionicOffset
		HasBionic:(調合物+100) += TFLAG:194
	CASEELSE
		IF ITEM:(調合物) + TFLAG:194 > 9999
			ITEM:(調合物) = 9999
		ELSE
			ITEM:(調合物) += TFLAG:194
		ENDIF
	ENDSELECT
ENDIF

;⑧経験加算 調合成功時は調合難易度×調合件数の経験
EXP:MASTER:調合経験 += PHARMACY_EXP(nResult, 調合件数, 調合物)
SIF CHARA
	EXP:CHARA:調合経験 += PHARMACY_EXP(nResult, 調合件数, 調合物)
;薬学教本持っていると追加
SIF ITEM:109
	EXP:MASTER:調合経験 += MAX(RAND:(調合件数), 1)

;能力差で教えてもらう・教えてあげる
IF 調合パワーM >= 調合パワーT && CHARA
	EXP:CHARA:調合経験 ++
ELSEIF CHARA
	EXP:MASTER:調合経験 ++
ENDIF


;⑨時間経過 調合難易度と調合件数によって補正
IF FLAG:70
BASE:MASTER:TSP -= (PHARMACY_TIME(nResult, 調合件数)*3)
ELSE
TIME += PHARMACY_TIME(nResult, 調合件数)
ENDIF

;⑩体力・気力減少処理
体力消費 = 30 * SQRT(調合件数)

気力消費 = MAX((((50 * nRankRequired) - (15 * TALENT:MASTER:調合知識 + 10 * TALENT:MASTER:調合Lv))), 30) * SQRT(調合件数)
;自室かつ机椅子があると体力気力消費低減
IF CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置 && ITEM:ケヤキの机椅子
	SELECTCASE ITEM:ケヤキの机椅子
		CASE 1
			TIMES 体力消費, 0.9
			TIMES 気力消費, 0.9
		CASE 2
			TIMES 体力消費, 0.85
			TIMES 気力消費, 0.85
		CASE 3
			TIMES 体力消費, 0.8
			TIMES 気力消費, 0.8
	ENDSELECT
	PRINTFORML With the desk being so tidy, it's much less tiring to mix.
ENDIF
DOWNBASE:MASTER:体力 = 体力消費
DOWNBASE:MASTER:気力 = 気力消費

;参加者のソース,同一コマンド制限を受けないので控えめに、調合失敗は半減
IF CHARA != MASTER
	;固定で獲得するソース
	SOURCE:CHARA:歓楽 = 200
	SOURCE:CHARA:情愛 = 50
	
	;ABL:従順をみる
	IF ABL:従順 <= 1
		SOURCE:CHARA:歓楽 += (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += (ABL:親密 * 20)
	ELSEIF ABL:従順 <= 3
		SOURCE:CHARA:歓楽 += 200 + (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += 50 + (ABL:親密 * 30)
	ELSEIF ABL:従順 <= 5
		SOURCE:CHARA:歓楽 += 500 + (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += 200 + (ABL:親密 * 30)
	ELSEIF ABL:従順 <= 8
		SOURCE:CHARA:歓楽 += 750 + (ABL:従順 * 60)
		SOURCE:CHARA:情愛 += 300 + (ABL:親密 * 40)
	ELSEIF ABL:従順 <= 11
		SOURCE:CHARA:歓楽 += 1000 + (ABL:従順 * 60)
		SOURCE:CHARA:情愛 += 600 + (ABL:親密 * 40)
	ELSE
		SOURCE:CHARA:歓楽 += 1600 + (ABL:従順 * 30)
		SOURCE:CHARA:情愛 += 1000 + (ABL:親密 * 20)
	ENDIF
	
	;好感度はみない
	
	SOURCE:CHARA:受動 = 200 + 100 * ABL:従順
	SOURCE:CHARA:征服 = 200 + 100 * ABL:サドっ気
	
	;調合成果をみる、調合難易度で設定
	IF 調合物
		SELECTCASE PHARMACY_RANK(調合物)
			CASE 1
				TIMES SOURCE:CHARA:歓楽 , 1.00
				TIMES SOURCE:CHARA:受動 , 1.00
				TIMES SOURCE:CHARA:征服 , 1.00
				SOURCE:CHARA:達成 = 80
			CASE 2
				TIMES SOURCE:CHARA:歓楽 , 1.25
				TIMES SOURCE:CHARA:受動 , 1.25
				TIMES SOURCE:CHARA:征服 , 1.15
				SOURCE:CHARA:達成 = 125
			CASE 3
				TIMES SOURCE:CHARA:歓楽 , 1.50
				TIMES SOURCE:CHARA:受動 , 1.50
				TIMES SOURCE:CHARA:征服 , 1.25
				SOURCE:CHARA:達成 = 150
			CASE 4
				TIMES SOURCE:CHARA:歓楽 , 1.75
				TIMES SOURCE:CHARA:受動 , 1.75
				TIMES SOURCE:CHARA:征服 , 1.50
				SOURCE:CHARA:達成 = 200
			CASE 5
				TIMES SOURCE:CHARA:歓楽 , 2.00
				TIMES SOURCE:CHARA:受動 , 2.00
				TIMES SOURCE:CHARA:征服 , 1.75
				SOURCE:CHARA:達成 = 300
			CASEELSE
				TIMES SOURCE:CHARA:歓楽 , 2.25
				TIMES SOURCE:CHARA:受動 , 2.25
				TIMES SOURCE:CHARA:征服 , 2.00
				SOURCE:CHARA:達成 = 350
		ENDSELECT
	;調合失敗
	ELSE
		TIMES SOURCE:CHARA:歓楽 , 0.50
		TIMES SOURCE:CHARA:受動 , 0.50
		TIMES SOURCE:CHARA:征服 , 0.50
	ENDIF
ENDIF

;フラグ引き渡し
TFLAG:SELECTCOMの分岐 = 調合物
SELECTCASE nResult
CASE IS >= WeaponOffset
	TFLAG:ITEM_CREATE_TYPE = 1
CASE IS >= BionicOffset
	TFLAG:ITEM_CREATE_TYPE = 2
CASEELSE
	TFLAG:ITEM_CREATE_TYPE = 0
ENDSELECT

RETURN 1