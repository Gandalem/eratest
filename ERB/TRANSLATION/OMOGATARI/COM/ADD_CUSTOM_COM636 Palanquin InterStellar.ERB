@PAL_TAXI_COST(ARG)
#FUNCTION
#DIM DYNAMIC nEstCost
#DIM DYNAMIC nEstMult
;if from makai, 25K
SIF GET_MAPID(CFLAG:MASTER:300) == 11 || ARG == 11
	RETURNF 25000
;else, calculate cost from movement
nEstCost = TIME_REQUIRED(GET_MAPID(CFLAG:MASTER:300), ARG)
IF GET_MAPID(CFLAG:MASTER:300) == 10 || ARG == 10
	nEstMult = 130
ELSE
	nEstMult = 75
ENDIF
RETURNF nEstCost*nEstMult
;Ship Captain

@PAL_TAXI_SPEAK(ARGS, ARGS:1 = "通常")
SIF ARGS:1 == "smile"
	ARGS:1 '= "笑顔"
SIF ARGS:1 == "blush"
	ARGS:1 '= "発情"
IF CFLAG:86:現在位置 == CFLAG:PLAYER:現在位置
	CALL SPTALK, 86, ARGS:1, 0, ARGS, 1
ELSE
	CALL SPTALK, 0, ARGS:1, 12, ARGS, 1
ENDIF
RESETCOLOR
