			CASEELSE
				PRINTFORML cautiously \@TARGET != ARG?%PARSE("approach")%#approach\@ the pitfall where %CALLNAME:ARG% had fallen into.
				PRINTFORMW There's an uncontrollable rush of fierce bloodlust rising from the bottom of the pit...
		ENDSELECT
		ENDIF

		SOURCE:ARG:鬱屈 += 50 + LOCAL * 50
		SOURCE:ARG:苦痛 += 350 + LOCAL * 50	
