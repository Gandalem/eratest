; Modular ERB: OMOGATARI/COM/COMF195 Breastfeed.ERB
;-------------------------------------------------
;Breastfeed
;Allows you to feed a 2hu with your breast milk
;You have to be lactating to do this.
;-------------------------------------------------

@ADD_CUSTOM_COM195
#DIM Recipient
CALL KISS_CANCEL
SIF RESULT == -1
	RETURN -1
PRINTFORML 가슴을 열거나, %조사처리(CALLNAME:TARGET,"의")% 것을 먹어라?
CALL ASK_M("당신 자신", TALENT:MASTER:母乳体質, CALLNAME:TARGET, TALENT:TARGET:母乳体質, "취소", 1)
IF RESULT == 2
	DEBUG_Target = -1
	RETURN -1
ELSEIF RESULT == 0 ;drinking semen yourself
	DEBUG_Target = MASTER
	Recipient = TARGET
ELSE
	DEBUG_Target = TARGET
	Recipient = MASTER
ENDIF
TEQUIP:DEBUG_Target:乳首吸い = !TEQUIP:DEBUG_Target:乳首吸い
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽
TCVAR:PLAYER:108 = 1
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 20
	SOURCE:DEBUG_Target:快Ｂ = 100
	SOURCE:DEBUG_Target:快Ｂ += ABL:Recipient:指 * 15
ELSE
	DOWNBASE:DEBUG_Target:体力 += 5
	DOWNBASE:DEBUG_Target:気力 += 50
	SOURCE:DEBUG_Target:快Ｂ = 100
	SOURCE:DEBUG_Target:情愛 = 50
	SOURCE:DEBUG_Target:性行動 = 60
	SOURCE:DEBUG_Target:露出 = 10
	SOURCE:DEBUG_Target:不潔 = 20
	SOURCE:DEBUG_Target:反感 = 20
	SOURCE:Recipient:快Ｍ = 100
	SOURCE:Recipient:情愛 = 50
	SOURCE:Recipient:性行動 = 60
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	SOURCE:DEBUG_Target:快Ｂ += ABL:Recipient:舌 * 15
	;抑圧、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:DEBUG_Target:自己愛 < 0 || TALENT:DEBUG_Target:抵抗
		SOURCE:DEBUG_Target:鬱屈 += 20
	;-------------------------------------------------
	;汚れの処理
	;-------------------------------------------------
	;調教者のTALENT:舌使いをみる
	TIMES SOURCE:Recipient:不潔 , 1.40
	SIF TALENT:Recipient:舌使い
		TIMES SOURCE:DEBUG_Target:快Ｂ , 1.40
	SOURCE:Recipient:鬱屈 += SOURCE:Recipient:不潔 / 20
	;奴隷のＢ⇔調教者の口の汚れが移動
	STAIN:Recipient:5 |= STAIN:DEBUG_Target:0
	STAIN:Recipient:0 |= STAIN:DEBUG_Target:5
	EXP:Recipient:口淫経験 ++
	Qol_Info_Count_Array:DEBUG_Target:Qol_Count_MSexNip += EXP_UP(GETNUM(EXP, "口淫経験"), Recipient) ;qol custom code
ENDIF
;奴隷のＢ⇔調教者の指の汚れが移動
STAIN:Recipient:5 |= STAIN:DEBUG_Target:1
STAIN:DEBUG_Target:1 |= STAIN:Recipient:5
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF FLAG:70 == 1
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 5
	ENDIF
ELSE
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 5
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 5
	ENDIF
ENDIF
RETURN 1

@ADD_CUSTOM_MESSAGE_COM195
IF DEBUG_Target == MASTER
	PRINTFORML 당신은 당신의 %SHOW_TOP(MASTER)%을 열고 부드럽게 당신의 %OPPAI_DESCRIPTION_TR(MASTER)%를 %조사처리(CALLNAME:TARGET,"에게")% 기울인다.
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 두 팔로 당신의 제물을 받아들여 당신의 유두를 말릴 때까지 빠는.
ELSE
	PRINTFORML %조사처리(CALLNAME:TARGET,"가")%/가 %HIS_HER(TARGET)% %SHOW_TOP(MASTER)%을/를 열어젖히자, 그 안에서 %HIS_HER(TARGET)% %OPPAI_DESCRIPTION_TR(TARGET)%이 드러났다.
	PRINTFORML %PARSE("You reach")%는 그들에게로 향하며 한 모금 크게 마셨다.
	CALL RECOVER(MASTER,ABL:TARGET:Ｂ感覚 * 10,"体力")
	CALL RECOVER(MASTER,ABL:TARGET:Ｂ感覚 * 20,"気力")
	CALL RECOVER(MASTER,ABL:TARGET:Ｂ感覚 * 10,"精力")
	CALL COLORMESSAGE(@"STA＋{ABL:TARGET:Ｂ感覚 * 10}",C_AQUA,1)
	CALL COLORMESSAGE(@"ENE＋{ABL:TARGET:Ｂ感覚 * 20}",C_AQUA,1)
	CALL COLORMESSAGE(@"VIG＋{ABL:TARGET:Ｂ感覚 * 10}",C_AQUA,1)
ENDIF

@ADD_CUSTOM_EQUIP_COM195(ARG)
#DIM C_ID
IF ARG == MASTER
	C_ID = TARGET
ELSE
	C_ID = MASTER
ENDIF
SELECTCASE SELECTCOM
	CASE 0 TO 2,4,8,20,47 TO 49,60 TO 66,68,70,71,81 TO 85,91 TO 94,105,120 TO 126,140,410
		PRINTL ＜유두 빨기 취소＞
		SIF TEQUIP:乳首吸い
			TEQUIP:乳首吸い = 0
	CASEELSE
		;乳首吸い中
		PRINTL 모유 수유
		;-------------------------------------------------
		;ソース追加処理
		;-------------------------------------------------
		IF FLAG:70 == 1
			BASE:MASTER:TSP -= 20
			SOURCE:ARG:快Ｂ += (ABL:C_ID:舌 + 1) * 10
		ELSE
			DOWNBASE:ARG:体力 += 5
			DOWNBASE:ARG:気力 += 20
			DOWNBASE:C_ID:体力 += 5
			DOWNBASE:C_ID:気力 += 10
			SOURCE:ARG:快Ｂ += (ABL:C_ID:舌 + 1) * 10
			SOURCE:ARG:露出 = 20
			SOURCE:ARG:不潔 = 30
			SOURCE:ARG:反感 = 50
			SOURCE:ARG:情愛 += ABL:C_ID:舌 * 5
			SIF ABL:親密 >= 5
				SOURCE:情愛 += (ABL:親密 * 3)
		ENDIF
		;-------------------------------------------------
		;汚れの処理
		;-------------------------------------------------
		;奴隷のＢ⇔調教者の口の汚れが移動
		STAIN:5 |= STAIN:C_ID:0
		STAIN:C_ID:0 |= STAIN:5
		;調教者が猫舌持ちの場合は、調教者に嗜虐快楽経験を追加
		SIF TALENT:C_ID:猫舌
			EXP:C_ID:嗜虐快楽経験 += 1
		EXP:C_ID:口淫経験 ++
		Qol_Info_Count_Array:ARG:Qol_Count_MSexNip += EXP_UP(GETNUM(EXP, "口淫経験"), C_ID) ;qol custom code
		;EXP:乳首 ++
ENDSELECT
RETURN 1

