@ADD_CUSTOM_COM481
#DIM AimedShot
#DIM nDMG
#DIM nDmgType
#DIM COM481_PREV_PAIN
#DIM ShotCount
#DIM DYNAMIC DebugEnabled
;#; DebugEnabled = 1

[IF_NDEBUG]
SIF TARGET == MASTER
    GOTO FIRE_AT_AIR
[ENDIF]

PRINTFORML What are you shooting at?
{
CALL ASK_M(
    @"Cancel", 1,
    @"%CALLNAME:TARGET%", TARGET != MASTER,
    @"The air", 1,
    COND_STR("[DEBUG] Armor Testing", DebugEnabled), DebugEnabled,
    )
}
COM481_PREV_PAIN = PALAM:TARGET:苦痛
SELECTCASE RESULT
CASE 3
    CALL FireWeaponArmorTest
CASE 2
    $FIRE_AT_AIR
    PRINTFORMW You fire your weapon at the air.
    ;ShotCount = GET_INT((MASTER), "Weapon", EQUIP:MASTER:Weapon, "Burst")
    ShotCount = 1
CASE 1
    ShotCount = 1
    FOR LOCAL:8,0,9
        SIF !LOCAL:8
            CONTINUE
        LOCAL:10 = EffectivePenetration(TARGET, AimedShotTranslate:(LOCAL:8), MASTER)
        LOCAL:9 = RESULT:1
        PRINTFORM [{LOCAL:8}] - %AimedShotParts:(LOCAL:8),10,LEFT%
        PRINTFORM (
        IF LOCAL:10
        SIF LOCAL:9
        LOCALS '= @"\@ CLOTHES_TR(CLOTHNAME(LOCAL:9,EQUIP:TARGET:(LOCAL:9))) != "" ? %CLOTHES_TR(CLOTHNAME(LOCAL:9,EQUIP:TARGET:(LOCAL:9)))%  # Natural Armor\@" 
        PRINTFORM  %LOCALS,15,LEFT%: 
        PRINTFORM %SoilStr(TARGET,3,1,LOCAL:9), 10% 
        RESETCOLOR
        PRINTFORM (PM {EffectivePenetration(TARGET, (AimedShotTranslate:(LOCAL:8)), MASTER)/100,2,RIGHT}, {ArmorCharges:TARGET:(LOCAL:9):0,5,RIGHT}/{ArmorCharges:TARGET:(LOCAL:9):1,5,LEFT}kJ)
        ENDIF
        PRINTFORML )
    NEXT
    PRINTFORML [99] - Back
    INPUT
    IF RESULT <= 8
    AimedShot = RESULT
    ELSE
    RETURN
    ENDIF
    PRINTFORMW You fire at %CALLNAME:TARGET%'s %AimedShotParts:AimedShot%.
    VARSET lcDamageDeal
    CALL HIT_BY_CHARACTER(MASTER,TARGET,charaWeaponInts:MASTER:WeaponInventory ? charaWeaponInts:MASTER:WeaponInventory # EQUIP:MASTER:Weapon,0,AimedShot,0,1,1)
    DOWNBASE:TARGET:0 += lcDamageDeal:TARGET:0
    
    LOCAL = PALAM:TARGET:苦痛-COM481_PREV_PAIN
    PALAM:TARGET:苦痛 = COM481_PREV_PAIN
    LOCAL = LOCAL*30/100
    SOURCE:苦痛 = LOCAL
    SOURCE:反感 = GetWeaponScore(EQUIP:MASTER:Weapon, MASTER)
    SOURCE:Terror = GetWeaponScore(EQUIP:MASTER:Weapon, MASTER)
CASEELSE
RETURN -1
ENDSELECT
FOR LOCAL,1,ShotCount+1
    charaWeaponInts:(MASTER):Ammo --
    SIF charaWeaponInts:(MASTER):Ammo <= 0
        BREAK
    CALL PlayFireSound(MASTER)
    firedWeapon:MASTER:0 = charaWeaponInts:MASTER:Loudness
    FOR LOCAL:1,1,GET_TARGETNUM()+1
        SIF TARGET:(LOCAL:1) == MASTER
            CONTINUE
        ;SOURCE:(TARGET:(LOCAL:1)):Terror += (GetWeaponScore(EQUIP:MASTER:Weapon, MASTER)/10)
    NEXT
    CALL FIRE_WEAPON_CHECK(MASTER)
    LOCAL:17 = MIN(500/(charaWeaponInts:(MASTER):Burst+1),50)
    TWAIT LOCAL:17, 1
NEXT
CALL CrippleEffects(TARGET)
TIME ++
RETURN 1

@FIRE_WEAPON_CHECK_ALL
;loudness
FOR LOCAL,0,CHARANUM
    CALL FIRE_WEAPON_CHECK(LOCAL)
NEXT

@FIRE_WEAPON_CHECK(ARG)
SIF !firedWeapon:ARG:0
    RETURN
CALL LOUDNESS_CHECK_ALL(CFLAG:ARG:300,ARG,firedWeapon:ARG:0,@"a %GET_STR(ARG, "Weapon", EQUIP:ARG:Weapon, "名前")% shot", "firearm")
firedWeapon:ARG:0 = 0


@LOUDNESS_CHECK_ALL(nNoiseLocation,ARG,nNoiseLevel,nNoiseReason, nNoiseType)
#DIM nNoiseLevel
#DIMS nNoiseReason
#DIMS nNoiseType
#DIM nNoiseLocation
#DIM investigator
#DIM controlLossMultiplier
#DIM runAwayMultiplier
SIF GET_MAPID(nNoiseLocation) != MAIN_MAP
    RETURN
SIF GROUPMATCH(nNoiseLocation,ROAD_TO(MAIN_MAP),SUKIMA(),MAXROOM,MAXROOM-1,OMANEKIBEYA(),0)
    RETURN
SIF SaveIsEZB
    RETURN
SIF nNoiseLocation == 0
    nNoiseLocation = MINROOM()
SELECTCASE nNoiseType
CASE "firearm"
runAwayMultiplier = 200
controlLossMultiplier = 150
CASE "death"
runAwayMultiplier = 150
controlLossMultiplier = 100
CASEELSE
runAwayMultiplier = 100
controlLossMultiplier = 100
ENDSELECT

FOR investigator,0,CHARANUM
    SIF investigator == ARG && investigator != MASTER
        CONTINUE
    ; SIF investigator == MASTER
    ;     CONTINUE
    SIF GROUPMATCH(CFLAG:(investigator):300,ROAD_TO(MAIN_MAP),SUKIMA(),MAXROOM,MAXROOM-1,0)
        CONTINUE
    SIF GET_MAPID(CFLAG:(investigator):300) != MAIN_MAP
        CONTINUE
    SIF !SHIRAHU(investigator)
        CONTINUE
    SIF DT_EXIST(@"Movement_{investigator}")
        CONTINUE
    CALL NAS_CALC_MOVE(investigator,nNoiseLocation)
    SIF RESULT > nNoiseLevel
        CONTINUE
    IF investigator == MASTER
		CALL COLORMESSAGE(@"You hear %nNoiseReason%!",C_YELLOW,2)
        CONTINUE
    ENDIF
    LOCAL:6 = 0
    LOCAL:7 = 0
    SELECTCASE COMBAT_BRAVERY(investigator)
    CASE 1000
        $InvestigateShots
        SIF GROUPMATCH(CFLAG:(investigator):300,nNoiseLocation)
            CONTINUE
        PRINTFORML %CALLNAME:(investigator)% hears %nNoiseReason% and decides to investigate.
        CALL ForceGoAndMove(investigator, nNoiseLocation)
    CASE IS < 166
        $RunAway
        IF COMBAT_BRAVERY(investigator) < 300
            ;piss self
            SIF RAND(1000) < ((200-COMBAT_BRAVERY(investigator))+(75*PeeBarStage(investigator))) && PeeBarStage(investigator) >= 2
                LOCAL:6 = 1
            SIF RAND(1000) < ((150-COMBAT_BRAVERY(investigator))+(35*PeeBarStage(investigator))) && PooBarStage(investigator) >= 2
                LOCAL:7 = 1
            ;have accident
            IF LOCAL:6 || LOCAL:7
                PRINTFORML %CALLNAME:(investigator)% hears %nNoiseReason% but loses control of %HIS_HER(LOCAL)% %PeeAndPoo(LOCAL:6,LOCAL:7,"bladder","bowels")%...
                IF CFLAG:(investigator):300 == CFLAG:MASTER:300
                    CALL CAUSE_OMORASHI(investigator,LOCAL:6,LOCAL:7)
                ELSE
                    CALL OMORASHI_END(investigator,LOCAL:6,LOCAL:7)
                ENDIF
                RETURN
            ENDIF
        ENDIF
        PRINTFORML %CALLNAME:(investigator)% hears %nNoiseReason% and begins to run away.
        LOCAL:9 = GET_MAPID(CFLAG:(investigator):358) != MAIN_MAP || CFLAG:(investigator):311 == SUKIMA() ? ENTRANCE # CFLAG:(investigator):311
        CALL ForceGoAndMove(investigator, LOCAL:9) 
    CASEELSE
        IF RAND(1000) < COMBAT_BRAVERY(investigator)
            GOTO InvestigateShots
        ELSEIF RAND(1000) > COMBAT_BRAVERY(investigator)*100/runAwayMultiplier
            GOTO RunAway
        ENDIF
    ENDSELECT
NEXT


