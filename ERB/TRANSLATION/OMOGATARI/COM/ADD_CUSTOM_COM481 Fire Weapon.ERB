@FireWeaponArmorTest
#DIMS selectionInfo
#DIM protectionItem
#DIM DYNAMIC shotsToKill,5
#DIM DYNAMIC headShots
#DIM DYNAMIC oneTappedBody
#DIM DYNAMIC oneTappedHead
#DIM STATIC ArmorSuits = 0, 18028, 13103, 18038, 18024
#DIM mobChar
#DIM armorLevel
#DIM gunShots
#DIM fwLineCount
#DIM ArmorSuitSlot
#DIM ArmorSuitID
#DIM nNecroOld
#DIM pelletCount

selectionInfo '= "intro"
mobChar = FREE_MOB_SLOT()
armorLevel = -1
fwLineCount = LINECOUNT
nNecroOld = nNecro
nNecro = MAX(nNecro,1)
VARSET shotsToKill

$NextResult
CLEARLINE LINECOUNT - fwLineCount
SELECTCASE selectionInfo
CASE "intro"
    PRINTFORML =====Armor Testing=====
    PRINTFORML This will test your weapon and its potential damage against a Touhou with Normal resistances against increasing levels of armor.
    PRINTL
    PRINTFORML Current Weapon: %PrintWeaponName(MASTER,,1)%
    PRINTL
    PRINTFORML [0] - Test
    PRINTFORML [1] - Get me out of here!
    PRINTFORML [2] - Help!
    INPUT
    SELECTCASE RESULT
    CASE 0
        selectionInfo '= "testing"
        GOTO NextResult
    CASE 2
        selectionInfo '= "help"
        GOTO NextResult
    CASEELSE
        nNecro = nNecroOld
        RETURN 0
    ENDSELECT
CASE "result"
    PRINTFORML ==Results==
    PRINTFORML %PrintWeaponName(MASTER,,1)% (Pen {CharaWeaponInts:MASTER:Penetration})
    IF charaWeaponAtts:MASTER:9
        PRINTFORMSL GET_STR(MASTER, "WeaponAmmo", charaWeaponAtts:MASTER:9, "名前")
    ELSE
        PRINTFORML %CharaWeaponStrs:MASTER:Ammo% Regular
    ENDIF
    PRINTL
    PRINTFORM %"Head",17,LEFT%: 
    IF oneTappedHead
        SETCOLOR C_D_RED
        PRINTL 1+
        RESETCOLOR
    ELSEIF headShots
        SETCOLOR Color_Gradient_PER(C_GREEN,C_RED,MAX(0,100 - ((headShots-1)*10)))
        PRINTVL headShots
        RESETCOLOR
    ELSE
        PRINTL -
    ENDIF
    FOR armorLevel, 0, 5
        IF !armorLevel
            PRINTFORM %"Unarmored",17,LEFT%: 
        ELSE
            PRINTFORM Level {armorLevel} (VPAM {GET_INT(mobChar, CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(ArmorSuits:armorLevel/1000)), ArmorSuits:armorLevel%1000, "Armor"),2}): 
        ENDIF
        IF GETBIT(oneTappedBody,armorLevel)
            SETCOLOR C_D_RED
            PRINTL 1+
            RESETCOLOR
        ELSEIF shotsToKill:armorLevel
            SETCOLOR Color_Gradient_PER(C_GREEN,C_RED,MAX(0,100 - ((shotsToKill:armorLevel-1)*6)))
            PRINTVL shotsToKill:armorLevel
            RESETCOLOR
        ELSE
            PRINTL -
        ENDIF
    NEXT
    PRINTL
    PRINTFORML [0] - Exit
    PRINTFORML [1] - Change Weapon
    PRINTFORML [2] - Retest
    INPUT
    SELECTCASE RESULT
    CASE 1
        CALL Weapon_Chose_State(MASTER)
        GOTO NextResult
    CASE 2
        selectionInfo '= "testing"
        CALL DELETE_CHARA(mobChar)
        ADDCHARA RANDOM_CHARANUM
        GOTO NextResult
    CASEELSE
    nNecro = nNecroOld
    CALL DELETE_CHARA(mobChar)
    ADDCHARA RANDOM_CHARANUM
    RETURN 1
    ENDSELECT
CASE "help"
    PRINTFORML =====Armor Testing=====
    PRINTFORML This will test your weapon and its potential damage against a 1500 (2000 true) STA Touhou with Normal resistances.
    PRINTFORML 200 shots to penetrate each level of armor.
    PRINTFORML Testing is done at point blank range at the Torso of the Touhou.
    PRINTL
    PRINTFORML ==Rated level of penetration==
    PRINTFORML Lvl 0 cannot defeat any armor type.
    PRINTFORML Lvl 1 can penetrate the %UNDIES_NAME_WITH_BRAND(mobChar,ArmorSuits:1%1000,1,ArmorSuits:1/1000)% (VPAM {GET_INT(mobChar, CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(ArmorSuits:1/1000)), ArmorSuits:1%1000, "Armor")}).
    PRINTFORML Lvl 2 can penetrate the %UNDIES_NAME_WITH_BRAND(mobChar,ArmorSuits:2%1000,1,ArmorSuits:2/1000)% (VPAM {GET_INT(mobChar, CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(ArmorSuits:2/1000)), ArmorSuits:2%1000, "Armor")}).
    PRINTFORML Lvl 3 can penetrate the %UNDIES_NAME_WITH_BRAND(mobChar,ArmorSuits:3%1000,1,ArmorSuits:3/1000)% (VPAM {GET_INT(mobChar, CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(ArmorSuits:3/1000)), ArmorSuits:3%1000, "Armor")}).
    PRINTFORML Lvl 4 can penetrate the %UNDIES_NAME_WITH_BRAND(mobChar,ArmorSuits:4%1000,1,ArmorSuits:4/1000)% (VPAM {GET_INT(mobChar, CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(ArmorSuits:4/1000)), ArmorSuits:4%1000, "Armor")}). This is the rarest armor type.
    PRINTL
    PRINTFORML Head = Shots to kill on the unarmored head.
    PRINTFORML   < 1 represents how many potential headshots it takes to down a Touhou.
    PRINTFORML   1+ means it only takes 1 shot to destroy the head.
    PRINTFORML
    PRINTFORML Body Lvl 0 -> 4 = Shots to kill on the torso, armored according the the Body Lvl.
    PRINTFORML  < 1 represents how many potential bodyshots it takes to down a Touhou.
    PRINTFORML  1+ means it only takes 1 shot to destroy the torso.
    PRINTL
    PRINTFORML [0] - Okay
    INPUT
    selectionInfo '= "intro"
    GOTO NextResult
CASE "testing"
    CALL SpawnMobEnemy(mobChar,1)
    ;normalize resistances
    FOR LOCAL, 0, VARSIZE("DamageResist")
        DamageResist:mobChar:LOCAL:0 = 0
        DamageResist:mobChar:LOCAL:1 = 0
    NEXT
    ;reset
    VARSET oneTappedBody
    VARSET oneTappedHead
    VARSET shotsToKill
    VARSET headShots
    
    FOR armorLevel, -1, 5
        IF armorLevel == -1
            CALL ANIMATION_LOAD_NAS(0, 0, 6, @"Testing armor level: Head"); nas loading
        ELSE
            CALL ANIMATION_LOAD_NAS(armorLevel+1, 0, 6, @"Testing armor level: {armorLevel}"); nas loading
        ENDIF

        ;initialize
        CALLF HESOYAM(mobChar)
        CALLF NudeMe(mobChar)
        gunShots = 0

        ;give armor
        IF armorLevel >= 0
            ArmorSuitID = ArmorSuits:armorLevel%1000
            ArmorSuitSlot = ArmorSuits:armorLevel/1000

            CFLAG:mobChar:(200+ArmorSuitSlot) = ArmorSuitID
            CFLAG:mobChar:(240+ArmorSuitSlot) = ArmorSuitID
            EQUIP:mobChar:ArmorSuitSlot = ArmorSuitID
            CALLF ArmorStats(mobChar, ArmorSuitID,1,,ArmorSuitSlot)
        ENDIF

        ;begin the shooting
        WHILE gunShots<200
            VARSET lcDamageDeal
            FOR pelletCount, 1, charaWeaponInts:(MASTER):Pellets+1
                CALL HIT_BY_CHARACTER(MASTER,mobChar,charaWeaponInts:MASTER:WeaponInventory ? charaWeaponInts:MASTER:WeaponInventory # EQUIP:MASTER:Weapon,0,armorLevel == -1 ? 1 # 2,0,1,1)
                CALL CREATE_HIT_FRAGMENTS(MASTER,mobChar,armorLevel == -1 ? 1 # 2)
                CALL CREATE_HIT_EXPLOSION(MASTER,mobChar,armorLevel == -1 ? 1 # 2)
                CALL HIT_BY_FRAGMENT(mobChar,1,armorLevel == -1 ? 1 # 2)
                CALL HIT_BY_EXPLOSION(mobChar,1,armorLevel == -1 ? 1 # 2)
                BASE:mobChar:0 -= lcDamageDeal:mobChar:0
            NEXT
            CALL CrippleEffects(mobChar)
            gunShots++
            ;check if they're dead
            IF BASE:mobChar:0 < 500 || IsDead:mobChar:0
                IF armorLevel < 0
                    SIF BodyPartHealth:mobChar:1:0 <= -BodyPartHealth:mobChar:1:1 && gunShots == 1
                        oneTappedHead = 1
                    headShots = gunShots
                ELSE
                    SIF BodyPartHealth:mobChar:40:0 <= -BodyPartHealth:mobChar:40:1 && gunShots == 1
                        SETBIT oneTappedBody,armorLevel
                    shotsToKill:armorLevel = gunShots
                ENDIF
                BREAK
            ENDIF
        WEND
    NEXT
    ;give result
    selectionInfo '= "result"
    GOTO NextResult
ENDSELECT

