; Modular ERB: OMOGATARI/COM/ADD_CUSTOM_COM360 Peek-a-Boo.ERB
;-------------------------------------------------
;Peek-a-Boo
;Playing with your toddler
;-------------------------------------------------

@ADD_CUSTOM_COM360
SELECTCASE TFLAG:192
	CASE 0
		LOCAL = RAND:100
		LOCAL:1 = (ABL:MASTER:44*13) + ARM_SUCCESS_RATE() / 5
		SIF LOCAL:1 > 99
			LOCAL:1 = 99
		IF LOCAL <= 9
			;10％で大成功
			EXP:MASTER:会話経験 ++
			TFLAG:193 = 1
			TFLAG:98 = 2
		ELSEIF LOCAL >= LOCAL:1
			;10～1％で失敗
			TFLAG:193 = -1
			TFLAG:98 = -2
		ELSE
			;残りは成功
			TFLAG:193 = 0
			TFLAG:98 = 0
		ENDIF
	CASE 1
		IF RAND:100 <= 9
			;10％で大成功
			EXP:MASTER:会話経験 ++
			TFLAG:193 = 1
			TFLAG:98 = 2
		ELSE
			;残りは成功
			TFLAG:193 = 0
			TFLAG:98 = 0
		ENDIF
	CASE -1
		TFLAG:193 = -1
		TFLAG:98 = -1
	CASE -2
		RETURN 0
ENDSELECT
;先制発生時は失敗しない
SIF TCVAR:20
	TFLAG:193 = MAX(TFLAG:193,0)
DOWNBASE:MASTER:気力 += 50
DOWNBASE:MASTER:体力 += 30
TFLAG:ムード上昇抑制 = 1
;信頼
TFLAG:98 += 3
;その場に居るTARGET全員で回す
LOCAL:1 = TARGET
FOR LOCAL, 1, GET_TARGETNUM() + 1
SIF !TALENT:(TARGET:LOCAL):幼稚 && charaAge:(TARGET:LOCAL):0 > 13
	CONTINUE
SIF CFLAG:(TARGET:LOCAL):睡眠
	CONTINUE
TARGET = TARGET:LOCAL
CALL ADD_CUSTOM_COM360_1
NEXT
TARGET = LOCAL:1
TIME += 10
RETURN 1

@ADD_CUSTOM_COM360_1
DOWNBASE:気力 += 50
;固定で獲得するソース
SOURCE:歓楽 = 1000
;ABL:従順をみる
IF ABL:従順 <= 1
	SOURCE:歓楽 += (ABL:従順 * 60)
ELSEIF ABL:従順 <= 3
	SOURCE:歓楽 += 200 + (ABL:従順 * 65)
ELSEIF ABL:従順 <= 5
	SOURCE:歓楽 += 500 + (ABL:従順 * 65)
ELSEIF ABL:従順 <= 8
	SOURCE:歓楽 += 750 + (ABL:従順 * 85)
ELSEIF ABL:従順 <= 11
	SOURCE:歓楽 += 1000 + (ABL:従順 * 85)
ELSE
	SOURCE:歓楽 += 2000 + (ABL:従順 * 40)
ENDIF
;好感度をみる
IF CFLAG:2 <= 500
	SOURCE:歓楽 += CFLAG:2
ELSEIF CFLAG:2 <= 5000
	SOURCE:歓楽 += 500 + (CFLAG:2 - 500) / 3
ELSE
	SOURCE:歓楽 += 2000 + (CFLAG:2 - 5000) / 5
ENDIF
SIF SOURCE:歓楽 < 0
	SOURCE:歓楽 = 0
SOURCE:受動 = 300 + 150 * ABL:従順
SOURCE:征服 = 300 + 100 * ABL:サドっ気
IF TFLAG:193 == -1
	TIMES SOURCE:歓楽 , 0.10
	TIMES SOURCE:征服 , 0.50
	TIMES SOURCE:受動 , 0.50
ELSEIF TFLAG:193 == 0
	TIMES SOURCE:歓楽 , 1.00
	TIMES SOURCE:征服 , 1.00
	TIMES SOURCE:受動 , 1.00
ELSE
	TIMES SOURCE:歓楽 , 2.00
	TIMES SOURCE:征服 , 2.00
	TIMES SOURCE:受動 , 2.00
ENDIF
CALL SET_DERAY(6,TARGET)
RETURN 1
;@ADD_CUSTOM_CAN_COM489

@ADD_CUSTOM_MESSAGE_COM360
PRINTFORMDW 당신은 %조사처리(CALLNAME:TARGET,"와")% 숨바꼭질을 한다.

@ADD_CUSTOM_COM_ABLE360
; Do not allow during ufufu or time stop
SIF FLAG:70 == 1
	RETURN 0
SIF CFLAG:うふふ != 0
	RETURN 0
SIF !TFLAG:100
	RETURN 0
SIF CFLAG:睡眠
	RETURN 0
SIF TARGET == MASTER ; doesn't make sense to kick yourself out
	RETURN 0
;not finished yet
RETURN 0
RETURN 1
