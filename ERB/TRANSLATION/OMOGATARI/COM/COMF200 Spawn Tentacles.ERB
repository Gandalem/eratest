IF FLAG:70 == 1
	IF !TEQUIP:EStimClit
	ELSE
	ENDIF
ELSE
	IF !TEQUIP:EStimClit
	ELSE
		PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% %PRINT_CLIT(TARGET)%에 접착성 전극을 부착한다.
	ENDIF
ENDIF

@ADD_CUSTOM_COM_ABLE200
RETURN 0
;バイブ実行判定
SIF !TFLAG:100
	RETURN 0
SIF !HasAnyYoujutsu(MASTER)
	RETURN 0
SIF !CFLAG:MASTER:うふふ
	RETURN 0
RETURN 1
