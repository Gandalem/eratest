SIF FLAG:70 == 1 || CFLAG:イタズラ
	Qol_Info_Count_Array:TARGET:Qol_Count_UncUSex ++ ;qol custom code
RETURN 1

@ADD_CUSTOM_CAN_COM161(ARG)
;-------------------------------------------------
;実行判定処理
;-------------------------------------------------
IF FLAG:70 == 1 || CFLAG:イタズラ
	SKIPDISP ARG
	IF CFLAG:PLAYER:現在位置 == 10 || CFLAG:PLAYER:現在位置 == 40
		PRINTL 요도 개 따먹기
	ELSEIF !BEDROOM(CFLAG:PLAYER:現在位置) && !(BATHROOM() && ITEM:20)
		PRINTL 서 있는 요도 강간견
	ELSE
		PRINTL 요도 도기 강간
	ENDIF
ELSE
	;縄で縛られている場合は無視（縄が無い時のみ実行判定を行う）
	IF TEQUIP:縄 == 0
		SKIPDISP ARG
		IF CFLAG:PLAYER:現在位置 == 10 || CFLAG:PLAYER:現在位置 == 40
			PRINTL 요도 강아지
		ELSEIF !BEDROOM(CFLAG:PLAYER:現在位置) && !(BATHROOM() && ITEM:20)
			PRINTL 서 있는 요도 개 자세
		ELSE
			PRINTL 요도 도기
		ENDIF
		A = 0
		S = 0
		;すべての命令に共通の要素を考慮
		;(従順が高いと命令に従いやすいなど)
		CALL COM_ORDER
		;ABL:欲望
		IF ABL:欲望
			SIF S
				PRINT  + 
			A += ABL:欲望 * 3
			PRINT 욕정
			PRINTV 'LV,ABL:欲望,'(,ABL:欲望 * 3,')
			S = 1
		ENDIF
		;USens
		IF ABL:USens
			SIF S
				PRINT  + 
			A += ABL:USens * 2
			PRINT U Sens
			PRINTV 'LV,ABL:USens,'(,ABL:USens * 2,')
			S = 1
		ENDIF
		;快楽刻印
		IF MARK:快楽刻印
			SIF S
				PRINT  + 
			A += MARK:快楽刻印 * 3
			PRINT 쾌락의 낙인
			PRINTV 'LV,MARK:快楽刻印,'(,MARK:快楽刻印 * 3,')
			S = 1
		ENDIF
		;PALAM:潤滑（の不足）
		IF PALAM:潤滑 < PALAMLV:3
			PRINT  - 
			A -= 5
			PRINT 낮은 윤활
			PRINTV '(,5,')
			S = 1
		ENDIF
		;PALAM:欲情
		IF GETPALAMLV(PALAM:欲情,5)
			SIF S
				PRINT  + 
			A += GETPALAMLV(PALAM:欲情,5) * 3
			PRINT 욕정
			PRINTV 'LV,GETPALAMLV(PALAM:欲情,5),'(,GETPALAMLV(PALAM:欲情,5) * 3,')
			S = 1
		ENDIF
		;恥じらい
		IF TALENT:羞恥心 > 0
			PRINT  - 
			A -= 2
			PRINT 수줍음
			PRINTV '(,2,')
			S = 1
		ENDIF
		;快感の否定
		IF TALENT:快感応答 < 0 && !TALENT:恋慕
			PRINT  - 
			A -= 5
			PRINT 쾌감을 거부한다
			PRINTV '(,5,')
			S = 1
		ENDIF
		;男嫌い（恋慕、親愛で無効）
		IF OTOKOGIRAI(TARGET)
			PRINT  - 
			A -= 12
			PRINT 남자 싫어하는 사람
			PRINTV '(,12,')
			S = 1
		ENDIF
		;恋慕
		IF TALENT:恋慕 && ASSIPLAY == 0
			SIF S
				PRINT  + 
			A += 15
			PRINT 연모
			PRINTV '(,15,')
			S = 15
		ENDIF
		;親愛
		IF TALENT:恋慕 > 1 && ASSIPLAY == 0
			SIF S
				PRINT  + 
			A += 5
			PRINT 깊은 연모
			PRINTV '(,5,')
			S = 5
		ENDIF
		;処女
		LOCAL = MAX(10,40 - EXP:UExp)
		IF !CFLAG:TARGET:LostVirginUDay
			PRINT  - 
			A -= LOCAL
			PRINT 요도 처녀
			PRINTV '(,LOCAL,')
			S = 1
			;V経験
		ELSEIF EXP:UExp < EXPLV:2
			PRINT  - 
			A -= 15
			PRINT 부족함 
			PRINT 경험(U) 없음
			PRINTV '(,15,')
			S = 1
		ENDIF
		;調教者がふたなり
		IF (TALENT:PLAYER:2 & 3) == 3
			SIF S
				PRINT  + 
			A += 4
			PRINT 두 명의 여성
			PRINTV '(,4,')
			S = 1
		ENDIF
		;媚薬
		IF TCVAR:媚薬
			SIF S
				PRINT  + 
			A += 6
			PRINT 최음제
			PRINTV '(,6,')
			S = 1
		ENDIF
		Y = 0
		;愛液の汚れ
		SIF STAIN:PLAYER:2 & 1
			Y += 1
		;精液の汚れ
		SIF STAIN:PLAYER:2 & 4
			Y += 3
		;アナルの汚れ
		SIF STAIN:PLAYER:2 & 8
			Y += 7
		SIF STAIN:PLAYER:2 & 16
			Y += 15
		Y = Y * (2 - TALENT:汚臭耐性) / 2
		;汚れあり
		IF Y
			PRINT  - 
			A -= Y
			PRINT 더러운
			;汚臭鈍感
			IF TALENT:汚臭耐性 > 0
				PRINT 악취 내성
			ELSEIF TALENT:汚臭耐性 < 0
				PRINT 악취에 민감함
			ENDIF
			PRINTV '(,Y,')
			S = 1
		ENDIF
		;合計を表示(20以上で実行)
		PRINT  =
		PRINTV A
		V = 20
		SIF A < V
			PRINT  < 
		SIF A == V
			PRINT  =
		SIF A > V
			PRINT  > 
		PRINT 필수 값 
		PRINTV V
	ELSE
		SKIPDISP ARG
		IF !BEDROOM(CFLAG:PLAYER:現在位置) && !(BATHROOM() && ITEM:20)
			PRINTL 구속된 서 있는 요도 도기
		ELSE
			PRINTL 구속된 요도 강아지
		ENDIF
	ENDIF
	WAIT
	SKIPDISP 0
	;実行できない
	SIF A < V
		RETURN 0
ENDIF
SKIPDISP 0
RETURN 1
