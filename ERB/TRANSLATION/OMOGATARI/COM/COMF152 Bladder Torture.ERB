; Modular ERB: OMOGATARI/COM/COMF152 Bladder Torture.ERB
;-------------------------------------------------
;Bladder Torture
;Portal command where you can do various training commands to a 2hu's bladder
;Playing rain sounds, forcing them to put their hands in water, vibrator torture.
;Hard training command level: 2
;Flags required: Urination
;-------------------------------------------------

@ADD_CUSTOM_COM152
PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% 방광을 어떻게 고문할 건가?
PRINTFORML [  0] [ 0] - %조사처리(CALLNAME:TARGET,"의")% 방광을 찌른다
PRINTFORML [  1] [ 1] - %조사처리(CALLNAME:TARGET,"의")% 손을 물에 넣는다
SIF ITEM:1
	PRINTFORML [  2] - %조사처리(CALLNAME:TARGET,"의")% 방광에 마사지기를 대라.
PRINTFORML [  3] - %조사처리(CALLNAME:TARGET,"에게")% 물 1L을 준다.
PRINTFORML [  4] - 물 1L을 마신다.
INPUT
TIME += 1
TFLAG:144 = RESULT
SELECTCASE RESULT
	CASE 0
		CALL Com_BladderPoke
	CASE 1
		CALL Com_WaterHand
	CASE 2
		CALL Com_MassageBladder
	CASE 3
		CALL Com_ForceDrinkWater(TARGET)
	CASE 4
		CALL Com_ForceDrinkWater(MASTER)
ENDSELECT
RETURN 1

@Com_BladderPoke
PRINTFORML 당신의 손가락으로, 당신은 %조사처리(CALLNAME:TARGET,"의")% 방광에 강한 압력을 가한다.
IF PeeBarStage(TARGET) >= 7
	PRINTFORML 그것을 만지면 통제 불가능하게 새기 시작한다...
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 스스로를 화나게 하기 위해 소변을 본다.
	CALL OSHIKKO_OMORASHI(TARGET)
ELSEIF PeeBarStage(TARGET) >= 5
	PRINTFORML 가득 차서 단단하게 느껴진다, 거의 %HE_SHE(TARGET)%가 터지기 직전 같다.
ELSEIF PeeBarStage(TARGET) >= 3
	PRINTFORML 가득 찬 느낌이지만 여전히 말랑하다.
ELSE
	PRINTFORML 허전하고 물렁한 느낌이다.
ENDIF
DOWNBASE:体力 += 50
DOWNBASE:気力 += 60
BASE:尿意 += 50
SOURCE:MASTER:征服 += 5000
SOURCE:欲情 += 1000
SOURCE:恭順 += 1000
SOURCE:苦痛 += 200
SOURCE:反感 += 100
TIME += 4

@Com_WaterHand
PRINTFORML 당신은 물이 가득 담긴 컵을 잡고 %조사처리(CALLNAME:TARGET,"에게")% 그것에 %HIS_HER(TARGET)%의 손을 넣으라고 지시한다.
IF PeeBarStage(TARGET) >= 6
	PRINTFORML %조사처리(CALLNAME:TARGET,"가")% 물에 닿는 순간, %HIS_HER(TARGET)%의 방광 조절 능력은 무의미해진다.
	CALL OSHIKKO_OMORASHI(TARGET)
ELSEIF PeeBarStage(TARGET) >= 4
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 버티려고 애쓰며, 한 손으로는 %HIS_HER(TARGET)% 자신을 잡고 다른 한 손으로는 완전한 변기춤을 추었다.
	PRINTFORML %HE_SHE(TARGET,1)%는 (는) %HIS_HER(TARGET)%의 누출로 작은 물웅덩이를 만든다.
ELSEIF PeeBarStage(TARGET) >= 2
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 절망 속에서 몸을 꿈틀거린다.
ELSE
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 그곳에서 인내심을 갖고 기다린다.
ENDIF
DOWNBASE:体力 += 100
DOWNBASE:気力 += 110
BASE:尿意 += 100
SOURCE:MASTER:征服 += 5000
SOURCE:欲情 += 3000
SOURCE:恭順 += 5000
SOURCE:反感 += 300
TIME += 10

@Com_MassageBladder
PRINTFORML 막대형 마사지기를 꺼내서 %조사처리(CALLNAME:TARGET,"의")% 방광에 대고 전원을 켠다.
IF PeeBarStage(TARGET) >= 5
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 참으려고 애쓰지만 모든 것을 시도해도 그럴 수 없다.
	PRINTFORML 불행하게도, %HIS_HER(TARGET)%의 용감한 노력으로는 홍수를 막기에 충분하지 않았다.
	CALL OSHIKKO_OMORASHI(TARGET)
ELSEIF PeeBarStage(TARGET) >= 2
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 절망적으로 발길질하고 소리를 지른다.
	PRINTFORML %HE_SHE(TARGET,1)%는 %HIS_HER(TARGET)%의 %PeeProtectType(TARGET,1)%에 작은 얼룩을 흘린다.
ELSE
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 비정상적인 감각이 %HIS_HER(TARGET)%의 방광을 공격하자 꿈틀거린다.
ENDIF
DOWNBASE:体力 += 100
DOWNBASE:気力 += 110
BASE:尿意 += 150
SOURCE:MASTER:征服 += 5000
SOURCE:欲情 += 10000
SOURCE:恭順 += 16000
SOURCE:反感 += 1000
TIME += 5

@Com_ForceDrinkWater(ARG)
PRINTFORML 당신은 물 한 리터를 집어 %CALLNAME:ARG%에게 그것을 마시게 한다.
IF TCVAR:ARG:LiquidIntake <= 750
	PRINTFORML %HE_SHE(ARG,1)%은 기꺼이 그것을 모두 마셨다.
	DOWNBASE:体力 -= 250
	DOWNBASE:気力 -= 250
	TCVAR:ARG:PeeConcentration -= 3
	TCVAR:ARG:LiquidIntake += 1000
	SOURCE:MASTER:征服 += 3500
	SOURCE:欲情 += 5000
	SOURCE:恭順 += 8000
	SOURCE:反感 += 600
	TIME += 5
ELSE
	PRINTFORML %CALLNAME:ARG%은 그것을 마시고 싶어 하지 않는 것 같다.
	PRINTFORML %HE_SHE(ARG,1)%은 마지막으로 마신 것 때문에 배가 부르다.
ENDIF

@ADD_CUSTOM_COM_ABLE152
;浣腸実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(152)
	RETURN RESULT
IF FLAG: 70 == 1
ELSE
	;Do not enable if obdience + desire + exposure is less than 7
	SIF ABL:従順 + ABL:欲望 + ABL:露出癖 < 7
		RETURN 0
ENDIF
;'nuff said
SIF !GETBIT(nPee, 1)
	RETURN 0
RETURN 1
