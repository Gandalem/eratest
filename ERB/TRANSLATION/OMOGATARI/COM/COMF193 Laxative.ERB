; Modular ERB: OMOGATARI/COM/COMF193 Laxative.ERB
;-------------------------------------------------
;利尿剤
;特殊コマンド
;-------------------------------------------------

@ADD_CUSTOM_COM193
ITEM:314 -= 1
DrugStats:TARGET:LaxativeTime += 210
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
;調教者が調合知識を持っていれば消費を抑えられる
IF TALENT:PLAYER:調合知識
	DOWNBASE:体力 += 100
	DOWNBASE:気力 += 100
ELSE
	DOWNBASE:体力 += 200
	DOWNBASE:気力 += 200
ENDIF
SOURCE:逸脱 = 800
;利尿剤効果で軽く変動
SOURCE:反感 = 150
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF FLAG:70 == 1
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ELSE
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ENDIF
RETURN 1

@ADD_CUSTOM_MESSAGE_COM193
IF CFLAG:MASTER:イタズラ == 2
	PRINTFORM 당신 조심스럽게 %PARSE("insert")% 잠든 %CALLNAME:TARGET%'의 항문에 좌약을 넣었다.
	SIF ABL:PLAYER:技巧 >= 3
		PRINT  윤활제로
	PRINT
	PRINTFORML ...
	PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 갑자기 배변하고 싶은 충동을 느끼며 자신의 허벅지(%HIS_HER(TARGET)%)를 비빈다...
ELSE
	PRINTFORM 당신 \@ ABL:従順 <= 2 ? 강제로 %" "% #  \@%PARSE("insert")% 좌약은 ~안으로 %조사처리(CALLNAME:TARGET,"의")% 항문
	;調教者の技巧LV3以上
	SIF ABL:PLAYER:技巧 >= 3
		PRINT  윤활제로
	;従順LV2以下
	SIF ABL:従順 <= 2
		PRINT
	PRINTFORML ...
	PRINTFORML 다가오는 사고를 막으려고 최선을 다하는 %HE_SHE(TARGET)%의 옆에서 %조사처리(CALLNAME:TARGET,"가")% 운다...
ENDIF
;-------------------------------------------------
;実行判定
;-------------------------------------------------

@ADD_CUSTOM_COM_ABLE193
;利尿剤実行判定
SIF !TFLAG:100
	RETURN 0
SIF !nScat
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(182)
	RETURN RESULT
;アイテムを持っているか、アイテムなし設定でないとダメ
SIF ITEM:314 == 0 && NOITEM == 0
	RETURN 0
;薬毒耐性の場合、直接注入以外ダメ
SIF DrugAddict:TARGET:0 >= 6
	RETURN 0
;新妻プレイ中はダメ
SIF TEQUIP:33
	RETURN 0
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
RETURN 1
