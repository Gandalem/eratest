@Com_EatShit(ARG)
;based on sqn/akuma maid
SIF ARG
    GOTO OVERRIDE
SIF !GETBIT(nScat,3)
    RETURN -1

PRINTFORML Eat poo yourself, or make %CALLNAME:TARGET% do it?
CALL ASK_M("Yourself", 1, CALLNAME:TARGET, 1, "Cancel", 1)
SIF RESULT == 2
	RETURN -1
IF RESULT == 0 ;drinking semen yourself
$OVERRIDE
	TFLAG:194 = 1 ;flag for self
	
	STAIN:MASTER:口 |= 512
	CFLAG:MASTER:口に精液 = 1
	
	IF FLAG:70 == 1
		BASE:MASTER:TSP -= 50
	ELSE
		DOWNBASE:MASTER:気力 += 100
	ENDIF
	
	;ABL:PeeDrinkAddictをみる
	SELECTCASE ABL:MASTER:PooEatAddict
	CASE 0
		PRINTFORML Not being able to handle feces too well, you throw most of it out...
		TFLAG:ScatBowl = MULTIPLY(TFLAG:ScatBowl, 25)
	CASE 1
		PRINTFORML Not being able to handle feces too well, you throw half of it out...
		TFLAG:ScatBowl = MULTIPLY(TFLAG:ScatBowl, 50)
	CASE 2
		PRINTFORML Not being able to handle feces too well, you throw some out...
		TFLAG:ScatBowl = MULTIPLY(TFLAG:ScatBowl, 75)
	ENDSELECT
	SELECTCASE EXP:MASTER:GeneralPoopExp
	CASE IS < 5
		TIMES DOWNBASE:MASTER:気力, 4.00
	CASE IS < 20
		TIMES DOWNBASE:MASTER:気力, 2.00
	CASE IS < 50
		TIMES DOWNBASE:MASTER:気力, 1.50
	CASE IS < 100
		TIMES DOWNBASE:MASTER:気力, 1.20
	CASE IS < 300
	CASEELSE
		TIMES DOWNBASE:MASTER:気力, 0.50
	ENDSELECT
	;loves semen
	SIF TALENT:MASTER:PeeDrinker
		SOURCE:MASTER:快Ｍ += (TFLAG:ScatBowl * 10) / 2
	
	IF SHIRAHU(TARGET)
		SIF ABL:PeeDrinkAddict >= 3
			SOURCE:欲情 = (TFLAG:ScatBowl + 4)/5 * 100 + 150 * ABL:サドっ気
		SOURCE:逸脱 = (TFLAG:ScatBowl + 4)/5 * 100
		SOURCE:不潔 = (TFLAG:ScatBowl + 4)/5 * 10

		IF ABL:サドっ気 < 3
			;精液経験をみる
			SELECTCASE EXP:GeneralPoopExp
			CASE IS < 5
				TIMES SOURCE:MASTER:逸脱, 2.00
				TIMES SOURCE:不潔, 3.00
			CASE IS < 20
				TIMES SOURCE:逸脱, 1.50
				TIMES SOURCE:不潔, 2.00
			CASE IS < 50
				TIMES SOURCE:逸脱, 1.25
				TIMES SOURCE:不潔, 1.50
			CASE IS < 100
				TIMES SOURCE:逸脱, 1.00
				TIMES SOURCE:不潔, 1.20
			CASE IS < 300
				TIMES SOURCE:逸脱, 0.50
				TIMES SOURCE:不潔, 1.00
			CASEELSE
				TIMES SOURCE:逸脱, 0.50
				TIMES SOURCE:不潔, 0.50
			ENDSELECT
		ELSE
			TIMES SOURCE:逸脱, 0.25
            TIMES SOURCE:不潔, 0
			SOURCE:強要 = (TFLAG:ScatBowl + 4)/5 * 500
			SOURCE:加虐 = (TFLAG:ScatBowl + 4)/5 * 500
		ENDIF
		SELECTCASE ABL:PooEatAddict
		CASE 0
			TIMES SOURCE:欲情, 0.10
		CASE 1
			TIMES SOURCE:欲情, 1.00
		CASE 2
			TIMES SOURCE:欲情, 1.20
		CASE 3
			TIMES SOURCE:欲情, 1.40
		CASE 4
			TIMES SOURCE:欲情, 1.80
		CASEELSE
			TIMES SOURCE:欲情, 2.00
		ENDSELECT
	ENDIF
	SIF SOURCE:欲情 > 20000
		SOURCE:欲情 = 20000
	
		EXP:MASTER:GeneralPoopExp += TFLAG:ScatBowl/100
	RETURN 1
ENDIF

