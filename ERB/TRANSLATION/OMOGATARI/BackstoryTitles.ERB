; Modular ERB: OMOGATARI/BackstoryTitles.ERB
;Returns a short hand title akin to Rimworld

@CharaStoryTitles(ARG)
#FUNCTIONS
VARSET LOCALS
LOCALS = %nameArray:ARG:na_ShortTitle%
SIF LOCALS == ""
	LOCALS = Resident
RETURNF LOCALS

@STNAME(ARG)
#FUNCTIONS
RETURNF @"%CALLNAME:ARG%, %CharaStoryTitles(ARG)%"
