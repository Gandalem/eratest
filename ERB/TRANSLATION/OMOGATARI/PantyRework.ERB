@PANTY_REWORK_DISPLAY_COLLECTION_B(C_ID,ARG:0=0,ARG:1=0)
#DIM C_ID
#DIM PRDCB_TYPE
#DIM PRDCB_COUNT
#DIM PRDCB_INLINE
#DIM PRDCB_TOTAL
#DIM PRDCB_CONFIRM
#DIM PRDCB_CONFIRM_PAJAMA
#DIM PRDCB_TYPE_HAS
#DIM PRDCB_POSSIBLE
#DIM PRDCB_CONDITION_CAN
#DIMS PRDCB_CONDITION
#DIMS PRDCB_HTML

#DIM CONST PADDING = 38 ;custom code

VARSET RESULT
VARSET PRDCB_HTML
PRDCB_TOTAL = 0
PRDCB_CONFIRM = CFLAG:C_ID:下半身下着確認
PRDCB_CONFIRM_PAJAMA = CFLAG:C_ID:パジャマ下半身下着確認
PRDCB_TYPE_HAS = 0
PRDCB_INLINE = 0
PRDCB_POSSIBLE = 0

;以後、女性とふた
FOR PRDCB_TYPE,0,MAXPANTS
	PRDCB_COUNT = PANTY_REWORK_IN_COLLECTION(C_ID,PRDCB_TYPE,"PantyCollection")
	IF PRDCB_COUNT
		PRDCB_TOTAL += PRDCB_COUNT
		PRDCB_TYPE_HAS ++
		PRDCB_POSSIBLE ++
		;PRDCB_INLINE ++
		SIF PRDCB_TYPE == 18
			SETCOLOR C_H_PINK
	ELSE
		SIF !GET_INT(C_ID, "下半身下着_ずらし可能", PRDCB_TYPE, "コレクション表示可能")
			CONTINUE
		;Tags check
		SIF UnderwearTagScore(C_ID,PRDCB_TYPE) <= -100
			CONTINUE
		PRDCB_POSSIBLE ++
		;PRDCB_INLINE ++
		;SETCOLOR C_GRAY
	ENDIF
	SIF !STRLENS(PRDCB_HTML)
		PRDCB_HTML '= "　"
	;custom code, formatting printing
	LOCALS = %PANTY_REWORK_COLLECTION_B_PANTS_STR(C_ID, PRDCB_TYPE, PRDCB_COUNT)%
	IF HTML_STRINGLEN(LOCALS) > PADDING
		;using the second-last entry, make a new line
		IF PRDCB_INLINE % ((MAXWIDTH()/PADDING)-1) == 0 && PRDCB_INLINE % (MAXWIDTH()/PADDING) != 0
			PRDCB_INLINE = -1
			HTML_PRINT PRDCB_HTML
			VARSET PRDCB_HTML
		ENDIF
		PRDCB_INLINE ++
	ENDIF

	$PRDCB_INPUT
	PRDCB_HTML += LOCALS
	PRDCB_INLINE ++
	
	IF PRDCB_INLINE % (MAXWIDTH()/PADDING) == 0 && PRDCB_INLINE
		PRDCB_INLINE = 0
		HTML_PRINT PRDCB_HTML
		VARSET PRDCB_HTML
	ENDIF
NEXT
SIF PRDCB_INLINE
	PRINTL

CFLAG:C_ID:下半身下着確認 = PRDCB_CONFIRM
CFLAG:C_ID:パジャマ下半身下着確認 = PRDCB_CONFIRM_PAJAMA

RETURN PRDCB_TOTAL, PRDCB_TYPE_HAS,PRDCB_POSSIBLE

