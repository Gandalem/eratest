;Reworked Panty Thieving System
;Uses Enter's Datatables


@PantyTableCreate(TEMP = 0)
#FUNCTION
#DIMS nTableName
#DIM DYNAMIC TEMP
IF TEMP
	nTableName '= @"PANTS_TEMP"
ELSE
	nTableName '= @"PantyCollection"
ENDIF
DT_CREATE nTableName
DT_COLUMN_ADD nTableName, "chara", "int16"
DT_COLUMN_ADD nTableName, "panty", "int16"
REPEAT VARSIZE("DiapeLiquidSoil")
	DT_COLUMN_ADD nTableName, @"liquidSoil{COUNT}", "int32"
REND
REPEAT VARSIZE("DiapeSolidSoil")
	DT_COLUMN_ADD nTableName, @"solidSoil{COUNT}", "int32"
REND
DT_COLUMN_ADD nTableName, "corpseTaint", "int32"
DT_COLUMN_ADD nTableName, "liquidSoilBit", "int32"
DT_COLUMN_ADD nTableName, "solidSoilBit", "int32"
DT_COLUMN_ADD nTableName, "isWashed", "int16"
DT_COLUMN_ADD nTableName, "washingTimer", "int16"

;ARG: Target
;PANTY: What panty the Touhou is wearing
;ARG: Table
    ;PantyCollection = permanent storage
    ;PANTS_TEMP      = temp storage
;I_ID: Panty ID to import from
;Testing: PANTY_REWORK_GO_COLLECTION(17,103, "PANTS_TEMP") (should give Alice a fantastabab)
@PANTY_REWORK_GO_COLLECTION(ARG, PANTY, ARGS = "PantyCollection", I_ID = 0, HAS_SOIL = 1)
#FUNCTION
#DIM DYNAMIC PANTY
#DIM DYNAMIC T_ID
#DIM DYNAMIC I_ID
#DIM DYNAMIC HAS_SOIL
DT_ROW_ADD ARGS, "chara", ARG, "panty", PANTY
T_ID = RESULT
SIF HAS_SOIL
CALLF PANTY_REWORK_ADD_SOIL(ARG, T_ID, ARGS, I_ID)
RETURNF T_ID

@PANTY_REWORK_ADD_SOIL(ARG, T_ID, ARGS, I_ID = 0)
#FUNCTION
#DIM DYNAMIC T_ID
#DIM DYNAMIC I_ID
;DEBUGPRINTFORML Importing from: {I_ID} - Exporting to: {T_ID}
FOR LOCAL,0,VARSIZE("DiapeLiquidSoil")
    DT_CELL_SET ARGS, T_ID, @"liquidSoil{LOCAL}", (I_ID ? DT_CELL_GET("PANTS_TEMP", I_ID,  @"liquidSoil{LOCAL}", 1) # DiapeLiquidSoil:ARG:LOCAL), 1
NEXT

FOR LOCAL,0,VARSIZE("DiapeSolidSoil")
    DT_CELL_SET ARGS, T_ID, @"solidSoil{LOCAL}", (I_ID ? DT_CELL_GET("PANTS_TEMP", I_ID,  @"solidSoil{LOCAL}", 1) # DiapeSolidSoil:ARG:LOCAL), 1
NEXT

DT_CELL_SET ARGS, T_ID, @"liquidSoilBit", (I_ID ? DT_CELL_GET("PANTS_TEMP", I_ID,  @"liquidSoilBit", 1) # PANTY_REWORK_SOILBIT(ARG, ARGS, T_ID, "liquid")), 1
DT_CELL_SET ARGS, T_ID, @"solidSoilBit", (I_ID ? DT_CELL_GET("PANTS_TEMP", I_ID,  @"solidSoilBit", 1) # PANTY_REWORK_SOILBIT(ARG, ARGS, T_ID, "solid")), 1
DT_CELL_SET ARGS, T_ID, @"isWashed", (I_ID ? DT_CELL_GET("PANTS_TEMP", I_ID,  @"isWashed", 1) # 0), 1
DT_CELL_SET ARGS, T_ID, @"washingTimer", (I_ID ? DT_CELL_GET("PANTS_TEMP", I_ID,  @"washingTimer", 1) # 0), 1



@PANTY_REWORK_IN_COLLECTION(ARG,nGetPanty,ARGS = "PantyCollection")
#FUNCTION
#DIM nGetPanty
RETURNF DT_SELECT(ARGS, @"chara = {ARG} and panty = {nGetPanty}")

@PANTY_REWORK_GET(ARG,ARGS)
#DIM PANTY
SIF !EQUIP:ARG:下半身下着２ ;bugfix custom code, panties must exist
	RETURN
PANTY = EQUIP:ARG:下半身下着２
CALL PANTY_REWORK_GETTING(ARG, PANTY)
;custom code, if ARGS != "もらう" the panty wasn't given willingly, so is AWOL
CALL PANTY_AWOL(ARG,ARGS != "もらう")

;achievements
SIF PANTY_REWORK_IS_SOIL(ARG,"liquid",0) && PANTY_REWORK_IS_SOIL(ARG,"liquid",3) && PANTY_REWORK_IS_SOIL(ARG,"solid",0)
    CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("soilPeePoopCum")
SIF PANTY_REWORK_IS_SOIL(ARG,"liquid",0) && PANTY_REWORK_IS_SOIL(ARG,"liquid",1) && PANTY_REWORK_IS_SOIL(ARG,"liquid",2)
    CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("soilPeeBloodJuice")

CFLAG:ARG:ノーパン = 1
EQUIP:ARG:下半身下着２ = 0
CALL CLOTHES_SETTING_TRAIN(ARG)

SIF CFLAG:ARG:パジャマ == 1
	CFLAG:ARG:パジャマパンツ = 0

SIF ARGS == "もらう"
	CFLAG:ARG:ノーパン = 2
CALLF DiapeStats(ARG,0,1)
;qol custom code
CALL PANTY_SPECIAL_GET(ARG, PANTY)

@PANTY_REWORK_GETTING(ARG, PANTY)
#DIM PANTY
#DIM GAP_USED
;addition custom code, duplicated characters
#DIM ACTUAL_CHARACTER
#DIMS HTML
#DIM P_ID

GAP_USED = 0
ACTUAL_CHARACTER = NO:(ARG)
P_ID = PANTY_REWORK_GO_COLLECTION(ARG, PANTY, "PANTS_TEMP")
;PANTS_TEMP:ACTUAL_CHARACTER:PANTY += 1

IF ITEM:コレクションのスキマ
	IF FLAG:Cスキマ自動仕様
		CALL PANTY_REWORK_COLLECTORS_GAP(P_ID)
		GAP_USED = RESULT
	ELSEIF FLAG:パンツ輸送 == 0
		IF CFLAG:MASTER:現在位置 != CFLAG:MASTER:初期位置
			HTML '= @"Use a Collector's Gap (Remaining：{ITEM:コレクションのスキマ}) to add "
		;custom code, only way to translate this to english
		ELSE
			HTML '= @"Add "
		ENDIF
		SIF PANTY_REWORK_IN_COLLECTION(ARG, PANTY, "PantyCollection") == 0
			SETCOLOR C_PINK
		HTML += HTML_PRINT_NAS(@"%CALLNAME:ARG%'s %UNDIES_NAME_WITH_BRAND(ARG, PANTY)% ")
        SIF STRLENS(PANTY_REWORK_SOILSTR(ARG,1))
        HTML += @"(%PANTY_REWORK_SOILSTR(ARG,1,1)%) "
		RESETCOLOR
		HTML += "to your collection?"
        HTML_PRINT HTML
		CALL ASK_YN
		IF !RESULT
			CALL PANTY_REWORK_COLLECTORS_GAP(P_ID)
			GAP_USED = RESULT
		ENDIF
	ENDIF
ENDIF
SIF !GAP_USED
	FLAG:パンツ輸送 = 1
RETURN GAP_USED

;controls collector's gaps being used
@PANTY_REWORK_COLLECTORS_GAP(P_ID)
#DIM PANTY
#DIM GAP_USED
;addition custom code, duplicated characters
#DIM ACTUAL_CHARACTER
#DIM P_ID
SIF !P_ID
	RETURN 0

GAP_USED = 0
ACTUAL_CHARACTER = DT_CELL_GET("PANTS_TEMP", P_ID,  @"chara", 1)
PANTY = DT_CELL_GET("PANTS_TEMP", P_ID,  @"panty", 1)
;move panties to collection
; FOR LOCAL, 1, DT_SELECT("PANTS_TEMP", @"chara = {ARG} and panty = {PANTY}")+1
;     P_ID = RESULT:LOCAL
;     CALLF PANTY_REWORK_GO_COLLECTION(ARG, PANTY, "PantyCollection", P_ID)
;     DT_ROW_REMOVE "PANTS_TEMP", P_ID
; NEXT
CALLF PANTY_REWORK_GO_COLLECTION(ACTUAL_CHARACTER, PANTY, "PantyCollection", P_ID)
DT_ROW_REMOVE "PANTS_TEMP", P_ID

IF CFLAG:MASTER:現在位置 != CFLAG:MASTER:初期位置
	ITEM:コレクションのスキマ -= 1
	PRINTFORMW You open up a Collector's Gap and toss %CALLNAME:ACTUAL_CHARACTER%'s %COND_STR("soiled ",STRLENS(PANTY_REWORK_SOILSTR(ACTUAL_CHARACTER,,,"PANTS_TEMP",P_ID)))%%UNDIES_NAME_WITH_BRAND(ACTUAL_CHARACTER, PANTY)% inside.
ELSE
	PRINTFORMW %CALLNAME:ACTUAL_CHARACTER%'s %UNDIES_NAME_WITH_BRAND(ACTUAL_CHARACTER, PANTY)% added to your collection!
ENDIF 
GAP_USED = 1
CALL PANTY_REWORK_UPDATE_STATUS
RETURN GAP_USED

@PANTY_REWORK_SOILBIT(ARG, TABLE_NAME = "", TABLE_ID = 0, nType = "")
#FUNCTION
#DIM nBIT
#DIMS 	DYNAMIC TABLE_NAME
#DIM 	DYNAMIC TABLE_ID
#DIMS 	DYNAMIC nType
VARSET nBit

SELECTCASE nType
CASE "liquid"
	FOR LOCAL,0,VARSIZE("DiapeLiquidSoil")
		SIF PANTY_REWORK_IS_SOIL(ARG,"liquid",LOCAL,TABLE_NAME,TABLE_ID)
			SETBIT nBit, LOCAL
	NEXT
CASE "solid"
	FOR LOCAL,0,VARSIZE("DiapeSolidSoil")
		SIF PANTY_REWORK_IS_SOIL(ARG,"solid",LOCAL,TABLE_NAME,TABLE_ID)
			SETBIT nBit, LOCAL
	NEXT
ENDSELECT
RETURNF nBit

