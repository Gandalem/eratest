@NAS_GodPrayerEffect(ARG, ARG:1)
SELECTCASE ARG:1
	;NAS:
	CASE 15
		TALENT:ARG:USens++
	CASE 900
		TALENT:ARG:96 = LIMIT(TALENT:ARG:97-1,-4,3)
		TALENT:ARG:97 = LIMIT(TALENT:ARG:97-1,-4,3)
		CALLF AddBionic(ARG,74,106-(TALENT:ARG:BladderSize),0)
		CALLF AddBionic(ARG,67,115-(TALENT:ARG:BowelSize),0)
	CASE 32
		;regression
		MARK:ARG:RegressionMark --
		SETCOLOR 247,171,166
		PRINTFORML A sense of maturity flows through %CALLNAME:TARGET%...
		PRINTFORMW %CALLNAME:TARGET% went down to Regression Mark LV{MARK:ARG:RegressionMark}!
		RESETCOLOR
		TFLAG:193 = 30
	CASE 9010
		;continence 
		SIF INRANGE(PeeHold:TARGET:0,-4,5)
		PeeHold:TARGET:0 ++
		SIF INRANGE(PooHold:TARGET:0,-4,5)
		PooHold:TARGET:0 ++
		PRINTFORMW %CALLNAME:TARGET%'s got better at potty training!
		GOTO ContChangeAfter
	CASE 9011
		;incontinence
		SIF INRANGE(PeeHold:TARGET:0,-4,5)
		PeeHold:TARGET:0 --
		SIF INRANGE(PooHold:TARGET:0,-4,5)
		PooHold:TARGET:0 --
		PRINTFORMW %CALLNAME:TARGET%'s lost a bit of control!
		$ContChangeAfter
		PeeHoldExp:TARGET:0 = EXP_DEMAND_20(0,91,TARGET)
		PooHoldExp:TARGET:0 = EXP_DEMAND_21(0,92,TARGET)
		CALLF SILENT_ENDURANCECHANGE(TARGET)
		CALLF ResetBladders(TARGET)	
		PRINTFORM %CALLNAME:TARGET%'s potty training abilities are now at level 
		SETCOLOR C_YELLOW
		PRINTFORM {PeeHold:TARGET:0}【%GET_TALENTNAME_TR(1514, TALENT:TARGET:57)%】
		IF nScat
		RESETCOLOR
		PRINTFORM /
		SETCOLOR 0x6b4737
		PRINTFORML {PooHold:TARGET:0}【%GET_TALENTNAME_TR(1500, TALENT:TARGET:58)%】
		ENDIF
		RESETCOLOR
		WAIT
	;=======================
	;Ported from Vanilla:
	CASE 1
		MARK:ARG:反発刻印 --
		CALL ASK_M("Remove Old Hate Mark as well",1,"Leave history alone",1)
		SIF !RESULT
			MARK:ARG:反発取得履歴 = MAX(MARK:ARG:反発取得履歴 - 1, 0)
		TFLAG:193 = 30
	CASE 2
		FLAG:願掛け内容 = 999
	CASE 3
		CFLAG:MASTER:魔力回収 = 1
		SIF (CFLAG:MASTER:小槌 == 4 || CFLAG:MASTER:小槌 == 5) && TALENT:MASTER:形状 == 2
			TALENT:MASTER:形状 = CFLAG:MASTER:382
	CASE 4
		CFLAG:ARG:時間停止バレ = 0
	CASE 5
		FLAG:願掛け内容 = 204
		TFLAG:193 = 200
		FLAG:開運大紋購入回数 = 1
		BASE:53:体力 = 1
		BASE:53:気力 = 0
	CASE 6
		FLAG:願掛け内容 = 206
		IF FLAG:子宝祈願 == TARGET
			CFLAG:子宝補正 ++
		ELSE
			FOR LOCAL,1,CHARANUM
				CFLAG:LOCAL:子宝補正 = 0
			NEXT
			CFLAG:子宝補正 ++
		ENDIF
		SIF TALENT:妊娠願望
			CFLAG:子宝補正 ++
		SIF TALENT:恋人
			CFLAG:子宝補正 ++
		FLAG:子宝祈願 = TARGET
	CASE 7
		ABL:ARG:サドっ気 -= 1
		JUEL:ARG:優越 = 0
		EXP:ARG:嗜虐快楽経験 = MAX(EXP:ARG:嗜虐快楽経験 - 200, 0)
	CASE 8
		MARK:ARG:反発取得履歴 = 0
		TFLAG:193 = 35
	;=============
ENDSELECT

@PANTY_REWORK_MOST_VALUABLE(ARGS,C_ID,P_COMP)
#FUNCTION
#DIM C_ID
#DIM P_COMP
#DIM P_ID
#DIM PANTY
#DIM TABLE_SIZE
#DIM TEMP_TABLE, 1000
VARSET TEMP_TABLE
PANTY = DT_CELL_GET(ARGS, P_COMP, "panty", 1)


;dupe checking
DT_SELECT ARGS, @"chara = {C_ID} and panty = {PANTY} and liquidSoilBit = {DT_CELL_GET(ARGS, P_COMP, "liquidSoilBit", 1)} and solidSoilBit = {DT_CELL_GET(ARGS, P_COMP, "solidSoilBit", 1)}", "", TEMP_TABLE
IF P_COMP != TEMP_TABLE:0
	DEBUGPRINTFORML {P_COMP} (%CALLNAME:C_ID% - %PANTSNAME(PANTY,C_ID)%) is a duplicate of {TEMP_TABLE:1}
	RETURNF -1
ENDIF

TABLE_SIZE = DT_SELECT(ARGS, @"chara = {C_ID} and panty = {PANTY}", "", TEMP_TABLE)
FOR LOCAL, 0, TABLE_SIZE+1
	P_ID = TEMP_TABLE:LOCAL
	SIF P_ID == P_COMP 	;same panty
		CONTINUE
	SIF !P_ID
		BREAK
	IF PANTY_REWORK_VALUE(ARGS,P_COMP) < PANTY_REWORK_VALUE(ARGS,P_ID) 
		DEBUGPRINTFORML {P_COMP} (¥{PANTY_REWORK_VALUE(ARGS,P_COMP)}) has less value than {P_ID} (¥{PANTY_REWORK_VALUE(ARGS,P_ID)})
		RETURNF 0
	ENDIF
NEXT
RETURNF 1

