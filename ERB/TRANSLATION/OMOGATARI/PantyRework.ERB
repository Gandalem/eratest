@PANTY_REWORK_SOILSTR(ARG,isShort,isHTML, TABLE_NAME = "", TABLE_ID = 0, bypassWashing = 0)
#FUNCTIONS
#DIMS nSTR
#DIM DYNAMIC isShort
#DIM DYNAMIC isHTML
#DIMS DYNAMIC TABLE_NAME
#DIM DYNAMIC TABLE_ID
#DIM DYNAMIC bypassWashing
VARSET nSTR
;DEBUGPRINTFORML Importing from: {TABLE_ID} (%TABLE_NAME%)

IF TABLE_ID && !bypassWashing
	SIF DT_CELL_GET(TABLE_NAME,TABLE_ID, "isWashed", 1) == 1
		RETURNF "Wash"
ENDIF

FOR LOCAL,0,VARSIZE("DiapeLiquidSoil")
    SIF PANTY_REWORK_IS_SOIL(ARG,"liquid",LOCAL,TABLE_NAME,TABLE_ID)
        nSTR += @"%UndiesSoilingType("liquid", LOCAL, isShort, isHTML)%/"
NEXT
FOR LOCAL,0,VARSIZE("DiapeSolidSoil")
	IF DT_CELL_GET(TABLE_NAME,TABLE_ID, "isWashed", 1) == -1 && !bypassWashing
		;going to use Scr to mean scraped solids
		nSTR += @"Scr/"
		BREAK
	ENDIF
	SIF PANTY_REWORK_IS_SOIL(ARG,"solid",LOCAL,TABLE_NAME,TABLE_ID)
        nSTR += @"%UndiesSoilingType("solid", LOCAL, isShort, isHTML)%/"
NEXT
;coprse taint
SIF PANTY_REWORK_IS_SOIL(ARG,"corpse taint",0)
    nSTR += @"%UndiesSoilingType("corpse taint", 0, isShort, isHTML)%/"
RETURNF SUBSTRING(nSTR,0,STRLENS(nSTR)-1)

;soiling is above threshold
@PANTY_REWORK_IS_SOIL(ARG,nType,nThing, TABLE_NAME = "", TABLE_ID = 0)
#FUNCTION
#DIMS nType
#DIM nThing
#DIMS DYNAMIC TABLE_NAME
#DIM DYNAMIC TABLE_ID
#DIM DYNAMIC SOIL_ABS	;absolute minimum
#DIM DYNAMIC SOIL_PER	;percetange it's soiled
#DIM DYNAMIC SOIL_GET	;soiling got
SIF ARG >= CHARANUM
	RETURNF 0
SELECTCASE nType
CASE "liquid"
    SELECTCASE nThing
    CASE 0 ;urine
        ;300ml
		SOIL_ABS = 300
		;30% soiled
		SOIL_PER = 30
    CASE 1 ;Menstrual Blood
        ;50ml
        SOIL_ABS = 50
        ;10% soiled
		SOIL_PER = 10
    CASE 2 ;pussy juice
        ;50ml
        SOIL_ABS = 50
        ;10% soiled
		SOIL_PER = 10
    CASE 3 ;semen
        ;50ml
        SOIL_ABS = 50
        ;10% soiled
		SOIL_PER = 10
    ENDSELECT
CASE "solid"
    SELECTCASE nThing
    CASE 0 ;poop
        ;150g
        SOIL_ABS = 150
        ;15% soiled
        SOIL_PER = 15
    CASE 1 ;egg
        ;150g
        SOIL_ABS = 150
        ;15% soiled
        SOIL_PER = 15
    ENDSELECT
CASE "corpse taint"
	SOIL_ABS = 1
ENDSELECT
;no type
SIF !SOIL_ABS && !SOIL_PER
	RETURNF 0

SELECTCASE nType
CASE "liquid"
	IF TABLE_ID
		SOIL_GET = DT_CELL_GET(TABLE_NAME, TABLE_ID,  @"liquidSoil{nThing}", 1)
	ELSE
		SOIL_GET = DiapeLiquidSoil:ARG:nThing
	ENDIF
	;absolute value
	SIF SOIL_GET > SOIL_ABS
		RETURNF 1
	;percentage
	SIF SOIL_GET > (DiapeCharges:ARG:1*SOIL_PER/100)
		RETURNF 1
CASE "solid"
	IF TABLE_ID
		SOIL_GET = DT_CELL_GET(TABLE_NAME, TABLE_ID,  @"solidSoil{nThing}", 1)
	ELSE
		SOIL_GET = DiapeSolidSoil:ARG:nThing
	ENDIF
	;absolute value
	SIF SOIL_GET > SOIL_ABS
		RETURNF 1
	;percentage
	SIF SOIL_GET > (DiapePooCharges:ARG:1*SOIL_PER/100)
		RETURNF 1
CASE "corpse taint"
	IF TABLE_ID
		RETURNF DT_CELL_GET(TABLE_NAME, TABLE_ID,  @"corpse taint", 1)
	ELSE
		SIF IsDead:ARG:0
			RETURNF 1
	ENDIF
ENDSELECT

@PANTY_REWORK_SOIL_SCORE(ARG, TABLE_NAME = "", TABLE_ID = 0)
#FUNCTION
#DIM nScore
#DIMS 	DYNAMIC TABLE_NAME
#DIM 	DYNAMIC TABLE_ID
#DIM 	DYNAMIC nThing
VARSET nScore

IF TABLE_ID
	SIF DT_CELL_GET(TABLE_NAME,TABLE_ID, "isWashed", 1) == 1
		RETURNF 0
ENDIF

FOR LOCAL,0,VARSIZE("DiapeLiquidSoil")
	SIF PANTY_REWORK_IS_SOIL(ARG,"liquid",LOCAL,TABLE_NAME,TABLE_ID)
		nScore += PANTY_REWORK_SOIL_INDEX("liquid",nThing)
NEXT
FOR LOCAL,0,VARSIZE("DiapeSolidSoil")
	IF TABLE_ID
		SIF DT_CELL_GET(TABLE_NAME, TABLE_ID,  @"isWashed",1) == -1
			BREAK
	ENDIF

	SIF PANTY_REWORK_IS_SOIL(ARG,"solid",LOCAL,TABLE_NAME,TABLE_ID)
		nScore += PANTY_REWORK_SOIL_INDEX("solid",nThing)
NEXT
RETURNF nScore

@PANTY_REWORK_VALUE(TABLE_NAME,P_ID)
#FUNCTION
#DIM P_ID
#DIM P_TYPE
#DIM C_ID
#DIM P_PRICE
#DIMS TABLE_NAME
#DIM P_MAX, 2
#DIM P_THINGS_SOILED
P_TYPE 	= DT_CELL_GET(TABLE_NAME, P_ID, "panty",1)	;panty ID
C_ID 	= DT_CELL_GET(TABLE_NAME, P_ID, "chara",1)	;char ID
P_THINGS_SOILED = 0

;auto calc
CALLF DiapeStats(C_ID,P_TYPE, , 1)
P_MAX:0 = RESULT:1
P_MAX:1 = RESULT:1

;base price
P_PRICE = 100

;price by clothing price
P_PRICE += ClothPrice("下半身下着_ずらし可能",P_TYPE,C_ID)

;soiling
FOR LOCAL,0,VARSIZE("DiapeLiquidSoil")
	IF PANTY_REWORK_IS_SOIL(C_ID,"liquid",LOCAL,TABLE_NAME,P_ID)
		P_PRICE += (MAX(P_MAX:0,600)*PANTY_REWORK_SOIL_INDEX("liquid",LOCAL))
		P_THINGS_SOILED++
		;panty is soiled, so we increase multiplier
	ENDIF
NEXT
FOR LOCAL,0,VARSIZE("DiapeSolidSoil")
	IF PANTY_REWORK_IS_SOIL(C_ID,"solid",LOCAL,TABLE_NAME,P_ID)
		P_PRICE += (MAX(P_MAX:1,600)*PANTY_REWORK_SOIL_INDEX("solid",LOCAL))
		P_THINGS_SOILED++
		;panty is soiled, so we increase multiplier
	ENDIF
NEXT

SIF GETBIT(NAS_PAIL,5)
	TIMES P_PRICE, 2.00

IF P_THINGS_SOILED >= 2
	P_PRICE = P_PRICE * NUM_EXPONENT(2+SaveAchievementClaimed("soilPeePoopCum"),P_THINGS_SOILED)
ENDIF
RETURNF P_PRICE


;score
@PANTY_REWORK_SOIL_INDEX(nType,nThing)
#FUNCTION
#DIMS nType
#DIM nThing
#DIM DYNAMIC SOIL_SCORE	;absolute minimum
SELECTCASE nType
CASE "liquid"
    SELECTCASE nThing
    CASE 0 ;urine
        ;2pt
		SOIL_SCORE = 2
    CASE 1 ;Menstrual Blood
        SOIL_SCORE = 1
    CASE 2 ;pussy juice
        SOIL_SCORE = 1
    CASE 3 ;semen
        SOIL_SCORE = 1
    ENDSELECT
CASE "solid"
    SELECTCASE nThing
    CASE 0 ;poop
        SOIL_SCORE = 3
    CASE 1 ;egg
        SOIL_SCORE = 2
    ENDSELECT
CASE "corpse taint"
	SOIL_SCORE = 5
ENDSELECT
RETURNF SOIL_SCORE


;initalize stuffs
@PANTY_REWORK_DISPLAY_ALL_INIT
nGlobalPage = 0
PR_NextStart:0 = 0

;全コレクション表示
;引数	ARG:0	表示対象	0=Collection	,1=On Hand
;		ARG:1	表示種類	0=Display 		,1=Selection
;		ARG:2	Selection	0=Consolidate 	,1=Separate
;戻り値	RESULT:0	総数
;		RESULT:1	所有nTypes
@PANTY_REWORK_DISPLAY_ALL_COLLECTION(ARG:0=0,ARG:1=0,ARG:2)
#DIM C_ID
#DIM T_COUNT
#DIM OWN_TYPES
#DIM OWN_WEAR
#DIM NEXT_START = 1
#DIM ENTRYLINESTART

VARSET RESULT
T_COUNT = 0
OWN_TYPES = 0
OWN_WEAR = 0

SELECTCASE ARG:0
CASE 0
LOCALS = PantyCollection
CASE 1
LOCALS = PANTS_TEMP
ENDSELECT

LINESTART = LINECOUNT
FOR C_ID,PR_NextStart:nGlobalPage,CHARANUM
	NEXT_START = C_ID + 1
	ENTRYLINESTART = LINECOUNT
	SIF !DT_SELECT(LOCALS, @"chara = {C_ID}")
        CONTINUE
	;一枚もパンツ持ってないキャラでも着用可能数をカウントするため
	IF FLAG:パンツ収集状況タイプB && ARG:0 == 0
		PRINTL
		PRINTFORML 【%CALLNAME:C_ID%】
		CALL PANTY_REWORK_DISPLAY_COLLECTION(C_ID, ARG:0, ARG:1, ARG:2)
		T_COUNT += RESULT:0
		OWN_TYPES += RESULT:1
		OWN_WEAR += RESULT:2
	ELSEIF RESULT:0 > 0
		PRINTL
		PRINTFORML 【%CALLNAME:C_ID%】
		CALL PANTY_REWORK_DISPLAY_COLLECTION(C_ID, ARG:0, ARG:1, ARG:2)
		T_COUNT += RESULT:0
		OWN_TYPES += RESULT:1
	ENDIF
	IF LINECOUNT - LINESTART > 45 ;if the last chara printed doesn't fit delete it and push it to the next page
		NEXT_START -= 1
		CLEARLINE LINECOUNT - ENTRYLINESTART
		BREAK
	ENDIF
NEXT
PR_NextStart:(nGlobalPage + 1) = NEXT_START ;index the first entry each page so we know where to start when going backwards
PRINTL
DRAWLINE
PRINTFORM %@" Page {nGlobalPage + 1}",8, LEFT%
PRINTFORML %@"({PR_NextStart:nGlobalPage}-{NEXT_START - 1})",10,LEFT%
PRINTFORM %" " * 2%
IF nGlobalPage == 0
	SETCOLOR 0x606060
	PRINTFORM %"Prev page",15,LEFT%
	RESETCOLOR 
ELSE
	PRINTBUTTON @"%"Prev page",15,LEFT%", 888
ENDIF
IF NEXT_START >= CHARANUM
	SETCOLOR 0x606060
	PRINTFORM %"Next page",15,LEFT%
	RESETCOLOR 
ELSE
	PRINTBUTTON @"%"Next page",15,LEFT%", 222
ENDIF
PRINTL

RETURN T_COUNT, OWN_TYPES, OWN_WEAR

;コレクション表示
;引数	対象	表示対象ID
;		ARG:0	表示対象		0=Collection		,1=On Hand
;		ARG:1	表示種類		0=Display Only		,1=Selection
;		ARG:2	Dupe Handling	0=Consolidate		,1=Separate
;戻り値	RESULT:0	総数
;		RESULT:1	所有nTypes
@PANTY_REWORK_DISPLAY_COLLECTION(C_ID,ARG:0=0,ARG:1=0,ARG:2=0)
#DIM C_ID                       ;character
#DIM P_ID                       ;panty ID (in the P_ID_LIST table)
#DIM P_TYPE						;panty type
#DIM OWN_COUNT                  ;number owned
#DIM N_LINE                     ;for new line
#DIM TOTAL_NUM
#DIM TOTAL_TYPES
#DIM LOWER_BODY_CONFIRM
#DIM PAJAMA_LOWER_BODY_CONFIRM
#DIM P_ID_LIST, MAXPANTS
#DIM PADDING = 55 ;custom code
#DIMS HTML
#DIMS TABLE_NAME
#DIM PRINT_DONE

VARSET RESULT
SELECTCASE ARG:0
CASE 0
TABLE_NAME = PantyCollection
CASE 1
TABLE_NAME = PANTS_TEMP
ENDSELECT
TOTAL_TYPES = 0
IF ARG:2 == 2
TOTAL_NUM = DT_SELECT(TABLE_NAME, @"chara = {C_ID} and (isWashed = 0 or (isWashed = -1 and washingTimer > 0) or CONVERT(ISNULL(isWashed,0),'System.Boolean') = false) and (liquidSoilBit > 0 or solidSoilBit > 0 or corpseTaint > 0)", "Panty ASC, liquidSoilBit ASC, solidSoilBit ASC, corpseTaint ASC",P_ID_LIST)
ELSE
TOTAL_NUM = DT_SELECT(TABLE_NAME, @"chara = {C_ID}", "Panty ASC, liquidSoilBit ASC, solidSoilBit ASC, corpseTaint ASC",P_ID_LIST)
ENDIF
N_LINE = 0
LOWER_BODY_CONFIRM = CFLAG:C_ID:下半身下着確認
PAJAMA_LOWER_BODY_CONFIRM = CFLAG:C_ID:パジャマ下半身下着確認
HTML =
PRINT_DONE = 0

DEBUGPRINTFORML Got {TOTAL_NUM} panties in the list for %CALLNAME:C_ID%
FOR LOCAL,0,TOTAL_NUM
	P_ID 	= P_ID_LIST:LOCAL						;entry ID in table
	P_TYPE 	= DT_CELL_GET(TABLE_NAME, P_ID, "panty",1)	;panty ID
	IF ARG:2
		;don't allow diapers for laundry
		SIF IsPadded(C_ID, , P_TYPE) && !DT_CELL_GET(TABLE_NAME, P_ID, "solidSoilBit",1) && !GET_INT(C_ID, "下半身下着_ずらし可能", P_TYPE, "Can Wash") && ARG:2 == 2
			CONTINUE

		SIF LOCAL < TOTAL_NUM-1
			GOTO FORCE_PRINT_NO_MOVE
	ENDIF

	;handle duplicates
	IF LOCAL
		;panties must be unique in either soiling or type
		IF PANTY_REWORK_IS_UNIQUE(TABLE_NAME,P_ID,P_ID_LIST:(LOCAL-1))
			$FORCE_PRINT
			IF TOTAL_NUM > 1 && !ARG:2
				;switch to previous panty
				P_ID = P_ID_LIST:(LOCAL-1)
				P_TYPE 	= DT_CELL_GET(TABLE_NAME, P_ID, "panty",1)
			ENDIF
			$FORCE_PRINT_NO_MOVE
			;printing
			;check if it's in collection
			IF PANTY_REWORK_IN_COLLECTION(C_ID, P_TYPE, "PantyCollection") == 0
				SETCOLOR COLOR("PINK")
			ELSEIF ARG:2
				IF (STRFIND(PANTY_REWORK_OFFERING,TOSTR(P_ID)) > -1 && ARG:2 == 1) || (STRFIND(PANTY_REWORK_WASHING,TOSTR(P_ID)) > -1 && ARG:2 == 2)
					SETCOLOR C_AQUA
				ELSEIF PANTY_REWORK_MOST_VALUABLE(TABLE_NAME,C_ID,P_ID) > 0
					SETCOLOR C_PINK
				ELSE
					RESETCOLOR
				ENDIF
			ELSE
				RESETCOLOR
			ENDIF

			IF OWN_COUNT || ARG:2
				TOTAL_TYPES ++
				SIF !STRLENS(HTML)
					HTML += "　"
				;custom code, formatting printing
				LOCALS = %CAPITALIZE(UNDIES_NAME_WITH_BRAND(C_ID, P_TYPE))%
				IF ARG:1 == 0
					;custom code
					;HTML += @"%HTML_PRINT_NAS(@"%LOCALS,PADDING,LEFT%{OWN_COUNT,3}")%　"
					LOCALS '= @"%HTML_PRINT_NAS(@"%CAPITALIZE(UNDIES_NAME_WITH_BRAND(C_ID, P_TYPE))%")%%COND_STR(@" (%PANTY_REWORK_SOILSTR(C_ID,2,2,TABLE_NAME,P_ID)%)",STRLENS(PANTY_REWORK_SOILSTR(C_ID,,,TABLE_NAME,P_ID)))%"
					SIF HTML_STRINGLEN(LOCALS) < PADDING
					LOCALS '= LOCALS+HTML_SPACE(MAX(PADDING-HTML_STRINGLEN(LOCALS)+(PANTY_REWORK_IS_SOIL(C_ID,"liquid",3,TABLE_NAME,P_ID)),0))
					LOCALS '= @"%LOCALS%{OWN_COUNT,3}"
					HTML += @"<nonbutton title='%PANTY_REWORK_PANTY_DESC(TABLE_NAME, P_ID)%'>%LOCALS%</nonbutton>　"
				ELSE
					;the selection mode is unused right now (?)
					;DEBUGPRINTFORML Soiling on {P_ID} (%CALLNAME:C_ID% - %UNDIES_NAME_WITH_BRAND(C_ID, P_TYPE)%): %PANTY_REWORK_SOILSTR(C_ID,,,TABLE_NAME,P_ID)%
					LOCALS '= @"%HTML_PRINT_NAS(@"[%CAPITALIZE(UNDIES_NAME_WITH_BRAND(C_ID, P_TYPE))%")%%COND_STR(@" (%PANTY_REWORK_SOILSTR(C_ID,2,2,TABLE_NAME,P_ID)%)",STRLENS(PANTY_REWORK_SOILSTR(C_ID,,,TABLE_NAME,P_ID)))%"
					SIF HTML_STRINGLEN(LOCALS) < PADDING
					LOCALS '= LOCALS+HTML_SPACE(MAX(PADDING-HTML_STRINGLEN(LOCALS)-(3*(ARG:2 ? 1 # 0 ))+(PANTY_REWORK_IS_SOIL(C_ID,"liquid",3,TABLE_NAME,P_ID)),0))
					LOCALS += HTML_PRINT_NAS("]")
					IF ARG:2 == 1
					LOCALS = %LOCALS%%金額表示(PANTY_REWORK_VALUE(TABLE_NAME,P_ID)),6,LEFT%
					ELSEIF ARG:2 == 2
						IF STRFIND(PANTY_REWORK_WASHING,TOSTR(P_ID)) > -1 && PANTY_REWORK_WASHING_ON
						LOCALS = %LOCALS%{PANTY_REWORK_DRYING_COST(P_TYPE)-DT_CELL_GET(TABLE_NAME, P_ID, "washingTimer", 1),3}m
						ELSE
						LOCALS = %LOCALS%D {PANTY_REWORK_SOIL_SCORE(C_ID,TABLE_NAME,P_ID),2}
						ENDIF
					ELSE
					LOCALS = %LOCALS%{OWN_COUNT,3}
					ENDIF
					;LOCALS = %LOCALS,30,LEFT%{OWN_COUNT,3}　
					HTML += @"<button value='{P_ID}' title='%PANTY_REWORK_PANTY_DESC(TABLE_NAME, P_ID)%'>%LOCALS%</button>　"
				ENDIF
				N_LINE ++
				IF N_LINE % ((MAXWIDTH()-2)/(PADDING+6)) == 0 && N_LINE
					HTML_PRINT HTML
					VARSET HTML
					HTML += "　"
					N_LINE = 0
				ENDIF
			ENDIF
			;===========================
			;reset own count
			IF TOTAL_NUM > 1 && !ARG:2
				P_ID = P_ID_LIST:(LOCAL+1)
				P_TYPE 	= DT_CELL_GET(TABLE_NAME, P_ID, "panty",1)
			ENDIF
			OWN_COUNT = 1
			;HTML =
			IF LOCAL == TOTAL_NUM-1
				IF !PRINT_DONE && TOTAL_NUM > 1 && !ARG:2
					P_ID = P_ID_LIST:(TOTAL_NUM-1)
					P_TYPE 	= DT_CELL_GET(TABLE_NAME, P_ID, "panty",1)
					PRINT_DONE = 1
					GOTO FORCE_PRINT_NO_MOVE
				ENDIF
				BREAK
			ENDIF
		ELSE
			;dupe
			OWN_COUNT ++
		ENDIF
	ELSE
		OWN_COUNT = 1
	ENDIF
	SIF LOCAL == TOTAL_NUM-1
		GOTO FORCE_PRINT
NEXT
SIF N_LINE
	HTML_PRINT HTML

CFLAG:C_ID:下半身下着確認 = LOWER_BODY_CONFIRM
CFLAG:C_ID:パジャマ下半身下着確認 = PAJAMA_LOWER_BODY_CONFIRM

RESETCOLOR
RETURN TOTAL_NUM, TOTAL_TYPES

