		SIF DT_CELL_GET("PantyCollection", LOCAL,  @"isWashed") == -1
			CONTINUE
		SIF GETBIT(DT_CELL_GET("PantyCollection", LOCAL,  @"solidSoilBit"),LOCAL:1)
