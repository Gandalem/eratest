@PANTY_REWORK_PRAYING(ARG,ARG:1,ARG:2)
;ARG 対象
;ARG:1 願い(1=反発解除 2=感度一時上昇 3=小槌 4=時間停止バレ解除[オミット]
;			 5=天罰 6=子宝祈願 7=サドっ気減少 8=反発履歴削除)
#DIM TOTAL
#DIM nTypes
#DIM DUPE
#DIM OFFERED
#DIM toOffer
#DIM nCost
#DIM PR_LINECOUNT
#DIM P_ID
#DIM P_ID_LIST, MAXPANTS
VARSET LOCAL
TOTAL = DT_SELECT("PantyCollection",@"chara = {ARG}")
nTypes = PANTY_REWORK_UNIQUE_PANTIES(ARG)
DUPE = TOTAL - nTypes
OFFERED = 0
toOffer = 0
SELECTCASE ARG:1
	CASE 1
		nCost = 10
	CASE 2
		nCost = 3
	CASE 3
		nCost = CFLAG:MASTER:魔力回収 / 2 + 1
	CASE 4,6,8
		nCost = 1
	CASE 5,7
		nCost = 3
	;addition custom code, from KR version
	CASE 9,10,11,12,13,15
		nCost = 5
	CASE 14
		nCost = 10
	;NAS:
	CASE 900, 31, 9010, 9011
		nCost = 10
ENDSELECT


;NAS: Pantsuist and non-pantsuist
IF GET_RELIGION_PRECEPT(MASTER, "Panty Stealing") > 0 || ARG:2
IF nOmutsu
	nCost *= 1500
ELSE
	nCost *= 500
ENDIF

PRINTFORML A voice echoes in your head...
CALL COLORMESSAGE(@"((If thou wishes to be bequeathed such a boon, offer a sacrifice...))",C_YELLOW,2,1) ;custom code
;CALL COLORMESSAGE(@"((Offer up {nCost} of %CALLNAME:ARG%'s panties...))",C_YELLOW,2,1) ;custom code
CALL COLORMESSAGE(@"((Offer up %金額表示(nCost)% in %CALLNAME:ARG%'s panties...))",C_YELLOW,2,1) ;custom code
PRINTFORM Current amount of %CALLNAME:ARG% panties: 
IF !nTypes
	PRINTW Not a single one
	RETURN -1
ENDIF
PRINTFORML Total {TOTAL,3}     Uniques: {nTypes,3}     Duplicates: {DUPE}
PR_LINECOUNT = LINECOUNT
DO
	VARSET OFFERED
	CLEARLINE LINECOUNT - PR_LINECOUNT
	;value
	LOCAL = 0
	DO
		P_ID = TOINT(SPLIT_SINGLE(PANTY_REWORK_OFFERING, LOCAL, "/"))
		;PRINTFORML %CALLNAME:ARG%'s %表示ラベル:nLoop%: %LOCALS% ({LOCAL})
		SIF !P_ID
			BREAK
		OFFERED += PANTY_REWORK_VALUE("PantyCollection",P_ID)
		LOCAL++
	LOOP 1

	PRINTFORML Offering %金額表示(OFFERED)% in panties.
	IF OFFERED < nCost
		PRINTFORML Still need {ABS(OFFERED-nCost)} more to appease %PantsuSama()%
	ELSE
		PRINTFORML Will gain %金額表示(OFFERED-nCost)% as compensation
	ENDIF

	DRAWLINE
	CALL PANTY_REWORK_DISPLAY_COLLECTION(ARG,0,1,1)
	DRAWLINE
	SIF OFFERED-nCost >= 0
	PRINTFORM [0] - Offer　　
	PRINTFORM [7] - Offer Duplicates　　
	PRINTFORM [8] - Clear All　　
	PRINTFORM [9] - Cancel　　
	PRINTL
	INPUT
	LOCAL = RESULT
	SELECTCASE RESULT
	CASE 0
		IF OFFERED-nCost >= 0
			;remove
			LOCAL = 0
			DO
				P_ID = TOINT(SPLIT_SINGLE(PANTY_REWORK_OFFERING, LOCAL, "/"))
				;PRINTFORML %CALLNAME:ARG%'s %表示ラベル:nLoop%: %LOCALS% ({LOCAL})
				SIF !P_ID
					BREAK
				DT_ROW_REMOVE "PantyCollection", P_ID
				LOCAL ++
			LOOP 1
			VARSET PANTY_REWORK_OFFERING
			BREAK
		ENDIF
	CASE 7
		VARSET PANTY_REWORK_OFFERING

		DT_SELECT "PantyCollection", @"chara = {ARG}", "Panty ASC, liquidSoilBit ASC, solidSoilBit ASC, corpseTaint ASC", P_ID_LIST
		LOCAL = 0
		DO
			LOCAL ++
			P_ID = P_ID_LIST:LOCAL
			;not most valuable
			IF PANTY_REWORK_MOST_VALUABLE("PantyCollection",ARG,P_ID) <= 0
				PANTY_REWORK_OFFERING += @"{P_ID}/"
				;value
				LOCAL:1 = 0
				VARSET OFFERED
				DO
					P_ID = TOINT(SPLIT_SINGLE(PANTY_REWORK_OFFERING, LOCAL:1, "/"))
					;PRINTFORML %CALLNAME:ARG%'s %表示ラベル:nLoop%: %LOCALS% ({LOCAL})
					SIF !P_ID
						BREAK
					OFFERED += PANTY_REWORK_VALUE("PantyCollection",P_ID)
					LOCAL:1++
				LOOP 1
				SIF STRCOUNT(PANTY_REWORK_OFFERING,"/") >= 29
					BREAK
			ENDIF
		LOOP OFFERED < nCost
	CASE 8
		VARSET PANTY_REWORK_OFFERING
	CASE 9
		RETURN -1
	CASEELSE

		IF DT_CELL_GET("PantyCollection", LOCAL, "id", 1)
			IF STRFIND(PANTY_REWORK_OFFERING,TOSTR(LOCAL)) > -1
				PANTY_REWORK_OFFERING '= REPLACE(PANTY_REWORK_OFFERING, @"{LOCAL}/", "")
			ELSE
				IF STRCOUNT(PANTY_REWORK_OFFERING,"/") >= 29
					PRINTFORMW Maximum amount of panties ({29}) selected.
					CONTINUE
				ENDIF
				PANTY_REWORK_OFFERING += @"{LOCAL}/"
			ENDIF
		ENDIF
	ENDSELECT
LOOP 1
ELSE
	TOTAL = 0
	PRINTFORML A voice echoes in your head...
	CALL COLORMESSAGE(@"((If thou wishes to be bequeathed such a boon, offer a sacrifice...))",C_YELLOW,2,1) ;custom code
	CALL COLORMESSAGE(@"((Offer up \\{nCost*2000}...))",C_YELLOW,2,1) ;custom code
	LOCALS '= @"Pay \\%DIGIT_GROUP(nCost*2000)%"
	SIF MONEY >= nCost*2000
		TOTAL = nCost
	$LOOP
	CALL ASK_M("Cancel",1,@"%LOCALS%",TOTAL >= nCost)
	IF RESULT == 1
		CALL LOST_MONEY_YEN(nCost*2000, 1)
	ELSE
		RETURN -1
	ENDIF

ENDIF

;addition custom code
CALL Add_GodPrayerEffect(ARG, ARG:1)
PRINTFORML You pray next to your collection and %金額表示(nCost)% worth of them burst into flames!
FLAG:篤信 += nCost
SIF OFFERED-nCost > 0
	CALL GET_MONEY_YEN(OFFERED-nCost,1)
CALL GET_MONEY_YEN(,2)
IF ARG:1 == 7
	CALL COLORMESSAGE(@"%CALLNAME:ARG%'s Sadism has decreased.",C_YELLOW,2,1)
	CALL COLORMESSAGE(@"%CALLNAME:ARG%'s Sadism Exp has been lowered.",C_YELLOW,2,1)
