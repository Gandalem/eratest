@PANTY_REWORK_SPEND_COLLECTION
#DIM C_ID
#DIM PANTY
#DIM P_INDEX
#DIM P_ID_LIST, MAXPANTS
#DIM P_ID
#DIM TOTAL_NUM
#DIM DYNAMIC nSold
#DIM DYNAMIC nTotalValue

VARSET RESULT

FOR C_ID,0,CHARANUM
	TOTAL_NUM = DT_SELECT("PantyCollection", @"chara = {C_ID}", "Panty ASC, liquidSoilBit ASC, solidSoilBit ASC, corpseTaint ASC",P_ID_LIST)
	FOR P_INDEX,0,TOTAL_NUM
		P_ID = P_ID_LIST:P_INDEX
		PANTY = DT_CELL_GET("PantyCollection", P_ID, "panty", 1)
		IF PANTY_REWORK_MOST_VALUABLE("PantyCollection",C_ID,P_ID) < 1
			;sell
			nSold++
			nTotalValue += PANTY_REWORK_VALUE("PantyCollection",P_ID)
			DT_ROW_REMOVE "PantyCollection", P_ID
		ENDIF
	NEXT
NEXT
RETURN nSold,nTotalValue

