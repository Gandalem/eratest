SIF STRLENS(CBPSTR_COND)
	CBPSTR_DESC += @"Requirements: %CBPSTR_COND%\n"

SIF SUBSTRING(CBPSTR_NAME,0,1) != "『"
	CBPSTR_NAME '= @" %CBPSTR_NAME%"	

IF CBPSTR_COUNT	
	CBPSTR_COLOR = C_WHITE
	SIF STRLENS(LOCALS) > PADDING
		PADDING = PADDING * 2 + 5
		CBPSTR_STR '= @"%CBPSTR_NAME,PADDING,LEFT%{LIMIT(CBPSTR_COUNT, 0, 999),3}" + "　" * 1
ELSE
	CBPSTR_COLOR = C_GRAY
	;NAS: Added character argument
	SIF SUBSTRING(CBPSTR_COND,0,1) != "『" && STRLENS(CBPSTR_COND)
		CBPSTR_COND '= @" %CBPSTR_COND%"	
	IF CBPSTR_PANTY == 18
		CBPSTR_COND '= "？？？？？"
		;付与文字列は「XXX枚　」で全角3+半角1
		CBPSTR_STR '= @"%CBPSTR_COND,PADDING,LEFT%" + " " + "　" * 2
	ELSEIF STRLENS(CBPSTR_COND)
		CBPSTR_STR '= @"%CBPSTR_COND,PADDING,LEFT%" + " " + "　" * 2
	ELSE
		CBPSTR_STR '= @"%CBPSTR_NAME,PADDING,LEFT%" + " " + "　" * 2
	ENDIF
ENDIF
RETURNF HTML_PRINT_NAS(CBPSTR_STR,CBPSTR_DESC,TOSTR(CBPSTR_COLOR,"X6"))
