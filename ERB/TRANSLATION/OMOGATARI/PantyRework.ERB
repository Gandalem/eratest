	CALL COLORMESSAGE(@"((Touch %HIM_HER(ARG)% and thy wish shall be granted...))",C_YELLOW,2,1) ;custom code
ELSEIF ARG:1 == 2 && !GANKAKE_1(ARG)
	PRINTW
