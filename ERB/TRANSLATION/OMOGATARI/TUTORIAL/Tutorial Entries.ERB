CALL DQPRINT("「…… 이 세상에서 네가 정말로 『해야 하는 것』은 아무것도 없어.」", FLAG:594)
CALL DQPRINT("「후후, 하지만 그게 인생이지, 그렇지 않아?」", FLAG:594)
CALL DQPRINT("「그냥 네 욕정에 따르고, 매일을 네 마음대로 보내야 해.」", FLAG:594)
CALL DQPRINT("「흙을 향해, 스스로를 지탱하고, 검소하게 살아라――」", FLAG:594)
CALL DQPRINT("「재산을 모으고 퇴폐를 즐겨라--」", FLAG:594)
CALL DQPRINT("「사랑할 누군가를 찾고, 다음 세대와 당신의 삶을 묶어 아이를 키워라.」", FLAG:594)
CALL DQPRINT("「모든 것을 해라, 시간을 극복하고, 다시 모든 것을 하라.」", FLAG:594)
CALL DQPRINT("「네가 내리는 어떤 선택이든 받아들여질 거야, 이런 세상이니까.」", FLAG:594)

@TUTORIAL_ENTRY_INFO_101
TUTORIAL_ENTRY_NAME '= "\"시간 정지\"?"
TUTORIAL_ENTRY_TYPE '= "General"
TUTORIAL_ENTRY_SHOW = 1

@TUTORIAL_ENTRY_101
CALL DQPRINT("「시간을 멈추는 것――당신이 가진 힘, 당신이 가진 유일한 힘이다.」", FLAG:594)
CALL DQPRINT("「우측 상단에 「[Stop Time]」이라고 표시되어 있는 한 할 수 있다.」", FLAG:594)
CALL DQPRINT("「하지만 당연히 무한하지 않으며, 소위 『TSP』를 소모한다.」", FLAG:594)
CALL DQPRINT("「시간이 얼어붙은 세상에서는 원하는 모든 것을 할 수 있다……」", FLAG:594)
CALL DQPRINT("「후훗...... 네가 생각하듯이, 외설적인 행동을 하는 것은 전적으로 너의 권한 내에 있다.」", FLAG:594)
CALL DQPRINT("「그렇다고는 해도, 그런 일로 시작된 어떤 관계를 더 이상 '순수하다'고 부르기는 어렵다.」", FLAG:594)
CALL DQPRINT("「음식에 '약물을 타는' 것과 같은 용도나 특정 '물건'을 몰래 운반하는 데에도 사용될 수 있다.」", FLAG:594)
CALL DQPRINT("「술을 끓일 때, 시간을 빠르게 하면 사케가 더 빨리 완성된다.」", FLAG:594)
CALL DQPRINT("「순식간에 먼 거리를 여행할 수 있다.」", FLAG:594)
CALL DQPRINT("「처음에는 그것을 오래 막을 수 없을 것 같은 기분이 들 것이다.」", FLAG:594)
CALL DQPRINT("「하지만 능력을 계속 사용하면 TSP 수용량이 조금씩 증가한다.」", FLAG:594)
CALL DQPRINT("「경험이 전부라고 말한다♪」", FLAG:594)

@TUTORIAL_ENTRY_INFO_102
TUTORIAL_ENTRY_NAME '= "돈을 버는 방법"
TUTORIAL_ENTRY_TYPE '= "General"
TUTORIAL_ENTRY_SHOW = 1

@TUTORIAL_ENTRY_102
CALL DQPRINT("「후후, 먹고사는 게 우선이니까.」", FLAG:594)
CALL DQPRINT("「그렇다고는 해도, 이 세계에는 실제 생활비가 없다.」", FLAG:594)
CALL DQPRINT("「……하지만, 당신의 가정이 『증가』하고 먹여야 할 다른 입을 갖게 된다면, 그건 또 다른 문제다.」", FLAG:594)
CALL DQPRINT("「만약 누군가의 일을 도와준다면, 그에 비례하는 양만 받게 된다.」", FLAG:594)
CALL DQPRINT("「누가 언제 어디서 일하는지 알아내려면 방에 있는 『달력』을 확인한다.」", FLAG:594)
CALL DQPRINT("「대신, 네가 사는 곳을 청소하면 소액의 수당을 받을 수 있다.」", FLAG:594)
CALL DQPRINT("「그 외에도 부엌에서 사케를 만들어서 인간 마을의 주류점에 팔 수 있다.」", FLAG:594)
CALL DQPRINT("「혹은 식물을 채집해서 에이텐이에 팔 물약을 만들 수 있다...」", FLAG:594)
CALL DQPRINT("「마을에서 낚시를 하거나 정원을 가꾸거나 약을 만들고 노점을 차둘 수 있다.」", FLAG:594)
CALL DQPRINT("「나무 베기 기능도 있다. 그냥 나무를 베어서 마을에서 도매로 팔면 된다.」", FLAG:594)
CALL DQPRINT("「잠자리에 들기 전에 남은 TSP를 부업에 사용할 수 있다. 그것은 시간이 지난 후 축적되기 시작하고 쌓이게 된다.」", FLAG:594)
CALL DQPRINT("「이것을 할지 말지를 설정하는 것은 수면 메뉴의 【부업】옵션에서 할 수 있다.」", FLAG:594)
CALL DQPRINT("「아, 맞다. 스칼렛 데빌 저택에서 카지노도 열린다고 들었어.」", FLAG:594)
CALL DQPRINT("「운과 행운에 자신이 있다면 한번 방문해 보는 건 어때?」", FLAG:594)
CALL DQPRINT("「돈을 벌기 위한 방법으로 범죄에 의지할 수도 있다.」", FLAG:594)
CALL DQPRINT("「이는 주로 소매치기와 도둑질한 물건을 길거리 노점에서 파는 것에서 비롯된다.」", FLAG:594)
CALL DQPRINT("「TSP를 얼마나 쓰는지 잘 신경 써라, 그것은 들키고 싶지 않은 매우 반감적인 행위니까.」", FLAG:594)

@TUTORIAL_ENTRY_INFO_103
TUTORIAL_ENTRY_NAME '= "하루의 기본 흐름"
TUTORIAL_ENTRY_TYPE '= "General"
TUTORIAL_ENTRY_SHOW = 1

@TUTORIAL_ENTRY_103
CALL DQPRINT("「매일 메뉴 화면으로 시작한다.」", FLAG:594)
CALL DQPRINT("「그곳에서 【취침 장소 변경】, 【알람 설정】, 【저장】 및 【불러오기】 등의 것들을 할 수 있다.」", FLAG:594)
CALL DQPRINT("「준비가 되면, 제대로 하루를 시작하기 위해 【기상】만 하면 된다.」", FLAG:594)
CALL DQPRINT("「만약 태풍이나 눈보라 같은 일이 발생하면 그때 알려줄 것이다.」", FLAG:594)
CALL DQPRINT("「낮에 『ENE』가 부족해지면 일부 명령어가 사용 불가능해진다.」", FLAG:594)
CALL DQPRINT("「게다가 해당 날의 『STA』가 모두 소진되면 그날은 끝난다.」", FLAG:594)
CALL DQPRINT("「간식을 먹거나 【낮잠 자기】, 【목욕하기】, 혹은 【아이템】을 사용하면 에너지와 스태미너를 회복할 수 있다.」", FLAG:594)
CALL DQPRINT("「기상 후 일정 시간이 지나면 당신은 『잠이 필요함』 상태에 돌입한다.」", FLAG:594)
CALL DQPRINT("「'잠을 필요로 할 때', 당신의 스태미나와 에너지 소모가 급격히 증가한다.」", FLAG:594)
CALL DQPRINT("「잠을 자기로 선택하거나 잠을 깨는 데 도움이 되는 특정 아이템을 사용하면 상태가 지연될 수 있다.」", FLAG:594)
CALL DQPRINT("「잠자리에 들거나 스태미나가 소진되면 하루가 끝난다.」", FLAG:594)
CALL DQPRINT("「청소나 일 돕기 정도에 따라 보상을 받고, 호의를 늘려 카리스마를 얻는다.」", FLAG:594)
CALL DQPRINT("「이 시점에서는 모든 자녀 양육 비용이 지불되며, 당신의 에너지와 스태미나가 회복된다.」", FLAG:594)
CALL DQPRINT("「소지품과 상황에 따라 이 시점에서 특별한 일이 일어날 수도 있다.」", FLAG:594)
CALL DQPRINT("「...그게 전반적인 요점이야. 더 완전한 설명이 필요하면 특정 주제에 대해 물어봐.」", FLAG:594)

@TUTORIAL_ENTRY_INFO_104
TUTORIAL_ENTRY_NAME '= "수면 시간대"
TUTORIAL_ENTRY_TYPE '= "General"
TUTORIAL_ENTRY_SHOW = 1

@TUTORIAL_ENTRY_104
CALL DQPRINT("「수면 메뉴에서 「집 설정」을 선택하면 깨는 시간을 변경할 수 있다.」", FLAG:594)
CALL DQPRINT("「정말 심각한 상태가 아니라면, 절대 과다 수면을 취하지 못할 것이다.」", FLAG:594)
CALL DQPRINT("「같이 자는 사람이 있다면 또 다른 이야기다.」", FLAG:594)
CALL DQPRINT("「잠자리에 드는 시기는 깨어나는 시기에 따라 달라진다...... 『수면 필요』 시간을 변경한다.」", FLAG:594)
CALL DQPRINT("「어떤 사람들은 야행성이다. 그런 사람을 알아가기 위해서는 낮 시간 중에 알람을 나중에 울리도록 설정하는 것이 좋은 방법이다.」", FLAG:594)
CALL DQPRINT("「『잠잘 수 있음(Can Sleep)』이라고 되어 있는 동안에는 언제든지 잠자러 갈 수 있다.」", FLAG:594)
CALL DQPRINT("「집이나 낯선 곳에서 잠을 자거나 밤샘을 한다면 체력이 많이 회복되지 않는다.」", FLAG:594)
CALL DQPRINT("「게다가 잠을 제대로 자지 않으면 『사랑을 위한 자동 기도』가 작동하지 않으니 조심해라.」", FLAG:594)
CALL DQPRINT("「아무튼, 피곤하면 잠자리에 들고 질 좋은 잠을 자렴. 나를 위해서도야♪」", FLAG:594)
IF ITEM:スイート安眠枕
	CALL DQPRINT("「그나저나 내가 준 저 타피르 베개는 어때?」", FLAG:594)
	CALL DQPRINT("「앞으로도 필요에 따라 소소한 점검을 해드릴 수 있으니 영원히 저희를 찾아주시길 바랍니다♪」", FLAG:594)
ELSE
	CALL DQPRINT("「그래도 바쁠 때는 좋은 수면 습관을 유지하기 어렵다.」", FLAG:594)
	CALL DQPRINT("「만약 너무 바쁘다면, 『꿈꾸는 베개』를 받는 것이 바로 당신에게 필요한 것일지도 모르니 기대해 주세요.」", FLAG:594)
ENDIF

@TUTORIAL_ENTRY_INFO_105
TUTORIAL_ENTRY_NAME '= "기도에 관하여"
TUTORIAL_ENTRY_TYPE '= "General"
TUTORIAL_ENTRY_SHOW = 1

@TUTORIAL_ENTRY_105
CALL DQPRINT("「특정 지도에서는 하루에 한 번 【기도】할 수 있다.」", FLAG:594)
CALL DQPRINT("「특정 업적을 얻은 후 방에서 【기도】할 수 있는 『제단』을 받게 된다.」", FLAG:594)
CALL DQPRINT("「당신은 어떤 신에게 기도하는가? 음...... 나에게 묻는 건가?」", FLAG:594)
CALL DQPRINT("「그저 돈을 좀 바치면서 【기도】하면 작은 기적이 당신에게 축복을 내릴 것이다.」", FLAG:594)
CALL DQPRINT("「『연모의 기도』는 당신이 기도하는 사람이 다음 날 방문하도록 만들 특별한 것이다.」", FLAG:594)
CALL DQPRINT("「『영원한 성욕 지구력』이나 『평온함』을 바라면서도... 뭐, 어쩔 수 없지.」", FLAG:594)
CALL DQPRINT("「『가슴 가슴』이라고 말하는군... 그런 부류의 사람이면 어쩔 수 없지.」", FLAG:594)
CALL DQPRINT("「'일반적으로 숭배되지 않는 특정 신들에게 일일 이벤트 중에 기도하는 데 도움을 준다.'」", FLAG:594)
CALL DQPRINT("「『Girl P...』아아! 그냥 그만둬. 그런 것들이 원한다면 청소하는 게 훨씬 더 쉽다.」", FLAG:594)
CALL DQPRINT("「『모두를 흥분시켜라』…… 정말 역겹지 않아?」", FLAG:594)
CALL DQPRINT("「그렇게 하면 이상한 날씨인 『핑크 바람』이 발생할 수 있지만... 이건 네가 해서는 안 되는 일이지, 맞지?」", FLAG:594)

@TUTORIAL_ENTRY_INFO_106
TUTORIAL_ENTRY_NAME '= "특별한 기도"
TUTORIAL_ENTRY_TYPE '= "General"
TUTORIAL_ENTRY_SHOW = 1

@TUTORIAL_ENTRY_106
CALL DQPRINT("「특수한 종류의 【기도】에 대해 말해 주려고 한다.」", FLAG:594)
CALL DQPRINT("「'화난 여자들에 대해 뭔가 조치가 취해져야 한다'... 정말 편리하군.」", FLAG:594)
CALL DQPRINT("「특별한 제물을 바침으로써... 분노한 소녀의 팬티에서 증오의 표식을 제거할 수 있다.」", FLAG:594)
CALL DQPRINT("「과거의 실수에 대해서는... 오래된 증오의 흔적을 지우는 것도 가능하다.」", FLAG:594)
CALL DQPRINT("「하지만 이것은 사람들을 덜 새드하게 만들고 정상적인 관계에 더 개방적이게 만드는 데 사용될 수도 있다.」", FLAG:594)
CALL DQPRINT("「아이를 위해 기도하는 옵션도 있다. 후후, 참 간절하네.」", FLAG:594)
CALL DQPRINT("「이토록 구체적인 기도에는 대상이 필요하다. 보상으로서 그리고 방향으로, 이 경우에는 팬티 한 쌍이다.」", FLAG:594)
CALL DQPRINT("「그러니 매일 몇 개씩 모으도록 해. 다만 문제만 일으키지 않게 조심해, 알겠지?」", FLAG:594)
CALL DQPRINT("「...에? 왜 단조로운 응답인 거야? 네 비밀을 흘려야 하나... 아니, 정말 골치 아픈 신이구나, 네 말대로.」", FLAG:594)
CALL DQPRINT("「기회가 된다면 『그것을 파는 어떤 악당』을 추적할 수도 있다.」", FLAG:594)
CALL DQPRINT("「또한 누군가 무언가를 찾는 것을 도와준다면 그 사람의 팬티를 촉매로 사용하여 그것을 찾을 수 있다.」", FLAG:594)
CALL DQPRINT("「아, 맞다. 【집 설정】에서 【연모 자동 기도】을 활성화할 수 있어.」", FLAG:594)
CALL DQPRINT("「그날에 「기도하기」를 잊으면, 잠자리에 들기 전에 자동으로 하게 된다.」", FLAG:594)
CALL DQPRINT("「하지만 그것을 할 때 시간을 들여 고려해 주시길 바랍니다.」", FLAG:594)

@TUTORIAL_ENTRY_INFO_107
TUTORIAL_ENTRY_NAME '= "업적에 관하여"
TUTORIAL_ENTRY_TYPE '= "General"
TUTORIAL_ENTRY_SHOW = 1

@TUTORIAL_ENTRY_107
CALL DQPRINT("「업적은 잠자기 메뉴에서 확인할 수 있다.」", FLAG:594)
CALL DQPRINT("「요구사항 중 하나를 충족하면 보너스를 받게 될 것이다. 예를 들어 충분한 수의 사람을 『사모』하게 하는 것과 같은 방식으로.」", FLAG:594)
CALL DQPRINT("「'오방짐작' 같은 유용한 능력이 있고, '제단' 같은 유용한 아이템도 있다.」", FLAG:594)
CALL DQPRINT("「그것들은 매우 편리하니 많이 하는 것이 좋다.」", FLAG:594)
CALL DQPRINT("「최대 스태미나와 에너지가 주로 여기서 성장하므로, 높은 우선순위를 두어라.」", FLAG:594)
CALL DQPRINT("「잊어버리더라도 가끔 확인해서 새로운 것을 해제했는지 볼 수 있다.」", FLAG:594)

@TUTORIAL_ENTRY_INFO_108
TUTORIAL_ENTRY_NAME '= "사이좋게 지내기"
TUTORIAL_ENTRY_TYPE '= "General"
TUTORIAL_ENTRY_SHOW = 1

@TUTORIAL_ENTRY_108
CALL DQPRINT("「모든 관계는 여러 단계로 나뉜다.」", FLAG:594)
CALL DQPRINT("「일반적으로 『사모』→『연모』→『연인』→『배우자』로 가거나, 아니면 『섹프』→『욕망』→『걸레』→『음란』으로 간다.」", FLAG:594)
CALL DQPRINT("「한 루트를 선택하면, 어느 정도 그쪽으로 고정된다.」", FLAG:594)
CALL DQPRINT("「옵션으로 들어가서 그것을 후자로 변경하면 전자로 바뀔 수 있다. 어떤 경우에 유용할 수도 있다.」", FLAG:594)
CALL DQPRINT("「『사모(Yearning)』의 조건은 【능력】 보기에서 『낙하 조건』 아래에 확인할 수 있다.」", FLAG:594)
CALL DQPRINT("「게다가 관계를 충분히 깊게 만들면 고백할 수 있다.」", FLAG:594)
IF nReligions
	CALL DQPRINT("「하지만 당신의 종교는 이 세상에서 가질 수 있는 연인의 수를 결정한다.」", FLAG:594)
	CALL DQPRINT(@"「%TOSTR_Religion(TALENT:MASTER:Religion)%에게 이것은 %PRINT_PLUR("person", FLAG:追加恋人枠)%이다」", FLAG:594)
ELSE
	IF !MORELOVER
