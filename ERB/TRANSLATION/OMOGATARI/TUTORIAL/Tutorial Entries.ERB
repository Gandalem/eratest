TUTORIAL_ENTRY_SHOW = 1

@TUTORIAL_ENTRY_210
CALL DQPRINT("「You can brew various types of liquor in the『Kitchen』spots on your home map by using the Sake Bug there.」", FLAG:594)
CALL DQPRINT("「Choose【Make Sake】when you are in the kitchen to do so.」", FLAG:594)
CALL DQPRINT("「First you need to【Draw Water】from various bodies of water and pour it into the Sake Bug Jar.」", FLAG:594)
CALL DQPRINT("「Then, after a few days, the water will turn into consumable liquor on its own.」", FLAG:594)
CALL DQPRINT("「If you want to shorten the time it takes, you can do【Time Manipulated Brewing】if you have enough TSP.」", FLAG:594)
CALL DQPRINT("「You can also speed up the process of making『Unrefined Sake』from『Plain Water』by adding 5 extra『Unrefined Sake』bottles.」", FLAG:594)
CALL DQPRINT("「Depending on the water used, different types of alcohol will be made.」", FLAG:594)
CALL DQPRINT("「「Plain Water」which you can get from common places such as wells will produce『Unrefined Sake』, which will then turn into『Sake』if left as is.」", FLAG:594)
CALL DQPRINT("「『Sake』can also be produced directly by using「Misty Lake Water」which is drawn from the shores of the eponymous lake.」", FLAG:594)
CALL DQPRINT("「So-called Oni-killing『Strong Sake』is made from「Hell's Hot Spring Water」drawn at Underground's hot spring. Its output seems notably smaller though.」", FLAG:594)
CALL DQPRINT("「『Sacred Sake』can be made from「Miracle Water」drawn at the lakeside on the Summit. Unfortunately, the output seems to be even smaller.」", FLAG:594)
CALL DQPRINT("「Oh, and be sure to fetch water beforehand to replace the finished alcohol when you want to take it out!」", FLAG:594)
CALL DQPRINT("「The amount of sake produced depends on your『Knowledge』level.」", FLAG:594)
CALL DQPRINT("「The resulting liquor can either be served to others, or wholesaled to liquor store in the Village. Please consume alcohol responsibly!」", FLAG:594)
CALL DQPRINT("「As a side note, 『Distilled Alcohol』,『Medical Alcohol』, and『Pomace Brandy』are liquors made by【Mixing】.」", FLAG:594)
CALL DQPRINT("「Keep in mind that they cannot be made from Sake Bug.」", FLAG:594)

@TUTORIAL_ENTRY_INFO_211
TUTORIAL_ENTRY_NAME '= "More about brewing"
TUTORIAL_ENTRY_TYPE '= "Skills"
TUTORIAL_ENTRY_SHOW = 1

@TUTORIAL_ENTRY_211
CALL DQPRINT("「You seem to have quite the exquisite taste, too♪ Well then, let's go deeper into the world of brewing!」", FLAG:594)
CALL DQPRINT("「Just as with the regular brewing, start by adding any kind of water.」", FLAG:594)
CALL DQPRINT("「Then, select【Add items into the mix】to put your items into the Sake Bug jar.」", FLAG:594)
CALL DQPRINT("「Add『Wild Grape＊20』to turn water into「Grape Juice」. With enough time, it'll change from『Wine』→『Aged Wine』→『Vintage Wine』.」", FLAG:594)
CALL DQPRINT("「Similarly, add『Raspberry＊20』to make「Raspberry Water」→『Fruit Wine』,『Moldy Grape＊20』to make「Botrytized Grape Juice」→『Botrytized Wine』.」", FLAG:594)
CALL DQPRINT("「『Honey＊10』will change into「Honey Water」→『Mead』.『Fine Ingredients』will change into「Koji」→『Sweet Sake』.」", FLAG:594)
CALL DQPRINT("「Additionally, whenever you add『Wild Grape』and『Moldy Grape』, you obtain『Pomace』as a byproduct from strained lees.」", FLAG:594)
CALL DQPRINT("「From this point forward, the brewing process is even more time-consuming and labor-intensive, combining the Sake Bug jar and【Mixing】!」", FLAG:594)
CALL DQPRINT("「While having「Grape Juice」as a base, if you add『Distilled Alcohol』acquired by【Mixing】, you obtain『Fortified Grape Juice』→『Fortified Wine』.」", FLAG:594)
CALL DQPRINT("「While having『Unrefined Sake』as a base, if you add『Wood Ash』acquired by【Mixing】, you obtain『Akumochizake』.」", FLAG:594)
CALL DQPRINT("「You can also make『Sweet Potato Shochu』by adding『Potato＊10』into water to make『Potato Water』→『Sake Mash』and then【Mixing】it.」", FLAG:594)
CALL DQPRINT("「The highest stage of brewing requires「Two-stage Aging」process in the Sake Bug jar with【Mixing】process in between.」", FLAG:594)
CALL DQPRINT("「For example, you can make『Unaged Brandy』by【Mixing】either『Wine』『Aged Wine』or『Vintage Wine』.」", FLAG:594)
CALL DQPRINT("「If you then add『Unaged Brandy』into the Sake Bug jar with the water, you can age it from『Brandy VS』→『VSOP』→『XO』over time.」", FLAG:594)
CALL DQPRINT("「In the same way,『Unaged Framboise』is obtained by【Mixing】『Fruit Wine』, then ripened into『Framboise』in the Sake Bug jar.」", FLAG:594)
CALL DQPRINT("「Also, add『Sweetener＊10』into water to make『Sugared Water』→『Fermented Sugar Base』, and then【Mix】it to obtain『Unaged Rum』.」", FLAG:594)
CALL DQPRINT("「You can then put it back into the Sake Bug jar and age it from『White Rum』→『Gold Rum』→『Dark Rum』over time.」", FLAG:594)
CALL DQPRINT("「Liquor that needs Aging→【Mixing】→Aging can not only be drunk directly,」", FLAG:594)
CALL DQPRINT("「but can also be added when making sweets, so let's make some if you can afford it!」", FLAG:594)


