@TUTORIAL_ENTRY_INFO_100
TUTORIAL_ENTRY_NAME '= "뭘 하는 게 좋을까?"
TUTORIAL_ENTRY_TYPE '= "General"
TUTORIAL_ENTRY_SHOW = 1

@TUTORIAL_ENTRY_100
