@BLADDER_SIZE_CHART(nLevel, nSide = 1)
#DIM nLevel
#DIM nSide
;mob
CALL ADDCHARA_INIT(CSV_CHARANUM())
CALLF InitNewHediff(CHARANUM-1)
CALLF GAMANME(CHARANUM-1,nLevel)
PRINTL 【｛방광 크기 차트｝】
FOR LOCAL,8,0,-1
CALLF AddBionic(CHARANUM-1,74,111-(LOCAL),0)
CALLF AddBionic(CHARANUM-1,67,120-(LOCAL),0)
CALLF ResetBladders(CHARANUM-1)
IF nSide == 2
	PRINTFORML %TOSTR_BLADDERSIZE(TALENT:(CHARANUM-1):BowelSize), 15, LEFT%{MAXBASE:(CHARANUM-1):Poo,4}g ({GetMaxBowels(CHARANUM-1),4}g에서 실수한다)
ELSEIF nSide == 1
	PRINTFORML %TOSTR_BLADDERSIZE(TALENT:(CHARANUM-1):BladderSize), 15, LEFT%은(는) {MAXBASE:(CHARANUM-1):4,4}ml (최대 방광 용량 {GetMaxBladder(CHARANUM-1),4}ml에서 소변을 본다)
ENDIF
NEXT
CALL DELETE_CHARA(CHARANUM-1)

@WEARABLE_UNDERWEAR_CHART(nLevel, nSide = 1)
#DIM nLevel
#DIM nSide
;mob
CALL ADDCHARA_INIT(CSV_CHARANUM())
CALLF InitNewHediff(CHARANUM-1)
CALLF GAMANME(CHARANUM-1,nLevel)
CALLF ResetBladders(CHARANUM-1)
;age
CharaAge:(CHARANUM-1):0 = 21
PRINTL 【｛착용 가능한 속옷｝】
;;#; PRINTFORML Current Potty Level: {EffectivePottyLevel(CHARANUM-1)}
FOR LOCAL,0,VARSIZE("UNDERWEAR_TYPES")
FOR LOCAL:1,0,VARSIZE("UNDERWEAR_SUB_TYPES")
IF CanWearUnderwear(CHARANUM-1, UNDERWEAR_TYPES:LOCAL,UNDERWEAR_SUB_TYPES:(LOCAL:1))
	PRINTFORML ・%MERGE_UNDIES_NAME(UNDERWEAR_TYPES:LOCAL,UNDERWEAR_SUB_TYPES:(LOCAL:1))%
ENDIF
NEXT
NEXT
CALL DELETE_CHARA(CHARANUM-1)
