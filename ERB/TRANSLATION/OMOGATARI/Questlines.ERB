;for making checklists of events

@IRAI_CHECKLIST(IC_DESC:0, IC_STEPS:0, IC_DESC:1, IC_STEPS:1, IC_DESC:2, IC_STEPS:2, IC_DESC:3, IC_STEPS:3, IC_DESC:4, IC_STEPS:4, IC_DESC:5, IC_STEPS:5, IC_DESC:6, IC_STEPS:6, IC_DESC:7, IC_STEPS:7, IC_DESC:8, IC_STEPS:8, IC_DESC:9, IC_STEPS:9)
#FUNCTIONS
#DIM IC_STEPS, 10
#DIMS IC_DESC, 10
#DIMS DYNAMIC IC_STRING
IC_STRING =
FOR LOCAL,0,VARSIZE("IC_STEPS")
SIF !STRLENS(IC_DESC:LOCAL)
	CONTINUE
IC_STRING += @"\n%" "*20%"
IC_STRING += @"・%IC_DESC:LOCAL%%COND_STR(" (Completed)",IC_STEPS:LOCAL)%"
NEXT
RETURNF IC_STRING
