; Modular ERB: OMOGATARI/Questlines.ERB

@QUEST_LINE_AMOUNT(ARG)
#FUNCTION
#DIM DYNAMIC QLA_COUNT
VARSET QLA_COUNT
FOR LOCAL,0,10
VARSET QUEST_LINE_NAME
TRYCALLFORMF QUEST_LINE_INFO_K{ARG}(LOCAL)
SIF STRLENS(QUEST_LINE_NAME)
	QLA_COUNT ++
NEXT
RETURNF QLA_COUNT
;for checking quest line names
;Example: QUEST_LINE_QUEST_AMOUNT(102,1)

@QUEST_LINE_QUEST_AMOUNT(ARG,ARG:1)
#FUNCTION
#DIM DYNAMIC QLQA_COUNT
#DIMS DYNAMIC QLQA_SPLIT, 64
#DIM DYNAMIC QLQA_LOOP
VARSET QLQA_COUNT
VARSET QUEST_LINE_NAME
VARSET QLQA_SPLIT
TRYCALLFORMF QUEST_LINE_INFO_K{ARG}(ARG:1)
SIF !STRLENS(QUEST_LINE_NAME)
	RETURNF 0
SPLIT QUEST_LINE_QUESTS,"/", QLQA_SPLIT
FOR QLQA_LOOP,0,64
SIF QLQA_SPLIT:QLQA_LOOP == ""
	BREAK
IF STRLENS(STR_DATA_IRAI(MAKE_IRAI_ID(ARG, TOINT(QLQA_SPLIT:QLQA_LOOP)),"依頼名",ARG)) && QLQA_SPLIT:QLQA_LOOP != "0"
	QLQA_COUNT ++
	;DEBUGPRINTFORML {TOINT(QLQA_SPLIT:LOCAL)} %STR_DATA_IRAI(MAKE_IRAI_ID(ARG, TOINT(QLQA_SPLIT:QLQA_LOOP)),"依頼名",ARG)% is in the quest list
ENDIF
NEXT
RETURNF QLQA_COUNT

@QUEST_LINE_COMPLETED(ARG,ARG:1)
#FUNCTION
#DIM DYNAMIC QLC_COUNT
VARSET QLC_COUNT
TRYCALLFORMF QUEST_LINE_INFO_K{ARG}(ARG:1)
FOR LOCAL,0,64
SIF GETBIT(CharaQuestLine:ARG:(ARG:1):0,LOCAL)
	QLC_COUNT++
NEXT
RETURNF QLC_COUNT
;for checking if quests are completed

@QUEST_LINE_QUEST_IS_COMPLETED(ARG,ARG:1)
#FUNCTION
#DIM QLQIC_QUEST
#DIM QLQIC_LINE
QLQIC_QUEST = QUEST_LINE_BIT(ARG,ARG:1)
QLQIC_LINE = RESULT:1
RETURNF GETBIT(CharaQuestLine:ARG:(QLQIC_LINE):0,QLQIC_QUEST)
;grabbing quests

@QUEST_LINE_BIT(ARG,QLB_QUEST)
#FUNCTION
#DIMS DYNAMIC QLC_SPLIT, 64
#DIM DYNAMIC QLB_COUNT
#DIM DYNAMIC QLB_QUEST
VARSET RESULT
FOR LOCAL,0,10
VARSET QUEST_LINE_NAME
TRYCALLFORMF QUEST_LINE_INFO_K{ARG}(LOCAL)
SIF !STRLENS(QUEST_LINE_NAME)
	CONTINUE
SIF FINDELEMENT(QUEST_LINE_QUESTS,@"{QLB_QUEST}/") == -1
	CONTINUE
SPLIT QUEST_LINE_QUESTS,"/", QLC_SPLIT
FOR QLB_COUNT,0,64
SIF QLC_SPLIT:QLB_COUNT == ""
	BREAK
IF TOINT(QLC_SPLIT:QLB_COUNT) == QLB_QUEST
	;found what we needed
	RESULT:1 = LOCAL
	RETURNF QLB_COUNT+1
	BREAK
ENDIF
NEXT
NEXT
RETURNF -1
;prompt for tutorial

@INTERACTIVE_TUTORIAL_GET(CHARA,IRAI_ID,SCENE,ITC_BIT,ITC_MESSLAB = "Tutorial: ")
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  EXPL_BIT
#DIM ITC_LINE
#DIM ITC_BIT
#DIM ITC_QUEST
#DIM ITC_SDISP
#DIMS DYNAMIC ITC_MESSLAB
;not a valid ID
SIF !HAS_REQUEST_OF_ID(CHARA,IRAI_ID)
	RETURN
ITC_QUEST = QUEST_LINE_BIT(CHARA,IRAI_ID)
ITC_LINE = RESULT:1
SIF ITC_QUEST == -1
	RETURN
RESULTS =
ITC_SDISP = ISSKIP()
IF !GETBIT(CharaQuestLine:CHARA:ITC_LINE:ITC_QUEST,ITC_BIT)
	SKIPDISP 0
	CALL COLOR_LINE
	CALL COLORMESSAGE(@"%ITC_MESSLAB%%SCENE%",C_YELLOW,1,2)
	CALL SHOW_IRAI_MESSAGE(CHARA, IRAI_ID, SCENE)
	PRINTL
	PRINTFORML [0] - 알겠어
	CALL COLOR_LINE
	INPUT
	SETBIT CharaQuestLine:CHARA:ITC_LINE:ITC_QUEST,ITC_BIT
	SIF INT_DATA_IRAI(MAKE_IRAI_ID(CHARA, IRAI_ID), "Pass Requirements", CHARA)
		CFLAG:CHARA:依頼状況 = 3
ENDIF
SKIPDISP ITC_SDISP
;different to SEARCH_IRAI_SLOT
;looks for character ID

@HAS_REQUEST_OF_ID(ARG,ARG:1)
#FUNCTION
SIF FINDELEMENT(IRAI_SLOT,(ARG*1000)+ARG:1) > -1
	RETURNF 1
;completing quests

@QUEST_LINE_COMPLETE_QUEST(ARG,ARG:1)
#DIM QLCK_QUEST
#DIM QLCK_LINE
QLCK_QUEST = QUEST_LINE_BIT(ARG,ARG:1)
QLCK_LINE = RESULT:1
SIF QLCK_QUEST == -1
	RETURN 0
SETBIT CharaQuestLine:ARG:(QLCK_LINE):0,QLCK_QUEST
RETURN 1

@QUEST_LINE_CHANGE(ARG,QLC_CAN_CANCEL=1)
#DIMS DYNAMIC QLC_STR, CQ_MAX_LINES
#DIM DYNAMIC QLC_COMPLETE, CQ_MAX_LINES
#DIM DYNAMIC QLC_AMOUNT, CQ_MAX_LINES
#DIM DYNAMIC QLC_ABLE, CQ_MAX_LINES
#DIM DYNAMIC QLC_RESULT
#DIM DYNAMIC QLC_LINECOUNT
#DIM DYNAMIC QLC_CAN_CANCEL
VARSET QLC_STR
QLC_LINECOUNT = LINECOUNT
$QLC_RESTART
CLEARLINE LINECOUNT - QLC_LINECOUNT
FOR LOCAL,0,QUEST_LINE_AMOUNT(ARG)
TRYCALLFORMF QUEST_LINE_INFO_K{ARG}(LOCAL)
SIF !STRLENS(QUEST_LINE_NAME)
	CONTINUE
SIF !STRLENS(QUEST_LINE_CHANGING_STR)
	QUEST_LINE_CHANGING_STR '= @"「%QUEST_LINE_NAME%」"
QLC_COMPLETE:LOCAL = QUEST_LINE_COMPLETED(ARG,LOCAL)
QLC_AMOUNT:LOCAL = QUEST_LINE_QUEST_AMOUNT(ARG,LOCAL)
QLC_ABLE:LOCAL = QUEST_LINE_ABLE
QLC_STR:LOCAL '= @"%QUEST_LINE_CHANGING_STR% ({QLC_COMPLETE:LOCAL}/{QLC_AMOUNT:LOCAL})"
SIF CharaQuestPath:ARG:0 == LOCAL
	QLC_STR:LOCAL += "(Current)"
NEXT
PRINTFORML %CALLNAME:ARG%의 퀘스트라인을 변경한다.
PRINTFORML 퀘스트라인 변경은 %HIM_HER(ARG)%에게서 받을 수 있는 퀘스트에 영향을 준다.
CALL ASK_M( "취소", QLC_CAN_CANCEL, QLC_STR:0, QLC_ABLE:0, QLC_STR:1, QLC_ABLE:1, QLC_STR:2, QLC_ABLE:2, QLC_STR:3, QLC_ABLE:3, QLC_STR:4, QLC_ABLE:4, QLC_STR:5, QLC_ABLE:5, QLC_STR:6, QLC_ABLE:6, QLC_STR:7, QLC_ABLE:7, QLC_STR:8, QLC_ABLE:8, QLC_STR:9, QLC_ABLE:9, )
QLC_RESULT = RESULT
SELECTCASE QLC_RESULT
	CASE 0
		RETURN
	CASEELSE
		TRYCALLFORMF QUEST_LINE_INFO_K{ARG}(QLC_RESULT-1)
		DRAWLINE
		PRINTFORML %QUEST_LINE_NAME%
		PRINTL
		PRINTFORML %QUEST_LINE_DESC%
		DRAWLINE
		PRINTFORML 이 퀘스트라인으로 변경할까요?
		CALL ASK_YN()
		SELECTCASE RESULT
			CASE 0
				CharaQuestPath:ARG:0 = QLC_RESULT-1
			CASE 1
				GOTO QLC_RESTART
		ENDSELECT
ENDSELECT

@QUEST_LINE_PICK_QUEST(ARG,ARG:1,QLPK_CAN_CANCEL=1)
#DIMS DYNAMIC QLPK_STR, 64
#DIM DYNAMIC QLPK_COMPLETE, 64
#DIM DYNAMIC QLPK_ID, 64
#DIM DYNAMIC QLPK_ABLE, 64
#DIMS DYNAMIC QLPK_SPLIT, 64
#DIM DYNAMIC QLPK_RESULT
#DIM DYNAMIC QLPK_LINECOUNT
#DIM DYNAMIC QLPK_CAN_CANCEL
VARSET QLPK_STR
QLPK_LINECOUNT = LINECOUNT
$QLPK_RESTART
CLEARLINE LINECOUNT - QLPK_LINECOUNT
TRYCALLFORMF QUEST_LINE_INFO_K{ARG}(ARG:1)
IF !STRLENS(QUEST_LINE_NAME)
	PRINTFORMW 이 퀘스트라인에는 퀘스트가 없다.
	RETURN 0
ENDIF
IF CFLAG:ARG:依頼状況 > 1 && CFLAG:ARG:依頼状況 < 100 ;player already accepted their current request, do not override. Already completed requests can be overridden.
	PRINTFORMW 다른 것을 선택하기 전에 현재 요청을 취소하거나 완료해 주세요.
	RETURN 0
ENDIF
SPLIT QUEST_LINE_QUESTS,"/", QLPK_SPLIT
FOR LOCAL,0,64
SIF QLPK_SPLIT:LOCAL == ""
	CONTINUE
QLPK_ID:LOCAL = TOINT(QLPK_SPLIT:LOCAL)
QLPK_STR:LOCAL '= STR_DATA_IRAI(MAKE_IRAI_ID(ARG,QLPK_ID:LOCAL),"依頼名",ARG)
SIF !STRLENS(QLPK_STR:LOCAL) || QLPK_STR:LOCAL == "0"
	CONTINUE
QLPK_COMPLETE:LOCAL = QUEST_LINE_QUEST_IS_COMPLETED(ARG,QLPK_ID:LOCAL)
QLPK_ABLE:LOCAL = INT_DATA_IRAI(MAKE_IRAI_ID(ARG, QLPK_ID:LOCAL),"Line Requirements",ARG)
NEXT
PRINTFORML 이 퀘스트라인에서 %CALLNAME:ARG%를 위한 퀘스트를 선택한다.
FOR LOCAL,0,64
SIF QLPK_STR:LOCAL == ""
	CONTINUE
IF !QLPK_ABLE:LOCAL
	SETCOLOR C_GRAY
	PRINTPLAINFORM [{LOCAL,2}] - %QLPK_STR:LOCAL%
ELSE
	PRINTFORM [{LOCAL,2}] - %QLPK_STR:LOCAL%
ENDIF
SIF QLPK_COMPLETE:LOCAL
	PRINTFORM  (완료)
RESETCOLOR
PRINTL
NEXT
PRINTL
PRINTFORML [99] - 취소
INPUT
QLPK_RESULT = RESULT
SELECTCASE QLPK_RESULT
	CASE 99
		RETURN
	CASEELSE
		DRAWLINE
		PRINTFORML %QLPK_STR:QLPK_RESULT%
		PRINTL
		CALL SHOW_IRAI_MESSAGE(ARG, QLPK_ID:QLPK_RESULT, "依頼提示時")
		PRINTFORML %STR_DATA_IRAI(MAKE_IRAI_ID(ARG,QLPK_ID:QLPK_RESULT),"依頼内容表示",ARG)%
		DRAWLINE
		PRINTFORML 이 퀘스트를 하시겠습니까(현재 퀘스트 진행 상황이 초기화됩니다)
		CALL ASK_YN()
		SELECTCASE RESULT
			CASE 0
				CharaQuestLine:ARG:(ARG:1):(QLPK_RESULT+1) = 0
				CALLF Add_SPECIAL_REQUEST_CREATION(ARG, QLPK_ID:QLPK_RESULT, 100, 1, 1)
			CASE 1
				GOTO QLPK_RESTART
		ENDSELECT
ENDSELECT

