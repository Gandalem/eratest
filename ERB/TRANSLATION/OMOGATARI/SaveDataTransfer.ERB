@GetSaveType()
#FUNCTION

;========== NAS
IF STRLENS(SAVESTR:NAS_SAVE_VER)
;OTW
	SIF CFLAG:16:出禁 && CFLAG:49:出禁
		RETURNF 11
;NAS
	RETURNF 10
ENDIF
; ;Omogatari
; SIF MAXBASE:1:4
; 	RETURNF 13

;========== ATW
IF STRLENS(SAVESTR:ATW_SAVE_VER) && CHARANUM > 145
; ;BBA Saikou
; 	SIF NAME:84 == "黑谷 山女"
; 		RETURNF 23
;ATW
	RETURNF 22

ENDIF

;========== Neodev
IF CHARANUM > 139
;Pedy 4.900+
	SIF CALLNAME:139 == "Orange" || CALLNAME:141 == "Placeholder7"
		RETURNF 21
ENDIF
;Pedy, dates to parsee dialogue
SIF CFLAG:60:916
	RETURNF 20

;Maindev
;check reimu's name
IF NAME:1 == CSVNAME(1)
RETURNF 1
ELSE
RETURNF 2
ENDIF

;ID the branch is identifying itself as
@SAVE_TRANSFER_CURRENT_BRANCH()
#FUNCTION
RETURNF 10

;Names of the branches
