;10: eraNAS================================
CASE 10
	RETURNF "eraNAS"
CASE 11
	RETURNF "OmoTheWorld"
;20: Neodev================================
CASE 21
	RETURNF "Neodev 4.891+"
CASE 20
	RETURNF "Neodev"
;AnonTW==================
CASE 23
	;CN New
	RETURNF "BBASaikouTW"
CASE 22
	RETURNF "AnonTW"
;Upstream==================================
CASE 1
	;JP
	RETURNF "Japanese Upstream"
CASE 2
	RETURNF "Maindev"
CASE 3
	;KR
	RETURNF "Korean"
ENDSELECT

