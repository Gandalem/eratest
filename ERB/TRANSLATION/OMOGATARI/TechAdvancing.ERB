@TechLevelStrToInt(ARGS)
#FUNCTION
SELECTCASE TOLOWER(ARGS)
	CASE "animal"
		RETURNF 0
	CASE "neolithic", "tribal"
		RETURNF 1
	CASE "classical"
		RETURNF 2
	CASE "medieval", "early medieval"
		RETURNF 3
	CASE "late medieval"
		RETURNF 4
	CASE "renaissance"
		RETURNF 5
	CASE "industrial", "early industrial",
		RETURNF 6
	CASE "machine", "late industrial", "world-war"
		RETURNF 7
	CASE "midworld", "modern", "cold-war"
		RETURNF 8
	CASE "spacer"
		RETURNF 9
	CASE "ultra","ultratech"
		RETURNF 10
	CASE "archotech"
		RETURNF 11
ENDSELECT

