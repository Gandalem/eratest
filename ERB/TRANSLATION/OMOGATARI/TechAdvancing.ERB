@RESEARCH_MENU(nFaction=-1,CHEAT=0,RT_OP="",ARG:1=0)
#DIM nFaction
#DIM DYNAMIC CHEAT
#DIM  DYNAMIC RT_COUNT
#DIMS DYNAMIC RT_RES_INT
#DIMS DYNAMIC RT_RES_NAME
#DIM DYNAMIC RT_RES_TECH
#DIM DYNAMIC RT_RES_REQ
#DIM DYNAMIC RT_LOOP
#DIM DYNAMIC RT_LINECOUNT
#DIMS DYNAMIC RT_OP
RT_TAB = ARG:1
RT_LINECOUNT = LINECOUNT
CALL RESEARCH_FIX_PLAYER_TECHKNOW
$REPRINT
IF !STRCOUNT(RT_OP,"「Ability Listing」")
	CLEARLINE LINECOUNT - RT_LINECOUNT
ENDIF
PRINTFORM %FactionName(nFaction)%의 기술 수준: 
SETCOLOR TechLevelColor(MIN(FactionTech:nFaction,nMaxTech))
PRINTFORM %AllTechLevels(MIN(FactionTech:nFaction,nMaxTech))%
RESETCOLOR
PRINTL
IF !STRCOUNT(RT_OP,"「Ability Listing」")
	PRINTFORM %조사처리(CALLNAME:MASTER,"의")% 기술 지식: 
	SETCOLOR TechLevelColor(MIN(TALENT:MASTER:TechKnow,nMaxTech))
	PRINTFORM %AllTechLevels(MIN(TALENT:MASTER:TechKnow,nMaxTech))%
	RESETCOLOR
	PRINTL
ENDIF
DRAWLINE
CALL RESEARCH_TAB(nFaction,RT_TAB,RT_OP)
;tabs
DRAWLINE
FOR LOCAL, 0, VARSIZE("FactionTableTabs")
SIF RT_TAB == LOCAL
	SETCOLOR 0x00FFFF
PRINTBUTTON FactionTableTabs:LOCAL, LOCAL + (STRCOUNT(RT_OP,"「Ability Listing」") ? 95000 # 2)
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTL
IF !STRCOUNT(RT_OP,"「Ability Listing」")
	[IF_DEBUG]
	PRINTFORML [-67] - 치트 모드 토글하기: %YesOrNo(CHEAT)%
	PRINTFORML [-68] - 모든 연구 완료
	[ENDIF]
	PRINTFORML [999] - 나가기
	INPUT
	SELECTCASE RESULT
		CASE 999
			RETURN
		CASE IS >= 60000000
			CALL RESEARCH_INPUT(RESULT,nFaction,CHEAT)
		CASE 2 TO VARSIZE("FactionTableTabs")+2
			RT_TAB = RESULT-2
		CASE -67
			[IF_DEBUG]
			CHEAT = !CHEAT
			[ENDIF]
		CASE -68
			[IF_DEBUG]
			IF nFaction == 99
				CALLF COMPLETE_ALL_PERSONAL_RESEARCH()
			ELSE
				CALL COMPLETE_RESEARCH_PREVIOUS(nFaction,nMaxTech+1)
			ENDIF
			[ENDIF]
	ENDSELECT
	GOTO REPRINT
ENDIF

@RESEARCH_TAB(nFaction,ARG:1=0,RT_OP="")
#DIM nFaction
#DIM DYNAMIC CHEAT
#DIM DYNAMIC RT_LIST, 300
#DIM  DYNAMIC RT_COUNT
#DIMS DYNAMIC RT_RES_INT
#DIMS DYNAMIC RT_RES_NAME
#DIM DYNAMIC RT_RES_TECH
#DIM DYNAMIC RT_RES_REQ
#DIM DYNAMIC RT_LOOP
#DIM DYNAMIC RT_RP_ENTRY
#DIM DYNAMIC RT_PROGRESS
#DIM DYNAMIC RT_COMPARE, 2
#DIMS DYNAMIC RT_COMPARES, 2
#DIM DYNAMIC RT_PREREC_COMP_0,30
#DIM DYNAMIC RT_PREREC_COMP_1,30
#DIM DYNAMIC RT_PRERECS_DONE,2
#DIMS DYNAMIC RT_OP
RT_TAB = ARG:1
;idea:
;get research projects with no requirements up top
VARSET RT_RP_ENTRY
VARSET RT_LIST
RT_COUNT = DT_SELECT("ResearchProject", @"tab = '%FactionTableTabs:RT_TAB%'", "", RT_LIST)
;prerecs
;ソート実処理
LOCAL:0 = 1
WHILE LOCAL:0 < RT_COUNT
SIF !(LOCAL:0)
	LOCAL:0 ++
VARSET RT_COMPARE
VARSET RT_PREREC_COMP_0
VARSET RT_PREREC_COMP_1
FOR RT_LOOP,0,2
RT_COMPARES:(RT_LOOP) '= DT_CELL_GETS("ResearchProject", RT_LIST:(LOCAL:0-RT_LOOP), "prerequisites", 1)
;no prerecs, set priority to 999
SIF !STRLENS(RT_COMPARES:(RT_LOOP))
	RT_COMPARE:(RT_LOOP) = 999
;grab prerec id
FOR LOCAL:1,0,STRCOUNT(RT_COMPARES:(RT_LOOP),"/")
VARSET RESULT
LOCALS '= SPLIT_SINGLE(RT_COMPARES:RT_LOOP,LOCAL:1,"/")
DT_SELECT "ResearchProject", @"defName = '%LOCALS%'"
RT_RP_ENTRY = RESULT:1
SETVAR @"RT_PREREC_COMP_{RT_LOOP}:{(LOCAL:1)}", RT_RP_ENTRY
NEXT
NEXT
FOR LOCAL:1,0,STRCOUNT(RT_COMPARES:(0),"/")
; SIF RT_PREREC_COMP_0:(LOCAL:1) == RT_LIST:(LOCAL:0-1)
; 	RT_COMPARE:0 -= 999
IF FINDELEMENT(RT_PREREC_COMP_1,RT_PREREC_COMP_0:(LOCAL:1)) > -1
	CONTINUE
ENDIF
RT_COMPARE:0 --
NEXT
FOR LOCAL:1,0,STRCOUNT(RT_COMPARES:(1),"/")
SIF FINDELEMENT(RT_PREREC_COMP_0,RT_PREREC_COMP_1:(LOCAL:1)) > -1
	CONTINUE
RT_COMPARE:1 --
NEXT
IF RT_COMPARE:0 >= RT_COMPARE:1
	LOCAL:0 ++
ELSE
	SWAP RT_LIST:(LOCAL:0 - 1), RT_LIST:(LOCAL:0)
	LOCAL:0 --
ENDIF
WEND
;tech level
;ソート実処理
LOCAL:0 = 1
WHILE LOCAL:0 < RT_COUNT
SIF !(LOCAL:0)
	LOCAL:0 ++
RT_COMPARE:0 = TechLevelStrToInt(DT_CELL_GETS("ResearchProject", RT_LIST:(LOCAL:0), "techLevel", 1))
RT_COMPARE:1 = TechLevelStrToInt(DT_CELL_GETS("ResearchProject", RT_LIST:(LOCAL:0-1), "techLevel", 1))
IF RT_COMPARE:0 >= RT_COMPARE:1
	LOCAL:0 ++
ELSE
	SWAP RT_LIST:(LOCAL:0 - 1), RT_LIST:(LOCAL:0)
	LOCAL:0 --
ENDIF
WEND
FOR RT_LOOP,0,RT_COUNT
VARSET RESULT
RT_RES_NAME '= DT_CELL_GETS("ResearchProject", RT_LIST:RT_LOOP, "label", 1)
RT_RES_INT '= DT_CELL_GETS("ResearchProject", RT_LIST:RT_LOOP, "defName", 1)
RT_RES_TECH = TechLevelStrToInt(DT_CELL_GETS("ResearchProject", RT_LIST:RT_LOOP, "techLevel", 1))
RT_RES_REQ =  DT_CELL_GET("ResearchProject", RT_LIST:RT_LOOP, "baseCost", 1)
DT_SELECT "ResearchProgress", @"faction = {nFaction} and defName = '%RT_RES_INT%'"
RT_RP_ENTRY = RESULT:1
IF RESULT:1
	RT_PROGRESS = DT_CELL_GET("ResearchProgress", RT_RP_ENTRY, "progress", 1)
ELSE
	RT_PROGRESS = 0
	SIF STRCOUNT(RT_OP,"「Completed Only」")
		CONTINUE
ENDIF
SIF STRCOUNT(RT_OP,"「Completed Only」") && !RESEARCH_DONE(nFaction,RT_RES_INT)
	CONTINUE
SIF RT_RES_TECH > (nMaxTech)
	CONTINUE
SETCOLOR TechLevelColor(RT_RES_TECH)
LOCALS '= @"[%RT_RES_NAME% ({RT_PROGRESS}/{RT_RES_REQ})%COND_STR(" (Current)",FactionResearching:nFaction == RT_RES_INT)%]"
IF STRCOUNT(RT_OP,"「No Buttons」")
	PRINTFORMS LOCALS
ELSE
	PRINTBUTTON LOCALS,  RT_LIST:RT_LOOP
ENDIF
PRINTL
RESETCOLOR
NEXT

@RESEARCH_INPUT(nInput,nFaction,CHEAT)
#DIM nInput
#DIM nFaction
#DIMS DYNAMIC RT_RES_INT
#DIMS DYNAMIC RT_RES_NAME
#DIM DYNAMIC RT_RES_TECH
#DIM DYNAMIC RT_RES_REQ
#DIM DYNAMIC RT_LINECOUNT
#DIM DYNAMIC RT_COMPARE, 2
#DIMS DYNAMIC RT_COMPARES, 2
#DIM DYNAMIC RT_PRERECS_DONE,2
#DIM CHEAT
nInput = RESULT
RT_RES_NAME '= DT_CELL_GETS("ResearchProject", nInput, "label", 1)
RT_RES_INT '= DT_CELL_GETS("ResearchProject", nInput, "defName", 1)
RT_RES_TECH = TechLevelStrToInt(DT_CELL_GETS("ResearchProject", nInput, "techLevel", 1))
RT_RES_REQ =  DT_CELL_GET("ResearchProject", nInput, "baseCost", 1)
DRAWLINE
PRINTFORM %RT_RES_NAME% 
SIF FactionResearching:nFaction == RT_RES_INT
	PRINTFORM (현재 프로젝트)
PRINTL
DRAWLINE
PRINTFORML %DT_CELL_GETS("ResearchProject", nInput, "description", 1)%
RESETCOLOR
PRINTFORM 기술 레벨: 
SETCOLOR TechLevelColor(RT_RES_TECH)
PRINTFORM %AllTechLevels(RT_RES_TECH)% 
RESETCOLOR
LOCAL = 100
SELECTCASE RT_RES_TECH-TALENT:MASTER:TechKnow
	CASE IS >= 2
		LOCAL = 200
	CASE 1
		LOCAL = 150
ENDSELECT
IF LOCAL != 100
	PRINTFORM 당신의 기술적 지식은 
	SETCOLOR TechLevelColor(TALENT:MASTER:TechKnow)
	PRINTFORM %AllTechLevels(TALENT:MASTER:TechKnow)%
	RESETCOLOR
	PRINTFORM , 연구 비용에 {LOCAL}\%가 곱해진다)
ENDIF
PRINTL
PRINTFORML 전제 조건:
RT_COMPARES:0 '= DT_CELL_GETS("ResearchProject",nInput, "prerequisites", 1)
IF !STRLENS(RT_COMPARES:(0))
	;no prerecs
	PRINTFORML 없음
	VARSET RT_PRERECS_DONE
	GOTO BYPASS_PREPREC_PRINT
ENDIF
;grab prerec id
VARSET RT_PRERECS_DONE
FOR LOCAL:1,0,STRCOUNT(RT_COMPARES:(0),"/")
VARSET RESULT
LOCALS '= SPLIT_SINGLE(RT_COMPARES:0,LOCAL:1,"/")
DT_SELECT "ResearchProject", @"defName = '%LOCALS%'"
RT_COMPARE = RESULT:1
SIF RT_COMPARE
	RT_PRERECS_DONE:1++
SETCOLOR TechLevelColor(TechLevelStrToInt(DT_CELL_GETS("ResearchProject", RT_COMPARE, "techLevel", 1)))
SIF RESEARCH_DONE(nFaction,LOCALS)
	SETCOLOR C_GRAY
PRINTFORM %DT_CELL_GETS("ResearchProject", RT_COMPARE, "label", 1)%
IF RESEARCH_DONE(nFaction,LOCALS)
	PRINTFORM  (완료됨)
	RT_PRERECS_DONE:0 ++
ENDIF
RESETCOLOR
PRINTL
NEXT
$BYPASS_PREPREC_PRINT
PRINTFORML 필요 선행 조건:
FOR LOCAL,0,DT_ROW_LENGTH("ResearchProject")
SIF STRFIND(DT_CELL_GETS("ResearchProject",LOCAL, "prerequisites"), @"%RT_RES_INT%/") == -1
	CONTINUE
PRINTFORML ・%DT_CELL_GETS("ResearchProject",LOCAL, "label")% (연구)
NEXT
FOR LOCAL,1, VARSIZE("EquipIDSTR")
SELECTCASE LOCAL
	CASE 0,10
		CONTINUE
ENDSELECT
FOR LOCAL:1,0,VAR_TEMP_MAX
SIF STRFIND(GET_STR(MASTER, EquipIDSTR:LOCAL, LOCAL:1, "Research Required"), @"%RT_RES_INT%/") == -1
	CONTINUE
PRINTFORML ・%GET_STR(MASTER, EquipIDSTR:LOCAL, LOCAL:1, "名前")% (%表示ラベル:LOCAL%)
NEXT
NEXT
PRINTL
IF RESEARCH_DONE(nFaction,RT_RES_INT)
	SETCOLOR C_GRAY
	PRINTPLAINFORM [0] - 완료됨
	RESETCOLOR
	PRINTL
ELSEIF RT_PRERECS_DONE:0 >= RT_PRERECS_DONE:1
	PRINTFORML [0] 이 프로젝트로 전환한다.
ELSE
	SETCOLOR C_GRAY
	PRINTPLAINFORM [0] 이 프로젝트를 시작하는 데 필요한 전제 조건이 누락되었다.
	RESETCOLOR
	PRINTL
ENDIF
IF CHEAT
	PRINTFORML [800] - 즉시 완료
	PRINTFORML [801] - 미완료
ENDIF
PRINTFORML [999] - 종료
INPUT
SELECTCASE RESULT
	CASE 0
		SIF RT_PRERECS_DONE:0 < RT_PRERECS_DONE:1
			RETURN
		CALLF START_RESEARCH_PROJECT(nFaction,RT_RES_INT)
		PRINTFORMW 프로젝트가 %RT_RES_NAME%으로 전환되었다.
	CASE 800
		SIF !CHEAT
			RETURN
		CALL COMPLETE_RESEARCH_PROJECT_INDE(nFaction,RT_RES_INT)
	CASE 801
		SIF !CHEAT
			RETURN
		CALLF CLEAR_RESEARCH_PROJECT(nFaction,RT_RES_INT)
		PRINTFORMW 프로젝트 진행도가 해제되었다.
	CASE 999
ENDSELECT

@START_RESEARCH_PROJECT(nFaction,nResearch)
#FUNCTION
#DIM nFaction
#DIMS nResearch
FactionResearching:nFaction '= nResearch
SIF !DT_SELECT("ResearchProgress", @"defName = '%nResearch%' and faction = {nFaction}")
	DT_ROW_ADD @"ResearchProgress", "defName", @"%nResearch%", "progress", 0, "researched", 0, "faction", nFaction,

@CLEAR_RESEARCH_PROJECT(nFaction,nResearch)
#FUNCTION
#DIM nFaction
#DIMS nResearch
SIF DT_SELECT("ResearchProgress", @"defName = '%nResearch%' and faction = {nFaction}")
	DT_ROW_REMOVE "ResearchProgress", RESULT:1

@CONTRIBUTE_RESEARCH_PROJECT(nFaction,nPoints=0,nPlayerContribute=0)
#DIM nFaction
#DIM nPoints
#DIM nProject
#DIM nDB
#DIM nPlayerContribute
SIF !nPoints
	RETURN
SIF nFaction < 0
	RETURN
nProject = CURRENT_RESEARCH_PROJECT_FACTION(nFaction)
nDB = RESEARCH_PROJECT_FROM_DEFNAME(FactionResearching:nFaction)
SIF !nProject
	RETURN
SIF !nDB
	RETURN
IF nPlayerContribute
	CALL COLORMESSAGE(@"{nPoints} EXP를 %DT_CELL_GETS("ResearchProject", nDB, "label", 1)%에 기여했다.", C_YELLOW, 2,1)
ELSE
	PRINTFORMSL @"%FactionName(nFaction)%기여했다 {nPoints} EXP를 %DT_CELL_GETS("ResearchProject", nDB, "label", 1)%에"
ENDIF
DT_CELL_SET "ResearchProgress", nProject, "progress", LIMIT(DT_CELL_GET("ResearchProgress",nProject, "progress",1)+nPoints,0,DT_CELL_GET("ResearchProject",nDB, "baseCost",1)), 1
SIF DT_CELL_GET("ResearchProgress",nProject, "progress",1) >= DT_CELL_GET("ResearchProject",nDB, "baseCost",1)
	CALL COMPLETE_RESEARCH_PROJECT(nFaction)

@COMPLETE_RESEARCH_PROJECT(nFaction)
#DIM nFaction
#DIM nProject
#DIM nDB
SIF nFaction < 0
	RETURN
CALL COMPLETE_RESEARCH_PROJECT_INDE(nFaction,FactionResearching:nFaction)
FactionResearching:nFaction '= ""

@COMPLETE_RESEARCH_PROJECT_INDE(nFaction,nProjectSTR)
#DIM nFaction
#DIM nPoints
#DIM nProject
#DIM nDB
#DIMS nProjectSTR
nProject = COMPLETE_RESEARCH_PROJECT_F(nFaction,nProjectSTR)
nDB = RESULT:1
CALL COLORMESSAGE(@"연구를 완료했다 %FactionName(nFaction)%에서 %DT_CELL_GETS("ResearchProject", nDB, "label", 1)%.", C_GREEN,2,1)
DT_CELL_SET "ResearchProject", nProject, "researched", 1, 1
;check for research tech levels
;starts at archo, ends at neolit
FOR LOCAL,MAX_TECH_LEVEL,0,-1
SIF LOCAL <= FactionTech:nFaction
	BREAK
SIF RESEARCH_DONE_PERCENTAGE(nFaction,LOCAL) >= 50
	CALL RESEARCH_LEVEL_PROMOTE(nFaction,LOCAL)
NEXT

@COMPLETE_RESEARCH_PROJECT_F(nFaction,nProjectSTR)
#FUNCTION
#DIM nFaction
#DIM nPoints
#DIM nProject
#DIM nDB
#DIMS nProjectSTR
nDB 	 = RESEARCH_PROJECT_FROM_DEFNAME(nProjectSTR)
nProject = FACTION_RESEARCH(nFaction,nProjectSTR)
SIF nFaction < 0
	RETURNF
SIF !nDB
	RETURNF
IF !nProject
	DT_ROW_ADD @"ResearchProgress", "defName", @"%nProjectSTR%", "progress", DT_CELL_GET("ResearchProject", nDB, "baseCost", 1), "researched", 1, "faction", nFaction,
	nProject = RESULT
ENDIF
DT_CELL_SET "ResearchProgress", DT_CELL_GET("ResearchProject", nDB, "baseCost", 1), "progress", 1, 1
DT_CELL_SET "ResearchProgress", nProject, "researched", 1, 1
RESULT:1 = nDB
RETURNF nProject

@COMPLETE_RESEARCH_PREVIOUS(nFaction,nFactionLevel=-1)
#DIM nFaction
#DIM nFactionLevel
SIF nFactionLevel == -1
	nFactionLevel = FactionTech:nFaction
;research
FOR LOCAL, 0,nMaxTech+1
;animal
SIF !nFactionLevel
	BREAK
;faction tech level is lower
SIF nFactionLevel < LOCAL
	BREAK
;faction tech level is higher than max
SIF LOCAL > nMaxTech
	BREAK
FOR LOCAL:1,0,DT_ROW_LENGTH("ResearchProject")
SIF TechLevelStrToInt(DT_CELL_GETS("ResearchProject", LOCAL:1, "techLevel")) != LOCAL
	CONTINUE
DT_ROW_ADD @"ResearchProgress", "defName", @"%DT_CELL_GETS("ResearchProject", LOCAL:1, "defName")%", "progress", DT_CELL_GET("ResearchProject", LOCAL:1, "baseCost"), "researched", 1, "faction", nFaction,
NEXT
NEXT
SIF nFactionLevel > nMaxTech
	FactionTech:nFaction = nMaxTech

