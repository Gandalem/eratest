@FACTION_RESEARCH_PROGRESS(nFaction,nResearch)
#FUNCTION
#DIMS nResearch
#DIM nFaction
VARSET RESULT
DT_SELECT "ResearchProgress", @"faction = {nFaction} and defName = '%nResearch%'"
SIF !RESULT:1
	RETURNF 0
RETURNF DT_CELL_GET("ResearchProgress", RESULT:1, "progress",1)

@RESEARCH_DONE(nFaction,nResearch)
#FUNCTION
#DIM nFaction
#DIMS nResearch
#DIM RD_ID,2
VARSET RESULT
VARSET RD_ID
SELECTCASE nFaction
	CASE 99
		SIF !GETBIT(nResearchSystem,0)
			RETURNF 1
	CASEELSE
		SIF !GETBIT(nResearchSystem,1)
			RETURNF 1
ENDSELECT
DT_SELECT "ResearchProject", @"defName = '%nResearch%'"
RD_ID:0 = RESULT:1
VARSET RESULT
DT_SELECT "ResearchProgress", @"faction = {nFaction} and defName = '%nResearch%'"
RD_ID:1 = RESULT:1
IF RD_ID:1
	RETURNF DT_CELL_GET("ResearchProgress", RD_ID:1, "progress", 1) >= DT_CELL_GET("ResearchProject", RD_ID:0, "baseCost", 1)
ELSE
	RETURNF 0
ENDIF

@RESEARCH_GROWING(ARG)
#FUNCTION
#DIM RG_STAT
RG_STAT = 8250
RG_STAT *= RESEARCH_SPEED(ARG)
RG_STAT /= 100000
RETURNF RG_STAT

@RESEARCH_SPEED(ARG)
#FUNCTION
#DIM DYNAMIC RE_SPEED
RE_SPEED = 80
RE_SPEED += (120*RANK_SUB_RW(ABL:ARG:43))
;manip
RE_SPEED = RE_SPEED*(100 + (CapacityStats:ARG:4-100) * 50/100)/100
;sight
RE_SPEED = RE_SPEED*(100 + (CapacityStats:ARG:1-100) * 50/100)/100
RETURNF RE_SPEED
;for subistuting ranks from the TW system into the RW system

@RANK_SUB_RW(ARG)
#FUNCTION
; SIF nLevelRework
; 	RETURNF ARG
SELECTCASE ARG
	CASE 1
		RETURNF 3
	CASE 2
		RETURNF 5
	CASE 3
		RETURNF 8
	CASE 4
		RETURNF 11
	CASE 5
		RETURNF 14
	CASE 6
		RETURNF 18
	CASE 7
		RETURNF 20
	CASE 8
		RETURNF 30
	CASE 9
		RETURNF 40
	CASE 10
		RETURNF 50
ENDSELECT
;counts research researched.

@RESEARCH_COUNT(nFaction=-1,nTech = -1)
#FUNCTION
#DIM DYNAMIC nFaction
#DIM DYNAMIC nTech
#DIMS RC_TABLE
#DIM DYNAMIC RC_RESEARCH_IDS,300
#DIM DYNAMIC RC_PROGRESS_IDS,300
#DIM DYNAMIC RC_COUNT
#DIMS RC_ARGUMENT_STRING
VARSET RC_RESEARCH_IDS
VARSET RC_PROGRESS_IDS
VARSET RC_ARGUMENT_STRING
VARSET RC_COUNT
IF nFaction == -1
	RC_TABLE '= "ResearchProject"
ELSE
	RC_TABLE '= "ResearchProgress"
ENDIF
DT_SELECT "ResearchProject", "", "", RC_RESEARCH_IDS
FOR LOCAL,0,VARSIZE("RC_RESEARCH_IDS")
SIF !RC_RESEARCH_IDS:LOCAL
	BREAK
IF nTech != -1 && TechLevelStrToInt(DT_CELL_GETS("ResearchProject", RC_RESEARCH_IDS:LOCAL, "techLevel", 1)) != nTech
	RC_RESEARCH_IDS:LOCAL = 0
	CONTINUE
ENDIF
SIF nFaction == -1
	RC_COUNT ++
NEXT
SIF nFaction == -1
	GOTO BYPASSFACTION
ARRAYSORT RC_RESEARCH_IDS, "BACK"
DT_SELECT "ResearchProgress", @"faction = {nfaction}", "", RC_PROGRESS_IDS
FOR LOCAL,0,VARSIZE("RC_PROGRESS_IDS")
SIF !RC_PROGRESS_IDS:LOCAL
	BREAK
SIF FINDELEMENT(RC_RESEARCH_IDS,RESEARCH_PROJECT_FROM_DEFNAME(DT_CELL_GETS("ResearchProgress", RC_PROGRESS_IDS:LOCAL, "defName", 1))) == -1
	CONTINUE
RC_COUNT ++
NEXT
$BYPASSFACTION
RETURNF RC_COUNT
;percentage of all research done

@RESEARCH_DONE_PERCENTAGE(nFaction=-1,nTech = -1)
#FUNCTION
#DIM DYNAMIC nFaction
#DIM DYNAMIC nTech
RETURNF GETPERCENT(RESEARCH_COUNT(nFaction,nTech),RESEARCH_COUNT(-1,nTech))
;DT_SELECT RC_TABLE, "", "", RC_RESEARCH_IDS
;promote

@RESEARCH_LEVEL_PROMOTE(nFaction=-1,nTech = -1)
#DIM DYNAMIC nFaction
#DIM DYNAMIC nTech
;can't demote
SIF nTech <= FactionTech:nFaction
	RETURN
FactionTech:nFaction = nTech
IF nFaction == 99
	CALL COLORMESSAGE(@"당신은 기술적 지식을 더 똑똑하게 만든 연구 프로젝트를 막 마쳤다. 당신의 새로운 기술 레벨은 %AllTechLevels(FactionTech:nFaction)%이다.", C_GREEN,2,1)
	SELECTCASE nTech
		CASE 1
			CALL EVENT_Get_EXP(MASTER, 75, 10)
		CASE 2
			CALL EVENT_Get_EXP(MASTER, 75, 25)
		CASE 3
			CALL EVENT_Get_EXP(MASTER, 75, 50)
		CASE 4
			CALL EVENT_Get_EXP(MASTER, 75, 70)
		CASE 5
			CALL EVENT_Get_EXP(MASTER, 75, 95)
		CASE 6
			CALL EVENT_Get_EXP(MASTER, 75, 110)
		CASE 7
			CALL EVENT_Get_EXP(MASTER, 75, 190)
		CASE 8
			CALL EVENT_Get_EXP(MASTER, 75, 300)
		CASE 9
			CALL EVENT_Get_EXP(MASTER, 75, 500)
		CASE 10
			CALL EVENT_Get_EXP(MASTER, 75, 1000)
		CASE 11
			CALL EVENT_Get_EXP(MASTER, 75, 3000)
	ENDSELECT
	TALENT:MASTER:TechKnow = nTech
ELSE
	CALL COLORMESSAGE(@"한 연구원이 %FactionName(nFaction)%을 더 똑똑하게 만든 연구 프로젝트를 막 마쳤다. 그들의 새로운 기술 수준은 %AllTechLevels(FactionTech:nFaction)%이다.", C_GREEN,2,1)
ENDIF
;DT_SELECT RC_TABLE, "", "", RC_RESEARCH_IDS

@RESEARCH_PRERECS_DONE(nFaction,ARGS)
#FUNCTION
#DIMS DYNAMIC RPD_PRERECS
#DIM DYNAMIC RPD_COUNT, 2
#DIM DYNAMIC RPD_ID
#DIM DYNAMIC RPD_PREREC_ID
#DIM nFaction
VARSET RPD_COUNT
VARSET RESULT
DT_SELECT "ResearchProject", @"defName = '%ARGS%'"
RPD_ID = RESULT:1
RPD_PRERECS:0 '= DT_CELL_GETS("ResearchProject",RPD_ID, "prerequisites", 1)
IF !STRLENS(RPD_PRERECS:(0))
	;no prerecs
	RETURNF 1
ENDIF
;grab prerec id
VARSET RPD_COUNT
FOR LOCAL:1,0,STRCOUNT(RPD_PRERECS:(0),"/")
VARSET RESULT
LOCALS '= SPLIT_SINGLE(RPD_PRERECS:0,LOCAL:1,"/")
DT_SELECT "ResearchProject", @"defName = '%LOCALS%'"
RPD_PREREC_ID = RESULT:1
SIF RPD_PREREC_ID
	RPD_COUNT:1++
IF RESEARCH_DONE(nFaction,LOCALS)
	RPD_COUNT:0 ++
ENDIF
NEXT
RETURNF RPD_COUNT:0 >= RPD_COUNT:1
;you know the research

@KNOW_RESEARCH(nResearch)
#FUNCTION
#DIMS nResearch
SIF !GETBIT(nResearchSystem,0)
	RETURNF 1
FOR LOCAL,0,MaxFactions
SIF !FactionRank:MASTER:LOCAL && LOCAL != 99
	CONTINUE
SIF RESEARCH_DONE(LOCAL,nResearch)
	RETURNF 1
NEXT

@RESEARCH_FIX_PLAYER_TECHKNOW
