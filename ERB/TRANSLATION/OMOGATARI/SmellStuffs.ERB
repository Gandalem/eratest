; Modular ERB: OMOGATARI/SmellStuffs.ERB

@BathThreshold(ARG)
#FUNCTION
#DIM お風呂入りたい
IF TALENT:ARG:氷精
	お風呂入りたい = 2000
	;お風呂が嫌いなキャラ(虎は泳げるけど)
ELSEIF GROUPMATCH(ARG, [[橙]], [[星]], [[正邪]], [[お燐]], [[ミケ]])
	お風呂入りたい = 2000
ELSEIF TALENT:ARG:汚臭耐性 == -2
	お風呂入りたい = 600
ELSEIF TALENT:ARG:汚臭耐性 == -1
	お風呂入りたい = 800
ELSEIF TALENT:ARG:汚臭耐性 == 0
	お風呂入りたい = 1000
ELSEIF TALENT:ARG:汚臭耐性 == 1
	お風呂入りたい = 1500
ELSEIF TALENT:ARG:汚臭耐性 == 2
	お風呂入りたい = 2000
ENDIF
RETURNF お風呂入りたい

@WantsToGoBath(ARG)
#FUNCTION
SIF CFLAG:ARG:風呂 >= BathThreshold(ARG)
	RETURNF 1
;divine > irresistible > wonderful > pleasurable > pleasing > neutral > unpleasant > pungent > rancid > horrific > reeking

@ThingsThatSmell()
#DIM customChar
#DIMS nTableName
#FUNCTION
nTableName '= @"Smells"
DT_CREATE nTableName
DT_COLUMN_ADD nTableName, "smell"
DT_COLUMN_ADD nTableName, "type"
DT_COLUMN_ADD nTableName, "severity", "int32"
DT_ROW_ADD "Smells", "smell", "vagina", "type", "neutral", "severity", 1
DT_ROW_ADD "Smells", "smell", "penis", "type", "neutral", "severity", 1
DT_ROW_ADD "Smells", "smell", "pussy juice", "type", "nice", "severity", 1
DT_ROW_ADD "Smells", "smell", "corpse", "type", "rancid", "severity", -5
DT_ROW_ADD "Smells", "smell", "pee", "type", "musky", "severity", -1
DT_ROW_ADD "Smells", "smell", "poop", "type", "rancid", "severity", -3

@GetFilthLevel(ARG,ARG:1)
#FUNCTION
#DIM FilthThreshold, 5
#DIM DYNAMIC nLOOP
VARSET FilthThreshold
SELECTCASE TALENT:(ARG:1):汚臭耐性
	CASE -2
		FilthThreshold:0 = 1300
		FilthThreshold:1 = 1100
		FilthThreshold:2 = 900
		FilthThreshold:3 = 500
		FilthThreshold:4 = 300
	CASE -1
		FilthThreshold:0 = 2000
		FilthThreshold:1 = 1500
		FilthThreshold:2 = 1000
		FilthThreshold:3 = 700
		FilthThreshold:4 = 400
	CASE 0
		FilthThreshold:0 = 2500
		FilthThreshold:1 = 2000
		FilthThreshold:2 = 1500
		FilthThreshold:3 = 1000
		FilthThreshold:4 = 500
	CASE 1
		FilthThreshold:0 = 9999
		FilthThreshold:1 = 2500
		FilthThreshold:2 = 2000
		FilthThreshold:3 = 1000
		FilthThreshold:4 = 0
	CASE 2
		FilthThreshold:0 = 9999
		FilthThreshold:1 = 9999
		FilthThreshold:2 = 9999
		FilthThreshold:3 = 0
		FilthThreshold:4 = 0
ENDSELECT
FOR nLOOP, 4, -1, -1
SIF CFLAG:ARG:風呂 < FilthThreshold:nLOOP
	RETURNF nLOOP+1
NEXT
RETURNF 0
