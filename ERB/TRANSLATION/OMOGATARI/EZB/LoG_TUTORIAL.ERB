@LOG_TUTORIAL(ARG)
SELECTCASE ARG
CASE 1
CALL PRINT_GP("L", "Welcome to the World of Fantasy!")
CALL PRINT_GP("L", "To start, you will need a weapon. While it is possible to battle with just your fists, its not very practical to.")
CALL PRINT_GP("L", "But first, lets go on the Internet and head to Danmaku.world.")
CASE 10
CALL PRINT_GP("L", "Welcome to Danmaku.world. This is the place where the fighters meet and banter.")
CALL PRINT_GP("L", "You can also get tips that will help you become a better fighter.")
CALL PRINT_GP("L", "Some rivals also have hints for other rivals too, or you can go and read whatever argument's happening over at Be Free.")
CALL PRINT_GP("L", "Lets head to the weapon shop and buy yourself a weapon.")
CASE 20
CALL PRINT_GP("L", "There are four main types of weapons in eraNAS:")
CALL PRINT_GP("L", "- Melee: Close range, but high damage. Low attack count but do not require ammo.")
CALL PRINT_GP("L", "- Ranged: Longer ranged weapons that deal damage according to their caliber. Requires reloading.")
CALL PRINT_GP("L", "- Youjutsu: Youkai Arts. Magical abilities that deal elemental damage or buff or debuff characters. Uses MP.")
CALL PRINT_GP("L", "- Danmaku: Not your standard Spell Card ruled Danmaku. These are lethal and showcase the true power these magic bullets have.")
CALL PRINT_GP("L", "These weapons can be bought with Yen, the standard Japanese currency.")
CALL PRINT_GP("L", "Lets pick a weapon for the future Legend to use, but you can just leave and go with your fists. I'm not stopping you.")
CASE 21
CALL PRINT_GP("L", "Hmmth. You're persistent about using your fists?")
CALL PRINT_GP("L", "Have two points of Melee on the house.")
ABL:MASTER:Melee = LIMIT(ABL:MASTER:Melee+2,0,MaxNonHLevel)

CASE 30
CALL PRINT_GP("L", "Okay, now that you have a weapon, its time to Wake Up and start battling.")
CALL PRINT_GP("L", "Click on Wake Up to start the day.")
CASE 40
CALL PRINT_GP("L", "Now you are in the map selection screen. you can choose where you want to start in Gensokyo")
CALL PRINT_GP("L", "Keep in mind that you cannot leave the area in the same day, so choose wisely.")
CALL PRINT_GP("L", "Since this is stage 1, the only map available is the Human Village.")
CALL PRINT_GP("L", "Lets drop there and start battling.")
CASE 50
CALL PRINT_GP("L", "Now that you are in The World proper, you can finally start challenging rivals.")
CALL PRINT_GP("L", "But first, you have to go and equip our weapon.")
CALL PRINT_GP("L", "Click on the Holster menu.")
CASE 60
CALL PRINT_GP("L", "The Holster menu shows you what weapons you have.")
CALL PRINT_GP("L", "You are able to switch between weapons at any time, and use weapons that you've acquired within the day too.")
CALL PRINT_GP("L", "You can also holster your weapon and use either your fists or Danmaku.")
CALL PRINT_GP("L", "Lets go to the weapon you bought and equip that.")
CALL PRINT_GP("L", "After that, move to the residential area by using the Move command.")
CALLF HESOYAM(80)
CALLF WAKEUP(80)
CFLAG:80:300 = 214
CASE 70
CALL PRINT_GP("L", "Say hello to Akyuu! Everyone in Legend of Gensokyo can be challenged.")
CALL PRINT_GP("L", "To challenge someone, click on the Challenge command in the command menu.")
CALL PRINT_GP("L", "Most challengers will accept your challenge, but some Wanderers - independent fighters, may refuse.")
CALL PRINT_GP("L", "These Wanderers will have specific requirements which can be figured out on your own (or use Spoiler Mode like a wuss)")
CFLAG:80:300 = 214
TFLAG:現在のTARGET = 80
TARGET = 80
CASE 80
CALL PRINT_GP("L", "That was a fight!")
CALL PRINT_GP("L", "When beating rivals, you will get Yen as a prize, as well as a bonus for damage dealt, turn amount, and MP used.")
CALL PRINT_GP("L", "Even when you lose, you will still get Yen from the bonus factors.")
CALLF HESOYAM(MASTER)
CASE 81
CALL PRINT_GP("L", "Injuries acquired will last for the rest of the day, but will be healed in the next day.")
CALL PRINT_GP("L", "On knockout, you lose the day, but otherwise get the same heal as if you exited the map still alive and awake.")
CALL PRINT_GP("L", "Don't die however! Resurrection will cost you 1,000,000 Yen or 10% of your money, whichever is less.")
CALL PRINT_GP("L", "And to end the day, you can click the Go Home button.")
CALL PRINT_GP("L", "Beating all stage bosses of a stage will also end the day.")
CASE 90
CALL PRINT_GP("L", "To progress, beat all of the team members of a team, which will bring out the team leader.")
CALL PRINT_GP("L", "Beat team leaders to bring out minibosses. Beat enough minibosses to bring out the stage bosses.")
CALL PRINT_GP("L", "Beat all stage bosses, and the license to the next stage is yours.")
CALL PRINT_GP("L", "Have fun in Legend of Gensokyo!")
ENDSELECT

@LoG_AdvanceTutorial(Stage,AdvanceStage=1,BypassStage=0)
#DIM DYNAMIC Stage
#DIM DYNAMIC AdvanceStage
#DIM DYNAMIC AT_LineCount
#DIM DYNAMIC BypassStage
SIF !SaveIsEZB
    RETURN
SIF LoG_TutorialProgress >= Stage && !BypassStage
    RETURN
AT_LineCount = LINECOUNT
PRINTL
CALL COLOR_LINE
CALL LOG_TUTORIAL(Stage)
; PRINTFORML [0] - Okay
CALL COLOR_LINE
; INPUT
PRINTBUTTON "[Okay]", "Okay"
PRINTL
INPUTS
IF AdvanceStage && LoG_TutorialProgress < Stage
    LoG_TutorialProgress = Stage
ENDIF
CLEARLINE LINECOUNT-AT_LineCount
RETURN 1