; Modular ERB: OMOGATARI/EZB/LoG_TUTORIAL.ERB

@LOG_TUTORIAL(ARG)
SELECTCASE ARG
	CASE 1
		CALL PRINT_GP("L", "판타지의 세계에 오신 것을 환영합니다!")
		CALL PRINT_GP("L", "시작하려면 무기가 필요하다. 맨손으로 싸울 수는 있지만, 그것은 그다지 실용적이지 않다.")
		CALL PRINT_GP("L", "하지만 먼저 인터넷으로 가서 Danmaku.world로 가자.")
	CASE 10
		CALL PRINT_GP("L", "단마쿠닷월드에 온 것을 환영한다. 이곳은 격투가들이 모여 농담을 주고받는 곳이다.")
		CALL PRINT_GP("L", "더 나은 전사가 되는 데 도움이 될 만한 팁도 얻을 수 있다.")
		CALL PRINT_GP("L", "일부 라이벌들은 다른 라이벌들에 대한 단서도 가지고 있거나, 아니면 베 프리에서 벌어지고 있는 어떤 논의든 가서 읽을 수 있다.")
		CALL PRINT_GP("L", "무기고로 가서 자신에게 무기를 사자.")
	CASE 20
		CALL PRINT_GP("L", "에라나스에는 네 가지 주요 무기 유형이 있다.")
		CALL PRINT_GP("L", "근접 공격: 사거리는 짧지만 피해량이 높다. 공격 횟수는 적지만 탄약이 필요하지 않다.")
		CALL PRINT_GP("L", "원거리 무기: 구경에 따라 피해를 주는 더 긴 사거리를 가진 무기이다. 재장전이 필요하다.")
		CALL PRINT_GP("L", "- 유술(妖術): 요괴의 기술이다. 원소 대미지나 캐릭터 버프 또는 디버프를 주는 마법적인 능력이다. MP를 사용한다.")
		CALL PRINT_GP("L", "- 단막(Danmaku): 일반적인 스펠 카드 규칙을 따르지 않는 단막이다. 이것들은 치명적이며 이 마법 탄환들이 가진 진정한 힘을 보여준다.")
		CALL PRINT_GP("L", "이 무기들은 표준 일본 화폐인 엔으로 구매할 수 있다.")
		CALL PRINT_GP("L", "미래의 전설이 사용할 무기를 선택해 보지만, 그냥 두 손으로 싸우고 갈 수도 있다. 나는 너를 막지 않을 것이다.")
	CASE 21
		CALL PRINT_GP("L", "흥. 주먹 쓰는 것에 집착하는 건가?")
		CALL PRINT_GP("L", "근접 공격에 두 포인트를 보유하고 있다.")
		ABL:MASTER:Melee = LIMIT(ABL:MASTER:Melee+2,0,MaxNonHLevel)
	CASE 30
		CALL PRINT_GP("L", "자, 이제 무기가 생겼으니 깨어나 전투를 시작할 시간이다.")
		CALL PRINT_GP("L", "하루를 시작하려면 'Wake Up'을 클릭한다.")
	CASE 40
		CALL PRINT_GP("L", "지금은 지도 선택 화면에 있다. 당신이 환상향에서 어디서 시작하고 싶은지 선택할 수 있다.")
		CALL PRINT_GP("L", "같은 날 그 구역을 벗어날 수 없다는 것을 염두에 두었으니 신중하게 선택하세요.")
		CALL PRINT_GP("L", "이것은 스테이지 1이므로 이용 가능한 지도는 인간 마을뿐이다.")
		CALL PRINT_GP("L", "여기서 내려서 전투를 시작하자.")
	CASE 50
		CALL PRINT_GP("L", "이제 진정한 세계에 들어왔으니 마침내 라이벌들에게 도전할 수 있다.")
		CALL PRINT_GP("L", "하지만 먼저 우리 무기를 장착해야 한다.")
		CALL PRINT_GP("L", "홀스터 메뉴를 클릭한다.")
	CASE 60
		CALL PRINT_GP("L", "홀스터 메뉴는 당신이 어떤 무기를 가지고 있는지 보여준다.")
		CALL PRINT_GP("L", "당신은 언제든지 무기를 전환할 수 있고, 오늘 획득한 무기도 사용할 수 있다.")
		CALL PRINT_GP("L", "무기를 칼집에 넣고 주먹이나 단마쿠를 사용할 수도 있다.")
		CALL PRINT_GP("L", "네가 산 무기로 가서 그것을 장착해라.")
		CALL PRINT_GP("L", "그 후에는 이동 명령을 사용하여 주거 지역으로 이동한다.")
		CALLF HESOYAM(80)
		CALLF WAKEUP(80)
		CFLAG:80:300 = 214
	CASE 70
		CALL PRINT_GP("L", "아큐에게 인사해라! 모든 레전드 오브 겐소쿄의 인물들은 도전할 수 있다.")
		CALL PRINT_GP("L", "누군지 도전을 하려면 명령어 메뉴에서 도전 명령을 클릭한다.")
		CALL PRINT_GP("L", "대부분의 도전자는 당신의 도전을 받아들이겠지만, 일부 방랑자들(독립적인 전사)은 거절할 수도 있다.")
		CALL PRINT_GP("L", "이 방랑자들은 스스로 알아내거나(겁쟁이처럼 스포일러 모드를 사용하지 말고) 특정한 요구 사항을 가지게 될 것이다.")
		CFLAG:80:300 = 214
		TFLAG:現在のTARGET = 80
		TARGET = 80
	CASE 80
		CALL PRINT_GP("L", "그거 굉장한 싸움이었다!")
		CALL PRINT_GP("L", "라이벌을 물리치면 피해량, 턴 수 및 사용된 마력에 대한 보너스와 함께 엔(Yen)을 보상으로 얻는다.")
		CALL PRINT_GP("L", "지더라도 보너스 요소로부터 엔을 얻게 된다.")
		CALLF HESOYAM(MASTER)
	CASE 81
		CALL PRINT_GP("L", "얻은 부상은 그날 남지만 다음 날 치유된다.")
		CALL PRINT_GP("L", "기절 시 하루를 잃지만, 그렇지 않으면 살아있고 깨어있는 상태로 맵을 나갔을 때와 동일한 회복량을 얻는다.")
		CALL PRINT_GP("L", "죽지 마라! 부활은 당신의 돈 중 적은 금액인 1,000,000엔 또는 10%를 요구한다.")
		CALL PRINT_GP("L", "그리고 하루를 마무리하며, 홈으로 가기 버튼을 클릭할 수 있다.")
		CALL PRINT_GP("L", "한 스테이지의 모든 보스를 처치하면 그날이 끝난다.")
	CASE 90
		CALL PRINT_GP("L", "진행하려면 팀의 모든 팀원을 쓰러뜨려야 하며, 그러면 팀 리더가 등장한다.")
		CALL PRINT_GP("L", "팀 리더들을 처치하여 미니보스를 소환한다. 충분한 미니보스를 처치하여 스테이지 보스를 소환한다.")
		CALL PRINT_GP("L", "모든 스테이지 보스를 처치하면 다음 스테이지의 라이선스가 당신에게 주어집니다.")
		CALL PRINT_GP("L", "환상의 소요를 즐기세요!")
ENDSELECT

@LoG_AdvanceTutorial(Stage,AdvanceStage=1,BypassStage=0)
#DIM DYNAMIC Stage
#DIM DYNAMIC AdvanceStage
#DIM DYNAMIC AT_LineCount
#DIM DYNAMIC BypassStage
SIF !SaveIsEZB
	RETURN
SIF LoG_TutorialProgress >= Stage && !BypassStage
	RETURN
AT_LineCount = LINECOUNT
PRINTL
CALL COLOR_LINE
CALL LOG_TUTORIAL(Stage)
; PRINTFORML [0] - Okay
CALL COLOR_LINE
; INPUT
PRINTBUTTON "[알겠습니다]", "Okay"
PRINTL
INPUTS
IF AdvanceStage && LoG_TutorialProgress < Stage
	LoG_TutorialProgress = Stage
ENDIF
CLEARLINE LINECOUNT-AT_LineCount
RETURN 1
