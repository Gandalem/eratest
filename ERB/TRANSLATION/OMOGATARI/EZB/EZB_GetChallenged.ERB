;RivalID
@LoG_ChallengePlayer(challengeType,R_ID:0=-1,R_ID:1=-1,R_ID:2=-1)
#DIM DYNAMIC C_ID,3
#DIM DYNAMIC R_ID,3
#DIM DYNAMIC R_LOOP
#DIMS challengeType
#DIMS bossType
IF challengeType != "noMessage"
    IF R_ID:1 > -1 || R_ID:2 > -1
        PRINTFORMW Multiple fighters begin to challenge you.
    ELSE
        PRINTFORMW A fighter begins to challenge you.
    ENDIF
ENDIF
;Regular: Show title
;Team: Show title + team name
;Mini: Flash once
;Stage boss: Flash 3 times

FOR R_LOOP,0,VARSIZE("R_ID")
    SIF R_ID:R_LOOP <= -1
        CONTINUE
    CALL LoG_MakeRival(R_ID:R_LOOP,-1)
    C_ID = LoG_CharaID
    DEBUGPRINTFORML adding character id {C_ID}, rival id {R_ID:R_LOOP} to battle
    SIF challengeType == "stage"
    CALL FLASH(1, RGBCOLOR(255, 000, 000))
    TWAIT 750, 1
    CALL CHARA_CUTIN(EZB_TITLES(R_ID:R_LOOP), C_ID > CSV_CHARANUM() ? nameArrayTemp:0 # CSVNAME(C_ID), NameChecker(C_ID,,,,0))
    CALLF AddCombatant(C_ID,0)
NEXT

CALLF AddCombatant(MASTER,1)
IF LOG_RECOLLECTION_BATTLE
    SELECTCASE EZB_SETTINGS_BATTLE_SYS
    CASE 0
        CALL KNIFE_FIGHT(C_ID,MASTER)
    CASE 1
        CALL TGC_CombatInit(1)
    CASE 2
        FORCE_ERATW_DANMAKU = 1
        CALL DANMAKU_BATTLE(C_ID, 1)
        FORCE_ERATW_DANMAKU = 0
    ENDSELECT
ELSE
    CALL KNIFE_FIGHT(C_ID,MASTER)
ENDIF


;boss of that stage
@LoG_StageBattle(ARG)
LoG_InBossBattle = 1
SELECTCASE ARG
CASE 0
    CALL PRINT_GP("L", @"Two figures, dressed in red and green drop down from the sky.")
    CALL PRINT_GP("L", @"They both hold vegitation as they begin to dance.")
    CALL LoG_ChallengePlayer("stage",122,123)
CASE 1
    CALL LoG_ChallengePlayer("stage",34)
CASE 3
    CALL LoG_ChallengePlayer("stage",26,43,124)
CASE 4
    CALL LoG_ChallengePlayer("stage",98,99)
CASE 5
    ; CALL LoG_ChallengePlayer("stage",34)
    ; SIF LcWarResult == 1
    CALL LoG_ChallengePlayer("stage",148)
CASE 6
    CALL PRINT_GP("L", @"The doll answers your call...")
    CALL PRINT_GP("L", @"...")
    CALL PRINT_GP("L", @"..")
    CALL PRINT_GP("L", @".")
    CALL PRINT_GP("L", @"Immediately, a matronly figure forms from the shadows, making you drop the doll.")
    CALL PRINT_GP("L", @"Clad in a dark red evening dress, with several small demonic wings coming from her back, she begins to fly up in the air.")
    CALL PRINT_GP("L", @"Her piercing red eyes glare at you. You're propped up in the air as well as you just stand there, watching.")
    SETBGCOLOR C_THE_WORLD
    CALL PRINT_GPC("W", @"ＴＨＥ・ＷＯＲＬＤ！！　ＳＴＯＰ・ＴＩＭＥ！",102)
    PRINTL
    FLAG:70 = 1
    CALL PRINT_GP("L", @"Time stops. Everyone but you and the figure cease to move.")
    CALL PRINT_GP("L", @"It's do or die time.")
    CALL LoG_ChallengePlayer("noMessage",102)
ENDSELECT

;
@LoG_StageBattleCond(ARG)
#FUNCTION
SELECTCASE ARG
CASE 0
    SIF LoG_StageBattleCond(122) && LoG_StageBattleCond(123)
        RETURNF 0
    RETURNF LoG_RivalWins(13) && LoG_RivalWins(24)
CASE 1
ENDSELECT

@LoG_StageName(ARG)
#FUNCTIONS
SELECTCASE ARG
CASE IS >= 7
    RETURNF "GAME CLEAR"
CASE 6
    RETURNF "Extra Stage"
CASEELSE
    RETURNF @"Stage {ARG+1}"
ENDSELECT




