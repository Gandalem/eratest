; Modular ERB: OMOGATARI/EZB/EZB_GetChallenged.ERB
;RivalID

@LoG_ChallengePlayer(challengeType,R_ID:0=-1,R_ID:1=-1,R_ID:2=-1)
#DIM DYNAMIC C_ID,3
#DIM DYNAMIC R_ID,3
#DIM DYNAMIC R_LOOP
#DIMS challengeType
#DIMS bossType
IF challengeType != "noMessage"
	IF R_ID:1 > -1 || R_ID:2 > -1
		PRINTFORMW 다수의 전투자들이 당신에게 도전을 시작한다.
	ELSE
		PRINTFORMW 한 전사가 당신에게 도전하기 시작한다.
	ENDIF
ENDIF
;Regular: Show title
;Team: Show title + team name
;Mini: Flash once
;Stage boss: Flash 3 times
FOR R_LOOP,0,VARSIZE("R_ID")
SIF R_ID:R_LOOP <= -1
	CONTINUE
CALL LoG_MakeRival(R_ID:R_LOOP,-1)
C_ID = LoG_CharaID
DEBUGPRINTFORML 캐릭터 ID {C_ID}, 라이벌 ID {R_ID:R_LOOP}를 전투에 추가한다.
SIF challengeType == "stage"
	CALL FLASH(1, RGBCOLOR(255, 000, 000))
TWAIT 750, 1
CALL CHARA_CUTIN(EZB_TITLES(R_ID:R_LOOP), C_ID > CSV_CHARANUM() ? nameArrayTemp:0 # CSVNAME(C_ID), NameChecker(C_ID,,,,0))
CALLF AddCombatant(C_ID,0)
NEXT
CALLF AddCombatant(MASTER,1)
IF LOG_RECOLLECTION_BATTLE
	SELECTCASE EZB_SETTINGS_BATTLE_SYS
		CASE 0
			CALL KNIFE_FIGHT(C_ID,MASTER)
		CASE 1
			CALL TGC_CombatInit(1)
		CASE 2
			FORCE_ERATW_DANMAKU = 1
			CALL DANMAKU_BATTLE(C_ID, 1)
			FORCE_ERATW_DANMAKU = 0
	ENDSELECT
ELSE
	CALL KNIFE_FIGHT(C_ID,MASTER)
ENDIF
;boss of that stage

@LoG_StageBattle(ARG)
LoG_InBossBattle = 1
SELECTCASE ARG
	CASE 0
		CALL PRINT_GP("L", @"빨간색과 녹색 옷을 입은 두 체형이 하늘에서 떨어진다.")
		CALL PRINT_GP("L", @"그들은 춤을 추기 시작하며 둘 다 식물을 들고 있다.")
		CALL LoG_ChallengePlayer("stage",122,123)
	CASE 1
		CALL LoG_ChallengePlayer("stage",34)
	CASE 3
		CALL LoG_ChallengePlayer("stage",26,43,124)
	CASE 4
		CALL LoG_ChallengePlayer("stage",98,99)
	CASE 5
		; CALL LoG_ChallengePlayer("stage",34)
		; SIF LcWarResult == 1
		CALL LoG_ChallengePlayer("stage",148)
	CASE 6
		CALL PRINT_GP("L", @"인형이 당신의 부름에 응답한다...")
		CALL PRINT_GP("L", @"...")
		CALL PRINT_GP("L", @"..")
		CALL PRINT_GP("L", @".")
		CALL PRINT_GP("L", @"즉시, 한 숙녀 같은 체형이 그림자 속에서 형성되며 당신을 인형을 떨어뜨리게 한다.")
		CALL PRINT_GP("L", @"어두운 붉은색 이브닝 드레스를 입고 등에서 작은 악마 날개 몇 개를 달고 그녀는 공중으로 날아오기 시작한다.")
		CALL PRINT_GP("L", @"그녀의 날카로운 붉은 눈이 너를 노려본다. 너는 공중에 떠 있으며 그저 서서 지켜보고 있을 뿐이다.")
		SETBGCOLOR C_THE_WORLD
		CALL PRINT_GPC("W", @"ＴＨＥ・ＷＯＲＬＤ！！　ＳＴＯＰ・ＴＩＭＥ！",102)
		PRINTL
		FLAG:70 = 1
		CALL PRINT_GP("L", @"시간이 멈춘다. 너와 체형을 제외한 모든 이들이 움직임을 멈췄다.")
		CALL PRINT_GP("L", @"승부할 때다.")
		CALL LoG_ChallengePlayer("noMessage",102)
ENDSELECT
;

@LoG_StageBattleCond(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 0
		SIF LoG_StageBattleCond(122) && LoG_StageBattleCond(123)
			RETURNF 0
		RETURNF LoG_RivalWins(13) && LoG_RivalWins(24)
	CASE 1
ENDSELECT

@LoG_StageName(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE IS >= 7
		RETURNF "GAME CLEAR"
	CASE 6
		RETURNF "엑스트라 스테이지"
	CASEELSE
		RETURNF @"스테이지 {ARG+1}"
ENDSELECT
