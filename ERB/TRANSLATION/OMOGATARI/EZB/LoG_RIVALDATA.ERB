@LoG_MakeRival(R_ID,nPosition=-1,ReInit=0)
#DIM DYNAMIC R_ID
#DIM DYNAMIC nPosition
#DIM DYNAMIC R_DT
#DIM DYNAMIC ReInit
#DIM DYNAMIC C_ID
CALLF LoG_RIVALDATA(R_ID,1)

IF LoG_CharaID == -1
    RETURN
ELSEIF INRANGE(R_ID,3000,4000)
    ;mob
    LoG_CharaID = -1
    ;get character ID
    FOR LOCAL,0,CHARANUM
        IF TALENT:LOCAL:LoGMobRival == R_ID
            LoG_CharaID = LOCAL
            BREAK
        ENDIF
    NEXT
    ;not initialized
    IF !INRANGE(LoG_CharaID,0,CHARANUM-1)
        CALL MAKE_YUKIZURI(Free_Mob_Slot(), STRLENS(TempMobRace) ? TempMobRace # SPLIT_G("町娘:妖精:人妻:河童:白狼天狗:鴉天狗:化け狸:イナバ:販売員:玉兎:鬼:泡姫:山童:茨たぬき:メイド妖精:ゾンビフェアリー:サキュバス:化け狐:化け猫"), 1)
        TALENT:(Free_Mob_Slot(1)):LoGMobRival = R_ID
        TALENT:(Free_Mob_Slot(1)):300 = 0
        CALLF LoG_RIVALDATA(R_ID,1)
        LoG_CharaID = Free_Mob_Slot(1)
        DEBUGPRINTFORML made mob rival {LoG_CharaID}, rival id {R_ID}
    ENDIF
    ; DEBUGPRINTFORM rival is {LoG_CharaID}
    IF (IS_MOB_OR_LOG_RIVAL(LoG_CharaID)) && !GCREATED(CFLAG:LoG_CharaID:モブ子素材CFLAG開始位置)
		; CALL MOB_IMAGE_GEN(LoG_CharaID,0)
		; CALL MOB_IMAGE_GEN(LoG_CharaID,1)
	ENDIF
ENDIF
C_ID = LoG_CharaID

CALL IndividualNameSet(C_ID)
IF STRLENS(nameArrayTemp:3)
    FOR LOCAL,0,VARSIZE("nameArray")
        nameArray:C_ID:LOCAL '= nameArrayTemp:LOCAL
    NEXT
ENDIF
NAME:C_ID = %NameChecker(C_ID)%
;CALLNAME:C_ID '= nameArrayTemp:na_CallName
nameArray:C_ID:na_CallName '= EZB_TITLES(R_ID)
CALLNAME:C_ID '= EZB_TITLES(R_ID)
RELATION:C_ID:C_ID = 0

;init character DTs
IF !DT_EXIST("LoG_RivalStat")
    CALLF LoG_CreateRivalStatDT
    DEBUGPRINTFORML adding character DT
    GOTO AddCharaDT
ELSEIF !LoG_GetRivalDT(R_ID)
$AddCharaDT
{
DT_ROW_ADD @"LoG_RivalStat",
"rivalID",      R_ID, 
"charaID",      C_ID,
"teamID",       LoG_MobTeam,
"win",          0,
"lose",         0,
"draw",         0,
}
ELSE
;edit rival, character, team IDs
ENDIF

MAXBASE:C_ID:0 = TempMobHP
MAXBASE:C_ID:Blood = TempMobHP
MAXBASE:C_ID:7 = TempMobMP
MAXBASE:C_ID:8 = TempMobTSP
IF !ReInit
    BASE:C_ID:0 = MAXBASE:C_ID:0
    BASE:C_ID:Blood = MAXBASE:C_ID:0
    BASE:C_ID:7 = MAXBASE:C_ID:7
    BASE:C_ID:8 = MAXBASE:C_ID:8
ENDIF

LoG_RivalVariant:C_ID:0 = R_ID/10000
ABL:C_ID:42 = TempMobCombatLevel
ABL:C_ID:Shooting = TempMobCombatLevel
ABL:C_ID:Melee = TempMobCombatLevel
FOR LOCAL,0,64
	IF TempMobYoujutsuLevel:LOCAL
		CALLF GiveYoujutsu(C_ID,LOCAL,TempMobYoujutsuLevel:LOCAL)
	ENDIF
NEXT
;CALL AutoYoujutsuSet(C_ID)
CALLF ClearAllYoujutsuCombatMag(C_ID)

CALL SET_MINIMUM_EXP_ALL(C_ID, 1)
SIF !ReInit
CFLAG:C_ID:睡眠 = 0

;hediffs
IF !ReInit
    IF TempMobEquip:24
        ;specific weapon
        SIF TempMobEquip:24 == 1
            CALLF GiveYoujutsu(C_ID,0,1)
        CALLF EQUIPWEAPON(C_ID,TempMobEquip:24)
    ELSE
        ;weapon from tags
        DEBUGPRINTFORML %CALLNAME:C_ID% wants weapon with tags "%TempMobDesiredWeap%"
        CALLF EQUIPWEAPON(C_ID,MakeDesiredWeapon(TempMobDesiredWeap))
    ENDIF

    FOR LOCAL,0, 15
        IF TempMobYoujutsuList:LOCAL
            {
                DT_ROW_ADD @"combatMagic",
                "chara", C_ID,
                "spellPage", (TempMobYoujutsuList:LOCAL)/1000,
                "spell", (TempMobYoujutsuList:LOCAL)%1000,
                "enchantment", 0,
            }
        ELSE
            CONTINUE
        ENDIF
    NEXT

    FOR LOCAL,0, 25
        IF TempMobEquip:LOCAL
            EQUIP:C_ID:LOCAL = TempMobEquip:LOCAL
            CFLAG:C_ID:(200+LOCAL) = TempMobEquip:LOCAL
            SIF LOCAL == 6
                CALLF PANTY_REWORK_CHANGE(C_ID,TempMobEquip:LOCAL)
        ELSE
            CONTINUE
        ENDIF
    NEXT

    CALLF ClearAllHediffs(C_ID, 1)
    FOR LOCAL,0, DT_ROW_LENGTH("TempMobHediff")
        {
            DT_ROW_ADD @"Hediff",
            "chara", C_ID,
            "part", DT_CELL_GET(@"TempMobHediff", LOCAL, "part"),
            "type", DT_CELL_GET(@"TempMobHediff", LOCAL, "type"),
            "severity", DT_CELL_GET(@"TempMobHediff", LOCAL, "severity"),
            "tended", DT_CELL_GET(@"TempMobHediff", LOCAL, "tended"),
            "bleeding", DT_CELL_GET(@"TempMobHediff", LOCAL, "bleeding"),
            "owner", DT_CELL_GET(@"TempMobHediff", LOCAL, "owner"),
            "cause", DT_CELL_GETS(@"TempMobHediff", LOCAL, "cause"),
            "permanent", DT_CELL_GET(@"TempMobHediff", LOCAL, "permanent"),
        }
    NEXT
    ;genitals
    CALL newGenderSystemConvert(C_ID)
    CALL bladderTraitToPart(C_ID)
ENDIF
CALLF ResetBladders(C_ID)

CFLAG:C_ID:基本服装セット = 300
CFLAG:C_ID:衣装一時変更 = 0
SIF !ReInit
    CALLF HESOYAM(C_ID)
CALL CrippleEffects(C_ID)
CALL CLOTHES_SETTING_TRAIN(C_ID)
FOR LOCAL,0, 25
	CFLAG:C_ID:(240+LOCAL) = CFLAG:C_ID:(200+LOCAL)
NEXT

LoG_CharaID = C_ID
IF !ReInit
    IF nPosition == -1
        nPosition = KICKOUT()
    ELSEIF nPosition == -2
        RETURN 1
    ENDIF
    CFLAG:C_ID:現在位置 = nPosition
    CALL MOB_SET_ARRIVE_TIME(C_ID, 800)
ENDIF
RETURN 1

@LoG_RivalID(ARG)
#FUNCTION
SIF TALENT:ARG:LoGMobRival
    RETURNF TALENT:ARG:LoGMobRival

RETURNF ARG+(LoG_RivalVariant:ARG:0*10000)

;get rival chara from ID
@LoG_GetRival(ARG)
#FUNCTION
RETURNF DT_CELL_GET("LoG_RivalStat", LoG_GetRivalDT(ARG), "charaID", 1)

;get rival DT from ID
@LoG_GetRivalDT(ARG)
#FUNCTION
#DIM DYNAMIC GetRivalIDList, 900
DT_SELECT "LoG_RivalStat", @"rivalID = {ARG}",, GetRivalIDList
RETURNF GetRivalIDList:0

@LoG_GetRivalDTFromChara(ARG)
#FUNCTION
#DIM DYNAMIC GetRivalIDList, 900
DT_SELECT "LoG_RivalStat", @"charaID = {ARG}",, GetRivalIDList
RETURNF GetRivalIDList:0

@LoG_GetRivalFromChara(ARG)
#FUNCTION
RETURNF DT_CELL_GET("LoG_RivalStat", LoG_GetRivalDTFromChara(ARG), "rivalID", 1)


