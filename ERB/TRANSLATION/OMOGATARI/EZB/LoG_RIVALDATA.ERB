;DT for rivals
;this stores win/loss 
@LoG_CreateRivalStatDT
#FUNCTION
#DIMS nTableName
nTableName '= "LoG_RivalStat"
DT_CREATE nTableName
DT_COLUMN_ADD nTableName, "rivalID", "int16" ;id of the rival in the LoG rival list
DT_COLUMN_ADD nTableName, "charaID", "int16" ;id of the character in the rival
DT_COLUMN_ADD nTableName, "teamID", "int8" ;id of the team that the character is in
DT_COLUMN_ADD nTableName, "win", "int16" ;win count
DT_COLUMN_ADD nTableName, "lose", "int16" ;loss count
DT_COLUMN_ADD nTableName, "draw", "int16" ;draw count

@LoG_MakeAllRivals(ARG=0)
#DIM DYNAMIC RivalLoop
FOR RivalLoop,0,5000
    SIF RivalLoop == MASTER
        CONTINUE
    CALL LoG_MakeRival(RivalLoop,InTrain ? -2 # SUKIMA(),ARG)
NEXT

@LoG_RivalCanAppear(ARG)
#FUNCTION
CALLF LoG_RIVALDATA(LoG_RivalID(ARG))
SIF LoG_MobHomeLocation > -1 && MAIN_MAP != LoG_MobHomeLocation
    RETURNF 0
RETURNF LoG_AppearCond

