;losses from rival ID
@LoG_RivalLosses(ARG)
#FUNCTION
RETURNF DT_CELL_GET("LoG_RivalStat", LoG_GetRivalDT(ARG), "lose", 1)

;draws from rival ID
@LoG_RivalDraws(ARG)
#FUNCTION
RETURNF DT_CELL_GET("LoG_RivalStat", LoG_GetRivalDT(ARG), "draw", 1)

;win/lose/draw adding/removing method
;takes character id
;endTypes can be "win", "lose", "draw"
@LoG_ChangeRivalStanding(C_ID,endType="win",addPoints=1)
#FUNCTION
#DIM DYNAMIC C_ID
#DIM DYNAMIC D_ID
#DIM DYNAMIC addPoints
#DIMS DYNAMIC endType
D_ID = LoG_GetRivalDTFromChara(C_ID)
SELECTCASE endType
CASE "win", "lose", "draw"
CASEELSE
    RETURNF
ENDSELECT
DT_CELL_SET "LoG_RivalStat", D_ID, endType, DT_CELL_GET("LoG_RivalStat", D_ID, endType, 1)+addPoints, 1
RETURNF 1

