; Modular ERB: OMOGATARI/EZB/EZB_Charamake.ERB

@EZB_NewGameStart
NAS_NoobGuide = 0
NAS_NoobStage = 0
;inits:
SaveIsEZB = 1
TALENT:MASTER:居場所察知 = 1
SETBIT FLAG:面識ボーナス取得状況, 2
FLAG:会員ランク = 3
CM_COMMISSION = 18
CM_LIMIT = 3000
FLAG:カモられ指数 = 0
GOTO Case0
PRINTFORML eraNAS: 전설의 지옥(幻想郷)에 오신 것을 환영합니다!
PRINTFORML 전설의 지옥은 주인공이 적들과 싸워 돈을 벌고, 캐릭터를 성장시키며, 새로운 단계를 해금하는 에라NAS의 턴제 RPG 모드입니다. 이 모드는 지옥에서 진행됩니다.
PRINTFORML 당신은 아무것도 아닌 존재로 시작하여 라이벌들을 물리치고 신적인 경지에 오르게 됩니다.
PRINTL
PRINTFORML [0] 나는 새로운 플레이어다.
PRINTFORML [1] 나는 돌아온 플레이어다.
INPUT
SELECTCASE RESULT
	CASE 0
		$Case0
		NAS_NoobStage = 1
		NAS_NoobGuide = 26
		nStartingBackstory = 999
		CALL NAS_NewPlayer_Guide
	CASE 1
		FLAG:ゲームモード = 0
		nStartingBackstory = 999
		CALL BackstoyBonuses
		TRYCALLFORM BACKSTORY_{nStartingBackstory}
		SIF RESULT == -8888
			RETURN -8888
		TalentPointOffset = CalcTalentPointsUsed(MASTER)+nTalentPoints
		CALL CHAR_EDITOR_NAS(MASTER)
		SIF RESULT == -8888
			RETURN -8888
ENDSELECT
