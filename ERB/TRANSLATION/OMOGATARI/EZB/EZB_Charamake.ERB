@EZB_NewGameStart
NAS_NoobGuide = 0
NAS_NoobStage = 0

;inits:
SaveIsEZB = 1
TALENT:MASTER:居場所察知 = 1
SETBIT FLAG:面識ボーナス取得状況, 2
FLAG:会員ランク = 3
CM_COMMISSION = 18
CM_LIMIT = 3000
FLAG:カモられ指数 = 0
GOTO Case0

PRINTFORML Welcome to eraNAS: Legend of Gensokyo!
PRINTFORML Legend of Gensokyo is a turn-based RPG mode for eraNAS set in Gensokyo where the protagonist has to fight against opponents to gain money, further develop their character, and unlock new stages.
PRINTFORML You begin as a nobody, and fight through rivals to ascend to godhood
PRINTL
PRINTFORML [0] I am a new player
PRINTFORML [1] I am a returning player
INPUT
SELECTCASE RESULT
CASE 0
$Case0
NAS_NoobStage = 1
NAS_NoobGuide = 26
nStartingBackstory = 999
CALL NAS_NewPlayer_Guide
CASE 1
FLAG:ゲームモード = 0
nStartingBackstory = 999
CALL BackstoyBonuses
TRYCALLFORM BACKSTORY_{nStartingBackstory}
SIF RESULT == -8888
    RETURN -8888
TalentPointOffset = CalcTalentPointsUsed(MASTER)+nTalentPoints
CALL CHAR_EDITOR_NAS(MASTER)
SIF RESULT == -8888
	RETURN -8888
ENDSELECT

;easyBattle
;(989\e\n)(880\e\n)(999\e\n)(9483\e\n)(560\e\n)(0\e\n)(0\e\n)(0\e\n)(9453\e\n)(1\e\n)(0\e\n)(1\e\n)(999\e\n)(1\e\n)(401\e\n)(987\e\n)(1100\e\n)(0\e\n)
;easyloot
;(9453\e\n)(1\e\n)(0\e\n)(1\e\n)(999\e\n)(1\e\n)(401\e\n)(987\e\n)(1100\e\n)(0\e\n)

@EZB_NEWGAME_BONUSES
#DIMS choices, 100
;初期化
;甲斐性なし、農民
SETBIT FLAG:1000, 1
SETBIT FLAG:1000, 2
;TINKO
SIF !TALENT:MASTER:形状
	TALENT:MASTER:形状 = 3
;服
SIF !CFLAG:MASTER:基本服装セット
	CALL MASTER_CLOTHES_INIT
;
;SIF !ゲーム開始処理中
;	ニューゲーム特典 '= "なし"
;選択肢
VARSET choices
PRINTL
PRINTL
PRINTL Here some various settings can be set before the game starts.
DRAWLINE
choices:0 '= @"Re-customize yourself"
SIF HAS_PENIS(MASTER)
	choices:1 '= @"Your penis is currently a %TINKO_SIMPLE(MASTER)%"
choices:2 '= @"You are wearing %MASTER_CLOTHES_NAME(CFLAG:MASTER:基本服装セット)%"
IF FLAG:甲斐性無
	choices:3 '= @"You do not have the courage to confess"
ELSE
	choices:3 '= @"You can confess"
ENDIF
SIF FLAG:LUSTMODE
	choices:3 += "(Lust mode enabled)"

; choices:20 '= LoG_NEWGAMEBONUS_TEXT()
IF ゲーム引き継ぎ処理中
	choices:21 '= 周回特典_表示()
ENDIF


CALL ASK_CHOICES(choices, 100, "Finished")

SELECTCASE RESULT
CASE 0
		IF !FLAG:なりきり
			CALL CHAR_EDITOR_NAS(MASTER)
			CALL SET_MAINHOME
		ENDIF
CASE 2
	CALL MASTER_CLOTHES
CASE 21
	IF ゲーム引き継ぎ処理中
		CALL 周回特典
	ENDIF
CASE 100
		CALL VIRGIN_SET_APPLY
		CALL SET_BODY_APPLY
		; CALL NEWGAME_BONUS_APPLY
		MONEY += 100000
		CALL SET_APPLY_NOUMIN
		;CALL 周回特典_適用
		ITEM:安物食材 = 10
		RETURN
ENDSELECT
RESTART

;stage 1 starter weapons:
;- danmaku
;- shouwatou katana
;- ftac CC⑮ pistol
;- luninco LAC13 rifle
;- akatsuki Raiken shotgun
;- pd Demi bow
@LoG_STARTER_WEAPON_BONUS_SELECT
#DIMS buttonText, 100
SETCOLOR 103,228,126
PRINTFORML 【Starting Weapons】
RESETCOLOR
PRINTFORML Please choose one. (Click on one to see description)
buttonText:0 '= @"Danmaku"
buttonText:1 '= @"YMKA Shouwatou katana"
buttonText:2 '= @"Fairy Tactical CC⑮ pistol"
buttonText:3 '= @"LUNINCO LAC13 rifle"
buttonText:4 '= @"Akatsuki Raiken shotgun"
buttonText:5 '= @"Phantom Dynamics Demi bow"
buttonText:99 '= @"￥{100000}"
CALL ASK_BUTTONS(buttonText)
SELECTCASE RESULT
CASE 0
	ニューゲーム特典 '= "Danmaku"
	LOCALS = Start with the ability to use Danmaku magic from the start.
CASE 1
	ニューゲーム特典 '= "Katana"
	LOCALS = Start with a katana
CASE 2
	ニューゲーム特典 '= "Handgun"
	LOCALS = Start with a handgun
CASE 3
	ニューゲーム特典 '= "Rifle"
	LOCALS = Start with a single-shot rifle
CASE 4
	ニューゲーム特典 '= "Shotgun"
	LOCALS = Start with a shotgun musket
CASE 5
	ニューゲーム特典 '= "Bow"
	LOCALS = Start with a compound bow
CASE 99
	ニューゲーム特典 '= @"%金額表示(100000)%"
	LOCALS = Starting Money
	PRINTFORMW You get no starting weapon, but you instead get money that you can use on any other weapon.
ENDSELECT
PRINTFORMW %LOCALS% selected.
RETURN

@LoG_NEWGAMEBONUS_TEXT
#FUNCTIONS
SELECTCASE ニューゲーム特典
	CASE ""
		RETURNF "<font color='#67e47e'>" + "Select Starting Weapon" + "</font>"
	CASE "Danmaku"
		RETURNF "Lets you start with the ability to use Danamku from the get go."
	CASE "Katana"
		RETURNF @"Start with a katana."
	CASE "Handgun"
		RETURNF @"Start with a semi-automatic handgun."
	CASE "Rifle"
		RETURNF @"Start with a single-shot rifle."
	CASE "Shotgun"
		RETURNF @"Start with a shotgun musket."
	CASE "Bow"
		RETURNF @"Start with a compound bow."
	CASE @"%金額表示(100000)%"
		RETURNF @"Start with no weapon, but instead %金額表示(100000)%."
ENDSELECT