@EZB_NEWGAME_BONUSES
#DIMS choices, 100
;初期化
;甲斐性なし、農民
SETBIT FLAG:1000, 1
SETBIT FLAG:1000, 2
;TINKO
SIF !TALENT:MASTER:形状
	TALENT:MASTER:形状 = 3
;服
SIF !CFLAG:MASTER:基本服装セット
	CALL MASTER_CLOTHES_INIT
;
;SIF !ゲーム開始処理中
;	ニューゲーム特典 '= "なし"
;選択肢
VARSET choices
PRINTL
PRINTL
PRINTL 게임이 시작되기 전에 다양한 설정을 할 수 있다.
DRAWLINE
choices:0 '= @"자신을 다시 꾸민다"
SIF HAS_PENIS(MASTER)
	choices:1 '= @"당신의 성기는 현재 %TINKO_SIMPLE(MASTER)%이다."
choices:2 '= @"당신은 %MASTER_CLOTHES_NAME(CFLAG:MASTER:基本服装セット)%을 입고 있다."
IF FLAG:甲斐性無
	choices:3 '= @"당신에게는 고백할 담력이 없다"
ELSE
	choices:3 '= @"고백할 수 있다"
ENDIF
SIF FLAG:LUSTMODE
	choices:3 += "(색욕 모드 활성화)"
; choices:20 '= LoG_NEWGAMEBONUS_TEXT()
IF ゲーム引き継ぎ処理中
	choices:21 '= 周回特典_表示()
ENDIF
CALL ASK_CHOICES(choices, 100, "완료")
SELECTCASE RESULT
	CASE 0
		IF !FLAG:なりきり
			CALL CHAR_EDITOR_NAS(MASTER)
			CALL SET_MAINHOME
		ENDIF
	CASE 2
		CALL MASTER_CLOTHES
	CASE 21
		IF ゲーム引き継ぎ処理中
			CALL 周回特典
		ENDIF
	CASE 100
		CALL VIRGIN_SET_APPLY
		CALL SET_BODY_APPLY
		; CALL NEWGAME_BONUS_APPLY
		MONEY += 100000
		CALL SET_APPLY_NOUMIN
		;CALL 周回特典_適用
		ITEM:安物食材 = 10
		RETURN
ENDSELECT
RESTART
