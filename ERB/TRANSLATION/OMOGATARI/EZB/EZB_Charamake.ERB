@LoG_STARTER_WEAPON_BONUS_SELECT
#DIMS buttonText, 100
SETCOLOR 103,228,126
PRINTFORML 【시작 무기】
RESETCOLOR
PRINTFORML 하나를 선택해 주세요. (하나를 클릭하여 설명을 확인하세요)
buttonText:0 '= @"단막"
buttonText:1 '= @"YMKA 쇼와토우 카타나"
buttonText:2 '= @"요정 전술 CC 소총"
buttonText:3 '= @"루닌코 LAC13 소총"
buttonText:4 '= @"아카츠키 라이켄 산탄총"
buttonText:5 '= @"팬텀 다이나믹스 데미 보우"
buttonText:99 '= @"￥{100000}"
CALL ASK_BUTTONS(buttonText)
SELECTCASE RESULT
	CASE 0
		ニューゲーム特典 '= "Danmaku"
		LOCALS '= @"처음부터 단막 마법을 사용할 수 있는 능력으로 시작한다."
	CASE 1
		ニューゲーム特典 '= "Katana"
		LOCALS '= @"카타나로 시작한다"
	CASE 2
		ニューゲーム特典 '= "Handgun"
		LOCALS '= @"권총으로 시작한다"
	CASE 3
		ニューゲーム特典 '= "Rifle"
		LOCALS '= @"단발 소총 하나로 시작한다"
	CASE 4
		ニューゲーム特典 '= "Shotgun"
		LOCALS '= @"산탄총 머스킷으로 시작한다."
	CASE 5
		ニューゲーム特典 '= "Bow"
		LOCALS '= @"복합 활로 시작한다."
	CASE 99
		ニューゲーム特典 '= @"%金額表示(100000)%"
		LOCALS '= @"시작 자금"
		PRINTFORMW 시작 무기는 받지 못하지만 대신 어떤 다른 무기에도 사용할 수 있는 돈을 얻는다.
ENDSELECT
PRINTFORMW %LOCALS%가 선택되었다.
RETURN

@LoG_NEWGAMEBONUS_TEXT
#FUNCTIONS
SELECTCASE ニューゲーム特典
	CASE ""
		RETURNF "<font color='#67e47e'>" + "시작 무기 선택" + "</font>"
	CASE "Danmaku"
		RETURNF "처음부터 탄막을 사용할 수 있게 됩니다."
	CASE "Katana"
		RETURNF @"카타나로 시작한다."
	CASE "Handgun"
		RETURNF @"자동권총으로 시작한다."
	CASE "Rifle"
		RETURNF @"단발 소총으로 시작한다."
	CASE "Shotgun"
		RETURNF @"산탄총으로 시작한다."
	CASE "Bow"
		RETURNF @"복합 활로 시작한다."
	CASE @"%金額表示(100000)%"
		RETURNF @"무기 없이 시작하지만 대신 %金額表示(100000)%이다."
ENDSELECT
