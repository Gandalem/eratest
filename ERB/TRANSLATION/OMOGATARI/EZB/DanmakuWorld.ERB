@LoG_DW_LicenseName(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE IS >= 6
		RETURNF "Extra Stage"
	CASE 0
		RETURNF "No License"
	CASEELSE
		RETURNF @"스테이지 {ARG+1}"
ENDSELECT

@LoG_DW_PageName(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "Be Free"
	CASE 1
		RETURNF "Human Village"
	CASE 2
		RETURNF "Youkai Mountain"
	CASE 3
		RETURNF "Misty Lake"
	CASE 4
		RETURNF "Hijiri Temple"
	CASE 5
		RETURNF "Netherworld"
	CASE 6
		RETURNF "Moon"
	CASE 7
		RETURNF "The Rest of Gensokyo"
	CASE 8
		RETURNF "Makai"
	CASE 10
		RETURNF "Direct Messages"
	CASE 11
		RETURNF "Announcements"
ENDSELECT

@DanmakuWorld_Page_CanDo(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 0, 1, 10, 11
		RETURNF 1
	CASE 2, 3
		RETURNF LegendModeStage >= 1
	CASE 4
		RETURNF LegendModeStage >= 2
	CASE 5
		RETURNF LegendModeStage >= 3
	CASE 6
		RETURNF LegendModeStage >= 4
	CASE 7
		RETURNF LegendModeStage >= 5
	CASE 8
		RETURNF LegendModeStage >= 6
ENDSELECT
