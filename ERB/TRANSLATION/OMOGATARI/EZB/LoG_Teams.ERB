;check if all rivals on a team have been defeated
;aside from team leader
;a bit jank since it has to loop between all characters in the game

@LoG_OthersFromTeamDefeated(ARG = 0)
#FUNCTION
#DIM DYNAMIC charaTeamList, 100
#DIM DYNAMIC charaBoss = 0
#DIM DYNAMIC charaTeamSize
#DIM DYNAMIC C_ID
#DIM DYNAMIC R_ID
;wanderer or WOF
SIF !ARG || !SaveIsEZB
    RETURNF
;get all characters in team
charaTeamSize = DT_SELECT("LoG_RivalStat", @"teamID = {ARG}", "", charaTeamList)
FOR LOCAL, 0, charaTeamSize
    R_ID = DT_CELL_GET("LoG_RivalStat", charaTeamList:LOCAL, "rivalID", 1)
    C_ID = DT_CELL_GET("LoG_RivalStat", charaTeamList:LOCAL, "charaID", 1)
    CALLF LoG_RIVALDATA(R_ID,1)
    ; DEBUGPRINTFORML {charaTeamList:LOCAL} %CALLNAME:C_ID% (chara {C_ID} - rival {R_ID}): wins {DT_CELL_GET("LoG_RivalStat", charaTeamList:LOCAL, "win", 1)}
    IF charaBoss == 0 && LoG_BossType == "team"
        charaBoss = C_ID
        CONTINUE
    ELSEIF DT_CELL_GET("LoG_RivalStat", charaTeamList:LOCAL, "win", 1) == 0
        RETURNF 0
    ENDIF
NEXT
RETURNF 1

@LoG_TeamLeader(ARG = 0,ARG:1)
#FUNCTION
#DIM DYNAMIC charaTeamList, 100
#DIM DYNAMIC charaBoss = 0
#DIM DYNAMIC charaTeamSize
#DIM DYNAMIC C_ID
#DIM DYNAMIC R_ID
;wanderer or WOF
SIF !ARG || !SaveIsEZB
    RETURNF
;get all characters in team
charaTeamSize = DT_SELECT("LoG_RivalStat", @"teamID = {ARG}", "", charaTeamList)
FOR LOCAL, 0, charaTeamSize
    R_ID = DT_CELL_GET("LoG_RivalStat", charaTeamList:LOCAL, "rivalID", 1)
    C_ID = DT_CELL_GET("LoG_RivalStat", charaTeamList:LOCAL, "charaID", 1)
    CALLF LoG_RIVALDATA(R_ID,1)
    IF charaBoss == 0 && LoG_BossType == "team"
        SELECTCASE ARG:1
        CASE 0
        RETURNF C_ID
        CASE 1
        RETURNF R_ID
        ENDSELECT
    ENDIF
NEXT
RETURNF -1

