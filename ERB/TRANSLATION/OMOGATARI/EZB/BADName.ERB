IF TotalBattleStats:Battle_Count < BAD_BATTLE_THRESHOLDS:0 && DAY < 7
	RETURNF "New Beginner"
ENDIF
;get the level
FOR BAD_NAME_LEVEL, 0, VARSIZE("BAD_BATTLE_THRESHOLDS")
IF TotalBattleStats:Battle_Count < BAD_BATTLE_THRESHOLDS:BAD_NAME_LEVEL
	BAD_NAME_LEVEL --
	BREAK
ENDIF
NEXT
;Get the adjective.
FOR BAD_NAME_LOOP, 0, VARSIZE("BAD_NAME_PART_A")
SELECTCASE BAD_NAME_PART_A:BAD_NAME_LOOP
	CASE "TURN_MIN"
		IF (TotalBattleStats:Battle_Turns/MAX(1,TotalBattleStats:Battle_Count)) <= GETVAR(@"BAD_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BAD_NAME_PART:0 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BREAK
		ENDIF
	CASE "TURN_MAX"
		IF (TotalBattleStats:Battle_Turns/MAX(1,TotalBattleStats:Battle_Count)) >= GETVAR(@"BAD_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BAD_NAME_PART:0 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BREAK
		ENDIF
	CASE "DAMAGE_AVG"
		IF (TotalBattleStats:Battle_Damage/MAX(1,TotalBattleStats:Battle_Count)) >= GETVAR(@"BAD_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BAD_NAME_PART:0 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BREAK
		ENDIF
	CASE "RETIRE"
		IF GETVAR(@"BAD_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}") >= 100
		ELSE
			IF (TotalBattleStats:Battle_Surrender) >= GETVAR(@"BAD_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
				BAD_NAME_PART:0 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
				BREAK
			ENDIF
		ENDIF
	CASE "OMORASHI"
		SIF !CAN_ACCIDENT(MASTER,1) && !CAN_ACCIDENT(MASTER,2)
			CONTINUE
		IF (Qol_Info_Count_Array:MASTER:Qol_Count_Wetting+Qol_Info_Count_Array:MASTER:Qol_Count_Messing) >= GETVAR(@"BAD_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BAD_NAME_PART:0 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BREAK
		ENDIF
		; CASE "OMORASHI_MIN"
		;     SIF !CAN_ACCIDENT(MASTER,1) && !CAN_ACCIDENT(MASTER,2)
		;         CONTINUE
		;     IF (Qol_Info_Count_Array:MASTER:Qol_Count_Wetting+Qol_Info_Count_Array:MASTER:Qol_Count_Messing) <= GETVAR(@"BAD_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
		;         BAD_NAME_PART:0 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
		;         BREAK
		;     ENDIF
	CASE "WIN_STREAK"
		IF MAX(TotalBattleStats:Battle_Streak,TotalBattleStats:Battle_StreakMax) >= GETVAR(@"BAD_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BAD_NAME_PART:0 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_A:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BREAK
		ENDIF
ENDSELECT
NEXT
IF !STRLENS(BAD_NAME_PART:0)
	;day fallback
	FOR BAD_NAME_LOOP, 0, VARSIZE("BAD_DAY")
	IF DAY < BAD_DAY
		BAD_NAME_LOOP --
		BAD_NAME_PART:0 '= BAD_TITLES_DAY:BAD_NAME_LOOP
		BREAK
	ENDIF
	NEXT
ENDIF
;Get the Noun.
FOR BAD_NAME_LOOP, 0, VARSIZE("BAD_NAME_PART_B")
SELECTCASE BAD_NAME_PART_B:BAD_NAME_LOOP
	CASE "ACCURACY_MAX"
		IF (TotalBattleStats:Battle_Hits/MAX(1,TotalBattleStats:Battle_Attacks)) >= GETVAR(@"BAD_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BAD_NAME_PART:1 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BREAK
		ENDIF
	CASE "DODGE_MAX"
		IF (TotalBattleStats:Battle_Dodges/MAX(1,TotalBattleStats:Battle_AttacksAgainst)) >= GETVAR(@"BAD_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BAD_NAME_PART:1 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BREAK
		ENDIF
	CASE "DODGE_MAX"
		IF (TotalBattleStats:Battle_Dodges/MAX(1,TotalBattleStats:Battle_AttacksAgainst)) >= GETVAR(@"BAD_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BAD_NAME_PART:1 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BREAK
		ENDIF
	CASE "DAMAGE_MAX"
		IF (TotalBattleStats:Battle_DamageMax) >= GETVAR(@"BAD_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BAD_NAME_PART:1 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BREAK
		ENDIF
	CASE "KILLS_MAX"
		IF (TotalBattleStats:Battle_EnemyMax) >= GETVAR(@"BAD_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BAD_NAME_PART:1 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BREAK
		ENDIF
	CASE "WR"
		IF ((TotalBattleStats:Battle_Win*100)/MAX(1,TotalBattleStats:Battle_Count)) >= GETVAR(@"BAD_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BAD_NAME_PART:1 '= GETVARS(@"BAD_TITLES_%BAD_NAME_PART_B:BAD_NAME_LOOP%:{BAD_NAME_LEVEL}")
			BREAK
		ENDIF
ENDSELECT
NEXT
;stage fallback
IF !STRLENS(BAD_NAME_PART:1)
	IF SaveIsEZB
		BAD_NAME_PART:1 '= BAD_TITLES_GENERIC_NOUN:LegendModeStage
	ELSE
		BAD_NAME_PART:1 '= "Resident"
	ENDIF
ENDIF
RETURNF BAD_NAME_PART:0+" "+BAD_NAME_PART:1
;SB01 BAD names
;https://w.atwiki.jp/highwaybattle/pages/65.html
; About B.A.D. Names
; B.A.D. Names (according to strategy guides, an abbreviation for Battle Ability Decision; hereafter referred to as “Names”) are like nicknames separate from the car model names. Simply put, they are the names that appear next to your SP gauge during battles. These aren't randomly assigned; there are rules governing how Names are determined.
; Typically, it's determined by your driving style (hereafter referred to as the standard name). However, there are also special names obtained by applying specific team stickers to certain car models.
; ----Overview of Standard Names---
; Standard names are determined based on your driving performance and take the form of two combined titles (adjective + noun). For example:
; “Precision Machine of Frustration”
; In this name:
; The “Precision Machine” part reflects your driving performance in terms of “relatively short average race distance,” while the “of Frustration” part reflects your driving performance in terms of “relatively short average race distance.”
; “Precision Machine” each reflect aspects of your driving performance.
; In this case, “of Frustration” signifies “a relatively short average distance per battle,” while “Precision Machine” indicates “a relatively low number of collisions with other cars.”
; So, what factors are reflected?
; First, the major determining factors are:
; Total number of battles
; In addition to this, the following items A and B serve as evaluation factors.
; A) Evaluation factors for the first half of the name (the adjective part)
; 　　Short average distance traveled per battle
; 　　Long average distance traveled per battle
; 　　Average speed during battles
; 　　Number of retirements
; 　　Highest speed achieved during a battle
; 　　Highest consecutive win streak
; 　　(any one of these 6 elements)
;
; B) Meaning of the second half of the name (the noun part)
; 　　Fewest number of collisions with cars
; 　　Most number of collisions with cars
; 　　Fewest number of collisions with walls
; 　　Most number of collisions with walls
; 　　Highest win rate
; 　　Longest total distance driven
; 　　(any one of these 6 elements)
;
; Among the elements listed in parallel in A and B, whichever element is listed higher in A or B will be prioritized for reflection in the name.
; For example, if both average speed and top speed meet the title conditions in A, the average speed element takes priority and is reflected in the name.
; Incidentally, except for the number of retirements and the number of collisions with walls or cars, you can check the other data by pressing the R2 button on the Garage TOP screen. The average distance traveled during battles can be calculated by dividing the Distance item by the total number of battles.
; ---Specific Name Determination Criteria---
; You probably have a general idea of the types of elements reflected in names and their priority order, but this approach
; “So, this name is ~~ right now, but what exactly does it mean??”
; Therefore, I'll list specific titles and their determination criteria below in detail. (For some reason, making a table is too narrow and doesn't work well, so please use the search function to find the relevant title orz)
; As mentioned earlier, total battle count is also a determining factor, so the “~ battles or more” written at the beginning refers to that.
