;creates easybattle fighters

@EZB_MAKE_FIGHTER(ARG,combatLeague,combatFighterClass=-1)
#DIM DYNAMIC combatFighterID
#DIM DYNAMIC combatLeague
#DIM DYNAMIC combatFighterClass
SIF combatFighterClass == -1
	combatFighterClass = RAND(10)
$RollForFighter
VARSET TempMobName
combatFighterID = 10000+(combatLeague*100)+combatFighterClass
CALL MobEnemyArchive(ARG,combatFighterID)
IF !STRLENS(TempMobName)
	;come back with an new class and try fucking again
	combatFighterClass = RAND(100)
	GOTO RollForFighter
ENDIF
CALL SpawnMobEnemy(ARG, combatFighterID)
CFLAG:ARG:出禁 = 0
EZB_LEAGUE:ARG:0 = combatLeague
EZB_ELO:ARG:0 = RAND(EZB_THRESHOLDS:(combatLeague), combatLeague+1 >= VARSIZE("EZB_THRESHOLDS") ? EZB_THRESHOLDS:(combatLeague)+200 # EZB_THRESHOLDS:(combatLeague+1))
RETURN ARG
;initalize elo

@EZB_INIT_CHARA_LEAGUE(ARG)
#FUNCTION
EZB_LEAGUE:ARG:0 = EZB_INIT_CHARA_LEAGUE_CALC(ARG)
EZB_ELO:ARG:0 = EZB_THRESHOLDS:(EZB_LEAGUE:ARG:0)
;calculate the touhou's elo

@EZB_INIT_CHARA_LEAGUE_CALC(ARG)
#FUNCTION
#DIM LevelList,2
SELECTCASE ARG
	CASE 0
		;MC-chan
		;starts at the bottom of preemie
		RETURNF 0
	CASEELSE
		;use highest combat stat to get league
		FOR LOCAL, 13, -1, -1
		LevelList:1 = EZB_LEAGUE_LEVELS(LOCAL)
		LevelList:0 = RESULT:1
		SIF !INRANGE(MAX(ABL:ARG:42,ABL:ARG:66,ABL:ARG:67),LevelList:0,LevelList:1)
			CONTINUE
		RETURNF LOCAL
		NEXT
ENDSELECT

