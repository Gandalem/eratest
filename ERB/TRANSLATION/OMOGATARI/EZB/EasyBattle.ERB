@EasyBattleArmor(nChara,nRank)
#DIM nRank
#DIM nChara
#DIM DYNAMIC nSet
VARSET ArmorCharges:nChara:0:0

SELECTCASE nRank
CASE IS >= UniversalRank("TriUltra")
nSet = 89 
CASE IS >= UniversalRank("OverDrive")
nSet = 86
CASE IS >= UniversalRank("Phantasm")
nSet = 85
CASE IS >= UniversalRank("Extra")
nSet = 84 
CASE IS >= UniversalRank("S")
nSet = 83
CASE IS >= UniversalRank("A")
nSet = 82
CASE IS >= UniversalRank("B")
nSet = 81
CASEELSE
nSet = 1
ENDSELECT
CALL CTRL_CLOTHES_SET(nChara, "現在衣装の変更_衣装セット", nSet)

@FAKEBATTLE
#FUNCTION
#DIM nChara
CALLF RemoveAllCombatants()
CALLF FISHER_YATES_SHUFFLE_F(CHARANUM)
FLAG:POSTAL = 2
FOR LOCAL, 0, 10
    nChara = SHAFFLE_ARRAY:LOCAL
    SIF CFLAG:nChara:出禁
        CONTINUE
    SIF IsDead:nChara:0
        CONTINUE    
    EQUIP:nChara:Weapon = ARMUP(nChara)	
    CALLF AddCombatant(nChara,0)
NEXT
FOR LOCAL, 10, 20
    nChara = SHAFFLE_ARRAY:LOCAL
    SIF CFLAG:nChara:出禁
        CONTINUE
    SIF IsDead:nChara:0
        CONTINUE     
    EQUIP:nChara:Weapon = ARMUP(nChara)	
    CALLF AddCombatant(nChara,1)
NEXT
RETURNF GetCombatantSize()
[SKIPEND]

@EXP_DEMAND_EZB(ARG = 0)
#FUNCTION
VARSET LOCAL
SELECTCASE EasyBattleLevel + ARG
	CASE 0
		LOCAL:12 = 1000
	CASE 1
		LOCAL:12 = 2500
	CASE 2
		LOCAL:12 = 5000
	CASE 3
		LOCAL:12 = 10000
	CASE 4
		LOCAL:12 = 30000
	CASE 5
		LOCAL:12 = 45000
	CASE 6
		LOCAL:12 = 60000
	CASE 7
		LOCAL:12 = 75000
	CASE 8
		LOCAL:12 = 100000
	CASE 9
		LOCAL:12 = 150000
	CASEELSE
		LOCAL:12 = 100000 * ((EasyBattleLevel + ARG) - 3)
ENDSELECT

RETURNF LOCAL:12


