@EZB_ELO_NEW(toRate,rateOp,gotScore=1,kFactor=30)
#FUNCTION
#DIM DYNAMIC toRate
#DIM DYNAMIC rateOp
#DIM DYNAMIC expectedScore
#DIM DYNAMIC gotScore
#DIM DYNAMIC kFactor
#DIM STATIC multFactor = 1000000
;expected scores
;multiply by 1000 because no floats
expectedScore = multFactor/(1+(NUM_EXPONENT_ELO(10,(EZB_ELO:(rateOp):0-EZB_ELO:(toRate):0)*1000/400)))
DEBUGPRINTFORML 예상 점수: {expectedScore:0}
RETURNF ((multFactor*EZB_ELO:toRate:0) + (kFactor*(((gotScore*multFactor)-expectedScore))))/multFactor
; expectedScore:0 = multFactor/(1+(NUM_EXPONENT(10,(EZB_ELO:(55):0-EZB_ELO:(0):0)/400)))
;----------------------------------------------------------------------
;Exponent function with thousand multipliers
;----------------------------------------------------------------------

@NUM_EXPONENT_ELO(ARG,nDegree)
#FUNCTION
#DIM nDegree
#DIM nNum
#DIM STATIC nOffset = 1000
nNum = ARG
SIF nDegree == 0
	RETURNF 1
IF nDegree > 1000
	REPEAT (nDegree/nOffset)-1
	nNum *= ARG
	REND
ELSE
ENDIF
RETURNF nNum
