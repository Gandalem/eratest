@EXP_DEMAND_EZB(ARG = 0)
#FUNCTION
VARSET LOCAL
SELECTCASE EasyBattleLevel + ARG
	CASE 0
		LOCAL:12 = 1000
	CASE 1
		LOCAL:12 = 2500
	CASE 2
		LOCAL:12 = 5000
	CASE 3
		LOCAL:12 = 10000
	CASE 4
		LOCAL:12 = 30000
	CASE 5
		LOCAL:12 = 45000
	CASE 6
		LOCAL:12 = 60000
	CASE 7
		LOCAL:12 = 75000
	CASE 8
		LOCAL:12 = 100000
	CASE 9
		LOCAL:12 = 150000
	CASEELSE
		LOCAL:12 = 100000 * ((EasyBattleLevel + ARG) - 3)
ENDSELECT
RETURNF LOCAL:12

