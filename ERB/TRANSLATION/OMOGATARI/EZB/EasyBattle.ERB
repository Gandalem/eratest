					EasyBattleSave:3 = LOCAL:1
					PRINTFORMW You have unlocked %NAME:(LOCAL:1)%!
				ELSE
					PRINTFORMW Not enough money...
				ENDIF
				ENDSELECT
			ELSE
					PRINTFORML You are now %NAME:(LOCAL:1)%.
					EasyBattleSave:3 = (LOCAL:1)
			ENDIF
	ENDSELECT
CASE 2
	CALL Weapon_Chose_State(MASTER,,2)
CASE 3
	PRINTFORML Please enter a value
	FOR LOCAL,0,(MaxNonHLevel+1)
		SELECTCASE LOCAL
		CASE 0 TO UniversalRank("Extra"), UniversalRank("Phantasm"), UniversalRank("OverDrive"), UniversalRank("TriUltra"), UniversalRank("QuadUltra")
		SIF LOCAL > EasyBattleSave
			CONTINUE

			CALL PRINT_RANK(LOCAL,"MAX_6")
			PRINTBUTTON @" {LOCAL}", LOCAL
			PRINTFORML
		ENDSELECT
	NEXT

	PRINTFORML [-1] Cancel
	INPUT
	SIF RESULT != -1 && RESULT <= EasyBattleSave && RESULT <= MaxNonHLevel
	EasyBattleSave:5 = RESULT
CASE 80

CASE 81
	CALL ASK_M("Change my team rank", 1, "Change my enemy's team rank", 1, "Leave", 1)
	SELECTCASE RESULT
	CASE 0
		PRINTFORML Please select a team rank
		PRINTFORM Your max team rank: 
		CALL PRINT_RANK(MIN(EasyBattleSave/3,MaxNonHLevel),"MAX_6")
		PRINTFORML  {MIN(EasyBattleSave/3,MaxNonHLevel)}
		FOR LOCAL,0,(MaxNonHLevel+1)
			SELECTCASE LOCAL
			CASE 0 TO UniversalRank("Extra"), UniversalRank("Phantasm"), UniversalRank("OverDrive"), UniversalRank("TriUltra"), UniversalRank("QuadUltra")
			SIF LOCAL > EasyBattleSave/3
				CONTINUE

				CALL PRINT_RANK(LOCAL,"MAX_6")
				PRINTBUTTON @" {LOCAL}", LOCAL
				PRINTFORML
			ENDSELECT
		NEXT		
		INPUT
		LOCAL = RESULT
		SELECTCASE RESULT
		CASE IS > MaxNonHLevel
			PRINTFORML Max rank is level {MaxNonHLevel}
		CASE IS < 0
			PRINTFORML Minimum rank must be 0
		CASE IS > MAX(EasyBattleSave/3,1)
			PRINTFORML Insufficient rank.
		CASEELSE
			PRINTFORML Change accepted
			PRINTFORM Your team rank is now 
			CALL PRINT_RANK(LOCAL,"MAX_6")
			PRINTFORML  {LOCAL}			
			WAIT
			EasyBattleSave:8 = LOCAL
		ENDSELECT
	CASE 1
		PRINTFORML Please select a team size
		PRINTFORM Enemy's max team rank: 
		CALL PRINT_RANK(MIN(EasyBattleSave,MaxNonHLevel),"MAX_6")
		PRINTFORML  {MIN(EasyBattleSave,MaxNonHLevel)}
		FOR LOCAL,0,(MaxNonHLevel+1)
			SELECTCASE LOCAL
			CASE 0 TO UniversalRank("Extra"), UniversalRank("Phantasm"), UniversalRank("OverDrive"), UniversalRank("TriUltra"), UniversalRank("QuadUltra")
			SIF LOCAL > EasyBattleSave
				CONTINUE

				CALL PRINT_RANK(LOCAL,"MAX_6")
				PRINTBUTTON @" {LOCAL}", LOCAL
				PRINTFORML
			ENDSELECT
		NEXT		
		INPUT
		LOCAL = RESULT
		SELECTCASE RESULT
		CASE IS > MaxNonHLevel
			PRINTFORML Max rank is level {MaxNonHLevel}
		CASE IS < 0
			PRINTFORML Minimum rank must be 0
		CASE IS > EasyBattleSave
			PRINTFORML Insufficient rank.
		CASEELSE
			PRINTFORML Change accepted
			PRINTFORM The enemy's team rank is now 
			CALL PRINT_RANK(LOCAL,"MAX_6")
			PRINTFORML  {LOCAL}			
			WAIT			
			EasyBattleSave:9 = LOCAL
		ENDSELECT	
	ENDSELECT
CASE 84
	EasyBattleSave:10 = !EasyBattleSave:10
CASE 85
	EasyBattleSave:11 = !EasyBattleSave:11
CASE 86
	EasyBattleSave:12 = !EasyBattleSave:12
CASE 87
	CALL CUSTOM_CHARA_MENU
CASE 89
	PRINTFORML Combat Simulation Tool:
	PRINTFORML Please understand that these are a work in progress.
	PRINTL
	PRINTFORML Work in progress! Sorry!
	PRINTFORMW
CASE 98
	SIF CFLAG:(EasyBattleSave:3):別顔有 || CFLAG:(EasyBattleSave:3):別立ち有
		CFLAG:(EasyBattleSave:3):差し替え適用 += 1
	SIF (CFLAG:(EasyBattleSave:3):差し替え適用 > CFLAG:(EasyBattleSave:3):別顔有 && FLAG:立ち絵種類) || (CFLAG:(EasyBattleSave:3):差し替え適用 > CFLAG:(EasyBattleSave:3):別立ち有 && !FLAG:立ち絵種類) ;custom code
		CFLAG:(EasyBattleSave:3):差し替え適用 = 0
CASE 画像切り替え
	IF !FLAG:画像表示
		FLAG:画像表示 = !FLAG:画像表示
		SIF FLAG:画像表示 && nStoreImageCount > 0 ;qol custom code, restore previous value if enabled
			FLAG:画像表示 = nStoreImageCount
		
		FLAG:立ち絵種類 = 0
		CFLAG:(EasyBattleSave:3):差し替え適用 = 0 ;custom code
	ELSEIF !FLAG:立ち絵種類
		FLAG:立ち絵種類 = !FLAG:立ち絵種類
	ELSEIF FLAG:立ち絵種類
		SIF FLAG:画像表示 ;qol custom code, store previous value if it's going to be disabled
			nStoreImageCount = FLAG:画像表示
		
		FLAG:画像表示 = !FLAG:画像表示
	ENDIF
CASE -99
	PRINTFORML ARE YOU SURE?
	CALL ASK_YN()
	IF !RESULT
		SETCOLOR C_RED
		PRINTFORMW ARE YOU REALLY SURE YOU WANT TO CLEAR YOUR EASYBATTLE DATA?
		PRINTFORMW THIS WILL WIPE YOUR LEVEL, YOUR CHARACTERS AND WEAPONS, AND MONEY!
		RESETCOLOR
		CALL ASK_YN()
		IF !RESULT
		PRINTFORMW EasyBattle data has been cleared
		PRINTFORMW Returning to NAS title screen.
		VARSET EasyBattleSave
		SaveIsEZB = 0
		SAVEGLOBAL
		RETURN
		ENDIF
	ENDIF
CASE 100





SAVEGLOBAL
LOADGLOBAL



SAVEGLOBAL
CASE 101
CALLF HESOYAM()
CALLF RemoveAllCombatants()
NPCBattle = 1
GOTO STARTBATTLE

CASE 999
SaveIsEZB = 0
SAVEGLOBAL
RETURN
CASE 103
PRINTFORMW Not working yet. Sorry!
ENDSELECT
