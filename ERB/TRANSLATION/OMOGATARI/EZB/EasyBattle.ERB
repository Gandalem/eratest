PRINTFORML [999] - Leave 
INPUT
SELECTCASE RESULT
CASE 1
	CALL SHOW_CHARA_LIST_TR()
	LOCAL:1 = RESULT
	SELECTCASE LOCAL:1
		CASE 999
			PRINTFORML You lose interest, and you are stil who you are.
		CASEELSE
			IF !EasyBattleCharacterUnlock:(LOCAL:1)
				;LOCAL:3 = (ABL:(LOCAL:1):42 * 1000) + (ABL:(LOCAL:1):66 * 2000) + (ABL:(LOCAL:1):67 * 750) + (TALENT:(LOCAL:1):ESP * 10000) + (BASE:(LOCAL:1):0 * 100)
				LOCAL:3 = (TALENT:(LOCAL:1):ESP * 10000) + (MAXBASE:(LOCAL:1):TSP * 1000) + (MAXBASE:(LOCAL:1):0 * 100)
				PRINTFORML Unlocking %CALLNAME:(LOCAL:1)% will cost %金額表示(LOCAL:3)%
				PRINTFORML Pay?
				CALL ASK_YN()
				SELECTCASE RESULT 
				CASE 0
				IF EasyBattleSave:2 >= LOCAL:3
