@LoG_StageEndCond
#FUNCTION
SELECTCASE LegendModeStage
	CASE 0
		;stage 1
		RETURNF LoG_RivalWins(122) && LoG_RivalWins(123)
	CASE 1
		RETURNF LoG_RivalWins(34)
	CASE 2
	CASE 3
	CASE 4
	CASE 5
	CASE 6
		RETURNF LoG_RivalWins(102)
ENDSELECT
RETURNF 0

@LoG_AdvancePlayerStage
IF SaveIsEZB
	LoG_EndDayAfterWin = 0
	;final playable stage
	IF LoG_StageEndCond() && LegendModeStage+1 >= (LoG_ShowAllRivals ? LoG_StageMax # LoG_StageMaxPlayable) && LegendModeStage+1 < LoG_StageMax
		CALL LoG_StartCutScene(((LegendModeStage+1)*1000)+998)
		IF RESULT
			CALL LoG_STAGE_CLEAR_BONUS(LegendModeStage)
			FORCEWAIT
		ENDIF
	ELSEIF LoG_StageEndCond() && LegendModeStage+1 < (LoG_ShowAllRivals ? LoG_StageMax # LoG_StageMaxPlayable)
		;advance stage
		LegendModeStage++
		CALL LoG_StartCutScene((LegendModeStage+1)*1000)
		; IF RESULT
		; 	CALL LoG_STAGE_CLEAR_BONUS(LegendModeStage-1)
		; 	FORCEWAIT
		; ENDIF
	ENDIF
ENDIF
