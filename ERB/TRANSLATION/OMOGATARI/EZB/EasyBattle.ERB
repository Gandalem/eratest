@EZB_ELO_BAR(ARG,ShowProgress=0)
#DIM DYNAMIC ShowProgress
SIF ShowProgress
PRINTFORM Elo: {EZB_ELO:ARG:0} (%EZB_RANKS(EZB_LEAGUE:ARG:0,1)%) 

IF EZB_LEAGUE:ARG:0 >= VARSIZE("EZB_THRESHOLDS")-1
	PRINTFORM [
	CALL PRINT_COLORBAR(1,1, 15, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑"), RESULT:1)
	PRINTFORM ] %"Max League",15,LEFT%
