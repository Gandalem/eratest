@LoG_StartCutScene(ARG,ReplayScene=0)
#DIM DYNAMIC ReplayScene
IF CEVENT(@"LoG_CutScene_{ARG}", MASTER) && !ReplayScene
    RETURN
ENDIF

CALL EZB_CUTSCENES(ARG)

CALLF SET_CEVENT(@"LoG_CutScene_{ARG}",MASTER)
RETURN 1

@LoG_STAGE_CLEAR_BONUS(ARG, VALUE, PRINT_TYPE)
#DIM VALUE
#DIM PRINT_TYPE
IF !VALUE
    SELECTCASE ARG
    CASE 0
    ;stage 1
    VALUE = 1500000
    CASE 1
    ;stage 2
    CASE 2
    ;stage 3
    VALUE = 8000000
    CASE 3
    ;stage 4
    VALUE = 15000000
    CASE 4
    ;stage 5
    VALUE = 100000000
    CASE 5
    ;stage 6
    VALUE = 250000000
    CASE 6
    ;extra stage
    VALUE = __INT_MAX__
    ENDSELECT
ENDIF
 
