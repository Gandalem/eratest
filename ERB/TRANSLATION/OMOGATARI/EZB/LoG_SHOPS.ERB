; Modular ERB: OMOGATARI/EZB/LoG_SHOPS.ERB
;Weapon shop for the Legend of Gensokyo mode
;The Stage element determines what stages the weapon will be unlocked for the player.
;Buying that weapon will give you one copy of that weapon.

@LoG_WeaponShop
#DIM WSLinecount
#DIM WSInput
#DIM WSPage
#DIM WSWeapon
#DIM nPrice
#DIMS CONST DispName = "Blunt Melee", "Blades", "Throwing", "Pistols", "Rifles", "Shotguns", "Machine Guns", "Explosives", "Bows", "Youjutsu", "Hybrid", "All"
gLineCount = WSLinecount
DO
CLEARLINE LINECOUNT-WSLinecount
CALL LoG_WeaponShopDisplay(DispName:WSPage)
DRAWLINE
FOR LOCAL, 0, VARSIZE("DispName")
SIF WSPage == LOCAL
	SETCOLOR 0x00FFFF
;exception for player character
PRINTBUTTON DispName:LOCAL, LOCAL + 2
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTFORML 
PRINTBUTTON "[부속품]", -3433
PRINTL
PRINTBUTTON "[반환]", -3432
CALL LoG_AdvanceTutorial(20)
SIF RESULT
	RESTART
INPUT
WSInput = RESULT
SELECTCASE WSInput
	CASE -3432
		IF !DT_ROW_LENGTH("WeaponInventory")
			PRINTFORMW 주먹으로만 싸우고 싶습니까?
			CALL ASK_YN()
			SIF RESULT
				CONTINUE
			CALL LoG_AdvanceTutorial(21)
			CALL LoG_AdvanceTutorial(30)
		ELSE
			CALL LoG_AdvanceTutorial(30)
		ENDIF
		RETURN 1
	CASE -3433
		CALL TOOL_DEVELOP
	CASE 2 TO VARSIZE("DispName")+2
		WSPage = WSInput-2
	CASE IS > 3000
		WSWeapon = WSInput-3000
		TempMod = WSWeapon
		nPrice = ClothPrice("Weapon",WSWeapon,MASTER)
		SIF !nPrice
			nPrice = 250
		IF GET_INT(MASTER,"Weapon",WSWeapon,"Quest Only")
			PRINTFORMW 이 퀘스트 전용 무기를 잠금 해제하기에 요구 사항이 부족하다.
			CONTINUE
		ELSEIF LegendModeStage < GET_INT(MASTER,"Weapon",WSWeapon,"Grade")
			PRINTFORML 이것은 %LoG_StageName(GET_INT(MASTER,"Weapon",WSWeapon,"Grade"))% 무기다!
			PRINTFORMW 당신은 현재 %LoG_StageName(LegendModeStage)%에만 있다
			CONTINUE
		ENDIF
		CALL WeaponDescription(WSWeapon)
		PRINTFORML %UNDIES_NAME_WITH_BRAND(MASTER,WSWeapon,1,24)%을(를) 구매한다?
		CALL ASK_YN()
		IF !RESULT
			IF MONEY < nPrice
				PRINTFORMW 돈이 충분하지 않다.
				CONTINUE
			ENDIF
			MONEY -= nPrice
			CALLF CREATE_WEAPON(WSWeapon)
			PRINTFORMW %UNDIES_NAME_WITH_BRAND(MASTER,WSWeapon,1,24)%를 구매했다!
			CALL LoG_AdvanceTutorial(30)
			CONTINUE
		ELSE
			CONTINUE
		ENDIF
ENDSELECT
LOOP 1
;Not enough Money...
;Not enough CM...

@LoG_WeaponShopDisplay(ARGS)
#DIM DYNAMIC nPrice
#DIM DYNAMIC L_ENTRIES
#DIM DYNAMIC L_LINES
PRINTFORML 구매할 무기를 선택해 주십시오. (돈: %金額表示(MONEY)% )
DRAWLINE
FOR LOCAL:1,2,VAR_TEMP_MAX
SIF CLOTHNAME(24, LOCAL:1) == ""
	CONTINUE
SIF !CHECK_WEAPON(LOCAL:1, ARGS)
	CONTINUE
nPrice = ClothPrice("Weapon",LOCAL:1,MASTER)
SIF !nPrice
	nPrice = 250
IF GET_INT(MASTER,"Weapon",LOCAL:1,"Quest Only")
	LOCALS:1 = Quest Only
	SETCOLOR C_GRAY
ELSEIF LegendModeStage < GET_INT(MASTER,"Weapon",LOCAL:1,"Grade")
	LOCALS:1 = %LoG_StageName(GET_INT(MASTER,"Weapon",LOCAL:1,"Grade"))%
	SETCOLOR C_GRAY
ELSEIF MONEY < nPrice
	LOCALS:1 = %金額表示(nPrice)%
	SETCOLOR C_GRAY
ELSE
	LOCALS:1 = %金額表示(nPrice)%
ENDIF
LOCALS = [{(LOCAL:1)+3000,4}]%UNDIES_NAME_WITH_BRAND(MASTER,LOCAL:1,,24)%
PRINTFORM %LOCALS, 50, LEFT% %LOCALS:1, 11% 
RESETCOLOR
L_ENTRIES ++
IF L_ENTRIES % 3 == 0
	PRINTL
	L_LINES ++
ENDIF
NEXT
IF L_ENTRIES % 3 != 0
	PRINTL
ENDIF
