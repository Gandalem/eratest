; Modular ERB: OMOGATARI/Bugarlar.ERB
;ARG: Location ID

@NAS_LOCKPICKING(ARG)
;-------------------------------------
;NAS custom code: lockpicking
;-------------------------------------
;#; PRINTFORML Area {ARG} is locked.
PRINTFORMW 잠겨 있다.
PRINTFORML 문을 따 보겠습니까?
$LockPickLoop
CALL ASK_YN()
SELECTCASE RESULT
	CASE 0
		CLEARLINE 5
		EXP:MASTER:手淫経験 ++
		IF RAND:500 < ABL:MASTER:指*10
			PRINTFORMW 당신은 순식간에 자물쇠를 해제했다!
			RETURN ARG
		ELSE
			PRINTFORML 자물쇠를 따는 데 실패했다.
			IF FLAG:70
				BASE:MASTER:TSP -= 3
			ELSE
				TIME++
			ENDIF
			FOR LOCAL, 0, CHARANUM
			SIF CFLAG:LOCAL:300 != ARG
				CONTINUE
			IF (!RAND:3 || !CFLAG:LOCAL:睡眠) && !FLAG:70 && !CFLAG:LOCAL:出禁 && !IsDead:LOCAL:0 && !TCVAR:LOCAL:睡眠薬強度 && EXP:LOCAL:睡眠姦経験 < 300
				;PRINT 物音に気づいた
				PRINTFORML %CALLNAME:LOCAL%은(는) 소리를 듣는다.
				CALL CHARA_AWAKE(LOCAL,1)
				IF !CFLAG:LOCAL:睡眠 && !CFLAG:LOCAL:隠密中
					IF TALENT:LOCAL:恋慕
						PRINTFORMW %CALLNAME:LOCAL%은 문을 열고 안도의 한숨을 내쉰다. 왜냐하면 %HE_SHE(TARGET)%가 그것이 %PARSE("you")%임을 알았기 때문이다...
						CALL KOJO_MESSAGE_SEND("EVENT",12,LOCAL,1,2)
						;移動成立
						RETURN ARG
					ELSE
						PRINTFORMW %CALLNAME:LOCAL%이(가) %PARSE("you")%를 밖으로 던진다.
						CALL KOJO_MESSAGE_SEND("EVENT",12,LOCAL,1,4)
						;侵入成功フラグクリア
						CLEARBIT CFLAG:LOCAL:42,8
						LOCK:(CFLAG:LOCAL:現在位置) = 1
						FORCEWAIT
						RETURN
					ENDIF
				ENDIF
			ENDIF
			NEXT
			PRINTFORML 다시 시도해 보시겠습니까?
			GOTO LockPickLoop
		ENDIF
	CASE 1
		RETURN
ENDSELECT
