;ARG: Location ID
@NAS_LOCKPICKING(ARG)
;-------------------------------------
;NAS custom code: lockpicking
;-------------------------------------
;#; PRINTFORML Area {ARG} is locked.
PRINTFORMW It's locked.
PRINTFORML Do you want to try picking the door?
$LockPickLoop
CALL ASK_YN()
SELECTCASE RESULT
CASE 0
    CLEARLINE 5
    EXP:MASTER:手淫経験 ++
    IF RAND:500 < ABL:MASTER:指*10
        PRINTFORMW You bypassed the lock in no time!
        RETURN ARG
    ELSE
        PRINTFORML You failed to pick the lock.
        IF FLAG:70
            BASE:MASTER:TSP -= 3
        ELSE
            TIME++
        ENDIF
        FOR LOCAL, 0, CHARANUM
            SIF CFLAG:LOCAL:300 != ARG
                CONTINUE
            IF (!RAND:3 || !CFLAG:LOCAL:睡眠) && !FLAG:70 && !CFLAG:LOCAL:出禁 && !IsDead:LOCAL:0 && !TCVAR:LOCAL:睡眠薬強度 && EXP:LOCAL:睡眠姦経験 < 300
                ;PRINT 物音に気づいた
                PRINTFORML %CALLNAME:LOCAL% hears a sound.
                CALL CHARA_AWAKE(LOCAL,1)
                IF !CFLAG:LOCAL:睡眠 && !CFLAG:LOCAL:隠密中
                    IF TALENT:LOCAL:恋慕
                        PRINTFORMW %CALLNAME:LOCAL% opens the door and sighs in relief as %HE_SHE(TARGET)% finds out it's %PARSE("you")%...
                        CALL KOJO_MESSAGE_SEND("EVENT",12,LOCAL,1,2)
                        ;移動成立
                        RETURN ARG
                    ELSE
                        PRINTFORMW %CALLNAME:LOCAL% throws %PARSE("you")% out...
                        CALL KOJO_MESSAGE_SEND("EVENT",12,LOCAL,1,4)
                        ;侵入成功フラグクリア
                        CLEARBIT CFLAG:LOCAL:42,8
                        LOCK:(CFLAG:LOCAL:現在位置) = 1
                        FORCEWAIT
                        RETURN
                    ENDIF
                ENDIF
            ENDIF
        NEXT
        PRINTFORML Do you want to try again?
        GOTO LockPickLoop
    ENDIF
CASE 1
    RETURN
ENDSELECT