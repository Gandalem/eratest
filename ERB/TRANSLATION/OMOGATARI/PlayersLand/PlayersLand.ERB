@PlayerHouseRenovate
#DIM 自室決め
PRINTFORML 　Funds: %金額表示(MONEY)%\@ MONEY:2 ? %" "%(Charisma: %DIGIT_GROUP(MONEY:2)%CM)#\@
	$INPUT_LOOP_KAITIKU
SELECTCASE PlayerLandProgress
	CASE 0
	PRINTFORML You can spend some money and build a shed.
	PRINTFORML You will be able to live in this area and make it your home.
	PRINTFORML What should you do?
	{
	CALL ASK_M(
		@"Rebuild (%金額表示(1000000)%)", MONEY >= 1000000,
		@"Cancel", 1
	)
	}
	IF RESULT == 0
		IF MONEY >= 1000000
			CALL PAY_MONEY_YEN(1000000, 1)
			PRINTFORMW *Clang* *Clang* *Clang*
			PRINTFORML 
			PRINTFORMW You built a shed on your land!
			;CALL NOTIFY_BONUS_7(281)
			PlayerLandProgress = 1
			PlayerLandComfort = 60
			PlayerLandComfort:1 = 60
			SIF MAIN_MAP == PlayerLandID
				CALL ROOMSETTING()
		ELSE
			PRINTFORMW Not enough money.
			RETURN 0
		ENDIF
	ELSE
		RETURN 0
	ENDIF
	CASE 1
		PRINTFORML You can spend some money and build a worn-out house.
		PRINTFORML The drum bath can be placed in the garden, the upper limit of the comfort level will raise.
		PRINTFORML What should you do?
		{
		CALL ASK_M(
			@"Rebuild (%金額表示(2500000)%)", MONEY >= 2500000,
			@"Cancel", 1
		)
		}
		IF RESULT == 0
			IF MONEY >= 2500000
				CALL PAY_MONEY_YEN(2500000, 1)
				PRINTFORMW *Clang* *Clang* *Clang*
				PRINTFORML 
				PRINTFORMW The house became larger!
				;CALL NOTIFY_BONUS_7(282)
				PlayerLandProgress = 2
				PlayerLandComfort += 30
				PlayerLandComfort:1 += 30
				SIF MAIN_MAP == PlayerLandID
					CALL ROOMSETTING()
			ELSE
				PRINTFORMW Not enough money.
				RETURN 0
			ENDIF
		ELSE
			RETURN 0
		ENDIF
	CASE 2
		PRINTFORML You can spend some money and build an ordinary house.
		PRINTFORML Number of rooms will be increased, the upper limit of the comfort level will raise.
		PRINTFORML In addition, when you marry a girl it will be possible to live together in such a house.
		PRINTFORML What should you do?
		{
		CALL ASK_M(
			@"Rebuild (%金額表示(10000000)%)", MONEY >= 10000000,
			@"Cancel", 1
		)
		}
		IF RESULT == 0
			IF MONEY >= 10000000
				CALL PAY_MONEY_YEN(10000000, 1)
				PRINTFORMW *Clang* *Clang* *Clang*
				PRINTFORML 
				PRINTFORMW The house became larger!
				;CALL NOTIFY_BONUS_7(283)
				PlayerLandProgress = 3
				PlayerLandComfort += 30
				PlayerLandComfort:1 += 30
				SIF MAIN_MAP == PlayerLandID
					CALL ROOMSETTING()
			ELSE
				PRINTFORMW Not enough money.
				RETURN 0
			ENDIF
		ELSE
			RETURN 0
		ENDIF
	CASE 3
		PRINTFORML You can spend some money and build a big house.
		PRINTFORML Number of rooms will be increased, the upper limit of the comfort level will raise.
		PRINTFORMW In addition, you will be able to live with 5 girls in one house.
		PRINTFORML What should you do?
		{
		CALL ASK_M(
			@"Rebuild an old version of the house (%金額表示(60000000)%)", MONEY >= 60000000,
			@"Rebuild (%金額表示(60000000)%)", MONEY >= 60000000,
			@"Cancel", 1
		)
		}
		IF RESULT == 0
			IF MONEY >= 60000000
				CALL PAY_MONEY_YEN(60000000, 1)
				PRINTFORMW *Clang* *Clang* *Clang*
				PRINTFORML 
				PRINTFORMW The house became larger!
				;CALL NOTIFY_BONUS_7(284)
				PlayerLandProgress = 4
				PlayerLandComfort += 30
				PlayerLandComfort:1 += 30
				IF MAIN_MAP == PlayerLandID
					CALL ROOMSETTING()
				ENDIF
				CALL RelocateAllTenants
			ELSE
				PRINTFORMW Not enough money.
				RETURN 0
			ENDIF
		ELSEIF RESULT == 1
			CALL PAY_MONEY_YEN(60000000, 1)
			PRINTFORMW *Clang* *Clang* *Clang*
			PRINTFORML 
			PRINTFORMW The house became larger!
			;CALL NOTIFY_BONUS_7(284)
			PlayerLandProgress = 4
			PlayerLandComfort += 30
			PlayerLandComfort:1 += 30
			PlayerLandProgressAlt = 1
			IF MAIN_MAP == PlayerLandID
				CALL ROOMSETTING()
			ENDIF
			CALL RelocateAllTenants
		ELSE
			RETURN 0
		ENDIF
	CASE 4
		PRINTFORML You can spend some money and build a gigantic mansion.
		PRINTFORML Number of rooms will be increased, the upper limit of the comfort level will raise,
		PRINTFORML In addition, you will be able to live with 15 girls in one house.
		PRINTFORML What should you do?
		{
		CALL ASK_M(
			@"Rebuild (%金額表示(500000000)%)", MONEY >= 500000000,
			@"Cancel", 1
		)
		}
		IF RESULT == 0
			IF MONEY >= 500000000
				CALL PAY_MONEY_YEN(500000000, 1)
				PRINTFORMW *Clang* *Clang* *Clang*
				PRINTFORML 
				PRINTFORMW The house became larger!
				;CALL NOTIFY_BONUS_7(285)
				PlayerLandProgress = 5
				PlayerLandComfort += 30
				PlayerLandComfort:1 += 30
				SIF MAIN_MAP == PlayerLandID
					CALL ROOMSETTING()
				CALL RelocateAllTenants
			ELSE
				PRINTFORMW Not enough money.
				RETURN 0
			ENDIF
		ELSE
			RETURN 0
		ENDIF
	CASEELSE
		PRINTFORMW The house is fully upgraded.
ENDSELECT

