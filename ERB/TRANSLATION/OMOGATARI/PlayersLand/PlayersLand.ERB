@PlayerHouseRenovateAlternative
#DIM 自室決め
PRINTFORML 　Funds: %金額表示(MONEY)%\@ MONEY:2 ? %" "%(Charisma: %DIGIT_GROUP(MONEY:2)%CM)#\@
	$INPUT_LOOP_KAITIKU
SELECTCASE PlayerLandProgress
CASE 4
	PRINTL You can spend some money and renovate the house.
	PRINTL You can return to the previous variant later, but you will need to pay the same amount again.
	PRINTL What should you do?
	$INPUT_RIFOOMU
	PRINTL  [0] Renovate (¥60m)
	PRINTL  [1] Cancel
	INPUT
	IF RESULT == 0
		IF MONEY >= 60000000
			IF PlayerLandProgressAlt == 0
				PlayerLandProgressAlt = 1
				VARSET PlayerLandGuestLiving
				CALL RelocateAllTenants
			ELSE
				PlayerLandProgressAlt = 0
				VARSET PlayerLandGuestLiving
				CALL RelocateAllTenants
			ENDIF
		ELSE
			PRINTFORMW Not enough money.
			RETURN 0
		ENDIF
	ELSEIF RESULT == 1
		RETURN 0
	ENDIF
ENDSELECT

;Remodeling rooms
@PlayerHouseRoomRemodel
#DIM 自室決め
#DIM ROOM
IF MAIN_MAP != PlayerLandID
	PRINTFORML You need to be living in your land to renovate rooms.
	FORCEWAIT
	RETURN
ENDIF

PRINTFORML 　Funds: %金額表示(MONEY)%\@ MONEY:2 ? %" "%(Charisma: %DIGIT_GROUP(MONEY:2)%CM)#\@
$INPUT_LOOP_KAITIKU
PRINTL You can spend some money and remodel empty rooms.
PRINTL You can change to a different room later, but in that case it will cost money as well.
PRINTL
gLineCount = LINECOUNT
$INPUT_HEYAKAIZOU
CLEARLINE LINECOUNT - gLineCount
FOR LOCAL, 0, VARSIZE("PlayerLandRoomRemodel")
	IF ROOMDATA:(LOCAL) & ROOM_CUSTOM
		TRYCALLFORMF HOME_ROOMTYPE_{PlayerLandRoomRemodel:LOCAL}
		PRINTFORML [{LOCAL}] Remodel【%STR_TR(8000+(PlayerLandID*100)+LOCAL)%】(Current: %HOME_CUSTOM_ROOM_NAME%)
	ENDIF
NEXT
PRINTL [99] Cancel
INPUT
SELECTCASE RESULT
CASE 0 TO 98
	ROOM = RESULT
	SIF !(ROOMDATA:(ROOM % 100) & ROOM_CUSTOM)
		RESTART
	PRINTL How do you want to remodel it?
	$INPUT_HEYAKAIZOU2
	FOR LOCAL, 0, 100
		VARSET HOME_CUSTOM_ROOM_NAME
		TRYCALLFORMF HOME_ROOMTYPE_{LOCAL}
		SIF STRLENS(HOME_CUSTOM_ROOM_NAME)
			PRINTFORML  [{LOCAL,2}] %HOME_CUSTOM_ROOM_NAME% (\@ PlayerLandRoomRemodel:(ROOM % 100) == LOCAL ? Current # ¥%PALAM_NUM_NAS(HOME_CUSTOM_ROOM_COST,,1)% \@)
	NEXT
	;PRINTL  [9] 精神と時の部屋(100億円)
	PRINTL  [98] Go back 
	PRINTL  [99] Cancel
	INPUT
	
	SELECTCASE RESULT
	CASE 0 TO 97
		E = RESULT
		VARSET HOME_CUSTOM_ROOM_NAME
		TRYCALLFORMF HOME_ROOMTYPE_{E}
		SIF !STRLENS(HOME_CUSTOM_ROOM_NAME)
			RETURN

		DRAWLINE
		PRINTFORML %HOME_CUSTOM_ROOM_NAME%
		SETCOLOR C_GRAY
		PRINTFORML Cost: ¥%PALAM_NUM_NAS(HOME_CUSTOM_ROOM_COST,,1)%
		RESETCOLOR
		PRINTL
		PRINTFORML  %HOME_CUSTOM_ROOM_DESC%
		DRAWLINE
		PRINTFORML Do you want to renovate this room into this?
		CALL ASK_YN()
		SELECTCASE RESULT
		CASE 0
			IF MONEY < HOME_CUSTOM_ROOM_COST
				PRINTW Not enough money.
				GOTO INPUT_HEYAKAIZOU2
			ENDIF
			PRINTW Successfully remodeled.
			PlayerLandRoomRemodel:ROOM = E
			CALL PAY_MONEY_YEN(HOME_CUSTOM_ROOM_COST,2)
		CASE 1
			GOTO INPUT_HEYAKAIZOU2
		ENDSELECT
	CASE 98
		GOTO INPUT_HEYAKAIZOU
	CASE 99
		RETURN 0
	CASEELSE
		GOTO INPUT_HEYAKAIZOU2
	ENDSELECT
CASE 99
	RETURN 0
ENDSELECT

