@PlayerHouseFixBrokenTenants
#DIM G_COUNT

FOR G_COUNT, 0, PlayerHouseMaxGuests()
	IF PlayerLandGuests:G_COUNT > -1
		IF !INRANGE(PlayerLandGuests:G_COUNT,0,CHARANUM-1)
			PlayerLandGuests:G_COUNT = -1
			PlayerLandGuestLiving:G_COUNT = 0
			CALL COLORMESSAGE(@"Fixing invalid tenant for housing room {G_COUNT}...",C_YELLOW,1,1)
		ENDIF
	ENDIF
NEXT