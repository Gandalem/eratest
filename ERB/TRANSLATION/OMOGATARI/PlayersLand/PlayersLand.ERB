LOOP 1

@PlayerHouseTenantConfig(nSlot)
#DIM nSlot
#DIM C_ID
#DIM phtcLineCount
C_ID = PlayerLandGuests:nSlot

phtcLineCount = LINECOUNT
IF C_ID == -1
	PRINTFORML Choose someone to invite
	CALL SHOW_CHARA_LIST_TR("陥落")
	LOCAL:1 = RESULT
	SELECTCASE LOCAL:1
		CASE 999
			PRINTFORMW You lose interest, and the room is still vacant.
		CASE MASTER
			PRINTFORMW Silly %CALLNAME:MASTER%, you're the owner of the house.
		CASEELSE
			IF FINDELEMENT(PlayerLandGuests,LOCAL:1) > -1
				PRINTFORMW %CALLNAME:(LOCAL:1)% already lives here.
				RESTART
			ENDIF

			PRINTFORML You invited %NAME:(LOCAL:1)% to live.
			PlayerLandGuests:nSlot = LOCAL:1
			CALLF RelocateMakaiIdiots(LOCAL:1)
			SIF MAIN_MAP == PlayerLandID
				CALL ROOMSETTING()
			RETURN 1
	ENDSELECT
	RETURN 0
ENDIF

DO
PRINTFORML Selected Guest {nSlot+1}: %NAME:C_ID%
PRINTFORML Currently living in %STR_TR(CFLAG:(PlayerLandGuests:LOCAL):311+8000)%
{
CALL ASK_M(
	@"Cancel", 1,
	@"Change Room", 1,
	@"Evict", 1
)
}
LOCAL:1 = RESULT
SELECTCASE LOCAL:1
	; CASE 1
	; 	PRINTFORML You collect ¥%DIGIT_GROUP(PlayerLandGuestRent:nSlot)% from %CALLNAME:C_ID% as rent pay
	; 	CALL GET_MONEY_YEN(PlayerLandGuestRent:nSlot,2)
	; 	PlayerLandGuestRent:nSlot = 0
	CASE 1
		PlayerLandSelection = 1
		CALL NAS_PickLivingPlace(C_ID,PlayerLandID)
		PlayerLandGuestLiving:nSlot = CFLAG:C_ID:311
		PlayerLandSelection = 0
		CALLF RelocateMakaiIdiots(C_ID)
	CASE 2
		PRINTFORML Do you want to evict %CALLNAME:C_ID% from your home?
		PRINTFORML You will have to re-invite them to live if you want them back.
		CALL ASK_YN
		IF !RESULT
			; IF PlayerLandGuestRent:nSlot
			; 	PRINTFORML You collect ¥%DIGIT_GROUP(PlayerLandGuestRent:nSlot)% from %CALLNAME:C_ID% as an eviction fee
			; 	CALL GET_MONEY_YEN(PlayerLandGuestRent:nSlot,2)
			; ENDIF
			PlayerLandGuests:nSlot = -1
			PlayerLandGuestLiving:nSlot = 0
			PlayerLandGuestRent:nSlot = 0
			CFLAG:C_ID:311 = CSVCFLAG(NO:C_ID, GETNUM(CFLAG, "初期位置"))
			CALLF RelocateMakaiIdiots(C_ID)
			RETURN 1
		ENDIF
	CASEELSE
		RETURN 1
ENDSELECT
LOOP 1

@PlayerLand_GetRent
#DIM DYNAMIC nSlot
#DIM DYNAMIC C_ID
#DIM DYNAMIC RentToGet
#DIM DYNAMIC RentTotal
SIF !PlayerLandBought
	RETURN
RentTotal = 0
FOR nSlot,0,VARSIZE("PlayerLandGuests")
	C_ID = PlayerLandGuests:nSlot
	SIF C_ID == -1 || C_ID == MASTER
		CONTINUE
	SELECTCASE PlayerLandProgress
	CASE 0
		RentToGet = 500
	CASE 1
		RentToGet = 850
	CASE 2
		RentToGet = 1270
	CASE 3
		RentToGet = 1950
	CASE 4
		RentToGet = 2560
	CASE 5
		RentToGet = 4920
	ENDSELECT
	RentToGet += (100*PlayerLandComfort)
	IF TALENT:C_ID:7
		TIMES RentToGet, 2.0
	ELSEIF SignificantRelationship(C_ID)
		TIMES RentToGet, 1.75
	;tier 1
	ELSEIF HasFallState(C_ID)
		TIMES RentToGet, 1.5
	ENDIF
	RentToGet += (CFLAG:C_ID:合意判定*20)
	RentTotal += RentToGet
NEXT
IF RentTotal
	PRINTFORML You collect %金額表示(RentTotal)% from your tenants as daily rent pay
	CALL GET_MONEY_YEN(RentTotal,2)
ENDIF


