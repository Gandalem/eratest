@RelocateAllTenants
#DIM ShowDisplay
VARSET PlayerLandGuestLiving
VARSET ShowDisplay
FOR LOCAL,0,100
	IF PlayerLandRoomRemodel:LOCAL
		TRYCALLFORMF HOME_ROOMTYPE_{PlayerLandRoomRemodel:LOCAL}
		MONEY += HOME_CUSTOM_ROOM_COST
		ShowDisplay = 1
	ENDIF
NEXT
VARSET PlayerLandRoomRemodel
SIF ShowDisplay
	PRINTFORML All room renovations have been removed and you have been refunded the cost.

PRINTFORML Please note that the bedroom for you and all tenants was also changed.
WAIT
;PRINTFORMW If you married %NAME:93%, %HIS_HER(93)% bedroom will be different.
FOR LOCAL,0,CHARANUM
	IF LOCAL == MASTER
		IF MAIN_MAP == PlayerLandID
			CALLFORM DEFAULT_OWNER_{MAIN_MAP}
			CFLAG:MASTER:自宅位置 = GET_MAP_REPLACEMENT(デフォルト初期位置)
			CFLAG:MASTER:311 = デフォルト初期位置
			CFLAG:MASTER:神社在住 = デフォルト初期位置
			CFLAG:MASTER:300 = デフォルト初期位置
		ENDIF
		CONTINUE
	ENDIF
	IF FINDELEMENT(PlayerLandGuests,LOCAL) != -1
		Q = AvailableHousingAreas()
		CFLAG:LOCAL:自宅位置 = GET_MAP_REPLACEMENT(Q)
		CFLAG:LOCAL:311 = Q
		CFLAG:LOCAL:神社在住 = Q
		PlayerLandGuestLiving:(FINDELEMENT(PlayerLandGuests,LOCAL)) = Q
	ENDIF
NEXT

