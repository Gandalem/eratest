@AvailableHousingAreas(ARG, ARG:1)
#FUNCTION
#DIM nGetAreas, 20
VARSET nGetAreas

SELECTCASE PlayerLandProgress
CASE 3
nGetAreas:0 = 1902
CASE 4
IF !PlayerLandProgressAlt
	nGetAreas:0 = 1918
	nGetAreas:1 = 1915
	nGetAreas:2 = 1923
	nGetAreas:3 = 1924
	nGetAreas:4 = 1925
ELSE
	nGetAreas:0 = 1925
	nGetAreas:1 = 1926
	nGetAreas:2 = 1927
	nGetAreas:3 = 1928
	nGetAreas:4 = 1929
ENDIF
CASEELSE
	nGetAreas:0 = 1961
	nGetAreas:1 = 1962
	nGetAreas:2 = 1963
	nGetAreas:3 = 1964
	nGetAreas:4 = 1965
	nGetAreas:5 = 1966
	nGetAreas:6 = 1967
	nGetAreas:7 = 1968
	nGetAreas:8 = 1969
	nGetAreas:9 = 1970
	nGetAreas:10 = 1971
	nGetAreas:11 = 1972
	nGetAreas:12 = 1950
	nGetAreas:13 = 1951
	nGetAreas:14 = 1976
ENDSELECT

SELECTCASE ARG
CASE 1
	SIF FINDELEMENT(nGetAreas,ARG:1) != -1
		RETURNF 0
	RETURNF 1
CASE 2
	RETURNF FINDELEMENT(PlayerLandGuestLiving,ARG:1)
CASE 0
	FOR LOCAL,0,VARSIZE("nGetAreas")
		SIF !nGetAreas:LOCAL
			BREAK
		IF FINDELEMENT(PlayerLandGuestLiving,nGetAreas:LOCAL) == -1
			RETURNF nGetAreas:LOCAL
		ENDIF
	NEXT
ENDSELECT

