; Modular ERB: OMOGATARI/PlayersLand/ROOMSETTING_19.ERB
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
;Room Attributes
;JP Attribute	   EN Translation	Function			Description
;場所_ワンルーム   One Room								Room locked when the owner is not available. Acts like a Bedroom・Indoors・Kitchen・Study・Rest・Dining・and Private Room.
;場所_布団         Bedroom			BEDROOM()			Can rest (in free acts as well)
;場所_洋室         Western Style	INROOM()			Indoors, but allows shoes to be worn
;場所_屋内		   Indoors			INROOM()			Room is not considered outside
;場所_屋根         Roofed								Outdoors, but is under a roof. If the room has no indoors tag or roofed tag, then it's assumed to be outdoors unroofed.
;場所_広い		   Spacious			OPENPLACE()
;場所_月見         Moon Viewable	MOON_WATCH_POINT()	Moon is visible even if indoors or under a roof.
;場所_休憩		   Rest				休憩可()			Can rest
;場所_風呂		   Bath				BATHROOM()			Can take a bath
;場所_トイレ	   Toilet			IN_TOILET()			Can relieve oneself by using the toilet
;場所_厨房		   Kitchen          KITCHEN()			Can cook food (in free acts as well)
;場所_訓練		   Training			戦闘訓練可()		Can combat train and have sanctioned Danmaku battles
;場所_勉強		   Study			勉強可()			Can study
;場所_天の声	   Pray Area		天の声可()			Can listen to god and pray (if religious)
;場所_菜園		   Garden			家庭菜園可()		Can grow plants
;場所_水汲み	   Draw Water		水汲み可()			Can draw water
;場所_身体測定	   Dressing Room	MEASUREMENTCHECK()	Can measure one's body
;場所_物干し       Laundry			物干し可()			Can wash underwear. In ATW this is Flavor Text, mostly about how 「The laundry is drying.」
;場所_飲食         Dining			憩いスペース()		Can eat food (during free acts)
;場所_つまみ食い   Food Stealing	つまみ食いスポット() Can steal food (during free acts)
;場所_留まらない   Moves Frequent						Characters move from the area frequently
;場所_過疎         Moves Rarely							Characters move from the area rarely
;場所_プライベート Private								Characters rarely enter, mostly reserved for bedrooms, bathrooms, and toilets
;場所_炬燵         Kotatsu			炬燵のある場所()	Can rest (during free acts)
;場所_公共の場     Public Area							Cannot be pushed down
;ROOM_CUSTOM	   Custom Room		HOME_CUSTOM_ROOM()	Room can be customized
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝

@ROOMSETTING_19
#DIM ROOM
VARSET ROOMDATA
SIF GET_MAPID(拠点_酒虫) != MAIN_MAP
	拠点_酒虫 = 1901
SELECTCASE PlayerLandProgress
	CASE 0, 1
		MAXROOM = 1902
	CASE 2
		MAXROOM = 1909
	CASE 3
		MAXROOM = 1985
	CASE 4
		MAXROOM = 1986
	CASE 5
		MAXROOM = 1986
ENDSELECT
ENTRANCE = PlayerHousingEntrance()
SUMIKOMI_ROOM = 0
MAP_PAGES = 1
SELECTCASE PlayerLandProgress
	CASE 0
		MAPNAME:1 = %CALLNAME:PlayerLandOwner%'s Land
	CASE 1
		MAPNAME:1 = %CALLNAME:PlayerLandOwner%'s Shack
	CASE 2
		MAPNAME:1 = %CALLNAME:PlayerLandOwner%'s House
	CASE 3
		MAPNAME:1 = %CALLNAME:PlayerLandOwner%'s House
	CASE 4
		MAPNAME:1 = %CALLNAME:PlayerLandOwner%'s Mansion
	CASE 5
		MAPNAME:1 = %CALLNAME:PlayerLandOwner%'s Grand Mansion
ENDSELECT
FOR LOCAL, MINROOM(), MAXROOM
ROOM = LOCAL % 100
SELECTCASE PlayerLandProgress
	;▼Shed
	CASE 1
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_ワンルーム
	CASE 2
		;▼Worn Out
		SELECTCASE LOCAL
			CASE 1901
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_ワンルーム
			CASE 1905
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_広い
			CASE 1906
				ROOMDATA:ROOM |= 場所_菜園
				ROOMDATA:ROOM |= 場所_訓練
				ROOMDATA:ROOM |= 場所_休憩
				ROOMDATA:ROOM |= 場所_飲食
				ROOMDATA:ROOM |= 場所_月見
				ROOMDATA:ROOM |= 場所_物干し
			CASE 1908
				ROOMDATA:ROOM |= 場所_風呂
		ENDSELECT
	CASE 3
		;▼Regular
		SELECTCASE LOCAL
			CASE 1901,1902
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_ワンルーム
			CASE 1903
				ROOMDATA:ROOM |= 場所_屋内
			CASE 1904
				ROOMDATA:ROOM |= 場所_勉強
			CASE 1905
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_広い
			CASE 1906
				ROOMDATA:ROOM |= 場所_菜園
				ROOMDATA:ROOM |= 場所_訓練
				ROOMDATA:ROOM |= 場所_休憩
				ROOMDATA:ROOM |= 場所_飲食
				ROOMDATA:ROOM |= 場所_月見
				ROOMDATA:ROOM |= 場所_物干し
			CASE 1908
				ROOMDATA:ROOM |= 場所_風呂
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_プライベート
			CASE 1984
				ROOMDATA:ROOM |= 場所_トイレ
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_プライベート
		ENDSELECT
	CASE 4
		IF !PlayerLandProgressAlt
			SELECTCASE LOCAL
				CASE 1911
					ROOMDATA:ROOM |= 場所_広い
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1912, 1914
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= 場所_勉強
					ROOMDATA:ROOM |= 場所_休憩
				CASE 1913
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1915
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= 場所_勉強
					ROOMDATA:ROOM |= 場所_休憩
				CASE 1916
					ROOMDATA:ROOM |= 場所_飲食
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1917
					ROOMDATA:ROOM |= 場所_厨房
					ROOMDATA:ROOM |= 場所_勉強
				CASE 1918
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1919
					ROOMDATA:ROOM |= 場所_菜園
					ROOMDATA:ROOM |= 場所_訓練
					ROOMDATA:ROOM |= 場所_休憩
					ROOMDATA:ROOM |= 場所_飲食
					ROOMDATA:ROOM |= 場所_月見
					ROOMDATA:ROOM |= 場所_物干し
				CASE 1920
					ROOMDATA:ROOM |= 場所_水汲み
				CASE 1921
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= 場所_身体測定
				CASE 1922
					ROOMDATA:ROOM |= 場所_トイレ
					ROOMDATA:ROOM |= 場所_風呂
					ROOMDATA:ROOM |= 場所_プライベート
				CASE 1923 TO 1926
					ROOMDATA:ROOM |= 場所_プライベート
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1927
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= ROOM_CUSTOM
				CASE 1928 TO 1931
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= 場所_留まらない
					ROOMDATA:ROOM |= 場所_広い
				CASE 1984,1985
					ROOMDATA:ROOM |= 場所_トイレ
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= 場所_プライベート
			ENDSELECT
		ELSE
			SELECTCASE LOCAL
				CASE 1911
					ROOMDATA:ROOM |= 場所_広い
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1912
					ROOMDATA:ROOM |= 場所_休憩
					ROOMDATA:ROOM |= 場所_勉強
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1913, 1914
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1915
					ROOMDATA:ROOM |= 場所_飲食
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1916
					ROOMDATA:ROOM |= 場所_厨房
					ROOMDATA:ROOM |= 場所_勉強
				CASE 1917
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= 場所_身体測定
				CASE 1918
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= 場所_風呂
				CASE 1919
					ROOMDATA:ROOM |= 場所_菜園
					ROOMDATA:ROOM |= 場所_訓練
					ROOMDATA:ROOM |= 場所_休憩
					ROOMDATA:ROOM |= 場所_飲食
					ROOMDATA:ROOM |= 場所_月見
					ROOMDATA:ROOM |= 場所_物干し
				CASE 1920
					ROOMDATA:ROOM |= 場所_水汲み
				CASE 1921
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= ROOM_CUSTOM
				CASE 1922
					ROOMDATA:ROOM |= 場所_広い
				CASE 1923
					ROOMDATA:ROOM |= 場所_広い
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1924 TO 1929
					ROOMDATA:ROOM |= 場所_ワンルーム
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1930
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= 場所_勉強
					ROOMDATA:ROOM |= 場所_休憩
				CASE 1931
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= 場所_勉強
					ROOMDATA:ROOM |= 場所_休憩
					ROOMDATA:ROOM |= 場所_訓練
				CASE 1932
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= 場所_勉強
				CASE 1933
					ROOMDATA:ROOM |= 場所_屋内
				CASE 1984
					ROOMDATA:ROOM |= 場所_トイレ
					ROOMDATA:ROOM |= 場所_屋内
					ROOMDATA:ROOM |= 場所_プライベート
			ENDSELECT
		ENDIF
	CASEELSE
		SELECTCASE LOCAL
			CASE 1942
				ROOMDATA:ROOM |= 場所_広い
			CASE 1943
				ROOMDATA:ROOM |= 場所_広い
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= ROOM_CUSTOM
			CASE 1944 TO 1947
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_勉強
				ROOMDATA:ROOM |= 場所_休憩
			CASE 1948
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_飲食
			CASE 1949
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_厨房
			CASE 1950, 1951, 1952
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_布団
			CASE 1953 TO 1956
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= ROOM_CUSTOM
			CASE 1957
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_広い
				ROOMDATA:ROOM |= ROOM_CUSTOM
			CASE 1958
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_身体測定
			CASE 1959
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_風呂
			CASE 1960
				ROOMDATA:ROOM |= 場所_風呂
			CASE 1961 TO 1972
				ROOMDATA:ROOM |= 場所_ワンルーム
				ROOMDATA:ROOM |= 場所_屋内
			CASE 1973
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_広い
				ROOMDATA:ROOM |= 場所_勉強
				ROOMDATA:ROOM |= 場所_休憩
				ROOMDATA:ROOM |= ROOM_CUSTOM
			CASE 1974
				ROOMDATA:ROOM |= 場所_ワンルーム
				ROOMDATA:ROOM |= 場所_屋内
			CASE 1975
				ROOMDATA:ROOM |= 場所_広い
				ROOMDATA:ROOM |= 場所_菜園
				ROOMDATA:ROOM |= 場所_訓練
			CASE 1976
				ROOMDATA:ROOM |= 場所_ワンルーム
				ROOMDATA:ROOM |= 場所_屋内
			CASE 1977
				ROOMDATA:ROOM |= 場所_水汲み
			CASE 1978 TO 1982
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_留まらない
				ROOMDATA:ROOM |= 場所_広い
			CASE 1983
				ROOMDATA:ROOM |= 場所_屋根
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_休憩
				ROOMDATA:ROOM |= 場所_飲食
				ROOMDATA:ROOM |= 場所_月見
				ROOMDATA:ROOM |= 場所_物干し
			CASE 1984,1985
				ROOMDATA:ROOM |= 場所_トイレ
				ROOMDATA:ROOM |= 場所_屋内
				ROOMDATA:ROOM |= 場所_プライベート
		ENDSELECT
ENDSELECT
IF ROOMDATA:ROOM & ROOM_CUSTOM
	VARSET HOME_CUSTOM_ROOM_DATA
	TRYCALLFORMF HOME_ROOMTYPE_{PlayerLandRoomRemodel:ROOM}
	ROOMDATA:ROOM |= HOME_CUSTOM_ROOM_DATA
ENDIF
NEXT
;-----------------------------------------
;デフォルトの初期位置と大家の設定
;-----------------------------------------

@DEFAULT_OWNER_19
SELECTCASE PlayerLandProgress
	CASE 0, 1, 2,3
		デフォルト初期位置 = 1901
	CASE 4
		IF !PlayerLandProgressAlt
			デフォルト初期位置 = 1926
		ELSE
			デフォルト初期位置 = 1924
		ENDIF
	CASEELSE
		デフォルト初期位置 = 1974
ENDSELECT
拠点_大家 = PlayerLandOwner
;-----------------------------------------
;お出かけマップの設定
;ARG   対象の地点
;ARGS  判定文字引数
;-----------------------------------------

@ODEKAKEMAP_SETTING_19(ARG, ARGS)
#FUNCTION
;＼1 2 3 4 5 6 7 8 9
;01
;02
;03
;04６
;05５　７　　８
;06　　　　　　　　９
;07
;08
;09１
SELECTCASE ARG
	CASE 6111
		SIF ARGS == "座標"
			RETURNF 19
		SIF GROUPMATCH(ARGS, "屋根")
			RETURNF 1
	CASE 6112
		SIF ARGS == "座標"
			RETURNF 19
		SIF GROUPMATCH(ARGS, "屋根")
			RETURNF 1
	CASEELSE
		SIF ARGS == "座標"
			RETURNF 19
		SIF GROUPMATCH(ARGS, "屋根")
			RETURNF 1
ENDSELECT
