;--------------------------------------------------
;移動制限設定
;ARG    場所ID
;CHARA  移動するキャラID
;RETURNF 1=移動できる,0=移動できない
;TFLAG:移動不能メッセージ   ↓の@MAP_CANNOT_WORD用の設定
;--------------------------------------------------

@MAP_CAN_MOVE_19(ARG, CHARA)
#FUNCTION
#DIM CHARA
SIF ARG == MAXROOM
	RETURNF 1
SELECTCASE PlayerLandProgress
	CASE 2
		SELECTCASE ARG
			CASE 1901, 1905, 1906, 1908
			CASEELSE
				;places that don't exist
				$PlaceDoesNotExist
				TFLAG:移動不能メッセージ = 998
				RETURNF 0
		ENDSELECT
	CASE 3
		SELECTCASE ARG
			CASE 1901 TO 1908, 1984
			CASEELSE
				GOTO PlaceDoesNotExist
		ENDSELECT
	CASE 4
		IF PlayerLandProgressAlt
			SELECTCASE ARG
				CASE 1911 TO 1934, 1984
				CASEELSE
					GOTO PlaceDoesNotExist
			ENDSELECT
		ELSE
			SELECTCASE ARG
				CASE 1911 TO 1931, 1984, 1985
				CASEELSE
					GOTO PlaceDoesNotExist
			ENDSELECT
		ENDIF
	CASE 5
		SELECTCASE ARG
			CASE 1942 TO 1985
			CASEELSE
				GOTO PlaceDoesNotExist
		ENDSELECT
ENDSELECT
RETURNF 1
;--------------------------------------------------
;移動不能時に表示されるメッセージ
;--------------------------------------------------

@MAP_CANNOT_WORD_19(ARG)
RETURN
SELECTCASE TFLAG:移動不能メッセージ
	CASE 1
		PRINTFORMW 여기에 메시지를 넣는다. 줄 수 + 1의 CLEARLINE을 한다
		CLEARLINE 2
ENDSELECT
