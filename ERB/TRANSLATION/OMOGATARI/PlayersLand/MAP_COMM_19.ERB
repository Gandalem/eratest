;--------------------------------------------------
;内部構造がある場所の内部の判定
;TFLAG:マップ切り替え  内部察知が必要なマップ番号
;                P_ID  表示ボタンの場所ID
;                Q_ID  判定する内部の場所ID,必ずP_IDと一致した数値も含める
;--------------------------------------------------
@GETMAP_BUILDING_19(P_ID, Q_ID)
#FUNCTION
#DIM P_ID
#DIM Q_ID
IF TFLAG:マップ切り替え == 1
	SELECTCASE P_ID
	ENDSELECT
ENDIF
RETURNF 0

;--------------------------------------------------
;移動制限設定
;ARG    場所ID
;CHARA  移動するキャラID
;RETURNF 1=移動できる,0=移動できない
;TFLAG:移動不能メッセージ   ↓の@MAP_CANNOT_WORD用の設定
;--------------------------------------------------
@MAP_CAN_MOVE_19(ARG, CHARA)
#FUNCTION
#DIM CHARA
SIF ARG == MAXROOM
	RETURNF 1

SELECTCASE PlayerLandProgress
CASE 2
	SELECTCASE ARG
	CASE 1901, 1905, 1906, 1908
	CASEELSE
		;places that don't exist
		$PlaceDoesNotExist
		TFLAG:移動不能メッセージ = 998
		RETURNF 0
	ENDSELECT
CASE 3
	SELECTCASE ARG
	CASE 1901 TO 1908, 1984
	CASEELSE
		GOTO PlaceDoesNotExist
	ENDSELECT
CASE 4
	IF PlayerLandProgressAlt
		SELECTCASE ARG
		CASE 1911 TO 1934, 1984
		CASEELSE
			GOTO PlaceDoesNotExist
		ENDSELECT
	ELSE
		SELECTCASE ARG
		CASE 1911 TO 1931, 1984, 1985
		CASEELSE
			GOTO PlaceDoesNotExist
		ENDSELECT
	ENDIF
CASE 5
	SELECTCASE ARG
	CASE 1942 TO 1985
	CASEELSE
		GOTO PlaceDoesNotExist
	ENDSELECT
ENDSELECT
RETURNF 1

;--------------------------------------------------
;移動不能時に表示されるメッセージ
;--------------------------------------------------
@MAP_CANNOT_WORD_19(ARG)
RETURN
SELECTCASE TFLAG:移動不能メッセージ
	CASE 1
		PRINTFORMW ※ここにメッセージを入れる。行数+1のCLEARLINEをする
		CLEARLINE 2
ENDSELECT
REUSELASTLINE

