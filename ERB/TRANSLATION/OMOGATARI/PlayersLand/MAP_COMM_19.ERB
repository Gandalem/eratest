@MAP_PLACENAME_19(ARG, ARG:1)
#FUNCTIONS
IF GET_MAPID(ARG) == MAIN_MAP
	SELECTCASE ARG
		CASE SUMIKOMI_ROOM
			;※このマップでは未実装
			IF FLAG:住み込みキャラ
				RETURNF ""
			ELSE
				RETURNF ""
			ENDIF
		CASE MINROOM() TO (MAXROOM - 1)
			IF PlayerLandRoomRemodel:(ARG % 100)
				TRYCALLFORMF HOME_ROOMTYPE_{PlayerLandRoomRemodel:(ARG % 100)}
				RETURNF HOME_CUSTOM_ROOM_NAME
			ELSEIF FINDELEMENT(PlayerLandGuestLiving,ARG) > -1 && INRANGE(FINDELEMENT(PlayerLandGuestLiving,ARG),0,CHARANUM-1)
				IF ARG == 1976
					RETURNF @"%CALLNAME:(PlayerLandGuests:FINDELEMENT(PlayerLandGuestLiving,ARG))%의 집"
				ELSE
					RETURNF @"%CALLNAME:(PlayerLandGuests:FINDELEMENT(PlayerLandGuestLiving,ARG))%의 방"
				ENDIF
			ELSE
				RETURNF STR_TR(ARG + 8000)
			ENDIF
		CASE OMANEKIBEYA()
			RETURNF OMANEKI_PLACE()
		CASE SUKIMA()
			RETURNF "Gap Space"
		CASE MAXROOM
			RETURNF "Crossroads"
		CASEELSE
			RETURNF "Unknown"
	ENDSELECT
ELSE
	RETURNF "Beyond the Plot"
ENDIF
