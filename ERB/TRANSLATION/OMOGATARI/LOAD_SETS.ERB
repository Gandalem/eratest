@SET_SAVE_PREVIEWS(ARG)
#DIM SSP_LINES,4
RESULTS:1 =

;auxiliary file
IF SaveIsEZB
    RESULTS:1 '= "Legend of Gensokyo - "
ELSEIF STRLENS(LS_ACTIVE())
    RESULTS:1 '= "Lunatic Survival - "
ELSE
    RESULTS:1 '= "The World - "
ENDIF
RESULTS:1 += @"%NameChecker(MASTER,,,,0)% (%EZB_BAD_NAME()%)\n"
IF SaveIsEZB
    RESULTS:1 += @"%LoG_StageName(LegendModeStage)% - "
ELSEIF STRLENS(LS_ACTIVE())
    RESULTS:1 += @"%LS_ACTIVE()% - "
ENDIF
RESULTS:1 += @"Day {DAY} - %GET_MAPNAME(MAIN_MAP)%\n[ENDSTATS]\n"

; RESULTS:0 += @" (%PRINT_DATE_F(DAY,2)%)  "
; RESULTS:0 += @"%GET_MAPNAME(MAIN_MAP),28,LEFT%  "
; RESULTS:0 += @"%@"%NAME:MASTER% ({CharaAge:MASTER:0}%ShortGender(MASTER)%)",30,LEFT%  "
; RESULTS:0 += @"%NASVersionName(),30,LEFT%"
; RESULTS:0 += @"\@ FLAG:周回数 ? %" "%NG:{FLAG:周回数}#\@  "


;preview lines
SSP_LINES:0 = PreviewLineEnd ? PreviewLineEnd # LINECOUNT
SSP_LINES:1 = PreviewLineStart
SSP_LINES:2 = MAX(0,LINECOUNT-PreviewLineStart)
SSP_LINES:3 = MAX(0,LINECOUNT-PreviewLineEnd)


FOR LOCAL,SSP_LINES:2,SSP_LINES:3-1,-1
    SIF LOCAL < 0
        RETURN
	RESULTS:1 += HTML_GETPRINTEDSTR(MAX(0,LOCAL))+"\n"
NEXT

SAVETEXT RESULTS:1, (ARG)

@LOAD_SAVE_PREVIEW(ARG)
#DIMS LSP
#DIMS LSP_SPLIT, 50
#DIM LSP_TOTAL
#DIMS LSP_FULL
LOADTEXT ARG
LSP '= RESULTS
LSP_FULL =
IF LSP == ""
    HTML_PRINT @"Preview not found"
    RETURN
ENDIF
SPLIT LSP, "</p>", LSP_SPLIT

FOR LOCAL,0,50
    LSP '= LSP_SPLIT:LOCAL
    IF !STRLENS(LSP)
        BREAK
    ELSEIF LSP == "<p align='left'><nobr> </nobr>"
        CONTINUE
    ELSEIF STRFIND(LSP,"[ENDSTATS]") > -1
        LSP '= SUBSTRING(LSP,STRFIND(LSP,"[ENDSTATS]")+11,STRLENS(LSP))
    ENDIF

    LSP '= HTML_PURIFY(LSP)
    ;LSP '= @"%LSP%"
    SIF !STRLENS(LSP) || LSP == ""
        CONTINUE
    LSP_FULL += LSP
    ;HTML_PRINT LSP
NEXT
HTML_PRINT LSP_FULL

@LOAD_WITH_HEADER(ARG)
CUSTOMDRAWLINE ━
SETCOLOR C_RED
PRINTFORML Preview:
CUSTOMDRAWLINE ━
RESETCOLOR
CALL LOAD_SAVE_PREVIEW(ARG)
SETCOLOR C_RED
CUSTOMDRAWLINE ━
RESETCOLOR


@HTML_PURIFY(ARGS,ARG=0)
#FUNCTIONS
ARGS '= REPLACE(ARGS, @"<p align='center'>", "")
ARGS '= REPLACE(ARGS, @"<p align='left'>", "")
ARGS '= REPLACE(ARGS, @"<p align='right'>", "")
ARGS '= REPLACE(ARGS, @"<p>", "")
ARGS '= REPLACE(ARGS, @"</nobr>", "")
ARGS '= REPLACE(ARGS, @"<nobr>", "")
ARGS '= REPLACE(ARGS, @"</p>", "")
ARGS '= REPLACE(ARGS, @"<button value='(\\d+)'", "<nonbutton")
ARGS '= REPLACE(ARGS, @"<button value='-(\\d+)'", "<nonbutton")
ARGS '= REPLACE(ARGS, @"</button>", "</nonbutton>")
IF ARG
    ARGS '= REPLACE(ARGS, @"<font [^>]+>", "")
    ARGS '= REPLACE(ARGS, @"</font>", "")
ENDIF
RETURNF ARGS