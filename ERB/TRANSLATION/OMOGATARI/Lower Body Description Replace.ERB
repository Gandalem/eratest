; Modular ERB: OMOGATARI/Lower Body Description Replace.ERB
;HTML print versions

@LOWER_BODY_INSPECT_NAS(ARG)
#DIM CLOTHING_SLOT
#DIMS CLOTHING_NAME
#DIMS HTML ;NAS HTML stuffs
VARSET HTML
;============================
HTML '= "【하반신】"
;TEQUIP:下半身着衣状況 下半身着衣状況(ビット0=スカート 1=ずらし可 2=ずらし不可 3=ずらせない下半身上着)
;	(ビットを使いたくない人用 0=なし 1=ノーパンスカート 2=パンティのみ 3=スカート+パンティ
;	4=スパッツ(下着)もしくはノーパンズボン 5=スカート+スパッツ 6=ズボン+パンティ 7=フル装備(このバリアントでは無理)）
;CFLAG:パンツ パンツフラグ
;0 パンツはいている
;1 パンツはいてない
;下半身着衣なし、もしくはパンツはいていない
IF TEQUIP:ARG:下半身着衣状況 == 0 || CFLAG:ARG:ノーパン > 0
	;	下半身着衣があるがノーパンである
	IF CFLAG:ARG:ノーパン && TEQUIP:ARG:下半身着衣状況 != 0
		;着衣状況 = 0
		FOR CLOTHING_SLOT, 15, 4, -1
		SIF GROUPMATCH(CLOTHING_SLOT, 8, 7)
			CONTINUE
		CLOTHING_NAME '= LOOK_AT_CLOTHNAME(ARG, CLOTHING_SLOT)
		SIF !STRLENS(CLOTHING_NAME)
			CONTINUE
		HTML += CAPITALIZE(CLOTHING_NAME)
		BREAK
		NEXT
		;パンツははいていないが見えないので表示しない
		;PRINT （パンツはいてない）
		IF PREVCOM == 330
			IF PALAM:潤滑 >= PALAMLV:5
				HTML += @"%HIS_HER(ARG,1)%의 허벅지가 젖어 있다."
			ELSEIF PALAM:潤滑 >= PALAMLV:3
				HTML += @"액체가 %HIS_HER(ARG)%의 허벅지를 타고 흘러내린다."
			ENDIF
			IF 充填率(ARG,1) >= 100 || 充填率(ARG,2) >= 100
				HTML += @"정액이 넘치면서 크게 똑똑 떨어졌다 %HIM_HER(ARG)%"
			ELSEIF 充填率(ARG,1) >= 30 || 充填率(ARG,2) >= 30
				HTML += @"넘쳐흐르는 정액이 %HIS_HER(ARG)%의 허벅지를 타고 흘러내린다."
			ENDIF
		ELSEIF 充填率(ARG,1) >= 100 || 充填率(ARG,2) >= 100
			HTML += @"・\@ TALENT:MASTER:濃厚精液 ? %HIS_HER(ARG)%의 발 주위에 풀 같은 정액이 작은 산처럼 형성되어 있다 # %HIS_HER(ARG,1)%의 발은 정액으로 된 작은 웅덩이에서 헤엄치고 있다 \@"
		ELSEIF 充填率(ARG,1) >= 30 || 充填率(ARG,2) >= 30
			HTML += @"・\@ TALENT:MASTER:濃厚精液 ? 끈적한 정액이 %HIS_HER(ARG)%의 허벅지에 달라붙는다 # 정액이 %HIS_HER(ARG)%의 허벅지를 타고 흘러내린다 \@"
		ENDIF
	ELSEIF EQUIP:下半身下着１ || EQUIP:下半身下着２
		IF EQUIP:下半身下着２
			;CLOTHING_NAME '= PANTSNAME(EQUIP:ARG:下半身下着２, ARG)
			CLOTHING_NAME '= UNDIES_NAME_WITH_BRAND(ARG,EQUIP:ARG:下半身下着２,1)
			; HTML += @"%CAPITALIZE(CLOTHES_TR(CLOTHING_NAME))%"
			HTML += UNDIES_NAME_WITH_BRAND(ARG,EQUIP:ARG:下半身下着２,1)
			HTML += PANTY_SEE(ARG,MASTER,1)
			IF IsPadded(ARG)
				;diape descriptions
				IF 充填率(ARG,1) >= 500 || 充填率(ARG,2) >= 500 || PALAM:潤滑 >= PALAMLV:10
					HTML += @"%HIS_HER(ARG,1)%의 (가) %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%에서 새고 있다."
				ELSEIF 充填率(ARG,1) >= 200 || 充填率(ARG,2) >= 200 || PALAM:潤滑 >= PALAMLV:7
					HTML += @"・%HIS_HER(ARG,1)% %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))% 완전히 가득 참"
				ELSEIF 充填率(ARG,1) >= 100 || 充填率(ARG,2) >= 100 || PALAM:潤滑 >= PALAMLV:5
					HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHES_TR(CLOTHING_NAME)%이 상당한 볼륨을 형성했다."
				ELSEIF PALAM:潤滑 >= PALAMLV:3
					HTML += @"・%HIS_HER(ARG,1)% %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))% 축축하고 물컹했다"
				ELSEIF PALAM:潤滑 >= PALAMLV:1 || CFLAG:ARG:膣内射精 == 1 || CFLAG:ARG:アナル射精 == 1
					HTML += @"・%HIS_HER(ARG,1)%은(는) %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 축축하다."
				ENDIF
			ELSE
				IF 充填率(ARG,1) >= 100 || 充填率(ARG,2) >= 100
					HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%는 정액으로 완전히 흠뻑 젖어있다"
				ELSEIF 充填率(ARG,1) >= 30 || 充填率(ARG,2) >= 30
					HTML += @"・%HIS_HER(ARG,1)%은(는) %CLOTHES_TR(CLOTHING_NAME)%으로 정액을 전부 흡수할 수 없다."
					;ELSEIF CFLAG:ARG:膣内射精 == 1 || CFLAG:ARG:アナル射精 == 1 || PALAM:潤滑 >= PALAMLV:3
				ELSEIF SoiledDiaper(ARG,1,,60)
					;NAS: Soiling
					HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 얼룩져 있다. "
					;ELSEIF PALAM:潤滑 >= PALAMLV:2
				ELSEIF SoiledDiaper(ARG,1,,40)
					;NAS: Soiling
					HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 축축하다."
				ENDIF
			ENDIF
		ELSE
			CLOTHING_NAME '= GET_STR(ARG, "下半身下着_ずらし不可", EQUIP:ARG:下半身下着１, "名前")
			HTML += @"%CAPITALIZE(CLOTHES_TR(CLOTHING_NAME))%"
			SELECTCASE CLOTHING_NAME
				CASE "褌", "スパッツ"
					IF 充填率(ARG,1) >= 100 || 充填率(ARG,2) >= 100
						HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%는 정액으로 완전히 흠뻑 젖어있다"
					ELSEIF 充填率(ARG,1) >= 30 || 充填率(ARG,2) >= 30
						HTML += @"・%HIS_HER(ARG,1)%은(는) %CLOTHES_TR(CLOTHING_NAME)%로는 정액을 전부 흡수할 수 없다."
						;ELSEIF CFLAG:ARG:膣内射精 == 1 || CFLAG:ARG:アナル射精 == 1 || PALAM:潤滑 >= PALAMLV:3
					ELSEIF SoiledDiaper(ARG,1,,60)
						;NAS: Soiling
						HTML += @"・%HIS_HER(ARG,1)%의 (는) %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 얼룩져 있다. "
						;ELSEIF PALAM:潤滑 >= PALAMLV:2
					ELSEIF SoiledDiaper(ARG,1,,40)
						;NAS: Soiling
						HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 축축하다."
					ENDIF
				CASE "前張り", "絆創膏"
					IF 充填率(ARG,1) >= 100 || 充填率(ARG,2) >= 100
						HTML += @"・%HIS_HER(ARG,1)%의 (는) %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 벗겨졌다가 다시 붙었다."
					ELSEIF 充填率(ARG,1) >= 30 || 充填率(ARG,2) >= 30
						HTML += @"・%HIS_HER(ARG,1)%은(는) %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 간신히 걸쳐 있다 "
					ELSEIF CFLAG:ARG:膣内射精 == 1 || CFLAG:ARG:アナル射精 == 1 || PALAM:潤滑 >= PALAMLV:5
						HTML += @"・%HIS_HER(ARG,1)%이/가 %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%를 벗는다 "
					ELSEIF CFLAG:ARG:膣内射精 == 1 || CFLAG:ARG:アナル射精 == 1 || PALAM:潤滑 >= PALAMLV:3
						HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 얼룩져 있다."
					ELSEIF PALAM:潤滑 >= PALAMLV:2
						HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 축축하다."
					ENDIF
				CASE "貞操帯", "ラビアピアス", "クリピアス"
					IF 充填率(ARG,1) >= 100 || 充填率(ARG,2) >= 100
						IF CLOTHING_NAME == "貞操帯"
							HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHES_TR(CLOTHING_NAME)%은 정액으로 완전히 가득 차 있다."
						ELSE
							HTML += @" ・%HIS_HER(ARG,1)%의 %CLOTHES_TR(CLOTHING_NAME)%가 정액으로 가득 넘치고 있다."
						ENDIF
					ELSEIF 充填率(ARG,1) >= 30 || 充填率(ARG,2) >= 30
						HTML += @"・%HIS_HER(ARG,1)% %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))% 정액이 흐르고 있었다."
					ELSEIF CFLAG:ARG:膣内射精 == 1 || CFLAG:ARG:アナル射精 == 1 || PALAM:潤滑 >= PALAMLV:3
						HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 뚝뚝 떨어지고 있다."
					ELSEIF PALAM:潤滑 >= PALAMLV:2
						HTML += @"・%HIS_HER(ARG,1)%의 (그것은) %CLOTHES_TR(CLOTHING_NAME)% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))% 젖어 있다."
					ENDIF
			ENDSELECT
		ENDIF
		;下半身着衣がない
	ELSE
		HTML += @"벌거벗은"
		SIF TEQUIP:ARG:クリキャップ
			HTML += @" 클립 캡이 그녀의 음핵에 붙어있다."
		SIF TEQUIP:ARG:オナホール
			HTML += @" ・%HIS_HER(ARG)%의 성기가 오나홀에 박혀 있다."
		IF !CFLAG:うふふ
			IF CFLAG:ARG:膣内射精
				IF CFLAG:ARG:アナル射精 == 1
					IF 充填率(ARG,1) >= 1000 || 充填率(ARG,2) >= 1000
						HTML += @"정액이 양쪽 %HIS_HER(ARG)% 구멍에서 분출한다."
					ELSEIF 充填率(ARG,1) >= 100 || 充填率(ARG,2) >= 100
						HTML += @"%HIS_HER(ARG)%의 양쪽 모두 두 폭포수처럼 정액으로 넘쳐흐른다."
					ELSEIF 充填率(ARG,1) >= 30 || 充填率(ARG,2) >= 30
						HTML += @"%HIS_HER(ARG,1)%의 질과 항문이 정액으로 넘치고 있다."
					ELSE
						HTML += @"%HIS_HER(ARG)%의 질과 항문에서 정액이 흘러내린다."
					ENDIF
				ELSEIF EX:処女喪失チェック
					HTML += @"넘쳐흐르는 정액이 %HIS_HER(ARG)%의 처녀의 피와 섞인다."
				ELSEIF PALAM:潤滑 >= PALAMLV:2
					HTML += @"정액과 그들 자신의 액으로 넘쳐흐르고 있다"
				ELSE
					HTML += @"%HIS_HER(ARG)%의 질에서 정액이 새어 나온다."
				ENDIF
			ELSEIF CFLAG:ARG:アナル射精 == 1
				HTML += @"%HIS_HER(ARG)%의 항문에서 정액이 새어 나온다."
			ELSEIF PALAM:潤滑 >= PALAMLV:2
				IF PALAM:潤滑 >= PALAMLV:6
					HTML += @"· 성적인 체액은\@ EX:処女喪失チェック ? %" "%혼합되어 처녀의 피와 #  \@ %HIS_HER(ARG)%의 질에서 흘러나온다"
				ELSEIF EX:処女喪失チェック
					HTML += @"질에서 처녀의 피가 흐른다."
				ELSEIF PALAM:潤滑 >= PALAMLV:4
					HTML += @"연모의 액체가 %HIS_HER(ARG)%의 허벅지를 타고 흐른다."
				ELSEIF PALAM:潤滑 >= PALAMLV:2
					HTML += @"%HIS_HER(ARG,1)%의 질은 연모액으로 축축하다."
				ENDIF
			ENDIF
		ELSEIF PALAM:潤滑 >= PALAMLV:2 && !(CFLAG:ARG:膣内射精 == 1 || TEQUIP:Ｖセックス == PLAYER || TEQUIP:バイブ)
			IF PALAM:潤滑 >= PALAMLV:4
				HTML += @"· 성적인 체액은\@ EX:処女喪失チェック ? %" "%혼합되어 처녀의 피와 #  \@ %HIS_HER(ARG)%의 질에서 흘러나온다"
			ELSEIF EX:処女喪失チェック
				HTML += @"질에서 처녀의 피가 흐른다."
			ELSEIF PALAM:潤滑 >= PALAMLV:3
				HTML += @"연모의 액이 %HIS_HER(ARG)%의 허벅지를 타고 흘러내린다."
			ELSEIF PALAM:潤滑 >= PALAMLV:2
				HTML += @"・%HIS_HER(ARG,1)%의 질은 연모액으로 축축하다."
			ELSEIF TALENT:処女 == 1
				HTML += @"· %HIS_HER(ARG,1)%의 완전히 사용되지 않은 개방부가 노출되어 있다."
			ENDIF
		ENDIF
		IF EX:ARG:放尿 >= 12
			SETCOLOR C_YELLOW
			HTML += HTML_PRINT_NAS(@"%HIS_HER(ARG)% 주변에 오줌 웅덩이가 생겼다. ")
			RESETCOLOR
		ELSEIF EX:ARG:放尿 >= 5
			SETCOLOR C_YELLOW
			HTML += HTML_PRINT_NAS(@"%HIS_HER(ARG)%의 요도에서 소변이 똑똑 떨어진다. ")
			RESETCOLOR
		ENDIF
		IF EX:ARG:Defecation >= 5
			CALLF C_JELLYORPOO()
			HTML += HTML_PRINT_NAS(@"・%HIS_HER(ARG,1)%의 항문은 \@ GETBIT(nScat,4) ? 분변 물질 # 젤로 더럽혀져 있다 \@ ")
			RESETCOLOR
		ENDIF
	ENDIF
	CALL LOOK_BELLY(ARG)
	;下半身着を穿いている、かつ下着も付けている
ELSE
	;着衣状況 = 0
	;	上着が上下つなぎになっている服を着ている場合、それを表示する
	;	なければ、スカートやズボンを表示する
	;	特に凝った順番にもなってなかったのでループを統合
	FOR CLOTHING_SLOT, 15, 4, -1
	SIF GROUPMATCH(CLOTHING_SLOT, 8, 7, 12)
		CONTINUE
	SIF CLOTHING_SLOT == 6 && STRLENS(LOOK_AT_CLOTHNAME(ARG, 5))
		CONTINUE
	CLOTHING_NAME '= LOOK_AT_CLOTHNAME(ARG, CLOTHING_SLOT)
	SIF !STRLENS(CLOTHING_NAME)
		CONTINUE
	; SIF CLOTHING_SLOT == 6
	;     BREAK
	HTML += @"%CAPITALIZE(CLOTHING_NAME)%"
	LOCAL:6 = CLOTHING_SLOT
	BREAK
	NEXT
	SIF !STRLENS(CLOTHING_NAME)
		HTML += "알몸"
	;new panty exposing system
	HTML += PANTY_SEE(ARG,MASTER,LOCAL:6 == 6)
	IF !CFLAG:うふふ
		;なんか分岐入ってたけどTEQUIP:下半身着衣状況 == 0は↑で処理されるので死に分岐
		;IF TEQUIP:下半身着衣状況 != 0
		;ENDIF
		IF !IsPadded(ARG) || SoiledSelf:ARG:0
			IF PALAM:潤滑 >= PALAMLV:5 || SoiledSelf:ARG:0
				HTML += @"%HIS_HER(ARG,1)%의 허벅지가 젖어 있다."
			ELSEIF PALAM:潤滑 >= PALAMLV:3
				HTML += @"액체가 %HIS_HER(ARG)%의 허벅지를 타고 흘러내린다."
			ENDIF
		ENDIF
		;小人
		IF TALENT:ARG:100 == -5
			LOCAL = 200
			;幼児体型、小柄体型
		ELSEIF TALENT:ARG:100 < 0
			LOCAL = 300
			;長身以上
		ELSEIF TALENT:ARG:100 >= 1
			LOCAL = 500
			;普通体型
		ELSE
			LOCAL = 400
		ENDIF
		;PRINTFORML {CLOTHING_SLOT}
		IF !IsPadded(ARG)
			SIF EX:ARG:膣内精液 > LOCAL || EX:ARG:アナル内精液 > LOCAL
				HTML += @"・\@ TALENT:MASTER:濃厚精液 ? 끈적한 정액이 %HIS_HER(ARG)%의 허벅지에 달라붙는다 # 정액이 %HIS_HER(ARG)%의 허벅지를 타고 흘러내린다 \@"
			IF EX:ARG:放尿 >= 12
				SETCOLOR C_YELLOW
				HTML += HTML_PRINT_NAS(@"・%HIS_HER(ARG,1)%의 다리는 %HIS_HER(ARG)%의 오줌으로 흥건하다.")
				RESETCOLOR
			ELSEIF EX:ARG:放尿 >= 5
				SETCOLOR C_YELLOW
				HTML += HTML_PRINT_NAS(@"%HIS_HER(ARG)%의 다리에서 소변이 똑똑 떨어진다. ")
				RESETCOLOR
			ENDIF
		ENDIF
		IF SoiledSelf:ARG:1 && SoiledDiaper(ARG,2,,100)
			CALLF C_JELLYORPOO()
			IF GETBIT(nScat,5)
				HTML += HTML_PRINT_NAS(@"%FSYN("poo:n")% 조각들이 %HIS_HER(ARG)+" "+PeeProtectType(ARG)%에서 떨어지고 있다.")
			ELSE
				HTML += HTML_PRINT_NAS(@"・%HIS_HER(ARG,1)+" "+PeeProtectType(ARG)%의 PeeProtectType(ARG)은 넘치고 극도로 지저분해 보인다.")
			ENDIF
			RESETCOLOR
		ELSEIF SoiledDiaper(ARG,2,,75)
			CALLF C_JELLYORPOO()
			HTML += HTML_PRINT_NAS(@"・%HIS_HER(ARG,1)+" "+PeeProtectType(ARG)%는 %FSYN("poo:n")%으로 가득 차 보이고 냄새가 난다.")
			RESETCOLOR
		ELSEIF SoiledDiaper(ARG,2,,40)
			CALLF C_JELLYORPOO()
			HTML += HTML_PRINT_NAS(@"・%HIS_HER(ARG,1)+" "+PeeProtectType(ARG)%은/는 %FSYN("poo:n")%의 특징적인 냄새를 풍긴다.")
			RESETCOLOR
		ENDIF
		IF SoiledSelf:ARG:0
			SETCOLOR C_YELLOW
			HTML += HTML_PRINT_NAS(@"%HIS_HER(ARG)%의 %CLOTHING_NAME%에 소변 자국이 극도로 보인다.")
			RESETCOLOR
		ENDIF
		;ここからはうふふ中
	ELSEIF TEQUIP:下半身着衣状況 & 4
		IF PALAM:潤滑 >= PALAMLV:5
			HTML += @"%HIS_HER(ARG)% 다리 전체 길이가 흠뻑 젖어있다"
		ELSEIF PALAM:潤滑 >= PALAMLV:3
			HTML += @"액체가 %HIS_HER(ARG)%의 허벅지를 타고 흘러내린다."
		ENDIF
	ELSE
		HTML += @"・%HIS_HER(ARG,1)%의 옷이 위로 당겨져 %HIS_HER(ARG)%을 드러낸다 %HIP(ARG)%"
		IF PALAM:潤滑 >= PALAMLV:1 || CFLAG:ARG:アナル射精 == 1 || CFLAG:ARG:膣内射精 == 1 && !((CFLAG:ARG:アナル射精 == 1 && CFLAG:ARG:膣内射精 == 1) || TEQUIP:Ｖセックス == PLAYER || TEQUIP:バイブ || TEQUIP:Ａセックス == PLAYER || TEQUIP:アナルバイブ || TEQUIP:アナルビーズ || TEQUIP:浣腸 || TEQUIP:拡張バルーン || TEQUIP:アナル電極)
			;これ下半身下着１がアリで下半身下着２がナシだとどうなるんですかね
			;IF (EQUIP:下半身下着１ || EQUIP:下半身下着２)
			;修正を試み加筆;しておいてなんですが下半身下着１を悉皆する選択肢もありますよ
			IF EQUIP:下半身下着２
				;CLOTHING_NAME '= PANTSNAME(EQUIP:ARG:下半身下着２, ARG)
				CLOTHING_NAME '= CLOTHNAME_GENERIC(6,EQUIP:ARG:下半身下着２)
				IF IsPadded(ARG)
					;diape descriptions
					IF SoiledDiaper(ARG,1,,100)
						HTML += @"・%HIS_HER(ARG,1)% %CLOTHING_NAME% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%에서 새고 있다."
					ELSEIF SoiledDiaper(ARG,1,,80)
						HTML += @"・%HIS_HER(ARG,1)% %CLOTHING_NAME% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 완전히 차 있다."
					ELSEIF SoiledDiaper(ARG,1,,60)
						HTML += @"・%HIS_HER(ARG,1)%은(는) %CLOTHING_NAME% %HAS_HAVE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 상당히 볼록하게 부풀어 올랐다."
					ELSEIF SoiledDiaper(ARG,1,,40)
						HTML += @"・%HIS_HER(ARG,1)%의 (은/는) %CLOTHING_NAME% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 축축하고 말랑하다."
					ELSEIF SoiledDiaper(ARG,1,,20)
						HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHING_NAME% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 축축하다"
					ENDIF
				ELSE
					IF SoiledDiaper(ARG,1,,100)
						HTML += @"・%HIS_HER(ARG,1)%%CLOTHING_NAME% %IS_ARE_PANTIES(CLOTHES_TR(CLOTHING_NAME))%가 새고 있다."
					ELSEIF SoiledDiaper(ARG,1,,60)
						HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHING_NAME% %IS_ARE_PANTIES(CLOTHING_NAME)%가 더러워졌다"
					ELSEIF SoiledDiaper(ARG,1,,40)
						HTML += @"・%HIS_HER(ARG,1)%의 %CLOTHING_NAME% %IS_ARE_PANTIES(CLOTHING_NAME)%가 축축하다."
					ENDIF
				ENDIF
			ELSE
				CLOTHING_NAME '= GET_STR(ARG, "下半身下着_ずらし不可", EQUIP:ARG:下半身下着１, "名前")
				SELECTCASE CLOTHING_NAME
					CASE "褌", "スパッツ"
						IF CFLAG:ARG:膣内射精 == 1 || CFLAG:ARG:アナル射精 == 1 || PALAM:潤滑 >= PALAMLV:3
							HTML += @"・%HIS_HER(ARG,1)%의 %PANTSNAME(EQUIP:ARG:下半身下着１, ARG)%이 얼룩져 있다"
						ELSEIF PALAM:潤滑 >= PALAMLV:2
							HTML += @"・%HIS_HER(ARG,1)%의 %PANTSNAME(EQUIP:ARG:下半身下着１, ARG)%가 축축해졌다."
						ENDIF
					CASE "前張り", "絆創膏"
						IF CFLAG:ARG:膣内射精 == 1 || CFLAG:ARG:アナル射精 == 1 || PALAM:潤滑 >= PALAMLV:5
							HTML += @"・%HIS_HER(ARG,1)%은(는) %PANTSNAME(EQUIP:ARG:下半身下着１, ARG)%을 벗는다"
						ELSEIF CFLAG:ARG:膣内射精 == 1 || CFLAG:ARG:アナル射精 == 1 || PALAM:潤滑 >= PALAMLV:3
							HTML += @"・%HIS_HER(ARG,1)%의 %PANTSNAME(EQUIP:ARG:下半身下着１, ARG)%가 얼룩져 있다."
						ELSEIF PALAM:潤滑 >= PALAMLV:2
							HTML += @"・%HIS_HER(ARG,1)%의 %PANTSNAME(EQUIP:ARG:下半身下着１, ARG)%가 축축하다."
						ENDIF
					CASE "貞操帯", "ラビアピアス", "クリピアス"
						IF CFLAG:ARG:膣内射精 == 1 || CFLAG:ARG:アナル射精 == 1 || PALAM:潤滑 >= PALAMLV:3
							HTML += @"%PANTSNAME(EQUIP:ARG:下半身下着１, ARG)%에 물기가 생겨있다."
						ELSEIF PALAM:潤滑 >= PALAMLV:2
							HTML += @"・%HIS_HER(ARG,1)%의 %PANTSNAME(EQUIP:ARG:下半身下着１, ARG)%가 축축하다."
						ENDIF
				ENDSELECT
			ENDIF
		ENDIF
		IF !EQUIP:下半身下着２
			; ELSEIF PANTIES_SHIFT_ASIDE(ARG)
			;     HTML += @"・%HIS_HER(ARG,1)% %PANTSNAME(EQUIP:ARG:下半身下着２, ARG)% %HAS_HAVE_PANTIES(PANTSNAME(EQUIP:ARG:下半身下着２, ARG))% been moved aside"
		ELSEIF TEQUIP:ARG:PANTY_STATE != PANTY_WORN ;addition custom code
			HTML += @"・%HIS_HER(ARG,1)% %PRINT_PANTY_STATE(ARG, "past")%"
		ELSEIF (CFLAG:ARG:アナル射精 == 1 || CFLAG:ARG:膣内射精 == 1) && !(TEQUIP:Ｖセックス == PLAYER || TEQUIP:バイブ || TEQUIP:Ａセックス == PLAYER || TEQUIP:アナルバイブ || TEQUIP:アナルビーズ || TEQUIP:浣腸 || TEQUIP:拡張バルーン || TEQUIP:アナル電極)
			HTML += @"・%HIS_HER(ARG,1)% %PANTSNAME(EQUIP:ARG:下半身下着２, ARG)% %HAS_HAVE_PANTIES(PANTSNAME(EQUIP:ARG:下半身下着２, ARG))%에 커다란 얼룩이 생겼다."
		ENDIF
		IF CFLAG:ARG:膣内射精 == 1 && PALAM:潤滑 >= PALAMLV:1 && !(TEQUIP:Ｖセックス == PLAYER || TEQUIP:バイブ) && (TEQUIP:Ａセックス == PLAYER || TEQUIP:アナルバイブ || TEQUIP:アナルビーズ || TEQUIP:浣腸 || TEQUIP:拡張バルーン || TEQUIP:アナル電極)
			HTML += @"정액과 그들 자신의 액으로 넘쳐흐르고 있다"
		ELSEIF CFLAG:ARG:膣内射精 == 1 && !(TEQUIP:Ｖセックス == PLAYER || TEQUIP:バイブ || PALAM:潤滑 >= PALAMLV:1) && (TEQUIP:Ａセックス == PLAYER || TEQUIP:アナルバイブ || TEQUIP:アナルビーズ || TEQUIP:浣腸 || TEQUIP:拡張バルーン || TEQUIP:アナル電極)
			HTML += @"%HIS_HER(ARG)%의 질에서 정액이 새어 나온다."
		ELSEIF CFLAG:ARG:アナル射精 == 1 && !(TEQUIP:Ａセックス == PLAYER || TEQUIP:アナルバイブ || TEQUIP:アナルビーズ || TEQUIP:浣腸 || TEQUIP:拡張バルーン || TEQUIP:アナル電極) && (TEQUIP:Ｖセックス == PLAYER || TEQUIP:バイブ)
			HTML += @"%HIS_HER(ARG)%의 항문에서 정액이 새어 나온다."
		ENDIF
		IF EX:ARG:放尿 > 0
			;SETCOLOR PeeColor_C(ARG)
			SETCOLOR C_YELLOW
			HTML += @"・%HIS_HER(ARG,1)% %PANTSNAME(EQUIP:ARG:下半身下着２, ARG)% %HAS_HAVE_PANTIES(PANTSNAME(EQUIP:ARG:下半身下着２, ARG))% "
			SETCOLOR PeeColor_C(ARG)
			HTML += @"%PeeColor(ARG)%"
			SETCOLOR C_YELLOW
			SIF EX:ARG:放尿 >= 9
				HTML += @"깊게"
			SIF EX:ARG:放尿 < 5
				HTML += @"%" "%하지만 빛이"
			HTML += @"%" "%오줌 자국 "
			RESETCOLOR
		ENDIF
		IF EX:ARG:放尿 >= 5
			SETCOLOR C_YELLOW
			HTML += @"%HIS_HER(ARG)%의 요도에서 소변이 똑똑 떨어진다. "
			RESETCOLOR
		ENDIF
		IF EX:ARG:Defecation >= 5
			CALLF C_JELLYORPOO()
			HTML += @"・%HIS_HER(ARG,1)%의 항문은 \@ GETBIT(nScat,4) ? 분변 물질 # 젤로 더럽혀져 있다 \@ "
			RESETCOLOR
		ENDIF
	ENDIF
	CALL LOOK_BELLY(ARG)
ENDIF
HTML_PRINT HTML
IF (TCVAR:ARG:V挿入管理フラグ == PLAYER || TCVAR:ARG:A挿入管理フラグ == PLAYER) && TALENT:PLAYER:形状 == 10
	PRINTL
	PRINT 음부에서 페니스의 형상이 보일 수 있다...
ENDIF
