; Modular ERB: OMOGATARI/Makai/MAKAI_ENTRY.ERB

@MAKAI_PORTAL_ABLE
#FUNCTION
;One of the requirements MUST be met to use the portal.
;Makai person
SIF TALENT:MASTER:190 == 5
	RETURNF 1
;Knowledge A or higher
SIF ABL:MASTER:43 >= UniversalRank("A")
	RETURNF 1
;Member of the Federation
SIF FactionRank:MASTER:9
	RETURNF 1
;Intimacy 5 or higher with a Makai person
SIF MakaiUnlockCharacterCheck()
	RETURNF MakaiUnlockCharacterCheck()
RETURNF makaiPortalUnlocked
;checks for intimacy

@MakaiUnlockCharacterCheck
#FUNCTION
FOR LOCAL,0,8
SELECTCASE LOCAL
	CASE 0
		LOCAL:1 = 17
	CASE 1
		LOCAL:1 = 48
	CASE 2
		LOCAL:1 = 102
	CASE 3
		LOCAL:1 = 103
	CASE 4
		LOCAL:1 = 104
	CASE 5
		LOCAL:1 = 105
	CASE 6
		LOCAL:1 = 147
	CASE 7
		LOCAL:1 = 148
ENDSELECT
SIF ABL:(LOCAL:1):9 >= 5
	RETURNF LOCAL:1
NEXT

@MakaiPortalUnlockNotify(reason)
#DIMS reason
;, you can now access Makai via a portal.
SELECTCASE reason
	CASE "knowledge"
		PRINTFORML 공부를 하는 동안, 마카이로 가는 포털이 있다는 것을 알게 된다.
	CASE "intimacy"
		PRINTFORML %CALLNAME:MakaiUnlockCharacterCheck()%과 친구가 된 후, %HE_SHE(MakaiUnlockCharacterCheck())%은(는) 마카이로 가는 포털이 있다고 알려준다.
	CASE "log"
		PRINTFORML 당신은 추가 스테이지 라이선스를 획득했습니다!
ENDSELECT
PRINTFORMW 이제 포털을 통해 [마카이]에 접근할 수 있다.
makaiPortalUnlocked = 1
