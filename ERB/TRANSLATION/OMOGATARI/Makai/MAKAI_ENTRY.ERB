@MAKAI_PORTAL_ABLE
#FUNCTION
;One of the requirements MUST be met to use the portal.

;Makai person
SIF TALENT:MASTER:190 == 5
    RETURNF 1
;Knowledge A or higher
SIF ABL:MASTER:43 >= UniversalRank("A")
    RETURNF 1
;Member of the Federation
SIF FactionRank:MASTER:9
    RETURNF 1

;Intimacy 5 or higher with a Makai person
SIF MakaiUnlockCharacterCheck()
    RETURNF MakaiUnlockCharacterCheck()

RETURNF makaiPortalUnlocked

;checks for intimacy
@MakaiUnlockCharacterCheck
#FUNCTION
FOR LOCAL,0,8
    SELECTCASE LOCAL
    CASE 0
    LOCAL:1 = 17
    CASE 1
    LOCAL:1 = 48
    CASE 2
    LOCAL:1 = 102
    CASE 3
    LOCAL:1 = 103
    CASE 4
    LOCAL:1 = 104
    CASE 5
    LOCAL:1 = 105
    CASE 6
    LOCAL:1 = 147
    CASE 7
    LOCAL:1 = 148
    ENDSELECT
    SIF ABL:(LOCAL:1):9 >= 5
        RETURNF LOCAL:1
NEXT

@MakaiPortalUnlockNotify(reason)
#DIMS reason
;, you can now access Makai via a portal.
SELECTCASE reason
CASE "knowledge"
    PRINTFORML During your studies, you find out that there is a portal to Makai.
CASE "intimacy"
    PRINTFORML After befriending %CALLNAME:MakaiUnlockCharacterCheck()%, %HE_SHE(MakaiUnlockCharacterCheck())% tells you that that there is a portal to Makai.
CASE "log"
    PRINTFORML You have obtained your Extra Stage License!
ENDSELECT
PRINTFORMW You can now access [Makai] via a portal.

makaiPortalUnlocked = 1