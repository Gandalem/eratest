		RETURN 1102
	CASE 1102
		SELECTCASE 現在の位置
			CASE 1103
				RETURN 1101
			CASE 1109, 1110, 1118, 1121
				RETURN 1107
			CASE 1142
				RETURN 1141
			CASEELSE
				RETURN 1103
