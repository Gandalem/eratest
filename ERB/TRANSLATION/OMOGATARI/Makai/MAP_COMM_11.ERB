; Modular ERB: OMOGATARI/Makai/MAP_COMM_11.ERB
;--------------------------------------------------
;地点名変更関数
;--------------------------------------------------

@MAP_PLACENAME_11(ARG, ARG:1)
#FUNCTIONS
IF GET_MAPID(ARG) == MAIN_MAP
	SELECTCASE ARG
		CASE 1128 ;qol custom code
			IF CFLAG:MASTER:初期位置 == ARG
				RETURNF CALLNAME:MASTER + "의 저택"
			ELSE
				RETURNF "빈 저택"
			ENDIF
		CASE SUMIKOMI_ROOM
			;※このマップでは未実装
			IF FLAG:住み込みキャラ
				RETURNF "무너진 신전・"+CALLNAME:(FLAG:住み込みキャラ) + "의 방"
			ELSE
				RETURNF "무너진 신전・201호"
			ENDIF
		CASE MINROOM() TO (MAXROOM - 1)
			RETURNF STR_TR(ARG + 8000)
		CASE OMANEKIBEYA()
			RETURNF OMANEKI_PLACE()
		CASE SUKIMA()
			RETURNF "틈새 공간"
		CASE MAXROOM
			RETURNF "환상의 세계"
		CASEELSE
			RETURNF "알 수 없음"
	ENDSELECT
ELSE
	RETURNF "경계 너머"
ENDIF
;--------------------------------------------------
;場所ARGがどのエリアにあるか
;表示するマップの番号と連動（TFLAG:マップ切り替え）
;ARG     場所ID
;--------------------------------------------------

@MAP_AREASELECT_11(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 1157 TO 1177
		RETURNF 6
	CASE 1178
		RETURNF 5
	CASE 1145 TO 1154
		RETURNF 4
	CASE 1131 TO 1139
		RETURNF 3
	CASE 1122 TO 1127
		RETURNF 2
	CASEELSE
		RETURNF 1
ENDSELECT
;--------------------------------------------------
;内部構造がある場所の内部の判定
;TFLAG:マップ切り替え  内部察知が必要なマップ番号
;                P_ID  表示ボタンの場所ID
;                Q_ID  判定する内部の場所ID,必ずP_IDと一致した数値も含める
;--------------------------------------------------

@GETMAP_BUILDING_11(P_ID, Q_ID)
#FUNCTION
#DIM P_ID
#DIM Q_ID
IF TFLAG:マップ切り替え == 1
	SELECTCASE P_ID
	ENDSELECT
ENDIF
RETURNF 0
;--------------------------------------------------
;移動制限設定
;ARG    場所ID
;CHARA  移動するキャラID
;RETURNF 1=移動できる,0=移動できない
;TFLAG:移動不能メッセージ   ↓の@MAP_CANNOT_WORD用の設定
;--------------------------------------------------

@MAP_CAN_MOVE_11(ARG, CHARA)
#FUNCTION
#DIM CHARA
SELECTCASE ARG
ENDSELECT
RETURNF 1
;--------------------------------------------------
;移動不能時に表示されるメッセージ
;--------------------------------------------------

@MAP_CANNOT_WORD_11(ARG)
RETURN
SELECTCASE TFLAG:移動不能メッセージ
	CASE 1
		PRINTFORMW 여기에 메시지를 넣는다. 줄 수 + 1의 CLEARLINE을 한다
		CLEARLINE 2
ENDSELECT
REUSELASTLINE
;-----------------------------------------
;拠点専用の情景描写
;WAITはかけないように
;-----------------------------------------

@MAP_UNIQUEMESSAGE_11
SELECTCASE CFLAG:MASTER:現在位置
	CASE 1101
		PRINTDATAL
			DATAFORM A 「마카이(MAKAI)」라는 간판이 도시의 꼭대기에 우뚝 서 있었다.
			DATAFORM 「마카이는 오른쪽으로 통행한다」와 「차량 주의」 같은 경고 표지판들이 옆에 붙어 있다.
			DATAFORM 「MKForce 요원을 상대하지 마라. 사살될 것이다」라고 적힌 불길한 빨간색 간판을 발견할 수 있다.
			DATAFORM 「시간 정지자들: 당신은 혼자가 아니다」라고 쓰인 파란색 표지판이 보인다.
			DATAFORM 가운데 권총 그림과 함께 「숨긴 소지 및 공개 휴대 상태」라고 적힌 노란색 간판을 볼 수 있다.
		ENDDATA
	CASE 1102, 1103
		SELECTCASE RAND:3
			CASE 0
				PRINTFORM A 
				CALL MAP_11_RAND_CAR_PRINT()
				PRINTDATA
					DATAFORM  경주하는 모습이 보이다
					DATAFORM  도로 위에 주차되어 있다
					DATAFORM  무심하게 지나간다
					DATAFORM  신호등에서 정지한다
					DATAFORM  차들과 날아다니는 사람들 사이에서 눈에 띈다
				ENDDATA
			CASE 1
				PRINTFORML 「일반 폐기물만. 더러운 의류는 금지.」라는 표지가 붙은 쓰레기통이 보인다.
			CASE 2
				IF INRANGE(TIME, CLOCK_TO_TIME(6), CLOCK_TO_TIME(21, 59))
					PRINTFORML 몇몇 마카이 사람들이 어슬렁거리고 있다.
				ELSE
					PRINTFORML 마카이의 거리는 비어 있다.
				ENDIF
			CASE 3
				PRINTFORML 빨간 테두리가 있는 흰색 원형 표지판이 보도에 서 있으며 「50」이라고 적혀 있다.
		ENDSELECT
	CASE 1104
		PRINTDATAL
			DATAFORM A 「얼음과 눈의 세계」 표지판이 문 앞에 있다.
			DATAFORM A 「4WD 또는 체인 타이어 필요」 표지판이 문 앞에 있다.
			DATAFORM 「문 밖 기온 SUB 0C」 및 「방한복 착용 필수」와 같은 경고 표지판들이 옆에 있다.
			DATAFORM 「관광객: 시내에 머무르시오」라고 적힌 불길한 빨간색 표지판을 발견할 수 있다.
		ENDDATA
	CASE 1111
		SELECTCASE RAND:4
			CASE 0
				$OmoGomiBin
				PRINTFORML 쓰레기통이 두 개 있었는데, 하나에는 「일반 폐기물만. 오염된 의류는 금지.」라고 적힌 표지판이 있고, 다른 하나는 「오모고미: 오염된 의류 전용」 통이었다.
				PRINTFORML 오모고미 통에는 사용한 기저귀, 패드, 옷을 이 통에 버리며 마카이에 기여해달라는 문구와 함께 치워진 기저귀를 처리하는 소녀의 그림이 적혀 있었다.
			CASE 1
				PRINTFORML '겐소우짱' 브랜드의 성인용 접이식 기저귀 교환대와 기저귀 디스펜서가 있다.
				PRINTFORML 표지에는 「팬타스타베이비 디스펜서. 몇 개 이상 필요하세요? 「겐소우짱」 본사에서 무료로 제공해 드립니다.」라고 쓰여 있었다.
			CASE 2
				PRINTFORML 화장실은 현대적인 좌변기다.
			CASE 3
				PRINTFORML 화장실은 세면대의 매끄러운 대리석과 은색으로 칠해진 나무 칸막이가 있어 상당히 현대적으로 보인다.
		ENDSELECT
	CASE 1112, 1113, 1114
		SELECTCASE RAND:1
			CASE 0
				GOTO OmoGomiBin
		ENDSELECT
	CASE 1119
		PRINTDATAL
			DATAFORM 「FEDERATION SUPERMARKET」가 큰 노란색 글씨로 쓰여 있다.
			DATAFORM 「절에서 도둑질하는 것은 범죄다. 도둑은 감옥에 갈 것이다」라는 빨간 표지판이 가게 곳곳에 놓여 있다.
			DATAFORM 「도둑질을 하고 도망치려고 순간이동하지 마라. 우리가 잡을 것이다.」라는 빨간 표지판이 가게 곳곳에 놓여 있다.
		ENDDATA
	CASE 1148
		GOTO OmoGomiBin
	CASE 1178
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「홋카이」라고 쓰인 빨간 표지판이 입구에 있다.
				PRINTFORML 그 바로 아래에는 「액티브 전투 존. 전투 훈련 필요」라는 또 다른 빨간 표지판이 있다.
		ENDSELECT
		;PRINTFORML A red sign saying「Authorized MKForce personnel only」is at the entrance.
	CASEELSE
ENDSELECT
RETURN 1

@MAP_11_RAND_CAR_PRINT()
SELECTCASE RAND:100
	CASE IS <= 20
		;sports cars
		PRINTDATA
			;Nissan Skyline GT-R (BNR34)
			DATAFORM V34 마스터슨 호라이즌 GD-X 스포츠카
			;Nissan GT-R (R35)
			DATAFORM V35 마스터슨 호라이즌 GD-X 슈퍼카
			;Toyota Supra (JZA80)
			DATAFORM A40 면허 슈퍼카 레이싱 스포츠카
			;Lexus LFA (LFA10)
			DATAFORM SNG1 면허 슈퍼카
			DATAFORM 시베타 볼리데 슈퍼카
		ENDDATA
	CASE IS <= 40
		;utility
		PRINTDATA
			;utility
			DATAFORM 레벨 46 프랭클린 올테레인 스포츠 유틸리티 차량
			DATAFORM '90년대 슈발리에 D1500 픽업트럭
		ENDDATA
	CASE IS >= 90
		;unique
		PRINTDATA
			;utility
			DATAFORM 근사(幻想)-짱, 비행 자동차를 탄다.
			DATAFORM 근사(幻想)-짱, 장갑차 형태의 비행체를 마주한다.
		ENDDATA
	CASEELSE
		;regular cars
		PRINTDATA
			;Nissan Skyline GTS-t (HCR32)
			DATAFORM V32 마스터슨 호라이즌 GDS-t 세단
			DATAFORM '90년대 슈발리에 니알라 세단
			DATAFORM 2020년대 슈발리에 니알라 세단
			DATAFORM E120 멘쿄 아우룸 세단
			DATAFORM E210 멘쿄 아우룸 해치백
			;based on the beamng vehicle
			DATAFORM 체리에 비바체 해치백
		ENDDATA
ENDSELECT
;-----------------------------------------
;拠点の場所IDをお出かけマップ上の場所IDに置換する関数
;ARG      対象の場所ID（拠点マップ）
;RETURNF  差し替え場所ID（お出かけマップ）
;-----------------------------------------

@MAP_SEARCH_REPLACEMENT_11(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 1101 TO 1121, 1128, 1129, 1130, 1140, 1141
		RETURNF 1110
	CASE 1122 TO 1127, 1179
		RETURNF 1120
	CASE 1131 TO 1139
		RETURNF 1130
	CASE 1142, 1143
		RETURNF 1150
	CASE 1157 TO 1177
		RETURNF 1170
ENDSELECT
RETURNF 0
