;--------------------------------------------------
;地点名変更関数
;--------------------------------------------------
@MAP_PLACENAME_11(ARG, ARG:1)
#FUNCTIONS
IF GET_MAPID(ARG) == MAIN_MAP
	SELECTCASE ARG
		CASE 1128 ;qol custom code
			IF CFLAG:MASTER:初期位置 == ARG
				RETURNF CALLNAME:MASTER + "'s Residence"
			ELSE
				RETURNF "Vacant Housing"
			ENDIF
		CASE SUMIKOMI_ROOM
			;※このマップでは未実装
			IF FLAG:住み込みキャラ
				RETURNF "Fallen Temple・"+CALLNAME:(FLAG:住み込みキャラ) + "'s Room"
			ELSE
				RETURNF "Fallen Temple・Room 201"
			ENDIF
		CASE MINROOM() TO (MAXROOM - 1)
			RETURNF STR_TR(ARG + 8000)
		CASE OMANEKIBEYA()
			RETURNF OMANEKI_PLACE()
		CASE SUKIMA()
			RETURNF "Gap Space"
		CASE MAXROOM
			RETURNF "World of Fantasy"
		CASEELSE
			RETURNF "Unknown"
	ENDSELECT
ELSE
	RETURNF "Beyond the Border"
ENDIF

;--------------------------------------------------
;場所ARGがどのエリアにあるか
;表示するマップの番号と連動（TFLAG:マップ切り替え）
;ARG     場所ID
;--------------------------------------------------
@MAP_AREASELECT_11(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 1157 TO 1177
		RETURNF 6
	CASE 1178
		RETURNF 5
	CASE 1145 TO 1154
		RETURNF 4
	CASE 1131 TO 1139
		RETURNF 3
	CASE 1122 TO 1127
		RETURNF 2
	CASEELSE
		RETURNF 1
ENDSELECT

;--------------------------------------------------
;内部構造がある場所の内部の判定
;TFLAG:マップ切り替え  内部察知が必要なマップ番号
;                P_ID  表示ボタンの場所ID
;                Q_ID  判定する内部の場所ID,必ずP_IDと一致した数値も含める
;--------------------------------------------------
@GETMAP_BUILDING_11(P_ID, Q_ID)
#FUNCTION
#DIM P_ID
#DIM Q_ID
IF TFLAG:マップ切り替え == 1
	SELECTCASE P_ID
	ENDSELECT
ENDIF
RETURNF 0

;--------------------------------------------------
;移動制限設定
;ARG    場所ID
;CHARA  移動するキャラID
;RETURNF 1=移動できる,0=移動できない
;TFLAG:移動不能メッセージ   ↓の@MAP_CANNOT_WORD用の設定
;--------------------------------------------------
@MAP_CAN_MOVE_11(ARG, CHARA)
#FUNCTION
#DIM CHARA
SELECTCASE ARG
ENDSELECT
RETURNF 1

;--------------------------------------------------
;移動不能時に表示されるメッセージ
;--------------------------------------------------
@MAP_CANNOT_WORD_11(ARG)
RETURN
SELECTCASE TFLAG:移動不能メッセージ
	CASE 1
		PRINTFORMW ※ここにメッセージを入れる。行数+1のCLEARLINEをする
		CLEARLINE 2
ENDSELECT
REUSELASTLINE

;-----------------------------------------
;拠点専用の情景描写
;WAITはかけないように
;-----------------------------------------
@MAP_UNIQUEMESSAGE_11
SELECTCASE CFLAG:MASTER:現在位置
	CASE 1101
		PRINTDATAL
		DATAFORM A 「WELCOME TO MAKAI」 sign towers at the top of the city.
		DATAFORM Warning signs such as「MAKAI DRIVES ON THE RIGHT」and 「WATCH OUT FOR VEHICLES」are on the side
		DATAFORM An ominous red sign saying「DO NOT ENGAGE MKForce PERSONNEL. YOU WILL BE SHOT」can be found.
		DATAFORM An blue sign saying「TIME STOPPERS: YOU ARE NOT ALONE」can be seen.
		DATAFORM An yellow sign with a pistol at the middle saying「CONCEALED AND OPEN CARRY STATE」can be seen.
		ENDDATA
	CASE 1102, 1103
		SELECTCASE RAND:3
		CASE 0
			PRINTFORM A 
			CALL MAP_11_RAND_CAR_PRINT()
			PRINTDATA
			DATAFORM  can be seen racing
			DATAFORM  is parked on the road
			DATAFORM  casually drives by
			DATAFORM  stops for a traffic light
			DATAFORM  stands out within the traffic of cars and flying people
			ENDDATA
		CASE 1
			PRINTFORML An trash can with the sign saying「GENERAL DISPOSAL ONLY. NO SOILED GARMENTS.」can be seen.
		CASE 2
			IF INRANGE(TIME, CLOCK_TO_TIME(6), CLOCK_TO_TIME(21, 59))
				PRINTFORML Several Makai persons are mingling about.
			ELSE
				PRINTFORML The streets of Makai are empty.
			ENDIF
		CASE 3
			PRINTFORML A white circular sign with a red border stands on the sidewalk, saying「50」.

		ENDSELECT
	CASE 1104
		PRINTDATAL
		DATAFORM A 「WORLD OF ICE AND SNOW」 sign is at the gate.
		DATAFORM A 「4WD OR CHAINED TIRES REQUIRED」 sign is at the gate.
		DATAFORM Warning signs such as「SUB 0C TEMPERATURES OUTSIDE THE GATE」and 「COLD CLOTHES REQUIRED」are on the side
		DATAFORM An ominous red sign saying「TOURISTS: STAY IN THE CITY」can be found.
		ENDDATA
	CASE 1111
		SELECTCASE RAND:4
		CASE 0
			$OmoGomiBin
			PRINTFORML There are two trash cans, one with the sign saying「GENERAL DISPOSAL ONLY. NO SOILED GARMENTS.」, and another 「OmoGomi: SOILED GARMENTS ONLY」 bin.
			PRINTFORML The OmoGomi bin has the sign 「Help contribute to Makai: Dispose of your soiled diapers, pads, and clothing in this bin.」, with a figure of a girl disposing a used diaper.
		CASE 1
			PRINTFORML There an adult-sized folding changing table with Gensou-chan branding, along with a diaper dispenser.
			PRINTFORML The sign says「FantastaBab dispenser. Need more than a few? Complementary diapers can be given from the Gensou-chan HQ.」
		CASE 2
			PRINTFORML The toilets are modern squat toilets.
		CASE 3
			PRINTFORML The bathrooms look rather modern, with smooth looking marble at the sink and silver painted wood stalls.
		ENDSELECT
	CASE 1112, 1113, 1114
		SELECTCASE RAND:1
		CASE 0
			GOTO OmoGomiBin
		ENDSELECT
	CASE 1119
		PRINTDATAL
		DATAFORM 「FEDERATION SUPERMARKET」 is in big yellow letters.
		DATAFORM A red sign saying「STEALING IS A CRIME IN THE FEDERATION. THIEVES WILL BE JAILED」is placed throughout the store.
		DATAFORM A red sign saying「DON'T TELEPORT TO GET AWAY WITH STEALING. WE WILL GET YOU.」is placed throughout the store.
		ENDDATA
	CASE 1148
		GOTO OmoGomiBin
	CASE 1178
		SELECTCASE RAND:3
		CASE 0
			PRINTFORML A red sign saying「HOKKAI」is at the entrance.
			PRINTFORML Another red sign is just below, saying「ACTIVE COMBAT ZONE. COMBAT TRAINING REQUIRED」.
		ENDSELECT
			;PRINTFORML A red sign saying「Authorized MKForce personnel only」is at the entrance.
	CASEELSE
ENDSELECT
RETURN 1

@MAP_11_RAND_CAR_PRINT()
SELECTCASE RAND:100
CASE IS <= 20
;sports cars
	PRINTDATA
	;Nissan Skyline GT-R (BNR34)
	DATAFORM V34 Masterson Horizon GD-X sports car
	;Nissan GT-R (R35)
	DATAFORM V35 Masterson Horizon GD-X super car
	;Toyota Supra (JZA80)
	DATAFORM A40 Menkyo Superic RZ sports car
	;Lexus LFA (LFA10)
	DATAFORM SNG1 Menkyo SNG super car
	DATAFORM Cievetta Bolide super car
	ENDDATA
CASE IS <= 40
;utility
	PRINTDATA
	;utility
	DATAFORM LV46 Franklin All-Terrain sport utility vehicle
	DATAFORM '90s Chevalier D1500 pickup
	ENDDATA
CASE IS >= 90
;unique
	PRINTDATA
	;utility
	DATAFORM Gensou-chan Commit flying car
	DATAFORM Gensou-chan Conflict armored flying vehicle
	ENDDATA
CASEELSE
;regular cars
	PRINTDATA
	;Nissan Skyline GTS-t (HCR32)
	DATAFORM V32 Masterson Horizon GDS-t sedan
	DATAFORM '90s Chevalier Nyala sedan
	DATAFORM 2020s Chevalier Nyala sedan
	DATAFORM E120 Menkyo Aurum sedan
	DATAFORM E210 Menkyo Aurum hatchback
	;based on the beamng vehicle
	DATAFORM Cherrier Vivace hatchback
	ENDDATA
ENDSELECT

;-----------------------------------------
;拠点の場所IDをお出かけマップ上の場所IDに置換する関数
;ARG      対象の場所ID（拠点マップ）
;RETURNF  差し替え場所ID（お出かけマップ）
;-----------------------------------------
@MAP_SEARCH_REPLACEMENT_11(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 1101 TO 1121, 1128, 1129, 1130, 1140, 1141
		RETURNF 1110
	CASE 1122 TO 1127, 1179
		RETURNF 1120
	CASE 1131 TO 1139
		RETURNF 1130
	CASE 1142, 1143
		RETURNF 1150
	CASE 1157 TO 1177
		RETURNF 1170
ENDSELECT
RETURNF 0

