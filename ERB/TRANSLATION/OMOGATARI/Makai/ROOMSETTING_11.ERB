;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
;地点の属性設定
;場所_ワンルーム   家主が不在のとき鍵がかかる,布団・屋内・厨房・勉強・休憩・飲食・プライベートが自動で付与
;場所_布団         休憩が自動で付与
;場所_洋室         屋内だけど靴を履いたまま,屋内が自動で付与
;場所_屋内
;場所_屋根         屋外だけど屋根がある場所,屋内でも屋根でも無い場合は野外判定（旧青天井）
;場所_広い
;場所_月見         屋内や屋根があっても月が見える場所
;場所_休憩
;場所_風呂
;場所_トイレ
;場所_厨房         つまみ食いが自動で付与
;場所_訓練
;場所_勉強
;場所_天の声
;場所_菜園
;場所_水汲み
;場所_身体測定
;場所_物干し       風景描写用
;場所_飲食         自由行動用
;場所_つまみ食い   自由行動用
;場所_留まらない   あまりキャラが留まらない（移動しやすい）
;場所_過疎         あまりキャラが立ち入らない（移動されにくい）
;場所_プライベート 節度のあるキャラは入ってこない,主に私室と風呂・トイレ
;場所_炬燵         自由行動用
;場所_公共の場     押し倒してこない
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
@ROOMSETTING_11
#DIM ROOM
VARSET ROOMDATA
MAXROOM = 1180
PatrolingFaction = 9
ENTRANCE = 1101
避難先 = 1111

SIF GET_MAPID(拠点_酒虫) != MAIN_MAP
	拠点_酒虫 = 1101

MAP_PAGES = 6
MAPNAME:1 = Makai City
MAPNAME:2 = World of Ice and Snow
IF ABL:102:親密 >= 5
MAPNAME:3 = Project Vina
ELSE
MAPNAME:3 = Ruins of Vina
ENDIF
MAPNAME:4 = Pandæmonium
MAPNAME:5 = Hokkai
MAPNAME:6 = Fallen Temple

;qol custom code
SUMIKOMI_ROOM = 1129


FOR LOCAL, MINROOM(), MAXROOM
	ROOM = LOCAL % 100
	SELECTCASE LOCAL
	;▼Makai City
	CASE 1157, 1169, 1149, 1150, 1108, 1110, 1116
		ROOMDATA:ROOM |= 場所_ワンルーム
	CASE 1101
		ROOMDATA:ROOM |= 場所_広い
	CASE 1102
		ROOMDATA:ROOM |= 場所_広い
	CASE 1103
		ROOMDATA:ROOM |= 場所_広い
		ROOMDATA:ROOM |= 場所_訓練
	CASE 1109
		ROOMDATA:ROOM |= 場所_屋内
	CASE 1128, 1129
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_プライベート
	CASE 1111 TO 1114
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_トイレ
		ROOMDATA:ROOM |= 場所_プライベート
	CASE 1115
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_風呂
		;ROOMDATA:ROOM |= 場所_プライベート
	CASE 1117
		ROOMDATA:ROOM |= 場所_屋内
	CASE 1118
		ROOMDATA:ROOM |= 場所_屋内
	CASE 1119
		ROOMDATA:ROOM |= 場所_屋内
	CASE 1120
		ROOMDATA:ROOM |= 場所_菜園
	CASE 1121
		ROOMDATA:ROOM |= 場所_屋内
	;▼World of Ice and Snow
	CASE 1122
		ROOMDATA:ROOM |= 場所_広い
		ROOMDATA:ROOM |= 場所_訓練
	;▼Pandemonium
	CASE 1147
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_飲食
	CASE 1148
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_トイレ
		ROOMDATA:ROOM |= 場所_プライベート
	CASE 1151
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_風呂
		ROOMDATA:ROOM |= 場所_プライベート
	;▼Fallen Temple
	CASE 1158
		ROOMDATA:ROOM |= 場所_広い
		ROOMDATA:ROOM |= Is_Graveyard
	CASE 1159
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_広い
	CASE 1160, 1161, 1168
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_トイレ
		ROOMDATA:ROOM |= 場所_プライベート
	CASE 1164, 1167
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_風呂
		ROOMDATA:ROOM |= 場所_プライベート
	CASE 1162
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_広い
		ROOMDATA:ROOM |= 場所_休憩
	CASE 1165
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_広い
		ROOMDATA:ROOM |= 場所_休憩
		ROOMDATA:ROOM |= 場所_天の声
	CASE 1163
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_厨房
	CASE 1166
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_休憩
		ROOMDATA:ROOM |= 場所_勉強
		ROOMDATA:ROOM |= 場所_飲食
		ROOMDATA:ROOM |= 場所_炬燵
		ROOMDATA:ROOM |= 場所_広い
	CASE 1170, 1171, 1172, 1174, 1175, 1176
		ROOMDATA:ROOM |= 場所_屋内
		ROOMDATA:ROOM |= 場所_休憩
		ROOMDATA:ROOM |= 場所_勉強
		ROOMDATA:ROOM |= 場所_飲食
		ROOMDATA:ROOM |= 場所_炬燵
		ROOMDATA:ROOM |= 場所_厨房
		ROOMDATA:ROOM |= 場所_プライベート
	CASE 1173
		ROOMDATA:ROOM |= 場所_屋内
	ENDSELECT
NEXT

;-----------------------------------------
;デフォルトの初期位置と大家の設定
;-----------------------------------------
@DEFAULT_OWNER_11
デフォルト初期位置 = 1128
拠点_大家 = 102

;-----------------------------------------
;お出かけマップの設定
;ARG   対象の地点
;ARGS  判定文字引数
;-----------------------------------------
@ODEKAKEMAP_SETTING_11(ARG, ARGS)
#FUNCTION
;＼1 2 3 4 5 6 7 8 9 
;01　　　　　　　　　
;02　　　　　　　　　
;03　　　　　　　　　
;04６　　　　　　　　
;05５　７　　８　　　
;06　　　　　　　　９
;07　　　　　　　　　
;08　　　　　　　　　
;09１　　　　　　　　
SELECTCASE ARG
CASE 6111
	SIF ARGS == "座標"
		RETURNF 19
	SIF GROUPMATCH(ARGS, "屋根")
		RETURNF 1
CASE 6112
	SIF ARGS == "座標"
		RETURNF 19
	SIF GROUPMATCH(ARGS, "屋根")
		RETURNF 1
CASEELSE
	SIF ARGS == "座標"
		RETURNF 19
	SIF GROUPMATCH(ARGS, "屋根")
		RETURNF 1
ENDSELECT
