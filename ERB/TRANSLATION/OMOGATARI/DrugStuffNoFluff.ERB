;Big unified function for drug effects.
;For single effects
;Arguments:
;C_ID: Character ID
;I_ID: Item ID
;RNG: Some items may have random effects. -1 rolls it randomly here, but you can set a value taken from somewhere else.
@DrugStuffNoFluff(C_ID,I_ID,RNG=-1,G_ID=-1)
#DIM DYNAMIC C_ID
#DIM DYNAMIC I_ID
#DIM DYNAMIC G_ID
#DIM DYNAMIC RNG
SIF G_ID==-1
    G_ID = C_ID
SELECTCASE I_ID
CASE 41; Aphro
    TCVAR:C_ID:媚薬 += DRUG_EFFECTIVENESS(C_ID,210)
CASE 42; Diuretic
    TCVAR:C_ID:利尿剤 += DRUG_EFFECTIVENESS(C_ID,210)
CASE 51 TO 59; Alcohols
    CALL DRUNKEN(C_ID,I_ID)
CASE 120; Black Thunder
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 50, @"%ITEMNAME:I_ID%/甘い/ジャンキー/サクサク/"), "体力", "Recover via chocolate")
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 50, @"%ITEMNAME:I_ID%/甘い/ジャンキー/サクサク/"), "気力", "Recover via chocolate")
    CALL 満腹度上昇(C_ID, "デザート", 60)
    SIF nScat
        TCVAR:C_ID:FoodIntake += 150
CASE 121
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 300, @"%ITEMNAME:I_ID%/甘い/"), "体力", "Recover via chocolate")
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 300, @"%ITEMNAME:I_ID%/甘い/"), "気力", "Recover via chocolate")
    CALL 満腹度上昇(C_ID, "デザート")
    SIF nScat
        TCVAR:C_ID:FoodIntake += 150
CASE 122
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 500, @"%ITEMNAME:I_ID%/甘い/上品/豪華/高級食材/"), "体力", "Recover via chocolate")
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 500, @"%ITEMNAME:I_ID%/甘い/上品/豪華/高級食材/"), "気力", "Recover via chocolate")
    CALL 満腹度上昇(C_ID, "デザート")
    SIF nScat
        TCVAR:C_ID:FoodIntake += 150
CASE 123; Handmade Chocolate
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 1000, @"%ITEMNAME:I_ID%/愛情/甘い/"), "体力", "Recover via chocolate")
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 1000, @"%ITEMNAME:I_ID%/愛情/甘い/"), "気力", "Recover via chocolate")
    CALL 満腹度上昇(C_ID, "デザート")
    SIF nScat
        TCVAR:C_ID:FoodIntake += 150
CASE 212; Rice Cake/kashiwa mochi
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 100, @"%ITEMNAME:I_ID%/甘い/"), "体力", "Recover via kashiwa mochi")
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID,   0, @"%ITEMNAME:I_ID%/甘い/"), "気力", "Recover via kashiwa mochi")
    CALL 満腹度上昇(C_ID, "デザート")
    SIF nScat
        TCVAR:C_ID:FoodIntake += 500
CASE 213; Ice Cream
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 150, @"%ITEMNAME:I_ID%/冷たい/甘い/"), "気力", "Recover via ice cream")
    CALL 満腹度上昇(C_ID, "デザート")
    ; SIF GETBIT(nPee, 1)
    ; 	CALL DRINK(C_ID, 100,1)	
    SIF nScat
        TCVAR:C_ID:FoodIntake += 300
CASE 215; Black Tea
    SETBIT TCVAR:C_ID:特別なお茶, 0
CASE 218; Water
    CALL RECOVER(C_ID, 75, "体力", "Recover via water")
    CALL RECOVER(C_ID, 150, "気力", "Recover via water")
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 500)
CASE 219; Coffee
    CALL RECOVER(C_ID, 200, "体力", "Recover via coffee")
    CALL RECOVER(C_ID, 400, "気力", "Recover via coffee")
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 500)
    TCVAR:C_ID:お薬 += 1
CASE 220; Bottle of Urine
    TFLAG:PissCup += 1000
    SIF C_ID == MASTER
        CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("pissDrinker")
    CALL Com_DrinkPee(C_ID)
    CALL ADD_CUSTOM_MESSAGE_COM153
    CALL GET_ITEM("EmptyBottle", 1, 1)
CASE 221; Soda
    CALL RECOVER(C_ID, 300, "体力", "Recover via soda")
    CALL RECOVER(C_ID, 200, "気力", "Recover via soda")
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 355)
    SIF nScat
        DrugStats:C_ID:LaxativeTime += 30
    TCVAR:C_ID:お薬 += 1
CASE 222; Marshmallow
    CALL RECOVER(C_ID, 125, "体力", "Recover via marshmallows")
    CALL RECOVER(C_ID, 100, "気力", "Recover via marshmallows")
    SIF nScat
        TCVAR:C_ID:FoodIntake += 50
; CASE 223; Healing Soda
;     CALL RECOVER(C_ID, 1200, "体力", "Recover via soda")
;     CALL RECOVER(C_ID, 600, "気力", "Recover via soda")
;     SIF GETBIT(nPee, 1)
;         CALL DRINK(C_ID, 355)
;     SIF nScat
;         DrugStats:C_ID:LaxativeTime += 30
;     TCVAR:C_ID:お薬 += 1
CASE 224; Harming Soda
    CALL RECOVER(C_ID, -600, "体力", "Recover via soda")
    CALL RECOVER(C_ID, -400, "気力", "Recover via soda")
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 355)
    SIF nScat
        DrugStats:C_ID:LaxativeTime += 30
    TCVAR:C_ID:お薬 += 1
CASE 225; Sensible Soda
    CALL RECOVER(C_ID, 300, "体力", "Recover via soda")
    CALL RECOVER(C_ID, 200, "気力", "Recover via soda")
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 355)
    SIF nScat
        DrugStats:C_ID:LaxativeTime += 30
    TCVAR:C_ID:お薬 += 1
CASE 253; Cocaine
    CALLF AddDrugGain(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,210), 48, G_ID, "cocaine")
    CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,180,-1),G_ID,"cocaine")
    CALLF ChangeEndurance(C_ID,"charatrauma",-350)
    CALL RECOVER(C_ID, 2250, "体力", "Recover via cocaine")
    CALL RECOVER(C_ID, 1800, "気力", "Recover via cocaine")
CASE 300; Tissue
    SoiledSelf:C_ID:0 = 0
    SoiledSelf:C_ID:1 = 0
CASE 314; Laxative
    DrugStats:C_ID:LaxativeTime += DRUG_EFFECTIVENESS(C_ID,210,0)
CASE 315; Anaphro
    DrugStats:C_ID:AnaphrodisiacTime += DRUG_EFFECTIVENESS(C_ID,210,0)
CASE 352; Strawberry
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 50, @"%ITEMNAME:I_ID%/野菜/果物/甘い/"), "気力", "Recover via strawberry")
    SIF nScat
        TCVAR:C_ID:FoodIntake += 100
CASE 364; Watermellon
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 100, @"%ITEMNAME:I_ID%/野菜/果物/甘い/"), "気力", "Recover via watermelon")
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 200,1)
    SIF nScat
        TCVAR:C_ID:FoodIntake += 300
CASE 500; Green Juice
    CALL RECOVER(C_ID,100, "体力", "Recover via green juice")
    CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 200, @"%ITEMNAME:I_ID%/苦い/苦い/苦い/ヘルシー/野菜/葉物/野趣/"), "気力", "Recover via green juice")
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 250,1)
CASE 501; Energy Drink
    CALL RECOVER(C_ID, 薬の知識(200), "体力", "Recover via energy drink")
    CALL RECOVER(C_ID, 薬の知識(100), "気力", "Recover via energy drink")
    CFLAG:C_ID:眠気覚まし = MAX(薬の知識(20), CFLAG:C_ID:眠気覚まし)
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 500,1)	
    TCVAR:C_ID:お薬 = 1
CASE 502; Vigora
    CALL RECOVER(C_ID, 薬の知識(300), "精力", "Recover via Vigora")
    SIF GETBIT(nPee, 1)
        CALL RECOVER(C_ID,200, "尿意", "Recover via Vigora")		
    TCVAR:C_ID:お薬 = 1
CASE 503
    CALL RECOVER(C_ID, 薬の知識(500), "体力", "Recover via Gin Gin Ｚ")
    CALL RECOVER(C_ID, 薬の知識(300), "気力", "Recover via Gin Gin Ｚ")
    CFLAG:C_ID:眠気覚まし = MAX(薬の知識(60), CFLAG:C_ID:眠気覚まし)
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 500,1)
    TCVAR:C_ID:お薬 = 1
CASE 505
    CALL RECOVER(C_ID, 薬の知識(800), "体力", "Recover via Gin Gin Ｘ")
    CALL RECOVER(C_ID, 薬の知識(600), "気力", "Recover via Gin Gin Ｘ")
    CFLAG:C_ID:眠気覚まし = MAX(薬の知識(180), CFLAG:C_ID:眠気覚まし)
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 1000,1)
    CFLAG:C_ID:徹夜 = 1
    TCVAR:C_ID:お薬 = 1
CASE 506; Medical Drug『Tengen Toppa』
    CALL RECOVER(C_ID, 薬の知識(400), "体力", "Recover via Medical Drug『Tengen Toppa』")
    CALL RECOVER(C_ID, 薬の知識(300), "気力", "Recover via Medical Drug『Tengen Toppa』")
    CALL RECOVER(C_ID, 薬の知識(800), "精力", "Recover via Medical Drug『Tengen Toppa』")
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 500,1)
    TCVAR:C_ID:お薬 = 1
CASE 507; Potion
    CALL RECOVER(C_ID, 薬の知識(150), "気力", "Recover via potion")
    CALL RECOVER(C_ID, 薬の知識(150), BASENAME:7, "Recover via potion") ; NAS
    CALL RECOVER(C_ID, 薬の知識(150), "TSP", "Recover via potion")
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 250,1)		
    TCVAR:C_ID:お薬 = 1
CASE 508; Magic Potion
    CALL RECOVER(C_ID, 薬の知識(300), "気力", "Recover via magic potion")
    CALL RECOVER(C_ID, 薬の知識(600), BASENAME:7, "Recover via magic potion")
    CALL RECOVER(C_ID, 薬の知識(600), "TSP", "Recover via magic potion")
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 250,1)
    TCVAR:C_ID:お薬 = 1
CASE 509; No Sleep Potion
    CALL RECOVER(C_ID, 薬の知識(200), "気力", "Recover via no-sleep potion")
    CFLAG:C_ID:眠気覚まし = MAX(薬の知識(240), CFLAG:C_ID:眠気覚まし)
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 250,1)
    CFLAG:C_ID:徹夜 = 1
    TCVAR:C_ID:お薬 = 1
CASE 510; Tumeric Drink
    TFLAG:酔い止め = 1
CASE 511; Elixir
    CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:体力), "体力", "Recover via Elixir")
    CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:気力), "気力", "Recover via Elixir")
    CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:精力), "精力", "Recover via Elixir")
    CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:TSP),  "TSP",  "Recover via Elixir")
    CFLAG:C_ID:眠気覚まし = MAX(300, CFLAG:C_ID:眠気覚まし)
    CALL Resurrect(C_ID,,1)
    CALLF HESOYAM(C_ID)
    IF GETBIT(nPee, 1)
        CALLF RINYOUME(C_ID, 600, 10000, 0)
    ENDIF
    TCVAR:C_ID:お薬 = 1
    ; CALLF DamageBodyPart(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,210), 43, G_ID, "Elixir")
    ; CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,350),G_ID,"Elixir")
CASE 512; Elixir of Life
    CALL BUFF_BASE(C_ID, BASE_体力, MAX(MAXBASE:C_ID:体力 / 5, 500))
    CALL BUFF_BASE(C_ID, BASE_気力, MAX(MAXBASE:C_ID:気力 / 5, 500))
    CALL BUFF_BASE(C_ID, BASE_精力, MAX(MAXBASE:C_ID:精力 / 5, 500))	
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 500,1)	
CASE 515; Peerless Patriot's Elixir
    RNG = TCVAR:C_ID:国士無双の薬 < 3
    IF RNG == 1
        CALL BUFF_BASE(C_ID, BASE_体力, MAX(MAXBASE:C_ID:体力 / 15, 150))
        CALL BUFF_BASE(C_ID, BASE_精力, MAX(MAXBASE:C_ID:精力 / 10, 150))			
        TCVAR:C_ID:国士無双の薬 ++
    ELSE
        ;四回目で爆発、デバフに
        CALL BUFF_BASE(C_ID, BASE_体力, MIN((-1 * (MAXBASE:C_ID:体力 / 5)), -450))
        CALL BUFF_BASE(C_ID, BASE_精力, MIN((-1 * (MAXBASE:C_ID:精力 / 3)), -450))
        TCVAR:C_ID:国士無双の薬 = 0
    ENDIF
    SIF GETBIT(nPee, 1)
        CALL DRINK(C_ID, 250,1)
CASE 517
    TFLAG:ポイズンボディ += DRUG_EFFECTIVENESS(C_ID,240,0)
CASE 524; Ibuprofen
    CALLF DamageBodyPart(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,210), 44, G_ID, "Ibuprofen")
    CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,60,-1),G_ID,"Ibuprofen")
    CALL RECOVER(C_ID, 100, "体力", "Recover via Ibuprofen")
CASE 525; Morphine
    CALLF DamageBodyPart(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,210), 43, G_ID, "Morphine")
    CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,130,-1),G_ID,"Morphine")
    CALL RECOVER(C_ID, 300, "体力", "Recover via morphine")
CASE 533; Gensou-chan bottle
    SIF RNG == -1
        RNG = RAND:20
    SELECTCASE LOCAL
    CASE 0
		PeeHoldExp:C_ID:0 -= 50
		PooHoldExp:C_ID:0 -= 50
		CALLF RINYOUME(C_ID, 90, 1000)
		CALLF GERIME(C_ID, 90, 1000, 0)
    CASE 1
		CALL RECOVER(C_ID, MAXBASE:C_ID:体力/3, "体力", "Milk in GC bottle")
		CALL RECOVER(C_ID, MAXBASE:C_ID:体力/3, "気力", "Milk in GC Bottle")
    CASE 2
		CALL RECOVER(C_ID, MAXBASE:C_ID:体力/3, "体力", "Milk in GC bottle")
		CALL RECOVER(C_ID, MAXBASE:C_ID:体力/3, "気力", "Milk in GC Bottle")
		SOURCE:C_ID:Regression += 2500
    CASE 3
		CALLF RINYOUME(C_ID, 60, 0)
		CALLF GERIME(C_ID, 60, 500, 0)		
		TCVAR:C_ID:お薬 = 1
    CASE 4
		SOURCE:C_ID:Regression -= 2500
    CASE 5
		CALLF RINYOUME(C_ID, 90, 1000)
    CASE 6
		CALL RECOVER(C_ID,100, "体力", "Recover via green juice")
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 200, @"%ITEMNAME:I_ID%/苦い/苦い/苦い/ヘルシー/野菜/葉物/野趣/"), "気力", "Recover via green juice")
    CASE 7
		CALLF RINYOUME(C_ID, 40, 0)
		CALLF GERIME(C_ID, 40, 300, 0)
		SETBIT TCVAR:MASTER:特別なお茶, 0
    CASE 8
        CALL RECOVER(C_ID, 薬の知識(200), "体力", "Recover via energy drink")
        CALL RECOVER(C_ID, 薬の知識(100), "気力", "Recover via energy drink")
        CFLAG:C_ID:眠気覚まし += 20
        TCVAR:C_ID:お薬 = 1
        CALLF RINYOUME(C_ID, 60, 0)
        CALLF GERIME(C_ID, 60, 500, 0)
    CASE 9
        CALL RECOVER(C_ID, 薬の知識(500), "体力", "Recover via Gin Gin Ｚ")
        CALL RECOVER(C_ID, 薬の知識(300), "気力", "Recover via Gin Gin Ｚ")
        CFLAG:C_ID:眠気覚まし += 薬の知識(60)
        TCVAR:C_ID:お薬 = 1
        CALLF RINYOUME(C_ID, 60, 0)
        CALLF GERIME(C_ID, 60, 500, 0)
    CASE 10
        CALL RECOVER(C_ID, 薬の知識(150), "気力", "Recover via potion")
        CALL RECOVER(C_ID, 薬の知識(150), BASENAME:7, "Recover via potion") ; NAS
        CALL RECOVER(C_ID, 薬の知識(150), "TSP", "Recover via potion")	
        TCVAR:C_ID:お薬 = 1
        CALLF RINYOUME(C_ID, 60, 0)
        CALLF GERIME(C_ID, 60, 500, 0)
    CASE 11
        CALL RECOVER(C_ID, 薬の知識(300), "気力", "Recover via magic potion")
        CALL RECOVER(C_ID, 薬の知識(600), "TSP", "Recover via magic potion")
        TCVAR:C_ID:お薬 = 1
        CALLF RINYOUME(C_ID, 60, 0)
        CALLF GERIME(C_ID, 60, 500, 0)
    CASE 12
        TFLAG:酔い止め = 1
    CASE 13
        CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:体力), "体力", "Recover via Elixir")
        CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:気力), "気力", "Recover via Elixir")
        CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:精力), "精力", "Recover via Elixir")
        CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:TSP),  "TSP",  "Recover via Elixir")
        CFLAG:C_ID:眠気覚まし += 300
        CALL RESURRECT(C_ID,,1)
        IF nPee || nScat
            CALLF RINYOUME(C_ID, 600, 10000, 0)
            CALLF GERIME(C_ID, 600, 10000, 0)
        ENDIF
    CASE 14
        CALL BUFF_BASE(C_ID, BASE_体力, MAX(MAXBASE:C_ID:体力 / 5, 500))
        CALL BUFF_BASE(C_ID, BASE_気力, MAX(MAXBASE:C_ID:気力 / 5, 500))
        CALL BUFF_BASE(C_ID, BASE_精力, MAX(MAXBASE:C_ID:精力 / 5, 500))
    CASE 15
        TCVAR:C_ID:国士無双の薬 ++
    CASE 16
        CALL DRUNKEN(C_ID,58)
    CASE 17
        SETBIT YoujutsuEffects:C_ID:18, 22
    CASE 18
        IF C_ID == MASTER
            TFLAG:GensouBottleUsed = 99
        ELSE
            CALL PRINT_GP("W", @"Unable to keep %HIMSELF_HERSELF(C_ID)% up, %CALLNAME:C_ID% falls to the ground.")
            CALLF GO2SLEEP(C_ID)
        ENDIF
    CASE 19
		CFLAG:C_ID:眠気覚まし -= -600
    ENDSELECT
    RETURN LOCAL
CASE 539; Marketeers Injector
    BASE:C_ID:0 = MAXBASE:C_ID:0
    BASE:C_ID:気力 = MAXBASE:C_ID:気力
    BASE:C_ID:精力 = MAXBASE:C_ID:精力
    ;BASE:C_ID:7 = MAXBASE:C_ID:7
    IsDead:C_ID:0 = 0
    TCVAR:C_ID:Bleeding = 0
    CFLAG:C_ID:313 = 0
    CALLF HealAllHediffs(C_ID,NUM_EXPONENT(10,9))
CASE 1100; Fake antidepressant
    ;CFLAG:C_ID:PainSuppress += DRUG_EFFECTIVENESS(C_ID,2500000,1)
    CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,1000,-1),G_ID,"fentanyl")
    CALLF AddDrugGain(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,2500), 42, G_ID, "counterfeit antidepressants")
    CALLF ChangeEndurance(C_ID,"charatrauma",-1000)
CASE 1101; Fake morphine
    SIF RNG == -1
        RNG = RAND:10
    IF RNG <= 1
        CALL RECOVER(C_ID,300, "体力", "Recover via illicit morphine")
        CALLF AddDrugGain(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,210), 43, G_ID, "Illicit morphine")
        CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,350,-1),G_ID,"illicit morphine")
        RETURN 0
    ELSE
        CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,3500,-1),G_ID,"illicit morphine")
        CALLF AddDrugGain(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,1260), 43, G_ID, "Illicit morphine")
        ;CFLAG:C_ID:PainSuppress += DRUG_EFFECTIVENESS(C_ID,15000000,1)
        RETURN 1
    ENDIF
CASE 1107; Fake Laxative
    ;constant effect. tummy go hurdz doesn't need no drug tollerance.
    DrugStats:C_ID:LaxativeFakeTime = 210
CASE 1108; Incon Drop
    ; INCONTINENCE!!!!
    CALLF AddDrugGain(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,1440), 53, G_ID, "Incontinence drop")
CASE 11091; Fake Aphrodisiac
    ; Poison
    CALL RECOVER(C_ID, -MAX((MAXBASE:C_ID:0/2),1000), BASENAME:0, "Damage by counterfeit aphrodisiac")
CASE 11092; Fake Aphrodisiac
    ; DEATH
    CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,3500,-1),G_ID,"counterfeit aphrodisiac")
    CALL DrugStuffNoFluff(C_ID,41)
CASE 1110; Defibrillator
    IsDead:C_ID:0 = 0
    BASE:C_ID:0 = MAX(BASE:C_ID:0,1000)
    CFLAG:C_ID:衰弱 = 0
    CALLF WAKEUP(C_ID)
CASE 1111; Fake Anaphrodisiac
    CALLF ChangeEndurance(C_ID,"charatrauma",200)
    DOWNBASE:C_ID:0 += 250
CASE 1114; Fake Elixir
    CALL RECOVER(C_ID, 600, "体力", "Recover via counterfeit Elixir")
    CALL RECOVER(C_ID, 300, "気力", "Recover via counterfeit Elixir")
    IF GETBIT(nPee, 1)
        CALLF RINYOUME(C_ID, 600, 10000, 0)
    ENDIF
    TCVAR:C_ID:お薬 = 1
CASE 1115; Green Potion
    CALL RECOVER(C_ID, -MAX((MAXBASE:C_ID:0/2),800), BASENAME:0, "Damage by green potion")
CASE 1116; KyuuKyuu-Nyo
    CALLF AddDrugGain(C_ID, 0, 210, 40, C_ID, "KyuuKyuu-Nyo")
    CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,180,-1),G_ID,"KyuuKyuu-Nyo")
