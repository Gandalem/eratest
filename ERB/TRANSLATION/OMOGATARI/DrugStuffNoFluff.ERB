; Modular ERB: OMOGATARI/DrugStuffNoFluff.ERB
;Big unified function for drug effects.
;For single effects
;Arguments:
;C_ID: Character ID
;I_ID: Item ID
;RNG: Some items may have random effects. -1 rolls it randomly here, but you can set a value taken from somewhere else.

@DrugStuffNoFluff(C_ID,I_ID,RNG=-1,G_ID=-1)
#DIM DYNAMIC C_ID
#DIM DYNAMIC I_ID
#DIM DYNAMIC G_ID
#DIM DYNAMIC RNG
SIF G_ID==-1
	G_ID = C_ID
SELECTCASE I_ID
	CASE 41; Aphro
		TCVAR:C_ID:媚薬 += DRUG_EFFECTIVENESS(C_ID,210)
	CASE 42; Diuretic
		TCVAR:C_ID:利尿剤 += DRUG_EFFECTIVENESS(C_ID,210)
	CASE 51 TO 59; Alcohols
		CALL DRUNKEN(C_ID,I_ID)
	CASE 120; Black Thunder
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 50, @"%ITEMNAME:I_ID%/달콤한/중독성 있는/바삭한/"), "体力", "초콜릿으로 회복한다")
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 50, @"%ITEMNAME:I_ID%/달콤한/중독적인/바삭한/"), "気力", "초콜릿으로 회복한다")
		CALL 満腹度上昇(C_ID, "デザート", 60)
		SIF nScat
			TCVAR:C_ID:FoodIntake += 150
	CASE 121
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 300, @"%ITEMNAME:I_ID%의 달콤한"), "体力", "초콜릿으로 회복한다.")
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 300, @"%ITEMNAME:I_ID%의 달콤한"), "気力", "초콜릿을 통해 회복한다")
		CALL 満腹度上昇(C_ID, "デザート")
		SIF nScat
			TCVAR:C_ID:FoodIntake += 150
	CASE 122
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 500, @"%ITEMNAME:I_ID%의 달콤하고 우아하며 호화로운 고급식재/"), "体力", "초콜릿을 통해 회복한다.")
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 500, @"%ITEMNAME:I_ID%/달콤한/고급스러운/호화로운/고급식재/"), "気力", "초콜릿을 통해 회복한다.")
		CALL 満腹度上昇(C_ID, "デザート")
		SIF nScat
			TCVAR:C_ID:FoodIntake += 150
	CASE 123; Handmade Chocolate
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 1000, @"%ITEMNAME:I_ID%의 애정/달콤함/"), "体力", "초콜릿으로 회복한다.")
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 1000, @"%ITEMNAME:I_ID%의 애정/달콤함/"), "気力", "초콜릿으로 회복한다")
		CALL 満腹度上昇(C_ID, "デザート")
		SIF nScat
			TCVAR:C_ID:FoodIntake += 150
	CASE 212; Rice Cake/kashiwa mochi
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 100, @"%ITEMNAME:I_ID%/달콤한/"), "体力", "가시와 모치로 회복한다.")
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID,   0, @"%ITEMNAME:I_ID%의 달콤한"), "気力", "가시와 모치로 회복한다.")
		CALL 満腹度上昇(C_ID, "デザート")
		SIF nScat
			TCVAR:C_ID:FoodIntake += 500
	CASE 213; Ice Cream
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 150, @"%ITEMNAME:I_ID%/차가운/달콤한/"), "気力", "아이스크림으로 회복한다.")
		CALL 満腹度上昇(C_ID, "デザート")
		; SIF GETBIT(nPee, 1)
		; 	CALL DRINK(C_ID, 100,1)
		SIF nScat
			TCVAR:C_ID:FoodIntake += 300
	CASE 215; Black Tea
		SETBIT TCVAR:C_ID:特別なお茶, 0
	CASE 218; Water
		CALL RECOVER(C_ID, 75, "体力", "물을 통해 회복한다.")
		CALL RECOVER(C_ID, 150, "気力", "물을 통해 회복한다.")
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 500)
	CASE 219; Coffee
		CALL RECOVER(C_ID, 200, "体力", "커피로 회복한다")
		CALL RECOVER(C_ID, 400, "気力", "커피를 통해 회복한다.")
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 500)
		TCVAR:C_ID:お薬 += 1
	CASE 220; Bottle of Urine
		TFLAG:PissCup += 1000
		SIF C_ID == MASTER
			CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("pissDrinker")
		CALL Com_DrinkPee(C_ID)
		CALL ADD_CUSTOM_MESSAGE_COM153
		CALL GET_ITEM("EmptyBottle", 1, 1)
	CASE 221; Soda
		CALL RECOVER(C_ID, 300, "体力", "소다를 통해 회복한다")
		CALL RECOVER(C_ID, 200, "気力", "소다를 통해 회복한다")
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 355)
		SIF nScat
			DrugStats:C_ID:LaxativeTime += 30
		TCVAR:C_ID:お薬 += 1
	CASE 222; Marshmallow
		CALL RECOVER(C_ID, 125, "体力", "마시멜로를 통해 회복한다.")
		CALL RECOVER(C_ID, 100, "気力", "마시멜로를 통해 회복한다.")
		SIF nScat
			TCVAR:C_ID:FoodIntake += 50
		; CASE 223; Healing Soda
		;     CALL RECOVER(C_ID, 1200, "体力", "Recover via soda")
		;     CALL RECOVER(C_ID, 600, "気力", "Recover via soda")
		;     SIF GETBIT(nPee, 1)
		;         CALL DRINK(C_ID, 355)
		;     SIF nScat
		;         DrugStats:C_ID:LaxativeTime += 30
		;     TCVAR:C_ID:お薬 += 1
	CASE 224; Harming Soda
		CALL RECOVER(C_ID, -600, "体力", "소다를 통해 회복한다")
		CALL RECOVER(C_ID, -400, "気力", "소다를 통해 회복한다")
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 355)
		SIF nScat
			DrugStats:C_ID:LaxativeTime += 30
		TCVAR:C_ID:お薬 += 1
	CASE 225; Sensible Soda
		CALL RECOVER(C_ID, 300, "体力", "소다를 통해 회복한다")
		CALL RECOVER(C_ID, 200, "気力", "소다를 통해 회복한다")
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 355)
		SIF nScat
			DrugStats:C_ID:LaxativeTime += 30
		TCVAR:C_ID:お薬 += 1
	CASE 253; Cocaine
		CALLF AddDrugGain(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,210), 48, G_ID, "cocaine")
		CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,180,-1),G_ID,"cocaine")
		CALLF ChangeEndurance(C_ID,"charatrauma",-350)
		CALL RECOVER(C_ID, 2250, "体力", "코카인을 통해 회복한다.")
		CALL RECOVER(C_ID, 1800, "気力", "코카인을 통해 회복한다")
	CASE 300; Tissue
		SoiledSelf:C_ID:0 = 0
		SoiledSelf:C_ID:1 = 0
	CASE 314; Laxative
		DrugStats:C_ID:LaxativeTime += DRUG_EFFECTIVENESS(C_ID,210,0)
	CASE 315; Anaphro
		DrugStats:C_ID:AnaphrodisiacTime += DRUG_EFFECTIVENESS(C_ID,210,0)
	CASE 352; Strawberry
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 50, @"%ITEMNAME:I_ID%은(는) 채소/과일/달다"), "気力", "딸기를 통해 회복한다.")
		SIF nScat
			TCVAR:C_ID:FoodIntake += 100
	CASE 364; Watermellon
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 100, @"%ITEMNAME:I_ID%은(는)/채소/과일/달다/"), "気力", "수박으로 회복한다.")
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 200,1)
		SIF nScat
			TCVAR:C_ID:FoodIntake += 300
	CASE 500; Green Juice
		CALL RECOVER(C_ID,100, "体力", "녹색 주스를 통해 회복한다.")
		CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 200, @"%ITEMNAME:I_ID%/쓴/쓴/쓴/건강한/채소/잎채소/야생적인/"), "気力", "녹색 주스로 회복한다.")
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 250,1)
	CASE 501; Energy Drink
		CALL RECOVER(C_ID, 薬の知識(200), "体力", "에너지 드링크로 회복한다.")
		CALL RECOVER(C_ID, 薬の知識(100), "気力", "에너지 드링크를 통해 회복한다.")
		CFLAG:C_ID:眠気覚まし = MAX(薬の知識(20), CFLAG:C_ID:眠気覚まし)
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 500,1)
		TCVAR:C_ID:お薬 = 1
	CASE 502; Vigora
		CALL RECOVER(C_ID, 薬の知識(300), "精力", "비고라를 통해 회복한다.")
		SIF GETBIT(nPee, 1)
			CALL RECOVER(C_ID,200, "尿意", "비고라를 통해 회복한다.")
		TCVAR:C_ID:お薬 = 1
	CASE 503
		CALL RECOVER(C_ID, 薬の知識(500), "体力", "진진을 통해 회복한다.")
		CALL RECOVER(C_ID, 薬の知識(300), "気力", "진진(Gin Gin)을 통해 회복한다.")
		CFLAG:C_ID:眠気覚まし = MAX(薬の知識(60), CFLAG:C_ID:眠気覚まし)
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 500,1)
		TCVAR:C_ID:お薬 = 1
	CASE 505
		CALL RECOVER(C_ID, 薬の知識(800), "体力", "진진을 통해 회복한다.")
		CALL RECOVER(C_ID, 薬の知識(600), "気力", "진진을 통해 회복한다.")
		CFLAG:C_ID:眠気覚まし = MAX(薬の知識(180), CFLAG:C_ID:眠気覚まし)
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 1000,1)
		CFLAG:C_ID:徹夜 = 1
		TCVAR:C_ID:お薬 = 1
	CASE 506; Medical Drug『Tengen Toppa』
		CALL RECOVER(C_ID, 薬の知識(400), "体力", "의료제 『텐겐 토파』를 통해 회복한다.")
		CALL RECOVER(C_ID, 薬の知識(300), "気力", "의료약 『텐겐 토파』로 회복한다.")
		CALL RECOVER(C_ID, 薬の知識(800), "精力", "의료품 『천공탑』을 통해 회복한다.")
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 500,1)
		TCVAR:C_ID:お薬 = 1
	CASE 507; Potion
		CALL RECOVER(C_ID, 薬の知識(150), "気力", "포션을 통해 회복한다.")
		CALL RECOVER(C_ID, 薬の知識(150), BASENAME:7, "물약으로 회복") ; NAS
		CALL RECOVER(C_ID, 薬の知識(150), "TSP", "포션으로 회복한다.")
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 250,1)
		TCVAR:C_ID:お薬 = 1
	CASE 508; Magic Potion
		CALL RECOVER(C_ID, 薬の知識(300), "気力", "마법 물약으로 회복한다.")
		CALL RECOVER(C_ID, 薬の知識(600), BASENAME:7, "마법 물약으로 회복한다")
		CALL RECOVER(C_ID, 薬の知識(600), "TSP", "마법 포션으로 회복한다.")
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 250,1)
		TCVAR:C_ID:お薬 = 1
	CASE 509; No Sleep Potion
		CALL RECOVER(C_ID, 薬の知識(200), "気力", "수면 방지 포션으로 회복한다")
		CFLAG:C_ID:眠気覚まし = MAX(薬の知識(240), CFLAG:C_ID:眠気覚まし)
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 250,1)
		CFLAG:C_ID:徹夜 = 1
		TCVAR:C_ID:お薬 = 1
	CASE 510; Tumeric Drink
		TFLAG:酔い止め = 1
	CASE 511; Elixir
		CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:体力), "体力", "엘릭서로 회복한다")
		CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:気力), "気力", "엘릭서로 회복한다.")
		CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:精力), "精力", "엘릭서로 회복한다.")
		CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:TSP),  "TSP",  "엘릭서로 회복한다")
		CFLAG:C_ID:眠気覚まし = MAX(300, CFLAG:C_ID:眠気覚まし)
		CALL Resurrect(C_ID,,1)
		CALLF HESOYAM(C_ID)
		IF GETBIT(nPee, 1)
			CALLF RINYOUME(C_ID, 600, 10000, 0)
		ENDIF
		TCVAR:C_ID:お薬 = 1
		; CALLF DamageBodyPart(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,210), 43, G_ID, "Elixir")
		; CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,350),G_ID,"Elixir")
	CASE 512; Elixir of Life
		CALL BUFF_BASE(C_ID, BASE_体力, MAX(MAXBASE:C_ID:体力 / 5, 500))
		CALL BUFF_BASE(C_ID, BASE_気力, MAX(MAXBASE:C_ID:気力 / 5, 500))
		CALL BUFF_BASE(C_ID, BASE_精力, MAX(MAXBASE:C_ID:精力 / 5, 500))
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 500,1)
	CASE 515; Peerless Patriot's Elixir
		RNG = TCVAR:C_ID:国士無双の薬 < 3
		IF RNG == 1
			CALL BUFF_BASE(C_ID, BASE_体力, MAX(MAXBASE:C_ID:体力 / 15, 150))
			CALL BUFF_BASE(C_ID, BASE_精力, MAX(MAXBASE:C_ID:精力 / 10, 150))
			TCVAR:C_ID:国士無双の薬 ++
		ELSE
			;四回目で爆発、デバフに
			CALL BUFF_BASE(C_ID, BASE_体力, MIN((-1 * (MAXBASE:C_ID:体力 / 5)), -450))
			CALL BUFF_BASE(C_ID, BASE_精力, MIN((-1 * (MAXBASE:C_ID:精力 / 3)), -450))
			TCVAR:C_ID:国士無双の薬 = 0
		ENDIF
		SIF GETBIT(nPee, 1)
			CALL DRINK(C_ID, 250,1)
	CASE 517
		TFLAG:ポイズンボディ += DRUG_EFFECTIVENESS(C_ID,240,0)
	CASE 524; Ibuprofen
		CALLF DamageBodyPart(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,210), 44, G_ID, "Ibuprofen")
		CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,60,-1),G_ID,"Ibuprofen")
		CALL RECOVER(C_ID, 100, "体力", "이부프로펜으로 회복한다")
	CASE 525; Morphine
		CALLF DamageBodyPart(C_ID, 0, DRUG_EFFECTIVENESS(C_ID,210), 43, G_ID, "Morphine")
		CALLF AddOverdoseGain(C_ID,DRUG_EFFECTIVENESS(C_ID,130,-1),G_ID,"Morphine")
		CALL RECOVER(C_ID, 300, "体力", "모르핀을 통해 회복한다.")
	CASE 533; Gensou-chan bottle
		SIF RNG == -1
			RNG = RAND:20
		SELECTCASE LOCAL
			CASE 0
				PeeHoldExp:C_ID:0 -= 50
				PooHoldExp:C_ID:0 -= 50
				CALLF RINYOUME(C_ID, 90, 1000)
				CALLF GERIME(C_ID, 90, 1000, 0)
			CASE 1
				CALL RECOVER(C_ID, MAXBASE:C_ID:体力/3, "体力", "GC 병 속의 우유")
				CALL RECOVER(C_ID, MAXBASE:C_ID:体力/3, "気力", "GC 병 안의 우유")
			CASE 2
				CALL RECOVER(C_ID, MAXBASE:C_ID:体力/3, "体力", "GC 병 안의 우유")
				CALL RECOVER(C_ID, MAXBASE:C_ID:体力/3, "気力", "GC 병 안의 우유")
				SOURCE:C_ID:Regression += 2500
			CASE 3
				CALLF RINYOUME(C_ID, 60, 0)
				CALLF GERIME(C_ID, 60, 500, 0)
				TCVAR:C_ID:お薬 = 1
			CASE 4
				SOURCE:C_ID:Regression -= 2500
			CASE 5
				CALLF RINYOUME(C_ID, 90, 1000)
			CASE 6
				CALL RECOVER(C_ID,100, "体力", "녹색 주스를 통해 회복한다.")
				CALL RECOVER(C_ID, ITEM_TASTE(C_ID, 200, @"%ITEMNAME:I_ID%의/쓴/쓴/쓴/건강한/채소/잎채소/야생미/"), "気力", "녹색 주스를 통해 회복한다.")
			CASE 7
				CALLF RINYOUME(C_ID, 40, 0)
				CALLF GERIME(C_ID, 40, 300, 0)
				SETBIT TCVAR:MASTER:特別なお茶, 0
			CASE 8
				CALL RECOVER(C_ID, 薬の知識(200), "体力", "에너지 드링크를 통해 회복한다.")
				CALL RECOVER(C_ID, 薬の知識(100), "気力", "에너지 드링크를 통해 회복한다.")
				CFLAG:C_ID:眠気覚まし += 20
				TCVAR:C_ID:お薬 = 1
				CALLF RINYOUME(C_ID, 60, 0)
				CALLF GERIME(C_ID, 60, 500, 0)
			CASE 9
				CALL RECOVER(C_ID, 薬の知識(500), "体力", "진진을 통해 회복한다.")
				CALL RECOVER(C_ID, 薬の知識(300), "気力", "진진을 통해 회복한다.")
				CFLAG:C_ID:眠気覚まし += 薬の知識(60)
				TCVAR:C_ID:お薬 = 1
				CALLF RINYOUME(C_ID, 60, 0)
				CALLF GERIME(C_ID, 60, 500, 0)
			CASE 10
				CALL RECOVER(C_ID, 薬の知識(150), "気力", "포션을 통해 회복한다.")
				CALL RECOVER(C_ID, 薬の知識(150), BASENAME:7, "물약으로 회복") ; NAS
				CALL RECOVER(C_ID, 薬の知識(150), "TSP", "포션으로 회복한다")
				TCVAR:C_ID:お薬 = 1
				CALLF RINYOUME(C_ID, 60, 0)
				CALLF GERIME(C_ID, 60, 500, 0)
			CASE 11
				CALL RECOVER(C_ID, 薬の知識(300), "気力", "마법 물약으로 회복한다.")
				CALL RECOVER(C_ID, 薬の知識(600), "TSP", "마법 물약으로 회복한다")
				TCVAR:C_ID:お薬 = 1
				CALLF RINYOUME(C_ID, 60, 0)
				CALLF GERIME(C_ID, 60, 500, 0)
			CASE 12
				TFLAG:酔い止め = 1
			CASE 13
				CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:体力), "体力", "엘릭서로 회복한다.")
				CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:気力), "気力", "엘릭서로 회복한다.")
				CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:精力), "精力", "엘릭서로 회복한다.")
				CALL RECOVER(C_ID, MAX(9999, MAXBASE:C_ID:TSP),  "TSP",  "엘릭서로 회복한다.")
				CFLAG:C_ID:眠気覚まし += 300
				CALL RESURRECT(C_ID,,1)
				IF nPee || nScat
					CALLF RINYOUME(C_ID, 600, 10000, 0)
					CALLF GERIME(C_ID, 600, 10000, 0)
				ENDIF
			CASE 14
				CALL BUFF_BASE(C_ID, BASE_体力, MAX(MAXBASE:C_ID:体力 / 5, 500))
				CALL BUFF_BASE(C_ID, BASE_気力, MAX(MAXBASE:C_ID:気力 / 5, 500))
				CALL BUFF_BASE(C_ID, BASE_精力, MAX(MAXBASE:C_ID:精力 / 5, 500))
			CASE 15
				TCVAR:C_ID:国士無双の薬 ++
			CASE 16
				CALL DRUNKEN(C_ID,58)
			CASE 17
				SETBIT YoujutsuEffects:C_ID:18, 22
			CASE 18
				IF C_ID == MASTER
					TFLAG:GensouBottleUsed = 99
				ELSE
