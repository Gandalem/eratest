			ENDIF
			IF MAXBASE:MASTER:TSP >= 4000
				CALL COLORMESSAGE(@"%PARSE("Your")% ~에 대한 통제력 %PARSE("your",1)% 시간 정지 능력이 절정에 달했다!",C_GREEN,1,1)
				POINTS += 1500
			ENDIF
			;PRINTFORMW You have good grips on your %%
			FOR LOCAL,1,CHARANUM-1
			PRINTFORML 관계와: %NAME:LOCAL%
			PRINTFORML %CALLNAME:LOCAL% has %TOSTR(CFLAG:LOCAL:2)% favorability.
			POINTS += CFLAG:LOCAL:2
			IF ABL:LOCAL:親密 > 0
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%의 친밀도 레벨은 %TOSTR(ABL:LOCAL:親密)%이다.",C_GREEN,1,1)
				POINTS = POINTS +(ABL:LOCAL:親密*100)
			ENDIF
			IF ABL:LOCAL:欲望 > 0
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은 욕정 레벨 %TOSTR(ABL:LOCAL:欲望)%이다.",C_GREEN,1,1)
				POINTS = POINTS +(ABL:LOCAL:欲望*100)
			ENDIF
			IF MARK:LOCAL:快楽刻印 > 0
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은 즐거움의 낙인 레벨 %TOSTR(MARK:LOCAL:快楽刻印)%을 가지고 있다.",C_RED,1,1)
				POINTS = POINTS +(MARK:LOCAL:快楽刻印*5000)
			ENDIF
			IF MARK:LOCAL:不埒刻印 > 0
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은 음란한 낙인 Lv.%TOSTR(MARK:LOCAL:不埒刻印)%을 가지고 있다.",C_RED,1,1)
				POINTS = POINTS +(MARK:LOCAL:不埒刻印*5000)
			ENDIF
			IF TALENT:LOCAL:恋慕
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은(는) 당신을 연모했다.",C_GREEN,1,1)
