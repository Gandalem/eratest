@FIND_DEATH(ARG, Rep, ShowRep)
#DIM Rep
#DIM IsAccept
#DIM RepColor
#DIM ShowRep
SIF IsDead:ARG:0
	RETURN -1
SIF KnowsDeadBodies:ARG:Rep && IsDead:Rep:0
	RETURN -1
SIF SaveIsEZB
	RETURN -1
KnowsDeadBodies:ARG:Rep = DAY
REDRAW 0
SIF ShowRep
	CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) %CALLNAME:Rep%의 죽음에 대해 알게 되었다.", C_RED, 2, 1)
SIF ARG == 29 && !GROUPMATCH(KilledBy:Rep:0,-1,Rep) && KilledBy:Rep:0 < CHARANUM
	CALL AddCombatInfamy(KilledBy:Rep:0,Rep,3)
;trauma gain
IF RELATION:ARG:LOCAL >= 100 && !Talent:LOCAL:Raider
	LOCAL:1 = ((1000*RELATION:ARG:LOCAL)/500)
	IF RELATION_IS_INCEST(ARG,ARG:1) == 1
		LOCAL:1 *= 2
	ELSEIF RELATION_IS_INCEST(ARG,ARG:1) == 2
		LOCAL:1 = LOCAL:1*130/100
	ENDIF
	CALLF ChangeEndurance(ARG,"charatrauma",LOCAL:1)
