@SET_HISTORY_DEATH(ARG,KILLER=-1,WEAPON,LOCATION,MODIFIER)
#DIM KILLER
#DIMS WEAPON
#DIMS LOCATION
#DIMS MODIFIER
#DIMS labelMessage
#DIM labelColor
#DIM messageStyle
SIF KILLER >= CHARANUM
	RETURN -1
SIF !nNecro && !SaveIsEZB && !TALENT:ARG:NonSentient
	RETURN -1
SIF IsDead:ARG:0
	RETURN
;don't hurt the baby!
SIF IS_BABY(ARG) || (NASCheat:5 && ARG == MASTER)
	RETURN
;非処女化、処女喰いフラグ、喪失記念日なども関数側で設定
DeathDay:ARG:0 = DAY
IF KILLER >= 0
	SIF WEAPON != "Bleeding"
		KilledBy:ARG:0 = KILLER
ELSEIF KILLER == -1 && !KilledBy:ARG:0 && !STRLENS(KilledWith:ARG:0)
	KilledBy:ARG:0 = ARG
ENDIF
IF WEAPON != "" && WEAPON != "Bleeding"
	KilledWith:ARG:0 = %WEAPON%
ELSEIF WEAPON == ""
	WEAPON = %KilledWith:ARG:0%
ENDIF
SIF WEAPON == "Bleeding"
	DeadByBloodLoss:ARG:0 = 1
DeathText:ARG:0 = %HISTORY_DEATH_TEXT(ARG,KilledBy:ARG:0,WEAPON,LOCATION,MODIFIER)%
DeathText:ARG:6 '= @"여기에 %NAME:ARG%이(가) 잠들다 (%YearSTR(DAY_TO_DATE(CharaAge:ARG:2,1)/1000)%-%YearSTR(DAY_TO_DATE(DAY)/1000)%)\n\n"
DeathText:ARG:6 += @"%DeathText:ARG:1%\n"
DeathText:ARG:6 += @"%@"%"Cause",8,LEFT%: %DeathText:ARG:5%",65,LEFT%\n"
DeathText:ARG:6 += @"%@"%"Location",8,LEFT%: %DeathText:ARG:3%",65,LEFT%\n"
DeathText:ARG:6 += @"%@"%"Date",8,LEFT%: %DeathText:ARG:4%",65,LEFT%\n"
CALL Add_Epitapth(1)
DeathText:ARG:6 += @"\n【%SPLIT_G(RESULTS)%】"
;make message
IF ARG == MASTER
	labelMessage '= "사망 (플레이어)"
	labelColor = C_RED
	messageStyle = 8
ELSEIF TALENT:ARG:NonSentient
	labelMessage '= "파괴"
	labelColor = C_ORANGE
ELSEIF IS_MOB(ARG)
	labelMessage '= "죽음 (스침)"
	labelColor = C_ORANGE
ELSEIF SaveIsEZB
	labelMessage '= "죽음 (로그)"
	labelColor = C_ORANGE
	messageStyle = 1
ELSE
	labelMessage '= "죽음"
	labelColor = C_RED
	messageStyle = 0
ENDIF
SELECTCASE messageStyle
	CASE 0
		IF DT_EXIST("TGC_Map")
			CALL TGC_LogAdd(DeathText:ARG:2,labelColor)
			TGC_ImportantMessage = 1
		ELSE
			CALL COLORMESSAGE(@"%labelMessage%: %NAME:ARG%",labelColor,1,1)
			CALL COLORMESSAGE(DeathText:ARG:0,labelColor,1,0)
		ENDIF
	CASE 1
		IF DT_EXIST("TGC_Map")
			CALL TGC_LogAdd(DeathText:ARG:2,labelColor)
		ELSE
			CALL COLORMESSAGE(DeathText:ARG:2,labelColor,1,1)
		ENDIF
	CASE 8
		SETCOLOR C_RED
		CALL PRINT_LETTER(DeathText:ARG:6,,40,1)
		RESETCOLOR
ENDSELECT
;factions
FOR LOCAL,0,MaxFactions
SIF !nFactions
	BREAK
SIF SaveIsEZB
	BREAK
IF FactionRank:ARG:LOCAL
	FactionUnits:LOCAL:(FactionRank:ARG:LOCAL) --
	CALL COLORMESSAGE(@"-1 %FACTION_RANK_STRING(ARG,LOCAL)% (%FactionName(LOCAL)%, 현재 {FactionUnits:LOCAL:(FactionRank:ARG:LOCAL)})",C_RED,1,1)
	IF KilledBy:ARG:0 >= 0 && ARG != KilledBy:ARG:0
		FOR LOCAL:1,0,MaxFactions
		SIF !FactionExist(LOCAL:1)
			CONTINUE
		;PRINTFORML %FactionName(LOCAL:1)%: {FactionRelationComp2(ARG,LOCAL:1,LOCAL:0)}
		IF FactionRelationComp2(ARG,LOCAL:1,LOCAL:0) < -25000 && FactionRank:(KilledBy:ARG:0):(LOCAL:1)
			CALL CHANGE_FACTION_EXP(KilledBy:ARG:0,LOCAL:1,FactionRank:ARG:LOCAL)
		ENDIF
		NEXT
	ENDIF
ENDIF
NEXT
IF !IsPartCrippled(ARG,1) && !FLAG:70 && !CFLAG:ARG:311
	CALL LOUDNESS_CHECK_ALL(CFLAG:ARG:300,ARG,3,@"%CALLNAME:ARG%의 죽음의 비명", "death")
	CALL KOJO_MESSAGE_SEND("EVENT",101,ARG,0,0)
ENDIF
SIF !DT_EXIST("TGC_Map") && ((!TALENT:ARG:Raider && !TALENT:ARG:NonSentient && !SaveIsEZB) || ARG == MASTER)
	FORCEWAIT
IsDead:ARG:0 = 1
CFLAG:ARG:睡眠 = 1
SIF KilledBy:MASTER:0 == MASTER
	TotalKillsByPlayer++
SIF KilledBy:MASTER:0 == MASTER && ARG == MASTER && TGC_CurrentAttacker == MASTER
	CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("suicide")
;piss self on death
SIF Can_Accident(ARG,1,0) || Can_Accident(ARG,2,0)
	TRYCALL OMORASHI_END(ARG,Can_Accident(ARG,1,0),Can_Accident(ARG,2,0))
;obliterated.
SIF BODY_PARTS_HEALTH(ARG, 40) <= -250
	CFLAG:ARG:300 = 1100

