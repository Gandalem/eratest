		PRINTFORML mabconnect: 재연결 중이다.%"." * COUNT%
		TWAIT 150, 1
		REND
		ENDNOSKIP
		PRINTFORMDL mabconnect: 치명적 오류: 시도 후 25회 동안 활성화 호스트에 연결할 수 없음
		PRINTFORMDL 커널 패닉 - 동기화 실패: 시도 후 25회 동안 활성화 호스트에 연결할 수 있음 exitcode=0x00000100
		PRINTFORMDL CPU: 1 PID: 1 Comm: switch_root tainted 6.1.0-MABOURU #1
		PRINTFORMDL 하드웨어 이름: MaBouru 인헤드 유쥬츠 활성화기, BIOS 2022-4-25
		PRINTFORMDL 콜 트레이스:
		PRINTFORMDL ---[끝 커널 패닉 - 동기화 실패: 시도 후 25회 동안 활성화 호스트에 연결할 수 있음 exitcode=0x00000100]---
		FORCEWAIT
	ENDIF
	PRINTFORMDW 모든 것이 하얗게 변한다...
	REDRAW 10
	CALL ANIMATION_BGCOLOR_TRANSITION( 0x000000, 0xFFFFFF, 20, 300, -30, 0x0000 )
	SETCOLOR 0x000000
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDW 응?
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDW
	PRINTFORMDW 당신은 커다란 흰 방에서 눈을 뜬다. 한동안 볼 수 없었다. 너무 눈이 부셨기 때문이다.
	PRINTFORMDW 눈에 엄청난 통증이 느껴져, 마치 평생 처음으로 눈을 사용하는 것 같다.
	PRINTFORMDW 시야에는 아무것도 없다. 오직 당신 바로 위에 드리워진 거대한 무언가의 그림자만이 있을 뿐이다.
	IF SaveIsEZB
		PRINTL
		LOCAL = MIN(MONEY/10,1000000)
		SETCOLOR C_GRAY
		CALL PRINT_GP("W", @"LIFE SIGNS FOR COMBATANT %TOUPPER(NAME:MASTER)% HAVE CEASED.")
		CALL PRINT_GP("W", @"자동 부활은 %金額表示(LOCAL)%을 비용으로 한다.")
		RESETCOLOR
		CALL LOST_MONEY_YEN(LOCAL,2)
		CALL ANIMATION_BGCOLOR_TRANSITION( 0xFFFFFF, 0x000000, 20, 300, -30, 0x0000 )
		REDRAW 0
		RESETBGCOLOR
		RESETCOLOR
		CALL TRIPLEDOT("timed")
		CALL Resurrect(MASTER, 1)
		RETURN
		RESETCOLOR
	ELSEIF PermaDeath <= 0
		IF (AutoReviveCondition(MASTER) || FLAG:POSTAL >= 3)
			CALL SET_KOJO_COLOR(30)
			CALL CodQuotes()
			WAIT
			CALL ANIMATION_BGCOLOR_TRANSITION( 0xFFFFFF, 0x000000, 20, 300, -30, 0x0000 )
			REDRAW 0
			RESETBGCOLOR
			RESETCOLOR
			CALL TRIPLEDOT("timed")
			CALL Resurrect(MASTER, 1)
			RETURN
			RESETCOLOR
		ENDIF
	ENDIF
	SELECTCASE TALENT:MASTER:Religion
		CASE 6
			IF nOmutsu
				LOCALS = diaper
				LOCALS:1 = diapers
				LOCALS:2 = diaper
			ELSE
				LOCALS = panty
				LOCALS:1 = panties
				LOCALS:2 = pair of panties
			ENDIF
			PRINTFORMDW 올려다보니 당신의 머리 위로 %LOCALS:2%가 떠 있다!
			PRINTFORMDW 낮고 우렁찬 목소리가 갑자기 당신의 머릿속에서 들려오기 시작하는데, 그 소리는 익숙하다...
			CALL COLORMESSAGE("인간",0xFF6600,2,1)
			CALL COLORMESSAGE("((너는 나의 영광을 환상소 주민들과 나누기에 잘했다))",0xFF6600,2,1)
			CALL COLORMESSAGE(@"((하지만 너는 나에게 얼마나 많은 %LOCALS:1%를 데려왔느냐, 나의 아이야?))",0xFF6600,2,1)
			PRINTFORMDW 음... {FLAG:獲得パンツ種数}에 대해?
			IF FLAG:獲得パンツ種数 <= 0
				CALL COLORMESSAGE("((...뭐라고? 감히 나를 조롱해?))",0xFF6600,2,1)
				CALL COLORMESSAGE("((...))",0xFF6600,2,1)
				CALL COLORMESSAGE("((실패. 이제 죽어라.))",C_RED,2,1)
				GOTO GameOver
			ENDIF
			CALL COLORMESSAGE("((…용납할 수 없다))",0xFF6600,2,1)
			CALL COLORMESSAGE("(너는 아직 죽을 준비가 되지 않았다)",0xFF6600,2,1)
			CALL COLORMESSAGE("((선택 시작))",0xFF6600,2,1)
			PRINTFORML
			PRINTFORMDW 이번에는, 당신은 오직 %LOCALS:1%로 가득 찬 거대한 들판에 나타났다.
			PRINTFORMDW 마치 그들이 땅 자체에서 자라나는 것만 같다.
			PRINTFORMDW 당신은 수집을 시작한다. 하나 %LOCALS%, 둘 %LOCALS:1%, 셋 %LOCALS:1%...
			PRINTFORMDW ...
			PRINTFORMDW ...
			PRINTFORMDW ...
			PRINTFORMDW {RAND(1000000,2000000)} %LOCALS:1%... {RAND(3000000,5000000)} %LOCALS:1%... {RAND(5000000,10000000)} %LOCALS:1%...
			PRINTFORMDW 얼마나 많이 모아도 더 있다, 수평선에서 수평선까지 펼쳐진 %LOCALS:1%의 들판들이 계속 존재한다.
			PRINTFORMDW 셀 수 없을 때까지 계속하다 보면 어지러움을 느끼기 시작한다...
			CALL ANIMATION_BGCOLOR_TRANSITION( 0xFFFFFF, 0x000000, 20, 300, -30, 0x0000 )
			REDRAW 0
			RESETBGCOLOR
			RESETCOLOR
			CALL TRIPLEDOT("timed")
			CALL Resurrect(MASTER,,1)
			RETURN
		CASEELSE
			IF IsDead:30:0
				GOTO GameOver
			ENDIF
			CALL SET_KOJO_COLOR(30)
			CALL CodQuotes()
			WAIT
			PRINTFORMDW 낮고 우렁찬 목소리가 갑자기 머릿속에서 들리기 시작하며, 그 소리는 익숙하게 들린다...
			PRINTFORMW 「나는 %NAME:30%야 야마산두」
			PRINTFORMDW 공포에 질린 당신은 야마로부터 부드럽지만 단호한 목소리를 듣는다.
			PRINTFORMW 「나는 네가 살아오면서 해온 모든 것을 평가하러 왔어.」
			RESETCOLOR
			PRINTFORMW 평가: %NAME:MASTER%
			LOCALS '= BREAKENG(DeathText:MASTER:0)
			CALL COLORMESSAGE(LOCALS,C_RED,1)
			SETCOLOR C_GREEN
			PRINTFORMW 권리
			PRINTFORML
			RESETCOLOR
			IF ABL:MASTER:戦闘能力 >= 14
				CALL COLORMESSAGE(@"당신은 뛰어난 전투능력을 가졌다",C_GREEN,1,1)
				POINTS += 1500
			ENDIF
			IF ABL:MASTER:教養 >= 14
				CALL COLORMESSAGE(@"당신은 깊은 지식을 가지고 있었다.",C_GREEN,1,1)
				POINTS += 1500
			ENDIF
			IF ABL:MASTER:話術技能 >= 14
				CALL COLORMESSAGE(@"당신은 사람들을 대하는 법을 알고 있었다.",C_GREEN,1,1)
