@GetStateOfCrisis
#DIM TempShowAdd
SIF !nRyona || SaveIsEZB
	RETURN
VARSET StateOfEmergency
VARSET CrisisPoints
VARSET CrisisElapse
IF GETBIT(NASFeature,9)
	PRINTFORML
	SETCOLOR C_RED
	PRINTFORML 근현의 편집증 계산
	RESETCOLOR
	IF CFLAG:MASTER:329
		TempShowAdd = CFLAG:MASTER:329*35000
		PRINTFORML 경고 탈리스만 ({CFLAG:MASTER:329}): +{TempShowAdd}
		CrisisPoints += TempShowAdd
	ENDIF
	FOR LOCAL, 0, CHARANUM
	IF LOCAL == 26 && IsDead:26:0
		StateOfEmergency = 999
		RETURN
	ENDIF
	IF IsDead:LOCAL:0 && KilledBy:LOCAL:0 == MASTER
		CrisisPoints += AddParanoia(LOCAL)
		SIF AddParanoia(LOCAL,1) > 0
			PRINTFORML %NAME:LOCAL%의 죽음: {AddParanoia(LOCAL,1)}
	ELSEIF !IsDead:LOCAL:0
		IF GETBIT(ReputationKnow:LOCAL:0, 0) && DAY < YearLength
			TempShowAdd = MAX(2500 - (2500/(YearLength-DAY)),0)
			CrisisPoints += TempShowAdd
			PRINTFORML  %NAME:LOCAL%은(는) 당신의 TSP를 알고 있다: +{TempShowAdd}
		ENDIF
	ENDIF
	SIF CrisisPoints > PALAMLV:(3+StateOfEmergency)
		StateOfEmergency = LIMIT(StateOfEmergency+1,0,6)
	NEXT
	SIF StateOfEmergency >= 5
		FLAG:POSTAL = 1
	PRINTFORML 위기점: {PALAMLV:(2+StateOfEmergency)}/{CrisisPoints}/{PALAMLV:(3+StateOfEmergency)} (-{CrisisElapse}/일)
	PRINTFORML 이상현의 편집증 수준: {StateOfEmergency}/6
	PRINTFORML 
ELSE
	StateOfEmergency = 0
ENDIF
CALL FactionStatus(MASTER)
IF (nRaids || nFactionWar) && !benchMarkStart
	SIF (DAY > 31 || FLAG:POSTAL > 0) && nRaids
		PRINTFORML 마지막 레이드 이후 경과 일수: {DaysSinceLastRaid}
	IF !FLAG:POSTAL
		SIF DAY <= 31
			PRINTFORML 첫 번째 레이드까지의 유예 기간: {31-DAY}
		SELECTCASE DAY
			CASE 1, 7, 14, 21
				SETCOLOR C_GREEN
				PRINTFORML NAS는 %PeeAndPoo(nRaids,nFactionWar, "raids", "wars")%에 대해 31일의 유예 기간을 갖는다.
				PRINTFORML 이것은 새로운 캐릭터들이 준비되지 않아 레이드 파티들에 의해 사망하는 것을 방지하기 위함이다.
				PRINTFORM 전투 훈련까지 
				CALL PRINT_RANK(UniversalRank("B"),"MAX_6")
				PRINTFORM  {UniversalRank("B")} 
				SETCOLOR C_GREEN
				PRINTFORML  추천된다.
				RESETCOLOR
				FORCEWAIT
			CASE 28
				SETCOLOR C_ORANGE
				PRINTFORML 당신은 31일의 유예 기간이 끝나갈 무렵이다.
				PRINTFORML 다른 것이 없다면 전투 훈련을 우선시해야 한다.
				RESETCOLOR
				FORCEWAIT
			CASE 31
				SETCOLOR C_RED
				PRINTFORML %PeeAndPoo(nRaids,nFactionWar, "raids", "wars")%의 31일 신규 도착 유예 기간이 만료되었다.
				PRINTL
				IF nRaids
					PRINTFORML 당신의 설정에 따라 레이드는 {nRaids} 동안 유예 기간을 가집니다 %PLURALIZER("day",nRaids)%.
					PRINTFORML 이 유예 기간이 지나면 매 시간 레이드가 발생할 낮은 확률이 존재합니다.
					PRINTL
				ENDIF
				IF nFactionWar
					PRINTFORML 이 유예 기간이 지나면 매일 파벌이 전쟁을 선포할 낮은 확률이 있을 것이다.
					PRINTL
				ENDIF
				FORCEWAIT
		ENDSELECT
	ENDIF
ENDIF

