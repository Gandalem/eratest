			ENDIF
			IF TALENT:LOCAL:思慕
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은(는) 당신을 사모하고 있었다.",C_GREEN,1,1)
				POINTS += 5000
			ENDIF
			;PRINTFORML %CALLNAME:LOCAL% lusts for you.
			;PRINTFORMW You accepted %CALLNAME:LOCAL% requests: +500
			IF CFLAG:LOCAL:子供人数 > 0
				CALL COLORMESSAGE(@"당신은 %TOSTR(CFLAG:LOCAL:子供人数)%으로 %CALLNAME:LOCAL%명의 아이를 만들었다.",C_GREEN,1,1)
				POINTS += 15000
			ENDIF
			NEXT
			SETCOLOR C_RED
			PRINTFORMW 잘못들
			PRINTFORML
			RESETCOLOR
			FOR LOCAL,1,CHARANUM-1
			PRINTFORML 관계와: %NAME:LOCAL%
			IF MARK:LOCAL:反発刻印 > 0
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은 증오의 각인 레벨 %TOSTR(MARK:LOCAL:反発刻印)%을 가지고 있다.",C_RED,1,1)
				POINTS = POINTS -(MARK:LOCAL:反発刻印*5000)
			ENDIF
			IF MARK:LOCAL:時姦刻印 > 0
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은(는) 강간 각인 레벨을 %TOSTR(MARK:LOCAL:時姦刻印)% 가지고 있다.",C_RED,1,1)
				POINTS = POINTS -(MARK:LOCAL:時姦刻印*5000)
			ENDIF
			IF MARK:LOCAL:苦痛刻印 > 0
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은 고통 각인 레벨%TOSTR(MARK:LOCAL:苦痛刻印)%을 가지고 있다.",C_RED,1,1)
				POINTS = POINTS -(MARK:LOCAL:苦痛刻印*5000)
			ENDIF
			IF ABL:LOCAL:自慰中毒 > 0
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은 자위 중독 레벨 %TOSTR(ABL:LOCAL:自慰中毒)%을 가지고 있다.",C_RED,1,1)
				POINTS = POINTS -((ABL:LOCAL:自慰中毒)*100)
			ENDIF
			IF ABL:LOCAL:レズ中毒+ABL:LOCAL:ゲイ中毒 > 0
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은(는) 동성애 중독 레벨을 %TOSTR(ABL:LOCAL:レズ中毒+ABL:LOCAL:ゲイ中毒)% 가지고 있다.",C_RED,1,1)
				POINTS = POINTS -((ABL:LOCAL:レズ中毒+ABL:LOCAL:ゲイ中毒)*100)
			ENDIF
			IF ABL:LOCAL:膣射中毒+ABL:LOCAL:肛射中毒 > 0
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은 질내사정중독 Lv.%TOSTR(ABL:LOCAL:膣射中毒+ABL:LOCAL:肛射中毒)%을 가지고 있다.",C_RED,1,1)
				POINTS = POINTS -((ABL:LOCAL:膣射中毒+ABL:LOCAL:肛射中毒)*100)
			ENDIF
			IF ABL:LOCAL:精液中毒 > 0
				CALL COLORMESSAGE(@"%CALLNAME:LOCAL%은 정액중독 레벨 %TOSTR(ABL:LOCAL:精液中毒)%을 가지고 있다.",C_RED,1,1)
				POINTS = POINTS -(ABL:LOCAL:精液中毒*100)
			ENDIF
			;PRINTFORMW %CALLNAME:LOCAL% has Peeing Addiction Lv.%%: -500
			;PRINTFORMW %CALLNAME:LOCAL% has Pooing Addiction Lv.%%: -500
			;PRINTFORMW You declined %CALLNAME:LOCAL% requests: - 500
			;PRINTFORMW You drugged %CALLNAME:LOCAL%
			IF IsDead:LOCAL:0
				IF KilledBy:LOCAL:0 == MASTER
					CALL COLORMESSAGE(@"당신은 %NAME:LOCAL%을(를) 죽였다.",C_RED,1,1)
					POINTS -= 100000
				ELSEIF KilledBy:LOCAL:0 != LOCAL && INRANGE(KilledBy:LOCAL:0,0,CHARANUM-1)
					CALL COLORMESSAGE(@"%NAME:LOCAL%은(는)%NAME:(KilledBy:LOCAL:0)%에 의해 죽었다.",C_RED,1,1)
				ELSE
					CALL COLORMESSAGE(@"%NAME:LOCAL%은(는) 자연적인 원인으로 사망했다.",C_RED,1,1)
				ENDIF
				LOCALS '= DeathText:LOCAL:0
				CALL COLORMESSAGE(LOCALS,C_RED,1)
