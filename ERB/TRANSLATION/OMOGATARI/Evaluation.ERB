			NEXT
			PRINTFORMW 당신의 생명 점수는 %TOSTR(POINTS)%이다...
			PRINTFORM 신중한 고려 끝에, 당신은 ...으로 간주되었다. 
			SELECTCASE POINTS
				CASE IS >= 3000000
					PRINTFORML 신
				CASE IS >= 1000000
					PRINTFORML 신령
				CASE IS >= 500000
					PRINTFORML 천상의
				CASE IS >= 250000
					PRINTFORML 은둔자
				CASE IS >= 100000
					PRINTFORML 아이돌
				CASE IS >= 50000
					PRINTFORML 메이드
				CASE IS >= 25000
					PRINTFORML 선한 사마리아인
					;negative
				CASE IS <= -3000000
					PRINTFORML 신기(死神)
				CASE IS <= -1000000
					PRINTFORML 복수심에 불타는 영혼 
				CASE IS <= -500000
					PRINTFORML 테러리스트
				CASE IS <= -250000
