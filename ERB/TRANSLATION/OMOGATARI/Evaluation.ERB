; evaluation by yamaxandu when you die
@DeathEval(OVERRIDE)
#DIM OVERRIDE
#DIM POINTS
POINTS = 0
IF !DeathDay:MASTER:0 && !OVERRIDE
	CALL NAS_Error_Show(@"@DeathEval CALLED BUT NO REASON WAS GIVEN FOR PLAYER DEATH")
	RETURN
ENDIF

IF DeathDay:MASTER:0 || OVERRIDE == 1

	IF HealthInsuranceLevel >= 2
		IF PermaDeath == 2
			LOCAL = 87
		ELSE
			LOCAL = 88
		ENDIF
		CALL MarketeersRecoverChara(MASTER,LOCAL)
		SIF LOCAL == 88
			RETURN
	ENDIF

	IF HasBionicPart(MASTER,127) || HasBionicPart(MASTER,128) || HasBionicPart(MASTER,129) || HasBionicPart(MASTER,130) || HasBionicPart(MASTER,131)
	NOSKIP ;addition custom code
	REPEAT 25
		CLEARLINE 2
		PRINTFORML mabconnect: Mind link to Enabler disconnected.
		PRINTFORML mabconnect: Reconnecting.%"." * COUNT%
		TWAIT 150, 1
	REND
	ENDNOSKIP
	PRINTFORMDL mabconnect: FATAL: Unable to connect to Enabler Host after 25 attempts
	PRINTFORMDL Kernel panic - not syncing: Unable to connect to Enabler Host after 25 attempts exitcode=0x00000100
	PRINTFORMDL CPU: 1 PID: 1 Comm: switch_root tainted 6.1.0-MABOURU #1
	PRINTFORMDL Hardware Name: MaBouru In-Head Youjutsu Enabler, BIOS 2022-4-25
	PRINTFORMDL Call Trace:
	PRINTFORMDL ---[end Kernel panic - not syncing: Unable to connect to Enabler Host after 25 attempts exitcode=0x00000100]---
	FORCEWAIT
	ENDIF

	PRINTFORMDW Everything goes white...
	REDRAW 10
	CALL ANIMATION_BGCOLOR_TRANSITION( 0x000000, 0xFFFFFF, 20, 300, -30, 0x0000 )
	SETCOLOR 0x000000
	CALL TRIPLEDOT("reverse:timed")
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDW Huh?
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDL
	PRINTFORMDW
	PRINTFORMDW ...You wake up in a big white room. You can't see for a while, it's so blinding.
	PRINTFORMDW It hurts your eyes so much, it feels as though you're using them for the first time in your life.
	PRINTFORMDW There's absolutely nothing in sight, other than a looming shadow of something colossal right above you.
	IF SaveIsEZB
		PRINTL
		LOCAL = MIN(MONEY/10,1000000)
		SETCOLOR C_GRAY
		CALL PRINT_GP("W", @"LIFE SIGNS FOR COMBATANT %TOUPPER(NAME:MASTER)% HAVE CEASED.")
		CALL PRINT_GP("W", @"AUTOMATIC RESURRECTION WILL COST %金額表示(LOCAL)%")
		RESETCOLOR
		CALL LOST_MONEY_YEN(LOCAL,2)
		CALL ANIMATION_BGCOLOR_TRANSITION( 0xFFFFFF, 0x000000, 20, 300, -30, 0x0000 )
		REDRAW 0
		RESETBGCOLOR
		RESETCOLOR
		CALL TRIPLEDOT("timed")
		CALL Resurrect(MASTER, 1)
		RETURN
		RESETCOLOR
	ELSEIF PermaDeath <= 0
		IF (AutoReviveCondition(MASTER) || FLAG:POSTAL >= 3)
			CALL SET_KOJO_COLOR(30)
			CALL CodQuotes()
			WAIT
			CALL ANIMATION_BGCOLOR_TRANSITION( 0xFFFFFF, 0x000000, 20, 300, -30, 0x0000 )
			REDRAW 0
			RESETBGCOLOR
			RESETCOLOR
			CALL TRIPLEDOT("timed")
			CALL Resurrect(MASTER, 1)
			RETURN
			RESETCOLOR
		ENDIF
	ENDIF
	SELECTCASE TALENT:MASTER:Religion
	CASE 6
		IF nOmutsu
		LOCALS = diaper
		LOCALS:1 = diapers
		LOCALS:2 = diaper
		ELSE
		LOCALS = panty
		LOCALS:1 = panties
		LOCALS:2 = pair of panties
		ENDIF
		PRINTFORMDW Looking up, you gaze upon a %LOCALS:2% floating over your head!
		PRINTFORMDW A low, booming voice suddenly starts speaking in your head, sounding familiar...
		CALL COLORMESSAGE("((Human))",0xFF6600,2,1)
		CALL COLORMESSAGE("((Thou hast done well sharing my glory with the denizens of Gensokyo))",0xFF6600,2,1)
		CALL COLORMESSAGE(@"((But how many %LOCALS:1% hast thee brought me, my child?))",0xFF6600,2,1)
		PRINTFORMDW Uhh... About {FLAG:獲得パンツ種数}?
		IF FLAG:獲得パンツ種数 <= 0 
			CALL COLORMESSAGE("((...What? Thou dare mock me?))",0xFF6600,2,1)
			CALL COLORMESSAGE("((...))",0xFF6600,2,1)
			CALL COLORMESSAGE("((Failure. Perish, now.))",C_RED,2,1)
			GOTO GameOver
		ENDIF
		CALL COLORMESSAGE("((...Unacceptable))",0xFF6600,2,1)
		CALL COLORMESSAGE("((Thou art not ready for death just yet))",0xFF6600,2,1)
		CALL COLORMESSAGE("((Start picking))",0xFF6600,2,1)
		PRINTFORML
		PRINTFORMDW This time, you appear on a giant field, filled with nothing but %LOCALS:1%.
		PRINTFORMDW It almost feels like they grow from the soil itself.
		PRINTFORMDW You start collecting. One %LOCALS%, two %LOCALS:1%, three %LOCALS:1%...
		PRINTFORMDW ...
		PRINTFORMDW ...
		PRINTFORMDW ...
		PRINTFORMDW {RAND(1000000,2000000)} %LOCALS:1%... {RAND(3000000,5000000)} %LOCALS:1%... {RAND(5000000,10000000)} %LOCALS:1%...
		PRINTFORMDW No matter how many you collect, there's still more, with fields and fields of %LOCALS:1% stretched from horizon to horizon.
		PRINTFORMDW You keep at it until you lose count, and then you start feeling dizzy...
		CALL ANIMATION_BGCOLOR_TRANSITION( 0xFFFFFF, 0x000000, 20, 300, -30, 0x0000 )
		REDRAW 0
		RESETBGCOLOR
		RESETCOLOR
		CALL TRIPLEDOT("timed")
		CALL Resurrect(MASTER,,1)
		RETURN
	CASEELSE
		IF IsDead:30:0
			GOTO GameOver
		ENDIF

		CALL SET_KOJO_COLOR(30)
		CALL CodQuotes()
		WAIT

		PRINTFORMDW A low, booming voice suddenly starts speaking in your head, sounding familiar...
		PRINTFORMW 「I'm %NAME:30%: Yamaxandu」
		PRINTFORMDW In your panic, you hear a soft but assertive voice from the yama.
		PRINTFORMW 「I'm here to evaluate everything that you've have done in your life.」
		RESETCOLOR
		PRINTFORMW Evaluation: %NAME:MASTER%
		LOCALS '= BREAKENG(DeathText:MASTER:0)
		CALL COLORMESSAGE(LOCALS,C_RED,1)

		SETCOLOR C_GREEN
		PRINTFORMW Rights
		PRINTFORML
		RESETCOLOR
		IF ABL:MASTER:戦闘能力 >= 14
			CALL COLORMESSAGE(@"You had excellent combat ability",C_GREEN,1,1)
			POINTS += 1500
		ENDIF
		IF ABL:MASTER:教養 >= 14
			CALL COLORMESSAGE(@"You had deep knowledge",C_GREEN,1,1)
			POINTS += 1500
		ENDIF
		IF ABL:MASTER:話術技能 >= 14
			CALL COLORMESSAGE(@"You knew your way around people.",C_GREEN,1,1)
			POINTS += 1500
		ENDIF
		IF MAXBASE:MASTER:TSP >= 4000
			CALL COLORMESSAGE(@"%PARSE("Your")% control over %PARSE("your",1)% time stop ability had reached its pinnacle!",C_GREEN,1,1)
			POINTS += 1500
		ENDIF
		;PRINTFORMW You have good grips on your %%
		FOR LOCAL,1,CHARANUM-1
		PRINTFORML Relationship with: %NAME:LOCAL%
		PRINTFORML %CALLNAME:LOCAL% has %TOSTR(CFLAG:LOCAL:2)% favorability.
		POINTS += CFLAG:LOCAL:2
		IF ABL:LOCAL:親密 > 0
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% has Intinmacy Lv.%TOSTR(ABL:LOCAL:親密)%",C_GREEN,1,1)
			POINTS = POINTS +(ABL:LOCAL:親密*100)
		ENDIF
		IF ABL:LOCAL:欲望 > 0
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% has Desire Lv.%TOSTR(ABL:LOCAL:欲望)%",C_GREEN,1,1)
			POINTS = POINTS +(ABL:LOCAL:欲望*100)
		ENDIF
		IF MARK:LOCAL:快楽刻印 > 0
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% has Pleasure Mark Lv.%TOSTR(MARK:LOCAL:快楽刻印)%",C_RED,1,1)
			POINTS = POINTS +(MARK:LOCAL:快楽刻印*5000)
		ENDIF
		IF MARK:LOCAL:不埒刻印 > 0
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% has Lewd Mark Lv.%TOSTR(MARK:LOCAL:不埒刻印)%",C_RED,1,1)
			POINTS = POINTS +(MARK:LOCAL:不埒刻印*5000)
		ENDIF
		IF TALENT:LOCAL:恋慕
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% was in love with you.",C_GREEN,1,1)
			POINTS += 10000
		ENDIF
		IF TALENT:LOCAL:思慕
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% was yearning for you.",C_GREEN,1,1)
			POINTS += 5000
		ENDIF
		;PRINTFORML %CALLNAME:LOCAL% lusts for you.
		;PRINTFORMW You accepted %CALLNAME:LOCAL% requests: +500
		IF CFLAG:LOCAL:子供人数 > 0
			CALL COLORMESSAGE(@"You made %TOSTR(CFLAG:LOCAL:子供人数)% children with %CALLNAME:LOCAL%",C_GREEN,1,1)
			POINTS += 15000
		ENDIF 
		NEXT

		SETCOLOR C_RED
		PRINTFORMW Wrongs
		PRINTFORML
		RESETCOLOR
		FOR LOCAL,1,CHARANUM-1
		PRINTFORML Relationship with: %NAME:LOCAL%
		IF MARK:LOCAL:反発刻印 > 0
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% has Hate Mark Lv.%TOSTR(MARK:LOCAL:反発刻印)%",C_RED,1,1)
			POINTS = POINTS -(MARK:LOCAL:反発刻印*5000)
		ENDIF
		IF MARK:LOCAL:時姦刻印 > 0
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% has Rape Mark Lv.%TOSTR(MARK:LOCAL:時姦刻印)%",C_RED,1,1)
			POINTS = POINTS -(MARK:LOCAL:時姦刻印*5000)
		ENDIF
		IF MARK:LOCAL:苦痛刻印 > 0
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% has Pain Mark Lv.%TOSTR(MARK:LOCAL:苦痛刻印)%",C_RED,1,1)
			POINTS = POINTS -(MARK:LOCAL:苦痛刻印*5000)
		ENDIF
		IF ABL:LOCAL:自慰中毒 > 0
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% has Masturbation Addiction Lv.%TOSTR(ABL:LOCAL:自慰中毒)%",C_RED,1,1)
			POINTS = POINTS -((ABL:LOCAL:自慰中毒)*100)
		ENDIF
		IF ABL:LOCAL:レズ中毒+ABL:LOCAL:ゲイ中毒 > 0
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% has Homosexuality Addiction Lv.%TOSTR(ABL:LOCAL:レズ中毒+ABL:LOCAL:ゲイ中毒)%",C_RED,1,1)
			POINTS = POINTS -((ABL:LOCAL:レズ中毒+ABL:LOCAL:ゲイ中毒)*100)
		ENDIF
		IF ABL:LOCAL:膣射中毒+ABL:LOCAL:肛射中毒 > 0
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% has Creampie Addiction Lv.%TOSTR(ABL:LOCAL:膣射中毒+ABL:LOCAL:肛射中毒)%",C_RED,1,1)
			POINTS = POINTS -((ABL:LOCAL:膣射中毒+ABL:LOCAL:肛射中毒)*100)
		ENDIF 
		IF ABL:LOCAL:精液中毒 > 0
			CALL COLORMESSAGE(@"%CALLNAME:LOCAL% has Semen Addiction Lv.%TOSTR(ABL:LOCAL:精液中毒)%",C_RED,1,1)
			POINTS = POINTS -(ABL:LOCAL:精液中毒*100)
		ENDIF 
		;PRINTFORMW %CALLNAME:LOCAL% has Peeing Addiction Lv.%%: -500
		;PRINTFORMW %CALLNAME:LOCAL% has Pooing Addiction Lv.%%: -500
		;PRINTFORMW You declined %CALLNAME:LOCAL% requests: - 500
		;PRINTFORMW You drugged %CALLNAME:LOCAL%
		IF IsDead:LOCAL:0
			IF KilledBy:LOCAL:0 == MASTER
			CALL COLORMESSAGE(@"You killed %NAME:LOCAL%.",C_RED,1,1)
			POINTS -= 100000
			ELSEIF KilledBy:LOCAL:0 != LOCAL && INRANGE(KilledBy:LOCAL:0,0,CHARANUM-1)
			CALL COLORMESSAGE(@"%NAME:LOCAL% was killed by %NAME:(KilledBy:LOCAL:0)%.",C_RED,1,1)
			ELSE
			CALL COLORMESSAGE(@"%NAME:LOCAL% died of a natural cause.",C_RED,1,1)
			ENDIF
			LOCALS '= DeathText:LOCAL:0
			CALL COLORMESSAGE(LOCALS,C_RED,1)		
		ENDIF	
		NEXT

		PRINTFORMW Your life score is %TOSTR(POINTS)%...
		PRINTFORM After careful consideration, you have been considered a.... 
		SELECTCASE POINTS
		CASE IS >= 3000000
		PRINTFORML God
		CASE IS >= 1000000
		PRINTFORML Divine Spirit
		CASE IS >= 500000
		PRINTFORML Celestial
		CASE IS >= 250000
		PRINTFORML Hermit
		CASE IS >= 100000
		PRINTFORML Idol
		CASE IS >= 50000
		PRINTFORML Maid
		CASE IS >= 25000
		PRINTFORML Good Samaritan
		;negative
		CASE IS <= -3000000
		PRINTFORML Shinigami
		CASE IS <= -1000000
		PRINTFORML Vengeful Spirit 
		CASE IS <= -500000
		PRINTFORML Terrorist
		CASE IS <= -250000
		PRINTFORML Extremist
		CASE IS <= -100000
		PRINTFORML Felon
		CASE IS <= -50000
		PRINTFORML Molester
		CASE IS <= -25000
		PRINTFORML Petty Criminal
		CASEELSE
		PRINTFORML Non-Playable Character
		ENDSELECT
		PRINTFORML

		IF POINTS >= 250000 || POINTS <= -250000
		PRINTFORMW You've earned enough points to Resurrect 
		LOCAL:1 = 1
		ENDIF
		IF POINTS >= 100000
		PRINTFORMW You've earned enough points to Bite the Dust
		PRINTFORMW You've been sent to heaven...
		LOCAL:2 = 1
		LOCAL:3 = 0
		ELSEIF POINTS <= -100000
		PRINTFORMW You've earned enough points to Bite the Dust
		PRINTFORMW You've been sent to hell...
		LOCAL:2 = 1
		LOCAL:3 = 1
		ELSE
		PRINTFORMW You landed in the netherworld...
		LOCAL:3 = 2
		ENDIF

		IF PermaDeath >= 2
			GOTO GameOver
		ENDIF

		$YourFate
		SIF LOCAL:1
			PRINTFORML [  0] - Resurrect here
		SIF LOCAL:2
			PRINTFORML [  1] - Bite the Dust
		PRINTFORML [  2] - Resurrect as a ghost in %TOSTR(LOCAL:3)%
		PRINTFORML [  3] - Transfer consciousness to another character.
		PRINTFORML [999] - Quit life...
		INPUT
		SELECTCASE RESULT
		CASE 0
			CALL ANIMATION_BGCOLOR_TRANSITION( 0xFFFFFF, 0x000000, 20, 300, -30, 0x0000 )
			REDRAW 0
			RESETBGCOLOR
			RESETCOLOR
			CALL TRIPLEDOT("timed")
			PRINTFORMW Well that was.. weird...
			CALL Resurrect(MASTER,,1)
			RETURN
		CASE 1
			PRINTFORML Reverse time back to the first day?
			PRINTL 
			PRINTL [0] Don't press the「Switch」——— !!!
			PRINTL [1] No, this is the limit! I'm pushing it... NOW!
			INPUT
			IF RESULT == 1
				CALL Resurrect(MASTER)
				CALL ANIMATION_BGCOLOR_TRANSITION( 0xFFFFFF, 0x000000, 20, 300, -30, 0x0000 )
				REDRAW 0
				RESETBGCOLOR
				RESETCOLOR
				CALL TRIPLEDOT("timed")
				RETURN		
				CALL 強くてニューゲーム
			ELSE
				GOTO YourFate
			ENDIF
		CASE 2
			CALL SET_KOJO_COLOR(30)
			PRINTL
			IF POINTS >= 1000000
			TALENT:MASTER:神霊 = 2
			PRINTFORML 「As the benevolent demigod that you are, I've decided to resurrect you as a divine spirit.」
			PRINTFORMW 「...A real god amongst ourselves.」
			PRINTFORML 
			$GodExplanation
			PRINTFORMW 「There's no other equivalent I can pay you back other than direct resurrection, but you seem to have embraced post-mortem godhood.」
			PRINTFORMW 「You'll be fertile as ever, you'll be powerful as ever, nothing but other gods, shrine maidens, and anti-tank weaponry can stop you.」
			PRINTFORMW 「And if you DO die, you can just resurrect yourself.」
			ELSEIF POINTS <= -1000000
			PRINTFORML 「Due to your... sheer malevolence... I have no other choice but to resurrect you as a Shinigami.」
			PRINTFORMW 「...A god of death.」
			PRINTFORML 
			PRINTFORMW 「You are truly an infamous spirit, clearly having killed many during your time alive.」
			TALENT:MASTER:神霊 = 2
			GOTO GodExplanation
			ELSE
			PRINTFORML 「I'll give you a second lease in life, but at a significant cost.」
			PRINTFORMW 「You'll be resurrected as a poltergeist, meaning you will be infertile.」
			PRINTL
			PRINTFORMW 「You won't age, you won't need food, you won't excrete, but at what cost...」
			PRINTFORMW 「Well... When Gensokyo dies, you die as well.」 
			TALENT:MASTER:幽霊 = 3
			;no excretions
			PeeHold:MASTER:0 = 6
			PooHold:MASTER:0 = 6
			ENDIF
			CALL ANIMATION_BGCOLOR_TRANSITION( 0xFFFFFF, 0x000000, 20, 300, -30, 0x0000 )
			REDRAW 0
			RESETBGCOLOR
			RESETCOLOR
			CALL TRIPLEDOT("timed")
			CALL Resurrect(MASTER,,1)
			RETURN
			CALL Resurrect(MASTER)
		CASE 3
			CALL IdentityCrsis()
			IF RESULT
				CALL ANIMATION_BGCOLOR_TRANSITION( 0xFFFFFF, 0x000000, 20, 300, -30, 0x0000 )
				REDRAW 0
				RESETBGCOLOR
				RESETCOLOR
				CALL TRIPLEDOT("timed")		
				RETURN
			ELSE
			GOTO YourFate
			ENDIF
		CASEELSE
			$GameOver
			CALL DeathCertificate(MASTER)
			PRINTFORMW May you rest in peace........ （Game Over）
			DO
			INPUT
			LOOP 1
		ENDSELECT
	ENDSELECT
ENDIF

@ONGOING_FULL(ARG, ARG:1 = 0)
#FUNCTIONS
IF (TEQUIP:乳首吸い && !GROUPMATCH(SELECTCOM,7,11,21,22)) || (TEQUIP:胸揉み && !GROUPMATCH(SELECTCOM,12,21,22))
	;This is the default, but, using ONGOING() you can instead have ", while" or " and " etc.
