@CalculateHideChance(ARG)
#FUNCTION
#DIM HideChance
VARSET HideChance, 1
HideChance = 1+ABS(CFLAG:ARG:出禁)
SIF EQUIP:ARG:その他３ == 60
	HideChance += 10
SIF ROOMDATA:(CFLAG:MASTER:現在位置 % 100) & Is_Graveyard && EQUIP:ARG:その他３ == 60
	HideChance = PALAMLV:15
RETURNF HideChance

@TPToGraveyard(ARG)
#FUNCTION
SIF !IsDead:ARG:0
	RETURNF
SELECTCASE ARG
	CASE 0
		IF nStartingBackstory == 32
			SELECTCASE nBackstoryChoices:1
				CASE 0
					RETURNF 59
				CASEELSE
					RETURNF nBackstoryChoices:1
			ENDSELECT
		ENDIF
	CASE 153, 12, 15, 16, 17, 50, 109, 155, 166, 164
		RETURNF 1158
	CASE 39, 85 TO 92, 167
		RETURNF P121墓地
	CASE 162
		RETURNF P349LaylaGrave
	CASEELSE
		RETURNF P59Graveyard
ENDSELECT

@IS_GRAVEYARD(ARG)
#FUNCTION
;temple
SIF ARG == GET_MAP_REPLACEMENT(858)
	RETURNF 1
;myouren cemetarty
SIF ARG == GET_MAP_REPLACEMENT(121)
	RETURNF 1
;layla's grave
SIF ARG == GET_MAP_REPLACEMENT(349)
	RETURNF 1
;hakurei graveyard
SIF ARG == GET_MAP_REPLACEMENT(59)
	RETURNF 1
SIF ROOMDATA:(ARG % 100) & Is_Graveyard
	RETURNF 1
RETURNF 0

@IS_MORGUE(ARG)
#FUNCTION
;hakurei morgue
SIF ARG == GET_MAP_REPLACEMENT(60)
	RETURNF 1
;einitei basement
SIF ARG == GET_MAP_REPLACEMENT(430)
	RETURNF 1
;GC medical center
SIF ARG == GET_MAP_REPLACEMENT(1159)
	RETURNF 1
SIF ROOMDATA:(ARG % 100) & Is_Morgue
	RETURNF 1

@TPToMorgue(ARG)
#FUNCTION
SIF !IsDead:ARG:0
	RETURNF
IF MAIN_MAP != 4
	RETURNF 480
ELSE
	RETURNF 430
ENDIF
RETURNF 0

@BeforeTrainDeathThings()
FOR LOCAL, 0, CHARANUM
IF IsDead:LOCAL:0 && (DAY-KnowsDeadBodies:29:LOCAL <= 1 || DAY == 1) && KnowsDeadBodies:29:LOCAL
	FOR LOCAL:1, 0, CHARANUM
	CALL FIND_DEATH(LOCAL:1,LOCAL)
	NEXT
	IF HasGrave:(LOCAL):0
		CFLAG:LOCAL:現在位置 = TPToGraveyard(LOCAL)
		HasGrave:(LOCAL):0 = TPToGraveyard(LOCAL)
		CALL CTRL_CLOTHES_SET(LOCAL, "現在衣装の変更_衣装セット", 80)
		EQUIP:LOCAL:その他３ = 60
		tempHediffCount = DT_SELECT("Hediff", @"chara = {LOCAL}",,tempHediffList)
		FOR LOCAL:3,0,tempHediffCount
		DT_CELL_SET @"Hediff", tempHediffList:(LOCAL:3), "bleeding", 0, 1
		DT_CELL_SET @"Hediff", tempHediffList:(LOCAL:3), "tended", 100, tempHediffList:1
		NEXT
	ELSEIF LOCAL == NewDead
	ELSE
		CFLAG:LOCAL:現在位置 = TPToMorgue(LOCAL)
	ENDIF
ENDIF
NEXT

