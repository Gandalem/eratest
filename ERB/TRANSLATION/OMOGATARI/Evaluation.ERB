			LINE_BREAK ++
			SIF LINE_BREAK % (PRINTCPERLINE() - 1) == 0
				PRINTL 
		ENDIF
		RESETCOLOR
	NEXT
	SIF LINE_BREAK % (PRINTCPERLINE() - 1) != 0
		PRINTL 
