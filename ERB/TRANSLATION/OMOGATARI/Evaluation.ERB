				IF !RESULT
					PRINTFORMW Use which weapon to defend yourself?
					FOR LOCAL,0,920
						IF GROUPMATCH(LOCAL,1,26,28,36,150)
						SIF !ITEM:(LOCAL)
							CONTINUE
						PRINTFORML [{LOCAL}] - %ITEMNAME_TR(LOCAL)% 
						ENDIF
					NEXT
					FOR LOCAL,920, 953
						SIF !ITEM:(LOCAL)
							CONTINUE
						PRINTFORML [{LOCAL}] - %ITEMNAME_TR(LOCAL)% 
					NEXT
					PRINTFORML [998] - Danmaku
					INPUT
					SELECTCASE RESULT
						SIF FLAG:223
							FLAG:223 = !FLAG:223
						CASEELSE
						;LOCAL:1 = ArmUp(TARGET)    
						TRYCALL KNIFE_FIGHT(MASTER,TARGET,RESULT,LOCAL:1)
					ENDSELECT

					IF CFLAG:39:衰弱
						RETURN
					ENDIF
				ENDIF
				[SKIPEND]

				IF !RAND:(CalculateHideChance(LOCAL))
				PRINTFORMW %CALLNAME:39% uses %HIS_HER(39)% dowsing rod and finds %CALLNAME:LOCAL%'s body in %NAME_FROM_PLACE(CFLAG:LOCAL:現在位置)%!
				FOR LOCAL:1, 0, CHARANUM
					SIF RELATION:(LOCAL:1):LOCAL <= 100
						CONTINUE
					CALL FIND_DEATH(LOCAL:1,LOCAL,1)
				NEXT

				CALL FIND_DEATH(39,LOCAL,1)
				CALL FIND_DEATH(29,LOCAL,1)
				CFLAG:LOCAL:出禁 = 0
				ELSE
				PRINTFORMW They could find nothing...
				ENDIF
				DetectiveUsed:0 = 1
			ENDIF
		ENDIF 
	NEXT
