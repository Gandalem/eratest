; Modular ERB: OMOGATARI/Evaluation.ERB
; evaluation by yamaxandu when you die

@DeathEval(OVERRIDE)
#DIM OVERRIDE
#DIM POINTS
POINTS = 0
IF !DeathDay:MASTER:0 && !OVERRIDE
