@DeathCertificate(ARG)
#DIMS deathType
#DIMS deathCause
#DIMS deathNotes, 3
#DIMS deathInterval
#DIMS deathPartList
#DIM deathHediffCount
#DIM woundList, 1000
deathType '= "homicide" ;assumed homicide unless proven otherwise.
RESETBGCOLOR
CALL PRINT_GP("L", @"Ogiso's Register",)
CALL PRINT_GP("L", @"Certificate of Death",)
CALL PRINT_GP("W", @"ID: RJGS-%REPLACE(PRINT_DATE_F(DAY,2),".","")%%TOSTR(ARG,"0000")%",)
PRINTL
PRINTFORML # DESCEDENT 
PRINTFORML ## 1. Decedent's Legal Name (First, Middle, Last, Suffix)
PRINTFORML %NAME:ARG%
PRINTFORML ## 2. Sex
PRINTFORML %TOSTR_GENDER(TALENT:ARG:2)%

PRINTFORML 3. Date of Death (Month/Day/Year)
PRINTFORML %PRINT_DATE_F(DAY,1)%

PRINTFORML ## 4. ID
PRINTFORML {ARG}
PRINTL ## 5. Age
PRINTFORML     3A (years): {CharaAge:ARG:1}
PRINTFORML     3B (Under 1 Year, days):
PRINTFORML ## 6. Birthplace (PISS Code, remove )
IF TALENT:ARG:190 == 6
	PRINTFORML UNKNOWN
ELSEIF TALENT:ARG:190 == 5
	PRINTFORML MKAI-CITY
ELSEIF TALENT:ARG:190 == 4
	PRINTFORML ERTH-ELUC
ELSE
	PRINTFORML ERTH-RJGS
ENDIF
			;Outsider: UNKNOWN
PRINTFORML ## 7. (RJGS ONLY) Decedent of Outsider Origin
IF TALENT:ARG:190 == 6
	PRINTFORML YES
ELSE
	PRINTFORML NO
ENDIF
PRINTFORML ## 8. Decedent's Race
;Human and not Were-Hakutaku
IF TALENT:ARG:人間 && !TALENT:ARG:半白澤
	SELECTCASE TALENT:ARG:人間
		;Human = Human
		CASE 1
			PRINTFORML HUMAN
			GOTO Step9
		;Celestial
		CASE 3
			PRINTFORML CELESTRIAL
			GOTO Step9
		CASE 4
			PRINTFORML LUNARIAN
			GOTO Step9
		CASE 5 ;Makai Resident = youkai
			PRINTFORML YOUKAI
			GOTO Step9
		;Hermits and Outsiders can be humans, youkai, or neither so we keep checking
	ENDSELECT
ENDIF

;hack to ensure Narumi is treated as a youkai
;Jizo and Magician = youkai
IF TALENT:ARG:人形 == 3 && TALENT:ARG:追加種族 == 2
	PRINTFORML YOUKAI
	GOTO Step9
ELSEIF TALENT:ARG:妖怪 == 14
;NAS custom code: genji
	PRINTFORML TURTLE
	GOTO Step9
;Doll
ELSEIF TALENT:ARG:人形
	PRINTFORML DOLL
	GOTO Step9
;Jiang-Shi
ELSEIF TALENT:ARG:人形 == 5
	PRINTFORML REANIMATED HUMAN
	GOTO Step9
;Ice Fairy, Fairy, Divine Spirit, Phantom, Doll = non-youkai non-human
ELSEIF TALENT:ARG:氷精 || TALENT:ARG:妖精
	PRINTFORML FAIRY
	GOTO Step9
ELSEIF TALENT:ARG:神霊
	PRINTFORML GOD
	GOTO Step9
ELSEIF TALENT:ARG:幽霊
	PRINTFORML GHOST
	GOTO Step9
;Kitsune, Youkai, Youkai, Tsukumogami, Were-Hakutaku, Magician, Animal Ears = youkai
ELSEIF TALENT:ARG:狐 || TALENT:ARG:妖狐 || TALENT:ARG:妖怪 || TALENT:ARG:付喪神 || TALENT:ARG:半白澤 || TALENT:ARG:追加種族 == 2 || TALENT:ARG:動物耳 || TALENT:ARG:氷精 == 2
	PRINTFORML YOUKAI
	GOTO Step9
ENDIF
;Anything else is human
PRINTFORML HUMAN

$Step9
PRINTFORML ## 9. Maritial Status at Time of Death
;     - Ex: SINGLE, MARRIED, WIDDOWED, DIVORCED
IF TALENT:ARG:221
	PRINTFORML MARRIED
ELSEIF TALENT:ARG:4
	PRINTFORML ENGAUGED
ELSE
	PRINTFORML SINGLE
ENDIF

PRINTFORML ## 10. Survival Spouse's Name

PRINTL ## 11. Place of Death
;     - Ex: RESIDENCE, INSTITUTION
PRINTFORML {CFLAG:ARG:300} %THE_CASE_SHIFT(NAME_FROM_PLACE(CFLAG:ARG:300))%

PRINTL ## 12. Location
;     - Ex: 534 Home, Bamboo Forest
PRINTFORML %GET_MAPNAME(GET_MAPID(CFLAG:ARG:300))%

PRINTL ## 13. PISS Area Code
;     - Ex: RJGS  
SELECTCASE GET_MAPID(CFLAG:ARG:300)
CASE 11
	PRINTFORML MKAI-CITY
CASE 10
	PRINTFORML ERTH-ELUC
CASEELSE
	PRINTFORML ERTH-RJGS
ENDSELECT
PRINTL
PRINTFORML # Certifier

PRINTL ## 14. Certifier (check one)
PRINTFORML ☒ Certifying Physician: To the best of my knowledge, death occurred at the time, date, and place, and due to the cause(s) and manner stated
PRINTFORML ☐ Cornorer: On basis of examination and/or investigation, in my opinion, death occurred at the time, date, and place, and due to the cause(s) and manner stated

PRINTL ## 15. Time of Death
;     - EX: 12:31 PRONOUNCED
PRINTFORMSL 時刻表示(TIME)+" PRONOUNCED"

PRINTL ## 16. Date Pronounced Dead
;     - EX: Aprimay 6, 2023
PRINTFORMSL PRINT_DATE_F(DAY,1)

PRINTFORML ## 18. Certifier Name, Title, and Address of Person who Completed Cause of Death
PRINTFORML Yagokoro, Eirin, MD, 531 Einitei, Gensokyo, Japan, ERTH-RJGS

PRINTFORML # CAUSE OF DEATH
PRINTFORML Enter the disease, injuries, or complications that caused the death. Do not enter the mode of dying, such as cardiac or respiratory arrest, shock, or heart faiure. List only one cause on each line.
PRINTFORML ## 19.
PRINTFORML a. Immediate Cause (final disease or conditions resulting in death)
PRINTFORM		- 
SELECTCASE KilledWith:ARG:0
CASE "OD"
	deathCause '= "DRUG OVERDOSE"
CASE "BirthFail"
	deathCause '= "BIRTH COMPLICATIONS"
CASE "BigPain"
	PRINTFORM TEMINAL PAIN SHOCK
	deathType '= "accident"
CASE "BigSegs"
	PRINTFORM OVEREXERTION
	deathType '= "accident"
CASE "SmiteGod"
	PRINTFORM ELECTROCUTION
CASE "Chupacabra"
	PRINTFORM MULTIPLE BITE WOUNDS
CASE "DieForMe", "Shimachau", "Cheat"
	PRINTFORM BRAIN FAILURE
	deathType '= "natural"
CASE "Pitfall"
	PRINTFORM NECK FRACTURE
	;FALLING
	deathType '= "accident"
CASE "tornado"
	PRINTFORM ORGAN RUPTURE, HEMORRAGE
	;FRACTURES
	;STRUCK BY DEBRIS AND FLUNG BY TORNADO
	;MOD_PRE = has been minced to pieces by a tornado
CASE "fallen tree"
	PRINTFORM BLUNT-FORCE TRAUMA
	;STRUCK BY FALLING TREE
	;MOD_PRE = has been been obliterated by a fallen tree
CASE "debris"
	PRINTFORM BLUNT-FORCE TRAUMA
	;STRUCK BY DEBRIS IN NATURAL DISASTER
	;MOD_PRE = became a victim of a natural disaster
CASE "MarisaSuicide"
	PRINTFORM EXPLOSION
	deathType '= "suicide"
CASE "Surgery"
	;HEART FAILURE
	PRINTFORM FAILED FIELD SURGERY
	deathType '= "accident"
CASE "asphyxiation"
	PRINTFORM ASPHYXIATION
CASEELSE
	deathHediffCount = DT_SELECT("Hediff", @"chara = {ARG} and type = {LastHediff:ARG % 100}", "severity DESC", woundList)
	IF deathHediffCount != 0
		FOR LOCAL, 0, deathHediffCount && !GROUPMATCH(LastHediff:ARG % 100,7,34,38)
			LOCALS '= @"%TOUPPER(BDY_PART_NAME(DT_CELL_GET(@"Hediff", woundList:LOCAL, "part", 1)))%、"
			IF STRFIND(deathPartList,LOCALS) == -1
				deathPartList += LOCALS
				IF STRCOUNT(deathPartList,"、") >= 5
					deathPartList += "ETC."
					BREAK
				ENDIF
			ENDIF
		NEXT
	ENDIF
	SELECTCASE LastHediff:ARG % 100
		CASE 1
			IF deathHediffCount > 3
				deathCause '= "MULTIPLE GUNSHOT WOUNDS"
			ELSE
				deathCause '= "GUNSHOT WOUND"
			ENDIF
			;GUNSHOT WOUND ON HEAD
			deathInterval '= "SECOND(S)"
		CASE 2 
			IF deathHediffCount > 3
				deathCause '= "MULTIPLE STAB WOUNDS"
			ELSE
				deathCause '= "STAB WOUND"
			ENDIF
			;GUNSHOT WOUND ON HEAD
			deathInterval '= "SECOND(S)"
		CASE 3, 4
			PRINTFORM BURN WOUND
		CASE 6
			;MULTIPLE BLUNT-FORCE TRAUMA
			;ON NECK, HEAD, CHEST, CROTCH, LEFT LEG, RIGHT LEG, LEFT ARM, RIGHT ARM, ABDOMEN
			;ON NECK, HEAD, CHEST, CROTCH, LEFT LEG, ETC.
			PRINTFORM BLUNT-FORCE TRAUMA
			deathInterval '= "SECOND(S)"
		CASE 11
			deathType '= "natural"
			PRINTFORM CARCINOMA
			deathInterval '= "WEEK(S)"
		CASE 7
			PRINTFORM ELECTROCUTION
			deathInterval '= "SECOND(S)"
		CASE 8
			PRINTFORM EXTERNAL DECAY
			deathInterval '= "MINUTE(S)"
		CASE 34
			PRINTFORM ASPHYXIATION
			deathInterval '= "MINUTE(S)"
		CASE 35
			PRINTFORM FROSTBITE
			deathInterval '= "DAY(S)"
		CASE 36
			PRINTFORM PSYCHOSIS-INDUDUCED NERVE DAMAGE
			deathInterval '= "SECOND(S)"
		CASE 38
			PRINTFORM EXPLOSION
			deathInterval '= "SECOND(S)"
		CASEELSE
			PRINTFORM %GET_STR(ARG, "Hediff", (LastHediff:ARG % 100), "名前")%
			deathInterval '= "DAY(S)"
		ENDSELECT
ENDSELECT
PRINTFORMS deathCause
SIF STRLENS(deathPartList)
PRINTFORMS " ON "+LIST_IN_STRING(deathPartList,,", ")
PRINTFORML  (%TOUPPER(deathInterval)%)

PRINTFORML Sequentially list conditions, if any, leading to immediate cause

PRINT b.
IF DeadByBloodLoss:ARG:0 == 1
	PRINTL TERMINAL EXTERNAL HEMORRAGE
ELSE
PRINTL
ENDIF
PRINT c.
PRINTL
PRINT d.
PRINTL
;		b. Due to: BLEEDING (MINUTE[S])
;		c. Due to: BLEEDING (MINUTE[S])
;		d. Due to: BLEEDING (MINUTE[S])
PRINTFORML ## 20. Manner of Death (Homicide, Natural, Accident, Suicide, or Pending)
PRINTFORML %TOUPPER(deathType)%

PRINTFORML ## 21. Describe How Injury Occurred
;	EX: Shot by ArmTeck SPA rifle, Struck by bat	
PRINTFORML ACTIVE COMBAT
PRINTL
PRINTFORML This is a true and correct copy of the record as registered in Ogiso's Register.
PRINTFORML Hangh Nguyen - Death Recorder
PRINTFORML %PRINT_DATE_F(DAY,2)%