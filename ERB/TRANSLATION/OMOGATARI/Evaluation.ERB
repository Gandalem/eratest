@DeathCertificate(ARG)
#DIMS deathType
#DIMS deathCause
#DIMS deathNotes, 3
#DIMS deathInterval
#DIMS deathPartList
#DIM deathHediffCount
#DIM woundList, 1000
deathType '= "homicide" ;assumed homicide unless proven otherwise.
RESETBGCOLOR
CALL PRINT_GP("L", @"오기소의 등록서",)
CALL PRINT_GP("L", @"사망진단서",)
CALL PRINT_GP("W", @"ID: RJGS-%REPLACE(PRINT_DATE_F(DAY,2),".","")%%TOSTR(ARG,"0000")%",)
PRINTL
PRINTFORML # DESCEDENT 
PRINTFORML ## 1. 사망자의 법적 성명(이름, 중간 이름, 성, 접미사)
PRINTFORML %NAME:ARG%
PRINTFORML ## 2. 성별
PRINTFORML %TOSTR_GENDER(TALENT:ARG:2)%
PRINTFORML 3. 사망일 (월/일/년)
PRINTFORML %PRINT_DATE_F(DAY,1)%
PRINTFORML ## 4. ID
PRINTFORML {ARG}
PRINTL ## 5. 연령
PRINTFORML     3A (세): {CharaAge:ARG:1}
PRINTFORML     3B (1세 미만, 일):
PRINTFORML ## 6. 출생지 (PISS 코드, 제거)
IF TALENT:ARG:190 == 6
	PRINTFORML UNKNOWN
ELSEIF TALENT:ARG:190 == 5
	PRINTFORML MKAI-CITY
ELSEIF TALENT:ARG:190 == 4
	PRINTFORML ERTH-ELUC
ELSE
	PRINTFORML ERTH-RJGS
ENDIF
;Outsider: UNKNOWN
PRINTFORML ## 7. (RJGS 전용) 외부 출신 사망자
IF TALENT:ARG:190 == 6
	PRINTFORML YES
ELSE
	PRINTFORML NO
ENDIF
PRINTFORML ## 8. 사망자의 인종
;Human and not Were-Hakutaku
IF TALENT:ARG:人間 && !TALENT:ARG:半白澤
	SELECTCASE TALENT:ARG:人間
		;Human = Human
		CASE 1
			PRINTFORML HUMAN
			GOTO Step9
			;Celestial
		CASE 3
			PRINTFORML CELESTRIAL
			GOTO Step9
		CASE 4
			PRINTFORML LUNARIAN
			GOTO Step9
		CASE 5 ;Makai Resident = youkai
			PRINTFORML YOUKAI
			GOTO Step9
			;Hermits and Outsiders can be humans, youkai, or neither so we keep checking
	ENDSELECT
ENDIF
;hack to ensure Narumi is treated as a youkai
;Jizo and Magician = youkai
IF TALENT:ARG:人形 == 3 && TALENT:ARG:追加種族 == 2
	PRINTFORML YOUKAI
	GOTO Step9
ELSEIF TALENT:ARG:妖怪 == 14
	;NAS custom code: genji
	PRINTFORML TURTLE
	GOTO Step9
	;Doll
ELSEIF TALENT:ARG:人形
	PRINTFORML DOLL
	GOTO Step9
	;Jiang-Shi
ELSEIF TALENT:ARG:人形 == 5
	PRINTFORML 소생한 인간
	GOTO Step9
	;Ice Fairy, Fairy, Divine Spirit, Phantom, Doll = non-youkai non-human
ELSEIF TALENT:ARG:氷精 || TALENT:ARG:妖精
	PRINTFORML FAIRY
	GOTO Step9
ELSEIF TALENT:ARG:神霊
	PRINTFORML GOD
	GOTO Step9
ELSEIF TALENT:ARG:幽霊
	PRINTFORML GHOST
	GOTO Step9
	;Kitsune, Youkai, Youkai, Tsukumogami, Were-Hakutaku, Magician, Animal Ears = youkai
ELSEIF TALENT:ARG:狐 || TALENT:ARG:妖狐 || TALENT:ARG:妖怪 || TALENT:ARG:付喪神 || TALENT:ARG:半白澤 || TALENT:ARG:追加種族 == 2 || TALENT:ARG:動物耳 || TALENT:ARG:氷精 == 2
	PRINTFORML YOUKAI
	GOTO Step9
ENDIF
;Anything else is human
PRINTFORML HUMAN
$Step9
PRINTFORML 사망 시 혼인 상태
;     - Ex: SINGLE, MARRIED, WIDDOWED, DIVORCED
IF TALENT:ARG:221
	PRINTFORML MARRIED
ELSEIF TALENT:ARG:4
	PRINTFORML ENGAUGED
ELSE
	PRINTFORML SINGLE
ENDIF
PRINTFORML ## 10. 생존 배우자 이름
PRINTL ## 11. 사망 장소
;     - Ex: RESIDENCE, INSTITUTION
PRINTFORML {CFLAG:ARG:300} %THE_CASE_SHIFT(NAME_FROM_PLACE(CFLAG:ARG:300))%
PRINTL ## 12. 위치
;     - Ex: 534 Home, Bamboo Forest
PRINTFORML %GET_MAPNAME(GET_MAPID(CFLAG:ARG:300))%
PRINTL ## 13. 소변 지역 코드
;     - Ex: RJGS
