@BirthdayAilment(ARG,ShowMessage)
#DIM DYNAMIC nRoll
#DIM DYNAMIC nThreshold
#DIM DYNAMIC ShowMessage
#DIM DYNAMIC nAilment
#DIM DYNAMIC nPart,10
VARSET LOCAL

IF TALENT:ARG:BornChild
	VARSET S
	SELECTCASE CharaAge:ARG:0
	CASE 3, 7, 10, 15
	;toddler
	;child
	;petite
	;normal sized
	TALENT:ARG:100++
	S++
	ENDSELECT
	SIF S && ShowMessage
	PRINTFORML %CALLNAME:ARG% grew and increased in size. %HE_SHE(ARG,1)% is now 【%GET_TALENTNAME_TR(100,TALENT:ARG:100,ARG)%】
ENDIF


FOR nAilment,0, VARSIZE("DamageTypes")
VARSET nPart
nRoll = RAND(0,100000)

	SELECTCASE nAilment
	CASE 11
		$CancerPartGet
		nPart = RAND:100
		SIF !HasBodyPart(ARG,nPart) || BDY_PART_NAME(nPart) == ""
			GOTO CancerPartGet		
		SELECTCASE CharaAge:ARG:0
		CASE IS >= 23
			nThreshold = 150
		CASEELSE
		CONTINUE
		ENDSELECT	
	CASE 16
		nPart = 1
		SELECTCASE CharaAge:ARG:0
		CASE IS >= 120
			nThreshold = 300
		CASE IS >= 80
			nThreshold = 200
		CASE IS >= 56
			nThreshold = 120
		CASE IS >= 34
			nThreshold = 61
		CASEELSE
		CONTINUE
		ENDSELECT
	CASE 17
		nPart:0 = 45
		nPart:1 = 46
		SELECTCASE CharaAge:ARG:0
		CASE IS >= 40
			nThreshold = 1344
		CASE IS >= 24
			nThreshold = 96
		CASEELSE
			nThreshold = 48
		ENDSELECT	
	CASE 18
		nPart = 55
		SELECTCASE CharaAge:ARG:0
		CASE IS >= 80
			nThreshold = 1860
		CASE IS >= 60
			nThreshold = 1395
		CASE IS >= 40
			nThreshold = 930
		CASEELSE
		CONTINUE
		ENDSELECT		
	CASE 19
		nPart:0 = 4
		SELECTCASE CharaAge:ARG:0
		CASE IS >= 70
			nThreshold = 1105
		CASE IS >= 49
			nThreshold = 530
		CASEELSE
			CONTINUE
		ENDSELECT		
	CASE 20
		nPart = 1
		SELECTCASE CharaAge:ARG:0
		CASE IS >= 92
			nThreshold = 9300
		CASE IS >= 85
			nThreshold = 4200			
		CASE IS >= 79
			nThreshold = 930
		CASEELSE
		CONTINUE
		ENDSELECT
	CASE 21
		nPart = 47
		SELECTCASE CharaAge:ARG:0
		CASE IS >= 80
			nThreshold = 170
		CASE IS >= 40
			nThreshold = 145			
		CASE IS >= 21
			nThreshold = 100
		CASEELSE
		CONTINUE
		ENDSELECT
	CASE 22
		nPart = 5
		nPart:1 = 6
		SELECTCASE CharaAge:ARG:0
		CASE IS >= 60
			nThreshold = 1110
		CASE IS >= 49
			nThreshold = 530
		CASEELSE
		CONTINUE
		ENDSELECT		
	CASE 30
		nPart = 74
		SELECTCASE CharaAge:ARG:0
		CASE IS >= 63
			nThreshold = 930
		CASE IS >= 45
			nThreshold = 420		
		CASEELSE
			nThreshold = 230
		ENDSELECT
	CASE 31
		nPart = 53
		SELECTCASE CharaAge:ARG:0
		CASE IS >= 63
			nThreshold = 930
		CASE IS >= 35
			nThreshold = 480
		CASEELSE
			nThreshold = 230
		ENDSELECT	
	ENDSELECT	

	IF nRoll <= nThreshold
		FOR LOCAL,0,10
			SIF !nPart:LOCAL
				CONTINUE
			CALLF DamageBodyPart(ARG,nPart:LOCAL,0,nAilment,ARG,"Natural Aging",1)
			IF ShowMessage
				SETCOLOR C_RED
				SIF !(LOCAL:3++)
					PRINTFORML But %CALLNAME:ARG% got these aliments:
				RESETCOLOR
				PRINTFORML %DamageTypes:nAilment% (%BDY_PART_NAME(nPart:LOCAL)%)
			ENDIF
		NEXT
	ENDIF
NEXT
SIF LOCAL:3
FORCEWAIT


