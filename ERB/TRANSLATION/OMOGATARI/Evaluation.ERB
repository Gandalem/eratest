		IF PermaDeath == 2
			LOCAL = 87
		ELSE
			LOCAL = 88
		ENDIF
		CALL MarketeersRecoverChara(MASTER,LOCAL)
		SIF LOCAL == 88
			RETURN
	ENDIF
	IF HasBionicPart(MASTER,127) || HasBionicPart(MASTER,128) || HasBionicPart(MASTER,129) || HasBionicPart(MASTER,130) || HasBionicPart(MASTER,131)
