@GetStateOfCrisis
#DIM TempShowAdd

SIF !nRyona || SaveIsEZB
	RETURN

VARSET StateOfEmergency
VARSET CrisisPoints
VARSET CrisisElapse
IF GETBIT(NASFeature,9)
	PRINTFORML
	SETCOLOR C_RED
	PRINTFORML Gensokyo Paranoia Calculations
	RESETCOLOR
	IF CFLAG:MASTER:329
		TempShowAdd = CFLAG:MASTER:329*35000
		PRINTFORML Warning Talismans ({CFLAG:MASTER:329}): +{TempShowAdd}
		CrisisPoints += TempShowAdd
	ENDIF

	FOR LOCAL, 0, CHARANUM 
		IF LOCAL == 26 && IsDead:26:0
			StateOfEmergency = 999
			RETURN
		ENDIF

		IF IsDead:LOCAL:0 && KilledBy:LOCAL:0 == MASTER
		CrisisPoints += AddParanoia(LOCAL)
		
		SIF AddParanoia(LOCAL,1) > 0
			PRINTFORML Death of %NAME:LOCAL%: +{AddParanoia(LOCAL,1)}
		ELSEIF !IsDead:LOCAL:0
			IF GETBIT(ReputationKnow:LOCAL:0, 0) && DAY < YearLength
				TempShowAdd = MAX(2500 - (2500/(YearLength-DAY)),0)
				CrisisPoints += TempShowAdd
				PRINTFORML  %NAME:LOCAL% knows your TSP: +{TempShowAdd}
			ENDIF
		ENDIF

		

		SIF CrisisPoints > PALAMLV:(3+StateOfEmergency)
			StateOfEmergency = LIMIT(StateOfEmergency+1,0,6)
	NEXT
	SIF StateOfEmergency >= 5
		FLAG:POSTAL = 1

	PRINTFORML Crisis Points: {PALAMLV:(2+StateOfEmergency)}/{CrisisPoints}/{PALAMLV:(3+StateOfEmergency)} (-{CrisisElapse}/day)
	PRINTFORML Gensokyo's Paranoia Level: {StateOfEmergency}/6
	PRINTFORML 
ELSE
	StateOfEmergency = 0
ENDIF
CALL FactionStatus(MASTER)
IF (nRaids || nFactionWar) && !benchMarkStart
	SIF (DAY > 31 || FLAG:POSTAL > 0) && nRaids
	PRINTFORML Days since last raid: {DaysSinceLastRaid}
	IF !FLAG:POSTAL
		SIF DAY <= 31
			PRINTFORML Grace period until first raid: {31-DAY}
		SELECTCASE DAY
		CASE 1, 7, 14, 21
			SETCOLOR C_GREEN
			PRINTFORML NAS has a 31 day grace period for %PeeAndPoo(nRaids,nFactionWar, "raids", "wars")%.
			PRINTFORML This is to prevent new characters from being killed by raiding parties due to being unprepared.
			PRINTFORM Combat training until 
			CALL PRINT_RANK(UniversalRank("B"),"MAX_6")
			PRINTFORM  {UniversalRank("B")} 
			SETCOLOR C_GREEN
			PRINTFORML  is recommended.
			RESETCOLOR
			FORCEWAIT
		CASE 28
			SETCOLOR C_ORANGE
			PRINTFORML You are nearing the end of the 31 day grace period.
			PRINTFORML Combat training should be prioritized if nothing else.
			RESETCOLOR
			FORCEWAIT
		CASE 31
			SETCOLOR C_RED
			PRINTFORML The 31 day new arrival grace period for %PeeAndPoo(nRaids,nFactionWar, "raids", "wars")% has lapsed
			PRINTL
			IF nRaids
			PRINTFORML With your settings, raids will have a grace period of {nRaids} %PLURALIZER("day",nRaids)%.
			PRINTFORML After this grace period, every hour will have a low chance of a raid happening.
			PRINTL
			ENDIF
			IF nFactionWar
			PRINTFORML After this grace period, every day will have a low chance of a faction declaring war.
			PRINTL
			ENDIF
			FORCEWAIT
		ENDSELECT
	ENDIF
ENDIF

