;for broad damage
@BroadDamage(ARG = -1,ARGS = "thorax",DMG = 0,DMG_TYPE = 1,nDealer=-555,nItem="No Item Given!", nPerm = 0, nCritical = -1)
#FUNCTION
#DIM DMG
#DIM DMG_TYPE
#DIM nDealer
#DIMS nItem
#DIM nPerm
#DIM nCritical
#DIM DMG_MAIN_PART
#DIM DMG_MULTIPLIER

IF nCritical == -1
    IF INRANGE(nDealer,0,CHARANUM-1)
        nCritical = RAND(100) < GetCriticalAccuracy(nDealer)
    ELSE
        nCritical = !RAND(3)
    ENDIF
ENDIF

SELECTCASE ARGS
CASE "head"
    DMG_MAIN_PART = 1
    DMG_MULTIPLIER = 400
CASE "thorax"
    DMG_MAIN_PART = 40
    DMG_MULTIPLIER = 100
CASE "stomach"
    DMG_MAIN_PART = 53
    DMG_MULTIPLIER = 75
CASE "crotch"
    DMG_MAIN_PART = 61
    DMG_MULTIPLIER = 100
CASE "larm"
    DMG_MAIN_PART = 20
    DMG_MULTIPLIER = 33
CASE "rarm"
    DMG_MAIN_PART = 30
    DMG_MULTIPLIER = 33
CASE "lleg"
    DMG_MAIN_PART = 81
    DMG_MULTIPLIER = 33
CASE "rleg"
    DMG_MAIN_PART = 91
    DMG_MULTIPLIER = 33
CASE "arms"
    SELECTCASE RAND:2
    CASE 0
        CALLF BroadDamage(ARG,"larm",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CASE 1
        CALLF BroadDamage(ARG,"rarm",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical) 
    ENDSELECT
    RETURNF
CASE "legs"
    SELECTCASE RAND:2
    CASE 0
        CALLF BroadDamage(ARG,"lleg",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CASE 1
        CALLF BroadDamage(ARG,"rleg",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical) 
    ENDSELECT
    RETURNF
CASE "limb"
    SELECTCASE RAND:4
    CASE 0
        CALLF BroadDamage(ARG,"lleg",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CASE 1
        CALLF BroadDamage(ARG,"rleg",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CASE 2
        CALLF BroadDamage(ARG,"larm",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CASE 3
        CALLF BroadDamage(ARG,"rarm",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    ENDSELECT
    RETURNF
CASE "torso"
    SELECTCASE RAND:3
    CASE 0
        CALLF BroadDamage(ARG,"thorax",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CASE 1
        CALLF BroadDamage(ARG,"stomach",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CASE 2
        CALLF BroadDamage(ARG,"crotch",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    ENDSELECT
    RETURNF
CASE "fullbody"
    CALLF BroadDamage(ARG,"head",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CALLF BroadDamage(ARG,"thorax",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CALLF BroadDamage(ARG,"stomach",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CALLF BroadDamage(ARG,"crotch",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CALLF BroadDamage(ARG,"larm",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CALLF BroadDamage(ARG,"rarm",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CALLF BroadDamage(ARG,"lleg",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    CALLF BroadDamage(ARG,"rleg",DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical)
    RETURNF
ENDSELECT

LOCAL:2 = DMG
DMG = DamageMitigate(ARG,nDealer,DMG,DMG_MAIN_PART)
IF !DMG
    RETURNF
ELSEIF DMG < LOCAL:2/10 && GROUPMATCH(DMG_TYPE,1,2,6)
    DMG_TYPE = 6
ENDIF

SELECTCASE ARGS
CASE "head"
    CALLF DamageBodyPart(ARG,1,DMG,DMG_TYPE,nDealer,nItem, nPerm)
    IF nCritical
        IF !RAND:4
            ;neck
            CALLF DamageBodyPart(ARG,11,DMG,DMG_TYPE,nDealer,nItem, nPerm, 1200)
        ELSE
            ;brain
            IF !RAND:3
                IF !RAND:2
                    CALLF DamageBodyPart(ARG,5,DMG,DMG_TYPE,nDealer,nItem, nPerm)
                ELSE
                    CALLF DamageBodyPart(ARG,6,DMG,DMG_TYPE,nDealer,nItem, nPerm)
                ENDIF
            ENDIF
            CALLF DamageBodyPart(ARG,12,DMG,DMG_TYPE,nDealer,nItem, 1)
        ENDIF
    ELSE
        SELECTCASE RAND:3
            CASE 0
            CALLF DamageBodyPart(ARG,4,DMG,DMG_TYPE,nDealer,nItem, nPerm)
            CASE 1
            CALLF DamageBodyPart(ARG,7,DMG,DMG_TYPE,nDealer,nItem, nPerm)
            CASE 2
            CALLF DamageBodyPart(ARG,8,DMG,DMG_TYPE,nDealer,nItem, nPerm)
        ENDSELECT
        SIF !RAND:6
            CALLF DamageBodyPart(ARG,12,DMG,DMG_TYPE,nDealer,nItem, 1)
    ENDIF
CASE "crotch"
    CALLF DamageBodyPart(ARG,60,DMG,DMG_TYPE,nDealer,nItem, nPerm)
    CALLF DamageBodyPart(ARG,61,DMG,DMG_TYPE,nDealer,nItem, nPerm)
    IF nCritical
        SELECTCASE RAND:3
        CASE 0
            IF HAS_VAGINA(ARG)
                CALLF DamageBodyPart(ARG,62,DMG,DMG_TYPE,nDealer,nItem, nPerm)
                CALLF DamageBodyPart(ARG,63,DMG,DMG_TYPE,nDealer,nItem, nPerm)
                CALLF DamageBodyPart(ARG,64,DMG,DMG_TYPE,nDealer,nItem, nPerm)
            ENDIF
            IF HAS_PENIS(ARG)
                CALLF DamageBodyPart(ARG,68,DMG,DMG_TYPE,nDealer,nItem, nPerm)
                CALLF DamageBodyPart(ARG,69,DMG,DMG_TYPE,nDealer,nItem, nPerm)
                CALLF DamageBodyPart(ARG,70,DMG,DMG_TYPE,nDealer,nItem, nPerm)
                CALLF DamageBodyPart(ARG,71,DMG,DMG_TYPE,nDealer,nItem, nPerm)
            ENDIF
        CASE 1
            CALLF DamageBodyPart(ARG,65,DMG,DMG_TYPE,nDealer,nItem, nPerm)
            CALLF DamageBodyPart(ARG,67,DMG,DMG_TYPE,nDealer,nItem, nPerm)
        CASE 2
            CALLF DamageBodyPart(ARG,72,DMG,DMG_TYPE,nDealer,nItem, nPerm)
            CALLF DamageBodyPart(ARG,74,DMG,DMG_TYPE,nDealer,nItem, nPerm)
        ENDSELECT
    ENDIF
CASE "stomach"
    CALLF DamageBodyPart(ARG,52,DMG,DMG_TYPE,nDealer,nItem, nPerm)
    CALLF DamageBodyPart(ARG,53,DMG,DMG_TYPE,nDealer,nItem, nPerm)

    IF nCritical
        SELECTCASE RAND:3
            CASE 0
            CALLF DamageBodyPart(ARG,75,DMG,DMG_TYPE,nDealer,nItem, nPerm)    
            CASE 1
            CALLF DamageBodyPart(ARG,76,DMG,DMG_TYPE,nDealer,nItem, nPerm)
            CASE 2
            CALLF DamageBodyPart(ARG,77,DMG,DMG_TYPE,nDealer,nItem, nPerm)
        ENDSELECT
    ENDIF
CASE "thorax"
    CALLF DamageBodyPart(ARG,40,DMG,DMG_TYPE,nDealer,nItem, nPerm)

    SELECTCASE RAND:3
    CASE 0
        CALLF DamageBodyPart(ARG,41,DMG,DMG_TYPE,nDealer,nItem, nPerm)
        SIF nCritical
            CALLF DamageBodyPart(ARG,45,DMG,DMG_TYPE,nDealer,nItem, nPerm)
    CASE 1
        CALLF DamageBodyPart(ARG,43,DMG,DMG_TYPE,nDealer,nItem, nPerm)
        SIF nCritical
            CALLF DamageBodyPart(ARG,46,DMG,DMG_TYPE,nDealer,nItem, nPerm)
    CASE 2
        SIF nCritical
        CALLF DamageBodyPart(ARG,47,DMG,DMG_TYPE,nDealer,nItem, nPerm)
    ENDSELECT
CASE "lleg"
    SELECTCASE RAND:3
    CASE 0
        CALLF DamageBodyPart(ARG,81,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
    CASE 1
        CALLF DamageBodyPart(ARG,82,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
    CASE 2
        CALLF DamageBodyPart(ARG,83,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
