;#392167
@HediffName(ARG,nPart,nWound,ShowTend,HTML, stack = 1)
#FUNCTIONS
#DIM nPart
#DIM nWound
#DIM nHediff
#DIM ShowTend
#DIM DYNAMIC stack
#DIM DYNAMIC HTML
#DIM totalHediffCount
#DIM hediffStack, 10


totalHediffCount = DT_SELECT(@"Hediff", @"chara = {ARG} and part = {nPart}", "", tempHediffList)
nHediff = tempHediffList:(nWound)

VARSET hediffStack
hediffStack:0 = 1
hediffStack:1 = DT_CELL_GET(@"Hediff", nHediff, "severity", 1)
hediffStack:2 = DT_CELL_GET(@"Hediff", nHediff, "bleeding", 1)
hediffStack:3 = DT_CELL_GET(@"Hediff", nHediff, "type", 1)
hediffStack:4 = GetHediffStage(ARG,nHediff)
LOCALS =

IF stack
    FOR LOCAL, 0, totalHediffCount
        SIF LOCAL == nWound
            CONTINUE
        IF HediffSameSource(ARG,nPart,nWound,LOCAL)
            hediffStack:0 ++
            hediffStack:1 += DT_CELL_GET(@"Hediff", tempHediffList:LOCAL, "severity", 1)
            hediffStack:2 += DT_CELL_GET(@"Hediff", tempHediffList:LOCAL, "bleeding", 1)
        ENDIF
    NEXT
ENDIF

IF HTML == 8 
    LOCALS += @"<button value='{nHediff}' title='%HTML_Escape(BionicDescription((hediffStack:3)))%'>"
ELSEIF HTML == 2 || HTML == 8 || (HTML == 3 && IsBionicPart(ARG,nPart,nWound) && GET_INT(ARG, "Hediff", (hediffStack:3), "Has Config"))
    LOCALS += @"<button value='{nPart*100000+nWound}' title='%HTML_Escape(BionicDescription((hediffStack:3)))%'>"
ELSEIF HTML
    LOCALS += @"<nonbutton title='%HTML_Escape(BionicDescription((hediffStack:3)))%'>"
ENDIF

;invalid hediff
SIF !hediffStack:3
    RETURNF

;hidden hediff
[IF_NDEBUG]
SIF GET_INT(ARG, "Hediff", hediffStack:3, @"{hediffStack:4}/Hidden")
    RETURNF
[ENDIF]

IF IsBionicPart(ARG,nPart,nWound)
    ;blank hediff names
    SIF !STRLENS(GET_STR(ARG, "Hediff", (hediffStack:3), "名前"))
        RETURNF

    LOCALS += @"%GET_STR(ARG, "Hediff", (hediffStack:3), "名前")%" 
    GOTO BYPASS
ELSEIF IsDrugHediff(ARG,nPart,nWound)
    ;blank hediff names
    SIF !STRLENS(GET_STR(ARG, "Hediff", (hediffStack:3), "名前"))
        RETURNF

    LOCALS += @"%GET_STR(ARG, "Hediff", (hediffStack:3), "名前")% ({hediffStack:1}m)" 
    GOTO BYPASS
ENDIF

SIF DT_CELL_GET(@"Hediff", nHediff, "permanent", 1) && hediffStack:1 >= 500
LOCALS += @"Permanent "
LOCALS += @"%GET_STR(ARG, "Hediff", (hediffStack:3), "名前")%"
SIF DT_CELL_GET(@"Hediff", nHediff, "permanent", 1) && hediffStack:1 < 500 && hediffStack:1 > 0
LOCALS += @" Scar"
SIF STRLENS(GET_STR(ARG, "Hediff", hediffStack:3, @"{hediffStack:4}/Name"))
LOCALS += @" (%GET_STR(ARG, "Hediff", hediffStack:3, @"{hediffStack:4}/Name")%)"

SIF hediffStack > 1
    LOCALS += @" {hediffStack}x"

;SIF !ShowWounds
;    PRINTFORM  (
;ShowWounds = 1
IF IsDiseaseHediff(ARG,nPart,nWound)
    LOCALS += @" ({(hediffStack:1*100)/(GET_INT(ARG, "Hediff", (hediffStack:3), "Scale") ? GET_INT(ARG, "Hediff", (hediffStack:3), "Scale") # 100)}\%, "
ELSE
    LOCALS += @" ({hediffStack:1}, "
ENDIF

IF DT_CELL_GET(@"Hediff", nHediff, "owner", 1) >= CHARANUM
    LOCALS += @"Unknown "
ELSE
    LOCALS += @"%CALLNAME:(DT_CELL_GET(@"Hediff", nHediff, "owner", 1))%'s "
ENDIF

IF TOINT(DT_CELL_GETS(@"Hediff", nHediff, "cause", 1)) || DT_CELL_GETS(@"Hediff", nHediff, "cause", 1) == "0"
    LOCALS += @"%HTML_ESCAPE(GET_STR(MASTER, "Weapon", TOINT(DT_CELL_GETS(@"Hediff", nHediff, "cause", 1)), "名前"))%"
ELSE
    LOCALS += @"%HTML_ESCAPE(DT_CELL_GETS(@"Hediff", nHediff, "cause", 1))%"
ENDIF
IF ShowTend
    IF hediffStack:2 || DT_CELL_GET(@"Hediff", nHediff, "tended", 1)
        LOCALS += ", "
        IF DT_CELL_GET(@"Hediff", nHediff, "tended", 1)
        LOCALS += @"Tend Quality: {DT_CELL_GET(@"Hediff", nHediff, "tended", 1)}\%"
        ELSEIF hediffStack:2
        LOCALS += @"Bleeding ({hediffStack:2}x)"
        ELSE
        ENDIF
    ENDIF
ENDIF
    LOCALS += ")"


$BYPASS
IF HTML
    IF HTML == 2 || HTML == 8 || (HTML == 3 && IsBionicPart(ARG,nPart,nWound) && GET_INT(ARG, "Hediff", (hediffStack:3), "Has Config"))
    LOCALS += @"</button>"
    ELSEIF HTML
    LOCALS += @"</nonbutton>"
    ENDIF

    IF GET_STR(ARG, "Hediff", hediffStack:3, @"Color") != ""
        LOCALS '= @"<font color='#%GET_STR(ARG, "Hediff", hediffStack:3, @"Color")%'>%LOCALS, 2%</font>"
    ELSEIF IsBionicPart(ARG,nPart,nWound)
        LOCALS = %COLOR_PRINT_HTML(LOCALS, "C_AQUA")%
    ELSEIF IsDrugHediff(ARG,nPart,nWound)
        LOCALS = %COLOR_PRINT_HTML(LOCALS, "C_OD_PINK")%
    ELSEIF DT_CELL_GET(@"Hediff", nHediff, "permanent", 1) || BodyPartRemoved:ARG:nPart
        LOCALS = %COLOR_PRINT_HTML(LOCALS, "C_GRAY")%
    ELSE
        SELECTCASE (hediffStack:1*100)/BodyPartHealth:ARG:nPart:1
        CASE IS >= 200
            LOCALS = %COLOR_PRINT_HTML(LOCALS, "C_D_RED")%
        CASE IS >= 100
            LOCALS = %COLOR_PRINT_HTML(LOCALS, "C_RED")%
        CASE IS >= 75
            LOCALS = %COLOR_PRINT_HTML(LOCALS, "C_D_ORANGE")%
        CASE IS >= 50
            LOCALS = %COLOR_PRINT_HTML(LOCALS, "C_ORANGE")%
        CASE IS >= 30
            LOCALS = %COLOR_PRINT_HTML(LOCALS, "C_YELLOW")%
        CASE IS >= 20
            LOCALS = %COLOR_PRINT_HTML(LOCALS, "C_GREEN")%
        CASEELSE
        ENDSELECT
    ENDIF
ENDIF

RETURNF LOCALS

;Dumps a list of the 2hu's hediffs
@DumpHediffs(ARG)
#FUNCTION

LOCAL:6 = DT_SELECT("Hediff", @"chara = {ARG}",,tempHediffList)
FOR LOCAL, 0, DT_ROW_LENGTH(@"Hediff")
    DEBUGPRINTFORM #{LOCAL} Type： {DT_CELL_GET(@"Hediff", tempHediffList:LOCAL, "type",1)} on part {DT_CELL_GET(@"Hediff", tempHediffList:LOCAL, "Part",1)} Severity：{DT_CELL_GET(@"Hediff", tempHediffList:LOCAL, "severity",1)}
    DEBUGPRINTFORML
NEXT



;checks if the hediff was dealt by the same person with the same cause, of the same type.
@HediffSameSource(ARG,nPart,nTargetWound,nComparingWound)
#FUNCTION
#DIM nPart
#DIM nTargetWound
#DIM nComparingWound

nTargetWound = HediffGet(ARG,nPart,nTargetWound)
nComparingWound = HediffGet(ARG,nPart,nComparingWound)

SIF DT_CELL_GETS(@"Hediff", nTargetWound, "cause", 1) != DT_CELL_GETS(@"Hediff", nComparingWound, "cause", 1)
    RETURNF 0
SIF DT_CELL_GET(@"Hediff", nTargetWound, "owner", 1) != DT_CELL_GET(@"Hediff", nComparingWound, "owner", 1)
    RETURNF 0
SIF DT_CELL_GET(@"Hediff", nTargetWound, "type", 1) != DT_CELL_GET(@"Hediff", nComparingWound, "type", 1)
    RETURNF 0
RETURNF 1

;count number of the same hediffs
@HediffCount(ARG,nPart,nTargetWound)
#FUNCTION
#DIM nPart
#DIM nTargetWound
#DIM woundStacks
#DIM HC, 300
#DIM HC_COUNT

VARSET woundStacks
VARSET PartStack
HC_COUNT = DT_SELECT(@"Hediff", @"chara = {ARG} and part = {nPart}",,HC)
