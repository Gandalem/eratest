CASE "rleg"
    SELECTCASE RAND:3
    CASE 0
        CALLF DamageBodyPart(ARG,91,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
    CASE 1
        CALLF DamageBodyPart(ARG,92,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
    CASE 2
        CALLF DamageBodyPart(ARG,93,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
    ENDSELECT
CASE "larm"
    SELECTCASE RAND:3
    CASE 0
        CALLF DamageBodyPart(ARG,20,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
    CASE 1
        CALLF DamageBodyPart(ARG,22,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
    CASE 2
        CALLF DamageBodyPart(ARG,23,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
