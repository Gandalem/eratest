;trimmed down variant of DamageBodyPart
@AddDrugGain(ARG = -1,BodyPart,DMG,DMG_TYPE,nDealer,nItem, nPerm = 0)
#FUNCTION
#DIM DYNAMIC BodyPart
#DIM DYNAMIC DMG
#DIM DYNAMIC DMG_TYPE
#DIM DYNAMIC nHediff
#DIM DYNAMIC nDealer
#DIM DYNAMIC nPerm
#DIMS DYNAMIC nItem
;no damage
SIF DMG <= 0
    RETURNF

$BYPASS
SIF !DMG_TYPE
    THROW @"Attempted to give {ARG} %NAME:ARG% a hediff with an invalid damage type ({DMG_TYPE})!"

;first we get the hediff
IF DT_SELECT("Hediff", @"chara = {ARG} and type = {DMG_TYPE}")
    ;already exists, stack it instead
    nHediff = RESULT:1
	DT_CELL_SET @"Hediff", nHediff, "severity", DT_CELL_GET(@"Hediff", nHediff, "severity",1)+DMG, 1
	DT_CELL_SET @"Hediff", nHediff, "owner", nDealer, 1
	DT_CELL_SET @"Hediff", nHediff, "cause", nItem, 1
ELSE
    ;create new hediff
    {
    DT_ROW_ADD @"Hediff",
    "chara", ARG,
    "part", BodyPart,
    "type", DMG_TYPE,
    "severity", DMG,
    "tended", 0,
    "bleeding", 0,
    "owner", nDealer,
    "cause", nItem,
    "permanent", nPerm,
    }
    nHediff = RESULT
ENDIF