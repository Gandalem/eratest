;Initalize character capacity
;We can save capacities to CapacityStats
@InitCharaCapacity(C_ID,A_ID)
#FUNCTION
#DIM C_ID; character
#DIM A_ID; capacity
#DIM B_ID; body type
#DIM nValue, 10
#DIM DYNAMIC nInfluence, 10
; IF (CFLAG:MASTER:睡眠 && inTrain == 1) ;optimizations
;     CapacityStats:C_ID:A_ID = 100
;     RETURNF CapacityStats:C_ID:A_ID
; ENDIF

$END

;check all hediffs again
VARSET LOCAL
FOR LOCAL:3,0,DT_SELECT(@"Hediff", @"chara = {C_ID}", "", tempHediffList)
    LOCAL:4 = DT_CELL_GET(@"Hediff", tempHediffList:(LOCAL:3), "type", 1)
    LOCAL:5 = GetHediffStage(C_ID,tempHediffList:(LOCAL:3))
    LOCALS '= @"{LOCAL:5}/%ERDName(CapacityStats,A_ID)%"

    IF GET_INT(C_ID, "Hediff", (LOCAL:4), LOCALS+"/Max"); max 
        ;get lowest max
        LOCAL:6 = MIN(LOCAL:6,GET_INT(C_ID, "Hediff", (LOCAL:4), LOCALS+"/Max"))
    ELSEIF GET_INT(C_ID, "Hediff", (LOCAL:4), LOCALS+"/Mult"); multiply
        CapacityStats:C_ID:A_ID = (CapacityStats:C_ID:A_ID*GET_INT(C_ID, "Hediff", (LOCAL:4), LOCALS+"/Mult"))/100
    ELSEIF GET_INT(C_ID, "Hediff", (LOCAL:4), LOCALS+"/Add"); add
        CapacityStats:C_ID:A_ID = (CapacityStats:C_ID:A_ID+GET_INT(C_ID, "Hediff", (LOCAL:4), LOCALS+"/Add"))
    ENDIF
NEXT

;set max after all modifiers, this way a hediff early in the list that sets max low won't be fatal with other hediffs that set cons.
SIF LOCAL:6
    CapacityStats:C_ID:A_ID = MIN(CapacityStats:C_ID:A_ID,LOCAL:6)

RETURNF CapacityStats:C_ID:A_ID

