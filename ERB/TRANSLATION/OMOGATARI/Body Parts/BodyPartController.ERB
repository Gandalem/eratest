@IsPartCrippled(ARG,nPart,nType = 0)
#FUNCTION
#DIM nPart
#DIM nType
#DIM nWound
#DIM maxWounds
IF (CFLAG:MASTER:睡眠 && inTrain == 1) ;optimizations
    RETURNF 0
ENDIF

CALLF BodyPartDependencies(nPart)

FOR LOCAL,0,20
    SIF !BodyPartChildren:LOCAL
        BREAK
        
    SELECTCASE nType
    CASE 0
        IF (BodyPartHealth:ARG:(BodyPartChildren:LOCAL):0 <= 0 || BodyPartRemoved:ARG:(BodyPartChildren:LOCAL)) && BodyPartHealth:ARG:(BodyPartChildren:LOCAL):1
            ;bionic priority
            ;DEBUGPRINTFORML %BDY_PART_NAME(BodyPartChildren:LOCAL)% is crippled
            ;IF IsBionicPart(ARG,nPart,0) && BodyPartHealth:ARG:(nPart):0 > 0 && !BodyPartRemoved:ARG:(nPart)
            IF PartOrChildIsBionic(ARG,nPart,1)
                ;DEBUGPRINTFORML Giving bionic priority to %BDY_PART_NAME(nPart)%
                RETURNF 0
            ENDIF
            RETURNF BodyPartChildren:LOCAL
        ENDIF
    CASE 1
        VARSET tempHediffList
        maxWounds = DT_SELECT(@"Hediff", @"chara = {ARG} and part = {BodyPartChildren:LOCAL}", "", tempHediffList)
        FOR nWound,0, maxWounds
            IF DT_CELL_GET(@"Hediff", tempHediffList:nWound, "bleeding", 1) && !DT_CELL_GET(@"Hediff", tempHediffList:nWound, "tended", 1)
                RETURNF BodyPartChildren:LOCAL
            ENDIF
        NEXT
    CASE 100
        ;bionic
        IF DT_SELECT(@"Hediff", @"chara = {ARG} and part = {BodyPartChildren:LOCAL} and type > 100")
            RETURNF BodyPartChildren:LOCAL
        ENDIF
    CASEELSE
        IF BodyPartStatus:ARG:(BodyPartChildren:LOCAL):nType
            RETURNF BodyPartChildren:LOCAL
        ENDIF
    ENDSELECT
NEXT
RETURNF 0   

