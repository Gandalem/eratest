@HealAllHediffs(ARG,nAmount)
#FUNCTION
#DIM DYNAMIC nAmount
#DIM DYNAMIC nHediff
#DIM DYNAMIC nHediffDef
#DIM DYNAMIC nPart
#DIM DYNAMIC nHediffCount
#DIM DYNAMIC nCurrentSeverity

SIF IsDead:ARG:0
    RETURNF

nHediffCount = DT_SELECT("Hediff", @"chara = {ARG}", "",tempHediffList)
FOR nHediff,0, nHediffCount
	nPart = DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "part",1)
    nHediffDef = DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "type",1)
	SIF GROUPMATCH(GET_STR(ARG, "Hediff", nHediffDef, "Hediff Type"), "Bionic", "Drug") ; no bionics
		CONTINUE
	SIF DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "permanent",1) ; perm hediffs don't heal
		CONTINUE
    nCurrentSeverity = DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "severity", 1)
	;heal if part isn't destroyed
    ;hourai exception (they can heal all)
	IF (BodyPartHealth:ARG:(nPart):0 > -BodyPartHealth:ARG:(nPart):1 || !nNecro || TALENT:ARG:197 == 4) && BodyPartHealth:ARG:(nPart):1
		LOCAL:6 = (DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "tended",1) ? MAX(DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "tended",1)/8, 3) # 1) * (nAmount)
		SELECTCASE TALENT:ARG:130
		CASE -1
			LOCAL:6 /= 2
		CASE 1
			LOCAL:6 *= 2
		ENDSELECT
		;PRINTFORML Healing %DamageTypes:(Hediff:ARG:(nPart):(LOCAL:3))% ({HediffSeverity:ARG:(nPart):(LOCAL:3)} damage) for {LOCAL:6}
		DT_CELL_SET @"Hediff", tempHediffList:nHediff, "severity", MAX(0,nCurrentSeverity - LOCAL:6), 1
		IF DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "severity",1) <= 0
            ;DEBUGPRINTFORML Clearing hediff {tempHediffList:nHediff} from %NAME:ARG%
			DT_ROW_REMOVE @"Hediff", tempHediffList:nHediff
		ENDIF
	ENDIF
NEXT

;make drug hediffs lapse
@LapseDrugHediffs(ARG,nAmount)
#FUNCTION
#DIM DYNAMIC nAmount
#DIM DYNAMIC nHediff
#DIM DYNAMIC nHediffDef
#DIM DYNAMIC nPart
#DIM DYNAMIC nHediffCount
#DIM DYNAMIC nCurrentSeverity

SIF IsDead:ARG:0
    RETURNF

nHediffCount = DT_SELECT("Hediff", @"chara = {ARG}", "",tempHediffList)
FOR nHediff,0, nHediffCount
	nPart = DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "part",1)
    nHediffDef = DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "type",1)
	SIF !GROUPMATCH(GET_STR(ARG, "Hediff", nHediffDef, "Hediff Type"), "Drug") ; must be drugs
		CONTINUE
	SIF DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "permanent",1) ; perm hediffs don't heal
		CONTINUE
    nCurrentSeverity = DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "severity", 1)
	;drugs lapse
    DT_CELL_SET @"Hediff", tempHediffList:nHediff, "severity", MAX(0,nCurrentSeverity - nAmount), 1
    IF DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "severity",1) <= 0
        ;DEBUGPRINTFORML Clearing hediff {tempHediffList:nHediff} from %NAME:ARG%
        DT_ROW_REMOVE @"Hediff", tempHediffList:nHediff
    ENDIF
NEXT

@TendAllHediffs(ARG,nAmount)
#FUNCTION
#DIM DYNAMIC nAmount
#DIM DYNAMIC nHediff
#DIM DYNAMIC nPart
#DIM DYNAMIC nHediffCount

SIF IsDead:ARG:0
    RETURNF

nHediffCount = DT_SELECT("Hediff", @"chara = {ARG}", "",tempHediffList)
FOR nHediff,0, nHediffCount
	nPart = DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "part",1)
	SIF DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "type",1) > 100 ; no bionics
		CONTINUE
	SIF DT_CELL_GET(@"Hediff", tempHediffList:nHediff, "permanent",1) ; perm hediffs don't heal
		CONTINUE
	;heal if part isn't destroyed
    ;hourai exception (they can heal all)
	IF (BodyPartHealth:ARG:(nPart):0 > -BodyPartHealth:ARG:(nPart):1 || !nNecro || TALENT:ARG:197 == 4) && BodyPartHealth:ARG:(nPart):1
		;PRINTFORML Healing %DamageTypes:(Hediff:ARG:(nPart):(LOCAL:3))% ({HediffSeverity:ARG:(nPart):(LOCAL:3)} damage) for {LOCAL:6}
		DT_CELL_SET @"Hediff", tempHediffList:nHediff, "tended", nAmount, 1
	ENDIF
NEXT

@DamageBodyPart(ARG = -1,BodyPart,DMG,DMG_TYPE,nDealer,nItem,nPerm = 0,nBleedMultiplier = 100)
#FUNCTION
#DIM DYNAMIC BodyPart
#DIM DYNAMIC DMG
#DIM DYNAMIC DMG_TYPE
#DIM DYNAMIC nHediff
#DIM DYNAMIC nDealer
#DIM DYNAMIC nPerm
#DIMS DYNAMIC nItem
#DIM DYNAMIC nBleeds
#DIM DYNAMIC nBleedMultiplier

;don't hurt the baby!
SIF IS_BABY(ARG) || (NASCheat:5 && ARG == MASTER)
    RETURNF

SIF nDealer == -1 || nDealer == ARG
    GOTO BYPASS

SELECTCASE TALENT:ARG:40
CASE -2
    TIMES DMG, 0.25
CASE -1
    TIMES DMG, 0.5
CASE 1
    TIMES DMG, 1.15
ENDSELECT

DMG = DMG*YoujutsuResistMULT(DamageResist:ARG:DMG_TYPE:1)/100

[SKIPSTART]
IF !TALENT:nDealer:DirgeofDecay
    SIF TALENT:ARG:妖怪
        TIMES DMG, 0.33
    SIF TALENT:ARG:神霊
        TIMES DMG, 0.1
    SIF TALENT:ARG:幽霊
        TIMES DMG, 0.2
ENDIF
[SKIPEND]

;bionics are always 1 damage
SIF DMG_TYPE > 100
    DMG = 1

;no damage
SIF DMG <= 0
    RETURNF

$BYPASS

;bodypart is 0, assume this is whole body.
; SIF !BodyPart
;     THROW @"Attempted to give {ARG} %NAME:ARG% a hediff on an invalid body part ({BodyPart})!"
SIF !DMG_TYPE
    THROW @"Attempted to give {ARG} %NAME:ARG% a hediff with an invalid damage type ({DMG_TYPE})!"

;invalid part
SIF !HasBodyPart(ARG,BodyPart)
    RETURNF
;part is supposed to be removed, attribute part to parent instead
IF PartOrChildIsBionic(ARG,BodyPart,1)
    CALLF BodyPartParentFromChild(BodyPart)
    BodyPart = BodyPartChildren:0
ENDIF
;can't further damage a destroyed part
SIF IsPartDestroyed(ARG,BodyPart) && BodyPart != 40
    RETURNF


; nHediff = GetFreeHediff(ARG,BodyPart)
; Hediff:ARG:BodyPart:nHediff = DMG_TYPE
; HediffSeverity:ARG:BodyPart:nHediff = DMG
; HediffOwner:ARG:BodyPart:nHediff = nDealer
; HediffCause:ARG:BodyPart:nHediff = %nItem%
; HediffPermanent:ARG:BodyPart:nHediff = nPerm

;nHediffCount = DT_SELECT("Hediff", @"chara = {ARG}",,tempHediffList)
{
DT_ROW_ADD @"Hediff",
"chara", ARG,
"part", BodyPart,
"type", DMG_TYPE,
"severity", DMG,
"tended", 0,
"bleeding", 0,
"owner", nDealer,
"cause", nItem,
"permanent", nPerm,
}
nHediff = RESULT

IF GROUPMATCH(GET_STR(ARG,"Hediff", DMG_TYPE, "Hediff Type"),"Damage", "Disease")
BleedTimeout:ARG:0 = 60
KilledBy:ARG:0 = nDealer
KilledWith:ARG:0 = %nItem%
LastHediff:ARG = BodyPart*100+DMG_TYPE
ENDIF

;BodyPartHealth:ARG:BodyPart:0 -= DMG
;BodyWound:ARG:BodyPart:(VARSIZE(BodyWound:ARG:BodyPart:0)+1) = DMG

IF GET_INT(ARG,"Hediff", DMG_TYPE, "Bleed Threshold") && !PartOrChildIsBionic(ARG,BodyPart)
nBleeds = DT_CELL_GET(@"Hediff", nHediff, "bleeding")+(DMG/GET_INT(ARG,"Hediff", DMG_TYPE, "Bleed Threshold"))
SIF nBleedMultiplier != 100
    nBleeds = nBleeds*nBleedMultiplier/100
{
DT_CELL_SET @"Hediff",
nHediff,
"bleeding",
nBleeds,
1
}
ENDIF

