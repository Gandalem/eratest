;get stage of hediffs
@GetHediffStage(C_ID,H_ID)
#FUNCTION
#DIM C_ID
#DIM H_ID
#DIM H_DEF
#DIM H_STAGE
#DIM H_MAX
#DIM H_SCALE

H_DEF = DT_CELL_GET(@"Hediff", H_ID, "type",1)
H_MAX = GET_INT(C_ID, "Hediff", H_DEF, @"Scale") ? GET_INT(C_ID, "Hediff", H_DEF, @"Scale") # 100

;10 is a pretty moderate limit
FOR H_STAGE, 0, 10
    IF !GET_INT(C_ID, "Hediff", H_DEF, @"{H_STAGE+1}/Level")
        H_STAGE--
        RETURNF MAX(0,H_STAGE)
    ELSEIF (DT_CELL_GET(@"Hediff", H_ID, "severity", 1)*100)/H_MAX < GET_INT(C_ID, "Hediff", H_DEF, @"{H_STAGE+1}/Level")
        ; H_STAGE--
        RETURNF MAX(0,H_STAGE)
    ENDIF
    H_STAGE++
NEXT

