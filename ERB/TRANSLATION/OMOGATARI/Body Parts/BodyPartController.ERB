@IsPartDestroyed(ARG,nPart)
#FUNCTION
#DIM nPart
#DIM nParent
#DIM nChildPart

IF (CFLAG:MASTER:睡眠 && inTrain == 1) ;optimizations
    RETURNF 0
ENDIF

SIF BodyPartHealth:ARG:(nPart):0 <= -BodyPartHealth:ARG:(nPart):1 && BodyPartHealth:ARG:(nPart):1
    RETURNF 1


;return negative if the parent is not dead
CALLF BodyPartParentFromChild(nPart)
IF IsBionicPart(ARG,BodyPartChildren:0,0) == 1 && BodyPartHealth:ARG:(BodyPartChildren:0):0 > 0 && !BodyPartRemoved:ARG:(BodyPartChildren:0)
    ;DEBUGPRINTFORML Giving bionic priority to %BDY_PART_NAME(BodyPartChildren:0)%
    RETURNF 0
ENDIF   

SIF BodyPartRemoved:ARG:nPart
    RETURNF 1

;Initialize character capacity, pain, efficiently.
;Most stuff related to capacities goes here
;We can save capacities to CapacityStats
;Main goal is to eliminate as many loops and ultimately INCREASE ZE PERFORMANCE
@CrippleEffects(C_ID)
#DIM C_ID; character
#DIM A_LOOP
#DIM A_ID; capacity
#DIM B_ID; body type
#DIM H_ID; hediff
#DIM H_DEF; hediff definition
#DIM H_PART; hediff part
#DIM H_STAGE; hediff stage
#DIM DYNAMIC A_MAX ;agony max
#DIM DYNAMIC A_MULT ;agony mult
#DIM DYNAMIC A_ADD ;agony add
#DIM nValue, 10
#DIM DYNAMIC nInfluence, 10
#DIM DYNAMIC DamageOffset, 100
#DIM DYNAMIC EfficiencyMult, 100
#DIM DYNAMIC CapacityMax, VARSIZE("CapacityStats")
#DIM DYNAMIC CapacityMult, VARSIZE("CapacityStats")
#DIM DYNAMIC CapacityOffset, VARSIZE("CapacityStats")
#DIM DYNAMIC HediffList, 10000
#DIM DYNAMIC HediffCount
#DIM DYNAMIC H_GENITAL,2
#DIM Lapse
#DIM DYNAMIC TempBloodLoss
#DIM CrippledParts
#DIM D_INDEX, 3
#DIM DYNAMIC BaseWasBuffed, VARSIZE("BASE")
HediffCount = DT_SELECT(@"Hediff", @"chara = {C_ID}", "", HediffList)
VARSET CrippledParts
VARSET CapacityMax
VARSET CapacityMult, 100
VARSET CapacityOffset
HealthFlags:C_ID:0 = 0
Lapse = TIME_PROGRESS(TIME:1)
MAXBASE:C_ID:Agony = MAX(10000,MAXBASE:C_ID:0*5)
BASE:C_ID:Agony = 0
A_MAX = MAXBASE:C_ID:Agony
A_MULT = 100

BleedTimeout:C_ID:0 -= Lapse
SIF !IsDead:C_ID:0
    BASE:C_ID:Blood = LIMIT(BASE:C_ID:Blood+(Lapse*2),0,MAXBASE:C_ID:Blood)
TCVAR:C_ID:Bleeding = 0

; IF (CFLAG:MASTER:睡眠 && inTrain == 1) ;optimizations
;     GOTO BypassHediffs
; ENDIF

;tsp unbuff
VARSET BaseWasBuffed
FOR D_INDEX,0,VARSIZE("BionicBASE")
    SIF BionicBASE:C_ID:D_INDEX
        BaseWasBuffed:D_INDEX = BionicBASE:C_ID:D_INDEX
    MAXBASE:C_ID:D_INDEX -= BionicBASE:C_ID:D_INDEX
    BUFF:C_ID:D_INDEX -= BionicBASE:C_ID:D_INDEX
    BionicBASE:C_ID:D_INDEX = 0
NEXT

;DEBUGPRINTFORML Calculating health for %CALLNAME:C_ID%

FOR D_INDEX,0,HediffCount
    ;hediff effects
    H_ID = HediffList:D_INDEX
    H_PART = DT_CELL_GET(@"Hediff", H_ID, "part", 1)
    H_STAGE = GetHediffStage(C_ID,H_ID)
    IF H_ID
        H_DEF = DT_CELL_GET(@"Hediff", H_ID, "type", 1)
        SELECTCASE GET_STR(C_ID, "Hediff", H_DEF, "Hediff Type")
        CASE "Bionic"
            SELECTCASE H_DEF
            CASE 25
                ;cloaca
                SETBIT HealthFlags:C_ID:0,3
            CASE 161
                ;painstopper
                SETBIT HealthFlags:C_ID:0,HealthFlags_HasPainStopper
            CASE 168
                ;collagulator
                SETBIT HealthFlags:C_ID:0,2
            ENDSELECT
            SELECTCASE H_PART
            CASE 63
                SETBIT HealthFlags:C_ID:0,HealthFlags_HasVagina
                H_GENITAL:1 = H_DEF
            CASE 68
                SETBIT HealthFlags:C_ID:0,HealthFlags_HasPenis
                H_GENITAL:0 = H_DEF
            ENDSELECT

            ;IsBionicPart(ARG,63,0)
        CASE "Drug"
        CASE "Disease"
            SETBIT HealthFlags:C_ID:0,HealthFlags_UnwellHediff
        CASEELSE
            ;assume Damage
            DamageOffset:(H_PART) += DT_CELL_GET(@"Hediff", H_ID, "severity", 1)
            TempBloodLoss = DT_CELL_GET(@"Hediff", H_ID, "bleeding", 1)
            SIF DT_CELL_GET(@"Hediff", H_ID, "tended", 1)
                TempBloodLoss = 0
            TCVAR:C_ID:Bleeding += TempBloodLoss
            SIF C_ID == MASTER
                CALL INTERACTIVE_TUTORIAL_GET(102,203,"Bleeding",2)
            SETBIT HealthFlags:C_ID:0,HealthFlags_UnwellHediff
            ;DamageOffset:(DT_CELL_GET(@"Hediff", H_ID, "part", 1)) += DT_CELL_GET(@"Hediff", H_ID, "severity", 1)
        ENDSELECT

        SELECTCASE GET_STR(C_ID, "Hediff", H_DEF, "Hediff Type")
        CASE "Bionic", "Drug"
            ;base increases
            FOR D_INDEX:1,0,VARSIZE("BionicBASE")
                SIF GET_INT(C_ID, "Hediff", H_DEF, @"Base{D_INDEX:1}")
                    BionicBASE:C_ID:(D_INDEX:1) += GET_INT(C_ID, "Hediff", H_DEF, @"Base{D_INDEX:1}")
            NEXT
        CASE "Disease"
        ENDSELECT
        IF GET_INT(C_ID, "Hediff", H_DEF, "Efficiency")
            SIF !EfficiencyMult:H_PART
                EfficiencyMult:H_PART = 100
            EfficiencyMult:H_PART = (EfficiencyMult:H_PART*GET_INT(C_ID, "Hediff", H_DEF, "Efficiency"))/100
        ENDIF

        CapacityOffset:10 += GET_INT(C_ID, "Hediff", H_DEF, "Pee Holding")
        CapacityOffset:11 += GET_INT(C_ID, "Hediff", H_DEF, "Poo Holding")
        SIF H_DEF == 41
            DEBUGPRINTFORML overdose. stage {H_STAGE} id {H_ID}
        IF GET_INT(C_ID, "Hediff", (H_DEF), TOSTR(H_STAGE)+"/Fatal")
            ;should kill
            SETBIT HealthFlags:C_ID:0,HealthFlags_WillDieAfterCheck
        ENDIF
        ;agony
        IF !(BodyPartRemoved:C_ID:(DT_CELL_GET(@"Hediff", H_ID, "part", 1))) && !(PartOrChildIsBionic(C_ID,DT_CELL_GET(@"Hediff", H_ID, "part", 1)))
            LOCALS '= @"{H_STAGE}/agony"
            ;DEBUGPRINTFORML hediff {H_ID}: def {H_DEF} - stage {H_STAGE} - %LOCALS%

            SIF GROUPMATCH(GET_STR(C_ID,"Hediff", H_DEF, "Hediff Type"),"Damage")
                BASE:C_ID:Agony += (DT_CELL_GET(@"Hediff", H_ID, "severity", 1)*GET_INT(C_ID,"Hediff", H_DEF, "Pain Multiplier"))

            IF GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Max"); max 
                ;get lowest max
                A_MAX = MIN(A_MAX,GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Max"))
            ELSEIF GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Mult") && A_MULT > 0; multiply
                A_MULT = (A_MULT*GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Mult"))/100
            ELSEIF GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Add"); add
                A_ADD = (A_ADD+GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Add"))
            ENDIF
        ENDIF
        ;capacity
        FOR D_INDEX:1,0,VARSIZE("CapacityStats")
            LOCALS '= @"{H_STAGE}/%ERDName(CapacityStats,D_INDEX:1)%"

            IF GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Max"); max 
                ;get lowest max
                IF !CapacityMax
                    CapacityMax:(D_INDEX:1) = GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Max")
                ELSE
                    CapacityMax:(D_INDEX:1) = MIN(CapacityMax:(D_INDEX:1),GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Max"))
                ENDIF
            ELSEIF GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Mult"); multiply
                CapacityMult:(D_INDEX:1) = (CapacityMult:(D_INDEX:1)*GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Mult"))/100
            ELSEIF GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Add"); add
                CapacityOffset:(D_INDEX:1) = (CapacityOffset:(D_INDEX:1)+GET_INT(C_ID, "Hediff", (H_DEF), LOCALS+"/Add"))
            ENDIF
        NEXT
    ENDIF
NEXT

;after hediff effects
FOR D_INDEX,0,100
    ;base buffs
    SELECTCASE D_INDEX
    CASE 0 TO VARSIZE("BionicBASE")-1
        MAXBASE:C_ID:D_INDEX += BionicBASE:C_ID:D_INDEX
        BUFF:C_ID:D_INDEX += BionicBASE:C_ID:D_INDEX
        ;add base
        SIF BionicBase:C_ID:D_INDEX > BaseWasBuffed:D_INDEX
            BASE:C_ID:D_INDEX = MIN(MAXBASE:C_ID:D_INDEX,BASE:C_ID:D_INDEX+(BionicBASE:C_ID:D_INDEX-BaseWasBuffed:D_INDEX))
    ENDSELECT

    SIF BDY_PART_NAME(D_INDEX) == ""
        CONTINUE

    ;make body part health
    IF BDY_PART_NAME(D_INDEX) != "" && D_INDEX < 100
        ;set body part health at max
        BodyPartHealth:C_ID:D_INDEX:1 = MAXBASE:C_ID:0
        SIF BodyPartHealth_0(D_INDEX)
            BodyPartHealth:C_ID:D_INDEX:1 = (BodyPartHealth:C_ID:D_INDEX:1)*BodyPartHealth_0(D_INDEX)/100
         BodyPartHealth:C_ID:D_INDEX:1 = BodyPartHealth:C_ID:D_INDEX:1*CharaBodySize(C_ID)/100
        BodyPartHealth:C_ID:D_INDEX:0 = BodyPartHealth:C_ID:D_INDEX:1
    ENDIF
    BodyPartHealth:C_ID:(D_INDEX):0 -= DamageOffset:(D_INDEX)
    IF IsPartDestroyed(C_ID,D_INDEX)
        BodyPartRemoved:C_ID:D_INDEX = 1
        EfficiencyStats:C_ID:D_INDEX = 0
        SIF GROUPMATCH(D_INDEX,1,11,40)
            SETBIT HealthFlags:C_ID:0,HealthFlags_WillDieAfterCheck
    ELSEIF BodyPartHealth:C_ID:(D_INDEX):0 <= 0 && BodyPartHealth:C_ID:(D_INDEX):1
        ;crippled part counter
        SIF !IsDead:C_ID:0
            CrippledParts++
    ENDIF
    IF EfficiencyMult:D_INDEX
        EfficiencyStats:C_ID:D_INDEX = LIMIT(((BodyPartHealth:C_ID:D_INDEX:0*100)/MAX(1,BodyPartHealth:C_ID:D_INDEX:1)),0,100)*EfficiencyMult:D_INDEX/100
    ELSE
        EfficiencyStats:C_ID:D_INDEX = LIMIT(((BodyPartHealth:C_ID:D_INDEX:0*100)/MAX(1,BodyPartHealth:C_ID:D_INDEX:1)),0,100)
    ENDIF
NEXT

SIF GETBIT(HealthFlags:C_ID:0,2)
    TCVAR:C_ID:Bleeding /= 2

$BypassHediffs

SIF BleedTimeout:C_ID:0 <= 0
    BleedTimeout:C_ID:0 = 60

;agony
;add, then multiply, then set max after all modifiers
SIF A_ADD
    BASE:C_ID:Agony = (BASE:C_ID:Agony+A_ADD)
IF A_MULT
    IF A_MULT <= 0
        BASE:C_ID:Agony = 0
    ELSE
        BASE:C_ID:Agony = (BASE:C_ID:Agony*A_MULT)/100
    ENDIF
ENDIF
SIF A_MAX
    BASE:C_ID:Agony = MIN(BASE:C_ID:Agony,A_MAX)
IF GETBIT(C_ID,HealthFlags_HasPainStopper)
    BASE:C_ID:Agony = 0
ENDIF

; ;reinit capacities here
; yes the ids are confusing because id 0 on the cap stats is consciousness but its not here.
FOR A_LOOP,0,VARSIZE("CapacityStats")
    ; CapacityMax:A_ID = 0
    ; CapacityMult:A_ID = 0
    ; CapacityOffset:A_ID = 0
    VARSET nValue
    VARSET nInfluence
    A_ID = -1
    SELECTCASE A_LOOP
    CASE 0
    ;Breathing
        A_ID = 6
        IF IsPartDestroyed(C_ID,45) && IsPartDestroyed(C_ID,46) ;destroyed lungs
            CapacityStats:C_ID:6 = 0
            CONTINUE
        ENDIF
        nValue = EfficiencyStats:C_ID:11 ;Neck
        nValue:1 = EfficiencyStats:C_ID:45 ;Left lung
        nValue:2 = EfficiencyStats:C_ID:46 ;Right lung
        nInfluence = (100 + (nValue:1-100) * 50/100)
        nInfluence:1 = (100 + (nValue:2-100) * 50/100)
        CapacityStats:C_ID:A_ID = nValue * nInfluence/100 * nInfluence:1/100
    CASE 1
    ;Blood Filtration
        A_ID = 7
        nValue = EfficiencyStats:C_ID:77 ;Liver
        nValue:1 = EfficiencyStats:C_ID:75 ;L kidney
        nValue:2 = EfficiencyStats:C_ID:76 ;R kidney
        nInfluence = (100 + (nValue:1-100) * 50/100)
        nInfluence:1 = (100 + (nValue:2-100) * 50/100)
        CapacityStats:C_ID:A_ID = nValue * nInfluence/100 * nInfluence:1/100
    CASE 2
    ;Blood pumping
        A_ID = 8
        CapacityStats:C_ID:A_ID = EfficiencyStats:C_ID:47 ; Heart
    CASE 3
    ;Consciousness
        A_ID = 0
        IF IsDead:C_ID:0
            ;dead
            CapacityStats:C_ID:A_ID = 0
            CONTINUE
        ENDIF
        ; nValue = GetPartEfficiency(C_ID,1) ;base
        ; nInfluence = GetPartEfficiency(C_ID,12) ;brain
        ; nValue = nValue * nInfluence/100
        nValue = EfficiencyStats:C_ID:12 ;base (brain)
        nInfluence = (100 + (MIN(CapacityStats:C_ID:8,100)-100) * 20/100) ;blood pumping
        nInfluence:1 = (100 + (MIN(CapacityStats:C_ID:6,100)-100) * 20/100) ;breathing
        nInfluence:2 = (100 + (MIN(CapacityStats:C_ID:7,100)-100) * 10/100) ;blood filtration
        IF Base:C_ID:Agony < MaxBase:C_ID:Agony/10 ;agony
            nInfluence:5 = 0
        ELSE
            ;nInfluence:5 = (Base:C_ID:Agony-(MaxBase:C_ID:Agony/10))/225
            nInfluence:5 = (((Base:C_ID:Agony*10000)/MaxBase:C_ID:Agony)-(1000))/225
        ENDIF
        nValue = (nValue * nInfluence/100 * nInfluence:1/100 * nInfluence:2/100) - nInfluence:5
        CapacityStats:C_ID:A_ID = nValue
    CASE 4
    ;Sight
        A_ID = 1
        CapacityStats:C_ID:A_ID = EfficiencyStats:C_ID:4
    CASE 5
    ;Hearing
        A_ID = 2
        nValue = EfficiencyStats:C_ID:5
        nValue:1 = EfficiencyStats:C_ID:6
        nInfluence = MAX(nValue,nValue:1)*75/100
        nInfluence:1 = MIN(nValue,nValue:1)*25/100
        ;DEBUGPRINTFORML Left Ear: {nInfluence}\%
        ;DEBUGPRINTFORML Right Ear: {nInfluence:1}\%
        CapacityStats:C_ID:A_ID = nInfluence + nInfluence:1
    CASE 6
    ;Moving
        A_ID = 3
        ;no moving until 3, or if legs are bound
        IF CharaAge:C_ID:0 < 3 || LEGS_BOUND(C_ID)
            CapacityStats:C_ID:A_ID = 0
            CONTINUE
        ENDIF
        nValue = LIMIT(CapacityStats:C_ID:0,0,100) ;Consciousness
        nValue:1 = EfficiencyStats:C_ID:81 ;Left Thigh
        nValue:2 = EfficiencyStats:C_ID:82 ;Left Knee
        nValue:3 = EfficiencyStats:C_ID:83 ;Left Foot
        nValue:4 = EfficiencyStats:C_ID:91 ;Right Thigh
        nValue:5 = EfficiencyStats:C_ID:92 ;Right Knee
        nValue:6 = EfficiencyStats:C_ID:93 ;Right Foot
        nValue:7 = EfficiencyStats:C_ID:60 ;Hip
        nValue:8 = EfficiencyStats:C_ID:55 ;Spine
        nInfluence = nValue:1 * nValue:2/100 * nValue:3/100
        nInfluence:1 = nValue:4 * nValue:5/100 * nValue:6/100
        ;;#; DEBUGPRINTFORML Left Leg: {nInfluence}\%
        ;;#; DEBUGPRINTFORML Right Leg: {nInfluence:1}\%
        nInfluence:2 = (nInfluence/2) + (nInfluence:1/2) * nValue:7/100 * nValue:8/100
        ;;#; DEBUGPRINTFORML Leg efficiency: {nInfluence:2}\%
        nInfluence:3 = (100 + (CapacityStats:C_ID:8-100) * 20/100)
        ;;#; DEBUGPRINTFORML Blood Pumping Offset: {nInfluence:3}\%
        nInfluence:4 = (100 + (CapacityStats:C_ID:6-100) * 20/100)
        ;;#; DEBUGPRINTFORML Breathing Offset: {nInfluence:4}\%
        CapacityStats:C_ID:A_ID = nValue * nInfluence:3/100 * nInfluence:4/100 * nInfluence:2/100
    CASE 7
    ;Manipulation
        A_ID = 4
        IF ARMS_BOUND(C_ID) ;bound arms
            CapacityStats:C_ID:A_ID = 0
            CONTINUE
        ENDIF
        nValue = MAX(CapacityStats:C_ID:0,0) ;Consciousness
        nValue:1 = EfficiencyStats:C_ID:20 ;Left Arm
        nValue:2 = EfficiencyStats:C_ID:21 ;Left Armpit
        nValue:3 = EfficiencyStats:C_ID:22 ;Left Elbow
        nValue:4 = EfficiencyStats:C_ID:23 ;Left Hand
        nValue:5 = EfficiencyStats:C_ID:30 ;Right Arm
        nValue:6 = EfficiencyStats:C_ID:31 ;Right Armpit
        nValue:7 = EfficiencyStats:C_ID:32 ;Right Elbow
        nValue:8 = EfficiencyStats:C_ID:33 ;Right Hand

        nInfluence = nValue:1 * nValue:2/100 * nValue:3/100 * nValue:4/100
        nInfluence:1 = nValue:5 * nValue:6/100 * nValue:7/100 * nValue:8/100
        ;;#; DEBUGPRINTFORML Left Arm: {nInfluence}\%
        ;;#; DEBUGPRINTFORML Right Arm: {nInfluence:1}\%
        CapacityStats:C_ID:A_ID = nValue * ((nInfluence/2) + (nInfluence:1/2))/100
    CASE 8
    ;Talking
        A_ID = 5
        nValue = MAX(CapacityStats:C_ID:0,0) ;Consciousness
        nValue:1 = EfficiencyStats:C_ID:8 ;Mouth
        nValue:2 = EfficiencyStats:C_ID:9 ;Tongue
        CapacityStats:C_ID:A_ID = nValue * nValue:1/100 * nValue:2/100
    CASE 9
    ;Fertility
        A_ID = 9
        VARSET nValue
        IF HAS_PENIS(C_ID)
        ;Penis
            nValue:1 = EfficiencyStats:C_ID:68 ;Penis
            nValue:2 = EfficiencyStats:C_ID:69 ;Gland
            nValue:3 = EfficiencyStats:C_ID:70 ;Shaft
            nValue:4 = EfficiencyStats:C_ID:71 ;Balls
        ENDIF
        IF HAS_VAGINA(C_ID)
        ;Vagina
            nValue:5 = EfficiencyStats:C_ID:63 ;Vagina
            nValue:6 = EfficiencyStats:C_ID:64 ;Womb
        ENDIF
        nInfluence = nValue:1 * nValue:2/100 * nValue:3/100 * nValue:4/100  
        nInfluence:1 = nValue:5 * nValue:6/100
        CapacityStats:C_ID:A_ID = MAX(nInfluence,nInfluence:1)
        SIF !妊娠可否(C_ID)
            CapacityStats:C_ID:A_ID = 0
    CASE 10
    ;Pee Con
        A_ID = 10
        nValue = 0 ;base
        ;always return incon if bladder is crippled
        IF IsPartCrippled(C_ID,74)
            $NoBladder
            CapacityStats:C_ID:A_ID = -99
            CONTINUE
        ELSEIF GETBIT(YoujutsuEffects:C_ID:18,22) || DT_SELECT("Hediff", @"chara = {C_ID} and type = 53")
            ;incontinent
            $Incontinent
            CapacityStats:C_ID:A_ID = -10
            CONTINUE
        ELSEIF GETBIT(HealthFlags:C_ID:0,3)
            ;cloaca = incontinent
            GOTO NoBladder
        ENDIF
        IF C_ID == MASTER
            SIF DAILY_Lucid_Stats:3 == 3 && GETBIT(LUCID_EV3_Hold,3)
                nInfluence += 2
            SIF AL_IS_CLAIMED("lucidEV3BeatNoSoil")
                nInfluence += 2
        ENDIF
        nInfluence += TCVAR:C_ID:HypnoContinence
        nValue += nInfluence
        CapacityStats:C_ID:A_ID = nValue
    CASE 11
    ;Poo Con
        A_ID = 11
        nValue = 0 ;base
        ;always return incon if bladder is crippled
        IF IsPartCrippled(C_ID,53)
            GOTO NoBladder
        ELSEIF GETBIT(YoujutsuEffects:C_ID:18,22) || DT_SELECT("Hediff", @"chara = {C_ID} and type = 53")
            ;incontinent
            GOTO Incontinent
        ELSEIF GETBIT(HealthFlags:C_ID:0,3)
            ;cloaca = incontinent
            GOTO NoBladder
        ENDIF
        IF C_ID == MASTER
            SIF DAILY_Lucid_Stats:3 == 3 && GETBIT(LUCID_EV3_Hold,3)
                nInfluence += 2
            SIF AL_IS_CLAIMED("lucidEV3BeatNoSoil")
                nInfluence += 2
        ENDIF
        nInfluence += TCVAR:C_ID:HypnoContinence
        nValue += nInfluence
        CapacityStats:C_ID:A_ID = nValue
    ENDSELECT

    ;set capacities here.
    IF CapacityMult:A_ID; multiply
        CapacityStats:C_ID:A_ID = (CapacityStats:C_ID:A_ID*CapacityMult:A_ID)/100
    ENDIF
    IF CapacityOffset:A_ID; add
        CapacityStats:C_ID:A_ID = (CapacityStats:C_ID:A_ID+CapacityOffset:A_ID)
    ENDIF

    ;set max after all modifiers, this way a hediff early in the list that sets max low won't be fatal with other hediffs that set cons.
    SIF CapacityMax:A_ID
        CapacityStats:C_ID:A_ID = MIN(CapacityStats:C_ID:A_ID,CapacityMax:A_ID)
        ; DEBUGPRINTFORML chara {C_ID} | cap {A_ID} is 0!
NEXT

;if consciousness, breathing, blood filter/pump is at 0
SIF CapacityStats:C_ID:0 <= 0 || CapacityStats:C_ID:6 <= 0 || CapacityStats:C_ID:7 <= 0 || CapacityStats:C_ID:8 <= 0
    SETBIT HealthFlags:C_ID:0,HealthFlags_WillDieAfterCheck

;torso overkilled
SIF BODY_PARTS_HEALTH(C_ID, 40) <= -250
    CFLAG:C_ID:300 = 1100

;and other shit

IF GETBIT(HealthFlags:C_ID:0,HealthFlags_WillDieAfterCheck)
    CALL SET_HISTORY_DEATH(C_ID)
ELSEIF CapacityStats:C_ID:0 < 30
    IF C_ID == MASTER
        PRINTL (<30% Consciousness)
        PRINTFORMW Your body can't seem to continue on, causing you to faint...
        PRINTFORML 
        CALL OYASUMI
    ELSE
        SIF CFLAG:C_ID:300 == CFLAG:MASTER:300 && SHIRAHU(C_ID)
        PRINTFORML %CALLNAME:C_ID% faints from low consciousness.
    ENDIF
    CFLAG:C_ID:衰弱 = 60
    CALL CHARA_ACTION_FAINT(C_ID)
ENDIF

CALL CrippledHandDisarm(C_ID)



; IF HasBionicPart(C_ID,61)
; PALAM:C_ID:苦痛 = 0
; ENDIF

; ;Pain
IF BASE:C_ID:Agony && SHIRAHU(C_ID)
	SELECTCASE AGONY_STAGE(C_ID)
    CASE 5
        CFLAG:C_ID:衰弱 = 60
        IF C_ID == MASTER
            SETCOLOR C_RED
            PRINTFORML Unable to cope with the overwhelming pain, you faint and fall into a pain shock.
            RESETCOLOR
        ELSEIF CFLAG:MASTER:現在位置 == CFLAG:C_ID:現在位置
            SETCOLOR C_RED
            PRINTFORML %CALLNAME:C_ID% falls into a pain shock from too much pain.
            RESETCOLOR
        ENDIF
        CALL CHARA_ACTION_FAINT(C_ID)
    CASE 4
        IF C_ID == MASTER
            SETCOLOR C_RED
            PRINTFORML Your intense pain is too much for your feeble body to cope.
            PRINTFORML Even moaning and tearing up feels difficult.
            RESETCOLOR
        ELSE
            SETCOLOR C_RED
            PRINTFORML %CALLNAME:C_ID% moans and tears up, clearly in intense pain.
            RESETCOLOR
        ENDIF
    CASE 3
        IF C_ID == MASTER
            SETCOLOR C_ORANGE
            PRINTFORML The amount of pain you're experiencing stresses your body.
            PRINTFORML It feels harder to do anything.
            RESETCOLOR
        ELSE
            SETCOLOR C_ORANGE
            PRINTFORML %CALLNAME:C_ID% grimaces, grabbing the injured body part.
            RESETCOLOR
        ENDIF
    CASE 2
        IF C_ID == MASTER
            SETCOLOR C_YELLOW
            PRINTFORML Your body aches in pain, distracting you from everything you do.
            RESETCOLOR
        ENDIF
    CASE 1
        IF C_ID == MASTER
            PRINTFORML A mild pain lingers in your body.
        ENDIF
    ENDSELECT
ENDIF

;bleeding
IF TCVAR:C_ID:Bleeding
    LOCAL:3 = Lapse*(1*TCVAR:C_ID:Bleeding)
    BASE:C_ID:Blood -= LOCAL:3

    IF C_ID == MASTER
    SETCOLOR C_RED
    PRINTFORML You bleed out %TOSTR(LOCAL:3)%ml of blood...
    RESETCOLOR
    ENDIF
    SIF BASE:C_ID:Blood <= 0
    	CALL SET_HISTORY_DEATH(C_ID,KilledBy:C_ID:0,"Bleeding") 
ENDIF	

PeeHold:C_ID:1 = CapacityStats:C_ID:10
PooHold:C_ID:1 = CapacityStats:C_ID:11

PeeHold:C_ID:2 = MAX(PeeHold:C_ID:0 + PeeHold:C_ID:1,-5)
PooHold:C_ID:2 = MAX(PooHold:C_ID:0 + PooHold:C_ID:1,-5)


;checks if the character will die due to injury
@CharWillDieAfterCheck(ARG)
#FUNCTION
FOR LOCAL,0,100
    SIF BDY_PART_NAME(LOCAL) == ""
        CONTINUE
    
    ;check them hediffs
    LOCAL:1 = DT_SELECT(@"Hediff", @"chara = {ARG} and part = {LOCAL}",, tempHediffList)
    IF LOCAL:1
        FOR LOCAL:2, 0, LOCAL:1
            LOCAL:3 = DT_CELL_GET(@"Hediff", tempHediffList:(LOCAL:2), "type",1)
            LOCAL:4 = GetHediffStage(ARG,tempHediffList:(LOCAL:2))
            SIF GET_INT(ARG, "Hediff", (LOCAL:3), TOSTR(LOCAL:4)+"/Fatal")
                RETURNF 1
        NEXT
    ELSE
        CONTINUE
    ENDIF
    IF IsPartDestroyed(ARG,LOCAL)
        ;head, heart or torso
        SIF GROUPMATCH(LOCAL,1,11,40)
            RETURNF 1
    ENDIF
NEXT
;if consciousness, breathing, blood filter/pump is at 0
SIF CapacityStats:ARG:0 <= 0 || CapacityStats:ARG:6 <= 0 || CapacityStats:ARG:7 <= 0 || CapacityStats:ARG:8 <= 0
    RETURNF 3
;
SIF MAX(((5*(TCVAR:ARG:Bleeding))-120),0)
    RETURNF 2
RETURNF 0


