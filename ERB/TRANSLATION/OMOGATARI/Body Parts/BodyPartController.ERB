;Adds overdose strength by power of drug.
;100 is FATAL
@AddOverdoseGain(ARG,drugPower,drugGiver=-1,drugName)
#FUNCTION
#DIM DYNAMIC drugPower
#DIM DYNAMIC drugGiver
#DIMS DYNAMIC drugName
SIF drugGiver == -1
	drugGiver = ARG
drugPower = 950
DEBUGPRINTFORML %CALLNAME:ARG% took a drug and increased their overdose gain by {drugPower}\%

IF DT_SELECT(@"Hediff", @"chara = {ARG} and type = 41")
	LOCAL = RESULT:1
	DT_CELL_SET @"Hediff", LOCAL, "severity", DT_CELL_GET(@"Hediff", LOCAL, "severity",1)+drugPower, 1
	DT_CELL_SET @"Hediff", LOCAL, "owner", drugGiver, 1
	DT_CELL_SET @"Hediff", LOCAL, "cause", drugName, 1
	SIF DT_CELL_GET(@"Hediff", LOCAL, "severity",1) <= 0
		DT_ROW_REMOVE "Hediff", LOCAL
ELSE
	SIF drugPower < 0
		RETURNF
    {
    DT_ROW_ADD @"Hediff",
    "chara", ARG,
    "part", 0,
    "type", 41,
    "severity", drugPower,
    "tended", 0,
    "bleeding", 0,
    "owner", drugGiver,
    "cause", drugName,
    "permanent", 0,
    }
ENDIF
SIF drugPower <= 0
    RETURNF
KilledBy:ARG:0 = drugGiver
KilledWith:ARG:0 = %drugName%
LastHediff:ARG = 41

