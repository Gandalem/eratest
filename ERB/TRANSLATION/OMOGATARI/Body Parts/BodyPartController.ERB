CASE "rarm"
    SELECTCASE RAND:3
    CASE 0
        CALLF DamageBodyPart(ARG,30,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
    CASE 1
        CALLF DamageBodyPart(ARG,32,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
    CASE 2
        CALLF DamageBodyPart(ARG,33,DMG,DMG_TYPE,nDealer,nItem, nPerm, nCritical ? 400 # 100)
    ENDSELECT
ENDSELECT
