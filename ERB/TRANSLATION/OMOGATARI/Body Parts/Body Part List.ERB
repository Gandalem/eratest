@BDY_PART_NAME(ARG,ARG:1=0)
#FUNCTIONS
SELECTCASE ARG:1
CASE 0
RETURNF BDY_PART_NAME_0(ARG)
CASE 701
RETURNF BDY_PART_NAME_701(ARG)
ENDSELECT

