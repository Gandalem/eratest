@IsBionicPart(ARG,nPart,nHediff)
#FUNCTION
#DIM DYNAMIC nPart
#DIM DYNAMIC nHediff
nHediff = DT_CELL_GET(@"Hediff", HediffGet(ARG,nPart,nHediff), "type", 1)
IF GET_STR(ARG, "Hediff", nHediff, "Hediff Type") == "Bionic"
	SIF GET_INT(ARG, "Hediff", nHediff, "Natural")
		RETURNF 2
	RETURNF 1
ENDIF

@IsDrugHediff(ARG,nPart,nHediff)
#FUNCTION
#DIM DYNAMIC nPart
#DIM DYNAMIC nHediff
nHediff = DT_CELL_GET(@"Hediff", HediffGet(ARG,nPart,nHediff), "type", 1)
SIF GET_STR(ARG, "Hediff", nHediff, "Hediff Type") == "Drug"
	RETURNF 1

@IsDiseaseHediff(ARG,nPart,nHediff)
#FUNCTION
