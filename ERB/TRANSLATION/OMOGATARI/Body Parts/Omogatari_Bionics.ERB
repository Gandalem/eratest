@AddBionic(ARG,nPart,nBionic,reclaimPart = 1)
#FUNCTION
#DIM DYNAMIC nPart
#DIM DYNAMIC nBionic
#DIM DYNAMIC nHediff
#DIM DYNAMIC reclaimPart
#DIM H_ID
VARSET tempHediffList
IF reclaimPart && GET_INT(MASTER, "Hediff", nBionic+100, "Replaces Other Bionics")
	IF !IsBionicPart(ARG,nPart,0)
		$CanReclaimPart
		HasNaturalPart:nPart ++
	ELSEIF !GET_INT(MASTER, "Hediff", DT_CELL_GET(@"Hediff", HediffGet(ARG,nPart,0), "type", 1), "Replaces Other Bionics")
		GOTO CanReclaimPart
	ENDIF
ENDIF
CALLF BodyPartParent(nPart)
FOR LOCAL,0,20
SIF !BodyPartChildren:LOCAL
	CONTINUE
FOR LOCAL:3,0, DT_SELECT(@"Hediff", @"chara = {ARG} and part = {(BodyPartChildren:LOCAL)}",,tempHediffList)
;prevent duplicated parts
SIF DT_CELL_GET(@"Hediff", tempHediffList:(LOCAL:3), "type", 1) == nBionic+100
	RETURNF
SIF !GET_INT(MASTER, "Hediff", nBionic+100, "Replaces Other Bionics") && IsBionicPart(ARG,(BodyPartChildren:LOCAL),(LOCAL:3))
	CONTINUE
SIF IsBionicPart(ARG,(BodyPartChildren:LOCAL),(LOCAL:3)) && reclaimPart
	HasBionic:(DT_CELL_GET(@"Hediff", tempHediffList:(LOCAL:3), "type", 1)) ++
CALLF ClearHediff(ARG,BodyPartChildren:LOCAL,LOCAL:3)
NEXT
;don't give hediff for natural replacements
SIF !nPart
	CONTINUE
;bionics only for main parts. subparts get "removed" but aren't actually
IF LOCAL == 0
	BodyPartRemoved:ARG:(BodyPartChildren:LOCAL) = 0
	DT_ROW_ADD @"Hediff", "chara", ARG, "part", (BodyPartChildren:LOCAL), "type", 100+nBionic, "severity", 1, "tended", 0, "bleeding", 0, "owner", ARG, "cause", "Surgery", "permanent", 0,
ELSE
	SIF GET_INT(ARG, "Hediff", nBionic+100, "Replaces Other Bionics") && !GET_INT(ARG, "Hediff", nBionic+100, "Natural")
		BodyPartRemoved:ARG:(BodyPartChildren:LOCAL) = 1
ENDIF
NEXT
RETURNF 1
;code that checks if a part is bionic

@PartOrChildIsBionic(C_ID, P_ID, CHK_FOR_REMOVAL=0)
#FUNCTION
#DIM DYNAMIC C_ID
#DIM DYNAMIC P_ID
#DIM DYNAMIC CHK_FOR_REMOVAL
;return negative if the parent is not dead
CALLF BodyPartParentFromChild(P_ID)
SIF BodyPartChildren:0 == P_ID && CHK_FOR_REMOVAL
	RETURNF 0
IF IsBionicPart(C_ID,BodyPartChildren:0,0) == 1 && BodyPartHealth:C_ID:(BodyPartChildren:0):0 > -BodyPartHealth:C_ID:(BodyPartChildren:0):1 && !BodyPartRemoved:C_ID:(BodyPartChildren:0)
	RETURNF 1
ENDIF
RETURNF 0

@BionicConflictMenu(ARG,nBionic, giveBack = 1)
#DIM DYNAMIC nBionic
#DIM DYNAMIC nPart
#DIM DYNAMIC giveBack
#DIM DYNAMIC nHasBionicParts,2
#DIM DYNAMIC gotHediffs, 100
#DIM DYNAMIC gotHediffs2, 100
nPart = GET_INT(ARG, "Hediff", nBionic, "Part")
CALLF ConflictingParts(nPart)
IF ConflictingPartChoices:1
	PRINTFORML 이 %GET_STR(ARG, "Hediff", (nBionic), "名前")%를 넣을 수 있는 여러 곳이 있다.
	FOR LOCAL,0, 100
	SIF ConflictingPartChoices:LOCAL && BDY_PART_NAME(ConflictingPartChoices:LOCAL) != ""
		PRINTFORML [{ConflictingPartChoices:LOCAL}] - %BDY_PART_NAME(ConflictingPartChoices:LOCAL)%
	NEXT
	PRINTFORML [-1] 취소
	INPUT
	IF RESULT != -1
		nPart = RESULT
	ELSE
		RETURN 0
	ENDIF
ENDIF
LOCAL = 0
IF GET_INT(MASTER, "Hediff", nBionic, "Replaces Other Bionics")
	LOCALS =
	PRINTFORM %GET_STR(MASTER, "Hediff", (nBionic), "名前")%를 추가하면 %CALLNAME:ARG%의 모든 것을 제거한다. 
	CALLF BodyPartParent(nPart)
	FOR LOCAL:1,0,20
	SIF !BodyPartChildren:(LOCAL:1)
		CONTINUE
	LOCALS += @"%BDY_PART_NAME(BodyPartChildren:(LOCAL:1))%、"
	NEXT
	PRINTFORML %LIST_IN_STRING(LOCALS)%
	IF !IsBionicPart(ARG,nPart,0)
		$CanReclaimPartText
		PRINTFORML 자연적인 부품이므로 자연적인 %BDY_PART_NAME(nPart)%를 얻는다.
	ELSEIF !GET_INT(MASTER, "Hediff", DT_CELL_GET(@"Hediff", HediffGet(ARG,nPart,0), "type", 1), "Replaces Other Bionics")
		GOTO CanReclaimPartText
	ENDIF
	PRINTL
	X = DT_SELECT(@"Hediff", @"chara = {ARG} and part = {nPart}", , gotHediffs)
	FOR LOCAL:3,0,X
	IF DT_CELL_GETS(@"Hediff", gotHediffs:(LOCAL:3), "Hediff Type", 1) == "Bionic"
		IF !nHasBionicParts
			PRINTFORML 다음 바이오닉 부품들은 \@ giveBack ? 당신의 인벤토리로 회수된다 # 사라진다 \@:
			FOR LOCAL:1,0,20
			SIF !BodyPartChildren:(LOCAL:1)
				BREAK
			Y = DT_SELECT(@"Hediff", @"chara = {ARG} and part = {BodyPartChildren:(LOCAL:1)}", , gotHediffs2)
			FOR LOCAL:3,0,Y
			SIF DT_CELL_GET(@"Hediff", gotHediffs2:(LOCAL:3), "type", 1) < 100
				CONTINUE
			PRINTFORML ・%GET_STR(MASTER, "Hediff", DT_CELL_GET(@"Hediff", gotHediffs2:(LOCAL:3), "type", 1), "名前")%
			NEXT
			NEXT
			nHasBionicParts = 1
		ENDIF
	ENDIF
	NEXT
ENDIF
PRINTFORMW %GET_STR(MASTER, "Hediff", (nBionic), "名前")%를 %BDY_PART_NAME(nPart)%에 추가한다.
CALLF AddBionic(ARG,nPart,nBionic-100)
RETURN RESULT

