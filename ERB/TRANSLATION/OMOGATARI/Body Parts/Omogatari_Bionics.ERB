@ConflictingParts(ARG)
#FUNCTION
VARSET ConflictingPartChoices
SELECTCASE ARG
	CASE 0
		FOR LOCAL,0,100
		ConflictingPartChoices:LOCAL = LOCAL
		NEXT
	CASE 5
		ConflictingPartChoices:0 = 5
		ConflictingPartChoices:1 = 6
	CASE 20
		ConflictingPartChoices:0 = 20
		ConflictingPartChoices:1 = 30
	CASE 23
		ConflictingPartChoices:0 = 23
		ConflictingPartChoices:1 = 33
	CASE 41
		ConflictingPartChoices:0 = 41
		ConflictingPartChoices:1 = 43
	CASE 45
		ConflictingPartChoices:0 = 45
		ConflictingPartChoices:1 = 46
	CASE 75
		ConflictingPartChoices:0 = 75
		ConflictingPartChoices:1 = 76
	CASE 81
		ConflictingPartChoices:0 = 81
		ConflictingPartChoices:1 = 91
	CASE 83
		ConflictingPartChoices:0 = 83
		ConflictingPartChoices:1 = 93
	CASEELSE
		ConflictingPartChoices:0 = ARG
		RETURNF 0
ENDSELECT
RETURNF 1
