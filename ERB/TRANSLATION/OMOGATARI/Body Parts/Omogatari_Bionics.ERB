@BIONIC_CONFIG_BLADDER(ARG, nRange = 2, nPart = 1)
#DIM nRange
#DIM nPart

C = TALENT:ARG:(95+nPart)
PRINTFORML Please select a \@ nPart == 2 ? bowel # bladder \@ size (Current Size: %TOSTR_BLADDERSIZE(C)%)
FOR LOCAL, -nRange, nRange+1
	SIF STRLENS(TOSTR_BLADDERSIZE(LOCAL))
		PRINTFORML [{LOCAL, 2}] - %TOSTR_BLADDERSIZE(LOCAL)%
NEXT
PRINTL
PRINTFORML [999] - Return
INPUT
SELECTCASE RESULT
CASE -nRange TO nRange
	TALENT:ARG:(95+nPart) = RESULT
	PRINTFORMW \@ nPart == 2 ? Bowel # Bladder \@ size changed to %TOSTR_BLADDERSIZE(RESULT)%
	CALLF ResetBladders(ARG)
ENDSELECT

