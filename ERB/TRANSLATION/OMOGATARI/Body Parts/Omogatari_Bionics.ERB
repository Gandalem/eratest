@BIONIC_CONFIG_BLADDER(ARG, nRange = 2, nPart = 1)
#DIM nRange
#DIM nPart
C = TALENT:ARG:(95+nPart)
PRINTFORML \@ nPart == 2 ? 장 # 방광 \@ 크기(현재 크기: %TOSTR_BLADDERSIZE(C)% )를 선택해 주세요.
FOR LOCAL, -nRange, nRange+1
SIF STRLENS(TOSTR_BLADDERSIZE(LOCAL))
	PRINTFORML [{LOCAL, 2}] - %TOSTR_BLADDERSIZE(LOCAL)%
NEXT
PRINTL
PRINTFORML [999] - 반환
INPUT
SELECTCASE RESULT
	CASE -nRange TO nRange
		TALENT:ARG:(95+nPart) = RESULT
		PRINTFORMW \@ nPart == 2 ? 장 # 방광 \@ 크기가 %TOSTR_BLADDERSIZE(RESULT)%로 변경되었다.
		CALLF ResetBladders(ARG)
ENDSELECT

