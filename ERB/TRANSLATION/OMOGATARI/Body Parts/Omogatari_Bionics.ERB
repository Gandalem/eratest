;more through check
@charaBodyPartIsBionic(C_ID,P_ID)
#FUNCTION
#DIM C_ID
#DIM P_ID
#DIM DYNAMIC H_ID
#DIM DYNAMIC H_DEF
#DIM DYNAMIC H_LOOP
#DIM DYNAMIC H_LIST, 1000

FOR H_LOOP,0,DT_SELECT(@"Hediff", @"chara = {C_ID} and part = {P_ID}", "", H_LIST)
    H_ID = H_LIST:(H_LOOP)
    SIF BodyPartRemoved:C_ID:(DT_CELL_GET(@"Hediff", H_ID, "part", 1))
        CONTINUE
    H_DEF = DT_CELL_GET(@"Hediff", H_ID, "type", 1)

	IF GET_STR(C_ID,"Hediff", H_DEF, "Hediff Type") == "Bionic"
		IF GET_INT(C_ID, "Hediff", (H_DEF), "Natural")
			CONTINUE
		ELSEIF GET_INT(C_ID, "Hediff", (H_DEF), "Replaces Other Bionics")
			RETURNF H_ID
		ENDIF
	ENDIF
NEXT
RETURNF 0