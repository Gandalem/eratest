@GET_BIONIC(ITEM_ID, ITEM_NUM, PRINT_TYPE)
#DIM ITEM_ID
#DIM ITEM_NUM
#DIM PRINT_TYPE;表示形式　0=通常　1=L　2=W
IF GET_STR(0, "Hediff", ITEM_ID, "名前") == ""
	PRINTFORML {ITEM_ID}는 존재하지 않는다.
ENDIF
DEBUGPRINTFORML 바이오닉 이름: %GET_STR(0, "Hediff", ITEM_ID, "名前")%, 아이디: {ITEM_ID}
IF HasBionic:ITEM_ID + ITEM_NUM >= 100
	;custom code
	CALL COLORMESSAGE(@"Got \@ STRCOUNT(GET_STR(0, "Hediff", ITEM_ID, "名前"), "s$") ? %GET_STR(0, "Hediff", ITEM_ID, "名前")% # %ARTICLE(GET_STR(0, "Hediff", ITEM_ID, "名前"))%\@", C_YELLOW, PRINT_TYPE)
	HasBionic:ITEM_ID = MAX(HasBionic:ITEM_ID, 99)
ELSE
	CALL COLORMESSAGE(@"{ITEM_NUM} %GET_STR(0, "Hediff", ITEM_ID, "名前")%을 얻었다.", C_YELLOW, PRINT_TYPE)
	HasBionic:ITEM_ID += ITEM_NUM
ENDIF

@GET_BDY_PART(ITEM_ID, ITEM_NUM, PRINT_TYPE)
#DIM ITEM_ID
#DIM ITEM_NUM
#DIM PRINT_TYPE;表示形式　0=通常　1=L　2=W
IF BDY_PART_NAME(ITEM_ID) == ""
	PRINTFORML {ITEM_ID}가 존재하지 않는다.
ENDIF
DEBUGPRINTFORML 부위 이름: %BDY_PART_NAME(ITEM_ID)%, ID: {ITEM_ID}
IF HasNaturalPart:ITEM_ID + ITEM_NUM >= 100
	;custom code
	CALL COLORMESSAGE(@"Got \@ STRCOUNT(BDY_PART_NAME(ITEM_ID), "s$") ? %BDY_PART_NAME(ITEM_ID)% # %ARTICLE(BDY_PART_NAME(ITEM_ID))%\@", C_YELLOW, PRINT_TYPE)
	HasNaturalPart:ITEM_ID = MAX(HasNaturalPart:ITEM_ID, 99)
ELSE
	CALL COLORMESSAGE(@"{ITEM_NUM}의 %BDY_PART_NAME(ITEM_ID)%을 얻었다.", C_YELLOW, PRINT_TYPE)
	HasNaturalPart:ITEM_ID += ITEM_NUM
ENDIF

