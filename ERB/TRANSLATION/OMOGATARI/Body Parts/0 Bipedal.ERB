@BDY_PART_DESC_0(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "몸 전체입니다. 전신에 영향을 주며 특정 부위를 직접 손상시키는 형태가 아닌 건강 이상에 사용됩니다."
	CASE 1
		RETURNF "인간에게 가장 중요한 부위 중 하나입니다. 귀, 뇌, 이마, 뺨, 턱, 눈, 코, 입이 포함됩니다. 머리를 잃으면 즉사합니다."
	CASE 2
		RETURNF "외형과 미관에 영향을 주는 부위입니다."
	CASE 3
		RETURNF ""
	CASE 4
		RETURNF "시각을 담당하는 부위입니다. 시력을 잃으면 실명하며, 시야 상실은 명중률에도 큰 영향을 줍니다."
	CASE 5, 6
		RETURNF "소리를 듣게 해 주는 부위입니다. 한쪽 귀를 잃으면 청력이 저하되고, 양쪽 귀를 모두 잃으면 들을 수 없게 됩니다."
	CASE 7
		RETURNF ""
	CASE 8
		RETURNF "혀와 목구멍이 이어지는 부위이며, 말하고 먹는 데 사용됩니다."
	CASE 9
		RETURNF "맛을 느끼고 말을 하는 데 중요한 부위입니다. 혀를 잃으면 말을 할 수 없게 됩니다."
	CASE 10
		RETURNF ""
	CASE 11
		RETURNF "머리와 나머지 신체 사이로 혈액이 순환하게 해 주는 매우 중요한 부위입니다. 목은 출혈에도 매우 취약하며, 심한 출혈이 발생하면 몇 분 안에 사망할 수 있습니다"
	CASE 12
		RETURNF "머리 안에 있는 생명 유지에 필수적인 부위입니다. 의식에 가장 큰 영향을 주며, 뇌 손상은 의식 상태에 직접적인 영향을 줍니다. 이 부위는 -100%가 아니라 0%가 되면 사망합니다"
	CASE 20 TO 23, 30 TO 33
		RETURNF "물건을 잡는 데 사용하는 부위입니다. 양손 무기를 사용하려면 양쪽 팔이 모두 정상적으로 기능해야 합니다. 팔이나 손이 없으면 아무것도 들 수 없습니다. 팔에 치명타를 입으면 동맥 출혈이 발생하며, 출혈량이 많아 일반 출혈보다 훨씬 위험합니다. "
	CASE 40
		RETURNF "몸의 중심부인 몸통입니다. 생명 유지에 필요한 여러 장기를 포함하며, 흉부를 잃으면 즉사합니다."
	CASE 41 TO 44
		RETURNF "모유를 분비하는 부위이며 생식 관련 능력에도 영향을 줍니다."
	CASE 45, 46
		RETURNF "호흡을 담당합니다. 양쪽 폐를 모두 잃으면 즉사하지만 한쪽 폐만으로도 생존할 수 있습니다."
	CASE 47
		RETURNF "혈액을 온몸으로 순환시키는 핵심 장기입니다. 이 부위는 -100%가 아니라 0%가 되면 사망합니다."
	CASE 51
		RETURNF ""
	CASE 52
		RETURNF "몸통의 중간 부위입니다."
	CASE 53
		RETURNF "소화 과정에서 음식물을 저장하는 부위입니다. 이 부위를 잃으면 배변 조절에 심각한 문제가 생깁니다."
	CASE 54
		RETURNF "과거 탯줄이 연결되어 있던 흔적입니다."
	CASE 55
		RETURNF "척추가 위치한 등 부위입니다. 척추가 크게 손상되면 움직일 수 없게 될 수 있습니다."
	CASE 56, 57
		RETURNF "일반적인 비행을 가능하게 하는 등 쪽의 부속 기관입니다. 날개가 없어도 요술을 이용한 비행은 가능합니다."
	CASE 58
		RETURNF ""
	CASE 60
		RETURNF "양쪽 다리를 연결하는 하체 중심부입니다. 골반이 심하게 손상되면 움직일 수 없게 될 수 있습니다."
	CASE 61
		RETURNF "생식기가 위치하는 부위입니다."
	CASE 62 TO 64
		RETURNF "여성 생식계에 해당하며 태아가 자라는 데 관여합니다. 임신과 출산을 위해 중요한 부위입니다."
	CASE 65
		RETURNF "앉을 때 몸을 받쳐 주는 부위입니다."
	CASE 66
		RETURNF "배출할 때까지 노폐물을 유지하는 데 관여합니다. 이 부위를 잃으면 배변 조절이 불가능해질 수 있습니다."
	CASE 67
		RETURNF "고형 노폐물을 저장하는 부위입니다. 이 부위를 잃으면 배변 조절이 불가능해질 수 있습니다."
	CASE 68 TO 71
		RETURNF "남성 생식계에 해당하며 정자를 생성·보관하고 생식에 관여합니다. 임신을 원한다면 중요한 부위입니다."
	CASE 72
		RETURNF "소변이 지나가는 통로입니다. 이 부위를 잃으면 배뇨 조절에 심각한 문제가 생깁니다."
	CASE 73
		RETURNF "동물처럼 몸 뒤쪽에 이어진 부위로, 움직임에 따라 흔들립니다."
	CASE 74
		RETURNF "소변을 저장하는 장기입니다. 이 부위를 잃으면 소변을 참을 수 없게 됩니다."
	CASE 75, 76
		RETURNF "노폐물을 걸러 소변으로 배출하는 장기입니다. 양쪽 신장을 모두 잃으면 사망하지만 한쪽만으로도 생존할 수 있습니다."
	CASE 77
		RETURNF "혈액을 정화하고 여러 대사 기능을 담당하는 장기입니다. 이 부위가 0% 이하가 되면 즉사합니다."
		;	CASE 80
		;		RETURNF "L leg"
	CASE 81 TO 83, 91 TO 93
		RETURNF "이동에 사용하는 부위입니다. 다리를 다치면 이동 속도가 느려집니다. 다리가 없거나 묶여 있으면 정상적으로 이동할 수 없습니다. 다리에 치명타를 입으면 동맥 출혈이 발생하며, 출혈량이 많아 일반 출혈보다 훨씬 위험합니다."
ENDSELECT
