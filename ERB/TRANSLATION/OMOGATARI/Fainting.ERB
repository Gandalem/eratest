; uses dead drunk code but for if a character gets under 0 stamina
@CHARA_ACTION_FAINT(ARG)
SIF IsDead:ARG:0
	RETURN

SIF !CFLAG:ARG:衰弱 && BASE:ARG:体力 <= 0
	CFLAG:ARG:衰弱 = 360
IF CFLAG:ARG:衰弱
	CALL ENDUFUFU(ARG)
	CFLAG:ARG:睡眠 = 1
	TCVAR:睡眠深度 = PALAMLV:15
	;仕事内容が宴会参加の場合
	IF CFLAG:ARG:職種 == 49
		;仕事内容を酔いつぶれるに変更
		CFLAG:ARG:職種 = 51
		CFLAG:ARG:職場 = TFLAG:宴会場
		CFLAG:ARG:行動 = 5
	ELSE
	ENDIF

	IF CFLAG:MASTER:現在位置 == CFLAG:ARG:現在位置
		IF CFLAG:ARG:職種 == 51
			PRINT 　
		ENDIF
		;SIF BASE:ARG:体力 <= 0
		;PRINTFORML %CALLNAME:ARG% faints from running out of strength.
	ENDIF
ENDIF


@InSexNegativeStaminaWarning(ARG)
SIF !nNecro
	RETURN 0
SIF IsDead:ARG:0
	RETURN 0 

PRINTFORML WARNING: %CALLNAME:ARG% is at {BASE:ARG:0*100/MAXBASE:MASTER:0}\%
PRINTFORML If %CALLNAME:ARG% reaches -100\% ({-MAXBASE:MASTER:0}) STA, %HE_SHE(ARG)% will die.
FORCEWAIT