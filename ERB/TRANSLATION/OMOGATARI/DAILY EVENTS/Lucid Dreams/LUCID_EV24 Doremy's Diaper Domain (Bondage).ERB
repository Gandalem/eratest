			ENDIF
			CALL PRINT_GP("L", @"스트레칭을 끝낸 후, %HE_SHE(109)%는 당신의 팔을 의자에 되돌린다.")
			DAILY_Lucid_Stats:6 = 0
			DAILY_Lucid_Stats:7 = 3
			SETBIT DAILY_Lucid_Stats:11,1
		CASE 2
			; SIF GETBIT(DAILY_Lucid_Stats:11,DAILY_Lucid_Stats:6)
			; 	GOTO RerollChallenge
