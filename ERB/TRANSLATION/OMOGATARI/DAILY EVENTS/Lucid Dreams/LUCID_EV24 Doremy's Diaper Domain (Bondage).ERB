CALL PRINT_GP("W", @"%CALLNAME:109%가 당신에게 다가와 당신의 성기 부위를 살짝 짓누른다.")
IF nOmutsu
	CALL LUCID_EV27_DIAperChange(MASTER)
	CALL PRINT_GP("W", @"기저귀의 구겨짐과 부피가 존재하며, 당신의 %PRINT_CLIT(MASTER)%이 기저귀에 쓸리는 감각을 느낀다.")
	;CALL PRINT_GPC("W", @"「No worries, you're wearing a diaper. You don't have to hold it when you have to go potty, just let go and relax...」", 109)
ELSE
	CALL PRINT_GP("W", @"당신의 %PRINT_CLIT(MASTER)%가 속옷에 비벼지는 감각은 모든 보호받는 느낌을 부정한다.")
ENDIF
CALL PRINT_GPC("W", @"「어라, %CALLNAME:MASTER%. 어떻게 이런 상황에 처한 거야?」", 109)
CALL PRINT_GPC("W", @"「치정스러운 즐거움을 드러낼 것 같은 얼굴이네~」", 109)
CALL PRINT_GPC("W", @"「의자에 묶인 채로, \@ DAILY_Lucid_Stats:2 ? 장이 # 방광이 터지기 직전이다. \@」", 109)
CALL PRINT_GPC("W", @"「아기처럼 %HIS_HER(MASTER)%가 \@ DAILY_Lucid_Stats:2 ? 대변을 보지 않으려고 # 소변을 본다 \@ %PeeProtectType(MASTER,2)%로 몸을 비튼다.」", 109)
PRINTL
CALL PRINT_GPC("W", @"「이제 품위 있는 안정을 원한다면, 10가지 도전을 견뎌야 한다.」", 109)
CALL PRINT_GPC("W", @"「이걸 일찍 끝내고 싶다면, 안도감을 구걸하거나 당신의 치정적인 쾌락을 인정하고 \@ DAILY_Lucid_Stats:2 ? 대변을 본다 # 소변을 본다 \@ 당신의 %PeeProtectType(MASTER,2)%.」", 109)
CALL PRINT_GPC("W", @"「도전 과제를 많이 할수록, 당신의 안도감은 더욱 고귀해진다.」", 109)
PRINTFORMW 만약 네가 \@ nOmutsu ? 이 기저귀를 더럽히는 것 # 온몸에 지저분하게 만드는 것을 원하지 않는다면, 빠져나갈 방법을 찾거나 끝까지 버텨야 한다. \@
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 0)
	CALL DRINK(MASTER, 750)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 0)
	CALL EAT(MASTER, 750)
ENDIF
CALLF TP(109)
DAILY_Lucid_Stats:6 = 0
DAILY_Lucid_Stats:7 = 3
DAILY_Lucid_Stats:12 = 0
