					CALL PRINT_GPC("L", @"「마침내 21시에 나는 드디어 긴장을 풀 수 있었다. 하루 종일 물을 한 병밖에 마시지 못했지만 두 병을 마신 후 침대에서 거의 기절하듯 쓰러졌다.」", 109)
					CALL PRINT_GPC("L", @"「나는 한밤중에 완전히 방광이 터질 듯한 상태로 잠에서 깨어났다.」", 109)
					CALL PRINT_GPC("L", @"「마지막으로 소변 본 지 15시간이 넘었고, 방광에 세 병 분량의 오줌이 차 있다.」", 109)
					CALL PRINT_GPC("L", @"「나는 터지기 전에 화장실에 가려고 침대에서 뛰쳐나갔지만, 더 이상 참을 수 없었다.」", 109)
					CALL PRINT_GPC("L", @"「일어선 순간, 소변의 폭포가 나에게서 뿜어져 나오기 시작했다.」", 109)
					CALL PRINT_GPC("L", @"「나는 바지가 젖는 와중에도 가득 차 있던 방광이 마침내 비워지는 느낌을 즐기며 그저 서 있을 수밖에 없었다.」", 109)
					CALL PRINT_GPC("L", @"「모든 것을 꺼내는 데 두 분 이상이 걸렸고, 그 결과 바닥은 내 바지보다 더 흥건해졌다.」", 109)
