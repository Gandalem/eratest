DAILY_Lucid_Type '= "Nightmare"
DAILY_Lucid_CanDo = (DAILY_Lucid_Stats:1 || DAILY_Lucid_Stats:2)
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1"
