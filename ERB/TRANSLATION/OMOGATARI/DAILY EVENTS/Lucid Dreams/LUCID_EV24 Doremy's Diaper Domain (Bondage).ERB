			CALL PRINT_GP("L", @"%CALLNAME:109%은 의자에서 당신의 팔을 풀고 자신의 팔로 당신의 팔을 %HE_SHE(109)%가 할 수 있는 가장 높은 곳까지 함께 들어 올린다.")
			CALL PRINT_GP("L", @"%HE_SHE(109,1)%은 너를 의자에 기대게 만들어서 더 이상 기댈 수 없게 만든다.")
			CALL PRINT_GP("L", @"당신은 스트레칭 중에 %PeeAndPoo(DAILY_Lucid_Stats:1, DAILY_Lucid_Stats:2, "방광", "장")%의 통증을 느낄 수 있다.")
