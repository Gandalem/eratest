;----------------------------
;Info for the dream
;----------------------------
 @LUCID_DREAM_INFO_26
 #FUNCTION

DAILY_Lucid_Name '= @"%CALLNAME:109%'s Clone Search"
{
DAILY_Lucid_Desc '= @"Work in Progress\n
Find the right copy of %CALLNAME:109% in time, or else you'll have a shameful accident in the dream AND in bed."
}
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = (DAILY_Lucid_Stats:1 || DAILY_Lucid_Stats:2) && nOmutsu
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "62/10"
DAILY_Lucid_CanGiveUp = 1

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_26
DAILY_Lucid_Stats:7 = TIME + 120
DAILY_Lucid_Stats:10 = RAND(16)
DAILY_Lucid_Stats:6 = 0
DAILY_Lucid_Stats:11 = 0
LOCAL = FIRSTTIME("LUCID_EV_26")
CALL SET_KOJO_COLOR(109)
IF LOCAL
PRINTFORMW 「This %PRINT_MALE("boy")% seems to be a bed wetter and smells like %HE_SHE(MASTER)% could be making a lot of progress...」
ENDIF

PRINTFORMDW You stand in front of %CALLNAME:109%, next to a fountain and a puddle of water.
PRINTFORMDW The place is surrounded by gray concrete walls. 
SIF DAILY_Lucid_Stats:1
CALLF PEEME(MASTER, 5)
SIF DAILY_Lucid_Stats:2
CALLF POOME(MASTER, 5)
CALLF PANTY_REWORK_CHANGE(MASTER,DAILY_LUCID_STATS:8)
CALL SET_KOJO_COLOR(109)
IF LOCAL
	PRINTFORMDW It feels unfamiliar to you, having just been teleported from your bed.
	LOCALS '= @"「Oh! You're finally awake! Now I wonder if you're still asleep in reality.」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
	WAIT
	PRINTFORMDW You ask what this place is, having been sleeping just a few minutes earlier.
	LOCALS '= @"「You're still soundly asleep in your room, but this is a piece of my domain in the dream world.」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)

	WAIT
	PRINTFORMDW You wonder if you sleep in this dream, you'll be able to have a different one instead.
	PRINTL
	PRINTFORMDW The day has ended.
	PRINTDW ・
	PRINTDW ・・
	PRINTDW ・・・
	PRINTL
	LOCALS '= @"「DON'T GO TO SLEEP.」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
	WAIT

	LOCALS '= @"「What are you doing trying to sleep on your own without asking me?!」/"
	LOCALS += @"「I haven't seen a %PRINT_MALE("boy")% this obnoxious in a long time!」/"
	LOCALS += @"「Furthermore, you even made fun of my stature!」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
	WAIT
	PRINTL
	PRINTFORMDW You ask what this dream is?
	PRINTFORMW 「Sure, it's another one of your dreams, but my intervention makes it a little bit more special.」
	PRINTFORMDW You wonder what %HE_SHE(109)% means by a special dream.
	PRINTFORMW 「Yes! Special dreams! More specificly, a %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"pee","poo")% dream」
	PRINTFORMDW You feel a sense a dread as you realize that failing here will result in a humiliating accident.
	PRINTFORMW 「As the ruler of dreams, I can give anyone a dream of my choosing. And it so happens that you'll have a %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"pee","poo")% one today.」
	PRINTL
	LOCALS '= @"「Back to the point, you are a confirmed bed %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wetter","messer")%. I'm giving you a chance.」/"
	LOCALS += @"「If you win the game with me, you can wake up without %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wetting","messing")% the bed!」/"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 109, 0)
	WAIT
	PRINTFORMDW You ask what kind of game it is.
	LOCALS '= @"「There are 16 copies of me in this maze.」/"
	LOCALS += @"「There is only one copy that can save you from %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wetting","messing")% the bed!」/"
	LOCALS += @"「Find it and you win the game. Easy, isn't it?」/"
	LOCALS += @"「Oh yeah! I forgot to mention that there is a time limit.」/"
	LOCALS += @"「Run out of time and you'll have an accident.」/"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
	WAIT
	LOCALS '= @"「Also, you look pretty confident, so let's spice things up a bit then!」/"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
	WAIT
	;CALL NeedForPee(MASTER)
	PRINTL
	LOCALS '= @"「I have a link to your %PeeAndPoo(nPee,nScat,"bladder","bowels")% from the real world.」/"
	LOCALS += @"「This means that an accident in the dream world will result in an accident in reality.」/"
	LOCALS += @"「Keep in mind that having an accident or relieving oneself in this place will end up the same as if you ran out of time.」/"
	LOCALS += @"「You have 120 minutes since it's your first time.」/"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
ELSE
	PRINTFORMW 「Long time no see, %CALLNAME:MASTER%.」
	PRINTFORMDW You feel a sense a dread as it's the same searching dream as last time.
	PRINTFORMW 「You know what to do, go ahead and start looking for it.」
	PRINTL
	PRINTFORMW 「And I almost forgot...」
	RESETCOLOR
	;CALL NeedForPee(MASTER)
	PRINTL
	CALL SET_KOJO_COLOR(109)
	PRINTFORMDW You express your anger to %CALLNAME:109% for making you bursting to go.
	PRINTFORMW 「You look better squirming, desperate for a leak...」
	PRINTL
	PRINTFORMW 「Good luck trying not to %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wet","mess")% the bed.」
	PRINTFORMW 「Timer is 90 minutes this time.」
	DAILY_Lucid_Stats:7 = TIME + 90
ENDIF

	CALL SET_KOJO_COLOR(109)
PRINTFORMW 「See ya, have a wet sleep.」
RESETCOLOR


;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_26
IF DAILY_Lucid_Stats:9 == 10
	CALL DDD_SoiledSelf
ENDIF

;When a command ends
@LUCID_DREAM_TURN_26
IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
	PLAYSOUND "se/間違い.wav"
	FONTBOLD
	SETCOLOR C_RED
	PRINTFORML CAN'T HOLD IT!
	RESETCOLOR
	FONTREGULAR
	FORCEWAIT
	PRINTL
	LOCALS '= @"「Oh dear... you can't hold it in any longer...」/"
	LOCALS += @"「I'm afraid that you'll be waking up to a %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wet","messy")% bed today.」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
	WAIT
	DAILY_Lucid_Stats:9 = 10
	CALL LucidDreamTimeUp()
ENDIF

IF DAILY_Lucid_Stats:7-TIME <= 0
	PLAYSOUND "se/間違い.wav"
	FONTBOLD
	SETCOLOR C_RED
	PRINTFORML TIME UP!
	RESETCOLOR
	FONTREGULAR
	FORCEWAIT
	PRINTL
	LOCALS '= @"「Oh dear... time's up...」/"
	LOCALS += @"「I'm afraid that you'll be waking up to a %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wet","messy")% bed today.」/"
	LOCALS += @"「But before that, I'll make you relieve yourself on the spot, so you'll be empty even in this dream.」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
	WAIT
	DAILY_Lucid_Stats:9 = 10
	CALL LucidDreamTimeUp()
ENDIF

;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_26(nInput)
#DIM nInput
SELECTCASE nInput
CASE 0
	SETBIT DAILY_Lucid_Stats:11, DAILY_Lucid_Stats:6
	IF DAILY_Lucid_Stats:6 == DAILY_Lucid_Stats:10
		PLAYSOUND "se/正解.wav"	
		LOCALS '= @"「Damn! Good for you!」/"
		LOCALS += @"「You'll wake up dry this time!」/"
		LOCALS += @"「But, will you make it next time?」/"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 109, 0)
		WAIT
		LOCALS '= @"「Well then... it's time for you to wake up!」/"
		LOCALS += @"「And...I'll give away a prize for finding the correct statue!」/"
		LOCALS += @"「Enjoy it when you arise!」/"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 109, 0)
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
	ELSE
		PLAYSOUND "se/間違い.wav"
		LOCALS '= @"「Too bad this isn't the right copy, %CALLNAME:MASTER%.」/"
		LOCALS += @"「If you don't hurry up, you won't make it in time.」/"
		{
		CALL CUTSCENESPEAK_NAS(
			@"%LOCALS%"
			, "怒り", 109, 0)
		}
		CALL ASK_YN("Express anger","Leave")
		SELECTCASE RESULT
		CASE 0
			PRINTFORMDW You insult %CALLNAME:109% by telling %HIM_HER(109)% that %HES_SHES(109)% a pervert with a bad personality.
			CALL CUTSCENESPEAK_NAS(@"「Who you calling weird?!」/「I'm putting my line on the line for this one.」/「Get comfortable %CALLNAME:MASTER%, because this is for those who say stuff like that!」", "怒り", 109, 0)
			TIME += 15
			PRINTFORMDW You feel like your desperation has gotten way worse. 
			CALL CUTSCENESPEAK_NAS(@"「You'll be %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wetting","messing")% the bed a bit sooner now.♪」", "怒り", 109, 0)
			WAIT
		CASE 1
		ENDSELECT
	ENDIF
CASE 1
	TIME += RAND(7,20)
	LOCAL:3 = DAILY_Lucid_Stats:6
	$StatueLoop
	DAILY_Lucid_Stats:6 = RAND(16)
	SIF DAILY_Lucid_Stats:6 == LOCAL:3 || GETBIT(DAILY_Lucid_Stats:11, DAILY_Lucid_Stats:6)
		GOTO StatueLoop
ENDSELECT

;----------------------------
;Input names
;----------------------------
@LUCID_DREAM_INPUT_NAMES_26(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
CASE 0
	DAILY_Lucid_ComName '= @"Check Statue"
CASE 1
	DAILY_Lucid_ComName '= @"Move"
ENDSELECT
RETURNF DAILY_Lucid_ComName

