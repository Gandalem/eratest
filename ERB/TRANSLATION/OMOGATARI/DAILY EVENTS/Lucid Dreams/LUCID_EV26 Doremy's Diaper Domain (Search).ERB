;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_26
#FUNCTION
DAILY_Lucid_Name '= @"%CALLNAME:109%의 클론 검색"
DAILY_Lucid_Desc '= @"작업 중\n 제때 %CALLNAME:109%의 올바른 복사본을 찾지 못하면 꿈속과 침대에서 치욕적인 사고를 당할 것이다."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = (DAILY_Lucid_Stats:1 || DAILY_Lucid_Stats:2) && nOmutsu
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "62/10"
DAILY_Lucid_CanGiveUp = 1
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_26
DAILY_Lucid_Stats:7 = TIME + 120
DAILY_Lucid_Stats:10 = RAND(16)
DAILY_Lucid_Stats:6 = 0
DAILY_Lucid_Stats:11 = 0
LOCAL = FIRSTTIME("LUCID_EV_26")
CALL SET_KOJO_COLOR(109)
IF LOCAL
	PRINTFORMW 「%PRINT_MALE("boy")%은 야뇨증 환자 같고, %HE_SHE(MASTER)%가 많은 진전을 이루는 것 같다.」
ENDIF
PRINTFORMDW 당신은 분수와 물웅덩이 옆에서 %CALLNAME:109% 앞에 서 있다.
PRINTFORMDW 그 장소는 회색 콘크리트 벽으로 둘러싸여 있다. 
SIF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 5)
SIF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 5)
CALLF PANTY_REWORK_CHANGE(MASTER,DAILY_LUCID_STATS:8)
CALL SET_KOJO_COLOR(109)
IF LOCAL
	PRINTFORMDW 침대에서 막 전이되어 온 당신에게는 이 모든 것이 낯설게 느껴진다.
	LOCALS '= @"「오! 드디어 깨어났군! 이제 현실에서도 아직 잠들어 있는지 궁금해졌어.」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
	WAIT
	PRINTFORMDW 방금 잠에서 깨어난 채 이 장소가 무엇인지 묻는다.
	LOCALS '= @"「당신은 여전히 방에서 깊이 잠들어 있지만, 이곳은 꿈의 세계 속 나의 영역 중 하나이다.」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
	WAIT
	PRINTFORMDW 이 꿈에서 잠들면 다른 꿈을 꾸게 될지 궁금해할 것이다.
	PRINTL
	PRINTFORMDW 하루가 끝났다.
	PRINTDW ・
	PRINTDW ・・
	PRINTDW ・・・
	PRINTL
	LOCALS '= @"「자지 마.」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
	WAIT
	LOCALS '= @"「나한테 물어보지도 않고 혼자 잠을 청하려고 뭘 하는 거야?!」"
	LOCALS += @"「오랜만에 이렇게 짜증 나는 %PRINT_MALE("boy")%은 보지 못했어!」/"
	LOCALS += @"「게다가 내 체격까지 놀렸단 말이야!」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
	WAIT
	PRINTL
	PRINTFORMDW 이 꿈이 무엇인지 묻는다?
	PRINTFORMW 「물론이지, 네 꿈 중 또 하나일 뿐이지만, 나의 개입으로 조금 더 특별하게 만들어 줄 테니까.」
	PRINTFORMDW 당신은 %HE_SHE(109)%가 특별한 꿈이란 무슨 의미인지 궁금해한다.
	PRINTFORMW 「그래! 특별한 꿈 말이야! 더 구체적으로는 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"pee","poo")% 꿈이지」
	PRINTFORMDW 이곳에서 실패하면 수치스러운 사고를 치게 될 거라는 것을 깨닫고 공포감을 느낀다.
	PRINTFORMW 「꿈의 지배자로서 나는 누구에게나 내가 선택한 꿈을 줄 수 있어. 그리고 오늘 너는 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"pee","poo")% 같은 꿈을 갖게 될 운명이야.」
	PRINTL
	LOCALS '= @"「본론으로 돌아가서, 당신은 확인된 침대 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wetter","messer")%입니다. 기회를 주겠습니다.」/"
	LOCALS += @"「나와 함께 게임에서 이기면 침대를 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wetting","messing")%하지 않고 일어날 수 있어!」/"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 109, 0)
	WAIT
	PRINTFORMDW 당신은 그것이 어떤 종류의 게임인지 묻는다.
	LOCALS '= @"이 미로에는 나 자신이 16개 존재한다."
	LOCALS += @"「침대를 더럽히는 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wetting","messing")%로부터 당신을 구할 수 있는 건 단 한 장뿐이다!」/"
	LOCALS += @"「찾아내면 게임에서 이기는 거다. 쉽지 않나?」"
	LOCALS += @"「오, 그래! 시간 제한이 있다는 걸 말하는 걸 깜빡했어.」"
	LOCALS += @"시간이 다 되면 사고가 날 것이다."
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
	WAIT
	LOCALS '= @"「게다가, 너 꽤 자신만 만 것 같으니 좀 분위기를 바꿔보자고!」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
	WAIT
	;CALL NeedForPee(MASTER)
	PRINTL
	LOCALS '= @"나는 현실 세계로부터 당신의 %PeeAndPoo(nPee,nScat,"bladder","bowels")%에 대한 링크를 가지고 있다."
	LOCALS += @"「이것은 꿈속의 사고가 현실에서도 사고를 일으킨다는 것을 의미한다.」/"
	LOCALS += @"이 장소에서 사고를 치거나 실수를 해도 시간 부족으로 끝나는 것과 같은 결과가 될 거라는 점을 명심해라."
	LOCALS += @"첫 번째 플레이이므로 120분이 주어집니다."
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
ELSE
	PRINTFORMW 「오랜만이다, %CALLNAME:MASTER%.」
	PRINTFORMDW 지난번과 똑같은 탐색의 꿈이라 공포감을 느낀다.
	PRINTFORMW 「무엇을 해야 할지 알고 있겠지, 가서 그것을 찾기 시작해라.」
	PRINTL
	PRINTFORMW 「그리고 나는 거의 잊을 뻔했지...」
	RESETCOLOR
	;CALL NeedForPee(MASTER)
	PRINTL
	CALL SET_KOJO_COLOR(109)
	PRINTFORMDW 당신은 %CALLNAME:109%에게 당신을 터지게 만든 것에 대해 분노를 표한다.
	PRINTFORMW 「넌 새어나오길 갈망하며 몸부림치는 게 더 보기 좋군...」
	PRINTL
	PRINTFORMW 「침대에 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wet","mess")% 하지 않도록 노력해 보길 바란다.」
	PRINTFORMW 「이번 타이머는 90분이다.」
	DAILY_Lucid_Stats:7 = TIME + 90
ENDIF
CALL SET_KOJO_COLOR(109)
PRINTFORMW 「잘 가, 촉촉한 꿈 꿔.」
RESETCOLOR
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_26
IF DAILY_Lucid_Stats:9 == 10
	CALL DDD_SoiledSelf
ENDIF
;When a command ends

@LUCID_DREAM_TURN_26
IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
	PLAYSOUND "se/間違い.wav"
	FONTBOLD
	SETCOLOR C_RED
	PRINTFORML 참을 수 없어!
	RESETCOLOR
	FONTREGULAR
	FORCEWAIT
	PRINTL
	LOCALS '= @"「아이고... 더는 참을 수 없을 거야...」/"
	LOCALS += @"「오늘 당신은 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"젖은","엉망인")% 침대에서 깨게 될 것 같다.」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
	WAIT
	DAILY_Lucid_Stats:9 = 10
	CALL LucidDreamTimeUp()
ENDIF
IF DAILY_Lucid_Stats:7-TIME <= 0
	PLAYSOUND "se/間違い.wav"
	FONTBOLD
	SETCOLOR C_RED
	PRINTFORML 시간 종료!
	RESETCOLOR
	FONTREGULAR
	FORCEWAIT
	PRINTL
	LOCALS '= @"「아이고... 시간이 다 됐어...」/"
	LOCALS += @"「오늘 당신은 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"젖었다","지저분하다")%한 침대에서 깨게 될 것 같습니다.」/"
	LOCALS += @"「하지만 그 전에 바로 여기서 네가 용변을 보도록 만들어 주지, 그래서 이 꿈 안에서도 너는 비게 될 테니까.」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
	WAIT
	DAILY_Lucid_Stats:9 = 10
	CALL LucidDreamTimeUp()
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_26(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		SETBIT DAILY_Lucid_Stats:11, DAILY_Lucid_Stats:6
		IF DAILY_Lucid_Stats:6 == DAILY_Lucid_Stats:10
			PLAYSOUND "se/正解.wav"
			LOCALS '= @"「젠장! 잘됐다!」"
			LOCALS += @"이번에는 말라 깨어날 거야!"
			LOCALS += @"「하지만, 다음엔 해낼 수 있겠어?」"
			CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 109, 0)
			WAIT
			LOCALS '= @"「자, 그럼... 깨어날 시간이야!」"
			LOCALS += @"「그리고... 올바른 동상을 찾는 사람에게 상품을 줄 거야!」"
			LOCALS += @"깨어났을 때 즐겨라!"
			CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 109, 0)
			DAILY_Lucid_Stats:9 = 62
			CALL LucidDreamTimeUp()
		ELSE
			PLAYSOUND "se/間違い.wav"
			LOCALS '= @"「이게 맞는 사본이 아니니 유감하군, %CALLNAME:MASTER%.」"
			LOCALS += @"「서두르지 않으면 제시간에 도착하지 못할 거야.」"
			CALL CUTSCENESPEAK_NAS( @"%LOCALS%" , "怒り", 109, 0)
			CALL ASK_YN("분노를 표현한다.","떠나기")
			SELECTCASE RESULT
				CASE 0
					PRINTFORMDW 당신은 모욕한다 %CALLNAME:109% ~라고 말함으로써 %HIM_HER(109)% ~라고 %HES_SHES(109)% 성격이 나쁜 변태
					CALL CUTSCENESPEAK_NAS(@"「누구한테 전화하는 거야, 이상한 거?!」/「이번 건 내 걸로 할게.」/「%CALLNAME:MASTER%, 편하게 있어. 이런 소리 하는 애들을 위한 거라고!」", "怒り", 109, 0)
					TIME += 15
					PRINTFORMDW 당신은 자신의 절망이 훨씬 더 심해졌다고 느낀다. 
					CALL CUTSCENESPEAK_NAS(@"「이제 침대에 좀 더 일찍 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wetting","messing")%하게 될 거야.♪」", "怒り", 109, 0)
					WAIT
				CASE 1
			ENDSELECT
		ENDIF
	CASE 1
		TIME += RAND(7,20)
		LOCAL:3 = DAILY_Lucid_Stats:6
		$StatueLoop
		DAILY_Lucid_Stats:6 = RAND(16)
		SIF DAILY_Lucid_Stats:6 == LOCAL:3 || GETBIT(DAILY_Lucid_Stats:11, DAILY_Lucid_Stats:6)
			GOTO StatueLoop
ENDSELECT
