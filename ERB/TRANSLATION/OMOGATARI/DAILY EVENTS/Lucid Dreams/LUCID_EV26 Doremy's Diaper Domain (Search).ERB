@LUCID_DREAM_INPUT_NAMES_26(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		DAILY_Lucid_ComName '= @"상태 확인"
	CASE 1
		DAILY_Lucid_ComName '= @"이동한다"
ENDSELECT
RETURNF DAILY_Lucid_ComName
