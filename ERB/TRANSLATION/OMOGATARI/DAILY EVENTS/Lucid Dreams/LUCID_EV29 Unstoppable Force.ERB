; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV29 Unstoppable Force.ERB
; new nightmare lucid dream: A fight you cannot possibly win
; - you get dropped into a battle in the EasyBattle Arena against a mob who has quadultra level combat and dripped out in ultratech weaponry, armor, and high levels in youjutsu
; - the expected outcome is that you just fucking die™ but you CAN beat him if you know endgame NAS combat well
; - you also cannot retreat or submit
; - if you do beat him then the next time you have that nightmare it will have one more opponent but you will have no punishment
; - if you lose you get the expected consequence of a nightmare lucid dream (a wet and messy bed)

@LUCID_DREAM_INFO_29
#FUNCTION
DAILY_Lucid_Name '= "Unstoppable Force"
DAILY_Lucid_Desc '= "What happens when an unstoppable force meets.... you?"
DAILY_Lucid_Type '= "Nightmare"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/"
DAILY_Lucid_CanGiveUp = 0
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_29
CALL PRINT_GP("W", @"당신은 공허를 바라보며 눈을 뜬다. 어둠이 당신의 눈을 둘렀다.")
IF LUCID_EV29_WINS
	CALL PRINT_GP("W", @"여러 체형들이 물질화하며, 모두 천천히 당신에게 다가온다.")
ELSE
	CALL PRINT_GP("W", @"당신 앞에 한 체형이 형성되기 시작하며, 당신에게 다가오기 시작한다.")
ENDIF
FOR LOCAL, 0, LUCID_EV29_WINS+1
CALL EZB_MAKE_FIGHTER(FREE_MOB_SLOT(),10)
SIF !LOCAL
	DAILY_Lucid_Chara = CHARANUM-1
CALLF AddCombatant(CHARANUM-1,0)
NEXT
SELECTCASE EQUIP:DAILY_Lucid_Chara:Weapon
	CASE 0, 1
		CALL PRINT_GP("W", @"그들의 손은 옆에 붙어 있고, 발걸음은 소리가 나지 않는다.")
	CASEELSE
		CALL PRINT_GP("W", @"그들의 손은 %PrintWeaponName(DAILY_Lucid_Chara,EQUIP:DAILY_Lucid_Chara:Weapon,1)%를 휘두르고, 발걸음은 조용했다.")
ENDSELECT
CALL PRINT_GP("W", @"\@ LUCID_EV29_WINS ? 모든 체형은 # 머리를 제외한 온몸이 초기술 갑옷 판으로 덮여 있고, 그들의 %PLNOUN("head",LUCID_EV29_WINS+1)% 위에는 흰 머리 장식이 놓여 있다. \@")
CALL PRINT_GP("W", @"움직임이 멈추고, 체형은 당신보다 짧은 거리에 있다.")
PRINTL
CALL PRINT_GPC("L", @"「당신이 우리가 찾던 움직이지 않는 물건입니까?」", DAILY_Lucid_Chara)
CALL PRINT_GP("W", @"당신이 대답하기 전에, \@ LUCID_EV29_WINS ? 어떤 체형이 # 그 체형이 \@ 당신에게 새로운 지시를 내린다.")
CALL PRINT_GP("W", @"체형이 당신에게 돌아서서 10보 걸으라고 말한다.")
CALL PRINT_GP("W", @"1... 2... 3...")
CALL PRINT_GP("W", @"4... 5... 6...")
CALL PRINT_GP("W", @"7... 8... 9...")
CALL PRINT_GPC("L", @"「게임 시작!!」", DAILY_Lucid_Chara)
CALLF AddCombatant(MASTER,1)
CALL KNIFE_FIGHT(DAILY_Lucid_Chara,MASTER)
CALL LucidDreamTimeUp()
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_29
SELECTCASE lcWarResult
	CASE 0
		IF IsDead:MASTER:0
			SETCOLOR C_RED
			PRINTL (터미널 본체 피해)
			RESETCOLOR
			PRINTFORMW 모든 것이 검게 변한다...
		ELSE
			PRINTL (기력이 소진되었다)
			PRINTL
			PRINTFORMW 힘이 다해서 기절한다...
		ENDIF
		CALL PRINT_GP("W", @"머릿속에 위에서 들리는 목소리가 울려 퍼진다.")
		IF LUCID_EV29_WINS
			CALL PRINT_GPC("L", @"「더 잘할 수 있다. 다음번에 다시 시도해라.」", DAILY_Lucid_Chara)
			CALL PRINT_GPC("L", @"「이것이 어쩌면 당신의 한계인가?」", DAILY_Lucid_Chara)
		ELSE
			CALL PRINT_GPC("L", @"「결국 그러지 않았던 것 같네요.」", DAILY_Lucid_Chara)
		ENDIF
		;full heal even if you died
		DAILY_Lucid_Stats:9 = 10
		CALLF HESOYAM(MASTER)
	CASE 1
		CALL PRINT_GP("W", @"체형은 기절하여 땅으로 쓰러진다.")
		CALL PRINT_GP("W", @"그것으로 무엇인가를 할 수 있게 되기 전에, 체형은 다시 무(無) 속으로 녹아 사라진다.")
		CALL PRINT_GP("W", @"머릿속에 위에서 들리는 목소리가 울려 퍼진다.")
		CALL PRINT_GPC("L", @"「가치 있는 도전자일지도?」", DAILY_Lucid_Chara)
		CALL PRINT_GPC("L", @"「이 시험을 통과했다.」", DAILY_Lucid_Chara)
		CALLF HESOYAM(MASTER)
		DAILY_Lucid_Stats:9 = 1
		LUCID_EV29_WINS++
	CASEELSE
ENDSELECT
;When a command ends

@LUCID_DREAM_TURN_29
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_29(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
ENDSELECT
