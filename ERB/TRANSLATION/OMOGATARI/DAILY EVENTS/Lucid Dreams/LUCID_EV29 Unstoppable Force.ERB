; new nightmare lucid dream: A fight you cannot possibly win
; - you get dropped into a battle in the EasyBattle Arena against a mob who has quadultra level combat and dripped out in ultratech weaponry, armor, and high levels in youjutsu
; - the expected outcome is that you just fucking die™ but you CAN beat him if you know endgame NAS combat well
; - you also cannot retreat or submit
; - if you do beat him then the next time you have that nightmare it will have one more opponent but you will have no punishment
; - if you lose you get the expected consequence of a nightmare lucid dream (a wet and messy bed)
@LUCID_DREAM_INFO_29
#FUNCTION
DAILY_Lucid_Name '= "Unstoppable Force"
DAILY_Lucid_Desc '= "What happens when an unstoppable force meets.... you?"
DAILY_Lucid_Type '= "Nightmare"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/"
DAILY_Lucid_CanGiveUp = 0

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_29
CALL PRINT_GP("W", @"You wake up looking at the void. The darkness surrounds your eyes.")
IF LUCID_EV29_WINS
	CALL PRINT_GP("W", @"Multiple figures materialize, all slowly approaching you.")
ELSE
	CALL PRINT_GP("W", @"A figure begins to form in front of you, and begins to approach you.")
ENDIF
FOR LOCAL, 0, LUCID_EV29_WINS+1
	CALL EZB_MAKE_FIGHTER(FREE_MOB_SLOT(),10)
	SIF !LOCAL
		DAILY_Lucid_Chara = CHARANUM-1
	CALLF AddCombatant(CHARANUM-1,0)
NEXT
SELECTCASE EQUIP:DAILY_Lucid_Chara:Weapon
CASE 0, 1
CALL PRINT_GP("W", @"Their hands are on their sides, their steps silent.")
CASEELSE
CALL PRINT_GP("W", @"Their hands brandish a %PrintWeaponName(DAILY_Lucid_Chara,EQUIP:DAILY_Lucid_Chara:Weapon,1)%, their steps silent.")
ENDSELECT
CALL PRINT_GP("W", @"\@ LUCID_EV29_WINS ? All of the figures are # Their whole body, excluding the head, is\@ covered with an ultratech armor plating, and a white headdress tops their %PLNOUN("head",LUCID_EV29_WINS+1)%.")
CALL PRINT_GP("W", @"The movements stop, and the figure is a short distance ahead of you.")
PRINTL
CALL PRINT_GPC("L", @"「Are you the immovable object we are looking for?」", DAILY_Lucid_Chara)
CALL PRINT_GP("W", @"Before you can answer, \@ LUCID_EV29_WINS ? one of the figures # the figure \@ orders you a new instruction.")
CALL PRINT_GP("W", @"The figure tells you to turn around and take 10 steps.")
CALL PRINT_GP("W", @"1... 2... 3...")
CALL PRINT_GP("W", @"4... 5... 6...")
CALL PRINT_GP("W", @"7... 8... 9...")
CALL PRINT_GPC("L", @"「Game start!!」", DAILY_Lucid_Chara)
CALLF AddCombatant(MASTER,1)
CALL KNIFE_FIGHT(DAILY_Lucid_Chara,MASTER)
CALL LucidDreamTimeUp()

;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_29
SELECTCASE lcWarResult
CASE 0
	IF IsDead:MASTER:0
		SETCOLOR C_RED
		PRINTL (Terminal body harm)
		RESETCOLOR
		PRINTFORMW Everything goes black...
	ELSE
		PRINTL (Ran out of strength)
		PRINTL
		PRINTFORMW You run out of strength and faint...
	ENDIF
	CALL PRINT_GP("W", @"An overhead voice echos throughout your head.")
	IF LUCID_EV29_WINS
		CALL PRINT_GPC("L", @"「You can do better. Try again next time.」", DAILY_Lucid_Chara)
		CALL PRINT_GPC("L", @"「Is this perhaps, your limit?」", DAILY_Lucid_Chara)
	ELSE
		CALL PRINT_GPC("L", @"「Seems like you weren't, after all.」", DAILY_Lucid_Chara)
	ENDIF
	;full heal even if you died
	DAILY_Lucid_Stats:9 = 10
	CALLF HESOYAM(MASTER)
CASE 1
	CALL PRINT_GP("W", @"The figure faints, falling down to the ground.")
	CALL PRINT_GP("W", @"Before you're able to do anything with it, the figure dissolves back into nothingness.")
	CALL PRINT_GP("W", @"An overhead voice echos throughout your head.")
	CALL PRINT_GPC("L", @"「A worthy challenger, perhaps?」", DAILY_Lucid_Chara)
	CALL PRINT_GPC("L", @"「You've passed this test.」", DAILY_Lucid_Chara)
	CALLF HESOYAM(MASTER)
	DAILY_Lucid_Stats:9 = 1
	LUCID_EV29_WINS++
CASEELSE
ENDSELECT

;When a command ends
@LUCID_DREAM_TURN_29

;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_29(nInput)
#DIM nInput
SELECTCASE nInput
CASE 0
ENDSELECT

;----------------------------
;Input names
;----------------------------
@LUCID_DREAM_INPUT_NAMES_29(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
CASE 0
	DAILY_Lucid_ComName '= @"Custom COM"
ENDSELECT
RETURNF DAILY_Lucid_ComName

