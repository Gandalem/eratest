;----------------------------
;Info for the dream
;----------------------------
@LUCID_DREAM_INFO_20
#FUNCTION
DAILY_Lucid_Name '= "The Daycare"
{
DAILY_Lucid_Desc '= "You wake up laying in a crib in a daycare."
}
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/11/20/62"
DAILY_Lucid_CanGiveUp = 0

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_20
PRINTFORMW You wake up in an unfamiliar place.
PRINTFORMW It's decorated with soft pastel colours and full of baby toys.
PRINTFORMW As you sit up, you realize you are dressed like a toddler and the bed is actually a cradle filled with cuddly plushies.

PRINTFORM [490] - 
CALL SET_KOJO_COLOR(MASTER)
PRINTFORML 「I'm hungry」
RESETCOLOR
PRINTFORML [403] - Go to bed
PRINTFORML [400] - Climb out
PRINTFORML [357] - Cry for help
INPUT
SELECTCASE RESULT
CASE 357
PRINTFORMW You feel helpless and trapped, so you start crying calling for help.
PRINTFORMW A door opens on the other side of the room, and %CALLNAME:DAILY_Lucid_Chara% enters.
PRINTFORMW You notice %HIS_HER(DAILY_Lucid_Chara)% and struggle to get your words out as you try to ask for help.
PRINTFORMW %CALLNAME:DAILY_Lucid_Chara% goes up to the cradle and takes you into %HIS_HER(DAILY_Lucid_Chara)% arms.
PRINTFORMW Then, %HE_SHE(DAILY_Lucid_Chara)% carries you to another room, which seems to be a bathroom and sits you on a potty chair designed for your size.
PRINTFORMW At that moment, you realize you really have to go, so you put your embarrassment aside and use the toilet.
CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
IF RESULT <= 0
CALL COLORMESSAGE(@"Loser!",C_RED,2,1)
DAILY_Lucid_Stats:9 = LucidDreamLoser()
CALL LucidDreamTimeUp()
ENDIF
PRINTFORMW %CALLNAME:DAILY_Lucid_Chara% then strokes your hair and in a calm soothing voice says:
CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
PRINTFORMW 「You are a good baby」
RESETCOLOR
DAILY_Lucid_Stats:9 = 1
CALL LucidDreamTimeUp()
CASE 400
PRINTFORMW You decide you have to escape this place.
PRINTFORMW You climb out of the cradle and try running towards the door.
IF ABL:MASTER:教養 > UniversalRank("B")
PRINTFORMW Knowing your size and your bursting bladder, you decide to slow down and take it easy.
PRINTFORMW Now the main issue is actually finding the exit.
ELSE
	PRINTFORMW However, after a few steps you trip and fall face first into the floor.
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")		
	PRINTFORMW With tears in your eyes, you realize your pants are starting to grow warmer and when you look you realize you are \@ DAILY_Lucid_Stats:1 ?%FSYN("pee:ing")%#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:ing")%#\@ your pants. 
	PRINTFORMW Upon noticing this, you start to cry in frustration like a baby, as the world vanishes around you.	
	CALL COLORMESSAGE(@"This action requires {UniversalRank("B")} %ABL_TR(43)%!",C_RED,2,1)
	DAILY_Lucid_Stats:9 = 10
	CALL LucidDreamTimeUp()
ENDIF
CASE 403
PRINTFORMW You decide this has to be a dream.
PRINTFORMW You stopped being a toddler a long time ago.
PRINTFORMW Maybe you can escape if you go back to sleep.
PRINTFORMW You get comfortable in your cradle and drift back to sleep.
DAILY_Lucid_Stats:9 = 62
CALL LucidDreamTimeUp()
CASE 490
PRINTFORML You start feeling hungry as you look around for something to eat. 
PRINTFORMW You then notice a baby bottle full of warm milk sitting in the cradle alongside the plushies.
PRINTFORMW You decide to grab the bottle and bring it to your mouth, drinking warm milk.
PRINTFORMW The baby bottle makes you feel calm and happy, like it's soothing your very soul.
PRINTFORML As you continue drinking, you grab a %CALLNAME:DAILY_Lucid_Chara% plushie with your free hand and hold it to your chest.
CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
PRINTFORMW You then feel a pleasurable warmth gathering on your %FSYN("crotch")% as you notice you are wearing a diaper.
PRINTFORMW You don't worry about it, focusing on the soothing feeling of the baby bottle.
PRINTFORMW The warmth of %CALLNAME:DAILY_Lucid_Chara% and the \@ DAILY_Lucid_Stats:1 ?%FSYN("pee:n")%#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")%#\@ feels really good.
PRINTFORMW Babies should act like babies after all, right
DAILY_Lucid_Stats:9 = 20
CALL LucidDreamTimeUp()
ENDSELECT

;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
; @LUCID_DREAM_END_20

; ;When a command ends
; @LUCID_DREAM_TURN_20

;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_20(nInput)
#DIM nInput
SELECTCASE nInput
CASE 0
	PRINTFORML You wander around aimlessly.
	IF !RAND:4
		PRINTFORMW %CALLNAME:DAILY_Lucid_Chara% notices you out of your crib and tries to grab you...
		PRINTFORMW You retaliate by having an accident in front of %HIS_HER(DAILY_Lucid_Chara)%...
		CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
		$DaycareCaught
		CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code	
		PRINTFORMW 「Oh dear.... With that attitude, it makes you look like you don't want to be potty trained」
		PRINTFORMW 「Plus, you also got out during nap time.」
		PRINTFORMW 「Back to diapers for you.」
		RESETCOLOR
		PRINTFORMW Crying, you don't even attempt to resist %CALLNAME:DAILY_Lucid_Chara%'s advances.
		PRINTFORMW %HE_SHE(DAILY_Lucid_Chara,1)% picks you up and takes you to the bathroom.
		P = PunishChange:MASTER:0
		PunishChange:MASTER:0 = 5
		CALL RandomUnderwearCheck(DAILY_Lucid_Chara,3)
		PunishChange:MASTER:0 = P
		PRINTFORMW You are placed back in your crib, padded and with a bottle in your mouth, before forgetting it even happened...
		CALL COLORMESSAGE(@"You got caught!",C_RED,2,1)
		DAILY_Lucid_Stats:9 = LucidDreamLoser(1)
		CALL LucidDreamTimeUp()
	ELSEIF RAND:4 == 1
		PRINTFORMW You're in a hallway with no one...
	ELSEIF RAND:4 == 2
		PRINTFORMW Pretty soon you find yourself in the main entrance, the only thing stopping you from freedom is a door.
		PRINTFORMW You use all of your energy to run to the door and push it open, but you got the attention of %CALLNAME:DAILY_Lucid_Chara%.
		PRINTFORMW You make a mad dash through the village, trying to lose %CALLNAME:DAILY_Lucid_Chara%.
		IF !RAND:2
		PRINTFORMW You end up in the shopping district with nobody to be seen.
		PRINTFORMW In your mad dash through the village, you seemed to forget about your potty needs.
		PRINTFORMW Your urge to %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,FSYN("pee"), FSYN("poo"))% seems to be gone.
		PRINTL
		IF IsPadded(MASTER)
		PRINTFORMW You give your %FSYN("crotch")% a gentle touch and feel it being more squishy than before...
		ELSE
		PRINTFORMW You give your %FSYN("crotch")% a gentle touch and feel wet fabric...
		ENDIF
		PRINTFORML You had an accident!
		PRINTFORMW And you didn't know about it!
		CALL COLORMESSAGE(@"Was it worth it?",C_ORANGE,2,1)
		DAILY_Lucid_Stats:9 = LucidDreamLoser()
		CALL LucidDreamTimeUp()
		ELSE
		CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
		CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
		PRINTFORMW 「There you are!」
		PRINTFORMW 「Why you gotta be so difficult with me」
		PRINTFORMW 「You stink too... I think you did an uh oh inside your pants」
		PRINTFORMW 「Back to diapers for you.」
		RESETCOLOR
		PRINTFORMW Crying, you don't even attempt to resist %CALLNAME:DAILY_Lucid_Chara%'s advances.
		PRINTFORMW %HE_SHE(DAILY_Lucid_Chara,1)% picks you up and takes you to a secluded place.
		P = PunishChange:MASTER:0
		PunishChange:MASTER:0 = 5
		CALL RandomUnderwearCheck(DAILY_Lucid_Chara,3)
		PunishChange:MASTER:0 = P
		PRINTFORMW %CAPITALIZE(FSYN("shame:d"))%, you're held like a baby as %HE_SHE(DAILY_Lucid_Chara)% takes you back to the daycare.
		PRINTFORMW You are placed back in your crib, padded and with a bottle in your mouth, before forgetting it even happened...
		CALL COLORMESSAGE(@"You got caught!",C_RED,2,1)
		DAILY_Lucid_Stats:9 = 10
		CALL LucidDreamTimeUp()
		ENDIF
	ELSE
		PRINTFORMW You ended up in the bathroom.
		PRINTFORMW Go potty?
		CALL ASK_YN()
		IF !RESULT
		PRINTFORMW With the training potty right in front of you, you decide to swallow your pride and get on the potty to %FSYN("pee")%.
		CALL COM_TakeClothesBeforePee(MASTER)
			IF RESULT <= 0
			CALL TOILET_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
			DAILY_Lucid_Stats:9 = LucidDreamLoser()
			CALL LucidDreamTimeUp()
			ENDIF
		PRINTFORMW %CALLNAME:DAILY_Lucid_Chara% notices you out of your crib and grabs you when you're done...
		CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code	
		PRINTFORMW 「Good %PRINT_MALE("boy",MASTER)%...」
		PRINTFORMW 「But you got out during nap time.」
		PRINTFORMW 「You might faint if you skip it!」
		RESETCOLOR
		PRINTFORMW You try your best to get out of %CALLNAME:DAILY_Lucid_Chara%'s grab, but you're put back into your crib while screaming.
		PRINTFORMW %CALLNAME:DAILY_Lucid_Chara% force-feeds you with a warm bottle full of milk to calm you down.
		PRINTFORMW After having downed a couple of bottles, you fall asleep...
		CALL COLORMESSAGE(@"You got caught!",C_RED,2,1)
		DAILY_Lucid_Stats:9 = 1
		CALL LucidDreamTimeUp()
		ENDIF
	ENDIF
ENDSELECT

