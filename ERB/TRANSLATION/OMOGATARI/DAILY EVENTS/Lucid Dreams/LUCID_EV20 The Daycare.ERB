#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
CASE 0
	DAILY_Lucid_ComName '= @"Go somewhere"
ENDSELECT
RETURNF DAILY_Lucid_ComName

