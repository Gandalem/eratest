; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV20 The Daycare.ERB
;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_20
#FUNCTION
DAILY_Lucid_Name '= "어린이집"
DAILY_Lucid_Desc '= "어린이집의 아기 침대에 누운 채 눈을 뜬다."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/11/20/62"
DAILY_Lucid_CanGiveUp = 0
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_20
PRINTFORMW 당신은 낯선 곳에서 깨어난다.
PRINTFORMW 그곳은 부드러운 파스텔 색상으로 장식되어 있고 아기 장난감들로 가득하다.
PRINTFORMW 몸을 일으키자, 자신은 유아처럼 옷을 입고 침대는 사실 포근한 봉제 인형들로 가득 찬 요람이라는 것을 깨닫는다.
PRINTFORM [490] - 
CALL SET_KOJO_COLOR(MASTER)
PRINTFORML 「배고파」
RESETCOLOR
PRINTFORML [403] - 잠자리에 들다
PRINTFORML [400] - 기어 나오다
PRINTFORML [357] - 도움을 청하며 울다
INPUT
SELECTCASE RESULT
	CASE 357
		PRINTFORMW 당신은 무력하고 갇힌 기분이 들어 도움을 청하며 울기 시작한다.
		PRINTFORMW 방 건너편에 문이 열리고 %CALLNAME:DAILY_Lucid_Chara%가 들어온다.
		PRINTFORMW 당신은 %HIS_HER(DAILY_Lucid_Chara)%를 알아차리고 도움을 청하려 애쓰며 말을 꺼내려고 애쓴다.
		PRINTFORMW %CALLNAME:DAILY_Lucid_Chara%는 아기 침대로 다가와 당신을 %HIS_HER(DAILY_Lucid_Chara)%의 품에 안는다.
		PRINTFORMW 그리고 %HE_SHE(DAILY_Lucid_Chara)%는 당신을 화장실로 보이는 다른 방으로 데려가 당신의 크기에 맞춰진 변기 의자에 앉힌다.
		PRINTFORMW 그 순간, 당신은 정말 화를 봐야 한다는 것을 깨닫고 부끄러움을 뒤로한 채 변기를 사용한다.
		CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
		IF RESULT <= 0
			CALL COLORMESSAGE(@"패배자!",C_RED,2,1)
			DAILY_Lucid_Stats:9 = LucidDreamLoser()
			CALL LucidDreamTimeUp()
		ENDIF
		PRINTFORMW %CALLNAME:DAILY_Lucid_Chara%는 당신의 머리를 쓰다듬으며 차분하고 부드러운 목소리로 말한다:
		CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
		PRINTFORMW 「너는 착한 아기야」
		RESETCOLOR
		DAILY_Lucid_Stats:9 = 1
		CALL LucidDreamTimeUp()
	CASE 400
		PRINTFORMW 당신은 이 장소를 탈출해야 한다고 결정한다.
		PRINTFORMW 당신은 요람에서 기어 나와 문 쪽으로 달려가려 한다.
		IF ABL:MASTER:教養 > UniversalRank("B")
			PRINTFORMW 당신의 크기와 터질 것 같은 방광을 알기에, 속도를 늦추고 편안하게 하기로 결정한다.
			PRINTFORMW 이제 진짜 문제는 출구를 찾는 것이다.
		ELSE
			PRINTFORMW 하지만 몇 걸음 가다가 발을 헛디뎌 얼굴부터 바닥에 넘어졌다.
			CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
			PRINTFORMW 눈에 눈물을 머금고, 당신은 바지가 따뜻해지기 시작했다는 것을 깨닫는다. 그리고 바라보니 당신은 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:ing")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:ing")% #  \@ 바지 안에 있다. 
			PRINTFORMW 이를 알아차리자, 당신은 주변의 세상이 사라지는 가운데 아기처럼 좌절하며 울기 시작한다.	
			CALL COLORMESSAGE(@"이 행동은 {UniversalRank("B")} %ABL_TR(43)%을(를) 필요로 한다!",C_RED,2,1)
			DAILY_Lucid_Stats:9 = 10
			CALL LucidDreamTimeUp()
		ENDIF
	CASE 403
		PRINTFORMW 당신은 이것이 꿈이어야 한다고 결정한다.
		PRINTFORMW 당신은 아주 오래전에 유아가 되는 것을 멈췄다.
		PRINTFORMW 어쩌면 다시 잠들면 도망칠 수 있을지도 모른다.
		PRINTFORMW 당신은 요람에서 편안함을 느끼며 다시 잠이 들었다.
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
	CASE 490
		PRINTFORML 주위를 둘러 먹을 것을 찾으면서 배가 고프다는 느낌이 들기 시작한다. 
		PRINTFORMW 그러고 나서 아기 인형들 옆에 요람 안에 따뜻한 우유로 가득 찬 젖병이 놓여 있는 것을 알아차린다.
		PRINTFORMW 너는 그 병을 집어 입으로 가져가 따뜻한 우유를 마시기로 결정한다.
		PRINTFORMW 아기 젖병은 영혼을 달래주는 것처럼 너를 차분하고 행복하게 만든다.
		PRINTFORML 계속 마시는 동안, 남은 손으로 %CALLNAME:DAILY_Lucid_Chara% 인형을 집어 가슴에 안는다.
		CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
		PRINTFORMW 당신은 기저귀를 착용하고 있음을 알아차리면서 %FSYN("crotch")%에 즐거운 온기가 모이는 것을 느낀다.
		PRINTFORMW 당신은 그것을 걱정하지 않고 아기 젖병의 부드러운 느낌에 집중한다.
		PRINTFORMW %CALLNAME:DAILY_Lucid_Chara%의 따뜻함과 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% #  \@가 정말 기분 좋다.
		PRINTFORMW 결국 아기는 아기처럼 행동해야 하잖아, 그렇지?
		DAILY_Lucid_Stats:9 = 20
		CALL LucidDreamTimeUp()
ENDSELECT
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
; @LUCID_DREAM_END_20
; ;When a command ends
; @LUCID_DREAM_TURN_20
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_20(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		PRINTFORML 당신은 목적 없이 배회한다.
		IF !RAND:4
			PRINTFORMW %CALLNAME:DAILY_Lucid_Chara%는 당신이 아기 침대에서 나오는 것을 알아채고 당신을 잡으려고 한다…
			PRINTFORMW 당신은 %HIS_HER(DAILY_Lucid_Chara)% 앞에서 사고를 치며 맞선다…
			CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
			$DaycareCaught
			CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
			PRINTFORMW 「오 이런.... 그런 태도라면 화장실 가기 싫은 것처럼 보이잖아」
			PRINTFORMW 「게다가 낮잠 시간에도 나왔어.」
			PRINTFORMW 「다시 기저귀 차야겠네.」
			RESETCOLOR
			PRINTFORMW 울면서도 당신은 %CALLNAME:DAILY_Lucid_Chara%의 접근을 저항하려 하지 않는다.
			PRINTFORMW %HE_SHE(DAILY_Lucid_Chara,1)%는 당신을 안아 욕실로 데려간다.
			P = PunishChange:MASTER:0
			PunishChange:MASTER:0 = 5
			CALL RandomUnderwearCheck(DAILY_Lucid_Chara,3)
			PunishChange:MASTER:0 = P
			PRINTFORMW 당신은 다시 아기 침대에 놓이고, 패딩이 채워진 상태로 입에 젖병을 물고, 그것이 일어났다는 사실조차 잊게 된다...
			CALL COLORMESSAGE(@"걸렸어!",C_RED,2,1)
			DAILY_Lucid_Stats:9 = LucidDreamLoser(1)
			CALL LucidDreamTimeUp()
		ELSEIF RAND:4 == 1
			PRINTFORMW 아무도 없는 복도에 있다...
		ELSEIF RAND:4 == 2
			PRINTFORMW 곧 당신은 본 건물 입구에 있게 되고, 자유를 막는 유일한 것은 문이다.
			PRINTFORMW 당신은 모든 에너지를 다해 문으로 달려가 그것을 밀어 열지만, %CALLNAME:DAILY_Lucid_Chara%의 주의를 끌게 된다.
			PRINTFORMW 당신은 마을을 미친 듯이 질주하며 %CALLNAME:DAILY_Lucid_Chara%에게서 벗어나려고 노력한다.
			IF !RAND:2
				PRINTFORMW 아무도 보이지 않는 쇼핑 지구에 도착한다.
				PRINTFORMW 마을을 미친 듯이 달려가는 동안, 너는 배변 욕구를 잊은 것 같다.
				PRINTFORMW %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,FSYN("pee"), FSYN("poo"))%할 충동은 사라진 듯하다.
				PRINTL
				IF IsPadded(MASTER)
					PRINTFORMW 당신은 당신의 %FSYN("crotch")%에게 부드러운 손길을 건네고 그것이 전보다 더 말랑해지는 것을 느낀다...
				ELSE
					PRINTFORMW 당신은 자신의 %FSYN("crotch")%에게 부드러운 손길을 건네고 축축한 천의 감촉을 느낀다...
				ENDIF
				PRINTFORML 당신은 사고를 당했다!
				PRINTFORMW 그리고 그것을 몰랐다!
				CALL COLORMESSAGE(@"가치가 있었을까?",C_ORANGE,2,1)
				DAILY_Lucid_Stats:9 = LucidDreamLoser()
				CALL LucidDreamTimeUp()
			ELSE
				CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
				CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
				PRINTFORMW 「거기 있구나!」
				PRINTFORMW 「왜 그렇게 나한테 까다롭게 구는 거야」
				PRINTFORMW 「너도 냄새나... 네 바지 안에 뭐 실수한 것 같아」
				PRINTFORMW 「너한테 기저귀로 돌아가.」
				RESETCOLOR
				PRINTFORMW 울면서도 당신은 %CALLNAME:DAILY_Lucid_Chara%의 접근에 저항할 시도조차 하지 않는다.
				PRINTFORMW %HE_SHE(DAILY_Lucid_Chara,1)%이 당신을 안아 외진 곳으로 데려간다.
				P = PunishChange:MASTER:0
				PunishChange:MASTER:0 = 5
				CALL RandomUnderwearCheck(DAILY_Lucid_Chara,3)
				PunishChange:MASTER:0 = P
				PRINTFORMW %CAPITALIZE(FSYN("shame:d"))%, 당신은 %HE_SHE(DAILY_Lucid_Chara)%가 당신을 유치원으로 데려갈 때 아기처럼 붙잡혀 있다.
				PRINTFORMW 당신은 다시 아기 침대에 놓이고, 패딩 처리된 채 입에는 젖병이 물린 상태로 그것이 일어났다는 사실조차 잊는다...
				CALL COLORMESSAGE(@"걸렸어!",C_RED,2,1)
				DAILY_Lucid_Stats:9 = 10
				CALL LucidDreamTimeUp()
			ENDIF
		ELSE
			PRINTFORMW 너는 화장실에 있게 되었다.
			PRINTFORMW 용변 볼까?
			CALL ASK_YN()
			IF !RESULT
				PRINTFORMW 바로 앞에 있는 트레이닝 변기를 보며, 당신은 자존심을 버리고 변기에 올라가 %FSYN("pee")%하기로 결정한다.
				CALL COM_TakeClothesBeforePee(MASTER)
				IF RESULT <= 0
					CALL TOILET_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
					DAILY_Lucid_Stats:9 = LucidDreamLoser()
					CALL LucidDreamTimeUp()
				ENDIF
				PRINTFORMW %CALLNAME:DAILY_Lucid_Chara%는 네가 아기 침대에서 나오는 것을 알아채고 네가 끝나자 너를 잡는다...
				CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
				PRINTFORMW 「좋은 %PRINT_MALE("boy",MASTER)%...」
				PRINTFORMW 「하지만 낮잠 시간에 빠졌잖아.」
				PRINTFORMW 「이거 빼면 기절할지도 몰라!」
				RESETCOLOR
				PRINTFORMW %CALLNAME:DAILY_Lucid_Chara%의 붙잡힘에서 벗어나기 위해 최선을 다했지만, 비명을 지르며 다시 아기 침대로 돌아간다.
				PRINTFORMW %CALLNAME:DAILY_Lucid_Chara%는 당신을 진정시키기 위해 우유로 가득 찬 따뜻한 병으로 강제로 먹인다.
				PRINTFORMW 몇 개의 병을 마신 후, 잠이 들었다...
				CALL COLORMESSAGE(@"걸렸어!",C_RED,2,1)
				DAILY_Lucid_Stats:9 = 1
				CALL LucidDreamTimeUp()
			ENDIF
		ENDIF
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_20(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		DAILY_Lucid_ComName '= @"어딘가로 가다"
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
;Status page for Carry Status
;----------------------------

@LUCID_DREAM_INPUT_STATUS_20
#FUNCTIONS
DAILY_Lucid_InfoTab '= @""
RETURNF DAILY_Lucid_InfoTab
