#DIM SAVEDATA DAILY_Lucid_Stats, 17
#DIM SAVEDATA DAILY_Lucid_Chara, 2000
#DIM GLOBAL SAVEDATA DAILY_Lucid_Progress, DAILY_Lucid_Max
