#DIMS DAILY_Lucid_Desc

;Difficulty
;0: Normal
#DIMS DAILY_Lucid_Difficulty

;Endings
;-6: Genuine toilet accident (padded)
;-5: Intentional accident (padded)
;-4: Genuine accident (padded)
;-2: Genuine toilet accident
;-2: Intentional accident
;-1: Genuine accident
; 0: Undetermined.
; 1: Held it and relieved self
;98: Dream Paradox
;99: Left area
#DIMS DAILY_Lucid_EndingAvailable
;Types:
;Pee
;Sex
#DIMS DAILY_Lucid_Type
#DIM DAILY_Lucid_CanDo
#DIM DAILY_Lucid_NormalCom
#DIMS DAILY_Lucid_InterruptCom
#DIMS DAILY_Lucid_ComName
#DIMS DAILY_Lucid_InfoTab
;Bit 0: Unpadded
;Bit 1: Diapered
#DIM DAILY_Lucid_CanGiveUp
#DIMS DAILY_Lucid_CurrentPosition
#DIMS DAILY_Lucid_CurrentLocation
#DIMS DAILY_Lucid_ThingsOfInterest
#DIMS DAILY_Lucid_MoveDirections
