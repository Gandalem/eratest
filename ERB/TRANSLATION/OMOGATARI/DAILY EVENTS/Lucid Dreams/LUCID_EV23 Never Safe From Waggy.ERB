; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV23 Never Safe From Waggy.ERB
;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_23
#FUNCTION
DAILY_Lucid_Name '= "Never Safe from Waggy"
DAILY_Lucid_Desc '= @"%NAME:93%은 안개 호수에서 인간의 발로 일어나 당신 쪽으로 전력 질주한다. \n 당신의 목표는 그저 달리는 것이다."
DAILY_Lucid_Type '= "Nightmare"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 1
DAILY_Lucid_InterruptCom '= "405/811/"
DAILY_Lucid_EndingAvailable '= "10/"
DAILY_Lucid_CanGiveUp = 0
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_23
PRINTFORML 너에게는 평범한 날이었다. 대부분 자기 일에 신경 쓰고 마음대로 지내다가 그것을 보기 전까지는 말이다.
PRINTFORMW ・・・
PRINTFORMW ・・
PRINTFORMW ・
PRINTFORML %CALLNAME:93%은 스스로 두 발로 걷기 시작하고 달리기를 시작한다.
PRINTFORML 그리고 %HES_SHES(93)%도 빠르게 움직인다.
PRINTFORMW
PRINTFORML 너는 도망쳐야 한다.
PRINTFORML 무엇을 하든, 너는 %HIM_HER(93)%로부터 멀어져야 한다.
PRINTL
PRINTFORMW
CFLAG:93:313 = 0
CFLAG:93:300 = ENTRANCE
CFLAG:MASTER:デート中 = MAIN_MAP
CFLAG:MASTER:現在位置 = CFLAG:MASTER:311
CALL ForceGoAndMove(93, CFLAG:MASTER:300)
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_23
;When a command ends

@LUCID_DREAM_TURN_23
CALL ForceGoAndMove(93, CFLAG:MASTER:300)
IF CFLAG:93:300 == CFLAG:MASTER:300
	IF DAILY_Lucid_Stats:10
		FOR LOCAL, 1, GET_TARGETNUM()
		CFLAG:(TARGET:LOCAL):300 = SUKIMA()
		NEXT
		PRINTFORMW %CALLNAME:93%은 당신의 위치로 달려오지만 %CALLNAME:(TARGET:1)%%COND_STR(" and the others", LOCAL > 1)%에게 정신이 팔린다.
		PRINTFORMW %HE_SHE(93,1)%는 즉시 그들을 간격 공간으로 추방하고 무(無) 속으로 사라진다.
		PRINTFORMW 다른 이들이 희미해지는 것을 보며 당신은 식은땀을 흘리고, 두 다리를 가진 %TNAME(93,0)%가 스토커처럼 당신을 쫓는 것에 몸을 떨었다.
		PRINTL
		PRINTFORMW 결국 %CALLNAME:93%은(는) 당신을 찾지 못하고 다른 장소로 이동한다.
		PRINTFORMW 당신은 그 만남으로 인해 여전히 동요했고, 숨어 있던 곳에서 나와야 했다.
		CFLAG:93:300 = KICKOUT()
		DAILY_Lucid_Stats:10 = 0
		charaMovementStep:93:0 = 0
		CALL NAS_CALC_MOVE(93, CFLAG:MASTER:300, 1)
	ELSE
		PRINTFORMW 믿을 수 없어.
		PRINTFORMW 네가 %CALLNAME:93%에게 %HIS_HER(93)% 자신의 두 발을 허락하게 했어.
		DAILY_Lucid_Stats:9 = 10
		CALL LucidDreamTimeUp()
	ENDIF
ENDIF
IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
	CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
	PRINTL
	PRINTFORML 더 이상 변기에 갈 필요가 없어 보인다.
	PRINTFORMW 하지만 그게 지금 네 주된 문제는 아니다.
ENDIF
SIF DAILY_Lucid_Stats:10 && (!GET_TARGETNUM() || !inRoom(CFLAG:MASTER:300))
	DAILY_Lucid_Stats:10 = 0
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_23(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		IF DAILY_Lucid_Stats:10
			PRINTFORMW 당신은 은신에서 벗어난다
			DAILY_Lucid_Stats:10 = 0
		ELSEIF GET_TARGETNUM() && inRoom(CFLAG:MASTER:300)
			PRINTFORMW 당신은 어떤 가구 아래에 숨어, %CALLNAME:93%가 당신을 볼 수 없기를 바란다.
			DAILY_Lucid_Stats:10 = 1
		ENDIF
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_23(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		IF DAILY_Lucid_Stats:10
			DAILY_Lucid_ComName '= @"숨는 것을 그만둬라"
		ELSEIF GET_TARGETNUM()
			DAILY_Lucid_ComName '= @"숨기다"
		ENDIF
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
;Status page for Carry Status
;----------------------------

@LUCID_DREAM_INPUT_STATUS_23
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"%CALLNAME:93%으로부터의 거리: {DT_ROW_LENGTH(@"Movement_93")-charaMovementStep:93:0} 유닛"
RETURNF DAILY_Lucid_InfoTab
