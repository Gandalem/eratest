;----------------------------
;Info for the dream
;----------------------------
@LUCID_DREAM_INFO_23
#FUNCTION
DAILY_Lucid_Name '= "Never Safe from Waggy"
{
DAILY_Lucid_Desc '= @"%NAME:93% stands up from the Misty Lake on human feet, and proceeds to sprint towards your direction.\n
Your objective is to simply run."
}
DAILY_Lucid_Type '= "Nightmare"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 1
DAILY_Lucid_InterruptCom '= "405/811/"
DAILY_Lucid_EndingAvailable '= "10/"
DAILY_Lucid_CanGiveUp = 0

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_23
PRINTFORML It was a normal day for you, mostly minding your own business and doing as you please, until you see it.
PRINTFORMW ・・・
PRINTFORMW ・・
PRINTFORMW ・
PRINTFORML %CALLNAME:93% begins to walk on %HIS_HER(93)% own two feet, and starts to run.
PRINTFORML And %HES_SHES(93)% moving quickly too.
PRINTFORMW
PRINTFORML You have to run.
PRINTFORML Whatever you do, you need to get away from %HIM_HER(93)%.
PRINTL
PRINTFORMW

CFLAG:93:313 = 0
CFLAG:93:300 = ENTRANCE
CFLAG:MASTER:デート中 = MAIN_MAP
CFLAG:MASTER:現在位置 = CFLAG:MASTER:311
CALL ForceGoAndMove(93, CFLAG:MASTER:300)


;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_23

;When a command ends
@LUCID_DREAM_TURN_23
CALL ForceGoAndMove(93, CFLAG:MASTER:300)

IF CFLAG:93:300 == CFLAG:MASTER:300
	IF DAILY_Lucid_Stats:10
		FOR LOCAL, 1, GET_TARGETNUM()
			CFLAG:(TARGET:LOCAL):300 = SUKIMA()
		NEXT
		PRINTFORMW %CALLNAME:93% runs to your location, but is distracted by %CALLNAME:(TARGET:1)%%COND_STR(" and the others", LOCAL > 1)%.
		PRINTFORMW %HE_SHE(93,1)% immediately banishes them to the gap space, disappearing to nothingness.
		PRINTFORMW You sweat as the others fade away, shaking from seeing %TNAME(93,0)% with two legs, chasing you like a stalker.
		PRINTL
		PRINTFORMW Eventually, %CALLNAME:93% is unable to find you and moves to another location.
		PRINTFORMW You're still shaken from the encounter, and you had to move out of your hiding spot.
		CFLAG:93:300 = KICKOUT()
		DAILY_Lucid_Stats:10 = 0
		charaMovementStep:93:0 = 0
		CALL NAS_CALC_MOVE(93, CFLAG:MASTER:300, 1)

	ELSE
		PRINTFORMW You can't believe it.
		PRINTFORMW You let %CALLNAME:93% get you with %HIS_HER(93)% own two legs.
		DAILY_Lucid_Stats:9 = 10
		CALL LucidDreamTimeUp()
	ENDIF
ENDIF

IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
	CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
	PRINTL
	PRINTFORML Looks like you don't have to go potty anymore.
	PRINTFORMW But that's currently not your main issue.
ENDIF

SIF DAILY_Lucid_Stats:10 && (!GET_TARGETNUM() || !inRoom(CFLAG:MASTER:300))
	DAILY_Lucid_Stats:10 = 0



;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_23(nInput)
#DIM nInput
SELECTCASE nInput
CASE 0
	IF DAILY_Lucid_Stats:10
		PRINTFORMW You get out of hiding
		DAILY_Lucid_Stats:10 = 0
	ELSEIF GET_TARGETNUM() && inRoom(CFLAG:MASTER:300)
		PRINTFORMW You hide under some furniture, hoping that %CALLNAME:93% is unable to see you.
		DAILY_Lucid_Stats:10 = 1
	ENDIF
ENDSELECT

;----------------------------
;Input names
;----------------------------
@LUCID_DREAM_INPUT_NAMES_23(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
CASE 0
	IF DAILY_Lucid_Stats:10
		DAILY_Lucid_ComName '= @"Get Out of Hiding"
	ELSEIF GET_TARGETNUM()
		DAILY_Lucid_ComName '= @"Hide"
	ENDIF
ENDSELECT
RETURNF DAILY_Lucid_ComName

;----------------------------
;Status page for Carry Status
;----------------------------
@LUCID_DREAM_INPUT_STATUS_23
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"Distance from %CALLNAME:93%: {DT_ROW_LENGTH(@"Movement_93")-charaMovementStep:93:0} units"
RETURNF DAILY_Lucid_InfoTab