; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV21 또 다른 세계.ERB
;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
;Normal
;Nightmare
;Sex
;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------

@LUCID_DREAM_INFO_21
#FUNCTION
DAILY_Lucid_Name '= "또 다른 세계"
DAILY_Lucid_Desc '= "현대 서구 세계에서 눈을 떴다. 이제 이곳에서 살아갈 방법을 찾아야 한다."
DAILY_Lucid_Type '= "Normal"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 1
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "62/"
DAILY_Lucid_CanGiveUp = 3
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_21
#DIM RandomChara
FOR RandomChara, 0, 7
CALLF TP(DAILY_Lucid_Chara:RandomChara)
TARGET:(RandomChara+1) = DAILY_Lucid_Chara:RandomChara
CFLAG:(DAILY_Lucid_Chara:RandomChara):睡眠 = 0
CFLAG:(DAILY_Lucid_Chara:RandomChara):同室 = 1
TCVAR:(DAILY_Lucid_Chara:RandomChara):906 = 1
CALLF PEEME(DAILY_Lucid_Chara:RandomChara, 0)
CALLF POOME(DAILY_Lucid_Chara:RandomChara, 0)
NEXT
TFLAG:104 = DAILY_Lucid_Chara
BASE:MASTER:0 = MAXBASE:MASTER:0
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
PRINTFORMW 당신은 분주한 도로 옆에서 깨어난다.
PRINTFORMW 어떻게 거기에 왔는지 모르지만, 게다가 주변 사람들도 이상한 현대 서양 복장을 하고 있다는 것을 깨닫는다.
PRINTFORMW 다른 이들은 인간처럼 보이지도 않는다!
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_21
; ;When a command ends
; @LUCID_DREAM_TURN_21
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_21(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 1
		PRINTFORML 어디로 이동할까요?
		PRINTFORML [  0] [ 0] - 거리
		PRINTFORML [  1] [ 1] - 골목길
		SIF nOmutsu
			PRINTFORML [  2] 이상하게 생긴 건물
		PRINTFORML [  3] - 화려한 방
		PRINTFORML [  4] - 나가기
		PRINTFORML [999] - 그 자리에 머무르기
		INPUT
		SELECTCASE RESULT
			CASE 1
				PRINTFORMW 당신은 생각할 곳을 찾으려 골목 사이를 허둥지둥 뛰어다닌다.
				PRINTFORMW 당신이 수색하는 동안, 갑자기 위험해 보이는 무리에게 부딪힌다.
				IF DAILY_Lucid_Stats:1 || DAILY_Lucid_Stats:2
					PRINTFORMW 그들 중 하나가 당신을 바라볼 때, 방광이 터지기 직전인 것처럼 두려움을 느낀다.
				ELSE
					PRINTFORMW 당신은 잠시 당황하며 균형을 잃는다. 그중 한 명이 당신을 바라본다.
				ENDIF
				PRINTFORMW 「또 다른 것을 찾았다, 이제 풀어줄 시간이다」
				PRINTFORMW 네가 벌어지고 있는 일을 처리할 틈도 없이, 그중 가장 큰 것이 너에게 메이스를 휘두른다.
				PRINTFORMW 싸우지 않고 여기서 빠져나갈 수 없을 것 같다.
				;make a random one
				CALL MAKE_YUKIZURI(Free_Mob_Slot(), "妖精", 1)
				;bug fix, moved definition here
				DAILY_Lucid_Chara = Free_Mob_Slot(1)
				TARGET = DAILY_Lucid_Chara
				CFLAG:DAILY_Lucid_Chara:デート中 = -1 ;bug fix, disable dating flag
				CALL KOJO_MESSAGE_SEND("DANMAKU", 0, Free_Mob_Slot(1), 1, -1, "戦闘前")
				TEQUIP:Free_Mob_Slot(1):上半身着衣状況 = 1
				CALL CHARA_STATE_TR(Free_Mob_Slot(1))
				DRAWLINE
				CALL COLORMESSAGE(@"처녀 상실 이력: %CSTR:Free_Mob_Slot(1):処女喪失履歴%",C_PINK,1)
				PRINTFORML 
				CALL DANMAKU_OPPONENT_STATUS(Free_Mob_Slot(1))
				;--------------------
				$Gensokyo2FightLoop
				CALL ASK_M("싸운다",1,"탈출",1,"규칙",1)
				SELECTCASE RESULT
					CASE 0
						IF BASE:MASTER:気力 < 500 || BASE:MASTER:体力 < 500
							PRINTFORML %PARSE("You are")%너무 피곤하다.
							GOTO Gensokyo2FightLoop
						ENDIF
					CASE 1
						PRINTFORML %PARSE("You flee")%전투에서.
						DAILY_Lucid_Stats:9 = 62
						CALL LucidDreamTimeUp()
					CASE 2
						CALL SHOW_DANMAKU_RULE
						GOTO Gensokyo2FightLoop
				ENDSELECT
				CALL KNIFE_FIGHT(Free_Mob_Slot(1),MASTER,0,0)
				IF RESULT > 0
					PRINTFORML 그중 가장 큰 자가 너의 머리에 철퇴를 내리치고 모든 것이 즉시 어둠 속으로 들어간다.
					DAILY_Lucid_Stats:9 = 62
					CALL LucidDreamTimeUp()
				ENDIF
				DAILY_Lucid_Stats:9 = 62
				CALL LucidDreamTimeUp()
			CASE 2
				PRINTFORMW 문을 열자 그것이 화장실이라는 것을 깨닫는다.
				IF DAILY_Lucid_Stats:1 || DAILY_Lucid_Stats:2
					PRINTFORMW 그 순간 당신은 실제로 그것을 사용하고 싶다는 것을 깨닫고, 한 노점석에 가서 방광을 비운다.	
					CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
					IF RESULT <= 0
						DAILY_Lucid_Stats:9 = 0
						CALL LucidDreamTimeUp()
					ENDIF
					PRINTFORMW 당신이 그러하듯, 세상이 사라지면서 따뜻한 감정이 천천히 당신을 감싼다.
					DAILY_Lucid_Stats:9 = 0
					CALL LucidDreamTimeUp()
				ELSE
					PRINTFORMW 하지만 아직 갈 필요는 느껴지지 않는다.
				ENDIF
			CASE 3
				SIF !nOmutsu
					RETURN
				PRINTFORMW 당신은 무슨 일이 일어났는지 물어볼 강력한 요괴를 찾으며 돌아다니다가, 장식적인 모습의 큰 건물과 마주친다.
				PRINTFORMW 이상하게도, 그 건물을 향해 걸어 들어가는 대신, 다음에 벌어진 것은 당신이 그 건물에서 걸어 나오는 것이었다.
				PRINTFORMW 방금 무슨 일이 일어났는지 이해할 수 없었고, 마치 짧은 시간 동안 의식을 잃었던 것 같다.
				PRINTFORMW 당신은 그 건물이 위험할 수 있다고 판단하여, 계속해서 찾아보기로 한다.
				PRINTFORMW 걸어가면서 주변 사람들이 자신을 쳐다보며 웃고 있다는 것을 깨닫는다.
				PRINTFORMW 스스로를 내려다보고 자신이 셔츠와 기저귀 외에는 아무것도 입고 있지 않다는 것을 깨닫는다.		
				CALLF PANTY_REWORK_CHANGE(MASTER,103)
			CASE 4
				PRINTFORMW 당신은 사람들이 다른 세계로 전송되어 용이나 괴물을 쓰러뜨리며 세상을 구하는 모험을 하는 것일 거라 생각한다.
				PRINTFORMW 그렇게 생각하며, 당신은 싸울 괴물을 찾기 위해 마을 밖으로 서두르지만, 갑자기 자신이 알지 못하는 작은 생명체와 마주친다.
				PRINTFORMW 그것이 괴물이라고 생각하고 온 힘을 다해 발로 차지만, 그 작은 생명체는 거의 움직이지 않는다.
				PRINTFORMW 예상과는 달리, 그것은 땅에서 갑자기 기어 나오며 지하에 숨겨져 있던 거대하고 사나워 보이는 몸을 드러내고 천천히 당신을 바라보더니 자신이 실수했음을 깨닫는다...
				PRINTFORMW 당신은 균형을 잃고 %FSYN("ass")% 위로 쓰러지는데, \@ DAILY_Lucid_Stats:1 || DAILY_Lucid_Stats:2 ? 갑자기 따뜻함을 느끼기 시작한다 #  \@ 당신은 눈앞의 거대한 생명체를 계속 바라본다.
				PRINTFORMW 당신은 눈을 감고, 마지막으로 기억하는 것은 그 생명체가 분노하며 으르렁거리는 소리뿐이다.
				DAILY_Lucid_Stats:9 = 0
				CALL LucidDreamTimeUp()
			CASEELSE
		ENDSELECT
	CASE 0
		PRINTFORMW 당신은 %CALLNAME:DAILY_Lucid_Chara%에게 뒤에서 다가간다.
		PRINTFORMW 조용히 %HIS_HER(DAILY_Lucid_Chara)%의 어깨를 두드리며, 당신은 %HE_SHE(DAILY_Lucid_Chara)%에게 이곳이 어디인지 알려줄 수 있는지 묻는다.
		PRINTFORMW %CALLNAME:DAILY_Lucid_Chara%이 돌아보자, 당신은 %HIS_HER(DAILY_Lucid_Chara)%의 피부가 밝은 보라색이고 %HIS_HER(DAILY_Lucid_Chara)%의 눈이 마치 뒤에 밝은 전구라도 숨겨져 있는 것처럼 노랗게 빛나는 것을 알아차린다.
		PRINTFORMW 당신은 그런 광경에 움츠러들고, %CALLNAME:DAILY_Lucid_Chara%은 잠시 혼란스러운 표정을 짓는다.
		PRINTFORMW 하지만 이내 %HE_SHE(DAILY_Lucid_Chara)%는 근처 건물 쪽을 가리킨 뒤 몸을 돌려 %HIS_HER(DAILY_Lucid_Chara)%의 길로 되돌아간다.
		PRINTFORMW 당신은 방금 무슨 일이 일어났는지 제대로 이해하지 못했지만, 가리켜진 건물을 향해 가기로 결정한다.
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_21(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		SIF TARGET != MASTER
			DAILY_Lucid_ComName '= @"조언을 구한다"
	CASE 1
		DAILY_Lucid_ComName '= @"이동한다"
ENDSELECT
RETURNF DAILY_Lucid_ComName
