;----------------------------
;Info for the dream
;----------------------------
@LUCID_DREAM_INFO_2
#FUNCTION
DAILY_Lucid_Name '= "A Friendly Game"
DAILY_Lucid_Desc '= "A first to 3 game based on luck. Loser must have an accident."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
;DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/11/12/21/22/62"
DAILY_Lucid_CanGiveUp = 1

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_2
CALLF TP(DAILY_Lucid_Chara)
TARGET = DAILY_Lucid_Chara
TARGET:1 = DAILY_Lucid_Chara
CFLAG:DAILY_Lucid_Chara:睡眠 = 0
CFLAG:DAILY_Lucid_Chara:同室 = 1
IF DAILY_Lucid_Stats:1
CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
CALLF POOME(MASTER, 4)
ENDIF		

PRINTFORMDW You are enjoying a game with %CALLNAME:DAILY_Lucid_Chara% when you realize you need to \@ DAILY_Lucid_Stats:1 ? pee #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? poop #\@.
PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara% pouts, asking you to hold it a little longer until you're done with your game, though %HE_SHE(DAILY_Lucid_Chara)% seems to have a mischievous look in %HIS_HER(DAILY_Lucid_Chara)% eyes.


;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_2

;When a command ends
@LUCID_DREAM_TURN_2
IF DAILY_Lucid_Stats:6 >= 3
	PRINTFORML %PARSE("You")% won against %CALLNAME:DAILY_Lucid_Chara%!
	CALL COLORMESSAGE(@"Life prevails!",C_GREEN,2,1)		
	PRINTFORML Run to the toilet?
	CALL ASK_YN
	SELECTCASE RESULT
	CASE 0
	PRINTFORMDW You make a beeline for the toilets as %CALLNAME:DAILY_Lucid_Chara% has an accident in their pants.
	PRINTFORMDW You don't even quite get your pants down before you start \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:ing")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:ing")% #\@...
	CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
	IF RESULT <= 0
	DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
	CALL LucidDreamTimeUp()
	RETURN
	ENDIF
	PRINTFORMDW Most of the \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% #\@ goes into the toilet.
	PRINTFORMDW And it doesn't look like the little mishap shows on your clothes.
	PRINTFORMDW You're surrounded by a comforting glow of warmth as you finally relax.
	DAILY_Lucid_Stats:9 = 1
	CALL LucidDreamTimeUp()
	CASEELSE
	PRINTFORMDW You discover that you're in a dream and try to wake yourself up before it's too late.
	PRINTFORMDW You give yourself a good pinching on your arm, jolting yourself awake.
	DAILY_Lucid_Stats:9 = 62
	CALL LucidDreamTimeUp()
	ENDSELECT
ELSEIF DAILY_Lucid_Stats:7 >= 3
	PRINTFORMW %PARSE("You")% lost...
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")			
	PRINTFORMW As punishment, you had to go inside your underwear...
	DAILY_Lucid_Stats:9 = LucidDreamLoser(1)
	CALL LucidDreamTimeUp()
ELSEIF PeeBarStage(MASTER) >= 7 || PooBarStage(MASTER) >= 7
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")	
	PRINTFORMDW A content look briefly crosses your face as control is lost, but this contentment is quickly replaced by embarrassed horror as you open your eyes to see %CALLNAME:DAILY_Lucid_Chara% looking back with a devilish grin.
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
	;PRINTFORMDW Jolting awake back in bed, the humiliation of having an accident in front of a friend is replaced with humiliation of an accident in bed."	
ENDIF

;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_2(nInput)
#DIM nInput
CALLF TP(DAILY_Lucid_Chara)
DAILY_Lucid_Stats:11 = RAND:1000
DAILY_Lucid_Stats:12 = RAND:1500
SELECTCASE nInput
CASE 0
	PRINTFORMDW You reluctantly give in to %CALLNAME:DAILY_Lucid_Chara%'s pouting, sitting back down to continue the game.	
	$Case2Play
	PRINTFORMW ・・・
	PRINTL 
	CALL DICE_PRINT(DAILY_Lucid_Stats:11, DAILY_Lucid_Stats:12, 0, 0, 0, 0, "勝負")
	PRINTW 	
	BASE:MASTER:尿意 += RAND:75
	BASE:MASTER:Poo += RAND:75			
	BASE:DAILY_Lucid_Chara:尿意 += RAND:75
	BASE:DAILY_Lucid_Chara:Poo += RAND:75		
	IF DAILY_Lucid_Stats:11 >= DAILY_Lucid_Stats:12
	CALL COLORMESSAGE(@"Score! (%CALLNAME:MASTER%)",C_YELLOW,1)
	DAILY_Lucid_Stats:6 ++
	ELSE
	CALL COLORMESSAGE(@"Score! (%CALLNAME:DAILY_Lucid_Chara%)",C_YELLOW,1)
	DAILY_Lucid_Stats:7 ++
	ENDIF
	PRINTFORMW Score: {DAILY_Lucid_Stats:6} vs {DAILY_Lucid_Stats:7}
CASE 1
	PRINTFORMDW You confidently try for a trick shot.
	DAILY_Lucid_Stats:11 += 200
	BASE:MASTER:尿意 += RAND:75
	BASE:MASTER:Poo += RAND:75
	GOTO Case2Play
CASE 9
	PRINTFORMDW You apologize, assuring %CALLNAME:DAILY_Lucid_Chara% you'll be quick before leaving the room and rushing to the bathroom to use the toilet.
	CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
	;PRINTFORMDW Feeling so triumphant at having having outsmarted %HIS_HER(DAILY_Lucid_Chara)% attempt at tricking you into having an accident that upon waking up...
	;PRINTFORMDW You don't notice the warm \@ DAILY_Lucid_Stats:1 ? liquid #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? mess #\@ spreading through your %PeeProtectType(MASTER)% until the accident's already over.
	DAILY_Lucid_Stats:9 = 61
	CALL LucidDreamTimeUp()
ENDSELECT

;----------------------------
;Input names
;----------------------------
@LUCID_DREAM_INPUT_NAMES_2(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
CASE 0
	DAILY_Lucid_ComName '= "Play normally"
CASE 1
	DAILY_Lucid_ComName '= "Try for a trick shot"
CASE 9
	DAILY_Lucid_ComName '= "Ask to go potty"
ENDSELECT
RETURNF DAILY_Lucid_ComName

;----------------------------
;Status page for Carry Status
;----------------------------
@LUCID_DREAM_INPUT_STATUS_2
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"Score: {DAILY_Lucid_Stats:6} vs {DAILY_Lucid_Stats:7}"
RETURNF DAILY_Lucid_InfoTab