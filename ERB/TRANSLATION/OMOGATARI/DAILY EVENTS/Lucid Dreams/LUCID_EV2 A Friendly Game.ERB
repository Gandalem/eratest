; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV2 A Friendly Game.ERB
;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_2
#FUNCTION
DAILY_Lucid_Name '= "A Friendly Game"
DAILY_Lucid_Desc '= "A first to 3 game based on luck. Loser must have an accident."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
;DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/11/12/21/22/62"
DAILY_Lucid_CanGiveUp = 1
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_2
CALLF TP(DAILY_Lucid_Chara)
TARGET = DAILY_Lucid_Chara
TARGET:1 = DAILY_Lucid_Chara
CFLAG:DAILY_Lucid_Chara:睡眠 = 0
CFLAG:DAILY_Lucid_Chara:同室 = 1
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
PRINTFORMDW 당신은 %CALLNAME:DAILY_Lucid_Chara%와 게임을 즐기고 있는데 소변을 봐야 한다는 것을 깨닫는다 \@ DAILY_Lucid_Stats:1 ? pee #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? poop #  \@.
PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%는 게임이 끝날 때까지 조금 더 참으라고 투덜거렸지만, %HE_SHE(DAILY_Lucid_Chara)%은 %HIS_HER(DAILY_Lucid_Chara)%의 눈에 장난기 가득한 표정을 짓고 있었다.
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_2
;When a command ends

@LUCID_DREAM_TURN_2
IF DAILY_Lucid_Stats:6 >= 3
	PRINTFORML %PARSE("You")%이(가) %CALLNAME:DAILY_Lucid_Chara%를 이겼다!
	CALL COLORMESSAGE(@"생명이 승리했다!",C_GREEN,2,1)
	PRINTFORML 화장실로 달려가다?
	CALL ASK_YN
	SELECTCASE RESULT
		CASE 0
			PRINTFORMDW 당신은 %CALLNAME:DAILY_Lucid_Chara%이 바지에서 사고를 치자 화장실로 달려간다.
			PRINTFORMDW 당신은 바지를 완전히 내리기도 전에 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:ing")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:ing")% #  \@...
			CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
			IF RESULT <= 0
				DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
				CALL LucidDreamTimeUp()
				RETURN
			ENDIF
			PRINTFORMDW 대부분의 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% #  \@ 화장실로 들어간다.
			PRINTFORMDW 그리고 그 작은 사고가 옷에 나타나지는 않은 것 같다.
			PRINTFORMDW 당신은 마침내 긴장을 풀면서 따뜻한 안도감의 빛에 둘러싸인다.
			DAILY_Lucid_Stats:9 = 1
			CALL LucidDreamTimeUp()
		CASEELSE
			PRINTFORMDW 당신은 자신이 꿈 속에 있다는 것을 발견하고 너무 늦기 전에 자신을 깨우려 노력한다.
			PRINTFORMDW 당신은 팔을 세게 꼬집으며 스스로를 깜짝 놀라 잠에서 깬다.
			DAILY_Lucid_Stats:9 = 62
			CALL LucidDreamTimeUp()
	ENDSELECT
ELSEIF DAILY_Lucid_Stats:7 >= 3
	PRINTFORMW %PARSE("You")%놓쳤다...
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	PRINTFORMW 벌로 속옷 안에 들어가야 했다...
	DAILY_Lucid_Stats:9 = LucidDreamLoser(1)
	CALL LucidDreamTimeUp()
ELSEIF PeeBarStage(MASTER) >= 7 || PooBarStage(MASTER) >= 7
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	PRINTFORMDW 통제가 풀리자 잠시 만족스러운 표정이 스치지만, 눈을 뜨니 악마 같은 미소를 지으며 자신을 바라보는 %CALLNAME:DAILY_Lucid_Chara%를 보고 그 만족감은 금세 당혹스러운 공포로 대체된다.
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
	;PRINTFORMDW Jolting awake back in bed, the humiliation of having an accident in front of a friend is replaced with humiliation of an accident in bed."
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_2(nInput)
#DIM nInput
CALLF TP(DAILY_Lucid_Chara)
DAILY_Lucid_Stats:11 = RAND:1000
DAILY_Lucid_Stats:12 = RAND:1500
SELECTCASE nInput
	CASE 0
		PRINTFORMDW 당신은 %CALLNAME:DAILY_Lucid_Chara%의 토라진 모습에 저항하며 게임을 계속하기 위해 다시 앉는다.	
		$Case2Play
		PRINTFORMW ・・・
		PRINTL 
		CALL DICE_PRINT(DAILY_Lucid_Stats:11, DAILY_Lucid_Stats:12, 0, 0, 0, 0, "勝負")
		PRINTW 	
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		BASE:DAILY_Lucid_Chara:尿意 += RAND:75
		BASE:DAILY_Lucid_Chara:Poo += RAND:75
		IF DAILY_Lucid_Stats:11 >= DAILY_Lucid_Stats:12
			CALL COLORMESSAGE(@"점수! (%CALLNAME:MASTER%)",C_YELLOW,1)
			DAILY_Lucid_Stats:6 ++
		ELSE
			CALL COLORMESSAGE(@"스코어! (%CALLNAME:DAILY_Lucid_Chara%)",C_YELLOW,1)
			DAILY_Lucid_Stats:7 ++
		ENDIF
		PRINTFORMW 점수: {DAILY_Lucid_Stats:6} 대 {DAILY_Lucid_Stats:7}
	CASE 1
		PRINTFORMDW 당신은 자신 있게 트릭 샷을 시도한다.
		DAILY_Lucid_Stats:11 += 200
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		GOTO Case2Play
	CASE 9
		PRINTFORMDW 당신은 방을 나서기 전에 빨리 화장실에 가서 볼일을 보고 오겠다고 %CALLNAME:DAILY_Lucid_Chara%에게 말하며 사과한다.
		CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
		;PRINTFORMDW Feeling so triumphant at having having outsmarted %HIS_HER(DAILY_Lucid_Chara)% attempt at tricking you into having an accident that upon waking up...
		;PRINTFORMDW You don't notice the warm \@ DAILY_Lucid_Stats:1 ? liquid #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? mess #\@ spreading through your %PeeProtectType(MASTER)% until the accident's already over.
		DAILY_Lucid_Stats:9 = 61
		CALL LucidDreamTimeUp()
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_2(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		DAILY_Lucid_ComName '= "Play normally"
	CASE 1
		DAILY_Lucid_ComName '= "Try for a trick shot"
	CASE 9
		DAILY_Lucid_ComName '= "Ask to go potty"
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
;Status page for Carry Status
;----------------------------

@LUCID_DREAM_INPUT_STATUS_2
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"점수: {DAILY_Lucid_Stats:6} 대 {DAILY_Lucid_Stats:7}"
RETURNF DAILY_Lucid_InfoTab
