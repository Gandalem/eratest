CALL FISHER_YATES_SHAFFLE(CHARANUM)
VARSET LOCAL
FOR LOCAL, 1, CHARANUM
CHARA = SHAFFLE_ARRAY:LOCAL
;対象があなた
SIF CHARA == MASTER
	CONTINUE
;でてこない
SIF CFLAG:CHARA:出禁
	CONTINUE
;拠点キャラではない
SIF !CFLAG:CHARA:神社在住
	CONTINUE
;同じエリア内に住んでいない
SIF MAP_AREASELECT(MAIN_MAP, CFLAG:MASTER:初期位置) != MAP_AREASELECT(MAIN_MAP, CFLAG:CHARA:初期位置)
	CONTINUE
LOCAL:1 = CHARA
BREAK
NEXT
SIF LOCAL:1 <= 0
	RETURN
CALL KOJO_MESSAGE_SEND("DAILY", 2, LOCAL:1)

@LucidDreamCacheClothes(ARG)
#DIMS nTableName
nTableName '= @"LucidDream_Clothes_{ARG}"
DT_CREATE nTableName
DT_COLUMN_ADD nTableName, "slot", "int16"
DT_COLUMN_ADD nTableName, "equipment", "int16"
FOR LOCAL,200,240
DT_ROW_ADD nTableName, "slot", LOCAL, "equipment", CFLAG:ARG:LOCAL
NEXT
nTableName '= @"LucidDream_SleepClothes_{ARG}"
DT_CREATE nTableName
DT_COLUMN_ADD nTableName, "slot", "int16"
DT_COLUMN_ADD nTableName, "equipment", "int16"
FOR LOCAL,240,280
DT_ROW_ADD nTableName, "slot", LOCAL, "equipment", CFLAG:ARG:LOCAL
NEXT

@LucidDreamReleaseClothes(ARG)
#DIMS nTableName
nTableName '= @"LucidDream_Clothes_{ARG}"
SIF !DT_EXIST(nTableName)
	RETURN
FOR LOCAL,0,40
CFLAG:ARG:(LOCAL+200) = DT_CELL_GET(nTableName, LOCAL, "equipment")
NEXT
DT_RELEASE nTableName
nTableName '= @"LucidDream_SleepClothes_{ARG}"
FOR LOCAL,0,40
CFLAG:ARG:(LOCAL+240) = DT_CELL_GET(nTableName, LOCAL, "equipment")
NEXT
DT_RELEASE nTableName

