;Recollection menu

@LucidDreamRecollection
#DIM nLineCnt_Head
LOADGLOBAL
CUSTOMDRAWLINE ＊
PRINTFORML 명료한 꿈 회상
CUSTOMDRAWLINE ＊
SETCOLOR C_RED
PRINTFORML 루시드 드림 진행 상황은 모든 저장 사이에 저장된다.
RESETCOLOR
PRINTFORML
nLineCnt_Head = LINECOUNT
REDRAW 0
DO
SIF LINECOUNT - nLineCnt_Head > 0
	CLEARLINE LINECOUNT - nLineCnt_Head
CALL LucidDreamRecollection_State
SELECTCASE RESULT
	CASE 0,
		SAVEGLOBAL
		RETURN
	CASE 88890, -1
		SAVEGLOBAL
		RETURN RESULT
	CASEELSE
ENDSELECT
LOOP 1

@LucidDreamRecollection_State
#DIM 	 CREDRAW
#DIM     PAGE       ;表示中のページ
#DIMS CONST DISP_NAME = "Normal", "Nightmare", "Sex", "Pee"
#DIM FIRST_LINE
#DIM nTempDream
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
CALL LucidDreamRecollection_Page(PAGE, DISP_NAME:PAGE)
DRAWLINE
FOR LOCAL, 0, VARSIZE("DISP_NAME")
SIF LOCAL == 3 && !GETBIT(nPee,1) && !GETBIT(nScat,2)
	CONTINUE
SIF PAGE == LOCAL
	SETCOLOR 0x00FFFF
PRINTBUTTON DISP_NAME:LOCAL, LOCAL + 8002
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTFORML
;#;PRINTBUTTON "[-1] Random", -1
PRINTBUTTON "[0] 반환한다", 0
DO
INPUT
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 8002 TO VARSIZE("DISP_NAME")+8002
		PAGE = RESULT-8002
	CASE -1
		RETURN -1
	CASE 0 TO DAILY_Lucid_Max
		nTempDream = RESULT
		CALL LucidDreamRecollection_Info(nTempDream)
		;debug
		IF RESULT == 88890
			;set dream
			DAILY_Lucid_Stats:3 = nTempDream
			RETURN 88890
		ENDIF
	CASEELSE
		$RETRY
		REUSELASTLINE 잘못된 입력
		CONTINUE
ENDSELECT
BREAK
LOOP 1
GOTO REPRINT

@LucidDreamRecollection_Page(nCurPage, nTag)
#DIM DYNAMIC nCurPage
#DIMS DYNAMIC nTag
FOR LOCAL, 0, DAILY_Lucid_Max
VARSET DAILY_Lucid_Type
TRYCALL LucidDreamRecollection_Individual(LOCAL, nTag)
NEXT

@LucidDreamRecollection_Individual(DREAM, nType)
#DIM DYNAMIC DREAM
#DIMS DYNAMIC nType
#DIM DYNAMIC endingCount, 2
VARSET endingCount
VARSET DAILY_Lucid_EndingAvailable
TRYCALLFORMF LUCID_DREAM_INFO_{DREAM}
SIF TOLOWER(nType) != TOLOWER(DAILY_Lucid_Type)
	RETURN
PRINTBUTTON @"%DAILY_Lucid_Name%", DREAM
PRINTL
SETCOLOR C_GRAY
FOR LOCAL,0,100
LOCAL:1 = TOINT(SPLIT_SINGLE(DAILY_Lucid_EndingAvailable, LOCAL, "/"))
endingCount++
SIF !LOCAL:1
	BREAK
IF GETBIT(DAILY_Lucid_Progress:DREAM, (LOCAL:1))
	SETCOLOR C_YELLOW
ENDIF
PRINTFORM %LucidDreamEndingName(LOCAL:1,1,DREAM)%
SETCOLOR C_GRAY
SIF LOCAL != STRCOUNT(DAILY_Lucid_EndingAvailable,"/")
	PRINTFORM /
NEXT
RESETCOLOR
PRINTL

@LucidDreamRecollection_Info(DREAM, IsInteractive = 1)
#DIM DREAM
#DIM IsInteractive
TRYCALLFORMF LUCID_DREAM_INFO_{DREAM}
SIF !STRLENS(DAILY_Lucid_Name)
	RETURN
DRAWLINE
PRINTFORML %DAILY_Lucid_Name%
SETCOLOR C_GRAY
PRINTFORML %DAILY_Lucid_Type% 꿈
RESETCOLOR
PRINTL
PRINTFORML  %DAILY_Lucid_Desc%
SIF !IsInteractive
	RETURN
CALL PRINTLINE, "Endings Gotten"
FOR LOCAL,0,100
LOCAL:1 = TOINT(SPLIT_SINGLE(DAILY_Lucid_EndingAvailable, LOCAL, "/"))
SIF !LOCAL:1
	BREAK
IF GETBIT(DAILY_Lucid_Progress:DREAM, (LOCAL:1))
	SETCOLOR C_YELLOW
	PRINTFORML %LucidDreamEndingName(LOCAL:1,0, DREAM)%
ENDIF
NEXT
RESETCOLOR
DRAWLINE
IF DAILY_Lucid_Type != "Pee" || DAILY_Lucid_Stats:14
	PRINTFORML [0] 회상하기
ENDIF
SIF nPee
	PRINTFORML [1] - 회상하기 (젖음)
SIF nScat
	PRINTFORML [2] - 회상한다 (엉망진창)
SIF nPee && nScat
	PRINTFORML [3] - 회상하다 (복수)
PRINTFORML [9] - 떠나기
INPUT
D = RESULT
SELECTCASE RESULT
	CASE 0 TO 3
		IF DAILY_Lucid_Stats:14
			RETURN 88890
		ELSE
			CALL LucidDream(MASTER,GETBIT(D,0) , GETBIT(D,1),DREAM)
		ENDIF
ENDSELECT
;Lucid dream
;These dreams are mostly about things in the outside world, as the TW player is an outsider.
;ARG (Dream type. 1: Pee holding - 0: Wet dream)
;LOCAL to LOCAL:5 are characters

@LucidDream(ARGS,HasPiss,HasScat,DreamOverride=0,yumeDance=0)
#DIM HasPiss
#DIM HasScat
#DIM EndOutcome
#DIM DreamOverride
#DIM CHARA
#DIM PlayerDice
#DIM LocalDice
#DIM PlayerHealth
#DIM DamageThreshold
#DIM DamageTake
#DIM RandomChara
#DIM yumeDance
IF inTrain != 3
	VARSET DAILY_Lucid_Stats
	VARSET DAILY_LUCID_CLOTHES, -1
	DAILY_Lucid_Stats:1 = HasPiss
	DAILY_Lucid_Stats:2 = HasScat
	DAILY_Lucid_Stats:3 = DreamOverride
	DAILY_Lucid_Stats:4 = CFLAG:MASTER:300
	DAILY_Lucid_Stats:5 = TIME
	DAILY_Lucid_Stats:8 = EQUIP:MASTER:6
	DAILY_Lucid_Stats:15 = TIME:1
	DAILY_Lucid_Stats:16 = yumeDance
	;clear eternal desperation
	CLEARBIT YoujutsuEffects:MASTER:18,34
	CFLAG:MASTER:デート中 = 18
	FOR LOCAL,0,VARSIZE("DAILY_LUCID_CLOTHES")
	DAILY_LUCID_CLOTHES:LOCAL = EQUIP:MASTER:LOCAL
	NEXT
	;PRINTFORML Due to Eramaker restrictions, your save will be reloaded.
	CALL TempVarSave
	inTrain = 3
	SAVEDATA 302, "Lucid Dream Temp Save"
	;FORCEWAIT
	LOADDATA 302
	RETURN
ENDIF
yumeDance = DAILY_Lucid_Stats:16
EndOutcome = 0
LocalDice = 0
FOR LOCAL,0,CHARANUM
CALL LucidDreamCacheClothes(LOCAL)
NEXT
CALLF PANTY_REWORK_CHANGE(MASTER,今日のぱんつ(MASTER))
CFLAG:MASTER:現在位置 = 1810
;TFLAG:妄想中 = 1
;Get Dream
;Blank means to go anyway
IF !DreamOverride
	$GetDream
	VARSET DAILY_Lucid_Type
	VARSET DAILY_Lucid_Name
	DreamOverride = (RAND:DAILY_Lucid_Max)+1
	TRYCALLFORMF LUCID_DREAM_INFO_{DreamOverride}
	SIF DAILY_Lucid_Type != ARGS && STRLENS(ARGS)
		GOTO GetDream
	SELECTCASE DAILY_Lucid_Type
		CASE "Pee"
			;fetish toggles
			SIF !GETBIT(nPee,1) && !GETBIT(nScat,2)
				GOTO GetDream
			SIF !HasPiss && !HasScat
				GOTO GetDream
			IF FIRSTTIME("DoremyPeeTutorial")
				DreamOverride = 99
			ENDIF
		CASE "Sex"
			SIF !nSex
				GOTO GetDream
	ENDSELECT
	SIF !STRLENS(DAILY_Lucid_Name) ; invalid
		GOTO GetDream
ENDIF
DAILY_Lucid_Stats:3 = DreamOverride
;get a random character
CALL FISHER_YATES_SHAFFLE(CHARANUM)
VARSET LOCAL
FOR RandomChara, 0, CHARANUM
CHARA = SHAFFLE_ARRAY:(RandomChara)
;対象があなた
SIF CHARA == MASTER
	CONTINUE
SIF TALENT:CHARA:行きずり
	CONTINUE
SIF CFLAG:CHARA:出禁 ;ignore banned characters
	CONTINUE
; CALL Add_Duplicate_Character(CHARA)
; DAILY_Lucid_Chara:(LOCAL:15) = RESULT
DAILY_Lucid_Chara:(LOCAL:15) = CHARA
LOCAL:15 ++
NEXT
; ;loop again
; FOR RandomChara, 1, CHARANUM
; 	CHARA = SHAFFLE_ARRAY:(RandomChara)
; 	SIF GROUPMATCH(DAILY_Lucid_Chara:(RandomChara-1), MASTER, [[モブ子]])
; 		DAILY_Lucid_Chara:(RandomChara-1) = CHARA
; NEXT
SETBGCOLOR 0, 0, 102
IF yumeDance
	TRYCALLFORM LUCID_EV{DreamOverride}_YumeDance_Init(MASTER)
ELSE
	PRINTFORMDL 잠든 사이에 당신은 자각몽을 꾸게 된다...
	IF nSpoilerMode
		CALL LucidDreamRecollection_Info(DreamOverride,0)
		DRAWLINE
	ENDIF
ENDIF
$ResetDream
SELECTCASE DreamOverride
	CASEELSE
		TRYCALLFORM LUCID_DREAM_START_{DAILY_Lucid_Stats:3}
ENDSELECT
$END
;Outcome determined by what underwear you were wearing

@LucidDreamLoser(hasIntent)
#FUNCTION
#DIM hasIntent
IF IsPadded(MASTER)
	X = 20
ELSE
	X = 10
ENDIF
SIF hasIntent
	X += hasIntent
RETURNF X
;Ending flavor text
; 0: Undetermined.
; 1: Held it and relieved self
; 2: Relived self in a non-nomal location
;10: Genuine accident
;11: Intentional accident
;12: Genuine toilet accident
;20: Genuine accident (padded)
;21: Intentional accident (padded)
;22: Genuine toilet accident (padded)
;61: Dream Paradox
;62: Left area

@LucidDreamEnd()
TRYCALLFORM LUCID_DREAM_END_{DAILY_Lucid_Stats:3}
$Bypass
TRYCALLFORMF LUCID_DREAM_INFO_{DAILY_Lucid_Stats:3}
SELECTCASE DAILY_Lucid_Type
	CASE "Nightmare"
		SELECTCASE DAILY_Lucid_Stats:9
			CASE 1,2
				CALL COLORMESSAGE(@"생명이 승리했다!",C_GREEN,1,1)
			CASE 10,12
				CALL COLORMESSAGE(@"패배자!",C_RED,1,1)
		ENDSELECT
	CASE "Normal"
		SELECTCASE DAILY_Lucid_Stats:9
			CASE 1
				CALL COLORMESSAGE(@"생명이 승리했다!",C_GREEN,1,1)
			CASE 10
				CALL COLORMESSAGE(@"패배자!",C_RED,1,1)
		ENDSELECT
	CASE "Pee"
		SELECTCASE DAILY_Lucid_Stats:9
			CASE 20 TO 29
				CALL COLORMESSAGE(@"패배자! 하지만 쿠션 덕분에 살았다!",C_ORANGE,2,1)
			CASE 10 TO 19
				CALL COLORMESSAGE(@"패배자!",C_RED,1,1)
			CASE 1
				CALL COLORMESSAGE(@"생명이 승리했다!",C_GREEN,1,1)
			CASE 2
				CALL COLORMESSAGE(@"생명이 승리한다?",C_GREEN,1,1)
			CASE 61
				CALL COLORMESSAGE(@"꿈의 역설인가?!",C_PINK,2,1)
			CASE 62
				CALL COLORMESSAGE(@"(왼쪽 꿈)",C_YELLOW,2,1)
		ENDSELECT
ENDSELECT
CALL COLORMESSAGE(@"(%LucidDreamEndingName(DAILY_Lucid_Stats:9)% 종료)",C_YELLOW,2,1)
LOADGLOBAL
SETBIT DAILY_Lucid_Progress:(DAILY_Lucid_Stats:3), DAILY_Lucid_Stats:9
SAVEGLOBAL

