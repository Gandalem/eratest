;relieve yourself or have an accident in the dream which results you in having an accident for real.

@LucidDreamTimeUp()
CALL LucidDreamEnd()
CALL LucidDreamAfter()
BEGIN AFTERTRAIN
;After the lucid dream
;You'll most likely wet or mess yourself in bed.

@LucidDreamAfter()
;TCVAR:MASTER:906 = 0
;TCVAR:LOCAL:906 = 0
STOPSOUND
FOR LOCAL,0,CHARANUM
CALL LucidDreamReleaseClothes(LOCAL)
NEXT
CFLAG:MASTER:デート中 = MAIN_MAP
CFLAG:MASTER:300 = DAILY_Lucid_Stats:4
TIME = DAILY_Lucid_Stats:5
TFLAG:妄想中 = 0
CALLF PANTY_REWORK_CHANGE(MASTER,DAILY_Lucid_Stats:8)
BASE:MASTER:0 = MAXBASE:MASTER:0
DAILY_Lucid_Stats = 1
RESETBGCOLOR
RESETCOLOR
TRYCALLFORMF LUCID_DREAM_INFO_{DAILY_Lucid_Stats:3}
SELECTCASE DAILY_Lucid_Type
	CASE "Nightmare"
		IF DAILY_Lucid_Stats:9 == 10
			CALL BEDWETTING(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,0,1)
		ENDIF
	CASE "Sex"
		IF DAILY_Lucid_Stats:9 == 11
			CALL BEDWETTING(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,0,1)
		ELSEIF DAILY_Lucid_Stats:9 == 10
			CALL LucidDreamEjac
		ENDIF
	CASE "Pee"
		IF DAILY_Lucid_Stats:9 == 62
			PRINTFORML
			CALL DAILY_EV_901(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2)
		ELSEIF DAILY_Lucid_Stats:9 == 59
		ELSE
			PRINTFORML
			CALL BEDWETTING(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,0,1)
		ENDIF
ENDSELECT
