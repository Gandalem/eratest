;Recollection menu
@LucidDreamRecollection
#DIM nLineCnt_Head
LOADGLOBAL
CUSTOMDRAWLINE ＊
PRINTFORML Lucid Dream Recollection
CUSTOMDRAWLINE ＊
SETCOLOR C_RED
PRINTFORML Lucid dream progress is saved between all saves
RESETCOLOR
PRINTFORML
nLineCnt_Head = LINECOUNT
REDRAW 0
DO
	SIF LINECOUNT - nLineCnt_Head > 0
		CLEARLINE LINECOUNT - nLineCnt_Head

	CALL LucidDreamRecollection_State
	SELECTCASE RESULT
		CASE 0, 
			SAVEGLOBAL
			RETURN
		CASE 88890, -1
			SAVEGLOBAL
			RETURN RESULT
	CASEELSE
	ENDSELECT
LOOP 1

@LucidDreamRecollection_State
#DIM 	 CREDRAW
#DIM     PAGE       ;表示中のページ
#DIMS CONST DISP_NAME = "Normal", "Nightmare", "Sex", "Pee"
#DIM FIRST_LINE
#DIM nTempDream
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
CALL LucidDreamRecollection_Page(PAGE, DISP_NAME:PAGE)
DRAWLINE
FOR LOCAL, 0, VARSIZE("DISP_NAME")
	SIF LOCAL == 3 && !GETBIT(nPee,1) && !GETBIT(nScat,2)
		CONTINUE
	SIF PAGE == LOCAL
		SETCOLOR 0x00FFFF
	PRINTBUTTON DISP_NAME:LOCAL, LOCAL + 8002
	RESETCOLOR
	PRINTFORM 　　
NEXT
PRINTFORML 
;#;PRINTBUTTON "[-1] Random", -1
PRINTBUTTON "[0] Return", 0
DO
	INPUT
	SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 8002 TO VARSIZE("DISP_NAME")+8002
		PAGE = RESULT-8002
	CASE -1
		RETURN -1
	CASE 0 TO DAILY_Lucid_Max
		nTempDream = RESULT
		CALL LucidDreamRecollection_Info(nTempDream)
		;debug
		IF RESULT == 88890
			;set dream
			DAILY_Lucid_Stats:3 = nTempDream
			RETURN 88890
		ENDIF
	CASEELSE
		$RETRY
		REUSELASTLINE Invalid Input
		CONTINUE
	ENDSELECT
	BREAK
LOOP 1
GOTO REPRINT

@LucidDreamRecollection_Page(nCurPage, nTag)
#DIM DYNAMIC nCurPage
#DIMS DYNAMIC nTag
FOR LOCAL, 0, DAILY_Lucid_Max
	VARSET DAILY_Lucid_Type
	TRYCALL LucidDreamRecollection_Individual(LOCAL, nTag)
NEXT

@LucidDreamRecollection_Individual(DREAM, nType)
#DIM DYNAMIC DREAM
#DIMS DYNAMIC nType
#DIM DYNAMIC endingCount, 2
VARSET endingCount
VARSET DAILY_Lucid_EndingAvailable

TRYCALLFORMF LUCID_DREAM_INFO_{DREAM}
SIF TOLOWER(nType) != TOLOWER(DAILY_Lucid_Type)
	RETURN

PRINTBUTTON @"%DAILY_Lucid_Name%", DREAM
PRINTL
SETCOLOR C_GRAY
FOR LOCAL,0,100
	LOCAL:1 = TOINT(SPLIT_SINGLE(DAILY_Lucid_EndingAvailable, LOCAL, "/"))
	endingCount++
	SIF !LOCAL:1
		BREAK
	IF GETBIT(DAILY_Lucid_Progress:DREAM, (LOCAL:1))
		SETCOLOR C_YELLOW
	ENDIF
	PRINTFORM %LucidDreamEndingName(LOCAL:1,1,DREAM)%
	SETCOLOR C_GRAY
	SIF LOCAL != STRCOUNT(DAILY_Lucid_EndingAvailable,"/")
		PRINTFORM /
NEXT
RESETCOLOR
PRINTL

@LucidDreamRecollection_Info(DREAM, IsInteractive = 1)
#DIM DREAM
#DIM IsInteractive

TRYCALLFORMF LUCID_DREAM_INFO_{DREAM}
SIF !STRLENS(DAILY_Lucid_Name)
	RETURN

DRAWLINE
PRINTFORML %DAILY_Lucid_Name%
SETCOLOR C_GRAY
PRINTFORML %DAILY_Lucid_Type% Dream
RESETCOLOR
PRINTL
PRINTFORML  %DAILY_Lucid_Desc%
SIF !IsInteractive
	RETURN
CALL PRINTLINE, "Endings Gotten"
FOR LOCAL,0,100
	LOCAL:1 = TOINT(SPLIT_SINGLE(DAILY_Lucid_EndingAvailable, LOCAL, "/"))
	SIF !LOCAL:1
		BREAK
	IF GETBIT(DAILY_Lucid_Progress:DREAM, (LOCAL:1))
		SETCOLOR C_YELLOW
		PRINTFORML %LucidDreamEndingName(LOCAL:1,0, DREAM)%
	ENDIF
NEXT
RESETCOLOR
DRAWLINE
IF DAILY_Lucid_Type != "Pee" || DAILY_Lucid_Stats:14
	PRINTFORML [0] - Reminisce
ENDIF
SIF nPee
PRINTFORML [1] - Reminisce (Wet)
SIF nScat
PRINTFORML [2] - Reminisce (Mess)
SIF nPee && nScat
PRINTFORML [3] - Reminisce (Dual)
PRINTFORML [9] - Leave
INPUT
D = RESULT
SELECTCASE RESULT
CASE 0 TO 3
	IF DAILY_Lucid_Stats:14
		RETURN 88890
	ELSE
		CALL LucidDream(MASTER,GETBIT(D,0) , GETBIT(D,1),DREAM)
	ENDIF
ENDSELECT




;Lucid dream
