@LUCID_DREAM_INFO_19
#FUNCTION
DAILY_Lucid_Name '= "자위하다 들켰나?"
DAILY_Lucid_Desc '= "한밤중에 잠에서 깬 당신은 다시 잠들 방법을 찾아야 한다. 하지만 몸은 당장 화장실에 가라고 아우성친다!\n몸의 요구를 들어줄까, 아니면 끝까지 참아 볼까?\n기본 TW 이벤트를 바탕으로 제작된 꿈."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
;DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/2/10/11/20/21/22/61/62"
DAILY_Lucid_CanGiveUp = 3
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_19
PRINTFORMW 한밤중에 잠에서 깬다.
PRINTFORMW 다시 잠들기는 불가능해 보인다...
PRINTFORML [0] - 너는 그저 꿈을 꾸고 있을 뿐이야
PRINTFORML [400] - 밖에 나가라
PRINTFORML [402] - 방에 있어라
PRINTFORML [357] - 용변을 봐
INPUT
SELECTCASE RESULT
	CASE 0
		PRINTFORMW 팔을 꼬집어 자신이 잠들었는지 확인하기로 한다.
		PRINTFORMW 아무런 고통도 느껴지지 않는다... 이건 꿈이다...
		PRINTFORMW 다시 눈을 뜨자, 자신은 침대에 누워 있는 것을 발견한다.
		PRINTFORMW 꿈은 끝났지만 방광은 여전히 매우 가득 차 있다.
		PRINTFORMW 꿈 때문에 잠에서 쌌다면 정말 %FSYN("shame")% 상황이었을 거라 생각한다.
		PRINTL
		PRINTFORMW 잠에서 깨어나, 너는 화장실과 욕실로 향하기 시작한다.
		CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
		PRINTFORML 당신의 %FSYN("crotch")%이 극도로 따뜻하고 기분 좋게 느껴지는 게 이상하다...
		DAILY_Lucid_Stats:9 = 61
		CALL LucidDreamTimeUp()
	CASE 357
		PRINTFORMW 팔을 움직이려 하지만 무언가가 그것들을 잡아당기는 느낌이다.
		PRINTFORMW 이유를 알아내려고 주변을 둘러보지만, 침대에 쇠사슬로 묶여 있다는 것을 깨닫는다.
		PRINTFORML
		PRINTFORMW 지금 해결해야 할 문제는 두 가지가 있다:
		PRINTFORMW 첫 번째는 이 속박에서 어떻게 벗어날 것인가이다.
		PRINTFORMW 그리고 두 번째는 방광이 포기하기 전에 그것을 해낼 수 있을지 여부다.
		PRINTFORMW
		DAILY_Lucid_Stats:7 = 30
		BASE:MASTER:0 = MAXBASE:MASTER:0
		IF DAILY_Lucid_Stats:1
			CALLF PEEME(MASTER, 4)
		ENDIF
		IF DAILY_Lucid_Stats:2
			CALLF POOME(MASTER, 4)
		ENDIF
	CASE 400
		IF !RAND:4
			PRINTFORMW \@ CFLAG:MASTER:311 == CFLAG:DAILY_Lucid_Chara:311 ? 당신은 참느라 뒤틀린 걸음으로 방으로 돌아가다 무언가를 듣는다 # 당신은 참느라 뒤틀린 걸음으로 %CALLNAME:DAILY_Lucid_Chara%의 방 앞을 지나다 안에서 무언가를 듣는다 \@.
			DAILY_Lucid_Stats:9 = 61
			CALL LucidDreamTimeUp()
			;CALL FAKE_UFUFU(LOCAL,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2)
		ELSEIF !RAND:2
			$OYATU
			PRINTFORML 배가 조금 고파진 당신은 잠들기 전에 뭔가 먹기로 한다.
			PRINTFORMW 부엌 찬장을 뒤져 간식 하나를 찾아낸다.
			PRINTFORMW 직접 산 것은 아니지만 누군가 당신을 위해 사 둔 모양이라, 망설이지 않고 꺼낸다.
			PRINTFORML
			CALL COLORMESSAGE("아뇨, 곧 만료될 거예요! 누가 빨리 먹어주지 않을래요?!",C_YELLOW,2,2)
			PRINTFORML
			PRINTFORML 잘 먹겠다고 중얼거리며 간식을 먹는다.
			CALL BUFF_BASE(MASTER,BASE_気力,300)
			CALL COLORMESSAGE(@"당신의 맛있는 간식을 먹은 후 ENE가 일시적으로 증가했다.",C_YELLOW,2,1)
			PRINTFORMW 다시 이를 닦고 기분 좋게 잠자리에 든다.
			DAILY_Lucid_Stats:9 = 62
			CALL LucidDreamTimeUp()
		ELSE
			$NANIMONAI
			PRINTFORMW 밖에 나가는 건 별로 흥미롭지 않아서, 대신 용변을 보기로 결정한다.
			PRINTFORMW 쪼그리고 앉아 황홀경에 빠지면서 축축한 %PeeProtectType(MASTER,1)%를 움직인다.
			PRINTFORML
			SIF DAILY_Lucid_Stats:1
				CALL PEESOUNDS("v")
			IF DAILY_Lucid_Stats:2
				IF TCVAR:MASTER:BowelState > 0
					CALL POOSOUNDS("d")
				ELSE
					CALL POOSOUNDS("v")
				ENDIF
			ENDIF
			PRINTFORM 당신이 남긴 흔적에는%" "%
			IF DAILY_Lucid_Stats:1
				PRINTFORM 맑은 %FSYN("pee:n")% 웅덩이가
			ENDIF
			SIF DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2
				PRINTFORM 과
			IF DAILY_Lucid_Stats:2
				IF TCVAR:MASTER:BowelState > 0
					PRINTFORM 항문에서 쏟아진 %SCAT(MASTER,1)% 더미가
				ELSE
					PRINTFORM 아이스크림처럼 밀려 나온 %SCAT(MASTER,1)% 더미가
				ENDIF
			ENDIF
			PRINTFORM 남아, 결국 해냈음을 증명하고 있다.
			WAIT
			DAILY_Lucid_Stats:9 = 2
			CALL LucidDreamTimeUp()
		ENDIF
	CASE 402
		PRINTFORM 당신은
		PRINTDATA
			DATAFORM 가끔 소장품을 정리하며 감상하다가
			DATAFORM 아름다움과 선, 그리고 \@ nOmutsu ? 기저귀 # 팬티 \@에 대해 깊이 생각하다가
			DATAFORM 벽에 남은 얼룩을 멍하니 바라보다가
		ENDDATA
		PRINTFORML  다시 잠들려던 순간...
		PRINTFORMW 하지만 갑자기 화들짝 깨어난다.
		PRINTFORMW 방광이 결국 한계까지 차오른 것이다.
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
ENDSELECT
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_19
; ;When a command ends
; @LUCID_DREAM_TURN_19
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_19(nInput)
#DIM nInput
SELECTCASE DAILY_Lucid_Stats:10
	CASE 0
		SELECTCASE nInput
			CASE 0
				PRINTFORML 눈앞에서 자신을 해방할 방법이 없자, 당신은 사슬에 저항한다.
				DAILY_Lucid_Stats:7 -= ABL:MASTER:Melee
				BASE:MASTER:0 -= 50
				BASE:MASTER:尿意 += RAND:75
				BASE:MASTER:Poo += RAND:75
				WAIT
			CASE 1
				PRINTFORML 당신은 스스로를 해방시키기 위해 모든 노력을 사용한다.
				DAILY_Lucid_Stats:7 -= (ABL:MASTER:Melee *2)
				BASE:MASTER:0 -= 200
				WAIT
		ENDSELECT
		SELECTCASE DAILY_Lucid_Stats:7
			CASE IS <= 0
				PRINTFORML 수갑이 부서지고 너는 감금에서 자유로워졌다!
				DAILY_Lucid_Stats:10 = 1
				;stage transition
				PRINTFORMW 당신은 침대에서 일어나 화장실로 향하는데, 가는 길에 특이한 소리를 듣는다.
				PRINTFORMW 화장실에 도착해 문고리를 돌리려 하지만 전혀 움직이지 않는다.
				PRINTFORMW 문은 완전히 잠겨 있었다.
				PRINTFORMW 그러고 나서 문에 '사용 중'이라는 표지판이 붙어 있는 것을 깨닫고, 안에 있는 사람이 곧 나올 건지 두드리기 시작한다...
				PRINTFORML .
				PRINTFORML ..
				PRINTFORMW ...
				PRINTFORMW 대답은 없다...
				PRINTFORMW 아래를 내려다보았을 때, 자신이 듣고 있던 소음이 기저귀 바스락거리는 소리였다는 것을 깨닫고 다른 방법을 생각하려고 애쓴다.
				CALLF PANTY_REWORK_CHANGE(MASTER,103)
				DAILY_Lucid_Stats:7 = RAND:90
				RETURN
			CASE IS < 5
				PRINTFORML 금속 조각 하나만이 수갑을 침대에 붙이고 있다.
			CASE IS < 10
				PRINTFORML 사슬들이 부서지기 시작한다.
			CASE IS < 20
				PRINTFORML 그들은 사소한 마모의 징후를 보이기 시작한다.
			CASEELSE
				PRINTFORML 그들은 약점의 기미를 보이지 않는 것 같다.
		ENDSELECT
		IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7) || BASE:MASTER:0 <= 500 || nInput == 9
			PRINTFORMW 운명에 체념하자, 한계에 달한 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"방광","대장")%의 둑이 무너진다...
			CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
			PRINTFORMW 당신의 얼굴은 붉게 달아오르고 있으며, 항문 아래 침대 위로 축축한 자국이 천천히 커진다.
			DAILY_Lucid_Stats:9 = LucidDreamLoser()
			CALL LucidDreamTimeUp()
		ENDIF
	CASE 1
		SELECTCASE nInput
			CASE 0
				PRINTFORMDW 너는 해방의 유혹을 견딘다.
				BASE:MASTER:0 -= 50
				BASE:MASTER:尿意 += RAND:75
				BASE:MASTER:Poo += RAND:75
				PeeHoldExp:MASTER:0 += 1
				DAILY_Lucid_Stats:7 -= 5
			CASE 1
				PRINTFORMDW 당신은 해방의 유혹을 필사적으로 견딘다.
				BASE:MASTER:0 -= 200
				PeeHoldExp:MASTER:0 += 2
				DAILY_Lucid_Stats:7 -= 5
		ENDSELECT
		IF DAILY_Lucid_Stats:7 <= 0
			PRINTFORMDW 당신은 변기 바로 앞에 서서 안도감을 갈망하며, 문이 열리자마자 뛰어들 준비를 한다.
			PRINTFORMDW 문이 살짝 열리고, %CALLNAME:DAILY_Lucid_Chara%가 나간다, 그리고 당신은 변기로 달려든다.
			CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
			IF RESULT <= 0
				DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
				CALL LucidDreamTimeUp()
			ENDIF
			PRINTFORMDW 가까스로 기저귀를 벗고 변기에 앉는다. 조금만 늦었어도 그대로 실수할 뻔했다.
			PRINTFORMDW 너는 자신이 버텨냈다는 사실에 놀라 스스로 등을 토닥인다.
			DAILY_Lucid_Stats:9 = 1
			CALL LucidDreamTimeUp()
		ELSEIF (PeeBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2) || BASE:MASTER:0 <= 500
			CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
			PRINTFORML
			PRINTFORMW %CALLNAME:(DAILY_Lucid_Chara)%은 문을 열고 당신이 처한 굴욕적인 상태를 보게 된다.
			PRINTFORMW %HE_SHE(DAILY_Lucid_Chara,1)%은 당신에게 가여움을 느낀다.
			DAILY_Lucid_Stats:9 = LucidDreamLoser()
			CALL LucidDreamTimeUp()
		ENDIF
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_19(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE DAILY_Lucid_Stats:10
	CASE 0
		SELECTCASE nCom
			CASE 0
				DAILY_Lucid_ComName '= "몸부림친다 (STA 50)"
			CASE 1
				DAILY_Lucid_ComName '= "필사적으로 몸부림친다 (STA 200)"
			CASE 8
				DAILY_Lucid_ComName '= "도움을 청한다"
		ENDSELECT
	CASE 1
		SELECTCASE nCom
			CASE 0
				DAILY_Lucid_ComName '= "참는다 (STA 50)"
			CASE 1
				DAILY_Lucid_ComName '= "필사적으로 참는다 (STA 200)"
		ENDSELECT
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
;Status page for Carry Status
