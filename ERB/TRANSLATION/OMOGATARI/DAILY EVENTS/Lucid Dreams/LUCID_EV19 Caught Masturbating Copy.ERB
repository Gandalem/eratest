@LUCID_DREAM_INPUT_STATUS_19
#FUNCTIONS
SELECTCASE DAILY_Lucid_Stats:10
	CASE 0
		DAILY_Lucid_InfoTab '= @"구속력 내구도: {100*DAILY_Lucid_Stats:7/30}\%"
	CASE 1
		DAILY_Lucid_InfoTab '= @"열기까지 남은 시간: {DAILY_Lucid_Stats:7}분."
ENDSELECT
RETURNF DAILY_Lucid_InfoTab
;----------------------------
;Giving up
;----------------------------

@LUCID_DREAM_GIVEUP_19
SELECTCASE DAILY_Lucid_Stats:10
	CASE 0
		PRINTFORMW 운명을 받아들이자, 한계에 달한 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"방광","대장")%의 둑이 무너진다...
		CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
		PRINTFORMW 당신의 얼굴은 밝게 새빨개지고, 항문 아래 침대 위로 축축한 얼룩이 천천히 번져나간다.
	CASE 1
		CALL LUCID_DREAM_GIVEUP_DIAPER_19
ENDSELECT
DAILY_Lucid_Stats:9 = LucidDreamLoser(1)
CALL LucidDreamTimeUp()
