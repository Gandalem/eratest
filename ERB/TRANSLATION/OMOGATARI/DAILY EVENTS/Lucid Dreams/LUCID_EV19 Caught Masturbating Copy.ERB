; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV19 Caught Masturbating Copy.ERB
;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_19
#FUNCTION
DAILY_Lucid_Name '= "Caught Masturbating?"
DAILY_Lucid_Desc '= "You wake up in the middle of the night, and have to find a way to fall asleep. At the same time, your body is telling you to go!\n Do you listen to your body's demands, or try to hold it?\n Based on the vanilla TW event."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
;DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/2/10/11/20/21/22/61/62"
DAILY_Lucid_CanGiveUp = 3
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_19
PRINTFORMW %PARSE("You wake")%한밤중에.
PRINTFORMW 다시 잠들기는 불가능해 보인다...
PRINTFORML [0] - 너는 그저 꿈을 꾸고 있을 뿐이야
PRINTFORML [400] - 밖에 나가라
PRINTFORML [402] - 방에 있어라
PRINTFORML [357] - 용변을 봐
INPUT
SELECTCASE RESULT
	CASE 0
		PRINTFORMW 팔을 꼬집어 자신이 잠들었는지 확인하기로 한다.
		PRINTFORMW 아무런 고통도 느껴지지 않는다... 이건 꿈이다...
		PRINTFORMW 다시 눈을 뜨자, 자신은 침대에 누워 있는 것을 발견한다.
		PRINTFORMW 꿈은 끝났지만 방광은 여전히 매우 가득 차 있다.
		PRINTFORMW 꿈 때문에 잠에서 쌌다면 정말 %FSYN("shame")% 상황이었을 거라 생각한다.
		PRINTL
		PRINTFORMW 잠에서 깨어나, 너는 화장실과 욕실로 향하기 시작한다.
		CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
		PRINTFORML 당신의 %FSYN("crotch")%이 극도로 따뜻하고 기분 좋게 느껴지는 게 이상하다...
		DAILY_Lucid_Stats:9 = 61
		CALL LucidDreamTimeUp()
	CASE 357
		PRINTFORMW 팔을 움직이려 하지만 무언가가 그것들을 잡아당기는 느낌이다.
		PRINTFORMW 이유를 알아내려고 주변을 둘러보지만, 침대에 쇠사슬로 묶여 있다는 것을 깨닫는다.
		PRINTFORML
		PRINTFORMW 지금 해결해야 할 문제는 두 가지가 있다:
		PRINTFORMW 첫 번째는 이 속박에서 어떻게 벗어날 것인가이다.
		PRINTFORMW 그리고 두 번째는 방광이 포기하기 전에 그것을 해낼 수 있을지 여부다.
		PRINTFORMW
		DAILY_Lucid_Stats:7 = 30
		BASE:MASTER:0 = MAXBASE:MASTER:0
		IF DAILY_Lucid_Stats:1
			CALLF PEEME(MASTER, 4)
		ENDIF
		IF DAILY_Lucid_Stats:2
			CALLF POOME(MASTER, 4)
		ENDIF
	CASE 400
		IF !RAND:4
			PRINTFORMW %PARSE("You go")% 참아내려 애쓰는 고통스러운 걸음으로 \@ CFLAG:MASTER:311 == CFLAG:DAILY_Lucid_Chara:311 ? 그리고 %PARSE("you return",1)%에서 %PARSE("your",1)% 방 %PARSE("you hear",1)%으로 갈 때 소리가 들린다. # 그리고 ~할 때 %PARSE("you're",1)% 돌아가려던 %PARSE("you hear",1)% 에서 들리는 소리 %CALLNAME:DAILY_Lucid_Chara%의 방 \@.
			DAILY_Lucid_Stats:9 = 61
			CALL LucidDreamTimeUp()
			;CALL FAKE_UFUFU(LOCAL,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2)
		ELSEIF !RAND:2
			$OYATU
			PRINTFORML %PARSE("You feel")% 약간 배가 고프고 %PARSE("decide")% 뭔가 먼저 먹고 잠자리에 들려고 하다.
			PRINTFORMW %PARSE("You scrounge",1)% 부엌 찬장을 지나서 그리고 %PARSE("find")% 간식 하나
			PRINTFORMW 그것은 하나가 아니야 %PARSE("you",1)% 샀다. 하지만 누군가 그것을 샀을 가능성이 있으니 %PARSE("for you",1)%그래서 %PARSE("you take",1)% 그것을
			PRINTFORML 
			CALL COLORMESSAGE("아뇨, 곧 만료될 거예요! 누가 빨리 먹어주지 않을래요?!",C_YELLOW,2,2)
			PRINTFORML 
			PRINTFORML 간식으로서 %PARSE("You say")%와 %PARSE("you eat",1)%.
			CALL BUFF_BASE(MASTER,BASE_気力,300)
			CALL COLORMESSAGE(@"%PARSE("Your")% 맛있는 간식을 먹은 후 ENE가 일시적으로 증가했다.",C_YELLOW,2,1)
			PRINTFORMW %PARSE("You brush your")% 이빨 또 그리고 %PARSE("go")% 기분 좋게 잠자리에 들다.
			DAILY_Lucid_Stats:9 = 62
			CALL LucidDreamTimeUp()
		ELSE
			$NANIMONAI
			PRINTFORMW 밖에 나가는 건 별로 흥미롭지 않아서, 대신 용변을 보기로 결정한다.
			PRINTFORMW 쪼그리고 앉아 황홀경에 빠지면서 축축한 %PeeProtectType(MASTER,1)%를 움직인다.
			PRINTFORML
			SIF DAILY_Lucid_Stats:1
				CALL PEESOUNDS("v")
			IF DAILY_Lucid_Stats:2
				IF TCVAR:MASTER:BowelState > 0
					CALL POOSOUNDS("d")
				ELSE
					CALL POOSOUNDS("v")
				ENDIF
			ENDIF
			PRINTFORM A 
			IF DAILY_Lucid_Stats:1
				PRINTFORM 아름다운 %FSYN("pee:n")%가 땅에 고인다.
			ENDIF
			SIF DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2
				PRINTFORM %" and a "%
			IF DAILY_Lucid_Stats:2
				IF TCVAR:MASTER:BowelState > 0
					PRINTFORM 당신의 항문에서 %SCAT(MASTER,1)%가 분출되어 고여 있다.
				ELSE
					PRINTFORM %SCAT(MASTER,1)%이 아이스크림처럼 나와 쌓인다.
				ENDIF
			ENDIF
			PRINTFORM 당신이 해냈다는 것을 상기시키며.
			WAIT
			DAILY_Lucid_Stats:9 = 2
			CALL LucidDreamTimeUp()
		ENDIF
	CASE 402
		PRINTFORM %PARSE("You")% 
		PRINTDATA
			DATAFORM %PARSE("spend")% 가끔 정리하고 감상하는 %PARSE("your",1)% 컬렉션
			DATAFORM %PARSE("think")% 깊이 아름다움과 선에 대해 그리고 \@ nOmutsu ? 기저귀 # 팬티 \@
			DATAFORM 벽에 얼룩이 묻은 %PARSE("chat")%
		ENDDATA
		PRINTFORML  %PARSE("you feel",1)%가 다시 잠들 때까지...
		PRINTFORMW 하지만 갑자기 %PARSE("you wake")%은 뒷걸음질 친다.
		PRINTFORMW %PARSE("Your",1)%의 방광은 결국 너무 가득 찬 것이었다.
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
ENDSELECT
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_19
; ;When a command ends
; @LUCID_DREAM_TURN_19
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_19(nInput)
#DIM nInput
SELECTCASE DAILY_Lucid_Stats:10
	CASE 0
		SELECTCASE nInput
			CASE 0
				PRINTFORML 눈앞에서 자신을 해방할 방법이 없자, 당신은 사슬에 저항한다.
				DAILY_Lucid_Stats:7 -= ABL:MASTER:Melee
				BASE:MASTER:0 -= 50
				BASE:MASTER:尿意 += RAND:75
				BASE:MASTER:Poo += RAND:75
				WAIT
			CASE 1
				PRINTFORML 당신은 스스로를 해방시키기 위해 모든 노력을 사용한다.
				DAILY_Lucid_Stats:7 -= (ABL:MASTER:Melee *2)
				BASE:MASTER:0 -= 200
				WAIT
		ENDSELECT
		SELECTCASE DAILY_Lucid_Stats:7
			CASE IS <= 0
				PRINTFORML 수갑이 부서지고 너는 감금에서 자유로워졌다!
				DAILY_Lucid_Stats:10 = 1
				;stage transition
				PRINTFORMW 당신은 침대에서 일어나 화장실로 향하는데, 가는 길에 특이한 소리를 듣는다.
				PRINTFORMW 화장실에 도착해 문고리를 돌리려 하지만 전혀 움직이지 않는다.
				PRINTFORMW 문은 완전히 잠겨 있었다.
				PRINTFORMW 그러고 나서 문에 '사용 중'이라는 표지판이 붙어 있는 것을 깨닫고, 안에 있는 사람이 곧 나올 건지 두드리기 시작한다... 
				PRINTFORML .
				PRINTFORML ..
				PRINTFORMW ...
				PRINTFORMW 대답은 없다...
				PRINTFORMW 아래를 내려다보았을 때, 자신이 듣고 있던 소음이 기저귀 바스락거리는 소리였다는 것을 깨닫고 다른 방법을 생각하려고 애쓴다.
				CALLF PANTY_REWORK_CHANGE(MASTER,103)
				DAILY_Lucid_Stats:7 = RAND:90
				RETURN
			CASE IS < 5
				PRINTFORML 금속 조각 하나만이 수갑을 침대에 붙이고 있다.
			CASE IS < 10
				PRINTFORML 사슬들이 부서지기 시작한다.
			CASE IS < 20
				PRINTFORML 그들은 사소한 마모의 징후를 보이기 시작한다.
			CASEELSE
				PRINTFORML 그들은 약점의 기미를 보이지 않는 것 같다.
		ENDSELECT
		IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7) || BASE:MASTER:0 <= 500 || nInput == 9
			PRINTFORMW 운명에 체념한 당신의 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"bladder","colon")%가 물길이 열리며 깨진다...
			CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
			PRINTFORMW 당신의 얼굴은 붉게 달아오르고 있으며, 항문 아래 침대 위로 축축한 자국이 천천히 커진다.	
			DAILY_Lucid_Stats:9 = LucidDreamLoser()
			CALL LucidDreamTimeUp()
		ENDIF
	CASE 1
		SELECTCASE nInput
			CASE 0
				PRINTFORMDW 너는 해방의 유혹을 견딘다.
				BASE:MASTER:0 -= 50
				BASE:MASTER:尿意 += RAND:75
				BASE:MASTER:Poo += RAND:75
				PeeHoldExp:MASTER:0 += 1
				DAILY_Lucid_Stats:7 -= 5
			CASE 1
				PRINTFORMDW 당신은 해방의 유혹을 필사적으로 견딘다.
				BASE:MASTER:0 -= 200
				PeeHoldExp:MASTER:0 += 2
				DAILY_Lucid_Stats:7 -= 5
		ENDSELECT
		IF DAILY_Lucid_Stats:7 <= 0
			PRINTFORMDW 당신은 변기 바로 앞에 서서 안도감을 갈망하며, 문이 열리자마자 뛰어들 준비를 한다.
			PRINTFORMDW 문이 살짝 열리고, %CALLNAME:DAILY_Lucid_Chara%가 나간다, 그리고 당신은 변기로 달려든다.
			CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
			IF RESULT <= 0
				DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
				CALL LucidDreamTimeUp()
			ENDIF
			PRINTFORMDW 너는 \@ DAILY_Lucid_Stats:1 ? 젖다 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 더 더러워진다. #  \@하기 전에 기저귀를 벗고 변기에 앉을 시간이 거의 없다.
			PRINTFORMDW 너는 자신이 버텨냈다는 사실에 놀라 스스로 등을 토닥인다.
			DAILY_Lucid_Stats:9 = 1
			CALL LucidDreamTimeUp()
		ELSEIF (PeeBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2) || BASE:MASTER:0 <= 500
			CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
			PRINTFORML
			PRINTFORMW %CALLNAME:(DAILY_Lucid_Chara)%은 문을 열고 당신이 처한 굴욕적인 상태를 보게 된다.
			PRINTFORMW %HE_SHE(DAILY_Lucid_Chara,1)%은 당신에게 가여움을 느낀다.		
			DAILY_Lucid_Stats:9 = LucidDreamLoser()
			CALL LucidDreamTimeUp()
		ENDIF
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_19(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE DAILY_Lucid_Stats:10
	CASE 0
		SELECTCASE nCom
			CASE 0
				DAILY_Lucid_ComName '= "Struggle (50 STA)"
			CASE 1
				DAILY_Lucid_ComName '= "Struggle (200 STA)"
			CASE 8
				DAILY_Lucid_ComName '= "Call for help"
		ENDSELECT
	CASE 1
		SELECTCASE nCom
			CASE 0
				DAILY_Lucid_ComName '= "Hold it (50 STA)"
			CASE 1
				DAILY_Lucid_ComName '= "Hold it (200 STA)"
		ENDSELECT
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
;Status page for Carry Status
;----------------------------

@LUCID_DREAM_INPUT_STATUS_19
#FUNCTIONS
SELECTCASE DAILY_Lucid_Stats:10
	CASE 0
		DAILY_Lucid_InfoTab '= @"구속력 내구도: {100*DAILY_Lucid_Stats:7/30}\%"
	CASE 1
		DAILY_Lucid_InfoTab '= @"열기까지 남은 시간: {DAILY_Lucid_Stats:7}분."
ENDSELECT
RETURNF DAILY_Lucid_InfoTab
;----------------------------
;Giving up
;----------------------------

@LUCID_DREAM_GIVEUP_19
SELECTCASE DAILY_Lucid_Stats:10
	CASE 0
		PRINTFORMW 운명을 받아들이자, 당신의 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"bladder","colon")%가 문이 열리며 터진다...
		CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
		PRINTFORMW 당신의 얼굴은 밝게 새빨개지고, 항문 아래 침대 위로 축축한 얼룩이 천천히 번져나간다.	
	CASE 1
		CALL LUCID_DREAM_GIVEUP_DIAPER_19
ENDSELECT
DAILY_Lucid_Stats:9 = LucidDreamLoser(1)
CALL LucidDreamTimeUp()
;----------------------------
;Giving up but relieving self in diaper
;----------------------------

@LUCID_DREAM_GIVEUP_DIAPER_19
CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
PRINTFORMW 가장 창피하지 않은 선택이라고 생각하고, 당신은 기저귀에 소변을 보기로 결정한다. 그리고 방광을 비우면서 얼굴이 빨개지는 속도만큼 기저귀가 천천히 부풀어 오른다.
DAILY_Lucid_Stats:9 = LucidDreamLoser(1)
CALL LucidDreamTimeUp()
