;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_28
CALLF PooMe(MASTER)
CALL PRINT_GP("W", @"미로 속을 걸으면서, 당신의 장이 갑자기 고통으로 뒤틀리며 고통 속에 몸을 숙이게 만든다.")
CALL PRINT_GP("W", @"경련이 심하다, 매우 심하다. 발을 내디딜 때마다 경련은 견디기 점점 기하급수적으로 힘들어졌다.")
CALL PRINT_GP("W", @"절망에 이르게 되어 포기하게 만든다.")
CALL PRINT_GP("W", @"당신은 치정으로 몸을 웅크리고 무릎에 손을 대고 밀어낸다.")
CALL PoopyDescribe(MASTER)
CALL PRINT_GP("W", @"당신은 사고가 끝나자 고개를 젓는다.")
CALL PRINT_GP("W", @"기분이 나아졌다. 훨씬 더 좋아졌는데, 그러자 다시 배에서 꼬르륵 소리가 들린다.")
CALL PRINT_GP("W", @"기저귀를 갈아야 한다. 너의 장은 아직 만족하지 못하고 있고, 이미 기저귀는 가득 채워져 있다.")
;<DREAM START>
;Find clean diapers that you can poop inside to help ease the tummyache.
;Having a diaper blowout or defecating in the open is an automatic loss.
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_28
;diaper blowout
CALL PRINT_GP("W", @"당신의 시야가 갑자기 바뀌며 눈을 뜬다.")
CALL PRINT_GP("W", @"당황하며 기저귀 뒷부분을 움켜쥐고 실수했는지 확인한다.")
CALL PRINT_GP("W", @"네가 했다. 너는 확실히 실수를 했어")
;When a command ends

@LUCID_DREAM_TURN_28
