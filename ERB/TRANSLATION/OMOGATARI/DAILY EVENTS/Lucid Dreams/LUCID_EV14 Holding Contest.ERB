;----------------------------
;Info for the dream
;----------------------------
@LUCID_DREAM_INFO_14
#FUNCTION
DAILY_Lucid_Name '= "Holding Contest"
{
DAILY_Lucid_Desc '= "Compete against others in the dream world holding contest.\n
Beat 5 to become the champion!"
}
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "10/11/20/21/62"
DAILY_Lucid_CanGiveUp = 1

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_14
	PRINTFORMDW You're having a holding contest with %CALLNAME:DAILY_Lucid_Chara%. 
	PRINTFORMDW You're barely holding on, but %CALLNAME:DAILY_Lucid_Chara% seems to be struggling, too. 
	PRINTFORMDW Your \@ DAILY_Lucid_Stats:1 ? bladder #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? bowels #\@ gives an insistent twinge and you know this contest will be over soon.
	PRINTFORMDW What are you willing to do to win?
	BASE:MASTER:0 = MAXBASE:MASTER:0
	BASE:DAILY_Lucid_Chara:0 = MAXBASE:DAILY_Lucid_Chara:0
	IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
	CALLF PEEME(DAILY_Lucid_Chara, 4)
	ENDIF
	IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
	CALLF POOME(DAILY_Lucid_Chara, 4)
	ENDIF
	CALLF PANTY_REWORK_CHANGE(MASTER,EQUIP:MASTER:6 ? DAILY_Lucid_Chara # 2)
	CALLF PANTY_REWORK_CHANGE(DAILY_Lucid_Chara,EQUIP:DAILY_Lucid_Chara:6 ? DAILY_Lucid_Chara # 2)
	CALLF TP(DAILY_Lucid_Chara)
	SIF !TIME
		TIME = 60
	DAILY_Lucid_Stats:11 = PottyChartAccident:DAILY_Lucid_Chara:(DAY % 7)
	PRINTFORML

;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_14

;When a command ends
@LUCID_DREAM_TURN_14
	IF (PottyChartAccident:DAILY_Lucid_Chara:(DAY % 7) != DAILY_Lucid_Stats:11)
		PRINTFORMDW You're still reveling in the feeling of needing to go when %CALLNAME:DAILY_Lucid_Chara% finally gives up and \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:s")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:s")% #\@ %HIS_HER(DAILY_Lucid_Chara)%self.
		PRINTFORMDW You enjoy the view, before smugly sauntering off to the bathroom.	
		PRINTFORML %PARSE("You")% won against %CALLNAME:DAILY_Lucid_Chara%!
		CALL COLORMESSAGE(@"Life prevails!",C_GREEN,2,1)
		DAILY_Lucid_Stats:10 ++
		IF DAILY_Lucid_Stats:10 >= CHARANUM-2
		PRINTFORML How did you...
		PRINTFORML Well, that's a lot of puddles we'll have to clean up.
		PRINTFORML You can truly call yourself the 「True God of Holding」.
		CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("lucidEV14TrueGod")
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
		ELSEIF DAILY_Lucid_Stats:10 >= 5
		CALL COLORMESSAGE(@"ROUND %TOSTR(DAILY_Lucid_Stats:10)%/%TOSTR(CHARANUM)% complete!",C_GREEN,2,1)		
		CALL COLORMESSAGE(@"You are the dream world holding champion!",C_PINK,2,1)
		PRINTFORML But you can still continue on.
		CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("lucidEV14Beat")
		ELSE
		CALL COLORMESSAGE(@"ROUND %TOSTR(DAILY_Lucid_Stats:10)%/%TOSTR(CHARANUM)% (%TOSTR(5-DAILY_Lucid_Stats:10)% more for champion) complete!",C_GREEN,2,1)
		ENDIF
		CFLAG:DAILY_Lucid_Chara:300 = SUKIMA()
		DO
			DAILY_Lucid_Chara = DAILY_Lucid_Chara:(DAILY_Lucid_Stats:10)
			IF ((PeeHold:DAILY_Lucid_Chara:0 >= 6 && DAILY_Lucid_Stats:1) || !DAILY_Lucid_Stats:1) && ((PooHold:DAILY_Lucid_Chara:0 >= 6 && DAILY_Lucid_Stats:2) || !DAILY_Lucid_Stats:2)
				$HoldNewChara
				DAILY_Lucid_Stats:10 ++
				CONTINUE
			ENDIF
			SIF CFLAG:DAILY_Lucid_Chara:出禁 ;ignore banned characters
				GOTO HoldNewChara
			SIF IsDead:DAILY_Lucid_Chara:0 ;dead
				GOTO HoldNewChara
			SIF DAILY_Lucid_Chara == MASTER
				GOTO HoldNewChara
			SIF DAILY_Lucid_Stats:10 >= CHARANUM-2
				BREAK
			BREAK
		LOOP 1
		PRINTFORML Do you want to fight against %CALLNAME:DAILY_Lucid_Chara% next?
		CALL ASK_YN
		SELECTCASE RESULT
		CASE 0
		CALL LUCID_DREAM_START_14
		CASEELSE
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
		ENDSELECT
	ELSEIF BASE:MASTER:0 <= 500 || (PeeBarstage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2)
	$HoldContestLoss
		PRINTFORMDW You hold on for as long as you can.
		CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")	
		PRINTFORMDW But eventually, you have to admit defeat as \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% #\@ starts gushing out of you no matter how much you fidget and twist your legs and hold yourself.
		IF (PeeBarstage(DAILY_Lucid_Chara) >= 6 && DAILY_Lucid_Stats:1) || (PooBarStage(DAILY_Lucid_Chara) >= 6 && DAILY_Lucid_Stats:2)
		PRINTFORMDW You're not the only one who couldn't hold it anymore, though.
		CALL PlayAccidentSound(DAILY_Lucid_Chara,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")		
		PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara% looks at the growing \@ DAILY_Lucid_Stats:1 ? puddle #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? smell #\@ around %HIS_HER(DAILY_Lucid_Chara)% and loses the fight against %HIS_HER(DAILY_Lucid_Chara)% \@ DAILY_Lucid_Stats:1 ? bladder #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? bowels #\@ with a groan.
		PRINTFORMDW You watch their clothes \@ DAILY_Lucid_Stats:1 ? grow wet #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? bulge #\@ with rapt attention.
		PRINTFORMDW You may have lost the contest, but as far as you're concerned, you still won!	
		CALL COLORMESSAGE(@"Draw!",C_YELLOW,2,1)	
		CALL COLORMESSAGE(@"Won %TOSTR(DAILY_Lucid_Stats:10)%/5 rounds.",C_YELLOW,2,1)		
		PRINTFORML Do you want rematch %CALLNAME:DAILY_Lucid_Chara%?
		CALL ASK_YN
		SELECTCASE RESULT
		CASE 0
			PRINTFORML You feel your \@ DAILY_Lucid_Stats:1 ? bladder #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? bowels #\@ getting much fuller, in the same way you were bursting before.
			PRINTFORML Your pants also feel dry and clean.
			PRINTFORML It seems like time was reversed back to the start to the contest... 
			WAIT 
			CALL LUCID_DREAM_START_14
		CASEELSE
			DAILY_Lucid_Stats:9 = 0
			CALL LucidDreamTimeUp()
		ENDSELECT	
		ELSE
			PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara% laughs at your failure, before dashing off to the bathroom
			CALL COLORMESSAGE(@"Loser!",C_RED,2,1)	
			CALL COLORMESSAGE(@"Won %TOSTR(DAILY_Lucid_Stats:10)%/5 rounds.",C_YELLOW,2,1)
			DAILY_Lucid_Stats:9 = 0
			CALL LucidDreamTimeUp()
		ENDIF
	ENDIF

;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_14(nInput)
#DIM nInput
SELECTCASE nInput
CASE 0
	PRINTFORMDW You endure the temptation of release
	BASE:MASTER:0 -= 50
	BASE:MASTER:尿意 += RAND:75
	BASE:MASTER:Poo += RAND:75
	BASE:DAILY_Lucid_Chara:尿意 += RAND:75
	BASE:DAILY_Lucid_Chara:Poo += RAND:75
	PeeHoldExp:MASTER:0 += 1
CASE 1
	PRINTFORMDW You frantically endure the temptation of release
	BASE:MASTER:0 -= 200
	BASE:DAILY_Lucid_Chara:尿意 += RAND:75
	BASE:DAILY_Lucid_Chara:Poo += RAND:75
	PeeHoldExp:MASTER:0 += 2
CASE 9
	PRINTFORML Really tickle %CALLNAME:DAILY_Lucid_Chara%?
	CALL ASK_YN()
	SIF RESULT
		RETURN
	PRINTFORMDW There's a limit to your sense of fair play, and getting to see someone else \@ DAILY_Lucid_Stats:1 ? wet #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? mess #\@ their pants for a change is just too tempting.
	PRINTFORMDW Slowly, subtly, you shuffle over to %CALLNAME:DAILY_Lucid_Chara%, reaching out your fingers...
	PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara% squeaks in shock as your clever fingers find %HIS_HER(DAILY_Lucid_Chara)% ribs.
	SIF DAILY_Lucid_Stats:1
	CALL PEESOUNDS("s")
	SIF DAILY_Lucid_Stats:2
	CALL POOSOUNDS("f") 
	PRINTFORMDW It doesn't take long at all until a \@ DAILY_Lucid_Stats:1 ? wet #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? squishy #\@ spot appears on %HIS_HER(DAILY_Lucid_Chara)% clothes...
	SIF DAILY_Lucid_Stats:1
	CALL PEESOUNDS("hs")
	SIF DAILY_Lucid_Stats:2
	CALL POOSOUNDS("hf") 
	PRINTFORMDW Slowly growing...
	CALL PlayAccidentSound(DAILY_Lucid_Chara,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")	
	PRINTFORMDW And turning into a \@ DAILY_Lucid_Stats:1 ? puddle #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? bulge #\@.
	PRINTFORMDW You're still enjoying the view when the world around you fades before your eyes.
		PRINTFORML %PARSE("You")% won against %CALLNAME:DAILY_Lucid_Chara%!	
	CALL COLORMESSAGE(@"You were disqualified for cheating",C_RED,2,1)	
	CALL COLORMESSAGE(@"Won %TOSTR(DAILY_Lucid_Stats:10)%/5 rounds.",C_YELLOW,2,1)		
	DAILY_Lucid_Stats:9 = 62
ENDSELECT

;----------------------------
;Input names
;----------------------------
@LUCID_DREAM_INPUT_NAMES_14(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
CASE 0
	SIF BASE:MASTER:0 >= 50+500
	DAILY_Lucid_ComName '= "Hold it (50 STA)"
CASE 1
	SIF BASE:MASTER:0 >= 200+500
	DAILY_Lucid_ComName '= "Hold it (200 STA)"
CASE 9
	DAILY_Lucid_ComName '= @"Tickle %HIM_HER(DAILY_Lucid_Chara)%!"
ENDSELECT
RETURNF DAILY_Lucid_ComName

;----------------------------
;Status page for Carry Status
;----------------------------
@LUCID_DREAM_INPUT_STATUS_14
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"Score: {DAILY_Lucid_Stats:10}/{CHARANUM-2}"
RETURNF DAILY_Lucid_InfoTab

;----------------------------
;Spurting
;----------------------------
@LUCID_DREAM_SPURT_14
PRINTFORMDW You really aren't that good at holding your \@ DAILY_Lucid_Stats:1 ? pee #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? poo #\@, that's why you're wearing diapers after all. 
PRINTFORMDW But maybe, if you slowly and carefully let go into your diaper, you can \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #\@ without %CALLNAME:DAILY_Lucid_Chara% noticing and pretend you stayed dry!
PRINTFORMDW You carefully try to let go just a little...
IF DAILY_Lucid_Stats:1
DiapeCharges:MASTER:0 -= BASE:MASTER:尿意/2
BASE:MASTER:尿意 /= 2
ENDIF
IF DAILY_Lucid_Stats:2	
DiapePooCharges:MASTER:0 -= BASE:MASTER:Poo/2 		
BASE:MASTER:Poo /= 2	
ENDIF
IF (!RAND:(6+PeeHold:MASTER:0) && DAILY_Lucid_Stats:1) || (!RAND:(6+PooHold:MASTER:0) && DAILY_Lucid_Stats:2)
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")		
	PRINTFORMDW But once the flow has started, you can't stop!
	PRINTFORMDW The padding can't soak it all up quickly enough, and %CALLNAME:DAILY_Lucid_Chara% can hear the quiet sound of \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")% hissing #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% bulging #\@ into your diaper.
	PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara% looks at you.
	CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code		
	PRINTFORMW 「Did you just...?]
	RESETCOLOR
	CALL COLORMESSAGE(@"Loser!",C_RED,2,1)
	CALL COLORMESSAGE(@"Won %TOSTR(DAILY_Lucid_Stats:10)%/5 rounds.",C_YELLOW,2,1)
	DAILY_Lucid_Stats:9 = 20
	CALL LucidDreamTimeUp()
ELSEIF DiapeCharges:MASTER:0 <= 0 || DiapePooCharges:MASTER:0 <= 0
	PRINTFORMDW That felt better.
	PRINTFORMDW However, %CALLNAME:DAILY_Lucid_Chara% notices \@ DAILY_Lucid_Stats:1 ? a considerable %URINE(MASTER,1)% stain #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? a foul smell #\@ on your pants.
	PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara% calls you out on it.
	CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code		
	PRINTFORMW 「Did you just...?]
	RESETCOLOR
	CALL COLORMESSAGE(@"Loser!",C_RED,2,1)		
	CALL COLORMESSAGE(@"Won %TOSTR(DAILY_Lucid_Stats:10)%/5 rounds.",C_YELLOW,2,1)		
ELSE
	PRINTFORMDW That felt better.
	BASE:DAILY_Lucid_Chara:尿意 += RAND:75
	BASE:DAILY_Lucid_Chara:Poo += RAND:75
ENDIF

