; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV14 참기 대회.ERB
;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_14
#FUNCTION
DAILY_Lucid_Name '= "참기 대회"
DAILY_Lucid_Desc '= "꿈속 세계에서 다른 이들과 참기 대결을 벌인다.\n 다섯 명을 꺾고 우승자가 되어라!"
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "10/11/20/21/62"
DAILY_Lucid_CanGiveUp = 1
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_14
PRINTFORMDW 당신은 %CALLNAME:DAILY_Lucid_Chara%과 버티기 시합을 하고 있다.
PRINTFORMDW 당신은 간신히 버티고 있지만, %CALLNAME:DAILY_Lucid_Chara%도 힘들어하는 것 같다.
PRINTFORMDW 당신의 \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@는 계속해서 찌릿한 느낌을 주며 이 시합이 곧 끝날 것임을 당신은 안다.
PRINTFORMDW 승리를 위해 무엇을 할 의향이 있나?
BASE:MASTER:0 = MAXBASE:MASTER:0
BASE:DAILY_Lucid_Chara:0 = MAXBASE:DAILY_Lucid_Chara:0
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
	CALLF PEEME(DAILY_Lucid_Chara, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
	CALLF POOME(DAILY_Lucid_Chara, 4)
ENDIF
CALLF PANTY_REWORK_CHANGE(MASTER,EQUIP:MASTER:6 ? DAILY_Lucid_Chara # 2)
CALLF PANTY_REWORK_CHANGE(DAILY_Lucid_Chara,EQUIP:DAILY_Lucid_Chara:6 ? DAILY_Lucid_Chara # 2)
CALLF TP(DAILY_Lucid_Chara)
SIF !TIME
	TIME = 60
DAILY_Lucid_Stats:11 = PottyChartAccident:DAILY_Lucid_Chara:(DAY % 7)
PRINTFORML
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_14
;When a command ends

@LUCID_DREAM_TURN_14
IF (PottyChartAccident:DAILY_Lucid_Chara:(DAY % 7) != DAILY_Lucid_Stats:11)
	PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%은(는) 아직 가야 한다는 느낌에 취해 있다, 그것이 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:s")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:s")% #  \@ %HIS_HER(DAILY_Lucid_Chara)%자신.
	PRINTFORMDW 너는 만족스러운 듯 화장실로 성큼성큼 걸어가기 전 그 광경을 즐겼다.
	PRINTFORML 당신이(가) %CALLNAME:DAILY_Lucid_Chara%에게 이겼다!
	CALL COLORMESSAGE(@"생명이 승리했다!",C_GREEN,2,1)
	DAILY_Lucid_Stats:10 ++
	IF DAILY_Lucid_Stats:10 >= CHARANUM-2
		PRINTFORML 어떻게...
		PRINTFORML 음, 우리가 치워야 할 물웅덩이가 정말 많겠네.
		PRINTFORML 너 자신을 진정으로 「홀딩의 진정한 신」이라고 부를 수 있구나.
		CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("lucidEV14TrueGod")
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
	ELSEIF DAILY_Lucid_Stats:10 >= 5
		CALL COLORMESSAGE(@"라운드 %TOSTR(DAILY_Lucid_Stats:10)%/%TOSTR(CHARANUM)%는 완료했다!",C_GREEN,2,1)
		CALL COLORMESSAGE(@"당신은 꿈의 세계 홀딩 챔피언이다!",C_PINK,2,1)
		PRINTFORML 하지만 계속 진행할 수 있다.
		CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("lucidEV14Beat")
	ELSE
		CALL COLORMESSAGE(@"라운드 %TOSTR(DAILY_Lucid_Stats:10)%/%TOSTR(CHARANUM)% (%TOSTR(5-DAILY_Lucid_Stats:10)% 더 남음으로 챔피언 승리) 완료!",C_GREEN,2,1)
	ENDIF
	CFLAG:DAILY_Lucid_Chara:300 = SUKIMA()
	DO
	DAILY_Lucid_Chara = DAILY_Lucid_Chara:(DAILY_Lucid_Stats:10)
	IF ((PeeHold:DAILY_Lucid_Chara:0 >= 6 && DAILY_Lucid_Stats:1) || !DAILY_Lucid_Stats:1) && ((PooHold:DAILY_Lucid_Chara:0 >= 6 && DAILY_Lucid_Stats:2) || !DAILY_Lucid_Stats:2)
		$HoldNewChara
		DAILY_Lucid_Stats:10 ++
		CONTINUE
	ENDIF
	SIF CFLAG:DAILY_Lucid_Chara:出禁 ;ignore banned characters
		GOTO HoldNewChara
	SIF IsDead:DAILY_Lucid_Chara:0 ;dead
		GOTO HoldNewChara
	SIF DAILY_Lucid_Chara == MASTER
		GOTO HoldNewChara
	SIF DAILY_Lucid_Stats:10 >= CHARANUM-2
		BREAK
	BREAK
	LOOP 1
	PRINTFORML 다음에는 %CALLNAME:DAILY_Lucid_Chara%와 싸우고 싶습니까?
	CALL ASK_YN
	SELECTCASE RESULT
		CASE 0
			CALL LUCID_DREAM_START_14
		CASEELSE
			DAILY_Lucid_Stats:9 = 62
			CALL LucidDreamTimeUp()
	ENDSELECT
ELSEIF BASE:MASTER:0 <= 500 || (PeeBarstage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2)
	$HoldContestLoss
	PRINTFORMDW 네가 할 수 있는 한 오래 버텨라.
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	PRINTFORMDW 하지만 결국, 당신은 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% #  \@가 아무리 안절부절못하고 다리를 비틀고 스스로를 붙잡으려 해도 몸 밖으로 분출하기 시작한다는 것을 인정해야 했다.
	IF (PeeBarstage(DAILY_Lucid_Chara) >= 6 && DAILY_Lucid_Stats:1) || (PooBarStage(DAILY_Lucid_Chara) >= 6 && DAILY_Lucid_Stats:2)
		PRINTFORMDW 하지만 더는 참을 수 없었던 사람이 당신뿐만이 아니에요.
		CALL PlayAccidentSound(DAILY_Lucid_Chara,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
		PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%는 점점 커지는 \@ DAILY_Lucid_Stats:1 ? 웅덩이 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%와%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 냄새 #  \@around %HIS_HER(DAILY_Lucid_Chara)% and loses the fight, %HIS_HER(DAILY_Lucid_Chara)%DAILY_Lucid_Chara \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%와%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@을 상대로 한 싸움에서 신음과 함께 패배한다.
		PRINTFORMDW 당신은 그들의 옷이 \@ DAILY_Lucid_Stats:1 ? 젖어 가고 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%또한%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 부풀어 올라 #  \@가는 모습을 숨죽여 지켜본다.
		PRINTFORMDW 승부에서는 졌을지 몰라도, 당신이 보기에는 여전히 당신이 이긴 셈이다!
		CALL COLORMESSAGE(@"당기자!",C_YELLOW,2,1)
		CALL COLORMESSAGE(@"승리 %TOSTR(DAILY_Lucid_Stats:10)%의 /5라운드 동안.",C_YELLOW,2,1)
		PRINTFORML %CALLNAME:DAILY_Lucid_Chara%에게 리매치를 원하나요?
		CALL ASK_YN
		SELECTCASE RESULT
			CASE 0
				PRINTFORML 당신의 \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%와%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@이 전에 터질 듯했던 것과 같은 방식으로 훨씬 더 가득 차오르는 것이 느껴진다.
				PRINTFORML 바지도 마르고 깨끗한 느낌이다.
				PRINTFORML 시간이 대회의 시작으로 거꾸로 되돌아간 것 같다……
				WAIT
				CALL LUCID_DREAM_START_14
			CASEELSE
				DAILY_Lucid_Stats:9 = 0
				CALL LucidDreamTimeUp()
		ENDSELECT
	ELSE
		PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%는 당신의 실패를 비웃으며 화장실로 달려간다.
		CALL COLORMESSAGE(@"패배자!",C_RED,2,1)
		CALL COLORMESSAGE(@"윈 %TOSTR(DAILY_Lucid_Stats:10)% / 5 라운드 동안.",C_YELLOW,2,1)
		DAILY_Lucid_Stats:9 = 0
		CALL LucidDreamTimeUp()
	ENDIF
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_14(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		PRINTFORMDW 너는 해방의 유혹을 견딘다.
		BASE:MASTER:0 -= 50
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		BASE:DAILY_Lucid_Chara:尿意 += RAND:75
		BASE:DAILY_Lucid_Chara:Poo += RAND:75
		PeeHoldExp:MASTER:0 += 1
	CASE 1
		PRINTFORMDW 당신은 해방의 유혹을 필사적으로 견딘다.
		BASE:MASTER:0 -= 200
		BASE:DAILY_Lucid_Chara:尿意 += RAND:75
		BASE:DAILY_Lucid_Chara:Poo += RAND:75
		PeeHoldExp:MASTER:0 += 2
	CASE 9
		PRINTFORML 정말로 %CALLNAME:DAILY_Lucid_Chara%를 간지럽히나?
		CALL ASK_YN()
		SIF RESULT
			RETURN
		PRINTFORMDW 공평하게 행동하려는 마음에도 한계가 있고, 이번에는 다른 사람이 \@ DAILY_Lucid_Stats:1 ? 젖은 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%과 %" "% #  \@\@ DAILY_Lucid_Stats:2 ? 바지를 더럽히는 #  \@ 바지를 더럽히는 모습을 보는 건 정말 유혹적이다.
		PRINTFORMDW 천천히, 눈치채지 못하게 %CALLNAME:DAILY_Lucid_Chara%에게 슬금슬금 다가가 손가락을 뻗는다……
		PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%은 네 능숙한 손가락이 %HIS_HER(DAILY_Lucid_Chara)%의 갈비뼈를 찾아내자 놀라 끼익 소리를 낸다.
		SIF DAILY_Lucid_Stats:1
			CALL PEESOUNDS("s")
		SIF DAILY_Lucid_Stats:2
			CALL POOSOUNDS("f")
		PRINTFORMDW \@ DAILY_Lucid_Stats:1 ? wet #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? squishy #  \@ 자리에 %HIS_HER(DAILY_Lucid_Chara)% 옷에 나타나기까지 그리 오랜 시간이 걸리지 않았다...
		SIF DAILY_Lucid_Stats:1
			CALL PEESOUNDS("hs")
		SIF DAILY_Lucid_Stats:2
			CALL POOSOUNDS("hf")
		PRINTFORMDW 천천히 자라나고 있다...
		CALL PlayAccidentSound(DAILY_Lucid_Chara,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
		PRINTFORMDW 그리고 \@ DAILY_Lucid_Stats:1 ? 웅덩이로 변한다 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 불룩해진다 #  \@.
		PRINTFORMDW 주변 세계가 눈앞에서 사라지는 동안 당신은 여전히 그 광경을 즐긴다.
		PRINTFORML 당신는 %CALLNAME:DAILY_Lucid_Chara%를 상대로 승리했다!
		CALL COLORMESSAGE(@"당신은 부정행위로 실격 처리되었습니다.",C_RED,2,1)
		CALL COLORMESSAGE(@"윈 %TOSTR(DAILY_Lucid_Stats:10)% / 5 라운드 동안.",C_YELLOW,2,1)
		DAILY_Lucid_Stats:9 = 62
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_14(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		SIF BASE:MASTER:0 >= 50+500
			DAILY_Lucid_ComName '= "참는다(50 STA)"
	CASE 1
		SIF BASE:MASTER:0 >= 200+500
			DAILY_Lucid_ComName '= "참는다(200 STA)"
	CASE 9
		DAILY_Lucid_ComName '= @"%HIM_HER(DAILY_Lucid_Chara)%를 간지럽힌다!"
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
;Status page for Carry Status
;----------------------------

@LUCID_DREAM_INPUT_STATUS_14
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"점수: {DAILY_Lucid_Stats:10}/{CHARANUM-2}"
RETURNF DAILY_Lucid_InfoTab
;----------------------------
;Spurting
;----------------------------

@LUCID_DREAM_SPURT_14
PRINTFORMDW 넌 정말 \@ DAILY_Lucid_Stats:1 ? 오줌 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%그리고%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 똥 #  \@을 참는 데 서툴러, 결국 그래서 기저귀를 차고 있는 거야.
PRINTFORMDW 하지만 어쩌면, 천천히 조심스럽게 기저귀에 흘려보내면 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%그리고%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ %CALLNAME:DAILY_Lucid_Chara% 눈치채지 못한 채 젖지 않은 척할 수 있을지도 몰라!
PRINTFORMDW 조심스럽게 아주 조금만 흘려보내려고 해 본다……
IF DAILY_Lucid_Stats:1
	DiapeCharges:MASTER:0 -= BASE:MASTER:尿意/2
	BASE:MASTER:尿意 /= 2
ENDIF
IF DAILY_Lucid_Stats:2
	DiapePooCharges:MASTER:0 -= BASE:MASTER:Poo/2
	BASE:MASTER:Poo /= 2
ENDIF
IF (!RAND:(6+PeeHold:MASTER:0) && DAILY_Lucid_Stats:1) || (!RAND:(6+PooHold:MASTER:0) && DAILY_Lucid_Stats:2)
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	PRINTFORMDW 하지만 일단 흐르기 시작하면 멈출 수 없다!
	PRINTFORMDW 패드는 그 모든 것을 충분히 빠르게 흡수하지 못하고, %CALLNAME:DAILY_Lucid_Chara%는 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")%이 쉭쉭거린다 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%와 %" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")%이 불룩해진다 #  \@이 네 기저귀 속으로 흘러 들어가는 조용한 소리를 들을 수 있다.
	PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%은 너를 바라본다.
	CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
	PRINTFORMW 방금 ...한 거야?
	RESETCOLOR
	CALL COLORMESSAGE(@"패배자!",C_RED,2,1)
	CALL COLORMESSAGE(@"윈 %TOSTR(DAILY_Lucid_Stats:10)% / 5 라운드 동안.",C_YELLOW,2,1)
	DAILY_Lucid_Stats:9 = 20
	CALL LucidDreamTimeUp()
ELSEIF DiapeCharges:MASTER:0 <= 0 || DiapePooCharges:MASTER:0 <= 0
	PRINTFORMDW 기분이 나아진 것 같았다.
	PRINTFORMDW 하지만, %CALLNAME:DAILY_Lucid_Chara%는 \@ DAILY_Lucid_Stats:1 ? 상당한 %URINE(MASTER,1)% 얼룩 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 불쾌한 냄새 #  \@ 당신의 바지에 대해 알아차린다.
	PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%가 그것에 대해 지적했다.
	CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
	PRINTFORMW 방금... 그랬어?
	RESETCOLOR
	CALL COLORMESSAGE(@"패배자!",C_RED,2,1)
	CALL COLORMESSAGE(@"윈 %TOSTR(DAILY_Lucid_Stats:10)% / 5 라운드 동안.",C_YELLOW,2,1)
ELSE
	PRINTFORMDW 그게 더 나았다.
	BASE:DAILY_Lucid_Chara:尿意 += RAND:75
	BASE:DAILY_Lucid_Chara:Poo += RAND:75
ENDIF
; ;----------------------------
; ;Giving up
; ;----------------------------
; @LUCID_DREAM_GIVEUP_14
