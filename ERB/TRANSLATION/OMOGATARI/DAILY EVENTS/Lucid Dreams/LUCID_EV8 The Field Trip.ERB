; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV8 현장 학습.ERB
;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
;Normal
;Nightmare
;Sex
;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------

@LUCID_DREAM_INFO_8
#FUNCTION
DAILY_Lucid_Name '= "현장 학습"
DAILY_Lucid_Desc '= "꿈에 대한 상세 설명"
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/2/10/20/62"
DAILY_Lucid_CanGiveUp = 0
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_8
#DIM RandomChara
;field trip
FOR RandomChara, 0, 7
CALLF TP(DAILY_Lucid_Chara:RandomChara)
TARGET:(RandomChara+1) = DAILY_Lucid_Chara:RandomChara
CFLAG:(DAILY_Lucid_Chara:RandomChara):睡眠 = 0
CFLAG:(DAILY_Lucid_Chara:RandomChara):同室 = 1
TCVAR:(DAILY_Lucid_Chara:RandomChara):906 = 1
CALLF PEEME(DAILY_Lucid_Chara:RandomChara, 0)
CALLF POOME(DAILY_Lucid_Chara:RandomChara, 0)
SIF nOmutsu && !RAND:4
	CALLF PANTY_REWORK_CHANGE(DAILY_Lucid_Chara:RandomChara,103)
NEXT
TFLAG:104 = DAILY_Lucid_Chara
BASE:MASTER:0 = MAXBASE:MASTER:0
DAILY_Lucid_Stats:7 = RAND:90
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
PRINTFORMDW 당신은 %CALLNAME:DAILY_Lucid_Chara%과 데이트를 하고 있다.
PRINTFORMDW 당신은 이 순간을 아주 오랫동안 고대해 왔다.
PRINTFORMDW 당신은 배낭을 한 손에, 맛있는 탄산음료 병을 다른 손에 들고 버스에 앉아 편안하게 자세를 잡는다.
PRINTFORMDW 잠시 후, 병은 비었지만 무언가가 빠르게 차오르고 있다...
PRINTFORMDW 당신은 정말로 \@ DAILY_Lucid_Stats:1 ? 소변을 본다 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "%가 변한다 #  \@\@ DAILY_Lucid_Stats:2 ? 대변을 본다 #  \@! 
CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%가 당신의 어깨를 두드리며 당신의 절박함을 알아차린다.
PRINTFORMW 「야 %CALLNAME:MASTER%, 괜찮아?」
RESETCOLOR
PRINTFORML 
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_8
;When a command ends

@LUCID_DREAM_TURN_8
IF DAILY_Lucid_Stats:7 <= 0
	PRINTFORMDW 그리고 네가 실수를 저질렀을지도 모른다는 것을 깨닫는 바로 그 순간, 버스가 주차장에 들어선다.
	PRINTFORMDW 너는 화장실로 곧장 달려간다.
	CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
	IF RESULT <= 0
		DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
		CALL LucidDreamTimeUp()
	ENDIF
	PRINTFORMDW 대부분의 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% #  \@ 화장실로 들어간다.
	PRINTFORMDW 그리고 그 작은 사고가 옷에 나타나지는 않은 것 같다.
	PRINTFORMDW 당신은 마침내 긴장을 풀면서 따뜻한 안도감의 빛에 둘러싸인다.	
	DAILY_Lucid_Stats:9 = 1
	CALL LucidDreamTimeUp()
ELSEIF BASE:MASTER:0 <= 500 || (PeeBarstage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2)
	PRINTFORMDW 몇 분 후, 당신은 첫 번째 분출이 %PeeProtectType(MASTER,2)%로 새어 들어가는 것을 느낄 수 있다.
	PRINTFORMDW 무언가 말하고 싶었더라도, 지금은 너무 늦었다.
	IF IsPadded(MASTER)
		PRINTFORMDW 당신은 무릎을 내려다보고 다리 사이에 커다랗고 복슬복슬한 기저귀의 볼록함을 알아차린다.
		PRINTFORMDW 당신은 다리를 맞대는 것을 멈추고, 그것으로 통제력을 잃기에 충분했다.
		CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
		PRINTFORMDW 부끄럽지만, 네 말이 맞았어. 정말 훨씬 기분이 좋아졌어!
	ELSE
		PRINTFORMDW 당신은 조용히 바지 부분을 버스 좌석의 푹신한 천에 대고, 커다란 쿠션이 모든 것을 흡수해주기를 바라며 가만히 있었다.
		CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
		PRINTFORMDW 당신의 아래는 점차 따뜻해지며 \@ DAILY_Lucid_Stats:1 ? 젖는다 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? 지저분하다 #  \@...
		SIF nOmutsu
			PRINTFORMDW 네가 기저귀를 차고 있었더라면 좋았을 텐데!	
	ENDIF
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_8(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		PRINTFORMDW 당신은 아무도 당신이 얼마나 심하게 가고 싶은지 눈치채지 못하도록 조용히 지내고 버티는 것이 최선이라고 결정한다.
		BASE:MASTER:0 -= 50
		BASE:DAILY_Lucid_Chara:尿意 += RAND:75
		BASE:DAILY_Lucid_Chara:Poo += RAND:75
		DAILY_Lucid_Stats:7 -= 5
	CASE 1
		PRINTFORMDL 당신은 자신이 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ 할 필요가 없다고 결정한다.
		PRINTFORMDL 그냥 참으면 돼!
		PRINTFORMDL 그리고 만약 당신이 계속 자리에 안절부절못하고 있어도 어때서!
		PRINTFORMDW 적어도 %CALLNAME:(DAILY_Lucid_Chara:1)%에게 말할 필요는 없잖아!
		BASE:MASTER:0 -= 200
		PeeHoldExp:MASTER:0 += 2
		DAILY_Lucid_Stats:7 -= 5
	CASE 2
		IF TARGET != DAILY_Lucid_Chara:1
			PRINTFORMDW 당신은 정말로 %CALLNAME:(DAILY_Lucid_Chara:1)%와 이야기하고 싶지 않아서, 대신 %조사처리(CALLNAME:TARGET,"에게")% 돌아가 살짝 다리를 흔들면서 조언을 구한다.
			IF IsPadded(TARGET)
				CALL SET_KOJO_COLOR(TARGET) ;custom code
				PRINTFORMW 「기저귀에서 그냥 놓으면 안 돼?」
				PRINTFORMW 「우리가 떠날 때 정말 참았는데, 그리고 소변이 그냥 나와서 지금 훨씬 기분이 좋아졌어.」
				RESETCOLOR
				PRINTFORMDW 당신은 무릎을 내려다보더니 다리 사이에 커다랗고 복슬복슬한 기저귀의 볼륨이 있는 것을 알아챈다.
				PRINTFORMDW 물론 기저귀를 차고 있을 테니, 어떻게 그걸 잊겠어?
				CALLF PANTY_REWORK_CHANGE(MASTER,103)
				RETURN
			ENDIF
			SELECTCASE RAND:3
				CASE 0
					CALL SET_KOJO_COLOR(TARGET) ;custom code
					PRINTFORMW 「여기에 %CALLNAME:MASTER%, 가져가라.」
					PRINTFORMW 「이게 너를 구할지도 모르지.」
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 네가 마셨던 탄산음료 병을 던진다. 
					RESETCOLOR
					IF !DAILY_Lucid_Stats:2
						PRINTFORMDW 당신은 자신의 %SHOW_BOTTOM(MASTER)%을 내리고, 병을 자신의 %FSYN("crotch")%에 놓고 소변을 본다...
						CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
						PRINTFORMDW 민망하지만, %조사처리(CALLNAME:TARGET,"가")% 맞았어. 정말 훨씬 기분이 나아졌어!	
						DAILY_Lucid_Stats:9 = 2
						CALL LucidDreamTimeUp()
					ELSE
						PRINTFORMDW 당신은 그 제안을 정중히 거절한다. 그것이 이 난관에서 당신을 구해줄 수 없기 때문이다.
						BASE:MASTER:尿意 += RAND:75
						BASE:MASTER:Poo += RAND:75
						DAILY_Lucid_Stats:7 -= 5
					ENDIF
				CASE 1
					CALL SET_KOJO_COLOR(TARGET) ;custom code
					PRINTFORMW 「너는 더 이상 아기가 아니야. 그걸 감당할 수 있어」
					PRINTFORMW 「나도 너와 비슷한 상황을 겪었고, 성공적으로 그것을 감당했어」
					RESETCOLOR
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"의")% 영감적인 말은 당신이 절망에 대해 약간 잊도록 도와준다.
					BASE:MASTER:尿意 -= RAND:75
					BASE:MASTER:Poo -= RAND:75
					DAILY_Lucid_Stats:7 -= 5
				CASE 2
					PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 응답하지 않는다...
					BASE:MASTER:尿意 += RAND:75
					BASE:MASTER:Poo += RAND:75
					DAILY_Lucid_Stats:7 -= 5
			ENDSELECT
		ELSE
			PRINTFORMW 「%CALLNAME:(DAILY_Lucid_Chara:1)%!!」
			PRINTFORMDW 얼굴을 비정상적으로 붉히고 손을 다리 사이에 넣은 채, 당신은 %CALLNAME:(DAILY_Lucid_Chara:1)%를 부르며 화장실에 가달라고 애원한다.
			PRINTFORMDW %CALLNAME:(DAILY_Lucid_Chara:1)%는 얼굴을 찡그린다.
			CALL SET_KOJO_COLOR(DAILY_Lucid_Chara:1) ;custom code
			PRINTFORMW 「%CALLNAME:MASTER%, 정말 참을 수 없나요?」
			PRINTFORMW 「{DAILY_Lucid_Stats:7}분 정도 후에 도착할게요. 할 수 있어요.」
			RESETCOLOR
			SIF DAILY_Lucid_Stats:1
				CALL PEESOUNDS("s")
			PRINTFORMDW 당신은 고개를 저으며 신음하고, 손아귀에서 몇 방울이 빠져나가는 것을 느낀다.
			PRINTFORMDW 운이 좋다면, \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ 바지를 적실 시간이 몇 분 남았다.
			IF !RAND:4
				PRINTFORMDW %CALLNAME:(DAILY_Lucid_Chara:1)%은 불만스러운 소리를 내지만, 잠시 후 버스가 휴게소에 멈추고 당신은 모두가 자신을 쳐다보는 가운데 문으로 비틀거리며 향한다.
				PRINTFORMDW 아스팔트 위로 발을 내딛자 주변의 세상이 사라진다. 	
				DAILY_Lucid_Stats:9 = 62
				CALL LucidDreamTimeUp()
			ELSE
				CALL SET_KOJO_COLOR(DAILY_Lucid_Chara:1) ;custom code
				PRINTFORMW 「%CALLNAME:MASTER%, 정말 가야만 하는 상황이라는 건 알지만 미안해.」
				PRINTFORMW 「우리는 멈추지 않아. 이미 많이 늦었고 어떤 지연도 감당할 수 없어.」
			ENDIF
		ENDIF
ENDSELECT
