@LUCID_DREAM_INPUT_NAMES_8(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		DAILY_Lucid_ComName '= @"은근하게 행동해 보려 한다 (STA 50)"
	CASE 1
		DAILY_Lucid_ComName '= @"그것을 붙들기 위해 무슨 수를 써서라도 해라! (체력 200)"
	CASE 2
		IF TARGET != DAILY_Lucid_Chara:1
			DAILY_Lucid_ComName '= @"%조사처리(CALLNAME:TARGET,"에게")% 조언을 구한다."
		ELSE
			DAILY_Lucid_ComName '= @"운전자에게 말해라, %CALLNAME:(DAILY_Lucid_Chara:1)%이!"
		ENDIF
ENDSELECT
RETURNF DAILY_Lucid_ComName
