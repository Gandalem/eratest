;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
	;Normal
	;Nightmare
	;Sex
	;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
	;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------
@LUCID_DREAM_INFO_8
#FUNCTION
DAILY_Lucid_Name '= "The Field Trip"
DAILY_Lucid_Desc '= "A longer description of the dream"
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/2/10/20/62"
DAILY_Lucid_CanGiveUp = 0

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_8
#DIM RandomChara
;field trip
FOR RandomChara, 0, 7
	CALLF TP(DAILY_Lucid_Chara:RandomChara)
	TARGET:(RandomChara+1) = DAILY_Lucid_Chara:RandomChara
	CFLAG:(DAILY_Lucid_Chara:RandomChara):睡眠 = 0
	CFLAG:(DAILY_Lucid_Chara:RandomChara):同室 = 1
	TCVAR:(DAILY_Lucid_Chara:RandomChara):906 = 1		
	CALLF PEEME(DAILY_Lucid_Chara:RandomChara, 0)
	CALLF POOME(DAILY_Lucid_Chara:RandomChara, 0)		
	SIF nOmutsu && !RAND:4
	CALLF PANTY_REWORK_CHANGE(DAILY_Lucid_Chara:RandomChara,103)
NEXT
TFLAG:104 = DAILY_Lucid_Chara

BASE:MASTER:0 = MAXBASE:MASTER:0
DAILY_Lucid_Stats:7 = RAND:90

IF DAILY_Lucid_Stats:1
CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
CALLF POOME(MASTER, 4)
ENDIF	

PRINTFORMDW You're having a date with %CALLNAME:DAILY_Lucid_Chara%.
PRINTFORMDW You have been looking forward to this for a very long time.
PRINTFORMDW You've got your backpack in one hand and a delicious bottle of soda in the other as you settle into the bus and get comfortable.
PRINTFORMDW A while later, the bottle is empty, but something else is rapidly filling...
PRINTFORMDW You really have to \@ DAILY_Lucid_Stats:1 ?pee#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? poop#\@! 
CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code	
PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara% taps on your shoulder, noticing your desperation.
PRINTFORMW 「Hey %CALLNAME:MASTER%, you okay?」
RESETCOLOR	
PRINTFORML 

;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_8

;When a command ends
@LUCID_DREAM_TURN_8
	IF DAILY_Lucid_Stats:7 <= 0
		PRINTFORMDW And then, just as you realize that you might have made a mistake, the bus pulls into the parking lot.
		PRINTFORMDW You make a beeline for the toilets.
		CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
		IF RESULT <= 0
		DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
		CALL LucidDreamTimeUp()
		ENDIF		
		PRINTFORMDW Most of the \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% #\@ goes into the toilet.
		PRINTFORMDW And it doesn't look like the little mishap shows on your clothes.
		PRINTFORMDW You're surrounded by a comforting glow of warmth as you finally relax.	
		DAILY_Lucid_Stats:9 = 1
		CALL LucidDreamTimeUp()
	ELSEIF BASE:MASTER:0 <= 500 || (PeeBarstage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2)
		PRINTFORMDW After a few minutes, you can feel the first spurt leak into your %PeeProtectType(MASTER,2)%.
		PRINTFORMDW Even if you wanted to say something, it'd be much too late now.
		IF IsPadded(MASTER)
			PRINTFORMDW You look at your lap and notice the big, fluffy bulge of a diaper between your legs.
			PRINTFORMDW You stop twisting your legs together, and that's all it takes for you to lose control.
			CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
			PRINTFORMDW It's embarrassing, but you were right, you really do feel much better!
		ELSE
			PRINTFORMDW You keep quiet and press your crotch against the plush fabric of the bus seat, hoping that the big cushion will soak everything up...
			CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
			PRINTFORMDW Your bottom gradually grows grows warm and \@ DAILY_Lucid_Stats:1 ? wet#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? messy#\@...
			SIF nOmutsu
			PRINTFORMDW If only you had worn a diaper!	
		ENDIF

		DAILY_Lucid_Stats:9 = LucidDreamLoser()
		CALL LucidDreamTimeUp()
	ENDIF

;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_8(nInput)
#DIM nInput
SELECTCASE nInput
CASE 0
	PRINTFORMDW You decide that the best thing to do is to just keep quiet and hope that you can hold it without anybody noticing how badly you have to go.
	BASE:MASTER:0 -= 50
	BASE:DAILY_Lucid_Chara:尿意 += RAND:75
	BASE:DAILY_Lucid_Chara:Poo += RAND:75
	DAILY_Lucid_Stats:7 -= 5
CASE 1
	PRINTFORMDL You decide that you don't want to tell anyone that you have to \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #\@.
	PRINTFORMDL You'll just hold it!
	PRINTFORMDL And if you're constantly fidgeting in your seat, so what!
	PRINTFORMDW At least you don't have to tell %CALLNAME:(DAILY_Lucid_Chara:1)%!
	BASE:MASTER:0 -= 200
	PeeHoldExp:MASTER:0 += 2	
	DAILY_Lucid_Stats:7 -= 5
CASE 2
	IF TARGET != DAILY_Lucid_Chara:1
	PRINTFORMDW You really don't want to talk to %CALLNAME:(DAILY_Lucid_Chara:1)%, so instead you turn around to %CALLNAME:TARGET%, and ask for advice while subtly jiggling your legs.
	IF IsPadded(TARGET)
		CALL SET_KOJO_COLOR(TARGET) ;custom code		
		PRINTFORMW 「Why don't you just let go in your diaper?」
		PRINTFORMW 「I really had to go when we left, and then the pee just came out and I feel so much better now.」
		RESETCOLOR
		PRINTFORMDW You look at your lap and notice the big, fluffy bulge of a diaper between your legs.
		PRINTFORMDW Of course you'd be wearing a diaper, how could you forget?
		CALLF PANTY_REWORK_CHANGE(MASTER,103)
		RETURN
	ENDIF
		SELECTCASE RAND:3
		CASE 0
		CALL SET_KOJO_COLOR(TARGET) ;custom code		
		PRINTFORMW 「Here %CALLNAME:MASTER%, fetch.」
		PRINTFORMW 「Think this might just save you.」
		PRINTFORMDW %CALLNAME:TARGET% throws you the soda bottle you drunk. 
		RESETCOLOR
		IF !DAILY_Lucid_Stats:2
		PRINTFORMDW You pull down your %SHOW_BOTTOM(MASTER)%, place the bottle on your %FSYN("crotch")%, and pee...
		CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")		
		PRINTFORMDW It's embarrassing, but %CALLNAME:TARGET% was right, you really do feel much better!	
		DAILY_Lucid_Stats:9 = 2
		CALL LucidDreamTimeUp()
		ELSE
		PRINTFORMDW You politely decline the offer, as it won't bail you out out of this predicament.
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		DAILY_Lucid_Stats:7 -= 5
		ENDIF
		CASE 1
		CALL SET_KOJO_COLOR(TARGET) ;custom code
		PRINTFORMW 「You aren't a baby anymore. You can hold it」
		PRINTFORMW 「I had a situation like yours and I could successfully hold it」
		RESETCOLOR
		PRINTFORMDW The inspirational words from %CALLNAME:TARGET% help you slightly forget about your desperation.
		BASE:MASTER:尿意 -= RAND:75
		BASE:MASTER:Poo -= RAND:75
		DAILY_Lucid_Stats:7 -= 5
		CASE 2
		PRINTFORMDW %CALLNAME:TARGET% doesn't respond...
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		DAILY_Lucid_Stats:7 -= 5
		ENDSELECT
	ELSE
		PRINTFORMW 「%CALLNAME:(DAILY_Lucid_Chara:1)%!!」
		PRINTFORMDW With a beet-red face and a hand between your legs, You call out for %CALLNAME:(DAILY_Lucid_Chara:1)% and plead for a potty break.
		PRINTFORMDW %CALLNAME:(DAILY_Lucid_Chara:1)% grimaces.
		CALL SET_KOJO_COLOR(DAILY_Lucid_Chara:1) ;custom code	
		PRINTFORMW 「%CALLNAME:MASTER%, you really can't hold it?」
		PRINTFORMW 「We'll be there in around {DAILY_Lucid_Stats:7} minutes. You can do it.」
		RESETCOLOR
		SIF DAILY_Lucid_Stats:1
			CALL PEESOUNDS("s")
		PRINTFORMDW You shake your head no and whimper as you feel a few drops escape your iron grip.
		PRINTFORMDW You have minutes until you'll \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #\@ your pants, if you're lucky.
		IF !RAND:4
		PRINTFORMDW %CALLNAME:(DAILY_Lucid_Chara:1)% makes a disgruntled noise, but a little while later, the bus pulls onto a rest stop and you stumble to the doors while everyone stares at you.
		PRINTFORMDW As you step out onto the asphalt, the world around you vanishes. 	
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
		ELSE
		CALL SET_KOJO_COLOR(DAILY_Lucid_Chara:1) ;custom code	
		PRINTFORMW 「%CALLNAME:MASTER%, I know you have to go really bad, but I'm sorry.」
		PRINTFORMW 「We aren't stopping. We're already running very late and we can't afford any diversions.」
		ENDIF
	ENDIF
ENDSELECT

;----------------------------
;Input names
;----------------------------
@LUCID_DREAM_INPUT_NAMES_8(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
CASE 0
	DAILY_Lucid_ComName '= @"Try to be subtle (50 STA)"
CASE 1
	DAILY_Lucid_ComName '= @"Do whatever it takes to hold it! (200 STA)"
CASE 2
	IF TARGET != DAILY_Lucid_Chara:1
	DAILY_Lucid_ComName '= @"Ask %CALLNAME:TARGET% for advice"
	ELSE
	DAILY_Lucid_ComName '= @"Tell the driver, %CALLNAME:(DAILY_Lucid_Chara:1)%!"
	ENDIF
ENDSELECT
RETURNF DAILY_Lucid_ComName

