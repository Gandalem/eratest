;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_22(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		DAILY_Lucid_ComName '= @"이동한다"
	CASE 1
		DAILY_Lucid_ComName '= @"기저귀를 잡아라"
ENDSELECT
RETURNF DAILY_Lucid_ComName
