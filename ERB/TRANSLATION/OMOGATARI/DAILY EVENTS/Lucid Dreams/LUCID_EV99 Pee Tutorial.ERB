; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV99 Pee Tutorial.ERB
;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_99
#FUNCTION
DAILY_Lucid_Name '= "튜토리얼(소변)"
DAILY_Lucid_Desc '= @"%NAME:109%이(가) 몽유병 꿈이 어떻게 작동하는지 알려주고, 60분 타이머와 함께 욕실에 가둔다."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 1
DAILY_Lucid_InterruptCom '= "400/405/604/811/999"
DAILY_Lucid_EndingAvailable '= "1/2/10/11/12/20/21/22/62"
DAILY_Lucid_CanGiveUp = 3
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_99
PRINTL 
CALL 画像表示("立ち絵_服_通常_109", "right", 0, 130, 110)
CALL 画像描画終了
PRINTL 
PRINTL 
PRINTL 
SETBGCOLOR 0, 0, 102
PRINTFORML ............
PRINTFORML .........
PRINTFORML ......
PRINTFORML 정신을 차리자, 당신은 이상한 방에 있는 자신을 발견한다.
PRINTFORML 당신 앞에는 깊고 푸른 머리와 붉은 수면모를 쓴 소녀가 앉아 있다.
PRINTW 
CALL SET_KOJO_COLOR(109)
CALL DQPRINT("「음, 여러 번의 자각몽에 오신 것을 환영합니다.」", 1)
CALL DQPRINT("「소변 꿈의 궁극적인 목표는 가능한 모든 방식으로 자신을 해방하는 것이다.」", 1)
CALL DQPRINT("「비록 처음에는 직관에 반하는 것처럼 보일지라도:」", 1)
PRINTL
CALL DQPRINT("「대다수의 전설의 주민들이 침대에서 젖기 때문에, 그곳에 소변을 보면 안 된다.」", 1)
CALL DQPRINT("「자주 재앙적으로도.」", 1)
CALL DQPRINT("「명료한 꿈 속으로 더 깊이 들어가고 싶은 유혹은 많은 이들이 보듯 거부하기 매우 어렵다.」", 1)
PRINTL
CALL DQPRINT("「이 황홀한 꿈들을 즐기고 싶다면 강한 보호 장비를 가져오는 것을 추천한다.」", 1)
CALL DQPRINT("「좀 두껍고 테이프로 붙인 흡수성 속옷과 만약 그것마저 실패할 경우를 대비한 패드 정도면 충분할 것이다.」", 1)
PRINTL
CALL DQPRINT(@"「그리고 네가 스스로를 심하게 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"pee","poop")% 할 것처럼 보이는 너를 보자.」", 1)
IF (DiapeCharges:MASTER:0 > MaxBase:MASTER:4 || !DAILY_Lucid_Stats:1) && (DiapePooCharges:MASTER:0 > MaxBase:MASTER:Poo || !DAILY_Lucid_Stats:2)
	CALL DQPRINT("「네 속옷은 네 사고를 감당할 수 있을 것 같으니, 좀 더 탐험을 할 수도 있겠어.」", 1)
ELSE
	CALL DQPRINT("「당신 속옷은 얇고 허술해 보인다. 밤에 사고를 감당할 수 없을 거야.」", 1)
	CALL DQPRINT("「네 침대에서 범벅이 되게 만들면 정말 창피할 텐데, 안 그래?」", 1)
ENDIF
PRINTL
CALL DQPRINT("「이 튜토리얼을 위해 당신을 화장실에 두었지만, 변기를 사용하기 위한 문은 60분 타이머로 잠겨 있다.」", 1)
CALL DQPRINT("「이 꿈 동안 네가 할 수 있는 몇 가지 일들이 있다.」", 1)
CALL DQPRINT("「어떤 꿈들은 이 꿈처럼 자유 명령이며, 여기서 현실 세계의 대부분의 명령을 사용할 수 있게 해준다.」", 1)
CALL DQPRINT("「다른 꿈들은 그것을 들거나 속옷에 실례하는 것 같은 특정 명령을 수행하는 것으로 제한된다.」", 1)
PRINTL
CALL DQPRINT("「이런 명령들은 종종 다음과 같다: 『꿈을 떠나는 것』, 『꿈의 최종 목표에 도달하려고 애쓰는 것』(보통 화장실이다), 『포기하는 것』, 그리고 『특이한 장소에서 용변 보는 것』」", 1)
CALL DQPRINT("「또한 방광의 압력을 약간 해소시켜주는 『분출(Spurt)』을 할 수도 있지만 큰 사고가 날 가능성이 있다.」", 1)
CALL DQPRINT("「너를 네 방식대로 내버려 둘게. 단 꿈에 중요한 명령을 내릴 때는 내가 도와줄 거야.」", 1)
RESETCOLOR
CALLF TP(109)
SIF DAILY_Lucid_Stats:1
	CALLF PeeMe(MASTER,4)
SIF DAILY_Lucid_Stats:2
	CALLF PooMe(MASTER,4)
DAILY_Lucid_Stats:7 = TIME+60
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_99
SELECTCASE DAILY_Lucid_Stats:9
	CASE 1
		CALL SET_KOJO_COLOR(109)
		CALL DQPRINT("「너는 소변 꿈에서 화장실 같은 적절한 장소에 용변을 보는 데 성공했다.」", 1)
		CALL DQPRINT("「하지만 모든 꿈의 경우와 마찬가지로, 당신의 진짜 자아는 여전히 침대에 누워 있다.」", 1)
		;CALL DQPRINT(@"「You may be relieving yourself on a toilet in your dream, you're currently %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wetting","messing")% your undies for real.」")
		CALL DQPRINT("「깨어났을 때 놀랄 만한 일이 있을 거야.」", 1)
		CALL DQPRINT("「네 꿈에 너무 몰입하게 만든 것 같아... 헤헤...」", 1)
	CASE 2
		CALL SET_KOJO_COLOR(109)
		CALL DQPRINT("「어떤 꿈들은 이것처럼 싱크대 같은 비전통적인 장소에서 해소할 수 있게 해준다」", 1)
		CALL DQPRINT("「꿈을 건조하게 끝내는 방법이긴 하지만 조금 민망할 수도 있다. 하지만 대부분의 경우 사고를 치는 것보다는 선호된다.」", 1)
		CALL DQPRINT("「다른 선택지들은 병의 절박함에 대해 한쪽 끝에서만 절실해야 할 수도 있다. 예를 들어, 배변의 절박함에는 병이 작동하지 않을 것이다.」", 1)
		CALL DQPRINT("「꿈속에서 그저 해소하는 것만...」", 1)
		CALL DQPRINT("「깨어났을 때 깜짝 놀랄 거야.」", 1)
		CALL DQPRINT("「꿈에 너무 몰두하게 만든 것 같네... 헤헤...」", 1)
	CASE 99
		CALL SET_KOJO_COLOR(109)
		CALL DQPRINT("「어라? 돌아가는 거야?」")
		SELECTCASE RAND:2
			CASE 0
				CALL DQPRINT("「잘 자라, 좋은 밤 되길.」", 1)
			CASE 1
				CALL DQPRINT("「그럼 잘 가.」", 1)
		ENDSELECT
		RESETCOLOR
	CASEELSE
		CALL SET_KOJO_COLOR(109)
		CALL DQPRINT(@"「이런. 꿈속에서 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wet","messed")%한 것 같아.」", 1)
		CALL DQPRINT("「걱정 마, 그냥 꿈이야. 하지만 네가 꿈속에서 입고 있는 속옷은 현실에서 입는 속옷과 달라.」", 1)
		CALL DQPRINT("「네 가짜 속옷이 네 가짜 사고를 막아줬을지 모르지만, 이제 진짜 속옷이 네 진짜 사고를 막았는지 대답해야 할 것이다.」", 1)
ENDSELECT
RESETCOLOR
;When a command ends

@LUCID_DREAM_TURN_99
IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
	CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_99(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		IF DAILY_Lucid_Stats:7-TIME > 0
			PRINTFORML 가게를 열려고 하지만 잠겨 있는 것 같다.
			PRINTFORMW 타이머에는 {DAILY_Lucid_Stats:7-TIME} 분이 남았다고 표시되어 있다.
			RETURN
		ENDIF
		CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
		IF RESULT <= 0
			DAILY_Lucid_Stats:9 = LucidDreamLoser()
			CALL LucidDreamTimeUp()
		ENDIF
		DAILY_Lucid_Stats:9 = 1
		CALL LucidDreamTimeUp()
		RETURN
	CASE 1
		PRINTFORMW 터질 것 같은 기분이 들면, 자존심을 삼키고 쓰레기통으로 해소한다.
		CALL COM_TakeClothesBeforePee(MASTER)
		IF RESULT <= 0
			CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
			DAILY_Lucid_Stats:9 = LucidDreamLoser()
			CALL LucidDreamTimeUp()
		ENDIF
		PRINTFORMW 당신은 쓰레기통을 타고 올라가면서 거의 통제력을 잃지만, 용변을 보는 동안 배설물이 양동이에 걸린다.
		PRINTFORMW 벽에 기대어 편안하게 쉬자 미묘한 온기가 당신을 감싸고 세상이 희미해지기 시작했다.
		DAILY_Lucid_Stats:9 = 2
		CALL LucidDreamTimeUp()
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_99(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		DAILY_Lucid_ComName '= @"변기를 사용해라"
	CASE 1
		DAILY_Lucid_ComName '= @"휴지통을 사용한다."
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
;Status page for Carry Status
;----------------------------

@LUCID_DREAM_INPUT_STATUS_99
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"화장실이 열릴 때까지 남은 시간: {MAX(DAILY_Lucid_Stats:7-TIME,0)}분"
RETURNF DAILY_Lucid_InfoTab
;----------------------------
;Spurting
;----------------------------

@LUCID_DREAM_SPURT_99
CALL SET_KOJO_COLOR(109)
CALL DQPRINT("「이것은 분출 및 방귀 명령이다.」", 1)
CALL DQPRINT("「이 명령을 사용하여 방광과 장의 압력을 조금 해소할 수 있다.」", 1)
CALL DQPRINT("「폭주 후 스스로 통제력을 되찾는 능력은 당신의 절제력에 달려 있다.」", 1)
CALL DQPRINT("「더 낮은 배변 훈련은 분출만 시도할 때 완전히 젖고 지저분해질 수 있다는 것을 의미한다.」", 1)
CALL DQPRINT("「할래?」", 1)
RESETCOLOR
CALL ASK_YN()
CALL LUCID_DREAM_SPURT_GENERAL
;----------------------------
;Giving up
;----------------------------

@LUCID_DREAM_GIVEUP_99
CALL SET_KOJO_COLOR(109)
CALL DQPRINT("「이것은 포기 명령어다.」", 1)
CALL DQPRINT(@"「이렇게 하는 것은 당신 스스로 의도적으로 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wetting","messing")% 하면서 운명에 순응하게 만드는 것이다.」", 1)
CALL DQPRINT("「이것에서 돌아갈 수 없는 경우가 종종 있고, 현실에서는 네가 오줌을 지릴 것이다.」", 1)
CALL DQPRINT("「그것을 하고 싶어?」", 1)
RESETCOLOR
CALL ASK_YN()
SIF RESULT
	RETURN
CALL INTENTIONAL_ACCIDENT(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2, 0, 1)
DAILY_Lucid_Stats:9 = LucidDreamLoser(1)
CALL LucidDreamTimeUp()
RETURN
;----------------------------
;Giving up but relieving self in diaper
;----------------------------

@LUCID_DREAM_GIVEUP_DIAPER_99
CALL SET_KOJO_COLOR(109)
CALL DQPRINT("「이것은 포기 명령의 기저귀 버전이다.」", 1)
CALL DQPRINT(@"「이렇게 하는 것은 당신 스스로 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"젖게 하기","더럽히기")% 되도록 운명을 받아들이는 것이다.」", 1)
CALL DQPRINT("「하지만 당신의 꿈속 자아는 배변 바지를 입고 있을 것이다.」", 1)
CALL DQPRINT("「이 상황에서 돌아갈 수 없는 경우가 많고, 현실에서는 네가 소변을 지릴 것이다.」", 1)
CALL DQPRINT("「그거 하고 싶어?」", 1)
RESETCOLOR
CALL ASK_YN()
SIF RESULT
	RETURN
PRINTFORMDW %CALLNAME:109%은(는) 허리에 기저귀를 상상하게 만든 뒤, 풍선 같은 기저귀가 팬티를 대체하도록 한다.
CALLF PANTY_REWORK_CHANGE(MASTER,103)
CALL INTENTIONAL_ACCIDENT(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2, 0, 1)
DAILY_Lucid_Stats:9 = LucidDreamLoser(1)
CALL LucidDreamTimeUp()
RETURN
