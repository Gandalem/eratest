	CALLF PeeMe(MASTER,4)
SIF DAILY_Lucid_Stats:2
	CALLF PooMe(MASTER,4)
DAILY_Lucid_Stats:7 = TIME+60

;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_99
SELECTCASE DAILY_Lucid_Stats:9
CASE 1
CALL SET_KOJO_COLOR(109)
CALL DQPRINT("「You've managed to relieve yourself in a proper location such as a toilet in your pee dream.」", 1)
CALL DQPRINT("「However, as case with all dreams, your real self is still laying in your bed.」", 1)
;CALL DQPRINT(@"「You may be relieving yourself on a toilet in your dream, you're currently %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wetting","messing")% your undies for real.」")
CALL DQPRINT("「It'll be a surprise when you wake up.」", 1)
CALL DQPRINT("「I guess I got you too invested in your dream... Hehe...」", 1)
CASE 2
	CALL SET_KOJO_COLOR(109)
	CALL DQPRINT("「Some dreams, like this one, allow you to relieve yourself in non-traditional locations like the sink」", 1)
	CALL DQPRINT("「While it's a way to end the dream dry, it can also be a bit embarrassing, but is preferable over having an accident for most.」", 1)
	CALL DQPRINT("「Other options may also require you to only be desperate in one end, like a bottle won't work for bowel desperation.」", 1)
	CALL DQPRINT("「Just that relieving oneself in a dream....」", 1)
	CALL DQPRINT("「It'll be a surprise when you wake up.」", 1)
	CALL DQPRINT("「I guess I got you too invested in your dream... Hehe...」", 1)
CASE 99
CALL SET_KOJO_COLOR(109)
CALL DQPRINT("「Oh? You're going back?」")
SELECTCASE RAND:2
	CASE 0
		CALL DQPRINT("「...Sleep well, have a good night.」", 1)
	CASE 1
		CALL DQPRINT("「Well then... Take care.」", 1)
ENDSELECT
RESETCOLOR
CASEELSE
CALL SET_KOJO_COLOR(109)
CALL DQPRINT(@"「Oops. It looks like you %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"wet","messed")% yourself while in the dream.」", 1)
CALL DQPRINT("「Don't worry, it's just a dream. However, the underwear that you are wearing in the dream is different to the underwear that you're wearing in the real world.」", 1)
CALL DQPRINT("「Your fake underwear may have caught your fake accident, but now you'll have to answer if your real underwear has caught your real accident.」", 1)
ENDSELECT
RESETCOLOR

;When a command ends
@LUCID_DREAM_TURN_99
IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
	CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
ENDIF

;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_99(nInput)
#DIM nInput
SELECTCASE nInput
CASE 0
	IF DAILY_Lucid_Stats:7-TIME > 0
		PRINTFORML You try to open the stall, but it seems to be locked.
		PRINTFORMW The timer says that you have {DAILY_Lucid_Stats:7-TIME} minutes left.
		RETURN
	ENDIF

	CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
	IF RESULT <= 0
		DAILY_Lucid_Stats:9 = LucidDreamLoser()
		CALL LucidDreamTimeUp()
	ENDIF
	DAILY_Lucid_Stats:9 = 1
	CALL LucidDreamTimeUp()
	RETURN
CASE 1
		PRINTFORMW Feeling like you're about to burst, you swallow your pride and relieve yourself by using a trash can.
		CALL COM_TakeClothesBeforePee(MASTER)
		IF RESULT <= 0
			CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
			DAILY_Lucid_Stats:9 = LucidDreamLoser()
			CALL LucidDreamTimeUp()
		ENDIF
		PRINTFORMW You almost lose control getting yourself up the trashcan, but as you relieve yourself, your excretions are caught in the pail.
		PRINTFORMW A subtle warmth embraces you as you relax on the wall, the world starting to fade away.
		DAILY_Lucid_Stats:9 = 2
		CALL LucidDreamTimeUp()
ENDSELECT

