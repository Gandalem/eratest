@LUCID_EV27_DIAPERCHANGE(ARG)
IF nOmutsu
	CALL DiaperChange(ARG,134)
	IF (MAXBASE:ARG:4+1000) > DiapeCharges:ARG:1 || (MAXBASE:ARG:Poo+1000) > DiapePooCharges:ARG:1
		CALL DiaperChange(ARG,103)
		IF (MAXBASE:ARG:4+1000) > DiapeCharges:ARG:1 || (MAXBASE:ARG:Poo+1000) > DiapePooCharges:ARG:1
			CALL DiaperChange(ARG,104)
			IF (MAXBASE:ARG:4+1000) > DiapeCharges:ARG:1 || (MAXBASE:ARG:Poo+1000) > DiapePooCharges:ARG:1
				CALL DiaperChange(ARG,171)
			ENDIF
		ENDIF
	ENDIF
ELSE
	CALL DiaperChange(ARG,161)
ENDIF

@LUCID_EV27_BABWEAR(ARG)
FOR LOCAL,0,25
	EQUIP:ARG:LOCAL = 0
	CFLAG:ARG:(240+LOCAL) = 0
NEXT
EQUIP:ARG:10 = 34
EQUIP:ARG:5 = 27
EQUIP:ARG:19 = 65
FOR LOCAL,0,25
	CFLAG:ARG:(200+LOCAL) = EQUIP:ARG:LOCAL
	CFLAG:ARG:(240+LOCAL) = EQUIP:ARG:LOCAL
NEXT

@LUCID_EV27_TODDLEWEAR(ARG)
FOR LOCAL,0,25
	EQUIP:ARG:LOCAL = 0
NEXT
EQUIP:ARG:16 = 46
EQUIP:ARG:11 = 2
EQUIP:ARG:5 = 20

