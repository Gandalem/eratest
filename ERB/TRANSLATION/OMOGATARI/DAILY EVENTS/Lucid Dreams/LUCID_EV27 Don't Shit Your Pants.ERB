				CALL PRINT_GP("W", @"~일 때만 \@ EQUIP:TempUfufuBecome:6 ? %HE_SHE(TempUfufuBecome)% makes a %@"\@ DAILY_LUCID_STATS:2 ? 물컹한 # 젖은\@"% gift into %HIS_HER(TempUfufuBecome)% %PeeProtectType(TempUfufuBecome,2)% # the sand begins to feel wet \@ ~할 때 %HE_SHE(TempUfufuBecome)% 깨닫는다 %HE_SHE(TempUfufuBecome)% 가야 했다.")
				DAILY_Lucid_Stats:10 = 7
				CALL LucidDreamEnd()
			ENDIF
		ENDIF
		IF DAILY_Lucid_Stats:14 <= 0
			CLEARBIT YoujutsuEffects:TempUfufuBecome:18,34
			IF STRFIND(DAILY_Lucid_CurrentPosition, "onToilet/") > -1 || STRFIND(DAILY_Lucid_CurrentPosition, "onPottyChair/") > -1
				CALL GoToilet(TempUfufuBecome,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,EQUIP:TempUfufuBecome:6 ? -1 # 1,1,(STRFIND(DAILY_Lucid_CurrentPosition, "onPottyChair/") > -1)*3)
			ELSE
				CALL CAUSE_OMORASHI(TempUfufuBecome,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
				DAILY_Lucid_Stats:9 = LucidDreamLoser()
				DAILY_Lucid_Stats:10 = 12
			ENDIF
			CALL LucidDreamEnd()
		ENDIF
	CASE 3
		DAILY_Lucid_Stats:11 = 0
		DAILY_Lucid_Stats:13 = 0
		IF GET_MAPID(CFLAG:MASTER:300) != 18
			DAILY_Lucid_Stats:10 = 8
			CALL LucidDreamEnd()
		ENDIF
		IF CFLAG:MASTER:300 != CFLAG:TempUfufuBecome:300
			CALL PRINT_GPC("W", @"「%NAME:MASTER%, ID {MASTER}와 %NAME:TempUfufuBecome%, ID {TempUfufuBecome} 사이에 위치 불일치가 감지되었다..」", 102)
			CALL PRINT_GPC("W", @"「%NAME:MASTER%의, ID {MASTER}에서 %NAME:TempUfufuBecome%의, ID {TempUfufuBecome}으로 회귀를 시킨다.」", 102)
			CFLAG:MASTER:300 = CFLAG:TempUfufuBecome:300
		ENDIF
		FOR LOCAL,0,CHARANUM
		SIF CFLAG:LOCAL:300 != CFLAG:TempUfufuBecome:300
			CONTINUE
		IF LOCAL == 103
			CALL LucidDreamEnd()
			RETURN
			;UH OH
		ENDIF
		IF LOCAL == TempUfufuBecome
			IF STRFIND(DAILY_Lucid_CurrentPosition, "Crying/") > -1
				GOTO AddCry
			ENDIF
		ENDIF
		SIF GET_EMOTION(LOCAL) == 29
			GOTO AddCry
		IF (SoiledSelf:(LOCAL):0 || SoiledSelf:(LOCAL):1)
			DAILY_Lucid_Stats:13 ++
			IF CFLAG:(LOCAL):睡眠
				PRINTFORML %CALLNAME:(LOCAL)%은(는) 깨어나 울기 시작한다.
				CALL LUCID_EV27_BEGIN_CRYING(LOCAL)
				GOTO AddCry
			ELSE
				GOTO AddCry
			ENDIF
		ENDIF
		IF RAND(20) < DAILY_Lucid_Stats:11 && DAILY_Lucid_Stats:11 && GET_EMOTION(LOCAL) != 29
			PRINTFORML 과도한 소음 때문에 %CALLNAME:(LOCAL)%이 깨어나 울기 시작한다.
			CALL LUCID_EV27_BEGIN_CRYING(LOCAL)
			GOTO AddCry
		ENDIF
		$AddCry
		IF GET_EMOTION(LOCAL) == 29
			SIF TCVAR:LOCAL:LastMood == 29
				PRINTFORML %CALLNAME:(LOCAL)%은 계속 울고 있다.
			DAILY_Lucid_Stats:11 ++
			DAILY_Lucid_Stats:12 ++
			TCVAR:LOCAL:LastMood = 29
		ENDIF
		NEXT
ENDSELECT
IF DAILY_Lucid_Stats:11 >= 5
	PRINTFORML %NUM_COUNT(DAILY_Lucid_Stats:11)%의 울음소리는 %CALLNAME:103%가 감당하기에는 너무 크다.
	PRINTFORML %HE_SHE(103,1)%은 조사하기 위해 보육실 쪽으로 향한다.
	CALL LucidDreamEnd()
