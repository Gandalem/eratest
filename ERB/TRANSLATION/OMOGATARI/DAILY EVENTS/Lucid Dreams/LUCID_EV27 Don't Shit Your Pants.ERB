; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV27 Don't Shit Your Pants.ERB
;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
;Normal
;Nightmare
;Sex
;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------

@LUCID_DREAM_INFO_27
#FUNCTION
LOCALS:0 '= "응가"
LOCALS:1 '= "바지"
SIF !GETBIT(nScat,2)
	LOCALS:0 '= "소변"
SIF nOmutsu
	LOCALS:1 '= "기저귀"
DAILY_Lucid_Name '= @"바지에 지리지 마라"
DAILY_Lucid_Desc '= "플래시 게임 『바지에 똥 싸지 마!』에서 영감을 받은 꿈이다. 평소 조작은 사용할 수 없으며 텍스트 명령으로 움직여야 한다. 그리고 절대로 바지에 실수하지 마라!"
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = YoujutsuBookProgress:MASTER:19 > 0
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "10/"
DAILY_Lucid_CanGiveUp = 0
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_27
#DIM charaSwitchTo
TempUfufuBecome = MASTER
CALLF WAKEUP(MASTER)
SELECTCASE YoujutsuBookProgress:MASTER:18
	CASE 0
		DAILY_Lucid_Stats:7 = 1
	CASEELSE
		DAILY_Lucid_Stats:7 = TFLAG:103
ENDSELECT
[IF_DEBUG]
CALL EasyImage(@"LD027","OMOGATARI/Menus/LD027.png")
PRINTFORML [1] - 작은 교훈 (절박한, 기저귀를 찬)
PRINTFORML [2] - 「응가 마려워?」 (절박한, 풀업을 입은)
PRINTFORML [3] - 이리 와 %CALLNAME:103%! (기저귀를 찬, 다른 사람 5명과 함께 있는)
PRINTL
PRINTFORML [0] 진행도에 따라 달라지는 시나리오
INPUT
SIF RESULT > 0
	DAILY_Lucid_Stats:7 = RESULT
[ENDIF]
;reset positions
FOR LOCAL,0,CHARANUM
SIF LOCAL == MASTER
	CONTINUE
SIF CFLAG:LOCAL:300 == CFLAG:MASTER:300
	CFLAG:LOCAL:300 = SUKIMA()
NEXT
IF SaveIsEZB
	CALL PRINT_GPC("L", @"「EV.2.27.{DAILY_Lucid_Stats:7} 로딩 중」", 100)
ELSEIF FactionRank:MASTER:9 >= 4 || SignificantRelationship(102)
	FONTITALIC
	CALL PRINT_GPC("L", @"「%FACTION_CALLSIGN_9(102)%가 %FACTION_CALLSIGN_9(MASTER)%에게, EV.2.27.{DAILY_Lucid_Stats:7}을 시작한다」", 102)
	PRINTL
	FONTREGULAR
ENDIF
SELECTCASE DAILY_Lucid_Stats:7
	CASE 0
	CASE 1
		CALL LUCID_EV27_BABWEAR(MASTER)
		CALL PRINT_GP("W", @"당신은 보육원에서 아기 침대에서 깨어나지만, 전혀 편해 보이지 않는다.")
		IF nOmutsu
			CALL PRINT_GP("W", @"당신이 자신의 사타구니를 만지자, 기저귀의 부드러운 볼륨을 적어도 느낀다.")
			CALL DiaperChange(MASTER,103)
		ELSE
			CALL PRINT_GP("W", @"당신이 가랑이를 만져도 여전히 일반 속옷을 입고 있는 기분이다.")
		ENDIF
		CALL PRINT_GP("W", @"게다가 당신은 지금 %PeeProtectType(MASTER,2)%을 제자리에 고정하는 스냅이 달린 원피스 같은 것을 입고 있다.")
		PRINTL
		CALL PRINT_GP("W", @"아기 침대가 무너지자, 당신은 %K102_CALLNAME()%의 친숙한 얼굴이 귀엽게 당신에게 말하는 것을 본다.")
		SELECTCASE YoujutsuBookProgress:MASTER:19
			CASE 0
				IF FactionRank:MASTER:9 >= 4 || SignificantRelationship(102) || SaveIsEZB
					CALL PRINT_GPC("W", @"「%FACTION_CALLSIGN_9(MASTER)%, 배출 술법 훈련을 하러 왔나?」", 102)
					CALL PRINT_GP("W", @"당신은 긍정적으로 응답한다.")
					CALL PRINT_GPC("W", @"「이게 네 침대가 젖은 채로 깨는 일로 끝날 수 있다고 경고했었나?」", 102)
					CALL PRINT_GPC("W", @"「어차피 상관없어. 시작하기 전에 현실에서 이미 너를 바꿨으니까.」", 102)
					CALL PRINT_GPC("W", @"「어쨌든, 이번 훈련에서는 몇 가지 배설 주술의 효과를 받게 될 것이다.」", 102)
					CALL PRINT_GPC("W", @"「그리고 나중에 작은 놀라움이 있지.」", 102)
				ELSE
					CALL PRINT_GPC("W", @"「나의 작은 %조사처리(CALLNAME:MASTER,"가")% 너무 호기심이 많아 나쁜 짓을 했다는 것을 봤다.」", 102)
					CALL PRINT_GPC("W", @"「걱정 마, 벌 주진 않을 거야. 네가 읽으려고 했던 것에 대해 작은 교훈을 줄 뿐이니까.」", 102)
				ENDIF
			CASEELSE
				CALL PRINT_GPC("W", @"「작은 %조사처리(CALLNAME:MASTER,"는")% 어떻게 지내고 있니?」", 102)
				CALL PRINT_GPC("W", @"「심심해 보이니 작은 게임 하나 하자.」", 102)
		ENDSELECT
		PRINTL
		SKIPDISP 1
		CALL PROCESS_YOUJUTSU_COMMAND(102,MASTER,18,34)
		SKIPDISP 0
		CALL PRINT_GPC("W", @"「%NAS_ESP_NAME%...」", 102)
		IF DAILY_Lucid_Stats:1
			SKIPDISP 1
			CALL PROCESS_YOUJUTSU_COMMAND(102,MASTER,18,14)
			SKIPDISP 0
			CALL PRINT_GPC("W", @"「%NAS_ESP_NAME%...」", 102)
		ENDIF
		IF DAILY_Lucid_Stats:2
			SKIPDISP 1
			CALL PROCESS_YOUJUTSU_COMMAND(102,MASTER,18,24)
			SKIPDISP 0
			CALL PRINT_GPC("W", @"「%NAS_ESP_NAME%...」", 102)
		ENDIF
		IF nOmutsu
			CALL DiaperChange(MASTER,103)
			IF BASE:MASTER:4 > DiapeCharges:MASTER:1 || BASE:MASTER:Poo > DiapePooCharges:MASTER:1
				CALL DiaperChange(MASTER,104)
				IF BASE:MASTER:4 > DiapeCharges:MASTER:1 || BASE:MASTER:Poo > DiapePooCharges:MASTER:1
					CALL DiaperChange(MASTER,171)
				ENDIF
			ENDIF
		ELSE
			CALL DiaperChange(MASTER,161)
		ENDIF
		PRINTL
		CALL PRINT_GP("W", @"당신은 언제라도 참지 못할 것처럼 %PeeAndPoo(Daily_Lucid_Stats:1,Daily_Lucid_Stats:2,"pee","poop")%를 극도로 하고 싶다고 느낀다.")
		CALL PRINT_GP("W", @"정말 심하게 아프고, 자신이 이제껏 느껴본 가장 충만한 상태가 된 것 같은 기분이 든다.")
		CALL PRINT_GP("W", @"하지만 놓으려고 하면 무언가 정신적인 장벽이 그것을 막고 있음을 느낀다%COND_STR(", 스스로 지리는 취향이 있는데도", TALENT:MASTER:OmoGuardian)%.")
		CALL PRINT_GPC("W", @"「아, 그리고 이걸 당신도 필요할 것 같군요.」", 102)
		PRINTL
		CALL PRINT_GPC("W", @"「메타 월드 사용자에게 %NAME:MASTER%, ID {MASTER}의 제어권이 재지정되었다」", 102)
		CALL PRINT_GP("W", @"당신의 정신은 하얗게 비고 머리는 텅 빈 느낌이며 방광과 장을 더 이상 느낄 수 없다.")
		PRINTL
		CALL PRINT_GPC("W", @"「메타 월드 사용자여, 당신은 %NAME:MASTER%를 화장실로 조종해야 한다.」", 102)
		SIF !YoujutsuBookProgress:MASTER:19
			CALL PRINT_GPC("W", @"「당신에게는 명령어 라인만 주어지며, %HIM_HER(MASTER)%을 움직이게 하려면 텍스트 명령어를 입력해야 한다.」", 102)
		DAILY_Lucid_CurrentPosition '= "Laying/onCrib/onesieOn/"
		DAILY_Lucid_CurrentLocation '= "inNursery/"
		DAILY_Lucid_Stats:14 = 30
	CASE 2
		FONTITALIC
		SKIPDISP 1
		CALL PROCESS_YOUJUTSU_COMMAND(102,MASTER,18,34)
		SKIPDISP 0
		CALL PRINT_GPC("W", @"「%NAS_ESP_NAME%...」", 102)
		IF DAILY_Lucid_Stats:1
			SKIPDISP 1
			CALL PROCESS_YOUJUTSU_COMMAND(102,MASTER,18,14)
			SKIPDISP 0
			CALL PRINT_GPC("W", @"「%NAS_ESP_NAME%...」", 102)
		ENDIF
		IF DAILY_Lucid_Stats:2
			SKIPDISP 1
			CALL PROCESS_YOUJUTSU_COMMAND(102,MASTER,18,24)
			SKIPDISP 0
			CALL PRINT_GPC("W", @"「%NAS_ESP_NAME%...」", 102)
		ENDIF
		CALL LUCID_EV27_TODDLEWEAR(MASTER)
		IF nOmutsu
			CALL DiaperChange(MASTER,135)
			IF BASE:MASTER:4 > DiapeCharges:MASTER:1 || BASE:MASTER:Poo > DiapePooCharges:MASTER:1
				CALL DiaperChange(MASTER,74)
				IF BASE:MASTER:4 > DiapeCharges:MASTER:1 || BASE:MASTER:Poo > DiapePooCharges:MASTER:1
					CALL DiaperChange(MASTER,164)
				ENDIF
			ENDIF
		ELSE
			CALL DiaperChange(MASTER,161)
		ENDIF
		FONTREGULAR
		PRINTL
		CALL PRINT_GPC("W", @"「장미는... ...파란색이다. 이것이... 오줌을 쌀까, 아니면 변을 볼까?」", 102)
		CALL PRINT_GPC("W", @"「%K102_CALLNAME()%에게 주는 것인가?」", 102)
		CALL PRINT_GP("W", @"당신의 눈이 뜨이기 시작하고 %K102_CALLNAME()%은(는) 당신의 가랑이를 쓰다듬으며 %PeeProtectType(MASTER,2)%을 느낀다.")
		CALL PRINT_GPC("W", @"「%CALLNAME:MASTER%.... %CALLNAME:MASTER%?」", 102)
		CALL PRINT_GPC("W", @"「화장실 가야 해?」", 102)
		PRINTL
		CALL PRINT_GP("W", @"당신은 유치원 놀이 공간의 야외에서 벤치에 누워 깨어난다.")
		CALL PRINT_GP("W", @"당신의 %PeeAndPoo(Daily_Lucid_Stats:1,Daily_Lucid_Stats:2,"방광","장")%는 지난번에 일어났을 때처럼 아프다.")
		CALL PRINT_GP("W", @"당신은 벤치에서 일어나 힘을 주어 쪼그리고 앉아 자신을 비우려 시도하지만 아무것도 나오지 않는다.")
		PRINTL
		CALL PRINT_GPC("W", @"「확실히.」", 102)
		CALL PRINT_GPC("W", @"「ID {MASTER}의 제어권을 메타 월드 사용자에게 넘긴다. 대상은 %NAME:MASTER%이다」", 102)
		CALL PRINT_GP("W", @"당신의 정신이 다시 하얘진다.")
		CALL PRINT_GPC("W", @"「메타 월드 유저여, 당신은 %NAME:MASTER%를 화장실로 조종해야 한다.」", 102)
		CALL PRINT_GPC("W", @"「욕실은 다른 마카이 인물들이 사용하고 있으니... 다른 수단을 찾아야 할 거야... %HIMSELF_HERSELF(MASTER)%가.」", 102)
		DAILY_Lucid_CurrentPosition '= "Squatting/"
		CFLAG:MASTER:300 = 1804
		DAILY_Lucid_Stats:14 = 25
	CASE 3
		FONTITALIC
		CALL PRINT_GPC("L", @"「%CALLNAME:(DAILY_Lucid_Chara:0)%, ID {DAILY_Lucid_Chara:0}... %CALLNAME:MASTER%」", 102)
		CALL PRINT_GPC("L", @"「텔레포트 %CALLNAME:(DAILY_Lucid_Chara:1)%에게... %조사처리(CALLNAME:MASTER,"에게")%...」", 102)
		CALL PRINT_GPC("L", @"「%NAME:(DAILY_Lucid_Chara:2)%을(를) %CALLNAME:MASTER%, ID {MASTER}에게 순간이동시킨다.」", 102)
		CALL PRINT_GPC("L", @"「%NAME:(DAILY_Lucid_Chara:3)%을(를) %NAME:MASTER%에게 전송한다...」", 102)
		CALL PRINT_GPC("L", @"「텔레포트 %NAME:(DAILY_Lucid_Chara:4)%, ID {DAILY_Lucid_Chara:4}, 으로 %NAME:MASTER%, ID {MASTER}.」", 102)
		CALL PRINT_GPC("L", @"「자장가...」", 102)
		REPEAT 5
		CALLF TP(DAILY_Lucid_Chara:COUNT)
		CALLF GO2SLEEP(DAILY_Lucid_Chara:COUNT)
		CALL LUCID_EV27_BABWEAR(DAILY_Lucid_Chara:COUNT)
		CALL LUCID_EV27_DIAPERCHANGE(DAILY_Lucid_Chara:COUNT)
		CFLAG:(DAILY_Lucid_Chara:COUNT):睡眠 = 1
		CFLAG:(DAILY_Lucid_Chara:COUNT):衰弱 = 360
		REND
		FONTREGULAR
		PRINTL
		CALL PRINT_GP("L", @"너는 똑같은 불편한 아기 침대에서, 유치원의 같은 곳에서 깨어난다.")
		IF nOmutsu
			CALL PRINT_GP("L", @"당신이 자신의 사타구니를 만지자 기저귀의 익숙한 부피가 느껴진다.")
		ELSE
			CALL PRINT_GP("L", @"당신이 자신의 사타구니를 만지자 평범한 속옷의 감촉을 다시 느낀다.")
		ENDIF
		CALL LUCID_EV27_BABWEAR(MASTER)
		CALL LUCID_EV27_DIAPERCHANGE(MASTER)
		CALL PRINT_GP("L", @"너는 이것이 처음 일어났을 때 입었던 원피스도 입고 있다.")
		CALL PRINT_GP("L", @"하지만 이번에는 네 몸에 온통 %PeeAndPoo(Daily_Lucid_Stats:1,Daily_Lucid_Stats:2,"젖었다","엉망이다")%를 하고 싶은 충동이 없다.")
		CALL PRINT_GP("L", @"유일하게 빛을 내는 것은 다른 아기 침대의 모빌뿐이다. 불이 꺼진 동안 잠에서 깨어난 것 같았다.")
		PRINTL
		FONTITALIC
		CALL PRINT_GPC("W", @"「%NAME:MASTER%의 제어권을 메타 월드 유저에게 재지정한다, ID {MASTER}로」", 102)
		FONTREGULAR
		CALL PRINT_GP("W", @"잠들려고 할 무렵, 당신의 정신이 하얘지며 깜짝 놀라 깨어난다.")
		FONTITALIC
		CALL PRINT_GPC("W", @"「메타 월드 유저여, %CALLNAME:103%가 방에 들어갈 방법을 찾아라.」", 102)
		CALL PRINT_GPC("W", @"「%조사처리(CALLNAME:MASTER,"는")% 이것을 더 쉽게 하는 데 도움을 줄 수 있는 마법을 가지고 있다. 다른 잠든 토우호스들에게 그것들을 사용해라.」", 102)
		DAILY_Lucid_CurrentPosition '= "Laying/onCrib/onesieOn/magicAvailable/cribLocked/"
		DAILY_Lucid_CurrentLocation '= "inNursery/"
ENDSELECT
DAILY_Lucid_Stats:6 = EQUIP:MASTER:6
SIF DAILY_Lucid_Stats:14 > 0
	CALL PRINT_GPC("W", @"「게다가, %HE_SHE(MASTER)%는 {DAILY_Lucid_Stats:14}턴 후에 통제력을 잃을 테니 서둘러라.」", 102)
CALL PRINT_GPC("W", @"「나는 당신이 하는 모든 움직임을 인내심을 가지고 평가할 것이다.」", 102)
FONTREGULAR
PRINTL
;switch to yumeko
$ReSwitch
charaSwitchTo = RAND(1,CHARANUM-1)
IF CFLAG:charaSwitchTo:出禁 || IsDead:charaSwitchTo:0 || charaSwitchTo == MASTER || charaSwitchTo == 102
	GOTO ReSwitch
ENDIF
CALL PRINT_GPC("W", @"「%NAME:charaSwitchTo%의 재회, ID {charaSwitchTo}에서 %NAME:MASTER%로 ID {MASTER}에게 향한다.」", 102)
CALLF TP(charaSwitchTo)
CALL PRINT_GPC("W", @"「메타 월드 사용자 현재 캐릭터를 %NAME:charaSwitchTo%로, ID {charaSwitchTo}로 설정한다.」", 102)
TempUfufuBecome:1 = charaSwitchTo
CALLF SimultaneousMasterSwap(charaSwitchTo)
CALL LUCID_EV27_BABWEAR(charaSwitchTo)
CALL LUCID_EV27_DIAPERCHANGE(charaSwitchTo)

@LUCID_EV27_DIAPERCHANGE(ARG)
IF nOmutsu
	CALL DiaperChange(ARG,134)
	IF (MAXBASE:ARG:4+1000) > DiapeCharges:ARG:1 || (MAXBASE:ARG:Poo+1000) > DiapePooCharges:ARG:1
		CALL DiaperChange(ARG,103)
		IF (MAXBASE:ARG:4+1000) > DiapeCharges:ARG:1 || (MAXBASE:ARG:Poo+1000) > DiapePooCharges:ARG:1
			CALL DiaperChange(ARG,104)
			IF (MAXBASE:ARG:4+1000) > DiapeCharges:ARG:1 || (MAXBASE:ARG:Poo+1000) > DiapePooCharges:ARG:1
				CALL DiaperChange(ARG,171)
			ENDIF
		ENDIF
	ENDIF
ELSE
	CALL DiaperChange(ARG,161)
ENDIF

@LUCID_EV27_BABWEAR(ARG)
FOR LOCAL,0,25
EQUIP:ARG:LOCAL = 0
CFLAG:ARG:(240+LOCAL) = 0
NEXT
EQUIP:ARG:10 = 34
EQUIP:ARG:5 = 27
EQUIP:ARG:19 = 65
FOR LOCAL,0,25
CFLAG:ARG:(200+LOCAL) = EQUIP:ARG:LOCAL
CFLAG:ARG:(240+LOCAL) = EQUIP:ARG:LOCAL
NEXT

@LUCID_EV27_TODDLEWEAR(ARG)
FOR LOCAL,0,25
EQUIP:ARG:LOCAL = 0
NEXT
EQUIP:ARG:16 = 46
EQUIP:ARG:11 = 2
EQUIP:ARG:5 = 20
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_27
DAILY_Lucid_Stats:9 = LucidDreamLoser(1)
SELECTCASE DAILY_Lucid_Stats:7
	CASE 1, 2
		IF STRFIND(DAILY_Lucid_CurrentPosition, "onesieOn/") > -1 && STRFIND(DAILY_Lucid_CurrentPosition, "onCrib/") > -1 && STRFIND(DAILY_Lucid_CurrentPosition, "Laying/") > -1
			CALL PRINT_GPC("W", @"「메타 월드 유저, 너 시도조차 해봤을지 궁금하네.」", 102)
			CALL PRINT_GPC("W", @"「솔직히 말하자면, 나 같았으면 침대에 누워서 다시 잠들었을 거야 %HIM_HER(TempUfufuBecome)% %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"pee","poop")% %HIS_HER(TempUfufuBecome)% %PeeProtectType(TempUfufuBecome,2)%.」", 102)
			DAILY_Lucid_Stats:10 = 3
		ELSEIF !EQUIP:TempUfufuBecome:6 && STRFIND(DAILY_Lucid_CurrentPosition, "onCrib/") > -1
			CALL PRINT_GPC("W", @"「젠장 메타 월드 유저, 네가 %CALLNAME:TempUfufuBecome%을 변기 안에 넣어야지, %HIS_HER(TempUfufuBecome)%의 아기 침대에 넣으면 안 된다고.」", 102)
			CALL PRINT_GPC("W", @"「이제 이걸 치워야겠군.」", 102)
			DAILY_Lucid_Stats:10 = 4
