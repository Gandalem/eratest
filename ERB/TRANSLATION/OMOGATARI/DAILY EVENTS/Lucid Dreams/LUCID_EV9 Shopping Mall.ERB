; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV9 Shopping Mall.ERB
;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_9
#FUNCTION
DAILY_Lucid_Name '= "Shopping Mall"
DAILY_Lucid_Desc '= "You're at the mall with your caretaker!\n You've been promised your favorite ice cream if you're good, but you really need to go potty, and it's getting really bad, really quick."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 1
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/12/20/62"
DAILY_Lucid_CanGiveUp = 2
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_9
;shopping trip
;requires midworld tech knowledge
CALLF TP(DAILY_Lucid_Chara)
TARGET = DAILY_Lucid_Chara
TARGET:1 = DAILY_Lucid_Chara
CFLAG:DAILY_Lucid_Chara:睡眠 = 0
TCVAR:DAILY_Lucid_Chara:906 = 1
CFLAG:DAILY_Lucid_Chara:同室 = 1
TFLAG:104 = DAILY_Lucid_Chara
BASE:MASTER:0 = MAXBASE:MASTER:0
CALLF PANTY_REWORK_CHANGE(MASTER,5)
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
DAILY_Lucid_Stats:7 = TIME + RAND:100
DAILY_Lucid_Stats:10 = 0
PRINTFORMDW 네가 %CALLNAME:DAILY_Lucid_Chara%과 쇼핑몰에 있다!
PRINTFORMDW 쇼핑은 정말 신나는 일이다. 특히 착하면 가장 좋아하는 아이스크림을 약속받았기 때문이다.
PRINTFORMDW 하지만 시간이 좀 걸렸고, 집에서 \@ DAILY_Lucid_Stats:1 ? 마실 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 먹을 #  \@ 꽤 많은 것을 했다.
PRINTFORMDW 책임감 있게 행동해서 \@ DAILY_Lucid_Stats:1 ? 소변을 본 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 대변을 본 #  \@ 집에서 했더라도, 벌써 다시 가야 한다.
PRINTFORMDW 상황이 정말 빠르게 나빠지고 있다.
PRINTFORMDW 무슨 수를 써서라도 서둘러야 한다.
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_9
IF DAILY_Lucid_Stats:9 == 1
	PRINTFORMDW 거의 다 왔어, 아주 가까워, 하지만 너는 딱 제시간에 거기에 도달했어!
	CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,2)
	IF RESULT <= 0
		PRINTL ...
		PRINTFORML %CALLNAME:DAILY_Lucid_Chara%와 함께 있었을 때든, 변기 칸에서든 자지 않았다는 건 중요하지 않다...
		PRINTFORMW 당신이 사고를 친 것은 %HE_SHE(DAILY_Lucid_Chara)%가 분명 꾸짖을 것이라고...
		GOTO MallAccidentEnd
	ENDIF
	PRINTFORMDW 큰 %PRINT_MALE("boy", MASTER)%이 된 기분이 좋다!
ELSEIF PeeBarStage(MASTER) >= 7 || PooBarStage(MASTER) >= 7
	CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
	PRINTL
	PRINTFORMDW 너는 큰 %PRINT_MALE("boy", MASTER)% 바지를 책임질 만큼 충분히 대단하다고 생각했지만, 지금은 패딩으로 채워지고 싶다.
	PRINTFORML
	$MallAccidentEnd
	PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%는 네가 \@ DAILY_Lucid_Stats:1 ? 에 오줌을 지린 흔적과 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%그리고%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 를 엉망으로 만든 흔적 #  \@을 보고 풀이 죽은 채 돌아온다…… 
	CALL SET_KOJO_COLOR(DAILY_Lucid_Chara)
	PRINTFORMW 「%CALLNAME:MASTER%...」
	PRINTFORMW 「너를 위해 환상 속으로 돌아가자...」
	RESETCOLOR
	CALL RandomUnderwearCheck(DAILY_Lucid_Chara,2)
	DAILY_Lucid_Stats:9 = 10
ENDIF
;When a command ends

@LUCID_DREAM_TURN_9
IF DAILY_Lucid_Stats:7 <= TIME
	PRINTFORMDW 당신과 %CALLNAME:DAILY_Lucid_Chara%가 아이스크림 가게에 도착했다.
	SIF TARGET && SHIRAHU(TARGET)
		PRINTFORM 그리고 %PARSE("You")%과 %조사처리(CALLNAME:TARGET,"는")% 먹는다
	PRINTDATA
		DATAFORM 『아이스크림』
		DATAFORM 『냉동 만다린 오렌지』
		DATAFORM 『더블 스틱 아이스 포푸리』
		DATAFORM 『더블 스틱 아이스크림』
		DATAFORM 『츄펫』
		DATAFORM 『파피코 아이스크림』
		DATAFORM 『연유 아이스크림 바』
		DATAFORM 『팥 아이스크림 바』
		DATAFORM 『수박 포푸리』
		DATAFORM 『오렌지 아이스 팝』
		DATAFORM 『블랙 썬더 아이스크림』
		DATAFORM 『유키미 다이후쿠』
	ENDDATA
	PRINTFORML 함께.
	CALL RECOVER(MASTER, 150, "気力", "아이스크림으로 회복한다.")
	IF TARGET && SHIRAHU(TARGET)
		CALL RECOVER(TARGET, 150, "気力", "아이스크림으로 회복한다.")
	ENDIF
	SIF DAILY_Lucid_Stats:1
		BASE:MASTER:尿意 += 125
	SIF DAILY_Lucid_Stats:2
		BASE:MASTER:Poo += 125
	PRINTFORMDW 먹는 동안 당신의 절박함을 분명히 본 %CALLNAME:DAILY_Lucid_Chara%가 아이스크림을 받을 때까지 참아낸 것을 박수쳐 칭찬한다.
	CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
	PRINTFORMW 「여기까지 버틸 수 있었다니 놀랐다.」
	IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
		PRINTFORMW 「자, 이제 변기로 가볼까-」
		PRINTFORMDW 최선을 다해 참으려 애했지만, 아이스크림이 그 한계를 넘치게 만들었다.
		PRINTFORMDW 당신은 안도하며 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ your lower half silly\@ DAILY_Lucid_Stats:1 ? ; %FSYN("pee:n")% 의자에서 내려 바닥에 쏟기 전에 달린다 #  \@\@ DAILY_Lucid_Stats:2 ? ; %FSYN("poo:n")% 속옷에서 흘러나와 의자를 갈색으로 물들이며 배설한다 #  \@.
		PRINTFORML			
		PRINTFORMDW 너는 큰 %PRINT_MALE("boy", MASTER)% 바지를 책임질 만큼 충분하다고 생각했지만, 지금은 쿠션이 있는 게 훨씬 더 좋을 것이다. 	
		CALL LucidDreamTimeUp()
	ELSE
		PRINTFORMW 「이제 큰 사고 치기 전에 화장실에 가자.」
		RESETCOLOR
		PRINTFORMDW 당신은 화장실로 끌려가서 온 힘을 다해 참으려고 애한다.
		DAILY_Lucid_Stats:9 = 1
		CALL LucidDreamTimeUp()
	ENDIF
ELSEIF DAILY_Lucid_Stats:7-TIME <= 20 && !DAILY_Lucid_Stats:10
	SIF DAILY_Lucid_Stats:1
		CALL PEESOUNDS("s")
	PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%가 이상하게 성인 크기의 화려한 로퍼를 보는 동안 처음으로 새어 나오고, 큰 문제에 처했다는 것을 깨닫는다.
	PRINTFORMDW 그래도 한동안 버티며 아이스크림을 먹을 때까지 해내겠다고 다짐한다.
	PRINTFORMDW 하지만 갑자기 기저귀 코너에 서게 되고, 그 모든 패딩을 보는 것이 버티기 거의 불가능하게 만든다.
	SIF DAILY_Lucid_Stats:1
		BASE:MASTER:尿意 += RAND:120
	SIF DAILY_Lucid_Stats:2
		BASE:MASTER:Poo += RAND:120
	DAILY_Lucid_Stats:10 = 1
ENDIF
IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
	CALL LucidDreamTimeUp()
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_9(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		PRINTFORMDW 너는 %CALLNAME:DAILY_Lucid_Chara%이 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ 이미 또 걱정하는 것 같다.
		PRINTFORMDW 하지만 너는 스스로를 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ 하고 빠져나가기에는 너무 나이가 많다는 것을 알고 있다.
		PRINTFORMDW 그래서 그 맛있는 아이스크림을 놓칠 위험에도 불구하고, 너는 %CALLNAME:DAILY_Lucid_Chara%의 소매를 잡아당기며 정말로 가야 한다고 말한다!
		CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
		PRINTFORMW 「좋은 %PRINT_MALE("boy",MASTER)% %조사처리(CALLNAME:MASTER,"야")%!」
		PRINTFORMW 「화장실을 보면 데려다줄 테니 그때 아이스크림 먹어도 돼.」
		RESETCOLOR
		PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%는 당신에게 미소 지으며 그들에게 그렇게 잘 말해준 것을 따뜻하게 칭찬하고, 당신을 욕실로 데려간다.
		DAILY_Lucid_Stats:9 = 1
		CALL LucidDreamTimeUp()
	CASE 400, 811, 405
		IF !IS_CHILD(MASTER)
			PRINTFORMDW 이 꿈은 재미있었지만, 그건 당신의 믿음의 유보를 상당히 희박하게 늘리고 있어.
			PRINTFORMDW 당신은 쇼핑 여행에 너무 나이가 많다는 걸 알고 있고, 이제 아주 오래전부터 혼자 아이스크림을 사 먹고 있잖아, 정말 고마워!
			PRINTFORMD 하지만 당신은 
		ELSE
			PRINTFORMD 쇼핑 여행이 즐겁더라도 당신은 
		ENDIF
		PRINTFORMDW \@ LastAccident:MASTER:0 > MAX(DAY-5,0) || LastPooAccident:MASTER:0 > MAX(DAY-5,0) ? 최근에 정말 많은 사고를 치고 있는 것 같다 # 꿈에서 진짜 사고가 날 거라는 걸 알겠다 \@.
		PRINTFORMDW 그러니 만약 네 꿈이 너에게 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,FSYN("pee"),FSYN("poo"))%라고 말하고 있다면, 깨어나는 게 좋을지도 모른다.
		PRINTFORMDW 그리고 빨리.
		PRINTFORMDW 네 자신을 세게 꼬집고 번쩍 잠에서 깬다.
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_9(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		DAILY_Lucid_ComName '= @"%CALLNAME:DAILY_Lucid_Chara%에게 말한다"
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
