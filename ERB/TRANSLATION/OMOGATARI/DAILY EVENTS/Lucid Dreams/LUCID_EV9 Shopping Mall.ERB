@LUCID_DREAM_INPUT_STATUS_9
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"도착까지 남은 시간: {DAILY_Lucid_Stats:7-TIME}분."
RETURNF DAILY_Lucid_InfoTab
