@LUCID_EV3_GET_POINT_HOLD(VALUE, PRINT_TYPE)
#DIM VALUE
#DIM PRINT_TYPE;表示形式　0=通常　1=L　2=W
SIF VALUE <= 0
	RETURN
CALL COLORMESSAGE(@"{VALUE} 홀드 포인트를 받았다. 총합: {LUCID_EV3_POINTS:0} → {(LUCID_EV3_POINTS:0)+VALUE}", C_YELLOW, PRINT_TYPE)
LUCID_EV3_POINTS:0 += VALUE

@LUCID_EV3_GET_POINT_CARE(VALUE, PRINT_TYPE)
#DIM VALUE
#DIM PRINT_TYPE;表示形式　0=通常　1=L　2=W
