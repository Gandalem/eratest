@LUCID_EV3_SORT_ITEMS(SORT_TYPE,ITEM_LIST,ITEM_TYPE,ITEM_CNT)
#DIM SORT_TYPE
#DIM REF ITEM_LIST
#DIMS ITEM_TYPE
#DIM ITEM_CNT
#DIM ITEM_TEMP_A, 5
#DIM ITEM_TEMP_B, 5
#DIM LOOP_COUNT
;ソート実処理
LOCAL:0 = 1
WHILE LOCAL:0 < (ITEM_CNT)
	SIF !(LOCAL:0)
		LOCAL:0 ++
	CALL LUCID_EV3_STORE_ITEM(ITEM_TYPE,ITEM_LIST:(LOCAL:0 - 1))
	ARRAYCOPY "RESULT", "ITEM_TEMP_A"
	CALL LUCID_EV3_STORE_ITEM(ITEM_TYPE,ITEM_LIST:(LOCAL:0))
	ARRAYCOPY "RESULT", "ITEM_TEMP_B"
	
	LOCAL:1 = 0
	SELECTCASE ITEM_TYPE
	CASE "hold", "care"
		IF ITEM_TEMP_A:1 <= ITEM_TEMP_B:1
			LOCAL:1 = 1
		ENDIF
	CASE "underwear"
		IF ITEM_TEMP_A:3 <= ITEM_TEMP_B:3
			LOCAL:1 = 1
		ENDIF
	ENDSELECT
	; PRINTFORMW LOCAL {LOCAL} (ITEM_TEMP_A:1 {ITEM_TEMP_A:1}) | LOCAL-1 {LOCAL-1} (ITEM_TEMP_B:1 {ITEM_TEMP_B:1})
	IF LOCAL:1
		LOCAL:0 ++
	ELSE
		SWAP ITEM_LIST:(LOCAL:0 - 1), ITEM_LIST:(LOCAL:0)
		LOCAL:0 --
	ENDIF
WEND

