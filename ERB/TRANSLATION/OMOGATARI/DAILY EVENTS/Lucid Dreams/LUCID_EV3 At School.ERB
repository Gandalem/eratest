#FUNCTION
#DIM DYNAMIC soilThresh,3
IF IsPadded(MASTER,"diaper")
	;Gensou-chan
	IF STRCOUNT(GET_STR(MASTER, "下半身下着_ずらし可能", EQUIP:MASTER:6, "Tags"),"plastic-back") > 0
		soilThresh:1 = SoiledDiaper(MASTER,1,2,-1)
		soilThresh:2 = SoiledDiaper(MASTER,2,2,-1)*2
	ELSE
		;ESC MAG
		soilThresh:1 = SoiledDiaper(MASTER,1,2,-1)*3
		soilThresh:2 = SoiledDiaper(MASTER,2,2,-1)*5
	ENDIF
ELSEIF IsPadded(MASTER,"pull-up")
	soilThresh:1 = SoiledDiaper(MASTER,1,2,-1)*4
	soilThresh:2 = SoiledDiaper(MASTER,2,2,-1)*8
ELSE
	soilThresh:1 = SoiledDiaper(MASTER,1,2,-1)*8
	soilThresh:2 = SoiledDiaper(MASTER,2,2,-1)*12
ENDIF
IF GETBIT(LUCID_EV3_Care,1)
	TIMES soilThresh:1, 0.6
ENDIF
IF GETBIT(LUCID_EV3_Care,0)
	TIMES soilThresh:2, 0.4
ENDIF
soilThresh = soilThresh:1 + soilThresh:2
IF GETBIT(LUCID_EV3_Care,2)
	TIMES soilThresh, 0.6
ENDIF
RETURNF soilThresh

@LUCID_EV3_STORE
#DIM DYNAMIC nInput
#DIM DYNAMIC nOffset
#DIM DYNAMIC nLineCount
#DIM DYNAMIC nLoop
#DIM DYNAMIC nEntryTempInt, 5
#DIMS DYNAMIC nEntryTempStr, 5
#DIM CONST nCheckMax = 12
#DIM DYNAMIC nTempEntryList, 12
#DIM DYNAMIC nTempEntryCount
nLineCount = LINECOUNT
DO
CLEARLINE LINECOUNT-nLineCount
SETCOLOR C_YELLOW
PRINTFORM 【밑의 봉사】
RESETCOLOR
PRINTL  상점
PRINTFORML 보유 포인트: {LUCID_EV3_POINTS:0}
PRINTFORML 관리 포인트: {LUCID_EV3_POINTS:1}
PRINTFORML 승패 기록: {LUCID_EV3_TIMES_WIN}-{LUCID_EV3_TIMES_SHAT_SELF}
PRINTL
PRINTFORML 【잡기】
;make list
VARSET nTempEntryList
nTempEntryCount = 0
FOR nLoop,0,nCheckMax
CALL LUCID_EV3_STORE_ITEM("care",nLoop)
SIF RESULT == -1 || RESULT:2 == 0
	CONTINUE
nTempEntryList:nTempEntryCount = nLoop
nTempEntryCount++
NEXT
CALL LUCID_EV3_SORT_ITEMS(0,nTempEntryList,"care",nTempEntryCount)
FOR nLoop,0,nTempEntryCount
CALL LUCID_EV3_STORE_ITEM("hold",nTempEntryList:nLoop)
SIF RESULT == -1 || RESULT:2 == 0
	CONTINUE
ARRAYCOPY "RESULT", "nEntryTempInt"
ARRAYCOPY "RESULTS", "nEntryTempStr"
IF GETBIT(LUCID_EV3_UNLOCK_HOLD,nTempEntryList:nLoop) || GETBIT(LUCID_EV3_HOLD,nTempEntryList:nLoop)
	IF GETBIT(LUCID_EV3_HOLD,nTempEntryList:nLoop)
		SETCOLOR C_ORANGE
	ELSE
		SETCOLOR C_AQUA
	ENDIF
	PRINTFORM [{1000+nTempEntryList:nLoop}] %nEntryTempStr:0%은(는) ({nEntryTempInt:1} 보유 pt.): %nEntryTempStr:1%
	IF GETBIT(LUCID_EV3_HOLD,nTempEntryList:nLoop)
		PRINTFORML (활성)
	ELSE
		PRINTFORML (구매함)
	ENDIF
	RESETCOLOR
ELSEIF LUCID_EV3_POINTS:0 >= nEntryTempInt:1
	PRINTFORML [{1000+nTempEntryList:nLoop}] %nEntryTempStr:0%은(는) ({nEntryTempInt:1} 보유 pt.): %nEntryTempStr:1%
	RESETCOLOR
ELSE
	SETCOLOR C_GRAY
	PRINTPLAINFORM [{1000+nTempEntryList:nLoop}] %nEntryTempStr:0%은(는) ({nEntryTempInt:1} 보유 pt.): %nEntryTempStr:1%
	PRINTL
ENDIF
NEXT
PRINTL
PRINTFORML 【돌봄】
;make list
VARSET nTempEntryList
nTempEntryCount = 0
FOR nLoop,0,nCheckMax
CALL LUCID_EV3_STORE_ITEM("care",nLoop)
SIF RESULT == -1 || RESULT:2 == 0
	CONTINUE
nTempEntryList:nTempEntryCount = nLoop
nTempEntryCount++
NEXT
CALL LUCID_EV3_SORT_ITEMS(0,nTempEntryList,"care",nTempEntryCount)
FOR nLoop,0,nTempEntryCount
CALL LUCID_EV3_STORE_ITEM("care",nTempEntryList:nLoop)
SIF RESULT == -1 || RESULT:2 == 0
	CONTINUE
ARRAYCOPY "RESULT", "nEntryTempInt"
ARRAYCOPY "RESULTS", "nEntryTempStr"
IF GETBIT(LUCID_EV3_UNLOCK_Care,nTempEntryList:nLoop) || GETBIT(LUCID_EV3_Care,nTempEntryList:nLoop)
	IF GETBIT(LUCID_EV3_Care,nTempEntryList:nLoop)
		SETCOLOR C_ORANGE
	ELSE
		SETCOLOR C_AQUA
	ENDIF
	PRINTFORM [{2000+nTempEntryList:nLoop}] %nEntryTempStr:0% ({nEntryTempInt:1} 간호 환자): %nEntryTempStr:1%
	IF GETBIT(LUCID_EV3_Care,nTempEntryList:nLoop)
		PRINTFORML (활성)
	ELSE
		PRINTFORML (구매함)
	ENDIF
	RESETCOLOR
ELSEIF LUCID_EV3_POINTS:0 >= nEntryTempInt:1
	PRINTFORML [{2000+nTempEntryList:nLoop}] [%nEntryTempStr:0%] ({nEntryTempInt:1} 조심해서 돌봐줘:) [%nEntryTempStr:1%]
	RESETCOLOR
ELSE
	SETCOLOR C_GRAY
	PRINTPLAINFORM [{2000+nTempEntryList:nLoop}] [%nEntryTempStr:0%] ({nEntryTempInt:1} 환자 돌봄): [%nEntryTempStr:1%]
	PRINTL
ENDIF
NEXT
PRINTL
PRINTFORML 【속옷】
PRINTFORML *1 사고 = 600ml
IF nOmutsu
	PRINTFORM 기저귀가 강조된다
	SETCOLOR 0x9999ff
	PRINTFORML 파란색
	RESETCOLOR
ENDIF
VARSET nTempEntryList
nTempEntryCount = 0
FOR nLoop,0,nCheckMax
CALL LUCID_EV3_STORE_ITEM("underwear",nLoop)
SIF RESULT == -1 || RESULT:4 == 0
	CONTINUE
nTempEntryList:nTempEntryCount = nLoop
nTempEntryCount++
NEXT
CALL LUCID_EV3_SORT_ITEMS(0,nTempEntryList,"underwear",nTempEntryCount)
FOR nLoop,0,nTempEntryCount
CALL LUCID_EV3_STORE_ITEM("underwear",nTempEntryList:nLoop)
SIF RESULT == -1
	CONTINUE
ARRAYCOPY "RESULT", "nEntryTempInt"
ARRAYCOPY "RESULTS", "nEntryTempStr"
CALLF DiapeStats(MASTER,nEntryTempInt:1,1,1,nEntryTempInt:2)
nEntryTempStr:4 '= "("+TOSTR(RESULT:1)+"ml/"+TOSTR(RESULT:2)+@"g)"
nEntryTempStr:3 '= UNDIES_NAME_WITH_BRAND(MASTER,(nEntryTempInt:1),1)
IF nEntryTempInt:2 != -1
	nEntryTempStr:3 += @" %nEntryTempStr:2%와 함께"
ENDIF
IF LUCID_EV3_TIMES_SHAT_SELF >= nEntryTempInt:3
	SIF nTempEntryList:nLoop == LUCID_EV3_UNDIES
		SETCOLOR C_AQUA
	PRINTFORM [{3000+nTempEntryList:nLoop}]
	SIF IsPadded(MASTER,,nEntryTempInt:1) && nTempEntryList:nLoop != LUCID_EV3_UNDIES
		SETCOLOR 0x9999ff
	PRINTFORM %nEntryTempStr:3%
	SIF nTempEntryList:nLoop != LUCID_EV3_UNDIES
		RESETCOLOR
	PRINTFORM : %nEntryTempStr:1% %nEntryTempStr:4%
ELSE
	SETCOLOR C_GRAY
	PRINTPLAINFORM [{3000+nTempEntryList:nLoop}]
	SIF IsPadded(MASTER,,nEntryTempInt:1)
		SETCOLOR 0x4c4a77
	PRINTPLAINFORM %nEntryTempStr:3%
	SETCOLOR C_GRAY
	PRINTPLAINFORM ({nEntryTempInt:3}회 패배): %nEntryTempStr:1% %nEntryTempStr:4%
ENDIF
PRINTL
RESETCOLOR
NEXT
PRINTL
PRINTFORML 【난이도】
FOR nLoop,0,nCheckMax
CALL LUCID_EV3_STORE_ITEM("start",nLoop)
SIF RESULT == -1
	CONTINUE
ARRAYCOPY "RESULT", "nEntryTempInt"
ARRAYCOPY "RESULTS", "nEntryTempStr"
IF LUCID_EV3_TIMES_WIN >= nEntryTempInt:1
	SIF nLoop == LUCID_EV3_DIFFICULTY
		SETCOLOR C_AQUA
	PRINTFORML [{4000+nLoop}] %nEntryTempStr:0%: %nEntryTempStr:1%
ELSE
	SETCOLOR C_GRAY
	PRINTPLAINFORM [{4000+nLoop}] %nEntryTempStr:0% ({nEntryTempInt:1}회 승리): %nEntryTempStr:1%
	PRINTL
ENDIF
RESETCOLOR
NEXT
PRINTL
PRINTFORML [-455] 가자!
INPUT
nInput = RESULT
SELECTCASE nInput
	CASE -455
		CLEARLINE LINECOUNT-nLineCount
		DAILY_Lucid_Stats:10 = LUCID_EV3_DIFFICULTY
		CALL LUCID_EV3_STORE_ITEM("underwear",LUCID_EV3_UNDIES)
		CALLF PANTY_REWORK_CHANGE(MASTER,RESULT:1,RESULT:2)
		IF DAILY_Lucid_Stats:1 && GETBIT(LUCID_EV3_Care,3)
			CALLF PEEME(MASTER, 0)
		ENDIF
		IF DAILY_Lucid_Stats:2 && GETBIT(LUCID_EV3_Care,3)
			CALLF POOME(MASTER, 0)
		ENDIF
		CALL CrippleEffects(MASTER)
		CALLF ResetBladders(MASTER)
		RETURN
	CASE 1000 TO 1000+nCheckMax
		nOffset = nInput-1000
		CALL LUCID_EV3_STORE_ITEM("hold",nOffset)
		SIF RESULT == -1
			CONTINUE
		IF GETBIT(LUCID_EV3_UNLOCK_HOLD,nOffset) || GETBIT(LUCID_EV3_HOLD,nOffset)
			INVERTBIT LUCID_EV3_HOLD,nOffset
		ELSEIF LUCID_EV3_POINTS:0 >= RESULT:1
			SETBIT LUCID_EV3_UNLOCK_HOLD,nOffset
			SETBIT LUCID_EV3_HOLD,nOffset
			LUCID_EV3_POINTS:0 -= RESULT:1
		ELSE
			PRINTFORMW 유지 지점이 충분하지 않다...
		ENDIF
	CASE 2000 TO 2000+nCheckMax
		nOffset = nInput-2000
		CALL LUCID_EV3_STORE_ITEM("care",nOffset)
		SIF RESULT == -1
			CONTINUE
		IF GETBIT(LUCID_EV3_UNLOCK_CARE,nOffset) || GETBIT(LUCID_EV3_CARE,nOffset)
			INVERTBIT LUCID_EV3_CARE,nOffset
		ELSEIF LUCID_EV3_POINTS:1 >= RESULT:1
			SETBIT LUCID_EV3_UNLOCK_CARE,nOffset
			SETBIT LUCID_EV3_CARE,nOffset
			LUCID_EV3_POINTS:1 -= RESULT:1
		ELSE
			PRINTFORMW 케어 포인트가 충분하지 않습니다...
		ENDIF
	CASE 3000 TO 3000+nCheckMax
		LUCID_EV3_UNDIES = nInput-3000
	CASE 4000 TO 4000+nCheckMax
		LUCID_EV3_DIFFICULTY = nInput-4000
ENDSELECT
LOOP 1

