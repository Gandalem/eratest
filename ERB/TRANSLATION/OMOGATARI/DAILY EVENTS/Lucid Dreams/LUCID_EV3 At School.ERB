		PRINTPLAINFORM [{2000+nTempEntryList:nLoop}] %nEntryTempStr:0% ({nEntryTempInt:1} Care pt.): %nEntryTempStr:1%
		PRINTL
	ENDIF
NEXT
PRINTL
PRINTFORML 【Underwear】
PRINTFORML ＊1 accident = 600ml
IF nOmutsu
	PRINTFORM ＊Diapers are highlighted 
	SETCOLOR 0x9999ff
	PRINTFORML blue
	RESETCOLOR
ENDIF
VARSET nTempEntryList
nTempEntryCount = 0
FOR nLoop,0,nCheckMax
	CALL LUCID_EV3_STORE_ITEM("underwear",nLoop)
	SIF RESULT == -1 || RESULT:4 == 0
		CONTINUE
	nTempEntryList:nTempEntryCount = nLoop
	nTempEntryCount++
NEXT
CALL LUCID_EV3_SORT_ITEMS(0,nTempEntryList,"underwear",nTempEntryCount)
FOR nLoop,0,nTempEntryCount
	CALL LUCID_EV3_STORE_ITEM("underwear",nTempEntryList:nLoop)
	SIF RESULT == -1
		CONTINUE
	ARRAYCOPY "RESULT", "nEntryTempInt"
	ARRAYCOPY "RESULTS", "nEntryTempStr"
	CALLF DiapeStats(MASTER,nEntryTempInt:1,1,1,nEntryTempInt:2)
	nEntryTempStr:4 '= "("+TOSTR(RESULT:1)+"ml/"+TOSTR(RESULT:2)+@"g)"
	nEntryTempStr:3 '= UNDIES_NAME_WITH_BRAND(MASTER,(nEntryTempInt:1),1)
	IF nEntryTempInt:2 != -1
		nEntryTempStr:3 += @" with %nEntryTempStr:2%"
	ENDIF
	IF LUCID_EV3_TIMES_SHAT_SELF >= nEntryTempInt:3
		SIF nTempEntryList:nLoop == LUCID_EV3_UNDIES
			SETCOLOR C_AQUA
		PRINTFORM [{3000+nTempEntryList:nLoop}] 
		SIF IsPadded(MASTER,,nEntryTempInt:1) && nTempEntryList:nLoop != LUCID_EV3_UNDIES
			SETCOLOR 0x9999ff
		PRINTFORM %nEntryTempStr:3%
		SIF nTempEntryList:nLoop != LUCID_EV3_UNDIES
		RESETCOLOR
		PRINTFORM : %nEntryTempStr:1% %nEntryTempStr:4%
	ELSE
		SETCOLOR C_GRAY
		PRINTPLAINFORM [{3000+nTempEntryList:nLoop}] 
		SIF IsPadded(MASTER,,nEntryTempInt:1)
			SETCOLOR 0x4c4a77
		PRINTPLAINFORM %nEntryTempStr:3% 
		SETCOLOR C_GRAY
		PRINTPLAINFORM ({nEntryTempInt:3} %PLURALIZER("loss",nEntryTempInt:3)%): %nEntryTempStr:1% %nEntryTempStr:4%
	ENDIF
	
	PRINTL
	RESETCOLOR
NEXT
PRINTL
PRINTFORML 【Difficulty】
FOR nLoop,0,nCheckMax
	CALL LUCID_EV3_STORE_ITEM("start",nLoop)
	SIF RESULT == -1
		CONTINUE
	ARRAYCOPY "RESULT", "nEntryTempInt"
	ARRAYCOPY "RESULTS", "nEntryTempStr"
	IF LUCID_EV3_TIMES_WIN >= nEntryTempInt:1
		SIF nLoop == LUCID_EV3_DIFFICULTY
			SETCOLOR C_AQUA
		PRINTFORML [{4000+nLoop}] %nEntryTempStr:0%: %nEntryTempStr:1%
	ELSE
		SETCOLOR C_GRAY
		PRINTPLAINFORM [{4000+nLoop}] %nEntryTempStr:0% ({nEntryTempInt:1} %PLURALIZER("win",nEntryTempInt:1)%): %nEntryTempStr:1%
		PRINTL
	ENDIF
	RESETCOLOR
NEXT
PRINTL
PRINTFORML [-455] Let's go!
INPUT
nInput = RESULT
SELECTCASE nInput
CASE -455
	CLEARLINE LINECOUNT-nLineCount
	DAILY_Lucid_Stats:10 = LUCID_EV3_DIFFICULTY
	CALL LUCID_EV3_STORE_ITEM("underwear",LUCID_EV3_UNDIES)
	CALLF PANTY_REWORK_CHANGE(MASTER,RESULT:1,RESULT:2)
	IF DAILY_Lucid_Stats:1 && GETBIT(LUCID_EV3_Care,3)
	CALLF PEEME(MASTER, 0)
	ENDIF
	IF DAILY_Lucid_Stats:2 && GETBIT(LUCID_EV3_Care,3)
	CALLF POOME(MASTER, 0)
	ENDIF
	CALL CrippleEffects(MASTER)
	CALLF ResetBladders(MASTER)
	RETURN
CASE 1000 TO 1000+nCheckMax
	nOffset = nInput-1000
	CALL LUCID_EV3_STORE_ITEM("hold",nOffset)
	SIF RESULT == -1
		CONTINUE
	IF GETBIT(LUCID_EV3_UNLOCK_HOLD,nOffset) || GETBIT(LUCID_EV3_HOLD,nOffset)
		INVERTBIT LUCID_EV3_HOLD,nOffset
	ELSEIF LUCID_EV3_POINTS:0 >= RESULT:1
		SETBIT LUCID_EV3_UNLOCK_HOLD,nOffset
		SETBIT LUCID_EV3_HOLD,nOffset
		LUCID_EV3_POINTS:0 -= RESULT:1
	ELSE
		PRINTFORMW Not enough Hold points...
	ENDIF
CASE 2000 TO 2000+nCheckMax
	nOffset = nInput-2000
	CALL LUCID_EV3_STORE_ITEM("care",nOffset)
	SIF RESULT == -1
		CONTINUE
	IF GETBIT(LUCID_EV3_UNLOCK_CARE,nOffset) || GETBIT(LUCID_EV3_CARE,nOffset)
		INVERTBIT LUCID_EV3_CARE,nOffset
	ELSEIF LUCID_EV3_POINTS:1 >= RESULT:1
		SETBIT LUCID_EV3_UNLOCK_CARE,nOffset
		SETBIT LUCID_EV3_CARE,nOffset
		LUCID_EV3_POINTS:1 -= RESULT:1
	ELSE
		PRINTFORMW Not enough Care points...
	ENDIF
CASE 3000 TO 3000+nCheckMax
	LUCID_EV3_UNDIES = nInput-3000
CASE 4000 TO 4000+nCheckMax
	LUCID_EV3_DIFFICULTY = nInput-4000
ENDSELECT
LOOP 1

