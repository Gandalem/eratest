@LUCID_EV3_SORT_ITEMS(SORT_TYPE,ITEM_LIST,ITEM_TYPE,ITEM_CNT)
#DIM SORT_TYPE
#DIM REF ITEM_LIST
#DIMS ITEM_TYPE
#DIM ITEM_CNT
#DIM ITEM_TEMP_A, 5
#DIM ITEM_TEMP_B, 5
#DIM LOOP_COUNT
;ソート実処理
LOCAL:0 = 1
WHILE LOCAL:0 < (ITEM_CNT)
SIF !(LOCAL:0)
	LOCAL:0 ++
CALL LUCID_EV3_STORE_ITEM(ITEM_TYPE,ITEM_LIST:(LOCAL:0 - 1))
ARRAYCOPY "RESULT", "ITEM_TEMP_A"
CALL LUCID_EV3_STORE_ITEM(ITEM_TYPE,ITEM_LIST:(LOCAL:0))
ARRAYCOPY "RESULT", "ITEM_TEMP_B"
LOCAL:1 = 0
SELECTCASE ITEM_TYPE
	CASE "hold", "care"
		IF ITEM_TEMP_A:1 <= ITEM_TEMP_B:1
			LOCAL:1 = 1
		ENDIF
	CASE "underwear"
		IF ITEM_TEMP_A:3 <= ITEM_TEMP_B:3
			LOCAL:1 = 1
		ENDIF
ENDSELECT
; PRINTFORMW LOCAL {LOCAL} (ITEM_TEMP_A:1 {ITEM_TEMP_A:1}) | LOCAL-1 {LOCAL-1} (ITEM_TEMP_B:1 {ITEM_TEMP_B:1})
IF LOCAL:1
	LOCAL:0 ++
ELSE
	SWAP ITEM_LIST:(LOCAL:0 - 1), ITEM_LIST:(LOCAL:0)
	LOCAL:0 --
ENDIF
WEND

@LUCID_EV3_INSULT_THE_PLAYER(victim,insulter,linetype)
#DIM insulter
#DIM victim
#DIM lineType
CALL SET_KOJO_COLOR(insulter) ;custom code
SELECTCASE lineType
	CASE 0
		IF IsPadded(victim)
			PRINTDATAW
				DATAFORM 「%CALLNAME:victim%이(가) 아기처럼 기저귀를 차고 \@ DAILY_Lucid_Stats:1 ? 오줌을 쌌네 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? , 거기다 #  \@\@ DAILY_Lucid_Stats:2 ? 똥까지 쌌네 #  \@!」
				DATAFORM 「작은 현상짱 아기를 봐! 심지어 그걸 싸기도 했어.」
				DATAFORM 「기저귀 채우는 중이야~」
				DATAFORM 「아기 %CALLNAME:victim%는 기저귀를 갈 필요가 있나?」
				DATAFORM 「엄마는 어디로 갔니?」
			ENDDATA
