; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV12 수영장.ERB
;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_12
#FUNCTION
DAILY_Lucid_Name '= "수영장"
DAILY_Lucid_Desc '= "다른 사람들과 공공 수영장에 와 책을 읽던 중, 갑자기 참기 힘든 요의가 몰려왔다.\n 너무 눈에 띄지 않게 볼일을 해결할 방법을 찾아야 한다."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 1
DAILY_Lucid_InterruptCom '= "9357/400/811/405/604"
DAILY_Lucid_EndingAvailable '= "1/2/10/11/12/62"
DAILY_Lucid_CanGiveUp = 0
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_12
#DIM RandomChara
;pool
;holding it increases your knowledge by 1
FOR RandomChara, 0, 7
CALLF TP(DAILY_Lucid_Chara:RandomChara)
TARGET:(RandomChara+1) = DAILY_Lucid_Chara:RandomChara
CFLAG:(DAILY_Lucid_Chara:RandomChara):睡眠 = 0
CFLAG:(DAILY_Lucid_Chara:RandomChara):同室 = 1
TCVAR:(DAILY_Lucid_Chara:RandomChara):906 = 1
CALLF PEEME(DAILY_Lucid_Chara:RandomChara, 0)
CALLF POOME(DAILY_Lucid_Chara:RandomChara, 0)
SKIPDISP 1
CALL ADD_SWIMMING_OUTFIT(DAILY_Lucid_Chara:RandomChara)
NEXT
CALL ADD_SWIMMING_OUTFIT(MASTER)
SKIPDISP 0
TFLAG:104 = DAILY_Lucid_Chara
BASE:MASTER:0 = MAXBASE:MASTER:0
DAILY_Lucid_Stats:7 = RAND:90
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
PRINTFORMDW 공공 수영장에서 기분 좋고 따뜻한 오후를 즐기고 있다.
PRINTFORMDW 한적한 데크에 누워 좋은 책을 읽고 있는데, 갑자기 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ 해야 한다는 것을 깨닫는다.
PRINTL
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_12
;When a command ends

@LUCID_DREAM_TURN_12
IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
	PRINTFORMDW 당신은 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@...에 대한 필요성을 거의 잊을 뻔했다.
	SIF DAILY_Lucid_Stats:1
		CALL PEESOUNDS("hs")
	SIF DAILY_Lucid_Stats:2
		CALL POOSOUNDS("hf")
	PRINTFORMDW 네 사타구니가 갑자기 축축해질 때까지.
	PRINTFORMDW 당신은 비명을 지르며 책을 옆으로 던졌다.
	PRINTFORMDW 당신은 \@ DAILY_Lucid_Stats:1 ? 소변을 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 대변을 #  \@! 지금!
	PRINTFORMDW 당신은 벌떡 일어나 급히 용무를 볼 곳을 찾기 시작했다...
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	PRINTFORMDW 하지만 당신은 수건에서 세 걸음 떨어지기도 전에 통제력을 잃고 사고를 친다.
	PRINTFORMDW 당신의 \@ DAILY_Lucid_Stats:1 ? puddle #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? mess #  \@spreads on the tiles, your accident obvious on your formerly \@ DAILY_Lucid_Stats:1 ? dry #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? clean #  \@했던 수영복 위에 당신의 사고가 명백하다.
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
ELSE
	PRINTFORMD 정말로 화장실 갈 곳을 찾아봐야 할 것 같아.
	SIF (ABL:MASTER:PeeAddict >= 5 && DAILY_Lucid_Stats:1) || (ABL:MASTER:PooAddict >= 5 && DAILY_Lucid_Stats:2)
		PRINTFORMD , 하지만 당신의 완전한 \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 위 #  \@ 정말 기분이 좋다
	PRINTFORMDL .
	PRINTFORMDL 당신은 책에 너무 몰두해서 그것을 내려놓을 수가 없다.
	PRINTFORMDW 분명 조금 더 들고 있을 수 있잖아, 그렇지?	
	EXP:MASTER:学習経験 ++
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_12(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 9357, 400, 811, 405, 604
		PRINTFORML 수건, 변기, 아니면 수영장인가?
		PRINTFORML [0] - 아, 일어날 시간이다...		
		SIF !DAILY_Lucid_Stats:2
			PRINTFORML [1] 수건에 소변을 본다.	
		SIF !DAILY_Lucid_Stats:2
			PRINTFORML [2] - 수영장도 변기로 간주돼, 맞지? 	
		PRINTFORML [9] - 그것을 붙잡을 수 있어
		INPUT
		SELECTCASE RESULT
			CASE 0
				SIF (ABL:MASTER:PeeAddict >= 5 && DAILY_Lucid_Stats:1) || (ABL:MASTER:PooAddict >= 5 && DAILY_Lucid_Stats:2)
					PRINTFORMDW 물론, 당신은 절박해하고 사고를 치는 것을 좋아하지만 한계가 있는 법이야.
				PRINTFORMDW \@ DAILY_Lucid_Stats:1 ? %CAPITALIZE(FSYN("pee:ing"))% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %CAPITALIZE(FSYN("poo:ing"))% #  \@ 스스로 공공장소에서 그러는 것은 확실히 선을 넘었다.
				PRINTFORMDW 짜증 섞인 신음과 함께, 너는 책을 치우고 화장실 쪽으로 발걸음을 옮겼다...
				IF !RAND:2
					PRINTFORMDW 하지만 당신이 수영장 가장자리를 따라 걷고 있을 때...
					PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%가 갑자기 달려와 당신을 차가운 물속으로 밀어 넣는다.
					PRINTFORMDW 당신은 벌떡 깨어나, 더 이상 수영장이 아닌 자신의 침대에 있지만 여전히 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@! 하고 절실해한다.
					DAILY_Lucid_Stats:9 = 62
					CALL LucidDreamTimeUp()
				ELSE
					DAILY_Lucid_Stats:3 = 4
				ENDIF
			CASE 1
				PRINTFORMDW 너 정말 화장실까지 갈 만큼 참을 수 있을 거라고 생각 안 하는구나.
				PRINTFORMDW 그리고 그러지 못하고 있어.
				PRINTFORMDW 하지만 지금 있는 곳에 소변이라도 보면 누가 볼지도 몰라...
				PRINTFORMDW 영감을 받은 순간, 너는 수건을 집어 말아서 %FSYN("crotch")%에 갖다 붙인다.
				PRINTFORMDW 그리고 너무 이른 시각은 아니지만...
				CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
				PRINTFORMDW 수건이 당신에게 따뜻하고 축축하게 느껴질 때쯤, 당신은 겨우 편안함을 느꼈다.		
				DAILY_Lucid_Stats:9 = 2
				CALL LucidDreamTimeUp()
			CASE 2
				PRINTFORMDW 너 정말 화장실에 가봐야 한다는 걸 알고 있어... 
				PRINTFORMDW 하지만 할 수 있을지 확신이 서지 않아, 수영장이 훨씬 가까우니까, 게다가 수영장 화장실은 정말 역겨워.
				PRINTFORMDW 소변은 대부분 물일 뿐이잖아, 맞지?
				PRINTFORMDW 너는 책을 집어넣고 자연스럽게 움직이려 애쓰며 사고가 날 것처럼 보이지 않게 수영장 쪽으로 향한다.
				PRINTFORMDW 발이 차가운 물에 닿았을 때 거의 새버릴 뻔했다.
				CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
				PRINTFORMDW 막 사다에서 내려왔을 때 당신의 %FSYN("crotch")%이 갑자기 따뜻하게 느껴지기 시작하고 주변의 물이 %PEECOLOR(MASTER)%한 빛을 띠었다. 	
				DAILY_Lucid_Stats:9 = 1
				CALL LucidDreamTimeUp()
			CASEELSE
		ENDSELECT
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_12(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		; DAILY_Lucid_ComName '= @"Custom COM"
ENDSELECT
RETURNF DAILY_Lucid_ComName
