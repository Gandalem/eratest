@LUCID_DREAM_INFO_12
#FUNCTION
DAILY_Lucid_Name '= "The Pool"
{
DAILY_Lucid_Desc '= "You're at a public pool with some others reading a book, until a wave of desperation hits you.\n
You need to find a way to relieve yourself that doesn't look too conspicuous."
}
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 1
DAILY_Lucid_InterruptCom '= "9357/400/811/405/604"
DAILY_Lucid_EndingAvailable '= "1/2/10/11/12/62"
DAILY_Lucid_CanGiveUp = 0

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_12
#DIM RandomChara
;pool
;holding it increases your knowledge by 1

FOR RandomChara, 0, 7
	CALLF TP(DAILY_Lucid_Chara:RandomChara)
	TARGET:(RandomChara+1) = DAILY_Lucid_Chara:RandomChara
	CFLAG:(DAILY_Lucid_Chara:RandomChara):睡眠 = 0
	CFLAG:(DAILY_Lucid_Chara:RandomChara):同室 = 1
	TCVAR:(DAILY_Lucid_Chara:RandomChara):906 = 1		
	CALLF PEEME(DAILY_Lucid_Chara:RandomChara, 0)
	CALLF POOME(DAILY_Lucid_Chara:RandomChara, 0)
	SKIPDISP 1
	CALL ADD_SWIMMING_OUTFIT(DAILY_Lucid_Chara:RandomChara)
NEXT
CALL ADD_SWIMMING_OUTFIT(MASTER)
SKIPDISP 0

TFLAG:104 = DAILY_Lucid_Chara

BASE:MASTER:0 = MAXBASE:MASTER:0
DAILY_Lucid_Stats:7 = RAND:90

IF DAILY_Lucid_Stats:1
CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
CALLF POOME(MASTER, 4)
ENDIF	


PRINTFORMDW You're enjoying a nice, warm afternoon at the public pool.
PRINTFORMDW You're lying on a secluded part of the deck and enjoying a good book when you suddenly realize that you really need to \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #\@.
PRINTL

;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_12

;When a command ends
@LUCID_DREAM_TURN_12
IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
PRINTFORMDW You almost manage to forget all about your need to \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #\@...
SIF DAILY_Lucid_Stats:1
CALL PEESOUNDS("hs")
SIF DAILY_Lucid_Stats:2
CALL POOSOUNDS("hf") 
PRINTFORMDW Until your crotch suddenly grows damp.
PRINTFORMDW You yelp and toss your book to the side.
PRINTFORMDW You gotta \@ DAILY_Lucid_Stats:1 ? pee #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? poop #\@! NOW!
PRINTFORMDW You jump up and frantically start looking for a place to relieve yourself...
CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")	
PRINTFORMDW But you barely make it three steps away from your towel until you lose control and have an accident.
PRINTFORMDW Your \@ DAILY_Lucid_Stats:1 ?puddle#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? mess #\@ spreads on the tiles, your accident obvious on your formerly \@ DAILY_Lucid_Stats:1 ?dry#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? clean#\@ swimwear.
DAILY_Lucid_Stats:9 = LucidDreamLoser()
CALL LucidDreamTimeUp()
ELSE
PRINTFORMD You really should go find a place to relieve yourself
SIF (ABL:MASTER:PeeAddict >= 5 && DAILY_Lucid_Stats:1) || (ABL:MASTER:PooAddict >= 5 && DAILY_Lucid_Stats:2)
PRINTFORMD , but your full \@ DAILY_Lucid_Stats:1 ? bladder #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? stomach #\@ feels really good
PRINTFORMDL .
PRINTFORMDL You're too absorbed in your book to put it away.
PRINTFORMDW Surely you can hold it for a bit longer, right?	
EXP:MASTER:学習経験 ++	
ENDIF

;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_12(nInput)
#DIM nInput
SELECTCASE nInput
CASE 9357, 400, 811, 405, 604
	PRINTFORML Towel, toilet, or pool?
	PRINTFORML [0] - Ugh, time to get up...		
	SIF !DAILY_Lucid_Stats:2
	PRINTFORML [1] - Pee into your towel	
	SIF !DAILY_Lucid_Stats:2	
	PRINTFORML [2] - The pool counts as a toilet, right? 	
	PRINTFORML [9] - I can hold it
	INPUT
		SELECTCASE RESULT
		CASE 0
		SIF (ABL:MASTER:PeeAddict >= 5 && DAILY_Lucid_Stats:1) || (ABL:MASTER:PooAddict >= 5 && DAILY_Lucid_Stats:2)
		PRINTFORMDW Sure, you love being desperate and having an accident, but you have your limits.
		PRINTFORMDW \@ DAILY_Lucid_Stats:1 ? %CAPITALIZE(FSYN("pee:ing"))% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %CAPITALIZE(FSYN("poo:ing"))% #\@ yourself in public is definitely a step too far.
		PRINTFORMDW With an annoyed groan, you put your book away and shuffle off towards the toilets...
		IF !RAND:2
		PRINTFORMDW But as you're walking along the edge of the pool...
		PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara% suddenly runs into you and knocks you into the cold water.
		PRINTFORMDW You snap awake, suddenly no longer at the pool but in your own bed... and still desperate to \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #\@!
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
		ELSE
		DAILY_Lucid_Stats:3 = 4
		ENDIF
		CASE 1
		PRINTFORMDW You really don't think you can hold it for long enough to make it to the toilets even if you wanted to
		PRINTFORMDW And you don't.
		PRINTFORMDW But if you just pee where you are, somebody might see you...
		PRINTFORMDW In a moment of inspiration, you grab your towel, roll it up, and place it against your %FSYN("crotch")%.
		PRINTFORMDW And not a moment too soon...
		CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")	
		PRINTFORMDW You've barely gotten comfortable by the time you feel the towel grow warm and wet against you.		
		DAILY_Lucid_Stats:9 = 2
		CALL LucidDreamTimeUp()
		CASE 2
		PRINTFORMDW You know you really should try to make it to the toilet... 
		PRINTFORMDW But you're not sure you CAN, the pool is a lot closer, and the pool toilets are really gross, anyway.
		PRINTFORMDW Pee is mostly just water anyway, right?
		PRINTFORMDW You put your book away and make your way over to the pool, trying hard to move naturally and not like you're about to have an accident.
		PRINTFORMDW You almost leak when your feet touch the cold water.
		CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")	
		PRINTFORMDW You're barely off the ladder when your %FSYN("crotch")% suddenly starts feeling warm as the water around you takes on a %PEECOLOR(MASTER)% tint. 	
		DAILY_Lucid_Stats:9 = 1
		CALL LucidDreamTimeUp()
		CASEELSE
		ENDSELECT
ENDSELECT

