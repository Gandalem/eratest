;----------------------------
;Info for the dream
;----------------------------
@LUCID_DREAM_INFO_1
#FUNCTION
DAILY_Lucid_Name '= "Far Away Toilet"
DAILY_Lucid_Desc '= "You are sitting at the bottom of the stairs trying to get to a toilet."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
;DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/12/20/22/62"
DAILY_Lucid_CanGiveUp = 1

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_1
DAILY_Lucid_Stats:7 = RAND:100
BASE:MASTER:0 = MAXBASE:MASTER:0
IF DAILY_Lucid_Stats:1
CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
CALLF POOME(MASTER, 4)
ENDIF	

PRINTFORMDW You are sitting at the bottom of a colossal set of stairs with a \@ DAILY_Lucid_Stats:1 ?bursting bladder#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? aching bowels#\@.
PRINTFORMDW At the top, you can see a gloriously ornamented toilet.

;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_1
IF DAILY_Lucid_Stats:7 <= 0
	PRINTFORMDW But just when you are about to give up, you see the toilet standing right in front of you.
	CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
	IF RESULT <= 0
		DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
		RETURN
	ENDIF
	PRINTFORMDW As you sigh in relief, a kind warm light engulfs you while a warm feeling spreads through your %FSYN("crotch")%.
	DAILY_Lucid_Stats:9 = 1
ELSEIF PeeBarStage(MASTER) >= 7 || PooBarStage(MASTER) >= 7
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")	
	PRINTFORMDW You don't even notice the warmth spreading on your %PeeProtectType(MASTER,1)% until it's too late...
	PRINTFORMDW Now, it's your %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2, "bladder", "bowels")% that \@ DAILY_Lucid_Stats:2 ? feel # feels\@ completely empty.
	PRINTFORMDW Your face grows red as the world around you slowly vanishes.
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
ENDIF

;When a command ends
@LUCID_DREAM_TURN_1
IF DAILY_Lucid_Stats:7 <= 0 || PeeBarStage(MASTER) >= 7 || PooBarStage(MASTER) >= 7
	CALL LucidDreamTimeUp()
ENDIF

;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_1(nInput)
#DIM nInput
SELECTCASE nInput
CASE 0
	PRINTFORMDW As you steal your resolve, you start climbing the stairs.
	PRINTFORMDW The climb feels like eternity as each step brings anguish to your %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"bladder","colon")%.
	BASE:MASTER:0 -= 50
	BASE:MASTER:尿意 += RAND:75
	BASE:MASTER:Poo += RAND:75
	PeeHoldExp:MASTER:0 += 2
	DAILY_Lucid_Stats:7 -= 5
CASE 8
	PRINTFORMDW You sit at the bottom of the stairs waiting for anything to change.
	PRINTFORMDW Soon, your mind is completely empty and you stop caring about anything happing around you.
	BASE:MASTER:尿意 += RAND:75
	BASE:MASTER:Poo += RAND:75
CASE 9
	PRINTFORMDW The toilet is too far away.
	PRINTFORMDW There is no way you'll reach it in time.
	IF !RAND:5
		PRINTFORMDW But as you desperately look for another way, you notice a door behind you.
		PRINTFORMDW You open the door and a bright, gentle light washes over your body.
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
	ELSE
	PRINTFORMDW You don't find anything....
	BASE:MASTER:尿意 += RAND:75
	BASE:MASTER:Poo += RAND:75
	ENDIF
ENDSELECT

;----------------------------
;Input names
;----------------------------
@LUCID_DREAM_INPUT_NAMES_1(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
CASE 0
	DAILY_Lucid_ComName '= "Reach that toilet!"
CASE 8
	DAILY_Lucid_ComName '= "Wait for something to happen"
CASE 9
	DAILY_Lucid_ComName '= "Look for another way"
ENDSELECT
RETURNF DAILY_Lucid_ComName

;----------------------------
;Status page for Carry Status
;----------------------------
@LUCID_DREAM_INPUT_STATUS_1
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"Stairs until end: {DAILY_Lucid_Stats:7}"
RETURNF DAILY_Lucid_InfoTab