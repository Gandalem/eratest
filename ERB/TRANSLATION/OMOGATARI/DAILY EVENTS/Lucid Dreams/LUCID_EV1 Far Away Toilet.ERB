; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV1 Far Away Toilet.ERB
;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_1
#FUNCTION
DAILY_Lucid_Name '= "Far Away Toilet"
DAILY_Lucid_Desc '= "You are sitting at the bottom of the stairs trying to get to a toilet."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
;DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/12/20/22/62"
DAILY_Lucid_CanGiveUp = 1
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_1
DAILY_Lucid_Stats:7 = RAND:100
BASE:MASTER:0 = MAXBASE:MASTER:0
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
PRINTFORMDW 너는 거대한 계단 맨 아래에 앉아 있으며 \@ DAILY_Lucid_Stats:1 ? 방광이 터질 듯하고 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 장장이 아프다 #  \@.
PRINTFORMDW 위쪽에는 화려하게 장식된 변기가 보였다.
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_1
IF DAILY_Lucid_Stats:7 <= 0
	PRINTFORMDW 하지만 막 포기하려는 순간, 당신은 바로 앞에 서 있는 변기를 본다.
	CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
	IF RESULT <= 0
		DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
		RETURN
	ENDIF
	PRINTFORMDW 당신이 안도의 한숨을 내쉬자, 따뜻한 온기가 당신의 %FSYN("crotch")%를 감싸며 따뜻한 기운이 퍼진다.
	DAILY_Lucid_Stats:9 = 1
ELSEIF PeeBarStage(MASTER) >= 7 || PooBarStage(MASTER) >= 7
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	PRINTFORMDW %PeeProtectType(MASTER,1)%에 퍼지는 온기를 너무 늦게 알아차렸다...
	PRINTFORMDW 지금은 당신의 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2, "bladder", "bowels")%가 \@ DAILY_Lucid_Stats:2 ? 느껴 # 느낀다 \@ 완전히 비었다고.
	PRINTFORMDW 주변 세상이 천천히 사라지면서 당신의 얼굴이 붉어졌다.
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
ENDIF
;When a command ends

@LUCID_DREAM_TURN_1
IF DAILY_Lucid_Stats:7 <= 0 || PeeBarStage(MASTER) >= 7 || PooBarStage(MASTER) >= 7
	CALL LucidDreamTimeUp()
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_1(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		PRINTFORMDW 네 결심을 훔치자, 계단을 오르기 시작한다.
		PRINTFORMDW 그 오름은 영원처럼 느껴졌고, 각 발걸음은 당신의 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"bladder","colon")%에 고통을 안겼다.
		BASE:MASTER:0 -= 50
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		PeeHoldExp:MASTER:0 += 2
		DAILY_Lucid_Stats:7 -= 5
	CASE 8
		PRINTFORMDW 당신은 변화가 생기길 기다리며 계단 아래에 앉아 있다.
		PRINTFORMDW 곧 당신의 정신은 완전히 비게 되고 주위에 일어나는 어떤 일에도 신경 쓰지 않게 된다.
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
	CASE 9
		PRINTFORMDW 변기가 너무 멀다.
		PRINTFORMDW 제때 도달할 방법이 없다.
		IF !RAND:5
			PRINTFORMDW 하지만 당신이 필사적으로 다른 방법을 찾을 때, 당신은 뒤에 있는 문을 알아차린다.
			PRINTFORMDW 당신은 문을 열고 밝고 부드러운 빛이 당신의 몸 위로 쏟아진다.
			DAILY_Lucid_Stats:9 = 62
			CALL LucidDreamTimeUp()
		ELSE
			PRINTFORMDW 아무것도 찾지 못한다....
			BASE:MASTER:尿意 += RAND:75
			BASE:MASTER:Poo += RAND:75
		ENDIF
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_1(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		DAILY_Lucid_ComName '= "Reach that toilet!"
	CASE 8
		DAILY_Lucid_ComName '= "Wait for something to happen"
	CASE 9
		DAILY_Lucid_ComName '= "Look for another way"
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
;Status page for Carry Status
;----------------------------

@LUCID_DREAM_INPUT_STATUS_1
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"끝까지 계단: {DAILY_Lucid_Stats:7}"
RETURNF DAILY_Lucid_InfoTab
