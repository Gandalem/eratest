		CALL PRINT_GP("W", @"당신의 소변은 찾을 수 있는 모든 틈을 채우고, 그 액체는 %PeeProtectType(MASTER,2)%의 패딩 속으로 흡수된다.")
		CALL PRINT_GP("W", @"당신이 감당할 수 없는 쾌감으로 가득 차서 소변을 지릴 때 이해할 수 없는 비명이 새어 나온다.")
		CALL PRINT_GP("W", @"기쁨이 계속해서 밀려오면서 기저귀가 빠르게 부풀어 오고 있다는 것을 느낀다.")
		CALL PRINT_GP("W", @"방광의 내용을 완전히 비우는 데는 1분 이상이 걸리고, 결국 기저귀가 세 배로 커져 물웅덩이가 된 듯한 느낌을 받는다.")
		DAILY_Lucid_Stats:9 = 20+1-isGenuine
	ELSE
		IF IsPadded(MASTER)
			CALL PRINT_GP("W", @"당신의 소변은 찾을 수 있는 모든 틈새를 채우고, 그 액체는 %PeeProtectType(MASTER,2)%의 패딩 안으로 흡수된다.")
			CALL PRINT_GP("W", @"부인할 수 없는 쾌감으로 가득 차면서 당신이 실수를 하자 이해할 수 없는 비명이 새어 나왔다.")
			CALL PRINT_GP("W", @"기쁨이 계속 밀려오자, 당신은 기저귀가 빠르게 부풀어 오르고 커지는 것을 느낀다.")
			CALL PRINT_GP("W", @"흐름이 당신의 %PeeProtectType(MASTER,2)%에게 너무 많아지면서 소변이 기저귀에서 새어 나와 \@ DAILY_Lucid_Stats:6 ? 패드 # 침대 \@에 떨어진다.")
			CALL PRINT_GP("W", @"방광과 장의 내용물을 완전히 비우는 데는 1분 이상 걸리며, 마지막에는 기저귀와 침대를 적신 듯하고 지금은 노란빛을 띤다.")
		ELSE
			CALL PRINT_GP("W", @"당신의 소변이 흘러나와 \@ DAILY_Lucid_Stats:6 ? 패드 # 침대에 직접 스며든다 \@.")
			CALL PRINT_GP("W", @"부인할 수 없는 쾌감으로 가득 찬 채 당신이 소변을 지르자 이해할 수 없는 비명이 새어 나왔다.")
			CALL PRINT_GP("W", @"기쁨이 계속 밀려오면서 침대가 빠르게 더 축축해지는 것을 느낀다.")
			CALL PRINT_GP("W", @"당신의 온몸이 오줌에 흠뻑 젖고, 옷 뒷부분과 침대가 같은 운명을 맞는다.")
			CALL PRINT_GP("W", @"방광의 내용물을 완전히 비우는 데는 1분 이상 걸리고, 결국 침대를 망친 것 같은 느낌이 들며, 이제 노란빛을 띤다.")
		ENDIF
		DAILY_Lucid_Stats:9 = 10+1-isGenuine
	ENDIF
ENDIF
