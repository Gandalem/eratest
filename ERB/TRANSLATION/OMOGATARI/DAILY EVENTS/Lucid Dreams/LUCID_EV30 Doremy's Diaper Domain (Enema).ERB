		CALL PRINT_GP("W", @"당신의 근육이 갑자기 이완되며 등은 아치형으로 휘고 몸을 가득 채우는 쾌감과 함께 %PeeProtectType(MASTER,2)% 안에서 격렬하게 소변을 보기 시작한다.")
	ELSE
		CALL PRINT_GP("W", @"정말 한계에 다다른 기분이야. 그냥 여기서 끝내고 싶을 뿐이야.")
		CALL PRINT_GP("W", @"당신은 자존심을 삼키고 눈을 감은 뒤 방광 근육을 누르기 시작한다.")
		CALL PRINT_GP("W", @"당신의 근육이 이완되면서 %PeeProtectType(MASTER,2)% 안에서 격렬하게 소변을 보기 시작하고, 등은 아치형으로 휘어지며 몸이 쾌감으로 채워진다.")
	ENDIF
	CALL PRINT_GP("W", @"공허 전체에 북소리가 울려 퍼지고, 당신의 배뇨가 즉시 눈에 띄었다.")
