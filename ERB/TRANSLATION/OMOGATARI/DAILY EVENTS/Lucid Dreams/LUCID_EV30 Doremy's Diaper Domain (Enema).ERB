			CALL PRINT_GP("W", @"방광과 장의 내용물을 완전히 비우는 데 1분 이상 걸리고, 결국 기저귀와 침대를 망친 듯한 느낌이 들며, 이제 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"yellow","brown")% 색깔이다.")
		ELSE
			CALL PRINT_GP("W", @"단단한 배설물이 찾을 수 있는 모든 틈을 채우고, 당신의 팬티에는 이제 눈에 보이는 볼록함이 생겼다.")
			CALL PRINT_GP("W", @"액체 덩어리가 흘러나와 \@ DAILY_Lucid_Stats:6 ? 패드 # 침대 \@에 직접 스며든다.")
			SIF DAILY_Lucid_Stats:1
				CALL PRINT_GP("W", @"시련 속에서 방광도 터져 나와 무거운 물줄기가 \@ DAILY_Lucid_Stats:6 ? 패드에 스며든다 # 침대에 스며든다 \@ 그보다 더 많이.")
			CALL PRINT_GP("W", @"무게가 팬티에 너무 많이 실려서, 변이 속옷에서 흘러 나와 침대에 떨어진다.")
			CALL PRINT_GP("W", @"당신이 부정할 수 없는 쾌감으로 가득 찬 채 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"pee","poop")% 하면서 이해할 수 없는 비명을 새어낸다.")
			CALL PRINT_GP("W", @"방광과 장의 내용물을 완전히 비우는 데 1분 이상 걸리며, 마지막에는 침대를 망친 것 같은 느낌이 들고 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"yellow","brown")% 색조가 난다.")
		ENDIF
		DAILY_Lucid_Stats:9 = 10+1-isGenuine
	ENDIF
ELSE
	CALLF Peeme(MASTER)
	BASE:MASTER:4 += 1500
	IF isGenuine
		CALL PRINT_GP("W", @"방광 근육이 약해지고, 또 약해지다가 결국 더 이상 참을 수 없게 된다.")
