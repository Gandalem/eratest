; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV30 도레미의 기저귀 왕국(관장).ERB
;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
;Normal
;Nightmare
;Sex
;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------

@LUCID_DREAM_INFO_30
#FUNCTION
DAILY_Lucid_Name '= "도레미의 기저귀 왕국(관장)"
DAILY_Lucid_Desc '= @"작업 중\n 당신은 침대에 묶인 채 잠에서 깨어난다. 다리는 축 늘어져 있고 사타구니는 완전히 노출된 상태다.\n 익숙한 패딩 감촉이 가랑이를 덮고 있다. 기저귀, 놀랍게도\n 주변의 다른 요소들은 관에 연결된 IV 생리식 수액 백과 %CALLNAME:109%뿐이다.\n 이것은 지저분하게 끝날 것이다."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 0
DAILY_Lucid_CanDo = (DAILY_Lucid_Stats:1 || DAILY_Lucid_Stats:2) && nOmutsu && LUCID_EV24_TIMES_SHAT_SELF
DAILY_Lucid_InterruptCom '= "9357/400/405/811/"
DAILY_Lucid_EndingAvailable '= "10/"
DAILY_Lucid_CanGiveUp = 1
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_30
;second message initalizes so that you can change stuff in the debug console
CALL PRINT_GP("W", @"당신은 공허를 바라보며 눈을 뜬다. 어둠이 당신의 눈을 둘렀다.")
;initalize shits
IF nOmutsu
	IF FIRSTTIME("LUCID_EV30_FIRST_TIME_OMU", 1)
		;ALWAYS a dai-diaper
		;ALWAYS a dual accident
		DAILY_Lucid_Stats:1 = Can_Accident(MASTER,1)
		DAILY_Lucid_Stats:2 = Can_Accident(MASTER,2)
		CALLF PANTY_REWORK_CHANGE(MASTER,104,0)
	ELSE
		IF RAND(100) < 80
			;different omutsu time!
			SELECTCASE RAND:5
				CASE 1
					;panman
					CALLF PANTY_REWORK_CHANGE(MASTER,172,0)
				CASE 2
					;comfidry GN
					CALLF PANTY_REWORK_CHANGE(MASTER,102,0)
				CASE 3
					;printy-ups+
					CALLF PANTY_REWORK_CHANGE(MASTER,164,0)
				CASEELSE
					;dai-diaper
					CALLF PANTY_REWORK_CHANGE(MASTER,104,0)
			ENDSELECT
		ELSE
			CALLF PANTY_REWORK_CHANGE(MASTER,19,0)
		ENDIF
	ENDIF
ELSE
	CALLF PANTY_REWORK_CHANGE(MASTER,19,0)
ENDIF
IF FIRSTTIME("LUCID_EV30_FIRST_TIME_PAN", 1)
	DAILY_Lucid_Stats:6 = 1
ELSE
	DAILY_Lucid_Stats:6 = RAND(100) < 60
ENDIF
SIF FIRSTTIME("LUCID_EV30_FIRST_TIME_OMU", 1)
	DAILY_Lucid_Stats:6 = 0
IF LUCID_EV24_TIMES_APHEDRON
	;pacifier if you attempted to use aphedron
	EQUIP:MASTER:RestrainMouth = RAND(0,100) < 75 ? 1 # 0
ENDIF
CALL PRINT_GP("W", @"아래를 내려 자신이 아직 살아있는지 확인하려 하자, 다리가 위로 축 늘어져 넓게 벌어진 채 매달려 있는 것을 발견한다.")
CALL PRINT_GP("W", @"손을 움직이려 하지만, 그 손은 프레임에 묶여 있다.")
SELECTCASE EQUIP:MASTER:6
	CASE 19
		CALL PRINT_GP("W", @"계속 아래를 내려다보니 평범한 팬티를 입고 있다는 것을 알게 된다.")
	CASE 102
		CALL PRINT_GP("W", @"계속 아래를 내려다보자 당신의 가랑이 주변에 두꺼운 기저귀가 보였다.")
	CASE 104
		CALL PRINT_GP("W", @"계속 아래를 내려다보자, 허벅지 주변에 두툼한 프린트 기저귀가 보였고, 테이프와 패딩이 몸을 잘 감싸고 있었다.")
	CASE 164
		CALL PRINT_GP("W", @"계속 아래를 내려다보자, 허벅지 주변에 두꺼운 프린트된 기저귀가 보인다.")
	CASE 174
		CALL PRINT_GP("W", @"계속 아래를 내려다보자, 가랑이 근처에 얇은 프린트된 풀업을 발견한다.")
ENDSELECT
SIF EQUIP:MASTER:RestrainMouth
	CALL PRINT_GP("W", @"젖꼭지가 입을 막아 말하는 것을 방해한다.")
SIF DAILY_Lucid_Stats:6
	CALL PRINT_GP("W", @"하얀 일회용 패드가 당신의 엉덩이가 놓인 침대 바닥을 덮고 있다.")
CALL PRINT_GP("W", @"주변을 좀 더 둘러보니, 밸브와 튜브가 달린 수액 주머니가 걸려 있는 것이 보인다.")
CALL PRINT_GP("W", @"당신은 다시 도레미의 기저귀 영역으로 돌아왔고, 이곳에서 있었던 사고 중 하나의 기억이 머릿속에서 재생되기 시작한다.")
PRINTL
CALL PRINT_GP("W", @"%CALLNAME:109%가 당신에게 다가와 당신의 성기 부위를 가볍게 때리며 뒤로 끌어당긴다.")
CALL PRINT_GP("W", @"꽤 아프고, 작게 신음소리를 내게 한다.")
CALL PRINT_GP("W", @"그러면 %HE_SHE(109)%은 당신의 성기 부위를 문지르기 시작하고, 약간의 쾌감이 쌓이기 시작한다.")
CALL PRINT_GPC("L", @"「작은 \@ DAILY_Lucid_Stats:2 ? 침잠자 # 소변가 \@ %CALLNAME:MASTER%?」", 109)
CALL PRINT_GPC("L", @"「아직도 네... 치정적인 쾌감을 회상하고 있나?」", 109)
CALL PRINT_GP("W", @"%HE_SHE(109,1)%은 당신의 사타구니에서 손을 놓고 호스를 잡는다 / %HE_SHE(109)%가 침대에 앉을 때.")
CALL PRINT_GP("W", @"%HIS_HER(109)%의 손으로 튜브를 곧게 펴면서, %HE_SHE(109)%은 장난기 가득한 미소를 지으며 당신을 바라본다.")
IF !FIRSTTIME("LUCID_EV30_FIRST_TIME", 1)
	CALL PRINT_GPC("L", @"「음, 내가 뭘 할 건지 알겠지.」", 109)
	CALL PRINT_GPC("L", @"「당신은 부끄러움을 느낄지도 모르지만.... 하지만 비밀스럽게 당신의 몸은 그것을 갈망해왔다.」", 109)
	PRINTL
	CALL PRINT_GP("W", @"%CALLNAME:109%는 윤활제를 한 병 집어 그리고 튜브 끝에 윤활제를 바르기 시작하며 주변으로 퍼뜨린다.")
	CALL PRINT_GPC("L", @"「\@ DAILY_Lucid_Stats:2 ? 침대괴물 # 소변가드 \@~」", 109)
ELSE
	CALL PRINT_GPC("L", @"「너는 좀 나빴어 %PRINT_MALE("boy",MASTER)%...」", 109)
	CALL PRINT_GP("W", @"%HIS_HER(109,1)%의 손이 당신의 사타구니 쪽으로 돌아가 그것을 좀 더 문지른다.")
	CALL PRINT_GPC("L", @"「네 치정스러운 쾌감을 인정하는 거야~」", 109)
	PRINTL
	CALL PRINT_GP("W", @"%CALLNAME:109%는 윤활유 병을 집어 튜브 끝에 윤활유를 바르기 시작하며 주변으로 펴 바른다.")
	CALL PRINT_GPC("L", @"「걱정 마. 내가 그냥 너에게 좀 더 줄게~」", 109)
ENDIF
CALL PRINT_GP("W", @"%HE_SHE(109,1)%은 당신의 %PeeProtectType(MASTER,2)% 옆쪽을 치우고 \@ DAILY_Lucid_Stats:2 ? 항문 # 요도를 드러내며 \@, 그리고 관을 최대한 깊숙이 부드럽게 삽입했다.")
CALL PRINT_GP("W", @"당신의 숨이 빨라지고, 얼굴이 붉어지기 시작한다.")
CALL PRINT_GPC("L", @"「준비됐어?」", 109)
SIF EQUIP:MASTER:RestrainMouth
	CALL PRINT_GP("W", @"%CALLNAME:109%는 네 입에서 공갈을 조심스럽게 빼내어 말을 할 수 있게 해준다.")
CALL PRINT_GP("W", @"실제로 무슨 일이 일어나고 있는지 깨닫기 전에 단단한 \"네.\" 입에서 터져 나온다.")
SIF EQUIP:MASTER:RestrainMouth
	CALL PRINT_GP("W", @"당신의 공갈젖꼭지는 곧바로 다시 입안에 놓인다.")
PRINTL
CALL PRINT_GP("W", @"%CALLNAME:109%는 앞으로 몸을 숙이고 밸브를 열림 위치로 돌린다.")
CALL PRINT_GP("W", @"액체는 파이프에서부터 관을 거쳐 당신의 \@ DAILY_Lucid_Stats:2 ? 직장 # 방광에 흘러 들어가기 시작했다. \@")
CALL PRINT_GP("W", @"이것은 관이다. 그리고 당신의 \@ DAILY_Lucid_Stats:2 ? 직장 # 방광 \@이 액체가 차면서 부풀어 오르기 시작한다.")
CALL PRINT_GP("W", @"가벼운 신음이 당신의 입에서 새어 나오고, 당신은 주입구가 비워지는 것을 보며 %CALLNAME:109%가 튜브를 지탱하는 모습을 본다.")
PRINTL
CALL PRINT_GPC("L", @"「어때, 기분이?」", 109)
CALL PRINT_GP("W", @"당신이 동원할 수 있는 것은 가방 안의 물이 차갑다는 것이다.")
CALL PRINT_GP("W", @"곧 그 체액은 당신의 \@ DAILY_Lucid_Stats:2 ? 직장 # 방광 \@ 감당하기에 너무 많아지고, 익숙한 절망감을 느끼기 시작한다.")
CALL PRINT_GPC("L", @"「됐다.」", 109)
CALL PRINT_GP("W", @"더욱 유동적인 것이 당신의 \@ DAILY_Lucid_Stats:2 ? 장 안으로 들어간다 # 요도관으로 들어간다 \@, 그것을 참기가 더 어려워진다.")
CALL PRINT_GPC("L", @"「거의 다 됐어.」", 109)
CALL PRINT_GP("W", @"결국 모든 액체는 가방에서 당신의 \@ DAILY_Lucid_Stats:2 ? 장으로 이동한다 # 소변을 담는 곳에 이동한다 \@.")
CALL PRINT_GP("W", @"%CALLNAME:109%은 흐름을 끊는다, 왜냐하면 %HE_SHE(109)%이 이제 빈 가방을 느꼈기 때문이다.")
CALL PRINT_GPC("L", @"「오우 예, 그게 다야.」", 109)
CALL PRINT_GP("W", @"튜브는 당신의 \@ DAILY_Lucid_Stats:2 ? 항문 # 요도에 부드럽게 빠져나오고 \@, 그리고 당신의 %PeeProtectType(MASTER,2)%가 다시 놓인다.")
PRINTL
CALL PRINT_GPC("L", @"「얼마나 오래 견딜 수 있는지 보자고, 응?」", 109)
CALL PRINT_GPC("L", @"「원한다면 지금 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2, "pee","poop")% 해도 되지만, 그건 재미가 없어.」", 109)
IF DAILY_Lucid_Stats:2
	CALLF Poome(MASTER,5)
ELSEIF DAILY_Lucid_Stats:1
	CALLF Peeme(MASTER,5)
ENDIF
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_30
SELECTCASE DAILY_Lucid_Stats:9
	CASE 10
		IF DAILY_Lucid_Stats:2
			CALL PRINT_GPC("L", @"「너 정말 아주 지저분한 %PRINT_MALE("boy",MASTER)%구나, 응?」", 109)
			CALL PRINT_GPC("L", @"「이미 모든 것을 다 털어냈지만, 당신의 얼굴은 더 쏟아내고 싶다고 말하고 있다.」", 109)
			PRINTL
			CALL PRINT_GP("W", @"%CALLNAME:109%이 당신의 벗겨진 팬티 뒷부분을 볼 때, %HIS_HER(109)%은 침대 위의 갈색 얼룩과 변에 할 말을 잃는다.")
			IF DAILY_Lucid_Stats:6
				CALL PRINT_GPC("L", @"「네 기저귀 패드는 진한 갈색으로 흠뻑 젖었고 네 변으로 가득하구나. 분명 필요했을 거야.」", 109)
			ELSE
				CALL PRINT_GPC("L", @"「너 정말 심하게 사고 쳤구나, 매트리스에서 네 실수 냄새가 나.」", 109)
			ENDIF
			CALL PRINT_GP("W", @"아주 큰 사고에 만족하며, %CALLNAME:109% 주변의 내용물을 %HIS_HER(109)% 손으로 부순다.")
			CALL PRINT_GPC("L", @"「너 팬티를 기저귀처럼 취급했지 않니? 느낌도, 냄새도 똑같아.」", 109)
			CALL PRINT_GPC("L", @"「나 분수 마시기 전에 너도 화장실 가야 했잖아, 맞지?」", 109)
			CALL PRINT_GPC("W", @"「이것을 한동안 즐길 수 있을 것 같아.」", 109)
			PRINTL
			CALL PRINT_GP("L", @"%HES_SHES(109,1)%은 맞다, 상당히 고급스럽게 느껴진다.")
			CALL PRINT_GP("W", @"당신이 여운을 만끽하는 동안, 성기 주변의 따뜻하고 지독한 내용물이 마사지된다.")
			CALL PRINT_GPC("W", @"「꿈속에서 스스로 「젖는다/더럽힌다 %PeeAndPoo(DAILY_Lucid_Stats:1, DAILY_Lucid_Stats:2, "wet", "mess")%」는 기분이 드나요?」", 109)
			CALL PRINT_GPC("W", @"「더 좋은 건 당신의 사고가 당신의 \@ HAS_PENIS(MASTER) ? 작은 소변구 # 웃긴 음부 \@에 스칠 때다.」", 109)
			CALL PRINT_GP("W", @"꽤 많은 마사지 끝에 눈이 무거워지며 잠을 청하도록 유혹한다.")
			CALL PRINT_GP("W", @"당신의 배설물 패니트들의 취할 듯한 냄새와 축축함과 따뜻함, 침대의 안락함, 스스로 대변을 참으려는 고군분투, 그리고 방금 온 그 모든 것들이 깨어있는 것을 불가능하게 만든다.")
			CALL PRINT_GP("W", @"눈이 천천히 감기지만 장난기 어린 미소는 여전히 얼굴에 남아 있었다.")
			CALL PRINT_GPC("W", @"「안녕 %CALLNAME:MASTER%. 너의 치정스러운 ...재능이.... 연료가 되기를....」", 109)
		ELSE
			CALL PRINT_GPC("L", @"「너는 정말 아주 나쁜 축축한 %PRINT_MALE("boy",MASTER)%이구나, 응?」", 109)
			CALL PRINT_GPC("L", @"「이미 모든 것을 다 털어냈지만, 당신의 얼굴은 더 쏟아내고 싶다고 말하고 있다.」", 109)
			PRINTL
			CALL PRINT_GP("W", @"%CALLNAME:109%이/가 당신이 만든 물웅덩이를 바라볼 때, %HIS_HER(109)%의 턱은 그것이 얼마나 큰지에 놀라 떨어진다.")
			IF DAILY_Lucid_Stats:6
				CALL PRINT_GPC("L", @"「네 기저귀가 완전히 젖었어! 온통 노랗고 축축하네. 분명 필요했겠구나.」", 109)
			ELSE
				CALL PRINT_GPC("L", @"「너 정말 침대를 물웅덩이로 만들어놨구나, 매트리스에서 네 사고 냄새까지 나.」", 109)
			ENDIF
			CALL PRINT_GP("W", @"당신의 아주 큰 사고에 만족하며, %CALLNAME:109%은 축축한 %PRINT_CLIT(MASTER)%를 %HIS_HER(109)% 손으로 만진다.")
			CALL PRINT_GPC("L", @"「너 팬티를 기저귀처럼 취급했지? 냄새도 기저귀 같아.」", 109)
			CALL PRINT_GPC("L", @"「나 분수 마시기 전에 너도 화장실 가야 했잖아, 맞지?」", 109)
			CALL PRINT_GPC("W", @"「이것을 한동안 즐길 수 있을 것 같아.」", 109)
			PRINTL
			CALL PRINT_GP("W", @"%CALLNAME:109%은(는) 당신의 축축한 사타구니를 느끼지만, 더 이상 따뜻하지 않고 차갑기만 한 것을 알게 된다.")
			CALL PRINT_GPC("L", @"「슬퍼지고 있니? 네 사고는 냉각되었니?」", 109)
			CALL PRINT_GPC("L", @"「걱정 마, 내가 다시 따뜻하게 해 줄게.」", 109)
			CALL PRINT_GP("W", @"%HE_SHE(109,1)%이 당신의 젖은 침대에 올라와서 %HIS_HER(109)%의 사타구니를 당신에게 바짝 밀착시킨다.")
			CALL PRINT_GP("W", @"%HIS_HER(109,1)%의 눈이 감기고, %HE_SHE(109)%는 떨리기 시작한다. 그러자 익숙한 소변 보는 소리가 다시 들린다.")
			IF DAILY_Lucid_Stats:6
				CALL PRINT_GP("W", @"소변이 흘러 나머지 패드 전체를 %HIS_HER(102)%의 사고로 적시고, 신선한 소변 냄새로 감각을 더욱 가득 채운다.")
			ELSE
				CALL PRINT_GP("W", @"소변이 침대 시트와 매트리스의 나머지 부분을 %HIS_HER(102)% 사고로 적시고, 신선한 오줌 냄새로 감각을 더욱 범람시킨다.")
			ENDIF
			CALL PRINT_GP("W", @"당신의 옷은 흠뻑 젖고, 온몸이 서서히 더럽게 느껴진다.")
