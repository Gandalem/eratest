@LUCID_DREAM_INFO_17
#FUNCTION
DAILY_Lucid_Name '= "Potty Monster"
DAILY_Lucid_Desc '= "You go to the bathroom and use the toilet, but a potty monster pops out!"
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "21/61/62"
DAILY_Lucid_CanGiveUp = 2
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_17
FORCEWAIT
SIF DAILY_Lucid_Stats:1
	CALLF PeeMe(MASTER,4)
SIF DAILY_Lucid_Stats:2
	CALLF PooMe(MASTER,4)
CALL POTTY_MONSTER_ENCOUNTER(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2)
$PottyingMonsterResult
SELECTCASE RESULT
	CASE -2, -99
		DAILY_Lucid_Stats:9 = LucidDreamLoser()
		CALL LucidDreamTimeUp()
	CASE -3
		BASE:MASTER:4 = 0
		GOTO TOILETING
	CASE -4
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
	CASEELSE
		$TOILETING
		CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
		IF RESULT <= 0
			CALL COLORMESSAGE(@"패배자!",C_RED,2,1)
			DAILY_Lucid_Stats:9 = LucidDreamLoser()
			CALL LucidDreamTimeUp()
		ENDIF
		DAILY_Lucid_Stats:9 = 1
		CALL LucidDreamTimeUp()
ENDSELECT
