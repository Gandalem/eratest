; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV11 Watching Marathon.ERB
;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
;Normal
;Nightmare
;Sex
;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------

@LUCID_DREAM_INFO_11
#FUNCTION
DAILY_Lucid_Name '= "Watching Marathon"
DAILY_Lucid_Desc '= "A longer description of the dream"
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/12/20/22/62"
DAILY_Lucid_CanGiveUp = 2
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_11
PRINTFORMDW 당신은 온전히 하루를 가졌고 그것을 유용하게 쓸 계획이다!
PRINTFORMDW 하루 종일 물과 커피만 마시며 소파 위에서 새 쇼를 보며 몸을 뒤틀었다.
PRINTFORMDW 재미있었지만, 이제는 도저히 견딜 수 없을 정도로 심해져서 가야 한다.
PRINTFORMDW 무엇을 하든 당신의 \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@ 결정할 것이다. 
DAILY_Lucid_Stats:10 = 0
DAILY_Lucid_Stats:7 = 120
BASE:MASTER:0 = MAXBASE:MASTER:0
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_11
IF DAILY_Lucid_Stats:9 == 1
	SIF DAILY_Lucid_Stats:1
		CALL PEESOUNDS("s")
	CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,2)
	IF RESULT <= 0
		PRINTFORMDW 하지만 그게 사실 좀 멋지긴 하네.
		PRINTFORMDW 이상하게 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% #  \@는 식지 않는 것 같아...	
		DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
		RETURN
	ENDIF
	DAILY_Lucid_Stats:9 = 1
ENDIF
;When a command ends

@LUCID_DREAM_TURN_11
IF DAILY_Lucid_Stats:7 <= 0
	PRINTFORML 당신이 마침내 일어나 욕실 쪽으로 비틀거리며 향하는 동안 엔딩 크레딧이 올라간다.
	DAILY_Lucid_Stats:9 = 1
	CALL LucidDreamTimeUp()
ENDIF
IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7 || BASE:MASTER:0 <= 500)
	PRINTFORMW 댐이 터지고 너는 시작한다 \@ DAILY_Lucid_Stats:1 ? 오줌을 싸기 시작한다. #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 대변을 본다. #  \@ 전속력으로...
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	PRINTFORMDW 당신은 \@ DAILY_Lucid_Stats:1 ? 흠뻑 적신다 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 채우고 #  \@ 자신과 소파를.
	PRINTFORMDW 당신은 세계가 검은색으로 희미해지는 동안, 황홀하게 따뜻하고 비어있는 상태로 등받이에 몸을 기댄다. 		
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
ELSEIF DAILY_Lucid_Stats:10 == 1
	SIF DAILY_Lucid_Stats:1
		CALL PEESOUNDS("hs")
	SIF DAILY_Lucid_Stats:2
		CALL POOSOUNDS("hf")
	PRINTFORMDW 오 이런 또 새버렸네 \@ DAILY_Lucid_Stats:1 ? 바지 속으로 스며들어 손을 축축하게 적시는 젖은 자국이 있다. #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %", "% #  \@\@ DAILY_Lucid_Stats:2 ? 네 바지와 손을 얼룩지게 만드는 작고 축축한 덩어리가 형성된다. #  \@.
	PRINTFORMDW 이것이 이미 사고로 계산되는 건가?
	PRINTFORMDW 네가 그렇게 생각하지 않으니 계속 참거나 속여야 할 거고 그건 안 될 것이다.	
	DAILY_Lucid_Stats:10 = 2
ELSEIF (PeeBarstage(MASTER) >= 6) || (PooBarStage(MASTER) >= 6)
	SIF DAILY_Lucid_Stats:1
		CALL PEESOUNDS("s")
	SIF DAILY_Lucid_Stats:2
		CALL POOSOUNDS("f")
	PRINTFORMDW 큰 소리가 당신을 놀라게 하고 약간 새어 나왔으며, 그 축축함이 버티는 것을 더욱 어렵게 만들었다...
	PRINTFORMDW 하지만 당신은 이 에피소드를 무사히 넘길 것이라고 말했고, 당신은-
	DAILY_Lucid_Stats:10 = 1
ELSE
	SIF (ABL:MASTER:PeeAddict >= 5 && DAILY_Lucid_Stats:1) || (ABL:MASTER:PooAddict >= 5 && DAILY_Lucid_Stats:2)
		PRINTFORMDW 물론, 너는 \@ DAILY_Lucid_Stats:1 ? 젖는 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 더럽히는 #  \@ your pants, but that doesn't mean you don't want to see just how far you can push your \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@!
	PRINTFORMDW 몇 분 후 정말로 파티를 추기 시작하고, 당신은 자신에게서 새어 나오는 절박한 작은 한숨과 야옹거림을 참으려 애쓰지 않는다.
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_11(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		PRINTFORML 당신은 소지품을 은밀하게 유지하려고 노력한다.
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		DAILY_Lucid_Stats:7 -= 5
	CASE 1
		PRINTFORMDW 당신의 모든 능력으로 버텨라.	
		DAILY_Lucid_Stats:7 -= 5
	CASE 8
		PRINTFORMDW 좋아, 재미있었지만 다가오는 홍수로부터 소파를 보호할 생각은 못 했네.
		PRINTFORMDW 지금 화장실에 가지 않으면 결과가 있을 거다.
		SIF (ABL:MASTER:PeeAddict >= 5 && DAILY_Lucid_Stats:1) || (ABL:MASTER:PooAddict >= 5 && DAILY_Lucid_Stats:2)
			PRINTFORMDW 다음에 기회가 생기면 정말로 사고에 대비해야 할 것이다.
		PRINTFORMDW 당신은 일어나 천천히 욕실로 향한다.
		DAILY_Lucid_Stats:9 = 1
		CALL LucidDreamTimeUp()
	CASE 9
		PRINTFORMDW 당신은 소파에서 일어나 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ double as gravity tugs on your \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 장을 두 배로 잡아당긴다 #  \@.
		PRINTFORMDW 하지만 당신에게는 계획이 있고, 그것을 이행할 것이다!
		PRINTFORMDW 손을 단단하게 가랑이에 대고, 집 안을 더럽히지 않으려고 애쓰며 뒷문으로 비틀거리며 걸어가 바깥으로 나선다...
		PRINTFORMDW 하지만 막 좋은 곳을 찾아 해방하고 싶었을 때, 당신 주변의 세상이 사라진다. 	
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_11(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		SIF BASE:MASTER:0 >= 50+500
			DAILY_Lucid_ComName '= "Hold it (50 STA)"
	CASE 1
		SIF BASE:MASTER:0 >= 200+500
			DAILY_Lucid_ComName '= "Hold it (200 STA)"
	CASE 8
		DAILY_Lucid_ComName '= @"그만해, 그냥 가!"
	CASE 9
		DAILY_Lucid_ComName '= @"뒷마당에 소변을 본다"
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
;Status page for Carry Status
;----------------------------

@LUCID_DREAM_INPUT_STATUS_11
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"종료까지 남은 시간: {DAILY_Lucid_Stats:7}분"
RETURNF DAILY_Lucid_InfoTab
;----------------------------
;Spurting
;----------------------------

@LUCID_DREAM_SPURT_11
;----------------------------
;Giving up
;----------------------------

@LUCID_DREAM_GIVEUP_11
;----------------------------
;Giving up but relieving self in diaper
;----------------------------

@LUCID_DREAM_GIVEUP_DIAPER_11
PRINTFORMDW 조금 더 버티려고 계획하고 있었던 거 알지만…
SIF CanWearUnderwear(MASTER, "Diaper", "",1)
	PRINTFORMDW 기저귀에 너무 익숙해져서, 안전하고 보호받고 있다는 사실을 알면서도 참기가 좀 힘들어졌다.
PRINTFORMDW 그냥 놓아버리고 싶은 유혹이 거의 압도적이다.
PRINTFORMDW 결국, 당신은 그 선택을 할 필요가 없다.
PRINTFORMDW 당신이 보고 있는 쇼는 놀라울 정도로 흥미롭다.
PRINTFORMDW 플롯에 너무 몰입해서 당신의 \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@을 완전히 잊어버린다.
CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
PRINTFORMDW 기억해낼 때쯤 이미 당신은 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:ing")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:ing")% #  \@, 따뜻하고 포근한 포옹처럼 그들 주위로 패드가 부풀어 오르는 것을 느끼고 있다.
PRINTFORMDW 당신은 자세를 고치고 축축한 패드를 자신의 %FSYN("crotch")%에 눌러 감각을 음미한 뒤 쇼에 다시 집중한다. 	
DAILY_Lucid_Stats:9 = 20
CALL LucidDreamTimeUp()
