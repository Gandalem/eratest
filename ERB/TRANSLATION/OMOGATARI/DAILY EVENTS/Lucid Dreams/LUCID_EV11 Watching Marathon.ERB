ENDIF

;When a command ends
@LUCID_DREAM_TURN_11
IF DAILY_Lucid_Stats:7 <= 0
PRINTFORML The end credits roll as you finally get up and stumble towards the bathroom.
DAILY_Lucid_Stats:9 = 1
CALL LucidDreamTimeUp()
ENDIF

