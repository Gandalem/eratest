;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
	;Normal
	;Nightmare
	;Sex
	;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
	;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------
@LUCID_DREAM_INFO_10
#FUNCTION
DAILY_Lucid_Name '= "(Padded) Friends"
{
DAILY_Lucid_Desc '= "You're hanging out with some friends when you suddenly get the urge to go.\n
There's a training potty over at the corner of the room, but do you really want to use it?
"
}
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 1
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/12/20/22/62"
DAILY_Lucid_CanGiveUp = 0

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_10
#DIM RandomChara
;friends
;this lucid dream allows you to interact normally
FOR RandomChara, 0, 4
	CALLF TP(DAILY_Lucid_Chara:RandomChara)
	TARGET:(RandomChara+1) = DAILY_Lucid_Chara:RandomChara
	CFLAG:(DAILY_Lucid_Chara:RandomChara):睡眠 = 0
	CFLAG:(DAILY_Lucid_Chara:RandomChara):同室 = 1
	TCVAR:(DAILY_Lucid_Chara:RandomChara):906 = 1		
	CALLF PEEME(DAILY_Lucid_Chara:RandomChara, 0)
	CALLF POOME(DAILY_Lucid_Chara:RandomChara, 0)		
	SIF nOmutsu
	CALLF PANTY_REWORK_CHANGE(DAILY_Lucid_Chara:RandomChara,103)
NEXT
TFLAG:104 = DAILY_Lucid_Chara


IF DAILY_Lucid_Stats:1
CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
CALLF POOME(MASTER, 4)
ENDIF
CALLF PANTY_REWORK_CHANGE(MASTER,2)

PRINTFORMDW You are hanging out at home with %CALLNAME:DAILY_Lucid_Chara%, %CALLNAME:(DAILY_Lucid_Chara:1)%, %CALLNAME:(DAILY_Lucid_Chara:2)%, and %CALLNAME:(DAILY_Lucid_Chara:3)%.
PRINTFORMDW It's a nice afternoon, and all four of them are sitting on the carpet like they used to when you were younger.
SIF (TALENT:MASTER:幼児／幼児退行 || ABL:MASTER:DiaperAttraction >= 5) && nOmutsu
PRINTFORMDW Everybody else seems to be wearing diapers, but somehow it doesn't seem weird to you.
PRINTFORMDW After a while, you catch yourself shifting and jiggling your legs, and with a start your realize that your \@ DAILY_Lucid_Stats:1 ? bladder #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? bowels #\@ is painfully full.
PRINTFORMDW Suddenly, %CALLNAME:DAILY_Lucid_Chara% looks over at you.
CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code	
PRINTFORMW 「Hey, %CALLNAME:MASTER%, you look like you really have to go to the potty.」
RESETCOLOR
CALL ASK_YN("Deny everything.","Yeah, but I can hold it!")
SELECTCASE RESULT
CASE 0
PRINTFORMDW You deny that you need to go at all.
PRINTFORMDW Your friends don't seem to believe you, but they let it go for the time being...
CASE 1
PRINTFORMDW You nod, but proudly claim that you can hold it until playtime is over.
PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara% looks at you quizzically.
;IF nOmutsu && ABL:MASTER:DiaperAttraction >= 5
IF nOmutsu
CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code			
PRINTFORMW 「You know, you'd be more comfortable if you'd just wear a diaper.」
PRINTFORMW 「I already peed ages ago, and it's actually kinda nice.」
RESETCOLOR
PRINTFORMDW Your gaze strays to %CALLNAME:DAILY_Lucid_Chara%'s %FSYN("crotch")%, and %HE_SHE(DAILY_Lucid_Chara)% was telling the truth.
PRINTFORMDW %HIS_HER(DAILY_Lucid_Chara,1)% diaper's padding is clearly soaked, and yet %HE_SHE(DAILY_Lucid_Chara)% looks comfortable and happy. 
PRINTFORMDW But... but diapers are for little kids! 
PRINTFORMDW And you are not a little kid!	
TALENT:DAILY_Lucid_Chara:15 = 1
ENDIF
ENDSELECT

;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_10

;When a command ends
@LUCID_DREAM_TURN_10

IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
	[SKIPSTART]
	PRINTFORMDW But ooooh, you have to \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #\@ so badly...
	SIF DAILY_Lucid_Stats:1
	CALL PEESOUNDS("loc")
	SIF DAILY_Lucid_Stats:2
	CALL POOSOUNDS("loc") 
	PRINTFORMDW Just as you're about to ask about maybe getting a diaper after all, you feel your pants slowly growing \@ DAILY_Lucid_Stats:1 ? wetter and wetter #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? bigger and bigger #\@, until a \@ DAILY_Lucid_Stats:1 ? puddle #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? mess #\@ spreads beneath you on the floor. 
	[SKIPEND]
	CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)		
	PRINTL
	IF IsPadded(MASTER)
	PRINTFORMDW The padding gets warm and squishy around you. 
	PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara% stares at your bulging crotch as you have your infantile accident.
	CALL SET_KOJO_COLOR(DAILY_Lucid_Chara)
	PRINTFORMW 「Wow. You must've really needed that diapie.」
	PRINTFORMW 「Big %PRINT_MALE("boy",MASTER)% thought %HE_SHE(MASTER)% could hold it, but \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:ed")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:ed")% #\@ themselves like a baby instead.」
	RESETCOLOR
	ELSE	
	PRINTFORMDL You had an accident! 
	PRINTFORMDW Right there on the carpet!	
	ENDIF
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
;ELSEIF ((PeeBarstage(MASTER) >= 6 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 6 && DAILY_Lucid_Stats:2)) && ABL:MASTER:DiaperAttraction >= 5 && nOmutsu
ELSEIF ((PeeBarstage(MASTER) >= 6 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 6 && DAILY_Lucid_Stats:2)) && nOmutsu && !IsPadded(MASTER,"Diaper")
PRINTFORMDW Your fidgeting gets impossible to ignore as you're starting to do a potty dance while still sitting on the carpet.
PRINTFORMDW When you can't resist the urge to hold yourself anymore, %CALLNAME:DAILY_Lucid_Chara% gets up and grabs a diaper from a commode in the corner.
PRINTFORMDL Before you can protest, your %PeeProtectType(MASTER)+" "+IS_ARE_PANTIES(PeeProtectType(MASTER))% on the floor next to you.
PRINTFORMDW Instead your bottom half is snugly contained within a soft, bulky diaper.
;PRINTFORMDW "I don't need a diaper."
CALLF PANTY_REWORK_CHANGE(MASTER,103)
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_10(nInput)
#DIM nInput
SELECTCASE nInput
CASE 0
	PRINTFORMDW You easily admit that you really have to go and gingerly get up to go to the bathroom.
	PRINTFORMDW But your door is locked!
	PRINTFORMDW You twist your legs together as a wave of desperation washes over you, and you try the door knob again.
	PRINTFORMDW After a while, one of your friends gently reminds you that you're not allowed to leave the room during playtime.
	PRINTFORMDW You're directed towards an adult-sized potty chair in the corner.
	CALL SET_KOJO_COLOR(DAILY_Lucid_Chara:(RAND:4)) ;custom code		
	PRINTFORMW 「No toilets during playtime %CALLNAME:MASTER%.」
	PRINTFORMW 「If you wanna go, there's a training potty right there near you.」
	RESETCOLOR
	PRINTFORMDW You don't feel like you're supposed to \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #\@ in there, in front of all your friends, but you know you're out of time.
	PRINTFORMDW Either you're using that potty, or you're having an accident, no doubt about it.
	PRINTFORMDW Face burning bright with embarrassment, you yank down your clothes and relieve yourself.
	CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
	IF RESULT <= 0
	IF IsPadded(MASTER)
	PRINTFORMDW The padding gets warm and squishy around you. 
	ELSE
	PRINTFORMDW You had an accident! 
	PRINTFORMDW Right there on the carpet!		
	ENDIF
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
	ENDIF	
	SIF DAILY_Lucid_Stats:1
	CALL PEESOUNDS("loc")
	SIF DAILY_Lucid_Stats:2
	CALL POOSOUNDS("loc") 	
	PRINTFORMDW As the last drop begines to fall into the plastc container, %CALLNAME:(DAILY_Lucid_Chara)% scolds you for your selfishness.
	CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code		
	PRINTFORMW 「You know...」
	PRINTFORMW 「You really should've just worn a diaper after all.」
	RESETCOLOR	
	DAILY_Lucid_Stats:9 = 1
	CALL LucidDreamTimeUp()
CASE 1
	PRINTFORMDW You jump up without saying another word and bolt for the door as your need to \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #\@ suddenly seems to double.
	PRINTFORMDW You're afraid you won't make it, but you can't just \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #\@ yourself in front of your friends!
	PRINTFORMDW You can see the bathroom door glowing with a mysterious golden light from the other end of the corridor, and make a run for it.
	PRINTFORMDW Knowing that if there's even the slightest obstacle between you and the toilet bowl...
	PRINTFORMDW You are definitely going to \@ DAILY_Lucid_Stats:1 ?wet#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? mess#\@ yourself.
	PRINTFORMDW As you step into the light, the world around you vanishes.
	DAILY_Lucid_Stats:9 = 62
	CALL LucidDreamTimeUp()
ENDSELECT

