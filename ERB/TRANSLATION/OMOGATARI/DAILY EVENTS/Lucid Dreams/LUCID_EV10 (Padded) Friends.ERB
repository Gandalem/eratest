; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV10 (기저귀 찬) 친구들.ERB
;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
;Normal
;Nightmare
;Sex
;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------

@LUCID_DREAM_INFO_10
#FUNCTION
DAILY_Lucid_Name '= "(기저귀 찬) 친구들"
DAILY_Lucid_Desc '= "친구들과 어울려 놀던 중 갑자기 볼일이 급해졌다.\n 방 한쪽 구석에 유아용 변기가 놓여 있지만, 정말 저걸 쓰고 싶은가?"
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 1
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/12/20/22/62"
DAILY_Lucid_CanGiveUp = 0
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_10
#DIM RandomChara
;friends
;this lucid dream allows you to interact normally
FOR RandomChara, 0, 4
CALLF TP(DAILY_Lucid_Chara:RandomChara)
TARGET:(RandomChara+1) = DAILY_Lucid_Chara:RandomChara
CFLAG:(DAILY_Lucid_Chara:RandomChara):睡眠 = 0
CFLAG:(DAILY_Lucid_Chara:RandomChara):同室 = 1
TCVAR:(DAILY_Lucid_Chara:RandomChara):906 = 1
CALLF PEEME(DAILY_Lucid_Chara:RandomChara, 0)
CALLF POOME(DAILY_Lucid_Chara:RandomChara, 0)
SIF nOmutsu
	CALLF PANTY_REWORK_CHANGE(DAILY_Lucid_Chara:RandomChara,103)
NEXT
TFLAG:104 = DAILY_Lucid_Chara
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
CALLF PANTY_REWORK_CHANGE(MASTER,2)
PRINTFORMDW 당신은 집에서 %CALLNAME:DAILY_Lucid_Chara%, %CALLNAME:(DAILY_Lucid_Chara:1)%, %CALLNAME:(DAILY_Lucid_Chara:2)%, 그리고 %CALLNAME:(DAILY_Lucid_Chara:3)%와 시간을 보내고 있다.
PRINTFORMDW 좋은 오후였고, 네 명 모두 예전에 네가 어렸을 때처럼 카펫 위에 앉아 있었다.
SIF (TALENT:MASTER:幼児／幼児退行 || ABL:MASTER:DiaperAttraction >= 5) && nOmutsu
	PRINTFORMDW 다른 모든 사람들이 기저귀를 차고 있는 것 같은데, 이상하게도 당신에게는 그게 이상해 보이지 않는다.
PRINTFORMDW 한참 후에, 당신은 무의식적으로 다리를 움직이고 떨고 있는 자신을 발견하고 깜짝 놀라 자신의 \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@ 고통스럽게 가득 차 있음을 깨달았다.
PRINTFORMDW 갑자기, %CALLNAME:DAILY_Lucid_Chara%가 당신을 내려다본다.
CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
PRINTFORMW 「이봐, %CALLNAME:MASTER%, 너 정말 화장실 가야 할 것 같아.」
RESETCOLOR
CALL ASK_YN("모든 것을 거부한다.","그래, 하지만 난 참을 수 있어!")
SELECTCASE RESULT
	CASE 0
		PRINTFORMDW 당신은 전혀 갈 필요가 없다고 부인한다.
		PRINTFORMDW 친구들은 당신을 믿지 않는 것 같지만, 일단은 넘어가 준다…
	CASE 1
		PRINTFORMDW 당신은 고개를 끄덕이지만, 놀이 시간이 끝날 때까지 그것을 붙잡을 수 있다고 자랑스럽게 주장한다.
		PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%가 의심스러운 듯 당신을 바라본다.
		;IF nOmutsu && ABL:MASTER:DiaperAttraction >= 5
		IF nOmutsu
			CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
			PRINTFORMW 「있잖아, 기저귀를 차는 게 더 편할 거야.」
			PRINTFORMW 「나 벌써 오래전에 소변 봤고, 사실 좀 기분 좋아.」
			RESETCOLOR
			PRINTFORMDW 당신의 시선이 %CALLNAME:DAILY_Lucid_Chara%의 %FSYN("crotch")%로 향하고, %HE_SHE(DAILY_Lucid_Chara)%는 진실을 말하고 있었다.
			PRINTFORMDW %HIS_HER(DAILY_Lucid_Chara,1)% 기저귀 패드가 분명히 젖어 있는데도, %HE_SHE(DAILY_Lucid_Chara)%는 편안해 보이고 행복해 보인다. 
			PRINTFORMDW 하지만... 하지만 기저귀는 어린 아이들을 위한 것이잖아! 
			PRINTFORMDW 그리고 당신은 어린 아이가 아니잖아!	
			TALENT:DAILY_Lucid_Chara:15 = 1
		ENDIF
ENDSELECT
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_10
;When a command ends

@LUCID_DREAM_TURN_10
IF (PeeBarstage(MASTER) >= 7) || (PooBarStage(MASTER) >= 7)
	CALL CAUSE_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
	PRINTL
	IF IsPadded(MASTER)
		PRINTFORMDW 패딩이 당신 주위에서 따뜻하고 말랑해진다. 
		PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%는 당신의 아기 같은 사고로 인해 볼록해진 가랑이를 응시한다.
		CALL SET_KOJO_COLOR(DAILY_Lucid_Chara)
		PRINTFORMW 「와. 너 정말 기저귀가 필요했나 보네.」
		PRINTFORMW 「큰 %PRINT_MALE("boy",MASTER)% 생각이 그것을 지탱할 수 있을 거라고 생각했지만, \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:ed")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:ed")% #  \@ 본인들처럼 아기처럼 되어버렸어.」
		RESETCOLOR
	ELSE
		PRINTFORMDL 당신은 사고를 쳤어! 
		PRINTFORMDW 바로 카펫 위에서 말이야!	
	ENDIF
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
	;ELSEIF ((PeeBarstage(MASTER) >= 6 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 6 && DAILY_Lucid_Stats:2)) && ABL:MASTER:DiaperAttraction >= 5 && nOmutsu
ELSEIF ((PeeBarstage(MASTER) >= 6 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 6 && DAILY_Lucid_Stats:2)) && nOmutsu && !IsPadded(MASTER,"Diaper")
	PRINTFORMDW 당신이 카펫 위에 앉아 있으면서 배변 신호를 보내기 시작하자 몸을 가만히 있기 어려워진다.
	PRINTFORMDW 더 이상 참을 수 없을 때, %CALLNAME:DAILY_Lucid_Chara%는 일어나 구석 변기에서 기저귀를 집는다.
	PRINTFORMDL 당신이 항의하기도 전에, 당신의 %PeeProtectType(MASTER)+" "+IS_ARE_PANTIES(PeeProtectType(MASTER))%가 옆 바닥에 놓여 있다.
	PRINTFORMDW 대신 당신의 하반신은 부드럽고 두툼한 기저귀 안에 꼭 감싸인다.
	;PRINTFORMDW "I don't need a diaper."
	CALLF PANTY_REWORK_CHANGE(MASTER,103)
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_10(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		PRINTFORMDW 너는 정말로 화장실에 가야 한다는 것을 쉽게 인정한다.
		PRINTFORMDW 하지만 네 문은 잠겨 있다!
		PRINTFORMDW 절망의 파도가 밀려오자 너는 다리를 오므리고 다시 문고리를 돌려본다.
		PRINTFORMDW 한참 후, 친구 중 한 명이 놀이 시간 동안 방을 나갈 수 없다는 것을 부드럽게 상기시킨다.
		PRINTFORMDW 너는 구석에 있는 어른 크기의 변기에 이끌린다.
		CALL SET_KOJO_COLOR(DAILY_Lucid_Chara:(RAND:4)) ;custom code
		PRINTFORMW 「놀이 시간에는 화장실이 없어요 %CALLNAME:MASTER%.」
		PRINTFORMW 「가고 싶으면 바로 근처에 배변 연습용 변기가 있어요.」
		RESETCOLOR
		PRINTFORMDW 너는 모든 친구들 앞에서 그것을 할 의무가 없다고 느끼지만, 시간이 다 되어버렸다는 것을 알고 있다.\@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ 안에,
		PRINTFORMDW 네가 변기를 사용하고 있거나, 사고를 치고 있다는 것 외에는 달리 방법이 없다.
		PRINTFORMDW 얼굴은 부끄러움으로 새빨개지고, 너는 옷을 내리고 몸을 편다.
		CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
		IF RESULT <= 0
			IF IsPadded(MASTER)
				PRINTFORMDW 패딩이 당신 주위에서 따뜻하고 말랑해진다. 
			ELSE
				PRINTFORMDW 당신은 사고를 쳤어! 
				PRINTFORMDW 바로 저 카펫 위에서 말이야!		
			ENDIF
			DAILY_Lucid_Stats:9 = LucidDreamLoser()
			CALL LucidDreamTimeUp()
		ENDIF
		SIF DAILY_Lucid_Stats:1
			CALL PEESOUNDS("loc")
		SIF DAILY_Lucid_Stats:2
			CALL POOSOUNDS("loc")
		PRINTFORMDW 마지막 한 방울이 플라스틱 용기에 떨어지자, %CALLNAME:(DAILY_Lucid_Chara)%은 당신의 이기심을 꾸짖는다.
		CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
		PRINTFORMW 「알잖아...」
		PRINTFORMW 「결국 기저귀를 차고 왔어야 했는데 말이야.」
		RESETCOLOR
		DAILY_Lucid_Stats:9 = 1
		CALL LucidDreamTimeUp()
	CASE 1
		PRINTFORMDW 아무 말 없이 문으로 달려나가는데, 당신의 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ 갑자기 두 배로 필요해지는 것 같다.
		PRINTFORMDW 해낼 수 없을까 봐 두렵지만, 친구들 앞에서 당신 자신을 망칠 수는 없기에 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ 달리게 된다.
		PRINTFORMDW 복도 저 끝에서 욕실 문이 신비로운 황금빛으로 빛나는 것을 보고 달려 나간다.
		PRINTFORMDW 당신과 변기 사이에 아주 작은 장애물이라도 있다면...
		PRINTFORMDW 당신은 분명 \@ DAILY_Lucid_Stats:1 ? wet #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? mess #  \@ 스스로를 망치게 될 것이다.
		PRINTFORMDW 당신이 빛 속으로 발을 들이자, 주변의 세상이 사라진다.
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
ENDSELECT
