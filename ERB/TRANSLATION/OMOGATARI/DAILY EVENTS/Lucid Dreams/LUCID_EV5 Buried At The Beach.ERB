; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV5 해변에 파묻혀.ERB
;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_5
#FUNCTION
DAILY_Lucid_Name '= "해변에 파묻혀"
DAILY_Lucid_Desc '= "꿈에 대한 상세 설명"
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "2/10/62/"
DAILY_Lucid_CanGiveUp = 1
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_5
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
DAILY_Lucid_Stats:6 = RAND:100
DAILY_Lucid_Stats:7 = RAND:30
DAILY_Lucid_Stats:10 = 0
BASE:MASTER:0 = MAXBASE:MASTER:0
PRINTFORMDW 당신은 해변에 있으며, %CALLNAME:DAILY_Lucid_Chara%, %CALLNAME:(DAILY_Lucid_Chara:1)%, 그리고 %CALLNAME:(DAILY_Lucid_Chara:2)%이 당신을 커다란 모래 더미 속에 파묻었다.
PRINTFORMDW 즐거운 시간이었고, 무겁고 차가운 모래가 과열된 피부에 기분 좋게 느껴졌다.
PRINTFORMDW 하지만 작은 문제가 하나 있다 - 당신은 \@ DAILY_Lucid_Stats:1 ? hydrated #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? sated #  \@, and now all that \@ DAILY_Lucid_Stats:1 ? water #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? food #  \@is reaching your \@ DAILY_Lucid_Stats:1 ? bladder #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? bowels #  \@에 도달하고 있다. 
PRINTFORMDW 당신은 정말, 정말 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@해야 하지만, 모래에서 벗어나려고 애쓰면서 그것이 너무 무겁다는 것을 깨달았다.
PRINTFORMDW 당신을 도와줄 %CALLNAME:DAILY_Lucid_Chara%, %CALLNAME:(DAILY_Lucid_Chara:1)%, 혹은 %CALLNAME:(DAILY_Lucid_Chara:2)%가 없기 때문에, 당신은 꼼짝없이 갇혔다. 
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_5
;When a command ends

@LUCID_DREAM_TURN_5
IF DAILY_Lucid_Stats:7 <= 0 && !DAILY_Lucid_Stats:10
	DAILY_Lucid_Stats:7 = 0
	DAILY_Lucid_Stats:10 = 1
	PRINTFORMDW 결국 작은 무리는 물러서 작업을 시작한다.
	FOR LOCAL, 0, 3
	CALLF TP(DAILY_Lucid_Chara:LOCAL)
	TARGET:(LOCAL+1) = DAILY_Lucid_Chara:LOCAL
	CFLAG:(DAILY_Lucid_Chara:LOCAL):睡眠 = 0
	CFLAG:(DAILY_Lucid_Chara:LOCAL):同室 = 1
	NEXT
ELSEIF DAILY_Lucid_Stats:10
	DAILY_Lucid_Stats:6 -= 10
ENDIF
IF DAILY_Lucid_Stats:6 <= 0
	IF (PeeBarstage(MASTER) >= 6 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 6 && DAILY_Lucid_Stats:2)
		PRINTFORMDW 하지만 당신이 마침내 자유로워질 때쯤이면, 이미 너무 늦었다는 것을 알게 될 것이다: 
		PRINTFORMDW 만약 일어나려고 조금이라도 노력한다면, 분명 사고를 치게 될 것이다. 
		PRINTFORMDW 마지막으로 품위를 지키기 위해 비치 타월을 붙잡고 자신을 감싼다.
		CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
		PRINTFORMDW 허벅지를 모래에 대고 통제력을 잃으며 당신은 바란다 \@ DAILY_Lucid_Stats:1 ? 젖은 것이 수건 아래로 보일 만큼 퍼지지 않기를 바란다. #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? 네 수영복이 네 사고를 막아줄 수 있을지. #  \@.
		PRINTFORMDW 당신의 수영복은 \@ DAILY_Lucid_Stats:1 ? 따뜻하고 축축해진다 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? 당신의 엉덩이가 움직일 공간을 만들어 준다 #  \@이고, 주변의 모래도 같은 처리를 받는다.		
		DAILY_Lucid_Stats:9 = LucidDreamLoser()
		CALL LucidDreamTimeUp()
	ELSE
		PRINTFORMDW 결국 당신은 스스로를 해방하는 데 성공하지만 화장실을 찾을 수 없었다.
		PRINTFORMDW 당신은 바다가 그 역할을 해야겠다고 결정했다. 어차피 모두 \@ DAILY_Lucid_Stats:1 ? 소변을 본다 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 대변을 본다 #  \@ 바다에서 보는 거니까, 맞지?
		PRINTFORMDW 당신은 물 쪽으로 비틀거리며 걸어갔다.
		SIF DAILY_Lucid_Stats:1
			CALL PEESOUNDS("hs")
		PRINTFORMDW 차가운 물이 맨발에 닿자 거의 제어할 수 없었다...
		PRINTFORMDW 하지만 다리를 모으고 최악의 충동이 지나갈 때까지 멈췄다.
		PRINTFORMDW 용감하게 계속 걸었고, 물이 사타구니에 닿아 옷을 적셨다.
		CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
		PRINTFORMDW 당신은 무릎을 살짝 구부렸다가 놓으며 바다가 따뜻해지는 것을 보며 안도의 한숨을 내쉬었다\@ DAILY_Lucid_Stats:2 ? %" "+FSYN("poo:n")+" 덩어리들이 주위에 나타난다"% #  \@.		
		DAILY_Lucid_Stats:9 = 2
		CALL LucidDreamTimeUp()
	ENDIF
ELSEIF (PeeBarstage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2) || BASE:MASTER:0 <= 500
	PRINTFORMDW 너는 지금 모래 속에 꽉 끼어 제대로 몸을 비빌 수도 없고, 스스로를 붙잡아 둘 수도 없다.
	PRINTFORMDW 결국, 네가 실수했다는 것을 깨닫게 된다.
	PRINTFORMDW 위엄을 지킨 채 거기서 빠져나갈 방법은 전혀 없다.
	;PRINTFORMDW The sand pressing up between your legs is helping you hold it a little bit, at least, but something weird is happening to it.
	;PRINTFORMDW It's getting softer, drier and warmer, and before long you realize that it's not sand between your legs.
	;PRINTFORMDW You're wearing a diaper.
	SIF DAILY_Lucid_Stats:1
		CALL PEESOUNDS("hs")
	SIF DAILY_Lucid_Stats:2
		CALL POOSOUNDS("hf")
	;PRINTFORMDW Your barely have any time to wonder where it even came from before a leak escapes you and soaks into the padding...
	PRINTFORMDW 누군가 당신에게서 새어 나와 모래에 스며들기 전에 생각할 시간이 거의 없다...
	PRINTFORMDW 이어서 더 많은 것들이 빠르게 나타난다...
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	PRINTFORMDW 당신이 마침내 포기하고 홍수가 터지도록 내주기 전까지는.		
	PRINTFORMDW 당신은 여기, 당신의 엉망진창 속에 파묻혀 있네.
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_5(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		IF !DAILY_Lucid_Stats:10
			PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%, %CALLNAME:(DAILY_Lucid_Chara:1)%, %조사처리(CALLNAME:(DAILY_Lucid_Chara:2),"는")% 제법 멀리 떨어진 곳에서 배구를 하고 있다.
			PRINTFORMDW 그들을 방해하고 싶지도, 해변 전체에 네 난처한 사정을 외치고 싶지도 않다.
			PRINTFORMDW Instead, you decide to take it slowly and start digging, even as every motion puts pressure on your \@ DAILY_Lucid_Stats:1 ?bladder#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" 그리고 "%#\@\@ DAILY_Lucid_Stats:2 ? bowels#\@, not at all sure that you're going to make it.
		ELSE
			PRINTFORMDW 당신은, %CALLNAME:DAILY_Lucid_Chara%, %CALLNAME:(DAILY_Lucid_Chara:1)%, 그리고 %CALLNAME:(DAILY_Lucid_Chara:2)%이 함께 모든 모래를 파낸다.
		ENDIF
		BASE:MASTER:0 -= 100
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		DAILY_Lucid_Stats:6 -= 5
		DAILY_Lucid_Stats:7 -= 5
	CASE 1
		PRINTFORMDW 친구들이 지루해져서 아무 말도 하지 않아 당신을 파헤치기 전까지 그냥 붙들고 있는 게 맞다고 생각한다.
		PRINTFORMDW 어쨌든 얼마나 걸릴까?
		PRINTFORMDW 길었다, 모양이다.
		BASE:MASTER:0 -= 150
		PeeHoldExp:MASTER:0 += 2
		DAILY_Lucid_Stats:7 -= 10
	CASE 8
		PRINTFORMDW 너는 놓아버리려고 하지만 \@ DAILY_Lucid_Stats:1 ? 젖는다 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? 망친다 #  \@ 스스로를 일부러.
		PRINTFORMDW 하지만 그걸 할 수 없는 것 같아.
		PRINTFORMDW 놓아버리는 것을 막는 일종의 정신적인 장벽이 있어.
		SIF DAILY_Lucid_Stats:1
			CALL PEESOUNDS("s")
		SIF DAILY_Lucid_Stats:2
			CALL POOSOUNDS("f")
		PRINTFORMDW 놀랍도록 뜨겁고 축축한 분출을 허벅지 쪽으로 밀어내며, 갑자기 완전히 깨어났다.
		PRINTFORMDW 해변은 단지 꿈이었고, 당신은 정말로 집(침대)에 있으며, \@ DAILY_Lucid_Stats:1 ? pee #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? poo #  \@.
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
	CASE 9
		PRINTFORMDW 당신은 %CALLNAME:DAILY_Lucid_Chara%, %CALLNAME:(DAILY_Lucid_Chara:1)%, 그리고 %CALLNAME:(DAILY_Lucid_Chara:2)%를 부르며 무덤에서 나오기를 요청한다.
		PRINTFORMDW 하지만 그 장난꾸러기들은 별로 서두르는 것 같지 않다.
		PRINTFORMDW 그리고 당신은 왜 풀려야 하고 당신의 문제가 얼마나 절실한지를 그들에게 말하고 싶지는 않을 것이다.
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		DAILY_Lucid_Stats:7 -= 20
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_5(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		DAILY_Lucid_ComName '= @"파기 시작한다"
	CASE 1
		DAILY_Lucid_ComName '= @"지루해질 때까지 그것을 붙잡고 있어라."
	CASE 8
		DAILY_Lucid_ComName '= @"\@ DAILY_Lucid_Stats:1 ? 오줌 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%과%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 똥 #  \@을 그 자리에서"
	CASE 9
		DAILY_Lucid_ComName '= @"%CALLNAME:DAILY_Lucid_Chara%, %CALLNAME:(DAILY_Lucid_Chara:1)%, 그리고 %CALLNAME:(DAILY_Lucid_Chara:2)%에게 도움을 요청한다"
ENDSELECT
RETURNF DAILY_Lucid_ComName
