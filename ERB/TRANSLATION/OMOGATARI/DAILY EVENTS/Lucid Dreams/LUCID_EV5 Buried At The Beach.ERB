	PRINTFORMDW Quickly followed by many more...
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")	
	PRINTFORMDW Until you finally give up and let the floodgates open.		
	PRINTFORMDW You're stuck here, buried in your mess.
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
