@LUCID_DREAM_END_5

;When a command ends
@LUCID_DREAM_TURN_5
IF DAILY_Lucid_Stats:7 <= 0 && !DAILY_Lucid_Stats:10
	DAILY_Lucid_Stats:7 = 0
	DAILY_Lucid_Stats:10 = 1
	PRINTFORMDW Eventually, the small group relents and gets to work.
