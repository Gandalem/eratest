; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV4 The Longest Line.ERB
;----------------------------
;Info for the dream
;----------------------------

@LUCID_DREAM_INFO_4
#FUNCTION
DAILY_Lucid_Name '= "The Longest Line"
DAILY_Lucid_Desc '= "You manage to find a toilet, but the line's super long! (Other dreams can transition to this one.) You're not likely going to make it. Good luck."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/2/10/12/20/22/62"
DAILY_Lucid_CanGiveUp = 0
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_4
IF !DAILY_Lucid_Stats:11
	PRINTFORMDW 오랫동안 기대하던 이벤트에 와 있고, 정말 즐기고 있다!
	PRINTFORMDW 갑자기 \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@ and realize that you really, really have to \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ 할 필요가 있다는 것을 알아차린다.
	PRINTFORMDW 다리를 움츠리고 급하게 화장실을 찾아 두리번거렸다.
	PRINTFORMDW 필사적으로 찾아 헤맨 끝에, 마침내 하나를 발견했다...
ENDIF
$LongestLineTransistion
PRINTFORMDW 명백히 절박해 보이는 다른 이들의 긴 줄에 맞이되다.
PRINTFORML
PRINTFORMDW 너는 이전보다 더 나빠질 수도 있다는 사실에도 해낼 수 있을 거라 확신하며 줄에 선다.
PRINTFORMDW 결국 너는 너무 나이가 많아서 \@ DAILY_Lucid_Stats:1 ? 젖다 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 엉망진창 #  \@ 너 자신을 돌보기엔 너무 나이가 많잖아, 그렇지?
PRINTFORMDW 너는 그저 버티고 기다리기만 하면 된다.
BASE:MASTER:0 = MAXBASE:MASTER:0
DAILY_Lucid_Stats:7 = RAND:250
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_4
;When a command ends

@LUCID_DREAM_TURN_4
IF DAILY_Lucid_Stats:7 <= 0
	PRINTFORMDW 당신은 변기 바로 앞에 서서 안도감을 갈망하며, 문이 열리자마자 뛰어들 준비를 한다.
	PRINTFORMDW 문이 살짝 열리고, %CALLNAME:DAILY_Lucid_Chara%가 나간다, 그리고 당신은 변기로 달려든다.
	CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
	IF RESULT <= 0
		DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
		CALL LucidDreamTimeUp()
	ENDIF
	PRINTFORMDW 당신은 바지를 내리고 변기에 앉을 시간조차 거의 없었다 \@ DAILY_Lucid_Stats:1 ? 젖는다 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 더럽히다 #  \@ 스스로.
	PRINTFORMDW 하지만 당신의 순전한 의지가 그것을 해냈다.
	PRINTFORMDW 바지는 더 좋은 날도 있었겠지만, 그 안에서 완전히 실수하는 것보다는 확실히 낫다.
	DAILY_Lucid_Stats:9 = 1
	CALL LucidDreamTimeUp()
ELSEIF BASE:MASTER:0 <= 500 || (PeeBarstage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2)
	$LongestLineLose
	SIF DAILY_Lucid_Stats:1
		CALL PEESOUNDS("hs")
	SIF DAILY_Lucid_Stats:2
		CALL POOSOUNDS("hf")
	PRINTFORMDW 이제 꾸준히 새고 있네, 작은 분출이 \@ DAILY_Lucid_Stats:1 ? 오줌 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 방귀 #  \@ 속옷을 적시고, 그다음 옷까지 적시면서 계속 커져가는 젖은 얼룩을 만들고 있어...
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	PRINTFORMDW Until your \@ DAILY_Lucid_Stats:1 ?bladder#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? bowels#\@ gives up, \@ DAILY_Lucid_Stats:1 ?soaking#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? filling#\@ yourself right there in the queue. 	
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
ELSEIF (PeeBarstage(MASTER) >= 6 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 6 && DAILY_Lucid_Stats:2)
	SIF DAILY_Lucid_Stats:1
		CALL PEESOUNDS("s")
	SIF DAILY_Lucid_Stats:2
		CALL POOSOUNDS("f")
	PRINTFORMDL 한 분출이 \@ DAILY_Lucid_Stats:1 ? 소변 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 방귀에서 나온 분비물이 #  \@ 빠져나가 속옷을 적시고, 그 축축함이 더욱 잡기 어렵게 만든다.
	PRINTFORMDL 그 선은 짧아지기는커녕 오히려 어딘가 길어지는 듯했다.
	PRINTFORMDL 한참 지나자 자신이 버틸 수 없다는 것을 알지만, 그렇다고 놓을 수도 없다.		
ELSEIF (PeeBarstage(MASTER) >= 5 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 5 && DAILY_Lucid_Stats:2)
	PRINTFORMDL 시간이 지나면 버티기가 힘들어지고, 변기에 맞춰 춤추지 않을 수가 없다.
	PRINTFORMDL 그러면 잡는 것을 도와주기 위해 다리 사이에 손을 넣어줘야 한다.			
ELSE
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_4(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		PRINTFORMDW 너는 해방의 유혹을 견딘다.
		BASE:MASTER:0 -= 50
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		PeeHoldExp:MASTER:0 += 1
		DAILY_Lucid_Stats:7 -= 5
	CASE 1
		PRINTFORMDW 당신은 해방의 유혹을 필사적으로 견딘다.
		BASE:MASTER:0 -= 200
		PeeHoldExp:MASTER:0 += 2
		DAILY_Lucid_Stats:7 -= 5
	CASE 8
		PRINTFORMDW 줄에 실제로 서면 절대로 성공하지 못할 거라는 걸 당신도 알 것이다.
		PRINTFORMDW 그리고 아주 \@ DAILY_Lucid_Stats:1 ? 젖 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 지저분한 #  \@ 옷으로 끝나지 않는 다른 해결 방법은 보이지 않는다.
		PRINTFORMDW 당신은 자존심을 삼키고 줄의 맨 앞으로 간다.
		PRINTFORMDW 당신은 불안하게 줄에 선 첫 번째 사람 %CALLNAME:DAILY_Lucid_Chara%에게, 곧 \@ DAILY_Lucid_Stats:1 ? 젖 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 지저분하게 #  \@ 스스로를 해버릴 것 같으니 그냥 먼저 지나가도 되는지 조심스럽게 묻는다.
		PRINTFORMDW 당신의 다리는 떨림을 멈추지 않고, 새어나오는 것을 막기 위해 떨리는 손으로 %FSYN("crotch")%를 누르내야 한다.
		PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%는 살짝 뒤로 물러나 당신이 그 자리를 차지하게 해주면서 %HIS_HER(DAILY_Lucid_Chara)%의 조롱하는 미소를 애써 감추려 하지 않는다.
		PRINTFORMDW %CALLNAME:(DAILY_Lucid_Chara:1)%가 웃는다, 그리고 당신은 그것이 바로 그들 때문이라는 것을 알지만 - 화장실이 비고 당신이 서둘러 안으로 들어가 해소했을 때, 당신은 정말 신경 쓰지 않는다. 	
		CALL COM_TakeClothesBeforePee(MASTER)
		IF RESULT <= 0
			CALL TOILET_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
			DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
			CALL LucidDreamTimeUp()
		ENDIF
		CALL COLORMESSAGE(@"생명이 승리한다... 치터!",C_ORANGE,2,1)
		DAILY_Lucid_Stats:9 = 0
		CALL LucidDreamTimeUp()
	CASE 9
		PRINTFORMDW 당신은 필사적으로 다른 곳을 찾는다 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@.
		PRINTFORMDW 당신은 너무 가고 싶어서 제대로 생각할 수가 없다.
		PRINTFORMDW 하지만 당신이 \@ DAILY_Lucid_Stats:1 ? 소변 한 방울 #  \@\@ DAILY_Lucid_Stats:1&&DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 방귀 #  \@ 참아내고 속옷을 적시기 직전에, 훌륭한 은신처처럼 보이는 큰 관목 하나를 발견한다.
		PRINTFORMDW 가진 모든 근육에 힘을 주며, 당신은 그것으로 비틀거리며 다가가 가지들을 헤쳐 나간다...
		CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
		PRINTFORMW 「야!」
		RESETCOLOR
		PRINTFORMDW 너는 %CALLNAME:DAILY_Lucid_Chara%이 갑자기 소리를 지르는 것을 듣고 그 덤불이 이미 사용되었다는 사실을 깜짝 놀라 깨닫는다.
		PRINTFORMDW 당신이 황급히 사과하며 당신의 「1」의 「2」를 비울 다른 장소를 찾기 위해 돌아설 때 \@ DAILY_Lucid_Stats:1 ? 방의 곳을 찾기 위해 황급히 더듬거리며 사과하고 돌아보자 세상이 어둠으로 사라진다. #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@주변 세계가 어둠으로 사라진다.
		PRINTFORMDW 눈을 뜨면 네 침대에 다시 있고 - 여전히 ~ 직전이다. \@ DAILY_Lucid_Stats:1 ? 젖는 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #  \@\@ DAILY_Lucid_Stats:2 ? 스스로를 더럽히고 있다. #  \@ 너 자신에게 	
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_4(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		SIF BASE:MASTER:0 >= 50+500
			DAILY_Lucid_ComName '= "Hold it (50 STA)"
	CASE 1
		SIF BASE:MASTER:0 >= 200+500
			DAILY_Lucid_ComName '= "Hold it (200 STA)"
	CASE 8
		DAILY_Lucid_ComName '= "Cut the lines"
	CASE 9
		DAILY_Lucid_ComName '= "Look for another place... NOW!"
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
;Status page for Carry Status
;----------------------------

@LUCID_DREAM_INPUT_STATUS_4
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"당신은 순서가 %ORDINAL(DAILY_Lucid_Stats:7)%입니다."
RETURNF DAILY_Lucid_InfoTab
