; OldVal:1 = ABL:DAILY_Lucid_Chara:従順
; OldVal:2 = ABL:DAILY_Lucid_Chara:欲望
; OldVal:3 = CFLAG:DAILY_Lucid_Chara:好感度
; OldVal:4 = CFLAG:DAILY_Lucid_Chara:信頼度
; OldVal:5 = TALENT:DAILY_Lucid_Chara:恋慕
lcBaseTemp:MASTER:6 = BASE:MASTER:精力

IF DAILY_Lucid_Stats:1 || DAILY_Lucid_Stats:2
PRINTFORMW Unfortunately, your \@ DAILY_Lucid_Stats:1 ?bursting bladder#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? aching bowels #\@ is distracting you from the enjoyment from sex with %CALLNAME:DAILY_Lucid_Chara%.
PRINTFORMW You need to slip out fast, or you're having a %FSYN("shame")% accident.
ENDIF
WAIT

;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_16
;CALL NOTIFY_BONUS_7(244,26)
SIF NOWEX:MASTER:放尿
	DAILY_Lucid_Stats:1 = 1
SIF NOWEX:MASTER:Defecation
	DAILY_Lucid_Stats:2 = 1

IF (DAILY_Lucid_Stats:1 && NOWEX:MASTER:放尿) || (DAILY_Lucid_Stats:2 && NOWEX:MASTER:Defecation)
PRINTFORML Unable to hold it due to being distracted by sex, %PARSE("you")% begin to \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" and "% #\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #\@ %PARSE("your",1)%self...
PRINTFORML %PARSE("You blush")% as %PARSE("you have",1)% %ARTICLE(FSYN("shame"))% accident right in front of %CALLNAME:DAILY_Lucid_Chara%...
SIF DAILY_Lucid_Stats:1
EX:MASTER:放尿 = 99
SIF DAILY_Lucid_Stats:2
EX:MASTER:Defecation = 99
DAILY_Lucid_Stats:9 = 11
PRINTFORMW
ENDIF

SELECTCASE DAILY_Lucid_Stats:9
CASE 10, 11
	CALL AFTER_AFFAIR(1)
	CALL ENDUFUFU_ALL
CASE 62
	SIF DAILY_Lucid_Stats:1 || DAILY_Lucid_Stats:2
		PRINTFORMW You wake up in the same room as your dream. Just that your %PeeProtectType(MASTER)% is still on, and your \@ DAILY_Lucid_Stats:1 ? bladder#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? bowels #\@ is still killing you.
ENDSELECT
; ABL:DAILY_Lucid_Chara:親密 = OldVal
; ABL:DAILY_Lucid_Chara:従順 = OldVal:1
; ABL:DAILY_Lucid_Chara:欲望 = OldVal:2
; CFLAG:DAILY_Lucid_Chara:好感度 = OldVal:3
; CFLAG:DAILY_Lucid_Chara:信頼度 = OldVal:4
; TALENT:DAILY_Lucid_Chara:恋慕 = OldVal:5
BASE:MASTER:精力 = lcBaseTemp:MASTER:6

;When a command ends
@LUCID_DREAM_TURN_16
IF NOWEX:MASTER:放尿 || NOWEX:MASTER:Defecation ||  NOWEX:MASTER:射精 || BASE:MASTER:体力 <= 500
	DAILY_Lucid_Stats:9 = 10
	CALL LucidDreamTimeUp()
ELSEIF TARGET && BASE:体力 < 500 && !TCVAR:TARGET:休憩中
	PRINTFORMW (%CALLNAME:TARGET%'s strength neared its limit)
	PRINTFORMW %CALLNAME:DAILY_Lucid_Chara% slowly fades away...
	CALL ENDUFUFU_ALL
	DAILY_Lucid_Stats:9 = 62
	CALL LucidDreamTimeUp()
ELSEIF !CFLAG:DAILY_Lucid_Chara:うふふ
	PRINTFORMW As you slip out, %CALLNAME:DAILY_Lucid_Chara% slowly fades away.
	CALL ENDUFUFU_ALL
	DAILY_Lucid_Stats:9 = 62
	CALL LucidDreamTimeUp()
ENDIF

