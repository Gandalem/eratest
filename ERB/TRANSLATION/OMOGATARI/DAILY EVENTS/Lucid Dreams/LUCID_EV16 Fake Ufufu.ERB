;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
	;Normal
	;Nightmare
	;Sex
	;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
	;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------
@LUCID_DREAM_INFO_16
#FUNCTION
DAILY_Lucid_Name '= "Ufufu"
DAILY_Lucid_Desc '= "Get pushed down by a delusion."
DAILY_Lucid_Type '= "Sex"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 1
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "10/11/62"
DAILY_Lucid_CanGiveUp = 0

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_16
DO
PRINTFORML Think of someone important...
PRINTFORML Leaving lets fate decide.
CALL SHOW_CHARA_LIST_TR(,,,1,)
SELECTCASE RESULT
	CASE 0 TO CHARANUM
	DAILY_Lucid_Chara = RESULT
	BREAK
	CASE 999
	BREAK
ENDSELECT
LOOP 1
PRINTFORML Do you want to configure this delusion's options?
CALL ASK_YN()
IF !RESULT
	CALL COM460_NAS
ENDIF

CFLAG:MASTER:300 = CFLAG:MASTER:311
CFLAG:MASTER:デート中 = MAIN_MAP
CALL SpawnDelusion(DAILY_Lucid_Chara, 1)
PRINTFORMW %PARSE("You are")% pushed down!
CALL KOJO_MESSAGE_SEND("EVENT",10,DAILY_Lucid_Chara,1,0)	
PRINTFORMW While %CALLNAME:DAILY_Lucid_Chara% starts taking off your %PeeProtectType(MASTER)%, you start observing the surroundings.
PRINTFORM It seems to be the same familiar room you sleep in, just that you're having sex with 
IF TALENT:DAILY_Lucid_Chara:恋慕 || TALENT:DAILY_Lucid_Chara:恋人
	PRINTFORMD your lover
ELSEIF TALENT:DAILY_Lucid_Chara:愛欲
	PRINTFORMD your lust-driven mistress
ELSEIF TALENT:DAILY_Lucid_Chara:思慕
	PRINTFORMD your date
ELSEIF TALENT:DAILY_Lucid_Chara:セフレ == 1
	PRINTFORMD your sex friend
ELSE
	PRINTFORMD a complete stranger
ENDIF
PRINTFORML .

DAILY_Lucid_Chara = CHARANUM-1

CFLAG:MASTER:うふふ = 1
CFLAG:DAILY_Lucid_Chara:うふふ = 1
CFLAG:DAILY_Lucid_Chara:睡眠 = 0
TCVAR:MASTER:906 = 1
TCVAR:DAILY_Lucid_Chara:906 = 1
CFLAG:DAILY_Lucid_Chara:同室 = 1
ABL:DAILY_Lucid_Chara:親密 = 99
ABL:DAILY_Lucid_Chara:従順 = 99
ABL:DAILY_Lucid_Chara:欲望 = 99
CFLAG:DAILY_Lucid_Chara:好感度 = 1000000
CFLAG:DAILY_Lucid_Chara:信頼度 = 1000000
TALENT:DAILY_Lucid_Chara:恋慕 = 1
UFUFU_START_TIME = TIME
CFLAG:DAILY_Lucid_Chara:前ターン位置 = CFLAG:DAILY_Lucid_Chara:現在位置
FOR LOCAL,0,VARSIZE("PALAM")
	PALAM:DAILY_Lucid_Chara:LOCAL = 0
NEXT
CALLF FUCKME()

;set values which will be restored after
