; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV16 Fake 우후후.ERB
;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
;Normal
;Nightmare
;Sex
;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------

@LUCID_DREAM_INFO_16
#FUNCTION
DAILY_Lucid_Name '= "우후후"
DAILY_Lucid_Desc '= "망상 속 존재에게 덮쳐진다."
DAILY_Lucid_Type '= "Sex"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 1
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "10/11/62"
DAILY_Lucid_CanGiveUp = 0
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_16
DO
PRINTFORML 중요한 누군가를 생각해 보세요...
PRINTFORML 떠나면 운명에 맡기게 된다.
CALL SHOW_CHARA_LIST_TR(,,,1,)
SELECTCASE RESULT
	CASE 0 TO CHARANUM
		DAILY_Lucid_Chara = RESULT
		BREAK
	CASE 999
		BREAK
ENDSELECT
LOOP 1
PRINTFORML 이 망상의산물 옵션을 설정하고 싶습니까?
CALL ASK_YN()
IF !RESULT
	CALL COM460_NAS
ENDIF
CFLAG:MASTER:300 = CFLAG:MASTER:311
CFLAG:MASTER:デート中 = MAIN_MAP
CALL SpawnDelusion(DAILY_Lucid_Chara, 1)
PRINTFORMW %PARSE("You are")% 밀쳐 버렸다!
CALL KOJO_MESSAGE_SEND("EVENT",10,DAILY_Lucid_Chara,1,0)
PRINTFORMW %CALLNAME:DAILY_Lucid_Chara%가 당신의 %PeeProtectType(MASTER)%를 착용하기 시작하면 주변을 관찰한다.
PRINTFORM 잠드는 방과 똑같아 보인다. 다만 네가 섹스를 하고 있는 것뿐이다.
IF TALENT:DAILY_Lucid_Chara:恋慕 || TALENT:DAILY_Lucid_Chara:恋人
	PRINTFORMD 당신의 연인
ELSEIF TALENT:DAILY_Lucid_Chara:愛欲
	PRINTFORMD 당신의 욕망에 사로잡힌 주인
ELSEIF TALENT:DAILY_Lucid_Chara:思慕
	PRINTFORMD 너의 데이트
ELSEIF TALENT:DAILY_Lucid_Chara:セフレ == 1
	PRINTFORMD 당신의 섹프
ELSE
	PRINTFORMD 완전한 타인
ENDIF
PRINTFORML .
DAILY_Lucid_Chara = CHARANUM-1
CFLAG:MASTER:うふふ = 1
CFLAG:DAILY_Lucid_Chara:うふふ = 1
CFLAG:DAILY_Lucid_Chara:睡眠 = 0
TCVAR:MASTER:906 = 1
TCVAR:DAILY_Lucid_Chara:906 = 1
CFLAG:DAILY_Lucid_Chara:同室 = 1
ABL:DAILY_Lucid_Chara:親密 = 99
ABL:DAILY_Lucid_Chara:従順 = 99
ABL:DAILY_Lucid_Chara:欲望 = 99
CFLAG:DAILY_Lucid_Chara:好感度 = 1000000
CFLAG:DAILY_Lucid_Chara:信頼度 = 1000000
TALENT:DAILY_Lucid_Chara:恋慕 = 1
UFUFU_START_TIME = TIME
CFLAG:DAILY_Lucid_Chara:前ターン位置 = CFLAG:DAILY_Lucid_Chara:現在位置
FOR LOCAL,0,VARSIZE("PALAM")
PALAM:DAILY_Lucid_Chara:LOCAL = 0
NEXT
CALLF FUCKME()
;set values which will be restored after
; OldVal = ABL:DAILY_Lucid_Chara:親密
; OldVal:1 = ABL:DAILY_Lucid_Chara:従順
; OldVal:2 = ABL:DAILY_Lucid_Chara:欲望
; OldVal:3 = CFLAG:DAILY_Lucid_Chara:好感度
; OldVal:4 = CFLAG:DAILY_Lucid_Chara:信頼度
; OldVal:5 = TALENT:DAILY_Lucid_Chara:恋慕
lcBaseTemp:MASTER:6 = BASE:MASTER:精力
IF DAILY_Lucid_Stats:1 || DAILY_Lucid_Stats:2
	PRINTFORMW 불행하게도 당신의 \@ DAILY_Lucid_Stats:1 ? 터지기 직전의 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? 배가 아프다 #  \@ 이것은 당신을 ~와의 섹스로부터의 즐거움으로부터 방해하고 있습니다. %CALLNAME:DAILY_Lucid_Chara%.
	PRINTFORMW 빨리 빠져나가야 해 아니면 「1」 사고가 날 거야 %FSYN("shame")% 사고를 겪게 될 거야.
ENDIF
WAIT
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_16
;CALL NOTIFY_BONUS_7(244,26)
SIF NOWEX:MASTER:放尿
	DAILY_Lucid_Stats:1 = 1
SIF NOWEX:MASTER:Defecation
	DAILY_Lucid_Stats:2 = 1
IF (DAILY_Lucid_Stats:1 && NOWEX:MASTER:放尿) || (DAILY_Lucid_Stats:2 && NOWEX:MASTER:Defecation)
	PRINTFORML 성적인 것에 정신이 팔려 참을 수 없게 되자, 당신은 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@ 당신의자신을...
	PRINTFORML %PARSE("You blush")%가 %PARSE("you have",1)% %ARTICLE(FSYN("shame"))% 눈앞에서 사고를 치다 %CALLNAME:DAILY_Lucid_Chara%...
	SIF DAILY_Lucid_Stats:1
		EX:MASTER:放尿 = 99
	SIF DAILY_Lucid_Stats:2
		EX:MASTER:Defecation = 99
	DAILY_Lucid_Stats:9 = 11
	PRINTFORMW
ENDIF
SELECTCASE DAILY_Lucid_Stats:9
	CASE 10, 11
		CALL AFTER_AFFAIR(1)
		CALL ENDUFUFU_ALL
	CASE 62
		SIF DAILY_Lucid_Stats:1 || DAILY_Lucid_Stats:2
			PRINTFORMW 당신은 꿈과 같은 방에서 깨어난다. 다만 당신의 %PeeProtectType(MASTER)%이 여전히 작동 중이고, 당신의 \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@은 여전히 당신을 괴롭힌다.
ENDSELECT
; ABL:DAILY_Lucid_Chara:親密 = OldVal
; ABL:DAILY_Lucid_Chara:従順 = OldVal:1
; ABL:DAILY_Lucid_Chara:欲望 = OldVal:2
; CFLAG:DAILY_Lucid_Chara:好感度 = OldVal:3
; CFLAG:DAILY_Lucid_Chara:信頼度 = OldVal:4
; TALENT:DAILY_Lucid_Chara:恋慕 = OldVal:5
BASE:MASTER:精力 = lcBaseTemp:MASTER:6
;When a command ends

@LUCID_DREAM_TURN_16
IF NOWEX:MASTER:放尿 || NOWEX:MASTER:Defecation ||  NOWEX:MASTER:射精 || BASE:MASTER:体力 <= 500
	DAILY_Lucid_Stats:9 = 10
	CALL LucidDreamTimeUp()
ELSEIF TARGET && BASE:体力 < 500 && !TCVAR:TARGET:休憩中
	PRINTFORMW (%조사처리(CALLNAME:TARGET,"의")% 힘이 한계에 가까워졌다)
	PRINTFORMW %CALLNAME:DAILY_Lucid_Chara%가 천천히 사라진다...
	CALL ENDUFUFU_ALL
	DAILY_Lucid_Stats:9 = 62
	CALL LucidDreamTimeUp()
ELSEIF !CFLAG:DAILY_Lucid_Chara:うふふ
	PRINTFORMW 당신이 빠져나가자, %CALLNAME:DAILY_Lucid_Chara%는 천천히 사라진다.
	CALL ENDUFUFU_ALL
	DAILY_Lucid_Stats:9 = 62
	CALL LucidDreamTimeUp()
ENDIF
