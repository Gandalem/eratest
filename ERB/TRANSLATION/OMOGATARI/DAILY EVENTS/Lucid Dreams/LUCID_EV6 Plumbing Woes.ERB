;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
	;Normal
	;Nightmare
	;Sex
	;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
	;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------
@LUCID_DREAM_INFO_6
#FUNCTION
DAILY_Lucid_Name '= "Plumbing Woes"
{
DAILY_Lucid_Desc '= @"Your toilet broke, and you called a plumber to help fix it, but the repairs seem to be taking longer than expected.\n
As the repairs are being done, a sudden desperation grows and you need to relieve yourself quickly.
Will you be able to hold it until the toilet is repaired, or will you have to go in an unusual place?
"
}
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/2/10/12/20/22/62"
DAILY_Lucid_CanGiveUp = 0

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_6
PRINTFORMDW Oh no! The toilet broke!
PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara% is already hard at work, but whenever you ask %HIS_HER(DAILY_Lucid_Chara)% how much longer it's going to take, you get a different answer.
PRINTFORMDW You urgently have to %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"pee","poop")%...

DAILY_Lucid_Stats:6 = RAND:60
DAILY_Lucid_Stats:7 = 120
CALLF TP(DAILY_Lucid_Chara)
TARGET = DAILY_Lucid_Chara
TARGET:1 = DAILY_Lucid_Chara
CFLAG:DAILY_Lucid_Chara:睡眠 = 0
TCVAR:DAILY_Lucid_Chara:906 = 1
CFLAG:DAILY_Lucid_Chara:同室 = 1
IF DAILY_Lucid_Stats:1
CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
CALLF POOME(MASTER, 4)
ENDIF

;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_6

;When a command ends
@LUCID_DREAM_TURN_6
IF DAILY_Lucid_Stats:6 <= 0 && DAILY_Lucid_Stats:7 <= 0
	PRINTFORMDW It takes an eternity, but eventually the toilet stabilizes.
	CALL COLORMESSAGE(@"You can now safely go to the toilet!",C_GREEN,2,1)	
ELSEIF DAILY_Lucid_Stats:6 <= 0 && DAILY_Lucid_Stats:7 == 120
PRINTFORMDW But then!
PRINTFORMDW Finally!
PRINTFORMDW Finally %CALLNAME:DAILY_Lucid_Chara% steps out of the bathroom and walks over to you.
CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
PRINTFORMW 「It'll take about two hours until the quantum flow's settled down. Don't use the toilet until then, or you'll tear reality apart.」
RESETCOLOR
PRINTFORMDW What?
PRINTFORMDW You have no idea what's up with that quantum nonsense.
PRINTFORMDW But SOMETHING is going to be flowing alright if you're not allowed to use that toilet right now.
PRINTFORMDW You try to tell that to %CALLNAME:DAILY_Lucid_Chara%, but %HE_SHE(DAILY_Lucid_Chara)%'s nowhere to be seen.
ENDIF

IF (PeeBarstage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2) || BASE:MASTER:0 <= 500
	PRINTFORMDW So you'll just have to keep holding it...
	PRINTFORMDW And holding it...
	PRINTFORMDW and holding it...
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	IF IsPadded(MASTER)
	PRINTFORMDW But in the end, there is nothing you can do as you lose control and have an accident.
	PRINTFORMDW The diaper does it's best job at absorbing your \@ DAILY_Lucid_Stats:1 ?%FSYN("pee:n")%#\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" and "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")%#\@, but starts leaking out a bit.
	PRINTFORMDW Relieved that almost everything is now inside your diaper, the warmth from your real %FSYN("crotch")% brings you into reality.
	ELSE
	PRINTFORMDW But in the end, no amount of squirming is enough to keep the flood at bay.
	ENDIF
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
ENDIF

