			CALL COLORMESSAGE("You are now 【Incontinent】",C_YELLOW,2,1)			
		CASE 6
			CALLF GAMANME(,6, 0)
			CALL COLORMESSAGE("You now 【Can't Excrete】",C_YELLOW,2,1)			
		CASE 7
			SETCOLOR 247,171,166
