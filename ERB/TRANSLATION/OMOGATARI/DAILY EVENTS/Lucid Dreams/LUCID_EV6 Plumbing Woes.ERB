; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV6 Plumbing Woes.ERB
;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
;Normal
;Nightmare
;Sex
;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------

@LUCID_DREAM_INFO_6
#FUNCTION
DAILY_Lucid_Name '= "골치 아픈 배관"
DAILY_Lucid_Desc '= @"화장실이 고장 나서 수리를 도와줄 배관공을 불렀지만, 수리가 예상보다 오래 걸리는 듯하다.\n수리가 진행되는 동안 갑자기 다급해져서 서둘러 볼일을 봐야 한다. 화장실이 수리될 때까지 참을 수 있을까, 아니면 평소와는 다른 장소에서 볼일을 봐야 할까? "
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/2/10/12/20/22/62"
DAILY_Lucid_CanGiveUp = 0
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_6
PRINTFORMDW 아뇨! 변기가 고장났어요!
PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%는 이미 열심히 일하고 있지만, 당신이 %HIS_HER(DAILY_Lucid_Chara)%에게 얼마나 더 걸릴지 물어볼 때마다 다른 대답을 듣는다.
PRINTFORMDW 당신은 급하게 %PeeAndPoo(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,"소변","대변")%해야 한다...
DAILY_Lucid_Stats:6 = RAND:60
DAILY_Lucid_Stats:7 = 120
CALLF TP(DAILY_Lucid_Chara)
TARGET = DAILY_Lucid_Chara
TARGET:1 = DAILY_Lucid_Chara
CFLAG:DAILY_Lucid_Chara:睡眠 = 0
TCVAR:DAILY_Lucid_Chara:906 = 1
CFLAG:DAILY_Lucid_Chara:同室 = 1
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_6
;When a command ends

@LUCID_DREAM_TURN_6
IF DAILY_Lucid_Stats:6 <= 0 && DAILY_Lucid_Stats:7 <= 0
	PRINTFORMDW 영겁의 시간이 걸리지만 결국 변기는 안정된다.
	CALL COLORMESSAGE(@"이제 마음 놓고 화장실에 가도 돼!",C_GREEN,2,1)
ELSEIF DAILY_Lucid_Stats:6 <= 0 && DAILY_Lucid_Stats:7 == 120
	PRINTFORMDW 하지만 그때!
	PRINTFORMDW 드디어!
	PRINTFORMDW 마침내 %CALLNAME:DAILY_Lucid_Chara%는 욕실에서 나와 당신에게로 걸어온다.
	CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
	PRINTFORMW 「양자 흐름이 가라앉을 때까지 약 두 시간이 걸릴 거야. 그때까지 화장실에 가지 마, 아니 현실을 갈기게 될 테니까.」
	RESETCOLOR
	PRINTFORMDW 뭐라고?
	PRINTFORMDW 네가 그 양자적인 허튼소리가 뭔지 알 리 없어.
	PRINTFORMDW 하지만 지금 그 화장실을 쓸 수 없다면 뭔가 흘러나올 거다.
	PRINTFORMDW %CALLNAME:DAILY_Lucid_Chara%에게 그걸 말해 보려고 했지만, %HE_SHE(DAILY_Lucid_Chara)%는 어디에도 보이지 않는다.
ENDIF
IF (PeeBarstage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2) || BASE:MASTER:0 <= 500
	PRINTFORMDW 그러니 그냥 계속 붙잡고 있어야 해...
	PRINTFORMDW 그리고 그것을 붙잡고...
	PRINTFORMDW 그리고 그것을 붙잡고...
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	IF IsPadded(MASTER)
		PRINTFORMDW 하지만 결국 통제력을 잃고 사고가 나면 할 수 있는 것은 아무것도 없다.
		PRINTFORMDW 기저귀는 당신의 \@ DAILY_Lucid_Stats:1 ? %FSYN("소변:n")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% #  \@를 흡수하는 데 최선을 다하지만, 약간 새기 시작한다.
		PRINTFORMDW 거의 모든 것이 이제 기저귀 안에 있다는 사실에 안도하며, 당신의 실제 %FSYN("crotch")%에서 오는 따뜻함이 당신을 현실로 이끈다.
	ELSE
		PRINTFORMDW 하지만 결국, 아무리 몸을 비틀어도 홍수를 막기에는 부족하다.
	ENDIF
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_6(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		PRINTFORMDW 참으려고 노력하지만, 너무 오래 걸리고 있어...
		BASE:MASTER:0 -= 50
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		SIF DAILY_Lucid_Stats:6 <= 0
			DAILY_Lucid_Stats:7 -= 10
		DAILY_Lucid_Stats:6 -= 5
	CASE 1
		PRINTFORMDW 당신은 그것을 참으려고 최선을 다하지만, 너무 오래 걸리고 있어...
		BASE:MASTER:0 -= 200
		SIF DAILY_Lucid_Stats:6 <= 0
			DAILY_Lucid_Stats:7 -= 10
		DAILY_Lucid_Stats:6 -= 5
	CASE 2
		;toilet. before it's safe and after it is.
		PRINTFORML 당신은 미친 듯이 화장실로 달려간다.
		CALL MasterGoToilet(DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,,1)
		IF RESULT <= 0
			DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
			CALL LucidDreamTimeUp()
		ENDIF
		IF DAILY_Lucid_Stats:7 > 0
			PRINTFORMDW 현실의 직물이 당신의 배설물로 찢어지면서, 당신의 몸이 그것에 영향을 받게 된다.
			SELECTCASE RAND:10
				CASE 0
					MAXBASE:MASTER:0 = MAXBASE:MASTER:0 + MIN(MAXBASE:MASTER:0 / 10, 300)
					MAXBASE:MASTER:1 = MAXBASE:MASTER:1 + MIN(MAXBASE:MASTER:1 / 10, 300)
					CALL COLORMESSAGE("최대 스태미나와 에너지가 영구적으로 증가했다.",C_YELLOW,2,1)
				CASE 1
					TALENT:MASTER:2 = 3
					CALL COLORMESSAGE("너는 이제 후타나리가 되었다.",C_YELLOW,2,1)
				CASE 2
					IF MORELOVER
						TALENT:DAILY_Lucid_Chara:恋人 = 1
						CALL COLORMESSAGE(@"%CALLNAME:DAILY_Lucid_Chara%는 이제 당신의 연인이다",C_YELLOW,2,1)
					ELSE
						PRINTFORML 아무 일도 일어나지 않았다...
					ENDIF
				CASE 3
					PRINTFORML 그것은 %PantsuSama()%인데)! 하지만 남근가 달린 채로!
					CALL GOD_FUTANARI
				CASE 4
					PRINTFORML 아무 일도 일어나지 않았다.
				CASE 5
					CALLF GAMANME(,-5, 0)
					CALL COLORMESSAGE("당신은 이제 「실금증」이다",C_YELLOW,2,1)
				CASE 6
					CALLF GAMANME(,6, 0)
					CALL COLORMESSAGE("당신은 이제 【배출할 수 없다】",C_YELLOW,2,1)
				CASE 7
					SETCOLOR 247,171,166
					PRINTFORML %CALLNAME:DAILY_Lucid_Chara%은(는) 날카로운 시선으로 당신를 응시한다...
					PRINTFORMW %CALLNAME:DAILY_Lucid_Chara%은(는) 증오의 낙인 Lv1을 얻었다
					RESETCOLOR
					MARK:DAILY_Lucid_Chara:反発刻印 = 1
				CASE 8
					CALLF GAMANME(MASTER,RAND(-5,6), 0)
					PRINTFORM 당신의 배변 훈련 능력은 이제 레벨이 되었다.
					SETCOLOR C_YELLOW
					PRINTFORM {PeeHold:MASTER:0}【%GET_TALENTNAME_TR(1514, TALENT:MASTER:57)%】
					IF nScat
						RESETCOLOR
						PRINTFORM /
						SETCOLOR 0x6b4737
						PRINTFORML {PooHold:MASTER:0}【%GET_TALENTNAME_TR(1500, TALENT:MASTER:58)%】
					ENDIF
					RESETCOLOR
				CASE 9
					PRINTFORML 그게 진정한 오모라시 신인가?
					CALL OmoGodTrue
			ENDSELECT
		ELSE
		ENDIF
		DAILY_Lucid_Stats:9 = 1
		CALL LucidDreamTimeUp()
	CASE 7
		PRINTFORMDW 당신은 더 이상 참을 수 없을 거라는 걸 알고 있다...
		PRINTFORMDW 하지만 문 뒤쪽 옷장 깊숙한 곳에 아직 몇 개의 오래된 기저귀가 있다는 사실이 갑자기 떠오른다!
		PRINTFORMDW 그게 도대체 어디서 나왔는지는 정확히 모르지만, 상관없다.
		PRINTFORMDW 당신은 필사적으로 물건 더미를 뒤지다가 자신에게 너무 작아 보이는 폴카 도트 기저귀 한 묶음을 발견한다.
		PRINTFORMDW 하지만 이걸로 해야 한다.
		PRINTFORMDW 당신은 간신히 자신의 몸에 맞도록 늘어나는 듯한 그 기저귀를 서둘러 착용한다.
		PRINTFORMDW 패드 부분이 따뜻하고 부드럽게 감싸주며 거의 편안할 정도지만, 당신이 \@ DAILY_Lucid_Stats:1 ? %FSYN("소변:ing")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:ing")% #  \@ 자신에게 너무 가까워서 그렇지.
		PRINTFORMDW 당신은 완강하게 버텨보려 노력한다.
		PRINTFORMDW 어쨌든, 당신은 \@ DAILY_Lucid_Stats:1 ? 젖는 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? 더럽히는 #  \@ 기저귀를 차기에는 너무 나이가 많다.
		CALLF PANTY_REWORK_CHANGE(MASTER, 103)
	CASE 8
		PRINTFORMDW 너 정말 더는 참을 수 없어.
		PRINTFORMDW 좀 아프기 시작했고, 그건 좋지 않아.
		PRINTFORMDW 일어나 주변을 둘러 다른 선택지를 찾는다.
		PRINTFORMDW 부엌 싱크대가 지금 아주 유혹적으로 보이지만, 만약 %CALLNAME:DAILY_Lucid_Chara%가 너를 본다면 어떡하지?
		PRINTFORMDW 절대 안 돼.
		PRINTFORMDW 그리고 창밖에서 커다란 덤불을 발견한다.
		PRINTFORMDW 그것이 어떻게 거기에 왔는지 기억나지 않지만, 신경 쓸 일도 아니었다.
		PRINTFORMDW 너는 허둥지둥 마당으로 달려가, 덤불 속으로 몸을 숨기고, 옷을 치운 뒤 \@ DAILY_Lucid_Stats:1 ? 소변eeeee #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? pooooooo #  \@...
		DAILY_Lucid_Stats:9 = 2
		CALL LucidDreamTimeUp()
	CASE 9
		PRINTFORMDW 부끄러울 수도 있지만, 가장 쉬운 해결책인 것 같다.
		PRINTFORMDW 옆집으로 가서 이웃에게 %CALLNAME:(DAILY_Lucid_Chara:1)%이(가) %HIS_HER(DAILY_Lucid_Chara:1)% 화장실을 사용해도 되는지 물어볼 것이다.
		PRINTFORMDW 당신은 재빨리 현관으로 향하지만, 집에서 발을 내딛자 주변 세계가 검게 변한다...
		PRINTFORMDW 갑자기 침대에 돌아와서 \@ DAILY_Lucid_Stats:1 ? %FSYN("소변")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" 그리고 "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo")% #  \@.
		DAILY_Lucid_Stats:9 = 62
		CALL LucidDreamTimeUp()
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_6(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		SIF BASE:MASTER:0 >= 50+500
			DAILY_Lucid_ComName '= "참는다(STA 50)"
	CASE 1
		SIF BASE:MASTER:0 >= 200+500
			DAILY_Lucid_ComName '= "필사적으로 참는다(STA 200)"
	CASE 2
		IF DAILY_Lucid_Stats:7 > 0 && DAILY_Lucid_Stats:6 <= 0
			DAILY_Lucid_ComName '= @"어쨌든 가자"
		ELSEIF DAILY_Lucid_Stats:7 <= 0 && DAILY_Lucid_Stats:6 <= 0
			DAILY_Lucid_ComName '= @"자해하기"
		ENDIF
	CASE 7
		SIF nOmutsu && !IsPadded(MASTER,"Diaper")
			DAILY_Lucid_ComName '= "지저분해지지 않도록 버틴다"
	CASE 8
		DAILY_Lucid_ComName '= @"덤불에 볼일을 본다"
	CASE 9
		DAILY_Lucid_ComName '= "이웃집 화장실을 빌린다"
ENDSELECT
RETURNF DAILY_Lucid_ComName
