;----------------------------
;Input names
;----------------------------
@LUCID_DREAM_INPUT_NAMES_6(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
CASE 0
	SIF BASE:MASTER:0 >= 50+500
	DAILY_Lucid_ComName '= "Hold it (50 STA)"
CASE 1
	SIF BASE:MASTER:0 >= 200+500
	DAILY_Lucid_ComName '= "Hold it (200 STA)"
CASE 2
	IF DAILY_Lucid_Stats:7 > 0 && DAILY_Lucid_Stats:6 <= 0
	DAILY_Lucid_ComName '= @"Go anyway"
	ELSEIF DAILY_Lucid_Stats:7 <= 0 && DAILY_Lucid_Stats:6 <= 0
	DAILY_Lucid_ComName '= @"Relieve Self"
	ENDIF
CASE 7
	SIF nOmutsu && !IsPadded(MASTER,"Diaper")
	DAILY_Lucid_ComName '= "Try not to make a mess"
CASE 8
	DAILY_Lucid_ComName '= @"\"\@DAILY_Lucid_Stats:1?Water#\@\@DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2?%" "%and%" "%#\@\@DAILY_Lucid_Stats:2?Fertilize#\@\" the bushes"
CASE 9
	DAILY_Lucid_ComName '= "Ask to use neighbor's bathroom"
ENDSELECT
RETURNF DAILY_Lucid_ComName

