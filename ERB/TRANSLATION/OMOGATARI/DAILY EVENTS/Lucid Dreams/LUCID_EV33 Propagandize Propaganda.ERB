@LUCID_EV33_NUDIFY(ARG)
;Remove all clothes except your underwear
FOR LOCAL,0,25
EQUIP:ARG:LOCAL = 0
CFLAG:ARG:(240+LOCAL) = 0
NEXT
FOR LOCAL,0,25
CFLAG:ARG:(200+LOCAL) = EQUIP:ARG:LOCAL
CFLAG:ARG:(240+LOCAL) = EQUIP:ARG:LOCAL
NEXT
