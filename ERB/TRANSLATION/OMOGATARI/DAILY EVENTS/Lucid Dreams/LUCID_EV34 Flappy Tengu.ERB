;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_34(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		DAILY_Lucid_ComName '= @"커스텀 COM"
ENDSELECT
RETURNF DAILY_Lucid_ComName
