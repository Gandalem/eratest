; Modular ERB: OMOGATARI/DAILY EVENTS/Lucid Dreams/LUCID_EV7 비행기.ERB
;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
;Normal
;Nightmare
;Sex
;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------

@LUCID_DREAM_INFO_7
#FUNCTION
DAILY_Lucid_Name '= "비행기"
DAILY_Lucid_Desc '= "비행기를 타고 가던 중 갑자기 화장실이 급해졌다."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/12/20/22/62"
DAILY_Lucid_CanGiveUp = 2
;----------------------------
;When you start up a dream
;----------------------------

@LUCID_DREAM_START_7
PRINTFORMDW 당신은 눈을 뜨고 비행기 좌석에 앉아 있음을 발견한다.
PRINTFORMDW 당신의 오른쪽에는 창문이 있고, 왼쪽에는 잠든 %CALLNAME:DAILY_Lucid_Chara%가 있으며, 머리 위에서는 안전벨트 표시등이 빛나고 있다.
PRINTFORMDW 그리고 당신의 \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@에 고통스럽고 욱신거리는 압박감이 느껴진다.
PRINTFORMDW 당신은 어디로 가는 건지, 왜 가는 건지 기억하지 못하지만, 가야만 한다!
BASE:MASTER:0 = MAXBASE:MASTER:0
DAILY_Lucid_Stats:7 = RAND:100
CALLF TP(DAILY_Lucid_Chara)
TARGET = DAILY_Lucid_Chara
TARGET:1 = DAILY_Lucid_Chara
CFLAG:DAILY_Lucid_Chara:睡眠 = 1
TCVAR:DAILY_Lucid_Chara:906 = 1
CFLAG:DAILY_Lucid_Chara:同室 = 1
IF DAILY_Lucid_Stats:1
	CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
	CALLF POOME(MASTER, 4)
ENDIF
PRINTFORML
;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------

@LUCID_DREAM_END_7
;When a command ends

@LUCID_DREAM_TURN_7
IF DAILY_Lucid_Stats:7 <= 0
	PRINTFORMDW 영겁의 시간이 걸리지만 결국 안전벨트 경고등은 꺼진다.
	CALL COLORMESSAGE(@"이제 화장실에 갈 수 있다!",C_GREEN,2,1)
ELSEIF BASE:MASTER:0 <= 0 || (PeeBarstage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2)
	$PlaneLose
	PRINTFORMDW 당신은 한동안 더 애쓰지만, 결국 의자에게 얼마나 열심히 갈아 넣든 혹은 스스로에게 얼마나 필사적으로 중얼거리든 상관없다...
	PRINTFORMDW 당신은 한계에 도달했다.
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")
	PRINTFORMDW 다행히, 당신의 \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")% #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% #  \@ 비행기 바닥의 톡톡거림은 눈에 띄지 않는다...
	PRINTFORMDW 지금으로서는...
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
ENDIF
;----------------------------
;Results for clicking on selections
;----------------------------

@LUCID_DREAM_INPUT_7(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
		PRINTFORMDW 너는 해방의 유혹을 견딘다.
		BASE:MASTER:0 -= 50
		BASE:MASTER:尿意 += RAND:75
		BASE:MASTER:Poo += RAND:75
		PeeHoldExp:MASTER:0 += 1
		DAILY_Lucid_Stats:7 -= 5
	CASE 1
		PRINTFORMDW 당신은 해방의 유혹을 필사적으로 견딘다.
		BASE:MASTER:0 -= 200
		BASE:DAILY_Lucid_Chara:尿意 += RAND:75
		BASE:DAILY_Lucid_Chara:Poo += RAND:75
		PeeHoldExp:MASTER:0 += 2
		DAILY_Lucid_Stats:7 -= 5
	CASE 9
		PRINTFORMDW 다시 눈을 떴을 때쯤이면 안전벨트 경고등이 꺼져 있을지도 모른다.
		PRINTFORMDW 편안해지려면 몸의 무게를 \@ DAILY_Lucid_Stats:1 ? 방광 #  \@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ? %" "%and%" "% #  \@\@ DAILY_Lucid_Stats:2 ? 장 #  \@ 충분히 움직이고 자세를 바꿔야 하지만, 결국 뒤척이는 잠에 빠지게 된다...
		IF !RAND:3
			PRINTFORMDW 그리고 갑자기 다시 벌떡 깨어난다.
			PRINTFORMDW 네 자신의 침대에 있다.
			DAILY_Lucid_Stats:9 = 62
			CALL LucidDreamTimeUp()
		ELSE
			BASE:MASTER:0 -= 300
			BASE:MASTER:尿意 += RAND:120
			BASE:MASTER:Poo += RAND:120
			PeeHoldExp:MASTER:0 += 5
			DAILY_Lucid_Stats:7 -= 30
		ENDIF
	CASE 2
		PRINTFORMDL 당신은 %CALLNAME:DAILY_Lucid_Chara%를 깨우고 지나가게 해달라고 거의 애원한다.
		IF RAND:MAX(1,DAILY_Lucid_Stats:7) <= 15
			$PlanePass
			PRINTFORMDW 그들은 양보하고, 너는 서둘러 떠난다.
			PRINTFORMDW 너는 좁은 비행기를 지나서 지저분한 작은 비행기 화장실로 들어가 용무를 볼 때까지 길을 찾는다.
			CALL COM_TakeClothesBeforePee(MASTER)
			IF RESULT <= 0
				CALL TOILET_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
				DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
				CALL LucidDreamTimeUp()
			ENDIF
			SIF DAILY_Lucid_Stats:1
				CALL PEESOUNDS("loc")
			SIF DAILY_Lucid_Stats:2
				CALL POOSOUNDS("loc")
			PRINTFORMDW 뭔가 그게 잘못된 기분이야...
			PRINTFORMDW 하지만 또 생각해 보면, 그저 끔찍한 작은 비행기 변기일지도 몰라.	
			DAILY_Lucid_Stats:9 = 1
			CALL LucidDreamTimeUp()
		ELSE
			CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code
			PRINTFORMDW 하지만 %HE_SHE(DAILY_Lucid_Chara)%는 그저 흐릿하게 당신을 깜빡인다.
			PRINTFORMW 「안 보여? 안전벨트 경고등이?」
			PRINTFORMW 「그건 안전벨트를 계속 착용하라는 뜻이야. 예외는 없어.」
			RESETCOLOR
			PRINTFORMDW 더 이상 말없이 당신은 고개를 돌려 다른 쪽을 향하고 다시 잠이 든다.
		ENDIF
ENDSELECT
;----------------------------
;Input names
;----------------------------

@LUCID_DREAM_INPUT_NAMES_7(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
	CASE 0
		SIF BASE:MASTER:0 >= 50+500
			DAILY_Lucid_ComName '= "참는다(50 STA)"
	CASE 1
		SIF BASE:MASTER:0 >= 200+500
			DAILY_Lucid_ComName '= "참는다(200 STA)"
	CASE 2
		DAILY_Lucid_ComName '= @"%CALLNAME:DAILY_Lucid_Chara%에게 지나가도록 허락해라"
	CASE 9
		DAILY_Lucid_ComName '= @"낮잠을 자다"
ENDSELECT
RETURNF DAILY_Lucid_ComName
;----------------------------
;Status page for Carry Status
;----------------------------

@LUCID_DREAM_INPUT_STATUS_7
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"자리에서 일어서기 전까지의 시간: {DAILY_Lucid_Stats:7} 분"
RETURNF DAILY_Lucid_InfoTab
