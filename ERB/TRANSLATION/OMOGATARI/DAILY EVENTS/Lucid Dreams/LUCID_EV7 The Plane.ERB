;----------------------------
;Info for the dream
;======================
;DAILY_Lucid_Name: Name for the dream
;DAILY_Lucid_Desc: A description of the dream
;DAILY_Lucid_Type: Type of dream:
	;Normal
	;Nightmare
	;Sex
	;Pee
;DAILY_Lucid_CanDo: Requirements to do the dream
;DAILY_Lucid_NormalCom: Can do normal commands
;DAILY_Lucid_InterruptCom: What commands should be intercepted
;DAILY_Lucid_EndingAvailable: What endings are available.
;DAILY_Lucid_CanGiveUp: Whether you can give up in the dream (Bit System)
	;Pee: Bit 0 = Unpadded; Bit 1 = Diapered
;----------------------------
@LUCID_DREAM_INFO_7
#FUNCTION
DAILY_Lucid_Name '= "The Plane"
DAILY_Lucid_Desc '= "You're in the middle of a plane ride while you suddenly get the need to go."
DAILY_Lucid_Type '= "Pee"
DAILY_Lucid_CanDo = 1
DAILY_Lucid_NormalCom = 0
DAILY_Lucid_InterruptCom '= "400/405/811/"
DAILY_Lucid_EndingAvailable '= "1/10/12/20/22/62"
DAILY_Lucid_CanGiveUp = 2

;----------------------------
;When you start up a dream
;----------------------------
@LUCID_DREAM_START_7
PRINTFORMDW You opens your eyes to find yourself in a plane seat.
PRINTFORMDW There's a window to your right, and a sleeping %CALLNAME:DAILY_Lucid_Chara% to the left, the seatbelt sign glowing overhead.
PRINTFORMDW And a painful, throbbing pressure in your \@ DAILY_Lucid_Stats:1 ? bladder #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? bowels #\@.
PRINTFORMDW You don't remember where you're going or why, but you have to GO!
BASE:MASTER:0 = MAXBASE:MASTER:0
DAILY_Lucid_Stats:7 = RAND:100
CALLF TP(DAILY_Lucid_Chara)
TARGET = DAILY_Lucid_Chara
TARGET:1 = DAILY_Lucid_Chara
CFLAG:DAILY_Lucid_Chara:睡眠 = 1

TCVAR:DAILY_Lucid_Chara:906 = 1
CFLAG:DAILY_Lucid_Chara:同室 = 1	
IF DAILY_Lucid_Stats:1
CALLF PEEME(MASTER, 4)
ENDIF
IF DAILY_Lucid_Stats:2
CALLF POOME(MASTER, 4)
ENDIF
PRINTFORML

;----------------------------
;Ending of the dream
;Can be good or bad
;----------------------------
@LUCID_DREAM_END_7

;When a command ends
@LUCID_DREAM_TURN_7
IF DAILY_Lucid_Stats:7 <= 0
	PRINTFORMDW It takes an eternity, but eventually the seatbelt sign turns off.
	CALL COLORMESSAGE(@"You can now go to the toilet!",C_GREEN,2,1)	
ELSEIF BASE:MASTER:0 <= 0 || (PeeBarstage(MASTER) >= 7 && DAILY_Lucid_Stats:1) || (PooBarStage(MASTER) >= 7 && DAILY_Lucid_Stats:2)
	$PlaneLose
	PRINTFORMDW You struggle for a while longer, but in the end it doesn't matter how much you grind against the seat or how desperately you mutter to yourself...
	PRINTFORMDW You're at your limit.
	CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")	
	PRINTFORMDW Thankfully, the pitter-patter of your \@ DAILY_Lucid_Stats:1 ? %FSYN("pee:n")% #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? %FSYN("poo:n")% #\@ on the plane floor goes unnoticed...
	PRINTFORMDW For now...
	DAILY_Lucid_Stats:9 = LucidDreamLoser()
	CALL LucidDreamTimeUp()
ENDIF	

;----------------------------
;Results for clicking on selections
;----------------------------
@LUCID_DREAM_INPUT_7(nInput)
#DIM nInput
SELECTCASE nInput
	CASE 0
	PRINTFORMDW You endure the temptation of release
	BASE:MASTER:0 -= 50
	BASE:MASTER:尿意 += RAND:75
	BASE:MASTER:Poo += RAND:75
	PeeHoldExp:MASTER:0 += 1
	DAILY_Lucid_Stats:7 -= 5
	CASE 1
	PRINTFORMDW You frantically endure the temptation of release
	BASE:MASTER:0 -= 200
	BASE:DAILY_Lucid_Chara:尿意 += RAND:75
	BASE:DAILY_Lucid_Chara:Poo += RAND:75
	PeeHoldExp:MASTER:0 += 2
	DAILY_Lucid_Stats:7 -= 5	
CASE 9
	PRINTFORMDW Maybe the seatbelt sign will be turned off by the time you wake up again.
	PRINTFORMDW It takes some shifting and shuffling to take the weight off of your \@ DAILY_Lucid_Stats:1 ? bladder #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? bowels #\@ enough to get comfortable, but eventually you manage to drift off to a fitful sleep...
	IF !RAND:3
	PRINTFORMDW And suddenly snap awake again.
	PRINTFORMDW Back in your own bed.
	DAILY_Lucid_Stats:9 = 62
	CALL LucidDreamTimeUp()
	ELSE
	BASE:MASTER:0 -= 300
	BASE:MASTER:尿意 += RAND:120
	BASE:MASTER:Poo += RAND:120
	PeeHoldExp:MASTER:0 += 5
	DAILY_Lucid_Stats:7 -= 30
	ENDIF
CASE 2
	PRINTFORMDL You shake %CALLNAME:DAILY_Lucid_Chara% awake and practically beg them to let you pass.
	IF RAND:MAX(1,DAILY_Lucid_Stats:7) <= 15
	$PlanePass
	PRINTFORMDW They oblige, and you hurry off.
	PRINTFORMDW You make your way through the narrow plane until you can slip into the dingy little airplane bathroom and relieve yourself.
	CALL COM_TakeClothesBeforePee(MASTER)
	IF RESULT <= 0
	CALL TOILET_OMORASHI(MASTER,DAILY_Lucid_Stats:1,DAILY_Lucid_Stats:2,1)
	DAILY_Lucid_Stats:9 = LucidDreamLoser(2)
	CALL LucidDreamTimeUp()
	ENDIF
	SIF DAILY_Lucid_Stats:1
	CALL PEESOUNDS("loc")
	SIF DAILY_Lucid_Stats:2
	CALL POOSOUNDS("loc") 			
	PRINTFORMDW Something about it feels wrong...
	PRINTFORMDW But then again, that may just be the horrible little plane toilet.	
	DAILY_Lucid_Stats:9 = 1
	CALL LucidDreamTimeUp()
	ELSE
	CALL SET_KOJO_COLOR(DAILY_Lucid_Chara) ;custom code	
	PRINTFORMDW But %HE_SHE(DAILY_Lucid_Chara)% just blearily blinks at you.
	PRINTFORMW 「Can't you see the seatbelt sign?」
	PRINTFORMW 「That means the seatbelt stays on. No exceptions.」
	RESETCOLOR
	PRINTFORMDW Without a further word, you turn your head to the other side and go back to sleep.
	ENDIF
ENDSELECT

;----------------------------
;Input names
;----------------------------
@LUCID_DREAM_INPUT_NAMES_7(nCom)
#FUNCTIONS
#DIM nCom
VARSET DAILY_Lucid_ComName
SELECTCASE nCom
CASE 0
	SIF BASE:MASTER:0 >= 50+500
	DAILY_Lucid_ComName '= "Hold it (50 STA)"
CASE 1
	SIF BASE:MASTER:0 >= 200+500
	DAILY_Lucid_ComName '= "Hold it (200 STA)"
CASE 2
	DAILY_Lucid_ComName '= @"Beg %CALLNAME:DAILY_Lucid_Chara% to let you pass"
CASE 9
	DAILY_Lucid_ComName '= @"Take a nap"
ENDSELECT
RETURNF DAILY_Lucid_ComName

;----------------------------
;Status page for Carry Status
;----------------------------
@LUCID_DREAM_INPUT_STATUS_7
#FUNCTIONS
DAILY_Lucid_InfoTab '= @"Time before you can get out of your seat: {DAILY_Lucid_Stats:7} minutes"
RETURNF DAILY_Lucid_InfoTab

;----------------------------
;Spurting
;----------------------------
;@LUCID_DREAM_SPURT_7

;----------------------------
;Giving up
;----------------------------
;@LUCID_DREAM_GIVEUP_7

;----------------------------
;Giving up but relieving self in diaper
;----------------------------
@LUCID_DREAM_GIVEUP_DIAPER_7
PRINTFORMDW You already know you aren't going to make it for another minute.
PRINTFORMDW You've grown familiar with the feeling of your \@ DAILY_Lucid_Stats:1 ? bladder #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? bowels #\@ giving up on you, and this is it.
PRINTFORMDW As you press your hands against your %FSYN("crotch")% to stave off the inevitable, your fingers suddenly encounter soft padding
PRINTFORMDW Are you... wearing a diaper?
PRINTFORMDW You lift your shirt and take a peek and indeed.
PRINTFORMDW There's a diaper waistband poking out of your pants.
PRINTFORMDW And that little moment of distraction is already enough to overcome your feeble control...
CALL PlayAccidentSound(MASTER,DAILY_Lucid_Stats:1,"loc",DAILY_Lucid_Stats:2,"loc")	
PRINTFORMDW You're \@ DAILY_Lucid_Stats:1 ? peeing #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? pooping #\@, absolutely \@ DAILY_Lucid_Stats:1 ? flooding #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? filling #\@ you diaper.
PRINTFORMDW It's gonna be a long, \@ DAILY_Lucid_Stats:1 ? wet #\@\@ DAILY_Lucid_Stats:1 && DAILY_Lucid_Stats:2 ?%" "%and%" "%#\@\@ DAILY_Lucid_Stats:2 ? messy #\@ flight... but at least nobody has to know.	
DAILY_Lucid_Stats:9 = 20
CALL LucidDreamTimeUp()