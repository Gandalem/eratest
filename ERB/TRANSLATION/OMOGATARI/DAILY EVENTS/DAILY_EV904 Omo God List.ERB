CASE 1
		LOCALS '= @"「You'll have to pay the price this time too!」/"
		LOCALS += @"「Well then... let's go」"
		CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
		WAIT
