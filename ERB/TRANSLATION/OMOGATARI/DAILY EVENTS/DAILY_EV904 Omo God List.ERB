	LOCALS += @"「Let it all out comfortably...」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り:照れ", 109, 0)
	WAIT
	CALL CAUSE_OMORASHI(MASTER,nPee,nScat)
	PRINTL
	CALL SET_KOJO_COLOR(109)
	LOCALS '= @"「♪ Yes, yes, yes, you're still a good %PeeAndPoo(Can_Accident(MASTER,1,0),Can_Accident(MASTER,2,0),"bedwetter","bedmesser")%... ♪」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常:照れ", 109, 0)
	WAIT
	IF IsPadded(MASTER,)
	LOCALS '= @"「I don't like the fact that you're using %PLURALIZER(PeeProtectType(MASTER,2))% to protect yourself, but...」/"
	LOCALS += @"「It's still good enough for me... seeing it swell with your %PeeAndPoo(Can_Accident(MASTER,1,0),Can_Accident(MASTER,2,0),"pee","poop")%...」"
	ELSE
	LOCALS '= @"「Tomorrow you'll have to clean up...」/"
	LOCALS += @"「It's your fault for not taking precautions against %PeeAndPoo(Can_Accident(MASTER,1,0),Can_Accident(MASTER,2,0),"bedwetting","bedmessing")%.」/"
	LOCALS += @"「I'd love to physically move the futon out of the way so I could see everything, but I can only manipulate things in dreams.」"
	ENDIF
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り:照れ", 109, 0)
	WAIT
	CALL CUTSCENESPEAK_NAS(@"「Well, I guess I'll call it a night, little %PeeAndPoo(Can_Accident(MASTER,1,0),Can_Accident(MASTER,2,0),"bedwetter","bedmesser")%」", "通常", 109, 0)
