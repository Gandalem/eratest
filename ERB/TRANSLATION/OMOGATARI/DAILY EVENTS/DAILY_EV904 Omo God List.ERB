@EV904_GOD_5
EV904_GOD_NAME '= @"%NAME:109%"
EV904_GOD_COLOR = C_AQUA
EV904_GOD_TAGS '= "accident/"

@EV904_GOD_START_5
CALL ACCIDENT_TRIVIA_START
CALL ASK_YN(@"다른 방법으로", "평소처럼 선명한 꿈을 꾸어라")
SELECTCASE RESULT
	CASE 0
		CALL ACCIDENT_TRIVIA_EXPLAIN
	CASE 1
		LOCALS '= @"「이번에도 대가를 치러야 할 거야!」"
		LOCALS += @"「자, 그럼 가보지」"
		CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 109, 0)
		WAIT
		CALL LucidDream("Pee",Can_Accident(MASTER,1,0),Can_Accident(MASTER,2,0))
ENDSELECT

@EV904_GOD_JUDGE_5(ARGS)
IF FINDELEMENT(EV904_ANSWERS,ARGS) > -1
	PLAYSOUND "se/正解.wav"
	FONTBOLD
	SETCOLOR C_GREEN
	PRINTFORMW 정답이다!
	RESETCOLOR
	FONTREGULAR
	PRINTL
	LOCALS '= @"「젠장! 네 말이 맞아!」"
	LOCALS += @"「제대로 했다면 용서해 주겠다고 약속했어」"
	LOCALS += @"「음, 잘 자요 %CALLNAME:MASTER%, 달콤한 꿈 꾸고 시원하게 잠들어요!」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
	WAIT
	RETURN
ELSE
	PLAYSOUND "se/間違い.wav"
	FONTBOLD
	SETCOLOR C_RED
	PRINTFORMW 틀린 대답이다!
	RESETCOLOR
	FONTREGULAR
	PRINTL
	CALL SET_KOJO_COLOR(109)
	LOCALS '= @"「정말 죄송합니다, %CALLNAME:MASTER%...」/"
	LOCALS += @"「편안하게 전부 내보내라...」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り:照れ", 109, 0)
	WAIT
	CALL CAUSE_OMORASHI(MASTER,nPee,nScat)
	PRINTL
	CALL SET_KOJO_COLOR(109)
	LOCALS '= @"「♪ 그래, 응, 응, 너는 여전히 좋은 %PeeAndPoo(Can_Accident(MASTER,1,0),Can_Accident(MASTER,2,0),"bedwetter","bedmesser")%... ♪」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常:照れ", 109, 0)
	WAIT
	IF IsPadded(MASTER,)
		LOCALS '= @"「네가 자신을 보호하기 위해 %PLURALIZER(PeeProtectType(MASTER,2))%를 사용하고 있다는 사실이 마음에 들지 않지만...」"
		LOCALS += @"「나한테는 여전히 충분히 좋아... 네 %PeeAndPoo(Can_Accident(MASTER,1,0),Can_Accident(MASTER,2,0),"pee","poop")%가 부풀어 오르는 걸 보는 게...」"
	ELSE
		LOCALS '= @"「내일은 네가 치워야 할 거야...」"
		LOCALS += @"「%PeeAndPoo(Can_Accident(MASTER,1,0),Can_Accident(MASTER,2,0),"bedwetting","bedmessing")%에 대비하지 않은 것은 네 잘못이다.」/"
		LOCALS += @"「나는 모든 것을 볼 수 있도록 이 요를 물리적으로 치고 싶은 마음이지만 꿈속에서만 사물을 조종할 수 있다.」"
	ENDIF
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り:照れ", 109, 0)
	WAIT
	CALL CUTSCENESPEAK_NAS(@"「음, 오늘은 이만 자야겠어, 작은 %PeeAndPoo(Can_Accident(MASTER,1,0),Can_Accident(MASTER,2,0),"bedwetter","bedmesser")%」", "通常", 109, 0)
ENDIF

@ACCIDENT_TRIVIA_START
CALL SET_KOJO_COLOR(109)
LOCALS '= @"「또 시작이군 %CALLNAME:MASTER%시여!」//"
LOCALS += @"평소처럼 내 영역으로 너를 데려갈 수도 있겠지……"
LOCALS += @"「하지만 오늘은 너에게 관대하게 대해주려고 해.」"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
WAIT

@ACCIDENT_TRIVIA_EXPLAIN
SIF InTrain == 3
	CALLF PANTY_REWORK_CHANGE(MASTER,DAILY_Lucid_Stats:8)
LOCALS '= @"「자, 이번에는 간단한 퀴즈를 해보도록 하지.」"
LOCALS += @"「하지만 네가 자고 있으니, 네 잠재의식이 대답하게 해 주지.」"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
WAIT
LOCALS '= @"「정확하게 대답한다면, 나는 특별히 아무것도 할 필요가 없을 거야.」"
LOCALS += @"「오늘 밤은 그냥 넘어가 주지.」"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 109, 0)
WAIT
LOCALS '= @"「하지만... 만약 네가 틀리게 대답한다면...」"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り:照れ", 109, 0)
WAIT
PRINTL
LOCALS '= @"「자, 이제 질문이다.」"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
WAIT
PRINTL
IF Can_Accident(MASTER,1,0)
	CALLF PEEME(MASTER, 7)
ENDIF
IF Can_Accident(MASTER,2,0)
	CALLF POOME(MASTER, 7)
ENDIF
;shinki

@EV904_GOD_6
EV904_GOD_NAME '= NAME:102
EV904_GOD_COLOR = C_AQUA
EV904_GOD_TAGS:0 '= "accident/"
;variations
;diaper check
;quiz
;dream

@EV904_GOD_START_6
CALL SET_KOJO_COLOR(102)
LOCALS '= @"「안녕, 나의 작은 %CALLNAME:MASTER%아.」//"
LOCALS += @"지금 자고 있는 것 같지만, 내 작은 존재를 확인하지 않을 수가 없네."
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 102, 0)
PRINTFORMDW %CALLNAME:102%의 목소리는 언제나 다정하다.
SELECTCASE RAND:1
	CASE 0
		CALL SET_KOJO_COLOR(102)
		LOCALS '= @"「보호 장비를 착용했나?」"
		LOCALS += @"「밤 동안 나의 작은 %PRINT_MALE("boy", MASTER)%을 안전하게 지키기 위해서야.」"
		LOCALS += @"「나쁜 %PRINT_MALE("boy", MASTER)%들은 다음에 무슨 일이 일어날지 알고 있다...」"
		CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 102, 0)
		PRINTFORMDW 당신의 속옷이 만져지고 문질러지는 것을 느낀다. 거의 %HES_SHES(102)%가 기저귀 확인을 하는 것 같다.
		IF IsPadded(MASTER)
			IF DiapeCharges:MASTER:0 > MAXBASE:MASTER:4+1000 && DiapePooCharges:MASTER:0 > MAXBASE:MASTER:17+1000
				CALL SET_KOJO_COLOR(102)
				LOCALS '= @"「좋은 %PRINT_MALE("boy", MASTER)%입니다.」"
				LOCALS += @"당신은 사고로부터 자신을 보호하는 두꺼운 완충층을 가지고 있다."
				CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 102, 0)
				PRINTFORMDW %CALLNAME:102%은(는) 두꺼운 깨끗한 기저귀를 차고 매우 행복해한다.
			ELSEIF DiapeCharges:MASTER:1 > MAXBASE:MASTER:4+1000 && DiapePooCharges:MASTER:1 > MAXBASE:MASTER:17+1000
				CALL PRINT_GP("W", @"문지르는 소리가 축축하게 철퍽거리는 소리를 내고, 당신의 사고 냄새가 공기를 가득 채운다.")
				CALL SET_KOJO_COLOR(102)
				LOCALS '= @"당신은 자신의 더러움 속에 앉아 있는 것을 좋아하겠지, 그렇지? 하지만 어느 시점에서는 변화가 필요해, 특히 잠자리에 들기 전에는 말이야."
				LOCALS += @"「당신의 %PeeProtectType(MASTER,2)%는 정말 지독하고 가득해 보인다. 그리고 지금은 그것을 대신 바꿔줄 수가 없어.」/"
				LOCALS += @"「또 다른 ... 에피소드를 감당하지 못할지도 모른다.」/"
				CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 102, 0)
				PRINTFORMDW %CALLNAME:102%은/는 심하게 더러워진 기저귀를 차고 당신과 행복한 소리를 낸다.
			ELSE
				CALL SET_KOJO_COLOR(102)
				LOCALS '= @"「어이쿠...」//"
				CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 102, 0)
				PRINTFORMDW %CALLNAME:102%는 네가 지금 입고 있는 패딩에 분명 불만을 가지고 있다.
				CALL SET_KOJO_COLOR(102)
				LOCALS '= @"「이걸 기저귀라고 부를 수 없어, 응?」/"
				LOCALS += @"「패딩이 거의 없잖아!」 /"
				LOCALS += @"「자기야, 낮잠 시간까지 이걸로 버티려면 훨씬 더 많이 필요할 거야.」"
				LOCALS += @"「이것은 한 번 사용하면 새는 것 같다.」"
				CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 102, 0)
				WAIT
			ENDIF
		ELSE
			CALL SET_KOJO_COLOR(102)
			LOCALS '= @"「안 돼 안 돼 안 돼...」//"
			CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 102, 0)
			PRINTFORMDW %CALLNAME:102%는 당신이 현재 입고 있는 패딩 부족에 분명히 불만을 품는다.
			CALL SET_KOJO_COLOR(102)
			LOCALS '= @"「보호 장비를 착용하지 않은 것 같군요。」/"
			LOCALS += @"「사고를 당한다면 아깝겠군.」"
			IF CAN_ACCIDENT(MASTER,2)
				LOCALS += @"「따뜻하고 걸쭉한 지저분함이 당신의 속옷 뒤쪽에 쌓여, 그것이 닿는 모든 것을 통제 불능의 %CS_JELLYORPOO()%로 얼룩지게 한다...」/"
			ELSE
				LOCALS += @"「뜨겁고 따뜻한 소변이 침대를 적시면서 아이 방처럼 냄새가 난다...」"
			ENDIF
			CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 102, 0)
			WAIT
		ENDIF
		CALL PRINT_GPC("W", @"「선물 하나 남겨둘게. 내일 가져가도 돼.」",102)
		CALL PRINT_GPC("W", @"「잘 자렴, 나의 작은 달콤한 %CALLNAME:MASTER%아.」",102)
		IF CAN_ACCIDENT(MASTER,2)
			CALL PRINT_GPC("W", @"「코프로다인...」",102)
		ELSEIF CAN_ACCIDENT(MASTER,1)
			CALL PRINT_GPC("W", @"「오우레인다네...」",102)
		ELSE
			CALL PRINT_GPC("W", @"「음, 선물 하나 줄 거라고 했었는데, 그걸 잃어버렸네.」",102)
			CALL PRINT_GPC("W", @"「그것에 대해 미안합니다.」",102)
		ENDIF
		CALL CAUSE_OMORASHI(MASTER,CAN_ACCIDENT(MASTER,1), CAN_ACCIDENT(MASTER,2))
	CASE 1
		;dream
		;WIP
		CALL SET_KOJO_COLOR(102)
		LOCALS '= @"「좋은 밤을 보내길 바라요.」"
		LOCALS += @"「.」/"
		LOCALS += @"「나쁜 %PRINT_MALE("boy", MASTER)%들은 다음에 무슨 일이 일어날지 알고 있다...」"
		CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 102, 0)
		PRINTFORMDW 당신의 속옷이 만져지고 문질러지는 것을 느낀다. 거의 %HES_SHES(102)%가 기저귀 확인을 하는 것 같다.
		CALL PRINT_GPC("W", @"「잘 자렴, 나의 작은 달콤한 %CALLNAME:MASTER%아.」",102)
		CALL PRINT_GPC("W", @"「오늘 밤 생생한 꿈을 꾸게 될 것이다...」",102)
		CALL PRINT_GPC("W", @"「아주 %PeeAndPoo(CAN_ACCIDENT(MASTER,1),CAN_ACCIDENT(MASTER,2),"golden","mushy")%한 꿈...」",102)
		CALL LucidDream("Pee",Can_Accident(MASTER,1,0),Can_Accident(MASTER,2,0))
ENDSELECT

