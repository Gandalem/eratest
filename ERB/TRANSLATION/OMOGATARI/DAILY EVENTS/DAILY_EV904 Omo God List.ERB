;variations
;diaper check
;quiz
;dream
@EV904_GOD_START_6
CALL SET_KOJO_COLOR(102)
LOCALS '= @"「Hello my little %CALLNAME:MASTER%.」//"
LOCALS += @"「I see that you're sleeping right now, but I can't help but to check on my little one.」/"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 102, 0)
PRINTFORMDW %CALLNAME:102%'s voice is caring as always.


SELECTCASE RAND:1
CASE 0
	CALL SET_KOJO_COLOR(102)
	LOCALS '= @"「Have you been wearing your protection?」/"
	LOCALS += @"「Its to keep my little %PRINT_MALE("boy", MASTER)% safe during the night.」/"
	LOCALS += @"「Bad %PRINT_MALE("boy", MASTER)%s know what's going to happen next..」/"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 102, 0)
	PRINTFORMDW You feel your underwear being touched and rubbed, almost like %HES_SHES(102)% doing a diaper check.
	IF IsPadded(MASTER)
		IF DiapeCharges:MASTER:0 > MAXBASE:MASTER:4+1000 && DiapePooCharges:MASTER:0 > MAXBASE:MASTER:17+1000
			CALL SET_KOJO_COLOR(102)
			LOCALS '= @"「Good %PRINT_MALE("boy", MASTER)%.」/"
			LOCALS += @"「You got a thick layer of padding protecting you from your accidents.」/"
			CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 102, 0)
			PRINTFORMDW %CALLNAME:102% sound very happy with you in a thick and clean diaper.
		ELSEIF DiapeCharges:MASTER:1 > MAXBASE:MASTER:4+1000 && DiapePooCharges:MASTER:1 > MAXBASE:MASTER:17+1000
			CALL PRINT_GP("W", @"The rubbing causes a wet sloshing sound, the smell of your accidents filling the air.")
			CALL SET_KOJO_COLOR(102)
			LOCALS '= @"「You love sitting in your filth, right? But you need a change at some point, especially before bedtime.」/"
			LOCALS += @"「Your %PeeProtectType(MASTER,2)%'s looks really stinky and full. And I can't change it for you at this moment.」/"
			LOCALS += @"「It may not be able to handle another... episode.」/"
			CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 102, 0)
			PRINTFORMDW %CALLNAME:102% sound happy with you in a thick diaper, despite it being badly soiled.
		ELSE
			CALL SET_KOJO_COLOR(102)
			LOCALS '= @"「Uh oh...」//"
			CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 102, 0)
			PRINTFORMDW %CALLNAME:102% is clearly discontent with the padding you're currently wearing.
			CALL SET_KOJO_COLOR(102)
			LOCALS '= @"「You can't call this a diaper, huh?」/"
			LOCALS += @"「There's barely any padding at all!」/"
			LOCALS += @"「Honey, you'll need way more than this to last naptime.」/"
			LOCALS += @"「This thing looks like it'll leak after one use.」/"
			CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 102, 0)
			WAIT
		ENDIF
	ELSE
		CALL SET_KOJO_COLOR(102)
		LOCALS '= @"「No no no...」//"
		CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り", 102, 0)
		PRINTFORMDW %CALLNAME:102% is clearly discontent with the lack of padding you're currently wearing.
		CALL SET_KOJO_COLOR(102)
		LOCALS '= @"「It seems that you aren't wearing any protection.」/"
		LOCALS += @"「It would be a shame if you were to have an... accident.」/"
		IF CAN_ACCIDENT(MASTER,2)
		LOCALS += @"「The warm mushy mess piles at the back of your underwear, staining everything it touches with an incontinent %CS_JELLYORPOO()%...」/"
		ELSE
		LOCALS += @"「As the hot warm pee soaks through your bed, making it smell like a child's room...」/"
		ENDIF
		CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 102, 0)
		WAIT
	ENDIF
	CALL PRINT_GPC("W", @"「I'll be leaving you a gift. You can pick it up tomorrow.」",102)
	CALL PRINT_GPC("W", @"「Night night, my little sweet %CALLNAME:MASTER%.」",102)
	IF CAN_ACCIDENT(MASTER,2)
		CALL PRINT_GPC("W", @"「Coprodyne...」",102)
	ELSEIF CAN_ACCIDENT(MASTER,1)
		CALL PRINT_GPC("W", @"「Oureindyne...」",102)
	ELSE
		CALL PRINT_GPC("W", @"「Well, I said I was going to give you a gift, but I lost it.」",102)
		CALL PRINT_GPC("W", @"「Sorry about that.」",102)
	ENDIF
	CALL CAUSE_OMORASHI(MASTER,CAN_ACCIDENT(MASTER,1), CAN_ACCIDENT(MASTER,2))
CASE 1
	;dream
	;WIP
	CALL SET_KOJO_COLOR(102)
	LOCALS '= @"「I want to wish you a good night.」/"
	LOCALS += @"「.」/"
	LOCALS += @"「Bad %PRINT_MALE("boy", MASTER)%s know what's going to happen next..」/"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 102, 0)
	PRINTFORMDW You feel your underwear being touched and rubbed, almost like %HES_SHES(102)% doing a diaper check.

	CALL PRINT_GPC("W", @"「Night night, my little sweet %CALLNAME:MASTER%.」",102)
	CALL PRINT_GPC("W", @"「You will have a vivid dream tonight...」",102)
	CALL PRINT_GPC("W", @"「A very %PeeAndPoo(CAN_ACCIDENT(MASTER,1),CAN_ACCIDENT(MASTER,2),"golden","mushy")% dream...」",102)
	CALL LucidDream("Pee",Can_Accident(MASTER,1,0),Can_Accident(MASTER,2,0))
ENDSELECT


