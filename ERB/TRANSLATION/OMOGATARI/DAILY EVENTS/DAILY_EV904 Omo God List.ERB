@ACCIDENT_TRIVIA_START
CALL SET_KOJO_COLOR(109)
LOCALS '= @"「Here we go again %CALLNAME:MASTER%!」//"
LOCALS += @"「I could take you to my domain as usual...」/"
LOCALS += @"「But I think I'll go easy on you today.」"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
WAIT

@ACCIDENT_TRIVIA_EXPLAIN
SIF InTrain == 3
CALLF PANTY_REWORK_CHANGE(MASTER,DAILY_Lucid_Stats:8)
LOCALS '= @"「Well, we'll do a quick quiz this time.」/"
LOCALS += @"「But since you're sleeping, I'll let your subconscious answer.」"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
WAIT
LOCALS '= @"「If you answer correctly, I won't have to do anything in particular.」/"
LOCALS += @"「I'll let you off the hook for the rest of the night.」"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "笑顔", 109, 0)
WAIT
LOCALS '= @"「But... if you answer incorrectly...」/"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "怒り:照れ", 109, 0)
WAIT
PRINTL
LOCALS '= @"「Now, for the question.」"
CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
WAIT
PRINTL
IF Can_Accident(MASTER,1,0)
CALLF PEEME(MASTER, 7)
ENDIF
IF Can_Accident(MASTER,2,0)
CALLF POOME(MASTER, 7)
ENDIF

