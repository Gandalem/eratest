@EV904_GOD_JUDGE_5(ARGS)
IF FINDELEMENT(EV904_ANSWERS,ARGS) > -1
	PLAYSOUND "se/正解.wav"		
	FONTBOLD
	SETCOLOR C_GREEN
	PRINTFORMW CORRECT ANSWER!
	RESETCOLOR
	FONTREGULAR
	PRINTL
	LOCALS '= @"「Damn! You're right!」/"
	LOCALS += @"「I promised I'll let you off the hook if you got it right」/"
	LOCALS += @"「Well, good night %CALLNAME:MASTER%, may you have sweet dreams and a dry sleep!」"
	CALL CUTSCENESPEAK_NAS(@"%LOCALS%", "通常", 109, 0)
	WAIT
	RETURN
ELSE
