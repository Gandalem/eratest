@DAILY_INFO_EV920
#FUNCTION
DAILY_INFO_NAME '= @"Sadistic Storyteller"
DAILY_INFO_DESC '= @"Storyteller events akin to Rimworld"
DAILY_INFO_TYPE '= @"Trivial"

@DAILY_CONDITION_EV920

RETURN -1

[IF_NDEBUG]
SIF RAND:(5) > 0
	RETURN -1
[ENDIF]

CALL DAILY_EV920
RETURN 1

@DAILY_EV920
#DIM nPick
#DIM nRoll
{
#DIMS CONST IncidentNames = "Raid", "Cargo pods", "Psychic soothe", "Psychic drone", "Blight", "Disease", "Solar flare", "Meteorite"
}
nPick = RAND:VARSIZE("IncidentNames")
nRoll = RAND:5+1

[IF_DEBUG]
DO
CALL PRINT_RAINBOWL(@"Sadistic Storyteller (ID: 920): Debug Menu")
PRINTFORML What incident do you want to start?

FOR LOCAL,0, VARSIZE("IncidentNames")
PRINTFORML [%TOSTR(LOCAL),3%] - %IncidentNames:LOCAL%
NEXT
PRINTFORML [999] - Get me out of here!!
INPUT
SELECTCASE RESULT
	CASE 0 TO VARSIZE("IncidentNames")
		nPick = RESULT
		BREAK
	CASE 999
		BREAK
ENDSELECT		
LOOP 1
[ENDIF]

SELECTCASE nPick
CASE 0
PRINTFORML A group of solders from [FACTION NAME] have arrived nearby.
PRINTFORMW They are attacking immediately
CASE 1
PRINTFORML You have detected a cluster of cargo pods crashing near your room
PRINTFORMW Perhaps you'll find something useful in the wreckage.
DO
LOCAL = RAND:999
SIF ITEMNAME_TR(LOCAL) != ""
	BREAK

LOOP 1

	CALL COLORMESSAGE(@"Got {nRoll} %ITEMNAME_TR(LOCAL)%", C_YELLOW, 2)
	ITEM:LOCAL = MAX(ITEM:LOCAL+nRoll, 99)
CASE 7
nRoll = RAND(10,30)

DO
LOCAL = RAND(600,647)
SIF ITEMNAME_TR(LOCAL) != ""
	BREAK

LOOP 1

PRINTFORML A large meteorite has struck ground in the area. 
PRINTFORMW It has left behind a lump of %ITEMNAME_TR(LOCAL)%.

CALL COLORMESSAGE(@"Got {nRoll} %ITEMNAME_TR(LOCAL)%", C_YELLOW, 2)
ITEM:LOCAL = MAX(ITEM:LOCAL+nRoll, 99)
ENDSELECT