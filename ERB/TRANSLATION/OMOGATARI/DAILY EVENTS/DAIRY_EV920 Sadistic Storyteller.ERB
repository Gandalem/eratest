; Modular ERB: OMOGATARI/DAILY EVENTS/DAIRY_EV920 Sadistic Storyteller.ERB

@DAILY_INFO_EV920
#FUNCTION
DAILY_INFO_NAME '= @"새디스트 스토리텔러"
DAILY_INFO_DESC '= @"스토리텔러 이벤트는 림월드와 유사하다."
DAILY_INFO_TYPE '= @"사소한"

@DAILY_CONDITION_EV920
RETURN -1
[IF_NDEBUG]
SIF RAND:(5) > 0
	RETURN -1
[ENDIF]
CALL DAILY_EV920
RETURN 1

@DAILY_EV920
#DIM nPick
#DIM nRoll
#DIMS CONST IncidentNames = "Raid", "Cargo pods", "Psychic soothe", "Psychic drone", "Blight", "Disease", "Solar flare", "Meteorite"
nPick = RAND:VARSIZE("IncidentNames")
nRoll = RAND:5+1
[IF_DEBUG]
DO
CALL PRINT_RAINBOWL(@"새드 스토리텔러(ID: 920): 디버그 메뉴")
PRINTFORML 어떤 사건을 시작하고 싶으신가요?
FOR LOCAL,0, VARSIZE("IncidentNames")
PRINTFORML [%TOSTR(LOCAL),3%] - %IncidentNames:LOCAL%
NEXT
PRINTFORML [999] 나를 여기서 나가게 해줘!!
INPUT
SELECTCASE RESULT
	CASE 0 TO VARSIZE("IncidentNames")
		nPick = RESULT
		BREAK
	CASE 999
		BREAK
ENDSELECT
LOOP 1
[ENDIF]
SELECTCASE nPick
	CASE 0
		PRINTFORML [FACTION NAME]의 한 부대가 근처에 도착했다.
		PRINTFORMW 그들은 즉시 공격한다.
	CASE 1
		PRINTFORML 당신은 방 근처에 충돌하는 화물 포드 무리를 감지했다
		PRINTFORMW 잔해 속에서 유용한 것을 발견할 수도 있을 것이다
		DO
		LOCAL = RAND:999
		SIF ITEMNAME_TR(LOCAL) != ""
			BREAK
		LOOP 1
		CALL COLORMESSAGE(@"{nRoll} %ITEMNAME_TR(LOCAL)%을 얻었다.", C_YELLOW, 2)
		ITEM:LOCAL = MAX(ITEM:LOCAL+nRoll, 99)
	CASE 7
		nRoll = RAND(10,30)
		DO
		LOCAL = RAND(600,647)
		SIF ITEMNAME_TR(LOCAL) != ""
			BREAK
		LOOP 1
		PRINTFORML 넓은 운석이 해당 지역의 땅에 떨어졌다. 
		PRINTFORMW 그것은 %ITEMNAME_TR(LOCAL)%의 덩어리를 남겼다.
		CALL COLORMESSAGE(@"{nRoll} %ITEMNAME_TR(LOCAL)%을 얻었다.", C_YELLOW, 2)
		ITEM:LOCAL = MAX(ITEM:LOCAL+nRoll, 99)
ENDSELECT
