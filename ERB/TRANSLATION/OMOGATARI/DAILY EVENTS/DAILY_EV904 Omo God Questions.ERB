@EV904_QUESTION_0
EV904_TITLE '= @"Wet pants or dry pants, which do you prefer......"
EV904_TAGS '= "accident/survey/pee/poo/diaper/"
EV904_IS_LIST = 1
FOR LOCAL,0,VARSIZE("EV904_ANSWERS")
	EV904_ANSWERS:LOCAL '= TOSTR(LOCAL)
NEXT

VARSET EV904_AVALIABLE, 1
EV904_LISTS:0 '= "Wet ones"
IF !nPee
	EV904_LISTS:0 '= "Nnnh... Ummmmm...."
    EV904_AVALIABLE:0 = 0
	EV904_INVALID_REASON '= "My child... you can't do 'small' accidents"
ENDIF

EV904_LISTS:1 '= "Dry ones"
EV904_LISTS:2 '= "Messy ones, actually"
IF !nScat
	EV904_LISTS:2 '= "Um.... uh...." 
    EV904_AVALIABLE:2 = 0
	EV904_INVALID_REASON '= "My child... you can't do 'big' accidents"
ENDIF

;fourth option
VARSET LOCALS
SIF GETBIT(nPee,3)
	LOCALS += "My entire body, please:"
IF GETBIT(nPee,1) && GETBIT(nScat,2)
	LOCALS += "Both"
	SIF nOmutsu
		LOCALS += ", diapered"
	LOCALS += ":"
ENDIF
SIF nOmutsu && GETBIT(nScat,2)
	LOCALS += "A messy diaper:"
SIF nOmutsu && GETBIT(nPee,1)
	LOCALS += "A soggy diaper:"
SIF GETBIT(nScat,5)
	LOCALS += "One packed so much that it's bursting:"
	LOCALS += "If it's warm and comfy, any accident is okay!:"
	LOCALS += "An accident is inevitable..."
EV904_LISTS:3 '= SPLIT_G(LOCALS)
LOCAL = Qol_Info_Count_Array:MASTER:Qol_Count_Wetting + Qol_Info_Count_Array:MASTER:Qol_Count_Messing

IF LOCAL < 100
    EV904_AVALIABLE:3 = 0
	EV904_INVALID_REASON '= @"My child... ignore your need to go, release by habit, and you will unlock my true potential."
ENDIF

