@EV904_QUESTION_X
EV904_TITLE '= @"답할 수 있는 질문"
EV904_TAGS '= "dry/pee/poo/accident/"
EV904_ANSWERS '= TOSTR(3)

@EV904_QUESTION_0
EV904_TITLE '= @"젖은 바지 아니면 마른 바지, 어느 쪽을 선호하는가......"
EV904_TAGS '= "accident/survey/pee/poo/diaper/"
EV904_IS_LIST = 1
FOR LOCAL,0,VARSIZE("EV904_ANSWERS")
EV904_ANSWERS:LOCAL '= TOSTR(LOCAL)
NEXT
VARSET EV904_AVALIABLE, 1
EV904_LISTS:0 '= "Wet ones"
IF !nPee
	EV904_LISTS:0 '= "Nnnh... Ummmmm...."
	EV904_AVALIABLE:0 = 0
	EV904_INVALID_REASON '= "My child... you can't do 'small' accidents"
ENDIF
EV904_LISTS:1 '= "Dry ones"
EV904_LISTS:2 '= "Messy ones, actually"
IF !nScat
	EV904_LISTS:2 '= "Um.... uh...."
	EV904_AVALIABLE:2 = 0
	EV904_INVALID_REASON '= "My child... you can't do 'big' accidents"
ENDIF
;fourth option
VARSET LOCALS
SIF GETBIT(nPee,3)
	LOCALS += "온몸으로 부탁드립니다:"
IF GETBIT(nPee,1) && GETBIT(nScat,2)
	LOCALS += "둘 다"
	SIF nOmutsu
		LOCALS += ", 기저귀를 찬 채"
	LOCALS += ":"
ENDIF
SIF nOmutsu && GETBIT(nScat,2)
	LOCALS += "지저분해진 기저귀:"
SIF nOmutsu && GETBIT(nPee,1)
	LOCALS += "흠뻑 젖은 기저귀:"
SIF GETBIT(nScat,5)
	LOCALS += "터질 만큼 빵빵하게 찬 것:"
LOCALS += "따뜻하고 편안하다면 어떤 실수든 괜찮다!:"
LOCALS += "실수는 피할 수 없다..."
EV904_LISTS:3 '= SPLIT_G(LOCALS)
LOCAL = Qol_Info_Count_Array:MASTER:Qol_Count_Wetting + Qol_Info_Count_Array:MASTER:Qol_Count_Messing
IF LOCAL < 100
	EV904_AVALIABLE:3 = 0
	EV904_INVALID_REASON '= @"내 아이야... 가고 싶은 필요는 무시하고 습관에 의해 놓아주면 나의 진정한 잠재력을 해방할 수 있을 것이다."
ENDIF

