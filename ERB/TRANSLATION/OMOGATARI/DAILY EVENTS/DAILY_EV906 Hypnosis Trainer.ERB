; Modular ERB: OMOGATARI/DAILY EVENTS/DAILY_EV906 Hypnosis Trainer.ERB
;-------------------------------------------------
; DAILY_EV_906
; Night event where you can pay 20K to reassign a trait.
; Higher inteligence compared to you means a lower chance of success.
;-------------------------------------------------

@DAILY_INFO_EV906
#FUNCTION
DAILY_INFO_NAME '= @"최면 트레이너"
DAILY_INFO_DESC '= @"20K를 지불하고 특성을 재할당할 수 있는 밤 이벤트이다.\n자신보다 지능이 높으면 성공 확률이 낮아진다."
DAILY_INFO_TYPE '= @"마이너"

@DAILY_CONDITION_EV906
VARSET LOCAL
[IF_DEBUG]
LOCAL = 1
[ENDIF]
SIF MONEY < 20000
	RETURN -1
SIF !nHypno
	RETURN -1
SIF !RAND:10 || LOCAL
	CALL DAILY_EV_906
RETURN 1

@DAILY_EV_906
#DIM CHARA
#DIM NEWTRAIT
#DIM NEWVAL
#DIM PercentPass
$LOOP
PRINTFORMW 이상한 구슬을 가진 한 소녀에게 다가간다.
PRINTFORML 「야, 네가 아는 어떤 여자든 어떤 특성이라도 바꿀 수 있어.」
PRINTFORML 「단돈 \\20000만 내면 돼.」
PRINTFORML 그녀의 제안을 받아들일까?
CALL ASK_M( "제안을 수락한다", 1, "나에게 최면술의 기술을 가르쳐라", !GETBIT(TALENT:MASTER:ESP,19), "사라져라", 1 )
SELECTCASE RESULT
	CASE 0
		PRINTFORML 당신은 그녀의 제안을 정중히 거절하고 그녀를 내보낸 후 즉시 다시 잠이 들었다. 
	CASE 1
		PRINTFORML 당신은 최면 트레이너에게 자신에게 최면을 가르쳐 줄 수 있는지 묻는다.
		PRINTFORML 「후훗, 나의 비법 중 일부를 알고 싶다고?」
		PRINTFORML 「내 마법이 작동하게 만드는 것을 네가 배우게 해주지, 하지만 큰 대가를 치러야 할 거다.」
		PRINTFORML 「¥250,000은 네가 그것으로 할 수 있는 모든 것들에 대해 공정한 가격인 것 같군.」
		PRINTFORMDL 당신은 그 제안을 받아들일 건가?
		CALL ASK_M( "지불", MONEY >= 250000, "협상하다", 0, "비켜", 1 )
		SELECTCASE RESULT
			CASE 0
				CALL PAY_MONEY_YEN(250000,1)
				PRINTFORMW 당신은 이제 최면을 가졌다!
				SETBIT TALENT:MASTER:ESP, 19
				MAXBASE:MASTER:7 = MAX(MAXBASE:MASTER:7,100)
				RETURN 1
			CASE 1
			CASE 2
				PRINTFORML 제안을 철회한다.
				GOTO LOOP
		ENDSELECT
	CASE 2
		RETURN -1
ENDSELECT
$PickChara
PRINTFORML 당신이 최면 상태로 만들고 싶은 사람을 선택한다.
DRAWLINE
FOR LOCAL, 0, CHARANUM-1
IF LOCAL == MASTER
ELSEIF !IS_NAMED(LOCAL) || !CFLAG:LOCAL:面識
	CONTINUE
ENDIF
PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
NEXT
PRINTFORML
PRINTFORML
PRINTFORML [999] 취소
INPUT
CHARA = RESULT
IF INRANGE(CHARA,0,CHARANUM)
	CALL HYPNO_TALENT_REASSIGN(CHARA,1)
	SIF RESULT < 0
		GOTO PickChara
ENDIF

@HYPNO_TALENT_REASSIGN(CHARA,nPaid)
#DIM CHARA
#DIM NEWTRAIT
#DIM NEWVAL
#DIM PercentPass
#DIM nPaid
$PickTrait
IF CHARA == MASTER
	PercentPass = 100
ELSE
	PercentPass = 50 + (15*ABL:MASTER:教養) - (10*ABL:CHARA:教養)
ENDIF
PRINTFORML 당신은 %NAME:CHARA%에게 어떤 특성을 발현시키고 싶습니까?
SETCOLOR C_ORANGE
PRINTFORML 주황색으로 표시된 특성은 현재 %CALLNAME:CHARA%가 가진 것들이다.
RESETCOLOR
IF PercentPass >= 80
	SETCOLOR C_GREEN
ELSEIF PercentPass >= 50
	SETCOLOR C_YELLOW
ELSEIF PercentPass >= 30
	SETCOLOR C_ORANGE
ELSE
	SETCOLOR C_RED
ENDIF
PRINTFORM {MIN(PercentPass,100)}\% 
RESETCOLOR
PRINTFORML 성공 확률.
DRAWLINE
FOR LOCAL, 0, 999
SIF TALENT_TR(LOCAL) == ""
	CONTINUE
SELECTCASE LOCAL
	; CASE 0 TO 8, 15 TO 17, 46 TO 55, 73 TO 79, 90, 91, 100, 105, 120, 122, 132, 145, 152 TO 303, 150, 144, 142, 59, 108
	;     CONTINUE
	CASE 0 TO 8, 15 TO 17, 46 TO 55, 73 TO 79, 90, 91, 100 TO 106, 120, 122, 132, 152 TO 303, 150, 142 TO 145, 149, 59, 108
		CONTINUE
ENDSELECT
IF TALENT:CHARA:LOCAL != 0
	SETCOLOR C_ORANGE
	PRINTFORMLC [{LOCAL}] %GET_TALENTNAME_TR(LOCAL,TALENT:CHARA:LOCAL)%
ELSE
	PRINTFORMLC [{LOCAL}] %TALENT_TR(LOCAL)%
ENDIF
RESETCOLOR
NEXT
PRINTFORML
PRINTFORML
PRINTFORML [999] 취소
INPUT
NEWTRAIT = RESULT
SIF RESULT == 999
	RETURN -1
IF GET_TALENTNAME(NEWTRAIT,-1) != GET_TALENTNAME(NEWTRAIT,1) || GET_TALENTNAME(NEWTRAIT,2) != GET_TALENTNAME(NEWTRAIT,1)
	PRINTFORML 어떤 티어를 발현하고 싶은지 선택해 주세요?
	FOR LOCAL, -10, 10
	SIF GET_TALENTNAME_TR(NEWTRAIT,LOCAL) == "" && LOCAL != 0
		CONTINUE
	SIF TALENT:CHARA:NEWTRAIT == LOCAl
		SETCOLOR C_ORANGE
	PRINTFORML [{LOCAL}] - 【%GET_TALENTNAME_TR(NEWTRAIT,LOCAL)%】
	RESETCOLOR
	NEXT
	PRINTFORML
	PRINTFORML
	PRINTFORML [999] 취소
	INPUT
	SIF RESULT == 999
		GOTO PickTrait
	NEWVAL = RESULT
ELSEIF TALENT:CHARA:NEWTRAIT == 1
	NEWVAL = 0
ELSE
	NEWVAL = 1
ENDIF
LOCALS:0 = 
IF GET_TALENTNAME(NEWTRAIT,-1) != GET_TALENTNAME(NEWTRAIT,1) || GET_TALENTNAME(NEWTRAIT,2) != GET_TALENTNAME(NEWTRAIT,1)
	LOCALS:0 = 【%GET_TALENTNAME_TR(NEWTRAIT,TALENT:CHARA:NEWTRAIT)%】을 【%GET_TALENTNAME_TR(NEWTRAIT,NEWVAL)%】로 대체한다.
ELSEIF NEWVAL == 0
	LOCALS:0 = %GET_TALENTNAME_TR(NEWTRAIT,TALENT:CHARA:NEWTRAIT)%을(를) %CALLNAME:CHARA%에서 제거한다.
ELSE
	LOCALS:0 = 【%GET_TALENTNAME_TR(NEWTRAIT,NEWVAL)%】을 %CALLNAME:CHARA%에게 추가한다.
ENDIF
PRINTFORML %LOCALS:0%을/를 시도해라?
CALL ASK_YN()
SIF RESULT
	GOTO PickTrait
PRINTFORML ・
PRINTFORML ・・
PRINTFORMW ・・・
IF RAND(100) <= PercentPass
	IF NEWTRAIT == 95
		OrgasmDeny:CHARA:0 = NEWVAL
		OrgasmDenyExp:CHARA:0 = EXP_DEMAND_19(0,,CHARA)
	ELSEIF NEWTRAIT == 56
		DrugAddict:CHARA:0 = NEWVAL
		DrugExp:CHARA:0 = EXP_DEMAND_23(0,94,CHARA)
	ELSEIF NEWTRAIT == 57
		PeeHold:CHARA:0 = NEWVAL
		PeeHoldExp:CHARA:0 = EXP_DEMAND_20(0,91,CHARA)
	ELSEIF NEWTRAIT == 58
		PooHold:CHARA:0 = NEWVAL
		PooHoldExp:CHARA:0 = EXP_DEMAND_21(0,92,CHARA)
	ELSEIF NEWTRAIT == 121
		AlcoholAddict:CHARA:0 = NEWVAL
		DrinkingExp:CHARA:0 = EXP_DEMAND_22(0,93,CHARA)
	ENDIF
	TALENT:CHARA:NEWTRAIT = NEWVAL
	PRINTFORMW 성공! 
	PRINTFORML %CALLNAME:CHARA%는 이제 【%GET_TALENTNAME_TR(NEWTRAIT,NEWVAL)%】을 가지게 되었다!
ELSE
	PRINTFORMW 실패!
	IF nPaid
		PRINTFORML 「불행하게도 【%GET_TALENTNAME_TR(NEWTRAIT,NEWVAL)%】을 %CALLNAME:CHARA%에게 발현시킬 수 없었다.」
		PRINTFORML 「좀 더 똑똑해진 후에 다시 시도해 봐.」
	ENDIF
ENDIF
IF nPaid
	PRINTFORML 「제 서비스를 이용해 주셔서 감사합니다!」
	CALL PAY_MONEY_YEN(20000,2)
ENDIF
RETURN 1
