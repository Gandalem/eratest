		PRINTFORML
		SIF nBypass == 2
			RETURN
		CALL BEDWETTING_AFTER(HasPiss,HasScat)
	ENDIF
ELSE
	IF !IsAware
		PRINTFORMW 잠든 사이에, 당신은 무의식적으로 \@ HasPiss ? %FSYN("pee")% #  \@\@ HasPiss && HasScat ? %" "%and%" "% #  \@\@ HasScat ? %FSYN("poo")% #  \@ \@ EQUIP:MASTER:下半身下着２ ? 당신의 %CLOTHES_TR(PANTSNAME(EQUIP:MASTER:下半身下着２, MASTER))% # %PARSE("yourself")% \@ 하고 %BED_FUTON()%에 상당한 얼룩을 만든다.
		IF (ABL:MASTER:PeeAddict >= 5 && HasPiss) || (ABL:MASTER:PooAddict >= 5 && HasScat)
			PRINTFORMW 당신은 \@ HasPiss ? %FSYN("pee:ing")% #  \@\@ HasPiss && HasScat ? %" "%and%" "% #  \@\@ HasScat ? %FSYN("poo:ing")% #  \@ 스스로가 압도한다.
			EXP:MASTER:絶頂経験 ++
