@GETUP_FORMULA(ARG)
#FUNCTION
#DIM DYNAMIC HasPiss
#DIM DYNAMIC HasScat
#DIM DYNAMIC nChance
nChance = 40
SIF PeeBarStage(ARG) >= 3
	HasPiss = 1
SIF PooBarStage(ARG) >= 3
	HasScat = 1
SIF !HasPiss && !HasScat
	RETURNF 0
SIF HasPiss
	nChance = nChance - -(PeeHold:ARG:2*15)
SIF HasScat
	nChance = nChance - -(PooHold:ARG:2*15)
RETURNF nChance
;Threshold in 0 to 1000 to wet the bed

@BedWetThreshold(ARG, nExcrete = 1, nUnaware = 1)
#FUNCTION
#DIM nExcrete
#DIM nUnaware
#DIM nThresh
SELECTCASE nExcrete
	CASE 1
		SIF PeeHold:ARG:0 >= 6
			RETURNF 100000
		; SELECTCASE EffectivePottyLevel(MASTER,1, 1)
		; CASE IS >= 0
		; 	nThresh = 1667 + (200*PeeHold:ARG:2)
		; CASE -1
		; 	nThresh = 1000
		; CASE -2
		; 	nThresh = 500
		; CASE -3
		; 	nThresh = 250
		; CASE -4
		; 	nThresh = 100
		; CASE IS <= -5
		; 	nThresh = 0
		; ENDSELECT
		nThresh = 1667 + (EffectivePottyLevel(ARG,1, 1) > 0 ? 200*EffectivePottyLevel(ARG,1, 1) # 400*EffectivePottyLevel(ARG,1, 1))
		SELECTCASE PeeBarStage(ARG)
			CASE IS >= 5
				;wetting
				TIMES nThresh, 0.05
			CASE 4
				TIMES nThresh, 0.2
			CASE 3
				TIMES nThresh, 0.5
			CASE 2
				TIMES nThresh, 0.75
			CASE 1
				TIMES nThresh, 0.9
		ENDSELECT
	CASE 2
		SIF PooHold:ARG:0 >= 6
			RETURNF 100000
		; SELECTCASE EffectivePottyLevel(MASTER,2, 1)
		; CASE IS >= 0
		; 	nThresh = 1667 + (200*PooHold:ARG:2)
		; CASE -1
		; 	nThresh = 1000
		; CASE -2
		; 	nThresh = 500
		; CASE -3
		; 	nThresh = 250
		; CASE -4
		; 	nThresh = 100
		; CASE IS <= -5
		; 	nThresh = 0
		; ENDSELECT
		nThresh = 1667 + (EffectivePottyLevel(ARG,2, 1) > 0 ? 200*EffectivePottyLevel(ARG,2, 1) # 400*EffectivePottyLevel(ARG,2, 1))
		SELECTCASE PooBarStage(ARG)
			CASE IS >= 5
				;messing
				TIMES nThresh, 0.05
			CASE 4
				TIMES nThresh, 0.2
			CASE 3
				TIMES nThresh, 0.5
			CASE 2
				TIMES nThresh, 0.75
			CASE 1
				TIMES nThresh, 0.9
		ENDSELECT
ENDSELECT
SIF !nUnaware
	TIMES nThresh, 0.6
RETURNF MAX(nThresh,0)

@BedWetDreamAddict(ARG, HasPiss, HasScat)
#FUNCTION
#DIM HasPiss
#DIM HasScat
#DIM nThresh
#DIM nAdding
nThresh = 1600
IF HasPiss
	nAdding = (200*ABL:ARG:PeeAddict)
	SELECTCASE PeeBarStage(ARG)
		CASE IS >= 5
			;wetting
			TIMES nAdding, 20
		CASE 4
			TIMES nAdding, 5
		CASE 3
			TIMES nAdding, 2
		CASE 2
			TIMES nAdding, 1.25
		CASE 1
			TIMES nAdding, 1.1
	ENDSELECT
	nThresh -= nAdding
ENDIF
IF HasScat
	nAdding = (200*ABL:ARG:PooAddict)
	SELECTCASE PooBarStage(ARG)
		CASE IS >= 5
			;messing
			TIMES nAdding, 20
		CASE 4
			TIMES nAdding, 5
		CASE 3
			TIMES nAdding, 2
		CASE 2
			TIMES nAdding, 1.25
		CASE 1
			TIMES nAdding, 1.1
	ENDSELECT
	nThresh -= nAdding
ENDIF
RETURNF MAX(nThresh,0)
