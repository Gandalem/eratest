; Modular ERB: OMOGATARI/DAILY EVENTS/DAILY_EV909 Yumemi Reserved Removal.ERB
;-------------------------------------------------
; DAILY_EV_909
; Secret Easter egg if you remove reserved from yumemi
;-------------------------------------------------

@DAILY_INFO_EV909
#FUNCTION
DAILY_INFO_NAME '= @"유메미 보존 제거"
DAILY_INFO_DESC '= @"%CALLNAME:9%에서 「Reserved」를 제거하면 비밀스러운 이스터 에그가 있다."
DAILY_INFO_TYPE '= @"메이저"

@DAILY_CONDITION_EV909
VARSET LOCAL
[IF_DEBUG]
LOCAL = 1
[ENDIF]
SIF !GETBIT(nUnfair,0)
	RETURN -1
SIF TALENT:9:一線越えない
	RETURN -1
SIF TALENT:9:妄信
	RETURN -1
;SIF !RAND:10 || LOCAL
CALL DAILY_EV_909
RETURN 1

@DAILY_EV_909
PRINTFORMDW 당신은 자신의 방이 아닌 다른 방에서 눈을 뜬다.
PRINTL
PRINTFORMDL 두리번거려 보니 딸기와 울트라테크 기술로 가득 차 있었다.
PRINTFORMDW 책이 사방에 놓여 있고, 어느새 다리 사이에서 기분 좋은 온기가 느껴지기 시작한다.
PRINTFORMDW 플레이스홀더...
PRINTL
PRINTFORMW 【일선을넘지않음】이 제거된 결과, %CALLNAME:9%는 이제 영구적으로 발정 상태이다.
PRINTFORML 【덕】과【자기통제】도 제거되었다.
PRINTFORMDW %HE_SHE(9,1)%는 또한 【불륜】, 【맹목적헌신】, 그리고 【해방됨】을 얻었다. 
PRINTFORMDW 게다가 %CALLNAME:9%는 모든 전제 특성이 추가된 채【음란】이 되었다.
TALENT:9:妄信 = 1
TALENT:9:30 = -1
TALENT:9:31 = 1
TALENT:9:20 = 0
TALENT:9:4 = 1
TALENT:9:142 = 1
TALENT:9:184 = 1
RETURN 1
