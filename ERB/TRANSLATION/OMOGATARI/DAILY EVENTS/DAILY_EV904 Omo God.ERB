@EV904_GET_GOD
CALL FISHER_YATES_SHAFFLE(DAILY_EV_MAX)
FOR LOCAL,0,DAILY_EV_MAX
	VARSET EV904_GOD_NAME
	VARSET EV904_GOD_COLOR
	VARSET EV904_GOD_TAGS

	EV904_GOD = SHAFFLE_ARRAY:LOCAL
	;does it exist
	TRYCCALLFORM EV904_GOD_{SHAFFLE_ARRAY:LOCAL}
		;found one
		BREAK
	CATCH
		CONTINUE
	ENDCATCH
NEXT

;grab questions from tags
@EV904_QUESTIONS
CALL FISHER_YATES_SHAFFLE(DAILY_EV_MAX)
FOR LOCAL,0,DAILY_EV_MAX
	VARSET EV904_TITLE
	VARSET EV904_TAGS
	VARSET EV904_IS_LIST
	VARSET EV904_ANSWERS
	VARSET EV904_LISTS
	LOCAL:2 = 0 ;for continuing on the loop
	;does it exist
	TRYCCALLFORM EV904_QUESTION_{SHAFFLE_ARRAY:LOCAL}
		;check tags
		LOCAL:3 = STRCOUNT(EV904_GOD_TAGS, "/")
		FOR LOCAL:1,0,30
			SIF SPLIT_SINGLE(EV904_TAGS, LOCAL:1, "/") == ""
				BREAK
			;blacklisted tags
			SIF STRFIND(EV904_TAGS, "pee/") > -1 && !GETBIT(nPee,1)
				BREAK
			SIF STRFIND(EV904_TAGS, "poo/") > -1 && !GETBIT(nScat,2)
				BREAK
			SIF STRFIND(EV904_TAGS, "diaper/") > -1 && !nOmutsu
				BREAK


			;not matching
			IF STRFIND(EV904_GOD_TAGS,SPLIT_SINGLE(EV904_TAGS, LOCAL:1, "/")) > -1
				LOCAL:2 ++
			ENDIF
		NEXT
	CATCH
		CONTINUE
	ENDCATCH
	;found one matching ALL tags
	IF LOCAL:2 == LOCAL:3
		EV904_QUESTION = SHAFFLE_ARRAY:LOCAL
		TRYCALLFORM EV904_QUESTION_{EV904_QUESTION}
		TRYCALLFORM EV904_GOD_QUEST_ANSWERS_{EV904_GOD}
		RETURN 
	ENDIF
NEXT