@OmoGodAnswer(ARG,ARG:1)
IF ARG:1 == -1
	;CALL COLORMESSAGE("滅びよ悪しき者！！！","RED",1,1)
	SETCOLOR C_RED
	FONTBOLD
	PRINTFORMW 너 같은 사악한 자 같으니!!!
	RESETCOLOR
	FONTREGULAR
	IF ARG
		PRINTFORML 당신의 방광과 장이 불편할 정도로 빨리 차서 잠을 잘 수 없다.
		PRINTFORML 순식간에, 당신은 사고를 친다.
		PRINTFORM 당신은 또한 자신의 방광과 장이 느껴진다 
		IF ARG == 2
			PRINTFORML 깊이 퇴행한다...
		ELSEIF ARG == 1
			PRINTFORML 후퇴 중이다...
		ELSE
			PRINTFORML 점점 나아지고 있어...
		ENDIF
		PeeHold:MASTER:0 = LIMIT(PeeHold:MASTER:0-ARG,-5, 5)
		PooHold:MASTER:0 = LIMIT(PooHold:MASTER:0-ARG,-5, 5)
		PeeHoldExp:MASTER:0 = EXP_DEMAND_20(0,91,MASTER)
		PooHoldExp:MASTER:0 = EXP_DEMAND_21(0,92,MASTER)
		CALLF SILENT_ENDURANCECHANGE(MASTER)
		CALLF ResetBladders(MASTER)
		BASE:MASTER:尿意 = MAXBASE:MASTER:尿意
		BASE:MASTER:Poo = MAXBASE:MASTER:Poo
		PRINTFORM 당신의 배변 훈련 능력은 이제 레벨이 되었다. 
		SETCOLOR C_YELLOW
		PRINTFORM {PeeHold:MASTER:0}【%GET_TALENTNAME_TR(1514, TALENT:MASTER:57, MASTER)%】
		IF nScat
			RESETCOLOR
			PRINTFORM /
			SETCOLOR 0x6b4737
			PRINTFORML {PooHold:MASTER:0}【%GET_TALENTNAME_TR(1500, TALENT:MASTER:58, MASTER)%】
		ENDIF
		RESETCOLOR
		WAIT
		CALL CAUSE_OMORASHI(MASTER,nPee,nScat)
	ENDIF
ELSEIF ARG:1 == 2
	CALL COLORMESSAGE("에헤, 저건 뭐였지...",C_AQUA,1,1)
	PRINTFORML 목소리가 침묵한다.
ELSEIF !ARG:1
	;これが正解の分岐を後で作る
	;PRINTFORML あなたは心底おっぱいを愛しているのですね……
	SETCOLOR C_AQUA
	FONTBOLD
	PRINTFORMW 믿음이 없는 자는...
	RESETCOLOR
	FONTREGULAR
	;CALL COLORMESSAGE("哀れなる信念なき者……","AQUA",1,1)
	PRINTFORML 목소리가 침묵한다.
ELSE
	SETCOLOR C_AQUA
	FONTBOLD
	PRINTFORML 우리가 당신의 소망을 잊지 않았기에, \@ ARG < 0 ? 마른 # 젖은 \@ 바지는 언제나 당신의 아군일 것이다...
	PRINTFORML 당신은 \@ ARG < 0 ? 마른 # 젖은 \@ 바지에 사용할 수 있는 신성한 호의를 가지고 있다...
	RESETCOLOR
	FONTREGULAR
	CALL ASK_YN("나에게 황금 샤워를 주어라",@"Blessing은(는) \@ ARG < 0 ? 배변 훈련 # 방광 퇴행 \@")
	IF RESULT
		PRINTFORML 누구의 것인가?
		DRAWLINE
		FOR LOCAL,0,CHARANUM
		IF ARG > 0
			SIF PeeHold:LOCAL:0 > -5 || PooHold:LOCAL:0 > -5
				PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL% ({PeeHold:LOCAL:0}/{PooHold:LOCAL:0})
		ELSE
			SIF PeeHold:LOCAL:0 < 5 || PooHold:LOCAL:0 < 5
				PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL% ({PeeHold:LOCAL:0}/{PooHold:LOCAL:0})
		ENDIF
		NEXT
		PRINTFORML 
		DRAWLINE
		PRINTFORML [999] 정지
		INPUT
		SELECTCASE RESULT
			CASE 0 TO CHARANUM
				SETCOLOR C_AQUA
				FONTBOLD
				PRINTFORMW %CALLNAME:RESULT%의 방광이 축복받았다...
				RESETCOLOR
				FONTREGULAR
				IF ARG > 0
					PeeHold:RESULT:0 --
					PooHold:RESULT:0 --
					PRINTFORMW %CALLNAME:RESULT%이(가) 통제력을 조금 잃었다!
				ELSE
					SIF !GROUPMATCH(PeeHold:RESULT:0,5,6)
						PeeHold:RESULT:0 ++
					SIF !GROUPMATCH(PooHold:RESULT:0,5,6)
						PooHold:RESULT:0 ++
					PRINTFORMW %CALLNAME:RESULT%는 배변 훈련을 더 잘 하게 되었어!
				ENDIF
				PeeHoldExp:RESULT:0 = EXP_DEMAND_20(0,91,RESULT)
				PooHoldExp:RESULT:0 = EXP_DEMAND_21(0,92,RESULT)
				CALLF SILENT_ENDURANCECHANGE(RESULT)
				CALLF ResetBladders(RESULT)
				PRINTFORM %CALLNAME:RESULT%의 배변 훈련 능력은 이제 레벨이 되었다. 
				SETCOLOR C_YELLOW
				PRINTFORM {PeeHold:RESULT:0}【%GET_TALENTNAME_TR(1514, TALENT:RESULT:57)%】
				IF nScat
					RESETCOLOR
					PRINTFORM /
					SETCOLOR 0x6b4737
					PRINTFORML {PooHold:RESULT:0}【%GET_TALENTNAME_TR(1500, TALENT:RESULT:58)%】
				ENDIF
				RESETCOLOR
				WAIT
			CASEELSE
		ENDSELECT
	ELSE
		;揉ませてもらえる分岐は未完成
		SETCOLOR C_AQUA
		FONTBOLD
		PRINTFORML 당신의 연모가 자랐을 때 나는 한 번 허락하겠다...
		IF !TALENT:MASTER:器用な指
			PRINTFORMW 대신 나는 네가 더욱 뛰어난 기술로 방광을 망치게 해줄 기교를 가르쳐 주겠다...
			RESETCOLOR
			FONTREGULAR
			PRINTFORMW %PARSE("You have")%【능숙한손가락】이 되다!
			TALENT:MASTER:器用な指 = 1
		ENDIF
		RESETCOLOR
		FONTREGULAR
	ENDIF
	CALL PEESOUNDS("loc")
	PRINTFORM 표면적으로는 %FSYN("pee:n")%에 잠겨 있으나, %PARSE("your")% 의식은 %PARSE("you fall",1)% 자고 있는 동안 멀어져 간다.
	IF nOmutsu
		PRINTFORM %" "%신과 같은 디자인의 기저귀로 변했다.
		CFLAG:MASTER:指定パンツ = 103
		CALL SET_PANTS(MASTER)
		CALL SET_PANTS(MASTER,"今日のパジャマ")
		CFLAG:MASTER:指定パンツ = 0
		EQUIP:MASTER:下半身下着２ = 103
	ENDIF
	PRINTFORML .
	IF PeeHold:Master:0 < 2
		PRINTFORML 당신의 몸을 이완시키고, 모든 따뜻한 %FSYN("pee:n")%에 안긴다.
		CALL BEDWETTING(1,nScat)
	ENDIF
ENDIF

