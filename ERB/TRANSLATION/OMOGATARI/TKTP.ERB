;these attacks only happen when EVENTLOAD is called, so we put a function before it.
;pedy has removed them
[SKIPSTART]
@EVENTLOAD
#PRI
#DIM THREATS
#DIMS DESC

VARSET THREATS
VARSET DESC
; PRINTFORML ThisKillsThePedy is currently doing a scan on your save file.
FOR C, 100, 1000
    IF PBAND:C
        DESC += @"PBAND:{C} (called {PBAND:C} times)/"
        PBAND:C = 0
        THREATS ++
    ENDIF
    IF MONEY:C
        DESC += @"MONEY:{C} (called {MONEY:C} times)/"
        MONEY:C = 0
        THREATS ++
    ENDIF
    IF NOITEM:C
        DESC += @"NOITEM:{C} (called {NOITEM:C} times)/"
        NOITEM:C = 0
        THREATS ++
    ENDIF
NEXT
[IF_DEBUG]
IF THREATS
    FONTBOLD
    SETCOLOR C_RED
    PRINTFORML ThisKillsThePedy has found {THREATS} threats.
	FOR N,0,100
		LOCALS '= SPLIT_SINGLE(DESC, N, "/")
		SIF LOCALS == ""
			BREAK
        PRINTFORML ・%LOCALS%
	NEXT
    RESETCOLOR
    FONTREGULAR
    PRINTFORML Report this (Or don't, since it already removed the threats)!
ELSE
    PRINTFORML ThisKillsThePedy has found no threats.
    PRINTFORML Have a wonderful debugging session.
ENDIF
[ENDIF]

@EVENTLOAD
#LATER
#DIM THREATS

FOR C, 100, 1000
    PBAND:C = 0
    MONEY:C = 0
    NOITEM:C = 0
NEXT

