@ShowUnderwearStatus
#FUNCTIONS
#DIM DYNAMIC nShow
#DIMS DYNAMIC HTML
nShow = 0
VARSET HTML
;no soiling enabled
SIF !UndiesCanSoil("liquid") && !UndiesCanSoil("solid")
	RETURNF

IF PantiesType:MASTER:0 != "Naked"
	nShow = 1
	LOCALS:1 '= HTML_ESCAPE("<")
	LOCALS:1 += CAPITALIZE(MERGE_UNDIES_NAME(PantiesType:MASTER:0,PantiesType:MASTER:1))
	SIF STRLENS(PantiesType:MASTER:2)
		LOCALS:1 += @" + %CAPITALIZE(PantiesType:MASTER:2)%"
	;youjutsu alignment
	IF STRLENS(DiapeMagicAttunement:MASTER:0)
		SELECTCASE MagicUnderwear_GetMagicClass(DiapeMagicAttunement:MASTER:0)
		CASE "combat"
			TRYCALLFORMF NAS_ESP_{MagicUnderwear_GetMagicType(DiapeMagicAttunement:MASTER:0)}
			LOCALS:1 += @" (<font color='#%TOSTR(NAS_ESP_COLOR, "X6")%'>%NAS_ESP_NAME_VSHORT%</font>)"
		CASE "neg"
			LOCALS:1 += @" (<font color='#FF9999'>NEG</font>)"
		ENDSELECT
	ENDIF
	LOCALS:1 += ": "
	{
	LOCALS:2 '= @"%CAPITALIZE(PeeProtectType(MASTER))%\n
Type: %PantiesType:MASTER:0%\n
Absorbency Level: %PantiesType:MASTER:1%\n
\@ PadCount:MASTER:0 ? Pads: {PadCount:MASTER:0}x %PantiesType:MASTER:2%\n #\@
Check Chance: {MIN(1000,SoiledFindOutChance(MASTER))/10}\%
%COND_STR(@"\nImmune to checks for {TCVAR:MASTER:DiaperCheckImmunity} minutes",TCVAR:MASTER:DiaperCheckImmunity)%
%COND_STR(@"\nAttuned to %MagicUnderwear_GetName(DiapeMagicAttunement:MASTER:0)%",STRLENS(DiapeMagicAttunement:MASTER:0))%"
	}
	HTML += @"<nonbutton title='%HTML_ESCAPE(LOCALS:2)%'>%LOCALS:1%</nonbutton>"
	;Liquid
	IF UndiesCanSoil("liquid")
		CALLF SoilStr(MASTER,1,1)
		HTML += @"%MO_TALENT(SoilStr(MASTER,1))%"
		RESETCOLOR
		IF ABL:MASTER:教養 >= UniversalRank("B");
			HTML += @" (%PALAM_NUM_NAS(DiapeCharges:MASTER:0,,,-3)%/%PALAM_NUM_NAS(DiapeCharges:MASTER:1,,,-3,"l")%)"
		ENDIF
	ENDIF
	SIF UndiesCanSoil("liquid") && UndiesCanSoil("solid")
		HTML += @", "
	IF UndiesCanSoil("solid")
		CALLF SoilStr(MASTER,2,1)
		HTML += @"%MO_TALENT(SoilStr(MASTER,2))%"
		RESETCOLOR
		IF ABL:MASTER:教養 >= UniversalRank("B");
			HTML += @" (%PALAM_NUM_NAS(DiapePooCharges:MASTER:0,,,)%/%PALAM_NUM_NAS(DiapePooCharges:MASTER:1,,,,"g")%)"
		ENDIF
	ENDIF
	HTML += HTML_ESCAPE(">")
ENDIF
IF ABL:MASTER:教養 >= UniversalRank("B");
	SIF TCVAR:MASTER:LiquidIntake
		HTML += @"%HTML_ESCAPE("<")%Liquid Intake: {TCVAR:MASTER:LiquidIntake}ml%HTML_ESCAPE(">")%"
	SIF TCVAR:MASTER:FoodIntake
		HTML += @"%HTML_ESCAPE("<")%Food Intake: {TCVAR:MASTER:FoodIntake}g%HTML_ESCAPE(">")%"
ENDIF
SIF nShow
	RETURNF HTML

