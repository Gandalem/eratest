;[ライセンス]パブリックドメイン
;本ファイルに係る著作権を放棄する。
;本ファイルに係る著作人格権は行使しない。
;2009/3/28 MinorShift(Emuera作者)
;2010/4/2 MinorShift(Emuera作者) ver 1.736に合わせて一部修正。

;独自のセーブ・ロードシステムの例（Emuera  ver 1.736以降対象）
;LOADGAMEの代わりにCALL LOADGAME_EX、SAVEGAMEの代わりにCALL SAVEGAME_EXを実行してください。
;実際に使用するには旧来の@SAVEINFOに合わせて@SAVEINFO_EXを編集する必要があります。
;使用している命令の詳細については下記のEmueraWikiを参照してください。
;http://sourceforge.jp/projects/emuera/wiki/FrontPage

@LOAD_SAVE_NAS(ARG,ARG:1 = 0)
#DIM TYPE
#DIM LCOUNT
#DIM CREDRAW
#DIM FIRST_LINE
#DIM OFFSET_PAGE
LOADGLOBAL
FIRST_LINE = LINECOUNT
TYPE = ARG
OFFSET_PAGE = EZB_PAGE_OFFSET*ViewingTitlePage
;NAS CUSTOMS
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
SIF GLOBAL:999 < 0 + (OFFSET_PAGE)
	GLOBAL:999 = 0 + (OFFSET_PAGE)
SIF GLOBAL:999 > 10 + (OFFSET_PAGE)
	GLOBAL:999 = 9 + (OFFSET_PAGE)
SAVEGLOBAL
LOADGLOBAL
DRAWLINE
PRINTFORM Select 
SELECTCASE TYPE
	CASE 0
		LOCALS:0 = slot to load
		SETCOLOR C_ORANGE
	CASE 1
		LOCALS:0 = slot to save
		SETCOLOR C_AQUA
	CASE 2
		LOCALS:0 = save to delete
		SETCOLOR C_RED
ENDSELECT
PRINTFORM %LOCALS% 
RESETCOLOR
PRINTFORML - Page ({(GLOBAL:999-(OFFSET_PAGE))+1}/{10})
CALL PRINT_SAVEDATA
[IF_DEBUG]
CHKDATA 302
SETCOLOR COLOR("aqua")
PRINTBUTTON @"[Tmp] %RESULTS:0%", 302
RESETCOLOR
PRINTL
[ENDIF]
CHKDATA 301
SETCOLOR COLOR("aqua")
PRINTBUTTON @"[Mid] %RESULTS:0%", 301
PRINTL
CHKDATA 300
SETCOLOR COLOR("aqua")
PRINTBUTTON @"[End] %RESULTS:0%", 300
RESETCOLOR
PRINTL
PRINTFORM %@"\@ (GLOBAL:999 == (OFFSET_PAGE)) ? [1000] Last page # [1000] Previous page\@",28,LEFT%
SELECTCASE TYPE
	CASE 0
		SETCOLOR C_RED
		
	CASE 1
		SETCOLOR C_ORANGE
		
	CASE 2
		SETCOLOR C_AQUA
ENDSELECT
PRINTFORM %@"[997] %TYPE == 0?"Delete"#(TYPE==1 ? "Load" # "Save")%",28,LEFT%
RESETCOLOR
PRINTFORM %@"[999] Return",28,LEFT%
SELECTCASE TYPE
	CASE 0
		SETCOLOR C_AQUA
	CASE 1
		SETCOLOR C_RED
	CASE 2
		SETCOLOR C_ORANGE
ENDSELECT
PRINTFORM %@"[998] %TYPE == 0?"Save"#(TYPE==1 ? "Delete" # "Load")%",28,LEFT%
RESETCOLOR
PRINTFORM %@"\@ GLOBAL:999 == 9+(OFFSET_PAGE) ? [1002] First page # [1002] Next page\@",28,LEFT%
INPUT
IF RESULT == 997
	TYPE--
	SIF TYPE == -1
		TYPE = 2
	GOTO REPRINT
ELSEIF RESULT == 998
	TYPE++
	TYPE%=3
	GOTO REPRINT
ELSEIF (RESULT == 999)
	RETURN
ELSEIF RESULT == 1000
	IF GLOBAL:999 > (OFFSET_PAGE) && GLOBAL:999 < (OFFSET_PAGE)+10
		GLOBAL:999 -= 1
	ELSEIF GLOBAL:999 == OFFSET_PAGE
		GLOBAL:999 = OFFSET_PAGE+9
	ENDIF
	SAVEGLOBAL
	GOTO REPRINT
ELSEIF RESULT == 1002
	IF GLOBAL:999 < OFFSET_PAGE+9
		GLOBAL:999 += 1
	ELSEIF GLOBAL:999 == OFFSET_PAGE+9
		GLOBAL:999 = OFFSET_PAGE
	ENDIF
	SAVEGLOBAL
	GOTO REPRINT
ELSEIF ((RESULT < 0) || (RESULT >= 200+(EZB_PAGE_OFFSET*1000))) && (RESULT != 300) && (RESULT != 301)
	PRINTFORMW Invalid value.
	GOTO REPRINT
ELSEIF TYPE == 1 && ARG:1 != 1
	LCOUNT = RESULT
	CHKDATA LCOUNT
	;RESULT == 1は"ファイルが存在しない"
	IF RESULT != 1
		DRAWLINE
		PRINTL Save already exists. Overwrite?
		PRINTL  　[0] Yes
		PRINTL  　[1] No
		$INPUT_LOOP
		INPUT
		IF RESULT == 1
			GOTO REPRINT
		ELSEIF RESULT != 0
			GOTO INPUT_LOOP
		ENDIF
	ENDIF
	GLOBAL:998 = LCOUNT
	SAVEGLOBAL
	CALL SAVEINFO_EX
	LOCALS:55 '= RESULTS:0
	;NAS custom code
	;save TCVARS for mid-save
	CALL SET_SAVE_PREVIEWS(LCOUNT)
	CALL TempVarSave
	PLAYSOUND "se/セーブ音.m4a"
	;=========================
	SAVEDATA LCOUNT, LOCALS:55
ELSEIF TYPE == 0
	LCOUNT = RESULT
	CHKDATA LCOUNT
	;RESULT == 0ならロード可能
	IF RESULT != 0
		GOTO REPRINT
	ENDIF
	;NAS CUSTOM
	;=========================
	CALL LOAD_WITH_HEADER(LCOUNT)
	PRINTFORML Load save?
	CALL ASK_YN()
	SIF RESULT
		GOTO REPRINT
	;=========================
	GLOBAL:998 = LCOUNT
	SAVEGLOBAL
	LOADDATA LCOUNT
ELSE
	LCOUNT = RESULT
	CHKDATA LCOUNT
	;RESULT == 0ならロード可能
	IF RESULT != 0
		GOTO REPRINT
	ENDIF
	PRINTL Confirm deletion
	PRINTL  　[0] Yes, delete the save
	PRINTL  　[1] No
	$INPUT_LOOP_DEL
	INPUT
	IF RESULT == 1
		GOTO REPRINT
	ELSEIF RESULT != 0
		GOTO INPUT_LOOP_DEL
	ENDIF
	SAVEGLOBAL
	DELDATA LCOUNT
	PRINTFORMW Successfully deleted.
	GOTO REPRINT
ENDIF
DRAWLINE
PRINTFORMW Successfully %TYPE == 0?"loaded"#(TYPE==1 ? "saved" # "deleted")%.


@MidDaySave
CALL SAVEINFO_EX
CALL TempVarSave
SAVEDATA 301, RESULTS
CALL SET_SAVE_PREVIEWS(301)

@TempVarSave
;NAS custom code
;save TCVARS for mid-save
DT_RELEASE "SavedTempStats"
CALL InitSavedTempStats()
FOR LOCAL, 0, VARSIZE("TFLAG")
	SIF TFLAG:LOCAL
	{
	DT_ROW_ADD @"SavedTempStats",
	"type", "TFLAG",
	"slot", LOCAL,
	"integer", TFLAG:LOCAL,
	}
NEXT
FOR LOCAL, 0, CHARANUM
	FOR LOCAL:1,0, VARSIZE("TCVAR")
		SIF TCVAR:LOCAL:(LOCAL:1)
			{
			DT_ROW_ADD @"SavedTempStats",
			"type", "TCVAR",
			"chara", LOCAL,
			"slot", LOCAL:1,
			"integer", TCVAR:LOCAL:(LOCAL:1),
			}
		SIF TEQUIP:LOCAL:(LOCAL:1)
			{
			DT_ROW_ADD @"SavedTempStats",
			"type", "TEQUIP",
			"chara", LOCAL,
			"slot", LOCAL:1,
			"integer", TEQUIP:LOCAL:(LOCAL:1),
			}
		IF INRANGE(LOCAL:1,0,VARSIZE("PALAM")-1)
			SIF PALAM:LOCAL:(LOCAL:1)
				{
				DT_ROW_ADD @"SavedTempStats",
				"type", "PALAM",
				"chara", LOCAL,
				"slot", LOCAL:1,
				"integer", PALAM:LOCAL:(LOCAL:1),
				}
		ENDIF
	NEXT
NEXT

@SAVEINFO_EX_NAS
;SAVEDATA命令は@SAVEINFO関数を呼ばないのでPUTFORMの代わりの文字列を用意する必要がある
;GETTIME命令でRESULTSに現在時刻を代入
#DIMS DYNAMIC texts
texts '= ""
GETTIME
texts += RESULTS:0
SELECTCASE SaveIsEZB
CASE 0
	IF LS_ACTIVE() != ""
	    texts += " LS "
	ELSE
	    texts += " TW "
	ENDIF
CASE 1
    texts += " LoG "
ENDSELECT
texts += @"Day {DAY} (%PRINT_DATE_F(DAY,2)%)  "
texts += @"%GET_MAPNAME(MAIN_MAP),28,LEFT%  "
texts += @"%@"%NameChecker(MASTER,,,,0)% (%EZB_BAD_NAME()%)",45,LEFT%  "
texts += @"%NASVersionName(),30,LEFT%"
texts += @"\@ FLAG:周回数 ? %" "%NG:{FLAG:周回数}#\@  "
RESULTS:0 '= texts