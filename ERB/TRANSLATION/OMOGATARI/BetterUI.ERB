@CLICK_PER_WORD(ARGS)
#DIM LCOUNT
#DIM nInitColor
#DIMS TEMP, 5
#DIMS TPW, 100
#DIMS TPW_TOTAL
VARSET LOCALS
VARSET TPW
VARSET TPW_TOTAL
nInitColor = GETCOLOR()

PRINTFORML

;文字列を分解する
LOCALS '= REPLACE(ARGS, " ", "@WAIT@ @")
SPLIT LOCALS, "@WAIT@ @", TPW
TPW_TOTAL '= TPW:0
FOR LCOUNT, 0, RESULT
	;特殊な操作
	SIF LCOUNT
	TPW_TOTAL += @" %TPW:LCOUNT%"
	$TPW_PRINT
	CLEARLINE 1
	CALL PRINT_STR(TPW_TOTAL,,,,,,,,,,1)
	SETCOLOR nInitColor
	FONTREGULAR
	WAIT
NEXT

@TWAIT_PER_WORD(ARGS)
#DIM LCOUNT
#DIM nInitColor
#DIMS TEMP, 5
#DIMS TPW, 100
#DIMS TPW_TOTAL
VARSET LOCALS
VARSET TPW
VARSET TPW_TOTAL
nInitColor = GETCOLOR()


PRINTFORML

;compatibility
;ARGS '= REPLACE(ARGS, "_", "@")

;文字列を分解する
SPLIT ARGS, "⁂", TPW
FOR LCOUNT, 0, RESULT
	;特殊な操作
	IF STRCOUNT(TPW:LCOUNT, "TWAIT:")
		TPW:LCOUNT '= REPLACE(TPW:LCOUNT, "TWAIT:", "")
		SIF !TOINT(TPW:LCOUNT)
			GOTO TPW_PRINT
		TWAIT TOINT(TPW:LCOUNT), 1
		GOTO TPW_PRINT
	ENDIF
	TPW_TOTAL += TPW:LCOUNT
	$TPW_PRINT
	CLEARLINE 1
	CALL PRINT_STR(TPW_TOTAL,,,,,,,,,,1)
	SETCOLOR nInitColor
	FONTREGULAR
NEXT


;nas custom code ***************************************
;health status
@SHOW_EQUIP_HEALTH(ARG)
#DIMS DYNAMIC T_LINE
#DIMS DYNAMIC HTML,3
#DIM DYNAMIC HTML_COLOR
#DIM DYNAMIC HTML_BOLD
#DIM DYNAMIC T_LOOP
#DIM DYNAMIC T_HEDIFF
#DIM DYNAMIC T_DEF
#DIM DYNAMIC T_STAGE
#DIM DYNAMIC T_SCALE
VARSET T_LINE
HTML_BOLD = 0
HTML_COLOR = GETCOLOR()

;HTML_PRINT_NAS(strToPrint, strToolTip, strFont, nBold, nRainbow,nButton=-5342543)
IF BASE:ARG:Blood != MAXBASE:ARG:Blood || TCVAR:ARG:Bleeding
	IF TCVAR:ARG:Bleeding >= 14
		HTML_BOLD = 1
		HTML_COLOR = C_RED
		; HTML:1 = Severe!!!!
	ELSEIF TCVAR:ARG:Bleeding >= 12
		HTML_COLOR = C_RED
		; HTML:1 = Intense!!
	ELSEIF TCVAR:ARG:Bleeding >= 10
		HTML_COLOR = C_RED
		; HTML:1 = Unmanageable!
	ELSEIF TCVAR:ARG:Bleeding >= 8
		HTML_COLOR = C_ORANGE
		; HTML:1 = Distressing
	ELSEIF TCVAR:ARG:Bleeding >= 6
		HTML_COLOR = C_ORANGE
		; HTML:1 = Distracting
	ELSEIF TCVAR:ARG:Bleeding >= 4
		HTML_COLOR = C_YELLOW
		; HTML:1 = Moderate
	ELSEIF TCVAR:ARG:Bleeding >= 2
		HTML_COLOR = C_YELLOW
		; HTML:1 = Mild
	ELSEIF TCVAR:ARG:Bleeding > 0
		; HTML:1 = Minimal
	ENDIF

    IF BleedoutRate(ARG) > 120
        SELECTCASE MinsOfBleedUntilDeath(ARG)
		CASE IS >= 60
			HTML:1 '= @"{MinsOfBleedUntilDeath(ARG)/60}hr"
			SIF MinsOfBleedUntilDeath(ARG)%60
			HTML:1 += @" {MinsOfBleedUntilDeath(ARG)%60}m"
		CASEELSE
			HTML:1 '= @"{MinsOfBleedUntilDeath(ARG)}m"
		ENDSELECT
    ENDIF

	HTML '= @"Blood {(MAX(0,BASE:ARG:Blood)*100)/MAX(1,MAXBASE:ARG:Blood)}\%"
	SIF STRLENS(HTML:1)
		HTML += @" (%HTML:1%)"
	{
	T_LINE += HTML_PRINT_NAS("<"+HTML+"> ",
	@"Bleeding is a common occurrence from certain damage types. 
While an injury is bleeding, %CALLNAME:ARG% will lose blood, scaling with the wound and amount of wounds. 
If %CALLNAME:ARG% has no more blood, %HE_SHE(ARG)% will instantly die.",
	TOSTR(HTML_COLOR,"X6"),HTML_BOLD)
	}
ENDIF
HTML_BOLD = 0
HTML_COLOR = GETCOLOR()

; SETCOLOR C_YELLOW

; RESETCOLOR


IF BASE:ARG:Agony
	SELECTCASE AGONY_STAGE(ARG)
	CASE 5
		HTML_BOLD = 1
		HTML_COLOR = C_RED
		HTML:1 = Severe!!!!
	CASE 4
		HTML_COLOR = C_RED
		HTML:1 = Unmanageable!
	CASE 3
		HTML_COLOR = C_ORANGE
		HTML:1 = Distressing
	CASE 2
		HTML_COLOR = C_YELLOW
		HTML:1 = Distracting
	CASE 1
		HTML:1 = Minimal
	ENDSELECT

	HTML '= @"Agony {(BASE:ARG:Agony*100)/MAXBASE:ARG:Agony}\%"
	SIF STRLENS(HTML:1)
		HTML += @" (%HTML:1%)"
	{
	T_LINE += HTML_PRINT_NAS("<"+HTML+"> ",
	@"Injury causes Agony. Agony affects %CALLNAME:ARG%'s consciousness, and if %HE_SHE(ARG)% gets too much %HE_SHE(ARG)% will faint.",
	TOSTR(HTML_COLOR,"X6"),HTML_BOLD)
	}
ENDIF
HTML_BOLD = 0
HTML_COLOR = GETCOLOR()

;all of le hediffs
FOR T_LOOP, 0, DT_SELECT("Hediff", @"chara = {ARG}",, tempHediffList)
	T_HEDIFF = tempHediffList:T_LOOP
	T_DEF = DT_CELL_GET(@"Hediff", T_HEDIFF, "type", 1)
	T_STAGE = GetHediffStage(ARG,T_HEDIFF)


	;show only drugs
	SIF GET_INT(ARG, "Hediff", T_DEF, @"{T_STAGE}/Hidden")
		CONTINUE
	SIF !GROUPMATCH(GET_STR(ARG, "Hediff", T_DEF, @"Hediff Type"),"Drug") && !GET_INT(ARG, "Hediff", T_DEF, @"{T_STAGE}/Show On GUI") && !GET_INT(ARG, "Hediff", T_DEF, @"Show On GUI")
		CONTINUE

	HTML_COLOR = TOINT("0x"+GET_STR(ARG, "Hediff", T_DEF, @"Color")) ? TOINT("0x"+GET_STR(ARG, "Hediff", T_DEF, @"Color")) # GETCOLOR()
	SELECTCASE GET_STR(ARG, "Hediff", T_DEF, @"Hediff Type")
	CASE "Disease"
		T_SCALE = GET_INT(ARG, "Hediff", T_DEF, @"Scale") ? GET_INT(ARG, "Hediff", T_DEF, @"Scale") # 100
		HTML '= @"%GET_STR(ARG, "Hediff", T_DEF, @"名前")% {(DT_CELL_GET(@"Hediff", T_HEDIFF, "severity", 1)*100)/T_SCALE}\%"
	CASE "Drug"
		SIF HTML_COLOR == GETCOLOR()
			HTML_COLOR = 0xff3399
		HTML '= @"\@ STRLENS(GET_STR(ARG, "Hediff", T_DEF, @"ShortName")) ? %GET_STR(ARG, "Hediff", T_DEF, @"ShortName")% # %GET_STR(ARG, "Hediff", T_DEF, @"名前")%\@ {DT_CELL_GET(@"Hediff", T_HEDIFF, "severity", 1)}m"
	ENDSELECT
	{
	T_LINE += HTML_PRINT_NAS("<"+HTML+"> ", @"",
	TOSTR(HTML_COLOR,"X6"),HTML_BOLD)
	}
NEXT

IF STRLENS(T_LINE)
	;not blank
	T_LINE '= @"Health (%CALLNAME:ARG%): %T_LINE%"
	HTML_PRINT T_LINE
ENDIF
