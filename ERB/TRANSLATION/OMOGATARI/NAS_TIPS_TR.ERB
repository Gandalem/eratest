;english translations

@TIPS_GAME_TR(ARGS)
#FUNCTIONS
SELECTCASE ARGS
	CASE "TW"
		RETURNF "eraTW"
	CASE "ATW"
		RETURNF "AnonTW"
	CASE "NAS"
		RETURNF "eraNAS"
ENDSELECT

@TIPS_TYPES_TR(ARGS)
#FUNCTIONS
#DIMS DYNAMIC AL_LANGUAGE = "eng"
AL_LANGUAGE '= AL_DETECT_LANGUAGE()
SELECTCASE ARGS
	CASE "TOTAL"
		SELECTCASE AL_LANGUAGE
			CASE "eng"
				RETURNF "전체"
		ENDSELECT
	CASE "GENERAL"
		SELECTCASE AL_LANGUAGE
			CASE "eng"
				RETURNF "일반"
		ENDSELECT
	CASE "SEX"
		SELECTCASE AL_LANGUAGE
			CASE "eng"
				RETURNF "성적"
		ENDSELECT
	CASE "FUNNY"
		SELECTCASE AL_LANGUAGE
			CASE "eng"
				RETURNF "유머"
		ENDSELECT
	CASE "CHARACTER"
		SELECTCASE AL_LANGUAGE
			CASE "eng"
				RETURNF "캐릭터"
		ENDSELECT
	CASE "COMBAT"
		SELECTCASE AL_LANGUAGE
			CASE "eng"
				RETURNF "전투"
		ENDSELECT
	CASE "EXCRETE"
		SELECTCASE AL_LANGUAGE
			CASE "eng"
				RETURNF "배설"
		ENDSELECT
	CASEELSE
		IF STRFIND(ARGS,"YOUJUTSU_") > -1
			LOCAL = TOINT(SPLIT_SINGLE(ARGS,1,"_"))
			TRYCALLFORMF NAS_ESP_{LOCAL}
			RETURNF @"유쥬츠: %NAS_ESP_NAME%"
		ENDIF
ENDSELECT
RETURNF @"오류: \"%ARGS%\" 언어에 대한 번역된 문자열이 없습니다 %AL_LANGUAGE%!"

