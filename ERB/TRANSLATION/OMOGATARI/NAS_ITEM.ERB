@MakeUnwaveringPaniel(nType)
#DIM nType
#DIM nChara
#DIMS PROPOSED_NAME, 10
PRINTFORML 당신은 패널 자동화 상자를 연다.
nChara = FREE_MOB_SLOT()
CALL SpawnMobEnemy(nChara,nType)
NAME:nChara = %nameArray:nChara:na_FirstName+" '"+CALLNAME:nChara+"' "+nameArray:MASTER:na_LastName%
PRINTFORML 안에 %NAME:nChara%가 나왔다!
TALENT:nChara:3 = 1
CharaFamily:nChara:1 = MASTER
TALENT:nChara:Slave = 1
CFLAG:nChara:好感度 = 1000000
CFLAG:nChara:信頼度 = 1000000
CFLAG:nChara:生解禁 = 2
RELATION:nChara:MASTER = 300
CALL CHARA_STATE_TR(nChara)
$LOOP0
PRINTL 자동화에 이름을 붙여보자.
PRINTFORML 
CALL ASK_M("직접 입력한다",1,"임의 목록",1,"「멕시코를 스쳐 지나가는 뜨거운 바람」이 자연스럽게 지난 후, 이름 「산타나」!",1,"우리 모두에게 영감을 준 사람, 「페디」 이후에",1,"그냥 하지 않는 건 어때",1,)
SELECTCASE RESULT
	CASE 0
		$LOOP1
		PRINTL 자동화의 이름을 입력해 주세요.
		INPUTS
		IF RESULTS == ""
			GOTO LOOP1
		ELSE
			PROPOSED_NAME:0 = %RESULTS%
			;CALL CHK_CHILDNAME_DUPLICATION(PROPOSED_NAME:0)
			PRINTFORML %PROPOSED_NAME:0% 괜찮아?
			CALL ASK_YN
			IF RESULT
				GOTO LOOP1
			ELSE
				CALLNAME:nChara = %PROPOSED_NAME:0%
			ENDIF
		ENDIF
	CASE 1
		$LOOP2
		FOR LOCAL,1,10
		CALL GENERATE_FIRST_NAME_KF()
		PROPOSED_NAME:LOCAL = %RESULTS%
		;Custom code, disabled as it's untranslated
		;IF CHILD_SEX:YOME:CHILDNUM == 1
		;	PROPOSED_NAME:LOCAL = %ランダムキャラ_命名(YOME)%
		;ELSE
		;	PROPOSED_NAME:LOCAL = %男の子_命名(YOME, CHILDNUM)%
		;ENDIF
		PRINTFORML [{LOCAL}] - %PROPOSED_NAME:LOCAL%
		NEXT
		DRAWLINE
		PRINTFORML [99] - 새 목록 생성
		PRINTFORML [100] - 반환
		$LOOP3
		INPUT
		SELECTCASE RESULT
			CASE 1 TO 9
				LOCAL = RESULT
				PRINTFORML %PROPOSED_NAME:LOCAL%가 괜찮은가?
				CALL ASK_YN
				IF RESULT
					GOTO LOOP0
				ELSE
					CALLNAME:nChara = %PROPOSED_NAME:LOCAL%
				ENDIF
			CASE 99
				GOTO LOOP2
			CASE 100
				GOTO LOOP0
			CASEELSE
				GOTO LOOP3
		ENDSELECT
	CASE 2
		CALLNAME:nChara = Santana
	CASE 3
		CALLNAME:nChara = Pedy
ENDSELECT
NAME:nChara = %nameArray:nChara:na_FirstName+" '"+CALLNAME:nChara+"' "+nameArray:MASTER:na_LastName%
PRINTFORML 자동화의 이름은 %NAME:nChara%가 되었다.

@NAS_Put_On_Condom(nInsertForce=-1)
#DIM DYNAMIC nInsertForce
#DIM DYNAMIC nCondom
#DIMS CONST nCondomLabel = "Real", "Counterfeit"
#DIM CONST nCondomID = 45, 1102
#DIM CONST nCondomEQ = 1, -1
#DIMS nCondomStr
;NAS customs
;Real condom is 1, fake is -1
IF ITEM:45 && ITEM:1102
	PRINTFORML 어떤 종류의 콘돔을 착용해야 할까요? 
	CALL ASK_M(@"실재({ITEM:45}가 남음)", ITEM:45, @"위조품 ({ITEM:1102} 남음)", ITEM:1102, "취소", 1)
	SELECTCASE RESULT
		CASE 0
		CASE 1
			SETBIT nCondom, 2
		CASE 2
			RETURN -1
	ENDSELECT
ELSEIF ITEM:1102
	SETBIT nCondom, 2
ENDIF
nCondomStr = %COND_STR("counterfeit ",GETBIT(nCondom,2))%콘돔
SELECTCASE nInsertForce
	CASE MASTER
		SETBIT nCondom, 0
		GOTO BypassChara
	CASE IS > -1
		TFLAG:194 = 1
		SETBIT nCondom, 1
		GOTO BypassChara
	CASEELSE
ENDSELECT
;/////////////////////////////
;com custom code - put condom on target
IF HAS_PENIS(TARGET) && HAS_PENIS(PLAYER)
	PRINTFORML 콘돔을 누가 끼워야 할까? ({ITEM:(nCondomID:GETBIT(nCondom,2))} 남음)
	CALL ASK_M(@"당신은 \@ TEQUIP:PLAYER:コンドーム ? %" "%를 제거한다 #  \@.", 1, @"%CALLNAME:TARGET%\@ TEQUIP:コンドーム ? %" "%가 (Take Off)한다. #  \@", 1, "둘 다", 1, "취소", 1)
	SELECTCASE RESULT
		CASE 0
			SETBIT nCondom, 0
		CASE 1
			TFLAG:194 = 1
			SETBIT nCondom, 1
		CASE 2
			TFLAG:194 = 2
			SETBIT nCondom, 0
			SETBIT nCondom, 1
		CASE 3
			RETURN -1
	ENDSELECT
ELSEIF HAS_PENIS(TARGET)
	TFLAG:194 = 1
	SETBIT nCondom, 1
ELSEIF HAS_PENIS(PLAYER)
	SETBIT nCondom, 0
ENDIF
$BypassChara
IF GETBIT(nCondom, 0)
	IF !TEQUIP:PLAYER:コンドーム
		ITEM:(nCondomID:GETBIT(nCondom,2)) -= 1
		TEQUIP:PLAYER:コンドーム = nCondomEQ:GETBIT(nCondom,2)
		PRINTFORML %PARSE("You put")% 위에 %nCondomStr%가 있다.
		PRINTFORMW {ITEM:(nCondomID:GETBIT(nCondom,2))} 남았다.
	ELSE
		nCondomStr = %COND_STR("counterfeit ",TEQUIP:PLAYER:コンドーム==-1)%콘돔
		TEQUIP:PLAYER:コンドーム = 0
		PRINTFORMW %PARSE("You take")% ~로부터 떨어진 %nCondomStr%.
	ENDIF
ENDIF
IF GETBIT(nCondom, 1)
	SIF nInsertForce == -1
		nInsertForce = TARGET
	IF !TEQUIP:nInsertForce:コンドーム
		ITEM:(nCondomID:GETBIT(nCondom,2)) -= 1
		TEQUIP:nInsertForce:コンドーム = nCondomEQ:GETBIT(nCondom,2)
		PRINTFORML %PARSE("You put")%에 %nCondomStr%를 %CALLNAME:nInsertForce%의 %TINKO(nInsertForce)% 위에 올린다.
		PRINTFORMW {ITEM:(nCondomID:GETBIT(nCondom,2))}가 남았다.
	ELSE
		nCondomStr = %COND_STR("counterfeit ",TEQUIP:nInsertForce:コンドーム==-1)%콘돔
		TEQUIP:nInsertForce:コンドーム = 0
