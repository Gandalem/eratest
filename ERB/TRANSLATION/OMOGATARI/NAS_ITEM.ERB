			CASE "SALES"
				IF ITEM:ARG
					RETURN -1
				ELSE
					RETURN 0
				ENDIF
			CASE "購入"
				CALL SHOP_ASK(ARG, ARG:1)
				SIF !RESULT
					ITEM:ARG ++
			CASE "TYPE:調教", "TYPE:河童道具", "SHOP:通信販売", "SHOP:河童の道具屋", "SHOP:診察"
