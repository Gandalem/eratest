	CASE "NewMattress"
		SIF !GETBIT(nPee,1) && !GETBIT(nScat, 2)
			RETURN 0
		SELECTCASE ARGS
			CASE "SALES"
				RETURN 99
			CASE "購入"
				CALL SHOP_ASK(ARG, ARG:1)
				SIF !RESULT
					ITEM:ARG ++
			CASE "SHOP:通信販売"
				RETURN 1
		ENDSELECT
	CASE "浣腸器＋プラグ", ;com custom code
