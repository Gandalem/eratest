;///////////////////////////////////////
;Spell Results
;///////////////////////////////////////
@EsperMenuResult_14(PYC_CASTER,PYC_TARGET,nInput)
#DIM nInput
#DIM PYC_TARGET
#DIM PYC_CASTER
#DIM nIncreaseAmount
#DIM EMR
#DIM EMR14_LIST,100
#DIM EMR_SINGLE
EMR = TOINT(SUBSTRING(GETDOINGFUNCTION(),16))
TRYCALLFORM NAS_ESP_{EMR}_{nInput}

SELECTCASE nInput
CASE 0, 1
    ;Damage
    EMR_SINGLE = 0
CASE 2, 3
    ;Defense
    EMR_SINGLE = 2
CASE 4, 5, 10
    ;Accuracy
    EMR_SINGLE = 4
CASE 6, 7
    ;Evasion
    EMR_SINGLE = 6
CASE 8, 9
    ;Pierce
    EMR_SINGLE = 8
ENDSELECT

$LOOP

SELECTCASE nInput
CASE 0
    CALL BUFF_CHANGE(PYC_TARGET,0,1)
CASE 2
    CALL BUFF_CHANGE(PYC_TARGET,1,1)
CASE 4
    CALL BUFF_CHANGE(PYC_TARGET,2,1)
CASE 6
    CALL BUFF_CHANGE(PYC_TARGET,3,1)
CASE 8
    CALL BUFF_CHANGE(PYC_TARGET,4,1)
CASE 1, 3, 5, 7, 9
    CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,14,EMR_SINGLE,0)
CASE 10
    CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,14,EMR_SINGLE,2)
CASE 11
    CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,14,1000,2)
CASE 12
    CALL EsperMenuResult_14(PYC_CASTER,0,1)
    CALL EsperMenuResult_14(PYC_CASTER,0,3)
    CALL EsperMenuResult_14(PYC_CASTER,0,5)
    CALL EsperMenuResult_14(PYC_CASTER,0,7)
    CALL EsperMenuResult_14(PYC_CASTER,0,9)
CASE 13
    CALL BUFF_CHANGE(PYC_CASTER,0,6)
CASE 14
    CALL BUFF_CHANGE(PYC_CASTER,0,2)
    CALL BUFF_CHANGE(PYC_CASTER,1,-1)
    CALL BUFF_CHANGE(PYC_CASTER,2,2)
    CALL BUFF_CHANGE(PYC_CASTER,3,2)
CASE 15
    CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,14,1001,0)
    CALL LC_PRINT(@"everyone in the affected area' negative statuses have been removed!", C_RED, 1,)
CASE 16
    CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,14,1002,1)
    CALL LC_PRINT(@"All foe's positive stat changes have been removed!", C_RED, 1,)
CASE 17
    CALL LC_PRINT(@"%CALLNAME:PYC_CASTER%'s next attack will now do 2.5x damage!", C_RED, 1,)
    DT_CELL_SET "lcCombatants", GetCombatant(PYC_CASTER), "chargeBuff", 2, 1
CASE 18
    CALL LC_PRINT(@"everyone in the affected area now have a barrier which can reflect an attack!", C_RED, 1,)
    CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,14,1003,0)
CASE 19
    CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,14,1009,0)
CASE 20
;perfect drug
    CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,14,100,0)
CASE 100
    CALL BUFF_CHANGE(PYC_TARGET,0,3)
    CALL BUFF_CHANGE(PYC_TARGET,1,3)
    CALL BUFF_CHANGE(PYC_TARGET,2,3)
    CALL BUFF_CHANGE(PYC_TARGET,3,3)
    CALL BUFF_CHANGE(PYC_TARGET,4,3)
CASE 1000
    CALL BUFF_CHANGE(PYC_TARGET,2,2)
CASE 1001
    ;Dekunda
    FOR LOCAL,0,5
    CALL BUFF_CHANGE(PYC_TARGET,LOCAL,0,-1)
    NEXT
CASE 1002
    ;Dekaja
    FOR LOCAL,0,5
    CALL BUFF_CHANGE(PYC_TARGET,LOCAL,0,1)
    NEXT
CASE 1003
    ;Tetrakarn
    DT_CELL_SET "lcCombatants", GetCombatant(PYC_TARGET), "protectBuff", 2, 1
CASE 105
    ;Luster Candy
    CALL BUFF_CHANGE(PYC_TARGET,0,1)
    CALL BUFF_CHANGE(PYC_TARGET,1,1)
    CALL BUFF_CHANGE(PYC_TARGET,2,1)
    CALL BUFF_CHANGE(PYC_TARGET,3,1)
    CALL BUFF_CHANGE(PYC_TARGET,4,1)
CASE 106
    ;Revolution
    CALL BUFF_CHANGE(PYC_TARGET,2,2)
CASE 1009
    ;even flow
    CALL BUFF_CHANGE(PYC_TARGET,3,2)
ENDSELECT

@BUFF_CHANGE(PYC_TARGET,STAT,CHANGE=0,RESET_STATS=0)
#DIM PYC_TARGET
#DIM STAT
#DIM CHANGE
#DIM RESET_STATS
#DIM CONST BC_MAX = 6

IF RESET_STATS == -1
    ;debuffs
    DT_CELL_SET "lcCombatants", GetCombatant(PYC_TARGET), BUFF_NAMES(STAT,2), MAX(DT_CELL_GET("lcCombatants", GetCombatant(PYC_TARGET), BUFF_NAMES(STAT,2), 1),0), 1
    RETURN
ELSEIF RESET_STATS == 1
    ;buffs
    DT_CELL_SET "lcCombatants", GetCombatant(PYC_TARGET), BUFF_NAMES(STAT,2), MIN(DT_CELL_GET("lcCombatants", GetCombatant(PYC_TARGET), BUFF_NAMES(STAT,2), 1),0), 1
    RETURN
ENDIF

IF DT_CELL_GET("lcCombatants", GetCombatant(PYC_TARGET), BUFF_NAMES(STAT,2), 1) >= BC_MAX && CHANGE > 0
    CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%'s【%BUFF_NAMES(STAT)%】won't go any higher!", C_RED, 1,)
    RETURN
ELSEIF DT_CELL_GET("lcCombatants", GetCombatant(PYC_TARGET), BUFF_NAMES(STAT,2), 1) <= -BC_MAX && CHANGE < 0
    CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%'s【%BUFF_NAMES(STAT)%】won't go any lower!", C_RED, 1,)
    RETURN
ENDIF

DT_CELL_SET "lcCombatants", GetCombatant(PYC_TARGET), BUFF_NAMES(STAT,2), LIMIT(DT_CELL_GET("lcCombatants", GetCombatant(PYC_TARGET), BUFF_NAMES(STAT,2), 1)+CHANGE,-BC_MAX,BC_MAX), 1

SELECTCASE CHANGE
CASE 6
    CALL LC_PRINT(@"%CALLNAME:PYC_TARGET% maximized %HIS_HER(PYC_TARGET)%【%BUFF_NAMES(STAT)%】!", C_RED, 1,)
CASE IS >= 3
    CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%'s【%BUFF_NAMES(STAT)%】rose drastically!", C_RED, 1,)
CASE 2
    CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%'s【%BUFF_NAMES(STAT)%】rose sharply!", C_RED, 1,)
CASE 1
    CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%'s【%BUFF_NAMES(STAT)%】rose!", C_RED, 1,)
CASE -1
    CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%'s【%BUFF_NAMES(STAT)%】fell!", C_P_BLUE, 1,)
CASE -2
    CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%'s【%BUFF_NAMES(STAT)%】harshly fell!", C_P_BLUE, 1,)
CASE IS <= -3
    CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%'s【%BUFF_NAMES(STAT)%】severely fell!", C_P_BLUE, 1,)
ENDSELECT

;win a battle with attack at -6 and defense at -6