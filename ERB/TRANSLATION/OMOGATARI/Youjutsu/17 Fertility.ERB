@YoujutsuSelfStudyPuzzle_Quest_17(ARG,nSearchMode = "GET")
#DIMS nSearchMode
#DIM DYNAMIC nHasDidIt
nHasDidIt = 0
SELECTCASE YoujutsuQuestProgress:ARG:17
	CASE 10000 TO 19999
		SELECTCASE nSearchMode
			CASE "SET"
				RETURN 1
			CASE "GET"
				CALL PRINT_LETTER(@"1단계. 오르가즘·최고 기록\n・몸을 오르가즘으로 이끌어 절정의 쾌감에 도달하게 한다.",,40)
			CASE "CHECK"
				SIF TARGET_ORGASM_PowerF(MASTER)
					nHasDidIt = 1
				RETURN nHasDidIt
		ENDSELECT
	CASE 20000 TO 29999
		SELECTCASE nSearchMode
			CASE "SET"
				RETURN 1
			CASE "GET"
				CALL PRINT_LETTER(@"단계 2. 안전한 날 기준\n・안전한 날에 삽입하거나 삽입되는 것을 경험한다.\n・자위는 계산하지 않는다",,40)
			CASE "CHECK"
				SIF ((ESTRUS_CYCLE(MASTER) <= 15 && GroupMatch(SELECTCOM,130,131,132,133)) || (ESTRUS_CYCLE(TARGET) <= 15 && IS_SEXING(TARGET))) && TARGET != MASTER
					nHasDidIt = 1
				RETURN nHasDidIt
		ENDSELECT
	CASE 30000 TO 39999
		SELECTCASE nSearchMode
			CASE "SET"
				RETURN 1
			CASE "GET"
				CALL PRINT_LETTER(@"3단계. 위험한 날 기준\n・위험한 날에 삽입을 하거나 삽입을 당하는 경우.\n・배란약은 계산하지 않음.\n・자위는 계산하지 않음",,40)
			CASE "CHECK"
				SIF ((ESTRUS_CYCLE(MASTER) <= 1500 && GroupMatch(SELECTCOM,130,131,132,133)) || (ESTRUS_CYCLE(TARGET) <= 1500 && IS_SEXING(TARGET))) && TARGET != MASTER
					nHasDidIt = 1
				RETURN nHasDidIt
		ENDSELECT
	CASEELSE
		RETURN 999
ENDSELECT
RETURN 0

