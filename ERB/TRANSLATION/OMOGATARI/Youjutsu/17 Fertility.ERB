@EsperMenuResult_17(PYC_CASTER,PYC_TARGET,nInput)
#DIM nInput
#DIM PYC_TARGET
#DIM PYC_CASTER
#DIM nIncreaseAmount
#DIM EMR
#DIM EMR_SINGLE
EMR = TOINT(SUBSTRING(GETDOINGFUNCTION(),16))
TRYCALLFORM NAS_ESP_{EMR}_{nInput}
SELECTCASE nInput
	CASE 0, 1
		EMR_SINGLE = 0
	CASE 2, 3
		EMR_SINGLE = 2
	CASE 4, 5
		EMR_SINGLE = 4
	CASE 6, 7
		EMR_SINGLE = 6
	CASE 11, 12
		EMR_SINGLE = 11
ENDSELECT
SELECTCASE nInput
	CASE 0
		CALL LC_HORNY_ADD(PYC_TARGET,300,1)
	CASE 2
		CALL LC_HORNY_ADD(PYC_TARGET,550,1)
	CASE 4
		CALL LC_HORNY_ADD(PYC_TARGET,800,1)
	CASE 6
		CALL BUFF_CHANGE(PYC_TARGET,3,-1)
	CASE 8
		CALL BUFF_CHANGE(PYC_TARGET,4,-1)
	CASE 11
		;Libedyne
		CALL LC_HORNY_ADD(PYC_TARGET,1000,1)
	CASE 1, 3, 5, 7, 9, 12
		CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,17,EMR_SINGLE,1)
	CASE 13
		IF !HAS_VAGINA(PYC_TARGET)
			PRINTFORMW %CALLNAME:PYC_TARGET%은(는) 질이 없어서 난자 방출이 헛수고가 되었다.
			RETURN
		ELSE
			PRINTFORMW %CALLNAME:PYC_TARGET%는 특별히 비옥해진다! %HE_SHE(PYC_TARGET,1)%은 오늘 임신하기 더 쉬워질 수 있다.
		ENDIF
		TCVAR:PYC_TARGET:FertilityMagicDid = 1
	CASE 14
		IF !HAS_VAGINA(PYC_TARGET)
			PRINTFORMW %CALLNAME:PYC_TARGET%은(는) 질이 없어서 알 삽입이 헛수고가 되었다.
			RETURN
		ELSE
			PRINTFORMW %CALLNAME:PYC_TARGET% 안에 알이 생성된다! 오늘 %HE_SHE(PYC_TARGET,1)%는 임신할 수 있다.
		ENDIF
		TCVAR:PYC_TARGET:FertilityMagicDid = 2
	CASE 15
		IF !HAS_VAGINA(PYC_TARGET)
			PRINTFORMW %CALLNAME:PYC_TARGET%은(는) 질이 없어서 사이클 확인은 먹히지 않았다.
			RETURN
		ELSE
			IF TCVAR:PYC_TARGET:FertilityMagicDid && TCVAR:PYC_TARGET:強制排卵
				PRINTFORML %CALLNAME:PYC_TARGET%은 이중으로 배란 중이며 극도로 가임력이 높다.
			ELSEIF TCVAR:PYC_TARGET:FertilityMagicDid == 2
				PRINTFORML 알이 %CALLNAME:PYC_TARGET%에게 놓였다.
			ELSEIF TCVAR:PYC_TARGET:FertilityMagicDid == 1
				PRINTFORML %CALLNAME:PYC_TARGET%은(는) 마법으로 발정기에 들었다.
			ELSEIF TCVAR:PYC_TARGET:強制排卵
				PRINTFORML %CALLNAME:PYC_TARGET%에게 배란 유도제가 투여되었다.
			ELSE
				PRINTFORM %CALLNAME:PYC_TARGET%의 생리 주기는 현재
				CALL NEW_CYCLE_PRINT(PYC_TARGET)
				PRINTL
			ENDIF
			PRINTFORMW %CALLNAME:PYC_TARGET%의 발정 등급은 현재 다음과 같다: {REAL_ESTRUS_CYCLE(PYC_TARGET)}
		ENDIF
ENDSELECT

