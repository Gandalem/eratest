@YoujutsuSelfStudyPuzzle_22(ARG)
#DIM DYNAMIC FEINT
#DIM DYNAMIC timeMax
#DIM DYNAMIC Scale
#DIM DYNAMIC puzLineCount
#DIM DYNAMIC expToGet
#DIM DYNAMIC attackerPower
#DIM DYNAMIC correct
PRINTFORML Learn to train your reflexes by dodging attacks.
PRINTFORML If you train them enough, you can basically learn time stop.
PRINTFORML Avoid the attacker's attack, dodge in the opposite direction 
PRINTL
puzLineCount = LINECOUNT
DO
    CLEARLINE LINECOUNT-puzLineCount
    attackerPower = RAND(0,11)
    timeMax = 2000 - (ABL:ARG:戦闘能力 - ABL:MASTER:戦闘能力) * 100
	correct = RAND:4
	expToGet = MAX(RANK_TO_LEVEL(attackerPower) * 5, 5) * 10
    PRINT Attacker's power: 
    CALL PRINT_RANK(attackerPower,"MAX_6")
    PRINTS @" {attackerPower} "
    PRINTFORMW (Click to start)
    SELECTCASE RAND:20
        CASE IS <= 11
        ;Arrows
            LOCALS:0 = ↑
            LOCALS:1 = →
            LOCALS:2 = ←
            LOCALS:3 = ↓
            Scale = 100
        CASE 12 TO 15
        ;Romaji
            LOCALS:0 = UE
            LOCALS:1 = MIGI
            LOCALS:2 = HIDARI
            LOCALS:3 = SHITA
            Scale = 160
        ;English
        CASE 16,17,18
            LOCALS:0 = UP
            LOCALS:1 = RIGHT
            LOCALS:2 = LEFT
            LOCALS:3 = DOWN
            Scale = 120
        ;Spanish
        CASE 19
            LOCALS:0 = Arriba
            LOCALS:1 = Derecha
            LOCALS:2 = Izquierda
            LOCALS:3 = Abajo
            Scale = 300
    ENDSELECT
	IF attackerPower > 3 && !RAND:3
		FEINT = 1
		timeMax += 400
		Scale += 80
	ELSE
		FEINT = 0
	ENDIF
	CALL FISHER_YATES_SHAFFLE(4)
	PRINTFORM The attacker attacks from 
	SETCOLOR C_YELLOW
	IF FEINT
		PRINTFORM %LOCALS:(RAND:4)%
		RESETCOLOR
		PRINTFORM  but it's actually from %LOCALS:(3 - correct)%
	ELSE
		PRINTFORM %LOCALS:(3 - correct)%
		RESETCOLOR
	ENDIF
	PRINTFORML !
	FOR LOCAL:10,0,4
		LOCAL = SHAFFLE_ARRAY:(LOCAL:10)
		PRINTFORML [{LOCAL}] - Dodge %LOCALS:LOCAL%
	NEXT
    PRINTL
    PRINTFORML [{-222}] - Stop Training
    TINPUT timeMax, -1, 1
	IF RESULT == correct
		PRINTFORML You graze the attack!
		expToGet = expToGet * Scale / 100
		;custom code
    	CALL YoujutsuLearningProgress(ARG,22,expToGet)
        WAIT
    ELSEIF RESULT == -222
        PRINTFORML You quit training.
        RETURN
	ELSE
		PRINTFORML Missed it!
		PRINTFORMW Try again!
	ENDIF
LOOP 1


