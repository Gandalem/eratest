@YoujutsuSelfStudyPuzzle_22(ARG)
#DIM DYNAMIC FEINT
#DIM DYNAMIC timeMax
#DIM DYNAMIC Scale
#DIM DYNAMIC puzLineCount
#DIM DYNAMIC expToGet
#DIM DYNAMIC attackerPower
#DIM DYNAMIC correct
PRINTFORML 공격을 피하며 반사 신경을 단련하는 법을 배워라.
PRINTFORML 충분히 단련하면 기본적으로 시간 정지를 배울 수 있다.
PRINTFORML 공격자의 공격을 피하고, 반대 방향으로 회피해라. 
PRINTL
puzLineCount = LINECOUNT
DO
CLEARLINE LINECOUNT-puzLineCount
attackerPower = RAND(0,11)
timeMax = 2000 - (ABL:ARG:戦闘能力 - ABL:MASTER:戦闘能力) * 100
correct = RAND:4
expToGet = MAX(RANK_TO_LEVEL(attackerPower) * 5, 5) * 10
PRINT 공격자의 힘: 
CALL PRINT_RANK(attackerPower,"MAX_6")
PRINTS @" {attackerPower} "
PRINTFORMW (클릭하여 시작)
SELECTCASE RAND:20
	CASE IS <= 11
		;Arrows
		LOCALS:0 = ↑
		LOCALS:1 = →
		LOCALS:2 = ←
		LOCALS:3 = ↓
		Scale = 100
	CASE 12 TO 15
		;Romaji
		LOCALS:0 = UE
		LOCALS:1 = MIGI
		LOCALS:2 = HIDARI
		LOCALS:3 = SHITA
		Scale = 160
		;English
	CASE 16,17,18
		LOCALS:0 = UP
		LOCALS:1 = RIGHT
		LOCALS:2 = LEFT
		LOCALS:3 = DOWN
		Scale = 120
		;Spanish
	CASE 19
		LOCALS:0 = Arriba
		LOCALS:1 = Derecha
		LOCALS:2 = Izquierda
		LOCALS:3 = Abajo
		Scale = 300
ENDSELECT
IF attackerPower > 3 && !RAND:3
	FEINT = 1
	timeMax += 400
	Scale += 80
ELSE
	FEINT = 0
ENDIF
CALL FISHER_YATES_SHAFFLE(4)
PRINTFORM 공격자는 ~에서 공격한다 
SETCOLOR C_YELLOW
IF FEINT
	PRINTFORM %LOCALS:(RAND:4)%
	RESETCOLOR
	PRINTFORM  하지만 사실 그것은 %LOCALS:(3 - correct)%으로부터 온 것이다.
ELSE
	PRINTFORM %LOCALS:(3 - correct)%
	RESETCOLOR
ENDIF
PRINTFORML !
FOR LOCAL:10,0,4
LOCAL = SHAFFLE_ARRAY:(LOCAL:10)
PRINTFORML [{LOCAL}] - 회피한다 %LOCALS:LOCAL%
NEXT
PRINTL
PRINTFORML [{-222}] [-222] - 훈련 중지
TINPUT timeMax, -1, 1
IF RESULT == correct
	PRINTFORML 공격을 피했다!
	expToGet = expToGet * Scale / 100
	;custom code
	CALL YoujutsuLearningProgress(ARG,22,expToGet)
	WAIT
ELSEIF RESULT == -222
	PRINTFORML 당신은 수련을 그만두었다.
	RETURN
ELSE
	PRINTFORML 놓쳤다!
	PRINTFORMW 다시 시도해라!
ENDIF
LOOP 1

