@YoujutsuSelfStudyPuzzle_Quest_9(ARG,nSearchMode = "GET")
#DIMS nSearchMode
#DIM DYNAMIC nHasDidIt
nHasDidIt = 0

SELECTCASE YoujutsuQuestProgress:ARG:9
CASE 10000 TO 19999
    SELECTCASE nSearchMode
    CASE "SET"
        RETURN 1
    CASE "GET"
        IF SaveIsEZB
            CALL PRINT_LETTER(@"[CHALLENGE REDACTED]",,40)
        ELSE
            CALL PRINT_LETTER(@"Take the Human Phoenix to the hottest place in hell.",,40)
        ENDIF
    CASE "CHECK"
        SIF CFLAG:61:300 == CFLAG:ARG:300 && CFLAG:ARG:300 == GET_MAP_REPLACEMENT(929)
            nHasDidIt = 1
        SIF SaveIsEZB
            nHasDidIt = 1
        RETURN nHasDidIt
    ENDSELECT
CASE 20000 TO 29999
    SELECTCASE nSearchMode
    CASE "SET"
        RETURN 1
    CASE "GET"
        CALL PRINT_LETTER(@"Combat train when the ambient temperature is over 40˚C",,40)
    CASE "CHECK"
        SIF GET_現在気温() >= 400 && SELECTCOM == 411
            nHasDidIt = 1
        RETURN nHasDidIt
    ENDSELECT
CASE 30000 TO 39999
    SELECTCASE nSearchMode
    CASE "SET"
        RETURN 1
    CASE "GET"
        CALL PRINT_LETTER(@"Get hit by a fire spell or weapon during combat.",,40)
    CASE "CHECK"
        SIF YoujutsuQuestProgress:ARG:9 > 30000
            nHasDidIt = 1
        RETURN nHasDidIt
    ENDSELECT
CASEELSE
    RETURN 999
ENDSELECT
RETURN 0


