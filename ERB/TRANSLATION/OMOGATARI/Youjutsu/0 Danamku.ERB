TRYCALLFORMF NAS_ESP_{YOUJUTSU}()

KNOW_NEED = UniversalRank("B")

IF GETBIT(TALENT:ARG:ESP,0)
	PRINT 　
	CALL COLORMESSAGE(@"-　Acquired",C_YELLOW,1)
ELSE
	PRINT 　
	CALL COND_COLORMESSAGE(ABL:ARG:43 >= KNOW_NEED,@"{KNOW_NEED} Knowledge (Current:{ABL:ARG:43})")
	PRINT 　
    CALL COND_COLORMESSAGE(0,@"Read a book about Danmaku magic.")
ENDIF

@YoujutsuSelfStudyPuzzle_0(ARG)
#DIM DYNAMIC pickedAnswers, 12
#DIM CONST rightAnswers = 2, 4, 3, 3, 2, 0, 0, 1, 2, 2, 0, 0
#DIM DYNAMIC scoreCounter, 3
VARSET pickedAnswers
PRINTFORML World of Fantasy
PRINTFORML Spell Card Danmaku Participant Exam
PRINTFORML Rev: 2020.2.17
PRINTL
PRINTFORML Danmaku is a fun and competitive game involving the use of Youjutsu to fire magic bullets.
PRINTFORML These bullets can be used to harm or even kill when used improperly or as a combat tool.
PRINTFORML This game is highly regulated and these rules help keep the game safe.
PRINTFORML Score 80\% or higher to be qualified as a Danmaku competitor.
DRAWLINE
PRINTL
PRINTFORML 1. To cast Danmaku, you should...
{
CALL ASK_M(
	"Pee yourself", 1,
	"Throw a tantrum", 1,
	"Say \"Danmaku\", and stretch your hand outwards", 1,
	"Scream \"DANMAKU\"", 1,
	"Forget what you read and punch the opponent.", 1,
)
}
pickedAnswers:0 = RESULT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:0,rightAnswers:0,
"To cast Danmaku, you should say \"Danmaku\", and stretch your hand outwards.<br>
To stop casting, retract your arm.<br>
This is the case for any other Youjutsu spell.<br>
This requires you to have the ability to talk, which means a Pacifier or Ball Gag will suppress your ability to cast Danmaku.")
}
PRINTL

PRINTFORML 2. Training Danmaku should be done in
{
CALL ASK_M(
	"A garage", 1,
	"A banquet", 1,
	"The Library", 1,
	"A daycare", 1,
	"An open field", 1,
)
}
pickedAnswers:1 = RESULT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:1,rightAnswers:1,
"Danmaku Training should be done in an open field, clear from any possible items that could be damaged")
}

PRINTFORML 3. Your opponent casts a curtain of bullets that covers your entire field of view.
PRINTFORML What do you do?
{
CALL ASK_M(
	"Attempt to shoot your way through with your own Danmaku", 1,
	"Take the hit", 1,
	"Cast Mudo on the enemy", 1,
	"Dodge your away around, grazing as close as possible", 1,
	"Surrender", 1,
)
}
pickedAnswers:2 = RESULT
SELECTCASE pickedAnswers:2
CASE 0
	LOCALS '= "Your danmaku cannot cancel out other Danmaku."
CASE 1
	LOCALS '= "Taking the hit should be done as a last resort."
CASE 2
	LOCALS '= "Lethal spells are illegal in Danmaku."
CASE 3
	LOCALS '= "The correct option is to dodge. Remember that you're fighting in a 3D space!"
CASE 4
	LOCALS '= "Only losers surrender."
ENDSELECT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:2,rightAnswers:2,
LOCALS)
}

PRINTFORML 4. Mark the ability card type that isn't allowed.
{
CALL ASK_M(
	"Active Cards", 1,
	"Item Cards", 1,
	"Passive Cards", 1,
	"Equipment Cards", 1,
	"None of the above", 1,
)
}
pickedAnswers:3 = RESULT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:3,rightAnswers:3,
"Only Equipment Cards are not allowed in Danmaku")
}

PRINTFORML 5. Which weapons are allowed during Spell Card battles.
{
CALL ASK_M(
	"Everything", 1,
	"Youjutsu Only", 1,
	"Danmaku and Spell Cards", 1,
	"Firearms Only", 1,
	"Danmaku Only", 1,
)
}
pickedAnswers:4 = RESULT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:4,rightAnswers:4,
"Danmaku and Spell cards are allowed on Danmaku")
}

PRINTFORML 6. Fill in the blanks
PRINTFORML The basic idea is to hit your opponent ______ times before you're hit ______ times
{
CALL ASK_M(
	"three, three", 1,
	"three, one", 1,
	"three, four", 1,
	"five, five", 1,
	"one, one", 1,
)
}
pickedAnswers:5 = RESULT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:5,rightAnswers:5,
"three, three")
}

PRINTFORML 7. Which of the following is a Danmaku passive spell?
{
CALL ASK_M(
	"Spell It All Out", 1,
	"Agidyne", 1,
	"The World", 1,
	"Recarm", 1,
	"Null Physical", 1,
)
}
pickedAnswers:6 = RESULT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:6,rightAnswers:6,
"Spell It All Out is a Danmaku passive spell")
}

PRINTFORML 8. You've soiled yourself in the middle of a Danmaku match!
PRINTFORML What do you do?
{
CALL ASK_M(
	"Cast Diaper Conjuration", 1,
	"Ignore the mess in your pants and continue fighting", 1,
	"Pull down your soiled underwear", 1,
	"Ask for a timeout", 1,
	"Cry and hope a caregiver notices", 1,
)
}
pickedAnswers:7 = RESULT
SELECTCASE pickedAnswers:7
CASE 0
	LOCALS '= "Diaper Conjuration is an illegal spell, much like all Non-Danmaku Youjutsu spells."
CASE 1
	LOCALS '= "The correct option is to just ignore the accident that you made and keep on fighting. You can change after."
CASE 2
	LOCALS '= "Attempting to pull down your underwear manually leaves you vulnerable to your opponent(s) and shouldn't be done."
CASE 3
	LOCALS '= "Most opponents will not accept a timeout for any reason."
CASE 4
	LOCALS '= "Crying is the equivalent of surrendering, and only losers surrender."
ENDSELECT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:7,rightAnswers:7,
LOCALS)
}

PRINTFORML 9. When should Spell Card restrictions NOT be disregarded
PRINTFORML Disregarding Spell Card rules mean that lethal force is authorized, and any power limitations are lifted.
{
CALL ASK_M(
	"When your opponent pulls out a firearm", 1,
	"When your opponent begins casting lethal Youjutsu spells", 1,
	"When your opponent surrenders.", 1,
	"When your life is threatened in any way", 1,
	"When you are being shot at by an external entity", 1,
)
}
pickedAnswers:8 = RESULT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:8,rightAnswers:8,
"Spell Card rules can be disregarded when your life is threatened in any way.<br>
This can include when your opponent discharges a firearm, casts lethal spells, or is otherwise makes moves that attempts to threaten the life of someone.<br>
External interference such as a raid or attacking ground entity is also grounds for lethal force.<br>
Your opponent surrendering is not grounds for you to execute them in the way you see fit.")
}



PRINTFORML 10. How many times can you challenge a singular (1) opponent in one day...
{
CALL ASK_M(
	"Infinitely", 1,
	"Three times", 1,
	"Once", 1
)
}
pickedAnswers:9 = RESULT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:9,rightAnswers:9,
"Combatants will only accept a Danmaku challenge from you once per day.")
}

PRINTFORML 11. Fill in the blank
PRINTFORML If you run out of MP, you must ______
{
CALL ASK_M(
	"Surrender", 1,
	"Drink a magic potion", 1,
	"Hide in a building", 1,
	"Run away", 1,
	"Stand there and eat lunch", 1
)
}
pickedAnswers:10 = RESULT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:10,rightAnswers:10,
"If you run out of MP, you must surrender and lose the battle.")
}

PRINTFORML 12. True or false:
PRINTFORML To get more max MP, just use up your current MP
{
CALL ASK_M(
	"True", 1,
	"False", 1
)
}
pickedAnswers:11 = RESULT
{
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:11,rightAnswers:11,
"This is a true statement")
}

scoreCounter:0 = 0
scoreCounter:1 = VARSIZE("rightAnswers")
FOR LOCAL,0,scoreCounter:1
	SIF pickedAnswers:LOCAL == rightAnswers:LOCAL
		scoreCounter:0++
NEXT
PRINTFORML Score
PRINTFORMW ・
PRINTFORML {scoreCounter:0}/{scoreCounter:1}
PRINTFORMW ・・
PRINTFORML {100*scoreCounter:0/scoreCounter:1}\%
PRINTFORMW ・・・

IF 100*scoreCounter:0/(scoreCounter:1) >= 80
	PRINTFORMW Congratulations, you have passed.
	CALL YoujutsuLearningProgress(ARG,0,10000)
ELSE
	PRINTFORMW Unfortunately you did not pass. Try again next time.
ENDIF

@NAS_ESP_SELF_LEARN_0_ANSWER(picked,correct,explain)
#DIM picked
#DIM correct
#DIMS explain
DRAWLINE
IF picked == correct
	SETCOLOR C_GREEN
	PRINTFORML CORRECT!
	RESETCOLOR
ELSE
	SETCOLOR C_RED
	PRINTFORML WRONG ANSWER!
	RESETCOLOR
ENDIF
HTML_PRINT explain
PRINTL
CALL ASK_M("Okay",1)
DRAWLINE


