@SHOW_FALL_STATE_REV_INFO_200(ARG)
SFSR_TYPE '= "Youjutsu"
SFSR_CANDO = 1
VARSET NAS_ESP_NAME
LOCALS '= SUBSTRING(GETDOINGFUNCTION(),25)
LOCAL = MAX(0,TOINT(LOCALS)-200)
TRYCALLFORMF NAS_ESP_{LOCAL}()
SFSR_NAME '= "Youjutsu: "+NAS_ESP_NAME

@SHOW_FALL_STATE_REV_200(ARG)
#DIM YOUJUTSU
#DIM AG_NEEDED
#DIM KNOW_NEED
LOCALS '= SUBSTRING(GETDOINGFUNCTION(),20)
YOUJUTSU = MAX(0,TOINT(LOCALS)-200)
TRYCALLFORMF NAS_ESP_{YOUJUTSU}()
KNOW_NEED = UniversalRank("B")
IF GETBIT(TALENT:ARG:ESP,0)
	PRINT 　
	CALL COLORMESSAGE(@"획득함",C_YELLOW,1)
ELSE
	PRINT 　
	CALL COND_COLORMESSAGE(ABL:ARG:43 >= KNOW_NEED,@"{KNOW_NEED} 지식 (현재:{ABL:ARG:43})")
	PRINT 　
	CALL COND_COLORMESSAGE(0,@"단마쿠 마법에 관한 책을 읽는다.")
ENDIF

@YoujutsuSelfStudyPuzzle_0(ARG)
#DIM DYNAMIC pickedAnswers, 12
#DIM CONST rightAnswers = 2, 4, 3, 3, 2, 0, 0, 1, 2, 2, 0, 0
#DIM DYNAMIC scoreCounter, 3
VARSET pickedAnswers
PRINTFORML 환상의 세계
PRINTFORML 마법 카드 단막 참가자 시험
PRINTFORML 개정일: 2020.2.17
PRINTL
PRINTFORML 단막은 유술을 사용하여 마법 탄환을 발사하는 재미있고 경쟁적인 게임이다.
PRINTFORML 이 탄환들은 부적절하게 사용되거나 전투 도구로 쓰일 때 해를 입히거나 심지어 죽일 수도 있다.
PRINTFORML 이 게임은 엄격하게 규제되고 있으며, 이러한 규칙들이 게임을 안전하게 유지하는 데 도움을 준다.
PRINTFORML 단막 경쟁자로 자격을 얻으려면 점수가 80\% 이상이어야 한다.
DRAWLINE
PRINTL
PRINTFORML 단막을 시전하려면 당신은...
CALL ASK_M("소변을 봐라",1,"발작한다",1,"『탄막』이라고 외치며 손을 앞으로 뻗는다",1,"『탄마쿠!』라고 소리친다",1,"읽은 것은 잊고 상대에게 주먹을 날린다",1,)
pickedAnswers:0 = RESULT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:0,rightAnswers:0, "To cast Danmaku, you should say \"Danmaku\", and stretch your hand outwards.<br> To stop casting, retract your arm.<br> This is the case for any other Youjutsu spell.<br> This requires you to have the ability to talk, which means a Pacifier or Ball Gag will suppress your ability to cast Danmaku.")
PRINTL
PRINTFORML 2. 트레이닝 탄막은 ~에서 해야 한다
CALL ASK_M( "차고", 1, "연회", 1, "도서관", 1, "어린이집", 1, "탁 트인 들판", 1, )
pickedAnswers:1 = RESULT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:1,rightAnswers:1, "Danmaku Training should be done in an open field, clear from any possible items that could be damaged")
PRINTFORML 당신의 상대방이 시야 전체를 덮는 총알 커튼을 발동한다.
PRINTFORML 무엇을 할 것인가?
CALL ASK_M( "자신의 단막으로 돌파를 시도하라", 1, "맞기를 받아라", 1, "적에게 무도를 시전한다.", 1, "가능한 한 가깝게 스쳐 지나가면서 피하라", 1, "항복", 1, )
pickedAnswers:2 = RESULT
SELECTCASE pickedAnswers:2
	CASE 0
		LOCALS '= "자신의 탄막으로 다른 탄막을 상쇄할 수는 없다."
	CASE 1
		LOCALS '= "공격을 몸으로 받아 내는 것은 최후의 수단이어야 한다."
	CASE 2
		LOCALS '= "탄막 결투에서 치명적인 주문은 불법이다."
	CASE 3
		LOCALS '= "정답은 회피다. 지금 싸우는 곳이 3차원 공간이라는 사실을 잊지 마라!"
	CASE 4
		LOCALS '= "항복하는 것은 패배자뿐이다."
ENDSELECT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:2,rightAnswers:2, LOCALS)
PRINTFORML 허용되지 않는 능력 카드 타입을 표시한다.
CALL ASK_M( "활성화된 카드", 1, "아이템 카드", 1, "패시브 카드", 1, "장비 카드", 1, "위에 있는 것들 중 어느 것도 아니다", 1, )
pickedAnswers:3 = RESULT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:3,rightAnswers:3, "Only Equipment Cards are not allowed in Danmaku")
PRINTFORML 5. 마술 카드 배틀 동안 허용되는 무기는 무엇인가.
CALL ASK_M( "모든 것", 1, "유술만", 1, "단막과 스펠 카드", 1, "총기만 사용 가능", 1, "단마쿠 전용", 1, )
pickedAnswers:4 = RESULT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:4,rightAnswers:4, "Danmaku and Spell cards are allowed on Danmaku")
PRINTFORML 6. 빈칸을 채워라
PRINTFORML 기본적인 아이디어는 상대방을 당신이 맞기 전에 ___번 때리는 것이다 ___번 맞는다
CALL ASK_M( "세 개, 세 개", 1, "셋, 하나", 1, "세 개, 네 개", 1, "다섯, 다섯", 1, "하나, 하나", 1, )
pickedAnswers:5 = RESULT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:5,rightAnswers:5, "three, three")
PRINTFORML 다음 중 단막 수동 마법은 무엇인가?
CALL ASK_M( "전부 펼쳐 보여라", 1, "아지다인", 1, "세상", 1, "재각", 1, "물리적 무(無)", 1, )
pickedAnswers:6 = RESULT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:6,rightAnswers:6, "Spell It All Out is a Danmaku passive spell")
PRINTFORML 당신은 단막(탄막) 전투 도중에 스스로를 더럽혔다!
PRINTFORML 무엇을 할 것인가?
CALL ASK_M( "기저귀 소환술을 시전한다.", 1, "바지 안의 지저분한 것은 무시하고 계속 싸워라.", 1, "네 더러워진 속옷을 잡아당겨라", 1, "시간 초과를 요청한다", 1, "울면서 간병인이 알아봐 주길 바란다.", 1, )
pickedAnswers:7 = RESULT
SELECTCASE pickedAnswers:7
	CASE 0
		LOCALS '= "기저귀 소환은 다른 비탄막 요술과 마찬가지로 금지된 주문이다."
	CASE 1
		LOCALS '= "정답은 방금 저지른 실수를 무시하고 계속 싸우는 것이다. 갈아입는 건 나중에 해도 된다."
	CASE 2
		LOCALS '= "손으로 직접 속옷을 내리려 하면 상대에게 빈틈을 보이므로 해서는 안 된다."
	CASE 3
		LOCALS '= "대부분의 상대는 무슨 이유에서든 작전 시간을 받아 주지 않는다."
	CASE 4
		LOCALS '= "울음을 터뜨리는 것은 항복과 같고, 항복하는 것은 패배자뿐이다."
ENDSELECT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:7,rightAnswers:7, LOCALS)
PRINTFORML 9. 언제 스펠 카드 제약을 무시해서는 안 되는가
PRINTFORML 스펠 카드의 규칙을 무시한다는 것은 치명적인 힘이 승인되고 모든 능력의 제한이 해제된다는 것을 의미한다.
CALL ASK_M( "상대가 총을 꺼냈을 때", 1, "상대방이 치명적인 유술을 시전하기 시작할 때", 1, "상대방이 항복할 때.", 1, "당신의 생명이 어떤 방식으로든 위협받을 때", 1, "외부 개체로부터 공격을 받을 때", 1, )
pickedAnswers:8 = RESULT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:8,rightAnswers:8, "Spell Card rules can be disregarded when your life is threatened in any way.<br> This can include when your opponent discharges a firearm, casts lethal spells, or is otherwise makes moves that attempts to threaten the life of someone.<br> External interference such as a raid or attacking ground entity is also grounds for lethal force.<br> Your opponent surrendering is not grounds for you to execute them in the way you see fit.")
PRINTFORML 하루에 단 한 명의 적에게 몇 번이나 도전할 수 있을까...
CALL ASK_M( "무한히", 1, "세 번", 1, "한 번", 1 )
pickedAnswers:9 = RESULT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:9,rightAnswers:9, "Combatants will only accept a Danmaku challenge from you once per day.")
PRINTFORML 11. 빈칸을 채워라
PRINTFORML 만약 MP가 바닥나면, 당신은 _____해야 한다
CALL ASK_M( "항복", 1, "마법의 물약을 마신다", 1, "건물 안에 숨어라", 1, "도망쳐라", 1, "거기 서서 점심을 먹어라", 1 )
pickedAnswers:10 = RESULT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:10,rightAnswers:10, "If you run out of MP, you must surrender and lose the battle.")
PRINTFORML 12. 참인가 거짓인가:
PRINTFORML 더 많은 최대 MP를 얻으려면 현재 MP를 소모하기만 하면 된다
CALL ASK_M( "참", 1, "거짓이다", 1 )
pickedAnswers:11 = RESULT
CALL NAS_ESP_SELF_LEARN_0_ANSWER(pickedAnswers:11,rightAnswers:11, "This is a true statement")
scoreCounter:0 = 0
scoreCounter:1 = VARSIZE("rightAnswers")
FOR LOCAL,0,scoreCounter:1
SIF pickedAnswers:LOCAL == rightAnswers:LOCAL
	scoreCounter:0++
NEXT
PRINTFORML 점수
PRINTFORMW ・
PRINTFORML {scoreCounter:0}/{scoreCounter:1}
PRINTFORMW ・・
PRINTFORML {100*scoreCounter:0/scoreCounter:1}\%
PRINTFORMW ・・・
IF 100*scoreCounter:0/(scoreCounter:1) >= 80
	PRINTFORMW 축하한다, 너는 통과했다.
	CALL YoujutsuLearningProgress(ARG,0,10000)
ELSE
	PRINTFORMW 불행하게도 통과하지 못했다. 다음번에 다시 시도해라.
ENDIF

@NAS_ESP_SELF_LEARN_0_ANSWER(picked,correct,explain)
#DIM picked
#DIM correct
#DIMS explain
DRAWLINE
IF picked == correct
	SETCOLOR C_GREEN
	PRINTFORML 정답이다!
	RESETCOLOR
ELSE
	SETCOLOR C_RED
	PRINTFORML 틀린 대답이다!
	RESETCOLOR
ENDIF
HTML_PRINT explain
