@YoujutsuSelfStudyPuzzle_15(ARG)
CALL YoujutsuSelfStudyPuzzle_LetterQuests(ARG,15,"-273.15")

@YoujutsuSelfStudyPuzzle_Quest_15(ARG,nSearchMode = "GET")
#DIMS nSearchMode
#DIM DYNAMIC nHasDidIt
nHasDidIt = 0
SELECTCASE YoujutsuQuestProgress:ARG:15
	CASE 10000 TO 19999
		SELECTCASE nSearchMode
			CASE "SET"
				RETURN 1
			CASE "GET"
				CALL PRINT_LETTER(@"%CALLNAME:13%의 아이스크림 폭탄 퀘스트를 완료한다.",,40)
			CASE "CHECK"
				SIF YoujutsuQuestProgress:ARG:15 == 10001
					nHasDidIt = 1
				RETURN nHasDidIt
		ENDSELECT
	CASE 20000 TO 29999
		SELECTCASE nSearchMode
			CASE "SET"
				RETURN 1
			CASE "GET"
				CALL PRINT_LETTER(@"주변 온도가 영하 15도 미만일 때 전투 훈련을 한다.",,40)
			CASE "CHECK"
				SIF GET_現在気温() <= -150 && SELECTCOM == 411
					nHasDidIt = 1
				RETURN nHasDidIt
		ENDSELECT
		; CASE 30000 TO 39999
		;     SELECTCASE nSearchMode
		;     CASE "SET"
		;         RETURN 1
		;     CASE "GET"
		;         CALL PRINT_LETTER(@"Beat the eldrich being in combat.",,40)
		;     CASE "CHECK"
		;         SIF CFLAG:(151):弾幕勝負勝利
		;             nHasDidIt = 1
		;         RETURN nHasDidIt
		;     ENDSELECT
	CASEELSE
		RETURN 999
ENDSELECT
RETURN 0

