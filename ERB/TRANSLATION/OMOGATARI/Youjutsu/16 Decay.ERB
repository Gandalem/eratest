@YSSP16_MEAT_STATE(ARG)
#FUNCTION
SIF !(YJ16_Age:ARG)
	RETURNF -1
SELECTCASE TIME_PROGRESS(YJ16_Age:ARG)
	CASE IS < 90
		;fresh
		;0 to 90 minutes
		RETURNF 0
	CASE IS < 600
		;fine
		;90 minutes to 10 hours
		RETURNF 1
	CASE IS < 1440
		;oxidized
		;10 hours to 1 day
		RETURNF 2
	CASE IS < 2880
		;discolored
		;1 day to 2 days
		RETURNF 3
	CASE IS < 4320
		;slightly moldy
		;2 days to 3 days
		RETURNF 4
	CASE IS < 8640
		;rotten
		;3 days to 6 days
		RETURNF 5
	CASE IS < 11520
		;decaying
		;6 days to 8 days
		RETURNF 6
	CASEELSE
		;disintegrated
		;8 days+
		RETURNF 7
ENDSELECT

@YSSP16_IS_MEAT(ARG)
#FUNCTION
RETURNF (INRANGE(ARG,1220,1230) || INRANGE(ARG,701,708)) && STRLENS(ITEMNAME_TR(ARG))

@YSSP16_GET_XP(ARG)
#FUNCTION
#DIM CONST POINTS = 20,45,90,150,200,350,500,1000
#DIM DYNAMIC PointToGet
#DIM DYNAMIC PL_LOOP
FOR PL_LOOP, YJ16_SeePart:ARG, YSSP16_MEAT_STATE(ARG)+1
IF YJ16_SeePart:ARG < PL_LOOP
	PointToGet += POINTS:PL_LOOP
ENDIF
NEXT
SELECTCASE YJ16_Item:ARG
	CASE 701
		;pheasant
		TIMES PointToGet, 0.5
	CASE 702
		;red meat
		TIMES PointToGet, 0.7
	CASE 703
		;chicken meat
		TIMES PointToGet, 0.4
	CASE 705
		;unknown meat
		TIMES PointToGet, 1.0
	CASE 706
		;frog
		TIMES PointToGet, 0.75
	CASE 707
		;fish
		TIMES PointToGet, 0.6
	CASE 708
		;finest fish
		TIMES PointToGet, 1.2
	CASE 1220
		;human
		TIMES PointToGet, 1.0
	CASE 1221
		;youkai
		TIMES PointToGet, 1.1
	CASE 1222
		;hermet
		TIMES PointToGet, 1.3
	CASE 1223
		;divine spirit
		;tskumogami
		TIMES PointToGet, 1.5
	CASE 1224
		;phantom
		TIMES PointToGet, 1.25
	CASE 1225
		;fairy
		TIMES PointToGet, 0.7
	CASE 1226
		;tskumogami
		TIMES PointToGet, 1.4
	CASE 1227
		;oni
		TIMES PointToGet, 1.1
	CASE 1228
		;hourai
		TIMES PointToGet, 2.0
	CASE 1229
		;celestial
		TIMES PointToGet, 1.6
	CASE 1230
		;tengu
		TIMES PointToGet, 1.15
	CASEELSE
		;1.0x
ENDSELECT
RETURNF PointToGet

