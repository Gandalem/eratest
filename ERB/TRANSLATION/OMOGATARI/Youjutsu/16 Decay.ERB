	CALL COND_COLORMESSAGE(YoujutsuLevel:ARG:20 >= APATHEY_NEED && GETBIT(TALENT:ARG:ESP,20),@"{APATHEY_NEED} %NAS_ESP_NAME% Youjutsu (Current:\@ GETBIT(TALENT:ARG:ESP,20) ? {YoujutsuLevel:ARG:20} # Not Learned\@)")
	PRINT 　
	CALL COND_COLORMESSAGE(MAXBASE:ARG:7 >= MP_NEED,@"{MP_NEED} Max MP (Current:{MAXBASE:ARG:7})")
	PRINT 　
    CALL COND_COLORMESSAGE(0,@"Read a book about %LOCALS:1% magic in the SDM Library.")
ENDIF


