@YoujutsuSelfStudyPuzzle_12(ARG)
#DIM YSSP_LIFE
#DIM YSSP_MONEY
#DIM YSSP_LAPSES
#DIM YSSP_BARRIERS,3
#DIM YSSP_RAYS,3
#DIM YSSP_LINECOUNT
#DIM YSSP_UPGRADES, 3
YSSP_LIFE = 1000
YSSP_MONEY = 1000
YSSP_LAPSES = 0
VARSET YSSP_BARRIERS
VARSET YSSP_RAYS
YSSP_UPGRADES:0 = 1000
YSSP_UPGRADES:1 = 100000
YSSP_UPGRADES:2 = 1000000
CALL PRINT_RAINBOWL(@"불안정한 광선으로부터 방어해라!")
PRINTFORML 승리하려면 감마 보호막 500을 얻어라!
PRINTL
YSSP_LINECOUNT = LINECOUNT
DO
CLEARLINE LINECOUNT-YSSP_LINECOUNT
PRINTFORML 생명력: {YSSP_LIFE}
PRINTFORML 원소: {YSSP_MONEY}
PRINTL
PRINTFORML 【외부】
PRINTFORML 알파: %PALAM_NUM_NAS(YSSP_RAYS:0)%
PRINTFORML 베타 : %PALAM_NUM_NAS(YSSP_RAYS:1)%
PRINTFORML 감마: %PALAM_NUM_NAS(YSSP_RAYS:2)%
PRINTL
PRINTFORML 【보호】
PRINTFORML 알파 보호: %PALAM_NUM_NAS(YSSP_BARRIERS:0)%
PRINTFORML 베타 보호: %PALAM_NUM_NAS(YSSP_BARRIERS:1)%
PRINTFORML 감마 보호: %PALAM_NUM_NAS(YSSP_BARRIERS:2)%
PRINTL
PRINTFORML 【업그레이드】
PRINTFORML [100] - 종이 구매 (%PALAM_NUM_NAS(YSSP_UPGRADES:0)% 원자)
PRINTFORML [200] - 알루미늄 호일 구매 (%PALAM_NUM_NAS(YSSP_UPGRADES:1)% 원자)
PRINTFORML [300] - 납 구매 (%PALAM_NUM_NAS(YSSP_UPGRADES:2)% 원자)
PRINTL
PRINTFORML [-10] 바이패스 코드를 입력하라
PRINTFORML [-01] 종료한다
TINPUT (1000/60), 0,1
YSSP_LIFE = LIMIT(YSSP_LIFE+20,0,1000)
SELECTCASE RESULT
	CASE 100
		IF YSSP_MONEY >= YSSP_UPGRADES:0
			YSSP_BARRIERS:0 += 100
			YSSP_MONEY -= YSSP_UPGRADES:0
		ENDIF
	CASE 200
		IF YSSP_MONEY >= YSSP_UPGRADES:1
			YSSP_BARRIERS:0 += 1000
			YSSP_BARRIERS:1 += 10
			YSSP_MONEY -= YSSP_UPGRADES:1
		ENDIF
	CASE 300
		IF YSSP_MONEY >= YSSP_UPGRADES:2
			YSSP_BARRIERS:0 += 1000000000
			YSSP_BARRIERS:1 += 1000000000
			YSSP_BARRIERS:2 += 10
			YSSP_MONEY -= YSSP_UPGRADES:2
		ENDIF
	CASE -10
		CALL SPELL_THE_WORD_PUZZLE(ARG,SPELL_THE_WORDIFY(@"솔라 로드웨이즈"),10,LOCALS)
		IF RESULT == 1
			FONTITALIC
			CALL PRINT_GP("L", @"바이패스 코드가 승인되었다.")
			FONTREGULAR
			CALL YoujutsuLearningProgress(ARG,12,10000)
			RETURN
		ENDIF
	CASE -1
		RETURN
ENDSELECT
;alpha
YSSP_MONEY += (MIN(YSSP_BARRIERS:0,YSSP_RAYS:0))
IF YSSP_RAYS:0 > YSSP_BARRIERS:0 && YSSP_LAPSES % 15 == 0
	YSSP_LIFE -= (YSSP_RAYS:0-YSSP_BARRIERS:0)
ENDIF
;beta
YSSP_MONEY += (MIN(YSSP_BARRIERS:1,YSSP_RAYS:1)*25)
IF YSSP_RAYS:1 > YSSP_BARRIERS:1 && YSSP_LAPSES % 15 == 0
	YSSP_LIFE -= ((YSSP_RAYS:1-YSSP_BARRIERS:1)*10)
ENDIF
;gamma
YSSP_MONEY += (MIN(YSSP_BARRIERS:2,YSSP_RAYS:2)*10000)
IF YSSP_RAYS:2 > YSSP_BARRIERS:2 && YSSP_LAPSES % 15 == 0
	YSSP_LIFE -= ((YSSP_RAYS:2-YSSP_BARRIERS:2)*100)
ENDIF
IF YSSP_LIFE <= 0
	CALL PRINT_GP("L", @"피험체가 너무 많은 광선에 노출되어 소멸했다.")
	CALL PRINT_GP("W", @"게임 오버다.")
	RETURN
ENDIF
IF YSSP_BARRIERS:2 >= 500
	CALL PRINT_GP("L", @"이 정도의 보호막이라면 가장 에너지를 북돋는 광선조차 막을 것이다!")
	CALL PRINT_GP("W", @"코드 사용해 \"solarroadways\" 다음번에 프로그램을 건너뛰려면.")
	CALL YoujutsuLearningProgress(ARG,12,10000)
	RETURN
ENDIF
YSSP_LAPSES ++
YSSP_RAYS++
IF YSSP_RAYS >= 600 && YSSP_LAPSES % 15 == 0
	YSSP_RAYS:1 ++
ENDIF
IF YSSP_RAYS:1 >= 60 && YSSP_LAPSES % 60 == 0
	YSSP_RAYS:2 ++
ENDIF
LOOP 1
