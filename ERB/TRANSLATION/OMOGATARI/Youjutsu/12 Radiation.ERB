@YoujutsuSelfStudyPuzzle_12(ARG)
#DIM YSSP_LIFE
#DIM YSSP_MONEY
#DIM YSSP_LAPSES
#DIM YSSP_BARRIERS,3
#DIM YSSP_RAYS,3
#DIM YSSP_LINECOUNT
#DIM YSSP_UPGRADES, 3
YSSP_LIFE = 1000
YSSP_MONEY = 1000
YSSP_LAPSES = 0
VARSET YSSP_BARRIERS
VARSET YSSP_RAYS

YSSP_UPGRADES:0 = 1000
YSSP_UPGRADES:1 = 100000
YSSP_UPGRADES:2 = 1000000

CALL PRINT_RAINBOWL(@"Defend from the unstable rays!")
PRINTFORML Get 500 Gamma protection to win!
PRINTL
YSSP_LINECOUNT = LINECOUNT
DO
    CLEARLINE LINECOUNT-YSSP_LINECOUNT  
    PRINTFORML Life : {YSSP_LIFE}
    PRINTFORML Atoms: {YSSP_MONEY}
    PRINTL
    PRINTFORML 【Outside】
    PRINTFORML Alpha: %PALAM_NUM_NAS(YSSP_RAYS:0)%
    PRINTFORML Beta : %PALAM_NUM_NAS(YSSP_RAYS:1)%
    PRINTFORML Gamma: %PALAM_NUM_NAS(YSSP_RAYS:2)%
    PRINTL
    PRINTFORML 【Protection】
    PRINTFORML Alpha Protection: %PALAM_NUM_NAS(YSSP_BARRIERS:0)%
    PRINTFORML Beta  Protection: %PALAM_NUM_NAS(YSSP_BARRIERS:1)%
    PRINTFORML Gamma Protection: %PALAM_NUM_NAS(YSSP_BARRIERS:2)%
    PRINTL
    PRINTFORML 【Upgrades】
    PRINTFORML [100] - Buy paper (%PALAM_NUM_NAS(YSSP_UPGRADES:0)% atoms)
    PRINTFORML [200] - Buy aluminum foil (%PALAM_NUM_NAS(YSSP_UPGRADES:1)% atoms)
    PRINTFORML [300] - Buy lead (%PALAM_NUM_NAS(YSSP_UPGRADES:2)% atoms)
    PRINTL
    PRINTFORML [-10] - Enter Bypass Code
    PRINTFORML [-01] - Quit
    TINPUT (1000/60), 0,1
    YSSP_LIFE = LIMIT(YSSP_LIFE+20,0,1000)
    SELECTCASE RESULT
    CASE 100
        IF YSSP_MONEY >= YSSP_UPGRADES:0
            YSSP_BARRIERS:0 += 100
            YSSP_MONEY -= YSSP_UPGRADES:0
        ENDIF
    CASE 200
        IF YSSP_MONEY >= YSSP_UPGRADES:1
            YSSP_BARRIERS:0 += 1000
            YSSP_BARRIERS:1 += 10
            YSSP_MONEY -= YSSP_UPGRADES:1
        ENDIF
    CASE 300
        IF YSSP_MONEY >= YSSP_UPGRADES:2
            YSSP_BARRIERS:0 += 1000000000
            YSSP_BARRIERS:1 += 1000000000
            YSSP_BARRIERS:2 += 10
            YSSP_MONEY -= YSSP_UPGRADES:2
        ENDIF
    CASE -10
        CALL SPELL_THE_WORD_PUZZLE(ARG,SPELL_THE_WORDIFY(@"solarroadways"),10,LOCALS)
        IF RESULT == 1
            FONTITALIC
            CALL PRINT_GP("L", @"Bypass code accepted.")
            FONTREGULAR
            CALL YoujutsuLearningProgress(ARG,12,10000)
            RETURN
        ENDIF
    CASE -1
        RETURN
    ENDSELECT


    ;alpha
    YSSP_MONEY += (MIN(YSSP_BARRIERS:0,YSSP_RAYS:0))
    IF YSSP_RAYS:0 > YSSP_BARRIERS:0 && YSSP_LAPSES % 15 == 0
        YSSP_LIFE -= (YSSP_RAYS:0-YSSP_BARRIERS:0)
    ENDIF
    ;beta
    YSSP_MONEY += (MIN(YSSP_BARRIERS:1,YSSP_RAYS:1)*25)
    IF YSSP_RAYS:1 > YSSP_BARRIERS:1 && YSSP_LAPSES % 15 == 0
        YSSP_LIFE -= ((YSSP_RAYS:1-YSSP_BARRIERS:1)*10)
    ENDIF
    ;gamma
    YSSP_MONEY += (MIN(YSSP_BARRIERS:2,YSSP_RAYS:2)*10000)
    IF YSSP_RAYS:2 > YSSP_BARRIERS:2 && YSSP_LAPSES % 15 == 0
        YSSP_LIFE -= ((YSSP_RAYS:2-YSSP_BARRIERS:2)*100)
    ENDIF


    IF YSSP_LIFE <= 0
        CALL PRINT_GP("L", @"The subject has combusted due to too many rays hitting it.")
        CALL PRINT_GP("W", @"Game over.")
        RETURN
    ENDIF
    IF YSSP_BARRIERS:2 >= 500
        CALL PRINT_GP("L", @"This amount of protection will stop even the most energizing of rays!")
        CALL PRINT_GP("W", @"Use code \"solarroadways\" to skip the program next time.")
	    CALL YoujutsuLearningProgress(ARG,12,10000)
        RETURN
    ENDIF
    YSSP_LAPSES ++
    YSSP_RAYS++
    IF YSSP_RAYS >= 600 && YSSP_LAPSES % 15 == 0
        YSSP_RAYS:1 ++
    ENDIF
    IF YSSP_RAYS:1 >= 60 && YSSP_LAPSES % 60 == 0
        YSSP_RAYS:2 ++
    ENDIF
LOOP 1

