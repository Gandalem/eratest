;///////////////////////////////////////
;Spell Results
;///////////////////////////////////////
@EsperMenuResult_3(PYC_CASTER,PYC_TARGET,nInput)
#DIM nInput
#DIM PYC_TARGET
#DIM PYC_CASTER
#DIM nIncreaseAmount
#DIM EMR
#DIM EMR3_COUNT
EMR = TOINT(SUBSTRING(GETDOINGFUNCTION(),16))
TRYCALLFORM NAS_ESP_{EMR}_{nInput}

SELECTCASE nInput
CASE 0
CASE 1
CASE 30
    FOR EMR3_COUNT,0,2
        SELECTCASE K113_BODY(PYC_CASTER)
            CASE 1
                LOCAL:0 = 2
                LOCALS:0 = Moon
                LOCAL:1 = 3
                LOCALS:1 = Earth
            CASE 2
                LOCAL:0 = 3
                LOCALS:0 = Earth
                LOCAL:1 = 1
                LOCALS:1 = Otherworld
            CASE 3
                LOCAL:0 = 1
                LOCALS:0 = Otherworld
                LOCAL:1 = 2
                LOCALS:1 = Moon
        ENDSELECT
        CALL Add_Duplicate_Character(PYC_CASTER, @"%CALLNAME:PYC_CASTER% (%LOCALS:EMR3_COUNT%)")
		SIF RESULT < 0 ;cannot create duplicate
			BREAK
        PYC_TARGET = RESULT
        ;override color
        CFLAG:PYC_TARGET:1101 = LOCAL:(EMR3_COUNT)
        CFLAG:PYC_TARGET:好感度 -= (EMR3_COUNT) + 1;lower Favor to keep them nicely in order, at least at the start
        ;set affinity for other hecatias
        RELATION:PYC_TARGET:PYC_CASTER = 500
        RELATION:PYC_CASTER:PYC_TARGET = 500
        IF EMR3_COUNT == 1;set to other one as well
            RELATION:PYC_TARGET:(LOCAL:11) = 500
            RELATION:(LOCAL:11):PYC_TARGET = 500
        ENDIF
        SIF CFLAG:PYC_TARGET:衣装一時変更 == 55 ;no bunny girl outfits for alternate Hecatias
            CFLAG:PYC_TARGET:衣装一時変更 = 0

        LOCAL:(11+EMR3_COUNT) = PYC_TARGET ;save newly created ids

        ;give them different panties
        CFLAG:PYC_TARGET:205 = 0
        CFLAG:PYC_TARGET:206 = 0
        CFLAG:PYC_TARGET:207 = 0
        CFLAG:PYC_TARGET:208 = 0
        CALL SET_UNDERWEAR(PYC_TARGET, "今日の衣装")
        EQUIP:PYC_TARGET:下半身下着２ = CFLAG:PYC_TARGET:きょうのぱんつ

        CALLNAME:PYC_TARGET '= @"%CALLNAME:PYC_CASTER% (%LOCALS:EMR3_COUNT%)"
		CFLAG:PYC_TARGET:MARKED_FOR_DELETION = 1
        IF DT_EXIST("TGC_Map")
            CALL AddCombatantWithMessage(PYC_TARGET,DT_CELL_GET("lcCombatants", GetCombatant(PYC_CASTER), "side", 1))
            CALL TGC_MoveChara(PYC_TARGET,TOINT(SPLIT_SINGLE(DT_CELL_GETS("lcCombatants", GetCombatant(PYC_CASTER), "positionID", 1), 0, ","))+RAND(-1,2),TOINT(SPLIT_SINGLE(DT_CELL_GETS("lcCombatants", GetCombatant(PYC_CASTER), "positionID", 1), 1, ","))+RAND(-1,2))
        ELSEIF DT_EXIST("lcCombatants")
        CALL AddCombatantWithMessage(PYC_TARGET,DT_CELL_GET("lcCombatants", GetCombatant(PYC_CASTER), "side", 1))
        ELSE
        PRINTFORMDL %CALLNAME:PYC_TARGET% arrives.
        ENDIF
    NEXT
	IF RESULT < 0
		;error message
		DEBUGPRINTFORML Error while trying to create duplicates.
		PRINTFORML 「Whoops, looks like it's not working right now.」
		PRINTFORML 「%PARSE("You'll",5,,PYC_CASTER)% just have to settle for just %CALLNAME:PYC_CASTER% today.」
	ELSEIF DT_EXIST("lcCombatants")
		;set colors for each
		CALL SET_KOJO_COLOR(PYC_TARGET)
		PRINTFORML 「With all three of me here, this will be sure to become an experience you can never forget.」
		SETCOLOR K113_BODYCOLOR(LOCAL:0)
		PRINTFORML 「Even if you beg us to surrender, we won't let you go until you're all destroyed to bits.」
		SETCOLOR K113_BODYCOLOR(LOCAL:1)
		PRINTFORML 「Now, prepare yourself for the ultimate battle of %TOLOWER(TNAME(PYC_CASTER))%!」
        RESETCOLOR
	ENDIF
CASE 31
    ;flandre clone
    FOR EMR3_COUNT,0,3
        LOCAL:0 = 1
        LOCALS:0 = 1st Slave
        LOCAL:1 = 2
        LOCALS:1 = 2nd Slave
        LOCAL:2 = 3
        LOCALS:2 = 3rd Slave
        CALL Add_Duplicate_Character(PYC_CASTER, @"%CALLNAME:PYC_CASTER% (%LOCALS:EMR3_COUNT%)")
		SIF RESULT < 0 ;cannot create duplicate
			BREAK
        PYC_TARGET = RESULT
        ;override color
        CFLAG:PYC_TARGET:1101 = LOCAL:(EMR3_COUNT)
        CFLAG:PYC_TARGET:好感度 -= (EMR3_COUNT) + 1;lower Favor to keep them nicely in order, at least at the start
        ;set affinity for other hecatias
        RELATION:PYC_TARGET:PYC_CASTER = 500
        RELATION:PYC_CASTER:PYC_TARGET = 500
        IF EMR3_COUNT == 1;set to other one as well
            RELATION:PYC_TARGET:(LOCAL:11) = 500
            RELATION:(LOCAL:11):PYC_TARGET = 500
        ENDIF
        SIF CFLAG:PYC_TARGET:衣装一時変更 == 55 ;no bunny girl outfits for alternate Hecatias
            CFLAG:PYC_TARGET:衣装一時変更 = 0

        LOCAL:(11+EMR3_COUNT) = PYC_TARGET ;save newly created ids

        ;give them different panties
        CFLAG:PYC_TARGET:205 = 0
        CFLAG:PYC_TARGET:206 = 0
        CFLAG:PYC_TARGET:207 = 0
        CFLAG:PYC_TARGET:208 = 0
        CALL SET_UNDERWEAR(PYC_TARGET, "今日の衣装")
        EQUIP:PYC_TARGET:下半身下着２ = CFLAG:PYC_TARGET:きょうのぱんつ

        CALLNAME:PYC_TARGET '= @"%CALLNAME:PYC_CASTER% (%LOCALS:EMR3_COUNT%)"
		CFLAG:PYC_TARGET:MARKED_FOR_DELETION = 1
        IF DT_EXIST("TGC_Map")
            CALL AddCombatantWithMessage(PYC_TARGET,DT_CELL_GET("lcCombatants", GetCombatant(PYC_CASTER), "side", 1))
            CALL TGC_MoveChara(PYC_TARGET,TOINT(SPLIT_SINGLE(DT_CELL_GETS("lcCombatants", GetCombatant(PYC_CASTER), "positionID", 1), 0, ","))+RAND(-1,2),TOINT(SPLIT_SINGLE(DT_CELL_GETS("lcCombatants", GetCombatant(PYC_CASTER), "positionID", 1), 1, ","))+RAND(-1,2))
        ELSEIF DT_EXIST("lcCombatants")
        CALL AddCombatantWithMessage(PYC_TARGET,DT_CELL_GET("lcCombatants", GetCombatant(PYC_CASTER), "side", 1))
        ELSE
        PRINTFORMDL %CALLNAME:PYC_TARGET% arrives.
        ENDIF
    NEXT
    PRINTFORMDL %PARSE("You",,,PYC_CASTER)% %PARSE("clone",,,PYC_CASTER)% %PARSE("yourself",,,PYC_CASTER)% into four copies.

	IF RESULT < 0
		;error message
		DEBUGPRINTFORML Error while trying to create duplicates.
		PRINTFORML 「Whoops, looks like it's not working right now.」
		PRINTFORML 「%PARSE("You'll",5,,PYC_CASTER)% just have to settle for just %CALLNAME:PYC_CASTER% today.」
	ENDIF
ENDSELECT
WAIT

