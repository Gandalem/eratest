@EsperMenuResult_20(PYC_CASTER,PYC_TARGET,nInput)
#DIM nInput
#DIM PYC_TARGET
#DIM PYC_CASTER
#DIM nIncreaseAmount
#DIM EMR
#DIM EMR_SINGLE
EMR = TOINT(SUBSTRING(GETDOINGFUNCTION(),16))
TRYCALLFORM NAS_ESP_{EMR}_{nInput}
SELECTCASE nInput
	CASE 0, 1
		EMR_SINGLE = 0
	CASE 2, 3
		EMR_SINGLE = 2
	CASE 4, 5
		EMR_SINGLE = 4
	CASE 6, 7
		EMR_SINGLE = 6
	CASE 8, 9, 10
		EMR_SINGLE = 6
ENDSELECT
SELECTCASE nInput
	CASE 0
		CALL BUFF_CHANGE(PYC_TARGET,0,-1)
	CASE 2
		CALL BUFF_CHANGE(PYC_TARGET,1,-1)
	CASE 4
		CALL BUFF_CHANGE(PYC_TARGET,2,-1)
	CASE 6
		CALL BUFF_CHANGE(PYC_TARGET,3,-1)
	CASE 8
		CALL BUFF_CHANGE(PYC_TARGET,4,-1)
	CASE 1, 3, 5, 7
		CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,20,EMR_SINGLE,1)
	CASE 10
		CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,20,1003,1)
	CASE 11
		CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,20,1002,1)
	CASE 12
		CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,20,1001,1)
	CASE 13
		CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,20,1000,1)
	CASE 1000
		;Taunt
		CALL BUFF_CHANGE(PYC_TARGET,0,2)
		CALL BUFF_CHANGE(PYC_TARGET,1,-2)
	CASE 1001
		;War Cry
		CALL BUFF_CHANGE(PYC_TARGET,0,-2)
	CASE 1002
		;Fog Breath
		CALL BUFF_CHANGE(PYC_TARGET,2,-2)
		CALL BUFF_CHANGE(PYC_TARGET,3,-2)
	CASE 1003
		;Dehibilitate
		CALL BUFF_CHANGE(PYC_TARGET,0,-1)
		CALL BUFF_CHANGE(PYC_TARGET,1,-1)
		CALL BUFF_CHANGE(PYC_TARGET,2,-1)
		CALL BUFF_CHANGE(PYC_TARGET,3,-1)
		CALL BUFF_CHANGE(PYC_TARGET,4,-1)
ENDSELECT

@YoujutsuSelfStudyPuzzle_20(ARG)
#DIM DYNAMIC opp
#DIM DYNAMIC oldCont
oldCont = lcDirectControl
PRINTFORML 상당히 괜찮은 적과 싸워라.
PRINTFORML 공격력과 방어력이 각각 -6으로 디버프 될 것이다.
PRINTFORMW 유주츠를 배우려면 전투에서 승리해라.
CALLF AddCombatant(ARG,0)
opp = FREE_MOB_SLOT()
CALL SpawnMobEnemy(opp,10401)
CALLF AddCombatant(opp,1)
DT_CELL_SET "lcCombatants", GetCombatant(ARG), BUFF_NAMES(0,2), -6, 1
DT_CELL_SET "lcCombatants", GetCombatant(ARG), BUFF_NAMES(1,2), -6, 1
CALL KNIFE_FIGHT(ARG,opp)
SIF ARG != MASTER
	lcDirectControl = 1
SIF LCWarResult == 0
	CALL YoujutsuLearningProgress(ARG,20,10000)
CFLAG:(ARG):睡眠 = 0
lcDirectControl = oldCont
;You hit a wall! Try again.
;Good job!
