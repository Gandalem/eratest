	IF nPee
		CALL PeeBar(TARGET,21, 1, 1)
		SETCOLOR EnduranceColors(PeeHold:TARGET:2)
		PRINTFORM  %GET_TALENTNAME_TR(1514, PeeHold:TARGET:2)% ({PeeHold:TARGET:0} + {PeeHold:TARGET:1} = {PeeHold:TARGET:2})
		RESETCOLOR
		PRINTL
	ENDIF
	IF nScat
		CALL PooBar(TARGET,21, 1, 1)
		SETCOLOR EnduranceColors(PooHold:TARGET:2)
		PRINTFORM %GET_TALENTNAME_TR(1500, PooHold:TARGET:2)% ({PooHold:TARGET:0} + {PooHold:TARGET:1} = {PooHold:TARGET:2})
		RESETCOLOR
		PRINTL
	ENDIF
ENDIF
