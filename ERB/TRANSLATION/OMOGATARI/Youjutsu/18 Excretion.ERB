@EsperMenuResult_18(PYC_CASTER,PYC_TARGET,NASPicked)
#DIM HYP_RESULT
#DIM PYC_TARGET
#DIM PYC_CASTER
#DIM NASPicked
#DIM nIncreaseAmount
#DIM nIncreaseExtra
#DIM EMR_SINGLE
#DIM EMR18_LIST,100
#DIM DYNAMIC EMR_BASE
TRYCALLFORM NAS_ESP_18_{NASPicked}

SELECTCASE NASPicked
CASE 10 TO 11
    nIncreaseAmount = 33
    EMR_SINGLE = 10
    EMR_BASE = 4
CASE 12 TO 13
    nIncreaseAmount = 66
    nIncreaseExtra = 150
    EMR_SINGLE = 22
    EMR_BASE = 4
CASE 14 TO 15
    nIncreaseAmount = 100
    nIncreaseExtra = 1000
    EMR_SINGLE = 14
    EMR_BASE = 4
CASE 20 TO 21
    nIncreaseAmount = 33
    EMR_SINGLE = 20
    EMR_BASE = 17
CASE 22 TO 23
    nIncreaseAmount = 66
    nIncreaseExtra = 150
    EMR_SINGLE = 22
    EMR_BASE = 17
CASE 24 TO 25, 35, 36
    nIncreaseAmount = 100
    nIncreaseExtra = 1000
    EMR_SINGLE = 24
    EMR_BASE = 17
CASE 28,29
    EMR_SINGLE = 28
ENDSELECT

SELECTCASE NASPicked
CASE 0
	PRINTFORMW You cast the spell on \@PYC_TARGET == MASTER ? yourself # %CALLNAME:PYC_TARGET%\@.
	CALL RECOVER(PYC_TARGET,MAXBASE:PYC_TARGET:体力,"体力", NAS_ESP_NAME) ;qol custom code
	CALL RECOVER(PYC_TARGET,MAXBASE:PYC_TARGET:1, BASENAME:1, NAS_ESP_NAME) ;qol custom code
	PRINTFORML %PARSE("Your",,,PYC_TARGET)% body feels way better after casting that.
	SIF PooBarStage(PYC_CASTER) >= 7 || PeeBarStage(PYC_CASTER) >= 7
		PRINTFORML But your tummy starts to go into overdrive, and you can't help but to void on the spot.
CASE 10, 12, 14, 20, 22, 24
    CALL RECOVER(PYC_TARGET,(MAXBASE:PYC_TARGET:EMR_BASE*nIncreaseAmount/100)+nIncreaseExtra, BASENAME:EMR_BASE, @"%CALLNAME:PYC_CASTER%'s %NAS_ESP_NAME%") ;qol custom code
CASE 11, 13, 15, 21, 23, 25, 35
    IF DT_EXIST("lcCombatants")
        VARSET EMR18_LIST
        tempHediffCount = DT_SELECT("lcCombatants", @"side = {!DT_CELL_GET("lcCombatants", GetCombatant(PYC_CASTER), "side", 1)}",,EMR18_LIST)
        FOR LOCAL,0,tempHediffCount+1
            SIF DT_CELL_GET("lcCombatants", EMR18_LIST:LOCAL, "chara", 1) == PYC_CASTER
                CONTINUE
            CALL EsperMenuResult_18(PYC_CASTER,DT_CELL_GET("lcCombatants", EMR18_LIST:LOCAL, "chara", 1),EMR_SINGLE)
        NEXT
    ELSE
        FOR LOCAL,0,CHARANUM
            SIF CFLAG:LOCAL:300 != CFLAG:MASTER:300
                CONTINUE
            SIF LOCAL == PYC_CASTER
                CONTINUE
            CALL EsperMenuResult_18(PYC_CASTER,LOCAL,EMR_SINGLE)
        NEXT
    ENDIF
CASE 29
    IF DT_EXIST("lcCombatants")
        VARSET EMR18_LIST
        tempHediffCount = DT_SELECT("lcCombatants", @"side = {DT_CELL_GET("lcCombatants", GetCombatant(PYC_CASTER), "side", 1)}",,EMR18_LIST)
        FOR LOCAL,0,tempHediffCount+1
            SIF DT_CELL_GET("lcCombatants", EMR18_LIST:LOCAL, "chara", 1) == PYC_CASTER
                CONTINUE
            CALL EsperMenuResult_18(PYC_CASTER,DT_CELL_GET("lcCombatants", EMR18_LIST:LOCAL, "chara", 1),EMR_SINGLE)
        NEXT
    ELSE
        FOR LOCAL,0,CHARANUM
            SIF CFLAG:LOCAL:300 != CFLAG:MASTER:300
                CONTINUE
            SIF LOCAL == PYC_CASTER
                CONTINUE
            CALL EsperMenuResult_18(PYC_CASTER,LOCAL,EMR_SINGLE)
        NEXT
    ENDIF
CASE 28
    CALLF PEEME(PYC_TARGET,0)
    CALLF PooME(PYC_TARGET,0)
CASE 30,31
    CALL EsperMenuResult_19(PYC_TARGET,PYC_TARGET,NASPicked)
CASE 32
    INVERTBIT YoujutsuEffects:PYC_TARGET:18, 22
CASE 34
    INVERTBIT YoujutsuEffects:PYC_TARGET:18, 34
CASE 36
    ;PRINTFORMW did it to {PYC_TARGET} %NAME:PYC_TARGET%! Value: {(MAXBASE:PYC_TARGET:4*nIncreaseAmount/100)+nIncreaseExtra} | Extra Amount: {nIncreaseExtra}
    CALL RECOVER(PYC_TARGET,(MAXBASE:PYC_TARGET:4*nIncreaseAmount/100)+nIncreaseExtra, BASENAME:4, @"%CALLNAME:PYC_CASTER%'s %NAS_ESP_NAME%") ;qol custom code
    CALL RECOVER(PYC_TARGET,(MAXBASE:PYC_TARGET:17*nIncreaseAmount/100)+nIncreaseExtra, BASENAME:17, @"%CALLNAME:PYC_CASTER%'s %NAS_ESP_NAME%") ;qol custom code
CASE 37
    ;Waste Redirection
    CALL WasteRedirection(PYC_CASTER,PYC_TARGET)
ENDSELECT
