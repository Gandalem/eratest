@SHOW_FALL_STATE_REV_INFO_218(ARG)
SFSR_TYPE '= "Youjutsu"
SFSR_CANDO = nPee || nScat
VARSET NAS_ESP_NAME
LOCALS '= SUBSTRING(GETDOINGFUNCTION(),25)
LOCAL = MAX(0,TOINT(LOCALS)-200)
TRYCALLFORMF NAS_ESP_{LOCAL}()
SFSR_NAME '= "Youjutsu: "+NAS_ESP_NAME

@SHOW_FALL_STATE_REV_218(ARG)
#DIM YOUJUTSU
#DIM AG_NEEDED
#DIM KNOW_NEED
#DIM MEDICAL_NEED
#DIM MP_NEED
LOCALS '= SUBSTRING(GETDOINGFUNCTION(),20)
YOUJUTSU = MAX(0,TOINT(LOCALS)-200)
TRYCALLFORMF NAS_ESP_{YOUJUTSU}()
KNOW_NEED = UniversalRank("A")
MEDICAL_NEED = UniversalRank("B")
MP_NEED = 500
IF GETBIT(TALENT:ARG:ESP,18)
	PRINT 　
	CALL COLORMESSAGE(@"획득함",C_YELLOW,1)
ELSE
	PRINT 　
	CALL COND_COLORMESSAGE(ABL:ARG:43 >= KNOW_NEED,@"{KNOW_NEED} 지식 (현재:{ABL:ARG:43})")
	PRINT 　
	CALL COND_COLORMESSAGE(ABL:ARG:Medical >= MEDICAL_NEED,@"{MEDICAL_NEED} 의학적 (현재:{ABL:ARG:Medical})")
	PRINT 　
	CALL COND_COLORMESSAGE(GETBIT(TALENT:ARG:OmoGuardian,0)||GETBIT(TALENT:ARG:OmoGuardian,1),@"%PeeAndPoo(GETBIT(nPee,1),GETBIT(nScat,2), GET_TALENTNAME_TR(177,1),  GET_TALENTNAME_TR(177,2), " or")%")
	PRINT 　
	CALL COND_COLORMESSAGE(MAXBASE:ARG:7 >= MP_NEED,@"{MP_NEED} 최대 MP (현재:{MAXBASE:ARG:7})")
	PRINT 　
	CALL COND_COLORMESSAGE(0,@"SDM 도서관에서 %NAS_ESP_NAME% 마법에 관한 책을 읽는다.")
ENDIF

