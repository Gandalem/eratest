@SHOW_FALL_STATE_REV_218(ARG)
#DIM YOUJUTSU
#DIM AG_NEEDED
#DIM KNOW_NEED
#DIM MEDICAL_NEED
#DIM MP_NEED
LOCALS '= SUBSTRING(GETDOINGFUNCTION(),20)
YOUJUTSU = MAX(0,TOINT(LOCALS)-200)
TRYCALLFORMF NAS_ESP_{YOUJUTSU}()

KNOW_NEED = UniversalRank("A")
MEDICAL_NEED = UniversalRank("B")
MP_NEED = 500

IF GETBIT(TALENT:ARG:ESP,18)
	PRINT 　
	CALL COLORMESSAGE(@"-　Acquired",C_YELLOW,1)
ELSE
	PRINT 　
	CALL COND_COLORMESSAGE(ABL:ARG:43 >= KNOW_NEED,@"{KNOW_NEED} Knowledge (Current:{ABL:ARG:43})")
	PRINT 　
	CALL COND_COLORMESSAGE(ABL:ARG:Medical >= MEDICAL_NEED,@"{MEDICAL_NEED} Medical (Current:{ABL:ARG:Medical})")
	PRINT 　
	CALL COND_COLORMESSAGE(GETBIT(TALENT:ARG:OmoGuardian,0)||GETBIT(TALENT:ARG:OmoGuardian,1),@"%PeeAndPoo(GETBIT(nPee,1),GETBIT(nScat,2), GET_TALENTNAME_TR(177,1),  GET_TALENTNAME_TR(177,2), " or")%")
	PRINT 　
	CALL COND_COLORMESSAGE(MAXBASE:ARG:7 >= MP_NEED,@"{MP_NEED} Max MP (Current:{MAXBASE:ARG:7})")
	PRINT 　
    CALL COND_COLORMESSAGE(0,@"Read a book about %NAS_ESP_NAME% magic in the SDM Library.")
ENDIF

