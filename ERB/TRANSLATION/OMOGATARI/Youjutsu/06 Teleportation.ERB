YOUJUTSU = MAX(0,TOINT(LOCALS)-200)
TRYCALLFORMF NAS_ESP_{YOUJUTSU}()
KNOW_NEED = UniversalRank("Ex")
FLIGHT_NEED = UniversalRank("A")
MSUM_NEED = UniversalRank("B")
MP_NEED = 4000
LOCALS:1 '= NAS_ESP_NAME
IF GETBIT(TALENT:ARG:ESP,6)
	PRINT 　
	CALL COLORMESSAGE(@"획득함",C_YELLOW,1)
ELSE
	PRINT 　
	CALL COND_COLORMESSAGE(ABL:ARG:43 >= KNOW_NEED,@"{KNOW_NEED} 지식 (현재:{ABL:ARG:43})")
	PRINT 　
	CALLF NAS_ESP_1()
	CALL COND_COLORMESSAGE(YoujutsuLevel:ARG:1 >= FLIGHT_NEED && GETBIT(TALENT:ARG:ESP,1),@"{FLIGHT_NEED} %NAS_ESP_NAME% 유술 (현재:\@ GETBIT(TALENT:ARG:ESP,1) ? {YoujutsuLevel:ARG:1} # 배우지 않음 \@)")
	PRINT 　
	CALLF NAS_ESP_3()
	CALL COND_COLORMESSAGE(YoujutsuLevel:ARG:3 >= MSUM_NEED && GETBIT(TALENT:ARG:ESP,3),@"{MSUM_NEED} %NAS_ESP_NAME% 유술 (현재:\@ GETBIT(TALENT:ARG:ESP,3) ? {YoujutsuLevel:ARG:3} # 학습하지 않음 \@)")
	PRINT 　
	CALL COND_COLORMESSAGE(MAXBASE:ARG:7 >= MP_NEED,@"{MP_NEED} 최대 MP (현재:{MAXBASE:ARG:7})")
	PRINT 　
	CALL COND_COLORMESSAGE(0,@"SDM 도서관에서 %LOCALS:1% 마법에 관한 책을 읽는다.")
ENDIF
