@YoujutsuSelfStudyPuzzle_6(ARG)
#DIM YSSP_LINECOUNT
#DIM YSSP_COUNT
#DIM YSSP_LOCATION
#DIM YSSP_CORRECT
#DIM YSSP_CORRECT_LOCATION
#DIM YSSP_INPUT
#DIM YSSP_ROLLING
#DIM IS_WRONG
#DIM nPrintLineCount
YSSP_LINECOUNT = LINECOUNT
DO
	CLEARLINE LINECOUNT - YSSP_LINECOUNT
    CALL YoujutsuLearningProgress(ARG,6,0)
	PRINTL
	VARSET YSSP_ROLLING, -1
	VARSET YSSP_INPUT
	VARSET IS_WRONG
	REDRAW 0
	CALL FISHER_YATES_SHAFFLE(200)
	DO
		YSSP_ROLLING++
		IF YSSP_ROLLING >= 200
			THROW Failed to generate location after 200 attempts.
		ENDIF
		YSSP_CORRECT = SHAFFLE_ARRAY:YSSP_ROLLING
		SIF !STRLENS(STR_TR(6000+YSSP_CORRECT))
			CONTINUE
		YSSP_CORRECT_LOCATION = GET_MAPID(YSSP_CORRECT*10)
		BREAK
	LOOP 1

	CALL PRINT_RAINBOWL("Guess the Map!")

	PRINTFORMSL STR_TR(6000+YSSP_CORRECT)
	PRINTL
	nPrintLineCount = LINECOUNT
	$GO_BACK
	VARSET YSSP_COUNT
	CLEARLINE LINECOUNT - nPrintLineCount
	RESETCOLOR
	FOR YSSP_LOCATION,0,20
		IF IS_WRONG == 1 && YSSP_LOCATION == YSSP_INPUT
			SETCOLOR C_RED
		ELSEIF IS_WRONG && YSSP_LOCATION == YSSP_CORRECT_LOCATION
			SETCOLOR C_GREEN
		ENDIF
		IF GET_MAPNAME(YSSP_LOCATION) != "Mystery Area"
			PRINTFORM %@"[%TOSTR(YSSP_LOCATION,"00")%] - %GET_MAPNAME(YSSP_LOCATION)%",40,LEFT%
			YSSP_COUNT ++
			IF YSSP_COUNT%4 == 0
				YSSP_COUNT = 0
				PRINTL
			ENDIF
		ENDIF
    	RESETCOLOR
	NEXT
	SIF YSSP_COUNT%4
		PRINTL
	PRINTL
	PRINTFORML [-9] - Return
	SELECTCASE IS_WRONG
	CASE 1
		GOTO AFTER_SET_RED
	CASE -1
		GOTO AFTER_SET_GREEN
	CASEELSE
		INPUT
	ENDSELECT
	YSSP_INPUT = RESULT
	SELECTCASE YSSP_INPUT
	CASE -9
	RETURN -99
	CASE YSSP_CORRECT_LOCATION
		STOPSOUND
		PLAYSOUND "se/正解.wav"	
		IS_WRONG = -1
		GOTO GO_BACK
		$AFTER_SET_GREEN
    	CALL YoujutsuLearningProgress(ARG,6,500)
		TWAIT 1000, 0
	CASEELSE
		$ADD_ELSE
		STOPSOUND
		PLAYSOUND "se/間違い.wav"
		IS_WRONG = 1
		GOTO GO_BACK
		$AFTER_SET_RED
		TWAIT 1000, 0
	ENDSELECT
LOOP 1

