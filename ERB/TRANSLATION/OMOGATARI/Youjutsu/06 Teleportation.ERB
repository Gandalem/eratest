@SHOW_FALL_STATE_REV_206(ARG)
#DIM YOUJUTSU
#DIM AG_NEEDED
#DIM KNOW_NEED
#DIM FLIGHT_NEED
#DIM MP_NEED
#DIM MSUM_NEED
