@ReunionYoujutsu(CASTER, TeleFrom=-1,TeleTo=-1)
#DIM TeleCost
#DIM CASTER
#DIM TeleFrom
#DIM TeleTo
#DIM TeleCant
#DIM GetMap, 2
#DIMS DYNAMIC TeleCantReason = "", "Character unavailable", "Targets not set"
gLineCount = LINECOUNT
SIF TeleTo == -1
	TeleTo = CASTER
DO
	TeleCant = 0
	IF (TeleFrom < 0 || TeleTo < 0)
		TeleCant = 2
	ELSEIF CFLAG:TeleTo:300 == SUKIMA()
		TeleCant = 1
	ENDIF

	CLEARLINE LINECOUNT-gLineCount
	PRINTBUTTON @"%"Character to teleport:",24,LEFT% \@TeleFrom == -1 ? Unknown # %NAME:TeleFrom%\@", 100
	PRINTL
	PRINTBUTTON @"%"Teleporting to:",24,LEFT% \@TeleTo == -1 ? Unknown # %NAME:TeleTo%\@", 101
	PRINTL
	PRINTFORML %"Cost:",24,LEFT% \@ TeleFrom < 0 || TeleTo < 0 ? {0,4,LEFT} # {TeleCost,4,LEFT}\@ MP
	PRINTL
	SELECTCASE TeleCant
	CASE 0
		PRINTFORML [0] - Cast
	CASEELSE
		SETCOLOR C_GRAY
		PRINTPLAINFORM [0] - Cast (%TeleCantReason:TeleCant%)
		PRINTL
		RESETCOLOR
	ENDSELECT
	PRINTFORML [9] - Cancel
	INPUT
	SELECTCASE RESULT
	CASE 100
		CALL SHOW_CHARA_LIST_TR()
		SIF RESULT != 999
		TeleFrom = RESULT
	CASE 101
		CALL SHOW_CHARA_LIST_TR()
		SIF RESULT != 999
		TeleTo = RESULT
	CASE 0
		IF TeleCant
			;anti retard/gap space 
			PRINTFORMW Can't cast Reunion. Reason: %TeleCantReason:TeleCant%
			CONTINUE
		ENDIF
		

		CALL RECOVER(CASTER, -TeleCost, BASENAME:NAS_ESP_BASE, NAS_ESP_NAME)
		CFLAG:TeleFrom:現在位置 = CFLAG:TeleTo:現在位置
		CFLAG:TeleFrom:遭遇位置 = CFLAG:TeleTo:現在位置
		CFLAG:TeleFrom:拠点来訪 = 1
		TCVAR:TeleFrom:なるべく動かない = 1
		CALLF WAKEUP(TeleFrom)
		TIME:5 = 0
		RETURN
	CASE 9
		RETURN
	ENDSELECT
	IF !(TeleFrom < 0 || TeleTo < 0)
		GetMap:0 = GET_MAPID(CFLAG:TeleFrom:300)
		GetMap:1 = GET_MAPID(CFLAG:TeleTo:300)
		SIF CFLAG:TeleFrom:300 == SUKIMA()
			GETMAP:0 = GET_MAPID(CFLAG:TeleFrom:358)
		SIF CFLAG:TeleTo:300 == SUKIMA()
			GETMAP:1 = GET_MAPID(CFLAG:TeleTo:358)

		TeleCost = TIME_REQUIRED(GetMap:0,GetMap:1)*6
	ENDIF
LOOP 1

