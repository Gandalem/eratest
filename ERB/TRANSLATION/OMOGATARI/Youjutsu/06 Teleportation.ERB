TRYCALLFORMF NAS_ESP_{YOUJUTSU}()

KNOW_NEED = UniversalRank("Ex")
FLIGHT_NEED = UniversalRank("A")
MSUM_NEED = UniversalRank("B")
MP_NEED = 4000
LOCALS:1 '= NAS_ESP_NAME

IF GETBIT(TALENT:ARG:ESP,6)
	PRINT 　
	CALL COLORMESSAGE(@"-　Acquired",C_YELLOW,1)
ELSE
	PRINT 　
	CALL COND_COLORMESSAGE(ABL:ARG:43 >= KNOW_NEED,@"{KNOW_NEED} Knowledge (Current:{ABL:ARG:43})")
	PRINT 　
    CALLF NAS_ESP_1()
	CALL COND_COLORMESSAGE(YoujutsuLevel:ARG:1 >= FLIGHT_NEED && GETBIT(TALENT:ARG:ESP,1),@"{FLIGHT_NEED} %NAS_ESP_NAME% Youjutsu (Current:\@ GETBIT(TALENT:ARG:ESP,1) ? {YoujutsuLevel:ARG:1} # Not Learned\@)")
	PRINT 　
    CALLF NAS_ESP_3()
	CALL COND_COLORMESSAGE(YoujutsuLevel:ARG:3 >= MSUM_NEED && GETBIT(TALENT:ARG:ESP,3),@"{MSUM_NEED} %NAS_ESP_NAME% Youjutsu (Current:\@ GETBIT(TALENT:ARG:ESP,3) ? {YoujutsuLevel:ARG:3} # Not Learned\@)")
	PRINT 　
	CALL COND_COLORMESSAGE(MAXBASE:ARG:7 >= MP_NEED,@"{MP_NEED} Max MP (Current:{MAXBASE:ARG:7})")
	PRINT 　
    CALL COND_COLORMESSAGE(0,@"Read a book about %LOCALS:1% magic in the SDM Library.")
ENDIF


