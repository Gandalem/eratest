@EsperMenuResult_2(PYC_CASTER,PYC_TARGET,NASPicked)
#DIM HYP_RESULT
#DIM PYC_TARGET
#DIM PYC_CASTER
#DIM NASPicked
#DIM nIncreaseAmount
#DIM nIncreaseExtra
#DIM EMR_SINGLE
#DIM EMR2_LIST,100
#DIM DYNAMIC EMR_BASE
TRYCALLFORM NAS_ESP_2_{NASPicked}
SELECTCASE NASPicked
	CASE 0
		EMR2_LIST:0 = MIN(3,nMaxWeaponTech)
		EMR2_LIST:1 = MIN(5,nMaxWeaponTech)
	CASE 1
		EMR2_LIST:0 = MIN(6,nMaxWeaponTech)
		EMR2_LIST:1 = MIN(8,nMaxWeaponTech)
		NASPicked = 0
	CASE 2
		EMR2_LIST:0 = MIN(9,nMaxWeaponTech)
		EMR2_LIST:1 = nMaxWeaponTech
		NASPicked = 0
ENDSELECT
SELECTCASE NASPicked
	CASE 0, 1, 2
		WHILE 1
		LOCAL = MakeDesiredWeapon("firearm/")
		IF INRANGE(GET_INT(PYC_TARGET, "Weapon", LOCAL, "Tech Level"),EMR2_LIST:0,EMR2_LIST:1)
			BREAK
		ENDIF
		WEND
		PRINTFORMW %PARSE("You conjugate",,,PYC_CASTER)% 스스로에게 %UNDIES_NAME_WITH_BRAND(PYC_TARGET,LOCAL,1,24)% 위에서 \@ PYC_TARGET == MASTER ?  # %CALLNAME:PYC_TARGET% \@
		CALLF EquipWeapon(PYC_TARGET,LOCAL)
	CASE 3
		PRINTFORMW %PARSE("You conjugate",,,PYC_CASTER)% 기저귀를 ~에 \@ PYC_TARGET == MASTER ? 너 자신에게 # %CALLNAME:PYC_TARGET% \@.
		SELECTCASE LEVEL_TO_RANK(YoujutsuLevel:PYC_CASTER:18)
			CASE 0
				;paper pamp
				EMR2_LIST:0 = 136
				EMR2_LIST:1 = 100
				EMR2_LIST:2 = 66
			CASE 1
				;pull-up
				EMR2_LIST:0 = 73
				EMR2_LIST:1 = 200
				EMR2_LIST:2 = 150
			CASE 2
				;urb-pad
				EMR2_LIST:0 = 101
				EMR2_LIST:1 = 200
				EMR2_LIST:2 = 150
			CASE 3
				;ko-fantastabab
				EMR2_LIST:0 = 134
				EMR2_LIST:1 = 300
				EMR2_LIST:2 = 200
			CASE 4
				;fantastabab
				EMR2_LIST:0 = 103
				EMR2_LIST:1 = 300
				EMR2_LIST:2 = 200
			CASE 5
				;dai-daiper
				EMR2_LIST:0 = 174
				EMR2_LIST:1 = 500
				EMR2_LIST:2 = 300
			CASE 6, 7
				;fantastabab+
				EMR2_LIST:0 = 171
				EMR2_LIST:1 = 5000
				EMR2_LIST:2 = 30000
			CASE 8, 9, 10
				;dai-daiper+
				EMR2_LIST:0 = 178
				EMR2_LIST:1 = 30000
				EMR2_LIST:2 = 20000
		ENDSELECT
		CALLF Panty_Rework_Change(PYC_TARGET,EMR2_LIST)
		PantiesType:PYC_TARGET:2 '= "Booster"
		DiapeCharges:PYC_TARGET:2 = LEVEL_TO_RANK(YoujutsuLevel:PYC_CASTER:18)*(EMR2_LIST:1)
		DiapePooCharges:PYC_TARGET:2 = LEVEL_TO_RANK(YoujutsuLevel:PYC_CASTER:18)*(EMR2_LIST:2)
		DiapeCharges:PYC_TARGET:2 += DiapeCharges:PYC_TARGET:2
		DiapePooCharges:PYC_TARGET:2 += DiapePooCharges:PYC_TARGET:2
		PadCount:PYC_TARGET:0 += 1
		DiapeCharges:PYC_TARGET:1 += DiapeCharges:PYC_TARGET:2
		DiapePooCharges:PYC_TARGET:1 += DiapePooCharges:PYC_TARGET:2
		DiapeCharges:PYC_TARGET:0 = DiapeCharges:PYC_TARGET:1
		DiapePooCharges:PYC_TARGET:0 = DiapePooCharges:PYC_TARGET:1
	CASE 20
		PRINTFORML %CALLNAME:TARGET%에 걸린 모든 구속이 마법처럼 풀린다.
		FOR LOCAL,1,29
		SIF LOCAL == 12
			CONTINUE
		IF CHASTITY_ITEM(LOCAL,EQUIP:PYC_TARGET:LOCAL)
			CFLAG:PYC_TARGET:(200+LOCAL) = 0
			CFLAG:PYC_TARGET:(240+LOCAL) = 0
			EQUIP:PYC_TARGET:LOCAL   = 0
		ENDIF
		NEXT
		CFLAG:PYC_TARGET:LockedPampCover = -1
		IF DiapeMagicAttunement:PYC_TARGET:0 == "lockDiaper"
			PRINTFORML %CALLNAME:PYC_TARGET%의 잠금 조율인 %PeeProtectType(PYC_TARGET,2)%가 사라진다.
			DiapeMagicAttunement:PYC_TARGET:0 '= ""
		ENDIF
ENDSELECT
WAIT
