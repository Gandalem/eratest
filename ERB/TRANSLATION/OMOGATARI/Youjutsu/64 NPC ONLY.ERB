;///////////////////////////////////////
;Spell Results
;///////////////////////////////////////
@EsperMenuResult_64(PYC_CASTER,PYC_TARGET,nInput)
#DIM nInput
#DIM PYC_TARGET
#DIM PYC_CASTER
#DIM nIncreaseAmount
#DIM EMR
EMR = TOINT(SUBSTRING(GETDOINGFUNCTION(),16))
TRYCALLFORM NAS_ESP_{EMR}_{nInput}

SELECTCASE nInput
CASE 0
    PRINTFORMW Suddenly, your doppelganger reaches into %HIS_HER(MASTER)% bag.
    PRINTFORMW Pulling out a bottle, %HE_SHE(MASTER)% quickly chugs a few gulps before replacing it.
    PRINTFORMW As %HE_SHE(MASTER)% drinks, you feel cold liquid appearing in your own stomach, increasing your need to go!
    CALLF PeeMe(MASTER,PeeBarStage(MASTER)+1)
CASE 1
    PRINTFORMW Suddenly, your doppelganger reaches into %HIS_HER(MASTER)% bag.
    PRINTFORMW Pulling out a jar, %HE_SHE(MASTER)% quickly chugs before replacing the empty jar.
    PRINTFORMW As %HE_SHE(MASTER)% eats, you feel the jar's contents appearing in your own stomach, increasing your need to go!
    CALLF PooMe(MASTER,PooBarStage(MASTER)+1)
CASE 2
    PRINTFORMW Your mimic pulls a familiar-looking green stone out of %HIS_HER(MASTER)% pocket.
    PRINTFORMW As %HE_SHE(MASTER)% holds it aloft, it enwreaths %HIM_HER(MASTER)% in green light.
    PRINTFORMW You have a bad feeling that %HE_SHE(MASTER)% just got healthier...
    ; PM7_HEALTH:0 = PM7_HEALTH:1
CASE 3
CALL BUFF_CHANGE(PYC_CASTER,0,6)
CALL BUFF_CHANGE(PYC_CASTER,1,6)
CALL BUFF_CHANGE(PYC_CASTER,2,6)
CALL BUFF_CHANGE(PYC_CASTER,3,6)
CALL BUFF_CHANGE(PYC_CASTER,4,6)
ENDSELECT
WAIT