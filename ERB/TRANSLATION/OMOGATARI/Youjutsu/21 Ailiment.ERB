@EsperMenuResult_21(PYC_CASTER,PYC_TARGET,nInput)
#DIM nInput
#DIM PYC_TARGET
#DIM PYC_CASTER
#DIM nIncreaseAmount
#DIM EMR
#DIM EMR_SINGLE
#DIM EMR7_LIST,100
EMR = TOINT(SUBSTRING(GETDOINGFUNCTION(),16))
TRYCALLFORM NAS_ESP_{EMR}_{nInput}
SELECTCASE nInput
	CASE 0 TO 1
		EMR_SINGLE = 0
	CASE 2 TO 3
		EMR_SINGLE = 2
	CASE 8
		EMR_SINGLE = 7
	CASEELSE
		EMR_SINGLE = 4
ENDSELECT
SELECTCASE nInput
	CASE 0
		;lose their turn
		SETCOLOR C_RED
		CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%가 독에 걸렸다!", , 2,)
		RESETCOLOR
		DT_CELL_SET "lcCombatants", GetCombatant(PYC_TARGET), "poisonAilment", 3, 1
	CASE 2
		;mute
		SETCOLOR C_RED
		CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%은(는) 음소거되었다!", , 2,)
		RESETCOLOR
		DT_CELL_SET "lcCombatants", GetCombatant(PYC_TARGET), "muteAilment", 5, 1
	CASE 9
		;lose their turn
		SETCOLOR C_RED
		CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%이(가) 잠들었다!", , 2,)
		RESETCOLOR
		DT_CELL_SET "lcCombatants", GetCombatant(PYC_TARGET), "sleepAilment", 3, 1
	CASE 1, 3, 8
		CALL MULTI_YOUJUTSU_EFFECT(PYC_CASTER,21,EMR_SINGLE,1)
	CASE 7
		SETCOLOR C_RED
		CALL LC_PRINT(@"%CALLNAME:PYC_TARGET%이(가) 폭탄으로 장치되어 있었다!", , 2,)
		RESETCOLOR
		CALLF AddBionic(PYC_TARGET,67,132,0) ; bomb
ENDSELECT
