    PRINTFORML POTENTIAL LOST! (%CALLNAME:ARG%)
    RESETCOLOR
    PRINTFORMW %EsperAbilitySTR(youjutsuType)% Potential -{ABS(pointsAdd)} (now {YoujutsuPotential:ARG:youjutsuType})
ENDIF

