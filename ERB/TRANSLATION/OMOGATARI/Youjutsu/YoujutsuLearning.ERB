@YoujutsuSelfStudyQuestTrack(ARG,GetMode="CHECK")
#DIM YOUJUTSU
#DIMS GetMode
FOR YOUJUTSU,0,64
    $GoBack
    RESULT = 0
    SIF !YoujutsuQuestProgress:ARG:YOUJUTSU
        CONTINUE
    SELECTCASE GetMode
    CASE "GET"
        TRYCCALLFORM YoujutsuSelfStudyPuzzle_Quest_{YOUJUTSU}(ARG,"SET")
        CATCH
            CONTINUE
        ENDCATCH
        IF RESULT == 1
            TRYCALLFORMF NAS_ESP_{YOUJUTSU}
            PRINTFORML 　＜Youjutsu: %NAS_ESP_NAME% (Quest #%TOFULL(TOSTR(YoujutsuQuestProgress:ARG:YOUJUTSU/10000))%)＞
            TRYCCALLFORM YoujutsuSelfStudyPuzzle_Quest_{YOUJUTSU}(ARG,"GET")
            CATCH
                CONTINUE
            ENDCATCH
        ENDIF
    CASE "CHECK"
        TRYCCALLFORM YoujutsuSelfStudyPuzzle_Quest_{YOUJUTSU}(ARG, "CHECK")
        CATCH
        ENDCATCH
        SELECTCASE RESULT
        CASE 1
            LOCAL:6 = YoujutsuQuestProgress:ARG:YOUJUTSU
            ;next stage, clear progress
            YoujutsuQuestProgress:ARG:YOUJUTSU += 10000
            YoujutsuQuestProgress:ARG:YOUJUTSU /= 10000
            YoujutsuQuestProgress:ARG:YOUJUTSU *= 10000

            TRYCALLFORM YoujutsuSelfStudyPuzzle_Quest_{YOUJUTSU}(ARG,"SET")
            SELECTCASE RESULT
            CASE 999
                GOTO GetYoujutsu
            CASEELSE
                CALL PRINT_GP("L", @"As the %NUM_COUNT(LOCAL:6/10000,1)% quest is finished, the letter now has a new assignment written on it:")
                TRYCALLFORM YoujutsuSelfStudyPuzzle_Quest_{YOUJUTSU}(ARG,"GET")
            ENDSELECT
        CASE 999
            $GetYoujutsu
            SIF YoujutsuLearnType:ARG:YOUJUTSU == "self"
                CONTINUE

            CALL PRINT_GP("L", @"As the last quest is finished, the letter begins burning as %PARSE("you hold",,,ARG)% it.")
            CALL PRINT_GP("L", @"%PARSE("You drop",5,,ARG)% the paper and it's essence begins to transfer over to %PARSE("you",6,,ARG)%.")
            CALL YoujutsuLearningProgress(ARG,YOUJUTSU,10000)
        ENDSELECT
    ENDSELECT
NEXT

