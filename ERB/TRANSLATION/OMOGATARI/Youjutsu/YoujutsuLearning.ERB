@EXPPotentialChangeMsg(ARG,expType,pointsAdd)
#DIM expType
#DIM pointsAdd
EXPPotential:ARG:expType = MAX(0,EXPPotential:ARG:expType+pointsAdd)
IF pointsAdd > 0
	CALL PRINT_RAINBOWL(@"잠재력 획득! (%CALLNAME:ARG%)")
	PRINTFORMW %EXP_TR(expType)% 잠재력+{pointsAdd} 증가 (현재 {EXPPotential:ARG:expType})
ELSE
	SETCOLOR C_RED
	PRINTFORML 잠재력이 사라졌다! (%CALLNAME:ARG%)
	RESETCOLOR
	PRINTFORMW %EXP_TR(expType)% 잠재력 -{ABS(pointsAdd)} (현재 {EXPPotential:ARG:expType})
ENDIF
