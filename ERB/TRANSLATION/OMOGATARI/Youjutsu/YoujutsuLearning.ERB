@GUESS_THE_ITEM(ARG,nMaxWealth=50000,nMinWealth=0, nMaxItems = 10)
#DIM nMaxWealth
#DIM nMinWealth
#DIM nCurrentItem
#DIM nItemIDs, 10
#DIM nCurrentSlot
#DIM nCorrectSlot
#DIM nMaxItems
#DIM nItemMakeAttempt
#DIM nItemClassAttempt
#DIMS ALT_DESC
#DIM IS_WRONG
#DIM HIT_RESULT
#DIM nPrintLineCount
#DIM itemIsClothing
#DIM itemClassID

VARSET nItemIDs,0
VARSET IS_WRONG
nCorrectSlot = RAND(0,nMaxItems)
FOR nCurrentSlot,0,nMaxItems
    $ReSort
    CALL FISHER_YATES_SHAFFLE(1000)
    nItemMakeAttempt = 0
    nItemClassAttempt = 0
    itemIsClothing = !RAND:2
    IF itemIsClothing == 1
        IF !RAND:4
            IF !RAND:2
                itemIsClothing = 955
            ELSE
                itemIsClothing = 24
            ENDIF
        ELSE
            itemIsClothing = RAND(VARSIZE("EquipIDSTR"))
            SIF itemIsClothing == 10
                itemIsClothing = 17
        ENDIF
    ENDIF
    $RegenerateItem
    nItemMakeAttempt++
    nItemClassAttempt++
    ;crash if we fail hard
    IF nItemMakeAttempt >= 1000
        GOTO ReSort
    ENDIF
    IF nItemMakeAttempt >= 10000
        THROW Failed to make a valid item after 10000 attempts. Wealth Range: {nMinWealth} to {nMaxWealth}
    ENDIF

    nCurrentItem = SHAFFLE_ARRAY:nItemMakeAttempt
    IF itemIsClothing == 955
        SIF !STRLENS(GET_STR(ARG, "WeaponPreset", nCurrentItem, "Name"))
            GOTO RegenerateItem
        SIF !INRANGE(WeaponPrice(1000+nCurrentItem,10),nMinWealth,nMaxWealth)
            GOTO RegenerateItem
        IF nCurrentSlot == nCorrectSlot
            SIF GROUPMATCH(GET_STR(ARG,"WeaponPreset",nCurrentItem,"Description"),"0","",TOLOWER(GET_STR(ARG, "WeaponPreset", nCurrentItem, "Name")),GET_STR(ARG, "WeaponPreset", nCurrentItem, "Name"))
                GOTO RegenerateItem
        ENDIF
        nCurrentItem += ((itemIsClothing*1000)+1000)
        SIF FINDELEMENT(nItemIDs,nCurrentItem) > -1
            GOTO RegenerateItem
    ELSEIF itemIsClothing
        SIF !STRLENS(GET_STR(ARG, EquipIDSTR:itemIsClothing, nCurrentItem, "名前"))
            GOTO RegenerateItem
        SIF GET_INT(ARG, EquipIDSTR:itemIsClothing, nCurrentItem, "Firearm Template")
            GOTO RegenerateItem
        SIF !INRANGE(ClothPrice(EquipIDSTR:itemIsClothing,nCurrentItem,0)/(EquipIDSTR:itemIsClothing == "Weapon" ? 10 # 1),nMinWealth,nMaxWealth)
            GOTO RegenerateItem
        IF nCurrentSlot == nCorrectSlot
            SIF GROUPMATCH((Clothes_FullDescription(EquipIDSTR:itemIsClothing, nCurrentItem, ARG, 1)),"0","",TOLOWER(CLOTHES_TR(GET_STR(ARG, EquipIDSTR:itemIsClothing, nCurrentItem, "名前"))),CLOTHES_TR(GET_STR(ARG, EquipIDSTR:itemIsClothing, nCurrentItem, "名前")))
                GOTO RegenerateItem
        ENDIF
        nCurrentItem += ((itemIsClothing*1000)+1000)
        SIF FINDELEMENT(nItemIDs,nCurrentItem) > -1
            GOTO RegenerateItem
    ELSE
        SIF !STRLENS(ITEMNAME:(nCurrentItem))
            GOTO RegenerateItem
        SIF FINDELEMENT(nItemIDs,nCurrentItem) > -1
            GOTO RegenerateItem
        SIF !INRANGE(ITEMPRICE:(nCurrentItem),nMinWealth,nMaxWealth)
            GOTO RegenerateItem
        IF nCurrentSlot == nCorrectSlot
            SIF !STRLENS(MAIL_ORDER_DESCRIPTION(nCurrentItem, 1))
                GOTO RegenerateItem
        ENDIF
    ENDIF
    nItemIDs:nCurrentSlot = nCurrentItem
NEXT

CALL PRINT_RAINBOWL("Guess the Item!")
itemClassID = (nItemIDs:nCorrectSlot-1000)/1000
nCurrentItem = (nItemIDs:nCorrectSlot-1000)%1000
IF nItemIDs:nCorrectSlot >= 1000
    IF itemClassID == 955
        ALT_DESC '= GET_STR(ARG,"WeaponPreset",nCurrentItem,"Description")
    ELSE
        ALT_DESC '= Clothes_FullDescription(EquipIDSTR:itemClassID, nCurrentItem, ARG, 1)
    ENDIF

    SELECTCASE itemClassID
    CASE 17
    LOCALS:1 '= UNDIES_NAME_WITH_BRAND(ARG,nCurrentItem,-1)
    SIF STRFIND(LOCALS:1,"++") > -1
        LOCALS:1 '= SUBSTRING(LOCALS:1,0,STRLENS(LOCALS:1)-2)

    ALT_DESC '= REPLACE(ALT_DESC, LOCALS:1, "______")
    ALT_DESC '= REPLACE(ALT_DESC, TOLOWER(LOCALS:1), "______")
    CASE 24
    ALT_DESC '= REPLACE(ALT_DESC, PrintWeaponName(ARG,nCurrentItem,-1,1), "______")
    ALT_DESC '= REPLACE(ALT_DESC, TOLOWER(PrintWeaponName(ARG,nCurrentItem,-1,1)), "______")
    CASE 955
    ALT_DESC '= REPLACE(ALT_DESC, PrintWeaponName(ARG,nCurrentItem+1000,-1,1), "______")
    ALT_DESC '= REPLACE(ALT_DESC, TOLOWER(PrintWeaponName(ARG,nCurrentItem+1000,-1,1)), "______")
    CASEELSE
    ALT_DESC '= REPLACE(ALT_DESC, CLOTHES_TR(GET_STR(ARG, EquipIDSTR:itemClassID, nCurrentItem, "名前")), "______")
    ALT_DESC '= REPLACE(ALT_DESC, TOLOWER(CLOTHES_TR(GET_STR(ARG, EquipIDSTR:itemClassID, nCurrentItem, "名前"))), "______")
    ENDSELECT
ELSE
    LOCALS:1 '= ITEMNAME_TR(nItemIDs:nCorrectSlot)
    SIF STRFIND(LOCALS:1,"[") > -1
        LOCALS:1 '= SUBSTRING(LOCALS:1,1)
    SIF STRFIND(LOCALS:1,"]") > -1
        LOCALS:1 '= SUBSTRING(LOCALS:1,0,STRLENS(LOCALS:1)-1)
    [SKIPSTART]
    LOCALS:1 '= REPLACE(LOCALS:1, "\[", "")
    LOCALS:1 '= REPLACE(LOCALS:1, "\]", "")
    [SKIPEND]

    ALT_DESC '= MAIL_ORDER_DESCRIPTION(nItemIDs:nCorrectSlot, 1)
    ALT_DESC '= REPLACE(ALT_DESC, LOCALS:1, "______")
    ALT_DESC '= REPLACE(ALT_DESC, TOLOWER(LOCALS:1), "______")
ENDIF

HTML_PRINT HTML_ESCAPE(ALT_DESC)
PRINTL
nPrintLineCount = LINECOUNT
$GO_BACK
CLEARLINE LINECOUNT - nPrintLineCount
RESETCOLOR
FOR nCurrentSlot,0,nMaxItems
    IF IS_WRONG == 1 && nCurrentSlot == HIT_RESULT
        SETCOLOR C_RED
    ELSEIF IS_WRONG && nCurrentSlot == nCorrectSlot
        SETCOLOR C_GREEN
    ENDIF

    IF nItemIDs:nCurrentSlot >= 1000
        itemClassID = (nItemIDs:nCurrentSlot-1000)/1000
        nCurrentItem = (nItemIDs:nCurrentSlot-1000)%1000
        SELECTCASE itemClassID
        CASE 17
        LOCALS '= UNDIES_NAME_WITH_BRAND(ARG,nCurrentItem,1)
        CASE 24
        LOCALS '= PrintWeaponName(ARG,nCurrentItem,1,1)
        CASE 955
        LOCALS '= PrintWeaponName(ARG,nCurrentItem+1000,1,1)
        CASEELSE
        LOCALS '= CAPITALIZE(CLOTHES_TR(GET_STR(ARG, EquipIDSTR:itemClassID, nCurrentItem, "名前")))
        ENDSELECT
    ELSE
        LOCALS '= ITEMNAME_TR(nItemIDs:nCurrentSlot)
    ENDIF
    PRINTFORML [{nCurrentSlot,2}] - %LOCALS%
    RESETCOLOR
NEXT
PRINTL
PRINTFORML [-9] - Return
SELECTCASE IS_WRONG
CASE 1
    GOTO AFTER_SET_RED
CASE -1
    GOTO AFTER_SET_GREEN
CASEELSE
    INPUT
ENDSELECT
HIT_RESULT = RESULT
SELECTCASE HIT_RESULT
CASE -9
RETURN -99
CASE nCorrectSlot
    STOPSOUND
    PLAYSOUND "se/正解.wav"	
    IS_WRONG = -1
    GOTO GO_BACK
    $AFTER_SET_GREEN
    TWAIT 1000, 0
    RETURN 1
CASEELSE
    $ADD_ELSE
    STOPSOUND
    PLAYSOUND "se/間違い.wav"
    IS_WRONG = 1
    GOTO GO_BACK
    $AFTER_SET_RED
    TWAIT 1000, 0
    RETURN -1
ENDSELECT

