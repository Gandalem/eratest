@YoujutsuSelfStudyMenu(ARG)
#DIM YoujutsuStudy
PRINTFORML Please select a book %COND_STR(@"for %CALLNAME:ARG% ",ARG != MASTER)%tostudy on.

FOR LOCAL,0,64
    VARSET NAS_ESP_BOOK_NAME
    TRYCALLFORMF NAS_ESP_{LOCAL}_BOOK
    SIF NAS_ESP_BOOK_NAME == ""
        CONTINUE
    TRYCALLFORMF NAS_ESP_{LOCAL}
    PRINTFORM [{LOCAL,2}] %NAS_ESP_BOOK_NAME% 
    SETCOLOR C_GRAY
    PRINTFORM by %NAS_ESP_BOOK_AUTHOR%
    PRINTL
    RESETCOLOR
    PRINTFORM %NAS_ESP_NAME, 15%: 
    IF !GETBIT(TALENT:ARG:ESP,LOCAL)
        PRINTFORM Not Learned
    ELSE
    
        CALL PRINT_RANK(YoujutsuLevel:ARG:LOCAL,"MAX_6")
        PRINTFORM  {YoujutsuLevel:ARG:LOCAL}
    ENDIF
    PRINTL
    RESETCOLOR
NEXT
PRINTL
PRINTFORML [-1] Cancel
INPUT
YoujutsuStudy = RESULT
SELECTCASE YoujutsuStudy
CASE 0 TO 64
    TRYCCALLFORM YoujutsuSelfStudyPuzzle_{YoujutsuStudy}(ARG)
    CATCH
        TRYCALLFORMF NAS_ESP_{YoujutsuStudy}
        SETCOLOR C_YELLOW
        PRINTL
        PRINTFORML %"-"*89%
        PRINTFORML No Youjutsu Self Study puzzle for {YoujutsuStudy} %NAS_ESP_NAME%.
        PRINTFORML Giving Youjutsu as compensation.
        PRINTFORML %"-"*89%
        RESETCOLOR
    	CALL YoujutsuLearningProgress(ARG,YoujutsuStudy,10000)
    ENDCATCH
    TRYCALLFORMF NAS_ESP_{YoujutsuStudy}_BOOK
    RETURN YoujutsuStudy
CASE -1
RETURN
CASEELSE
REUSELASTLINE Invalid Input
RESTART
ENDSELECT

