	CALL PRINT_RAINBOWL(@"잠재력이 얻어졌다! (%CALLNAME:ARG%)")
	PRINTFORMW %EsperAbilitySTR(youjutsuType)% 잠재력+{pointsAdd} 증가 (현재 {YoujutsuPotential:ARG:youjutsuType})
ELSE
	SETCOLOR C_RED
	PRINTFORML 잠재력 상실! (%CALLNAME:ARG%)
