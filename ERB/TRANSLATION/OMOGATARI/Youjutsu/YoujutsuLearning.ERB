@SPELL_THE_WORD_PUZZLE(ARG,THE_WORD,KNOW_START,ALL_TIPS)
#DIMS THE_WORD
#DIMS LAST_STRINGS, 5
#DIMS CURRENT_STRING
#DIMS CHECK_STRING
#DIM CHECKING
#DIM IS_WRONG
#DIM KNOW_START
#DIMS ALL_TIPS
#DIM CORRECTNESS
VARSET CURRENT_STRING
VARSET IS_WRONG
VARSET LAST_STRINGS
CALL PRINT_RAINBOWL("Spell the word!")
PRINTFORML 각 글자를 개별적으로 입력한다.
PRINTL
gLineCount = LINECOUNT
$GO_BACK
CLEARLINE LINECOUNT - gLineCount
FOR CHECKING,4,-2,-1
VARSET CORRECTNESS
IF CHECKING < 0
	CHECK_STRING '= CURRENT_STRING
ELSE
	CHECK_STRING '= LAST_STRINGS:CHECKING
ENDIF
SIF CHECK_STRING == "" && CHECKING > -1
	CONTINUE
FOR LOCAL,0,STRCOUNT(THE_WORD,"/")
IF IS_WRONG || CHECKING > -1
	SETCOLOR C_RED
	IF SPLIT_SINGLE(CHECK_STRING,LOCAL,"/") == SPLIT_SINGLE(THE_WORD,LOCAL,"/")
		SETCOLOR C_GREEN
		CORRECTNESS += 10000/STRCOUNT(THE_WORD,"/")
	ELSEIF STRFIND(THE_WORD, SPLIT_SINGLE(CHECK_STRING,LOCAL,"/")) > -1
		SETCOLOR C_YELLOW
		CORRECTNESS += (10000/STRCOUNT(THE_WORD,"/")*33/100)
	ENDIF
ENDIF
IF SPLIT_SINGLE(CHECK_STRING,LOCAL,"/") == ""
	PRINTFORM _
ELSE
	FONTSTYLE 8
	PRINTFORM %SPLIT_SINGLE(CHECK_STRING,LOCAL,"/")%
	FONTREGULAR
ENDIF
NEXT
RESETCOLOR
IF IS_WRONG || CHECKING > -1
	SIF CHECK_STRING == THE_WORD
		CORRECTNESS = 10000
	PRINTFORML  ({CORRECTNESS/100}.%TOSTR(CORRECTNESS%100,"00")%\%)
ELSE
	PRINTL
ENDIF
NEXT
PRINTL
PRINTBUTTON "[취소]", "⊸"
PRINTBUTTON "[백스페이스]", "✅"
PRINTBUTTON @"[자동 해결 (%PARSE("Your",,,ARG)%) ", "🆘"
CALL PRINT_RANK(ABL:ARG:43,"MAX_6")
PRINTFORM  {ABL:ARG:43}
PRINTBUTTON ")]", "auto solve"
PRINTBUTTON "[힌트]", "❓"
PRINTL
SELECTCASE IS_WRONG
	CASE 1
		GOTO AFTER_SET_RED
	CASE -1
		GOTO AFTER_SET_GREEN
	CASEELSE
		SETFONT "VL Gothic"
		TONEINPUTS 0, "(",0
ENDSELECT
SETFONT
PLAYSOUND "se/キー音.m4a"
SELECTCASE RESULTS
	CASE "⊸"
		RETURN
	CASE "🆘"
	CASE "✅"
		CURRENT_STRING '= SUBSTRING(CURRENT_STRING,0,STRLENS(CURRENT_STRING)-1)
		GOTO GO_BACK
	CASE "❓"
		CALL PRINT_RAINBOWL("Hints")
		FOR LOCAL,0,STRCOUNT(ALL_TIPS,"/")
		CALL PRINT_RANK(RANK_TO_LEVEL(KNOW_START+LOCAL),"MAX_6")
		PRINTFORM  {RANK_TO_LEVEL(KNOW_START+LOCAL),2}: 
		IF LEVEL_TO_RANK(ABL:ARG:43) < KNOW_START+LOCAL && LOCAL
			SETCOLOR C_GRAY
			PRINTFORML 학습하지 않음
		ELSE
			PRINTFORML %SPLIT_SINGLE(ALL_TIPS,LOCAL,"/")%
		ENDIF
		RESETCOLOR
		NEXT
		WAIT
		GOTO GO_BACK
	CASEELSE
		$ADD_ELSE
		IS_WRONG = 0
		CURRENT_STRING += @"%TOLOWER(RESULTS)%/"
		IF STRCOUNT(CURRENT_STRING,"/") == STRCOUNT(THE_WORD,"/")
			IF THE_WORD == CURRENT_STRING
				STOPSOUND
				PLAYSOUND "se/正解.wav"
				IS_WRONG = -1
				GOTO GO_BACK
				$AFTER_SET_GREEN
				TWAIT 1000, 0
				RETURN 1
			ELSE
				STOPSOUND
				PLAYSOUND "se/間違い.wav"
				IS_WRONG = 1
				GOTO GO_BACK
				$AFTER_SET_RED
				TWAIT 1000, 0
				ARRAYSHIFT LAST_STRINGS, 1, CURRENT_STRING
				CURRENT_STRING =
				IS_WRONG = 0
			ENDIF
		ENDIF
		GOTO GO_BACK
ENDSELECT

@YoujutsuLearningProgress(ARG,YOUJUTSU,LEARNING_ADD,ADD_TYPE="add",LEARNING_TYPE="self")
#DIM YOUJUTSU
#DIM LEARNING_ADD
#DIMS ADD_TYPE
#DIMS LEARNING_TYPE
#DIM LAST_LEARN
#DIM LEARNING_PROGRESS
#DIM BAR_COLOR
SELECTCASE LEARNING_TYPE
	CASE "self"
		LAST_LEARN = YoujutsuBookProgress:ARG:YOUJUTSU
		BAR_COLOR = 0x6DE1FF
	CASE "teacher"
		LAST_LEARN = YoujutsuTeacherProgress:ARG:YOUJUTSU
		BAR_COLOR = 0x7bb35d
ENDSELECT
LEARNING_PROGRESS = LAST_LEARN
SELECTCASE ADD_TYPE
	CASE "add"
		LEARNING_PROGRESS = LIMIT(LEARNING_PROGRESS+LEARNING_ADD,0,10000)
	CASE "set"
		LEARNING_PROGRESS = LIMIT(LEARNING_ADD,0,10000)
	CASEELSE
		PRINTFORMW @유주술학습진행도는 알 수 없는 ADD_TYPE을 가지고 있다.
		RETURN
ENDSELECT
TRYCALLFORMF NAS_ESP_{YOUJUTSU}
PRINTFORM %NAS_ESP_NAME% 유술 %CAPITALIZE(LEARNING_TYPE)% 학습 {LEARNING_PROGRESS/100}.%TOSTR(LEARNING_PROGRESS%100,"00")%\%
SIF ARG != MASTER
	PRINTFORM  (%CALLNAME:ARG%)
IF LEARNING_PROGRESS != LAST_LEARN
	PRINTFORM  (
	IF LEARNING_PROGRESS != LAST_LEARN
		SETCOLOR C_GREEN
		PRINTFORM +{LEARNING_ADD/100}.%TOSTR(LEARNING_ADD%100,"00")%\%
	ELSE
		SETCOLOR C_RED
		PRINTFORM -{LEARNING_ADD/100}.%TOSTR(LEARNING_ADD%100,"00")%\%
	ENDIF
	RESETCOLOR
	PRINTFORML )
ELSE
	PRINTL
ENDIF
CALL hex_to_rgb(BAR_COLOR)
CALL COLOR_BAR(LEARNING_PROGRESS,10000,40,RESULT:0,RESULT:1,RESULT:2,-160,10,18,6,2,UNICODE(0x25AE),UNICODE(0x25AE))
SELECTCASE LEARNING_TYPE
	CASE "self"
		YoujutsuBookProgress:ARG:YOUJUTSU = LEARNING_PROGRESS
	CASE "teacher"
		YoujutsuTeacherProgress:ARG:YOUJUTSU = LEARNING_PROGRESS
ENDSELECT
IF YoujutsuBookProgress:ARG:YOUJUTSU >= 10000 && YoujutsuLearnType:ARG:YOUJUTSU != "self"
	CALL Get_Learn_Youjutsu(ARG,YOUJUTSU,"self")
ELSEIF YoujutsuTeacherProgress:ARG:YOUJUTSU >= 10000 && YoujutsuLearnType:ARG:YOUJUTSU == ""
	CALL Get_Learn_Youjutsu(ARG,YOUJUTSU,"teacher")
ENDIF

