@EsperMenuPage_10(ARG)
CALL EsperMenuPage_Universal(ARG, 10)

@YoujutsuSelfStudyPuzzle_10(ARG)
CALL YoujutsuSelfStudyPuzzle_LetterQuests(ARG,10,"brokentelevision")

@YoujutsuSelfStudyPuzzle_Quest_10(ARG,nSearchMode = "GET")
#DIMS nSearchMode
#DIM DYNAMIC nHasDidIt
nHasDidIt = 0
SELECTCASE YoujutsuQuestProgress:ARG:10
	CASE 10000 TO 19999
		SELECTCASE nSearchMode
			CASE "SET"
				RETURN 1
			CASE "GET"
				CALL PRINT_LETTER(@"천둥 번개 치는 폭풍우 속에서 전투 훈련을 한다.",,40)
			CASE "CHECK"
				SIF GET_WEATHER_THUNDERSTORM() && SELECTCOM == 411
					nHasDidIt = 1
				RETURN nHasDidIt
		ENDSELECT
	CASE 20000 TO 29999
		SELECTCASE nSearchMode
			CASE "SET"
				RETURN 1
			CASE "GET"
				CALL PRINT_LETTER(@"전기 자극으로 인한 오르가즘//이것은 동의를 얻고 주도권을 그들에게 넘기는 다른 동횡(Touhou)을 필요로 할 수 있다.",,40)
			CASE "CHECK"
				SIF TCVAR:ARG:2 == 23 && (NOWEX:ARG:0 || NOWEX:ARG:1 || NOWEX:ARG:2 || NOWEX:ARG:3 || NOWEX:ARG:4 || NOWEX:ARG:5 || NOWEX:ARG:11)
					nHasDidIt = 1
				RETURN nHasDidIt
		ENDSELECT
	CASE 30000 TO 39999
		SELECTCASE nSearchMode
			CASE "SET"
				RETURN 1
			CASE "GET"
				CALL PRINT_LETTER(@"전투 중인 엘드리치 존재를 물리친다.",,40)
			CASE "CHECK"
				SIF CFLAG:(151):弾幕勝負勝利
					nHasDidIt = 1
				RETURN nHasDidIt
		ENDSELECT
	CASEELSE
		RETURN 999
ENDSELECT
RETURN 0

