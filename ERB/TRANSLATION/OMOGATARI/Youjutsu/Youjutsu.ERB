;I'd say all non-humans should be immune or at least resistant to asphyxiation damage
;Is there a "holy"/"magic" element? Youkai should be weak to that
;Fairies should all be weak to Decay since they're embodiments of nature/life
@CALC_DAMAGE_RESIST(ARG)
#DIMS STR_LIST, 10
#DIM DYNAMIC DR_CALC, VARSiZE("DamageResist")
VARSET STR_LIST



SELECTCASE TALENT:ARG:190
CASE 1
	; Human:
	; Gun - Normal
	; Cut - Normal
	; Burn - Weak
	; Acid - Weak
	; Crush - Normal
	; Electric - Weak
	; Decay - Normal
	; Rad: Normal
	; Tox: Normal
	; Asphy: Normal
	; Ice: Normal
	; Psi: Normal
	; Holy: EX Resist
	DR_CALC:3 -= 1
	DR_CALC:4 -= 1
	DR_CALC:7 -= 1
	DR_CALC:37 += 4
CASE 4
	;Moonies should all be Frail against Decay since it's the most impure element
	;unless you're adding piss and shit damage types
	DR_CALC:8 -= 3
	DR_CALC:9 -= 2
	DR_CALC:27 -= 2
CASE 5
	;Makais are immune or have extreme resistancec to toxic elements due their environment and conditions in their land.
	DR_CALC:8 += 3
	DR_CALC:9 += 3
	DR_CALC:27 += 5
	DR_CALC:36 += 5
ENDSELECT

SELECTCASE TALENT:ARG:191
CASE 1
	;Youkai are weak to mental, strong against physical
	DR_CALC:1 += 1
	DR_CALC:2 += 1
	DR_CALC:6 += 1
CASE 2
	;Oni should be weak against fire (it ignites all the alcohol in their systems)
	;Resistant to physical as well
	DR_CALC:1 += 2
	DR_CALC:2 += 2
	DR_CALC:3 -= 1
	DR_CALC:6 += 2
	DR_CALC:37 -= 1
CASE 5
	;Tengu
	LOCALS '= nameArray:ARG:na_Title
	IF STRFIND(nameArray:ARG:na_Title, "●") > -1
		SPLIT LOCALS, "●", STR_LIST
		K = RESULT
		FOR LOCAL, 0, K
			IF STRFIND(STR_LIST:LOCAL, "Race:") > -1
				LOCALS:1 = %REPLACE(STR_LIST:LOCAL, "Race:", "")%
				LOCALS:1 = %REPLACE(LOCALS:1, "　", "")%
				;SIF STRFIND(種族テキスト, LOCALS:1) < 0
				BREAK
			ENDIF
		NEXT

		;PRINTFORML %LOCALS:1%
		IF LOCALS:1 == "Crow Tengu"
			; As per Megaten tradition, Crow Tengu should be weak against guns because they're birds
			DR_CALC:1 -= 1
			DR_CALC:6 -= 2
		ELSE
		ENDIF
	ENDIF
CASE 7
		DR_CALC:1 -= 1
		DR_CALC:6 -= 2
CASE IS > 0
ENDSELECT
SIF TALENT:ARG:191
	DR_CALC:37 -= 2

IF TALENT:ARG:192
;Fairies should all be weak to Decay since they're embodiments of nature/life
	DR_CALC:8 -= 1
ENDIF

; Gods should be immune to holy (obviously) but maybe Frail against Radiation because it represents science
; (which pushed them and other supernatural entities in Gensokyo in the first place)
SELECTCASE TALENT:ARG:193
CASE IS > 0
	;Youkai are weak to mental, strong against physical
	DR_CALC:1 += 1
	DR_CALC:2 += 1
	DR_CALC:6 += 1
	DR_CALC:9 -= 3
	DR_CALC:34 += 5
	DR_CALC:37 += 6
ENDSELECT

IF TALENT:ARG:194
; Anyway... undead should be resistant/immune to gun/cut/decay/acid/rad/tox damage
; but weak to holy/crush/fire/ice
	DR_CALC:1 += 5
	DR_CALC:2 += 5
	DR_CALC:3 -= 2
	DR_CALC:4 += 4
	DR_CALC:6 -= 2
	DR_CALC:8 += 5
	DR_CALC:24 += 5
	DR_CALC:27 += 5
	DR_CALC:34 += 5
	DR_CALC:37 -= 2
ENDIF

SELECTCASE TALENT:ARG:197
CASE 2
;Magicians should probably be weak against them though, since they're usually in poor health from working with mercury and the like
	DR_CALC:8 -= 1
	DR_CALC:9 -= 1
	DR_CALC:27 -= 1
	DR_CALC:34 += 5
	DR_CALC:36 -= 1
ENDSELECT


FOR LOCAL,0,VARSIZE("DamageResist")
	DamageResist:ARG:LOCAL:0 = LIMIT(DamageResist:ARG:LOCAL:0+DR_CALC:LOCAL,-3,7)
NEXT

