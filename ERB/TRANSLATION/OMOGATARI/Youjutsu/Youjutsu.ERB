@CombatMagicChangeMenu(ARG, Cheat = 0)
#DIM CCM_LINECOUNT
#DIM CCM_LIST
#DIM DYNAMIC Cheat
CCM_LINECOUNT = LINECOUNT
DO
	VARSET NAS_ESP_SelectType
	PRINTFORML Changing %CALLNAME:ARG%'s combat spells:
	PRINTL
	CALL CombatMagicDisplay(ARG,1)
	PRINTFORML [-990] - Add Spell
	PRINTFORML [-995] - Auto Fill
	PRINTFORML [-998] - Clear All
	PRINTFORML [-999] - Return
	INPUT
	SELECTCASE RESULT
	CASE 0, IS >= 6000000000
		CALL YoujutsuMenuAll(ARG, 1, RESULT, Cheat)
	CASE -990
		IF DT_SELECT("combatMagic", @"chara = {ARG}",,tempHediffList)  > 4+(EsperRank(ARG))
			PRINTFORMW Maximum amount of spells set. Please remove a spell before adding another.
			CONTINUE
		ENDIF
		CALL YoujutsuMenuAll(ARG, 1, 0, Cheat)
	CASE -995
		CALLF ClearAllYoujutsuCombatMag(ARG)
		CALL AutoYoujutsuSet(ARG)
		CALL ResetYoujutsuResist(ARG)
	CASE -998
		CALLF ClearAllYoujutsuCombatMag(ARG)
		CALL ResetYoujutsuResist(ARG)
	CASE -999
		RETURN
	ENDSELECT
LOOP 1

@CombatMagicDisplay(ARG,ARG:1)
#DIM CCM_LIST
VARSET tempHediffList
DT_SELECT "combatMagic", @"chara = {ARG}",,tempHediffList
FOR LOCAL,0,4+(EsperRank(ARG))
	CCM_LIST = tempHediffList:LOCAL
	LOCALS:1 =
	IF CCM_LIST
		VARSET NAS_ESP_NAME
		VARSET NAS_ESP_COLOR
		TRYCALLFORM NAS_ESP_{DT_CELL_GET("combatMagic", CCM_LIST, "spellPage",1)}_{DT_CELL_GET("combatMagic", CCM_LIST, "spell",1)}
		LOCALS:1 '= NAS_ESP_NAME
		SIF !STRLENS(NAS_ESP_NAME)
			LOCALS:1 '= @"Spell not found: Class {DT_CELL_GET("combatMagic", CCM_LIST, "spellPage",1)}, Spell {DT_CELL_GET("combatMagic", CCM_LIST, "spell",1)}"
	ELSEIF ARG:1 != 2
		PRINTBUTTON @"[{LOCAL,2}] ----", CCM_LIST
		PRINTL
	ENDIF
	SIF !STRLENS(LOCALS:1)
		CONTINUE
	SIF ARG:1 != 2
		PRINTBUTTON @"[{LOCAL,2}] ", CCM_LIST
	TRYCALLFORMF NAS_ESP_{DT_CELL_GET("combatMagic", CCM_LIST, "spellPage",1)}
	SIF NAS_ESP_COLOR
	SETCOLOR NAS_ESP_COLOR
	IF ARG:1 != 2
	PRINTBUTTON @"[%NAS_ESP_NAME_VSHORT,5%] ", CCM_LIST
	ELSE
	PRINTFORMS @"[%NAS_ESP_NAME_VSHORT,5%] "
	ENDIF
	RESETCOLOR
	IF ARG:1 != 2
	PRINTBUTTON @"%LOCALS:1,35,LEFT% ", CCM_LIST
	ELSE
	PRINTFORMS @"%LOCALS:1,35,LEFT% "
	ENDIF
	CALL PRINT_RANK(NAS_ESP_LevelNeed, "MAX_6")
	PRINTFORM  {NAS_ESP_LevelNeed, 2} 
	IF STRFIND(NAS_ESP_Type,"Passive/") > -1
		PRINTFORM  Passive
	ELSE
	CALL PRINT_COLORBAR(NAS_ESP_COST, 4000, 30, UNICODE(0x2585), UNICODE(0x2585), BASE_BCS(NAS_ESP_BASE), RESULT:1)
	PRINTFORM  {NAS_ESP_COST,5} %BASE_TR(BASENAME:NAS_ESP_BASE)%/use 
	ENDIF
	PRINTL
NEXT
PRINTL

@YoujutsuMenuAll(ARG, SelectionType=0, Slot=0, YMDebug=0)
#DIM DYNAMIC Slot
#DIM     PAGE       ;表示中のページ
#DIM CREDRAW
#DIM FIRST_LINE
#DIM HasMenu
#DIM YMInput
#DIM DYNAMIC SelectionType
#DIM DYNAMIC YMDebug
#DIM DYNAMIC YM_SPELLSHOW
#DIM DYNAMIC YMTarget
[IF_DEBUG]
YMDebug = 1
[ENDIF]
NAS_ESP_SelectType = SelectionType
FIRST_LINE = LINECOUNT
HasMenu = 0
YMTarget = TARGET != MASTER ? TARGET # MASTER
$REPRINT
LOCAL:6 = 0
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
DRAWLINE
PRINTFORML Youjutsu: %EsperAbilitySTR(PAGE)%
CALL BASE_BAR(ARG, "法力", 28, "オレンジ") 
PRINTL
DRAWLINE
TRYCALLFORM EsperMenuPage_{PAGE}(ARG)
DRAWLINE
FOR LOCAL, 0, (YMDebug ? 65 # 64)
	VARSET YM_SPELLSHOW
	SIF LOCAL == 64
		GOTO AlwaysPass
	IF GETBIT(TALENT:ARG:ESP, LOCAL) && STRLENS(EsperAbilitySTR(LOCAL))
		SELECTCASE LOCAL
        CASE 18
            SIF !GETBIT(nPee,1) && !GETBIT(nScat,2)
                CONTINUE
		CASE 19
			SIF !nHypno
				CONTINUE
		CASEELSE
			SIF !EXISTFUNCTION(@"%TOUPPER("EsperMenuPage_")%{LOCAL}")
				CONTINUE
		ENDSELECT
		FOR LOCAL:1,0,100
			VARSET NAS_ESP_NAME
			VARSET NAS_ESP_LevelNeed
			VARSET NAS_ESP_Type
			TRYCALLFORM NAS_ESP_{LOCAL}_{LOCAL:1}
			SIF YJCurrentLevel(ARG,LOCAL) < NAS_ESP_LevelNeed
				CONTINUE
			SELECTCASE SelectionType
			CASE 0
				SIF STRFIND(NAS_ESP_Type,"Daily/") == -1 && NAS_ESP_Type != "Daily"
					CONTINUE
				YM_SPELLSHOW = 1
			CASE 1
				SIF STRFIND(NAS_ESP_Type,"Combat/") == -1 && NAS_ESP_Type != "Combat"
					CONTINUE
				YM_SPELLSHOW = 1
			ENDSELECT
		NEXT
		SIF !YM_SPELLSHOW
			CONTINUE
		$AlwaysPass
		; IF !PAGE
		; 	;if page = 0
		; 	PAGE = LOCAL
        ;     HasMenu = 1
		; 	GOTO REPRINT
		; ENDIF

		    HasMenu = 1
		SIF PAGE == LOCAL
			SETCOLOR 0x00FFFF
		;exception for player character
		PRINTBUTTON EsperAbilitySTR(LOCAL), LOCAL + 8000
		RESETCOLOR
		PRINTFORM 　　
	ENDIF
NEXT
IF !HasMenu
    PRINTFORMW %PARSE("You do",,,ARG)% not have any Youjutsu spells that can be accessed.
    RETURN 9999
ENDIF

PRINTFORML
PRINTBUTTON "[9999] Return", 9999
IF !SelectionType
PRINTFORM   
PRINTBUTTON "[9900] Change Combat Spells ", 9900
IF YMTarget != MASTER && HasFallState(YMTarget)
	PRINTFORM   
	PRINTBUTTON @"[9901] Change %CALLNAME:YMTarget%'s Spells ", 9901
ENDIF
ENDIF
PRINTBUTTON @"[9902] Change Spell Target (Current: %CALLNAME:YMTarget%)", 9902
PRINTL
DO
	INPUT
	YMInput = RESULT
	SELECTCASE YMInput 
		CASE 8000 TO 8064
			IF YMInput-8000 == 64
				PAGE = RESULT-8000
			ELSE
			SIF GETBIT(TALENT:ARG:ESP, YMInput-8000)
				PAGE = RESULT-8000
			ENDIF
		CASE 9999 ;custom code
			RETURN 9999
		CASE 9900
			CALL CombatMagicChangeMenu(MASTER)
		CASE 9901
			CALL CombatMagicChangeMenu(YMTarget)
		CASE 9902
			TFLAG:104 = YMTarget
			CALL TARGET_CHANGE(1)
			YMTarget = TFLAG:104
		CASEELSE
		SELECTCASE SelectionType
		CASE 0
			CALL PROCESS_YOUJUTSU_COMMAND(ARG,YMTarget,PAGE,YMInput)
			SIF RESULT == -9530
				GOTO REPRINT
			SIF STRFIND(NAS_ESP_Type,"Close Page/") > -1
				RETURN
		CASE 1
			IF Slot
				DT_CELL_SET "combatMagic", Slot, "spellPage", PAGE, 1
				DT_CELL_SET "combatMagic", Slot, "spell", YMInput, 1
			ELSE
				{
				DT_ROW_ADD "combatMagic",
				"chara", ARG,
				"spellPage", PAGE,
				"spell", RESULT
				} 
			ENDIF
			RETURN
		ENDSELECT
	ENDSELECT
	BREAK
LOOP 1
GOTO REPRINT


@YoujutsuMaxSpells(ARG)
#FUNCTION
RETURNF 4+(EsperRank(ARG))


@ClearAllYoujutsuCombatMag(ARG)
#FUNCTION
tempHediffCount = DT_SELECT(@"combatMagic", @"chara = {ARG}", , tempHediffList)
FOR LOCAL, 0, tempHediffCount
    DT_ROW_REMOVE @"combatMagic", tempHediffList:LOCAL
NEXT


;////////////////////////////////
;AutoYoujutsuSet
;================================
;- Picks up to two skills per skillset
;- Highest skillests prioritized
;- Highest level, multi target skills prioritied
	;Multi Target priority rules
	;- If they can hit a weakness without their spell getting drained/nullified/reflected
	;- Only one tier lower than the higher power spell
	;Else picks the single target spell
;- One healing skill and buff will always be picked.
;////////////////////////////////
@AutoYoujutsuSet(ARG)
#DIM AYS
#DIM DYNAMIC AYS_COUNT
#DIM DYNAMIC AYS_SET
#DIM DYNAMIC SUBJECT_WEIGHTS, 65
#DIM DYNAMIC AYS_LIST, 100
#DIM DYNAMIC AYS_PRIORITY, 100
#DIM DYNAMIC AYS_COMPARE, 2
#DIM DYNAMIC AYS_TOTAL
AYS_COUNT = DT_SELECT("combatMagic", @"chara = {ARG}")

;manual loadout exists
IF EXISTFUNCTION(@"YoujutsuSet_{ARG}")
ENDIF

;Danmaku skills
FOR AYS, 0, 10
	SIF AYS_COUNT >= YoujutsuMaxSpells(ARG)
		RETURN
	SIF !GETBIT(CFLAG:ARG:弾幕特能,AYS)
		CONTINUE
	VARSET NAS_ESP_Type
	TRYCALLFORM NAS_ESP_0_{AYS}
	SIF !STRLENS(NAS_ESP_Type)
		CONTINUE
	DT_ROW_ADD "combatMagic", "chara", ARG, "spellPage", 0, "spell", AYS
	AYS_COUNT = DT_SELECT("combatMagic", @"chara = {ARG}")
NEXT


;remove inaccessible sets from the list
; FOR LOCAL, 0, 64
;     SUBJECT_WEIGHTS:LOCAL = 1
;     IF !YoujutsuPossible(ARG,LOCAL)
;         ;not possible
;         SUBJECT_WEIGHTS:LOCAL = 0
;         CONTINUE
;     ENDIF
;     $START
; 	SUBJECT_WEIGHTS:LOCAL += YJCurrentLevel(ARG,LOCAL)
; 	SELECTCASE LOCAL
; 	CASE 7
; 	SUBJECT_WEIGHTS:LOCAL += 50
; 	ENDSELECT
; NEXT


FOR AYS,0,64
	SIF AYS_COUNT >= YoujutsuMaxSpells(ARG)
		RETURN

	;ESP type doesn't fucking exist
	SIF !EXISTFUNCTION(@"NAS_ESP_{AYS}")
		CONTINUE
	;can't do it
    IF !YoujutsuPossible(ARG,AYS)
        ;not possible
        CONTINUE
    ENDIF
	AYS_SET = AYS

	; AYS_SET = ARRAY_HIT(SUBJECT_WEIGHTS, 64)
	; SIF AYS_SET < 0
	; 	RETURN
	; SUBJECT_WEIGHTS:AYS_SET = 0
	SELECTCASE AYS_SET
	CASE 7
		;healing

		;mediarahan
		CALL YoujutsuMagicCanDo(ARG,AYS_SET,5)
		IF RESULT
		DT_ROW_ADD "combatMagic", "chara", ARG, "spellPage", AYS_SET, "spell", 5
		GOTO ResSpells
		ENDIF
		;dia
		CALL YoujutsuMagicCanDo(ARG,AYS_SET,0)
		IF RESULT
		DT_ROW_ADD "combatMagic", "chara", ARG, "spellPage", AYS_SET, "spell", 0
		GOTO ResSpells
		ENDIF

		$ResSpells
	CASE 14
		;buff spells
		;tetrakarm
		CALL YoujutsuMagicCanDo(ARG,AYS_SET,18)
		IF RESULT
		DT_ROW_ADD "combatMagic", "chara", ARG, "spellPage", AYS_SET, "spell", 18
		ENDIF
		;Dekaja
		CALL YoujutsuMagicCanDo(ARG,AYS_SET,16)
		IF RESULT
		DT_ROW_ADD "combatMagic", "chara", ARG, "spellPage", AYS_SET, "spell", 16
		ENDIF

		;perfect drug
		CALL YoujutsuMagicCanDo(ARG,AYS_SET,20)
		IF RESULT
		DT_ROW_ADD "combatMagic", "chara", ARG, "spellPage", AYS_SET, "spell", 20
		GOTO CALC_NEW
		ENDIF

		;luster candy
		CALL YoujutsuMagicCanDo(ARG,AYS_SET,12)
		IF RESULT
		DT_ROW_ADD "combatMagic", "chara", ARG, "spellPage", AYS_SET, "spell", 12
		GOTO CALC_NEW
		ENDIF

		;Generate
		GOTO SpellGen
	CASE 20
		;Debilitate
		CALL YoujutsuMagicCanDo(ARG,AYS_SET,12)
		IF RESULT
		DT_ROW_ADD "combatMagic", "chara", ARG, "spellPage", AYS_SET, "spell", 10
		GOTO CALC_NEW
		ENDIF

		;Fog Breath
		CALL YoujutsuMagicCanDo(ARG,AYS_SET,11)
		IF RESULT
		DT_ROW_ADD "combatMagic", "chara", ARG, "spellPage", AYS_SET, "spell", 11
		GOTO CALC_NEW
		ENDIF

		GOTO SpellGen
	CASE 63
	CASEELSE
		$SpellGen
		;ソート実処理
		LOCAL:0 = 1
		VARSET AYS_TOTAL
		VARSET AYS_LIST
		FOR LOCAL,0,NAS_ESP_SPELL_MAX
			IF EXISTFUNCTION(@"NAS_ESP_{AYS_SET}_{LOCAL}")
				VARSET NAS_ESP_LevelNeed
				VARSET NAS_ESP_Type
				TRYCALLFORM NAS_ESP_{AYS_SET}_{LOCAL}
				CALL YoujutsuMagicCanDo(ARG,AYS_SET,LOCAL)
				SIF !RESULT
					CONTINUE
				SIF STRFIND(NAS_ESP_Type,"Combat/") == -1 && NAS_ESP_Type != "Combat"
					CONTINUE
				SIF STRFIND(NAS_ESP_Type,"Passive/") > -1
					CONTINUE
				SIF DT_SELECT("combatMagic", @"chara = {ARG} and spellPage = {AYS_SET} and spell = {LOCAL}")
					CONTINUE
				AYS_LIST:AYS_TOTAL = LOCAL
				;priority
				AYS_PRIORITY = NAS_ESP_LevelNeed
				SIF NAS_ESP_CharacterUnique == NO:ARG ;prioritize character unique skills.
					AYS_COMPARE:0 += 300
				AYS_TOTAL++
			ENDIF
		NEXT
		;no list
		SIF !AYS_TOTAL
			CONTINUE
		WHILE LOCAL:0 < AYS_TOTAL
			SIF !(LOCAL:0)
				LOCAL:0 ++
			;PRINTW Okay, wait, so, what?
			AYS_COMPARE:0 = AYS_PRIORITY:(LOCAL:0 - 1)
			AYS_COMPARE:1 = AYS_PRIORITY:LOCAL

			IF AYS_COMPARE:0 <= AYS_COMPARE:1
				LOCAL:0 ++
			ELSE
				SWAP AYS_LIST:(LOCAL:0 - 1), AYS_LIST:(LOCAL:0)
				SWAP AYS_PRIORITY:(LOCAL:0 - 1), AYS_PRIORITY:(LOCAL:0)
				LOCAL:0 --
			ENDIF
		WEND
		[IF_DEBUG]
		; FOR LOCAL,0,AYS_TOTAL
		; 	TRYCALLFORM NAS_ESP_{AYS_SET}_{AYS_LIST:(LOCAL:0)}
		; 	PRINTFORML #{LOCAL}: %NAS_ESP_NAME%
		; NEXT
		[ENDIF]
		DT_ROW_ADD "combatMagic", "chara", ARG, "spellPage", AYS_SET, "spell", AYS_LIST:(AYS_TOTAL-1)
	ENDSELECT
	$CALC_NEW
	AYS_COUNT = DT_SELECT("combatMagic", @"chara = {ARG}")
NEXT

