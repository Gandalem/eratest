@YJCurrentLevel(ARG,ARG:1)
#FUNCTION
SELECTCASE ARG:1
CASE 0
RETURNF ABL:ARG:42
CASE IS > 63
[IF_DEBUG]
RETURNF MaxNonHLevel
[ELSE]
RETURNF 0
[ENDIF]
CASEELSE
RETURNF YoujutsuLevel:ARG:(ARG:1)
ENDSELECT

@YJResistance(ARG,ARG:1)
#DIM DYNAMIC Current
#DIM DYNAMIC YJR_Count
#DIM DYNAMIC YJR_Affect
#DIM DYNAMIC YJR_Spell
Current = DamageResist:ARG:(ARG:1):0
YJR_Affect = Current
YJR_Count = DT_SELECT("combatMagic", @"chara = {ARG}")

FOR YJR_Spell,1,YJR_Count+1
	VARSET NAS_ESP_DAMAGE_AFFECT
	VARSET NAS_ESP_MainDMGType
	TRYCALLFORM NAS_ESP_{DT_CELL_GET("combatMagic", RESULT:YJR_Spell, "spellPage", 1)}_{DT_CELL_GET("combatMagic", RESULT:YJR_Spell, "spell", 1)}
	SELECTCASE NAS_ESP_DAMAGE_AFFECT:(ARG:1)
	CASE IS >= 5
		YJR_Affect = MAX(Current,NAS_ESP_DAMAGE_AFFECT:(ARG:1))
	CASE 1 TO 4
		YJR_Affect = Current >= 5 ? Current # LIMIT(Current+1,1,4)
	ENDSELECT
NEXT

RETURN YJR_Affect

