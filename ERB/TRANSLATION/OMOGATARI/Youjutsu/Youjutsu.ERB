@YoujutsuMagicCanDo(ARG,ARG:1,ARG:2)
SIF !GETBIT(TALENT:ARG:ESP,ARG:1)
    RETURN 0
;check
VARSET NAS_ESP_HasEffect
VARSET NAS_ESP_LevelNeed
VARSET NAS_ESP_HIDDEN
NAS_ESP_CharacterUnique = -1
TRYCALLFORM NAS_ESP_{ARG:1}_{ARG:2}
SIF NAS_ESP_HIDDEN
	RETURN 0
;SIF NAS_ESP_HasEffect
;    RETURN 0
;unique character
IF NAS_ESP_CharacterUnique > -1
	;doesn't exist
	SIF CHARANUM < NAS_ESP_CharacterUnique
		RETURN 0
	;always pass if holder.
	SIF NO:ARG == NAS_ESP_CharacterUnique
		RETURN 1
	;NPC
	SIF NO:ARG != NAS_ESP_CharacterUnique && ARG != MASTER
		RETURN
	;intimacy 5
	SIF ABL:NAS_ESP_CharacterUnique:9 < 5 && !HasFallState(ARG)
		RETURN 0
ENDIF 
