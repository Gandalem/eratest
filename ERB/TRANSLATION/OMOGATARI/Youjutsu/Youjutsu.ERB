@PROCESS_YOUJUTSU_COMMAND(PYC_CASTER,PYC_TARGET,PYC_PAGE,PYC_SPELL,NO_DISPLAY = 0,FREE_SPELL=0,CAST_REASON="")
#DIM PYC_CASTER
#DIM PYC_TARGET
#DIM PYC_PAGE
#DIM PYC_SPELL
#DIM NO_DISPLAY
#DIM FREE_SPELL
#DIMS CAST_REASON
VARSET NAS_ESP_Weapon

CALL ResetYoujutsuResist(PYC_CASTER)
SIF INRANGE(PYC_TARGET,0,CHARANUM-1)
CALL ResetYoujutsuResist(PYC_TARGET)

VARSET NAS_ESP_Weapon

TRYCALLFORM NAS_ESP_{PYC_PAGE}_{PYC_SPELL}
LOCALS:9 '= NAS_ESP_NAME

IF STRFIND(NAS_ESP_TYPE, "Passive/") > -1
	IF PYC_CASTER != MASTER
		SETCOLOR C_ORANGE
		PRINTL
		PRINTFORML %"-"*89%
		PRINTFORML {PYC_CASTER} %NAME:PYC_CASTER% attempted to cast %NAS_ESP_NAME%, which is a passive spell.
		PRINTFORML Class: {PYC_PAGE}, ID: {PYC_SPELL}
		PRINTFORML !REPORT THIS!
		PRINTFORML %"-"*89%
		RESETCOLOR 
	ENDIF
    PRINTFORMW Passive spells cannot be be actively casted.
    RETURN -9530
ENDIF

IF GetCombatant(PYC_CASTER) && !lcIsLethal && NAS_ESP_Weapon
	PRINTFORMW Damaging spells cannot be casted in Danmaku battles
	RETURN -9530
ENDIF

IF GetCombatant(PYC_CASTER) && LoG_InBossBattle && NAS_ESP_InstantKill
	PRINTFORML Instant-kill spells cannot be casted in Boss battles
	PRINTFORMW Let's try playing fair, okay.
	RETURN -9530
ENDIF

IF YOUJUTSU_PACIFIED(PYC_CASTER)
	PRINTFORMW %PARSE("You are",,,PYC_CASTER)% pacified and cannot cast spells.
	RETURN -9530
ENDIF

IF INRANGE(PYC_TARGET,0,CHARANUM-1)
	IF STRFIND(NAS_ESP_TYPE, "Revive/") > -1
		IF !IsDead:PYC_TARGET:0
			PRINTFORMW %CALLNAME:PYC_TARGET% is not dead.
			RETURN -9530
		ENDIF
	ELSEIF IsDead:PYC_TARGET:0 && STRFIND(NAS_ESP_TYPE, "CanCorpse/") == -1 && STRFIND(NAS_ESP_TYPE, "Revive/") == -1
		PRINTFORMW %NAS_ESP_NAME% cannot be be casted on a corpse.
		RETURN -9530
	ENDIF
ENDIF

IF BASE:PYC_CASTER:NAS_ESP_BASE < NAS_ESP_COST && !GROUPMATCH(NAS_ESP_BASE,4,17) && !FREE_SPELL
	$NotEnoughMP
	PRINTFORMW Not enough %BASE_TR(BASENAME:NAS_ESP_BASE)% for %NAS_ESP_NAME% ({BASE:PYC_CASTER:NAS_ESP_BASE}/{NAS_ESP_COST})
    RETURN -9530
ELSEIF !FREE_SPELL
    CALL CANNOT_YOUJUTSU(PYC_CASTER,PYC_PAGE,PYC_SPELL)
    IF RESULT
		SELECTCASE RESULT
		CASE 1
		    PRINTFORMW Invalid spell.
		CASE 2
		    PRINTFORMW Cannot cast %NAS_ESP_NAME% on the player.
		CASE 3
		    PRINTFORMW Cannot cast %NAS_ESP_NAME% while time is stopped.
		CASE 4
		    GOTO NotEnoughMP
		CASE 888
			TRYCCALLFORM NAS_ESP_{PYC_PAGE}_{PYC_SPELL}_CantDo_Text(PYC_CASTER,PYC_TARGET)
			CATCH
				PRINTFORML Custom invalid condition tripped for %NAS_ESP_NAME% but there is no message for this. This may be a bug.
				PRINTFORML Class: {PYC_PAGE}, ID: {PYC_SPELL}
				WAIT
			ENDCATCH
		CASE -1
	    	PRINTFORML Invalid conditions to do %NAS_ESP_NAME%. This may be a bug.
			PRINTFORML Class: {PYC_PAGE}, ID: {PYC_SPELL}
			WAIT
		ENDSELECT
		RETURN -9530
    ENDIF
ENDIF

$ForceWin
SIF NO_DISPLAY
	SKIPDISP 1
IF DT_EXIST("TGC_Map")
CALL TGC_LogAdd(@"%PARSE("You cast",,,PYC_CASTER)% %NAS_ESP_NAME% at \@ INRANGE(PYC_TARGET,0,CHARANUM-1) ? %CALLNAME:PYC_TARGET% # the terrain\@.")

ELSE
	SELECTCASE CAST_REASON
	CASE "diaperSpell"
	PRINTFORML %PARSE("Your",,,PYC_CASTER)% %PeeProtectType(PYC_CASTER,2)% reacts to %PARSE("your",5,,PYC_CASTER)% accident and casts %LOCALS:9%.
	CASEELSE
	PRINTFORML %PARSE("You cast",,,PYC_CASTER)% %LOCALS:9%.
	;DIARAHAN!
	CALL PRINT_GPC("W", @"「\@ GROUPMATCH(NAS_ESP_RADIUS,4,5,6) ? %TOUPPER(NAS_ESP_NAME)%!!! # %NAS_ESP_NAME%!\@」", PYC_CASTER)
	ENDSELECT
ENDIF


;MP cost of weapon spells are handled by the weapon already
SIF !NAS_ESP_Weapon && !FREE_SPELL
CALL RECOVER(PYC_CASTER, -NAS_ESP_COST, BASENAME:NAS_ESP_BASE, NAS_ESP_NAME)
;NAS Exclusive
BASE:PYC_CASTER:4 = MIN(BASE:PYC_CASTER:4,GetMaxBladder(PYC_CASTER))
BASE:PYC_CASTER:17 = MIN(BASE:PYC_CASTER:17,GetMaxBowels(PYC_CASTER))

SIF PYC_PAGE < 64
CALLF ChangeMagicExp(PYC_CASTER,PYC_PAGE,MAX(1,LEVEL_TO_RANK(NAS_ESP_LevelNeed)))
SIF NO_DISPLAY == 2
	SKIPDISP 0
SIF !DT_EXIST("TGC_Map")
TRYCALLFORM EsperMenuResult_{PYC_PAGE}(PYC_CASTER,PYC_TARGET,PYC_SPELL)
SIF NO_DISPLAY
	SKIPDISP 0

@MULTI_YOUJUTSU_EFFECT(MYE_CASTER,MYE_PAGE,MYE_SPELL,MYE_SIDE)
#DIM MYE_CASTER
#DIM MYE_PAGE
#DIM MYE_SPELL
#DIM MYE_LIST,100
#DIM MYE_SIDE
#DIM MYE_COUNT


IF DT_EXIST("lcCombatants")
	VARSET MYE_LIST
	SELECTCASE MYE_SIDE
	CASE 0
	;Allies
	MYE_COUNT = DT_SELECT("lcCombatants", @"side = {DT_CELL_GET("lcCombatants", GetCombatant(MYE_CASTER), "side", 1)}",,MYE_LIST)
	CASE 1
	;Enemies
	MYE_COUNT = DT_SELECT("lcCombatants", @"side = {!DT_CELL_GET("lcCombatants", GetCombatant(MYE_CASTER), "side", 1)}",,MYE_LIST)
	CASE 2
	;Everyone
	MYE_COUNT = DT_SELECT("lcCombatants",,,MYE_LIST)
	ENDSELECT
	FOR LOCAL,0,MYE_COUNT
		TRYCALLFORM EsperMenuResult_{MYE_PAGE}(MYE_CASTER,DT_CELL_GET("lcCombatants", MYE_LIST:LOCAL, "chara", 1),MYE_SPELL)
	NEXT
ELSE
	;everyone on the same location
	FOR LOCAL,0,CHARANUM
		SIF CFLAG:LOCAL:300 != CFLAG:MYE_CASTER:300
			CONTINUE
		TRYCALLFORM EsperMenuResult_{MYE_PAGE}(MYE_CASTER,LOCAL,MYE_SPELL)
	NEXT
ENDIF


@CANNOT_YOUJUTSU(C_ID,ARG,ARG:1)
#DIM C_ID
TRYCCALLFORM NAS_ESP_{ARG}_{ARG:1}
	TRYCALLFORM NAS_ESP_{ARG}_{ARG:1}_CantDo
	IF RESULT
		RETURN 888
	ENDIF
	IF (TARGET == MASTER && !NAS_ESP_CAN_MASTER)
		RETURN 2
	ELSEIF (FLAG:70 && !NAS_ESP_TSP)
		RETURN 3
	ELSEIF BASE:C_ID:NAS_ESP_BASE < NAS_ESP_COST
		RETURN 4
	ELSEIF NAS_ESP_HasEffect
		RETURN -1
	ENDIF
CATCH
RETURN 1
ENDCATCH

@EsperMenuPage_Universal(C_ID,ARG)
#DIM CANNOT_SPELL
#DIM C_ID
FOR LOCAL, 0, 100
	TRYCCALLFORM NAS_ESP_{ARG}_{LOCAL}
		SIF ARG >= 64
			GOTO AlwaysPass

		VARSET NAS_ESP_CharacterUnique, -1
		CALL YoujutsuMagicCanDo(C_ID,ARG,LOCAL)
		SIF !RESULT
			CONTINUE
	
		$AlwaysPass
		SELECTCASE NAS_ESP_SelectType
		CASE 0
			SIF STRFIND(NAS_ESP_Type,"Daily/") == -1 && NAS_ESP_Type != "Daily"
				CONTINUE
		CASE 1
			SIF STRFIND(NAS_ESP_Type,"Combat/") == -1 && NAS_ESP_Type != "Combat"
				CONTINUE
		ENDSELECT
        CALL CANNOT_YOUJUTSU(C_ID,ARG,LOCAL)
        CANNOT_SPELL = RESULT
		SIF CANNOT_SPELL
		SETCOLOR C_L_GRAY

        LOCALS = [{LOCAL,2}] - %NAS_ESP_NAME, 45, LEFT% 
		PRINTFORM %LOCALS%
		PRINTFORM (
		IF STRFIND(NAS_ESP_Type,"Passive/") > -1
			PRINTFORM Passive
		ELSEIF NAS_ESP_COST
			PRINTFORM %BASE_TR(BASENAME:NAS_ESP_BASE)% 
			SELECTCASE NAS_ESP_BASE
			CASE 4, 17
				PRINTFORM {ABS(NAS_ESP_COST), 5, LEFT}
			CASEELSE
				PRINTFORM {NAS_ESP_COST, 5, LEFT}
			ENDSELECT
		ELSE
			PRINTFORM No Consumption
		ENDIF
		PRINTFORM %" - "%
        CALL PRINT_RANK(NAS_ESP_LevelNeed, "MAX_6")
        PRINTFORM  {NAS_ESP_LevelNeed, 2}
		PRINTFORM %" - "%
		SELECTCASE NAS_ESP_RADIUS
		CASE 0
			PRINTFORM Applied immediately
		CASE 1
			PRINTFORM Today only
		CASE 2
			PRINTFORM Reversible
		CASE 3
			PRINTFORM Permanent
		CASE 4
			PRINTFORM Wide area
		CASE 5
			PRINTFORM Map-wide
		CASE 6
			PRINTFORM Worldwide
		ENDSELECT
		PRINTFORM )
		RESETCOLOR
		PRINTL
		SETCOLOR C_GRAY
		LOCALS:3 =
		SIF NAS_ESP_CharacterUnique > -1
			LOCALS:3 '= @"%NAME:NAS_ESP_CharacterUnique%'s unique spell - "
		PRINTFORML %" "*6% %LOCALS:3%%NAS_ESP_DESC%
		RESETCOLOR
	CATCH
	ENDCATCH
NEXT

