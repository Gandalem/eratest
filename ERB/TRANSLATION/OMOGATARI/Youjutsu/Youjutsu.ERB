@EsperPoints(ARG)
#FUNCTION
#DIM DYNAMIC SCORE
#DIM EPAspect
#DIM EPMult

SIF !TALENT:ARG:ESP
	RETURNF 0

SCORE += (MAXBASE:ARG:7*2)

FOR LOCAL, 0, 64
	IF GETBIT(TALENT:ARG:ESP,LOCAL)
		SELECTCASE LOCAL
		CASE 0
		;danmaku
		;SCORE += 100
		CASE 1
		;flight
		EPAspect = 4000
		CASE 2
		;basic summon
		EPAspect = 2000
		CASE 3
		;normal summon
		EPAspect = 10000
		CASE 4
		;great summon
		EPAspect = 50000
		CASE 5
		;tentacle summon
		EPAspect = 1250
		CASE 6
		CASE 18
		;excretion
		EPAspect = 7000
		CASE 19
		;hypnosis
		EPAspect = 12000
		CASE 63
		;debug
		EPAspect = 100000
		CASEELSE
		EPAspect = 2000
		ENDSELECT

		SELECTCASE Level_To_Rank(YJCurrentLevel(ARG,LOCAL))
		CASE 0
			EPMult = 20
		CASE 1
			EPMult = 50
		CASE 2
			EPMult = 70
		CASE 3
			EPMult = 100
		CASE 4
			EPMult = 115
		CASE 5
			EPMult = 130
		CASE 6
			EPMult = 150
		CASE 7
			EPMult = 155
		CASE 8
			EPMult = 185
		CASE 9
			EPMult = 215
		CASE IS >= 10
			EPMult = 245
		ENDSELECT
		SCORE += (EPAspect*EPMult/100)
	ENDIF
NEXT

RETURNF SCORE

@EsperRank(ARG)
