;custom code for non-CSV exp
;Mr Pops Alot
@ShowYoujutsuChange(ARG,ARG:1)
#DIM DYNAMIC nVal, 2
#DIM DYNAMIC nPotential
#DIM DYNAMIC nPotentialLoss
#DIM DYNAMIC nShow
#DIM DYNAMIC DIFFERENCE

FOR LOCAL,0,64
	VARSET nVal
	VARSET DIFFERENCE
	; SIF !YoujutsuPossible(ARG,LOCAL:1)
	; 	CONTINUE

    nVal:0 = YoujutsuExp:ARG:LOCAL:0
    nVal:1 = YoujutsuExp:ARG:LOCAL:1
    LOCALS:1 = %EsperAbilitySTR(LOCAL)% Youjutsu Exp

	IF nVal != nVal:1
		;NAS Potential
		nPotential = EXPPotential:ARG:(LOCAL)
		SIF HasBionicPart(ARG,61)
			nPotential += 2
		IF (nPotential)
			CALL COLORMESSAGE(@"Potential: %EsperAbilitySTR(LOCAL)% Youjutsu +{(nPotential)} (%CALLNAME:ARG%)",C_AQUA,1,1)
			;add exp to the counter
			SIF EXPPotential:ARG:(LOCAL)
				YoujutsuPotentialCounter:ARG:(LOCAL) += nVal:0

			;if the 25*potential level multiplier is better than flat points
			IF (nVal:0*(100+(25*(nPotential)))/100) > nVal:0+(nPotential)
				;reset pre multiplied exp, then give the exp
				YoujutsuExp:ARG:(LOCAL):0 -= nVal:0
				YoujutsuExp:ARG:(LOCAL):0 += (nVal:0*(100+(25*(nPotential)))/100)
				nVal:0 = (nVal:0*(100+(25*(nPotential)))/100)
			ELSE
				YoujutsuExp:ARG:(LOCAL):0 += (nPotential)
				nVal:0 += (nPotential)
			ENDIF
		ENDIF

		DIFFERENCE = nVal - nVal:1
		nShow ++
		PRINTFORML %LOCALS:1% \@ DIFFERENCE >= 0 ? + # \@{DIFFERENCE}(%CALLNAME:ARG%)
		SIF ARG:1
			YoujutsuExp:ARG:(LOCAL):1 = YoujutsuExp:ARG:(LOCAL):0
	ENDIF

	;NAS Potential check
	IF YoujutsuPotentialCounter:ARG:(LOCAL) >= PotentialResetCounter
		;over 300 pre multiplier EXP gained. we decrease the potential counter
		nPotentialLoss = 0
		WHILE YoujutsuPotentialCounter:ARG:(LOCAL) >= PotentialResetCounter
			nPotentialLoss--
			YoujutsuPotentialCounter:ARG:(LOCAL) = MAX(0,YoujutsuPotentialCounter:ARG:(LOCAL)-PotentialResetCounter)
		WEND
		CALL YoujutsuPotentialChangeMsg(ARG,LOCAL,nPotentialLoss)
	ENDIF
NEXT
RETURN nShow

