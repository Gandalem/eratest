;You hit a wall! Try again.
;Good job!

@FlappyTengu(scoreToWin=0,quitAfterSuccess=0)
#DIM DYNAMIC score
; #DIM DYNAMIC hitwall
#DIM DYNAMIC playing
#DIM CONST clickPromptID = 30
#DIM DYNAMIC wallX, 5
#DIM DYNAMIC wallY, 5
#DIMS DYNAMIC textContent
#DIM titleSize,2
#DIM DYNAMIC textSize
#DIM DYNAMIC frameTime, 2
#DIM DYNAMIC msPerFrame
#DIM DYNAMIC posX
#DIM DYNAMIC posY
#DIM DYNAMIC velY
#DIM DYNAMIC gameFontColor
#DIMS DYNAMIC gameFont
#DIM DYNAMIC gameFrame, 2
#DIM DYNAMIC passedWall
#DIM DYNAMIC scoreToWin
#DIM DYNAMIC quitAfterSuccess
;game is software rendered on the main thread.
gameFont '= GETFONT()
gameFontColor = GETDEFCOLOR()
gameFrame:0 = CLIENTWIDTH()
gameFrame:1 = CLIENTHEIGHT()
passedWall = 0
GCREATEFROMFILE 33336666, @"OMOGATARI/flappy_wall.png"
SPRITECREATE @"flappy_wall", 33336666
WHILE 1
IF !ISACTIVE() || !CLIENTWIDTH() || !CLIENTHEIGHT()
	;should keep the game from crashing from minimizing
	AWAIT
	CONTINUE
ENDIF
CBGCLEAR
CLEARLINE LINECOUNT
GDISPOSE 1
GCREATE 1, gameFrame:0, (gameFrame:1)
;render sprite
; GCREATEFROMFILE RM_TITLE, @"29_顔.webp"
; SPRITECREATE @"TW_title", RM_TITLE
;get width, then we scale it off that
titleSize:0 = (SPRITEWIDTH("顔絵_服_通常_29")*((((gameFrame:0)/16)*100/SPRITEWIDTH("顔絵_服_通常_29"))))/100
titleSize:1 = titleSize:0
IF !playing
	posY = 0
	wallX = gameFrame:0+500
	wallY = 0
	passedWall = 0
ENDIF
posX = ((gameFrame:0)*1/10)-((titleSize:0/2))
; posY = -(titleSize:1*2/10)
GDRAWSPRITE 1, "顔絵_服_通常_29", posX, posY, titleSize, titleSize:1
;wall
SIF playing == 1
	wallX -= min(39,10+score)
SIF wallX < gameFrame:0
	GDRAWSPRITE 1, "flappy_wall", wallX, wallY, 100, 300
IF wallX < 0
	wallX = gameFrame:0+500
	wallY = rand(0,gameFrame:1-300)
	passedWall = 0
ENDIF
IF playing == 1
	IF INRANGE(WallX,posX,posX+(titleSize:0/2))
		IF InRange(PosY+(titleSize:1/2),wallY,wallY+300)
			;hit
			playing = -1
		ELSEIF !passedWall
			score++
			passedWall = 1
		ENDIF
	ENDIF
	IF scoreToWin && score >= scoreToWin
		playing = -2
	ENDIF
ENDIF
; Score
textContent '= @"점수: {score} \@ scoreToWin ? %@"/{scoreToWin}"% #  \@"
textSize = 24
GSETFONT 1, gameFont, textSize, 0
GSETPEN 1, gameFontColor, 5
GDRAWTEXT 1, textContent, ((gameFrame:0)/2) - (STRLENS(textContent)*textSize/4), 0
;Win/Lose screen
IF posY >= (gameFrame:1-(titleSize:0/2))
	playing = -1
ENDIF
IF !playing
	textContent '= "클릭하여 시작"
	textSize = 24
	GSETFONT 1, gameFont, textSize, 0
	GSETPEN 1, gameFontColor, 5
	GDRAWTEXT 1, textContent, ((gameFrame:0)/2) - (STRLENS(textContent)*textSize/4), ((gameFrame:1)*9/16)+textSize
	IF scoreToWin
		textContent '= @"클리어 점수: {scoreToWin}"
		textSize = 24
		GSETFONT 1, gameFont, textSize, 0
		GSETPEN 1, gameFontColor, 5
		GDRAWTEXT 1, textContent, ((gameFrame:0)/2) - (STRLENS(textContent)*textSize/4), ((gameFrame:1)*8/16)+textSize
	ENDIF
ELSEIF playing == -1
	IF scoreToWin
		textContent '= "YOU LOSE"
	ELSE
		textContent '= "GAME OVER"
	ENDIF
	textSize = 144
	GSETFONT 1, gameFont, textSize, 0
	GSETPEN 1, 0xff000000 + 0xFF0000, 5
	GDRAWTEXT 1, textContent, ((gameFrame:0)/2) - (STRLENS(textContent)*textSize/3), ((gameFrame:1)*4/16)
	textContent '= @"점수: {score}"
	textSize = 24
	GSETFONT 1, gameFont, textSize, 0
	GSETPEN 1, gameFontColor, 5
	GDRAWTEXT 1, textContent, ((gameFrame:0)/2) - (STRLENS(textContent)*textSize/4), ((gameFrame:1)*8/16)+textSize
	textContent '= "클릭하여 다시 시작"
	textSize = 24
	GSETFONT 1, gameFont, textSize, 0
	GSETPEN 1, gameFontColor, 5
	GDRAWTEXT 1, textContent, ((gameFrame:0)/2) - (STRLENS(textContent)*textSize/4), ((gameFrame:1)*9/16)+textSize
ELSEIF playing == -2
	textContent '= "YOU WIN"
	textSize = 144
	GSETFONT 1, gameFont, textSize, 0
	GSETPEN 1, 0xff000000 + 0x00FF00, 5
	GDRAWTEXT 1, textContent, ((gameFrame:0)/2) - (STRLENS(textContent)*textSize/3), ((gameFrame:1)*4/16)
	textContent '= @"점수: {score}"
	textSize = 24
	GSETFONT 1, gameFont, textSize, 0
	GSETPEN 1, gameFontColor, 5
	GDRAWTEXT 1, textContent, ((gameFrame:0)/2) - (STRLENS(textContent)*textSize/4), ((gameFrame:1)*8/16)+textSize
	IF quitAfterSuccess
		textContent '= "클릭하여 종료"
		textSize = 24
		GSETFONT 1, gameFont, textSize, 0
		GSETPEN 1, gameFontColor, 5
		GDRAWTEXT 1, textContent, ((gameFrame:0)/2) - (STRLENS(textContent)*textSize/4), ((gameFrame:1)*9/16)+textSize
	ELSE
		textContent '= "클릭하여 다시 시작"
		textSize = 24
		GSETFONT 1, gameFont, textSize, 0
		GSETPEN 1, gameFontColor, 5
		GDRAWTEXT 1, textContent, ((gameFrame:0)/2) - (STRLENS(textContent)*textSize/4), ((gameFrame:1)*9/16)+textSize
	ENDIF
ENDIF
;FPS (call this at the end for more accurate FPS reading)
frameTime:0 = GETMILLISECOND()
textContent '= @"{1000/MAX((frameTime:0-frameTime:1),1)} FPS "
textSize = 24
GSETFONT 1, gameFont, textSize, 0
GSETPEN 1, gameFontColor, 5
GDRAWTEXT 1, textContent, ((gameFrame:0)) - (STRLENS(textContent)*(textSize/2)), 0
CBGSETG 1, 0, 0, -10
IF playing == 1
	velY += (gameFrame:1/100)*((frameTime:0-frameTime:1)/15)/2
	posY += velY*((frameTime:0-frameTime:1)/15)/3
	SIF posY <= -(titleSize:0/2)
		posY = -(titleSize:0/2)
ENDIF
frameTime:1 = GETMILLISECOND()
INPUTMOUSEKEY 5
IF RESULT == 1 && RESULT:1 == 0x100000
	; CBGCLEAR
	; CLEARLINE LINECOUNT
	; GDISPOSE 1
	; RETURN
	SELECTCASE playing
		CASE 0
			playing = 1
		CASE 1
			velY = -(gameFrame:1/15)
		CASE -1, -2
			CBGCLEAR
			CLEARLINE LINECOUNT
			GDISPOSE 1
			IF playing == -2 && quitAfterSuccess
				RETURN 1
			ENDIF
			playing = 0
			score = 0
			velY = 0
			CONTINUE
	ENDSELECT
ELSEIF RESULT:1 == 27
	RETURN -1
ENDIF
WEND
PRINTFORMW 플래피 텐구에서 10점을 얻어 비행을 배운다.
PRINTFORMW 최고 플레이는 60FPS에서 이루어졌다
