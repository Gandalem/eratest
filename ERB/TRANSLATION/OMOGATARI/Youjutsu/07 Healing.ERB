@EsperMenuResult_7(PYC_CASTER,PYC_TARGET,nInput)
#DIM nInput
#DIM PYC_TARGET
#DIM PYC_CASTER
#DIM nIncreaseAmount
#DIM EMR_SINGLE
#DIM EMR7_LIST,100
#DIM EMR7_COUNT
TRYCALLFORM NAS_ESP_7_{nInput}
SELECTCASE nInput
CASE 0 TO 1
    nIncreaseAmount = 33
    EMR_SINGLE = 0
CASE 2 TO 3
    nIncreaseAmount = 66
    EMR_SINGLE = 2
CASEELSE
    nIncreaseAmount = 100
    EMR_SINGLE = 4
ENDSELECT

$LOOP

SELECTCASE nInput
CASE 0, 2
    CALL RECOVER(PYC_TARGET,MAXBASE:PYC_TARGET:0*nIncreaseAmount/100, BASENAME:0, @"%CALLNAME:PYC_CASTER%'s %NAS_ESP_NAME%") ;qol custom code
    CALL RECOVER(PYC_TARGET,MAXBASE:PYC_TARGET:1*nIncreaseAmount/100, BASENAME:1, @"%CALLNAME:PYC_CASTER%'s %NAS_ESP_NAME%") ;qol custom code
	CALLF HealAllHediffs(PYC_TARGET,300)
CASE 4, 7
    CALL RECOVER(PYC_TARGET,MAXBASE:PYC_TARGET:0, BASENAME:0, @"%CALLNAME:PYC_CASTER%'s %NAS_ESP_NAME%") ;qol custom code
    CALL RECOVER(PYC_TARGET,MAXBASE:PYC_TARGET:1, BASENAME:1, @"%CALLNAME:PYC_CASTER%'s %NAS_ESP_NAME%") ;qol custom code
    CALLF HESOYAM(PYC_TARGET)
CASE 1, 3, 5, 6
    IF DT_EXIST("lcCombatants")
        VARSET EMR7_LIST
        EMR7_COUNT = DT_SELECT("lcCombatants", @"side = {DT_CELL_GET("lcCombatants", GetCombatant(PYC_CASTER), "side", 1)}",,EMR7_LIST)
        FOR LOCAL,0,EMR7_COUNT
            SIF EMR7_LIST:LOCAL != PYC_CASTER
            CALL EsperMenuResult_7(PYC_CASTER,DT_CELL_GET("lcCombatants", EMR7_LIST:LOCAL, "chara", 1),EMR_SINGLE)
        NEXT
    ELSE
        FOR LOCAL,0,CHARANUM
            SIF CFLAG:LOCAL:300 != CFLAG:MASTER:300
                CONTINUE
            CALL EsperMenuResult_7(PYC_CASTER,LOCAL,EMR_SINGLE)
        NEXT
    ENDIF
ENDSELECT
WAIT

@YoujutsuSelfStudyPuzzle_7(ARG)
#DIM PATIENT
#DIM SSY7_Linecount
#DIM lastDeathEnabled
#DIMS SSYM_RESULTS
lastDeathEnabled = nNecro
nNecro = 2
CALL SpawnMobEnemy(FREE_MOB_SLOT(),1)
PATIENT = FREE_MOB_SLOT(1)
CALL PRINT_RAINBOWL(@"Stabilize %NAME:PATIENT%!")
PRINTFORML Click on the injuries to tend to them.

MAXBASE:PATIENT:Blood = MAXBASE:PATIENT:0
BASE:PATIENT:Blood = MAXBASE:PATIENT:0
TCVAR:PATIENT:Bleeding = 0
BleedTimeout:PATIENT:0 = 9999

CALLF DamageBodyPart(PATIENT, 40, 1500, 3, 72, "Unknown Origin")
CALLF DamageBodyPart(PATIENT, 81, 1500, 3, 72, "Unknown Origin")
CALLF DamageBodyPart(PATIENT, 93, 1500, 3, 72, "Unknown Origin")

CALL CrippleEffects(PATIENT)
SSY7_Linecount = LINECOUNT
WHILE 1
CLEARLINE LINECOUNT-SSY7_Linecount

IF !RAND:8
    $RetryAddPart
    LOCAL = RAND(1,100)
    SIF !HasBodyPart(PATIENT,LOCAL)
        GOTO RetryAddPart
    SIF BodyPartHealth:PATIENT:LOCAL:1 <= 300
        GOTO RetryAddPart
    $RetryHediffSeverity
    LOCAL:1 = RAND(300,BodyPartHealth:PATIENT:LOCAL:1)

    CALLF DamageBodyPart(PATIENT, LOCAL, LOCAL:1, 3, 72, "Unknown Origin")
ENDIF

CALL BODY_PART_HEALTH(PATIENT,7)
RESETCOLOR
;CALL BLOOD_STATUS(PATIENT,28)

PRINTBUTTON "[Cancel]", "cancel"
PRINTBUTTON "[Cast Dia]", "dia"
PRINTBUTTON "[Enter Bypass Code]", "bypass code"
PRINTL
TINPUTS 1000, "p", 0
SIF RESULTS == "p"
    CLEARLINE 2
SSYM_RESULTS '= RESULTS
SELECTCASE SSYM_RESULTS
CASE "cancel"
    GOTO END
CASE "dia"
	CALL PROCESS_YOUJUTSU_COMMAND(MASTER,PATIENT,7,0)
CASE "bypass code"
        CALL SPELL_THE_WORD_PUZZLE(ARG,SPELL_THE_WORDIFY(@"eradimm"),10,LOCALS)
        IF RESULT == 1
            FONTITALIC
            CALL PRINT_GPC("L", @"Bypass code accepted.")
            FONTREGULAR
            CALL YoujutsuLearningProgress(ARG,7,10000)
            GOTO END
        ENDIF
CASEELSE
    IF TOINT(SSYM_RESULTS)
        DT_CELL_SET @"Hediff", TOINT(SSYM_RESULTS), "bleeding", MAX(0,DT_CELL_GET(@"Hediff", TOINT(SSYM_RESULTS), "bleeding",1)-MAX(1,ABL:MASTER:Medical)), 1
        SIF DT_CELL_GET(@"Hediff", TOINT(SSYM_RESULTS), "bleeding",1) == 0
            DT_CELL_SET @"Hediff", TOINT(SSYM_RESULTS), "tended", 300, 1
    ENDIF
ENDSELECT

BASE:PATIENT:Blood -= MAX((((TCVAR:PATIENT:Bleeding))-2),0)

CALL CrippleEffects(PATIENT)
IF IsDead:PATIENT:0
    PRINTFORMW %CALLNAME:PATIENT% has died...
    GOTO END
ELSEIF TCVAR:PATIENT:Bleeding == 0
    CALL PRINT_GP("L", @"%CALLNAME:PATIENT% has been stabilized!")
    CALL PRINT_GP("W", @"Use code \"eradimm\" to skip the program next time.")

	CALL YoujutsuLearningProgress(ARG,7,10000)
    GOTO END
ENDIF
WEND
$END
nNecro = lastDeathEnabled
CALL DELETE_CHARA(PATIENT)
SIF PATIENT == RANDOM_CHARANUM
    CALL ADDCHARA_INIT(CSV_CHARANUM())

@BLOOD_STATUS(ARG,nSize = 28)
#DIM nSize
#DIM BleedRate

CALL BASE_BAR(ARG, "Blood", nSize, "赤","")
IF TCVAR:ARG:Bleeding
    PRINT  
    BleedRate = BleedoutRate(ARG)
    PRINTFORM Rate: {BleedRate}ml/hour 
    IF IsDead:ARG:0
    PRINTFORM (dead)
    ELSEIF BleedRate > 120
        IF MinsOfBleedUntilDeath(ARG)/60 == 0 
            PRINTFORM (death in {MinsOfBleedUntilDeath(ARG)} %PLURALIZER("minute",MinsOfBleedUntilDeath(ARG))%)    
        ELSE
            PRINTFORM (death in {MinsOfBleedUntilDeath(ARG)/60} %PLURALIZER("hour",MinsOfBleedUntilDeath(ARG)/60)%
            SIF MinsOfBleedUntilDeath(ARG)%60
                PRINTFORM  {MinsOfBleedUntilDeath(ARG)%(60)} %PLURALIZER("minute",MinsOfBleedUntilDeath(ARG)%(60))%
            PRINT )    
        ENDIF
    ELSE
    PRINTFORM (no immediate danger)    
    ENDIF
ENDIF

@BleedoutRate(ARG)
#FUNCTION
RETURNF MAX(((60*(TCVAR:ARG:Bleeding))-120),0)

@MinsOfBleedUntilDeath(ARG)
#FUNCTION
RETURNF BASE:ARG:Blood/(BleedoutRate(ARG)/60)

@AGONY_STAGE(ARG)
#FUNCTION
SELECTCASE (BASE:ARG:Agony*100)/(MaxBase:ARG:Agony)
CASE IS > 80
    RETURNF 5
CASE IS > 60
    RETURNF 4
CASE IS > 40
    RETURNF 3
CASE IS > 10
    RETURNF 2
CASE IS > 0
    RETURNF 1
CASEELSE
    RETURNF 0
ENDSELECT


@AGONY_STATUS(ARG,nSize = 28)
#DIM nSize
#DIM BleedRate

CALL BASE_BAR(ARG, "Agony", nSize, "赤","")
PRINT  
SELECTCASE AGONY_STAGE(ARG)
CASE 5
	SETCOLOR C_RED
	FONTBOLD
	PRINTFORM (Severe!!!!)
	FONTREGULAR
CASE 4
	SETCOLOR C_RED
	PRINTFORM (Unmanageable!)
CASE 3
	SETCOLOR C_ORANGE
	PRINTFORM (Distressing)
CASE 2
	SETCOLOR C_YELLOW
	PRINTFORM (Distracting)
CASE 1
	PRINTFORM (Minimal)
CASE 0
	PRINTFORM (None)
ENDSELECT
RESETCOLOR