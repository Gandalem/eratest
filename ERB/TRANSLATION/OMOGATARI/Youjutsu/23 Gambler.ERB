CASE 0
PRINTFORML %CALLNAME:PYC_CASTER% rolls the dice...
D_ROLL = RAND(1,20)

CASE 1
;so snap can kill the player
ENDSELECT
WAIT

@GamblerMagicSpell(GMS_Caster,GMS_Type)
#DIM GMS_Caster
#DIMS GMS_Type
#DIM GMA_SpellTypeCount
#DIM GMA_SpellType
#DIM GMA_Spell

;rng to 6400
CALL FISHER_YATES_SHAFFLE(6400)
GMA_SpellTypeCount = 0
$RedoMagic
;get spell type and spell
GMA_SpellType = (SHAFFLE_ARRAY:GMA_SpellTypeCount)/100
GMA_Spell = (SHAFFLE_ARRAY:GMA_SpellTypeCount)%100

;null checks
IF !ExistFunction(@"NAS_ESP_{GMA_SpellType}")
    ;null
    GMA_SpellTypeCount++
    GOTO RedoMagic
ELSEIF !ExistFunction(@"NAS_ESP_{GMA_SpellType}_{GMA_Spell}")
    ;null
    GMA_SpellTypeCount++
    GOTO RedoMagic
ENDIF

;check the type of spell we are looking for
SELECTCASE GMS_Type
CASE "damaging"
CASE "stat"
ENDSELECT


