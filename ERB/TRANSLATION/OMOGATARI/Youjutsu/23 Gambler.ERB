@YoujutsuSelfStudyPuzzle_Quest_23(ARG,nSearchMode = "GET")
#DIMS nSearchMode
#DIM DYNAMIC nHasDidIt
nHasDidIt = 0
SELECTCASE YoujutsuQuestProgress:ARG:23
	CASE 10000 TO 19999
		;gold rank casino member reward
		SELECTCASE nSearchMode
			CASE "SET"
				RETURN 1
			CASE "GET"
				CALL PRINT_LETTER(@"책에는 그 캐릭터가 카지노를 충분히 플레이함으로써 무작위화 능력을 얻었다고 언급되어 있다. 그는 특히 골드 랭크 멤버가 될 때까지 충분히 플레이했다고 명시한다.\n카지노에서 더 많이 플레이해 보라.",,40)
			CASE "CHECK"
				SIF FLAG:会員ランク >= 3
					nHasDidIt = 1
				RETURN nHasDidIt
		ENDSELECT
ENDSELECT

