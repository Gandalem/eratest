@EsperMenuResult_23(PYC_CASTER,PYC_TARGET,nInput)
#DIM nInput
#DIM PYC_TARGET
#DIM PYC_CASTER
#DIM nIncreaseAmount
#DIM EMR
#DIM D_ROLL
EMR = TOINT(SUBSTRING(GETDOINGFUNCTION(),16))
TRYCALLFORM NAS_ESP_{EMR}_{nInput}
SELECTCASE nInput
	CASE 0
		PRINTFORML %CALLNAME:PYC_CASTER%가 주사위를 굴린다...
		D_ROLL = RAND(1,20)
	CASE 1
		;so snap can kill the player
ENDSELECT
WAIT

@GamblerMagicSpell(GMS_Caster,GMS_Type)
#DIM GMS_Caster
#DIMS GMS_Type
#DIM GMA_SpellTypeCount
#DIM GMA_SpellType
#DIM GMA_Spell
;rng to 6400
CALL FISHER_YATES_SHAFFLE(6400)
GMA_SpellTypeCount = 0
$RedoMagic
;get spell type and spell
GMA_SpellType = (SHAFFLE_ARRAY:GMA_SpellTypeCount)/100
GMA_Spell = (SHAFFLE_ARRAY:GMA_SpellTypeCount)%100
;null checks
IF !ExistFunction(@"NAS_ESP_{GMA_SpellType}")
	;null
	GMA_SpellTypeCount++
	GOTO RedoMagic
ELSEIF !ExistFunction(@"NAS_ESP_{GMA_SpellType}_{GMA_Spell}")
	;null
	GMA_SpellTypeCount++
	GOTO RedoMagic
ENDIF
;check the type of spell we are looking for
SELECTCASE GMS_Type
	CASE "damaging"
	CASE "stat"
ENDSELECT
;A spell that has a chance to either halve or double the next incoming damage could be interesting
;gun spell that fires a random caliber
;Healing spell that inflicts a random effect along the heal (the heal is fixed)
;Player dodge minigame is canceled when gambler spells are used
