@YoujutsuSelfStudyPuzzle_Quest_23(ARG,nSearchMode = "GET")
#DIMS nSearchMode
#DIM DYNAMIC nHasDidIt
nHasDidIt = 0

SELECTCASE YoujutsuQuestProgress:ARG:23
CASE 10000 TO 19999
    ;gold rank casino member reward
    SELECTCASE nSearchMode
    CASE "SET"
        RETURN 1
    CASE "GET"
            CALL PRINT_LETTER(@"The book mentions how the character gained his randomizing powers by playing the casino enough. He specifically states that he played enough to become a Gold Rank Member.\nTry playing at the casino more.",,40)
    CASE "CHECK"
        SIF FLAG:会員ランク >= 3
            nHasDidIt = 1
        RETURN nHasDidIt
    ENDSELECT
ENDSELECT

