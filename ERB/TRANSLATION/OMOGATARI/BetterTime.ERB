; Modular ERB: OMOGATARI/BetterTime.ERB
;returns the name of the current festival in english or nothing
;if the original function is changed, this one should be updated accordingly

@FESTIVAL_NAS
#FUNCTIONS
SELECTCASE DAY:2
	CASE 1
		SELECTCASE DAY:3
			CASE 1
				RETURNF "설날"
			CASE 2
				RETURNF "여자아이의 날"
			CASE 11
				RETURNF "어머니의 날"
			CASE 13
				RETURNF "화이트 이브"
			CASE 14
				RETURNF "화이트데이"
		ENDSELECT
	CASE 2
		SELECTCASE DAY:3
			CASE 5
				RETURNF "밸런타인데이"
			CASE 9
				RETURNF "토끼의 날"
		ENDSELECT
	CASE 3
		SELECTCASE DAY:3
			CASE 4
				RETURNF "화이트 이브"
			CASE 5
				RETURNF "화이트데이"
		ENDSELECT
	CASE 4
		SELECTCASE DAY:3
			CASE 1
				RETURNF "만우절"
		ENDSELECT
	CASE 5
		SELECTCASE DAY:3
			CASE 4
				RETURNF "어머니의 날"
			CASE 7
				RETURNF "하쿠레이 신사 예대제"
			CASE 9
				RETURNF "토끼의 날"
		ENDSELECT
	CASE 8
		SELECTCASE DAY:3
			CASE 9
				RETURNF "토끼의 날"
		ENDSELECT
	CASE 9
		SELECTCASE DAY:3
			CASE 1
				RETURNF "풍신 「폭풍의 날」"
		ENDSELECT
	CASE 10
		SELECTCASE DAY:3
			CASE 10
				RETURNF "핼러윈"
		ENDSELECT
	CASE 12
		SELECTCASE DAY:3
			CASE 9
				RETURNF "겨울 코믹 마켓"
			CASE 10
				RETURNF "섣달그믐"
		ENDSELECT
	CASEELSE
		RETURNF "월 정보가 없습니다! 이 오류를 제보해 주세요!"
ENDSELECT
;winter: december to february
;spring: march to may
;summer: june to august
;autumn: september to november

@GET_MONTH_NAS(ARG, ARG:1) ;custom code to return translated name on ARG:1 = 1
#FUNCTIONS
;fallback to include negative inputs
SIF ARG <= 0
	ARG = DAY:2
;custom code
RETURNF SPLIT_SINGLE("알 수 없음/1월/2월/3월/4월/5월/6월/7월/8월/9월/10월/11월/12월/", ARG, "/")
;NAS: 12 months of 10.
;February, May, August, and November have 11 days instead of 10
;This is to ensure 124-day parity.

@MONTH_LENGTH_NAS(ARG)
#FUNCTION
RETURNF 31
SELECTCASE ARG
	CASE 2, 5, 8, 11
		RETURNF 11
	CASEELSE
		RETURNF 10
ENDSELECT

@GET_SEASON_NAS(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 0 TO 2, 12
		RETURNF 1
	CASE 3 TO 5
		RETURNF 2
	CASE 6 TO 8
		RETURNF 3
	CASE 9 TO 11
		RETURNF 4
ENDSELECT
