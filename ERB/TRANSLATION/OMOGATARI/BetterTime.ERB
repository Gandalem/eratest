; Modular ERB: OMOGATARI/BetterTime.ERB
;returns the name of the current festival in english or nothing
;if the original function is changed, this one should be updated accordingly

@FESTIVAL_NAS
#FUNCTIONS
SELECTCASE DAY:2
	CASE 1
		SELECTCASE DAY:3
			CASE 1
				RETURNF "New Year's Day"
			CASE 2
				RETURNF "Girls' Day"
			CASE 11
				RETURNF "Mother's Day"
			CASE 13
				RETURNF "White Evening"
			CASE 14
				RETURNF "White Day"
		ENDSELECT
	CASE 2
		SELECTCASE DAY:3
			CASE 5
				RETURNF "Valentine's Day"
			CASE 9
				RETURNF "Bunny Day"
		ENDSELECT
	CASE 3
		SELECTCASE DAY:3
			CASE 4
				RETURNF "White Evening"
			CASE 5
				RETURNF "White Day"
		ENDSELECT
	CASE 4
		SELECTCASE DAY:3
			CASE 1
				RETURNF "April Fools"
		ENDSELECT
	CASE 5
		SELECTCASE DAY:3
			CASE 4
				RETURNF "Mother's Day"
			CASE 7
				RETURNF "Reitaisai"
			CASE 9
				RETURNF "Bunny Day"
		ENDSELECT
	CASE 8
		SELECTCASE DAY:3
			CASE 9
				RETURNF "Bunny Day"
		ENDSELECT
	CASE 9
		SELECTCASE DAY:3
			CASE 1
				RETURNF "Wind God 「Storm Day」"
		ENDSELECT
	CASE 10
		SELECTCASE DAY:3
			CASE 10
				RETURNF "Halloween"
		ENDSELECT
	CASE 12
		SELECTCASE DAY:3
			CASE 9
				RETURNF "Winter Comic Market"
			CASE 10
				RETURNF "New Year's Eve"
		ENDSELECT
	CASEELSE
		RETURNF "No month reported! Report this!"
ENDSELECT
;winter: december to february
;spring: march to may
;summer: june to august
;autumn: september to november

@GET_MONTH_NAS(ARG, ARG:1) ;custom code to return translated name on ARG:1 = 1
#FUNCTIONS
;fallback to include negative inputs
SIF ARG <= 0
	ARG = DAY:2
;custom code
RETURNF SPLIT_SINGLE("Unknown/January/February/March/April/May/June/July/August/September/October/November/December/", ARG, "/")
;NAS: 12 months of 10.
;February, May, August, and November have 11 days instead of 10
;This is to ensure 124-day parity.

@MONTH_LENGTH_NAS(ARG)
#FUNCTION
RETURNF 31
SELECTCASE ARG
	CASE 2, 5, 8, 11
		RETURNF 11
	CASEELSE
		RETURNF 10
ENDSELECT

@GET_SEASON_NAS(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 0 TO 2, 12
		RETURNF 1
	CASE 3 TO 5
		RETURNF 2
	CASE 6 TO 8
		RETURNF 3
	CASE 9 TO 11
		RETURNF 4
ENDSELECT
