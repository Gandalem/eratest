@COMMAND_IS_HARMFUL(ARG, nCommand)
#FUNCTION
#DIM nCommand
VARSET NEW_COM_HARM_CAN_BP
SELECTCASE nCommand
CASE 9299
;Execute
    NEW_COM_HARM_CAN_BP = 1
    RETURNF 4
CASE 9298
;Brand as slave
    NEW_COM_HARM_CAN_BP = 1
    RETURNF 3
CASE 9481
;Fire weapon
    SIF TARGET == MASTER
        RETURNF 1
    NEW_COM_HARM_CAN_BP = 1
    LOCAL = charaWeaponInts:(MASTER):Damage*MAX(1,charaWeaponInts:(MASTER):Pellets)
    IF LOCAL > BodyPartHealth:ARG:40:1*2
        RETURNF 4
    ELSEIF LOCAL > BodyPartHealth:ARG:1:1*2
        RETURNF 3
    ELSEIF LOCAL > BodyPartHealth:ARG:1:1/2
        RETURNF 2
    ENDIF
    RETURNF 1
CASE 9797
;Attack
    NEW_COM_HARM_CAN_BP = 1
    RETURNF 3
CASE 9350
;Rape
    NEW_COM_HARM_CAN_BP = 1
    RETURNF 2
CASE 9340
;Kick Stomach
    RETURNF 2
CASE 350
;Push down
    IF FLAG:70 && !MAXBASE:TARGET:TSP
        RETURNF 2
    ELSEIF CFLAG:睡眠
        RETURNF 2
    ENDIF
CASE 310, 330
	SIF (TCVAR:MASTER:馴れ合い < 2) && !CFLAG:睡眠
		RETURNF 2
CASE 310, 330
	SIF (TCVAR:MASTER:馴れ合い < 1) && !CFLAG:睡眠
		RETURNF 1
CASE 416
    SIF TARGET == MASTER
        RETURNF 0
    RETURNF 1
ENDSELECT

