SELECTCASE nPageName
	CASE "FP"
		SELECTCASE nCommand
			CASE 0, 5, 6, 15, 20, 22, 80, 81, 85, 902, 7, 3, 11, 12, 308, 310, 312,330,460
				RETURNF 1
			CASE 120, 145,91,9228,140, 90, 121, 126, 125
				RETURNF 1
			CASE 451, 700 TO 755
				RETURNF 1
		ENDSELECT
	CASE "INS"
		SELECTCASE nCommand
			CASE 92 TO 94, 130 TO 133, 60 TO 70
				RETURNF 1
		ENDSELECT
	CASE "TOY"
		SELECTCASE nCommand
			CASE 41, 99, 104, 105, 107,183,146,147, 40, 42, 44, 45, 46, 47, 48, 127
				RETURNF 1
			CASE 9339
				RETURNF 1
			CASE 9163 TO 9169
				RETURNF 1
		ENDSELECT
	CASE "SM"
		SELECTCASE nCommand
			CASE 64,100 TO 110, 140 TO 144, 182
				RETURNF 1
			CASE 150, 184, 186
				RETURNF 1
			CASE 9170, 9193, 9151
				RETURNF 1
		ENDSELECT
	CASE "DAY"
		SELECTCASE nCommand
			CASE 300, 301, 302, 332, 352,9357,9489
				RETURNF 1
		ENDSELECT
	CASE "CTXT"
		SELECTCASE nCommand
			CASE 460
			CASE 400 TO 499
			CASE 9452,9780,9480,9479,410
				RETURNF 1
		ENDSELECT
	CASE "HOST"
		SELECTCASE nCommand
			CASE 9797, 9350, 9340, 9481
				RETURNF 1
			CASE 9339
				SIF !CFLAG:MASTER:うふふ
					RETURNF 1
		ENDSELECT
	CASE "DIAL"
		SELECTCASE nCommand
			CASE 433
				RETURNF 1
			CASE 270 TO 299
				RETURNF 1
		ENDSELECT
	CASE "CUST"
		SIF nCommand >= 9000
			RETURNF 1
	CASE "OTR"
		FOR LOCAL,0,VARSIZE("NEW_COM_ABR")
		SIF NEW_COM_ABR:LOCAL == "OTR"
			CONTINUE
		SIF NEW_COM_ABR:LOCAL == "ALL"
			CONTINUE
		SIF NAS_FILTER_CANDO(NEW_COM_ABR:LOCAL,nCommand)
			RETURNF 0
		NEXT
		RETURNF 1
	CASEELSE
		RETURNF 1
ENDSELECT
RETURNF 0

@COMMAND_IS_HARMFUL(ARG, nCommand)
#FUNCTION
#DIM nCommand
VARSET NEW_COM_HARM_CAN_BP
SELECTCASE nCommand
	CASE 9299
		;Execute
		NEW_COM_HARM_CAN_BP = 1
		RETURNF 4
	CASE 9298
		;Brand as slave
		NEW_COM_HARM_CAN_BP = 1
		RETURNF 3
	CASE 9481
		;Fire weapon
		SIF TARGET == MASTER
			RETURNF 1
		NEW_COM_HARM_CAN_BP = 1
		LOCAL = charaWeaponInts:(MASTER):Damage*MAX(1,charaWeaponInts:(MASTER):Pellets)
		IF LOCAL > BodyPartHealth:ARG:40:1*2
			RETURNF 4
		ELSEIF LOCAL > BodyPartHealth:ARG:1:1*2
			RETURNF 3
		ELSEIF LOCAL > BodyPartHealth:ARG:1:1/2
			RETURNF 2
		ENDIF
		RETURNF 1
	CASE 9797
		;Attack
		NEW_COM_HARM_CAN_BP = 1
		RETURNF 3
	CASE 9350
		;Rape
		NEW_COM_HARM_CAN_BP = 1
		RETURNF 2
	CASE 9340
		;Kick Stomach
		RETURNF 2
	CASE 350
		;Push down
		IF FLAG:70 && !MAXBASE:TARGET:TSP
			RETURNF 2
		ELSEIF CFLAG:睡眠
			RETURNF 2
		ENDIF
	CASE 310, 330
		SIF (TCVAR:MASTER:馴れ合い < 2) && !CFLAG:睡眠
			RETURNF 2
	CASE 310, 330
		SIF (TCVAR:MASTER:馴れ合い < 1) && !CFLAG:睡眠
			RETURNF 1
	CASE 416
		SIF TARGET == MASTER
			RETURNF 0
		RETURNF 1
ENDSELECT

@MAKE_HARMFUL_COMMAND_COLOR(ARG,nCommand)
#DIM nCommand
LOCAL = COMMAND_IS_HARMFUL(ARG, nCommand)
SELECTCASE LOCAL
	CASE 0
	CASEELSE
		SETCOLOR DANGER_COMMAND_COLOR_LIST(LOCAL)
ENDSELECT

@DANGER_COMMAND_COLOR_LIST(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 1
		RETURNF C_YELLOW
	CASE 2
		RETURNF C_ORANGE
	CASE 3
		RETURNF C_RED
	CASE 4
		RETURNF C_D_RED
ENDSELECT

@HARMFUL_COMMAND_WARNING(ARG,nCommand)
#DIM nCommand
IF nCommand == ADD_CUSTOM_SCOM
	LOCALS '= Add_Custom_SCOM_Name(ADD_SELECTED_SCOM)
ELSEIF nCommand >= 9000
	LOCALS '= Add_Custom_COM_Name(nCommand-9000)
ELSEIF TFLAG:151 > -1
	LOCALS = %STR_TR(1500 + nCommand)%
ELSE
	LOCALS = %TRAINNAME_TR(nCommand)%
ENDIF
SELECTCASE COMMAND_IS_HARMFUL(ARG, nCommand)
	CASE 4
		FONTITALIC
		SETCOLOR C_D_RED
		PRINTFORML 【%LOCALS%】는 %CALLNAME:ARG%에게 확실한 종말이 될 명령이다.
		RESETCOLOR
		FONTREGULAR
		IF !NEW_COM_HARM_CAN_BP
			PRINTFORML 계속할래요?
			CALL ASK_YN()
			SIF RESULT
				RETURN -1
		ENDIF
	CASE 3
		FONTITALIC
		SETCOLOR C_RED
		PRINTFORML 【%LOCALS%】은 확실히 %CALLNAME:ARG%에게 심각한 신체적 또는 관계적 해를 입힐 수 있으며, %HIM_HER(ARG)%을 죽일 수도 있다.
		RESETCOLOR
		FONTREGULAR
		IF !NEW_COM_HARM_CAN_BP
			PRINTFORML 계속 진행하시겠습니까?
			CALL ASK_YN()
			SIF RESULT
				RETURN -1
		ENDIF
	CASE 2
		FONTITALIC
		SETCOLOR C_ORANGE
		PRINTFORML 【%LOCALS%】은(는) 확실히 %CALLNAME:ARG%에게 신체적 또는 관계상의 해를 끼칠 것이다.
		RESETCOLOR
		FONTREGULAR
		IF !NEW_COM_HARM_CAN_BP
			PRINTFORML 계속할까요?
			CALL ASK_YN()
			SIF RESULT
				RETURN -1
		ENDIF
	CASE 1
		FONTITALIC
		SETCOLOR C_YELLOW
		PRINTFORML 【%LOCALS%】은 당신이나 %CALLNAME:ARG%에게 신체적 또는 관계상의 해를 끼칠 수 있다.
		RESETCOLOR
		FONTREGULAR
ENDSELECT
RETURN 1

@SEX_COMMAND_SIMULATE_RISK(ARG,nCommand)
#DIM nCommand
#DIM enduranceSave, 10
#DIM enduranceSaveMaster, 10
#DIM baseSave, VARSIZE("BASE")
#DIM baseSaveMaster, VARSIZE("BASE")
#DIM expSave, VARSIZE("EXP")
#DIM expSaveMaster, VARSIZE("EXP")
#DIM tequipSave, VARSIZE("TEQUIP")
#DIM tequipSaveMaster, VARSIZE("TEQUIP")
#DIM tcvarSave, VARSIZE("TCVAR")
#DIM tcvarSaveMaster, VARSIZE("TCVAR")
#DIM palamSave, VARSIZE("TCVAR")
#DIM palamSaveMaster, VARSIZE("TCVAR")
#DIM qolDateSave, VARSIZE("Qol_Info_Dates_Array")
#DIM qolDateSaveMaster, VARSIZE("Qol_Info_Dates_Array")
#DIM qolCountSave, VARSIZE("Qol_Info_Count_Array")
#DIM qolCountSaveMaster, VARSIZE("Qol_Info_Count_Array")
#DIM drugStatsSave, VARSIZE("DrugStats")
#DIM drugStatsSaveMaster, VARSIZE("DrugStats")
#DIM stainSave, VARSIZE("STAIN")
#DIM stainSaveMaster, VARSIZE("STAIN")
#DIM tflagSave, VARSIZE("TFLAG")
#DIM commandAfter
#DIM timeSave
#DIMS strSave, 10
#DIMS cstr10Save
#DIMS cstr10SaveMaster
#DIM TF102Save
#DIM TF100Save
#DIM TF230Save
TF100Save = TFLAG:100
TF102Save = TFLAG:102
TF230Save = TFLAG:230
TFLAG:103 = 0
TFLAG:97 = 0
TFLAG:98 = 0
TFLAG:99 = 0
timeSave = TIME
;back up stats
FOR LOCAL, 0, VARSIZE("TCVAR")
SELECTCASE LOCAL
	CASE 0 TO 6
		;doesn't exist
		SIF !EnduranceDB(TOSTR(LOCAL))
			GOTO BypassEndure
		enduranceSave:LOCAL       = GETVAR(@"%EC_EXP_VAR%:{ARG}:0")
		enduranceSaveMaster:LOCAL = GETVAR(@"%EC_EXP_VAR%:{MASTER}:0")
ENDSELECT
$BypassEndure
;Saved strings
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("strSave")-1
		strSave:LOCAL '= STR:LOCAL
ENDSELECT
;EXP
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("EXP")-1
		expSave:LOCAL       = EXP:ARG:LOCAL
		expSaveMaster:LOCAL = EXP:MASTER:LOCAL
ENDSELECT
;BASE
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("BASE")-1
		baseSave:LOCAL      = BASE:ARG:LOCAL
		baseSaveMaster:LOCAL = BASE:MASTER:LOCAL
ENDSELECT
;PALAM
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("PALAM")-1
		palamSave:LOCAL = PALAM:ARG:LOCAL
		palamSaveMaster:LOCAL = PALAM:MASTER:LOCAL
ENDSELECT
;QOL
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("Qol_Info_Dates_Array")-1
		qolDateSave:LOCAL = Qol_Info_Dates_Array:ARG:LOCAL
		qolDateSaveMaster:LOCAL = Qol_Info_Dates_Array:MASTER:LOCAL
ENDSELECT
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("Qol_Info_Count_Array")-1
		qolCountSave:LOCAL = Qol_Info_Count_Array:ARG:LOCAL
		qolCountSaveMaster:LOCAL = Qol_Info_Count_Array:MASTER:LOCAL
ENDSELECT
;STAIN
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("STAIN")-1
		stainSave:LOCAL = STAIN:ARG:LOCAL
		stainSaveMaster:LOCAL = STAIN:MASTER:LOCAL
ENDSELECT
;DrugStats
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("DrugStats")-1
		drugStatsSave:LOCAL = DrugStats:ARG:LOCAL
		drugStatsSaveMaster:LOCAL = DrugStats:MASTER:LOCAL
ENDSELECT
tequipSave:LOCAL       = TEQUIP:ARG:LOCAL
tequipSaveMaster:LOCAL = TEQUIP:MASTER:LOCAL
tcvarSave:LOCAL       = TCVAR:ARG:LOCAL
tcvarSaveMaster:LOCAL = TCVAR:MASTER:LOCAL
tflagSave:LOCAL       = TFLAG:LOCAL
NEXT
cstr10Save '= CSTR:ARG:10
cstr10SaveMaster '= CSTR:MASTER:10
SKIPDISP 1
SELECTCASE nCommand
	CASE IS >= 9000
		TRYCALLFORM ADD_CUSTOM_COM{nCommand-9000}
	CASEELSE
		TRYCALLFORM COM{nCommand}
ENDSELECT
SKIPDISP 0
SOURCE:ARG:(33) = SOURCE:ARG:(33) *  MASTER_FAVOR_CHECK(ARG,33) * TECHNIQUE_CHECK(ARG,33) / 10000
SOURCE:ARG:(33) = SOURCE:ARG:(33) *  MOOD_CHECK(ARG,33) * REASON_CHECK(ARG,33) / 10000
CALL SOURCE_逸脱(ARG)
CALL SOURCE_反感(ARG)
CALL SOURCE_EXTRA(ARG)
;;#;DEBUGPRINTFORML %CALLNAME:ARG% hostility CUP for command {nCommand}: {CUP:ARG:反感}
SELECTCASE CUP:ARG:反感+CUP:ARG:不快
	CASE IS >= HateMarkThreshold:5
		commandAfter = 4
	CASE IS >= HateMarkThreshold:2
		commandAfter = 3
	CASE IS >= HateMarkThreshold:1
		commandAfter = 2
	CASEELSE
		commandAfter = 0
ENDSELECT
;revert
FOR LOCAL, 0, VARSIZE("TCVAR")
SELECTCASE LOCAL
	CASE 0 TO 6
		;doesn't exist
		SIF !EnduranceDB(TOSTR(LOCAL))
			GOTO BypassEndureRev
		enduranceSave:LOCAL = GETVAR(@"%EC_EXP_VAR%:{ARG}:0")
		enduranceSaveMaster:LOCAL = GETVAR(@"%EC_EXP_VAR%:{MASTER}:0")
ENDSELECT
$BypassEndureRev
;Saved strings
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("strSave")-1
		STR:LOCAL '= strSave:LOCAL
ENDSELECT
;EXP
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("EXP")-1
		EXP:ARG:LOCAL = expSave:LOCAL
		EXP:MASTER:LOCAL = expSaveMaster:LOCAL
ENDSELECT
;BASE
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("BASE")-1
		BASE:ARG:LOCAL    = baseSave:LOCAL
		BASE:MASTER:LOCAL = baseSaveMaster:LOCAL
		DOWNBASE:ARG:LOCAL    = 0
		DOWNBASE:MASTER:LOCAL = 0
ENDSELECT
;PALAM
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("PALAM")-1
		PALAM:ARG:LOCAL = palamSave:LOCAL
		PALAM:MASTER:LOCAL = palamSaveMaster:LOCAL
ENDSELECT
;QOL
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("Qol_Info_Dates_Array")-1
		Qol_Info_Dates_Array:ARG:LOCAL = qolDateSave:LOCAL
		Qol_Info_Dates_Array:MASTER:LOCAL = qolDateSaveMaster:LOCAL
ENDSELECT
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("Qol_Info_Count_Array")-1
		Qol_Info_Count_Array:ARG:LOCAL = qolCountSave:LOCAL
		Qol_Info_Count_Array:MASTER:LOCAL = qolCountSaveMaster:LOCAL
ENDSELECT
;STAIN
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("STAIN")-1
		STAIN:ARG:LOCAL = stainSave:LOCAL
		STAIN:MASTER:LOCAL = stainSaveMaster:LOCAL
ENDSELECT
;DrugStats
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("DrugStats")-1
		DrugStats:ARG:LOCAL = drugStatsSave:LOCAL
		DrugStats:MASTER:LOCAL = drugStatsSaveMaster:LOCAL
ENDSELECT
;CUP/CDOWN
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("CUP")-1
		CUP:ARG:LOCAL = 0
		CUP:MASTER:LOCAL = 0
		CDOWN:ARG:LOCAL = 0
		CDOWN:MASTER:LOCAL = 0
ENDSELECT
;SOURCE
SELECTCASE LOCAL
	CASE 0 TO VARSIZE("SOURCE")-1
		SOURCE:ARG:LOCAL = 0
		SOURCE:MASTER:LOCAL = 0
ENDSELECT
TEQUIP:ARG:LOCAL = tequipSave:LOCAL
TEQUIP:MASTER:LOCAL = tequipSaveMaster:LOCAL
TCVAR:ARG:LOCAL = tcvarSave:LOCAL
TCVAR:MASTER:LOCAL = tcvarSaveMaster:LOCAL
TFLAG:LOCAL = tflagSave:LOCAL
NEXT
CSTR:ARG:10 '= cstr10Save
CSTR:MASTER:10 '= cstr10SaveMaster
TIME = timeSave
TFLAG:102 = TF102Save
TFLAG:100 = TF100Save
TFLAG:230 = TF230Save
RETURN commandAfter
