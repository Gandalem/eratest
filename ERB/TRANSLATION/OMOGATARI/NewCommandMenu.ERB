CASE 0
CASEELSE
SETCOLOR DANGER_COMMAND_COLOR_LIST(LOCAL)
ENDSELECT

@DANGER_COMMAND_COLOR_LIST(ARG)
#FUNCTION
SELECTCASE ARG
CASE 1
RETURNF C_YELLOW
CASE 2
RETURNF C_ORANGE
CASE 3
RETURNF C_RED
CASE 4
RETURNF C_D_RED
ENDSELECT


@HARMFUL_COMMAND_WARNING(ARG,nCommand)
#DIM nCommand
IF nCommand == ADD_CUSTOM_SCOM
    LOCALS '= Add_Custom_SCOM_Name(ADD_SELECTED_SCOM)
ELSEIF nCommand >= 9000
    LOCALS '= Add_Custom_COM_Name(nCommand-9000)
ELSEIF TFLAG:151 > -1
    LOCALS = %STR_TR(1500 + nCommand)%
ELSE
    LOCALS = %TRAINNAME_TR(nCommand)%
ENDIF


SELECTCASE COMMAND_IS_HARMFUL(ARG, nCommand)
CASE 4
    FONTITALIC
    SETCOLOR C_D_RED
    PRINTFORML 【%LOCALS%】is a command that will certainly be the end for %CALLNAME:ARG%.
    RESETCOLOR
    FONTREGULAR
    IF !NEW_COM_HARM_CAN_BP
        PRINTFORML Do you want to continue?
        CALL ASK_YN()
        SIF RESULT
            RETURN -1
    ENDIF
CASE 3
    FONTITALIC
    SETCOLOR C_RED
    PRINTFORML 【%LOCALS%】will certainly cause severe physical or relational harm to %CALLNAME:ARG% and may kill %HIM_HER(ARG)%.
    RESETCOLOR
    FONTREGULAR
    IF !NEW_COM_HARM_CAN_BP
        PRINTFORML Do you want to continue?
        CALL ASK_YN()
        SIF RESULT
            RETURN -1
    ENDIF
CASE 2
    FONTITALIC
    SETCOLOR C_ORANGE
    PRINTFORML 【%LOCALS%】will certainly cause physical or relationship harm to %CALLNAME:ARG%.
    RESETCOLOR
    FONTREGULAR
    IF !NEW_COM_HARM_CAN_BP
        PRINTFORML Do you want to continue?
        CALL ASK_YN()
        SIF RESULT
            RETURN -1
    ENDIF
CASE 1
    FONTITALIC
    SETCOLOR C_YELLOW
    PRINTFORML 【%LOCALS%】may cause physical or relationship harm to you or %CALLNAME:ARG%.
    RESETCOLOR
    FONTREGULAR
ENDSELECT
RETURN 1

@SEX_COMMAND_SIMULATE_RISK(ARG,nCommand)
#DIM nCommand
#DIM enduranceSave, 10
#DIM enduranceSaveMaster, 10
#DIM baseSave, VARSIZE("BASE")
#DIM baseSaveMaster, VARSIZE("BASE")
#DIM expSave, VARSIZE("EXP")
#DIM expSaveMaster, VARSIZE("EXP")
#DIM tequipSave, VARSIZE("TEQUIP")
#DIM tequipSaveMaster, VARSIZE("TEQUIP")
#DIM tcvarSave, VARSIZE("TCVAR")
#DIM tcvarSaveMaster, VARSIZE("TCVAR")
#DIM palamSave, VARSIZE("TCVAR")
#DIM palamSaveMaster, VARSIZE("TCVAR")
#DIM qolDateSave, VARSIZE("Qol_Info_Dates_Array")
#DIM qolDateSaveMaster, VARSIZE("Qol_Info_Dates_Array")
#DIM qolCountSave, VARSIZE("Qol_Info_Count_Array")
#DIM qolCountSaveMaster, VARSIZE("Qol_Info_Count_Array")
#DIM drugStatsSave, VARSIZE("DrugStats")
#DIM drugStatsSaveMaster, VARSIZE("DrugStats")
#DIM stainSave, VARSIZE("STAIN")
#DIM stainSaveMaster, VARSIZE("STAIN")
#DIM tflagSave, VARSIZE("TFLAG")
#DIM commandAfter
#DIM timeSave
#DIMS strSave, 10
#DIMS cstr10Save
#DIMS cstr10SaveMaster
#DIM TF102Save
#DIM TF100Save
#DIM TF230Save
TF100Save = TFLAG:100
TF102Save = TFLAG:102
TF230Save = TFLAG:230

TFLAG:103 = 0
TFLAG:97 = 0
TFLAG:98 = 0
TFLAG:99 = 0
timeSave = TIME
;back up stats
FOR LOCAL, 0, VARSIZE("TCVAR")
    SELECTCASE LOCAL
    CASE 0 TO 6
        ;doesn't exist
        SIF !EnduranceDB(TOSTR(LOCAL))
            GOTO BypassEndure
        enduranceSave:LOCAL       = GETVAR(@"%EC_EXP_VAR%:{ARG}:0")
        enduranceSaveMaster:LOCAL = GETVAR(@"%EC_EXP_VAR%:{MASTER}:0")
    ENDSELECT
    $BypassEndure

    ;Saved strings
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("strSave")-1
        strSave:LOCAL '= STR:LOCAL
    ENDSELECT

    ;EXP
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("EXP")-1
        expSave:LOCAL       = EXP:ARG:LOCAL
        expSaveMaster:LOCAL = EXP:MASTER:LOCAL
    ENDSELECT

    ;BASE
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("BASE")-1
        baseSave:LOCAL      = BASE:ARG:LOCAL
        baseSaveMaster:LOCAL = BASE:MASTER:LOCAL
    ENDSELECT

    ;PALAM
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("PALAM")-1
        palamSave:LOCAL = PALAM:ARG:LOCAL
        palamSaveMaster:LOCAL = PALAM:MASTER:LOCAL
    ENDSELECT

    ;QOL
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("Qol_Info_Dates_Array")-1
        qolDateSave:LOCAL = Qol_Info_Dates_Array:ARG:LOCAL
        qolDateSaveMaster:LOCAL = Qol_Info_Dates_Array:MASTER:LOCAL
    ENDSELECT
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("Qol_Info_Count_Array")-1
        qolCountSave:LOCAL = Qol_Info_Count_Array:ARG:LOCAL
        qolCountSaveMaster:LOCAL = Qol_Info_Count_Array:MASTER:LOCAL
    ENDSELECT

    ;STAIN
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("STAIN")-1
        stainSave:LOCAL = STAIN:ARG:LOCAL
        stainSaveMaster:LOCAL = STAIN:MASTER:LOCAL
    ENDSELECT

    ;DrugStats
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("DrugStats")-1
        drugStatsSave:LOCAL = DrugStats:ARG:LOCAL
        drugStatsSaveMaster:LOCAL = DrugStats:MASTER:LOCAL
    ENDSELECT

    tequipSave:LOCAL       = TEQUIP:ARG:LOCAL
    tequipSaveMaster:LOCAL = TEQUIP:MASTER:LOCAL
    tcvarSave:LOCAL       = TCVAR:ARG:LOCAL
    tcvarSaveMaster:LOCAL = TCVAR:MASTER:LOCAL
    tflagSave:LOCAL       = TFLAG:LOCAL
NEXT
cstr10Save '= CSTR:ARG:10
cstr10SaveMaster '= CSTR:MASTER:10

SKIPDISP 1
SELECTCASE nCommand
CASE IS >= 9000
TRYCALLFORM ADD_CUSTOM_COM{nCommand-9000}
CASEELSE
TRYCALLFORM COM{nCommand}
ENDSELECT
SKIPDISP 0

SOURCE:ARG:(33) = SOURCE:ARG:(33) *  MASTER_FAVOR_CHECK(ARG,33) * TECHNIQUE_CHECK(ARG,33) / 10000
SOURCE:ARG:(33) = SOURCE:ARG:(33) *  MOOD_CHECK(ARG,33) * REASON_CHECK(ARG,33) / 10000
CALL SOURCE_逸脱(ARG)
CALL SOURCE_反感(ARG)
CALL SOURCE_EXTRA(ARG)

;;#;DEBUGPRINTFORML %CALLNAME:ARG% hostility CUP for command {nCommand}: {CUP:ARG:反感}
SELECTCASE CUP:ARG:反感+CUP:ARG:不快
CASE IS >= HateMarkThreshold:5
commandAfter = 4
CASE IS >= HateMarkThreshold:2
commandAfter = 3
CASE IS >= HateMarkThreshold:1
commandAfter = 2
CASEELSE
commandAfter = 0
ENDSELECT

;revert
FOR LOCAL, 0, VARSIZE("TCVAR")
    SELECTCASE LOCAL
    CASE 0 TO 6
        ;doesn't exist
        SIF !EnduranceDB(TOSTR(LOCAL))
            GOTO BypassEndureRev
        enduranceSave:LOCAL = GETVAR(@"%EC_EXP_VAR%:{ARG}:0")
        enduranceSaveMaster:LOCAL = GETVAR(@"%EC_EXP_VAR%:{MASTER}:0")
    ENDSELECT
    $BypassEndureRev

    ;Saved strings
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("strSave")-1
        STR:LOCAL '= strSave:LOCAL
    ENDSELECT

    ;EXP
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("EXP")-1
        EXP:ARG:LOCAL = expSave:LOCAL
        EXP:MASTER:LOCAL = expSaveMaster:LOCAL
    ENDSELECT

    ;BASE
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("BASE")-1
        BASE:ARG:LOCAL    = baseSave:LOCAL
        BASE:MASTER:LOCAL = baseSaveMaster:LOCAL
        DOWNBASE:ARG:LOCAL    = 0
        DOWNBASE:MASTER:LOCAL = 0
    ENDSELECT

    ;PALAM
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("PALAM")-1
        PALAM:ARG:LOCAL = palamSave:LOCAL
        PALAM:MASTER:LOCAL = palamSaveMaster:LOCAL
    ENDSELECT

    ;QOL
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("Qol_Info_Dates_Array")-1
        Qol_Info_Dates_Array:ARG:LOCAL = qolDateSave:LOCAL
        Qol_Info_Dates_Array:MASTER:LOCAL = qolDateSaveMaster:LOCAL
    ENDSELECT
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("Qol_Info_Count_Array")-1
        Qol_Info_Count_Array:ARG:LOCAL = qolCountSave:LOCAL
        Qol_Info_Count_Array:MASTER:LOCAL = qolCountSaveMaster:LOCAL
    ENDSELECT

    ;STAIN
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("STAIN")-1
        STAIN:ARG:LOCAL = stainSave:LOCAL
        STAIN:MASTER:LOCAL = stainSaveMaster:LOCAL
    ENDSELECT

    ;DrugStats
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("DrugStats")-1
        DrugStats:ARG:LOCAL = drugStatsSave:LOCAL
        DrugStats:MASTER:LOCAL = drugStatsSaveMaster:LOCAL
    ENDSELECT

    ;CUP/CDOWN
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("CUP")-1
        CUP:ARG:LOCAL = 0
        CUP:MASTER:LOCAL = 0
        CDOWN:ARG:LOCAL = 0
        CDOWN:MASTER:LOCAL = 0
    ENDSELECT

    ;SOURCE
    SELECTCASE LOCAL
    CASE 0 TO VARSIZE("SOURCE")-1
        SOURCE:ARG:LOCAL = 0
        SOURCE:MASTER:LOCAL = 0
    ENDSELECT


    TEQUIP:ARG:LOCAL = tequipSave:LOCAL
    TEQUIP:MASTER:LOCAL = tequipSaveMaster:LOCAL
    TCVAR:ARG:LOCAL = tcvarSave:LOCAL
    TCVAR:MASTER:LOCAL = tcvarSaveMaster:LOCAL
    TFLAG:LOCAL = tflagSave:LOCAL
NEXT
CSTR:ARG:10 '= cstr10Save
CSTR:MASTER:10 '= cstr10SaveMaster
TIME = timeSave
TFLAG:102 = TF102Save
TFLAG:100 = TF100Save
TFLAG:230 = TF230Save


RETURN commandAfter