;FOR LOCAL, 0, PREGNANT_RECORD_MAX
;	PREGNANT_RECORD_FATHER:C_ID:LOCAL = 0
;	PREGNANT_RECORD_TIMES:C_ID:LOCAL = 0
;NEXT
;TALENT:C_ID:奴隷市場モブ = 0
;TALENT:C_ID:妊娠 = 0
CFLAG:C_ID:出禁 = 0
CSTR:C_ID:99 =
FOR LOCAL, 0, VARSIZE("CFLAG")
;SIF GROUPMATCH(LOCAL, GETNUM(CFLAG, "キャラＩＤ"), GETNUM(CFLAG, "面識"), GETNUM(CFLAG, "好感度"), GETNUM(CFLAG, "従属度"), GETNUM(CFLAG, "依存度"))
;Favor and Trust
SIF GROUPMATCH(LOCAL, GETNUM(CFLAG, "面識"), GETNUM(CFLAG, "好感度"), 4, 2)
	CONTINUE
;Living
SIF GROUPMATCH(LOCAL, GETNUM(CFLAG, "起床時間"), GETNUM(CFLAG, "就寝時間"), GETNUM(CFLAG, "来訪時間"), GETNUM(CFLAG, "帰宅時間"), 311, GETNUM(CFLAG, "神社在住"), GETNUM(CFLAG, "自宅位置"), GETNUM(CFLAG, "よく行く地域"))
	CONTINUE
;Pregnancy
SIF GROUPMATCH(LOCAL, GETNUM(CFLAG, "出産経過日"), GETNUM(CFLAG, "弾幕特能"))
	CONTINUE
;Clothing
SIF INRANGE(LOCAL, 200, 239) || INRANGE(LOCAL, 240,260)
	CONTINUE
CFLAG:C_ID:LOCAL = 0
NEXT
CALLF InitNewHediff(C_ID)
CALLF InitNewHediff(C_ID, 1)
;load hediffs from HTML
DT_TOXML @"Hediff_CC", nHediffXML
nHediffXMLContent '= LOADTEXT(@"dat/chara_%TOSTR_CUSTOM_FILENAME(SLOT_ID, NameChecker(C_ID))%.hediff.xml")
DT_FROMXML @"Hediff_CC", nHediffXML, nHediffXMLContent
CALLF CopyHediffsCC(C_ID, 1)
DT_RELEASE "Hediff_CC"
;load youjutsu loadout
CALLF CreateCombatMagicTable()
CALLF CreateCombatMagicTable(1)
DT_TOXML @"combatMagic_CC", nHediffXML
nHediffXMLContent '= LOADTEXT(@"dat/chara_%TOSTR_CUSTOM_FILENAME(SLOT_ID, NameChecker(C_ID))%.combatMagic.xml")
DT_FROMXML @"combatMagic_CC", nHediffXML, nHediffXMLContent
CALLF CopyCombatMagicCC(C_ID, 1)
DT_RELEASE "combatMagic_CC"
CALL CUSTOM_DATA_VERSIONUP(C_ID)
TALENT:C_ID:CustomChara = 1
TALENT:C_ID:CustomCharaVersion = 0
[IF_DEBUG]
HasClothes:(C_ID) = 1
[ENDIF]
RETURN C_ID
