	sPrint_Text += @"<img src='%GetImageName(Chara)%' height='{iFont_Hei_mag}'"
ENDIF
;Vertical alignment
sPrint_Text += @" ypos='0'>"
;Horizontal alignment
sPrint_Text += @"<shape type='space' param='100'>"
iEnter_Con++ ; TODO: what is this for?
RETURNF sPrint_Text
