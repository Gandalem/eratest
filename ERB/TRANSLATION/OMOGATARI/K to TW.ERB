@GET_EMOTION(ARG:0)
#FUNCTION
#DIM Anger
#DIM Depression
#DIM Fear
#DIM Embarrassment
#DIM CurrMoodVal
#DIM CurrMood
;Main Value + Outer Value
;Anger = (BASE:(ARG:0):怒り*10) - MIN(PALAM:(ARG:0):好意,6000)
;Depression = PALAM:(ARG:0):抑鬱 - MIN(PALAM:(ARG:0):好意,6000)
;Fear = PALAM:(ARG:0):恐怖 + PALAM:(ARG:0):苦痛 - MIN(PALAM:(ARG:0):好意,6000)
Anger = (BASE:(ARG:0):怒り*10) - MIN(BASE:(ARG:0):ムード*4,6000)
Depression = PALAM:(ARG:0):抑鬱 - MIN(BASE:(ARG:0):ムード*4,6000)
Fear = PALAM:(ARG:0):Terror + (BASE:(ARG:0):Agony*2) - MIN(BASE:(ARG:0):ムード*4,6000)
Embarrassment = (PALAM:(ARG:0):恥情/5) - MIN(BASE:(ARG:0):ムード*4,6000)
;Taking highest value
CurrMoodVal = MAX(Anger, Depression, Fear, Embarrassment)
IF IsDead:(ARG:0):0
	CurrMood = 9999
ELSEIF CFLAG:(ARG:0):衰弱 || CFLAG:(ARG:0):睡眠
	CurrMood = 999
	;Under Hypnosis
ELSEIF BASE:(ARG:0):Hypno >= MAXBASE:(ARG:0):Hypno*9/10
	CurrMood = 99
	;Spirit Broken
ELSEIF CharaTrauma:ARG:0 >= 4
	CurrMood = 81
	;Mind Broken
ELSEIF CharaTrauma:ARG:0 >= 3
	CurrMood = 80
ELSEIF CurrMoodVal < 100
	;Euphoric
	IF CurrMoodVal < -5000
		CurrMood = -9
		CFLAG:ARG:不機嫌 = 0
		CFLAG:ARG:ブチギレ = 0
		TALENT:ARG:機嫌 = 1
		;Happy
	ELSEIF CurrMoodVal < -500
		CurrMood = -2
		CFLAG:ARG:不機嫌 = 0
		CFLAG:ARG:ブチギレ = 0
		TALENT:ARG:機嫌 = 1
		;Fine
	ELSEIF CurrMoodVal < -100
		CurrMood = -1
		;Neutral
	ELSE
		CurrMood = 0
	ENDIF
ELSEIF CurrMoodVal == Anger
	;Hate
	IF CurrMoodVal >= 5000
		CurrMood = 19
		CFLAG:ARG:不機嫌 = 1
		CFLAG:ARG:ブチギレ = 1
		TALENT:ARG:機嫌 = -1
		;Rage
	ELSEIF CurrMoodVal >= 500
		CurrMood = 11
		CFLAG:ARG:不機嫌 = 1
		CFLAG:ARG:ブチギレ = 1
		TALENT:ARG:機嫌 = -1
		;Anger
	ELSE
		CurrMood = 10
	ENDIF
ELSEIF CurrMoodVal == Depression
	;Depressed
	IF CurrMoodVal >= 5000
		CurrMood = 29
		;CFLAG:ARG:不機嫌 = 1
		;CFLAG:ARG:ブチギレ = 1
		TALENT:ARG:機嫌 = -1
		;Sad
	ELSEIF CurrMoodVal >= 500
		CurrMood = 21
		;CFLAG:ARG:不機嫌 = 1
		;CFLAG:ARG:ブチギレ = 1
		TALENT:ARG:機嫌 = -1
		;Anxious
	ELSE
		CurrMood = 20
	ENDIF
ELSEIF CurrMoodVal == Embarrassment
	;Mortified
	IF CurrMoodVal >= 8000
		CurrMood = 49
		;CFLAG:ARG:不機嫌 = 1
		;CFLAG:ARG:ブチギレ = 1
		TALENT:ARG:機嫌 = -1
		;Embarrassed
	ELSEIF CurrMoodVal >= 3000
		CurrMood = 41
		;CFLAG:ARG:不機嫌 = 1
		;CFLAG:ARG:ブチギレ = 1
		TALENT:ARG:機嫌 = -1
		;Ashamed
	ELSE
		CurrMood = 40
	ENDIF
ELSE
	;Crazy
	IF CurrMoodVal >= 5000
		CurrMood = 39
		;Fear
	ELSEIF CurrMoodVal >= 500
		CurrMood = 31
		;Nervous
	ELSE
		CurrMood = 30
	ENDIF
ENDIF
RETURNF CurrMood

