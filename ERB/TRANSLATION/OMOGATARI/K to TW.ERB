@IS_BIRTH_CHILD(ARG:0)
#FUNCTION
RETURNF 0
;-------------------------------------------------
;キャラARG:0を削除する関数
;-------------------------------------------------

@DELETE_CHARA(ARG:0,ARG:1=0)
;東方キャラの場合
IF ARG:0 < RANDOM_CHARANUM && !ARG:1
	;削除は禁止。エラーメッセージを出力
	THROW Error: You can't delete a Touhou! (Character num={ARG:0})
	;ランダムキャラ(汎用)の場合
ELSEIF IS_MOB(ARG:0)
	;キャラARG:0より後ろのNOを持つキャラのNOを詰める
	FOR LOCAL:0, 0, CHARANUM
	IF NO:(LOCAL:0) > NO:(ARG:0) && IS_MOB(LOCAL:0)
		NO:(LOCAL:0) --
	ENDIF
	NEXT
	;ランダムキャラのNO割り振り用変数を一つ戻す
	;FLAG:汎用武将カウント --
	;ランダムキャラ(子供)の場合
ELSEIF IS_BIRTH_CHILD(ARG:0)
	;キャラARG:0より後ろのNOを持つキャラのNOを詰める
	FOR LOCAL:0, 0, CHARANUM
	IF NO:(LOCAL:0) > NO:(ARG:0) && IS_BIRTH_CHILD(LOCAL:0)
		NO:(LOCAL:0) --
	ENDIF
	NEXT
	;子供のNO割り振り用変数を一つ戻す
	;FLAG:子供カウント --
	;イベントキャラの場合
ELSE
	;固有の処理は不要
ENDIF
;削除されるキャラが育児されている子供であった場合、その親の育児状態を削除する
;削除されるキャラを初体験とする
;キャラの削除
CALLF ClearAllHediffs(ARG:0, 1)
;move all hediffs
FOR LOCAL, ARG, CHARANUM-1
LOCAL:2 = DT_SELECT("Hediff", @"chara = {LOCAL}",,tempHediffList)
FOR LOCAL:1,0,LOCAL:2
DT_CELL_SET "Hediff", tempHediffList:(LOCAL:2), "chara", LOCAL-1, 1
NEXT
NEXT
DELCHARA ARG:0
FOR LOCAL,0,CHARANUM
FOR LOCAL:1, ARG, CHARANUM-1
RELATION:LOCAL:(LOCAL:1-1) = RELATION:LOCAL:(LOCAL:1)
RELATION:LOCAL:(LOCAL:1) = 0
RELATION:(LOCAL:1-1):LOCAL = RELATION:(LOCAL:1):LOCAL
RELATION:(LOCAL:1):LOCAL = 0
CharaFamily:LOCAL:(LOCAL:1-1) = CharaFamily:LOCAL:(LOCAL:1)
CharaFamily:LOCAL:(LOCAL:1) = 0
CharaFamily:(LOCAL:1-1):LOCAL = CharaFamily:(LOCAL:1):LOCAL
CharaFamily:(LOCAL:1):LOCAL = 0
; CharaFamily:LOCAL:(LOCAL:1+1) = CharaFamily:LOCAL:(LOCAL:1)
; CharaFamily:LOCAL:(LOCAL:1) = 0
; CharaFamily:(LOCAL:1+1):LOCAL = CharaFamily:(LOCAL:1):LOCAL
; CharaFamily:(LOCAL:1):LOCAL = 0
NEXT
NEXT
;REL_LIKE、REL_HATEの修正
;mod ensure the generated images get rotated
FOR LOCAL:0, 0, CHARANUM
CALL モブ子画像リセット(LOCAL:0)
NEXT

