;custom characters

@SETUP_SPECIAL_CHARACTERS()
#DIM 候補, キャラクタ数上限
#DIM 候補数
#DIM 配置先, キャラクタ数上限
#DIM FIRST_LINE
#DIM ページ
VARSET 候補,   -1
VARSET 候補数, 0
VARSET 配置先, -1
VARSET ページ
FOR LOCAL, 0, MAX_CUSTOM_CHARA
SIF !FIND_CHARADATA(TOSTR(LOCAL))
	CONTINUE
CALL LOAD_CUSTOM_DATA(LOCAL)
TALENT:RESULT:CustomChara = 2
候補:候補数 = RESULT
候補数 ++
NEXT
SIF 候補数 == 0
	RETURN 0
FIRST_LINE = LINECOUNT
$SHOW_LOOP
DRAWLINE
PRINTFORML 전이된 캐릭터와 커스텀 캐릭터의 상태를 설정한다.
DRAWLINE
FOR LOCAL, ページ * 20, MIN(ページ * 20 + 20, 候補数)
PRINTFORM [{LOCAL}]%ANAME(候補:LOCAL)% -
IF 配置先:LOCAL == -1
	PRINTFORML  참여하지 않음
ELSEIF 配置先:LOCAL == 0
	PRINTFORML  참가자
ENDIF
NEXT
DRAWLINE
PRINTBUTTON "[이전]", 10000
PRINTFORM {ページ+1}/{候補数 / 20 + 1}
PRINTBUTTON "[다음]", 10001
PRINTL
DRAWLINE
PRINTBUTTON "[일괄 설정]", 10003
PRINTL
DRAWLINE
PRINTBUTTON "[종료]", 10002
INPUT
IF RESULT == 10000
	ページ = ROUND_DECREMENT(ページ, 0, 候補数 / 20)
ELSEIF RESULT == 10001
	ページ = ROUND_INCREMENT(ページ, 0, 候補数 / 20)
ELSEIF RESULT == 10003
	PRINTBUTTON "[참여자]", 0
	PRINTL
	PRINTBUTTON "[참가하지 않음]", -1
	PRINTL
	PRINTBUTTON "[정지]", 99
	INPUT
	IF RESULT == 99
		CLEARLINE LINECOUNT - FIRST_LINE
		GOTO SHOW_LOOP
	ELSEIF GROUPMATCH(RESULT, 0, -1)
		LOCAL:1 = RESULT
		FOR LOCAL, 0, 候補数
		配置先:LOCAL = LOCAL:1
		NEXT
	ENDIF
	CLEARLINE LINECOUNT - FIRST_LINE
	GOTO SHOW_LOOP
ELSEIF RESULT == 10002
	FOR LOCAL, 候補数 - 1, -1,  -1
	IF 配置先:LOCAL == -1
		CALL DELETE_CHARA(候補:LOCAL)
	ENDIF
	NEXT
	RETURN
ENDIF
IF INRANGE(RESULT, 0, 候補数)
	LOCAL:1 = RESULT
	PRINTBUTTON "[참가자]", 0
	PRINTL
	PRINTBUTTON "[참여하지 않음]", -1
	PRINTL
	INPUT
	IF GROUPMATCH(RESULT, 0, -1)
		配置先:(LOCAL:1) = RESULT
	ENDIF
ENDIF
CLEARLINE LINECOUNT - FIRST_LINE
GOTO SHOW_LOOP
