@GENERATE_PORTRAIT(Chara, pType = 0, iSize=800)
#FUNCTIONS
#DIM Chara
#DIM pType
#DIM iSize
#DIM iEnter_Con ; Not in use?
#DIM iID
#DIM iFont_Hei_mag
#DIMS sPrint_Text
;Abort the mission if config is disabled
;SIF !CONFIG:555
;	RETURN
;JVN: We keep ARG while still having iID
iID = NO:Chara
