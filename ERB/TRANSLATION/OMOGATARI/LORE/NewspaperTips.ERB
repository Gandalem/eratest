@NEWSPAPER_2_INFO
#FUNCTIONS
NEWSPAPER_AD_NAME '= "Foraging Sales"
NEWSPAPER_AD_TYPE '= "Tip"
NEWSPAPER_AD_CANDO = 1

@NEWSPAPER_2
#DIM nItem

CALL FISHER_YATES_SHAFFLE(999)
FOR LOCAL ,0, 999
	nItem = SHAFFLE_ARRAY:(LOCAL)
	SELECTCASE nItem
		 CASE 601, 603 TO 609, 612 TO 615, 617 TO 620, 622 TO 625, 632 TO 635, 637, 640 TO 643, 646
			SIF ITEMNAME:nItem != ""
				BREAK
	ENDSELECT
NEXT

RESETCOLOR
PRINTFORML ───────────────────────────────
FONTBOLD
PRINTDATAL
	DATAFORM  %PLURALIZER(ITEMNAME_TR(nItem))% needed!
ENDDATA
FONTREGULAR
PRINTFORML ───────────────────────────────
SETFONT "ＭＳ Ｐゴシック"
FONTITALIC
PRINTFORML	We are willing to pay \\{(ITEMPRICE:(nItem) / 2)} per item with no sales cap!
PRINTFORML - %NAME:72%
FONTREGULAR
SETFONT
PRINTFORML ───────────────────────────────
RETURN 1