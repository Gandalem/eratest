@NEWSPAPER_1_INFO
#FUNCTIONS
NEWSPAPER_AD_NAME '= "Alignment Fix"
NEWSPAPER_AD_TYPE '= "Tip"
NEWSPAPER_AD_CANDO = 1

@NEWSPAPER_1
RESETCOLOR
PRINTFORML ───────────────────────────────
FONTBOLD
PRINTDATAL
	DATAFORM  In TW or any other game, if you have fucked up alignment on maps and etc:
ENDDATA
FONTREGULAR
PRINTFORML ───────────────────────────────
SETFONT "ＭＳ Ｐゴシック"
FONTITALIC
PRINTFORML	%BREAKENG("1) Check in Emuera settings (not game's!) on display tab if your Drawing Interface is textRenderer")%
