@PLAY_BATTLE_MUSIC(TARGET)
#FUNCTION

SIF !TARGET
	RETURNF RandomSong()

COUNT = EXEC_SCORES(楽譜処理モード：キャラ関連シリーズを全取得, TARGET)
FOR LOCAL, 0, COUNT
	RESULT = EXEC_SCORES(99999, TARGET, RESULT:LOCAL)
	IF RESULT != -1
		SIF PlayingBGM == RESULT
			RETURNF RESULT

		PlayingBGM = RESULT
        PLAYBGM @"music/score/{RESULT}.m4a"
		RETURNF RESULT
    ENDIF
NEXT

RETURNF RandomSong()


@RandomSong
#FUNCTION
;any bgm overrides this
SIF PlayingBGM
	RETURNF PlayingBGM

CALLF FISHER_YATES_SHUFFLE_F(999)
FOR LOCAL:3, 0, 2000
	LOCAL:4 = SHAFFLE_ARRAY:(LOCAL:3)
	LOCAL:5 = SHAFFLE_ARRAY:(LOCAL:3+1)
	LOCAL:6 = (LOCAL:4)+(LOCAL:5)+10000
	IF STR_TR(LOCAL:6) != ""
		SIF ENUMFILES(@"sound/music/score/{LOCAL:6}.m4a") == -1
			CONTINUE
		SIF PlayingBGM == LOCAL:6
			RETURNF LOCAL:6

		PlayingBGM = LOCAL:6
		PLAYBGM @"music/score/{LOCAL:6}.m4a"
		RETURNF LOCAL:6
	ENDIF
NEXT

