RETURNF SPRITEWIDTH(spriteName) * VNConfig:GIUiSize * sizeRatio/100

@VNTextPrint()
	#DIM index
	#DIMS char
	#DIMS colorList, 999
	;获取颜色list
	SPLIT VNGalTextColor, "_", colorList
	FOR index, 0, STRLENSU(VNGalText)
		char '= SUBSTRINGU(VNGalText, index, 1)
		;设置颜色
		SETCOLOR TOINT(colorList:index)
		PRINTS char
	NEXT

@VNTextInput
	#DIM index
	FOR index, 0, VARSIZE("VNGalChoiceList")
		IF VNGalChoiceList:index != ""
			PRINTFORML [{index,2}] %VNGalChoiceList:index%
		ELSE
			BREAK
		ENDIF
	NEXT
	WHILE 1
		INPUT
		IF RESULT >= 0 && RESULT < VARSIZE("VNGalChoiceList") && VNGalChoiceList:RESULT != ""
			RETURN RESULT
		ELSE
			PRINTW Invalid Input
			CLEARLINE 2
		ENDIF
	WEND

