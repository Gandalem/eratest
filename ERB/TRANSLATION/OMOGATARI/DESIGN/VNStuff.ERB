;绘制ui
@VNGalIDrawUi()
	#DIM index
	#DIM tmpH
	#DIM tmpW
	#DIM DYNAMIC line
	#DIM DYNAMIC textLong
	#DIMS char
	#DIMS colorList, 999
	;创建桌面
	GDISPOSE VNGid:2
	GCREATE VNGid:2, VNConfig:GIWidth + VNConfig:GILeft, VNConfig:GIBottle + VNConfig:GIHeight
	;背景
	GDISPOSE VNGid:20
	GCREATE VNGid:20, VNConfig:GIWidth - 14 * VNConfig:GIUiSize, VNConfig:GIHeight - 14 * VNConfig:GIUiSize
	GCLEAR VNGid:20, 0xff7b0000
	{
	GDRAWG VNGid:2, VNGid:20,
	VNConfig:GILeft + 7 * VNConfig:GIUiSize,
	7 * VNConfig:GIUiSize,
	VNConfig:GIWidth - 14 * VNConfig:GIUiSize,
	VNConfig:GIHeight - 14 * VNConfig:GIUiSize,
	0,
	0,
	VNConfig:GIWidth - 14 * VNConfig:GIUiSize,
	VNConfig:GIHeight - 14 * VNConfig:GIUiSize
	}
	
	;框
	GDRAWSPRITE VNGid:2, "flan左上角", VNConfig:GILeft, 0, 14 * VNConfig:GIUiSize, 14 * VNConfig:GIUiSize
	GDRAWSPRITE VNGid:2, "flan右上角", VNConfig:GIWidth + VNConfig:GILeft - 14 * VNConfig:GIUiSize, 0, 14 * VNConfig:GIUiSize, 14 * VNConfig:GIUiSize
	GDRAWSPRITE VNGid:2, "flan左下角", VNConfig:GILeft, 0 + VNConfig:GIHeight - 14 * VNConfig:GIUiSize, 14 * VNConfig:GIUiSize, 14 * VNConfig:GIUiSize
	GDRAWSPRITE VNGid:2, "flan右下角", VNConfig:GIWidth + VNConfig:GILeft - 14 * VNConfig:GIUiSize, 0 + VNConfig:GIHeight - 14 * VNConfig:GIUiSize, 14 * VNConfig:GIUiSize, 14 * VNConfig:GIUiSize
	;横框
	GDRAWSPRITE VNGid:2, "flan横框", VNConfig:GILeft + 14 * VNConfig:GIUiSize, 6 * VNConfig:GIUiSize, VNConfig:GIWidth - 28 * VNConfig:GIUiSize, VNSpriteH("flan横框")
	GDRAWSPRITE VNGid:2, "flan横框", VNConfig:GILeft + 14 * VNConfig:GIUiSize, VNConfig:GIHeight - 8 * VNConfig:GIUiSize, VNConfig:GIWidth - 28 * VNConfig:GIUiSize, VNSpriteH("flan横框")
	;竖框
	GDRAWSPRITE VNGid:2, "flan竖框", VNConfig:GILeft + 6 * VNConfig:GIUiSize, 14 * VNConfig:GIUiSize, VNSpriteW("flan竖框"), VNConfig:GIHeight - 28 * VNConfig:GIUiSize
	GDRAWSPRITE VNGid:2, "flan竖框", VNConfig:GILeft + VNConfig:GIWidth - 8 * VNConfig:GIUiSize, 14 * VNConfig:GIUiSize, VNSpriteW("flan竖框"), VNConfig:GIHeight - 28 * VNConfig:GIUiSize
	;LED
	GDRAWSPRITE VNGid:2, "flan水晶", VNConfig:GILeft + VNConfig:GIWidth - (14 + SPRITEWIDTH("flan水晶")) * VNConfig:GIUiSize, 0, SPRITEWIDTH("flan水晶") * VNConfig:GIUiSize, SPRITEHEIGHT("flan水晶") * VNConfig:GIUiSize
	;名字
	IF VNGCharaName() != ""
		GSETFONT VNGid:2, GETFONT(), VNConfig:GINameSize
		GDRAWTEXT VNGid:2, VNGCharaName(), VNConfig:GINameX + VNConfig:GILeft, VNConfig:GINameY
	ENDIF
	;文本
	;设置字体
	GSETFONT VNGid:2, GETFONT(), VNConfig:GITextSize
	;获取颜色list
	SPLIT VNGalTextColor, "_", colorList
	FOR index, 0, STRLENSU(VNGalText)
		char '= SUBSTRINGU(VNGalText, index, 1)
		;换行
		IF char == "\n" || textLong * VNConfig:GITextSize / 2 >= VNConfig:GITextLong
			textLong = 0
			line ++
			;主动换行
			SIF char == "\n"
				CONTINUE
		ENDIF
		;设置颜色
		GSETPEN VNGid:2, 0xff000000 + TOINT(colorList:index), 0
		GDRAWTEXT VNGid:2, char, VNConfig:GITextX + VNConfig:GILeft + textLong * VNConfig:GITextSize / 2, VNConfig:GITextY + line * VNConfig:GITextHeight
		;长度记录
		textLong += STRLENS(char)
	NEXT
	;输出
	CBGSETG VNGid:2, 0, 0, -10


;打印一堆点
@VNGSleep
	CALL PRINT_GP("L", "...\n......\n.........")

@VNGWait
	CALL PRINT_GP("W", "")

;仿gal打印
@PRINT_GP(mod, text, color = -1)
	#DIMS mod
	#DIMS text
	#DIM color
	;说话者是旁白
	VNGalChara = -9999
	SIF color == -1
		color = GETDEFCOLOR()
	CALL VNPrintMain, mod, text, color

;角色打印
;chara正值/0为登录番号
@PRINT_GPC, mod, text, chara, color=0
	#DIMS mod
	#DIMS text
	#DIM chara
	#DIM charaNo
	#DIM DYNAMIC color
	;记录说话者
	VNGalChara = chara
	charaNo = ABS(chara)
	IF !color
		CALL SET_KOJO_COLOR(chara)
		color = GETCOLOR()
		RESETCOLOR
	ENDIF
	CALL VNPrintMain, mod, text, color

@VNPrintMain, mod, text, color
	#DIMS mod
	#DIMS text
	#DIM color
	#DIM printMod
	SELECTCASE mod
		CASE "SL"
			printMod = 0
		CASE "L"
			printMod = 1
		CASE "W"
			printMod = 2
		CASEELSE
			THROW [VNStuff ERROR] Unknown printing type
	ENDSELECT
	CALL VNGPrint(text, color, printMod, nVNGlobals:hearts, nVNGlobals:printFlsuhTime, nVNGlobals:printFlushAdd)

;对话打印
@VNGPrint(text, color, mod, printHeart = 1, flushTime = 15, addStep = 2)
	#DIM color
	#DIMS text
	#DIMS printText
	#DIM mod	;0NULL 1L 2W
	#DIM printHeart ;决定是否会打印彩色的心
	#DIM DYNAMIC step
	#DIM DYNAMIC spearLine
	#DIM DYNAMIC skip
	#DIM line
	#DIM index
	#DIMS char
	#DIM flushTime
	#DIM addStep
	#DIM DYNAMIC flushTimes ;刷新次数
	#DIM bgColor;背景颜色
	;非彩色模式
	SIF TARGET != -1  && !FLAG:口上色
		color = GETDEFCOLOR()

	;仿GAL交互
	IF nVNGlobals:drawing == 1
		bgColor = 0x7b0000
	ELSE
		bgColor = GETBGCOLOR()
	ENDIF

	;记录行数
	line = LINECOUNT
	;判断是否为通用对话
	IF (SUBSTRING(text, 0, 1) == "「" && SUBSTRING(text, STRLENS(text) - 2, 1) == "」")
		printText '= SUBSTRING(text, 2, STRLENS(text) - 4)
		spearLine = 1
	ELSE
		printText '= text
	ENDIF
	WHILE 1
		VNGalText '= ""
		VNGalTextColor '= ""
		;禁用动画
		IF TARGET != -1
		SIF !VN_cartoon_play() || skip || !nVNGlobals:wordPrint
			step = STRLENSU(printText) + 2
		ELSE
		SIF !VN_cartoon_play() || skip
			step = STRLENSU(printText) + 2
		ENDIF
		VNGalTextColor += @"%TOSTR(color)%_"
		SIF spearLine
			VNGalText += "「"
		
		;动画
		FOR index, 0, MIN(STRLENSU(printText), step)
			char '= SUBSTRINGU(printText, index, 1)
			IF char == "♥" && printHeart
				VNGalTextColor += @"%TOSTR(color_mix(HeartColor, MIN(255, 128 * (step - index)), bgColor, 255 - MIN(255, 128 * (step - index))))%_"
			ELSE
				VNGalTextColor += @"%TOSTR(color_mix(color, MIN(255, 128 * (step - index)), bgColor, 255 - MIN(255, 128 * (step - index))))%_"
			ENDIF
			VNGalText += char
		NEXT
		VNGalTextColor += @"%TOSTR(color)%_"
		SIF spearLine
			VNGalText += "」"

		;刷新立绘
		;最后一句
		IF step >= STRLENSU(printText) + 3
			VNCartoonFlow = -1
		;正常
		ELSE
			VNCartoonFlow ++
		ENDIF

		;显示
		CALL VNPrintShow()
		;增加步长
		step += addStep
		SIF step >= STRLENSU(printText) + 3
			BREAK
		
		flushTimes ++
		INPUTMOUSEKEY flushTime
		SELECTCASE RESULT
			;鼠标按下
			CASE 1
				skip = 1
			;键盘按下
			CASE 3
				skip = 1
		ENDSELECT
		CLEARLINE LINECOUNT - line
		CBGCLEAR
	WEND
	RESETCOLOR
	;打印模式处理
	SELECTCASE mod
		CASE 0
		CASE 1
			TWAIT 1000, 0
		CASE 2
			WAIT
			SIF !MESSKIP()
			PLAYSOUND "se/キー音.m4a"
		CASEELSE
			THROW [芙兰口上ERROR]错误的打印模式(mod = {mod})
	ENDSELECT
	CLEARLINE LINECOUNT - line
	CBGCLEAR
	;打印历史信息
	SETCOLOR color
	PRINTSL text
	RESETCOLOR

@ASK_GSetQ(question:0, question:1, question:2, question:3, question:4, question:5, question:6, question:7, question:8, question:9)
	#DIMS question, VARSIZE("VNGalChoiceList")
	#DIM index
	FOR index, 0, VARSIZE("VNGalChoiceList")
		VNGalChoiceList:index '= question:index
	NEXT

@ASK_GSetQR(questionList)
	#DIMS REF questionList
	#DIM arrSize
	#DIM index
	arrSize = VARSIZE("questionList")
	FOR index, 0, VARSIZE("VNGalChoiceList")
		;超范围
		IF index >= arrSize
			VNGalChoiceList:index '= ""
		;正常
		ELSE
			VNGalChoiceList:index '= questionList:index
		ENDIF
	NEXT

@ASK_GInput()
	#DIM line
	#DIM out
	#DIM height
	line = LINECOUNT
	SELECTCASE nVNGlobals:drawing
		;Era
		CASE 0
			CALL VNTextInput()
		;GAL
		CASE 1
			CALL VNGalIInput()
		CASEELSE
			THROW [VNStuff ERROR] Invalid printing mode (nVNGlobals:drawing = {nVNGlobals:drawing})
	ENDSELECT
	out = RESULT
	PLAYSOUND "se/キー音.m4a"
	CLEARLINE LINECOUNT - line
	CBGCLEAR
	RETURN out

;-------------------------------------------
;标准打印函数
;-------------------------------------------
@VNP(mod, text, color = -1, autoCharaColor = 1)
	#DIMS mod
	#DIMS text
	#DIM color
	#DIM autoCharaColor	;自动角色颜色分析
	#DIM charaNo
	;未知的打印模式
	SIF !GROUPMATCH(mod, "", "S", "L", "W")
		THROW [VNStuff ERROR] Unknown print mode
	;禁用颜色/默认值
	IF !FLAG:口上色 || color == -1
		color = GETDEFCOLOR()
	;自动角色颜色分析
	ELSEIF autoCharaColor
		;登录番号
		IF color >= 0 && color < CHARANUM
			CALL SET_KOJO_COLOR(color)
			color = GETCOLOR()
			RESETCOLOR
		; ;NO编号
		; ELSEIF color >= -6000 && color <= -1000
		; 	charaNo = -color
		; 	color = VNGetCharaColor(charaNo)
		ENDIF
	ENDIF
	SETCOLOR color
	IF mod == "S"
		PRINTSINGLES text
	ELSE
		PRINTS text
	ENDIF
	RESETCOLOR
	SELECTCASE mod
		CASE "L"
			PRINTL
		CASE "W"
			WAIT
	ENDSELECT

