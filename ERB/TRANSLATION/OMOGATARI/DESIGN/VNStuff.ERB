@VNGalIDraw()
	#DIM inited
	#DIM index
	IF !inited
		;参数自动设定
		LOADGLOBAL
		SIF !nVNGlobals:drawing && !nVNGlobals:wordPrint && !nVNGlobals:hearts && !nVNGlobals:printFlsuhTime && !nVNGlobals:printFlushAdd
			CALLF VNGlobalConfigInit
		SAVEGLOBAL
		;SIF VNConfig:GIAutoSetting
			CALL VNGalIConfigInit()
		FOR index, 0, VARSIZE("VNGid")
			VNGid:index = VNApplyGid()
		NEXT
		inited = 1
	ENDIF
	;清空
	CBGCLEAR
	;背景
	CALL VNGalIBG()
	;chara
	CALL VNGalIDrawChara()
	;ui
	CALL VNGalIDrawUi()

;绘制背景
@VNGalIBG
	GDISPOSE VNGid:9
	GCREATE VNGid:9, MAX(CLIENTWIDTH(),1), MAX(CLIENTHEIGHT(),1)
	GCLEAR VNGid:9, 0xff000000 + GETBGCOLOR()
	CBGSETG VNGid:9, 0, 0, -1
;GalImageinput
@VNGalIInput
	#DIM choice
	WHILE 1
		CBGCLEAR
		;绘制问题
		CALL VNGalIDraw()
		CALL VNGalIDrawButton()
		;绘制按钮
		INPUTMOUSEKEY 15
		IF RESULT == 1 && RESULT:1 == 0x100000
			choice = VNGalIChoiceButton()
			SIF choice != -1
				RETURN choice
		ENDIF
	WEND

;画按钮
@VNGalIDrawButton(initFlag = 0)
	#DIM startX
	#DIM startY
	#DIM nowX
	#DIM nowY
	#DIM nameMax
	#DIM index
	#DIM initFlag
	#DIM darkPoint, VARSIZE("VNGalChoiceList")
	#DIM buttonHeight
	#DIM width
	#DIM height
	#DIM fontWidth
	#DIM fontHeight
	#DIM mousePosX
	#DIM mousePosY
	#DIM choice
	#DIM sizeRatio
	;初始化
	IF initFlag
		VARSET darkPoint, 150
	ENDIF
	;统计按钮信息
	FOR nameMax, 0, VARSIZE("VNGalChoiceList")
		SIF VNGalChoiceList:nameMax == ""
			BREAK
	NEXT
	nameMax --
	SIF nameMax == 0
		THROW [芙兰口上ERROR]未设置按钮列表
	buttonHeight = SPRITEHEIGHT("flan按钮左") * VNConfig:GIUiSize
	;计算中心位置
	width = CLIENTWIDTH() / 2
	height = CLIENTHEIGHT() *13/32
	sizeRatio = 100

	;Custom code
	;Allow for more buttons, resize if needed
	IF buttonHeight*nameMax > HEIGHT
		sizeRatio = (height*100/(buttonHeight*nameMax))
		buttonHeight = MAX(1,buttonHeight * (sizeRatio)/100)
	ENDIF
	;====================
	;创建桌面
	GDISPOSE VNGid:0
	GCREATE VNGid:0, width + VNConfig:GIButtonWidth / 2, height + (buttonHeight * nameMax + VNConfig:GIButtonSpace * (nameMax - 1) / 2)
	;按钮亮度处理
	mousePosX = MOUSEX()
	mousePosY = height + (buttonHeight * nameMax + VNConfig:GIButtonSpace * (nameMax - 1) / 2) + MOUSEY()
	choice = VNGalIChoiceButton()
	FOR index, 0, nameMax
		IF choice == index
			darkPoint:index -= 50
			SIF darkPoint:index < 0
				darkPoint:index = 0
		ELSE
			darkPoint:index += 20
			SIF darkPoint:index > 150
				darkPoint:index = 150
		ENDIF
	NEXT
	FOR index, 0, nameMax
		;底
		;创建桌面
		GDISPOSE VNGid:20
		GCREATE VNGid:20, VNConfig:GIButtonWidth - VNSpriteW("flan按钮左") - VNSpriteW("flan按钮右"), buttonHeight
		GCLEAR VNGid:20, 0xff7b0000
		GDRAWG VNGid:0, VNGid:20, width - VNConfig:GIButtonWidth / 2 + VNSpriteW("flan按钮右"), 0 + (buttonHeight + VNConfig:GIButtonSpace) * index, VNConfig:GIButtonWidth - VNSpriteW("flan按钮左") - VNSpriteW("flan按钮右"), buttonHeight, 0, 0, VNConfig:GIButtonWidth - VNSpriteW("flan按钮左") - VNSpriteW("flan按钮右"), buttonHeight
		;两边
		GDRAWSPRITE VNGid:0, "flan按钮左", width - VNConfig:GIButtonWidth / 2, 0 + (buttonHeight + VNConfig:GIButtonSpace) * index, VNSpriteW("flan按钮左"), VNSpriteH("flan按钮左", sizeRatio)
		GDRAWSPRITE VNGid:0, "flan按钮右", width + VNConfig:GIButtonWidth / 2 - VNSpriteW("flan按钮右"), 0 + (buttonHeight + VNConfig:GIButtonSpace) * index, VNSpriteW("flan按钮右"), VNSpriteH("flan按钮右", sizeRatio)
		;水晶
		GDRAWSPRITE VNGid:0, @"flan水晶{index * 2}", width - VNConfig:GIButtonWidth / 2, (12*sizeRatio/100) * VNConfig:GIUiSize + (buttonHeight + VNConfig:GIButtonSpace) * index, VNSpriteW(@"flan水晶{index * 2}"), VNSpriteH(@"flan水晶{index * 2}", sizeRatio)
		GDRAWSPRITE VNGid:0, @"flan水晶{index * 2 + 1}", width + VNConfig:GIButtonWidth / 2 - VNSpriteW("flan按钮右") + 3 * VNConfig:GIUiSize, (12*sizeRatio/100) * VNConfig:GIUiSize + (buttonHeight + VNConfig:GIButtonSpace) * index, VNSpriteW(@"flan水晶{index * 2}"), VNSpriteH(@"flan水晶{index * 2}", sizeRatio)
		;阴影
		;左
		GDISPOSE VNGid:20
		GDISPOSE VNGid:21
		GDISPOSE VNGid:22
		GCREATE VNGid:20, VNSpriteW("flan水晶阴影左"), VNSpriteH("flan水晶阴影左", sizeRatio)
		GDRAWSPRITE VNGid:20, "flan水晶阴影左", 0, 0, VNSpriteW("flan水晶阴影左"), VNSpriteH("flan水晶阴影左", sizeRatio)
		GCREATE VNGid:21, VNSpriteW("flan水晶阴影左"), VNSpriteH("flan水晶阴影左", sizeRatio)
		GCREATE VNGid:22, VNSpriteW("flan水晶阴影左"), VNSpriteH("flan水晶阴影左", sizeRatio)
		GCLEAR VNGid:21, 0xffffff00 + darkPoint:index
		GDRAWGWITHMASK VNGid:22, VNGid:20, VNGid:21, 0, 0
		GDRAWG VNGid:0, VNGid:22, width - VNConfig:GIButtonWidth / 2, (12*sizeRatio/100) * VNConfig:GIUiSize + (buttonHeight + VNConfig:GIButtonSpace) * index, VNSpriteW("flan水晶阴影左"), VNSpriteH("flan水晶阴影左", sizeRatio), 0, 0, VNSpriteW("flan水晶阴影左"), VNSpriteH("flan水晶阴影左", sizeRatio)
		;右
		GDISPOSE VNGid:20
		GDISPOSE VNGid:21
		GDISPOSE VNGid:22
		GCREATE VNGid:20, VNSpriteW("flan水晶阴影右"), VNSpriteH("flan水晶阴影右", sizeRatio)
		GDRAWSPRITE VNGid:20, "flan水晶阴影右", 0, 0, VNSpriteW("flan水晶阴影右"), VNSpriteH("flan水晶阴影右", sizeRatio)
		GCREATE VNGid:21, VNSpriteW("flan水晶阴影右"), VNSpriteH("flan水晶阴影右", sizeRatio)
		GCREATE VNGid:22, VNSpriteW("flan水晶阴影右"), VNSpriteH("flan水晶阴影右", sizeRatio)
		GCLEAR VNGid:21, 0xffffff00 + darkPoint:index
		GDRAWGWITHMASK VNGid:22, VNGid:20, VNGid:21, 0, 0
		GDRAWG VNGid:0, VNGid:22, width + VNConfig:GIButtonWidth / 2 - VNSpriteW("flan按钮右") + 3 * VNConfig:GIUiSize, (12*sizeRatio/100) * VNConfig:GIUiSize + (buttonHeight + VNConfig:GIButtonSpace) * index, VNSpriteW("flan水晶阴影右"), VNSpriteH("flan水晶阴影右", sizeRatio), 0, 0, VNSpriteW("flan水晶阴影左"), VNSpriteH("flan水晶阴影左", sizeRatio)
		;框
		GDRAWSPRITE VNGid:0, "flan横框", width - VNConfig:GIButtonWidth / 2 + VNSpriteW("flan按钮右"), 0 + (buttonHeight + VNConfig:GIButtonSpace) * index, VNConfig:GIButtonWidth - VNSpriteW("flan按钮左") - VNSpriteW("flan按钮右"), VNSpriteH("flan横框", sizeRatio)
		GDRAWSPRITE VNGid:0, "flan横框", width - VNConfig:GIButtonWidth / 2 + VNSpriteW("flan按钮右"), 0 + (buttonHeight + VNConfig:GIButtonSpace) * index + buttonHeight - VNSpriteH("flan横框", sizeRatio), VNConfig:GIButtonWidth - VNSpriteW("flan按钮左") - VNSpriteW("flan按钮右"), VNSpriteH("flan横框", sizeRatio)
		;字
		GSETFONT VNGid:0, GETFONT(), VNConfig:GIButtonTextSize
		GSETPEN VNGid:0, 0xff000000 + color_mix(GETDEFCOLOR(), darkPoint:index, GETFOCUSCOLOR(), 150 - darkPoint:index), 0
		GGETTEXTSIZE VNGalChoiceList:index, GGETFONT(VNGid:0), VNConfig:GIButtonTextSize
		fontWidth = RESULT:0
		fontHeight = RESULT:1
		GDRAWTEXT VNGid:0, VNGalChoiceList:index, width - fontWidth / 2,  buttonHeight / 2 + (buttonHeight + VNConfig:GIButtonSpace) * index - fontHeight / 2

	NEXT
	CBGSETG VNGid:0, 0, 0, -11

;获取鼠标位置
@VNGalIChoiceButton()
	#FUNCTION
	#DIM nameMax
	#DIM width
	#DIM height
	#DIM mousePosX
	#DIM mousePosY
	#DIM index
	#DIM buttonHeight
	#DIM sizeRatio
	;统计按钮信息
	FOR nameMax, 0, VARSIZE("VNGalChoiceList")
		SIF VNGalChoiceList:nameMax == ""
			BREAK
	NEXT
	nameMax --
	SIF nameMax == 0
		THROW [VNStuff ERROR] 未设置按钮列表
	buttonHeight = SPRITEHEIGHT("flan按钮左") * VNConfig:GIUiSize
	;计算中心位置
	width = CLIENTWIDTH() / 2
	height = CLIENTHEIGHT() *13/32
	;Custom code
	;Allow for more buttons, resize if needed
	IF buttonHeight*nameMax > HEIGHT
		sizeRatio = (height*100/(buttonHeight*nameMax))
		buttonHeight = buttonHeight * (sizeRatio)/100
	ENDIF
	;====================
	;鼠标坐标
	mousePosX = MOUSEX()
	mousePosY = height + (buttonHeight * nameMax + VNConfig:GIButtonSpace * (nameMax - 1) / 2) + MOUSEY()
	FOR index, 0, nameMax
		{
		SIF (mousePosX >= width - VNConfig:GIButtonWidth / 2 && mousePosX <= width + VNConfig:GIButtonWidth / 2) &&
			(mousePosY >= (buttonHeight + VNConfig:GIButtonSpace) * index) && mousePosY <= (buttonHeight + VNConfig:GIButtonSpace) * index + buttonHeight
		}
			RETURNF index
	NEXT
	RETURNF -1

