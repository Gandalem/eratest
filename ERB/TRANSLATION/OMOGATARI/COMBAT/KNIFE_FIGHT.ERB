		RETURNF 91
ENDSELECT

@ExplosionSizeTohuous(ARG)
#FUNCTION
SELECTCASE ARG
	CASE 0
		RETURNF 0
	CASE 1, 2, 3
		RETURNF 1
	CASE 4
		;up to 3 touhous
		RETURNF 3
	CASE 5
		;up to 6 touhous
		RETURNF 6
	CASE 6
		;up to 10 touhous
		RETURNF 10
	CASE 7
		;up to 25 touhous
		RETURNF 25
	CASE 8
		RETURNF 999
ENDSELECT
