				PRINTFORMW %CALLNAME:WINNER%은 %CALLNAME:LOSER%의 요구 따위는 신경 쓰지 않고 어쨌든 %HIM_HER(LOSER)%를 폭력적으로 강간하기 시작한다...
			ELSE
				PRINTFORMW %CALLNAME:WINNER%는 물러나서 %HIM_HER(LOSER)%를 혼자 두었다...
				PRINTFORMW %CALLNAME:LOSER%는 안도한다...
				RETURN -1
			ENDIF
			PRINTL
		ENDIF
		CALL Add_LOST_GYAKURE_EX(WINNER, 1,LOSER) ;addition custom code
		SIF RESULT
			GOTO GYAKURE_END
		;------------------------------
		PRINTFORMW 광경을 바라보며, %PARSE("you're")%은 환하게 웃는 %CALLNAME:WINNER%와 만났고, 그녀의 보지는 %CALLNAME:LOSER%의 %TINKO(LOSER)%를 밑으로 삼았다.
		PRINTFORMW %HIS_HER(WINNER)%의 절정에 흥분한 %CALLNAME:WINNER%는 갈증을 해소하기 위해 %CALLNAME:LOSER%를 난도질하고, 고문하며, 범한다...
		PRINTFORMW .........
		PRINTFORMW ......
		PRINTFORMW ...
		PRINTFORMW %CALLNAME:WINNER% 그녀는 만족할 때까지 계속해서 %CALLNAME:LOSER%를 탐닉한 후, 그저 지쳐 탈진한 채 바닥에 %HIM_HER(LOSER)%을 내버려 두고 떠난다.
	ENDIF
	$GYAKURE_END
	;FLAG:気絶中断 = 100 + CFLAG:MASTER:現在位置 / 100
	;CFLAG:MASTER:デート中 = CFLAG:MASTER:現在位置 / 100
	SIF InTrain == 1
		CALL LOST_GYAKURE_NAS(WINNER,LOSER)
ELSEIF LOSER == MASTER && !SaveIsEZB
	$GoBack
	SELECTCASE RAND:3
		CASE 0
			IF ITEM:LOOT && LOSER == MASTER
				PRINTFORMW %PARSE("You lose")% %ARTICLE(ITEMNAME_TR(LOOT))%...
				ITEM:LOOT --
			ELSE
				GOTO GoBack
			ENDIF
		CASE 1
			IF MONEY:2 >= REWARD && LOSER == MASTER
				PRINTFORMW %PARSE("You lose")% %DIGIT_GROUP(REWARD)% 카리스마...
				MONEY:2 -= REWARD
			ELSE
				GOTO GoBack
			ENDIF
		CASE 2
			REWARD *= 300
			PRINTFORMW %PARSE("You lose")% \@ MONEY > REWARD ? %金額表示(REWARD)% # 모든 돈 %PARSE("you have",1)% \@...
			MONEY = MAX(MONEY - REWARD, 0)
		CASE 3
			IF EQUIP:MASTER:Weapon && LOSER == MASTER
				PRINTFORMW %PARSE("You lose")% 너의 %PrintWeaponName(MASTER,EQUIP:MASTER:Weapon,-1)%...
				DT_ROW_REMOVE "WeaponInventory", CharaWeaponInts:MASTER:WeaponInventory
				CALLF EQUIPWEAPON(MASTER,0)
			ELSE
				GOTO GoBack
			ENDIF
	ENDSELECT
ENDIF

