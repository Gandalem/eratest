@AI_GET_TARGET(ARG, nSide)
#FUNCTION
#DIM SUBJECT_WEIGHTS, キャラクタ数上限 ;potential targets and their weights
#DIM  RANK       ;評価ランク、数が小さいほど優秀
#DIM  RANK_NUM   ;評価尺度に含まれる評価の種数
#DIM nSide
;remove inaccessible characters from the list
FOR LOCAL, 0, CHARANUM
SUBJECT_WEIGHTS:LOCAL = 1
IF CFLAG:LOCAL:出禁 || IsDead:LOCAL:0
	;banned or dead
	SUBJECT_WEIGHTS:LOCAL = 0
	CONTINUE
ELSEIF IS_BABY(LOCAL)
	;babies cannot fight and cannot be targeted
	SUBJECT_WEIGHTS:LOCAL = 0
	CONTINUE
ELSE
	;check if the 2hu is actually in combat
	SIF DT_SELECT("lcCombatants", @"chara = {LOCAL} and side <> {nSide}")
		GOTO START
	SUBJECT_WEIGHTS:LOCAL = 0
	CONTINUE
ENDIF
$START
;Don't mess with the weights for a character that doesn't exist in the current fork
IF LOCAL < CHARANUM
	;More likely to shoot at a hu with higher combat
	IF GetCombatAbility(LOCAL) > 0
		;DEBUGPRINTFORML %CALLNAME:LOCAL% has {GetCombatAbility(LOCAL)} combat
		;DEBUGPRINTFORML %CALLNAME:LOCAL%'s weight was {SUBJECT_WEIGHTS:LOCAL}
		SELECTCASE GetCombatAbility(LOCAL)
			CASE IS >= UniversalRank("QuadUltra")
				SUBJECT_WEIGHTS:LOCAL += 9
			CASE IS >= UniversalRank("TriUltra")
				SUBJECT_WEIGHTS:LOCAL += 8
			CASE IS >= UniversalRank("OverDrive")
				SUBJECT_WEIGHTS:LOCAL += 7
			CASE IS >= UniversalRank("Phantasm")
				SUBJECT_WEIGHTS:LOCAL += 6
			CASE IS >=  UniversalRank("Extra")
				SUBJECT_WEIGHTS:LOCAL += 5
			CASE IS >=  UniversalRank("S")
				SUBJECT_WEIGHTS:LOCAL += 4
			CASE IS >=  UniversalRank("A")
				SUBJECT_WEIGHTS:LOCAL += 3
			CASE IS >=  UniversalRank("B")
				SUBJECT_WEIGHTS:LOCAL += 2
			CASE IS >=  UniversalRank("C")
				SUBJECT_WEIGHTS:LOCAL += 1
			CASEELSE
				SUBJECT_WEIGHTS:LOCAL += 0
		ENDSELECT
		;DEBUGPRINTFORML %CALLNAME:LOCAL%'s weight is now {SUBJECT_WEIGHTS:LOCAL}
	ENDIF
	;prioritize low health 2hus
	IF lcIsLethal
		IF BASE:LOCAL:0 > 500
			LOCAL:3 = 100 * (BASE:(LOCAL):体力-500) / (MAXBASE:(LOCAL):体力-500)
			;DEBUGPRINTFORML %CALLNAME:LOCAL% has {LOCAL:3}\% health
			;DEBUGPRINTFORML %CALLNAME:LOCAL%'s weight was {SUBJECT_WEIGHTS:LOCAL}
			SELECTCASE LOCAL:3
				CASE IS <= 10
					SUBJECT_WEIGHTS:LOCAL += 9
				CASE IS <= 20
					SUBJECT_WEIGHTS:LOCAL += 8
				CASE IS <= 30
					SUBJECT_WEIGHTS:LOCAL += 7
				CASE IS <= 40
					SUBJECT_WEIGHTS:LOCAL += 6
				CASE IS <=  50
					SUBJECT_WEIGHTS:LOCAL += 5
				CASEELSE
					SUBJECT_WEIGHTS:LOCAL += 0
			ENDSELECT
			;DEBUGPRINTFORML %CALLNAME:LOCAL%'s weight is now {SUBJECT_WEIGHTS:LOCAL}
		ELSE
			SUBJECT_WEIGHTS:LOCAL = 0
		ENDIF
	ELSE
		IF DT_CELL_GET(@"lcCombatants", GetCombatant(LOCAL) , "lives", 1) > 0
			;DEBUGPRINTFORML %CALLNAME:LOCAL% has {DT_CELL_GET(@"lcCombatants", GetCombatant(LOCAL) , "lives", 1)} lives
			;DEBUGPRINTFORML %CALLNAME:LOCAL%'s weight was {SUBJECT_WEIGHTS:LOCAL}
			SELECTCASE DT_CELL_GET(@"lcCombatants", GetCombatant(LOCAL) , "lives", 1)
				CASE 1
					SUBJECT_WEIGHTS:LOCAL += 9
				CASE 2
					SUBJECT_WEIGHTS:LOCAL += 4
				CASE 3
					SUBJECT_WEIGHTS:LOCAL += 2
				CASEELSE
					SUBJECT_WEIGHTS:LOCAL += 0
			ENDSELECT
			;DEBUGPRINTFORML %CALLNAME:LOCAL%'s weight is now {SUBJECT_WEIGHTS:LOCAL}
		ELSE
			SUBJECT_WEIGHTS:LOCAL = 0
		ENDIF
	ENDIF
	SIF SUBJECT_WEIGHTS:LOCAL < 0 ;should never happen, but would fuck with ARRAY_HIT if it occurs
		THROW Subject weight for {LOCAL} is a negative value ({SUBJECT_WEIGHTS:LOCAL})
ENDIF
NEXT
LOCAL = ARRAY_HIT(SUBJECT_WEIGHTS, CHARANUM)
IF LOCAL < 0
	PRINTFORMDL 경고: 유효한 대상이 없습니다.
	PRINTFORMDL 전투를 종료합니다.
	;not ideal, but shouldn't cause issues
	RETURNF -1
ENDIF
RETURNF LOCAL

@ATTACKER_PRIORITY
#FUNCTION
#DIM SUBJECT_WEIGHTS, キャラクタ数上限 ;potential targets and their weights
#DIM  RANK       ;評価ランク、数が小さいほど優秀
#DIM  RANK_NUM   ;評価尺度に含まれる評価の種数
#DIM DYNAMIC nChara
#DIM DYNAMIC nCharaLoop
#DIM DYNAMIC nHit
RANK = 0
;remove inaccessible characters from the list
FOR nChara, 0, CHARANUM
SUBJECT_WEIGHTS:nChara = 1
;Don't mess with the weights for a character that doesn't exist in the current fork
IF nChara < CHARANUM
	IF CFLAG:nChara:出禁
		SUBJECT_WEIGHTS:nChara = 0
		CONTINUE
	ELSEIF IsDead:nChara:0 || BASE:nChara:0 < 500
		SUBJECT_WEIGHTS:nChara = 0
		CONTINUE
	ELSEIF !GetCombatant(nChara, 3)
		;PRINTFORML %CALLNAME:nChara% HAS NO COMBATANT ID
		SUBJECT_WEIGHTS:nChara = 0
		CONTINUE
	ENDIF
	;PRINTFORML %CALLNAME:nChara% HAS COMBATANT ID {GetCombatant(nChara, 3)}
	;More likely to shoot at a hu with higher combat
	IF GetCombatAbility(nChara) > 0
		;DEBUGPRINTFORML %CALLNAME:nChara% has {GetCombatAbility(nChara)} combat
		;DEBUGPRINTFORML %CALLNAME:nChara%'s weight was {SUBJECT_WEIGHTS:nChara}
		IF GetCombatAbility(nChara) >= 63
			SUBJECT_WEIGHTS:nChara = __INT_MAX__
		ELSE
			SUBJECT_WEIGHTS:nChara += (POWER(2,GetCombatAbility(nChara)))
		ENDIF
		;DEBUGPRINTFORML %CALLNAME:nChara%'s weight is now {SUBJECT_WEIGHTS:nChara}
	ENDIF
	IF CapacityStats:nChara:3 > 0
		;DEBUGPRINTFORML %CALLNAME:nChara% has {CapacityStats:nChara:3} movement
		;DEBUGPRINTFORML %CALLNAME:nChara%'s weight was {SUBJECT_WEIGHTS:nChara}
		SUBJECT_WEIGHTS:nChara = MAX(SUBJECT_WEIGHTS:nChara*CapacityStats:nChara:3/100,1)
		;DEBUGPRINTFORML %CALLNAME:nChara%'s weight is now {SUBJECT_WEIGHTS:nChara}
	ENDIF
	SIF SUBJECT_WEIGHTS:nChara < 0 ;should never happen, but would fuck with ARRAY_HIT if it occurs
		THROW Subject weight for {nChara} is a negative value ({SUBJECT_WEIGHTS:nChara})
ENDIF
;PRINTFORMDL %CALLNAME:nChara%: Weight {SUBJECT_WEIGHTS:nChara}
RANK++
NEXT
;PRINTFORMDL Trying to rank {RANK} combatants
FOR LOCAL:1, 0, RANK-1
nHit = ARRAY_HIT(SUBJECT_WEIGHTS, CHARANUM)
IF nHit < 0
	PRINTFORMDL 경고: 루프 #{LOCAL:1}/{RANK}에 유효한 공격자가 없다.
	PRINTFORMDL 전투를 종료한다.
	;not ideal, but shouldn't cause issues
	RETURNF -1
ENDIF
;grab the character
DT_SELECT "lcCombatants", @"chara = {nHit}"
nChara = RESULT:1
;give the priority
DT_CELL_SET "lcCombatants", nChara, "priority",  SUBJECT_WEIGHTS:nHit, 1
SUBJECT_WEIGHTS:nHit = 0
;PRINTFORMDL #{LOCAL:1}: %CALLNAME:(LOCAL)%
NEXT
DT_SELECT "lcCombatants", "", "priority DESC"
RETURNF DT_CELL_GET("lcCombatants", RESULT:1, "priority",1)

