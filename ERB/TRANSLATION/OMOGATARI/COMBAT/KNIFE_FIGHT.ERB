@ReactSelfDefense(ARG)
#DIM DYNAMIC nLoop
#DIM DYNAMIC nVictimChara
#DIM DYNAMIC nVictimChara2
#DIM DYNAMIC nIntimidated
#DIM DYNAMIC nCharaList, 2000
#DIM DYNAMIC nRoll
#DIM DYNAMIC combatType
VARSET nIntimidated
VARSET LOCAL
SIF inTrain == 3 || SaveIsEZB
	RETURN
IF ARG != MASTER && !CFLAG:ARG:うふふ && SHIRAHU(ARG) && !FLAG:70 && !CFLAG:ディレイ && !IsDead:ARG:0 && FLAG:POSTAL != -1 && !TEQUIP:ARG:拘束
	CALL FISHER_YATES_SHAFFLE(CHARANUM)
	ARRAYCOPY "SHAFFLE_ARRAY", "nCharaList"
	FOR (nLoop), 0, CHARANUM
	VARSET nIntimidated
	nVictimChara = nCharaList:(nLoop)
	SIF !SHIRAHU(ARG)
		BREAK
	SIF TEQUIP:ARG:拘束
		BREAK
	;Dead calm block
	SIF COMBAT_AGGRESSIVENESS(ARG) == 0
		BREAK
	;If 2hu is ded
	SIF TCVAR:(ARG):Grievous_Harm
		BREAK
	;Not in the same location
	SIF CFLAG:ARG:現在位置 != CFLAG:(nVictimChara):現在位置
		CONTINUE
	SIF ARG == nVictimChara
		CONTINUE
	;Don't fight if the combatant can't fight
	;also check if the touhou is too powerful
	SIF GetCombatAbility(ARG) < UniversalRank("C") || GetCombatAbility(nVictimChara) > (GetCombatAbility(ARG)+3)
		nIntimidated = 1
	nRoll = FightIsPossible(ARG,nVictimChara)
	;;#; PRINTFORML %CALLNAME:ARG% hostile to %CALLNAME:(nVictimChara)%: {HostileAffinity(nVictimChara,ARG)} | Is fight possible: {nRoll}
	SELECTCASE nRoll
		CASE 1
			;Danmaku
			$DANMAKUFight
			SIF !GETBIT(nWeapons,0)
				RETURN
			SIF nIntimidated
				GOTO GotIntimidated
			PRINTFORML %CALLNAME:ARG%은(는) %CALLNAME:(nVictimChara)%를 단막 싸움으로 몰아붙이며 수상한 행동을 한다...
			TCVAR:ARG:InitiatedAttack = 1
			CALL CompileCharactersToCombatant(nVictimChara,1,IntimidationFactor(ARG),,"「Same Location」「No Enemy Join RNG」")
			CALL KNIFE_FIGHT(ARG,nVictimChara, 0,1)
			SIF TCVAR:ARG:Grievous_Harm
				BASE:ARG:0 = 499
			SIF TCVAR:nVictimChara:Grievous_Harm
				BASE:nVictimChara:0 = 499
			CALL Add_TiredBitchesGotoSleep
		CASE 2
			;Lethal
			;acts sus
			SIF !nRyona
				GOTO DANMAKUFight
			;SIF RAND:4 && nVictimChara == MASTER
			;	CONTINUE
			IF nIntimidated
				$GotIntimidated
				PRINTFORML %CALLNAME:ARG%이 %GET_STR(ARG, "Weapon", EQUIP:ARG:Weapon, "FullName")%를 꺼내자 수상하게 행동한다.
				PRINTFORMW 하지만 %HES_SHES(ARG)%은 %PARSE("your",,,nVictimChara)%의 존재에 위축되어 도망치기 시작한다.
				CFLAG:ARG:300 = KICKOUT(CFLAG:ARG:300)
				SIF nVictimChara == MASTER
					FLAG:797 = 0
				CONTINUE
			ENDIF
			SELECTCASE EQUIP:ARG:Weapon
				CASE 0
					PRINTFORML %CALLNAME:ARG%는 그녀가 %HIS_HER(ARG)%의 주먹을 들어 올리자 수상하게 행동한다...
					PRINTFORMW %CALLNAME:ARG%는 %CALLNAME:(nVictimChara)%를 똑바로 노려본다...
				CASEELSE
					PRINTFORML %CALLNAME:ARG%은(는) %GET_STR(ARG, "Weapon", EQUIP:ARG:Weapon, "FullName")%을 꺼내며 수상하게 행동한다...
					PRINTFORMW %CALLNAME:ARG%은(는) 그것을 바로 %CALLNAME:(nVictimChara)%에게 겨눈다...
			ENDSELECT
			TCVAR:ARG:InitiatedAttack = 1
			CALLF AddCombatant(ARG,0)
			CALLF AddCombatant(nVictimChara,1)
			CALL CompileCharactersToCombatant(nVictimChara,1,IntimidationFactor(ARG),,"「Same Location」「No Enemy Join RNG」")
			CALL ASK_PLAYER_FOR_COMBAT
			CALL KNIFE_FIGHT(ARG,nVictimChara, 1,1)
	ENDSELECT
	IF FLAG:797 && nVictimChara == MASTER && !TCVAR:ARG:Just_Attacked
		;self defense
		IF nIntimidated
			GOTO GotIntimidated
		ELSE
			SELECTCASE FLAG:797
				CASE 1
					PRINTFORMW %CALLNAME:ARG%은(는) 당신이 다른 사람을 공격하는 것을 목격하고 자기방어를 한다...
					PRINTFORMW %HE_SHE(ARG,1)%은(는) %GET_STR(ARG, "Weapon", EQUIP:ARG:Weapon, "FullName")%를 꺼낸다...
					FLAG:797 = 0
					CALL KNIFE_FIGHT(ARG,nVictimChara, 1,1)
			ENDSELECT
		ENDIF
	ENDIF
	;PRINTFORML %CALLNAME:ARG%: {TCVAR:ARG:InitiatedAttack}
	; IF TCVAR:ARG:InitiatedAttack
	;     TCVAR:ARG:InitiatedAttack = 0
