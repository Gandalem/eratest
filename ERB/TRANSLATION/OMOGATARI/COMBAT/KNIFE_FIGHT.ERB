; Modular ERB: OMOGATARI/COMBAT/KNIFE_FIGHT.ERB
;yes, it's called KNIFE_FIGHT because i made this because i wanted a stab command, but now its expanded to a full-fledged combat system.

@KNIFE_FIGHT(ATTACKER,VICTIM, localLethal = 1, nPlaceHolder:1 = 0)
#DIM ATTACKER
#DIM VICTIM
#DIM FUCKOFF
#DIM DIFFERENCE
#DIM KILLSPELL
#DIM BGMStuffs
#DIM TempBoost
#DIM WeapSkill,2
#DIMS WeapUsed,2
#DIM DamageType
#DIM nPlaceHolder, 2
#DIM localLethal
#DIM nWeap
#DIM nEnemy
#DIM nPreviousValue
#DIM OUTPUT
#DIM nSide0Count
#DIM nSide0List, 200
#DIM nSide1Count
#DIM nSide1List, 200
#DIM nlcChara
#DIM nPriorityList, 200
#DIM nPriorityTotal
#DIM lcCurSide
#DIM nlcCanKeepTSP
VARSET EasyBattleExpToGet
VARSET CurrentBattle
lcIsLethal = localLethal
BADNamePrevious '= EZB_BAD_NAME()
;get old bad name here
SETBGMVOLUME BGMVOLUME
SETSOUNDVOLUME SOUNDVOLUME
IF !nRyona && !SaveIsEZB && lcIsLethal
	SETCOLOR C_RED
	PRINTL
	PRINTFORML %"-"*89%
	PRINTFORML 치명적인 @KNIFE_FIGHT가 활성화되지 않은 상태에서 호출되었습니다!
	PRINTFORML 이 사실을 보고해 주세요!
	PRINTFORML %"-"*89%
	RESETCOLOR
	RETURN
ELSEIF VICTIM < 0 || ATTACKER < 0
	SETCOLOR C_RED
	PRINTL
	PRINTFORML %"-"*89%
	PRINTFORML 정의된 캐릭터 없이 @KNIFE_FIGHT가 호출되었습니다!
	PRINTFORML 이것을 보고하세요!
	PRINTFORML %"-"*89%
	RESETCOLOR
	RETURN
ELSEIF !lcIsLethal && !GETBIT(nWeapons,0)
	SETCOLOR C_RED
	PRINTL
	PRINTFORML %"-"*89%
	PRINTFORML DANMAKU가 활성화되지 않은 상태에서 @KNIFE_FIGHT이 호출되었습니다!
	PRINTFORML 이것을 보고해 주세요!
	PRINTFORML %"-"*89%
	RESETCOLOR
	RETURN
ENDIF
FUCKOFF = 0
KILLSPELL = 0
TURNS = 0
MissCounter = 0
;set flags in case the 2hu dies by another cause (ie: bleeding or crippled head/thorax or amputated neck)
FLAG:796 = 0
IF VICTIM != MASTER
	LOCAL = NO:VICTIM
	nEnemy = VICTIM
ELSEIF ATTACKER != MASTER
	LOCAL = NO:ATTACKER
	nEnemy = ATTACKER
ENDIF
CALLF PLAY_BATTLE_MUSIC(LOCAL)
CALL BGM_CUTIN(STR_TR(PlayingBGM), 1)
;--------------------
;custom code for
CALL KOJO_MESSAGE_SEND("DANMAKU", 3+BONUS_DANMAKU_LIVES, LOCAL, DT_CELL_GET(@"lcCombatants", GetCombatant(MASTER), "side", 1) != DT_CELL_GET(@"lcCombatants", GetCombatant(LOCAL), "side", 1), -1, "INITIALIZE") ;addition custom code
BONUS_DANMAKU_LIVES = 0 ;addition custom code
REDRAW 0
VARSET TempBoost
VARSET IsInCover
VARSET lcWarResult, -1
VARSET lcPickFactionMax, -1
VARSET lcTitle
VARSET lcSidePower
SIF !DT_EXIST("lcCombatants")
	CALLF StartBattle()
SIF !GetCombatant(ATTACKER)
	CALLF AddCombatant(ATTACKER,0)
SIF !GetCombatant(VICTIM)
	CALLF AddCombatant(VICTIM,1)
CurrentBattle:Battle_PlayerSide = -1
IF GetCombatant(MASTER)
	CurrentBattle:Battle_PlayerSide = DT_CELL_GET(@"lcCombatants", GetCombatant(MASTER), "side", 1)
ENDIF
IF EasyBattleIsRanked
	EasyBattleNewElo:0:1 = EZB_ELO_NEW(ATTACKER,VICTIM,1,30)
	EasyBattleNewElo:0:0 = EZB_ELO_NEW(ATTACKER,VICTIM,0,30)
	EasyBattleOldElo:0 = EZB_ELO:ATTACKER:0
	EasyBattleNewElo:1:1 = EZB_ELO_NEW(VICTIM,ATTACKER,1,30)
	EasyBattleNewElo:1:0 = EZB_ELO_NEW(VICTIM,ATTACKER,0,30)
	EasyBattleOldElo:1 = EZB_ELO:VICTIM:0
ENDIF
; [IF_DEBUG]
; FOR nlcChara, 0, DT_ROW_LENGTH("lcCombatants")
;     PRINTFORML Combatant {nlcChara}: {DT_CELL_GET("lcCombatants", nlcChara, "chara")} %CALLNAME:(DT_CELL_GET("lcCombatants", nlcChara, "chara"))% (Side {DT_CELL_GET("lcCombatants", nlcChara, "side")})
;     PRINTFORML {GetCombatant(DT_CELL_GET("lcCombatants", nlcChara, "chara"), 3)}
; NEXT
; [ENDIF]
LOCAL:10 = TCVAR:ATTACKER:Attack_Power
LOCAL:11 = TCVAR:VICTIM:Attack_Power
DIFFERENCE = (TCVAR:VICTIM:Attack_Power-TCVAR:ATTACKER:Attack_Power)
SIF ATTACKER_PRIORITY() == -1
	GOTO END
;get unit count
lcStartingUnits:0 = DT_SELECT("lcCombatants", @"side = 0", "", nSide0List)
lcStartingUnits:1 = DT_SELECT("lcCombatants", @"side = 1", "", nSide0List)
;grab the title.
CALL INIT_BATTLE_NAME()
IF GetCombatant(MASTER)
	VARSET RESULT
	CALL KOJO_MESSAGE_SEND("DANMAKU", 3, nEnemy, MASTER, -1, "戦闘前")
	IF RESULT == -1
		RETURN -1
	ENDIF
ENDIF
DO
nSide0Count = DT_SELECT("lcCombatants", @"side = 0", "", nSide0List)
nSide1Count = DT_SELECT("lcCombatants", @"side = 1", "", nSide1List)
FOR LOCAL, 0, nSide0Count
nlcChara = DT_CELL_GET("lcCombatants", nSide0List:LOCAL, "chara", 1)
CALL ResetYoujutsuResist(nlcChara)
IF lcIsLethal
	nWeap = charaWeaponInts:nlcChara:WeaponInventory ? charaWeaponInts:nlcChara:WeaponInventory # EQUIP:(nlcChara):Weapon
ELSE
	nWeap = 1
ENDIF
CALLF COM_WEAPSTATS(nlcChara,nWeap,1,charaWeaponInts:nlcChara:Mode,0)
charaWeaponInts:(nlcChara):Accuracy = GetShootingAccuracy(nlcChara)
TCVAR:(nlcChara):Weap_Dodge = GetDodgeChance(nlcChara)
;TCVAR:ATTACKER:Attack_Power = LOCAL:10
NEXT
FOR LOCAL, 0, GetCombatantSize(2)
nlcChara = DT_CELL_GET("lcCombatants", nSide1List:LOCAL, "chara", 1)
CALL ResetYoujutsuResist(nlcChara)
IF lcIsLethal
	nWeap = charaWeaponInts:nlcChara:WeaponInventory ? charaWeaponInts:nlcChara:WeaponInventory # EQUIP:(nlcChara):Weapon
ELSE
	nWeap = 1
ENDIF
CALLF COM_WEAPSTATS(nlcChara,nWeap,1,charaWeaponInts:nlcChara:Mode,0)
charaWeaponInts:(nlcChara):Accuracy = GetShootingAccuracy(nlcChara)
TCVAR:(nlcChara):Weap_Dodge = GetDodgeChance(nlcChara)
;TCVAR:VICTIM:Attack_Power = LOCAL:11
NEXT
IF (EYEWITNESS() == 1 || GET_TARGETNUM() > 1) && ATTACKER == MASTER && lcIsLethal
	FLAG:797 = 1
	[IF_DEBUG]
	PRINTFORML FLAG 797 SET
	[ENDIF]
ELSE
	FLAG:797 = 0
ENDIF
[IF_DEBUG]
PRINTFORML EYEWITNESS: %TOSTR(EYEWITNESS())%, GET_TARGETNUM: %TOSTR(GET_TARGETNUM())%
[ENDIF]
TURNS += 1
CUSTOMDRAWLINE ━
PRINTFORML TURN: %TOSTR(TURNS)%
FOR LOCAL, 0, DT_ROW_LENGTH("lcCombatants")
;paralyzed
IF DT_CELL_GET("lcCombatants", LOCAL, "paralysisAilment")
	DT_CELL_SET "lcCombatants", LOCAL, "didAttack", 2
ENDIF
;losing turn
IF DT_CELL_GET("lcCombatants", LOCAL, "didAttack", 0) == 2
	DT_CELL_SET "lcCombatants", LOCAL, "didAttack", 1
ELSE
	DT_CELL_SET "lcCombatants", LOCAL, "didAttack", 0
ENDIF
DT_CELL_SET "lcCombatants", LOCAL, "protectBuff", MAX(0,DT_CELL_GET("lcCombatants", LOCAL, "protectBuff", 0)-1), 0
NEXT
SIF ATTACKER_PRIORITY() == -1
	GOTO END
lcCombatantCount = DT_SELECT("lcCombatants", @"didAttack < 1", "priority DESC", nPriorityList)
FOR lcCount, 0, lcCombatantCount
nlcChara = DT_CELL_GET("lcCombatants", nPriorityList:lcCount, "chara", 1)
CurrentBattle:Battle_DamageTurn = 0
SIF !DT_SELECT("lcCombatants",@"id = {nPriorityList:lcCount}") ; removed
	CONTINUE
SIF BASE:(nlcChara):0 < 500 || IsDead:(nlcChara):0 ; dead
	CONTINUE
;TSP
SIF FLAG:70 && BASE:nlcChara:8 < 100
	CONTINUE
;already attacked without one more
SIF DT_CELL_GET("lcCombatants", nPriorityList:lcCount, "didAttack", 1)
	CONTINUE
;sleep
SIF DT_CELL_GET("lcCombatants", nPriorityList:lcCount, "sleepAilment", 1)
	CONTINUE
lcOneMoreCount = 0
;#;PRINTFORML attacker {nlcChara} %NAME:nlcChara% has attacked {DT_CELL_GET("lcCombatants", nPriorityList:lcCount, "chara", 1)} %NAME:(DT_CELL_GET("lcCombatants", nPriorityList:lcCount, "chara", 1))%
;#;PRINTFORML list {nPriorityList:lcCount}
$DoAnotherAttack
CALL FIGHT_ATTACK(nlcChara)
DT_CELL_SET "lcCombatants", nPriorityList:lcCount, "didAttack", 1, 1
DT_CELL_SET "lcCombatants", nPriorityList:lcCount, "chargeBuff", MAX(0,DT_CELL_GET("lcCombatants", nPriorityList:lcCount, "chargeBuff", 1)-1), 1
SIF !RemoveDeadCombatants()
	GOTO END
SIF FLAG:796
	GOTO END
;if accidenter was the fighter
IF NAS_ESP_DiaperSpell:nlcChara:Index >= 2
	NAS_ESP_DiaperSpell:nlcChara:0 = 0
	NAS_ESP_DiaperSpell:nlcChara:1 = 0
	NAS_ESP_DiaperSpell:nlcChara:2 = 0
	GOTO DoAnotherAttack
ELSEIF NAS_ESP_DiaperSpell:nlcChara:1
	GOTO DoAnotherAttack
ENDIF
;accidents for other fighters
FOR LOCAL, 0, lcCombatantCount
LOCAL:1 = DT_CELL_GET("lcCombatants", nPriorityList:LOCAL, "chara", 1)
SIF LOCAL:1 == nlcChara
	CONTINUE
SIF NAS_ESP_DiaperSpell:(LOCAL:1):0
	CALL FIGHT_ATTACK(LOCAL:1)
SIF NAS_ESP_DiaperSpell:(LOCAL:1):1
	CALL FIGHT_ATTACK(LOCAL:1)
NAS_ESP_DiaperSpell:(LOCAL:1):0 = 0
NAS_ESP_DiaperSpell:(LOCAL:1):1 = 0
NAS_ESP_DiaperSpell:(LOCAL:1):2 = 0
NEXT
IF lcOneMore
	lcOneMoreCount++
	lcOneMore = 0
	GOTO DoAnotherAttack
ENDIF
IF nlcChara == MASTER
	CurrentBattle:Battle_DamageMax = MAX(CurrentBattle:Battle_DamageMax,CurrentBattle:Battle_DamageTurn)
	CurrentBattle:Battle_DamageTurn = 0
ENDIF
PRINTFORML 새로운 캐릭터
NEXT
;PRINTFORML Going to the end of line
$LoseTurn
;turn end
CVARSET NAS_ESP_DiaperSpell
nlcCanKeepTSP = 0
lcCombatantCount = DT_ROW_LENGTH("lcCombatants")
FOR LOCAL, 0, lcCombatantCount
nlcChara = DT_CELL_GET("lcCombatants", LOCAL, "chara", 0)
CALL TimeBladderGain(nlcChara,10)
IF SoiledSelf:nlcChara:0
	LOCALS '= @"%PARSE("Your",,,nlcChara)% 소변을 본 것이 %PeeProtectType(nlcChara,1)% 다리에 %PARSE("your",5,,nlcChara)% 고통스러운 발진을 주고 있다..."
	CALL RECOVER(nlcChara, -(MAXBASE:nlcChara:0-500)/16, "体力", LOCALS)
ENDIF
IF SoiledSelf:nlcChara:1
	LOCALS '= @"지저분한 바지는 %PARSE("your",,,nlcChara)% 건강에 좋지 않다..."
	CALL RECOVER(nlcChara, -(MAXBASE:nlcChara:0-500)/16, "体力", LOCALS)
ENDIF
IF DT_CELL_GET("lcCombatants", LOCAL, "poisonAilment", 0)
	LOCALS '= @"독이 %PARSE("you",,,nlcChara)%을(를) 먹어치고 있다..."
	CALL RECOVER(nlcChara, -(MAXBASE:nlcChara:0-500)/8, "体力", LOCALS)
ENDIF
IF DT_CELL_GET("lcCombatants", LOCAL, "burnAilment", 0)
	LOCALS '= @"%PARSE("You're",,,nlcChara)%타오르고 있어..."
	CALL RECOVER(nlcChara, -(MAXBASE:nlcChara:0-500)/8, "体力", LOCALS)
ENDIF
IF DT_CELL_GET("lcCombatants", LOCAL, "paralysisAilment", 0)
	DT_CELL_SET "lcCombatants", LOCAL, "paralysisAilment", MAX(0,DT_CELL_GET("lcCombatants", LOCAL, "paralysisAilment", 0)-1), 0
	IF DT_CELL_GET("lcCombatants", LOCAL, "paralysisAilment", 0) == 0
		SETCOLOR C_YELLOW
		CALL LC_PRINT(@"%PARSE("You free",,,nlcChara)% %PARSE("yourself",,,nlcChara)% 마비로부터 %PARSE("your",5,,nlcChara)%.", , 2,)
		RESETCOLOR
	ENDIF
ENDIF
IF DT_CELL_GET("lcCombatants", LOCAL, "muteAilment", 0)
	;muted
	DT_CELL_SET "lcCombatants", LOCAL, "muteAilment", MAX(0,DT_CELL_GET("lcCombatants", LOCAL, "muteAilment", 0)-1), 0
	IF DT_CELL_GET("lcCombatants", LOCAL, "muteAilment", 0) == 0
		SETCOLOR C_YELLOW
		CALL LC_PRINT(@"%PARSE("You",,,nlcChara)%드디어 다시 말할 수 있게 되었다.", , 2,)
		RESETCOLOR
	ENDIF
ENDIF
IF DT_CELL_GET("lcCombatants", LOCAL, "sleepAilment", 0)
	;sleep
	DT_CELL_SET "lcCombatants", LOCAL, "sleepAilment", MAX(0,DT_CELL_GET("lcCombatants", LOCAL, "sleepAilment", 0)-1), 0
	IF DT_CELL_GET("lcCombatants", LOCAL, "sleepAilment", 0) == 0
		SETCOLOR C_YELLOW
		CALL LC_PRINT(@"%PARSE("You wake",,,nlcChara)%위로.", , 2,)
		RESETCOLOR
	ENDIF
ENDIF
;TSP
IF FLAG:70
	IF BASE:nlcChara:8 >= 100
		nlcCanKeepTSP = 1
		CALL RECOVER(nlcChara, -100, BASENAME:8, "시간이 멈췄다")
	ENDIF
ENDIF
;NPC faints from these passives, give kill to whoever did the last damage
IF IsDead:nLcChara:0 || BASE:nlcChara:0 <= 500
	CALL ENDFIGHT(KilledBy:nlcChara:0,nlcChara)
	CALL KOJO_MESSAGE_SEND("DANMAKU", 0, nlcChara, (KilledBy:nlcChara:0), -1, "被弾") ;addition custom code
ENDIF
NEXT
SIF !RemoveDeadCombatants()
	BREAK
SIF FLAG:796
	BREAK
;call this again
SIF !FLAG:70
	TIME += 1
LOOP 1
$END
IF !lcIsLethal
	FOR LOCAL,0,CHARANUM
	SIF lcBaseTemp:LOCAL:0
		BASE:LOCAL:0 = lcBaseTemp:LOCAL:0
	NEXT
ENDIF
VARSET lcBaseTemp
;war result
;get unit count
lcEndingUnits:0 = DT_SELECT("lcCombatants", @"side = 0", "", nSide0List)
lcEndingUnits:1 = DT_SELECT("lcCombatants", @"side = 1", "", nSide0List)
SIF !lcStartingUnits:0 && !lcStartingUnits:1
	lcWarResult = -2
IF !GROUPMATCH(lcWarResult,-3,-2)
	lcWarResult = GetCombatantSize(2) > GetCombatantSize(1)
	SIF !GetCombatantSize(2) && !GetCombatantSize(1)
		lcWarResult = -1
ELSEIF lcWarResult == -3
ELSE
	GOTO BYPASsSUMMARY
ENDIF
SKIPDISP 0
CALLF StopMusic()
CALL lcAfterBattle
$BYPASsSUMMARY
CALLF StopMusic()
SKIPDISP 0
CALLF RemoveAllCombatants()
CALL FIRE_WEAPON_CHECK_ALL
RETURN TCVAR:MASTER:Grievous_Harm

@FIGHT_ATTACK(nDealer)
#DIM DYNAMIC ATTACKER, 100
#DIM DYNAMIC VICTIM, 100
#DIM DIFFERENCE
#DIM 正解
#DIM ANSWER,2
#DIM DYNAMIC FUCKOFF
#DIM DYNAMIC nDealer
#DIM AimedShot
#DIM nSide
#DIM nTarget
#DIM DYNAMIC BiggestBurst
#DIM DYNAMIC nDmgType
#DIM DYNAMIC nDMG
#DIM DYNAMIC PickCard
#DIM DYNAMIC TruncatedAttacks,15
#DIM DYNAMIC FA_WEAPON
#DIM DYNAMIC PR_WEAPON
#DIM FA_LINECOUNT
#DIM DYNAMIC FA_SUB
#DIM DYNAMIC FA_MENUBYP
#DIMS OUTPUT
#DIM DYNAMIC FA_RESIST
#DIM DYNAMIC FA_TARGETEVAL
#DIM DYNAMIC IS_VALID_FIGHTER
#DIM DYNAMIC FA_DEF_WEAPON
#DIM DYNAMIC ASDS_MAX
#DIM DYNAMIC PossibleToAttack
VARSET AimedShot
VARSET LC_REFLECTED
VARSET FA_SUB
VARSET FA_MENUBYP
VARSET lcDidInvalidMagic
REDRAW 0
SKIPDISP 0
LOCAL:53 = MESSKIP() && !(nDealer == MASTER || (lcDirectControl && GetCombatant(MASTER, DT_CELL_GET(@"lcCombatants", GetCombatant(nDealer), "side", 1)+1)))
IF LOCAL:53
	IF NASLoadingLine
		CALL ANIMATION_LOAD_NAS(lcCount, 0, lcCombatantCount, @"%CALLNAME:nDealer%의 턴을 시뮬레이션한다."); nas loading
	ELSE
		CALL NAS_START_LOADING()
		CALL ANIMATION_LOAD_NAS(lcCount, 0, lcCombatantCount, @"%CALLNAME:nDealer%의 턴을 시뮬레이션한다."); nas loading
	ENDIF
ENDIF
SKIPDISP LOCAL:53
PR_WEAPON = charaWeaponInts:nDealer:WeaponInventory ? charaWeaponInts:nDealer:WeaponInventory # EQUIP:(nDealer):Weapon
IF lcIsLethal && (!DT_CELL_GET("lcCombatants", GetCombatant(nDealer), "muteAilment", 1) || !GET_INT(nDealer, "Weapon", PR_WEAPON, WeapStats_Prefix(PR_WEAPON,charaWeaponInts:nDealer:Mode)+"MP Cost"))
	FA_WEAPON = charaWeaponInts:nDealer:WeaponInventory ? charaWeaponInts:nDealer:WeaponInventory # EQUIP:(nDealer):Weapon
ELSE
	FA_WEAPON = 1
ENDIF
FuckOff = 0
FA_DEF_WEAPON = FA_WEAPON >= 60000000000 ? DT_CELL_GET("WeaponInventory", FA_WEAPON, "def", 1) # FA_WEAPON
IF GetCombatant(nDealer,1)
	DT_SELECT "lcCombatants", @"side = 0", "", ATTACKER
	DT_SELECT "lcCombatants", @"side = 1", "", VICTIM
	nSide = 0
ELSEIF GetCombatant(nDealer,2)
	DT_SELECT "lcCombatants", @"side = 1", "", ATTACKER
	DT_SELECT "lcCombatants", @"side = 0", "", VICTIM
	nSide = 1
ELSE
	;PRINTFORMW Could not find %CALLNAME:nDealer% in either side of the combatants.
	lcOneMore = 0
	RETURN 1
ENDIF
DIFFERENCE = 0
; SIF charaWeaponInts:ATTACKER:Burst <= 0
;     charaWeaponInts:ATTACKER:Burst = 1
; SIF FLAG:223
;     charaWeaponInts:ATTACKER:Accuracy = 400
IF nDealer == -1
	lcOneMore = 0
	RETURN
ELSEIF BASE:(nDealer):0 < 500 || IsDead:(nDealer):0
	lcOneMore = 0
	RETURN
ELSEIF IS_BABY(nDealer)
	;baby
	CALLF RemoveCombatant(nDealer,1)
	CALLF RemoveCombatant(nDealer,0)
	lcOneMore = 0
	RETURN
ENDIF
nTarget = AI_GET_TARGET(nDealer,nSide)
IF nTarget == -1
	FLAG:796 = 1
	lcWarResult = -2
	RETURN
ENDIF
VARSET lcDamageDeal
KilledBy:nTarget:0 = nDealer
KilledWith:nTarget:0 = {FA_WEAPON}
;target buffs
;danmaku buffs relating to CORRECTION go here
;LOCAL:4 = 0
;DIFFERENCE = (TCVAR:VICTIM:Attack_Power-TCVAR:ATTACKER:Attack_Power)
;charaWeaponInts:ATTACKER:Accuracy -= (DIFFERENCE)
;SIF IsInCover:ATTACKER:0
;    charaWeaponInts:VICTIM:Accuracy /= 2
;SIF IsInCover:VICTIM:0
;    charaWeaponInts:ATTACKER:Accuracy /= 2
IF ISSKIP()
	FOR LOCAL, 0, MAX(GetCombatantSize(1),GetCombatantSize(2))
	;Attacker
	IF ATTACKER:LOCAL > 0
		BiggestBurst = MAX(BiggestBurst,charaWeaponInts:((DT_CELL_GET("lcCombatants", ATTACKER:LOCAL, "chara",1))):Burst*(charaWeaponInts:((DT_CELL_GET("lcCombatants", ATTACKER:LOCAL, "chara",1))):Pellets+1))
	ENDIF
	;Victim
	IF VICTIM:LOCAL > 0
		BiggestBurst = MAX(BiggestBurst,charaWeaponInts:((DT_CELL_GET("lcCombatants", VICTIM:LOCAL, "chara",1))):Burst*(charaWeaponInts:((DT_CELL_GET("lcCombatants", VICTIM:LOCAL, "chara",1))):Pellets+1))
	ENDIF
	NEXT
	GOTO SKIPLineFormatting
ENDIF
CUSTOMDRAWLINE ━
CALL ShowAttackPriority()
CUSTOMDRAWLINE ━
LOCAL:1 = DT_CELL_GET("lcCombatants", ATTACKER:0, "side",1)
LOCALS:0 '= @"%LCSideNames:(LOCAL:1)% ({GetCombatantSize(LOCAL:1+1)})"
LOCALS:1 '= @"%LCSideNames:(!LOCAL:1)% ({GetCombatantSize(!(LOCAL:1)+1)})"
PRINTFORM %LOCALS:0%%" "*(98-STRLENS(LOCALS:0))%| 
PRINTFORM %LOCALS:1%%" "*(98-STRLENS(LOCALS:1))%
PRINTL
DRAWLINE
;new vertical system
FOR LOCAL, 0, MAX(GetCombatantSize(1),GetCombatantSize(2))
;Attacker
IF ATTACKER:LOCAL > 0
	BiggestBurst = MAX(BiggestBurst,charaWeaponInts:((DT_CELL_GET("lcCombatants", ATTACKER:LOCAL, "chara",1))):Burst*(charaWeaponInts:((DT_CELL_GET("lcCombatants", ATTACKER:LOCAL, "chara",1))):Pellets+1))
	CALL lcLineFormatting(DT_CELL_GET("lcCombatants", ATTACKER:LOCAL, "chara",1),0,0)
	PRINTFORM %" "*20%| 
ELSE
	PRINTFORM %" "*98%| 
ENDIF
;Victim Line 1
IF VICTIM:LOCAL > 0
	BiggestBurst = MAX(BiggestBurst,charaWeaponInts:((DT_CELL_GET("lcCombatants", VICTIM:LOCAL, "chara",1))):Burst*(charaWeaponInts:((DT_CELL_GET("lcCombatants", VICTIM:LOCAL, "chara",1))):Pellets+1))
	CALL lcLineFormatting(DT_CELL_GET("lcCombatants", VICTIM:LOCAL, "chara",1),0,0)
	PRINTL
ELSE
	PRINTL
ENDIF
;Line 2
;Attacker
IF ATTACKER:LOCAL > 0
	CALL lcLineFormatting(DT_CELL_GET("lcCombatants", ATTACKER:LOCAL, "chara",1),1,0)
	PRINT  | 
ELSE
	PRINTFORM %" "*98%| 
ENDIF
;Victim
IF VICTIM:LOCAL > 0
	CALL lcLineFormatting(DT_CELL_GET("lcCombatants", VICTIM:LOCAL, "chara",1),1,1)
ELSE
	PRINTL
ENDIF
NEXT
ASDS_MAX = 5*GetCombatantSize(3)
CUSTOMDRAWLINE ━
$SKIPLineFormatting
IF lcOneMoreCount
	SETCOLOR C_AQUA
	CALL LC_PRINT(@"원 모어 x{lcOneMoreCount}회!", , 1,)
	RESETCOLOR
ENDIF
lcOneMore = 0
;accident
IF PeeBarStage(nDealer) >= 7 || PooBarStage(nDealer) >= 7
	CALL AIB_INIT(nDealer,,,,,nTarget)
ENDIF
IF NAS_ESP_DiaperSpell:nDealer:0
	VARSET NAS_ESP_Weapon
	TRYCALLFORM NAS_ESP_{(NAS_ESP_DiaperSpell:nDealer:(NAS_ESP_DiaperSpell:nDealer:Index))/100}_{(NAS_ESP_DiaperSpell:nDealer:(NAS_ESP_DiaperSpell:nDealer:Index))%100}
	IF STRFIND(NAS_ESP_Type, "Ally/") > -1
		GOTO YoujutsuUseAlly
	ELSE
		GOTO YoujutsuUse
	ENDIF
ENDIF
;horniness
SELECTCASE CFLAG:nDealer:溜まってる度
	CASE IS >= 1000
		;masturbate, lose turn.
		SETCOLOR C_RED
		CALL LC_PRINT(@"%PARSE("You",,,nDealer)%는 %PARSE("you begin",5,,nDealer)%를 하기 위해 더 이상 참을 수 없었다.", , 2,)
		RESETCOLOR
		PALAM:nDealer:0 += RAND(PleasureRequired(nDealer)/10,PleasureRequired(nDealer)/2)
		DT_CELL_SET "lcCombatants", GetCombatant(nDealer), "didAttack", 2, 1
		FUCKOFF = 800
ENDSELECT
;orgasm
IF PALAM:nDealer:0 >= PleasureRequired(nDealer) || PALAM:nDealer:1 >= PleasureRequired(nDealer) || PALAM:nDealer:2 >= PleasureRequired(nDealer)
	SETCOLOR C_RED
	CALL LC_PRINT(@"%PARSE("You",,,nDealer)% 더 이상 어떤 쾌락도 견딜 수 없었다, %PARSE("you lose",5,,nDealer)% %PARSE("your",5,,nDealer)%가 절정에 이른다.", , 2,)
	RESETCOLOR
	SKIPDISP 1
	CALL EVENT_SHOOT
	SKIPDISP 0
	CALL BUFF_CHANGE(nDealer,1,-2)
	CALL BUFF_CHANGE(nDealer,3,-2)
	LOCALS '= @"성적인 해방은 %PARSE("your",,,nDealer)% 스태미나를 대가로 온다..."
	CALL RECOVER(nDealer, -(MAXBASE:nDealer:0-500)/10, "体力", LOCALS)
	DT_CELL_SET "lcCombatants", GetCombatant(nDealer), "didAttack", 2, 1
	CFLAG:nDealer:溜まってる度 /= 4
	FOR LOCAL,0,6
	PALAM:nDealer:LOCAL = 0
	NEXT
	FUCKOFF = 800
ENDIF
;turn lost
SIF FUCKOFF == 800
	RETURN
IF (charaWeaponInts:(nDealer):Ammo <= 0 && FA_WEAPON) && charaWeaponInts:(nDealer):MagSize && GROUPMATCH(GET_STR((nDealer), "Weapon", FA_DEF_WEAPON, WeapStats_Prefix(FA_DEF_WEAPON,charaWeaponInts:nDealer:Mode)+"Type"),"Firearm","Explosive","Bow") && nDealer != MASTER
	PRINTFORMW \@ (nDealer) == MASTER ? %PARSE("You are")% # %CALLNAME:(nDealer)% 탄약이 다 떨어졌다! \@
	PRINTFORMW %ONGOING_G((nDealer))% 턴을 재장전하는 데 낭비했다!
	CALL WeaponReload((nDealer))
	RETURN
ELSEIF (GET_STR(nDealer, "Weapon", lcIsLethal ? FA_DEF_WEAPON # 0, WeapStats_Prefix(FA_DEF_WEAPON,charaWeaponInts:nDealer:Mode)+"Ammo") == "MP") && TALENT:(nDealer):ESP && BASE:(nDealer):法力 <= 0
	PRINTFORMW MP가 소진되어, %CALLNAME:(nDealer)%는 항복한다...
	CALLF RemoveCombatant(nDealer,1)
	CALLF RemoveCombatant(nDealer,0)
	RETURN
ELSEIF CFLAG:(nDealer):睡眠
	PRINTFORMW %CALLNAME:(nDealer)%은 잠들어 있다...
	RETURN
ENDIF
IF (nDealer) != MASTER
	IF !RAND:4 && (nDealer) != MASTER && !IsInCover:(nDealer):0 && lcIsLethal
		LOCAL:18 = RAND:VARSIZE("CoverTypes")
		PRINTFORML %CALLNAME:(nDealer)%은(는) 발사하기 전에 %CoverTypes:(LOCAL:18)% 아래로 엄폐한다.
		IsInCover:(nDealer):0 = LOCAL:18
	ENDIF
	; ;spell cards
	; IF !RAND:5
	;     $CardStart
	;     PickCard = RAND(nDealer*1000,(nDealer*1000)+SpellCardCount(nDealer))
	;     GOTO CardUse
	; ENDIF
ENDIF
IF nDealer != MASTER
	;SIF TCVAR:nTarget:Attack_Power < 4
	;    FUCKOFF = 1
	SIF GetPureAccuracy(nDealer) - GetPureAccuracy(nTarget) < -20 && nDealer != MASTER && COMBAT_BRAVERY(nTarget) < RAND(1000) && !LOG_RECOLLECTION_BATTLE
		GOTO RandSurrender
	SIF MARK:nDealer:3 >= 4 || SaveIsEZB
		FUCKOFF = 0
	SIF TURNS >= 150 || MissCounter > (5 * BiggestBurst) || (ASDSCounter >= LIMIT(ASDS_MAX*5,5,40) && ASDSCounter)
		FUCKOFF = 999
	IF HasBionicPart(nTarget,91)
		SETCOLOR 255,100,255
		PRINTFORML 【반사적 항복】
		RESETCOLOR
		PRINTFORML %CALLNAME:nDealer%는 %CALLNAME:nTarget%의 반사적 항복에 굴복한다...
		$RandSurrender
		FUCKOFF = RAND:3
	ENDIF
	IF FUCKOFF  ;if not brave,
		SELECTCASE FUCKOFF
			CASE 1
				CFLAG:nDealer:現在位置 = KICKOUT()
				SELECTCASE GetCombatAbility(nDealer)
					CASE IS >= UniversalRank("B")
						PRINTFORM %PARSE("You",,,nDealer)% 전술적으로 %PARSE("retreat",,,nDealer)% ...
					CASEELSE
						PRINTFORML %PARSE("You are",,,nDealer)%은 %PARSE("you run",5,,nDealer)%가 두려움에 달아나자 공포에 질린다.
						;kek
						CALL OMORASHI_END(nDealer, PeeBarStage(nDealer) > 2 && GETBIT(nPee,1), PooBarStage(nDealer) > 2 && GETBIT(nScat,2))
				ENDSELECT
				;CALL CARD_GOT_CHECK(nTarget)
				SIF nTarget == MASTER
					FLAG:797 = 0
				;FLAG:796 = 1
				CALLF RemoveCombatant(nDealer,1)
				CALLF RemoveCombatant(nDealer,0)
				RETURN
			CASE 2
				$ForceSurrender
				SKIPDISP 0
				PRINTFORML %CALLNAME:nDealer%은(는) %HIS_HER(nDealer)% 무기를 떨어뜨리고 두 손을 머리 위로 올렸다.
				PRINTFORML %CALLNAME:(nTarget)%, %CALLNAME:nDealer%이 항복한 것을 보고 기뻐하며, %HIM_HER(nDealer)%를 사용했다...
				;FLAG:796 = 1
				TCVAR:nDealer:Grievous_Harm = 1
				CALL FightLosePenalty((nTarget),nDealer)
				CALLF RemoveCombatant(nDealer,1)
				CALLF RemoveCombatant(nDealer,0)
				RETURN
			CASE 3
				PRINTFORML
			CASE 800
				RETURN
			CASE 999
				SKIPDISP 0
				SETCOLOR C_RED
				PRINTL
				PRINTFORML %"-"*89%
				PRINTFORML 스톨 방지 안전장치 활성화됨
				PRINTFORML 연속으로 놓친 횟수: {MissCounter}
				PRINTFORML 턴: {TURNS}
				PRINTFORML 연속으로 ASDS를 입력함: {ASDSCounter}
				PRINTFORML 승자 없이 전투 종료
				PRINTFORML 이것을 보고하라!
				PRINTFORML %"-"*89%
				RESETCOLOR
				FORCEWAIT
				FLAG:796 = 1
				lcWarResult = -3
				RETURN
		ENDSELECT
	ENDIF
ENDIF
IS_VALID_FIGHTER = ((nDealer) == MASTER || (lcDirectControl && GetCombatant(MASTER, DT_CELL_GET(@"lcCombatants", GetCombatant(nDealer), "side", 1)+1)))
IF IS_VALID_FIGHTER
	正解 = RAND:4
	LOCALS:0 = Up
	LOCALS:1 = Right
	LOCALS:2 = Left
	LOCALS:3 = Down
	SKIPDISP 0
	SIF LOCAL:53
		CALL NAS_LOAD_END()
	CALL KOJO_MESSAGE_SEND("DANMAKU", LC_HEALTH_TO_DANMAKU_LIVES(nDealer), nDealer, nTarget, -1, "HANDICAP") ;addition custom code
	gLineCount = LINECOUNT
	$AttackLoop
	;set damage type here
	IF lcIsLethal
		IF STRCOUNT(GET_STR((nDealer), "Weapon", FA_DEF_WEAPON, WeapStats_Prefix(FA_DEF_WEAPON,charaWeaponInts:nDealer:Mode)+"Class"), "Blunt")
			nDmgType = 6
		ELSEIF STRCOUNT(GET_STR((nDealer), "Weapon", FA_DEF_WEAPON, WeapStats_Prefix(FA_DEF_WEAPON,charaWeaponInts:nDealer:Mode)+"Class"), "Blade")
			nDmgType = 2
		ELSEIF GET_STR((nDealer), "Weapon", FA_DEF_WEAPON, WeapStats_Prefix(FA_DEF_WEAPON,charaWeaponInts:nDealer:Mode)+"Type") == "Firearm"
			nDmgType = 1
		ELSEIF GET_STR((nDealer), "Weapon", FA_DEF_WEAPON, WeapStats_Prefix(FA_DEF_WEAPON,charaWeaponInts:nDealer:Mode)+"Type") == "Youjutsu"
		ELSE
		ENDIF
		IF CharaWeaponInts:nDealer:DamageType
			nDmgType = CharaWeaponInts:nDealer:DamageType
		ELSEIF GET_INT((nDealer), "Weapon", FA_DEF_WEAPON, WeapStats_Prefix(FA_DEF_WEAPON,charaWeaponInts:nDealer:Mode)+"Incendiary")
			nDmgType = 3
		ENDIF
	ELSE
		nDmgType = 1
	ENDIF
	CLEARLINE LINECOUNT - gLineCount
	SKIPDISP 0
	IF lcDirectControl
		SETCOLOR C_AQUA
		PRINTFORML NPC 직접 제어: %NAME:nDealer% \@ nDealer == MASTER ? (당신) #  \@
		RESETCOLOR
	ENDIF
	;PRINTFORML Choose how %PARSE("you're",,,nDealer)% going to aim.
	PRINTFORML 현재 목표: %NAME:nTarget%
	CALL INTERACTIVE_TUTORIAL_GET(102,201,"Your Turn",0)
	CALL INTERACTIVE_TUTORIAL_GET(102,202,"Your Turn",0)
	CALL Add_STAMINA_BAR(nDealer, 28, 1) ;custom code: replaced bars with one that shows true stamina
	PRINTFORM 　　
	CALL BASE_BAR(nDealer, "気力", 28, "青")
	PRINTFORM 　　
	CALL BLOOD_STATUS(nDealer,28)
	PRINTFORML
	IF HasAnyYoujutsu(nDealer)
		CALL BASE_BAR(nDealer, "法力", 28, "オレンジ")
		PRINTFORM 　　
	ENDIF
	SIF MAXBASE:nDealer:TSP
		CALL BASE_BAR(nDealer, "TSP", 28, "水色")
	PRINTFORM 　　
	PRINTL
	IF Can_Accident(nDealer,1) || Can_Accident(nDealer,2)
		;poo bar
		;moved to a new function since multiple scripts need it now
		IF Can_Accident(nDealer,1)
			CALL PeeBar(nDealer,21)
		ENDIF
		SIF Can_Accident(nDealer,1) && Can_Accident(nDealer,2)
			PRINTFORM 　　
		IF Can_Accident(nDealer,2)
			CALL PooBar(nDealer,21)
		ENDIF
		PRINTL
	ENDIF
	IF FLAG:70
		PRINTFORM 현재 시간은 
		SETCOLOR C_RED
		PRINTFORML STOPPED.
		RESETCOLOR
	ENDIF
	FA_LINECOUNT = LINECOUNT
	IF FA_MENUBYP
		FA_MENUBYP = 0
		GOTO PageLoop
	ENDIF
	FONTBOLD
	PRINTFORML 메인 메뉴
	FONTREGULAR
	CALL ASK_M( "공격", 1, "방어한다", 1, "아이템", 1, "안도감",nPee||nScat, "TSP", 1, "탈출", 1, )
	FA_SUB = RESULT
	$PageLoop
	CLEARLINE LINECOUNT - FA_LINECOUNT
	SELECTCASE FA_SUB
		CASE 0
			IF charaWeaponInts:(nDealer):Accuracy <= 0
				PossibleToAttack = 0
			ELSEIF GROUPMATCH(GET_STR((nDealer), "Weapon", FA_DEF_WEAPON, WeapStats_Prefix(FA_DEF_WEAPON,charaWeaponInts:nDealer:Mode)+"Type"),"Firearm","Explosive","Bow")
				IF charaWeaponInts:(nDealer):MagSize
					PossibleToAttack = 1
					SIF (charaWeaponInts:(nDealer):Ammo <= 0 && FA_WEAPON)
						PossibleToAttack = 0
				ELSE
					PossibleToAttack = 1
				ENDIF
				IF charaWeaponInts:(nDealer):MPCost
					SIF BASE:nDealer:7 < charaWeaponInts:(nDealer):MPCost
						PossibleToAttack = 0
				ENDIF
			ELSE
				PossibleToAttack = 1
			ENDIF
			FONTBOLD
			PRINTFORML 공격:
			FONTREGULAR
			CALL ASK_M( "공격", PossibleToAttack, "정밀 사격",!GROUPMATCH(GET_STR((nDealer), "Weapon", FA_DEF_WEAPON, WeapStats_Prefix(FA_DEF_WEAPON,charaWeaponInts:nDealer:Mode)+"Type"),"Explosive") && PossibleToAttack, "스킬", 1, "재장전",lcIsLethal && GROUPMATCH(GET_STR((nDealer),"Weapon", FA_DEF_WEAPON, WeapStats_Prefix(FA_DEF_WEAPON,charaWeaponInts:nDealer:Mode)+"Type"),"Firearm","Explosive","Bow"), "무기 변경", lcIsLethal, "대상을 전환한다.", 1, @"NPC 직접 제어 (%YesOrNo(lcDirectControl)%)", 1, "돌아가다", 1 )
			SELECTCASE RESULT
				CASE 0
				CASE 1
					PRINTFORML 공격할 신체 부위를 선택한다.
					FOR LOCAL:8,0,9
					SIF !LOCAL:8
						CONTINUE
					LOCAL:10 = EffectivePenetration(nTarget, AimedShotTranslate:(LOCAL:8), nDealer)
					LOCAL:9 = RESULT:1
					PRINTFORM [{LOCAL:8}] - %AimedShotParts:(LOCAL:8),10,LEFT%
					PRINTFORM (
					SETCOLOR C_ORANGE
					PRINTFORM {LIMIT(charaWeaponInts:(nDealer):Accuracy*AimedShotAcc:(LOCAL:8)/100,0,100),3}\%
					RESETCOLOR
					IF LOCAL:10
						SIF LOCAL:9
							LOCALS '= @"\@ CLOTHES_TR(CLOTHNAME(LOCAL:9,EQUIP:nTarget:(LOCAL:9))) != "" ? %CLOTHES_TR(CLOTHNAME(LOCAL:9,EQUIP:nTarget:(LOCAL:9)))% # 자연 방어력 \@"
						PRINTFORM  %LOCALS,15,LEFT%: 
						PRINTFORM %SoilStr(nTarget,3,1,LOCAL:9), 10% 
						RESETCOLOR
						PRINTFORM (PM {EffectivePenetration(nTarget, (AimedShotTranslate:(LOCAL:8)), nDealer)/100,2,RIGHT}, {ArmorCharges:nTarget:(LOCAL:9):0,5,RIGHT}/{ArmorCharges:nTarget:(LOCAL:9):1,5,LEFT}kJ)
					ENDIF
					PRINTFORML )
					NEXT
					PRINTFORML [99] - 뒤로
					INPUT
					IF RESULT <= 8
						AimedShot = RESULT
						charaWeaponInts:(nDealer):Accuracy = charaWeaponInts:(nDealer):Accuracy*AimedShotAcc:AimedShot/100
					ELSE
						FA_SUB = 0
						FA_MENUBYP = 1
						GOTO AttackLoop
					ENDIF
					;CALL GET_ACCURACYCHECK((nDealer))
				CASE 2
					PRINTFORML 　☆마법
					CALL CombatMagicDisplay(nDealer)
					PRINTFORML 　☆마법 카드
					FOR LOCAL, 1, 100
					;フラグ0番が100を兼ねているのでこの形に
					SIF currentSpellCards:LOCAL == 0
						BREAK
					LOCAL:4 = currentSpellCards:LOCAL/1000
					LOCAL:5 = currentSpellCards:LOCAL - (LOCAL:4*1000)
					IF GET_STR(LOCAL:4, "SpellCard", LOCAL:5, "名前") != ""
						;IF HasSpellCards:CHARA:LOCAL
						;	PRINTBUTTON @"%GET_STR(CHARA, "SpellCard", LOCAL, "名前")%", LOCAL
						;ELSE
						PRINTBUTTON @"%GET_STR(LOCAL:4, "SpellCard", LOCAL:5, "名前"), 80, LEFT%", LOCAL
						;ENDIF
						CALL PRINT_RANK(GET_INT(LOCAL:4, "SpellCard", LOCAL:5, "Grade"), "MAX_6")
						PRINTFORM  {GET_INT(LOCAL:4, "SpellCard", LOCAL:5, "Grade"), 2} 
						IF GET_INT(LOCAL:4, "SpellCard", LOCAL:5, "TSP")
							CALL PRINT_COLORBAR((GET_INT(LOCAL:4, "SpellCard", LOCAL:5, "TSP")), 4000, 30, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("水色"), RESULT:1)
							PRINTFORM  {GET_INT(LOCAL:4, "SpellCard", LOCAL:5, "TSP")} TSP/사용 
						ENDIF
						IF GET_INT(LOCAL:4, "SpellCard", LOCAL:5, "ESP")
							CALL PRINT_COLORBAR((GET_INT(LOCAL:4, "SpellCard", LOCAL:5, "ESP")), 4000, 30, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("オレンジ"), RESULT:1)
							PRINTFORM  {GET_INT(LOCAL:4, "SpellCard", LOCAL:5, "ESP")} ESP 사용 
						ENDIF
						SIF GET_INT(LOCAL:4, "SpellCard", LOCAL:5, "Last Spell")
							PRINTFORM (마지막 주문) 
						PRINTL
					ELSE
						BREAK
					ENDIF
					NEXT
					PRINTL
					PRINTFORML [-1] 나가기
					INPUT
					LOCAL:16 = RESULT
					SELECTCASE LOCAL:16
						CASE IS >= 600000000000
							VARSET NAS_ESP_Weapon
							TRYCALLFORM NAS_ESP_{DT_CELL_GET("combatMagic", LOCAL:16, "spellPage",1)}_{DT_CELL_GET("combatMagic", LOCAL:16, "spell",1)}
							$YoujutsuUseAlly
							IF STRFIND(NAS_ESP_Type, "Ally/") > -1
								PRINTFORML %NAS_ESP_NAME%을 받을 아군을 선택한다.
								FOR LOCAL:15, 0, 100
								IF !ATTACKER:(LOCAL:15)
									BREAK
								ENDIF
								LOCAL:19 = DT_CELL_GET("lcCombatants", ATTACKER:(LOCAL:15), "chara", 1)
								PRINTFORM [{LOCAL:19,3}] - %NAME:(LOCAL:19),20,LEFT% (
								CALL PRINT_RANK(GetCombatAbility(LOCAL:19),"MAX_6")
								PRINTFORM  {GetCombatAbility(LOCAL:19),2})
								PRINTL
								NEXT
								PRINTL
								SIF !NAS_ESP_DiaperSpell:nDealer:0
									PRINTFORML [-1] 취소
								INPUT
								LOCAL:17 = RESULT
								SELECTCASE LOCAL:17
									CASE IS >= 0
										SIF GetCombatant(LOCAL:17)
											nTarget = LOCAL:17
									CASE -1
										FA_SUB = 0
										FA_MENUBYP = 1
										GOTO AttackLoop
								ENDSELECT
							ENDIF
							$YoujutsuUse
							IF NAS_ESP_DiaperSpell:nDealer:(NAS_ESP_DiaperSpell:nDealer:Index)
								CALL PROCESS_YOUJUTSU_COMMAND(nDealer,nTarget,(NAS_ESP_DiaperSpell:nDealer:(NAS_ESP_DiaperSpell:nDealer:Index))/100,(NAS_ESP_DiaperSpell:nDealer:(NAS_ESP_DiaperSpell:nDealer:Index))%100,,1,"diaperSpell")
							ELSE
								CALL PROCESS_YOUJUTSU_COMMAND(nDealer,nTarget,DT_CELL_GET("combatMagic", LOCAL:16, "spellPage",1),DT_CELL_GET("combatMagic", LOCAL:16, "spell",1))
							ENDIF
							IF RESULT == -9530
								IF IS_VALID_FIGHTER
									GOTO AttackLoop
								ELSE
									lcDidInvalidMagic = 1
									GOTO NPC_RETRY_ATTACK
								ENDIF
							ENDIF
							IF NAS_ESP_DiaperSpell:nDealer:0
								NAS_ESP_DiaperSpell:nDealer:Index++
								SIF !NAS_ESP_DiaperSpell:nDealer:1
									NAS_ESP_DiaperSpell:nDealer:Index = 2
							ENDIF
							IF NAS_ESP_Weapon
								FA_WEAPON = NAS_ESP_Weapon
								CALLF EQUIPWEAPON(nDealer,FA_WEAPON,1)
								; EQUIP:nDealer:Weapon = FA_WEAPON
								; CALLF COM_WEAPSTATS(nDealer,NAS_ESP_Weapon,1,charaWeaponInts:nDealer:Mode,0)
								charaWeaponInts:(nDealer):Accuracy = GetShootingAccuracy(nDealer)
								TCVAR:(nDealer):Weap_Dodge = GetDodgeChance(nDealer)
							ELSE
								RETURN
							ENDIF
						CASE IS >= 0
							PickCard = currentSpellCards:RESULT
							$CardUse
							PRINTFORML %CALLNAME:nDealer%은(는) 주문 카드를 사용한다...
							CALL CHARA_CUTIN(TNAME(nDealer, 1, 1), NAME:nDealer, GET_STR(PickCard/1000, "SpellCard", PickCard - (PickCard/1000*1000), "名前"))
							SIF GET_INT(PickCard/1000, "SpellCard", PickCard - (PickCard/1000*1000), "ESP")
								BASE:nDealer:7 -= GET_INT(PickCard/1000, "SpellCard", PickCard - (PickCard/1000*1000), "ESP")
							SIF GET_INT(PickCard/1000, "SpellCard", PickCard - (PickCard/1000*1000), "Damage")
								charaWeaponInts:nDealer:Damage = GET_INT(PickCard/1000, "SpellCard", PickCard - (PickCard/1000*1000), "ESP")
							SIF GET_INT(PickCard/1000, "SpellCard", PickCard - (PickCard/1000*1000), "Accuracy")
								charaWeaponInts:nDealer:Accuracy = GET_INT(PickCard/1000, "SpellCard", PickCard - (PickCard/1000*1000), "Accuracy")/2
							SIF GET_INT(PickCard/1000, "SpellCard", PickCard - (PickCard/1000*1000), "Burst")
								charaWeaponInts:nDealer:Burst = GET_INT(PickCard/1000, "SpellCard", PickCard - (PickCard/1000*1000), "Burst")
							SIF GET_INT(PickCard/1000, "SpellCard", PickCard - (PickCard/1000*1000), "Pellets")
								charaWeaponInts:nDealer:Pellets = GET_INT(PickCard/1000, "SpellCard", PickCard - (PickCard/1000*1000), "Pellets")
						CASE -1
							FA_SUB = 0
							FA_MENUBYP = 1
							GOTO AttackLoop
					ENDSELECT
				CASE 3
					CALL WeaponReload((nDealer))
					RETURN
				CASE 4
					CALL Weapon_Chose_State(nDealer)
					PR_WEAPON = charaWeaponInts:nDealer:WeaponInventory ? charaWeaponInts:nDealer:WeaponInventory # EQUIP:(nDealer):Weapon
					FA_WEAPON = charaWeaponInts:nDealer:WeaponInventory ? charaWeaponInts:nDealer:WeaponInventory # EQUIP:(nDealer):Weapon
					FA_SUB = 0
					FA_MENUBYP = 1
					GOTO AttackLoop
				CASE 5
					FOR LOCAL:15, 0, 100
					IF !VICTIM:(LOCAL:15)
						BREAK
					ENDIF
					LOCAL:19 = DT_CELL_GET("lcCombatants", VICTIM:(LOCAL:15), "chara", 1)
