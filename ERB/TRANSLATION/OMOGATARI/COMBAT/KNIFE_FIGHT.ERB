	SELECTCASE AblUsed:1
		CASE IS >= UniversalRank("Extra")
			FirstWinBonus = 50
		CASE IS >= UniversalRank("S")
			FirstWinBonus = 30
		CASE IS >= UniversalRank("A")
			FirstWinBonus = 20
		CASE IS >= UniversalRank("B")
			FirstWinBonus = 10
		CASE IS >= UniversalRank("C")
			FirstWinBonus = 5
		CASE IS >= UniversalRank("D")
			FirstWinBonus = 3
		CASEELSE
			FirstWinBonus = 1
	ENDSELECT
