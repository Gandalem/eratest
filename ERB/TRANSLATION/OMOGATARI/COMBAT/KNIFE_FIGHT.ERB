@lcAfterBattle
#DIMS lcHTML,3
#DIMS lcBADName
#DIM CONST lcPadding = 38
SKIPDISP 0
;report
CUSTOMDRAWLINE ━
FONTBOLD
PRINTFORML %lcTitle%
SELECTCASE lcWarResult
	CASE 0, 1
		PRINTFORM %LCSideNames:lcWarResult% 승리
		IF CurrentBattle:Battle_PlayerSide > -1
			IF lcWarResult == CurrentBattle:Battle_PlayerSide
				TotalBattleStats:Battle_Win++
				TotalBattleStats:Battle_Streak++
				CALL COLORMESSAGE(@" (WIN)",C_GREEN,1,1)
			ELSEIF lcWarResult == !CurrentBattle:Battle_PlayerSide
				TotalBattleStats:Battle_Lose++
				CALL COLORMESSAGE(@" (LOSE)",C_RED,1,1)
			ENDIF
		ELSE
			PRINTL
		ENDIF
	CASEELSE
		CALL COLORMESSAGE(@"DRAW",C_PURPLE,1,1)
ENDSELECT
FONTREGULAR
CUSTOMDRAWLINE ━
FOR LOCAL,0,2
SETCOLOR C_AQUA
PRINTFORM %LCSideNames:LOCAL,lcPadding,LEFT%%COND_STR(" | ",!LOCAL)%
RESETCOLOR
NEXT
PRINTL
FOR LOCAL,0,2
SETCOLOR C_AQUA
PRINTFORM %"Power: "+PALAM_NUM_NAS(lcSidePower:LOCAL),lcPadding,LEFT%%COND_STR(" | ",!LOCAL)%
RESETCOLOR
NEXT
PRINTL
VARSET lcHTML
FOR LOCAL,0,2
lcHTML:LOCAL += @"%"Starting",12,LEFT%:"
lcHTML:LOCAL += DIGIT_GROUP(lcStartingUnits:LOCAL)
lcHTML:LOCAL += HTML_SPACE(MAX(lcPadding-HTML_STRINGLEN(lcHTML:LOCAL),0))
lcHTML:LOCAL += COND_STR(" | ",!LOCAL)
lcHTML:2 += lcHTML:LOCAL
NEXT
HTML_PRINT lcHTML:2
VARSET lcHTML
FOR LOCAL,0,2
lcHTML:LOCAL += @"%"Ending",12,LEFT%:"
lcHTML:LOCAL += DIGIT_GROUP(lcEndingUnits:LOCAL)
IF lcEndingUnits:LOCAL < lcStartingUnits:LOCAL
	lcHTML:LOCAL += HTML_PRINT_NAS(@" ({lcEndingUnits:LOCAL - lcStartingUnits:LOCAL})",,TO_HEX(C_RED))
ELSEIF lcEndingUnits:LOCAL > lcStartingUnits:LOCAL
	lcHTML:LOCAL += HTML_PRINT_NAS(@" (+{lcEndingUnits:LOCAL - lcStartingUnits:LOCAL})",,TO_HEX(C_GREEN))
ENDIF
lcHTML:LOCAL += HTML_SPACE(MAX(lcPadding-HTML_STRINGLEN(lcHTML:LOCAL),0))
lcHTML:LOCAL += COND_STR(" | ",!LOCAL)
lcHTML:2 += lcHTML:LOCAL
NEXT
HTML_PRINT lcHTML:2
CUSTOMDRAWLINE ━
IF lcPickFaction:0 > -1 && lcPickFaction:1 > -1
	CALL FactionDestroyCheck(lcPickFaction:0,lcPickFaction:1)
	CALL FactionDestroyCheck(lcPickFaction:1,lcPickFaction:0)
ENDIF
;then we add new stats
;only check if player was in the battle
IF CurrentBattle:Battle_PlayerSide > -1
	TotalBattleStats:Battle_Count++
	;win and lose are handled above
	IF lcWarResult == CurrentBattle:Battle_PlayerSide
		IF SaveIsEZB
			SIF LoG_EndDayAfterWin == 1
				LoG_EndDayAfterWin = 2
		ENDIF
	ELSEIF lcWarResult == !CurrentBattle:Battle_PlayerSide
	ELSE
		; IF SaveIsEZB
		;     CALLF LoG_ChangeRivalStanding(LOSER,"win",1)
		; ENDIF
		TotalBattleStats:Battle_Draw++
	ENDIF
	FOR LOCAL,0,VARSIZE("TotalBattleStats")
	SELECTCASE LOCAL
		CASE 0 TO 3, 10, 11, 13, 14, 19 TO 20
	ENDSELECT
	TotalBattleStats:LOCAL += CurrentBattle:LOCAL
	NEXT
	TotalBattleStats:Battle_DamageMax = MAX(TotalBattleStats:Battle_DamageMax, CurrentBattle:Battle_DamageMax)
	SIF CurrentBattle:Battle_Surrender
		TotalBattleStats:Battle_Surrender++
	TotalBattleStats:Battle_StreakMax = MAX(TotalBattleStats:Battle_StreakMax,TotalBattleStats:Battle_Streak)
ENDIF
PRINTFORML %조사처리(CALLNAME:MASTER,"의")% 능력치:
PRINTFORML B.A.D. 이름: %EZB_BAD_NAME()%
IF TotalBattleStats:Battle_Streak
	IF lcWarResult == !CurrentBattle:Battle_PlayerSide && CurrentBattle:Battle_PlayerSide != -1
		CALL COLORMESSAGE(@"연승이 끊겼다! (최고 기록 {TotalBattleStats:Battle_StreakMax})",C_RED,1,1)
		TotalBattleStats:Battle_Streak = 0
	ELSE
		CALL COLORMESSAGE(@"승리 스윕: {TotalBattleStats:Battle_Streak} (최대 {TotalBattleStats:Battle_StreakMax})",C_GREEN,1,1)
	ENDIF
ENDIF
PRINTL
PRINTFORML 턴: {TURNS}
PRINTL
PRINTFORML 입힌 대미지: {CurrentBattle:Battle_Damage}
PRINTFORML 처치한 적: {CurrentBattle:Battle_Beat}
PRINTFORML 처치 수: {CurrentBattle:Battle_Kills}
PRINTFORML 명중률: {(CurrentBattle:Battle_Hits*100)/MAX(1,CurrentBattle:Battle_Attacks)}\%
PRINTL
PRINTFORML 적이 당신에게 공격한다: {CurrentBattle:Battle_AttacksAgainst}
PRINTFORML 적의 공격이 명중했다: {CurrentBattle:Battle_GotHit}
PRINTFORML 적의 공격을 회피했다: {CurrentBattle:Battle_Dodges}
PRINTFORML 받은 대미지: {CurrentBattle:Battle_DamageTaken}
; IF SAVEIsEZB
;     EasyBattleExpToGet = 0
;     IF EasyBattleLevel > EasyBattlePreviousLevel
;         PRINTL
;         CALL COLORMESSAGE(@"LEVEL UP!",C_AQUA,1,1)
;         CALL COLORMESSAGE(@"Your Easy Battle Rank has increased to level {EasyBattleLevel}.",C_AQUA,1,0)
;     ENDIF
; ENDIF
IF BADNamePrevious != EZB_BAD_NAME()
	PRINTL
	CALL COLORMESSAGE(@"B.A.D. NAME이 변경되었다.",C_AQUA,1,1)
	CALL COLORMESSAGE(@"%BADNamePrevious% -> %EZB_BAD_NAME()%",C_AQUA,1,0)
ENDIF
CUSTOMDRAWLINE ━
CALL LoG_AdvanceTutorial(80)
SIF RESULT
	RETURN
FORCEWAIT
IF LoG_EndDayAfterWin == 2
	CALL OYASUMI
ENDIF

