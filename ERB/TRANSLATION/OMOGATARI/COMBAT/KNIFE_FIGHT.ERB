@ATTACKER_DAMAGE_TYPE(ARG,ARG:1)
#FUNCTION
IF lcIsLethal
	IF CharaWeaponInts:ARG:DamageType
		RETURNF CharaWeaponInts:ARG:DamageType
	ELSEIF GET_INT((ARG), "Weapon", ARG:1, WeapStats_Prefix(ARG:1,charaWeaponInts:ARG:Mode)+"Incendiary")
		RETURNF 3
	ENDIF
	IF STRCOUNT(GET_STR((ARG), "Weapon", ARG:1, WeapStats_Prefix(ARG:1,charaWeaponInts:ARG:Mode)+"Class"), "Blunt")
		RETURNF 6
	ELSEIF STRCOUNT(GET_STR((ARG), "Weapon", ARG:1, WeapStats_Prefix(ARG:1,charaWeaponInts:ARG:Mode)+"Class"), "Blade")
		RETURNF 2
	ELSEIF GET_STR((ARG), "Weapon", ARG:1, WeapStats_Prefix(ARG:1,charaWeaponInts:ARG:Mode)+"Type") == "Firearm"
		RETURNF 1
	ENDIF
ELSE
	RETURNF 1
ENDIF

@WEAP_DAMAGE_TYPE(ARG)
#FUNCTION
IF PreviewWeaponInts:DamageType
	RETURNF PreviewWeaponInts:DamageType
ELSEIF STRCOUNT(GET_STR(, "Weapon", ARG, "Class"), "Blunt")
	RETURNF 6
ELSEIF STRCOUNT(GET_STR(, "Weapon", ARG, "Class"), "Blade")
	RETURNF 2
ELSEIF GET_STR(, "Weapon", ARG, "Type") == "Firearm"
	RETURNF 1
ENDIF

@FIRE_WEAPON_SHOT(VICTIM,DealerID,RecipientID,weaponID,inCombat,AimedShot,TruncatedAttacks,isAlwaysLethal=0,AlwaysHits=0)
#DIM          DealerID
#DIM          RecipientID
#DIM          TruncatedAttacks
#DIM          weaponID
#DIM          GetDamageType
#DIM  REF     VICTIM
#DIM  DYNAMIC isAlwaysLethal=0
#DIM  DYNAMIC AlwaysHits
#DIM  DYNAMIC AttackIsDodged
#DIM  DYNAMIC AttackGoesToAnother
#DIM  DYNAMIC AttackIsMissed
#DIM  DYNAMIC nDMG
#DIM  DYNAMIC AttackReflected
#DIM  DYNAMIC AimedShot
#DIM  DYNAMIC nDMGMultiplier
#DIM  DYNAMIC nDMGPart
#DIM  DYNAMIC inCombat
#DIM  DYNAMIC weaponIsFired
#DIM  DYNAMIC multiHitCount
#DIM  DYNAMIC multiHitMax
#DIM  DYNAMIC RecipientTempID
#DIM  DYNAMIC hitIsDirect
#DIMS DYNAMIC nDMGPartBroad
weaponIsFired = 0
IF lcIsLethal || !inCombat
	IF weaponID && (weaponID == EQUIP:DealerID:Weapon || weaponID == charaWeaponInts:DealerID:WeaponInventory) && charaWeaponInts:(DealerID):MagSize
		weaponIsFired = 1
		charaWeaponInts:(DealerID):Ammo --
	ELSEIF charaWeaponInts:(DealerID):MPCost && TALENT:(DealerID):ESP && !NAS_ESP_DiaperSpell
		BASE:(DealerID):法力 -= charaWeaponInts:(DealerID):MPCost
	ENDIF
ELSE
	IF GETBIT(TALENT:DealerID:ESP,0)
		BASE:(DealerID):法力 --
	ENDIF
ENDIF
SIF !TruncatedAttacks
	CALL PlayFireSound((DealerID))
SIF charaWeaponInts:(DealerID):Ammo < 0 && weaponIsFired == 1
	RETURN -4
;PRINTFORMW 3/8 pellets hit %CALLNAME:nTarget%
FOR LOCAL:7, 1, charaWeaponInts:(DealerID):Pellets+1
hitIsDirect = 0
IF inCombat
	CALL FISHER_YATES_SHAFFLE(100, -1)
	SHAFFLE_ARRAY:0 = GetCombatant(RecipientID)
	multiHitMax = charaWeaponInts:DealerID:MultiHit
	multiHitCount = 0
	IF DealerID == MASTER
		CurrentBattle:Battle_Attacks++
	ELSEIF RecipientID == MASTER
		CurrentBattle:Battle_AttacksAgainst++
	ENDIF
	FOR LOCAL:9, 0, 100
	IF SHAFFLE_ARRAY:(LOCAL:9) >= VARSIZE("VICTIM")
		LOCAL:10 = SHAFFLE_ARRAY:(LOCAL:9)
	ELSE
		LOCAL:10 = VICTIM:(SHAFFLE_ARRAY:(LOCAL:9))
	ENDIF
	RecipientTempID = DT_CELL_GET("lcCombatants", LOCAL:10, "chara", 1)
	;PRINTFORML Trying to find victim #{LOCAL:13} (table {LOCAL:10})
	IF !LOCAL:10
		CONTINUE
		;ELSEIF multiHitCount > multiHitMax || (!multiHitMax && (RecipientTempID) != RecipientID)
	ELSEIF multiHitCount > multiHitMax || (multiHitCount != 0 && (RecipientTempID) == RecipientID) || (!multiHitMax && (RecipientTempID) != RecipientID)
		BREAK
	ENDIF
	lcDamageDeal:RecipientTempID:96++
	CALL HIT_BY_CHARACTER(DealerID,RecipientTempID,weaponID,1,AimedShot,TruncatedAttacks)
	multiHitCount ++
	SELECTCASE RESULT
		CASE -1,-2
			;miss
			MissCounter ++
		CASE -6, -7
			;go to another target
			MissCounter ++
			multiHitMax ++
		CASEELSE
			hitIsDirect = 1
	ENDSELECT
	NEXT
ELSE
	CALL HIT_BY_CHARACTER(DealerID,RecipientID,weaponID,0,AimedShot,TruncatedAttacks)
ENDIF
NEXT
IF DT_EXIST("fragmentationTemp") || DT_EXIST("explosionTemp")
	FOR LOCAL:9, 0, 100
	IF SHAFFLE_ARRAY:(LOCAL:9) >= VARSIZE("VICTIM")
		LOCAL:10 = SHAFFLE_ARRAY:(LOCAL:9)
	ELSE
		LOCAL:10 = VICTIM:(SHAFFLE_ARRAY:(LOCAL:9))
	ENDIF
	SIF DT_CELL_GET("lcCombatants", LOCAL:10, "chara", 1) == RecipientID || LOCAL:10 == 0
		CONTINUE
	CALL HIT_BY_FRAGMENT(DT_CELL_GET("lcCombatants", LOCAL:10, "chara", 1),1,0)
	CALL HIT_BY_EXPLOSION(DT_CELL_GET("lcCombatants", LOCAL:10, "chara", 1),1,0)
	NEXT
ENDIF
DT_RELEASE "fragmentationTemp"
DT_RELEASE "explosionTemp"

@HIT_BY_CHARACTER(DealerID,RecipientID,weaponID,inCombat,AimedShot,TruncatedAttacks,isAlwaysLethal=0,AlwaysHits=0,CriticalShot=-1)
#DIM GetDamageType
#DIM DealerID
#DIM DealerCombatID
#DIM RecipientID
#DIM RecipientCombatID
#DIM TruncatedAttacks
#DIM weaponID
#DIM DYNAMIC isAlwaysLethal=0
#DIM DYNAMIC AlwaysHits
#DIM DYNAMIC AttackIsDodged
#DIM DYNAMIC AttackGoesToAnother
#DIM DYNAMIC AttackIsMissed
#DIM DYNAMIC nDMG
#DIM DYNAMIC AttackReflected
#DIM DYNAMIC AimedShot
#DIM DYNAMIC nDMGMultiplier
#DIM DYNAMIC CriticalShot
#DIMS DYNAMIC nDMGPartBroad
#DIM DYNAMIC nDMGPart
#DIM DYNAMIC inCombat
GetDamageType = CharaWeaponInts:DealerID:DamageType
SIF !GetDamageType
	GetDamageType = WEAP_DAMAGE_TYPE(EQUIP:DealerID:Weapon)
SIF !GetDamageType
	GetDamageType = 1
TCVAR:(RecipientID):Weap_Dodge = GetDodgeChance(RecipientID)
$RepeatAttack
KilledBy:(RecipientID):0 = DealerID
KilledWith:(RecipientID):0 = {weaponID}
AttackIsDodged = 0
AttackGoesToAnother = 0
AttackReflected = 0
AttackIsMissed = 0
SIF AlwaysHits
	GOTO AlwaysHit
IF RAND:(100) > (charaWeaponInts:(DealerID):Accuracy) || charaWeaponInts:(DealerID):Accuracy <= 0
	CALL INTERACTIVE_TUTORIAL_GET(102,201,"Misses",4)
	CALL INTERACTIVE_TUTORIAL_GET(102,202,"Misses",4)
	SIF !TruncatedAttacks
		CALL LC_PRINT(@"[\@ (DealerID) == MASTER ? %PARSE("You")% # %CALLNAME:(DealerID)% \@ completely \@ (DealerID) == MASTER ? 놓친다 # 놓친다 \@] !  ", , 1,)
	lcDamageDeal:(RecipientID):99 ++
	$MissCheck
	;little chance that missed bullet goes into another touhou
	IF RAND(100) < (CharaWeaponInts:DealerID:DivertToOther ? CharaWeaponInts:DealerID:DivertToOther# 50)
		SIF !TruncatedAttacks
			PRINTFORML 놓친 공격이 다른 대상에게 곧바로 들어간다!
	ENDIF
	;RETURN -1 - (5*AttackGoesToAnother) - (AttackIsDodged)
	AttackIsMissed = 1
	GOTO ExplosiveCheck
ELSEIF RAND:(100) <= TCVAR:(RecipientID):Weap_Dodge
	SIF !TruncatedAttacks
		CALL LC_PRINT(@"\@ (DealerID) == MASTER ? %PARSE("Your")% # %CALLNAME:(DealerID)% \@attack was dodged by \@ (RecipientID) == MASTER ? 너 # %CALLNAME:(RecipientID)% \@에 의해 회피되었다!  ", , 1,)
	MissCounter ++
	lcDamageDeal:(RecipientID):98 ++
	AttackIsDodged = 1
	SIF RecipientID == MASTER
		CurrentBattle:Battle_Dodges++
	GOTO MissCheck
ENDIF
$AlwaysHit
nDMG = charaWeaponInts:(DealerID):Damage
;defense
;SELECTCASE nDmgType
;CASE 1,2,6
nDMG = nDMG*100/BUFF_MULTIPLIER(DT_CELL_GET("lcCombatants", GetCombatant(RecipientID), "defenseBuff", 1))
;desperation, up to stage 6
SELECTCASE PeeBarStage(RecipientID)
	CASE 2
		TIMES nDMG, 1.25
	CASE 3
		TIMES nDMG, 1.5
	CASE 4
		TIMES nDMG, 1.75
	CASE 5
		TIMES nDMG, 2.0
	CASE 6
		TIMES nDMG, 2.25
ENDSELECT
SELECTCASE PooBarStage(RecipientID)
	CASE 2
		TIMES nDMG, 1.25
	CASE 3
		TIMES nDMG, 1.5
	CASE 4
		TIMES nDMG, 1.75
	CASE 5
		TIMES nDMG, 2.0
	CASE 6
		TIMES nDMG, 2.25
ENDSELECT
IF STRFIND(PrintWeaponType(dealerID,weaponID),"Melee/") > -1
	SIF TALENT:dealerID:力持ち
		TIMES nDMG, 1.5
	SELECTCASE TALENT:dealerID:100
		CASE -5
			TIMES nDMG, 0.2
		CASE -4
			TIMES nDMG, 0.35
		CASE -3
			TIMES nDMG, 0.6
		CASE -2
			TIMES nDMG, 0.8
		CASE -1
			TIMES nDMG, 0.95
		CASE 1
			TIMES nDMG, 1.1
		CASE 2
			TIMES nDMG, 1.3
		CASE 5
			TIMES nDMG, 2.25
	ENDSELECT
ENDIF
; CASEELSE
; nDMG = nDMG*100/BUFF_MULTIPLIER(DT_CELL_GET("lcCombatants", GetCombatant(RecipientID), "magicDefenseBuff", 1))
; ENDSELECT
;reflected
IF (DamageResist:(RecipientID):(GetDamageType):1 == 7 && lcIsLethal) || DT_CELL_GET("lcCombatants", GetCombatant(RecipientID), "protectBuff", 1)
	IF !LC_REFLECTED
		SETCOLOR C_RED
		IF DT_CELL_GET("lcCombatants", GetCombatant(RecipientID), "protectBuff", 1)
			CALL LC_PRINT(@"%CALLNAME:(RecipientID)%의 방어막이 공격을 %CALLNAME:DealerID%에게 반사했다!", , 2,)
		ELSE
			CALL LC_PRINT(@"%CALLNAME:(RecipientID)%의【%MagicTypeStrength(GetDamageType,DamageResist:(RecipientID):(GetDamageType):1,2)%】이 공격을 %CALLNAME:DealerID%에게 반사했다!", , 2,)
		ENDIF
		RESETCOLOR
	ENDIF
	RecipientID = DealerID
	LC_REFLECTED = 1
	;GOTO RepeatAttack
ENDIF
;Quest Stuff
SIF YoujutsuQuestProgress:(RecipientID):9 > 30000
	YoujutsuQuestProgress:(RecipientID):9 = 30001
;===============
lcDamageDeal:(RecipientID):97 ++
IF AimedShot
	$BalisticAimed
	nDMGPart = AimedShotInfo(AimedShot)
	nDMGMultiplier = RESULT:1
	nDMGPartBroad '= RESULTS:1
	nDMG = charaWeaponInts:(DealerID):Damage
	IF lcIsLethal || isAlwaysLethal
		;DamageMitigate(TARGET,MASTER,1371,1,0,0,1)
		nDMG = DamageMitigate(RecipientID,DealerID,nDMG,nDMGPart,0,0,1)
		STAIN:RecipientID:5 |= 64
		SIF !charaWeaponInts:(DealerID):NonLethal
			CALLF BroadDamage((RecipientID),nDMGPartBroad,charaWeaponInts:(DealerID):Damage,GetDamageType,(DealerID),printweaponname(DealerID,,-1))
	ENDIF
	lcDamageDeal:(RecipientID):0 += (nDMG*nDMGMultiplier/100)
	lcDamageDeal:(RecipientID):(nDMGPart) += (nDMG*nDMGMultiplier/100)
	IF DealerID == MASTER
		CurrentBattle:Battle_Hits++
	ELSEIF RecipientID == MASTER
		CurrentBattle:Battle_GotHit++
	ENDIF
	SIF !TruncatedAttacks
		PRINTFORML %CALLNAME:DealerID%은 %CALLNAME:(RecipientID)%에게 %CALLNAME:(RecipientID)%의 피해를 입혔다.
	SIF STRLENS(charaWeaponSTRs:DealerID:HitEffect)
		TRYCALLFORM %charaWeaponSTRs:DealerID:HitEffect%(RecipientID,DealerID)
	CALL CREATE_HIT_FRAGMENTS(DealerID,RecipientID,AimedShot)
	CALL CREATE_HIT_EXPLOSION(DealerID,RecipientID,AimedShot)
ELSE
	IF IsInCover:(RecipientID):0 &&  !STRCOUNT(GET_STR((DealerID), "Weapon", weaponID, WeapStats_Prefix(weaponID,charaWeaponInts:DealerID:Mode)+"Class"), "Blunt") && !STRCOUNT(GET_STR((DealerID), "Weapon", weaponID, WeapStats_Prefix(weaponID,charaWeaponInts:DealerID:Mode)+"Class"), "Blade")  && !STRCOUNT(GET_STR((DealerID), "Weapon", weaponID, WeapStats_Prefix(weaponID,charaWeaponInts:DealerID:Mode)+"Type"), "Youjutsu")
		IF GET_INT((DealerID), "Weapon", weaponID, WeapStats_Prefix(weaponID,charaWeaponInts:DealerID:Mode)+"Penetration") < CoverStrength:(IsInCover:(RecipientID):0)
			IF !RAND:4
				SIF !TruncatedAttacks
					CALL LC_PRINT(@"하지만 %CoverTypes:(IsInCover:(RecipientID):0)%는 효과가 없었다!", , 1,)
			ELSE
				IF !TruncatedAttacks
					CALL LC_PRINT(@"<%CoverTypes:(IsInCover:(RecipientID):0)%이 총알을 막았다!>", C_YELLOW, 1,)
				ENDIF
				RETURN 0
			ENDIF
		ELSE
			SIF !TruncatedAttacks
				CALL LC_PRINT(@"%CALLNAME:(RecipientID)%의 방어가 뚫렸다!", , 1,)
		ENDIF
	ENDIF
	;CriticalShot
	AimedShot = RAND(1,VARSIZE("AimedShotParts"))
	; SELECTCASE RAND(100)
	; CASE IS < charaWeaponInts:(DealerID):Accuracy/4
	;     AimedShot = 1
	; CASE IS < charaWeaponInts:(DealerID):Accuracy/2
	;     SELECTCASE RAND:4
	;     CASE 0
	;         AimedShot = 7
	;     CASE 1
	;         AimedShot = 8
	;     CASE 2
	;         AimedShot = 3
	;     CASE 3
	;         AimedShot = 4
	;     ENDSELECT
	; CASEELSE
	;     SELECTCASE RAND:3
	;     CASE 0
	;         AimedShot = 5
	;     CASE 1
	;         AimedShot = 2
	;     CASE 2
	;         AimedShot = 6
	;     ENDSELECT
	; ENDSELECT
	GOTO BalisticAimed
ENDIF
$ExplosiveCheck
;theoretically having a very easy integer that we can change that automatically determines multi-hit
IF AttackIsMissed
	CALL CREATE_HIT_FRAGMENTS(DealerID,RecipientID,0)
	CALL CREATE_HIT_EXPLOSION(DealerID,RecipientID,0)
ENDIF
CALL HIT_BY_FRAGMENT(RecipientID,1,AimedShot)
CALL HIT_BY_EXPLOSION(RecipientID,1,AimedShot)
RETURN -AttackIsMissed - (5*AttackGoesToAnother) - (AttackIsDodged)

@CREATE_HIT_FRAGMENTS(DealerID,RecipientID=-1,directHit)
#DIM GetDamageType
#DIM DealerID
#DIM RecipientID
#DIM nDMG
#DIM directHit
#DIM fragmentMax
SIF !charaWeaponInts:DealerID:Fragmentation
	RETURN
IF !DT_EXIST("fragmentationTemp")
	DT_CREATE "fragmentationTemp"
	DT_COLUMN_ADD "fragmentationTemp", "damage", "int32"
	DT_COLUMN_ADD "fragmentationTemp", "damageType", "int32"
	DT_COLUMN_ADD "fragmentationTemp", "size", "int32"
	DT_COLUMN_ADD "fragmentationTemp", "owner", "int32"
	DT_COLUMN_ADD "fragmentationTemp", "intendedVictim", "int32"
	DT_COLUMN_ADD "fragmentationTemp", "checkedByTouhou", "int32"
	DT_COLUMN_ADD "fragmentationTemp", "directHit", "int32"
ENDIF
fragmentMax = RAND(0,charaWeaponInts:DealerID:Fragmentation+1)
FOR LOCAL,0,fragmentMax
nDMG = charaWeaponInts:(DealerID):FragmentationDamage
GetDamageType = charaWeaponInts:(DealerID):FragmentationDamageType
SIF !GetDamageType
	GetDamageType = 2
DT_ROW_ADD @"fragmentationTemp", "owner",           DealerID, "intendedVictim",  RecipientID, "damage",          RAND(15,MAX(15,nDMG+1)), "damageType",      GetDamageType, "size",            charaWeaponInts:(DealerID):FragmentationSize, "checkedByTouhou", 0, "directHit",       directHit
NEXT

@HIT_BY_FRAGMENT(RecipientID,inCombat,shotTargetPart,isAlwaysLethal=0,AlwaysHits=0)
#DIM DealerID
#DIM RecipientID
#DIM FragmentsList, 500
#DIM FragmentsTotal
#DIM nDMG
#DIM GetDamageType
#DIM F_ID
#DIM DYNAMIC nDMGMultiplier
#DIMS DYNAMIC nDMGPartBroad
#DIM DYNAMIC nDMGPart
#DIM DYNAMIC inCombat
#DIM DYNAMIC shotTargetPart
#DIM DYNAMIC isAlwaysLethal
#DIM DYNAMIC AlwaysHits
#DIM DYNAMIC RandomSpread
SELECTCASE shotTargetPart
	CASE 0
		RandomSpread = 1
	CASEELSE
		RandomSpread = 0
ENDSELECT
IF DT_EXIST("fragmentationTemp")
	VARSET FragmentsList
	FragmentsTotal = DT_SELECT("fragmentationTemp",,,FragmentsList)
	FOR LOCAL,0,FragmentsTotal
	SIF RandomSpread
		shotTargetPart = RAND(1,9)
	nDMGPart = AimedShotInfo(shotTargetPart)
	nDMGMultiplier = RESULT:1
	nDMGPartBroad '= RESULTS:1
	F_ID = FragmentsList:LOCAL
	nDMG = DT_CELL_GET("fragmentationTemp", F_ID, "damage",1)
	GetDamageType = DT_CELL_GET("fragmentationTemp", F_ID, "damageType",1)
	DealerID = DT_CELL_GET("fragmentationTemp", F_ID, "owner",1)
	IF DT_CELL_GET("fragmentationTemp", F_ID, "intendedVictim",1) == RecipientID
		IF DT_CELL_GET("fragmentationTemp", F_ID, "directHit",1) == shotTargetPart
			;direct hit
			$HitFragment
			;;#; DEBUGPRINTFORML fragment hit %CALLNAME:RecipientID% for {nDMG} (multiplier {nDMGMultiplier}) on part {nDMGPart}
			IF lcIsLethal || isAlwaysLethal
				SIF !charaWeaponInts:(DealerID):NonLethal
					CALLF BroadDamage((RecipientID),nDMGPartBroad,nDMG,GetDamageType,(DealerID),printWeaponName(DealerID,,-1)+" fragment")
			ENDIF
			lcDamageDeal:(RecipientID):0 += (nDMG*nDMGMultiplier/100)
			lcDamageDeal:(RecipientID):(nDMGPart) += (nDMG*nDMGMultiplier/100)
			IF DT_CELL_GET("fragmentationTemp", F_ID, "directHit",1) == shotTargetPart
				DT_CELL_SET "fragmentationTemp", F_ID, "checkedByTouhou", DT_CELL_GET("fragmentationTemp", F_ID, "checkedByTouhou",1)+1, 1
				IF DT_CELL_GET("fragmentationTemp", F_ID, "checkedByTouhou",1) >= ExplosionSizeTohuous(DT_CELL_GET("fragmentationTemp", F_ID, "size",1))
					DT_ROW_REMOVE "fragmentationTemp", F_ID
				ENDIF
			ELSE
				DT_ROW_REMOVE "fragmentationTemp", F_ID
			ENDIF
		ELSE
			GOTO NonHit
		ENDIF
	ELSE
		$NonHit
		IF RAND(100) < 33
			GOTO HitFragment
		ELSE
			DT_CELL_SET "fragmentationTemp", F_ID, "checkedByTouhou", DT_CELL_GET("fragmentationTemp", F_ID, "checkedByTouhou",1)+1, 1
			IF DT_CELL_GET("fragmentationTemp", F_ID, "checkedByTouhou",1) >= ExplosionSizeTohuous(DT_CELL_GET("fragmentationTemp", F_ID, "size",1))
				DT_ROW_REMOVE "fragmentationTemp", F_ID
			ENDIF
		ENDIF
	ENDIF
	NEXT
ENDIF

@CREATE_HIT_EXPLOSION(DealerID,RecipientID=-1,directHit)
#DIM GetDamageType
#DIM DealerID
#DIM RecipientID
#DIM nDMG
#DIM directHit
SIF !charaWeaponInts:DealerID:IsExplosive
	RETURN
IF !DT_EXIST("explosionTemp")
	DT_CREATE "explosionTemp"
	DT_COLUMN_ADD "explosionTemp", "damage", "int32"
	DT_COLUMN_ADD "explosionTemp", "damageType", "int32"
	DT_COLUMN_ADD "explosionTemp", "size", "int32"
	DT_COLUMN_ADD "explosionTemp", "owner", "int32"
	DT_COLUMN_ADD "explosionTemp", "intendedVictim", "int32"
	DT_COLUMN_ADD "explosionTemp", "checkedByTouhou", "int32"
	DT_COLUMN_ADD "explosionTemp", "directHit", "int32"
ENDIF
FOR LOCAL,0,charaWeaponInts:DealerID:IsExplosive
nDMG = charaWeaponInts:(DealerID):ExplosiveDamage
GetDamageType = charaWeaponInts:(DealerID):ExplosiveDamageType
SIF !GetDamageType
	GetDamageType = 2
DT_ROW_ADD @"explosionTemp", "owner",           DealerID, "intendedVictim",  RecipientID, "damage",          nDMG, "damageType",      GetDamageType, "size",            charaWeaponInts:(DealerID):ExplosiveSize, "checkedByTouhou", 0, "directHit",       directHit
NEXT

@HIT_BY_EXPLOSION(RecipientID,inCombat,shotTargetPart,isAlwaysLethal=0,AlwaysHits=0)
#DIM DealerID
#DIM RecipientID
#DIM explosionsList, 500
#DIM FragmentsTotal
#DIM nDMG
#DIM GetDamageType
#DIM F_ID
#DIM DYNAMIC nDMGMultiplier
#DIMS DYNAMIC nDMGPartBroad
#DIM DYNAMIC nDMGPart
#DIM DYNAMIC inCombat
#DIM DYNAMIC shotTargetPart
#DIM DYNAMIC isAlwaysLethal
#DIM DYNAMIC AlwaysHits
#DIM DYNAMIC RandomSpread
#DIM DYNAMIC explosionSize
#DIM DYNAMIC explosionAccuracy
#DIM DYNAMIC nDMGRangeMultiplier
SELECTCASE shotTargetPart
	CASE 0
		RandomSpread = 1
	CASEELSE
		RandomSpread = 0
ENDSELECT
IF DT_EXIST("explosionTemp")
	VARSET explosionsList
	FragmentsTotal = DT_SELECT("explosionTemp",,,explosionsList)
	nDMGRangeMultiplier = 100
	FOR LOCAL,0,FragmentsTotal
	SIF RandomSpread
		shotTargetPart = RAND(1,9)
	nDMGPart = AimedShotInfo(shotTargetPart)
	nDMGMultiplier = RESULT:1
	nDMGPartBroad '= RESULTS:1
	F_ID = explosionsList:LOCAL
	nDMG = DT_CELL_GET("explosionTemp", F_ID, "damage",1)
	GetDamageType = DT_CELL_GET("explosionTemp", F_ID, "damageType",1)
	DealerID = DT_CELL_GET("explosionTemp", F_ID, "owner",1)
	explosionSize = DT_CELL_GET("explosionTemp", F_ID, "size",1)
	;#; DEBUGPRINTFORML explosion: victim {RecipientID} (int {DT_CELL_GET("explosionTemp", F_ID, "intendedVictim",1)}), part {shotTargetPart} (int: {DT_CELL_GET("explosionTemp", F_ID, "directHit",1)})
	IF DT_CELL_GET("explosionTemp", F_ID, "intendedVictim",1) == RecipientID
		;direct hit
		IF DT_CELL_GET("explosionTemp", F_ID, "directHit",1) == shotTargetPart
			$HitDirect
			;;#; DEBUGPRINTFORML fragment hit %CALLNAME:RecipientID% for {nDMG} (multiplier {nDMGMultiplier}) on part {nDMGPart}
			IF lcIsLethal || isAlwaysLethal
				SIF !charaWeaponInts:(DealerID):NonLethal
					CALLF BroadDamage((RecipientID),explosionSize >= 3 ? "fullbody" # nDMGPartBroad,nDMG*nDMGRangeMultiplier/100,GetDamageType,(DealerID),printWeaponName(DealerID,,-1)+" explosion")
			ENDIF
			lcDamageDeal:(RecipientID):0 += (nDMG*nDMGMultiplier*nDMGRangeMultiplier/10000)
			lcDamageDeal:(RecipientID):(nDMGPart) += (nDMG*nDMGMultiplier*nDMGRangeMultiplier/10000)
			DT_CELL_SET "explosionTemp", F_ID, "checkedByTouhou", DT_CELL_GET("explosionTemp", F_ID, "checkedByTouhou",1)+1, 1
			IF DT_CELL_GET("explosionTemp", F_ID, "checkedByTouhou",1) >= ExplosionSizeTohuous(explosionSize)
				DT_ROW_REMOVE "explosionTemp", F_ID
			ENDIF
		ELSE
			GOTO NonHit
		ENDIF
	ELSE
		$NonHit
		nDMGRangeMultiplier = RAND(0,10)
		SELECTCASE nDMGRangeMultiplier
			CASE 0
				nDMGRangeMultiplier = 90
			CASE 1
				nDMGRangeMultiplier = 80
			CASE 2
				nDMGRangeMultiplier = 70
			CASE 3
				nDMGRangeMultiplier = 60
			CASE 4
				nDMGRangeMultiplier = 50
			CASE 5
				nDMGRangeMultiplier = 40
			CASE 6
				nDMGRangeMultiplier = 30
			CASE 7
				nDMGRangeMultiplier = 20
			CASE 8
				nDMGRangeMultiplier = 10
			CASE 9
				;missed
				GOTO HitMiss
		ENDSELECT
		SELECTCASE explosionSize
			CASE 4
				explosionAccuracy = RAND(0,100+1)
			CASE 5
				explosionAccuracy = RAND(0,140+1)
			CASE 6
				explosionAccuracy = RAND(0,200+1)
			CASE 7
				explosionAccuracy = RAND(0,275+1)
			CASE 8
				explosionAccuracy = RAND(0,400+1)
			CASEELSE
				explosionAccuracy = 0
		ENDSELECT
		nDMGRangeMultiplier = nDMGRangeMultiplier*MIN(explosionAccuracy,100)/100
		IF RAND(100) < explosionAccuracy
			nDMGPartBroad '= "fullbody"
			GOTO HitDirect
		ELSE
			$HitMiss
			DT_CELL_SET "explosionTemp", F_ID, "checkedByTouhou", DT_CELL_GET("explosionTemp", F_ID, "checkedByTouhou",1)+1, 1
			IF DT_CELL_GET("explosionTemp", F_ID, "checkedByTouhou",1) >= ExplosionSizeTohuous(DT_CELL_GET("explosionTemp", F_ID, "size",1))
				DT_ROW_REMOVE "explosionTemp", F_ID
			ENDIF
		ENDIF
	ENDIF
	NEXT
ENDIF

