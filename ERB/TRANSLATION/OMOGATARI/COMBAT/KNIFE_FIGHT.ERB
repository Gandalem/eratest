@RetalitationProb(ARG)
#FUNCTION
#DIM DYNAMIC nPoints
;More likely to shoot at a hu with higher combat
IF GetCombatAbility(ARG) > 0
	;DEBUGPRINTFORML %CALLNAME:ARG% has {GetCombatAbility(ARG)} combat
	;DEBUGPRINTFORML %CALLNAME:ARG%'s weight was {nPoints}
	SELECTCASE GetCombatAbility(ARG)
		CASE IS >= UniversalRank("QuadUltra")
			nPoints += 9
		CASE IS >= UniversalRank("TriUltra")
			nPoints += 8
		CASE IS >= UniversalRank("OverDrive")
			nPoints += 7
		CASE IS >= UniversalRank("Phantasm")
			nPoints += 6
		CASE IS >=  UniversalRank("Extra")
			nPoints += 5
		CASE IS >=  UniversalRank("S")
			nPoints += 4
		CASE IS >=  UniversalRank("A")
			nPoints += 3
		CASE IS >=  UniversalRank("B")
			nPoints += 2
		CASE IS >=  UniversalRank("C")
			nPoints += 1
		CASEELSE
			nPoints += 0
	ENDSELECT
	;DEBUGPRINTFORML %CALLNAME:ARG%'s weight is now {nPoints}
ENDIF
;talents
nPoints += (2*TALENT:ARG:10) ; brave
nPoints += (1*TALENT:ARG:11) ; defiant
nPoints += (1*TALENT:ARG:12) ; cheeky
nPoints += (2*TALENT:ARG:13) ; prideful
nPoints += (2*TALENT:ARG:21) ; psycho
nPoints += (2*TALENT:ARG:22) ; desens
nPoints += (-1*TALENT:ARG:40) ; tough
;prioritize low health 2hus
IF BASE:ARG:0 > 500
	LOCAL:3 = 100 * (BASE:(ARG):体力-500) / (MAXBASE:(ARG):体力-500)
	;DEBUGPRINTFORML %CALLNAME:ARG% has {LOCAL:3}\% health
	;DEBUGPRINTFORML %CALLNAME:ARG%'s weight was {nPoints}
	SELECTCASE LOCAL:3
		CASE IS <= 10
			nPoints += -9
		CASE IS <= 20
			nPoints += -8
		CASE IS <= 30
			nPoints += -7
		CASE IS <= 40
			nPoints += -6
		CASE IS <=  50
			nPoints += -5
		CASEELSE
			nPoints += 0
	ENDSELECT
	;DEBUGPRINTFORML %CALLNAME:ARG%'s weight is now {nPoints}
ELSE
	nPoints = 0
ENDIF
RETURNF nPoints

@lcLineFormatting(ARG,nStage,nlcSide)
#DIM nStage
#DIM nlcSide
SELECTCASE nStage
	CASE 0
		LOCAL:3 = 100 * (BASE:ARG:体力-500) / (MAXBASE:ARG:体力-500)
		LOCALS = %CALLNAME:ARG%
		IF SaveIsEZB
			IF ARG == MASTER
				LOCALS '= EZB_BAD_NAME()
			ELSE
				LOCALS '= EZB_TITLES(LoG_RivalID(ARG))
			ENDIF
		ENDIF
		SIF (ARG) == MASTER
			SETCOLOR C_AQUA
		PRINTFORM %LOCALS,35,LEFT%
		RESETCOLOR
		SELECTCASE LOCAL:3
			CASE IS > 90
				CALL PRINT_COLORBAR, BASE:ARG:0-500, MAXBASE:ARG:0-500, 18, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("青")
			CASE IS > 75
				CALL PRINT_COLORBAR, BASE:ARG:0-500, MAXBASE:ARG:0-500, 18, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑")
			CASE IS > 50
				CALL PRINT_COLORBAR, BASE:ARG:0-500, MAXBASE:ARG:0-500, 18, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("黄色")
			CASE IS > 25
				CALL PRINT_COLORBAR, BASE:ARG:0-500,MAXBASE:ARG:0-500,18, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("オレンジ")
			CASEELSE
				CALL PRINT_COLORBAR, BASE:ARG:0-500,MAXBASE:ARG:0-500,18, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("赤")
		ENDSELECT
		PRINTFORM  (%PALAM_NUM_NAS(BASE:ARG:0-500),5%/%PALAM_NUM_NAS(MAXBASE:ARG:0-500),5%) 
		IF !lcIsLethal
			PRINTFORM {((DT_CELL_GET("lcCombatants", GetCombatant(ARG), "lives",1))),2} 생명 
		ELSE
			SETCOLOR GET_HEALTH_COLOR(ARG, BODY_PARTS_HEALTH_CALC(ARG),1)
			PRINTFORM ({BODY_PARTS_HEALTH_CALC(ARG),3}\% HP) 
			RESETCOLOR
		ENDIF
	CASE 1
		VARSET LOCALS
		FOR LOCAL,0,7
		IF DT_CELL_GET("lcCombatants", GetCombatant(ARG), BUFF_NAMES(LOCAL,2), 1)
			LOCALS:1 '= @"%BUFF_NAMES(LOCAL,1)%\@ DT_CELL_GET("lcCombatants", GetCombatant(ARG), BUFF_NAMES(LOCAL,2), 1) > 0 ? + #\@{DT_CELL_GET("lcCombatants", GetCombatant(ARG), BUFF_NAMES(LOCAL,2), 1)} "
			LOCALS += LOCALS:1
			IF DT_CELL_GET("lcCombatants", GetCombatant(ARG), BUFF_NAMES(LOCAL,2), 1) > 0
				SETCOLOR C_RED
			ELSE
				SETCOLOR C_P_BLUE
			ENDIF
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ENDIF
		NEXT
		IF DT_CELL_GET("lcCombatants", GetCombatant(ARG), "chargeBuff", 1)
			LOCALS:1 '= @"ATK 2.5x "
			LOCALS += LOCALS:1
			PRINTFORM %LOCALS:1%
		ENDIF
		IF DT_CELL_GET("lcCombatants", GetCombatant(ARG), "protectBuff", 1)
			LOCALS:1 '= @"BLOCK "
			LOCALS += LOCALS:1
			SETCOLOR C_P_PURPLE
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ENDIF
		IF DT_CELL_GET("lcCombatants", GetCombatant(ARG), "burnAilment", 1)
			LOCALS:1 '= @"FIRE "
			LOCALS += LOCALS:1
			SETCOLOR C_ORANGE
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ENDIF
		IF DT_CELL_GET("lcCombatants", GetCombatant(ARG), "poisonAilment", 1)
			LOCALS:1 '= @"PSN "
			LOCALS += LOCALS:1
			SETCOLOR C_P_PURPLE
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ENDIF
		IF DT_CELL_GET("lcCombatants", GetCombatant(ARG), "muteAilment", 1)
			LOCALS:1 '= @"MUTE "
			LOCALS += LOCALS:1
			SETCOLOR C_GRAY
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ENDIF
		IF DT_CELL_GET("lcCombatants", GetCombatant(ARG), "sleepAilment", 1)
			LOCALS:1 '= @"SLP "
			LOCALS += LOCALS:1
			SETCOLOR C_GRAY
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ENDIF
		IF HasBionicPart(ARG,132)
			LOCALS:1 '= @"BOMB "
			LOCALS += LOCALS:1
			SETCOLOR C_GREEN
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ENDIF
		IF PeeBarStage(ARG) >= 2
			LOCALS:1 '= @"PEE "
			LOCALS += LOCALS:1
			SETCOLOR Color_Gradient_PER(0xe1cb7f,C_RED,GetPercent(PeeBarStage(ARG),7))
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ENDIF
		IF PooBarStage(ARG) >= 2
			LOCALS:1 '= @"POO "
			LOCALS += LOCALS:1
			SETCOLOR Color_Gradient_PER(CF_JELLYORPOO(),C_RED,GetPercent(PooBarStage(ARG),7))
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ENDIF
		IF SoiledSelf:ARG:0 && SoiledSelf:ARG:1
			LOCALS:1 '= @"SOIL "
			LOCALS += LOCALS:1
			SETCOLOR C_D_RED
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ELSEIF SoiledSelf:ARG:0
			LOCALS:1 '= @"SOIL "
			LOCALS += LOCALS:1
			SETCOLOR 0xe1cb7f
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ELSEIF SoiledSelf:ARG:1
			LOCALS:1 '= @"SOIL "
			LOCALS += LOCALS:1
			SETCOLOR CF_JELLYORPOO()
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ENDIF
		;horni
		IF CFLAG:ARG:溜まってる度 >= 500
			LOCALS:1 '= @"HORNY "
			LOCALS += LOCALS:1
			SETCOLOR Color_Gradient_PER(C_GRAY,C_PINK,CFLAG:ARG:溜まってる度/10)
			PRINTFORM %LOCALS:1%
			RESETCOLOR
		ENDIF
		;pleasure
		FOR LOCAL,0,6
		SIF PALAM:ARG:LOCAL < PleasureRequired(ARG)/2
			CONTINUE
		LOCALS:1 '= @"%TOUPPER(PALAM_TR(PALAMNAME:LOCAL, "PalamSh"))% "
		LOCALS += LOCALS:1
		SETCOLOR Color_Gradient_PER(C_GRAY,C_PINK,GETPERCENT(PALAM:ARG:LOCAL-(PleasureRequired(ARG)/2),PleasureRequired(ARG)/2))
		PRINTFORM %LOCALS:1%
		RESETCOLOR
		NEXT
		PRINTFORM %"",35-STRLENS(LOCALS),LEFT%
		IF lcIsLethal
			PRINTFORM %CAPITALIZE(PrintWeaponName(ARG,EQUIP:ARG:Weapon,-1)),20,LEFT%
			IF charaWeaponInts:ARG:MagSize
				PRINTFORM ({charaWeaponInts:ARG:Ammo,5,RIGHT}/{charaWeaponInts:(ARG):MagSize,5,LEFT})
			ELSEIF GET_STR(ARG, "Weapon", lcIsLethal ? EQUIP:(ARG):Weapon # 0, WeapStats_Prefix(EQUIP:(ARG):Weapon,charaWeaponInts:ARG:Mode)+"Ammo") == "MP"  && HasAnyYoujutsu(ARG)
				PRINTFORM ({BASE:ARG:法力,5,RIGHT}/{MAXBASE:ARG:法力,5,LEFT})
			ELSE
				PRINTFORM %" "*13%
			ENDIF
		ELSE
			PRINTFORM %CAPITALIZE(GET_STR(ARG, "Weapon", 0, "名前")),20,LEFT% 
			PRINTFORM ({BASE:ARG:法力,5,RIGHT}/{MAXBASE:ARG:法力,5,LEFT})
		ENDIF
		PRINTFORM %" "%
		IF nlcSide
			CALL GET_DODGECHECK(ARG)
		ELSE
			CALL GET_ACCURACYCHECK(ARG)
		ENDIF
ENDSELECT
