		RESULTS:1 '= "rarm"
		RETURNF 30
	CASE 5
		RESULT:1 = 100
		RESULTS:1 '= "stomach"
		RETURNF 53
	CASE 6
		RESULT:1 = 100
		RESULTS:1 '= "crotch"
		RETURNF 61
	CASE 7
		RESULT:1 = 33
		RESULTS:1 '= "lleg"
		RETURNF 81
	CASE 8
		RESULT:1 = 33
