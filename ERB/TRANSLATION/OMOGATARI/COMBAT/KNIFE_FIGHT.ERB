		CALL COLORMESSAGE(@"【%CALLNAME:LOSER%를 상대로 첫 승리를 거두었다.】",C_YELLOW, 1)
	ENDIF
	CFLAG:LOSER:弾幕勝負勝利 = 1
	SELECTCASE AblUsed:1
		CASE IS >= UniversalRank("Extra")
