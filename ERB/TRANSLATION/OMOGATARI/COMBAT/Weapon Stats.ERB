ELSEIF ARG == 37
    AU_WEAPON = 101
ELSEIF ARG == 38
    AU_WEAPON = 709
ELSEIF ARG == 39
    AU_WEAPON = 16
ELSEIF ARG == 41
    AU_WEAPON = 20
ELSEIF ARG == 46
    AU_WEAPON = 19
ELSEIF ARG == 50
    AU_WEAPON = 164
ELSEIF ARG == 51
;scales with RND
