ENDSELECT

@CANNOT_TSP
#FUNCTION
SIF TFLAG:妄想中 == 1
    RETURNF 18
SIF BASE:MASTER:気力 <= 0
    RETURNF 15
SIF BASE:MASTER:TSP <= 0
    RETURNF 14
SIF (!FLAG:70 && (CFLAG:うふふ || CFLAG:イタズラ || CFLAG:添い寝中))
    RETURNF 13
SIF inTrain == 3
    RETURNF 17
SIF CFLAG:MASTER:睡眠
    RETURNF 16
SIF YOUJUTSU_PACIFIED(MASTER)
    RETURNF YOUJUTSU_PACIFIED(MASTER)

RETURNF 0

@WeaponHoldingDisclaimers(nWeapon)
#DIM DYNAMIC nWeapon
#DIM DYNAMIC weaponInv
#DIMS DYNAMIC retString
retString '= ""

IF nWeapon > 60000000000000000
	;weaponinventory entry
    weaponInv = nWeapon
	nWeapon = DT_CELL_GET("WeaponInventory", nWeapon, "def", 1)
ELSEIF nWeapon >= 1000
    nWeapon = GET_INT(0, "WeaponPreset", nWeapon%1000, "Base Weapon")
ENDIF

SIF GET_INT(0, "Weapon", nWeapon, "Heavy Weapon")
    retString += "This is an <font color='#ff9999'>VERY HEAVY</font> weapon and requires Strong Muscles to hold.<br>"
SIF GET_INT(0, "Weapon", nWeapon, "Two-Handed")
    retString += "This is a <font color='#ffff99'>Two-Handed</font> weapon and requires both hands to be functional to hold.<br>"
SIF GET_INT(0, "Weapon", nWeapon, "Youjutsu Tier")
    retString += "This is a <font color='#ffff99'>Youjutsu</font> spell and requires the user to be able to talk.<br>"
IF WeaponHasAntiTheft(0,nWeapon)
    retString += @"This weapon has a <font color='#ff9999'>biological anti-theft system</font>."
    IF !weaponInv
        retString += @" It will require linking to your body and can only be used by you."
    ELSE
        IF DT_CELL_GET("WeaponInventory", WeaponInv, "antiTheftCracked", 1)
            retString += @" It has been cracked and can be used by anyone."
        ELSEIF  DT_CELL_GET("WeaponInventory", weaponInv, "antiTheftID", 1)>0
            retString += @" It is currently linked to \@ InRange(DT_CELL_GET("WeaponInventory", weaponInv, "antiTheftID", 1)-1,0,CHARANUM-1) ? %NAME:(DT_CELL_GET("WeaponInventory", weaponInv, "antiTheftID", 1)-1)%# Someone you don't know\@%COND_STR(" (You)",DT_CELL_GET("WeaponInventory", weaponInv, "antiTheftID", 1)-1 == MASTER)%"
        ELSE
            retString += @" It is currently linked to no one."
        ENDIF
    ENDIF
    retString += "<br>"
ENDIF

SIF retString != ""
HTML_PRINT retString

@CrippledHandDisarm(ARG)
#DIMS lossString
#DIM cantHoldID
SIF !SHIRAHU(ARG)
    RETURN

cantHoldID = CANT_HOLD_WEAPON(ARG,EQUIP:ARG:Weapon)


IF cantHoldID
    SELECTCASE cantHoldID
    CASE 1 TO 3
        lossString '= @"Crippling %PARSE("your",,,ARG)% arm forces %PARSE("you",6,,ARG)% to put away %PARSE("your",5,,ARG)% %PrintWeaponName(ARG,EQUIP:ARG:Weapon,1)%!"
    CASE 4
        lossString '= @"Having %PARSE("your",,,ARG)% arms bound forces %PARSE("you",6,,ARG)% to put away %PARSE("your",5,,ARG)% %PrintWeaponName(ARG,EQUIP:ARG:Weapon,1)%!"
    CASE 10
        lossString '= @"Being muted forces %PARSE("you",6,,ARG)% to go back to %PrintWeaponName(ARG,GETBIT(TALENT:ARG:ESP,0),1)%!"
    CASE 11, 12
        lossString '= @"Crippling %PARSE("your",,,ARG)% mouth forces %PARSE("you",6,,ARG)% to go back to %PrintWeaponName(ARG,GETBIT(TALENT:ARG:ESP,0),1)%!"
    CASE 21
        lossString '= @"As %PARSE("you are",,,ARG)% not Youjutsu capable, %PARSE("you are",5,,ARG)% forced to go back to %PrintWeaponName(ARG,GETBIT(TALENT:ARG:ESP,0),1)%!"
    CASE 31
        lossString '= @"%PARSE("You put",,,ARG)% away %PARSE("your",5,,ARG)% %PrintWeaponName(ARG,EQUIP:ARG:Weapon,1)% because it's too heavy for %PARSE("you",6,,ARG)%!"
    CASEELSE
        lossString '= @"%PARSE("You",,,ARG)% cannot hold %PARSE("your",5,,ARG)% %PrintWeaponName(ARG,EQUIP:ARG:Weapon,1)% for reason: %CANT_HOLD_WEAPON_REASON(cantHoldID)%"
    ENDSELECT

    ;Losing your right arm forces you to put away your LAC141!
    IF DT_EXIST("TGC_MAP") || DT_EXIST("lcCombatants")
        CALL LC_PRINT(lossString, C_RED, 2,)
    ELSE
        CALL COLORMESSAGE(lossString, C_RED, 2)
    ENDIF
    CALLF EquipWeapon(ARG,GETBIT(TALENT:ARG:ESP,0) && !CANT_HOLD_WEAPON(ARG,1))
ENDIF