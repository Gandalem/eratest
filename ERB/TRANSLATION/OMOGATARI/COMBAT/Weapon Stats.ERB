@WeapStats_Prefix(ARG,ARG:1)
#FUNCTIONS
IF GET_INT(0, "Weapon", ARG, "Modes")
    RETURNF @"{ARG:1}/"
ENDIF
RETURNF


;PERSON: Character which is getting the weapon
;nWeapon: Weapon in question
;ARG:1: For calculating stats without fucking with attachments, ammo, etc.
;
@COM_WEAPSTATS(PERSON,nWEAPON, doNotReload, nMode, Previewing=0, nWeaponPreset=0, nWeapAtt=-1, nAttType="", nAttCount = 1, nAttLoop = 0); this is where weapon stats are grabbed from
#FUNCTION
#DIM PERSON
#DIM DYNAMIC nWEAPON
#DIM DYNAMIC nMode
#DIM DYNAMIC Previewing
#DIM DYNAMIC nWeaponPreset
#DIM DYNAMIC WeaponStatsTemp, VARSIZE("charaWeaponInts"), 4
#DIM DYNAMIC doNotReload
#DIM DYNAMIC nWeapAtt
#DIM DYNAMIC nAttCount
#DIM DYNAMIC nAttLoop

#DIM CurrentAttachment
#DIMS CurrentAttachmentType
#DIMS varType
#DIMS varTypeSTR
#DIMS nAttType
#DIM nRoll
#DIM WeapInventory
#DIM presetDetect
VARSET WeapInventory
IF Previewing
    varType '= @"previewWeaponInts"
    varTypeSTR '= @"previewWeaponStrs"
    VARSET previewWeaponInts
ELSE
    varType '= @"charaWeaponInts:{PERSON}"
    varTypeSTR '= @"charaWeaponStrs:{PERSON}"
ENDIF

IF nWEAPON > 60000000000000000
	;weaponinventory entry
	WeapInventory = nWEAPON
	;WeaponPreset = DT_CELL_GET("WeaponInventory", ARG, "detectedPreset", 1)
	nWEAPON = DT_CELL_GET("WeaponInventory", nWEAPON, "def", 1)
ELSEIF nWeapon > VAR_TEMP_MAX
	nWeaponPreset = nWeapon%VAR_TEMP_MAX
	nWEAPON = GET_INT(0, "WeaponPreset", nWeaponPreset, "Base Weapon")
ENDIF

IF !doNotReload && !Previewing
    CALLF RemoveCharaAttachments(PERSON)
    SIF nWeapon
    CALLF SetDefaultAttachments(PERSON,nWEAPON)
ENDIF
SETVAR @"%varTypeSTR%:0", GET_STR(PERSON, "Weapon", nWEAPON, "Platform")
SETVAR @"%varTypeSTR%:1", GET_STR(PERSON, "Weapon", nWEAPON, "Ammo")
SETVAR @"%varTypeSTR%:2", GET_STR(PERSON, "Weapon", nWEAPON, "Hit Effect")
SETVAR @"%varTypeSTR%:4", GET_STR(PERSON, "Weapon", nWEAPON, "User Effect")

;weapon stats
FOR LOCAL,0,VARSIZE("charaWeaponInts")
    SIF GROUPMATCH(LOCAL,12,13,14)
        CONTINUE
    CALLF WeapStatsVarNames(LOCAL)
    LOCALS:2 '= RESULTS:2
    WeaponStatsTemp:LOCAL:0 = GET_INT(PERSON, "Weapon", nWEAPON, WeapStats_Prefix(nWEAPON,nMode)+LOCALS:2)
    SETVAR @"%varType%:{LOCAL}", WeaponStatsTemp:LOCAL:0
NEXT

;weapon attachments
FOR nRoll, 0, VARSIZE("CharaWeaponAtts")
    SIF nWeapon == 0
        BREAK

    CurrentAttachmentType '= GetAttachmentType_Priority(nRoll)
	$reDoWeaponAttachment
    IF doNotReload && !Previewing
        CurrentAttachment = charaWeaponAtts:PERSON:CurrentAttachmentType
    ELSE
        CurrentAttachment = 0
    ENDIF



    IF nWeaponPreset && (PresetAttachment(nWeaponPreset,CurrentAttachmentType))
        CurrentAttachment = PresetAttachment(nWeaponPreset,CurrentAttachmentType)
        SIF !Previewing
        charaWeaponAtts:PERSON:CurrentAttachmentType = CurrentAttachment
    ELSEIF CurrentAttachmentType == nAttType && nAttLoop != 3
        ;attachment being installed
        SIF nAttCount
            CurrentAttachment = nWeapAtt
    ELSEIF WeapInventory
        CurrentAttachment = DT_CELL_GET("WeaponInventory", WeapInventory, CurrentAttachmentType, 1)
        SIF !Previewing
        charaWeaponAtts:PERSON:CurrentAttachmentType = CurrentAttachment
    ELSE
        ;base weapon
        SIF nAttCount
        CurrentAttachment = GET_INT(PERSON, "Weapon", nWEAPON, CurrentAttachmentType+"/Default")
        SIF !Previewing
        charaWeaponAtts:PERSON:CurrentAttachmentType = CurrentAttachment
    ENDIF

	IF CurrentAttachmentType == "WeaponReceiver" && CurrentAttachment && nAttLoop == 0
		;we set platform and ammo here
        ; SETVAR @"%varTypeSTR%:0", GetVarS(@"%varTypeSTR%:0")+GET_STR(0, "WeaponReceiver", CurrentAttachment, "Platform")
        ; SETVAR @"%varTypeSTR%:1", GetVarS(@"%varTypeSTR%:1")+GET_STR(0, "WeaponReceiver", CurrentAttachment, "Ammo")
        SIF STRLENS(GET_STR(0, "WeaponReceiver", CurrentAttachment, "Platform"))
            SETVAR @"%varTypeSTR%:0", GET_STR(0, "WeaponReceiver", CurrentAttachment, "Platform")
        SIF STRLENS(GET_STR(0, "WeaponReceiver", CurrentAttachment, "Ammo"))
            SETVAR @"%varTypeSTR%:1", GET_STR(0, "WeaponReceiver", CurrentAttachment, "Ammo")
    ENDIF
    ; no ammo type! grab ammo type using barrel used and continue doing receiver calcs after
    IF !STRLENS(GetVarS(@"%varTypeSTR%:1")) && CurrentAttachment && nRoll == 0 && nAttLoop == 0
        IF CurrentAttachmentType != "WeaponBarrelBody"
            CurrentAttachmentType '= "WeaponBarrelBody"
            GOTO reDoWeaponAttachment
        ENDIF
        SETVAR @"%varTypeSTR%:1", GET_STR(0, "WeaponBarrelBody", CurrentAttachment, "Ammo")
        CurrentAttachmentType '= "WeaponReceiver"
    ENDIF

    ;non blank hit effecgt
    SIF STRLENS(GET_STR(PERSON, CurrentAttachmentType, CurrentAttachment, "Hit Effect"))
        SETVAR @"%varTypeSTR%:2", GET_STR(PERSON, CurrentAttachmentType, CurrentAttachment, "Hit Effect")
    SIF STRLENS(GET_STR(PERSON, CurrentAttachmentType, CurrentAttachment, "User Effect"))
        SETVAR @"%varTypeSTR%:4", GET_STR(PERSON, CurrentAttachmentType, CurrentAttachment, "User Effect")

    FOR LOCAL,0,VARSIZE("charaWeaponInts")
        SIF GROUPMATCH(LOCAL,12,13,14)
            CONTINUE
        CALLF WeapStatsVarNames(LOCAL)
        LOCALS:2 '= RESULTS:2
        SIF CurrentAttachmentType == "WeaponAmmo" && !CurrentAttachment
            LOCALS:2 '= GetVarS(@"%varTypeSTR%:1")+"、"+RESULTS:2
        ;SIF PERSON == MASTER
            ;DEBUGPRINTFORML TYPE %CurrentAttachmentType%, ATTACHMENT {CurrentAttachment}, PARAM %LOCALS:2%

        ; IF nAttCount
		IF (CurrentAttachmentType == nAttType || (nWeaponPreset && GET_INT(0, "WeaponPreset", nWeaponPreset, CurrentAttachmentType+"/Required") || GET_INT(0, "WeaponPreset", nWeaponPreset, CurrentAttachmentType+"/Default"))) && nAttCount
            SETVAR @"WeaponStatsTemp:{LOCAL}:1", GET_INT(PERSON, CurrentAttachmentType, CurrentAttachment, LOCALS:2)
            SIF GET_INT(PERSON, CurrentAttachmentType, CurrentAttachment, LOCALS:2+"/Set")
                SETVAR @"WeaponStatsTemp:{LOCAL}:1", GET_INT(PERSON, CurrentAttachmentType, CurrentAttachment, LOCALS:2+"/Set")
            SIF Previewing == 2
                SETVAR @"previewAttInts:{LOCAL}", WeaponStatsTemp:LOCAL:1
        ENDIF
        IF GET_INT(PERSON, CurrentAttachmentType, CurrentAttachment, LOCALS:2+"/Set")
            SETVAR @"WeaponStatsTemp:{LOCAL}:0", GET_INT(PERSON, CurrentAttachmentType, CurrentAttachment, LOCALS:2+"/Set")
        ELSE
            SETVAR @"WeaponStatsTemp:{LOCAL}:0", GETVAR(@"WeaponStatsTemp:{LOCAL}:0")+GET_INT(PERSON, CurrentAttachmentType, CurrentAttachment, LOCALS:2)
        ENDIF
        SETVAR @"%varType%:{LOCAL}", WeaponStatsTemp:LOCAL:0
    NEXT
NEXT
;////////////////////////
;Religion
;////////////////////////
IF INRANGE(PERSON,0,CHARANUM)
    IF GET_STR(PERSON, "Weapon", nWEAPON, "Type") == "Firearm" && nWEAPON
        SELECTCASE ApplicablePrecept(PERSON, "Firearms")
        CASE -5
            ;should never happen but let's just strip the touhou's weapon if it DOES happen
            $TakeWeapon
            CALLF EquipWeapon(PERSON,0)
            RETURNF
        CASE -4
            IF !WEAP_IS_AIRGUN(nWEAPON)
                GOTO TakeWeapon
            ENDIF
        CASE -3
            IF !WEAP_IS_AIRGUN(nWEAPON)
                WeaponStatsTemp:4:0 = MIN(WeaponStatsTemp:4:0,10)
                WeaponStatsTemp:2:0 = 1
            ENDIF
        CASE -2
            IF !WEAP_IS_AIRGUN(nWEAPON)
                WeaponStatsTemp:4:0 = MIN(WeaponStatsTemp:4:0,10)
                WeaponStatsTemp:2:0 = MIN(WeaponStatsTemp:4:0,2)
            ENDIF
        CASE -1
            IF !WEAP_IS_AIRGUN(nWEAPON)
                WeaponStatsTemp:4:0 = MIN(WeaponStatsTemp:4:0,2)
            ENDIF
        CASEELSE
        ;unrestricted
        ENDSELECT
    ENDIF
ENDIF


SETVAR @"%varType%:{4}", WeaponStatsTemp:4:0
SETVAR @"%varType%:{2}", WeaponStatsTemp:2:0

IF !doNotReload && !Previewing
    charaWeaponInts:PERSON:Ammo = WeaponStatsTemp:4:0
    SIF STRFIND(charaWeaponStrs:PERSON:0,"closed-bolt/") > -1
        charaWeaponInts:PERSON:Ammo++
ENDIF
IF WeapInventory > 60000000000000000 || !Previewing
    IF !nWeaponPreset
        presetDetect = GetWeaponPreset(PERSON,WeapInventory)
    ELSE
        presetDetect = nWeaponPreset
    ENDIF
    IF WeapInventory > 60000000000000000
        ;DT_CELL_GET("weaponInventory", 638502515925810548, "detectedPreset",1)
        DT_CELL_SET "WeaponInventory", WeapInventory, "detectedPreset", presetDetect, 1
    ENDIF
    IF !Previewing
        charaWeaponInts:PERSON:WeaponInventory = WeapInventory
        CFLAG:PERSON:DetectedWeaponPreset = presetDetect
    ENDIF
ENDIF

@WEAP_IS_AIRGUN(ARG)
#FUNCTION
SIF STRFIND(GET_STR(0, "Weapon", ARG, "Tags"),"non lethal") > -1
    RETURNF 1
SIF STRFIND(GET_STR(0, "Weapon", ARG, "Tags"),"airgun") > -1
    RETURNF 1
RETURNF 0

@RELIGION_ALLOWS_WEAPON(ARG,nWEAPON)
#FUNCTION
#DIM nWEAPON
IF !nWEAPON
    ;Danmaku
    SELECTCASE ApplicablePrecept(ARG, "Danmaku")
    CASE -3
        RETURNF 0
    CASEELSE
    ;unrestricted
    ENDSELECT
ELSEIF nWeapon > 60000000000000000
	;weaponinventory entry
	;detectedPreset = DT_CELL_GET("WeaponInventory", nWeapon, "detectedPreset", 1)
	nWeapon = DT_CELL_GET("WeaponInventory", nWeapon, "def", 1)
ENDIF

IF GET_STR(ARG, "Weapon", nWEAPON, "Type") == "Firearm"
    SELECTCASE ApplicablePrecept(ARG, "Firearms")
    CASE -5
        RETURNF 0
    CASE -4
        IF !WEAP_IS_AIRGUN(nWEAPON)
            RETURNF 0
        ENDIF
    CASEELSE
    ;unrestricted
    ENDSELECT
ENDIF

IF STRFIND(GET_STR(ARG, "Weapon", nWEAPON, "Type"), "Blunt") > -1 || STRFIND(GET_STR(ARG, "Weapon", nWEAPON, "Type"), "Blade") > -1
    SELECTCASE ApplicablePrecept(ARG, "Melee")
    CASE -3
        RETURNF 0
    CASEELSE
    ;unrestricted
    ENDSELECT
ENDIF

RETURNF 1


@CANT_HOLD_WEAPON(ARG,nWEAPON)
#FUNCTION
#DIM nWEAPON
#DIM DYNAMIC Manip
#DIM DYNAMIC strengthPoint

IF nWeapon > 60000000000000000
	;weaponinventory entry
	;detectedPreset = DT_CELL_GET("WeaponInventory", nWeapon, "detectedPreset", 1)
	nWeapon = DT_CELL_GET("WeaponInventory", nWeapon, "def", 1)
ELSEIF nWeapon >= 1000
    nWeapon = GET_INT(ARG, "WeaponPreset", nWeapon%1000, "Base Weapon")
ENDIF

;Fists are always available
SIF GROUPMATCH(nWeapon,0)
    RETURNF 0

;MP check
IF GET_INT(0, "Weapon", nWeapon, "MP Cost")
    IF !HasAnyYoujutsu(ARG)
        RETURNF 21
    ELSEIF BASE:ARG:7 <= 0
        RETURNF 20
    ELSEIF BASE:ARG:7 < GET_INT(0, "Weapon", nWeapon, "MP Cost")
        RETURNF 22
    ENDIF
    ;Danmaku
    SIF GROUPMATCH(nWeapon,1)
        RETURNF 0
ENDIF

;Youjutsu Spells
IF GET_INT(0, "Weapon", nWeapon, "Youjutsu Tier")
    Manip = CapacityStats:ARG:5
    SIF Manip < 30
        RETURNF 12
ENDIF

Manip = CapacityStats:ARG:4

SIF ARMS_BOUND(ARG)
    RETURNF 4

;no manipulation.
SIF Manip < 10
    RETURNF 2

;two handed weapons

IF GET_INT(ARG, "Weapon", nWEAPON, "Two-Handed")
    SIF IsPartCrippled(ARG, 20) || IsPartCrippled(ARG,30)
        RETURNF 1
    SIF Manip < 30
        RETURNF 3
ENDIF

;heavy weapons
IF GET_INT(ARG, "Weapon", nWEAPON, "Heavy Weapon")
    SIF !TALENT:ARG:223
        RETURNF 31
ENDIF

RETURNF 0

