    ELSE
        AU_WEAPON = 1
    ENDIF
ELSEIF ARG == 63
    AU_WEAPON = 8
ELSEIF ARG == 64
    AU_WEAPON = 0
ELSEIF ARG == 65
    AU_WEAPON = 13
ELSEIF GROUPMATCH(ARG,71,90)
    AU_WEAPON = 104
ELSEIF ARG == 72
    AU_WEAPON = 700
ELSEIF ARG == 76
    AU_WEAPON = 1129
ELSEIF ARG == 97
    AU_WEAPON = 132
ELSEIF ARG == 98
    AU_WEAPON = 1015
ELSEIF ARG == 99
    AU_WEAPON = 711
ELSEIF ARG == 100
    AU_WEAPON = 422
ELSEIF ARG == 102
    AU_WEAPON = K102_GetGun()
ELSEIF ARG == 103
    AU_WEAPON = 59
ELSEIF GROUPMATCH(ARG,104,105, 48)
    AU_WEAPON = 314
ELSEIF ARG == 106
    ;sumireko
    ;Scales with shooting
    SELECTCASE LEVEL_TO_RANK(ABL:106:Shooting)
    CASE 0
    AU_WEAPON = 1005
    CASE 1
    AU_WEAPON = 1006
    CASE 2
    AU_WEAPON = 1007
    CASE 3
    AU_WEAPON = 1008
    CASE 4
    AU_WEAPON = 1009
    CASE 5
    AU_WEAPON = 1010
    CASEELSE
    AU_WEAPON = 1011
    ENDSELECT
ELSEIF ARG == 107
    AU_WEAPON = 106
ELSEIF ARG == 131
    AU_WEAPON = 404
ELSEIF ARG == 145
    AU_WEAPON = 315
ELSEIF GROUPMATCH(ARG,108,139)
    AU_WEAPON = 1084
ELSEIF ARG == 143
    AU_WEAPON = 102
ELSEIF ARG == 153
    AU_WEAPON = 22
ELSEIF ARG == [[Vivit]]
    AU_WEAPON = 423
ELSEIF ARG == [[Myouren]]
    AU_WEAPON = 156
ELSEIF MARK:ARG:3 >= 5
    ABL:ARG:66 = MAX(ABL:ARG:66,ABL:ARG:42,UniversalRank("S"))
    AU_WEAPON = MakeDesiredWeapon("military/anti tank")
ELSEIF FLAG:POSTAL > 0 && !ignorePostal
    CALLF FISHER_YATES_SHUFFLE_F(VAR_TEMP_MAX*2)
    AU_WEAPON:4 = -1
    DO
        AU_WEAPON:4++
        AU_WEAPON = SHAFFLE_ARRAY:(AU_WEAPON:4)
        IF AU_WEAPON >= VAR_TEMP_MAX
            AU_WEAPON:2 = AU_WEAPON-VAR_TEMP_MAX
            SIF !EXISTFUNCTION(@"WeaponPreset{AU_WEAPON:2}")
                CONTINUE
            AU_WEAPON:1 = GET_INT(,"WeaponPreset", AU_WEAPON:2, "Base Weapon")
        ELSE
            AU_WEAPON:2 = 0
            AU_WEAPON:1 = AU_WEAPON
        ENDIF
        IF !INRANGE(AU_WEAPON:4,0,VARSIZE("WeaponRankCache"))
            ;out of range
            AU_WEAPON = GETBIT(TALENT:ARG:ESP,0)
            CALLF EQUIPWEAPON(ARG,AU_WEAPON)
            RETURNF AU_WEAPON
        ENDIF 
        SIF !STRLENS(GET_STR(ARG, "Weapon", AU_WEAPON:1, "名前"))
            CONTINUE
        SIF GET_INT(ARG, "Weapon", AU_WEAPON:1, "Firearm Template") && AU_WEAPON < VAR_TEMP_MAX
            CONTINUE
        SIF CANT_HOLD_WEAPON(ARG,AU_WEAPON:1)
            CONTINUE

        SIF FLAG:POSTAL == 1 && WeaponRankCache:(AU_WEAPON:4) >= 22
            CONTINUE
        ; SIF FLAG:POSTAL > 1 && WeaponRankCache:(AU_WEAPON:4) < 9
        ;     CONTINUE
        CALLF EQUIPWEAPON(ARG,AU_WEAPON)
        RETURNF (AU_WEAPON)
    LOOP 1
ELSE
    AU_WEAPON = GETBIT(TALENT:ARG:ESP,0)
ENDIF

$GetWeapon
CALLF EQUIPWEAPON(ARG,AU_WEAPON)
RETURNF (AU_WEAPON)


