CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, LOCALS + turnLines:1)
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, turnLines:2)
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, turnLines:3)
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, turnLines:4)
