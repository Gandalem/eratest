@TGC_HitByCharacter(ARG, gridID:0, BypassAccuracy=0)
#DIM GetDamageType
#DIM TruncatedAttacks
#DIM DYNAMIC locX, 2
#DIM DYNAMIC locY, 2
#DIM DYNAMIC gridID, 2
#DIM DYNAMIC AlwaysHits
#DIM DYNAMIC BypassAccuracy
#DIM DYNAMIC AttackIsDodged
#DIM DYNAMIC AttackGoesToAnother
#DIM DYNAMIC AttackIsMissed
#DIM DYNAMIC nDMG
#DIM DYNAMIC AimedShot
#DIM DYNAMIC nDMGMultiplier
#DIM DYNAMIC nDMGPart
#DIMS DYNAMIC nDMGPartBroad
TruncatedAttacks = nNASQOL:1
;get location info
gridID:1 = TGC_CurrentGridSpace(ARG)
locX:0 = DT_CELL_GET("TGC_Map", gridID:0, "x", 1)
locY:0 = DT_CELL_GET("TGC_Map", gridID:0, "y", 1)
locX:1 = DT_CELL_GET("TGC_Map", gridID:1, "x", 1)
locY:1 = DT_CELL_GET("TGC_Map", gridID:1, "y", 1)
;accuracy
charaWeaponInts:(TGC_CurrentAttacker):Accuracy = TGC_AccuracyDifference(TGC_CurrentAttacker,ARG)

;damage info
GetDamageType = CharaWeaponInts:TGC_CurrentAttacker:DamageType
SIF !GetDamageType
    GetDamageType = WEAP_DAMAGE_TYPE(EQUIP:TGC_CurrentAttacker:Weapon)
SIF !GetDamageType
    GetDamageType = 1
;===================

SIF NASCheat:5 && ARG == MASTER
    GOTO AlwaysMiss
SIF BypassAccuracy == 1
    GOTO AlwaysHit
IF RAND:(100) > (charaWeaponInts:(TGC_CurrentAttacker):Accuracy) || charaWeaponInts:(TGC_CurrentAttacker):Accuracy <= 0
    $AlwaysMiss
    CALL INTERACTIVE_TUTORIAL_GET(102,201,"Misses",4)
    CALL INTERACTIVE_TUTORIAL_GET(102,202,"Misses",4)
    SIF !TruncatedAttacks
        CALL TGC_LogAdd(@"Miss!")
    lcDamageDeal:(ARG):99 ++
    $MissCheck
    ;little chance that missed bullet goes into another touhou
    ; IF RAND(100) < (CharaWeaponInts:TGC_CurrentAttacker:DivertToOther ? CharaWeaponInts:TGC_CurrentAttacker:DivertToOther# 50)
    ;     SIF !TruncatedAttacks
    ;         PRINTFORML The missed attack comes straight into another target!
    ; ENDIF
    AttackIsMissed = 1
    GOTO ExplosiveCheck
ELSEIF RAND:(100) <= TCVAR:(ARG):Weap_Dodge
    SIF !TruncatedAttacks
        CALL TGC_LogAdd(@"Dodge!")
    MissCounter ++
    lcDamageDeal:(ARG):98 ++
    AttackIsDodged = 1
    GOTO MissCheck
ENDIF

$AlwaysHit
nDMG = charaWeaponInts:(TGC_CurrentAttacker):Damage
;defense
;SELECTCASE nDmgType
;CASE 1,2,6
nDMG = nDMG*100/BUFF_MULTIPLIER(DT_CELL_GET("lcCombatants", GetCombatant(ARG), "defenseBuff", 1))
;desperation, up to stage 6
SELECTCASE PeeBarStage(ARG)
CASE 2
    TIMES nDMG, 1.25
CASE 3
    TIMES nDMG, 1.5
CASE 4
    TIMES nDMG, 1.75
CASE 5
    TIMES nDMG, 2.0
CASE 6
    TIMES nDMG, 2.25
ENDSELECT
SELECTCASE PooBarStage(ARG)
CASE 2
    TIMES nDMG, 1.25
CASE 3
    TIMES nDMG, 1.5
CASE 4
    TIMES nDMG, 1.75
CASE 5
    TIMES nDMG, 2.0
CASE 6
    TIMES nDMG, 2.25
ENDSELECT

;===============

lcDamageDeal:(ARG):97 ++
IF AimedShot
    $BalisticAimed
    nDMGPart = AimedShotInfo(AimedShot)
    nDMGMultiplier = RESULT:1
    nDMGPartBroad '= RESULTS:1

    nDMG = charaWeaponInts:(TGC_CurrentAttacker):Damage
    IF lcIsLethal
        ;DamageMitigate(TARGET,MASTER,1371,1,0,0,1)
        nDMG = DamageMitigate(ARG,TGC_CurrentAttacker,nDMG,nDMGPart,0,0,1)
        STAIN:ARG:5 |= 64
        SIF !charaWeaponInts:(TGC_CurrentAttacker):NonLethal
        CALLF BroadDamage((ARG),nDMGPartBroad,charaWeaponInts:(TGC_CurrentAttacker):Damage,GetDamageType,(TGC_CurrentAttacker),printweaponname(TGC_CurrentAttacker,,-1))
    ENDIF
    lcDamageDeal:(ARG):0 += (nDMG*nDMGMultiplier/100)
    lcDamageDeal:(ARG):(nDMGPart) += (nDMG*nDMGMultiplier/100)

    SIF !TruncatedAttacks
        CALL TGC_LogAdd(@"%CALLNAME:TGC_CurrentAttacker% did {lcDamageDeal:(ARG):0} damage to %CALLNAME:(ARG)%")
    ;CALL TGC_CREATE_HIT_EXPLOSION(TGC_CurrentAttacker,ARG,AimedShot,TGC_CurrentGridSpace(ARG))

ELSE
    SELECTCASE RAND(100)
    CASE IS < charaWeaponInts:(TGC_CurrentAttacker):Accuracy/4
        AimedShot = 1
    CASE IS < charaWeaponInts:(TGC_CurrentAttacker):Accuracy/2
        SELECTCASE RAND:4
        CASE 0
            AimedShot = 7
        CASE 1
            AimedShot = 8
        CASE 2
            AimedShot = 3
        CASE 3 
            AimedShot = 4
        ENDSELECT
    CASEELSE
        SELECTCASE RAND:3
        CASE 0
            AimedShot = 5
        CASE 1
            AimedShot = 2
        CASE 2
            AimedShot = 6
        ENDSELECT
    ENDSELECT
    GOTO BalisticAimed
ENDIF
SIF STRLENS(charaWeaponSTRs:TGC_CurrentAttacker:HitEffect)
    TRYCALLFORM %charaWeaponSTRs:TGC_CurrentAttacker:HitEffect%(ARG,TGC_CurrentAttacker)

$ExplosiveCheck
;theoretically having a very easy integer that we can change that automatically determines multi-hit
; IF AttackIsMissed
;     CALL CREATE_HIT_FRAGMENTS(TGC_CurrentAttacker,ARG,0)
;     CALL CREATE_HIT_EXPLOSION(TGC_CurrentAttacker,ARG,0)
; ENDIF
; CALL HIT_BY_FRAGMENT(ARG,1,AimedShot)
CALL TGC_HIT_BY_EXPLOSION(ARG,1,AimedShot)
CALL TGC_HIT_BY_FRAGMENT(ARG,1,AimedShot)

RETURN -AttackIsMissed - (5*AttackGoesToAnother) - (AttackIsDodged)

