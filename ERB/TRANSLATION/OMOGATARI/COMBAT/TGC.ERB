LOCALS '= "PRIORITY: "
VARSET turnLines
LOCAL:4 = 1
combatantSize = DT_SELECT("lcCombatants", @"didAttack < 1", "priority DESC", maxCharas)
FOR LOCAL, 0, combatantSize
    C_ID = DT_CELL_GET("lcCombatants", maxCharas:LOCAL, "chara", 1)
    SIF BASE:(C_ID):0 < 500 || IsDead:(C_ID):0 || DT_CELL_GET(@"lcCombatants", GetCombatant(C_ID) , "nonCombatant", 1) == 2
        CONTINUE
    LOCALS:1 '= REPLACE(PRINT_RANK_HTML(GetCombatAbility(C_ID),"MAX_6"), "<font color='#(.+)'>.+", "$1")
    LOCALS:2 '= REPLACE(PRINT_RANK_HTML(GetCombatAbility(C_ID),"MAX_6"), "<font.*?>(.*?)</font>", "$1")
    LOCALS:3 '= @"%CALLNAME:(C_ID)% (%LOCALS:2% {GetCombatAbility(C_ID)}) -> "
    IF STRLENS(turnLines:9)+STRLENS(LOCALS:3)+(LOCAL:4 == 1 ? STRLENS(LOCALS) # 0) > WND_WIDTH-4
        turnLines:9 '= ""
        LOCAL:4++
        SIF LOCAL:4 > 4
            BREAK
        GOTO AddToLine
    ELSE
        $AddToLine
        IF C_ID == MASTER
            LOCAL:5 = C_AQUA
        ELSEIF DT_CELL_GET(@"lcCombatants", GetCombatant(MASTER) , "side", 1) == DT_CELL_GET(@"lcCombatants", GetCombatant(C_ID) , "side", 1)
            LOCAL:5 = C_BLUE
        ELSE
            LOCAL:5 = C_RED
        ENDIF
        turnLines:(LOCAL:4) += @"@C:{LOCAL:5}@%CALLNAME:(C_ID)% (@C:{TOINT(LOCALS:1)}@%LOCALS:2%@/C@ {GetCombatAbility(C_ID)})@/C@ -> "
        turnLines:9 += LOCALS:3
    ENDIF
NEXT

;turnLines += "TURN END"

