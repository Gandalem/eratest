;TGC: Turn-Based Grid Combat

@TGC_CombatInit(localLethal = 1)
#DIM localLethal
#DIM DYNAMIC masterCombatantID
#DIM DYNAMIC nEnemy

#DIM nSide0Count
#DIM nSide0List, 200
#DIM nSide1Count
#DIM nSide1List, 200
#DIM nPriorityList, 200
#DIM nPriorityTotal

#DIM lcCurSide
#DIM nlcChara
#DIM TempBoost
#DIM nWeap

VARSET EasyBattleExpToGet
VARSET CurrentBattle
VARSET EasyBattleDamage

lcIsLethal = localLethal
TGC_LookingAt = MASTER

SETBGMVOLUME BGMVOLUME
SETSOUNDVOLUME SOUNDVOLUME


REPEAT 2
CALL WndMgr_DestroyWindow(-1)
REND
CALL TGC_Init()

IF !nRyona && !SaveIsEZB && lcIsLethal
	SETCOLOR C_RED
	PRINTL
	PRINTFORML %"-"*89%
	PRINTFORML LETHAL @TGC_CombatInit CALLED WITHOUT RYONA ENABLED!
	PRINTFORML !REPORT THIS!
	PRINTFORML %"-"*89%
	RESETCOLOR 
    RETURN
ELSEIF !DT_ROW_LENGTH("lcCombatants")
	SETCOLOR C_RED
	PRINTL
	PRINTFORML %"-"*89%
	PRINTFORML @TGC_CombatInit CALLED WITHOUT DEFINED CHARACTERS!
	PRINTFORML !REPORT THIS!
	PRINTFORML %"-"*89%
	RESETCOLOR 
    RETURN
ELSEIF !lcIsLethal && !GETBIT(nWeapons,0)
	SETCOLOR C_RED
	PRINTL
	PRINTFORML %"-"*89%
	PRINTFORML DANMAKU @TGC_CombatInit CALLED WITHOUT DANMAKU ENABLED!
	PRINTFORML !REPORT THIS!
	PRINTFORML %"-"*89%
	RESETCOLOR 
    RETURN
ENDIF

;set up flags
TURNS = 0
MissCounter = 0
VARSET TempBoost
VARSET IsInCover
VARSET lcWarResult, -1
VARSET lcPickFactionMax, -1
VARSET LCSideNames
VARSET lcTitle
VARSET lcSidePower
;set flags in case the 2hu dies by another cause (ie: bleeding or crippled head/thorax or amputated neck)
FLAG:796 = 0

masterCombatantID = GetCombatant(MASTER)
DT_SELECT "lcCombatants", @"side = '{!DT_CELL_GET("lcCombatants",masterCombatantID,"side",1)}'"
nEnemy = DT_CELL_GET("lcCombatants",RESULT:1,"chara",1)
VARSET RESULT
CALLF PLAY_BATTLE_MUSIC(nEnemy)
REDRAW 0

;check if combatants are initialized
; SIF !DT_EXIST("lcCombatants")
;     CALLF StartBattle()
; SIF !GetCombatant(MASTER,1)
; CALLF AddCombatant(MASTER,0)
; SIF !GetCombatant(4,2)
; CALLF AddCombatant(4,1)

;sanity check
;PRINTFORML DOES THE TABLE EVEN EXIST???? \@ DT_EXIST("lcCombatants") ? HELL YEA! %@"IS THERE ANYONE INSIDE? \@ DT_ROW_LENGTH("lcCombatants") ? YEAH, THERE'S AT LEAST {DT_ROW_LENGTH("lcCombatants")} OF THEM # SADLY NOT!  \@"% # NO IT FUCKING DOESN'T! \@

SIF ATTACKER_PRIORITY() == -1
    GOTO END

;get unit count
lcStartingUnits:0 = DT_SELECT("lcCombatants", @"side = 0", "", nSide0List)
lcStartingUnits:1 = DT_SELECT("lcCombatants", @"side = 1", "", nSide0List)

;grab the title.
; if faction war, use names of factions (World of Fantasies vs. Eros Religious State)
; if non-factions, use names of 3 most significant (Reimu, Marisa, Sakuya, etc. vs. Mima)
; requires four members of a faction to be considered a "faction war"
VARSET lcFactions
VARSET lcPickFaction, -1
FOR lcCurSide,0,2
    VARSET nSide0List
    nSide0Count = DT_SELECT("lcCombatants", @"side = {lcCurSide}", "", nSide0List)

    FOR LOCAL, 0, nSide0Count
        nlcChara = DT_CELL_GET("lcCombatants", nSide0List:LOCAL, "chara", 1)
        lcSidePower:lcCurSide += IntimidationFactor(nlcChara)
        FOR LOCAL:1,0,MaxFactions
            SIF FactionRank:nlcChara:(LOCAL:1)
                lcFactions:lcCurSide:(LOCAL:1) ++
        NEXT
    NEXT

    FOR LOCAL,0, maxFactions
        SIF lcFactions:lcCurSide:(LOCAL)  < 4
            CONTINUE
        IF lcFactions:lcCurSide:(LOCAL) > lcPickFactionMax:lcCurSide
            lcPickFaction:lcCurSide    = LOCAL
            lcPickFactionMax:lcCurSide = lcFactions:lcCurSide:(LOCAL)
        ENDIF
    NEXT

    IF lcPickFaction:lcCurSide != -1
        LCSideNames:lcCurSide '= FactionName(lcPickFaction:lcCurSide)
        SIF !STRLENS(LCSideNames:lcCurSide)
            LCSideNames:lcCurSide '= @"Faction #{lcPickFaction:lcCurSide}"
    ELSE
        nSide0Count = DT_SELECT("lcCombatants", @"side = {lcCurSide}", "priority DESC", nSide0List)
        LCSideNames:lcCurSide += @"%CALLNAME:(DT_CELL_GET("lcCombatants", nSide0List:0, "chara", 1))%、"
        SIF DT_CELL_GET("lcCombatants", nSide0List:1, "chara", 1)
            LCSideNames:lcCurSide += @"%CALLNAME:(DT_CELL_GET("lcCombatants", nSide0List:1, "chara", 1))%、"
        SIF DT_CELL_GET("lcCombatants", nSide0List:2, "chara", 1)
            LCSideNames:lcCurSide += @"%CALLNAME:(DT_CELL_GET("lcCombatants", nSide0List:2, "chara", 1))%、"
        LCSideNames:lcCurSide '= LIST_IN_STRING(LCSideNames:lcCurSide)
        SIF DT_CELL_GET("lcCombatants", nSide0List:3, "chara", 1)
            LCSideNames:lcCurSide += @", and more"
    ENDIF
NEXT

lcTitle '= @"%LCSideNames:0% vs. %LCSideNames:1%"

IF masterCombatantID
    CALL KOJO_MESSAGE_SEND("DANMAKU", 3, nEnemy, MASTER, -1, "戦闘前")
    IF RESULT == -1
        GOTO END
    ENDIF
ENDIF

[IF_DEBUG]
PRINTFORML EYEWITNESS: %TOSTR(EYEWITNESS())%, GET_TARGETNUM: %TOSTR(GET_TARGETNUM())%
[ENDIF]

WHILE 1
    nSide0Count = DT_SELECT("lcCombatants", @"side = 0", "", nSide0List)
    nSide1Count = DT_SELECT("lcCombatants", @"side = 1", "", nSide1List)
    FOR LOCAL, 0, nSide0Count
    nlcChara = DT_CELL_GET("lcCombatants", nSide0List:LOCAL, "chara", 1)
    CALL ResetYoujutsuResist(nlcChara)

    IF lcIsLethal
        nWeap = charaWeaponInts:nlcChara:WeaponInventory ? charaWeaponInts:nlcChara:WeaponInventory # EQUIP:(nlcChara):Weapon
    ELSE
        nWeap = 0
    ENDIF
    CALLF COM_WEAPSTATS(nlcChara,nWeap,1,charaWeaponInts:nlcChara:Mode,0)
    charaWeaponInts:(nlcChara):Accuracy = GetShootingAccuracy(nlcChara)
    TCVAR:(nlcChara):Weap_Dodge = GetDodgeChance(nlcChara)
    ;TCVAR:ATTACKER:Attack_Power = LOCAL:10
    NEXT
    FOR LOCAL, 0, GetCombatantSize(2)
    nlcChara = DT_CELL_GET("lcCombatants", nSide1List:LOCAL, "chara", 1)
    CALL ResetYoujutsuResist(nlcChara)

    IF lcIsLethal
        nWeap = charaWeaponInts:nlcChara:WeaponInventory ? charaWeaponInts:nlcChara:WeaponInventory # EQUIP:(nlcChara):Weapon
    ELSE
        nWeap = 0
    ENDIF        
    CALLF COM_WEAPSTATS(nlcChara,nWeap,1,charaWeaponInts:nlcChara:Mode,0)
    charaWeaponInts:(nlcChara):Accuracy = GetShootingAccuracy(nlcChara)
    TCVAR:(nlcChara):Weap_Dodge = GetDodgeChance(nlcChara)
    ;TCVAR:VICTIM:Attack_Power = LOCAL:11
    NEXT
    ; IF (EYEWITNESS() == 1 || GET_TARGETNUM() > 1) && ATTACKER == MASTER && lcIsLethal
    ;     FLAG:797 = 1
    ;     [IF_DEBUG]
    ;     PRINTFORML FLAG 797 SET
    ;     [ENDIF]
    ; ELSE
    ;     FLAG:797 = 0
    ; ENDIF
    TURNS += 1
    FOR LOCAL, 0, DT_ROW_LENGTH("lcCombatants")
        ;paralyzed
        IF DT_CELL_GET("lcCombatants", LOCAL, "paralysisAilment")
            DT_CELL_SET "lcCombatants", LOCAL, "didAttack", 2
        ENDIF
        DT_CELL_SET "lcCombatants", LOCAL, "paralysisAilment", MAX(0,DT_CELL_GET("lcCombatants", LOCAL, "paralysisAilment", 0)-1), 0
        ;muted
        DT_CELL_SET "lcCombatants", LOCAL, "muteAilment", MAX(0,DT_CELL_GET("lcCombatants", LOCAL, "muteAilment", 0)-1), 0

        ;losing turn
        IF DT_CELL_GET("lcCombatants", LOCAL, "didAttack", 0) == 2
            DT_CELL_SET "lcCombatants", LOCAL, "didAttack", 1
        ELSE
            DT_CELL_SET "lcCombatants", LOCAL, "didAttack", 0
        ENDIF
        DT_CELL_SET "lcCombatants", LOCAL, "protectBuff", MAX(0,DT_CELL_GET("lcCombatants", LOCAL, "protectBuff", 0)-1), 0
        DT_CELL_SET "lcCombatants",  MAX(0,DT_CELL_GET("lcCombatants", LOCAL, "aphrodisiacAilment", 0)-1), "aphrodisiacAilment"
    NEXT
    SIF ATTACKER_PRIORITY() == -1
    GOTO END

    lcCombatantCount = DT_SELECT("lcCombatants", @"didAttack < 1", "priority DESC", nPriorityList)


    FOR lcCount, 0, lcCombatantCount
        TGC_CurrentAttacker = DT_CELL_GET("lcCombatants", nPriorityList:lcCount, "chara", 1)
        ;TGC_CurrentAttacker = MASTER
        SIF BASE:(nlcChara):0 < 500 || IsDead:(nlcChara):0 || DT_CELL_GET(@"lcCombatants", GetCombatant(nlcChara) , "nonCombatant", 1) == 2
            CONTINUE
        lcOneMoreCount = 0
        $DoAnotherAttack
        DT_CLEAR "explosionTemp"
        DT_CLEAR "fragmentationTemp"
        TGC_PreviousAttackerWeapon = charaWeaponInts:TGC_CurrentAttacker:WeaponInventory ? charaWeaponInts:TGC_CurrentAttacker:WeaponInventory # EQUIP:(TGC_CurrentAttacker):Weapon
        IF lcIsLethal && (!DT_CELL_GET("lcCombatants", GetCombatant(TGC_CurrentAttacker), "muteAilment", 1) || !GET_INT(TGC_CurrentAttacker, "Weapon", TGC_PreviousAttackerWeapon, WeapStats_Prefix(TGC_PreviousAttackerWeapon,charaWeaponInts:TGC_CurrentAttacker:Mode)+"MP Cost"))
            TGC_CurrentAttackerWeapon = TGC_PreviousAttackerWeapon
        ELSE
            TGC_CurrentAttackerWeapon = 0
        ENDIF
        TGC_AttackerSurrender = 0
        CALL TGC_CombatHUD
        DT_CELL_SET "lcCombatants", nPriorityList:lcCount, "didAttack", 1, 1
        DT_CELL_SET "lcCombatants", nPriorityList:lcCount, "chargeBuff", MAX(0,DT_CELL_GET("lcCombatants", nPriorityList:lcCount, "chargeBuff", 1)-1), 1
        SIF !TGC_MarkDeadCombatants()
            GOTO END
        SIF FLAG:796
            GOTO END
        SIF lcOneMore
            GOTO DoAnotherAttack
        IF RESULT == -1
            GOTO END
        ENDIF
    NEXT

    $LoseTurn
    ;turn end
    FOR LOCAL, 0, nPriorityTotal
        nlcChara = DT_CELL_GET("lcCombatants", nPriorityList:LOCAL, "chara", 1)
        CALL TimeBladderGain(nlcChara,10)
        IF SoiledSelf:nlcChara:0
            LOCALS '= @"%PARSE("Your",,,nlcChara)% peed-in %PeeProtectType(nlcChara,1)% is giving %PARSE("your",5,,nlcChara)% legs a painful rash..."
            CALL RECOVER(nlcChara, -(MAXBASE:nlcChara:0-500)/16, "体力", LOCALS)
        ENDIF
        IF SoiledSelf:nlcChara:1
            LOCALS '= @"Messy pants aren't good for %PARSE("your",,,nlcChara)% health..."
            CALL RECOVER(nlcChara, -(MAXBASE:nlcChara:0-500)/16, "体力", LOCALS)
        ENDIF
        IF DT_CELL_GET("lcCombatants", nPriorityList:LOCAL, "poisonAilment", 1)
            LOCALS '= @"Poison is eating %PARSE("you",,,nlcChara)% away..."
            CALL RECOVER(nlcChara, -(MAXBASE:nlcChara:0-500)/8, "体力", LOCALS)
        ENDIF
        IF DT_CELL_GET("lcCombatants", nPriorityList:LOCAL, "burnAilment", 1)
            LOCALS '= @"%PARSE("You're",,,nlcChara)% burning out..."
            CALL RECOVER(nlcChara, -(MAXBASE:nlcChara:0-500)/8, "体力", LOCALS)
        ENDIF
        IF DT_CELL_GET("lcCombatants", nPriorityList:LOCAL, "aphrodisiacAilment", 1)
            CFLAG:nlcChara:溜まってる度 += MAX(100,100*(DT_CELL_GET("lcCombatants", nPriorityList:LOCAL, "aphrodisiacAilment", 1)/5))
            CALL TGC_LogAdd(@"%PARSE("Your",,,nlcChara)% body is getting aroused...", C_RED)
        ENDIF
    NEXT


    SIF !TGC_MarkDeadCombatants()
        BREAK
    SIF FLAG:796
        BREAK 

    ;call this again
    TIME += 1
WEND
$END
IF !lcIsLethal
    FOR LOCAL,0,CHARANUM
        SIF lcBaseTemp:LOCAL:0
            BASE:LOCAL:0 = lcBaseTemp:LOCAL:0
    NEXT
ENDIF
VARSET lcBaseTemp
;war result
;get unit count
lcEndingUnits:0 = DT_SELECT("lcCombatants", @"side = 0 and nonCombatant = 0", "", nSide0List)
lcEndingUnits:1 = DT_SELECT("lcCombatants", @"side = 1 and nonCombatant = 0", "", nSide0List)
SIF !lcStartingUnits:0 && !lcStartingUnits:1
    lcWarResult = -2
IF lcWarResult != -2
    lcWarResult = GetCombatantSize(2) > GetCombatantSize(1)
    SIF !GetCombatantSize(2) && !GetCombatantSize(1)
        lcWarResult = -1
ELSE
    GOTO BYPASsSUMMARY
ENDIF
SKIPDISP 0
CALLF StopMusic()
CALL lcAfterBattle

$BYPASsSUMMARY
CALLF StopMusic()
SKIPDISP 0

CALLF RemoveAllCombatants()

CALL TGC_Cleanup
CALL FIRE_WEAPON_CHECK_ALL
RETURN TCVAR:MASTER:Grievous_Harm

;==========================================
;TGC_CombatHUD
;==========================================
;Heads up display for the combat system
;Use global variables to change who is controlling.
;==========================================
;TGC_CurrentAttacker: What character is the attacker.
;==========================================
@TGC_CombatHUD
#DIM DYNAMIC LINE_NUM
; #DIM DYNAMIC ATTACKER, 100
; #DIM DYNAMIC VICTIM, 100
LINE_NUM = LINECOUNT

; IF GetCombatant(TGC_CurrentAttacker,1)
; DT_SELECT "lcCombatants", @"side = 0", "", ATTACKER
; DT_SELECT "lcCombatants", @"side = 1", "", VICTIM
; nSide = 0
; ELSEIF GetCombatant(TGC_CurrentAttacker,2)
; DT_SELECT "lcCombatants", @"side = 1", "", ATTACKER
; DT_SELECT "lcCombatants", @"side = 0", "", VICTIM
; nSide = 1
; ELSE
; ;PRINTFORMW Could not find %CALLNAME:TGC_CurrentAttacker% in either side of the combatants.
; lcOneMore = 0
; RETURN 1
; ENDIF

IF TGC_CurrentAttacker == -1
    lcOneMore = 0
    RETURN
ELSEIF BASE:(TGC_CurrentAttacker):0 < 500 || IsDead:(TGC_CurrentAttacker):0 || DT_CELL_GET(@"lcCombatants", GetCombatant(TGC_CurrentAttacker) , "nonCombatant", 1)
    lcOneMore = 0
    RETURN
ELSEIF IS_BABY(TGC_CurrentAttacker)
    ;baby
    CALLF RemoveCombatant(TGC_CurrentAttacker,1)
    CALLF RemoveCombatant(TGC_CurrentAttacker,0)
    lcOneMore = 0
    RETURN
ENDIF
lcOneMore = 0
TGC_CurrentAction '= ""

; TGC_AITarget = AI_GET_TARGET(TGC_CurrentAttacker,nSide)
; IF TGC_AITarget == -1
;     FLAG:796 = 1
;     lcWarResult = -2
;     RETURN
; ENDIF
; KilledBy:TGC_AITarget:0 = TGC_CurrentAttacker
; KilledWith:TGC_AITarget:0 = {TGC_CurrentAttackerWeapon}

;accident
IF PeeBarStage(TGC_CurrentAttacker) >= 7 || PooBarStage(TGC_CurrentAttacker) >= 7
    CALL AIB_INIT(TGC_CurrentAttacker)
ENDIF

IF DT_CELL_GET("lcCombatants", GetCombatant(TGC_CurrentAttacker), "didAttack", 1) == 2
    TGC_CurrentAction '= "turnEnd"
    RETURN
ENDIF

IF TGC_CurrentAttacker != MASTER
    CALL TGC_AI(TGC_CurrentAttacker)
ENDIF

SKIPDISP 0
TGC_InSkipMode = MESSKIP() && !(TGC_CurrentAttacker == MASTER || (lcDirectControl && GetCombatant(MASTER, DT_CELL_GET(@"lcCombatants", GetCombatant(TGC_CurrentAttacker), "side", 1)+1)))
IF TGC_InSkipMode
    IF NASLoadingLine
		CALL ANIMATION_LOAD_NAS(lcCount, 0, lcCombatantCount, @"Simulating turn for %CALLNAME:TGC_CurrentAttacker%"); nas loading
    ELSE
        CALL NAS_START_LOADING()
		CALL ANIMATION_LOAD_NAS(lcCount, 0, lcCombatantCount, @"Simulating turn for %CALLNAME:TGC_CurrentAttacker%"); nas loading
    ENDIF
ENDIF
SKIPDISP TGC_InSkipMode

WHILE 1
    REDRAW 0
    REPEAT 2
    CALL WndMgr_DestroyWindow(-1)
    REND
    IF !TGC_InSkipMode
        ;creating
        CALL TGC_MenuParent()
        SIF TGC_CurrentAttacker != -1
        CALL TGC_MenuCharacter(TGC_CurrentAttacker,1,0)
        SIF INRANGE(TGC_LookingAt,0,CHARANUM-1) && ((TGC_CurrentAttacker == MASTER && TGC_LookingAt != MASTER) || (TGC_CurrentAttacker != MASTER))
        CALL TGC_MenuCharacter(TGC_LookingAt,2,1)
        CALL TGC_TurnMenu()
        SIF TGC_LookingAt != -1 || GROUPMATCH(TGC_CurrentAction, "attack", "pickSpell")
        CALL TGC_AttackInfo(TGC_CurrentAttacker)

        CALL TGC_SideMenu()
        CALL TGC_BattleMap()
        ;render
        CALL WndMgr_DisplayAll()
    ENDIF
    REDRAW 0
    CALL TGC_MenuInput()
    IF RESULT == -1
        CLEARLINE LINECOUNT - LINE_NUM
        RETURN -1
    ELSEIF RESULT == 1
        CLEARLINE LINECOUNT - LINE_NUM
        RETURN 1
    ELSEIF RESULT == 2
        CLEARLINE LINECOUNT - LINE_NUM
        RETURN 2
    ENDIF
    CLEARLINE LINECOUNT - LINE_NUM
WEND

@TGC_MenuParent()
#DIM CONST MainWindowID = 0
#DIM MainWindowW
#DIM MainWindowH
#DIM DYNAMIC MenuLineCount

MainWindowW = MAXWIDTH()-1
MainWindowH = (CLIENTHEIGHT()/GetConfig("Font Size"))
;6f8f99
;failsafe

FINDELEMENT RESULT, MainWindowID, 1
IF RESULT == -1
    CALL WndMgr_CreateWindow(MainWindowID, 0, 0, MainWindowW, MainWindowH, 2)
    CALL WndMgr_Attribute(MainWindowID, "BorderColor", 0x6f8f99)
ELSE
    CALL WndMgr_ResetWindow(MainWindowID)
ENDIF

@TGC_SideMenu
#DIM CONST WINDOW_ID = 3
#DIM WND_WIDTH
#DIM WND_HEIGHT
#DIM WND_LOCATION
#DIM WND_X
#DIM WND_Y
#DIM DYNAMIC L_CNT
#DIM DYNAMIC NORM_COLOR
#DIM DYNAMIC WD_FONT_SIZE
#DIM WND_MAX_BAR_LENGTH
#DIM WND_CharaGrid
#DIM WND_CharaTable


NORM_COLOR = GETCONFIG("Text Color")
WD_FONT_SIZE = GetConfig("Font Size")
WND_WIDTH = MAXWIDTH()/4
SIF WND_WIDTH % 2
    WND_WIDTH--
WND_HEIGHT = (CLIENTHEIGHT()/GetConfig("Font Size"))-11
WND_X = 2
WND_Y = 9

FINDELEMENT RESULT, WINDOW_ID, 1
IF RESULT == -1
    CALL WndMgr_CreateWindow(WINDOW_ID, WND_X, WND_Y, WND_WIDTH, WND_HEIGHT, 2)
    CALL WndMgr_Attribute(WINDOW_ID, "BorderColor", 0x6f8f99)
ELSE
    CALL WndMgr_ResetWindow(WINDOW_ID)
ENDIF

IF !GROUPMATCH(TGC_CurrentAction,"attack_S1", "attack_S2", "attack_S3", "turnEnd", "doSpell_S1", "doSpell_S2")
    ;bars for magic, tsp, pee, poop
    CALL TGC_SideMenuBars(WINDOW_ID,L_CNT)
    L_CNT = RESULT+1
ENDIF

SELECTCASE TGC_CurrentAction
CASE "move"
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"Select a place to move to.")
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"")
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9999997@Cancel@/B@")
CASE "attack"
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"Select a place to attack.")
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"")
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9999997@Cancel@/B@")
CASE "debugLocations"
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"Debugging locations")
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"")
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9999997@Cancel@/B@")
CASE "attack_S1", "attack_S2", "attack_S3", "turnEnd", "doSpell_S1", "doSpell_S2", "viewingLog"
    CALLF TGC_ResetLogMaxLines
    FOR LOCAL,WND_HEIGHT-17,-1,-1
    ;FOR LOCAL,0,WND_HEIGHT-14
        CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, TGC_Logs:LOCAL)
    NEXT
CASE "pickSpell"
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"Select a Youjutsu spell")
CALL TGC_CombatMagicDisplay(TGC_CurrentAttacker,0,WINDOW_ID,L_CNT)
L_CNT = RESULT:1
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9999997@Cancel@/B@")
CASE "diaperChanging"
    CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"Select someone who will be changed")
    CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"You will use your turn and whoever's being changed's turn.")
    CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9999997@Cancel@/B@")
CASEELSE
;WND_CharaTable = 
WND_CharaGrid = TGC_CurrentGridSpace(TGC_CurrentAttacker)

IF charaWeaponInts:(TGC_CurrentAttacker):MagSize && charaWeaponInts:(TGC_CurrentAttacker):Ammo <= 0
    CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@C:{C_GRAY}@Attack (No Ammo)@/C@")
ELSE
    CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9000000@Attack@/B@")
ENDIF

CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9000001@Spells@/B@")
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9000100@Move To@/B@")
;CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9000102@Go Airborne@/B@")
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"")
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9000200@Items@/B@")
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9000201@Doctor@/B@")
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9000202@Change Weapon@/B@")
IF charaWeaponInts:(TGC_CurrentAttacker):MagSize
    IF charaWeaponInts:(TGC_CurrentAttacker):Ammo <= 0
        CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9000203@Reload@/B@")
    ELSE
        CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@C:{C_GRAY}@Reload (Weapon is full)@/C@")

    ENDIF
ENDIF
CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"")
IF CAN_ACCIDENT(TGC_CurrentAttacker,1) || CAN_ACCIDENT(TGC_CurrentAttacker,2)
    CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9000300@Relieve Self@/B@")
    CALL WndMgr_TextSet(WINDOW_ID, L_CNT++, @"@B:9000301@\@ IsPadded(TGC_CurrentAttacker) ? Use %PeeProtectType(TGC_CurrentAttacker,2)% # Soil self\@@/B@")
