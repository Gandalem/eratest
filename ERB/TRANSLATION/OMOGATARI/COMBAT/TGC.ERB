            LOCAL = TGC_RangeDifference(DT_CELL_GET("TGC_Map", TGC_CastRadius:0:0, "x", 1), DT_CELL_GET("TGC_Map", TGC_CastRadius:0:0, "y", 1), DT_CELL_GET("TGC_Map", RESULT, "x", 1), DT_CELL_GET("TGC_Map", RESULT, "y", 1))
