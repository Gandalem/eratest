@TGC_ShortWeaponDesc(ARG)
#FUNCTIONS
#DIM nWeapon
#DIMS weaponType
#DIM WeaponInv
#DIM WeaponPreset
#DIMS BrandString

nWeapon = CharaWeaponInts:ARG:WeaponInventory ? CharaWeaponInts:ARG:WeaponInventory # EQUIP:ARG:Weapon

IF nWeapon > 600000000000000000
	;weaponinventory entry
	WeaponInv = nWeapon
	;WeaponPreset = DT_CELL_GET("WeaponInventory", ARG, "detectedPreset", 1)
	nWeapon = DT_CELL_GET("WeaponInventory", nWeapon, "def", 1)
ELSEIF nWeapon >= VAR_TEMP_MAX
	WeaponPreset = nWeapon % 1000
	nWeapon = GET_INT(0,"WeaponPreset",WeaponPreset,@"Base Weapon")
ENDIF

CALLF UNDIES_GET_BRAND(nWeapon, 24)
BrandString '= RESULTS:2


weaponType '= toLower(GET_STR(0,"Weapon", nWeapon, "Class"))

SELECTCASE GET_STR(0,"Weapon", nWeapon, "Class")
CASE "Rifle"
    IF CharaWeaponInts:ARG:Burst >= 4
        weaponType '= "automatic rifle"
    ELSEIF CharaWeaponInts:ARG:Burst >= 2
        weaponType '= "semi-automatic rifle"
    ELSE
        weaponType '= "single-fire rifle"
    ENDIF

    SELECTCASE TGC_WEAPON_CALIBER(nWeapon)
    CASE 1
        IF CharaWeaponInts:ARG:Burst >= 4
            weaponType '= "sub-machine gun"
        ELSE
            weaponType '= "pistol-caliber carbine"
        ENDIF
    CASE 2
        IF CharaWeaponInts:ARG:Burst >= 4
            weaponType '= "assault rifle"
        ENDIF
    CASE 4
        IF CharaWeaponInts:ARG:Burst >= 4
            weaponType '= "automatic anti-material rifle"
        ELSE
            weaponType '= "anti-material rifle"
        ENDIF
    ENDSELECT

    IF CharaWeaponStrs:ARG:Ammo == "84x245mmR RCL"
        IF CharaWeaponInts:ARG:MagSize > 1
            weaponType '= "multi-rocket launcher"
        ELSE
            weaponType '= "rocket launcher"
        ENDIF
    ENDIF
ENDSELECT
RETURNF BrandString+" "+CharaWeaponStrs:ARG:Ammo+" "+weaponType

