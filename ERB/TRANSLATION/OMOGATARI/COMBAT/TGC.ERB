        FOR LOCAL:1,0,obsY
            obsTiles:LOCAL:(LOCAL:1) '= obsTileStorage:LOCAL:((obsY-1)-LOCAL:1)
            floorTiles:LOCAL:(LOCAL:1) '= floorTileStorage:LOCAL:((obsY-1)-LOCAL:1)
        NEXT
    NEXT
