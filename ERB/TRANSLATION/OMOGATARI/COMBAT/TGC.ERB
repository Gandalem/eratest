@TGC_BattleMap
#DIM CONST WINDOW_ID = 4
#DIM WND_WIDTH
#DIM WND_HEIGHT
#DIM WND_LOCATION
#DIM WND_X
#DIM WND_Y
#DIM WND_COLOR ;window color
#DIM DYNAMIC C_CNT ;text string
#DIM DYNAMIC L_CNT ;line count
#DIM DYNAMIC G_CNT ;grid count
#DIM DYNAMIC NORM_COLOR ;normal color
#DIM DYNAMIC TEXT_COLOR ;new text color
#DIM DYNAMIC WD_FONT_SIZE
#DIM DYNAMIC C_ID ;character being displayed
#DIM DYNAMIC G_ID ;datatable of the square
#DIM DYNAMIC R_ID ;radius ID
#DIMS DYNAMIC G_POS ;position ID
#DIM DYNAMIC G_MOD ;modulo
#DIM DYNAMIC IN_RADIUS
#DIMS DYNAMIC RADIUS_STR
#DIM CONST NAME_SIZE = 4 ;size of names

WND_COLOR = 0x6f8f99

NORM_COLOR = GETCONFIG("Text Color")
WD_FONT_SIZE = GetConfig("Font Size")

WND_X = 2 + (MAXWIDTH()/4)
SIF WND_X % 2
    WND_X--
WND_Y = 9

;column count
IF TGC_MapColumns
    WND_WIDTH = (NAME_SIZE)*TGC_MapColumns
    WND_WIDTH += 2
    SIF WND_WIDTH % 2
        WND_WIDTH--
ENDIF
IF TGC_MapRows
    WND_HEIGHT = ((2)*TGC_MapRows)+1
ENDIF

FINDELEMENT RESULT, WINDOW_ID, 1
IF RESULT == -1
    CALL WndMgr_CreateWindow(WINDOW_ID, WND_X, WND_Y, WND_WIDTH, WND_HEIGHT, 0)
ELSE
    CALL WndMgr_ResetWindow(WINDOW_ID)
ENDIF

;columns and rows on the grid

;L_CNT - current line
FOR L_CNT, 0, WND_HEIGHT
    ;roughtly how many 
    G_CNT = (L_CNT/2)
    LOCALS '= @"@C:{WND_COLOR}@"
    FOR C_CNT, 0, WND_WIDTH
        $RedoDraw
        G_MOD = (C_CNT)%(NAME_SIZE)
        G_POS '= @"{(C_CNT/(NAME_SIZE))},{G_CNT}"
        VARSET RESULT
        DT_SELECT "TGC_Map", @"positionID = '%G_POS%'"
        G_ID = RESULT:1
        LOCALS:1 '= DT_CELL_GETS("TGC_Map", G_ID, "charactersInside",1)
        IF !STRLENS(LOCALS:1)
            C_ID = -1
        ELSE
            C_ID = TOINT(SPLIT_SINGLE(LOCALS:1,0,"/"))
        ENDIF
        TEXT_COLOR = WND_COLOR
        RADIUS_STR '= ""

        ;check if any radiuses are active
        FOR R_ID,VARSIZE("TGC_CastRadius")-1,-1,-1
            ;does not exist
            IF !TGC_CastRadius:R_ID:1 && !STRLENS(TGC_CastRadiusSTR:R_ID)
                TEXT_COLOR = WND_COLOR
                CONTINUE
            ENDIF

            IN_RADIUS = TGC_InRadius(TGC_CastRadius:R_ID:1, DT_CELL_GET("TGC_Map", TGC_CastRadius:R_ID:0, "x", 1), DT_CELL_GET("TGC_Map", TGC_CastRadius:R_ID:0, "y", 1), (C_CNT/(NAME_SIZE)),  G_CNT) && !STRLENS(DT_CELL_GETS("TGC_Map", G_ID, "coverType", 1))
            IF IN_RADIUS
                TEXT_COLOR = TGC_CastRadius:R_ID:2
                RADIUS_STR '= TGC_CastRadiusSTR:R_ID
                BREAK
            ELSEIF R_ID == 0
                TEXT_COLOR = WND_COLOR
            ENDIF
        NEXT

        ;all
        SELECTCASE L_CNT%2
        CASE 0
            IF G_MOD == 0
                IF !INRANGE(C_ID,0,CHARANUM-1) && G_ID >= 60000000 && !IN_RADIUS
                    VARSET TGC_ObsSTR
                    VARSET TGC_Obs
                    IF STRLENS(DT_CELL_GETS(@"TGC_Map", G_ID , "coverType", 1))
                        CALLF TGC_ObstacleTypes(DT_CELL_GETS(@"TGC_Map", G_ID , "coverType", 1))
                        LOCALS += @"@C:{TGC_Obs:2 ? TGC_Obs:2 # 0x6f8f99}@%TGC_ObsSTR,NAME_SIZE%@/C@"
                    ELSE
                        CALLF TGC_FloorTypes(DT_CELL_GETS(@"TGC_Map", G_ID , "floorType", 1))
                        LOCALS += @"@C:{TGC_Obs:2 ? TGC_Obs:2 # 0x6f8f99}@%TGC_ObsSTR,NAME_SIZE%@/C@"
                    ENDIF
                    ;C_CNT += (NAME_SIZE)
                ELSEIF INRANGE(C_ID,0,CHARANUM-1)
                    IF C_ID == MASTER
                        TEXT_COLOR = C_AQUA
                    ELSEIF C_ID == TGC_LookingAt
                        TEXT_COLOR = C_ORANGE
                    ELSEIF DT_CELL_GET(@"lcCombatants", GetCombatant(C_ID) , "nonCombatant", 1) == 2
                        TEXT_COLOR = C_GREEN
                    ;ELSEIF BASE:C_ID:0 < 500
                    ELSEIF DT_CELL_GET(@"lcCombatants", GetCombatant(C_ID) , "nonCombatant", 1)
                        TEXT_COLOR = C_GRAY
                    ELSEIF DT_CELL_GET(@"lcCombatants", GetCombatant(MASTER) , "side", 1) == DT_CELL_GET(@"lcCombatants", GetCombatant(C_ID) , "side", 1)
                        TEXT_COLOR = C_BLUE
                    ELSE
                        TEXT_COLOR = C_RED
                    ENDIF
                    LOCALS += @"@C:{TEXT_COLOR}@%CENTER(SUBSTRING(CALLNAME:C_ID,0,NAME_SIZE),NAME_SIZE)%@/C@"
                ELSE
                    LOCALS += @"%"",NAME_SIZE%"
                ENDIF
            ELSEIF G_MOD == 1
                C_CNT--
                GOTO RedoDraw
            ENDIF
        CASE 1
            IF G_MOD == 0
                $PercentCheck
                ;LOCALS += @"@B:{G_ID}@@C:{TEXT_COLOR}@%CENTER(@"%G_POS%",NAME_SIZE)%@/C@@/B@@C:{0x6f8f99}@│@/C@"
                ;LOCALS += @"@B:{G_ID}@@C:{TEXT_COLOR}@%CENTER(@"%G_POS%",NAME_SIZE)%@/C@@/B@@C:{0x6f8f99}@│@/C@"
                ;LOCALS += @"@B:{G_ID}@@C:{TEXT_COLOR}@%CENTER(COND_STR(@"！",IN_RADIUS),NAME_SIZE)%@/C@@/B@@C:{0x6f8f99}@│@/C@"
                IF IN_RADIUS
                    LOCALS += @"@B:{G_ID}@@C:{TEXT_COLOR}@%CENTER(RADIUS_STR,NAME_SIZE)%@/C@@/B@"
                ELSEIF INRANGE(C_ID,0,CHARANUM-1)
                    SIF TGC_ClickMap
                        LOCALS += @"@B:{G_ID}@"
                    LOCALS += @"@C:{TEXT_COLOR}@%SUBSTRING(@"{(BASE:C_ID:0-500)*100/(MAXBASE:C_ID:0-500)}",0,NAME_SIZE),NAME_SIZE%@/C@"
                    SIF TGC_ClickMap
                        LOCALS += @"@/B@"
                ; ELSEIF TGC_CurrentAction != ""
                ;     ;doing an attack
                ;     LOCALS += @"@C:{TEXT_COLOR}@%"",NAME_SIZE%@/C@"
                ELSEIF G_ID >= 60000000
                    ;LOCALS += @"@B:{G_ID}@@C:{TEXT_COLOR}@%"",NAME_SIZE%@/C@@/B@"
                    VARSET TGC_ObsSTR
                    VARSET TGC_Obs
                    SIF TGC_ClickMap
                        LOCALS += @"@B:{G_ID}@"
                    IF STRLENS(DT_CELL_GETS(@"TGC_Map", G_ID , "coverType", 1))
                        CALLF TGC_ObstacleTypes(DT_CELL_GETS(@"TGC_Map", G_ID , "coverType", 1))
                        LOCALS += @"@C:{TGC_Obs:2 ? TGC_Obs:2 # 0x6f8f99}@%TGC_ObsSTR,NAME_SIZE%@/C@"
                    ELSE
                        CALLF TGC_FloorTypes(DT_CELL_GETS(@"TGC_Map", G_ID , "floorType", 1))
                        LOCALS += @"@C:{TGC_Obs:2 ? TGC_Obs:2 # 0x6f8f99}@%TGC_ObsSTR,NAME_SIZE%@/C@"
                    ENDIF
                    SIF TGC_ClickMap
                        LOCALS += @"@/B@"
                ELSE
                    LOCALS += @"%"",NAME_SIZE%"
                ENDIF
            ELSEIF G_MOD == 1
                C_CNT--
                GOTO RedoDraw
            ENDIF
        ENDSELECT

        C_CNT = STRLENS(REPLACE(LOCALS, "@[^@]*@", ""))
        C_CNT -= STRCOUNT(REPLACE(LOCALS, "@[^@]*@", ""),"％")
        
        IF LOCAL:9 == C_CNT
            SETCOLOR C_RED
            PRINTL
            PRINTFORML %"-"*89%
            PRINTFORML INFINITE LOOP DETECTED IN @TGC_CombatHud
            PRINTFORML Ending battle gracefully.
            PRINTFORML Last line: %REPLACE(LOCALS, "@[^@]*@", "")%
            PRINTFORML Line info: @"Line {L_CNT}/{WND_HEIGHT}, character {C_CNT}/{WND_WIDTH}, g_mod {G_MOD} ({C_CNT}/{NAME_SIZE} = {(C_CNT)%(NAME_SIZE)})"
            PRINTFORML !REPORT THIS!
            PRINTFORML %"-"*89%
            FORCEWAIT
            RETURN -1
        ENDIF
        LOCAL:9 = C_CNT
    NEXT
    LOCALS += @"@/C@"
    LOCALS '= REPLACE(LOCALS, "％", "%")

    CALL WndMgr_TextSet(WINDOW_ID, L_CNT, LOCALS)
NEXT

