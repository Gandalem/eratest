                        RETURN
                    ENDIF
                    IF TGC_InRadius(TGC_CastRadius:0:1, DT_CELL_GET("TGC_Map", TGC_CastRadius:0:0, "x", 1), DT_CELL_GET("TGC_Map", TGC_CastRadius:0:0, "y", 1), DT_CELL_GET("TGC_Map", nInput, "x", 1), DT_CELL_GET("TGC_Map", nInput, "y", 1))
                        CALL Com_DiaperGrab(TGC_LookingAt)
                        IF RESULT
                            DT_CELL_SET "lcCombatants", TGC_LookingAt, "didAttack", 2, 1
                            TGC_CurrentAction '= "turnEnd"
                            RETURN
                        ELSE
                            TGC_CurrentAction '= ""
                        ENDIF
                    ELSE
                        PRINTFORMW Out of range.
                    ENDIF
                    CALLF TGC_ClearRadius(0)
                ENDSELECT
            ENDSELECT
            ENDSELECT
        ENDIF
    ENDSELECT
ENDSELECT

