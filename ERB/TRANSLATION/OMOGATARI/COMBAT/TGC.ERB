;critically injured.
;overwhelming force
;damaged

@TGC_SURRENDER(Surrenderer,Surrendee)
#DIMS SurrenderLine
#DIM Surrenderer
#DIM Surrendee


PRINTDATAL
DATAFORM %CALLNAME:Surrendee% places %HIS_HER(Surrendee)% hands up and kneels down, dropping %HIS_HER(Surrendee)% weapon
DATAFORM %CALLNAME:Surrendee% drops %HIS_HER(Surrendee)% weapon and places both of %HIS_HER(Surrendee)% hands up.
ENDDATA
SurrenderLine = HTML_GETPRINTEDSTR()
CLEARLINE 1

PRINTFORMSW SurrenderLine

;FLAG:796 = 1
$SurrenderingPass
TCVAR:TGC_LookingAt:Grievous_Harm = 1
;SIF !TFLAG:妄想中 && TGC_CurrentAtSurrenderertacker != MASTER
CALL FightLosePenalty((Surrenderer),Surrendee)
DT_CELL_SET "lcCombatants", GetCombatant(Surrendee), "nonCombatant", 2, 1
SIF !GetCombatantSize(2) || !GetCombatantSize(1)
TGC_CurrentAction '= "turnEnd"


