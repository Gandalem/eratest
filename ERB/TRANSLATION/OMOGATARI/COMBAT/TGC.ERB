;==========================================
;radius: How big the radius is
;posX:0: Original X
;posY:0: Original Y
;posX:1: New X
;posY:1: New Y
;==========================================
@TGC_InRadius(radius, posX:0, posY:0, posX:1, posY:1)
#FUNCTION
#DIM DYNAMIC posX, 2
#DIM DYNAMIC posY, 2
#DIM DYNAMIC radius
