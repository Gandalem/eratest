@TGC_MenuInput
#DIM nInput

#DIM AimedShot
#DIM nSide
#DIM DYNAMIC BiggestBurst
#DIM DYNAMIC nDmgType
#DIM DYNAMIC nDMG
#DIM DYNAMIC PickCard
#DIM DYNAMIC TruncatedAttacks,15
#DIM DYNAMIC PR_WEAPON
#DIM FA_LINECOUNT
#DIM DYNAMIC FA_SUB
#DIM DYNAMIC FA_MENUBYP
#DIMS OUTPUT
#DIM DYNAMIC FA_RESIST
#DIM DYNAMIC FA_TARGETEVAL
#DIM DYNAMIC IS_VALID_FIGHTER
#DIM DYNAMIC FA_DEF_WEAPON
#DIM DYNAMIC ASDS_MAX
#DIM DYNAMIC PossibleToAttack
#DIM DYNAMIC LimitingAtkCap

SELECTCASE TGC_CurrentAction
CASE "attack_S1"
        TWAIT 500, 1
        CALL TGC_GetDamageType(0)
        TGC_AttackCurLoop = 0
        TGC_CurrentAction '= "attack_S2"
        RETURN
CASE "attack_S2"
    LimitingAtkCap = charaWeaponInts:(TGC_CurrentAttacker):MagSize && charaWeaponInts:(TGC_CurrentAttacker):Ammo < charaWeaponInts:(TGC_CurrentAttacker):Burst ? charaWeaponInts:(TGC_CurrentAttacker):Ammo # charaWeaponInts:(TGC_CurrentAttacker):Burst
    WHILE TGC_AttackCurLoop < LimitingAtkCap
        TGC_AttackCurLoop++
        CALL TGC_FIRE_WEAPON_SHOT(INRANGE(TGC_AITarget,0,CHARANUM-1) ? TGC_CurrentGridSpace(TGC_AITarget) # TGC_AITarget)
        LOCAL:17 = MIN(500/(charaWeaponInts:(TGC_CurrentAttacker):Burst+1),50)
        SIF !nNASQOL:1
        TWAIT LOCAL:17, 1
        RETURN
    WEND
    TGC_CurrentAction '= "attack_S3"
    RETURN
CASE "attack_S3"
    ;danmaku buffs and shit
    ;K is for total damage
    VARSET K
    FOR FA_TARGETEVAL,0, CHARANUM
    SIF !lcDamageDeal:(FA_TARGETEVAL):0 && !lcDamageDeal:(FA_TARGETEVAL):97 && !lcDamageDeal:(FA_TARGETEVAL):98 && !lcDamageDeal:(FA_TARGETEVAL):99
        CONTINUE

    IF TGC_CurrentAttacker == MASTER
    EasyBattleDamage = (lcDamageDeal:(FA_TARGETEVAL):0)
    EasyBattleExpToGet += EasyBattleDamage
    ;EasyBattleSave:2 += (lcDamageDeal:(FA_TARGETEVAL):0)/2 ;money
    ENDIF

    IF lcIsLethal
        IF STRCOUNT(GET_STR((TGC_CurrentAttacker), "Weapon", TGC_CurrentAttackerWeapon, WeapStats_Prefix(TGC_CurrentAttackerWeapon,charaWeaponInts:TGC_CurrentAttacker:Mode)+"Class"), "Blunt")
            nDmgType = 6
        ELSEIF STRCOUNT(GET_STR((TGC_CurrentAttacker), "Weapon", TGC_CurrentAttackerWeapon, WeapStats_Prefix(TGC_CurrentAttackerWeapon,charaWeaponInts:TGC_CurrentAttacker:Mode)+"Class"), "Blade")
            nDmgType = 2
        ELSEIF GET_STR((TGC_CurrentAttacker), "Weapon", TGC_CurrentAttackerWeapon, WeapStats_Prefix(TGC_CurrentAttackerWeapon,charaWeaponInts:TGC_CurrentAttacker:Mode)+"Type") == "Firearm"
            nDmgType = 1
        ENDIF
        IF CharaWeaponInts:TGC_CurrentAttacker:DamageType
            nDmgType = CharaWeaponInts:TGC_CurrentAttacker:DamageType
        ELSEIF GET_INT((TGC_CurrentAttacker), "Weapon", TGC_CurrentAttackerWeapon, WeapStats_Prefix(TGC_CurrentAttackerWeapon,charaWeaponInts:TGC_CurrentAttacker:Mode)+"Incendiary")
            nDmgType = 3
        ENDIF
    ELSE
        nDmgType = 1
    ENDIF


    IF (lcDamageDeal:(FA_TARGETEVAL):0) > 0
    FA_RESIST = DamageResist:(FA_TARGETEVAL):(nDmgType):1 - DT_CELL_GET(@"lcCombatants", GetCombatant(TGC_CurrentAttacker) , "pierceBuff", 1)
    FA_RESIST = LIMIT(FA_RESIST,-3,7)
    ;PRINTFORML %CALLNAME:FA_TARGETEVAL%'s Resistance: {DamageResist:(FA_TARGETEVAL):(nDmgType):1}, Pierce: {DT_CELL_GET(@"lcCombatants", GetCombatant(TGC_CurrentAttacker) , "pierceBuff", 1)}
    IF FA_RESIST && lcIsLethal
        LOCALS '= PeeAndPoo(DamageResist:(FA_TARGETEVAL):(nDmgType):1,DT_CELL_GET(@"lcCombatants", GetCombatant(TGC_CurrentAttacker) , "pierceBuff", 1),@"%CALLNAME:(FA_TARGETEVAL)%'s【%MagicTypeStrength(nDmgType,DamageResist:(FA_TARGETEVAL):(nDmgType):1,2)%】",@"%CALLNAME:(TGC_CurrentAttacker)%'s【Pierce\@ DT_CELL_GET(@"lcCombatants", GetCombatant(TGC_CurrentAttacker) , "pierceBuff", 1) > 0 ? + #\@{DT_CELL_GET(@"lcCombatants", GetCombatant(TGC_CurrentAttacker) , "pierceBuff", 1)}】")
        CALL TGC_LogAdd(@"%LOCALS%multiplies damage taken by {YoujutsuResistMULT(FA_RESIST)}\%", YoujutsuResistCOL(nDmgType,FA_RESIST), 1)
        lcDamageDeal:(FA_TARGETEVAL):0 = lcDamageDeal:(FA_TARGETEVAL):0*YoujutsuResistMULT(FA_RESIST)/100
    ENDIF
    IF TALENT:(FA_TARGETEVAL):271 && (lcDamageDeal:(FA_TARGETEVAL):0) > 0
        SETCOLOR C_YELLOW
        CALL LC_PRINT(@"%CALLNAME:(FA_TARGETEVAL)%'s【Extend】cuts the damage taken by half", , 2,)
        RESETCOLOR
        lcDamageDeal:(FA_TARGETEVAL):0 /= 2
    ELSEIF GETBIT(CFLAG:(FA_TARGETEVAL):弾幕特能, 5) && (lcDamageDeal:(FA_TARGETEVAL):0) > 0
        CALL TGC_LogAdd(@"%CALLNAME:(FA_TARGETEVAL)%'s【Deep Knowledge Of Life】cuts the damage taken by a third", C_YELLOW)
        lcDamageDeal:(FA_TARGETEVAL):0 *= 3
        lcDamageDeal:(FA_TARGETEVAL):0 /= 4
    ENDIF
    IF GETBIT(CFLAG:(FA_TARGETEVAL):弾幕特能, 4) && ((lcDamageDeal:(FA_TARGETEVAL):0) < ((MAXBASE:(FA_TARGETEVAL):体力-500)/3)) && lcDamageDeal:(FA_TARGETEVAL):97 >= (BASE:(FA_TARGETEVAL):体力-500)
        CALL TGC_LogAdd(@"%CALLNAME:(FA_TARGETEVAL)%'s【Anomalies, Strength, Disorder, and Spirits】activates!", C_RED, 1)
        IF TGC_CurrentAttackerWeapon == 0
            LOCALS '= "danmaku"
            LOCALS:1 '= "fired at"
        ELSEIF STRFIND(PrintWeaponType(TGC_CurrentAttacker,TGC_CurrentAttackerWeapon),"Firearm/") > -1
            LOCALS '= "bullets"
            LOCALS:1 '= "fired at"
        ELSEIF STRFIND(PrintWeaponType(TGC_CurrentAttacker,TGC_CurrentAttackerWeapon),"Youjutsu/") > -1
            LOCALS '= "magic"
            LOCALS:1 '= "casted at"
        ELSEIF STRFIND(PrintWeaponType(TGC_CurrentAttacker,TGC_CurrentAttackerWeapon),"Melee/") > -1
            LOCALS '= "strikes"
            LOCALS:1 '= "swung at"
        ELSE
            LOCALS '= "attacks"
            LOCALS:1 '= "targeted at"
        ENDIF
        CALL TGC_LogAdd(@"The %LOCALS% %PARSE("you",,,TGC_CurrentAttacker)% %LOCALS:1% %CALLNAME:(FA_TARGETEVAL)% disappear just before connecting!")
        ;口上呼び出し
        CALL KOJO_MESSAGE_SEND("DANMAKU", 1, (FA_TARGETEVAL), MASTER, -1, "怪力乱神")

        lcDamageDeal:(FA_TARGETEVAL):0 = LIMIT(lcDamageDeal:(FA_TARGETEVAL):0,0,MAX(0,(BASE:(FA_TARGETEVAL):体力-501)))
        ASDSCounter++
        RESETCOLOR
    ENDIF
    IF FA_RESIST  < 0 && !lcOneMore && TGC_CurrentAttacker != FA_TARGETEVAL && lcDamageDeal:(FA_TARGETEVAL):0
    CALL TGC_LogAdd(@"Weakness! %CALLNAME:TGC_CurrentAttacker% now has one more turn!", C_AQUA)
    lcOneMore = 1
    ENDIF

    IF lcDamageDeal:(FA_TARGETEVAL):97
        MissCounter = 0
    ENDIF

    IF (lcDamageDeal:(FA_TARGETEVAL):0) > 0
        SELECTCASE TALENT:(FA_TARGETEVAL):40
        CASE -2
            TIMES (lcDamageDeal:(FA_TARGETEVAL):0), 0.25
		    CALL TGC_LogAdd(@"%CALLNAME:(FA_TARGETEVAL)%'s【Toughness】cuts the damage taken to a quarter", C_YELLOW)
        CASE -1
            TIMES (lcDamageDeal:(FA_TARGETEVAL):0), 0.5
		    CALL TGC_LogAdd(@"%CALLNAME:(FA_TARGETEVAL)%'s【Toughness】cuts the damage taken by half", C_YELLOW)
        CASE 1
            TIMES (lcDamageDeal:(FA_TARGETEVAL):0), 1.15
		    CALL TGC_LogAdd(@"%CALLNAME:(FA_TARGETEVAL)%'s【Delicateness】increases the damage taken by 15\%", C_YELLOW)
        ENDSELECT
        ENDIF
    ENDIF

    BASE:(FA_TARGETEVAL):体力 = MIN(MAXBASE:(FA_TARGETEVAL):体力,BASE:(FA_TARGETEVAL):体力-(lcDamageDeal:(FA_TARGETEVAL):0))
    IF BASE:(FA_TARGETEVAL):体力-500 <= 0
    LOCAL:5 = 0
    ELSE
    LOCAL:5 = BASE:(FA_TARGETEVAL):体力-500
    ENDIF
    LOCAL:6--

    IF TGC_CurrentAttackerWeapon == 0
        LOCALS '= "shot"
    ELSEIF STRFIND(PrintWeaponType(TGC_CurrentAttacker,TGC_CurrentAttackerWeapon),"Firearm/") > -1
        LOCALS '= "shot"
    ELSEIF STRFIND(PrintWeaponType(TGC_CurrentAttacker,TGC_CurrentAttackerWeapon),"Youjutsu/") > -1
        LOCALS '= "casted at"
    ELSEIF STRFIND(PrintWeaponType(TGC_CurrentAttacker,TGC_CurrentAttackerWeapon),"Melee/") > -1
        LOCALS '= "striked"
    ELSE
        LOCALS '= "attacked"
    ENDIF
    ;CALL LC_PRINT(@"\@ TGC_CurrentAttacker == MASTER ? You # %CALLNAME:TGC_CurrentAttacker% \@ %LOCALS% %CALLNAME:(FA_TARGETEVAL)% {LOCAL:6} %PLNOUN("time",LOCAL:6)% and hit {lcDamageDeal:(FA_TARGETEVAL):97} %PLNOUN("time",lcDamageDeal:(FA_TARGETEVAL):97)% ({lcDamageDeal:(FA_TARGETEVAL):99} misses, {lcDamageDeal:(FA_TARGETEVAL):98} dodges).", , 1,)
    IF lcDamageDeal:(FA_TARGETEVAL):0 > 0
        ASDSCounter = 0
        LOCALS =
        FOR LOCAL:17, 0, 100
            SIF BDY_PART_NAME(LOCAL:17) == ""
                CONTINUE
            SIF !lcDamageDeal:(FA_TARGETEVAL):(LOCAL:17)
                CONTINUE
            LOCALS += @"{lcDamageDeal:(FA_TARGETEVAL):(LOCAL:17)} damage to the %BDY_PART_NAME(LOCAL:17)%、"
        NEXT

        CALL TGC_LogAdd(@"%PARSE("You",,,TGC_CurrentAttacker)% did %LIST_IN_STRING(LOCALS)%.")
        ;easybattle money
        K += lcDamageDeal:(FA_TARGETEVAL):0
        KilledWith:(FA_TARGETEVAL):0 '= PrintWeaponName(TGC_CurrentAttacker,TGC_CurrentAttackerWeapon,-1,2)
    ENDIF
        CALL TGC_LogAdd(@"Did {lcDamageDeal:(FA_TARGETEVAL):0} damage ({LOCAL:5}/{MAXBASE:(FA_TARGETEVAL):体力-500})")
        K:6 = MESSKIP()
        ;SKIPDISP TALENT:(FA_TARGETEVAL):Raider && K:6
        IF HasBionicPart(FA_TARGETEVAL,132) && lcDamageDeal:(FA_TARGETEVAL):0 > 0
            CALL TGC_LogAdd(@"The bomb inside %CALLNAME:FA_TARGETEVAL% explodes!")
            CALL SUICIDE_BOMB(FA_TARGETEVAL,232)
        ENDIF

        CALL CrippleEffects(FA_TARGETEVAL)
        IF IsDead:(FA_TARGETEVAL):0 && !lcOneMore && FA_TARGETEVAL != TGC_CurrentAttacker && !DT_CELL_GET(@"lcCombatants", GetCombatant(FA_TARGETEVAL) , "nonCombatant", 1) 
            CALL TGC_LogAdd(@"Fatal Blow! %CALLNAME:TGC_CurrentAttacker% now has one more turn!", C_AQUA,1)
            lcOneMore = 1
        ENDIF
        ;toilet desp
        CALL CombatLeakOnHit(FA_TARGETEVAL,lcDamageDeal:(FA_TARGETEVAL):0)
        IF (BASE:(FA_TARGETEVAL):体力 <= 500 || IsDead:(FA_TARGETEVAL):0) && !DT_CELL_GET(@"lcCombatants", GetCombatant(FA_TARGETEVAL) , "nonCombatant", 1)
            SIF DT_CELL_GET(@"lcCombatants", GetCombatant(FA_TARGETEVAL) , "lives", 1) <= 1 || lcIsLethal
            CALLF TGC_MarkDeadCombatants()
            CALL ENDFIGHT(TGC_CurrentAttacker,FA_TARGETEVAL)
        ENDIF
    NEXT
    SIF STRLENS(charaWeaponSTRs:TGC_CurrentAttacker:UserEffect)
    TRYCALLFORM %charaWeaponSTRs:TGC_CurrentAttacker:UserEffect%(TGC_CurrentAttacker)
    TGC_CurrentAction '= "turnEnd"
    RETURN
CASE "doSpell_S1"
    TGC_AttackCurLoop = 0
    CALL PROCESS_YOUJUTSU_COMMAND(TGC_CurrentAttacker,TGC_AITarget,DT_CELL_GET("combatMagic", TGC_MagicPick, "spellPage",1),DT_CELL_GET("combatMagic", TGC_MagicPick, "spell",1),1)
    IF RESULT == -9530
    TGC_CurrentAction '= ""
    ELSE
    TGC_CurrentAction '= "doSpell_S2"
    ENDIF
    RETURN
CASE "doSpell_S2"
    IF FINDELEMENT(NAS_ESP_Type,"PickArea/") > -1
        CALL TGC_CastMagicSelf(INRANGE(TGC_AITarget,0,CHARANUM-1) ? TGC_CurrentGridSpace(TGC_AITarget) # TGC_AITarget)
    ELSE
        CALL TGC_FIRE_WEAPON_SHOT(INRANGE(TGC_AITarget,0,CHARANUM-1) ? TGC_CurrentGridSpace(TGC_AITarget) # TGC_AITarget)
    ENDIF
    ;TRYCALLFORM EsperMenuResult_{PYC_PAGE}(PYC_CASTER,PYC_TARGET,PYC_SPELL)
    TGC_CurrentAction '= "turnEnd"
    RETURN
CASE "turnEnd"
        CALLF TGC_ClearRadius(0)
        CALLF ClearAttackRadiuses
        TGC_MagicPick = 0
        CALLF NAS_ESP_RESET
        VARSET lcDamageDeal
        IF TGC_ImportantMessage
            FORCEWAIT
            TGC_ImportantMessage = 0
            TGC_SkippingBoringShit = 0
        ELSE
            IF ISSKIP()
                ;TWAIT 500, 0
            ELSE
                TWAIT 500, 0
                ;TWAIT 3000, 0
            ENDIF
        ENDIF
        IF TGC_UsedTimeSkip
            TGC_UsedTimeSkip = 0
            TGC_CurrentAction '= ""
            RETURN
        ELSE
            RETURN 2
        ENDIF
CASE "wait"
    CALL TGC_LogAdd(@"%CALLNAME:TGC_CurrentAttacker% waits.")
    TGC_CurrentAction '= "turnEnd"
    RETURN
CASE "reload"
    CALL WeaponReload((TGC_CurrentAttacker))
    TGC_CurrentAction '= "turnEnd"
    RETURN
ENDSELECT

SIF TGC_InSkipMode
    RETURN

INPUT
nInput = RESULT
