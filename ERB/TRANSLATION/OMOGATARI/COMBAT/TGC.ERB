@TGC_FIRE_WEAPON_SHOT(shootingAt)
#DIM DYNAMIC shootingAt
#DIM  DYNAMIC weaponIsFired
#DIM  DYNAMIC hitIsDirect
#DIM  DYNAMIC currentAccuracy
#DIM  DYNAMIC castingMagic
#DIM  DYNAMIC pelletCount

castingMagic = (TGC_CurrentAction == "doSpell_S2")
weaponIsFired = 0

IF !castingMagic
    pelletCount = charaWeaponInts:(TGC_CurrentAttacker):Pellets+1
    IF lcIsLethal
        IF TGC_CurrentAttackerWeapon && charaWeaponInts:(TGC_CurrentAttacker):MagSize
            weaponIsFired = 1
            charaWeaponInts:(TGC_CurrentAttacker):Ammo --
        ELSEIF charaWeaponInts:(TGC_CurrentAttacker):MPCost && TALENT:(TGC_CurrentAttacker):ESP
            BASE:(TGC_CurrentAttacker):法力 -= charaWeaponInts:(TGC_CurrentAttacker):MPCost
        ENDIF
    ELSE
        IF GETBIT(TALENT:TGC_CurrentAttacker:ESP,0)
            BASE:(TGC_CurrentAttacker):法力 --
        ENDIF
    ENDIF
ELSE
    ;magics
    ;because it doesn't count the ending number we must add one
    pelletCount = 2
ENDIF

IF castingMagic
    currentAccuracy = 100
ELSE
    currentAccuracy = TGC_AccuracyDifference(TGC_CurrentAttacker,0,shootingAt)
ENDIF
FOR LOCAL:7, 1, pelletCount
    hitIsDirect = 0
    IF RAND(100) < currentAccuracy
        ;hit
        ;CALL TGC_LogAdd(@"direct hit! (AoE {charaWeaponInts:(TGC_CurrentAttacker):MultiHit})")
        LOCAL:9 = shootingAt
        CALL TGC_CREATE_HIT_EXPLOSION(TGC_CurrentAttacker,shootingAt,1,shootingAt)
        CALL TGC_CREATE_HIT_FRAGMENT(TGC_CurrentAttacker,shootingAt,1,shootingAt)
        $AttackSpace
        ;CALLF TGC_CreateRadius(LOCAL:9,charaWeaponInts:(TGC_CurrentAttacker):MultiHit,2,C_RED,"⁂",0)
        FOR LOCAL:8, 0, DT_ROW_LENGTH("TGC_Map")
            IF !STRLENS(DT_CELL_GETS("TGC_Map", LOCAL:8, "charactersInside"))
                CONTINUE
            ENDIF
            FOR LOCAL:11, 0, STRCOUNT(DT_CELL_GETS("TGC_Map", LOCAL:8, "charactersInside"), "/")
                LOCAL:10 = TOINT(SPLIT_SINGLE(DT_CELL_GETS("TGC_Map", LOCAL:8, "charactersInside"), LOCAL:11, "/"))
                IF DT_CELL_GET("TGC_Map", LOCAL:8, "id") == LOCAL:9 || TGC_InRadius(charaWeaponInts:(TGC_CurrentAttacker):MultiHit, DT_CELL_GET("TGC_Map", LOCAL:9, "x", 1), DT_CELL_GET("TGC_Map", LOCAL:9, "y", 1), DT_CELL_GET("TGC_Map", LOCAL:8, "x"), DT_CELL_GET("TGC_Map", LOCAL:8, "y"))
                    ;CALL TGC_LogAdd(@"can hit at %DT_CELL_GETS("TGC_Map", LOCAL:8, "positionID")%")
                    IF castingMagic
                        CALL TGC_ReGetMagicInfo
            		    ;CALL TGC_LogAdd(@"TARGET: {LOCAL:10} %CALLNAME:(LOCAL:10)% | ID: {TGC_MagicPick} | Spell: {NAS_ESP_SINGLE_VARIANT ? NAS_ESP_SINGLE_VARIANT # DT_CELL_GET("combatMagic", TGC_MagicPick, "spell",1)}", C_YELLOW)
                        TRYCALLFORM EsperMenuResult_{DT_CELL_GET("combatMagic", TGC_MagicPick, "spellPage",1)}(TGC_CurrentAttacker,LOCAL:10,NAS_ESP_SINGLE_VARIANT > -1 ? NAS_ESP_SINGLE_VARIANT # DT_CELL_GET("combatMagic", TGC_MagicPick, "spell",1))
                    ELSE
                        CALL TGC_HitByCharacter(LOCAL:10, LOCAL:9)
                    ENDIF
                ENDIF
                IF DT_EXIST("fragmentationTemp") || DT_EXIST("explosionTemp")
                    SIF DT_CELL_GET("lcCombatants", LOCAL:10, "chara", 1) == TGC_AITarget
                        CONTINUE
                    ;CALL HIT_BY_FRAGMENT(LOCAL:10,1,0)
                    CALL TGC_HIT_BY_EXPLOSION(LOCAL:10,1,0)
                    CALL TGC_HIT_BY_FRAGMENT(LOCAL:10,1,0)
                ENDIF
            NEXT
        NEXT
    ELSE
        ;miss
        ;CALL TGC_LogAdd(@"%CALLNAME:TGC_CurrentAttacker% missed! you suck!")
        IF !nNASQOL:1
        CALL TGC_LogAdd(@"Miss!")
        ENDIF

        ;still cause an explosion, but in a few tiles away

        ;get space

        LOCAL:9 = shootingAt
        LOCAL:21 = LIMIT(DT_CELL_GET("TGC_Map", LOCAL:9, "x", 1)+RAND(-4,5),0,TGC_MapSize:0)
        LOCAL:22 = LIMIT(DT_CELL_GET("TGC_Map", LOCAL:9, "y", 1)+RAND(-4,5),0,TGC_MapSize:1)
        DT_SELECT "TGC_Map", @"x = '{LOCAL:21}' and y = '{LOCAL:22}'"
        LOCAL:23 = RESULT:1
        ;#; DEBUGPRINTFORML miss! attempting to create explosion at {LOCAL:21}, {LOCAL:22} ({LOCAL:23})
        CALL TGC_CREATE_HIT_EXPLOSION(TGC_CurrentAttacker,0,0,LOCAL:23)
        CALL TGC_CREATE_HIT_FRAGMENT(TGC_CurrentAttacker,0,0,LOCAL:23)

        GOTO AttackSpace

    ENDIF
    ;first we check if we actually hit where we want to go
NEXT

