; I want to propose a lot of damage close to epicenter and a sharp falloff after a bit (all dependant on weapon)
; but I think a linear-ish model makes more sense
; at the very least I think they should be distinct from AoE magic in that the center of an explosion is more effective, but magic spreads better
; like, mafrei deals 100% everywhere it affects, while same base explosion does say 125% where it lands but falls off with every tile

@TGC_HIT_BY_EXPLOSION(RecipientID,inCombat,shotTargetPart,isAlwaysLethal=0,AlwaysHits=0)
#DIM DealerID
#DIM RecipientID
#DIM explosionsList, 500
#DIM FragmentsTotal
#DIM nDMG
#DIM GetDamageType
#DIM F_ID
#DIM DYNAMIC nDMGMultiplier
#DIMS DYNAMIC nDMGPartBroad
#DIM DYNAMIC nDMGPart
#DIM DYNAMIC inCombat
#DIM DYNAMIC shotTargetPart
#DIM DYNAMIC isAlwaysLethal
#DIM DYNAMIC AlwaysHits
#DIM DYNAMIC RandomSpread
#DIM DYNAMIC explosionSize
#DIM DYNAMIC explosionAccuracy
#DIM DYNAMIC nDMGRangeMultiplier
#DIM DYNAMIC rangeDifference
#DIM DYNAMIC gridID, 2
#DIM DYNAMIC posX, 2
#DIM DYNAMIC posY, 2

SELECTCASE shotTargetPart
CASE 0
    RandomSpread = 1
CASEELSE
    RandomSpread = 0
ENDSELECT
 


IF DT_EXIST("explosionTemp")
    VARSET explosionsList
    FragmentsTotal = DT_SELECT("explosionTemp",,,explosionsList)
    nDMGRangeMultiplier = 100
    gridID:0 = TGC_CurrentGridSpace(RecipientID)
    posX:0 = DT_CELL_GET("TGC_Map", gridID:0, "x",1)
    posY:0 = DT_CELL_GET("TGC_Map", gridID:0, "y",1)
    FOR LOCAL,0,FragmentsTotal
        SIF RandomSpread
            shotTargetPart = RAND(1,9)

        nDMGPart = AimedShotInfo(shotTargetPart)
        nDMGMultiplier = RESULT:1
        nDMGPartBroad '= RESULTS:1
        F_ID = explosionsList:LOCAL
        nDMG = DT_CELL_GET("explosionTemp", F_ID, "damage",1)
        GetDamageType = DT_CELL_GET("explosionTemp", F_ID, "damageType",1)
        DealerID = DT_CELL_GET("explosionTemp", F_ID, "owner",1)
        explosionSize = MAX(1,DT_CELL_GET("explosionTemp", F_ID, "size",1))
        gridID:1 = DT_CELL_GET("explosionTemp", F_ID, "areaID",1)
        posX:1 = DT_CELL_GET("TGC_Map", gridID:1, "x",1)
        posY:1 = DT_CELL_GET("TGC_Map", gridID:1, "y",1)
        ;get the range difference
        rangeDifference = TGC_RangeDifference(posX:0, posY:0, posX:1, posY:1)
        ;rangeDifference = (ABS(posX:0-posX:1) + ABS(posY:0-posY:1))
        SIF rangeDifference > explosionSize
            CONTINUE
        ;nDMGRangeMultiplier = (explosionSize-rangeDifference)*100/explosionSize
        nDMGRangeMultiplier = (explosionSize-rangeDifference)*100/explosionSize
        ; not happening
        SIF nDMGRangeMultiplier <= 0
            GOTO HitMiss
        ;explosionAccuracy = (explosionSize-rangeDifference)*100/explosionSize
        explosionAccuracy = 100
        ;nDMGRangeMultiplier = nDMGRangeMultiplier*MIN(explosionAccuracy,100)/100

        ;;#; DEBUGPRINTFORML explosion: %NAME:RecipientID% (int {DT_CELL_GET("explosionTemp", F_ID, "intendedVictim",1)}), part {shotTargetPart} (int: {DT_CELL_GET("explosionTemp", F_ID, "directHit",1)}), distance {rangeDifference}/{explosionSize}
        IF RAND(100) < explosionAccuracy
            nDMGPartBroad '= "fullbody"
            GOTO HitDirect
        ELSE
            $HitMiss
            ; DT_CELL_SET "explosionTemp", F_ID, "checkedByTouhou", DT_CELL_GET("explosionTemp", F_ID, "checkedByTouhou",1)+1, 1
            ; IF DT_CELL_GET("explosionTemp", F_ID, "checkedByTouhou",1) >= ExplosionSizeTohuous(DT_CELL_GET("explosionTemp", F_ID, "size",1))
            ;     DT_ROW_REMOVE "explosionTemp", F_ID
            ; ENDIF
            CONTINUE
        ENDIF

        ;direct hit
        IF DT_CELL_GET("explosionTemp", F_ID, "directHit",1) == shotTargetPart
            $HitDirect
            ;;#; DEBUGPRINTFORML explosion hit %CALLNAME:RecipientID% for {nDMG} (multiplier {nDMGMultiplier}) on part {nDMGPart}
            IF lcIsLethal || isAlwaysLethal
                SIF !charaWeaponInts:(DealerID):NonLethal
                    CALLF BroadDamage((RecipientID),explosionSize >= 3 ? "fullbody" # nDMGPartBroad,nDMG*nDMGRangeMultiplier/100,GetDamageType,(DealerID),printWeaponName(DealerID,,-1)+" explosion")
            ENDIF
            lcDamageDeal:(RecipientID):0 += (nDMG*nDMGMultiplier*nDMGRangeMultiplier/10000)
            lcDamageDeal:(RecipientID):(nDMGPart) += (nDMG*nDMGMultiplier*nDMGRangeMultiplier/10000)
            ; DT_CELL_SET "explosionTemp", F_ID, "checkedByTouhou", DT_CELL_GET("explosionTemp", F_ID, "checkedByTouhou",1)+1, 1
            ; IF DT_CELL_GET("explosionTemp", F_ID, "checkedByTouhou",1) >= ExplosionSizeTohuous(explosionSize)
            ;     DT_ROW_REMOVE "explosionTemp", F_ID
            ; ENDIF
        ENDIF
    NEXT
ENDIF

@TGC_HIT_BY_FRAGMENT(RecipientID,inCombat,shotTargetPart,isAlwaysLethal=0,AlwaysHits=0)
#DIM DealerID
#DIM RecipientID
#DIM explosionsList, 500
#DIM FragmentsTotal
