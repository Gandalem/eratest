        ENDIF
        TCVAR:TGC_CurrentAttacker:Attack_Power = 2*GetCombatAbility(TGC_CurrentAttacker) + (ABL:TGC_CurrentAttacker:指/2)
        TCVAR:TGC_LookingAt:Attack_Power = 2*GetCombatAbility(TGC_LookingAt) + (ABL:TGC_LookingAt:指/2)
