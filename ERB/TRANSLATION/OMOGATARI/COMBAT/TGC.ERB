;ARG:0: root position, usually the top left
;ARG:1: X space needed
;ARG:2: Y space needed
@TGC_ObstacleHasSpace(ARG, ARG:1, ARG:2)
#FUNCTION
#DIM currentGridLoc,2
#DIM reservedGridLocs,300
#DIM reservedGridLocCount

currentGridLoc:0 = DT_CELL_GET("TGC_Map", ARG, "x", 1)
currentGridLoc:1 = DT_CELL_GET("TGC_Map", ARG, "y", 1)

;not enough space
SIF currentGridLoc:0+ARG:1 > TGC_MapSize:0 || currentGridLoc:1+ARG:2 > TGC_MapSize:1
    RETURNF 0

;get reserved grids
reservedGridLocCount = DT_SELECT("TGC_Map", @"x >= {currentGridLoc:0} and x <= {currentGridLoc:0+ARG:1} and y >= {currentGridLoc:1} and y < {currentGridLoc:1+ARG:1}", "", reservedGridLocs)
;check all
FOR LOCAL, 0, reservedGridLocCount
    ;obstacle blocked, do not generate.
    SIF STRLENS(DT_CELL_GETS("TGC_Map", reservedGridLocs:LOCAL, "coverType", 1))
    RETURNF 0
NEXT

;clear
RETURNF 1


