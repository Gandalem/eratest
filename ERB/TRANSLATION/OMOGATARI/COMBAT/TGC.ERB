IF DT_EXIST("fragmentationTemp")
    VARSET explosionsList
    FragmentsTotal = DT_SELECT("fragmentationTemp",,,explosionsList)
    nDMGRangeMultiplier = 100
    gridID:0 = TGC_CurrentGridSpace(RecipientID)
    posX:0 = DT_CELL_GET("TGC_Map", gridID:0, "x",1)
    posY:0 = DT_CELL_GET("TGC_Map", gridID:0, "y",1)
    FOR LOCAL,0,FragmentsTotal
        SIF RandomSpread
            shotTargetPart = RAND(1,9)

        nDMGPart = AimedShotInfo(shotTargetPart)
        nDMGMultiplier = RESULT:1
        nDMGPartBroad '= RESULTS:1
        F_ID = explosionsList:LOCAL
        nDMG = DT_CELL_GET("fragmentationTemp", F_ID, "damage",1)
        GetDamageType = DT_CELL_GET("fragmentationTemp", F_ID, "damageType",1)
        DealerID = DT_CELL_GET("fragmentationTemp", F_ID, "owner",1)
        explosionSize = MAX(1,DT_CELL_GET("fragmentationTemp", F_ID, "size",1))
        gridID:1 = DT_CELL_GET("fragmentationTemp", F_ID, "areaID",1)
        posX:1 = DT_CELL_GET("TGC_Map", gridID:1, "x",1)
        posY:1 = DT_CELL_GET("TGC_Map", gridID:1, "y",1)
        ;get the range difference
        rangeDifference = TGC_RangeDifference(posX:0, posY:0, posX:1, posY:1)
        SIF rangeDifference > explosionSize
            CONTINUE
        ;100% since fragments don't have damage fall off
        explosionAccuracy = (explosionSize-rangeDifference)*100/explosionSize
        ;explosionAccuracy = 100
        ;nDMGRangeMultiplier = nDMGRangeMultiplier*MIN(explosionAccuracy,100)/100

        ;;#; DEBUGPRINTFORML fragment: %NAME:RecipientID% (int {DT_CELL_GET("fragmentationTemp", F_ID, "intendedVictim",1)}), part {shotTargetPart} (int: {DT_CELL_GET("fragmentationTemp", F_ID, "directHit",1)}), distance {rangeDifference}/{explosionSize}
        IF RAND(100) < explosionAccuracy
            nDMGPartBroad '= "fullbody"
            GOTO HitDirect
        ELSE
            $HitMiss
            ; DT_CELL_SET "fragmentationTemp", F_ID, "checkedByTouhou", DT_CELL_GET("fragmentationTemp", F_ID, "checkedByTouhou",1)+1, 1
            ; IF DT_CELL_GET("fragmentationTemp", F_ID, "checkedByTouhou",1) >= ExplosionSizeTohuous(DT_CELL_GET("fragmentationTemp", F_ID, "size",1))
            ;     DT_ROW_REMOVE "fragmentationTemp", F_ID
            ; ENDIF
            CONTINUE
        ENDIF

        ;direct hit
        $HitDirect
        ;;#; DEBUGPRINTFORML fragment hit %CALLNAME:RecipientID% for {nDMG} (multiplier {nDMGMultiplier}) on part {nDMGPart}
        IF lcIsLethal || isAlwaysLethal
            SIF !charaWeaponInts:(DealerID):NonLethal
                CALLF BroadDamage((RecipientID), nDMGPartBroad, nDMG*nDMGRangeMultiplier/100,GetDamageType,(DealerID),printWeaponName(DealerID,,-1)+" fragment")
        ENDIF
        lcDamageDeal:(RecipientID):0 += (nDMG*nDMGMultiplier*nDMGRangeMultiplier/10000)
        lcDamageDeal:(RecipientID):(nDMGPart) += (nDMG*nDMGMultiplier*nDMGRangeMultiplier/10000)
        ; DT_CELL_SET "explosionTemp", F_ID, "checkedByTouhou", DT_CELL_GET("explosionTemp", F_ID, "checkedByTouhou",1)+1, 1
        ; IF DT_CELL_GET("explosionTemp", F_ID, "checkedByTouhou",1) >= ExplosionSizeTohuous(explosionSize)
        ;     DT_ROW_REMOVE "explosionTemp", F_ID
        ; ENDIF
    NEXT
ENDIF



@TGC_AccuracyDifference(ARG,ARG:1,targetGrid = 0)
#FUNCTION
#DIM attackerAccuracy
#DIM DYNAMIC posX, 2
#DIM DYNAMIC posY, 2
#DIM DYNAMIC combatantID, 2
#DIM DYNAMIC rangeDifference
#DIM DYNAMIC maxRange
#DIM DYNAMIC targetGrid
combatantID:0 = GetCombatant(ARG)
posX:0 = TOINT(SPLIT_SINGLE(DT_CELL_GETS("lcCombatants", combatantID:0, "positionID", 1), 1, ","))
posY:0 = TOINT(SPLIT_SINGLE(DT_CELL_GETS("lcCombatants", combatantID:0, "positionID", 1), 1, ","))

IF targetGrid
ELSE
    combatantID:1 = GetCombatant(ARG:1)
    posX:1 = TOINT(SPLIT_SINGLE(DT_CELL_GETS("lcCombatants", combatantID:1, "positionID", 1), 1, ","))
    posY:1 = TOINT(SPLIT_SINGLE(DT_CELL_GETS("lcCombatants", combatantID:1, "positionID", 1), 1, ","))
ENDIF

;calculate the difference in terms of range
rangeDifference = (ABS(posX:0-posX:1) + ABS(posY:0-posY:1))
attackerAccuracy = GetShootingAccuracy(ARG)
maxRange = charaWeaponInts:ARG:Range

;range curve
SELECTCASE rangeDifference
CASE 0, 1
    ;POINT BLANK
    attackerAccuracy = MAX(attackerAccuracy,5)
    attackerAccuracy *= 4
CASE IS <= maxRange*20/100
    ; before 2/10ths the range, there will be slightly better accuracy.
    attackerAccuracy = attackerAccuracy*120/100
CASE IS <= maxRange*40/100
    attackerAccuracy = attackerAccuracy*100/100
CASE IS <= maxRange*60/100
    attackerAccuracy = attackerAccuracy*90/100
CASE IS <= maxRange*75/100
    attackerAccuracy = attackerAccuracy*75/100
CASE IS <= maxRange*80/100
    ; at 8/10ths the range, it will be drastically 
    attackerAccuracy = attackerAccuracy*55/100
CASE IS <= maxRange*90/100
    ; at 9/10ths the range, it will be about useless
    attackerAccuracy = attackerAccuracy*33/100
CASE IS <= maxRange
    ; at 9/10ths the range, it will be about useless
    attackerAccuracy = attackerAccuracy*25/100
ENDSELECT

SIF !targetGrid
    RETURNF attackerAccuracy
;size curve
SELECTCASE TALENT:(ARG:1):100
CASE -5
    ;inchling
    attackerAccuracy = attackerAccuracy*16/100
CASE -4
    ;baby sized
    attackerAccuracy = attackerAccuracy*33/100
CASE -3
    ;toddler sized
    attackerAccuracy = attackerAccuracy*55/100
CASE -2
    ;child sized
    attackerAccuracy = attackerAccuracy*75/100
CASE -1
    ;petite
    attackerAccuracy = attackerAccuracy*90/100
CASE 1
    ;tall
    attackerAccuracy = attackerAccuracy*110/100
CASE 2
    attackerAccuracy = attackerAccuracy*170/100
CASE 3
CASE 4
CASE 5
    ;giant
    attackerAccuracy = attackerAccuracy*400/100
ENDSELECT

RETURNF attackerAccuracy


@TGC_GetDamageType(getLogs)
#DIM nDmgType
#DIM getLogs
#DIMS logInfo
#DIMS weaponTypeStr
#DIMS weaponName
IF lcIsLethal
    weaponName = %PrintWeaponName(TGC_CurrentAttacker,TGC_CurrentAttackerWeapon,-1)%
    IF STRCOUNT(GET_STR((TGC_CurrentAttacker), "Weapon", TGC_CurrentAttackerWeapon, WeapStats_Prefix(TGC_CurrentAttackerWeapon,charaWeaponInts:TGC_CurrentAttacker:Mode)+"Class"), "Blunt")
        weaponTypeStr '= "melee"
        nDmgType = 6
    ELSEIF STRCOUNT(GET_STR((TGC_CurrentAttacker), "Weapon", TGC_CurrentAttackerWeapon, WeapStats_Prefix(TGC_CurrentAttackerWeapon,charaWeaponInts:TGC_CurrentAttacker:Mode)+"Class"), "Blade")
        weaponTypeStr '= "melee"
        nDmgType = 2
    ELSEIF GET_STR((TGC_CurrentAttacker), "Weapon", TGC_CurrentAttackerWeapon, WeapStats_Prefix(TGC_CurrentAttackerWeapon,charaWeaponInts:TGC_CurrentAttacker:Mode)+"Type") == "Firearm"
        weaponTypeStr '= "firearm"
        nDmgType = 1
    ELSEIF GET_STR((TGC_CurrentAttacker), "Weapon", TGC_CurrentAttackerWeapon, WeapStats_Prefix(TGC_CurrentAttackerWeapon,charaWeaponInts:TGC_CurrentAttacker:Mode)+"Type") == "Youjutsu"
        weaponTypeStr '= "youjutsu"
    ELSE
    ENDIF

    IF CharaWeaponInts:TGC_CurrentAttacker:DamageType
        nDmgType = CharaWeaponInts:TGC_CurrentAttacker:DamageType
    ELSEIF GET_INT((TGC_CurrentAttacker), "Weapon", TGC_CurrentAttackerWeapon, WeapStats_Prefix(TGC_CurrentAttackerWeapon,charaWeaponInts:TGC_CurrentAttacker:Mode)+"Incendiary")
        nDmgType = 3
    ENDIF
ELSE
    weaponName = %GET_STR((TGC_CurrentAttacker), "Weapon", 0, "名前")%
    weaponTypeStr '= "firearm"
    nDmgType = 1
ENDIF

IF getLogs
    IF !INRANGE(TGC_LookingAt,0,CHARANUM-1)
        LOCALS '= "the terrain" 
    ELSE
        LOCALS '= CALLNAME:TGC_AITarget
    ENDIF
    SELECTCASE weaponTypeStr
    CASE "firearm"
        logInfo '= @"%PARSE("You fire",,,TGC_CurrentAttacker)% off %PRINT_PLUR("shot",charaWeaponInts:(TGC_CurrentAttacker):Burst)% off %PARSE("your",5,,TGC_CurrentAttacker)% %weaponName% at %LOCALS%."
    CASE "melee"
        logInfo '= @"%PARSE("You swing your",,,TGC_CurrentAttacker)% %weaponName% %PRINT_PLUR("time",charaWeaponInts:(TGC_CurrentAttacker):Burst)% at %LOCALS%."
    CASE "youjutsu"
        logInfo '= @"%PARSE("You cast",,,TGC_CurrentAttacker)% %PRINT_PLUR("shot",charaWeaponInts:(TGC_CurrentAttacker):Burst)% off %PARSE("your",5,,TGC_CurrentAttacker)% %weaponName% at %LOCALS%."
    CASEELSE
        logInfo '= @"%PARSE("You use your",,,TGC_CurrentAttacker)% %weaponName% %PRINT_PLUR("times",charaWeaponInts:(TGC_CurrentAttacker):Burst)% at %LOCALS%."
    ENDSELECT
    CALL TGC_LogAdd(logInfo)
ENDIF

