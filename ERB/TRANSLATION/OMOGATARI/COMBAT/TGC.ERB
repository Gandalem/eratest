;Obstacle types:
;Walls
    ; Drywall (concealment only)
    ; Wooden wall (VPAM 3)
    ; Brick wall (VPAM 9)
;Trees
    ; Tree (VPAM 5)
;Rocks
    ; Brick wall (VPAM 9)
;Impassable Terrain
    ; Will stop all bullets
    ; Cannot go through. Must pass.
;Water
    ; Bullets can pass through
    ; Characters take a massive movement penalty (uses 4! spaces)
    ; (if a river, make vampires unable to cross)
;Escape caves
    ; Acts as places where you can retreat to

;=======================================
;TGC_GenerateObstacles
;=======================================
;generate a number of obstacles depending on our terrain type
;home (lots of walls)
;street (lots of buildings)
;forest (lots of trees, some mountains)
;plains (mostly nothing)
@TGC_GenerateObstacles(ARG)
#DIM DYNAMIC tileList, 2000
#DIM DYNAMIC tileCount
#DIM DYNAMIC obsTileList, 100
#DIM DYNAMIC obsTileCount
#DIM DYNAMIC obs_GenLoop, 2
;tileCount = DT_SELECT("TGC_Map", "x = 12 and y = 5", "", tileList)

SELECTCASE ARG
CASE 0
    ;blank
CASE 1
    ;cabin in the woods

    ;make all grass
    FOR obs_GenLoop,0,DT_ROW_LENGTH("TGC_Map")
        DT_CELL_SET "TGC_Map", obs_GenLoop, "floorType", "grass", 0
    NEXT

    tileCount = DT_SELECT("TGC_Map", @"x = {(TGC_MapSize:0/2)-2} and y = {(TGC_MapSize:1/2)-2}", "", tileList)
    CALL TGC_GenerateObstacleStructure(tileList,"building",0)
    FOR obs_GenLoop,0,TGC_MapSize:0/3
        FOR obs_GenLoop:1,0,TGC_MapSize:1/3
            tileCount = DT_SELECT("TGC_Map", @"x = {MAX(0,(3*obs_GenLoop)-1)} and y = {MAX(0,(3*obs_GenLoop:1)-1)}", "", tileList)
            CALL TGC_GenerateObstacleStructure(tileList,"tree",1)
        NEXT
    NEXT
    
    ;dirt pathway
    tileCount = DT_SELECT("TGC_Map", @"x = {(TGC_MapSize:0/2)-1} and y >= {(TGC_MapSize:1/2)+2}", "", tileList)
    FOR obs_GenLoop,0,tileCount
        DT_CELL_SET "TGC_Map", tileList:obs_GenLoop, "floorType", "roadDirt", 1
        DT_CELL_SET "TGC_Map", tileList:obs_GenLoop, "coverType", "", 1
    NEXT
    
CASE 2
    ;crossroads

    ;road cross 1
    tileCount = DT_SELECT("TGC_Map", @"y >= {(TGC_MapSize:1/2)-2} and y <= {(TGC_MapSize:1/2)+1}", "", tileList)
    FOR obs_GenLoop,0,tileCount
        DT_CELL_SET "TGC_Map", tileList:obs_GenLoop, "floorType", "road", 1
        DT_CELL_SET "TGC_Map", tileList:obs_GenLoop, "coverType", "", 1
    NEXT
    ;road cross 2
    tileCount = DT_SELECT("TGC_Map", @"x >= {(TGC_MapSize:0/2)-2} and x <= {(TGC_MapSize:0/2)+1}", "", tileList)
    FOR obs_GenLoop,0,tileCount
        DT_CELL_SET "TGC_Map", tileList:obs_GenLoop, "floorType", "road", 1
        DT_CELL_SET "TGC_Map", tileList:obs_GenLoop, "coverType", "", 1
    NEXT


    ;random buildings
    FOR obs_GenLoop,0,4
        LOCAL:1 = GROUPMATCH(obs_GenLoop,1,3) ? (TGC_MapSize:0/2)+2 # 0
        LOCAL:2 = GROUPMATCH(obs_GenLoop,2,3) ? (TGC_MapSize:1/2)+2 # 0
        SELECTCASE RAND:4
        CASE 0
            ;housing block
            tileCount = DT_SELECT("TGC_Map", @"x = {LOCAL:1} and y = {LOCAL:2}", "", tileList)
            CALL TGC_GenerateObstacleStructure(tileList,"building",0,obs_GenLoop >= 2 ? 2 # 0)
            tileCount = DT_SELECT("TGC_Map", @"x = {LOCAL:1+5} and y = {LOCAL:2+0}", "", tileList)
            CALL TGC_GenerateObstacleStructure(tileList,"building",0,obs_GenLoop >= 2 ? 2 # 0)
            tileCount = DT_SELECT("TGC_Map", @"x = {LOCAL:1+10} and y = {LOCAL:2+0}", "", tileList)
            CALL TGC_GenerateObstacleStructure(tileList,"building",0,obs_GenLoop >= 2 ? 2 # 0)
            tileCount = DT_SELECT("TGC_Map", @"x = {LOCAL:1} and y = {LOCAL:2+(TGC_MapSize:1/2)-6}", "", tileList)
            CALL TGC_GenerateObstacleStructure(tileList,"building",0,obs_GenLoop >= 2 ? 2 # 0)
            tileCount = DT_SELECT("TGC_Map", @"x = {LOCAL:1+5} and y = {LOCAL:2+(TGC_MapSize:1/2)-6}", "", tileList)
            CALL TGC_GenerateObstacleStructure(tileList,"building",0,obs_GenLoop >= 2 ? 2 # 0)
            tileCount = DT_SELECT("TGC_Map", @"x = {LOCAL:1+10} and y = {LOCAL:2+(TGC_MapSize:1/2)-6}", "", tileList)
            CALL TGC_GenerateObstacleStructure(tileList,"building",0,obs_GenLoop >= 2 ? 2 # 0)
        CASE 1
            ;super market
            tileCount = DT_SELECT("TGC_Map", @"x = {LOCAL:1} and y = {LOCAL:2}", "", tileList)
            CALL TGC_GenerateObstacleStructure(tileList,"building",1,obs_GenLoop >= 2 ? 2 # 0)
        CASE 2
            ;shops
            tileCount = DT_SELECT("TGC_Map", @"x = {LOCAL:1} and y = {LOCAL:2}", "", tileList)
            CALL TGC_GenerateObstacleStructure(tileList,"building",2,obs_GenLoop >= 2 ? 2 # 0)
            tileCount = DT_SELECT("TGC_Map", @"x = {LOCAL:1+8} and y = {LOCAL:2}", "", tileList)
            CALL TGC_GenerateObstacleStructure(tileList,"building",2,obs_GenLoop >= 2 ? 2 # 0)
        CASE 3
            ;apartment
            tileCount = DT_SELECT("TGC_Map", @"x = {LOCAL:1} and y = {LOCAL:2}", "", tileList)
            CALL TGC_GenerateObstacleStructure(tileList,"building",3,0)
        ENDSELECT
    NEXT
    ;rotation test
    ; tileCount = DT_SELECT("TGC_Map", @"x = {0} and y = {(TGC_MapSize:1/2)+2}", "", tileList)
    ; CALL TGC_GenerateObstacleStructure(tileList,"building",0,2)
    ; tileCount = DT_SELECT("TGC_Map", @"x = {5} and y = {(TGC_MapSize:1/2)+2}", "", tileList)
    ; CALL TGC_GenerateObstacleStructure(tileList,"building",0,1)
    ; tileCount = DT_SELECT("TGC_Map", @"x = {10} and y = {(TGC_MapSize:1/2)+2}", "", tileList)
    ; CALL TGC_GenerateObstacleStructure(tileList,"building",0,3)
CASE 3
    ; river and a bridge

    ;make all grass
    FOR obs_GenLoop,0,DT_ROW_LENGTH("TGC_Map")
        DT_CELL_SET "TGC_Map", obs_GenLoop, "floorType", "grass", 0
    NEXT

    ;river at the middle
        ;set up river. LOCAL:1 is the starting position
        tileCount = DT_SELECT("TGC_Map", @"x = {(TGC_MapSize:0/2)} and y = {0}", "", tileList)
        LOCAL:1 = tileList
        LOCAL:2 = (TGC_MapSize:0/2)
        DT_CELL_SET "TGC_Map", tileList, "floorType", "river", 1
        ;now that we have the initial position, we can make the river go across the y axis.
        FOR obs_GenLoop,0,TGC_MapSize:1
            LOCAL:2 = obs_GenLoop ? LOCAL:2 + (RAND(-1,2)) # LOCAL:2
            FOR obs_GenLoop:1,-3,4
                tileCount = DT_SELECT("TGC_Map", @"x = {(LOCAL:2)+(obs_GenLoop:1)} and y = {obs_GenLoop}", "", tileList)
                IF GROUPMATCH(obs_GenLoop:1,-3,3)
                    ;beach
                    DT_CELL_SET "TGC_Map", tileList, "floorType", "sand", 1
                ELSE
                    DT_CELL_SET "TGC_Map", tileList, "floorType", "river", 1
                ENDIF
                ;save the middle position
                SIF obs_GenLoop:1 == 0 && DT_CELL_GET("TGC_Map", tileList, "y",1) == TGC_MapSize:1/2
                    LOCAL:3 = tileList
            NEXT
        NEXT
    


    ;bridge
    DT_CELL_SET "TGC_Map", LOCAL:3, "floorType", "bridgeWood", 1
    LOCAL:2 = DT_CELL_GET("TGC_Map",LOCAL:3,"x",1)
    LOCAL:4 = DT_CELL_GET("TGC_Map",LOCAL:3,"y",1)
    FOR obs_GenLoop,-1,2
        FOR obs_GenLoop:1,-3,4
            tileCount = DT_SELECT("TGC_Map", @"x = {(LOCAL:2)+(obs_GenLoop:1)} and y = {LOCAL:4+obs_GenLoop}", "", tileList)
            DT_CELL_SET "TGC_Map", tileList, "floorType", "bridgeWood", 1
        NEXT
    NEXT

    ;bridge path
    LOCAL:2 = DT_CELL_GET("TGC_Map",LOCAL:3,"x",1)-4
    LOCAL:4 = DT_CELL_GET("TGC_Map",LOCAL:3,"y",1)
    FOR obs_GenLoop, LOCAL:2,-1,-1
        LOCAL:4 = obs_GenLoop != LOCAL:2 ? LOCAL:4 + (RAND(-1,2)) # LOCAL:4
        tileCount = DT_SELECT("TGC_Map", @"x = {(LOCAL:2)-(obs_GenLoop)} and y = {LOCAL:4}", "", tileList)
        DT_CELL_SET "TGC_Map", tileList, "floorType", "road", 1
    NEXT
    LOCAL:2 = DT_CELL_GET("TGC_Map",LOCAL:3,"x",1)+4
    LOCAL:4 = DT_CELL_GET("TGC_Map",LOCAL:3,"y",1)
    FOR obs_GenLoop, LOCAL:2,TGC_MapColumns
        LOCAL:4 = obs_GenLoop != LOCAL:2 ? LOCAL:4 + (RAND(-1,2)) # LOCAL:4
        tileCount = DT_SELECT("TGC_Map", @"x = {(LOCAL:2)+(obs_GenLoop)} and y = {LOCAL:4}", "", tileList)
        DT_CELL_SET "TGC_Map", tileList, "floorType", "road", 1
    NEXT

    ;rocks near the beach

    ;trees
    FOR obs_GenLoop,0,TGC_MapSize:0
        FOR obs_GenLoop:1,0,TGC_MapSize:1
            tileCount = DT_SELECT("TGC_Map", @"x = {obs_GenLoop} and y = {obs_GenLoop:1}", "", tileList)
            IF DT_CELL_GETS("TGC_Map",tileList,"floorType",1) == "grass" && !RAND:3
                CALLF TGC_ObstacleTypes("tree")
                DT_CELL_SET "TGC_Map", tileList, "coverType", "tree", 1
                DT_CELL_SET "TGC_Map", tileList, "coverHealth", TGC_Obs:1, 1
            ENDIF
        NEXT
    NEXT

CASE 55923
    ; VARSET tileList
    ; tileCount = DT_SELECT("TGC_Map", "", "", tileList)
    ; FOR LOCAL,0,TGC_MapSize:0+4
    ;     FOR LOCAL:1,0,TGC_MapSize:1
