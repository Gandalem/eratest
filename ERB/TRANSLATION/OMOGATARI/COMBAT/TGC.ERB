IF !TGC_ObstacleHasSpace(ARG,obsX,obsY)
    ;DEBUGPRINTFORML TGC_GenerateObstacleStructure: Couldn't reserve {obsX} X, {obsY} Y spaces for object %ARGS% ID {ARG:1}
    RETURN 0
ENDIF

;CREATE!
startGridLoc:0 = DT_CELL_GET("TGC_Map", ARG, "x", 1)
startGridLoc:1 = DT_CELL_GET("TGC_Map", ARG, "y", 1)

;get reserved grids
reservedGridLocCount = DT_SELECT("TGC_Map", @"x >= {startGridLoc:0} and x <= {startGridLoc:0+obsX} and y >= {startGridLoc:1} and y < {startGridLoc:1+obsY}", "", reservedGridLocs)
;check all
FOR LOCAL, 0, reservedGridLocCount
    currentGridLoc:0 = DT_CELL_GET("TGC_Map", reservedGridLocs:LOCAL, "x", 1)
    currentGridLoc:1 = DT_CELL_GET("TGC_Map", reservedGridLocs:LOCAL, "y", 1)
    ;DEBUGPRINTFORML TGC_GenerateObstacleStructure: Set coverType for grid {reservedGridLocs:LOCAL} to %obsTiles:(currentGridLoc:0-startGridLoc:0):(currentGridLoc:1-startGridLoc:1)%

    ;cover
    LOCALS '= obsTiles:(currentGridLoc:0-startGridLoc:0):(currentGridLoc:1-startGridLoc:1)
    CALLF TGC_ObstacleTypes(LOCALS)
    DT_CELL_SET "TGC_Map", reservedGridLocs:LOCAL, "coverType", LOCALS, 1
    DT_CELL_SET "TGC_Map", reservedGridLocs:LOCAL, "coverHealth", TGC_Obs:1, 1
    ;floor
    LOCALS '= floorTiles:(currentGridLoc:0-startGridLoc:0):(currentGridLoc:1-startGridLoc:1)
    SIF STRLENS(LOCALS)
     DT_CELL_SET "TGC_Map", reservedGridLocs:LOCAL, "floorType", LOCALS, 1
NEXT

;DEBUGPRINTFORML TGC_GenerateObstacleStructure: Reserved {obsX} X, {obsY} Y spaces for object %ARGS% ID {ARG:1}
RETURN 1


