@PRINT_REP(C_ID)
#DIM C_ID
#DIM LINE_BREAK
LINE_BREAK = 0
;Custom code, prevents you from seeing your own knowledge of your relationships
SIF C_ID == MASTER
	RETURN
SIF !GETBIT(NASFeature,10)
	RETURN
CALL PRINTBUTTON_EX(@"%CALLNAME:C_ID%의 당신의 평판에 대한 지식 (노란색은 허용됨)", 168, TFLAG:168, , , 1)
IF !TFLAG:浮気歴表示
	PRINTFORML
	FOR LOCAL,0,REP_NUM
	IF GETBIT(ReputationKnow:C_ID:0, LOCAL)
		SIF GETBIT(ReputationAccept:C_ID:0, LOCAL) == 2
			SETCOLOR C_YELLOW
		SIF LINEISEMPTY()
			PRINT 　
		PRINTFORMLC %GET_STR(C_ID, "Reputation", LOCAL, "Name")%
		LINE_BREAK ++
		SIF LINE_BREAK % (PRINTCPERLINE() - 1) == 0
			PRINTL
	ENDIF
	RESETCOLOR
	NEXT
	SIF LINE_BREAK % (PRINTCPERLINE() - 1) != 0
		PRINTL
ENDIF

@SET_REP(ARG, Rep, IsAccept, ShowRep)
#DIM Rep
#DIM IsAccept
#DIM RepColor
#DIM ShowRep
SIF ARG == MASTER
	RETURN
SIF IS_BABY(ARG)
	RETURN
SIF !GETBIT(NASFeature,10)
	RETURN
SIF GETBIT(ReputationKnow:ARG:0, Rep) && !IsAccept
	RETURN
SELECTCASE GET_INT(ARG, "Reputation", Rep, "Score")
	CASE IS > 0
		RepColor = C_GREEN
	CASE 0
		RepColor = C_YELLOW
	CASE IS < 0
		RepColor = C_RED
ENDSELECT
IF IsAccept
	SETBIT ReputationKnow:ARG:0, Rep
	SETBIT ReputationAccept:ARG:0, Rep
	SIF ShowRep
		CALL COLORMESSAGE(@"%CALLNAME:ARG%는 이제 당신을 【%GET_STR(ARG, "Reputation", Rep, "Label")%}로 받아들인다.", C_GREEN, 2, 1)
ELSE
	SIF GETBIT(ReputationKnow:ARG:0, Rep)
		RETURN
	SETBIT ReputationKnow:ARG:0, Rep
	IF ShowRep
		CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) 당신을 【%GET_STR(ARG, "Reputation", Rep, "Label")%】으로 알고 있다.", RepColor, 2, 1)
		IF GET_INT(ARG, "Reputation", Rep, "Score")
			CALL CHANGE_CFLAG(2, ARG, (50*GET_INT(ARG, "Reputation", Rep, "Score")))
			CALL CHANGE_CFLAG(4, ARG, (25*GET_INT(ARG, "Reputation", Rep, "Score")))
		ENDIF
	ELSE
		CFLAG:ARG:好感度 = MAX(CFLAG:ARG:好感度 + (50*GET_INT(ARG, "Reputation", Rep, "Score")), 0)
		CFLAG:ARG:信頼度 = MAX(CFLAG:ARG:信頼度 + (25*GET_INT(ARG, "Reputation", Rep, "Score")), 0)
	ENDIF
ENDIF
SIF ShowRep
	CALL KOJO_MESSAGE_SEND("EVENT",104,ARG,Rep,IsAccept-1)

@SET_REP_ALL(Rep, IsAccept, ShowRep, isDisregard = 0)
#DIM Rep
#DIM IsAccept
#DIM RepColor
#DIM ShowRep
#DIM isDisregard
IF isDisregard
	FOR LOCAL,1,CHARANUM
	SIF GETBIT(ReputationKnow:LOCAL:0, Rep)
		INVERTBIT ReputationKnow:LOCAL:0, Rep
	NEXT
	CALL COLORMESSAGE(@"모두가 당신이 「%GET_STR(29, "Reputation", Rep, "Name")%」라는 것을 잊어버렸다.", C_GREEN, 2, 1)
	RETURN 1
ENDIF
SELECTCASE GET_INT(29, "Reputation", Rep, "Score")
	CASE IS > 0
		RepColor = C_GREEN
	CASE 0
		RepColor = C_YELLOW
	CASE IS < 0
		RepColor = C_RED
ENDSELECT
SKIPDISP 1
FOR LOCAL,1,CHARANUM
IF !GETBIT(ReputationKnow:LOCAL:0,Rep)
	;CALL SET_REP(LOCAL, Rep, IsAccept)
	CALL SET_REP(LOCAL, Rep, IsAccept,1)
ENDIF
NEXT
SKIPDISP 0
SIF GET_INT(29, "Reputation", Rep, "Score")
	CALL COLORMESSAGE(@"모두의 호의도와 신뢰도는 \@ GET_INT(29, "Reputation", Rep, "Score") > 0 ? 증가했다 # 감소했다 \@ 최대 {ABS((50*GET_INT(29, "Reputation", Rep, "Score")))} 및 {ABS(25*GET_INT(29, "Reputation", Rep, "Score"))} 만큼 각각...",C_YELLOW,1,1)
CALL COLORMESSAGE(@"모두가 이제 당신을 【%GET_STR(29, "Reputation", Rep, "Name")%】로 알고 있다.", RepColor, 2, 1)

@Reputation_Spread
#DIMS DYNAMIC strArr, 100
#DIM nTemp
#DIM GetRep
#DIM RepKnow
#DIM Rep
#DIM SortRep
#DIM DYNAMIC GotRep, キャラクタ数上限
#DIM RS_CAN_SPREAD
#DIM RS_SPREAD_CHANCE
VARSET GotRep
SIF !GETBIT(NASFeature,10)
	RETURN 0
;seek characters who had enough favor gain to spread rumors
FOR LOCAL,1,CHARANUM
SIF TALENT:LOCAL:行きずり ;ignore randoms
	CONTINUE
SIF CFLAG:LOCAL:出禁 ;ignore banned and dead characters
	CONTINUE
SIF GotRep:LOCAL ; already has gotten a reputation in this day
	CONTINUE
CALL FISHER_YATES_SHAFFLE(REP_NUM)
FOR GetRep, 0, REP_NUM
Rep = SHAFFLE_ARRAY:(GetRep)
RS_SPREAD_CHANCE = 8
IF GET_INT(LOCAL, "Reputation", Rep, "Score") < 0
	RS_CAN_SPREAD = (GETBIT(ReputationKnow:LOCAL:0,Rep) && !TALENT:LOCAL:恋慕 && GETBIT(ReputationAccept:LOCAL:0,Rep))
	SIF TALENT:LOCAL:8
		RS_SPREAD_CHANCE = 20
ELSE
	RS_CAN_SPREAD = GETBIT(ReputationKnow:LOCAL:0,Rep)
ENDIF
IF RS_CAN_SPREAD && !RAND:RS_SPREAD_CHANCE
	SIF GETBIT(ReputationKnow:29:0,Rep)
		CONTINUE
	SIF GETBIT(ReputationAccept:29:0,Rep)
		CONTINUE
	DEBUGPRINTFORML --------
	;this is much simpler, we find all friends of this character and sour the favor with you because ruining relationships is much easier
	LOCALS '= Add_Rumor_Spread(LOCAL, "neg")
	DEBUGPRINTFORML 명성: %GET_STR(LOCAL, "Reputation", Rep, "Name")%, 목록: %LOCALS%
	SIF !STRLENS(LOCALS)
		CONTINUE
	CALL COLORMESSAGE(@"%CALLNAME:LOCAL% 당신이 【%GET_STR(LOCAL, "Reputation", Rep, "Name")%】라는 소문을 %HIS_HER(LOCAL)% 친구들에게 퍼뜨린다...",C_YELLOW,2,1)
	SPLIT LOCALS, ":", strArr
	FOR LOCAL:1, 0, RESULT
	nTemp = TOINT(strArr:(LOCAL:1))
	SIF nTemp == 0
		CONTINUE
	SIF TALENT:nTemp:恋慕
		CONTINUE
	SIF IsDead:nTemp:0
		CONTINUE
	CALL SET_REP(nTemp,Rep,,1)
	GotRep:nTemp = 1
	;FavorGainTracker:nTemp:0 = 0 ;reset negative rumor (does only once, too easy, no impact)
	NEXT
	BREAK
ENDIF
