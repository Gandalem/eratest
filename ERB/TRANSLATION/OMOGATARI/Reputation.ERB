@NEWSPAPER_DEATH_INCIDENT
#DIM DeathCount
#DIM nIncidentTarget
VARSET DeathCount


CALL FISHER_YATES_SHAFFLE(CHARANUM)
FOR LOCAL, 0, CHARANUM 
	IF IsDead:LOCAL:0 && DAY-KnowsDeadBodies:29:LOCAL <= 1 && KnowsDeadBodies:29:LOCAL && DeathDay:LOCAL:0 != -99
		DeathCount ++
		nIncidentTarget = LOCAL
	ENDIF
NEXT

IF DeathCount
	;header
	PRINTFORML ───────────────────────────────
	FONTBOLD
	SELECTCASE DeathCount
	CASE 1
		SELECTCASE LastHediff:nIncidentTarget % 100
		CASE 1
			PRINTFORML %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)% %PRINT_MALE("man", nIncidentTarget)% Fatally Shot
		CASE 2
			PRINTFORML %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)% %PRINT_MALE("man", nIncidentTarget)% Stabbed to Death
		CASE 3
			PRINTFORML Targeted Fire Kills %SpeciesSTR(nIncidentTarget)% %PRINT_MALE("man", nIncidentTarget)%
		CASE 4
			PRINTFORML Chemical Burn Mortally Wounds %SpeciesSTR(nIncidentTarget)%.
		CASE 5
			PRINTFORML %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)% %PRINT_MALE("man", nIncidentTarget)% Beaten to Death
		CASE 6
			PRINTFORML %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)% %SpeciesSTR(nIncidentTarget)% Electrocuted
		CASEELSE
			PRINTFORML %SpeciesSTR(nIncidentTarget)% Found Dead in %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)%
		ENDSELECT
	CASEELSE
		PRINTFORML Template Article (Incident involving Death)
	ENDSELECT
	FONTREGULAR
	PRINTFORML ───────────────────────────────
	SETFONT "ＭＳ Ｐゴシック"
	FONTITALIC
	;intro line
	SELECTCASE DeathCount
	CASE 1
		IF nIncidentTarget == 42
			PRINTFORML An article where someone has died.
			PRINTFORML - %NAME:29%
			FONTREGULAR
			SETFONT
			RETURN
		ELSE
			PRINTFORML We have confirmed reports that %NAME:nIncidentTarget% was found dead in the %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)% yesterday.
			;cause
		ENDIF
	CASEELSE
		PRINTFORML Template Article (Incident involving Death)
	ENDSELECT

	;witnesses and suspect

	;victims

	;quotes
	
	PRINTFORML - %NAME:29%
	FONTREGULAR
	SETFONT
ENDIF

