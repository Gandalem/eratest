@NEWSPAPER_CONDITION
#DIM RandomArticle
#DIM GetRep
#DIM Rep
;SIF !FLAG:新聞購読 && StateOfEmergency < 3
;	RETURN -1
SIF IsDead:29:0 && DAY-DeathDay:29:0 > 1
	RETURN -1
CALL NEWSPAPER_HEADER
;bunbunmaru closure
SIF IsDead:29:0
	CALL NEWSPAPER_CLOSURE
;incidents
CALL NEWSPAPER_DEATH_INCIDENT
;deaths
CALL NEWSPAPER_DEATHS
;resurrections
CALL NEWSPAPER_RESURRECT
;reputation
CALL NEWSPAPER_REP
;shitpost articles
CALL FISHER_YATES_SHAFFLE(VARSIZE("NEWSPAPER_DISABLE"))
FOR GetRep, 0, VARSIZE("NEWSPAPER_DISABLE")
Rep = SHAFFLE_ARRAY:(GetRep)
SIF NEWSPAPER_DISABLE:Rep
	CONTINUE
VARSET NEWSPAPER_AD_CANDO
TRYCALLFORMF NEWSPAPER_{REP}_INFO
IF NEWSPAPER_AD_CANDO
	TRYCALLFORM NEWSPAPER_{Rep}
	SIF RESULT > 0
		BREAK
ENDIF
NEXT
;weather
CALL NEWSPAPER_WEATHER
;charisma
CALL NEWSPAPER_CHARISMA
;weapons
CALL NEWSPAPER_RIKA
;memes
SIF !IsDead:42:0 && GETBIT(NASFeature,11)
	CALL NEWSPAPER_MEME
;missing people
CALL NEWSPAPER_MISSING

@NEWSPAPER_HEADER
PRINTFORML ───────────────────────────────
FONTBOLD
PRINTFORML  번번마루
PRINTFORML  %ORDINAL(DAY:3)%의 %GET_MONTH(,1)%, 연도 {(DAY:0 / 125) + 1} (%GET_DAY_TR()%)
FONTREGULAR

@NEWSPAPER_DEATH_INCIDENT
#DIM DeathCount
#DIM nIncidentTarget
VARSET DeathCount
CALL FISHER_YATES_SHAFFLE(CHARANUM)
FOR LOCAL, 0, CHARANUM
IF IsDead:LOCAL:0 && DAY-KnowsDeadBodies:29:LOCAL <= 1 && KnowsDeadBodies:29:LOCAL && DeathDay:LOCAL:0 != -99
	DeathCount ++
	nIncidentTarget = LOCAL
ENDIF
NEXT
IF DeathCount
	;header
	PRINTFORML ───────────────────────────────
	FONTBOLD
	SELECTCASE DeathCount
		CASE 1
			SELECTCASE LastHediff:nIncidentTarget % 100
				CASE 1
					PRINTFORML %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)%은 %PRINT_MALE("man", nIncidentTarget)%에게 치명적인 총격을 당한다.
				CASE 2
					PRINTFORML %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)% %PRINT_MALE("man", nIncidentTarget)% 죽을 때까지 찔렸다
				CASE 3
					PRINTFORML 표적이 된 화염 살상 %SpeciesSTR(nIncidentTarget)% %PRINT_MALE("man", nIncidentTarget)%
				CASE 4
					PRINTFORML 화학 화상은 %SpeciesSTR(nIncidentTarget)%에게 치명적인 부상을 입혔다.
				CASE 5
					PRINTFORML %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)% %PRINT_MALE("man", nIncidentTarget)% 죽음에 이르게 되다
				CASE 6
					PRINTFORML %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)%의 %SpeciesSTR(nIncidentTarget)%이 감전되었다.
				CASEELSE
					PRINTFORML %SpeciesSTR(nIncidentTarget)%이/가 %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)%에서 죽은 채 발견되었다.
			ENDSELECT
		CASEELSE
			PRINTFORML 신문 기사 (사망 사건 관련)
	ENDSELECT
	FONTREGULAR
	PRINTFORML ───────────────────────────────
	SETFONT "ＭＳ Ｐゴシック"
	FONTITALIC
	;intro line
	SELECTCASE DeathCount
		CASE 1
			IF nIncidentTarget == 42
				PRINTFORML 누군가 사망한 기사다.
				PRINTFORML - %NAME:29%
				FONTREGULAR
				SETFONT
				RETURN
			ELSE
				PRINTFORML 우리는 어제 %GET_MAPNAME(CFLAG:nIncidentTarget:300/100)%에서 %NAME:nIncidentTarget%가 사망한 보고를 확인했다.
				;cause
			ENDIF
		CASEELSE
			PRINTFORML 신문 기사 (사망 사건 관련)
	ENDSELECT
	;witnesses and suspect
	;victims
	;quotes
	PRINTFORML - %NAME:29%
	FONTREGULAR
	SETFONT
ENDIF

@NEWSPAPER_DEATHS
#DIM DeathCount
VARSET DeathCount
CALL FISHER_YATES_SHAFFLE(CHARANUM)
FOR LOCAL, 0, CHARANUM
IF IsDead:LOCAL:0 && DAY-KnowsDeadBodies:29:LOCAL <= 1 && KnowsDeadBodies:29:LOCAL && DeathDay:LOCAL:0 != -99
	DeathCount ++
ENDIF
NEXT
SIF StateOfEmergency
	TRYCALLFORM NEWSPAPER_StateOfEmergency_{StateOfEmergency}
IF DeathCount && !IsDead:29:0
	PRINTFORML ───────────────────────────────
	FONTBOLD
	PRINTDATAL
		DATAFORM  편히 잠드세요
	ENDDATA
	FONTREGULAR
	PRINTFORML ───────────────────────────────
	SETFONT "ＭＳ Ｐゴシック"
	FONTITALIC
	PRINTFORML	우리는 어제 환상향에서 쓰러진 이들을 기리기 위해 여기에 왔다.
	FOR LOCAL, 0, CHARANUM
	IF IsDead:LOCAL:0 && DAY-KnowsDeadBodies:29:LOCAL <= 1 && KnowsDeadBodies:29:LOCAL
		CALL PRINT_FACE, LOCAL, "通常", "服"
		PRINTFORML %NAME:LOCAL%
	ENDIF
	NEXT
	PRINTFORML - %NAME:29%
	FONTREGULAR
	SETFONT
	PRINTFORML ───────────────────────────────
ENDIF

@NEWSPAPER_RESURRECT
#DIM ExpectedResurrectCount
#DIM UnexpectedResurrectCount
VARSET ExpectedResurrectCount
VARSET UnexpectedResurrectCount
CALL FISHER_YATES_SHAFFLE(CHARANUM)
FOR LOCAL, 0, CHARANUM
IF DeathDay:LOCAL:0 && DAY-ResurrectDay:LOCAL:0 <= 1 && ResurrectDay:LOCAL:0 && AutoReviveCondition(LOCAL)
	ExpectedResurrectCount++
ELSEIF DeathDay:LOCAL:0 && DAY-ResurrectDay:LOCAL:0 <= 1 && ResurrectDay:LOCAL:0
	UnexpectedResurrectCount++
ENDIF
NEXT
IF (ExpectedResurrectCount || UnexpectedResurrectCount) && !IsDead:29:0
	PRINTFORML ───────────────────────────────
	FONTBOLD
	CALL PRINT_RAINBOWL("Resurrection Index")
	FONTREGULAR
	PRINTFORML ───────────────────────────────
	SETFONT "ＭＳ Ｐゴシック"
	FONTITALIC
	IF UnexpectedResurrectCount
		CALL BIGPRINT_RAINBOWL("Unexpected Resurrections")
		PRINTFORML 사망하거나 실종된 것으로 보고되었던 이들이 돌아다니는 것이 목격되었다고 보고가 들어왔다.
		PRINTFORML 해당 인물의 알려진 능력으로 인한 경고는 없다.
		FOR LOCAL, 0, CHARANUM
		IF DeathDay:LOCAL:0 && DAY-ResurrectDay:LOCAL:0 <= 1 && ResurrectDay:LOCAL:0 && !AutoReviveCondition(LOCAL)
			CALL PRINT_FACE, LOCAL, "通常", "服"
			PRINTFORML %NAME:LOCAL%
		ENDIF
		NEXT
		PRINTFORML
	ENDIF
	PRINTFORML 예상 부활
	FOR LOCAL, 0, CHARANUM
	IF DeathDay:LOCAL:0 && DAY-ResurrectDay:LOCAL:0 <= 1 && ResurrectDay:LOCAL:0 && AutoReviveCondition(LOCAL)
		CALL PRINT_FACE, LOCAL, "通常", "服"
		PRINTFORML %NAME:LOCAL%
	ENDIF
	NEXT
	PRINTFORML - %NAME:29%
	FONTREGULAR
	SETFONT
	PRINTFORML ───────────────────────────────
ENDIF

@NEWSPAPER_REP
#DIM GetRep
#DIM RepKnow
#DIM Rep
#DIM SortRep
IF DidFakeNews
	CALL NEWSPAPER_FAKENEWS
	DidFakeNews = 0
	RETURN
ENDIF
IF DisregardRep != -1
	TRYCALLFORM NEWSPAPER_DISREGARD_{DisregardRep}
	DisregardRep = -1
	SIF RESULT > 0
		RETURN
ENDIF
CALL FISHER_YATES_SHAFFLE(REP_NUM)
FOR GetRep, 0, REP_NUM
Rep = SHAFFLE_ARRAY:(GetRep)
VARSET RepKnow
;addition custom code
FOR LOCAL, 1, CHARANUM
SIF GETBIT(ReputationKnow:LOCAL:0,Rep)
	RepKnow ++
NEXT
SIF RepKnow >= CHARANUM-10 || RepKnow == 0 || AyaRepSpread:Rep
	CONTINUE
SIF !GETBIT(ReputationKnow:29:0,Rep)
	CONTINUE
SIF TALENT:[[文]]:恋人 && GET_INT(29, "Reputation", Rep, "Score") < 0 ;don't punish the player if in love with aya, she wouldn't publish this, right?
	CONTINUE
TRYCALLFORM NEWSPAPER_REP_{Rep}
IF RESULT > 0
	;bug fix
	AyaRepSpread:Rep = 1
	BREAK
ENDIF
NEXT

