CALL PRINTBUTTON_EX(@"%CALLNAME:C_ID%'s knowledge of %PARSE("your")% reputation （Yellow means allowed）", 168, TFLAG:168, , , 1)
IF !TFLAG:浮気歴表示
	PRINTFORML 
	FOR LOCAL,0,REP_NUM
		IF GETBIT(ReputationKnow:C_ID:0, LOCAL)
			SIF GETBIT(ReputationAccept:C_ID:0, LOCAL) == 2
				SETCOLOR C_YELLOW
			SIF LINEISEMPTY()
				PRINT 　
			PRINTFORMLC %GET_STR(C_ID, "Reputation", LOCAL, "Name")%
			LINE_BREAK ++
