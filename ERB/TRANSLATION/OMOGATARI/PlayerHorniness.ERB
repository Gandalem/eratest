	CASE 3
		PRINTFORML 당신은 손가락을 %조사처리(CALLNAME:ARG,"의")% %FSYN("vagina",,,ARG)%에 넣으려고 하지만, %조사처리(CALLNAME:ARG,"의")% 벨트가 그것을 막는다.
	CASE 703
		PRINTFORML %조사처리(CALLNAME:ARG,"의")% 몸이 욕망으로 타오르며 %조사처리(CALLNAME:ARG,"의")% 손이 위험하게 가까워지다 %조사처리(CALLNAME:ARG,"의")% 비밀스러운 곳.
		PRINTFORML 하지만 자신을 만지려 해도 정조대가 %PeeAndPoo(HAS_PENIS(ARG), HAS_VAGINA(ARG), TINKO(ARG), FSYN("vagina",,,ARG))%에 닿는 것을 막는다.
ENDSELECT
RETURN 1

