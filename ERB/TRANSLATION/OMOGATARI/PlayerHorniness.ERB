				PRINTFORMW \@ ARG == MASTER ? %PARSE("Your")% # %CALLNAME:ARG%'s \@ %PeeProtectType(ARG)% 은 ~로 촉촉해지기 시작하다 %PARSE("your",5,,ARG)% 즙들로
			ELSE
				PRINTFORMW %PARSE("Your",,,ARG)% 음란한 액체가 바닥에 떨어졌다.
			ENDIF
		ENDIF
		RESETCOLOR
		CFLAG:ARG:溜まってる度 += 50
	ELSEIF CFLAG:ARG:溜まってる度 >= 690
		$Squirming
		SETCOLOR C_PINK
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW \@ ARG == MASTER ? %PARSE("Your")% # %CALLNAME:ARG%'s \@ 마음이 잠시 음란한 생각으로 뒤덮인다.
			CASE 1
				PRINTFORMW \@ ARG == MASTER ? %PARSE("Your")% # %CALLNAME:ARG% \@은 제대로 생각할 수 없고, 마음이 성적 욕망으로 가득 차 있다.
			CASE 2
				PRINTFORMW %PARSE("You put your",,,ARG)% 손을 대다 %PARSE("your",5,,ARG)% 사타구니를 살짝 자극하며.
		ENDSELECT
		RESETCOLOR
		CFLAG:ARG:溜まってる度 += 50
	ELSEIF CFLAG:ARG:溜まってる度 >= 500
		$Noticeable
		SETCOLOR C_PINK
		PRINTFORMW \@ ARG == MASTER ? %PARSE("You feel")% # %CALLNAME:ARG%이 느낀다 \@ 상당히 흥분된
		RESETCOLOR
	ELSEIF CFLAG:ARG:溜まってる度 >= 250
	ENDIF
ELSE
ENDIF

