@CHAR_EDITOR_NAS_RESULT_1(ARG, CHEAT = 0, nInput)
#DIM CHEAT
#DIM nInput
IF nInput == 0 && MAXBASE:ARG:0 > 500
	MAXBASE:ARG:0 -= 100
ELSEIF nInput == 1
	MAXBASE:ARG:0 += 100
ELSEIF nInput == 2 && MAXBASE:ARG:1 > 0
	MAXBASE:ARG:1 -= 100
ELSEIF nInput == 3
	MAXBASE:ARG:1 += 100
ELSEIF nInput == 4 && MAXBASE:ARG:6 > 0
	MAXBASE:ARG:6 -= 100
ELSEIF nInput == 5
	MAXBASE:ARG:6 += 100
ELSEIF nInput == 6 && MAXBASE:ARG:7 > 0
	SELECTCASE MAXBASE:ARG:7
	CASE IS <= 100
		MAXBASE:ARG:7 = 0
	CASE IS <= 200
		MAXBASE:ARG:7 = 100
	CASE IS <= 500
		MAXBASE:ARG:7 = 200
	CASE IS <= 800
		MAXBASE:ARG:7 = 500
	CASE IS <= 1500
		MAXBASE:ARG:7 = 800
	CASE IS <= 2500
		MAXBASE:ARG:7 = 1500
	CASE IS <= 4000
		MAXBASE:ARG:7 = 2500
	CASE IS <= 8000
		MAXBASE:ARG:7 = 4000
	CASE IS <= 16000
		MAXBASE:ARG:7 = 8000
	CASE IS <= 32000
		MAXBASE:ARG:7 = 16000
	CASEELSE
		MAXBASE:ARG:7 = 32000
	ENDSELECT
ELSEIF nInput == 7
	SIF !TALENT:ARG:ESP
		SETBIT TALENT:ARG:ESP, 0
	SELECTCASE MAXBASE:ARG:7
	CASE IS <= 0
		MAXBASE:ARG:7 = 100
	CASE IS <= 100
		MAXBASE:ARG:7 = 200
	CASE IS <= 200
		MAXBASE:ARG:7 = 500
	CASE IS <= 500
		MAXBASE:ARG:7 = 800
	CASE IS <= 800
		MAXBASE:ARG:7 = 1500
	CASE IS <= 1500
		MAXBASE:ARG:7 = 2500
	CASE IS <= 2500
		MAXBASE:ARG:7 = 4000
	CASE IS <= 4000
		MAXBASE:ARG:7 = 8000
	CASE IS <= 8000
		MAXBASE:ARG:7 = 16000
	CASE IS <= 16000
		MAXBASE:ARG:7 = 32000
	CASE IS <= 32000
		MAXBASE:ARG:7 = 64000
	ENDSELECT
ELSEIF nInput == 8 && MAXBASE:ARG:8 > 0
	SELECTCASE MAXBASE:ARG:8
	CASE IS <= 100
		MAXBASE:ARG:8 = 0
	CASE IS <= 200
		MAXBASE:ARG:8 = 100
	CASE IS <= 500
		MAXBASE:ARG:8 = 200
	CASE IS <= 800
		MAXBASE:ARG:8 = 500
	CASE IS <= 1500
		MAXBASE:ARG:8 = 800
	CASE IS <= 2500
		MAXBASE:ARG:8 = 1500
	CASE IS <= 4000
		MAXBASE:ARG:8 = 2500
	CASE IS <= 8000
		MAXBASE:ARG:8 = 4000
	CASE IS <= 16000
		MAXBASE:ARG:8 = 8000
	CASE IS <= 32000
		MAXBASE:ARG:8 = 16000
	CASEELSE
		MAXBASE:ARG:8 = 32000
	ENDSELECT
ELSEIF nInput == 9
	SELECTCASE MAXBASE:ARG:8
	CASE IS <= 0
		MAXBASE:ARG:8 = 100
	CASE IS <= 100
		MAXBASE:ARG:8 = 200
	CASE IS <= 200
		MAXBASE:ARG:8 = 500
	CASE IS <= 500
		MAXBASE:ARG:8 = 800
	CASE IS <= 800
		MAXBASE:ARG:8 = 1500
	CASE IS <= 1500
		MAXBASE:ARG:8 = 2500
	CASE IS <= 2500
		MAXBASE:ARG:8 = 4000
	CASE IS <= 4000
		MAXBASE:ARG:8 = 8000
	CASE IS <= 8000
		MAXBASE:ARG:8 = 16000
	CASE IS <= 16000
		MAXBASE:ARG:8 = 32000
	CASE IS <= 32000
		MAXBASE:ARG:8 = 64000
	ENDSELECT
ENDIF
BASE:ARG:0 = MAXBASE:ARG:0
BASE:ARG:1 = MAXBASE:ARG:1
