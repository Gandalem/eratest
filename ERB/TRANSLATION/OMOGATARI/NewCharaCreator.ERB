@CHAR_EDITOR_NAS_PAGE_2(C_ID, CHEAT = 0)
#DIM CHEAT
#DIM  C_ID
#DIM SpeciesSort, 4
#DIM nFertileTurn

PRINTBUTTON "[Sex        ]", 100
PRINTFORML : %GET_TALENTNAME_TR(2,TALENT:C_ID:2,C_ID)%
PRINTBUTTON "[Pubic hair ]", 105
PRINTFORML : %GET_INMOU_NAME(PubesHair:C_ID:0)%
PRINTBUTTON "[Armpit hair]", 106
PRINTFORML : %GET_ARMPIT_NAME(PitsHair:C_ID:0)%
CALL PRINTLINE, @"Species tags:%" "%"
FOR SpeciesSort, 190, 198
	PRINTFORM %TALENT_TR(SpeciesSort)+": ", 15%
	FOR SpeciesSort:1, 1, 100
		IF TALENT:C_ID:SpeciesSort == SpeciesSort:1
			SETCOLOR C_AQUA
		ELSE
			SETCOLOR C_GRAY
		ENDIF
		IF STRLENS(GET_TALENTNAME_TR(SpeciesSort,SpeciesSort:1,C_ID))
			PRINTBUTTON @"%"<"+GET_TALENTNAME_TR(SpeciesSort,SpeciesSort:1,C_ID)+">", 18, LEFT%", SpeciesSort*100+SpeciesSort:1
			SpeciesSort:3 ++
			IF SpeciesSort:3 % 8 == 0
				PRINTL
				PRINTFORM %" ",15%
				;SpeciesSort:3 = 0
			ENDIF
		ENDIF
		RESETCOLOR
	NEXT
	;kitsune
	IF SpeciesSort == 197
		FOR SpeciesSort:2, 90, 167
			SIF !GROUPMATCH(SpeciesSort:2,90,91,166)
				CONTINUE
			IF TALENT:C_ID:(SpeciesSort:2)
				SETCOLOR C_AQUA
			ELSE
				SETCOLOR C_GRAY
