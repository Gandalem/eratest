	ENDIF
CASE 6
	PRINTFORML The current prefix is %nameArray:ARG:na_Prefix%
	PRINTFORML To change it, enter a new name. (Leave blank to cancel, enter RESETME to reset.)
	PRINTL
	PRINTBUTTON "[Reset] ", "RESETME"
	PRINTBUTTON "[Cancel]", ""
	INPUTS
	IF RESULTS == "RESETME"
	nameArray:ARG:na_Prefix =
	ELSEIF RESULTS != ""
		nameArray:ARG:na_Prefix '= RESULTS
		PRINTFORMW Accepted. Prefix now set to %nameArray:ARG:na_Prefix%.
	ENDIF
CASE 7
	PRINTFORML The current suffix is %nameArray:ARG:na_Suffix%
	PRINTFORML To change it, enter a new name. (Leave blank to cancel, enter RESETME to reset.)
	PRINTL
	PRINTBUTTON "[Reset] ", "RESETME"
