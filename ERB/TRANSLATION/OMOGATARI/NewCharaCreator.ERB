@NAS_PickLivingPlace(C_ID,nPlaceId = -1)
#DIM CHK_TRAINING
#DIM CHK_GARDENING
#DIM ANIMATION_SEED
#DIM PREV_REDRAW
#DIM curMap
#DIM nPlaceId
#DIM C_ID

	SIF inCharaCreator
		RECOLOREDMAPS = 1
	ANIMATION_SEED = 0
	PREV_REDRAW = CURRENTREDRAW()
	curMap = MAIN_MAP
	SIF nPlaceId > -1
	MAIN_MAP = nPlaceId

	;Map Animation Code
	$MAPANIMATION
	LINESTART = LINECOUNT
	DAY:3 = MAX(DAY:3,1)
	DAY:2 = MAX(DAY:2,1)
	SIF ANIMATERECOLOREDMAPS && !FLAG:70
		ANIMATION_SEED ++
	;
	;
	;メンバーの起床時間再設定
	;
	DRAWLINE
	;Color map
	IF RECOLOREDMAPS
		CALL DRAW_COLOREDMAP(ANIMATION_SEED, "HIKKOSHI")
	ELSE
		CALL DRAW_MAP("HIKKOSHI")
	ENDIF
	DRAWLINE
	PRINTFORML ■%GET_MAPNAME(MAIN_MAP)%
	PRINTL
	TRYCALLFORM MAP_{MAIN_MAP}_{TFLAG:マップ切り替え}
	PRINTL
	DRAWLINEFORM =
	PRINT Please select a place to stay. 
	PRINTBUTTON @"[Switch Preview Map({TFLAG:マップ切り替え})]", 1997
	PRINTL
	;custom code
	IF nPlaceId == -1
	LOCAL:1 = 0
	FOR LOCAL, 0, 20
		SIF MAIN_MAP == LOCAL
			SETCOLOR C_AQUA
		IF GET_EXISTMAP(LOCAL)
			PRINTFORM [{LOCAL + 2000}] %GET_MAPNAME(LOCAL), 28, LEFT%
			SIF (++LOCAL:1) % 3 == 0 ;custom code
				PRINTFORML
		ENDIF
		;SIF GROUPMATCH(LOCAL, 4, 9, 10) ;custom code - replaced with above method
		;	PRINTL 
		RESETCOLOR
	NEXT
	SIF LOCAL:1 % 3 > 0
		PRINTFORML
	ENDIF
	;-----------
	PRINT [1998] Cancel
	PRINTL
	;Map Animation Code
	IF ANIMATERECOLOREDMAPS && !FLAG:70
		REDRAW PREV_REDRAW
		TINPUT ANIMATERECOLOREDMAPS,99999,0,""
	ELSE
		INPUT
	ENDIF
	;拠点切り替え
	IF RESULT == 99999
		PREV_REDRAW = CURRENTREDRAW()
		REDRAW 0
		CLEARLINE LINECOUNT - LINESTART
		GOTO MAPANIMATION
	ELSEIF RESULT >= 2000 && GET_EXISTMAP(RESULT - 2000)
		MAIN_MAP = RESULT - 2000
		TFLAG:マップ切り替え = 1
		RESTART
	;プレビュー切り替え
	ELSEIF RESULT == 1997
		TFLAG:マップ切り替え += 1
		SIF !EXISTFUNCTION(@"MAP_{MAIN_MAP}_{TFLAG:マップ切り替え}")
			TFLAG:マップ切り替え = 1
		RESTART
	;キャンセル
	ELSEIF RESULT == 1998 && !ゲーム開始処理中 && !ゲーム引き継ぎ処理中
		MAIN_MAP = curMap
		CALL ROOMSETTING ;bug fix custom code
		RETURN
	ELSEIF INRANGE(RESULT,1,97) || INRANGE(RESULT,MAIN_MAP*100,MAIN_MAP*100+99)
		IF RESULT < 100
		K = RESULT+(MAIN_MAP*100)
		ELSE
		K = RESULT
		ENDIF
		SELECTCASE PlayerLandSelection
		CASE 1
			IF AvailableHousingAreas(1, K)
				PRINTFORMW Not a valid home area. Please select another.
				RESTART
			ELSEIF AvailableHousingAreas(2, K) > -1
				L = AvailableHousingAreas(2, K)
				N = PlayerLandGuests:L
				IF C_ID == N
					PRINTFORMW %CALLNAME:C_ID% is already living in this location.
					RESTART
				ENDIF

				PRINTFORML %NAME_FROM_PLACE(K+8000)% is currently occupied by %CALLNAME:(N)%.
				PRINTFORML Do you want to move %CALLNAME:(N)% to a new area?
				CALL ASK_YN(@"Yes", "No")
				SELECTCASE RESULT
				CASE 0
					M = PlayerLandGuestLiving:(FINDELEMENT(PlayerLandGuests,C_ID))
					CFLAG:N:自宅位置 = GET_MAP_REPLACEMENT(M)
					CFLAG:N:311 = M
					CFLAG:N:神社在住 = CFLAG:C_ID:311
					PlayerLandGuestLiving:L = M
					PRINTFORMW Moved %CALLNAME:N% to %NAME_FROM_PLACE(M+8000)%
				CASE 1
					RETURN
				ENDSELECT
			ENDIF
		ENDSELECT
		
		CFLAG:C_ID:自宅位置 = GET_MAP_REPLACEMENT(K)
		CFLAG:C_ID:311 = K
		CFLAG:C_ID:神社在住 = CFLAG:C_ID:311
		
		PRINTFORMW %NAME_FROM_PLACE(K+8000)% has been selected as home location.
		RETURN
	ELSE
		DEBUGPRINTFORML Tried to get area {RESULT}
		RESTART
	ENDIF

@LinkFamilyRelation(ARG, nTarget, nRelation)
#FUNCTION
#DIM nTarget
#DIM nRelation
#DIM nCollat
SELECTCASE nRelation
CASE 0
	;Unrelated
	CharaFamily:ARG:nTarget = 0
	CharaFamily:nTarget:ARG = 0
CASE 1
	;Son
	CharaFamily:ARG:nTarget = 1
	CharaFamily:nTarget:ARG = 4
CASE 2
	;Brother
	CharaFamily:ARG:nTarget = 2
	CharaFamily:nTarget:ARG = 2
	;strays
	FOR nCollat, 0, CHARANUM
		SIF GROUPMATCH(nCollat,ARG,nTarget)
			CONTINUE
		IF CharaFamily:nCollat:nTarget == 2 || CharaFamily:nTarget:nCollat == 2 || CharaFamily:nCollat:ARG == 2 || CharaFamily:ARG:nCollat == 2
			CharaFamily:nCollat:nTarget = 2
			CharaFamily:nTarget:ARG = 2
		ENDIF
	NEXT
CASE 3
	;Half-Brother
	CharaFamily:ARG:nTarget = 3
	CharaFamily:nTarget:ARG = 3
CASE 4
	;Father
	CharaFamily:ARG:nTarget = 4
	CharaFamily:nTarget:ARG = 1
CASE 5
	;Grandson
	CharaFamily:ARG:nTarget = 5
	CharaFamily:nTarget:ARG = 10
CASE 6
	;Kin
	CharaFamily:ARG:nTarget = 6
	CharaFamily:nTarget:ARG = 6
CASE 7
	;Half-Father
	CharaFamily:ARG:nTarget = 7
	CharaFamily:nTarget:ARG = 8
CASE 8
	;Grandson
	CharaFamily:ARG:nTarget = 8
	CharaFamily:nTarget:ARG = 7
CASE 9
	;Clone
	CharaFamily:ARG:nTarget = 9
	CharaFamily:nTarget:ARG = 9
CASE 10
	;Grandfather
	CharaFamily:ARG:nTarget = 10
	CharaFamily:nTarget:ARG = 5
ENDSELECT

@ChangeAlarmTime(ARG,nFlag)
#DIM nFlag
#DIM 同居人
#DIM 前日就寝時間
#DIM nStoreTime
nStoreTime = CFLAG:ARG:nFlag ;qol custom code
前日就寝時間 = CFLAG:MASTER:就寝時間 - DAY * 1440
同居人 = 0
FOR LOCAL,0,CHARANUM
	IF NO:LOCAL == NO:ARG
		同居人 = LOCAL
		BREAK
	ENDIF
NEXT
DO
 	;qol custom code, cleaner rendering of time slept (example: 10:0 becomes 10:00)
	PRINTFORM When should %CALLNAME:ARG% 
	SELECTCASE nFlag
	CASE 352
		PRINTFORM start visiting?
	CASE 353
		PRINTFORM stop visiting?
	CASE 354
		PRINTFORM go to bed?
	CASE 355
		PRINTFORM wake up?
	CASEELSE
		PRINTFORM the alarm go off?
	ENDSELECT
	PRINTFORML  (Currently: %時刻表示(CFLAG:ARG:nFlag)%)
	PRINTBUTTON "┏━ △ ", 60
	PRINTBUTTON "━△", 10
	PRINTBUTTON "△━┓", 1
	PRINTL 
	PRINT ┃　
	SIF CFLAG:ARG:nFlag < 600
		PRINT ０
	PRINTFORM %TOFULL(TOSTR(CFLAG:ARG:nFlag / 60))%：
	SIF CFLAG:ARG:nFlag % 60 < 10
		PRINT ０
	PRINTFORM %TOFULL(TOSTR(CFLAG:ARG:nFlag % 60))%　
	PRINTBUTTON "□", 5555
	PRINTL 
	PRINTBUTTON "┗━ ▽ ", -60
	PRINTBUTTON "━▽", -10
	PRINTBUTTON "▽━┛", -1
	PRINTL 
	SIF 同居人 < CHARANUM && 同居人
		PRINTFORM [2222] - Same as %CALLNAME:同居人%
	PRINT 　
	PRINTL [4444] - Direct input
	;qol custom code
	PRINTL [9999] - Cancel
	PRINTFORML [{0,4}] - Done
	INPUT
	IF RESULT == 0
		PRINTFORM The alarm is now set at 
		CALL COLORMESSAGE(@"%時刻表示(CFLAG:ARG:nFlag)%", C_YELLOW)
		PRINTFORMW .
		RETURN 1
	ELSEIF RESULT == 9999 ;qol custom code
		CFLAG:ARG:nFlag = nStoreTime
		RETURN 0
	ELSEIF RESULT == 2222 && 同居人 < CHARANUM && 同居人
		CFLAG:ARG:nFlag = CFLAG:同居人:nFlag
	ELSEIF RESULT == 4444
		CALL 起床時間入力()
	ELSEIF RESULT == 5555
		CALL 最低睡眠時間設定()
	ELSEIF INRANGE(RESULT, -1360, 1360)
		CFLAG:ARG:nFlag += RESULT
		IF CFLAG:ARG:nFlag >= 1440
			CFLAG:ARG:nFlag -= 1440
		ELSEIF CFLAG:ARG:nFlag < 0
			CFLAG:ARG:nFlag += 1440
		ENDIF
		CLEARLINE 8
	ENDIF
LOOP 1

