	IF nInput == 0
		IF TALENT:ARG:nInput == 1
			TALENT:ARG:nInput = 0
		ELSE
			TALENT:ARG:nInput++
		ENDIF
	;性別
	ELSEIF nInput == 2
		IF TALENT:ARG:nInput == 3
			TALENT:ARG:nInput = 1
			TALENT:ARG:形状 = 0
			MAXBASE:ARG:精力 = 0
			MAXBASE:ARG:5 = 0
		ELSE
			TALENT:ARG:nInput ++
			IF TALENT:ARG:形状 == 0 || MAXBASE:ARG:精力 == 0 || MAXBASE:ARG:5 == 0
				TALENT:ARG:形状 = 3
				MAXBASE:ARG:5 = 1500
				MAXBASE:ARG:精力 = 1000
			ENDIF
		ENDIF
	;Age
	ELSEIF nInput == 17
		TALENT:ARG:nInput ++
		SIF TALENT:ARG:nInput == 3
			TALENT:ARG:nInput = -1
	;Knowledge Seed
	ELSEIF nInput == 50
		SELECTCASE TALENT:ARG:nInput
		CASE IS < 5
			TALENT:ARG:nInput ++
		CASE 5 TO 45
			TALENT:ARG:nInput += 5
		CASE 50
			TALENT:ARG:nInput = -1
		ENDSELECT
	;Esper
	ELSEIF nInput == 59
		TALENT:ARG:nInput = !TALENT:ARG:nInput
		SIF TALENT:ARG:nInput
			MAXBASE:ARG:7 = MAX(100, MAXBASE:ARG:7)
	;性別嗜好
	ELSEIF nInput == 81
		IF TALENT:ARG:nInput == 3
			TALENT:ARG:nInput = -1
		ELSE
			TALENT:ARG:nInput ++
		ENDIF
	;オンオフ型の素質
	ELSEIF (TALENTNAME:nInput == GET_TALENTNAME(nInput,1) || GROUPMATCH(nInput,1,6)) && !GROUPMATCH(nInput, 143, 162, 164, 185, 190, 191, 193, 194, 196, 197, 198, 220, 274) ;exceptions, added 220
		TALENT:ARG:nInput = !TALENT:ARG:nInput
		;オンオフ型で別途追加が必要な素質
		;母乳体質
		IF nInput == 149
			IF TALENT:ARG:nInput
				MAXBASE:ARG:母乳 = 2000
			ELSE
				MAXBASE:ARG:母乳 = 0
			ENDIF
		ENDIF
	;体型
	ELSEIF nInput == 100
		;体型が「小人(-5)」と「巨人(3)」の場合を独立処理
		IF TALENT:ARG:nInput == -5
			TALENT:ARG:nInput = -2
		ELSEIF TALENT:ARG:nInput == 2
			TALENT:ARG:nInput = 5
		ELSEIF TALENT:ARG:nInput == 5
			TALENT:ARG:nInput = -5
		ELSE
			TALENT:ARG:nInput ++
		ENDIF
	;M sensitivity
	ELSEIF nInput == 106
		TALENT:ARG:nInput++
		SIF TALENT:ARG:nInput == 3
			TALENT:ARG:nInput = -1
	;drunkard
	ELSEIF nInput == 121
		TALENT:ARG:nInput++
		SIF TALENT:ARG:nInput == 4
			TALENT:ARG:nInput = -2
	;Animal Ears
	ELSEIF nInput == 143
		TALENT:ARG:nInput++
		TALENT:ARG:nInput %= 5
	;Music/singing/dancing knowledge
	ELSEIF nInput == 161
		TALENT:ARG:nInput++
		TALENT:ARG:nInput %= 4
	;skillers
	ELSEIF INRANGE(nInput, 42, 49)
		TALENT:ARG:nInput = RANK_TO_LEVEL(LEVEL_TO_RANK(TALENT:ARG:nInput)+1)
		TALENT:ARG:nInput %= MaxNonHLevel
	;tone deaf/sense of sound/perfect pitch
	ELSEIF nInput == 162
		TALENT:ARG:nInput++
		SIF TALENT:ARG:nInput == 3
			TALENT:ARG:nInput = -1
	;ice spirit
	ELSEIF nInput == 164
		TALENT:ARG:nInput++
		TALENT:ARG:nInput %= 3
	;fuck buddy
	ELSEIF nInput == 185
		TALENT:ARG:nInput++
		TALENT:ARG:nInput %= 3
	;human
	ELSEIF nInput == 190
		TALENT:ARG:nInput++
		TALENT:ARG:nInput %= 7
	;youkai
	ELSEIF nInput == 191
		TALENT:ARG:nInput++
		TALENT:ARG:nInput %= 13
	;Divine spirit
	ELSEIF nInput == 193
		TALENT:ARG:nInput++
		TALENT:ARG:nInput %= 4
	;non-living
	ELSEIF nInput == 194
		TALENT:ARG:nInput++
		TALENT:ARG:nInput %= 5
	;doll
	ELSEIF nInput == 196
		TALENT:ARG:nInput++
		IF TALENT:ARG:nInput == 6
			TALENT:ARG:nInput = 99
		ELSEIF TALENT:ARG:nInput == 100
			TALENT:ARG:nInput = 0
		ENDIF
	;extra
	ELSEIF nInput == 197
		TALENT:ARG:nInput++
		TALENT:ARG:nInput %= 5
	;milf
	ELSEIF nInput == 198
		TALENT:ARG:nInput++
		TALENT:ARG:nInput %= 3
	;custom: fairy friend
	ELSEIF nInput == 220
		TALENT:ARG:nInput++
		SIF TALENT:ARG:nInput == 11
			TALENT:ARG:nInput = -5
	;dick
	ELSEIF nInput == 250
		TALENT:ARG:nInput++
		SELECTCASE TALENT:ARG:nInput
			CASE 7
				TALENT:ARG:nInput = 10
			CASE 11
				TALENT:ARG:nInput = 1
		ENDSELECT
	;stone stacking
	ELSEIF nInput == 274
		TALENT:ARG:nInput++
		TALENT:ARG:nInput %= 6
	;NAS: Tech Knowledge
	ELSEIF nInput == 1204
		IF TALENT:ARG:nInput == 8
			TALENT:ARG:nInput = 0
		ELSE
			TALENT:ARG:nInput ++
		ENDIF
	;NAS: Sex Knowledge
	ELSEIF nInput == 1300
		IF TALENT:ARG:nInput == 5
			TALENT:ARG:nInput = -1
			SIF ARG == MASTER
			CALL SexKnowIgnorantWarning(1)
		ELSE
			TALENT:ARG:nInput ++
		ENDIF
	;量的素質
	ELSE
		;性別
		IF LOCAL == 2
			IF TALENT:ARG:nInput == 3
				TALENT:ARG:nInput = 1
			ELSE
				TALENT:ARG:nInput ++
			ENDIF
		;端まで行くと-1を掛ける
		ELSEIF STRLENS(GET_TALENTNAME(nInput,TALENT:ARG:nInput + 1)) || TALENT:ARG:nInput == -1
			TALENT:ARG:nInput ++
		ELSE
			TALENT:ARG:nInput = -1 * TALENT:ARG:nInput
		ENDIF
	ENDIF


