			$RandLastJap
			FOR LOCAL,1,10
			CALL GENERATE_FAMILY_NAME_J()
			PROPOSED_NAME:LOCAL = %RESULTS%
			;Custom code, disabled as it's untranslated
			;IF CHILD_SEX:YOME:CHILDNUM == 1
			;	PROPOSED_NAME:LOCAL = %ランダムキャラ_命名(YOME)%
			;ELSE
			;	PROPOSED_NAME:LOCAL = %男の子_命名(YOME, CHILDNUM)%
