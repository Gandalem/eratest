VARSET LOCALS
FOR N, 0, 20
IF TOSTR_Religion(N) != LOCALS && (TOSTR_Religion(N) != TOSTR_Religion(0) || !N) && (TALENT:ARG:Religion == N || charReligionCertainty:ARG:N || charReligionStatus:ARG:N)
	PRINTBUTTON @"%TOSTR_Religion(N),30,LEFT%", 2420000+N
	SELECTCASE charReligionCertainty:ARG:N/10
		CASE IS > 90
			CALL PRINT_COLORBAR, charReligionCertainty:ARG:N, 1000, 18, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("青")
		CASE IS > 75
			CALL PRINT_COLORBAR, charReligionCertainty:ARG:N, 1000, 18, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("緑")
		CASE IS > 50
			CALL PRINT_COLORBAR, charReligionCertainty:ARG:N, 1000, 18, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("黄色")
		CASE IS > 25
			CALL PRINT_COLORBAR, charReligionCertainty:ARG:N,1000,18, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("オレンジ")
		CASEELSE
			CALL PRINT_COLORBAR, charReligionCertainty:ARG:N,1000,18, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("赤")
	ENDSELECT
	PRINTFORM  ({charReligionCertainty:ARG:N/10,3}\%) 
	IF charReligionStatus:ARG:N
		PRINTFORM %ReligionRoles(charReligionStatus:ARG:N), 12, RIGHT%
	ENDIF
	IF N == TALENT:ARG:Religion
		SETCOLOR C_PINK
		PRINTFORM %"현재", 12 ,RIGHT%
