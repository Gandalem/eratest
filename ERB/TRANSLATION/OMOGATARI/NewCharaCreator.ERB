@CHAR_EDITOR_NAS_RESULT_7(chara, CHEAT = 0, choice)
#DIM chara
#DIM CHEAT
#DIM choice
#DIM command
#DIM credraw
#DIM portrait

credraw = CURRENTREDRAW()

IF choice > 1000
	command = choice
ELSE
	portrait = choice % 100
	command = (choice - portrait) / 100
ENDIF
;PRINTFORMW Debug: {portrait} {command}
SELECTCASE command
	CASE 1
		CUSTOM_PORTRAITS:chara:portrait -= 1
	CASE 2
		CUSTOM_PORTRAITS:chara:portrait += 1
	CASE 3
		CUSTOM_PORTRAITS:chara:portrait = 0
		;edit all the 4's here to match the case if it's changed
	CASE 4 TO (4 + (CUSTOM_PORTRAITS_TOTAL - 1))
		CUSTOM_PORTRAITS:chara:portrait = CUSTOM_PORTRAITS:chara:(Command-4)
	CASE 9 TO (9 + (CUSTOM_PORTRAITS_TOTAL - 1))
		$custom_image_input
		REDRAW 1
		PRINTFORML Current: %GENERATE_PORTRAIT_INFO(chara)%
		PRINTL Input a resource number (skip the starting "c", check you custom.csv ResourceNames, leave blank to leave unchanged):
		INPUTS
		IF ISNUMERIC(RESULTS)
			CUSTOM_PORTRAITS:chara:portrait = TOINT(RESULTS)
		ELSEIF RESULTS != ""
			GOTO custom_image_input
		ENDIF
	CASE 26666
		IF NO:chara == CSV_CHARANUM()
			CALL モブ子画像リセット(chara)
			CSTR:chara:モブ子画像文字列_服_通常 =
			CALL SET_MOB_IMAGE_STR(chara, "ランダム")
		ENDIF
ENDSELECT

