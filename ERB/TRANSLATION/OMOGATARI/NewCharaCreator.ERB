@CHAR_EDITOR_NAS(ARG, CHEAT=0)
#DIM CHEAT
#DIM nLineCnt_Head
;FOR LOCAL, 0, 100
;PRINTL
;NEXT
DRAWLINE
nLineCnt_Head = LINECOUNT
REDRAW 0
DO
	SIF LINECOUNT - nLineCnt_Head > 0
		CLEARLINE LINECOUNT - nLineCnt_Head

	CALL CHAR_EDITOR_NAS_STATE(ARG, CHEAT)
	SELECTCASE RESULT
		CASE 9999
			RETURN
	CASEELSE
	ENDSELECT
LOOP 1

@CHAR_EDITOR_NAS_STATE(C_ID,CHEAT = 0)
#DIM CHEAT
#DIM     C_ID       ;登録番号
#DIM     PAGE       ;表示中のページ
#DIMS CONST DISP_NAME = "Name", "Base", "Body", "Talents", "Abilities", "Experience", "Conquest", "Portraits", "Skills", "Equipment", "World", "Body Parts", "Info"
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
PRINTFORM Editing 
CALLF NameChecker(C_ID,,1)
PRINTL
DRAWLINE
CALLF ResetBladders(C_ID)
CALL CrippleEffects(C_ID)
SELECTCASE PAGE
CASE 3
	$PAGE_3_Loop
	CALL CHAR_EDITOR_NAS_PAGE_3(C_ID,globalLineSave,CHEAT)
	IF RESULT == -1
		GOTO REPRINT
	ENDIF
CASEELSE
VARSET globalLineSave
TRYCALLFORM CHAR_EDITOR_NAS_PAGE_{PAGE}(C_ID,CHEAT)
ENDSELECT
DRAWLINE
FOR LOCAL, 0, VARSIZE("DISP_NAME")
	SIF GROUPMATCH(LOCAL, 6, 9) && !CHEAT
		CONTINUE
	SIF PAGE == LOCAL
		SETCOLOR 0x00FFFF
	PRINTBUTTON DISP_NAME:LOCAL, LOCAL + 8002
	RESETCOLOR
	PRINTFORM 　　
NEXT
PRINTFORML 
CALL TALENT_POINTS_DISPLAY(C_ID,CHEAT)
IF (TalentPointOffset-CalcTalentPointsUsed(C_ID) >= 0 || nTalentPoints == -999) || CHEAT || !ゲーム開始処理中
PRINTBUTTON "[9999] End Customization", 9999
ELSE
SETCOLOR C_GRAY
PRINTPLAINFORM [9999] End Customization (Not Enough Points)
ENDIF
PRINTL
DO
	INPUT
	SELECTCASE RESULT
	CASE 8002 TO VARSIZE("DISP_NAME")+8002
		PAGE = RESULT-8002
	CASE 9997 ;custom code
	CASE 9998 ;custom code
		BREAK
	CASE 9999 ;custom code
		IF !CHEAT
			IF (TalentPointOffset-CalcTalentPointsUsed(C_ID) >= 0 || nTalentPoints == -999) || CHEAT || !ゲーム開始処理中
			ELSE
				CONTINUE
			ENDIF
			PRINTFORML Do you want to leave the character creator?
			CALL ASK_YN()
			SELECTCASE RESULT
			CASE 0
			CASE 1
				GOTO REPRINT
			ENDSELECT
		ENDIF
		RETURN 9999
	CASEELSE
		$RETRY
		TRYCALLFORM CHAR_EDITOR_NAS_RESULT_{PAGE}(C_ID, CHEAT, RESULT)
		;REUSELASTLINE Invalid Input
		;CONTINUE
	ENDSELECT
	BREAK
LOOP 1
GOTO REPRINT

