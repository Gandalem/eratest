		SETCOLOR Color_Gradient_PER(GETCONFIG("TEXT COLOR"),C_GREEN,MIN(FactionFameCompElse(ARG,N)/1000,100))
	CASE IS < 0
		SETCOLOR Color_Gradient_PER(GETCONFIG("TEXT COLOR"),C_D_RED,MIN(FactionInfamyCompElse(ARG,N)/1000,100))
ENDSELECT
PRINTFORM %FACTION_RELATION_STRING(ARG,N)%
RESETCOLOR
