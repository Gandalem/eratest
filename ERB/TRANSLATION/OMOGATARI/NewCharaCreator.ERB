	CASE IS < 0
		SETCOLOR Color_Gradient_PER(GETCONFIG("TEXT COLOR"),C_D_RED,MIN(FactionInfamyCompElse(ARG,N)/1000,100))
ENDSELECT
PRINTFORM {FactionRelationCompElse(ARG,N),7} 
SELECTCASE FactionRelationCompElse(ARG,N)
