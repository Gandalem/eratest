@NAS_REAL_NARIKIRI(nNo)
#DIM nNo
MASTER = nNo
PLAYER = nNo

PeeHold:MASTER:1 = 0
PooHold:MASTER:1 = 0

OrgasmDeny:MASTER:0 = OrgasmDeny:nNo:0
PeeHold:MASTER:0 = PeeHold:nNo:0
PooHold:MASTER:0 = PooHold:nNo:0
AlcoholAddict:MASTER:0 = AlcoholAddict:nNo:0
DrugAddict:MASTER:0 = DrugAddict:nNo:0
CharaTrauma:MASTER:0 = CharaTrauma:nNo:0
CharaTraumaExp:MASTER:0 = EXP_DEMAND_24(0,95,MASTER)
PeeHoldExp:MASTER:0 = EXP_DEMAND_20(0,91,MASTER)
PooHoldExp:MASTER:0 = EXP_DEMAND_21(0,92,MASTER)
DrinkingExp:MASTER:0 = EXP_DEMAND_22(0,93,MASTER)
DrugExp:MASTER:0 = EXP_DEMAND_23(0,94,MASTER)
CALLF SILENT_ENDURANCECHANGE(MASTER)

CALL BASE_BAR(MASTER, "体力", 28, "緑")
PRINTFORM 　　
CALL BASE_BAR(MASTER, "気力", 28, "青", "「改行」")

IF GETBIT(nPee,1)
CALL PeeBar(MASTER,21)
PRINTFORM 　　	
ENDIF
IF GETBIT(nScat,2)	
CALL PooBar(MASTER,21)
ENDIF
PRINTFORML 
PRINTFORML
IF nPee || nScat
	PRINTFORM ★Potty Training: 
	IF nPee
	SETCOLOR EnduranceColors(PeeHold:MASTER:2)
	PRINTFORM {PeeHold:MASTER:2} ({PeeHold:MASTER:0} + {PeeHold:MASTER:1})【%GET_TALENTNAME_TR(1514, PeeHold:MASTER:2)%】
	ENDIF
	IF nScat		
	RESETCOLOR
	SIF nPee
	PRINTFORM /
	SETCOLOR EnduranceColors(PooHold:MASTER:2)
	PRINTFORML {PooHold:MASTER:2} ({PooHold:MASTER:0} + {PooHold:MASTER:1})【%GET_TALENTNAME_TR(1500, PooHold:MASTER:2)%】
	ENDIF
ENDIF
RESETCOLOR	
PRINTFORM ★Addiction: 
SETCOLOR EnduranceColors(AlcoholAddict:MASTER:0)
PRINTFORM {AlcoholAddict:MASTER:0}【%GET_TALENTNAME_TR(121, TALENT:MASTER:121)%】			
RESETCOLOR
PRINTFORM /
SETCOLOR EnduranceColors(DrugAddict:MASTER:0)
PRINTFORML {DrugAddict:MASTER:0}【%GET_TALENTNAME_TR(56, TALENT:MASTER:56)%】
