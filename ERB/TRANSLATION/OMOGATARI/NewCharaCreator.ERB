	ELSEIF RESULTS != ""
		nameArray:ARG:na_Suffix '= RESULTS
		PRINTFORMW Accepted. Suffix now set to %nameArray:ARG:na_Suffix%.
	ENDIF
CASE 999
RETURN 1
ENDSELECT

