					PRINTL
					INPUT
					IF INRANGE(RESULT,0,1000)
						charaAge:ARG:0 = RESULT
						PRINTFORMW Accepted. %NAME:ARG% is now {charaAge:ARG:0}.
					ENDIF
				CASE 2
					NewDate = CharaAge:(ARG):2
					NewDate:4 = (NewDate/YearLength)
					;Removes years by dividing it by the year length and multiplying it back again.
					LOCAL:4 = ((NewDate/YearLength)*YearLength)
					IF NewDate < 0
						NewDate:4 --
						LOCAL:4 --
					ENDIF
					;Get the remainder of dividing by year length (124) then divide by month count (4), then adding 1 month
					IF NewDate % YearLength == 0
						NewDate:2 = 4
					ELSEIF NewDate % YearLength % 31 == 0
						NewDate:2 = ABS(NewDate) % YearLength / 31
					ELSE
						NewDate:2 = ABS(NewDate) % YearLength / 31 + 1
					ENDIF
					;Get the remainder of dividing by year length (124) and divide by month count (4), then subtracting 1 day
					IF NewDate % YearLength % 31 == 0
						NewDate:3 = 31
					ELSE
						NewDate:3 = ABS(NewDate % YearLength % 31)
					ENDIF
					;NAS: Negative date handling
					IF NewDate < 0
						NewDate:3 = 31 - (NewDate:3)
						NewDate:2 = 5 - (NewDate:2)
					ENDIF
					;end of month is weird
					IF NewDate:3 == 0
						NewDate:2 --
						SIF NewDate:2 == 0
							NewDate:2 = 4
						NewDate:3 = 31
					ENDIF
					RESULT_3_FIRST_LINE = LINECOUNT
					DO
						CLEARLINE LINECOUNT - RESULT_3_FIRST_LINE
						;(NewDate:3 != 31 ? NewDate:3 # NewDate:3-1)
						NewDate = (NewDate:4*YearLength)+((NewDate:2-1)*(YearLength/MonthCount))+NewDate:3
						SIF NewDate:2 == 4 && NewDate:3 == 31
							NewDate -= YearLength

						PRINTFORML The current chronological age is {charaAge:ARG:1} (born in %PRINT_DATE_F(CharaAge:ARG:2,2,1)%).
						PRINTFORML New Date: %PRINT_DATE_F(NewDate,2,1)%
						PRINTFORML [0] - Change Year: {NewDate:4}
						PRINTFORML [1] - Change Month: {NewDate:2}
						PRINTFORML [2] - Change Day: {NewDate:3}
						PRINTL
						PRINTFORML [997] - Set year as birth year
						PRINTFORML [998] - Apply
						PRINTFORML [999] - Cancel
						INPUT
						SELECTCASE RESULT
						CASE 0
							PRINTFORMDL Enter the year (up to {GET_YEAR()})
							INPUT
							SELECTCASE RESULT
								CASE IS <= GET_YEAR()
									NewDate:4 = RESULT
								CASEELSE
									PRINTFORMDL Invalid Input
							ENDSELECT
						CASE 1
							PRINTFORMDL Enter the month (1-4)
							INPUT
							SELECTCASE RESULT
								CASE 1 TO 4
									NewDate:2 = RESULT
								CASEELSE
									PRINTFORMDL Invalid Input
							ENDSELECT
						CASE 2
							$ENTER_THE_DAY
							PRINTFORMDL Enter the day (1-31)
							INPUT
							SELECTCASE RESULT
								CASE 1 TO 31
									NewDate:3 = RESULT
								CASEELSE
									PRINTFORMDL Invalid Input
							ENDSELECT
						CASE 997
							NewDate:4 = (TimeStamp()-((CharaAge:ARG:0)*YearLength))/YearLength
						CASE 998
						CALLF SetBirthDate(ARG, 0, (NewDate:2 == 4 && NewDate:3 == 31 ? NewDate:4-1 # NewDate:4), NewDate:2, NewDate:3, 0)
						RETURN
						CASE 999
						RETURN
						ENDSELECT
					LOOP 1
				ENDSELECT
			CASE 99
				RETURN
			CASE 108
				CALL SOMATOMETRY(ARG)
		ENDSELECT
	LOOP 1
CASEELSE
	ResSort = nInput/100
	ResSort:1 = nInput % ResSort
	IF INRANGE(ResSort,190,198) || GROUPMATCH(ResSort, 90, 91, 166)
		IF TALENT:ARG:ResSort == ResSort:1
		TALENT:ARG:ResSort = 0
		ELSE
		TALENT:ARG:ResSort = ResSort:1
		ENDIF
	ENDIF
ENDSELECT

