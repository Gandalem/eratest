		PRINTBUTTON "[리셋] ", "RESETME"
		PRINTBUTTON "[취소]", ""
		INPUTS
		IF RESULTS == "RESETME"
			nameArray:ARG:na_Prefix =
		ELSEIF RESULTS != ""
			nameArray:ARG:na_Prefix '= RESULTS
			PRINTFORMW 수락했다. 접두사는 이제 %nameArray:ARG:na_Prefix%로 설정되었다.
		ENDIF
	CASE 7
		PRINTFORML 현재 접미사는 %nameArray:ARG:na_Suffix%이다.
		PRINTFORML 변경하려면 새 이름을 입력한다. (취소하려면 비워두고, 초기화하려면 RESETME를 입력한다.)
		PRINTL
		PRINTBUTTON "[리셋] ", "RESETME"
		PRINTBUTTON "[취소]", ""
		INPUTS
		IF RESULTS == "RESETME"
			nameArray:ARG:na_Suffix =
		ELSEIF RESULTS != ""
			nameArray:ARG:na_Suffix '= RESULTS
			PRINTFORMW 수락했다. 접미사는 이제 %nameArray:ARG:na_Suffix%로 설정되었다.
		ENDIF
	CASE 999
		RETURN 1
ENDSELECT

@CHAR_EDITOR_NAS_PAGE_1(ARG, CHEAT = 0)
#DIM CHEAT
#DIM nInput
CHEAT = 1
CALL Add_STAMINA_BAR(ARG, 28, 1)
IF BASE:ARG:0 != 500 && (CHEAT || MAXBASE:ARG:0 > 1000)
	PRINTBUTTON "[−]", 0
ELSE
	SETCOLOR 0x969696
	PRINT [−]
	RESETCOLOR
ENDIF
IF BASE:ARG:0 != 2500 || CHEAT
	PRINTBUTTON "[＋]", 1
ELSE
	SETCOLOR 0x969696
	PRINT [＋]
	RESETCOLOR
ENDIF
PRINTL
CALL BASE_BAR(ARG, "気力", 28, "青")
IF BASE:ARG:1 != 0
	PRINTBUTTON "[−]", 2
ELSE
	SETCOLOR 0x969696
	PRINT [−]
	RESETCOLOR
ENDIF
IF BASE:ARG:1 != 2500 || CHEAT
	PRINTBUTTON "[＋]", 3
ELSE
	SETCOLOR 0x969696
	PRINT [＋]
	RESETCOLOR
ENDIF
PRINTL
CALL BASE_BAR(ARG, "精力", 28,)
IF BASE:ARG:6 != 0
	PRINTBUTTON "[−]", 4
ELSE
	SETCOLOR 0x969696
	PRINT [−]
	RESETCOLOR
ENDIF
IF BASE:ARG:6 != 2500 || CHEAT
	PRINTBUTTON "[＋]", 5
ELSE
	SETCOLOR 0x969696
	PRINT [＋]
	RESETCOLOR
ENDIF
PRINTL
IF CHEAT
	CALL BASE_BAR(ARG, "法力", 28, "オレンジ")
	IF BASE:ARG:7 != 0
		PRINTBUTTON "[−]", 6
	ELSE
		SETCOLOR 0x969696
		PRINT [−]
		RESETCOLOR
	ENDIF
	IF BASE:ARG:7 != 100 || CHEAT
		PRINTBUTTON "[＋]", 7
	ELSE
		SETCOLOR 0x969696
		PRINT [＋]
		RESETCOLOR
	ENDIF
	PRINTL
ENDIF
CALL BASE_BAR(ARG, "TSP", 28, "水色")
IF BASE:ARG:8 != 0
	PRINTBUTTON "[−]", 8
ELSE
	SETCOLOR 0x969696
	PRINT [−]
	RESETCOLOR
ENDIF
IF BASE:ARG:8 != 100 || (CHEAT && MAXBASE:ARG:8 < 64000)
	PRINTBUTTON "[＋]", 9
ELSE
	SETCOLOR 0x969696
	PRINT [＋]
	RESETCOLOR
ENDIF
PRINTL

@CHAR_EDITOR_NAS_RESULT_1(ARG, CHEAT = 0, nInput)
#DIM CHEAT
#DIM nInput
IF nInput == 0 && MAXBASE:ARG:0 > 500
	MAXBASE:ARG:0 -= 100
ELSEIF nInput == 1
	MAXBASE:ARG:0 += 100
ELSEIF nInput == 2 && MAXBASE:ARG:1 > 0
	MAXBASE:ARG:1 -= 100
ELSEIF nInput == 3
	MAXBASE:ARG:1 += 100
ELSEIF nInput == 4 && MAXBASE:ARG:6 > 0
	MAXBASE:ARG:6 -= 100
ELSEIF nInput == 5
	MAXBASE:ARG:6 += 100
ELSEIF nInput == 6 && MAXBASE:ARG:7 > 0
	SELECTCASE MAXBASE:ARG:7
		CASE IS <= 100
			MAXBASE:ARG:7 = 0
		CASE IS <= 200
			MAXBASE:ARG:7 = 100
		CASE IS <= 500
			MAXBASE:ARG:7 = 200
		CASE IS <= 800
			MAXBASE:ARG:7 = 500
		CASE IS <= 1500
			MAXBASE:ARG:7 = 800
		CASE IS <= 2500
			MAXBASE:ARG:7 = 1500
		CASE IS <= 4000
			MAXBASE:ARG:7 = 2500
		CASE IS <= 8000
			MAXBASE:ARG:7 = 4000
		CASE IS <= 16000
			MAXBASE:ARG:7 = 8000
		CASE IS <= 32000
			MAXBASE:ARG:7 = 16000
		CASEELSE
			MAXBASE:ARG:7 = 32000
	ENDSELECT
ELSEIF nInput == 7
	SIF !TALENT:ARG:ESP
		SETBIT TALENT:ARG:ESP, 0
	SELECTCASE MAXBASE:ARG:7
		CASE IS <= 0
			MAXBASE:ARG:7 = 100
		CASE IS <= 100
			MAXBASE:ARG:7 = 200
		CASE IS <= 200
			MAXBASE:ARG:7 = 500
		CASE IS <= 500
			MAXBASE:ARG:7 = 800
		CASE IS <= 800
			MAXBASE:ARG:7 = 1500
		CASE IS <= 1500
			MAXBASE:ARG:7 = 2500
		CASE IS <= 2500
