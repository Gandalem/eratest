	ELSEIF RESULTS != ""
		nameArray:ARG:na_LastName '= RESULTS
		PRINTFORMW Accepted. Last Name now set to %nameArray:ARG:na_LastName%.
	ENDIF			
CASE 2
	PRINTFORML The current middle name is %nameArray:ARG:na_MiddleName%
	PRINTFORML To change it, enter a new name. (Leave blank to cancel, enter RESETME to reset.)
	PRINTL
	PRINTBUTTON "[Reset] ", "RESETME"
	PRINTBUTTON "[Cancel]", ""				
	INPUTS
	IF RESULTS == "RESETME"
	nameArray:ARG:na_MiddleName =				
	ELSEIF RESULTS != ""
		nameArray:ARG:na_MiddleName '= RESULTS
		PRINTFORMW Accepted. Middle Name now set to %nameArray:ARG:na_MiddleName%.
	ENDIF			
CASE 3
	PRINTFORML The current call name is %CALLNAME:ARG%
	PRINTFORML To change it, enter a new name. (Leave blank to cancel, enter RESETME to reset.)
