			PRINTFORML WARNING:
			PRINTFORML Name conflicts with Character #{ConflictingName(ARG,,LOCALS)} (%NAME:(ConflictingName(ARG,,LOCALS))%)
			PRINTFORML Do you want to abandon this callname?
			CALL ASK_YN()
			SIF !RESULT
				RETURN
		ENDIF
		CALLNAME:ARG '= RESULTS
		PRINTFORMW Accepted. Call Name now set to %CALLNAME:ARG%.
	ENDIF
CASE 4
	PRINTFORML The current bloodline name is %BloodlineName:ARG:0%
	PRINTFORML To change it, enter a new name. (Leave blank to cancel, enter RESETME to reset.)
