#DIM CHEAT
#DIM nInput
#DIM ResSort, 4

ResSort = nInput/100
ResSort:1 = nInput - (ResSort*100)
;PRINTFORML {ResSort}
;PRINTFORMW {ResSort:1}
SELECTCASE nInput
CASE 100
	FOR LOCAL, 0, 1000100, 100
		SELECTCASE LOCAL
		CASE 0, 100, 500, 1000, 1500, 3000, 5000, 1000, 30000, 50000, 100000, 300000, 500000, 1000000
			CALL PRINT_RANK(LOCAL,"MAX_1M")
			PRINTBUTTON @" %DIGIT_GROUP(LOCAL)%", LOCAL
			PRINTFORML
		ENDSELECT
	NEXT
	PRINTL
	PRINTFORML [-1] Leave
	INPUT
	SELECTCASE RESULT
	CASE IS >= 0
		CFLAG:C_ID:2 = RESULT
	ENDSELECT
CASE 101
	FOR LOCAL, 0, 1000100, 100
		SELECTCASE LOCAL
		CASE 0, 10, 50, 100, 150, 500, 1000, 3000, 10000, 20000, 50000, 100000, 300000, 500000
			CALL PRINT_RANK(LOCAL,"MAX_20000")
			PRINTBUTTON @" %DIGIT_GROUP(LOCAL)%", LOCAL
			PRINTFORML
		ENDSELECT
	NEXT
	PRINTL
	PRINTFORML [-1] Leave
	INPUT
	SELECTCASE RESULT
	CASE IS >= 0
		CFLAG:C_ID:4 = RESULT
	ENDSELECT
CASEELSE
	SELECTCASE ResSort
	CASE 177
		INVERTBIT TALENT:C_ID:177, ResSort:1
	CASE 3, 4, 8, 142, 184, 185, 1215
		ResSort:1 -= 5
		IF ResSort:1 == TALENT:C_ID:ResSort
		TALENT:C_ID:ResSort = 0
		ELSE
		TALENT:C_ID:ResSort = ResSort:1
		ENDIF
	CASEELSE
		TALENT:C_ID:ResSort = !TALENT:C_ID:ResSort
	ENDSELECT
ENDSELECT


