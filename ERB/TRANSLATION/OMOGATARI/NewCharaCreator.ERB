				SELECTCASE RESULT
				CASE 1
					PRINTFORML %NAME:ARG% is currently {charaAge:ARG:0}
					PRINTFORML To change it, enter an age from 0 to 1000. (Leave blank to cancel.)
					PRINTL
					PRINTBUTTON "[Cancel] ", charaAge:ARG:0
					PRINTBUTTON "[3] ", 3
					PRINTBUTTON "[7] ", 7
					PRINTBUTTON "[10] ", 10
					PRINTBUTTON "[13] ", 13
					PRINTBUTTON "[16] ", 16
					PRINTBUTTON "[20] ", 20
