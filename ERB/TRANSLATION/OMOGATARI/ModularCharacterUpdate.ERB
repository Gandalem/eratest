;=========================================================
;NAS_KOJO_SETTING_CONTINENCE
;
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Pre-set potty training edit function.
;Didn't make it into ATW so there's just one NAS menu
;----------------------------------------------------------
;Parameters
;----------------------------------------------------------
;ARG: Character (Required)
;nSlotTake: Slot in the nCharaUpdate array
;nDesc: Description
;nUpdateVoice: Voice of the updater (Kojo Color), can be used for third-person update menus. -1 (default) ensures no kojo color
;----------------------------------------------------------
;Example (Adapted from Shinki)
;----------------------------------------------------------
; {
; 	CALL NAS_KOJO_SETTING_CONTINENCE(
; 		102, 4,
; 		@" 「Does %CALLNAME:102% have to go to the potty?」\n
; 		「If so, how good is %HE_SHE(102)% at holding it when nature calls.」",,
; 		@"Gods pee? No. Not in my TW",
; 		@"%CALLNAME:102% can hold %HIMSELF_HERSELF(102)% for days",
; 		@"Yea, but she can handle %HIMSELF_HERSELF(102)% pretty well",
; 		"Fully potty trained, but nothing more.",
; 		@"%HE_SHE(102,1)%'s used her diaper more than the toilet lately.",
; 		@"Potty training?",
; 		@"She makes poo-poo, and then she makes crystal poo-poo.",
; 		@"%HIS_HER(102,1)% cloaca can deal with it.",
; 	)
; }
;==========================================================
@NAS_KOJO_SETTING_CONTINENCE(ARG, nSlotTake, nDesc = "", nUpdateVoice = -1, nSlotDesc = "", nSlotDesc:1 = "", nSlotDesc:2 = "", nSlotDesc:3 = "", nSlotDesc:4 = "", nSlotDesc:5 = "", nSlotDesc:6 = "", nSlotDesc:7 = "", nSlotDesc:8 = "")
#DIM DYNAMIC nSlotTake
#DIMS DYNAMIC nSlotDesc, 20
#DIMS DYNAMIC nDesc
#DIM DYNAMIC nUpdateVoice
;NAS
IF GETBIT(VAR_OR_DEFAULT("nPee"),1) || GETBIT(VAR_OR_DEFAULT("nScat"),2)
{
	CALL KOJO_SETTING(
		ARG, nSlotTake, "Continence",
		@"\@ STRLENS(nDesc) ? %nDesc% # Affects the potty training of %CALLNAME:ARG%. Low potty training means more incontinence events and higher likelihood that %HE_SHE(ARG)%'ll be diapered. \@", nUpdateVoice,
		@"%@"\@ STRLENS(nSlotDesc:0) ? %nSlotDesc:0% # Can't Excrete \@",60,LEFT% %"※Can't excrete",20,LEFT%",
		@"%@"\@ STRLENS(nSlotDesc:1) ? %nSlotDesc:1% # %TOSTR_CONTINENCE(5)% \@",60,LEFT% %"※5 pee and poo holding",20,LEFT%",
		@"%@"\@ STRLENS(nSlotDesc:2) ? %nSlotDesc:2% # %TOSTR_CONTINENCE(3)% \@",60,LEFT% %"※3 pee and poo holding",20,LEFT%",
		@"%@"\@ STRLENS(nSlotDesc:3) ? %nSlotDesc:3% # %TOSTR_CONTINENCE(0)% \@",60,LEFT% %"※0 pee and poo holding",20,LEFT%",
		@"%@"\@ STRLENS(nSlotDesc:4) ? %nSlotDesc:4% # %TOSTR_CONTINENCE(-3)% \@",60,LEFT% %"※-3 pee and poo holding",20,LEFT%",
		@"%@"\@ STRLENS(nSlotDesc:5) ? %nSlotDesc:5% # %TOSTR_CONTINENCE(-4)% \@",60,LEFT% %"※-4 pee and poo holding",20,LEFT%",
		@"%@"\@ STRLENS(nSlotDesc:6) ? %nSlotDesc:6% # %TOSTR_CONTINENCE(-5)% \@",60,LEFT% %"※Urinary and bowel incontinent",20,LEFT%",
		@"%@"\@ STRLENS(nSlotDesc:7) ? %nSlotDesc:7% # Insect Metabolism \@",60,LEFT% %"※Can't pee, but is bowel incontinent",20,LEFT%",
		@"%@"\@ STRLENS(nSlotDesc:8) ? %nSlotDesc:8% # Cloaca \@",60,LEFT% %"※Urinary and bowel incontinent, but goes in one hole",20,LEFT%",
	)
}
ENDIF

;==========================================================
;TOSTR_CONTINENCE
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Lists all continence levels available in NAS
;==========================================================
@TOSTR_CONTINENCE(ARG:0)
#FUNCTIONS
SELECTCASE ARG:0
	CASE IS <= -5
		RETURNF "Incontinent"
	CASE -4
		RETURNF "Very Regressed"
	CASE -3
		RETURNF "Regressing"
	CASE -2
		RETURNF "Habit"
	CASE -1
		RETURNF "Tempted"
	CASE 0
		RETURNF "Continent"
	CASE 1
		RETURNF "Strengthened"
	CASE 2
		RETURNF "Strong"
	CASE 3
		RETURNF "Enhanced"
	CASE 4
		RETURNF "Unbreakable"
	CASE 5
		RETURNF "Masterful"
	CASE 6
		RETURNF "Phantasmic"
	CASE 7
		RETURNF "OverDrive"
	CASE 8
		RETURNF "TriUltra"
	CASE 9
		RETURNF "QuadUltra"
	CASE 99
		RETURNF "Incapable"
	CASE IS >= 10
		RETURNF "PentaUltra"
ENDSELECT
RETURNF "Continent"


