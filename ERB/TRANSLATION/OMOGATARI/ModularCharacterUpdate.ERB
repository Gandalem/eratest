;NAS_KOJO_SETTING_CONTINENCE
;
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Pre-set potty training edit function.
;Didn't make it into ATW so there's just one NAS menu
;----------------------------------------------------------
;Parameters
;----------------------------------------------------------
;ARG: Character (Required)
;nSlotTake: Slot in the nCharaUpdate array
;nDesc: Description
;nUpdateVoice: Voice of the updater (Kojo Color), can be used for third-person update menus. -1 (default) ensures no kojo color
;----------------------------------------------------------
;Example (Adapted from Shinki)
;----------------------------------------------------------
; {
; 	CALL NAS_KOJO_SETTING_CONTINENCE(
; 		102, 4,
; 		@" 「Does %CALLNAME:102% have to go to the potty?」\n
; 		「If so, how good is %HE_SHE(102)% at holding it when nature calls.」",,
; 		@"Gods pee? No. Not in my TW",
; 		@"%CALLNAME:102% can hold %HIMSELF_HERSELF(102)% for days",
; 		@"Yea, but she can handle %HIMSELF_HERSELF(102)% pretty well",
; 		"Fully potty trained, but nothing more.",
; 		@"%HE_SHE(102,1)%'s used her diaper more than the toilet lately.",
; 		@"Potty training?",
; 		@"She makes poo-poo, and then she makes crystal poo-poo.",
; 		@"%HIS_HER(102,1)% cloaca can deal with it.",
; 	)
; }
;==========================================================

@NAS_KOJO_SETTING_CONTINENCE(ARG, nSlotTake, nDesc = "", nUpdateVoice = -1, nSlotDesc = "", nSlotDesc:1 = "", nSlotDesc:2 = "", nSlotDesc:3 = "", nSlotDesc:4 = "", nSlotDesc:5 = "", nSlotDesc:6 = "", nSlotDesc:7 = "", nSlotDesc:8 = "")
#DIM DYNAMIC nSlotTake
#DIMS DYNAMIC nSlotDesc, 20
#DIMS DYNAMIC nDesc
#DIM DYNAMIC nUpdateVoice
;NAS
IF GETBIT(VAR_OR_DEFAULT("nPee"),1) || GETBIT(VAR_OR_DEFAULT("nScat"),2)
	CALL KOJO_SETTING( ARG, nSlotTake, "배변 자제력", @"\@ STRLENS(nDesc) ? %nDesc% # 영향을 미친다 %CALLNAME:ARG%의 배변 훈련에. 낮은 배변 훈련은 더 많은 실금 사건과 %HE_SHE(ARG)%가 기저귀를 차게 될 가능성을 높인다. \@", nUpdateVoice, @"%@"\@ STRLENS(nSlotDesc:0) ? %nSlotDesc:0% # 배설 불가 \@",60,LEFT% %"※배설할 수 없음",20,LEFT%", @"%@"\@ STRLENS(nSlotDesc:1) ? %nSlotDesc:1% # %TOSTR_CONTINENCE(5)% \@",60,LEFT% %"※소변·대변 참기 5",20,LEFT%", @"%@"\@ STRLENS(nSlotDesc:2) ? %nSlotDesc:2% # %TOSTR_CONTINENCE(3)% \@",60,LEFT% %"※소변·대변 참기 3",20,LEFT%", @"%@"\@ STRLENS(nSlotDesc:3) ? %nSlotDesc:3% # %TOSTR_CONTINENCE(0)% \@",60,LEFT% %"※소변·대변 참기 0",20,LEFT%", @"%@"\@ STRLENS(nSlotDesc:4) ? %nSlotDesc:4% # %TOSTR_CONTINENCE(-3)% \@",60,LEFT% %"※소변·대변 참기 -3",20,LEFT%", @"%@"\@ STRLENS(nSlotDesc:5) ? %nSlotDesc:5% # %TOSTR_CONTINENCE(-4)% \@",60,LEFT% %"※소변·대변 참기 -4",20,LEFT%", @"%@"\@ STRLENS(nSlotDesc:6) ? %nSlotDesc:6% # %TOSTR_CONTINENCE(-5)% \@",60,LEFT% %"※소변·대변 실금",20,LEFT%", @"%@"\@ STRLENS(nSlotDesc:7) ? %nSlotDesc:7% # 곤충 대사 \@",60,LEFT% %"※소변을 볼 수 없음, 대변은 참지 못함",20,LEFT%", @"%@"\@ STRLENS(nSlotDesc:8) ? %nSlotDesc:8% # 총배설강 \@",60,LEFT% %"※Urinary and bowel incontinent, 단 하나의 구멍으로 배설",20,LEFT%", )
ENDIF
;==========================================================
;TOSTR_CONTINENCE
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Lists all continence levels available in NAS
;==========================================================

@TOSTR_CONTINENCE(ARG:0)
#FUNCTIONS
SELECTCASE ARG:0
	CASE IS <= -5
		RETURNF "실금"
	CASE -4
		RETURNF "심하게 퇴행"
	CASE -3
		RETURNF "퇴행 중"
	CASE -2
		RETURNF "습관화"
	CASE -1
		RETURNF "위태로움"
	CASE 0
		RETURNF "정상"
	CASE 1
		RETURNF "강화됨"
	CASE 2
		RETURNF "튼튼함"
	CASE 3
		RETURNF "고도 강화"
	CASE 4
		RETURNF "철벽"
	CASE 5
		RETURNF "달인"
	CASE 6
		RETURNF "환상급"
	CASE 7
		RETURNF "오버드라이브"
	CASE 8
		RETURNF "트라이울트라"
	CASE 9
		RETURNF "쿼드울트라"
	CASE 99
		RETURNF "배설 불가"
	CASE IS >= 10
		RETURNF "펜타울트라"
ENDSELECT
RETURNF "정상"
;==================================================================================================================================================================================================================================================================================================
;KOJO_SUBMIT
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Generic effect applying functions
;==================================================================================================================================================================================================================================================================================================
;=========================================================
;NAS_KOJO_SUBMIT_CONTINENCE
;
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Apply's edits to Touhou's potty training depending on the
;----------------------------------------------------------
;Parameters
;----------------------------------------------------------
;ARG: Character (Required)
;nSlotTake: Slot in the nCharaUpdate array
;nUpdateVoice: Voice of the updater (Kojo Color), can be used for third-person update menus. -1 (default) ensures no kojo color
;nSlotDesc:(0 to 19): Description of each option if picked
;----------------------------------------------------------
;Example (From Hourai)
;----------------------------------------------------------
; {
; 	CALL NAS_KOJO_SUBMIT_CONTINENCE(
; 		[[Hourai]], 4, 17,
; 		@"「She cannot excrete anything, as she does not have any metabolism.」",
; 		@"「She's really, really good with her bladder.」",
; 		@"「She's pretty good at holding herself when she really needs to go to the toilet.」",
; 		@"「She's fully potty trained.」",
; 		@"%HE_SHE([[Hourai]],1)%'s starting to have accidents again.",
; 		@"「She's having a really bad time with potty training.」",
; 		@"「She's completely dependent on her padding to keep her safe from accidents.」",
; 		@"「She's completely dependent on her padding to keep her safe from accidents.」\n
;		「She's can't pee, but I think not being able to control when to go number 2 is worse.」",
; 	)
; }
;==========================================================

@NAS_KOJO_SUBMIT_CONTINENCE(ARG, nSlotTake, nUpdateVoice = -1, nSlotDesc = "", nSlotDesc:1 = "", nSlotDesc:2 = "", nSlotDesc:3 = "", nSlotDesc:4 = "", nSlotDesc:5 = "", nSlotDesc:6 = "", nSlotDesc:7 = "", nSlotDesc:8 = "", nSlotDesc:9 = "", nSlotDesc:10 = "", nSlotDesc:11 = "", nSlotDesc:12 = "", nSlotDesc:13 = "", nSlotDesc:14 = "", nSlotDesc:15 = "", nSlotDesc:16 = "", nSlotDesc:17 = "", nSlotDesc:18 = "", nSlotDesc:19 = "")
#DIM DYNAMIC nSlotTake
#DIMS DYNAMIC nSlotDesc, 20
#DIM DYNAMIC nUpdateVoice
SELECTCASE nCharaUpdate:ARG:(CFLAG:ARG:口上セレクタ):nSlotTake
	CASE 0
		TRYCALLF GAMANME(ARG,6,1)
	CASE 1
		TRYCALLF GAMANME(ARG,5,1)
	CASE 2
		TRYCALLF GAMANME(ARG,3,1)
	CASE 3
		TRYCALLF GAMANME(ARG,0,1)
	CASE 4
		TRYCALLF GAMANME(ARG,-3,1)
	CASE 5
		TRYCALLF GAMANME(ARG,-4,1)
	CASE 6
		TRYCALLF GAMANME(ARG,-5,1)
	CASE 7
		TRYCALLF GAMANME_SEP(ARG,6,-5)
	CASE 8
		CALLF DamageBodyPart(ARG,74, 0, 25, ARG, "Unknown Origin", 1)
ENDSELECT
