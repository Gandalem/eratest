; Modular ERB: OMOGATARI/Add_Banquet_31_Church.ERB

@EXIST_ADD_BANQUET31
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET31(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SIF !nReligions
	RETURNF
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "A weekly christian worship")
	CASE "ACTIVITIES"
		CALLF MAKE_STR(V_NAME, "Worship God")
	CASE "TERM"
		CALLF MAKE_STR(V_NAME, "church")
	CASE "PRIORITY"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "NOTIFY_PLAYER"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "HOST"
		CALLF MAKE_INT(V_NAME, 147)
		; CASE "HOST_LIST"
		;     CALLF MAKE_STR(V_NAME, @"16")
	CASE "GUEST_LIST"
		LOCALS =
		FOR C, 0, CHARANUM
		SIF TALENT:C:Religion == 4
			LOCALS += @"{C}/"
		NEXT
		CALLF MAKE_STR(V_NAME, @"%LOCALS%")
	CASE "BANNED_LIST"
		LOCALS =
		FOR C, 0, CHARANUM
		SIF TALENT:C:Religion != 4
			LOCALS += @"{C}/"
		NEXT
		CALLF MAKE_STR(V_NAME, LOCALS)
	CASE "CONDITIONS"
		SIF DAY % 7 == 6
			CALLF MAKE_INT(V_NAME, 1)
	CASE "WEATHER_DEPENDENT"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "DRINKING"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "MUSIC_PERFORMANCE"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING31
#DIM LOCATION
#DIM SCALE
#DIM START_TIME
LOCATION = 1165
SCALE = 2000 + RAND:1000
START_TIME = 660
CALL ADD_BANQUET_CREATE(31, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT
SIF LOCAL < 0 ;couldn't create
	RETURN
ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
PRINTFORMW 천사 중 한 명이 %HIS_HER(147)% 주간 기독교 예배를 드리고 있다.
PRINTFORML 
PRINTFORMW %ADD_BANQUET_TIME_AND_PLACE_DESCRIPTION(LOCAL)%
PRINT 사람들이 이야기하는 방식으로부터
IF ADD_BANQUETS_SCALE:LOCAL >= 5000
	PRINTW 이건 길어질 것 같다.
ELSEIF ADD_BANQUETS_SCALE:LOCAL >= 2500
	PRINTW  큰 집합이 될 것이다.
ELSEIF ADD_BANQUETS_SCALE:LOCAL >= 1500
	PRINTW  믿음의 형제들과 자매들과 우정을 깊게 하기 좋은 장소가 될 것이다.
ELSE
	PRINTW  작은 모임이 될 것 같다.
ENDIF
PRINTFORMW 신의 믿음을 믿는 자들은 사전에 알려야 한다...

