@EXIST_ADD_BANQUET31
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_BANQUET31(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SIF !nReligions
    RETURNF

SELECTCASE O_DATA
	CASE "NAME"
        CALLF MAKE_STR(V_NAME, "A weekly christian worship")
    CASE "ACTIVITIES"
        CALLF MAKE_STR(V_NAME, "Worship God")
    CASE "TERM"
        CALLF MAKE_STR(V_NAME, "church")
    CASE "PRIORITY"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "NOTIFY_PLAYER"
        CALLF MAKE_INT(V_NAME, 1)
    CASE "HOST"
        CALLF MAKE_INT(V_NAME, 147)
    ; CASE "HOST_LIST"
    ;     CALLF MAKE_STR(V_NAME, @"16")
    CASE "GUEST_LIST"
        LOCALS =
        FOR C, 0, CHARANUM
            SIF TALENT:C:Religion == 4
                LOCALS += @"{C}/"
        NEXT
        CALLF MAKE_STR(V_NAME, @"%LOCALS%")
    CASE "BANNED_LIST"
        LOCALS =
        FOR C, 0, CHARANUM
            SIF TALENT:C:Religion != 4
                LOCALS += @"{C}/"
        NEXT
        CALLF MAKE_STR(V_NAME, LOCALS)
    CASE "CONDITIONS"
        SIF DAY % 7 == 6
            CALLF MAKE_INT(V_NAME, 1)
    CASE "WEATHER_DEPENDENT"
        CALLF MAKE_INT(V_NAME, 0)
    CASE "DRINKING"
        CALLF MAKE_INT(V_NAME, 0)
    CASE "MUSIC_PERFORMANCE"
        CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_BANQUET_PLANNING31
#DIM LOCATION
#DIM SCALE
#DIM START_TIME

LOCATION = 1165

SCALE = 2000 + RAND:1000
START_TIME = 660
CALL ADD_BANQUET_CREATE(31, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT

SIF LOCAL < 0 ;couldn't create
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
PRINTFORMW One of the angels is doing %HIS_HER(147)% weekly Christian worship.
PRINTFORML 

PRINTFORMW %ADD_BANQUET_TIME_AND_PLACE_DESCRIPTION(LOCAL)%
PRINT From the way people are talking
IF ADD_BANQUETS_SCALE:LOCAL >= 5000
	PRINTW ... This is going to be a long one.
ELSEIF ADD_BANQUETS_SCALE:LOCAL >= 2500
	PRINTW  it'll be a big gathering.
ELSEIF ADD_BANQUETS_SCALE:LOCAL >= 1500
	PRINTW  it'll be a nice place to deepen some friendships with Brothers and Sisters in faith.
ELSE
	PRINTW  it seems like it's going to be a small gathering.
ENDIF
PRINTFORMW Those believing in the faith of God should inform in advance...

