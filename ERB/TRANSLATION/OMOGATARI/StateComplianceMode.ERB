; Modular ERB: OMOGATARI/StateComplianceMode.ERB

@SCMEnforce()
;Age Ups
VARSET LOCAL
SELECTCASE nSJW
	CASE IS > 1
		FOR LOCAL, 0, CHARANUM
		IF LOCAL != MASTER
			SELECTCASE SCMAgeup(LOCAL)
				CASE 1
					CALL COLORMESSAGE(@"상태 준수 모드: %CALLNAME:LOCAL%을(를) 21세로 나이를 먹인다.",C_ORANGE,1,1)
				CASE 2
					CALL COLORMESSAGE(@"상태 준수 모드: %CALLNAME:LOCAL%은 영구적으로 비활성화된다.",C_ORANGE,1,1)
			ENDSELECT
		ENDIF
		NEXT
ENDSELECT
;Scat
VARSET LOCAL
SELECTCASE nSJW
	CASE 1, 5
		SIF nScat
			LOCAL:1 ++
		nScat = 0
		SIF LOCAL:1
			CALL COLORMESSAGE(@"상태 준수 모드: 스캣은 영구적으로 비활성화되었다.",C_ORANGE,1,1)
	CASE 3, 4
		FOR LOCAL, 0, 64
		IF !GROUPMATCH(LOCAL, 0, 1, 2, 4)
			CLEARBIT nScat, LOCAL
			LOCAL:1 ++
		ELSE
			CONTINUE
		ENDIF
		NEXT
		SIF LOCAL:1
			CALL COLORMESSAGE(@"상태 준수 모드: 스캣은 소프트코어 플레이(즉, 장난)로 제한된다.",C_ORANGE,1,1)
ENDSELECT
