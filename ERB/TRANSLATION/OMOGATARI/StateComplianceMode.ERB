@SCMAgeup(ARG)
#FUNCTION
SIF nSJW < 2
	RETURNF 0
IF nSJW > 1
	SELECTCASE ARG
		CASE 3, 5, 6, 7, 8, 12, 14, 16, 18, 19, 20, 24, 27, 28, 33, 38, 44, 49, 50, 51, 53, 70, 71, 75, 83, 88, 89, 100, 106, 107, 108, 118, 146 TO 149, 120, 122, 123, 169 TO 172 , 161, 157 TO 159
			$SCMBlock
			CFLAG:ARG:出禁 = 99
			RETURNF 2
	ENDSELECT
ENDIF
;sjws mad
IF CharaAge:ARG:0 < 21 && nSJW > 1
	CharaAge:ARG:0 = MAX(21,CharaAge:ARG:0)
	CharaAge:ARG:1 = MAX(21,CharaAge:ARG:1)
	RETURNF 1
ENDIF
