; Modular ERB: OMOGATARI/GAMES/ADD_GAME_INFO_32 Spin to Push.ERB

@EXIST_ADD_GAME_INFO32
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_GAME_INFO32(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Spin to Push")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "기저귀 파티 세션")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, キャラクタ数上限)
	CASE "CHECKREQUIREMENTS"
		SIF GETBIT(nScat, 2)
			CALLF MAKE_INT(V_NAME, 1)
	CASE "VALIDBETS"
		CALLF MAKE_STR(V_NAME, ADD_GAME_STANDARD_BETS())
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 10)
ENDSELECT

@ADD_GAME32
#DIM PlayersLeft
#DIM SKILL_VALUES, 250
#DIM IsWet, 250
#DIM TempTime
#DIM nLoop
#DIM nRoll
#DIM CHARA
VARSET IsWet
PlayersLeft = ADD_GAME_PARTICIPANT_COUNT
TempTime = 0
FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
SKILL_VALUES:LOCAL = (PooHold:(ADD_GAME_PARTICIPANTS:LOCAL):2)
NEXT
CALL PRINT_LETTER( @"밀어서 밀어내기/Tea@OmoOrg의 난장판 게임// 모든 플레이어는 배변 욕구가 있거나 완하제를 복용해야 한다./ 만약 어떤 플레이어도 갈 필요를 느끼지 못한다면, 그들에게 회향유를 먹일 수 있다.// 또한 「10」, 「20」, 「30」, 「50」, 「60」이라는 숫자가 적힌 바퀴가 필요하다./ 규칙// 바퀴를 돌려서 나온 숫자를 확인한다./ 할당된 시간 동안 배를 최대한 세게 누른다./ 마지막 3번의 회전에서 변을 보지 않고 성공하면 승리한다. ", , 40)
PRINTW
FOR nLoop, 1, 4
PRINTFORMW 당신은 스피너를 돌린다…
PRINTL
REPEAT 8
REUSELASTLINE %"."*COUNT%
TWAIT 100, 1
REND
$RERoll
nRoll = RAND(1,7)
SIF GROUPMATCH(nRoll, 5)
	GOTO RERoll
PRINTL
PRINTV nRoll*10
PRINTW !
PRINTFORML 밀어붙여!
PRINTL
REPEAT nRoll*10
REUSELASTLINE {COUNT}
FOR LOCAL,0, ADD_GAME_PARTICIPANT_COUNT
SIF IsWet:LOCAL
	CONTINUE
IF PooHold:(ADD_GAME_PARTICIPANTS:LOCAL):0 >= 6
	PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)%은(는) 대변을 볼 수 없어 참여하지 않는다.
	IsWet:LOCAL = nLoop
	CONTINUE
ELSEIF PooHold:(ADD_GAME_PARTICIPANTS:LOCAL):2 <= -5
	PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)%은(는) 실수를 하고 참여하지 않는다.
	IsWet:LOCAL = nLoop
	CONTINUE
ENDIF
BASE:(ADD_GAME_PARTICIPANTS:LOCAL):Poo += (RAND(2,8))
;messing
IF PooBarStage(ADD_GAME_PARTICIPANTS:LOCAL) >= 7
	IF ADD_GAME_PARTICIPANTS:LOCAL == MASTER
		CALL CAUSE_OMORASHI(MASTER,0,1)
	ELSE
		PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)% %FSYN("poo:ed")% 그들 자신...
		TRYCALL OMORASHI_END((ADD_GAME_PARTICIPANTS:LOCAL), 0, 1)
	ENDIF
	IsWet:LOCAL = nLoop
	PlayersLeft --
ENDIF
NEXT
TWAIT 100, 1
REND
IF PlayersLeft <= 0
	PRINTFORML 모두들 실수를 저질렀다. 
	PRINTFORML 아무도 이기지 못했다...
	BREAK
ENDIF
NEXT
LOCALS =
FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
IF !IsWet:LOCAL
	LOCALS += @"%CALLNAME:(ADD_GAME_PARTICIPANTS:(LOCAL))%、"
	ADD_GAME_WINNERS:(ADD_GAME_WINNER_COUNT++) = ADD_GAME_PARTICIPANTS:(LOCAL)
ELSE
	ADD_GAME_LOSERS:(ADD_GAME_LOSER_COUNT++) = ADD_GAME_PARTICIPANTS:(LOCAL)
ENDIF
NEXT
SIF LOCALS != ""
	PRINTFORML %LIST_IN_STRING(LOCALS)%는 세 번의 회전 동안 모두 그것을 들고 있었다!
FOR LOCAL:1, 0, 12
LOCAL = 12 - LOCAL:1
LOCALS =
FOR CHARA, 0, ADD_GAME_PARTICIPANT_COUNT
IF IsWet:CHARA == LOCAL
	LOCALS += @"%CALLNAME:(ADD_GAME_PARTICIPANTS:(CHARA))%、"
ENDIF
NEXT
SIF LOCALS != ""
	PRINTFORML %LIST_IN_STRING(LOCALS)%은/는 %ORDINAL(LOCAL)% 회전판 위에 대변을 봤다!
NEXT
