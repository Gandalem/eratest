@EXIST_ADD_GAME_INFO31
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_GAME_INFO31(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Omorashi")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "a pee holding session")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, キャラクタ数上限)
	CASE "CHECKREQUIREMENTS"
		SIF GETBIT(nPee,1)
			CALLF MAKE_INT(V_NAME, 1)
	CASE "VALIDBETS"
		CALLF MAKE_STR(V_NAME, ADD_GAME_STANDARD_BETS())
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 120)
ENDSELECT

@ADD_GAME31
#DIM PlayersLeft
#DIM SKILL_VALUES, 250
#DIM IsWet, 250
#DIM TempTime
#DIM nLoop
#DIM CHARA

VARSET IsWet
PlayersLeft = ADD_GAME_PARTICIPANT_COUNT
TempTime = 0

FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
	SKILL_VALUES:LOCAL = (PeeHold:(ADD_GAME_PARTICIPANTS:LOCAL):2)
NEXT
PRINTFORML You bring out %NUM_COUNT(ADD_GAME_PARTICIPANT_COUNT)% big bottles of diuretic-spiked water and have everyone including you chug one down.

WHILE 1
	TempTime += 10	

	FOR LOCAL,0, ADD_GAME_PARTICIPANT_COUNT

	SIF IsWet:LOCAL
		CONTINUE
	IF PeeHold:(ADD_GAME_PARTICIPANTS:LOCAL):0 >= 6
		PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)% is unable to pee and doesn't participate
		IsWet:LOCAL = TempTime
		CONTINUE
	ELSEIF PeeHold:(ADD_GAME_PARTICIPANTS:LOCAL):2 <= -5
		PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)% is incontinent and doesn't participate
		IsWet:LOCAL = TempTime
		CONTINUE
	ENDIF

		IF !RAND(MAX(5+PeeHold:(ADD_GAME_PARTICIPANTS:LOCAL):2,1))
			PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)% couldn't make it and %FSYN("pee:ed")% themselves...
			TRYCALL OMORASHI_END((ADD_GAME_PARTICIPANTS:LOCAL), 1)
			IsWet:LOCAL = TempTime
			PlayersLeft --
		ENDIF
	NEXT

	IF PlayersLeft <= 0
	PRINTFORML Everyone peed themselves. 
	PRINTFORML No one won...
	BREAK
	ENDIF
	
	SIF TempTime == 120
		BREAK 
	
	PRINTFORMW +10 Minutes
WEND

LOCALS =
FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
	IF !IsWet:LOCAL
		LOCALS += @"%CALLNAME:(ADD_GAME_PARTICIPANTS:(LOCAL))%、"
		ADD_GAME_WINNERS:(ADD_GAME_WINNER_COUNT++) = ADD_GAME_PARTICIPANTS:(LOCAL)
	ELSE
		ADD_GAME_LOSERS:(ADD_GAME_LOSER_COUNT++) = ADD_GAME_PARTICIPANTS:(LOCAL)
	ENDIF
NEXT
SIF LOCALS != ""
	PRINTFORML %LIST_IN_STRING(LOCALS)% all held it for the full two hours!

FOR nLoop, 0, 12
	LOCAL = 120 - (nLoop*10)
	LOCALS =
	FOR CHARA, 0, ADD_GAME_PARTICIPANT_COUNT
		IF IsWet:CHARA == LOCAL
			LOCALS += @"%CALLNAME:(ADD_GAME_PARTICIPANTS:(CHARA))%、"
		ENDIF
	NEXT
	SIF LOCALS != ""
		PRINTFORML %LIST_IN_STRING(LOCALS)% wet themselves {LOCAL} minutes in!
NEXT