; Modular ERB: OMOGATARI/GAMES/ADD_GAME_INFO_31 Omorashi.ERB

@EXIST_ADD_GAME_INFO31
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_GAME_INFO31(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Omorashi")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "소변을 참는 세션")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, キャラクタ数上限)
	CASE "CHECKREQUIREMENTS"
		SIF GETBIT(nPee,1)
			CALLF MAKE_INT(V_NAME, 1)
	CASE "VALIDBETS"
		CALLF MAKE_STR(V_NAME, ADD_GAME_STANDARD_BETS())
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 120)
ENDSELECT

@ADD_GAME31
#DIM PlayersLeft
#DIM SKILL_VALUES, 250
#DIM IsWet, 250
#DIM TempTime
#DIM nLoop
#DIM CHARA
VARSET IsWet
PlayersLeft = ADD_GAME_PARTICIPANT_COUNT
TempTime = 0
FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
SKILL_VALUES:LOCAL = (PeeHold:(ADD_GAME_PARTICIPANTS:LOCAL):2)
NEXT
PRINTFORML 당신은 이뇨제 성분이 들어간 물 큰 병 %NUM_COUNT(ADD_GAME_PARTICIPANT_COUNT)% 개를 꺼내고, 당신을 포함한 모두가 그것들을 벌컥벌컥 마시게 한다.
WHILE 1
TempTime += 10
FOR LOCAL,0, ADD_GAME_PARTICIPANT_COUNT
SIF IsWet:LOCAL
	CONTINUE
IF PeeHold:(ADD_GAME_PARTICIPANTS:LOCAL):0 >= 6
	PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)%은 소변을 볼 수 없어 참여하지 않는다
	IsWet:LOCAL = TempTime
	CONTINUE
ELSEIF PeeHold:(ADD_GAME_PARTICIPANTS:LOCAL):2 <= -5
	PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)%은 실금이 가서 참여하지 못한다.
	IsWet:LOCAL = TempTime
	CONTINUE
ENDIF
IF !RAND(MAX(5+PeeHold:(ADD_GAME_PARTICIPANTS:LOCAL):2,1))
	PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)% 도착하지 못하고 %FSYN("pee:ed")% 그들 자신...
	TRYCALL OMORASHI_END((ADD_GAME_PARTICIPANTS:LOCAL), 1)
	IsWet:LOCAL = TempTime
	PlayersLeft --
ENDIF
NEXT
IF PlayersLeft <= 0
	PRINTFORML 모두들 벌거벗었다. 
	PRINTFORML 아무도 이기지 못했다...
	BREAK
ENDIF
SIF TempTime == 120
	BREAK
PRINTFORMW +10분
WEND
LOCALS =
FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
IF !IsWet:LOCAL
	LOCALS += @"%CALLNAME:(ADD_GAME_PARTICIPANTS:(LOCAL))%、"
	ADD_GAME_WINNERS:(ADD_GAME_WINNER_COUNT++) = ADD_GAME_PARTICIPANTS:(LOCAL)
ELSE
	ADD_GAME_LOSERS:(ADD_GAME_LOSER_COUNT++) = ADD_GAME_PARTICIPANTS:(LOCAL)
ENDIF
NEXT
SIF LOCALS != ""
	PRINTFORML %LIST_IN_STRING(LOCALS)% 모두 그것을 두 시간 내내 들고 있었다!
FOR nLoop, 0, 12
LOCAL = 120 - (nLoop*10)
LOCALS =
FOR CHARA, 0, ADD_GAME_PARTICIPANT_COUNT
IF IsWet:CHARA == LOCAL
	LOCALS += @"%CALLNAME:(ADD_GAME_PARTICIPANTS:(CHARA))%、"
ENDIF
NEXT
SIF LOCALS != ""
	PRINTFORML %LIST_IN_STRING(LOCALS)%은(는) {LOCAL}분 동안 스스로를 적셨다!
NEXT
