    PRINTL
    PRINTFORMDL Pick your safe item:

    RESETCOLOR
    FOR LOCAL,0,DiaRoulete_Size
        IF GETBIT(DiaRoulete_StuffUsed:DiaRoulete_Wheel,LOCAL)
            SETCOLOR C_GRAY
            PRINTPLAINFORM [{LOCAL,2}] - \@ DiaRoulete_Wheel == 1 ? %DiaRoulete_BoweStuff:(LOCAL)% # %DiaRoulete_BladStuff:(LOCAL)% \@
            PRINTL
            RESETCOLOR
        ELSE
            PRINTFORML [{LOCAL,2}] - \@ DiaRoulete_Wheel == 1 ? %DiaRoulete_BoweStuff:(LOCAL)% # %DiaRoulete_BladStuff:(LOCAL)% \@
        ENDIF
        RESETCOLOR
    NEXT
    INPUT
    SELECTCASE RESULT
    CASE 0 TO DiaRoulete_Size-1
        SafeItem = RESULT
        PRINTFORML You picked the [\@ DiaRoulete_Wheel == 1 ? %DiaRoulete_BoweStuff:(SafeItem)% # %DiaRoulete_BladStuff:(SafeItem)% \@] as your safe item.
    CASEELSE
