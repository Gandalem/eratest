; Modular ERB: OMOGATARI/GAMES/ADD_GAME_INFO_35 Diarrhea Roulette.ERB

@EXIST_ADD_GAME_INFO35
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_GAME_INFO35(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Desperation Roulette")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "기저귀 팬티 룰렛")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "CHECKREQUIREMENTS"
		SIF (PeeBarStage(MASTER) >= 2) || (PooBarStage(MASTER) >= 2)
			CALLF MAKE_INT(V_NAME, 1)
	CASE "VALIDBETS"
		CALLF MAKE_STR(V_NAME, ADD_GAME_STANDARD_BETS())
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@ADD_GAME35
IF !PottyMonsterGame && !PottyMonsterGame_HasPiss && !PottyMonsterGame_HasScat
	CALL INIT_POTTY_MONSTER_GAME()
	PottyMonsterGame_HasPiss = PeeBarStage(MASTER) >= 2
	PottyMonsterGame_HasScat = PooBarStage(MASTER) >= 2
	PottyMonsterGame_Stats:2 = 8
	PottyMonsterGame_Stats:5 = 1050
	PottyMonsterGame_Stats:6 = 1050
ENDIF
CALL PRINT_LETTER( @"절박함의 룰렛 / 룰렛의 변형 // 목표는 간단하다. \@ PottyMonsterGame_HasScat ? 대변을 본다 # 소변을 본다 \@ 스스로를 망치지 마라. 물론 말은 쉽지만 실천은 어렵다./ 너에게 이 두 바퀴에서 {PottyMonsterGame_Stats:2} 아이템이 주어질 것이다. 하나는 방광 관련 것이고, 다른 하나는 장 관련 것이다./ 너는 지금 화장실에 가야 하는 쪽의 면들만 플레이하게 되며, 여기에는 네 %PeeAndPoo(PottyMonsterGame_HasPiss,PottyMonsterGame_HasScat, "bladder", "bowels")%도 포함된다./ 각 굴림마다 안전한 아이템을 선택할 수 있다. 만약 그 아이템에 착지한다면 강제로 그것을 소비하지 않아도 된다./ 규칙 // 승리하려면 중복되지 않는 {PottyMonsterGame_Stats:2} 번의 생존이 필요하다/ 오염 임계치에 도달하지 않는 한 사고는 허용된다 ", , 40)
CALL DiarrheaRoulette

@DiarrheaRoulette
#DIM DiapeStand,3
#DIM DYNAMIC DiaRoulete_LINECOUNT
#DIM DYNAMIC DiaRoulete_StuffUsed, 2
#DIM DYNAMIC DiaRoulete_Count
#DIM DYNAMIC DiaRoulete_Wheel
#DIM DYNAMIC DIaRoulete_Item
#DIM DYNAMIC SafeItem
#DIM DYNAMIC DiaRoulete_Size
#DIMS CONST DiaRoulete_BladStuff = "Water", "Diuretic Water", "KyuuKyuu-Nyo", "모유", "Coffee", "수박", "Spiked Tea", "Juice", "KyuuKyuu-Soda", "청주"
#DIMS CONST DiaRoulete_BoweStuff = "Laxative Water", "Prune Juice", "KyuuKyuu-Un", "Olive Oil", "Enema", "Spoiled Milk", "Milk of Magnesia", "Castor Oil", "Bananas", "Cookies", "Marshmallows"
PottyMonsterGame = 1
VARSET DiapeStand
CALL KOJO_MESSAGE_SEND("PMONSTERGAME",0,(ADD_GAME_PARTICIPANTS:1),-99,0)
PRINTL
DiaRoulete_LINECOUNT = LINECOUNT
DO
CLEARLINE LINECOUNT - DiaRoulete_LINECOUNT
RESETCOLOR
PRINTFORM 아이템: {DiaRoulete_Count+1}/{PottyMonsterGame_Stats:2} 
PRINTFORM 오염 상태: 
SIF PottyMonsterGame_HasPiss
	PRINTFORM {PottyMonsterGame_Stats:3}/{PottyMonsterGame_Stats:5}ml 
SIF PottyMonsterGame_HasPiss
	PRINTFORM {PottyMonsterGame_Stats:4}/{PottyMonsterGame_Stats:6}g 
PRINTL
IF PottyMonsterGame_HasPiss
	CALL PeeBar(MASTER,20,1)
ENDIF
RESETCOLOR
IF PottyMonsterGame_HasScat
	CALL PooBar(MASTER,20,1)
ENDIF
PRINTL
IF PottyMonsterGame_HasPiss && PottyMonsterGame_HasScat
	PRINTFORMDW %CALLNAME:(ADD_GAME_PARTICIPANTS:1)%이 동전을 던진다.....
	REPEAT 5
	REUSELASTLINE  Tossing.%"." * COUNT%
	TWAIT 150, 1
	REND
	CALL SET_KOJO_COLOR((ADD_GAME_PARTICIPANTS:1))
	DiaRoulete_Wheel = RAND:2
	SELECTCASE DiaRoulete_Wheel
		CASE 0
			PRINTFORMW 「앞면!」
			GOTO WheelBladder
		CASE 1
			PRINTFORMW 「테일스!」
			GOTO WheelBowel
	ENDSELECT
ELSEIF PottyMonsterGame_HasScat
	$WheelBowel
	DiaRoulete_Wheel = 1
	PRINTFORMDL %CALLNAME:(ADD_GAME_PARTICIPANTS:1)%이 장내 절망의 바퀴를 돌리기 시작한다.
ELSE
	$WheelBladder
	DiaRoulete_Wheel = 0
	PRINTFORMDL %CALLNAME:(ADD_GAME_PARTICIPANTS:1)%이 방광 절박함의 바퀴를 돌리기 시작한다...
ENDIF
DiaRoulete_Size = (DiaRoulete_Wheel == 1 ? VARSIZE("DiaRoulete_BoweStuff") # VARSIZE("DiaRoulete_BladStuff"))
PRINTL
PRINTFORMDL 안전한 아이템을 고르세요:
RESETCOLOR
FOR LOCAL,0,DiaRoulete_Size
IF GETBIT(DiaRoulete_StuffUsed:DiaRoulete_Wheel,LOCAL)
	SETCOLOR C_GRAY
	PRINTPLAINFORM [{LOCAL,2}] - \@ DiaRoulete_Wheel == 1 ? %DiaRoulete_BoweStuff:(LOCAL)% # %DiaRoulete_BladStuff:(LOCAL)% \@
	PRINTL
	RESETCOLOR
ELSE
	PRINTFORML [{LOCAL,2}] - \@ DiaRoulete_Wheel == 1 ? %DiaRoulete_BoweStuff:(LOCAL)% # %DiaRoulete_BladStuff:(LOCAL)% \@
ENDIF
RESETCOLOR
NEXT
INPUT
SELECTCASE RESULT
	CASE 0 TO DiaRoulete_Size-1
		SafeItem = RESULT
		PRINTFORML 당신은 안전 아이템으로 [\@ DiaRoulete_Wheel == 1 ? %DiaRoulete_BoweStuff:(SafeItem)% # %DiaRoulete_BladStuff:(SafeItem)% \@]을 골랐다.
	CASEELSE
		RESTART
ENDSELECT
CALL FISHER_YATES_SHAFFLE(DiaRoulete_Size)
REDRAW 0
PRINTFORMDL %" "*25%V
REPEAT 50
FOR LOCAL,1,-2,-1
IF iNRANGE(COUNT % DiaRoulete_Size+LOCAL,0,DiaRoulete_Size-1)
	LOCAL:1 = (COUNT % DiaRoulete_Size)+LOCAL
ELSE
	LOCAL:1 = DiaRoulete_Size-1
ENDIF
PRINTFORMD [\@ DiaRoulete_Wheel == 1 ? %DiaRoulete_BoweStuff:(SHAFFLE_ARRAY:(LOCAL:1)),16% # %DiaRoulete_BladStuff:(SHAFFLE_ARRAY:(LOCAL:1)),16% \@] 
NEXT
PRINTL
SELECTCASE 50-COUNT
	CASE IS > 31
		TWAIT 10, 1
	CASE IS > 7
		TWAIT 50, 1
	CASE IS > 3
		TWAIT 250, 1
	CASE IS > 0
		TWAIT 500, 1
	CASE 1
		TWAIT 1000, 1
ENDSELECT
TWAIT 20, 1
SIF COUNT != 50 && COUNT != 49
	CLEARLINE 1
IF COUNT % DiaRoulete_Size == 0
	CALL FISHER_YATES_SHAFFLE(DiaRoulete_Size)
ENDIF
REND
DIaRoulete_Item = SHAFFLE_ARRAY:((COUNT-1) % DiaRoulete_Size)
CALL SET_KOJO_COLOR((ADD_GAME_PARTICIPANTS:1))
IF GETBIT(DiaRoulete_StuffUsed:DiaRoulete_Wheel,DIaRoulete_Item)
	PRINTFORMDW 그것은 이미 가져간 [\@ DiaRoulete_Wheel == 1 ? %DiaRoulete_BoweStuff:DIaRoulete_Item% # %DiaRoulete_BladStuff:DIaRoulete_Item% \@]에 떨어졌다.
	CONTINUE
ELSEIF DIaRoulete_Item == SafeItem
	PRINTFORMDW 그것은 당신의 안전 아이템이었던 [\@ DiaRoulete_Wheel == 1 ? %DiaRoulete_BoweStuff:DIaRoulete_Item% # %DiaRoulete_BladStuff:DIaRoulete_Item% \@]에 떨어졌다.
	SETBIT DiaRoulete_StuffUsed:DiaRoulete_Wheel, DIaRoulete_Item
	DiaRoulete_Count++
	CONTINUE
ELSE
	PRINTFORMW 「\@ DiaRoulete_Wheel == 1 ? %DiaRoulete_BoweStuff:DIaRoulete_Item% # %DiaRoulete_BladStuff:DIaRoulete_Item% \@!」
ENDIF
CALL KOJO_MESSAGE_SEND("PMONSTERGAME",0,(ADD_GAME_PARTICIPANTS:1),DiaRoulete_Wheel,DIaRoulete_Item)
SELECTCASE DiaRoulete_Wheel
	CASE 0
		SELECTCASE DIaRoulete_Item
			CASE 0,1
				IF DIaRoulete_Item == 0
					BASE:MASTER:4 += 50
				ELSE
					TCVAR:MASTER:利尿剤 = MAX(TCVAR:MASTER:利尿剤,90)
				ENDIF
				CALL DRINK(MASTER, 500)
			CASE 2
				TCVAR:MASTER:利尿剤 = MAX(TCVAR:MASTER:利尿剤,210)
			CASE 3
				CALL DRINK(MASTER, 350)
				CALL EAT(MASTER,350)
			CASE 5
				TCVAR:MASTER:利尿剤 = MAX(TCVAR:MASTER:利尿剤,30)
				CALL DRINK(MASTER, 250)
				CALL EAT(MASTER,350)
			CASE 6
				CALLF RINYOUME(MASTER, 40, 0)
				CALLF GERIME(MASTER, 40, 300, 0)
			CASE 7
				CALL DRINK(MASTER, 1000)
			CASE 8
				CALLF RINYOUME(MASTER, 90, 1000)
				CALLF GERIME(MASTER, 90, 1000, 0)
			CASE 9
				CALL DRINK(MASTER, 500)
				CALL DRUNKEN(MASTER,53)
		ENDSELECT
	CASE 1
		SELECTCASE DIaRoulete_Item
			CASE 1
				DrugStats:MASTER:LaxativeTime = MAX(DrugStats:MASTER:LaxativeTime,210)
			CASE 2
				DrugStats:MASTER:KyuuKyuuUnTime = MAX(DrugStats:MASTER:KyuuKyuuUnTime,210)
			CASE 3
				DrugStats:MASTER:OliveOilTime = MAX(DrugStats:MASTER:OliveOilTime,210)
			CASE 4
				BASE:MASTER:Poo += 600
				TCVAR:MASTER:BowelState = 2
			CASE 5
				CALL EAT(MASTER,500)
				TCVAR:MASTER:BowelState = 1
			CASE 7
				DrugStats:MASTER:CastorOilTime = MAX(DrugStats:MASTER:CastorOilTime,210)
			CASE 8
				BASE:MASTER:Poo += 450
			CASE 9
				CALL EAT(MASTER,500)
				DrugStats:MASTER:KyuuKyuuUnTime = MAX(DrugStats:MASTER:KyuuKyuuUnTime,210)
			CASE 10
				SOURCE:MASTER:快Ａ += 5000
				DrugStats:MASTER:LaxativeTime += 90
				BASE:MASTER:Poo += 200
		ENDSELECT
ENDSELECT
SETBIT DiaRoulete_StuffUsed:DiaRoulete_Wheel, DIaRoulete_Item
DiaRoulete_Count++
TIME += 5
CALL TIMETSPPASSAGE
WAIT
CALL BASE自然変動(MASTER)
;after
CALL KOJO_MESSAGE_SEND("PMONSTERGAME",0,(ADD_GAME_PARTICIPANTS:1),-80,0)
LOCAL:4 = BASE:MASTER:4
LOCAL:17 = BASE:MASTER:17
;player desperation
CALL NeedForPee(MASTER)
;calculate after leak or accident
PottyMonsterGame_Stats:3 += (LOCAL:4-BASE:MASTER:4)
PottyMonsterGame_Stats:4 += (LOCAL:17-BASE:MASTER:17)
PottyMonsterGame_LastDesp:0 = PeeBarStage(MASTER)
PottyMonsterGame_LastDesp:1 = PooBarStage(MASTER)
TIME:1 = TIME + 1440 * DAY
SIF PottyMonsterGame_Stats:3 >= PottyMonsterGame_Stats:5
	GOTO PlayerAccident
SIF PottyMonsterGame_Stats:4 >= PottyMonsterGame_Stats:6
	GOTO PlayerAccident
IF (DiaRoulete_Count+1) >= PottyMonsterGame_Stats:2
	PRINTFORMDW 당신은 할당된 시간을 버텨냈다.
	CALL KOJO_MESSAGE_SEND("PMONSTERGAME",0,(ADD_GAME_PARTICIPANTS:1),-910,0)
	ADD_GAME_WINNERS = MASTER
	ADD_GAME_LOSERS = (ADD_GAME_PARTICIPANTS:1)
	CALL INIT_POTTY_MONSTER_GAME
	RETURN 1
ENDIF
LOOP 1
$PlayerAccident
PRINTFORMDW 당신은 잠시 숨을 돌리자, 당신의 %PeeProtectType(MASTER,3)%는 이제 %PeeAndPoo(PottyMonsterGame_HasPiss,PottyMonsterGame_HasScat,"thoroughly saturated", "carrying a hefty load in the back")%하게 되었다.
CALL KOJO_MESSAGE_SEND("PMONSTERGAME",0,(ADD_GAME_PARTICIPANTS:1),-900,0)
ADD_GAME_LOSERS = MASTER
ADD_GAME_WINNERS = (ADD_GAME_PARTICIPANTS:1)
SIF GROUPMATCH((ADD_GAME_PARTICIPANTS:1),102,[[Shanghai]],[[Hourai]])
	K102_PottyMonsterAccidents ++
RETURN -4
CALL INIT_POTTY_MONSTER_GAME

@INIT_POTTY_MONSTER_GAME()
VARSET PottyMonsterGame
VARSET PottyMonsterGame_HasPiss
VARSET PottyMonsterGame_HasScat
VARSET PottyMonsterGame_Stats
VARSET PottyMonsterGame_LastDesp
