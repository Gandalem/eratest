@DiarrheaRoulette
#DIM DiapeStand,3
#DIM DYNAMIC DiaRoulete_LINECOUNT
#DIM DYNAMIC DiaRoulete_StuffUsed, 2
#DIM DYNAMIC DiaRoulete_Count
#DIM DYNAMIC DiaRoulete_Wheel
#DIM DYNAMIC DIaRoulete_Item
#DIM DYNAMIC SafeItem
#DIM DYNAMIC DiaRoulete_Size
{
#DIMS CONST DiaRoulete_BladStuff = 
    "Water",
    "Diuretic Water",
    "KyuuKyuu-Nyo",
    "Milk",
    "Coffee",
    "Watermelon",
    "Spiked Tea",
    "Juice",
    "KyuuKyuu-Soda",
    "Sake"
}
{
#DIMS CONST DiaRoulete_BoweStuff =
    "Laxative Water",
    "Prune Juice",
    "KyuuKyuu-Un",
    "Olive Oil",
    "Enema",
    "Spoiled Milk",
    "Milk of Magnesia",
    "Castor Oil",
    "Bananas",
    "Cookies",
