@EXIST_ADD_GAME_INFO30
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_GAME_INFO30(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Practical Shooting")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "a shooting competition")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, キャラクタ数上限)
	CASE "CHECKREQUIREMENTS"
		SIF OUTROOF(CFLAG:MASTER:現在位置) && GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Type") == "Firearm"
			CALLF MAKE_INT(V_NAME, 1)
	CASE "VALIDBETS"
		CALLF MAKE_STR(V_NAME, ADD_GAME_STANDARD_BETS())
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 30)
ENDSELECT

@ADD_GAME30
#DIM BASE_TIMEOUT
#DIM ACTUAL_TIMEOUT
#DIM ROUNDS
#DIM CORRECT_OPTION
#DIM POINTS, 250
#DIM CHARA
#DIMS VALID_AREAS
#DIMS VALID_WORDS
#DIM TIME_REDUCTION
#DIM ANSWER,2
#DIM BestScore,2
VARSET POINTS
ROUNDS = 11 ;uneven amount of rounds to ensure a victor
LOCALS:0 = ↑
LOCALS:1 = →
LOCALS:2 = ←
LOCALS:3 = ↓
CHARA = TARGET
VALID_WORDS = lascivious:erotic:lewd:raunchy:lecherous:suggestive:smutty:salacious

PRINTFORML You set out some targets for the %NUM_COUNT(ADD_GAME_PARTICIPANT_COUNT)% of you to enjoy.
PRINTFORML
PRINTFORML Ready?
REPEAT 3
	REUSELASTLINE  {3-COUNT}
	TWAIT 1000, 1
REND
PRINTFORML BEEP!
FOR LOCAL, 0, ROUNDS
	PRINTFORML
	FOR LOCAL:1, 0, ADD_GAME_PARTICIPANT_COUNT
	PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:(LOCAL:1)),15,LEFT% %"("+CAPITALIZE(GET_STR(ADD_GAME_PARTICIPANTS:(LOCAL:1), "Weapon", EQUIP:(ADD_GAME_PARTICIPANTS:(LOCAL:1)):Weapon, "名前"))+"):",15,LEFT% {POINTS:(LOCAL:1)}
	NEXT
	PRINTFORMW Round {LOCAL+1} out of {ROUNDS}!

	BASE_TIMEOUT = 2000 ;+ (ABL:MASTER:戦闘能力 * 100)
	ACTUAL_TIMEOUT = BASE_TIMEOUT
	TIME_REDUCTION = 0

	PRINTFORM Shoot 
	CORRECT_OPTION = RAND:4
	IF CORRECT_OPTION == 4
		SETCOLOR C_YELLOW
		PRINTFORM straight at you
	ELSE
		SETCOLOR C_YELLOW
		PRINTFORM %LOCALS:(CORRECT_OPTION)%
	ENDIF
	RESETCOLOR
	PRINTFORML !
	
	CALL FISHER_YATES_SHAFFLE(4)
	FOR LOCAL:10,0,4
		LOCAL:2 = SHAFFLE_ARRAY:(LOCAL:10)
		PRINTFORML [{LOCAL:2}] - Shoot %LOCALS:(LOCAL:2)%
	NEXT

	GETMILLISECOND
	ANSWER = RESULT 

	TINPUT ACTUAL_TIMEOUT, 4, 1, ""	
	IF RESULT == CORRECT_OPTION
		CALL PlayFireSound(MASTER)
		PRINTFORML Ping!
		GETMILLISECOND
		ANSWER:1 = ACTUAL_TIMEOUT - (RESULT - ANSWER)
		PRINTFORML {ANSWER:1} time remaining.   		
		POINTS:0 += ANSWER:1
		EXP:MASTER:Shooting += 3
	ELSE
		CALL PlayFireSound(MASTER)
		PRINTFORML You completely miss!
		POINTS:0 -= 1000
	ENDIF	

	FOR CHARA, 1, ADD_GAME_PARTICIPANT_COUNT
		;check if opponent succeeds in returning it
		;IF RAND:(20 + (ABL:CHARA:戦闘能力 * 4) - (STRIKE * 2)) > 5
		CALL PlayFireSound(ADD_GAME_PARTICIPANTS:CHARA)
		IF RAND:(6 + (ABL:(ADD_GAME_PARTICIPANTS:CHARA):Shooting * 4)) > 5
			PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:CHARA)% hits the target as well.
			POINTS:CHARA += RAND(1,ACTUAL_TIMEOUT)
			EXP:(ADD_GAME_PARTICIPANTS:CHARA):Shooting += 3
		ELSE
			PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:CHARA)% fails to hit the target.
			POINTS:CHARA -= 1000
		ENDIF	
		TWAIT 1, 0		
	NEXT
NEXT

PRINTFORML The game is over.
FOR LOCAL:1, 0, ADD_GAME_PARTICIPANT_COUNT
PRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:(LOCAL:1)),15,LEFT% %"("+CAPITALIZE(GET_STR(ADD_GAME_PARTICIPANTS:(LOCAL:1), "Weapon", EQUIP:(ADD_GAME_PARTICIPANTS:(LOCAL:1)):Weapon, "名前"))+"):",15,LEFT% {POINTS:(LOCAL:1)}
	IF BestScore < POINTS:(LOCAL:1)
	;set high scorer
	BestScore = POINTS:(LOCAL:1)
	BestScore:1 = ADD_GAME_PARTICIPANTS:(LOCAL:1)
	ENDIF
NEXT

;fallback to master winning if null char
SIF BestScore:1 >= CHARANUM
	BestScore:1 = MASTER

PRINTFORML With {BestScore} points, %CALLNAME:(BestScore:1)% is victorious.
FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
	IF (BestScore:1) == ADD_GAME_PARTICIPANTS:(LOCAL)
		ADD_GAME_WINNERS:(ADD_GAME_WINNER_COUNT++) = ADD_GAME_PARTICIPANTS:(LOCAL)
	ELSE
		ADD_GAME_LOSERS:(ADD_GAME_LOSER_COUNT++) = ADD_GAME_PARTICIPANTS:(LOCAL)
	ENDIF
NEXT