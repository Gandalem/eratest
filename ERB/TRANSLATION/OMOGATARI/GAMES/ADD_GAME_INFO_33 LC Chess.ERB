; Modular ERB: OMOGATARI/GAMES/ADD_GAME_INFO_33 LC Chess.ERB

@EXIST_ADD_GAME_INFO33
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_GAME_INFO33(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
RETURNF
SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Lethal Combat Chess")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "체스의 변형")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "CHECKREQUIREMENTS"
		SIF nRyona
			CALLF MAKE_INT(V_NAME, 1)
	CASE "VALIDBETS"
		CALLF MAKE_STR(V_NAME, ADD_GAME_STANDARD_BETS())
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 10)
ENDSELECT

@ADD_GAME33
#DIM PlayersLeft
#DIM SKILL_VALUES, 250
#DIM IsWet, 250
#DIM TempTime
#DIM nLoop
#DIM nRoll
#DIM CHARA
VARSET IsWet
PlayersLeft = ADD_GAME_PARTICIPANT_COUNT
TempTime = 0
FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
SKILL_VALUES:LOCAL = (PooHold:(ADD_GAME_PARTICIPANTS:LOCAL):2)
NEXT
CALL PRINT_LETTER( @"LC 체스 / FPS 체스의 변형 // 체스처럼 진행되지만 한 가지 차이가 있다: 어떤 말이든 포획하려는 시도는 두 말 사이에 치명적인 전투를 시작시킨다/ 생존자는 판 위에 머문다. 규칙 // 상대방을 체크메이트하여 승리한다. ", , 40)
PRINTW
