@EXIST_ADD_GAME_INFO33
#LOCALSIZE 1
#LOCALSSIZE 1

@ADD_GAME_INFO33(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
RETURNF

SELECTCASE O_DATA
	CASE "NAME"
		CALLF MAKE_STR(V_NAME, "Lethal Combat Chess")
	CASE "DESCRIPTION"
		CALLF MAKE_STR(V_NAME, "a variant of Chess")
	CASE "MINPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "MAXPLAYERS"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "CHECKREQUIREMENTS"
		SIF nRyona
			CALLF MAKE_INT(V_NAME, 1)
	CASE "VALIDBETS"
		CALLF MAKE_STR(V_NAME, ADD_GAME_STANDARD_BETS())
	CASE "DURATION"
		CALLF MAKE_INT(V_NAME, 10)
ENDSELECT

@ADD_GAME33
#DIM PlayersLeft
#DIM SKILL_VALUES, 250
#DIM IsWet, 250
#DIM TempTime
#DIM nLoop
#DIM nRoll
#DIM CHARA

VARSET IsWet
PlayersLeft = ADD_GAME_PARTICIPANT_COUNT
TempTime = 0

FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
	SKILL_VALUES:LOCAL = (PooHold:(ADD_GAME_PARTICIPANTS:LOCAL):2)
NEXT
{
    CALL PRINT_LETTER(
    @"LC Chess/
A variant of FPS Chess//
Plays like chess but with one variation:/
Any attempt to capture a piece will start a lethal combat battle between the two pieces/
Survivor stays on the board.
Rules://
Checkmate your opponent to win.
    ", , 40)
}
PRINTW