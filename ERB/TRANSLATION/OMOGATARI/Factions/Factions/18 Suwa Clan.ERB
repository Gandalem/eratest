@EXIST_Faction18
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction18(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "Suwa Clan")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "MORIYA")	
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "Moriya")
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"The Suwa clan, also known as the Moriyas, are transhumanists from the Outside World.")
CASE "Raider Pool"
	; raider pool
	LOCAL = 18
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 32
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

