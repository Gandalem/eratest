; Modular ERB: OMOGATARI/Factions/Factions/01 Human Village Alliance.ERB

@EXIST_Faction1
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "Human Village Alliance")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "HVA")
	CASE "Military"
		CALLF MAKE_STR(V_NAME, "People's Militia")
	CASE "MilitaryAbriv"
		CALLF MAKE_STR(V_NAME, "PMC")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "PMC")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"중세 시대 정도의 인간 정착지. 보통은 다른 곳에서 수집했거나 19세기 시대의 기술 장비만 가지고 있다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Leader"
		LOCAL = 67
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

@FACTION_INIT1
FactionTech:1 = 5
FactionWealth:1 = 250000
FactionUnits:1:1 = 150000
FactionUnits:1:2 = 800000
FactionUnits:1:3 = 25000
FactionUnits:1:4 = 1000
FactionUnits:1:5 = 150
FactionUnits:1:6 = 1
FOR LOCAL,0,20
SIF GROUPMATCH(LOCAL,5,10,11)
	CONTINUE
SETBIT FactionPatrolArea:1, LOCAL
NEXT

@FACTION_JOIN_REQURIE_1(C_ID)
#FUNCTION
#DIM C_ID
FactionJoinConditionMessage:0 '= @"관계가 -25000보다 좋다 (현재:{FactionRelationCompElse(C_ID,1)})"
FactionJoinCondition:0 = FactionRelationCompElse(C_ID,1) > -25000
FactionJoinConditionMessage:1 '= @"%GET_MAPNAME(2)%의 거주자가 되어라"
FactionJoinCondition:1 = (MAIN_MAP == 2)
FactionJoinConditionMessage:2 '= "인간일 것(마계인이나 월인이 아닐 것)"
FactionJoinCondition:2 = !IS_NONHUMAN(C_ID)

