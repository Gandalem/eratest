@EXIST_Faction3
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction3(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "The Netherworld")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "NW")	
CASE "Military"
	CALLF MAKE_STR(V_NAME, "Netherworld Ministry of Defense")	
CASE "MilitaryAbriv"
	CALLF MAKE_STR(V_NAME, "NMOD")		
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "netherworld defender")				
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Faction of the Netherworld Ministry. Unlike other factions, the soldiers here are oni with great danmaku experience.")			
CASE "Raider Pool"
	; raider pool
	LOCAL = 3
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 26
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

