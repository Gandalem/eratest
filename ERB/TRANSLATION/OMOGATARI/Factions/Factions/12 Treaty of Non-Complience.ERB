; `Bandits`

; Bandits are a unique special faction - they do not need to hold territory to exist.
; They are only destroyed after the entire world is united.
; When bandits control no cities, their armies randomly appear in relay points.
; They break down captives using gang rape and drugs.

@EXIST_Faction12
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction12(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "Treaty of Non-Compliance")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "T-NC")	
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "manhunter youkai")				
CASE "Desc"
	LOCALS '= "Manhunter youkai with somewhat enough leadership to form raiding groups. (Permanently Hostile)\n"
	LOCALS += "They do not need to hold territory to exist.\n"
	LOCALS += "They are only destroyed after the entire world is united.\n"
	LOCALS += "When the T-NC control no areas, their armies randomly appear in relay points.\n"
	CALLF MAKE_STR(V_NAME, LOCALS)
CASE "Raider Pool"
	; raider pool
	LOCAL = 12
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

