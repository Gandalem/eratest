; Modular ERB: OMOGATARI/Factions/Factions/14 Japan.ERB

@EXIST_Faction14
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction14(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		IF StartingYear > 1947
			CALLF MAKE_STR(V_NAME, "Japan")
		ELSE
			CALLF MAKE_STR(V_NAME, "Imperial Japan")
		ENDIF
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "JP")
	CASE "Military"
		IF StartingYear > 1947
			CALLF MAKE_STR(V_NAME, "Japan")
		ELSE
			CALLF MAKE_STR(V_NAME, "Imperial Japanese Army")
		ENDIF
	CASE "MilitaryAbriv"
		IF StartingYear > 1947
			CALLF MAKE_STR(V_NAME, "JSDF")
		ELSE
			CALLF MAKE_STR(V_NAME, "IJA")
		ENDIF
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "병사")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"축하한다. 너는 방금 이 세계(幻想郷)를 일본 나머지 지역에 개방했다. 그들은 너와 협상하거나, 혹은 유엔과 미합중국을 도와 네 영토를 합병하려고 들 것이다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Outsider"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT
