@EXIST_Faction14
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction14(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	IF StartingYear > 1947
	CALLF MAKE_STR(V_NAME, "Japan")
	ELSE
	CALLF MAKE_STR(V_NAME, "Imperial Japan")
	ENDIF	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "JP")		
CASE "Military"
	IF StartingYear > 1947
	CALLF MAKE_STR(V_NAME, "Japan")
	ELSE
	CALLF MAKE_STR(V_NAME, "Imperial Japanese Army")
	ENDIF	
CASE "MilitaryAbriv"
	IF StartingYear > 1947
	CALLF MAKE_STR(V_NAME, "JSDF")
	ELSE
	CALLF MAKE_STR(V_NAME, "IJA")
	ENDIF		
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "soldier")				
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Congratulations. You just opened up Gensokyo to the rest of Japan. They'll either negotiate with you, or try to annex your territory with the help of the United Nations and the United States of America.")			
CASE "Raider Pool"
	; raider pool
	LOCAL = 0
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Outsider"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT