@EXIST_Faction15
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction15(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "United States of America")
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "USA")		
CASE "Military"
	CALLF MAKE_STR(V_NAME, "United States Army")
CASE "MilitaryAbriv"
	CALLF MAKE_STR(V_NAME, "USA")
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "soldier")				
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Bad choice you made fucking with the US Army.")			
CASE "Raider Pool"
	; raider pool
	LOCAL = 0
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Outsider"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT