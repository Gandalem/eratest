@FACTION_RANK_ABRIV_9(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 1
		;member 1
		RETURNF "MB1"
	CASE 2
		;member 2
		RETURNF "MB2"
	CASE 3
		; member 3
		RETURNF "MB3"
	CASE 4
		; officer
		RETURNF "OF"
	CASE 5
		; lieutendent
		RETURNF "OF2"
	CASE 6
		; federation leader
		RETURNF "FL"
ENDSELECT

@FACTION_CALLSIGN_9(ARG,ARG:1)
#FUNCTIONS
SIF SaveIsEZB
	RETURNF "steamuser"
RETURNF FACTION_RANK_ABRIV_9(FactionRank:ARG:9)+@"-{ARG}%COND_STR(" ",ARG:1)%"

@EXIST_衣装セット303
#LOCALSIZE 1
#LOCALSSIZE 1

@衣装セット303(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, @"Federation of Makai %FACTION_RANK_ABRIV_9(3)% Soldier Set")
	CASE "キャラ特殊衣装セット"
		CALLF MAKE_INT(V_NAME, 1)
		;こっから衣装設定系
	CASE "帽子"
		CALLF MAKE_INT(V_NAME,66)
	CASE "外衣"
		CALLF MAKE_INT(V_NAME,24)
	CASE "ボディースーツ"
		CALLF MAKE_INT(V_NAME,33)
	CASE "靴"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "靴下"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "靴下"))
	CASE "下半身下着１"
		SIF nOmutsu
			CALLF MAKE_INT(V_NAME, 27)
	CASE "下半身下着２"
		IF nOmutsu
			CALLF MAKE_INT(V_NAME, 171)
		ELSE
			CALLF MAKE_INT(V_NAME, 163)
		ENDIF
ENDSELECT
