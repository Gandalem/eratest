@Faction9(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		; SELECTCASE GET_YEAR()
		; CASE 0 TO 1990
		; 	CALLF MAKE_STR(V_NAME, "Makai")
		; CASE 1990 TO 1996
		; 	CALLF MAKE_STR(V_NAME, "Old Makai")
		; CASE 1990 TO 2004
		; 	CALLF MAKE_STR(V_NAME, "Federation of Makai")
		; CASE 2005 TO 2009
		; 	CALLF MAKE_STR(V_NAME, "Fallen Makai")
		; CASE IS >= 2010
		CALLF MAKE_STR(V_NAME, "Federation of Makai")
		; ENDSELECT
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "MKFed")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "마카이 병사")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"마카이(Makai)라고 알려진 자급자족하는 초기술 세계로, 많은 강력한 요괴들이 존재한다. 세이호 세계보다 힘 면에서 우위에 있으며 스스로 유지된다. 대체로 평화롭지만(환경 제외), 그들의 바이오닉 강화 병사들은 가장 강력한 요괴조차 갈기갈기 찢을 수 있다. 마카이의 창시자이자 지도자인 %CALLNAME:102%는 무(無)에서 무엇이든 만들어내는 능력을 가지고 있으며, 이 능력 덕분에 마카이는 기술적으로 매우 빠르게 발전해 왔다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 9
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Leader"
		LOCAL = 102
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

