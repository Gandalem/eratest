@EXIST_Faction8
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction8(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		IF GETBIT(nUnfair,0)
			CALLF MAKE_STR(V_NAME, "Lake 요정 Crew")
			RETURNF
		ENDIF
		CALLF MAKE_STR(V_NAME, "United Fairies")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "UF")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "요정")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"요정들은 서로 하나로 뭉쳐 있다. 대체로 장난기가 많지만 다른 세력을 괴롭하는 것을 좋아한다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 8
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Leader"
		LOCAL = 14
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

@FACTION_RELATION_STRING8(ARG,ARG:1)
#FUNCTIONS
SELECTCASE FactionFame:ARG:(ARG:1)-FactionInfamy:ARG:(ARG:1)
	CASE IS >= 100000
		FAC_RELATION_STR '= @"요정 %PRINT_MALE("King:Queen",ARG)%"
	CASE IS >= 90000
		FAC_RELATION_STR '= "Ideal Embodiment of 요정 Friendship"
	CASE IS >= 80000
		FAC_RELATION_STR '= @"요정 종족의 영원한 챔피언"
	CASE IS >= 70000
		FAC_RELATION_STR '= @"요정 종족의 위대한 챔피언"
	CASE IS >= 60000
		FAC_RELATION_STR '= @"요정 종족의 챔피언"
	CASE IS >= 50000
		FAC_RELATION_STR '= @"요정 친한 친구"
	CASE IS >= 40000
		FAC_RELATION_STR '= @"슈퍼 울트라 베스트 요정 친구"
	CASE IS >= 30000
		FAC_RELATION_STR '= @"최고의 요정 친구"
	CASE IS >= 20000
		FAC_RELATION_STR '= @"최고의 요정 친구"
	CASE IS >= 10000
		FAC_RELATION_STR '= @"요정 친구"
	CASE IS >= 0
		FAC_RELATION_STR '= @"중립"
	CASE IS >= -10000
		FAC_RELATION_STR '= @"요정들에게 불명예스러운"
	CASE IS >= -20000
		FAC_RELATION_STR '= @"요정 배신자"
	CASE IS >= -30000
		FAC_RELATION_STR '= @"요정 숙적"
	CASE IS >= -40000
		FAC_RELATION_STR '= @"요정들의 큰 적"
	CASEELSE
		FAC_RELATION_STR '= @"요정 종족의 가장 위대하고 끔찍한 적"
ENDSELECT
RETURNF FAC_RELATION_STR

