@EXIST_Faction8
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction8(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	IF GETBIT(nUnfair,0)
	CALLF MAKE_STR(V_NAME, "Lake Fairy Crew")
	RETURNF
	ENDIF
	CALLF MAKE_STR(V_NAME, "United Fairies")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "UF")		
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "fairy")				
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Fairies united as one-another. Generally playful, but love to irritate other factions.")			
CASE "Raider Pool"
	; raider pool
	LOCAL = 8
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 14
	CALLF MAKE_INT(V_NAME, LOCAL)		
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

@FACTION_RELATION_STRING8(ARG,ARG:1)
#FUNCTIONS

SELECTCASE FactionFame:ARG:(ARG:1)-FactionInfamy:ARG:(ARG:1)
CASE IS >= 100000
	FAC_RELATION_STR '= @"Fairy %PRINT_MALE("King:Queen",ARG)%"
CASE IS >= 90000
	FAC_RELATION_STR '= "Ideal Embodiment of Fairy Friendship"		
CASE IS >= 80000
	FAC_RELATION_STR '= @"Eternal Champion of Fairykind"
CASE IS >= 70000
	FAC_RELATION_STR '= @"Great Champion of Fairykind"
CASE IS >= 60000
	FAC_RELATION_STR '= @"Champion of Fairykind"
CASE IS >= 50000
	FAC_RELATION_STR '= @"Fairy BFF"
CASE IS >= 40000
	FAC_RELATION_STR '= @"Super Ultra Best Fairy Friend"
CASE IS >= 30000
	FAC_RELATION_STR '= @"Super Best Fairy Friend"
CASE IS >= 20000
	FAC_RELATION_STR '= @"Best Fairy Friend"
CASE IS >= 10000
	FAC_RELATION_STR '= @"Fairy Friend"
CASE IS >= 0
	FAC_RELATION_STR '= @"Neutral"
CASE IS >= -10000
	FAC_RELATION_STR '= @"Dishonorable to Fairies"
CASE IS >= -20000
	FAC_RELATION_STR '= @"Fairy Betrayer"
CASE IS >= -30000
	FAC_RELATION_STR '= @"Fairy Nemesis"
CASE IS >= -40000
	FAC_RELATION_STR '= @"Great Enemy of Fairykind"
CASEELSE
	FAC_RELATION_STR '= @"Greatest, Most Terrible Enemy of Fairykind"
ENDSELECT
RETURNF FAC_RELATION_STR

