@EXIST_Faction2
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction2(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		IF GETBIT(nUnfair,0)
			CALLF MAKE_STR(V_NAME, "Scarlet Police")
			RETURNF
		ENDIF
		CALLF MAKE_STR(V_NAME, "Scarlet Devils")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "SD")
	CASE "Military"
		CALLF MAKE_STR(V_NAME, "United Fairies - Scarlet Devil Division")
	CASE "MilitaryAbriv"
		CALLF MAKE_STR(V_NAME, "UF/SDM")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "요정 메이드")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"강력한 일행 \"서쪽\" 요괴들 그들의 기지는 유니티 페어리에서 파견된 많은 요정들이 맡고 있는 매우 부유한 저택이다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 2
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Leader"
		LOCAL = 16
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

@FACTION_JOIN_REQURIE_2(C_ID)
#FUNCTION
#DIM C_ID
FactionJoinConditionMessage:0 '= @"관계가 -25000보다 좋다 (현재:{FactionRelationCompElse(C_ID,2)})"
FactionJoinCondition:0 = FactionRelationCompElse(C_ID,2) > -25000
FactionJoinConditionMessage:1 '= @"%GET_MAPNAME(3)%의 거주자가 되어라"
FactionJoinCondition:1 = (MAIN_MAP == 3)

