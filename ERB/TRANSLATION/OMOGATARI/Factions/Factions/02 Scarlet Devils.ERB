@EXIST_Faction2
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction2(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	IF GETBIT(nUnfair,0)
	CALLF MAKE_STR(V_NAME, "Scarlet Police")
	RETURNF
	ENDIF
	CALLF MAKE_STR(V_NAME, "Scarlet Devils")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "SD")	
CASE "Military"
	CALLF MAKE_STR(V_NAME, "United Fairies - Scarlet Devil Division")	
CASE "MilitaryAbriv"
	CALLF MAKE_STR(V_NAME, "UF/SDM")		
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "fairy maid")				
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"A group of powerful \"western\" youkai. Their base is a very wealthy mansion entrusted with many fairies deployed from United Fairies.")			
CASE "Raider Pool"
	; raider pool
	LOCAL = 2
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 16
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

