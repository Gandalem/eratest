@EXIST_Faction23
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction23(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "Free Tanuki")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "TANU")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "너구리")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"조종적이고 술을 많이 마시는 타누키는 요정들의 좀 더 진지한 버전 같다. 근접 무기에 특화되어 있다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 12
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Leader"
		LOCAL = 69
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

