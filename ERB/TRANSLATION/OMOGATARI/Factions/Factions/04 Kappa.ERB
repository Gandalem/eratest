@EXIST_Faction4
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction4(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "Youkai Mountain Kappa")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "YMK")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "카파")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"산업 및 중간 세계의 기술을 근거료로 긴요에 들여오는 것으로 알려진 해양 이족 보행 괴수들. 그들은 요괴 산 카प्पा 병기점에서 자체적으로 제조한 외부 장비 복제품으로 부하들을 무장시킬 만큼 부유하다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 4
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Leader"
		LOCAL = 51
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

@FACTION_INIT4
FactionTech:4 = 8
FactionWealth:4 = 80000000
FactionUnits:4:1 = 15000
FactionUnits:4:2 = 80000
FactionUnits:4:3 = 2500
FactionUnits:4:4 = 100
FactionUnits:4:5 = 15
FactionUnits:4:6 = 1
FOR LOCAL,0,20
; SIF GROUPMATCH(LOCAL,5,10,11)
; 	CONTINUE
SETBIT FactionPatrolArea:4, LOCAL
NEXT

@FACTION_JOIN_REQURIE_4(C_ID)
#FUNCTION
#DIM C_ID
FactionJoinConditionMessage:0 '= @"관계가 -25000보다 좋음 (현재: {FactionRelationCompElse(C_ID,3)})"
FactionJoinCondition:0 = FactionRelationCompElse(C_ID,3) > -25000
FactionJoinConditionMessage:1 '= @"B 지식 (현재:{ABL:C_ID:43})"
FactionJoinCondition:1 = ABL:C_ID:43 >= UniversalRank("B")
FactionJoinConditionMessage:2 '= @"%AllTechLevels(5)% 기술 지식 (현재: %AllTechLevels(TALENT:C_ID:TechKnow)%)"
FactionJoinCondition:2 = TALENT:C_ID:TechKnow >= 5

