
@EXIST_Faction4
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction4(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "Youkai Mountain Kappa")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "YMK")
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "kappa")
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Aqautic bipedal beasts known for importing Industrial and Midworld technology to Gensokyo. They're wealthy enough to outfit their men with their own manufactured reproductions of Outside equipment, manufactured in the Youkai Mountain Kappa Armory.")
CASE "Raider Pool"
	; raider pool
	LOCAL = 4
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 51
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

@FACTION_INIT4
FactionTech:4 = 8
FactionWealth:4 = 80000000

FactionUnits:4:1 = 15000
FactionUnits:4:2 = 80000
FactionUnits:4:3 = 2500
FactionUnits:4:4 = 100
FactionUnits:4:5 = 15
FactionUnits:4:6 = 1

FOR LOCAL,0,20
	; SIF GROUPMATCH(LOCAL,5,10,11)
	; 	CONTINUE
SETBIT FactionPatrolArea:4, LOCAL
NEXT

@FACTION_JOIN_REQURIE_4(C_ID)
#FUNCTION
#DIM C_ID
FactionJoinConditionMessage:0 '= @"Relations better than -25000 (Current: {FactionRelationCompElse(C_ID,3)})"
FactionJoinCondition:0 = FactionRelationCompElse(C_ID,3) > -25000

FactionJoinConditionMessage:1 '= @"B Knowledge (Current:{ABL:C_ID:43})"
FactionJoinCondition:1 = ABL:C_ID:43 >= UniversalRank("B")

FactionJoinConditionMessage:2 '= @"%AllTechLevels(5)% Technical Knowledge (Current: %AllTechLevels(TALENT:C_ID:TechKnow)%)"
FactionJoinCondition:2 = TALENT:C_ID:TechKnow >= 5

