; Modular ERB: OMOGATARI/Factions/Factions/24 Haniwa Army Corps.ERB

@EXIST_Faction24
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction24(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "Haniwa Army Corps")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "HAC")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "하니와")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"하니와는 테라코타로 만들어진 일본의 토기 인형이다. %NAME:132%에 의해 제작되었으며, 병사로서 매우 내구성이 있어 아프거나 지칠 수 없기에 인간 영혼들의 노동력을 완전히 대체했다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 24
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Leader"
		LOCAL = 132
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

