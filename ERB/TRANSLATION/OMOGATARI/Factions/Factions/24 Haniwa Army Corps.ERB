 
@EXIST_Faction24
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction24(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "Haniwa Army Corps")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "HAC")	
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "haniwa")				
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Haniwa are Japanese clay figures made of Terrakotta. Created by %NAME:132%, they've replaced the workforce of human spirits entirely since they are very durable as crafted soldiers, being unable to grow sick or tired.")
CASE "Raider Pool"
	; raider pool
	LOCAL = 24
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 132
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

