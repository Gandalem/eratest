; Modular ERB: OMOGATARI/Factions/Factions/13 United Nations.ERB

@EXIST_Faction13
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction13(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "United Nations")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "UN")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "평화 유지군")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"국제 연합(UN)은 국제 평화와 안보를 유지하고, 국가 간의 우호적인 관계를 발전시키며, 국제 협력을 달성하고, 국가들의 행동을 조화시키는 중심이 되는 것을 명시된 목적으로 하는 정부 간 기구이다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Outsider"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT
