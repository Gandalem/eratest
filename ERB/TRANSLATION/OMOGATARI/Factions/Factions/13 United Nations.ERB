@EXIST_Faction13
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction13(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "United Nations")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "UN")		
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "peacekeeper")				
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"The United Nations (UN) is an intergovernmental organization whose stated purposes are to maintain international peace and security, develop friendly relations among nations, achieve international cooperation, and be a centre for harmonizing the actions of nations.")			
CASE "Raider Pool"
	; raider pool
	LOCAL = 0
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Outsider"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT