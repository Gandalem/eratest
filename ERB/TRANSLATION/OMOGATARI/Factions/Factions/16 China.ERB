@EXIST_Faction16
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction16(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "People's Republic of China")
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "PRC")		
CASE "Military"
	CALLF MAKE_STR(V_NAME, "People's Liberation Army")
CASE "MilitaryAbriv"
	CALLF MAKE_STR(V_NAME, "PLA")
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "soldier")				
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Joins the reverse revolution in taking over Japan")			
CASE "Outsider"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Raider Pool"
	; raider pool
	LOCAL = 0
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT