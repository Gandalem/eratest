; Modular ERB: OMOGATARI/Factions/Factions/26 New World Order.ERB
; - Vigilantes description is a total BS, as they're raping captured 2hus every turn, lol. Nothing special, pretty much like bandits, but they can't make an ambush on the global map;

@EXIST_Faction26
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction26(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "New World Order")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "NWO")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "멤버")
	CASE "Desc"
		LOCALS '= "The New World Order (NWO) is a conspiracy theory that hypothesizes a secretly emerging totalitarian world government.\n"
		LOCALS += "The common theme in conspiracy theories about a New World Order is that a secretive power elite with a globalist agenda is conspiring to eventually achieve world domination and rule the world through an authoritarian one-world government—which will replace sovereign nation-states—and an all-encompassing propaganda whose ideology hails the establishment of the New World Order as the culmination of history's progress.\n"
		LOCALS += "They persuade their captives rather than raping them.\n"
		LOCALS += "They have general-purpose skills instead of a faction specific skill.\n"
		LOCALS += "They have a strong economy, and easily expand."
		CALLF MAKE_STR(V_NAME, LOCALS)
	CASE "Raider Pool"
		; raider pool
		LOCAL = 26
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

@FACTION_INIT26
FactionTech:26 = 8
FactionWealth:26 = 300000000
FactionUnits:26:1 = 10000000
FactionUnits:26:2 = 5000000
FactionUnits:26:3 = 300000
FactionUnits:26:4 = 2000
FactionUnits:26:5 = 50
FactionUnits:26:6 = 1
FOR LOCAL,0,64
SETBIT FactionPatrolArea:26, LOCAL
NEXT
FOR LOCAL,0,MAXFACTIONS
IF !GROUPMATCH(LOCAL,26)
	FactionTeamInfamy:26:LOCAL = 100000
	;FactionTeamInfamy:LOCAL:26 = 100000
ENDIF
NEXT

