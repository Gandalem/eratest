; `Outsiders`

; They don't have strong officers.
; But their skill is ultra-powerful - it forces your army's stats to be weaker than theirs.
; They break down captives using technology and sexual experiments.


@EXIST_Faction19
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction19(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "Antima")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "ANTIMA")	
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "Member")
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Anti Magic Action.")
CASE "Raider Pool"
	; raider pool
	LOCAL = 12
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

