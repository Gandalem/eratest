@EXIST_Faction22
#LOCALSIZE 1
#LOCALSSIZE 1

;Gouyoku Alliance (Yuuma, Chiyari): aerial warfare
@Faction22(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "Gouyoku Alliance")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "GA")	
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "Member")
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"aerial warfare")
CASE "Raider Pool"
	; raider pool
	LOCAL = 22
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

