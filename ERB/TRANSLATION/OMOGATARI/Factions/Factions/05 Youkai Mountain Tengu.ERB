@FACTION_APPLYING_5
#DIM     PAGE       ;表示中のページ
;
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
RESETCOLOR
DRAWLINE
;CALL SET_KOJO_COLOR(142)
PRINTFORMDL Youkai Mountain Tengu
PRINTFORMDL New Recruitment Application Form
DRAWLINE

TRYCALLFORM FACTION_APPLYING_5_INTRO
DRAWLINE
PRINTL
PRINTBUTTON "[9998] Submit Form ", 9998
DO
	INPUT
	SELECTCASE RESULT
	; CASE 8002 TO VARSIZE("DISP_NAME")+8002
	; 	PAGE = RESULT-8002
    CASE 9998
        ;Results
        IF !FactionApplyVars
            PRINTFORMW All required questions are not filled out!
            GOTO REPRINT
        ENDIF
        PRINTFORMDL RELEASE OF INFORMATION
        DRAWLINE
        PRINTFORMDL I authorize my employer(s) to release information to, and if necessary, speak with the Youkai Mountain Tengu Supervisors about my application as listed above for the purpose of determining whether I should be hired..
        PRINTFORMDL Do you want to submit this form to your employer?
        CALL ASK_YN()
        SIF RESULT
            CONTINUE
        FactionDivision:MASTER:5 = FactionApplyVars
        RETURN 1
	CASEELSE
		$RETRY
		TRYCALLFORM FACTION_APPLYING_5_RESULT(RESULT)
	ENDSELECT
	BREAK
LOOP 1
GOTO REPRINT

@FACTION_APPLYING_5_INTRO
#DIM nHome
nHome = CFLAG:MASTER:311
PRINTFORML Thank you for your interest in the Youkai Mountain Tengu. 
PRINTL
PRINTFORMDL %BREAKENG("All YMT applicants will be subject to a background check to ensure they are mentally stable and are not affiliated with our enemies.")%
PRINTFORMDL %BREAKENG("Failure fill out this form properly will result in automatic denial of your application.")%
PRINTFORMDL %BREAKENG(@"Persons affiliated with %FactionName(8)% or the %FactionName(12)%, or have significant infamy with YMT will be automatically denied.")%
PRINTDL
PRINTL
SETCOLOR C_YELLOW
PRINTFORML Personal Data
RESETCOLOR
PRINTFORMDL Date: %PRINT_DATE_F(DAY,1)%
PRINTFORMDL Name of applicant: %NAME:MASTER%
PRINTFORMDL Home Address: {nHome} %STR_TR(nHome+8000)%, %GET_MAPNAME(nHome/100)%, Gensokyo, Japan
DRAWLINE
SETCOLOR C_YELLOW
PRINTFORML Background Information
RESETCOLOR
PRINTFORML Do you have the legal right to work in Gensokyo? Yes ☒ No ☐
; PRINTFORML Are you over 18 years old? Yes ☒ No ☐
; PRINTFORML (Under-18 Applicants )
PRINTFORML Have you ever worked for YMT before? Yes ☐ No ☒
PRINTFORML Are you willing to relocate? Yes ☐ No ☒
PRINTFORML Do you have any friend who have worked for or are working for YMT? Yes ☐ No ☒
PRINTFORML If yes, list name(s):
DRAWLINE
SETCOLOR C_YELLOW
PRINTFORML Job Functions
RESETCOLOR
PRINTFORMDL %BREAKENG("All YMT applicants will be subject to filling out an EAc Accomodations Form upon being hired.")%
PRINTFORMDL Applying for: Just any position
PRINTFORMD Department applying for: 
SELECTCASE FactionApplyVars
CASE 1
    PRINTFORMDL Youkai Mountain Defense Force (MDF)
CASE 2
    PRINTFORMDL Planck Internet Services (Planck)
CASE 3
    PRINTFORMDL Gensokyo Department of Transportation (DOT)
CASEELSE
    PRINTFORMDL Unspecified
ENDSELECT
DRAWLINE
PRINTFORML Select a division to apply for:
PRINTFORML [1001] - Youkai Mountain Defense Force (White Wolf)
PRINTFORML [1002] - Planck Internet Services (Crow Tengu)
PRINTFORML [1003] - Gensokyo Department of Transportation (Yamabushi Tengu)

@FACTION_APPLYING_5_RESULT(ARG)
SELECTCASE ARG
CASE IS >= 1000
    FactionApplyVars = ARG-1000
ENDSELECT

@FACTION_APPLYING_5_ACCEPT
#DIM nHome
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
nHome = CFLAG:MASTER:311
PRINTFORML %PRINT_DATE_F(DAY,1)%
PRINTL
PRINTFORML %PRINT_MALE("Mr.",MASTER)% %NAME:140%
PRINTFORML {nHome} %STR_TR(nHome+8000)%
PRINTFORML %GET_MAPNAME(nHome/100)%, Gensokyo, Japan
PRINTL
PRINTFORML Dear %NAME:MASTER%,
PRINTL
PRINTFORML After a through review and background check, we have found you suitable for the position of %FACTION_RANK_STRING(MASTER,5)%.
PRINTFORML We are pleased to accept the offer and and look forward for your employment on %PRINT_DATE_F(DAY,1)%
PRINTL

PRINTFORML Your starting salary will be %金額表示(FACTION_SALARY(5,FactionRank:MASTER:5))% a day with the full range of benefits and accommodations all Youkai Mountain Tengu members have. Attached is the Mountain Defense Force Emergency Accommodations Act form (EAc), which must be filled out before you are able to work with us.
PRINTL
PRINTFORML Thank you again for giving us a wonderful opportunity, and welcome to the Youkai Mountain Tengu.
PRINTL
PRINTFORML Sincerely,
PRINTFORML %PRINT_MALE("Mr.",140)% %NAME:140%
PRINTFORML Chief of the Crow Tengu
WAIT
