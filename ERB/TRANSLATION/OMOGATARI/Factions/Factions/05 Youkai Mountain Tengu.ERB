@EXIST_Faction5
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction5(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "Youkai Mountain Tengu")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "YMT")	
CASE "Military"
	CALLF MAKE_STR(V_NAME, "Mountain Defense Force")	
CASE "MilitaryAbriv"
	CALLF MAKE_STR(V_NAME, "MDF")			
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "tengu")				
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Tengu rising up from the mountain summit. They operate a multi-division faction called the Youkai Mountain Tengu which covers military, surveillance, and construction.")
CASE "Raider Pool"
	; raider pool
	LOCAL = 5
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 140
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

@FACTION_RANK_STRING5(ARG,ARG:1)
#FUNCTIONS
SELECTCASE ARG
CASE 6
	FAC_RANK_STR '= @"Boss"
CASE 5
	FAC_RANK_STR '= "Great Tengu"
CASE 4
	FAC_RANK_STR '= "Jr. Great Tengu"
CASE 1 TO 3
    SELECTCASE ARG
    CASE 1
        FAC_RANK_STR '= "Jr. "
    CASE 2
        FAC_RANK_STR '= ""
    CASE 3
        FAC_RANK_STR '= "Sr. "
    ENDSELECT
    SELECTCASE ARG:1
    CASE 0
        FAC_RANK_STR += "Tengu"
    CASE 1
        FAC_RANK_STR += "White Wolf"
    CASE 2
        FAC_RANK_STR += "Crow Tengu"
    CASE 3
        FAC_RANK_STR += "Long-nose Tengu"
    CASE 4
        FAC_RANK_STR += "Yamabushi Tengu"
    ENDSELECT
CASE 0
	FAC_RANK_STR '= @""
ENDSELECT

RETURNF FAC_RANK_STR

