;オブジェクト本体
@Faction11(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "PnL Logisitcs")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "PnL")
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "paniel")
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Outside-world automation company who migrated into Gensokyo. Robots of theirs roam around everywhere, helping workers in the human village.")
CASE "Raider Pool"
	; raider pool
	LOCAL = 11
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

