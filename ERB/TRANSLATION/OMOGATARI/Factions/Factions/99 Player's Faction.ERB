; Modular ERB: OMOGATARI/Factions/Factions/99 Player's Faction.ERB

@EXIST_Faction99
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction99(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "Player's Faction")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "PLAYER")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "멤버")
	CASE "Leader"
		CALLF MAKE_INT(V_NAME, PlayersFactionLeader)
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"%NAME:PlayersFactionLeader%이 만든 커스텀 진영.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 99
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT
