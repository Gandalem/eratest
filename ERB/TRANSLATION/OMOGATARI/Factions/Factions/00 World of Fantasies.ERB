@EXIST_Faction0
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction0(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	IF GETBIT(nUnfair,3)
		CALLF MAKE_STR(V_NAME, "State of Ohio")	
	ELSE
		CALLF MAKE_STR(V_NAME, "World of Fantasies")	
	ENDIF
CASE "Abriv"
	IF GETBIT(nUnfair,3)
		CALLF MAKE_STR(V_NAME, "OH")	
	ELSE
		CALLF MAKE_STR(V_NAME, "WoF")	
	ENDIF
CASE "Military"
	CALLF MAKE_STR(V_NAME, "Anti-Incident Advisory")	
CASE "MilitaryAbriv"
	CALLF MAKE_STR(V_NAME, "AIA")		
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "AIA agent")				
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Gensokyo under current leadership of %NAME:26% and %NAME:1%. Sealed off during the 1880s, Gensokyo has been severely starved of technology. Soldiers mainly use magic, while wearing heavy armor designed for spiritual attacks such as Youjutsu and Danmaku")			
CASE "Raider Pool"
	; raider pool
	LOCAL = 0
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 26
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

