FactionJoinConditionMessage:1 '= "Be of Gensokyan descent"
FactionJoinCondition:1 = (TALENT:C_ID:人間 != 6)

FactionJoinConditionMessage:2 '= "Be a human (not a Makai nor Lunarian)"
FactionJoinCondition:2 = !IS_NONHUMAN(C_ID)


