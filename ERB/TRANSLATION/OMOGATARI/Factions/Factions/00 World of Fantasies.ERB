; Modular ERB: OMOGATARI/Factions/Factions/00 World of Fantasies.ERB

@EXIST_Faction0
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction0(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		IF GETBIT(nUnfair,3)
			CALLF MAKE_STR(V_NAME, "State of Ohio")
		ELSE
			CALLF MAKE_STR(V_NAME, "World of Fantasies")
		ENDIF
	CASE "Abriv"
		IF GETBIT(nUnfair,3)
			CALLF MAKE_STR(V_NAME, "OH")
		ELSE
			CALLF MAKE_STR(V_NAME, "WoF")
		ENDIF
	CASE "Military"
		CALLF MAKE_STR(V_NAME, "Anti-Incident Advisory")
	CASE "MilitaryAbriv"
		CALLF MAKE_STR(V_NAME, "AIA")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "AIA 에이전트")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"%NAME:26%와 %NAME:1%의 현재 지도 아래 있는 이상향은 1880년대에 봉쇄된 이후 기술이 심각하게 부족했다. 병사들은 주로 주술이나 단막과 같은 영적 공격을 위해 설계된 중장갑을 입고 마법을 사용한다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Leader"
		LOCAL = 26
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

