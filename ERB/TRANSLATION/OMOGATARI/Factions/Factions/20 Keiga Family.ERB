; Modular ERB: OMOGATARI/Factions/Factions/20 Keiga Family.ERB

@EXIST_Faction20
#LOCALSIZE 1
#LOCALSSIZE 1
;Keiga Family (Saki, Enoko): strength and brute force

@Faction20(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "Keiga Family")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "게이가")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "멤버")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"힘과 무력")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 20
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

@FACTION_INIT20
FactionTech:20 = 8
FactionWealth:20 = 400000000
FactionUnits:20:1 = 15000
FactionUnits:20:2 = 40000
FactionUnits:20:3 = 10000
FactionUnits:20:4 = 500
FactionUnits:20:5 = 10
FactionUnits:20:6 = 1
SETBIT FactionPatrolArea:20, 6
FactionTeamInfamy:20:21 = 50000
FactionTeamInfamy:20:22 = 50000
FactionTeamInfamy:20:24 = 100000
;keiga

@RaiderPool_20
#DIM nRoll
#DIM nEnemy
#DIM nCost
#DIMS CONST FactionPool = "56"
#DIMS CONST FactionCost = "150"
nRoll = RAND(0,VARSIZE("FactionPool"))
nEnemy = TOINT(FactionPool:nRoll)
RESULT:1 = TOINT(FactionCost:nRoll)
RETURN nEnemy

