@EXIST_Faction21
#LOCALSIZE 1
#LOCALSSIZE 1

;Kiketsu Family (Yachie, Biten): underhanded attacks from the shadows,
@Faction21(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "Kiketsu Family")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "KikeF")	
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "Member")
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"underhanded attacks from the shadows,")
CASE "Raider Pool"
	; raider pool
	LOCAL = 21
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

