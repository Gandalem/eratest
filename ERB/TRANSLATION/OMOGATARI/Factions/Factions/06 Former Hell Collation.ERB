@EXIST_Faction6
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction6(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "Former Hell Collation")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "FHC")
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "oni")
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"A organization made when Hell shattered into the former underworld. They control the former Hell and keep the place safe.")
CASE "Raider Pool"
	; raider pool
	LOCAL = 6
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 49
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

