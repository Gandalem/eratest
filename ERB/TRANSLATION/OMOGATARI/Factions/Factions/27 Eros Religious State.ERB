; Modular ERB: OMOGATARI/Factions/Factions/27 Eros Religious State.ERB
; `Succubi`
; Their special skill disables enemy officers in battle.
; The chance of this skill triggering increases with their difficulty level.
; This means strength 5 succubi are especially powerful.
; Succubi break down their captives with futanari rape.
; These are especially nasty because they can still crush you even if you're fully prepared.
; Destroy them with overwhelming numbers.

@EXIST_Faction27
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction27(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "Eros Religious State")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "EROS")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "서큐버스")
	CASE "Desc"
		LOCALS '= "The Eros Religious State is mainly composed of... succubi.\nThey rape their captives, drowning them in pleasure to break their will, giving [Lewd X] in process.\n"
		CALLF MAKE_STR(V_NAME, LOCALS)
	CASE "Raider Pool"
		; raider pool
		LOCAL = 27
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

@FACTION_INIT27
FactionTech:27 = 3
FactionWealth:27 = 5000000
FactionUnits:27:1 = 500000
FactionUnits:27:2 = 5000000
FactionUnits:27:3 = 50000
FactionNonMemberInfamy:12 = 100000
FOR LOCAL,0,64
SETBIT FactionPatrolArea:27, LOCAL
NEXT
FOR LOCAL,0,MAXFACTIONS
IF !GROUPMATCH(LOCAL,27)
	FactionTeamInfamy:27:LOCAL = 100000
	;FactionTeamInfamy:LOCAL:27 = 100000
ENDIF
NEXT

