@FACTION_JOIN_REQURIE_7(C_ID)
#FUNCTION
#DIM C_ID
FactionJoinConditionMessage:0 '= @"%FactionAbriv(0)% 및 %FactionAbriv(9)%와 무관함"
FactionJoinCondition:0 = !FactionRank:C_ID:0 && !FactionRank:C_ID:9
IF nPee || nScat
	FactionJoinConditionMessage:1 '= @"유효 포티 레벨이 0보다 크다 (현재: {EffectivePottyLevel(C_ID)})"
	FactionJoinCondition:1 = EffectivePottyLevel(C_ID) > 0
ENDIF
FactionJoinConditionMessage:2 '= @"%AllTechLevels(6)% 기술 지식 (현재: %AllTechLevels(TALENT:C_ID:TechKnow)% )"
FactionJoinCondition:2 = TALENT:C_ID:TechKnow >= 6

