@FACTION_JOIN_REQURIE_7(C_ID)
#FUNCTION
#DIM C_ID
FactionJoinConditionMessage:0 '= @"Unaffiliated with %FactionAbriv(0)% and %FactionAbriv(9)%"
FactionJoinCondition:0 = !FactionRank:C_ID:0 && !FactionRank:C_ID:9

IF nPee || nScat
FactionJoinConditionMessage:1 '= @"Effecitve Potty Level greater than 0 (Current: {EffectivePottyLevel(C_ID)})"
FactionJoinCondition:1 = EffectivePottyLevel(C_ID) > 0
ENDIF

FactionJoinConditionMessage:2 '= @"%AllTechLevels(6)% Technical Knowledge (Current: %AllTechLevels(TALENT:C_ID:TechKnow)%)"
FactionJoinCondition:2 = TALENT:C_ID:TechKnow >= 6


