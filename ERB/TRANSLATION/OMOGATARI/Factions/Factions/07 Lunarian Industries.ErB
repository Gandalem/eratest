; Modular ERB: OMOGATARI/Factions/Factions/07 Lunarian Industries.ErB

@EXIST_Faction7
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction7(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		IF GETBIT(nUnfair,3)
			CALLF MAKE_STR(V_NAME, "State of Michigan")
		ELSE
			CALLF MAKE_STR(V_NAME, "Lunar Capital")
		ENDIF
	CASE "Abriv"
		IF GETBIT(nUnfair,3)
			CALLF MAKE_STR(V_NAME, "MI")
		ELSE
			CALLF MAKE_STR(V_NAME, "LUNC")
		ENDIF
	CASE "Military"
		CALLF MAKE_STR(V_NAME, "Lunarian Defense Corps")
	CASE "MilitaryAbriv"
		CALLF MAKE_STR(V_NAME, "LDC")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "루나리안")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"루나리안은 달에 사는 존재들이다. 여러 전쟁을 치렀던 덕분에 그들의 기술 수준은 대부분의 센소키아 파벌보다 훨씬 높고 세이호 사양 기술과 동등하지만 마카이에는 미치지 못한다. 루나리안 수도는 자체적인 군대를 보유하고 있지는 않지만 '루나리안 방위대'라는 자위대 같은 조직을 가지고 있다. 대부분의 물건은 국유 기업인 루나리안 인더스트리즈 코퍼레이션(LUNINCO)에서 제조한다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 7
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Leader"
		LOCAL = 98
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT
