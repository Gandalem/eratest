@EXIST_Faction7
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction7(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	IF GETBIT(nUnfair,3)
		CALLF MAKE_STR(V_NAME, "State of Michigan")	
	ELSE
		CALLF MAKE_STR(V_NAME, "Lunar Capital")
	ENDIF
CASE "Abriv"
	IF GETBIT(nUnfair,3)
		CALLF MAKE_STR(V_NAME, "MI")	
	ELSE
		CALLF MAKE_STR(V_NAME, "LUNC")	
	ENDIF
CASE "Military"
	CALLF MAKE_STR(V_NAME, "Lunarian Defense Corps")	
CASE "MilitaryAbriv"
	CALLF MAKE_STR(V_NAME, "LDC")		
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "lunarian")				
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"Lunarians are those who live in the moon. Due them having been in multiple wars, their technological level is way above most Gensokyan factions and is on par with Seihou-spec technology, but still falls short of Makai. The Lunar Capital does not have their own military per se, but rather a self-defense force called the Lunar Defense Corps. Most objects are manufactured by the state-owned Lunarian Industries Corporation (LUNINCO).")
CASE "Raider Pool"
	; raider pool
	LOCAL = 7
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 98
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

