@EXIST_Faction10
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction10(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "Reverse Revolution")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "яR")	
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "revolutionary")				
CASE "Desc"
	SELECTCASE CharaQuestline:97:0:0
	CASE 0
	LOCALS '= @"Hated by everyone, driven to the ground by everyone, constantly being compared to the T-NC. %NAME:97%, however is still fighting and trying for recruits."
	CASE 1
	LOCALS '= @"With the funding they required being gifted to them in a silver platter, the Reverse Revolution is ready to start-up once more."
	CASE 3
	LOCALS '= @"An outsider has managed to convince several youkai from other factions to their cause. With several powerful recruits, they can easily take over bases, but are still vulnerable to a shrine maiden." 
	ENDSELECT
	CALLF MAKE_STR(V_NAME, @"Group of youkai rejects and humans tired of the current system of Gensokyo. %LOCALS%")
CASE "Raider Pool"
	; raider pool
	LOCAL = 10
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 97
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT


