; Modular ERB: OMOGATARI/Factions/Factions/10 Reverse Revolution.ERB

@EXIST_Faction10
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction10(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "Reverse Revolution")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "яR")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "혁명가")
	CASE "Desc"
		SELECTCASE CharaQuestline:97:0:0
			CASE 0
				LOCALS '= @"모두에게 미움받고, 모든 사람에 의해 바닥까지 몰렸지만, %NAME:97%는 여전히 싸우고 신규 영입을 위해 노력한다."
			CASE 1
				LOCALS '= @"그들이 필요로 했던 자금이 은쟁반에 담겨 선물되자 역혁명은 다시 시작할 준비를 마쳤다."
			CASE 3
				LOCALS '= @"외부인이 다른 파벌의 요괴 몇몇을 자신들의 대의에 동조하도록 설득하는 데 성공했다. 강력한 신규 영입자들을 보유하고 있어 기지를 쉽게 점령할 수 있지만, 여전히 신사 마이드는 취약하다."
		ENDSELECT
		CALLF MAKE_STR(V_NAME, @"요괴 무리와 인간들이 근래의 환상향 시스템에 염증을 느낀다. %LOCALS%")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 10
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Leader"
		LOCAL = 97
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT
