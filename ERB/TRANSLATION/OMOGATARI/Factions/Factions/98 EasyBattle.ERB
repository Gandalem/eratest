; Modular ERB: OMOGATARI/Factions/Factions/98 EasyBattle.ERB

@EXIST_Faction98
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Faction98(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "EasyBattle")
	CASE "Abriv"
		CALLF MAKE_STR(V_NAME, "EZB")
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, "EZB 조직가")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"이지배틀 관계자들. 그들은 이지배틀을 운영한다.")
	CASE "Raider Pool"
		; raider pool
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Leader"
		LOCAL = 64
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Factions」")
ENDSELECT

@FACTION_INIT98
FactionTech:98 = 11
FactionWealth:98 = 2500000
FactionUnits:98:1 = 1
FactionUnits:98:2 = 4000
FactionUnits:98:3 = 2500
FactionUnits:98:4 = 100
FactionUnits:98:5 = 1
FactionUnits:98:6 = 1
FOR LOCAL,0,10
SETBIT FactionPatrolArea:98, LOCAL
NEXT

@FACTION_UNIT_QUIRK_98(ARG)
TALENT:ARG:DirgeofDecay = 1

@FACTION_JOIN_REQURIE_98(C_ID)
#FUNCTION
#DIM C_ID
FactionJoinConditionMessage:0 '= @"관계가 -25000보다 좋다 (현재:{FactionRelationCompElse(C_ID,0)})"
FactionJoinCondition:0 = FactionRelationCompElse(C_ID,98) > -25000
