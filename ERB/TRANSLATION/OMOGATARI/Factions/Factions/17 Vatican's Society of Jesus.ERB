; `Cultists`

; Similar to the Outsiders.
; Their special skill has a high chance of triggering and grants temporary magic.
; They appear near the Moriya shrine, which is economically poor.
; They break down their captives with gangbangs and impregnation.

@EXIST_Faction17
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Faction17(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "Name"
	CALLF MAKE_STR(V_NAME, "Vatican's Society of Jesus")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "JESUIT")	
CASE "Unit"
	CALLF MAKE_STR(V_NAME, "jesuit")
CASE "Desc"
	CALLF MAKE_STR(V_NAME, @"JESUIT is a Roman Catholic organization, and sees their interest to kill demons and Youkai because they are naturally evil and are an abomination before God. JESUIT has a sacred duty to do battle with the 4,439,622 demons of hell, including the Youkai in Gensokyo.")
CASE "Raider Pool"
	; raider pool
	LOCAL = 17
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Leader"
	LOCAL = 176
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Factions」")	
ENDSELECT

