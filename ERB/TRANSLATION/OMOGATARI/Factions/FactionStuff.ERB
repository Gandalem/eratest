@FactionEnemySpawn(nFaction,raidPoints,isRaider=0,nSide = 1)
#DIM nFaction
#DIM nEnemy
#DIM isRaider
#DIM DYNAMIC FES_ENEMIES,100
#DIM FES_COUNT
#DIM FES_RANK
#DIM nSide
#DIM REF raidPoints
#DIMS FES_FILTERS
#DIM DYNAMIC nCurrentChara
VARSET FES_ENEMIES
VARSET FactionRaidRankSpawn
FES_FILTERS '= @"faction = {nFaction}、"
$LOOP
FES_COUNT = DT_SELECT("FactionUnits", LIST_IN_STRING(FES_FILTERS,," and"," and"), "", FES_ENEMIES)
SIF !FES_COUNT
	RETURN
nEnemy = RAND(0,FES_COUNT)
FES_RANK = DT_CELL_GET("FactionUnits", FES_ENEMIES:nEnemy, "rank", 1)
SIF !FES_RANK
	FES_RANK = 2
;if this unit will get them into the negatives
IF FactionUnits:nFaction:FES_RANK - (FactionRaidRankSpawn:FES_RANK+1) < 0
	FES_FILTERS += @"rank <> {FES_RANK}、"
	GOTO LOOP
ELSE
	FactionRaidRankSpawn:FES_RANK ++
ENDIF
raidPoints -= (RaidPointCost(FES_ENEMIES:nEnemy))
nCurrentChara = FREE_MOB_SLOT()
CALL SpawnMobEnemy(nCurrentChara,FES_ENEMIES:nEnemy)
;PRINTFORML Spawned %NAME:FREE_MOB_SLOT(1)%, a %TempMobName:0%.
SIF !FactionRank:(nCurrentChara):nFaction
	FactionRank:(nCurrentChara):nFaction = 1
SIF isRaider
	CALLF AddCombatant(nCurrentChara,nSide)
; PRINTFORMW {nCurrentChara} %CALLNAME:nCurrentChara% | FACTION {nFaction} | SIDE {nSide}
RETURN nCurrentChara

@FACTION_VISITORS_CONTROL
SIF GET_MAPID(CFLAG:MASTER:300) != MAIN_MAP
	RETURN
SIF !nFactions || SaveIsEZB
	RETURN
SIF nFactionPatrolChanceMultiplier == 0
	RETURN
SIF nFactionPatrol == 0
	RETURN
SIF !SHIRAHU(MASTER) || inTrain != 1
	RETURN
FOR LOCAL,0,MAXFactions
SIF !FactionExist(LOCAL)
	CONTINUE
SIF !GETBIT(FactionPatrolArea:LOCAL,MAIN_MAP) && FactionMainArea:MAIN_MAP != LOCAL
	CONTINUE
IF FactionMainArea:MAIN_MAP >= 0
	SIF FactionTeamRelation(LOCAL,FactionMainArea:MAIN_MAP) < -50000
		CONTINUE
ENDIF
SIF RAND:(MAX(1,(NASCheat:4 ? 15 # 90)*100/nFactionPatrolChanceMultiplier))
	CONTINUE
CALL FactionVisting(LOCAL)
NEXT

