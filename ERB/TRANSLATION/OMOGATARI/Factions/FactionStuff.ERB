@AfterDayFactionStuff
#DIM ADFS_AREA
#DIM ADFS_FACTION
#DIM ADFS_TARGET
;factions enabled
SIF !nFactions
	RETURN
;Passive Infamy Loss
FOR ADFS_FACTION,0,MAXFactions
SIF !FactionExist(ADFS_FACTION)
	CONTINUE
FOR LOCAL,0,CHARANUM
SIF !FactionInfamy:LOCAL:ADFS_FACTION
	CONTINUE
SKIPDISP LOCAL != MASTER
CALL AddInfamy(LOCAL,ADFS_FACTION,-RAND(1,500))
SKIPDISP 0
NEXT
NEXT
SKIPDISP 0
FOR ADFS_FACTION,0,MAXFactions
SIF !FactionExist(ADFS_FACTION)
	CONTINUE
IF STRLENS(FactionResearching:ADFS_FACTION)
	;research project
	CALL CONTRIBUTE_RESEARCH_PROJECT(ADFS_FACTION,RAND(25,250))
ELSE
	;target researcch
	CALL FISHER_YATES_SHAFFLE(DT_ROW_LENGTH("ResearchProject"))
	FOR ADFS_TARGET,0,DT_ROW_LENGTH("ResearchProject")
	SIF RESEARCH_DONE(ADFS_FACTION,DT_CELL_GETS("ResearchProject", SHAFFLE_ARRAY:ADFS_TARGET, "defName"))
		CONTINUE
	SIF TechLevelStrToInt(DT_CELL_GETS("ResearchProject", SHAFFLE_ARRAY:ADFS_TARGET, "techLevel")) > nMaxTech
		CONTINUE
	IF RESEARCH_PRERECS_DONE(ADFS_FACTION,DT_CELL_GETS("ResearchProject", SHAFFLE_ARRAY:ADFS_TARGET, "defName"))
		CALLF START_RESEARCH_PROJECT(ADFS_FACTION,DT_CELL_GETS("ResearchProject", SHAFFLE_ARRAY:ADFS_TARGET, "defName"))
		PRINTFORML %FactionName(ADFS_FACTION)%이(가) %DT_CELL_GETS("ResearchProject", SHAFFLE_ARRAY:ADFS_TARGET, "label")%에 대한 연구를 시작했다.
		SIF !benchMarkStart
			WAIT
		BREAK
	ENDIF
	NEXT
ENDIF
NEXT
;Start patroling
FOR ADFS_FACTION,0,MAXFactions
SIF !FactionExist(ADFS_FACTION)
	CONTINUE
FOR ADFS_AREA,0,20
SIF !GET_EXISTMAP(ADFS_AREA)
	CONTINUE
SIF GETBIT(FactionPatrolArea:ADFS_FACTION,ADFS_AREA)
	CONTINUE
SIF RAND:200
	CONTINUE
CALL COLORMESSAGE(@"%FactionName(ADFS_FACTION)%은(는) %GET_MAPNAME(ADFS_AREA)%을 순찰하기로 결정했다!",C_YELLOW,benchMarkStart ? 1 # 2,1)
SETBIT FactionPatrolArea:ADFS_FACTION, ADFS_AREA
FactionAreaControl:ADFS_FACTION:ADFS_Area = MAX(FactionAreaControl:ADFS_FACTION:ADFS_Area,150)
NEXT
;Wars
FOR ADFS_TARGET,0,MaxFactions
;lieutendent
SIF FactionRank:MASTER:(ADFS_FACTION) >= 5
	BREAK
SIF !FactionExist(ADFS_TARGET)
	CONTINUE
CALL FactionAllianceCheck(ADFS_FACTION, ADFS_TARGET)
CALL FactionTruceCheck(ADFS_FACTION, ADFS_TARGET)
FOR ADFS_AREA,0,20
SIF !GET_EXISTMAP(ADFS_AREA)
	CONTINUE
IF !GETBIT(FactionWarringAreas:(ADFS_FACTION):(ADFS_TARGET), ADFS_AREA)
	CALL FACTION_WAR_CHECK(ADFS_FACTION, ADFS_TARGET, ADFS_AREA)
ENDIF
NEXT
NEXT
NEXT
;Random Joins
FOR LOCAL,0,MaxFactions
SIF !FactionExist(LOCAL)
	CONTINUE
ADFS_GAIN_SUB:LOCAL:1 = FACTION_RECRUIT_RAND(LOCAL,50,2000)
ADFS_GAIN_SUB:LOCAL:2 = FACTION_RECRUIT_RAND(LOCAL,50,1000)
ADFS_GAIN_SUB:LOCAL:3 = FACTION_RECRUIT_RAND(LOCAL,50,200)
SIF !RAND(5)
	ADFS_GAIN_SUB:LOCAL:3 = FACTION_RECRUIT_RAND(LOCAL,0,5)
CALL ADFS_MOVE_SUB_TO_TOTAL(LOCAL)
NEXT
;Propaganda Signs
FOR LOCAL,0,VARSIZE("FacionPropagandaSign")
IF FacionPropagandaSign:LOCAL > -1
	ADFS_GAIN_SUB:(FacionPropagandaSign:LOCAL):1 = FACTION_RECRUIT_RAND(LOCAL,50,2000)
	ADFS_GAIN_SUB:(FacionPropagandaSign:LOCAL):2 = FACTION_RECRUIT_RAND(LOCAL,50,1000)
	ADFS_GAIN_SUB:(FacionPropagandaSign:LOCAL):3 = FACTION_RECRUIT_RAND(LOCAL,50,200)
ENDIF
NEXT
FOR ADFS_FACTION,0,MAXFactions
SIF ADFS_UNIT_COUNT_CHANGED(ADFS_FACTION,1)
	CALL COLORMESSAGE(@"선전 포스터 덕분에 %FactionName(ADFS_FACTION)%이 %LIST_IN_STRING(ADFS_GAIN_UNITS_LIST_STR(ADFS_Faction,1))%! 증가했다.",C_YELLOW,benchMarkStart ? 1 # 2,1)
NEXT
;daily pay
FOR ADFS_FACTION,0,MAXFactions
ADFS_INCOME_SUB:ADFS_FACTION = RAND(FACTION_TREASURY_DAILY(ADFS_FACTION)*90/100,FACTION_TREASURY_DAILY(ADFS_FACTION)*120/100)
CALL ADFS_MOVE_INCOME_SUB_TO_TOTAL(ADFS_FACTION)
NEXT
;total change
FOR ADFS_FACTION,0,MAXFactions
SIF !FactionExist(ADFS_FACTION)
	CONTINUE
VARSET LOCALS
CALL ADFS_MOVE_SUB_TO_TOTAL(ADFS_FACTION)
SIF ADFS_UNIT_COUNT_CHANGED(ADFS_FACTION)
	CALL COLORMESSAGE(@"%FactionName(ADFS_FACTION)%이(가) %LIST_IN_STRING(ADFS_GAIN_UNITS_LIST_STR(ADFS_Faction))%만큼 얻었다!",C_YELLOW ,benchMarkStart ? 1 # 2,1)
CALL ADFS_MOVE_TOTAL(ADFS_FACTION)
CALL ADFS_MOVE_INCOME_SUB_TO_TOTAL(ADFS_FACTION)
SIF ADFS_INCOME_CHANGED(ADFS_FACTION)
	CALL COLORMESSAGE(@"%FactionName(ADFS_FACTION)%이/가 %金額表示(ADFS_INCOME:ADFS_FACTION)%을/를 얻었다! (현재 %金額表示(FactionWealth:ADFS_FACTION+(ADFS_INCOME:ADFS_FACTION))%)",C_YELLOW ,benchMarkStart ? 1 # 2,1)
CALL ADFS_MOVE_INCOME_TOTAL(ADFS_FACTION)
NEXT

