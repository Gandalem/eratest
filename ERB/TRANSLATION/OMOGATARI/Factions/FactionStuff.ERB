@FACTION_RELATION_STRING(ARG,ARG:1)
#FUNCTIONS
#DIM FRS_FAME
#DIM FRS_INFAMY
VARSET FAC_RELATION_STR
FRS_FAME = FactionFameCompElse(ARG,ARG:1)
FRS_INFAMY = FactionInfamyCompElse(ARG,ARG:1)
FOR LOCAL:12, 0, MaxFactions
SIF !STRLENS(FactionName(LOCAL:12))
	CONTINUE
IF FactionRank:ARG:(ARG:12) && FactionTeamPermaHostile:(ARG:1):(LOCAL:12)
	FAC_RELATION_STR '= "Permanently Hostile"
	RETURNF FAC_RELATION_STR
ENDIF
NEXT
IF FactionPermaHostile:ARG:(ARG:1)
	FAC_RELATION_STR '= "Permanently Hostile"
	RETURNF FAC_RELATION_STR
ELSEIF FactionPermaFriendly:ARG:(ARG:1)
	FAC_RELATION_STR '= "Permanently Friendly"
	RETURNF FAC_RELATION_STR
ENDIF
TRYCALLFORMF FACTION_RELATION_STRING{ARG:1}(ARG,ARG:1)
SIF STRLENS(FAC_RELATION_STR)
	RETURNF FAC_RELATION_STR
SELECTCASE FRS_FAME
	CASE IS > 75000
		SELECTCASE FRS_INFAMY
			CASE IS > 75000
				FAC_RELATION_STR '= @"야생의 아이"
			CASE IS > 50000
				FAC_RELATION_STR '= @"다크 히어로"
			CASE IS > 25000
				FAC_RELATION_STR '= @"선량한 악동"
			CASEELSE
				FAC_RELATION_STR '= @"우상화되었다"
		ENDSELECT
	CASE IS > 50000
		SELECTCASE FRS_INFAMY
			CASE IS > 75000
				FAC_RELATION_STR '= @"온화한 악마"
			CASE IS > 50000
				FAC_RELATION_STR '= @"예측할 수 없다"
			CASE IS > 25000
				FAC_RELATION_STR '= @"웃는 말썽꾸러기"
			CASEELSE
				FAC_RELATION_STR '= @"좋아함"
		ENDSELECT
	CASE IS > 25000
		SELECTCASE FRS_INFAMY
			CASE IS > 75000
				FAC_RELATION_STR '= @"자비로운 불량배"
			CASE IS > 50000
				FAC_RELATION_STR '= @"비웃는 펑크"
			CASE IS > 25000
				FAC_RELATION_STR '= @"혼합"
			CASEELSE
				FAC_RELATION_STR '= @"수락했다"
		ENDSELECT
	CASEELSE
		SELECTCASE FRS_INFAMY
			CASE IS > 75000
				FAC_RELATION_STR '= @"악명 높은"
			CASE IS > 50000
				FAC_RELATION_STR '= @"미움"
			CASE IS > 25000
				FAC_RELATION_STR '= @"외면당한"
			CASEELSE
				FAC_RELATION_STR '= @"중립"
		ENDSELECT
ENDSELECT
RETURNF FAC_RELATION_STR

