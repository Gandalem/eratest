@FactionFameCompElse(ARG,FR_FACTION)
#FUNCTION
#DIM DYNAMIC FR_Faction,2
#DIM DYNAMIC FR_FactionPoints
#DIM DYNAMIC FR_MaxPoints
VARSET FR_MaxPoints
FR_FactionPoints = FactionFame:ARG:FR_FACTION
IF !FactionRank:ARG:FR_FACTION
	FR_FactionPoints += FactionNonMemberFame:(FR_Faction:0)
ENDIF
FOR FR_FACTION:1, 0, MaxFactions
IF FactionRank:ARG:(FR_Faction:1)
	FR_MaxPoints += MAX(FR_MaxPoints,(FactionTeamFame:(FR_Faction:0):(FR_Faction:1)*FACTION_RANK_ASSOCIATION_MULT(FactionRank:ARG:(FR_Faction:1))/100))
ENDIF
NEXT
FR_FactionPoints += FR_MaxPoints
RETURNF FR_FactionPoints

@FactionInfamyCompElse(ARG,FR_FACTION)
#FUNCTION
#DIM DYNAMIC FR_Faction,2
#DIM DYNAMIC FR_FactionPoints
#DIM DYNAMIC FR_MaxPoints
VARSET FR_MaxPoints
FR_FactionPoints = FactionInfamy:ARG:FR_FACTION
IF !FactionRank:ARG:FR_FACTION
	FR_FactionPoints += FactionNonMemberInfamy:(FR_Faction:0)
ENDIF
FOR FR_FACTION:1, 0, MaxFactions
IF FactionRank:ARG:(FR_Faction:1)
	FR_MaxPoints = MAX(FR_MaxPoints,(FactionTeamInfamy:(FR_Faction:0):(FR_Faction:1)*FACTION_RANK_ASSOCIATION_MULT(FactionRank:ARG:(FR_Faction:1))/100))
ENDIF
NEXT
FR_FactionPoints += FR_MaxPoints
RETURNF FR_FactionPoints

@FactionRelationCompElse(ARG,FR_FACTION)
