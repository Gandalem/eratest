@FACTION_DONATE_MENU(nFactionTarget, nFactionRepresent = -1, OP = "")
#DIM nFactionRepresent
#DIM nFactionTarget
#DIM 	 FU_CALC,5
#DIMS OP
#DIM FDM_MONEY,2
#DIM FDM_REPS,2
#DIMS FDM_REPRESENTATIVE
#DIM FU_RESULT
IF nFactionRepresent == -1
	FDM_REPRESENTATIVE = %CALLNAME:MASTER%
	FDM_REPS:0         = FactionFame:MASTER:nFactionTarget
	FDM_REPS:1  	   = FactionInfamy:MASTER:nFactionTarget
	FDM_MONEY:0 	   = MONEY
ELSE
	FDM_REPRESENTATIVE = %FactionName(nFactionRepresent)%
	FDM_REPS:0         = FactionTeamFame:nFactionTarget:nFactionRepresent
	FDM_REPS:1  	   = FactionTeamInfamy:nFactionTarget:nFactionRepresent
	FDM_MONEY:0 	   = FactionWealth:nFactionRepresent
ENDIF
VARSET FU_CALC
PRINTFORML 얼마를 기부하시겠습니까? (현재 보유 자금: ¥%PALAM_NUM_NAS(FDM_MONEY)%)
SIF !STRCOUNT(OP, "「No Withdraw」")
	PRINTFORML 당신은 %FACTION_RANK_STRING_INDE(nFactionTarget,5)% 이상일 경우 지갑으로 자금을 인출할 수 있다.
PRINTFORML 명성 상실당할 때마다 100엔, 명성 획득할 때마다 200엔
PRINTL
FU_CALC:0 = (100000-FDM_REPS:0)*200
FU_CALC:1 = (FDM_REPS:1)*100
PRINTBUTTON @"[%PALAM_NUM_NAS(FU_CALC:0)% (최대 명성)]", FU_CALC:0
PRINTL
PRINTBUTTON @"[%PALAM_NUM_NAS(FU_CALC:1)% (명예 초기화)]", FU_CALC:1
PRINTL
PRINTBUTTON @"[취소]", 0
PRINTL
INPUT
FU_RESULT = RESULT
SELECTCASE FU_RESULT
	CASE IS < -FactionWealth:nFactionTarget
		PRINTFORMW 사과하지만, %FactionName(nFactionTarget)%가 빚을 지고 있는 것을 보고 싶지 않다.
		RETURN
	CASE IS < 0
		IF STRCOUNT(OP, "「No Withdraw」")
			PRINTFORMW 자금을 인출할 수 없습니다!
		ELSEIF FactionRank:MASTER:nFactionTarget < 5
			PRINTFORMW 파벌에서 자금을 인출하기에는 순위가 부족하다 (최소 %FACTION_RANK_STRING_INDE(nFactionTarget,5)% 이상이어야 한다).
			RETURN
		ENDIF
		PRINTFORML 당신은 %FactionName(nFactionTarget)%에서 ¥%PALAM_NUM_NAS(FU_RESULT)%을 인출하시겠습니까?
		PRINTFORML 해당 파벌은 이제 ¥%PALAM_NUM_NAS(FactionWealth:nFactionTarget-FU_RESULT)%의 부를 갖게 됩니다.
		CALL ASK_YN()
		SELECTCASE RESULT
			CASE 0
				CALL GET_MONEY_YEN(FU_RESULT,2)
				FactionWealth:nFactionTarget -= FU_RESULT
			CASE 1
				RETURN
		ENDSELECT
	CASE 0
		RETURN
	CASE IS > FDM_MONEY
		PRINTFORMW 사과하지만, 나는 \@ nFactionRepresent == -1 ? 당신이 # %FactionName(nFactionRepresent)% 가 \@ 빚을 지는 것을 보고 싶지 않아요.
		RETURN
	CASE 1 TO FDM_MONEY
		PRINTFORML 당신은 ¥%PALAM_NUM_NAS(FU_RESULT)%를 %FactionName(nFactionTarget)%에게 기부할 것인지 확실한가?
		PRINTFORML \@ nFactionRepresent == -1 ? 당신 # %FactionName(nFactionRepresent)% 는 {FU_RESULT/200} 명성을 얻고 {FU_RESULT/100} 불명을 잃을 것이다. \@
		CALL ASK_YN()
		SELECTCASE RESULT
			CASE 0
				IF nFactionRepresent == -1
					CALL FACTION_GIVE_MONEY(nFactionTarget,FU_RESULT)
				ELSE
					CALLF StoreFactionTitles(MASTER,nFactionTarget)
					CALL COLORMESSAGE(@"%FactionName(nFactionRepresent)% 지불한 금액은 ¥%DIGIT_GROUP(FU_RESULT)%이며, 총액은 %DIGIT_GROUP(FactionWealth:nFactionRepresent)%에서 %DIGIT_GROUP(MAX(0, FactionWealth:nFactionRepresent - FU_RESULT))%로 변경됐다.", C_YELLOW, 2)
					FactionWealth:nFactionRepresent = FactionWealth:nFactionRepresent - FU_RESULT
					CALL FactionChangeRelation(nFactionRepresent,nFactionTarget,FU_RESULT/200,0,1,0)
					CALL FactionChangeRelation(nFactionRepresent,nFactionTarget,-(FU_RESULT/100),0,1,1)
					CALL FactionChangeRelation(nFactionTarget,nFactionRepresent,FU_RESULT/200,0,1,0)
					CALL FactionChangeRelation(nFactionTarget,nFactionRepresent,-(FU_RESULT/100),0,1,1)
					CALL FACTION_GET_MONEY_YEN(nFactionTarget, FU_RESULT, 2)
					CALL CheckForFacitonTitleChanges(MASTER,@"당신의기부")
				ENDIF
				WAIT
			CASE 1
				RETURN
		ENDSELECT
ENDSELECT

@FACTION_GIVE_MONEY(nFactionTarget,nAmount)
#DIM nFactionTarget
#DIM nAmount
CALLF StoreFactionTitles(MASTER,nFactionTarget)
CALL PAY_MONEY_YEN(nAmount,2)
CALL AddFame(MASTER,nFactionTarget,nAmount/200,1)
CALL AddInfamy(MASTER,nFactionTarget,-(nAmount/100),1)
CALL FACTION_GET_MONEY_YEN(nFactionTarget, nAmount, 2)
CALL CheckForFacitonTitleChanges(MASTER,@"당신의기부")

@FACTION_GET_MONEY_YEN(nFactionTarget, VALUE, PRINT_TYPE)
#DIM VALUE
#DIM PRINT_TYPE;表示形式　0=通常　1=L　2=W
#DIM nFactionTarget
SIF VALUE <= 0
	RETURN
CALL COLORMESSAGE(@"%FactionName(nFactionTarget)% 받음 %金額表示(VALUE)%총합: %DIGIT_GROUP(FactionWealth:nFactionTarget)%->%DIGIT_GROUP(FactionWealth:nFactionTarget+VALUE)%", C_YELLOW, PRINT_TYPE)
FactionWealth:nFactionTarget += VALUE

@FACTION_DONATE_TROOPS_MENU(nFactionTarget, nFactionRepresent = -1, OP = "")
#DIM nFactionRepresent
#DIM nFactionTarget
#DIM FU_CALC,5
#DIMS OP
#DIM FDM_MONEY,2
#DIM FDM_REPS,2
#DIMS FDM_REPRESENTATIVE
#DIM FU_RESULT
#DIM FU_UNIT_TYPE
#DIM FU_GIVING, 7
#DIM FU_LINECOUNT
#DIM CONST FU_GET_FAME = 100, 300, 500, 1000, 3000, 10000
IF nFactionRepresent == -1
	RETURN
ELSE
	FDM_REPRESENTATIVE = %FactionName(nFactionRepresent)%
	FDM_REPS:0         = FactionTeamFame:nFactionTarget:nFactionRepresent
	FDM_REPS:1  	   = FactionTeamInfamy:nFactionTarget:nFactionRepresent
ENDIF
VARSET FU_CALC
VARSET FU_GIVING
PRINTFORML 몇 명의 병력을 기부하고 싶습니까?
PRINTFORML %FactionName(nFactionRepresent)% 군:
FU_LINECOUNT = LINECOUNT
DO
CLEARLINE LINECOUNT - FU_LINECOUNT
VARSET FU_CALC
FOR LOCAL,1,6
PRINTBUTTON @"%FACTION_RANK_STRING_INDE(nFactionRepresent,LOCAL),10%: %PALAM_NUM_NAS(FactionUnits:nFactionRepresent:LOCAL),6%", LOCAL
SIF FU_GIVING:LOCAL
	PRINTFORM  ({FU_GIVING:LOCAL} 기증하기)
PRINTFORML {FU_GET_FAME:LOCAL} 단위당 명성
FU_CALC += (FU_GIVING:LOCAL*FU_GET_FAME)
NEXT
PRINTL
FU_CALC:1 = FU_CALC*2
PRINTFORML 당신은 {FU_CALC} 명성을 얻고 {FU_CALC:1} 악명을 잃는다.
PRINTL
PRINTBUTTON @"[기부]", 1500
PRINTL
PRINTBUTTON @"[제거]", 1501
PRINTL
PRINTBUTTON @"[취소]", 0
PRINTL
INPUT
FU_RESULT = RESULT
SELECTCASE FU_RESULT
	CASE 0
		RETURN
	CASE 1 TO 6
		FU_UNIT_TYPE = FU_RESULT
		FDM_MONEY = FactionUnits:nFactionRepresent:FU_UNIT_TYPE
		PRINTFORML 얼마나 많은 %PLURALIZER(FACTION_RANK_STRING_INDE(nFactionRepresent,FU_UNIT_TYPE))%을 기증하고 싶으신가요? (%FactionName(nFactionRepresent)%는 현재 %PALAM_NUM_NAS(FDM_MONEY)%의 %PLURALIZER(FACTION_RANK_STRING_INDE(nFactionRepresent,FU_UNIT_TYPE))%을 가지고 있습니다)
		PRINTL
		PRINTBUTTON @"[취소]", -1
		INPUT
		FU_RESULT = RESULT
		SELECTCASE RESULT
			CASE IS > FDM_MONEY
				PRINTFORMW 죄송하지만, 저는 %FactionName(nFactionRepresent)%가 군대 부채 상태인 것을 보고 싶지 않습니다.
				RETURN
			CASE 0 TO FDM_MONEY
				FU_GIVING:FU_UNIT_TYPE = FU_RESULT
			CASE -1
		ENDSELECT
	CASE 1500
		PRINTFORML %FactionName(nFactionTarget)%에게 이 부대를 기부하시겠습니까?
		FOR LOCAL,1,6
		SIF !FU_GIVING:LOCAL
			CONTINUE
		PRINTFORMS @"%FACTION_RANK_STRING_INDE(nFactionRepresent,LOCAL),10%: %PALAM_NUM_NAS(FactionUnits:nFactionRepresent:LOCAL),6%"
		PRINTFORML ({FU_GIVING:LOCAL})을 주는 것({FU_GET_FAME:LOCAL} 명당 단위의 명성) (남은 %PALAM_NUM_NAS(FactionUnits:nFactionRepresent:LOCAL-FU_GIVING:LOCAL)%가 있을 것입니다)
		NEXT
		PRINTFORML %FactionName(nFactionRepresent)%은(는) {FU_CALC} 명성을 얻고 {FU_CALC*2} 악명을 잃는다.
		CALL ASK_YN()
		SELECTCASE RESULT
			CASE 0
				CALLF StoreFactionTitles(MASTER,nFactionTarget)
				FOR LOCAL,1,6
				FactionUnits:nFactionRepresent:LOCAL -= (FU_GIVING:LOCAL)
				FactionUnits:nFactionTarget:LOCAL -= (FU_GIVING:LOCAL)
				NEXT
				CALL FactionChangeRelation(nFactionRepresent,nFactionTarget,FU_CALC,0,1,0)
				CALL FactionChangeRelation(nFactionRepresent,nFactionTarget,-(FU_CALC*2),0,1,1)
				CALL FactionChangeRelation(nFactionTarget,nFactionRepresent,FU_CALC,0,1,0)
				CALL FactionChangeRelation(nFactionTarget,nFactionRepresent,-(FU_CALC),0,1,1)
				CALL CheckForFacitonTitleChanges(MASTER,@"당신의기부")
				WAIT
			CASE 1501
				VARSET FU_GIVING
			CASE 1
				RETURN
		ENDSELECT
ENDSELECT
LOOP 1

@FACTION_RECRUITER(ARG)
#FUNCTION
#DIM nRecruiter
nRecruiter = -1
;find recruiter
FOR LOCAL,0,CHARANUM
IF TALENT:LOCAL:Recruiter == ARG+1
	RETURNF LOCAL
	BREAK
ENDIF
NEXT
IF nRecruiter == -1
	;no recruiter found, we must create one.
	ADDCHARA CSV_CHARANUM()
	TARGET = CHARANUM-1
	TALENT:TARGET:301 = 1
	FactionRank:TARGET:ARG = 4
	TALENT:TARGET:Recruiter = ARG+1
	CFLAG:TARGET:300 = SUKIMA()
	nRecruiter = TARGET
	NAME:TARGET '= @"%FactionAbriv(ARG)% 모집관"
	CALLNAME:TARGET '= @"%FactionAbriv(ARG)% 채용 담당자"
	RETURNF TARGET
ENDIF

