@IntimidationFactor(ARG)
#FUNCTION
#DIM DYNAMIC IF_POINTS
VARSET IF_POINTS
IF_POINTS += IntimidationFactor_Step1(ARG)
IF_POINTS += IntimidationFactor_Step2(ARG)
IF_POINTS =  IF_POINTS*IntimidationFactor_Step3(ARG,1)/100
RETURNF IF_POINTS
;combats

@IntimidationFactor_Step1(ARG)
#FUNCTION
#DIM DYNAMIC IFS_POINTS
#DIM DYNAMIC AblUsed
IF STRCOUNT(GET_STR(ARG, "Weapon", EQUIP:ARG:Weapon, "Class"), "Blunt") || STRCOUNT(GET_STR(ARG, "Weapon", EQUIP:ARG:Weapon, "Class"), "Blade")
	AblUsed:0 = ABL:ARG:Melee
ELSEIF GROUPMATCH(GET_STR(ARG, "Weapon", EQUIP:ARG:Weapon, "Type"),"Firearm","Explosive","Bow") && EQUIP:ARG:Weapon
	AblUsed:0 = ABL:ARG:Shooting
ELSE
	AblUsed:0 = ABL:ARG:戦闘能力
ENDIF
IFS_POINTS = AblUsed*100
IFS_POINTS += EsperPoints(ARG)/100
RETURNF IFS_POINTS
;weapon

@IntimidationFactor_Step2(ARG)
#FUNCTION
#DIM DYNAMIC IFS_POINTS
; SIF Equip:ARG:Weapon
IFS_POINTS += (MIN(GetWeaponScore(EQUIP:ARG:Weapon,ARG)/3,5000))
RETURNF IFS_POINTS
;talents

@IntimidationFactor_Step3(ARG,ARG:1)
#FUNCTION
#DIM DYNAMIC IFS_POINTS
IFS_POINTS = 100
SELECTCASE TALENT:ARG:11
	CASE 1
		TIMES IFS_POINTS, 1.1
	CASE -1
		TIMES IFS_POINTS, 0.8
ENDSELECT
SELECTCASE TALENT:ARG:12
	CASE 1
		TIMES IFS_POINTS, 1.1
	CASE -1
		TIMES IFS_POINTS, 0.9
ENDSELECT
SELECTCASE TALENT:ARG:13
	CASE 1
		TIMES IFS_POINTS, 1.3
	CASE -1
		TIMES IFS_POINTS, 0.7
ENDSELECT
SELECTCASE TALENT:ARG:21
	CASE 2
		TIMES IFS_POINTS, 1.7
	CASE 1
		TIMES IFS_POINTS, 1.3
	CASE -1
		TIMES IFS_POINTS, 0.7
ENDSELECT
RETURNF IFS_POINTS

@INIT_FACTIONS
#DIM T_ID
VARSET FactionMainArea, -1
CALLF FactionUnitTableCreate
IF SaveIsEZB
	VARSET FactionDisabled, 1
	CALL ADDFACTION_INIT(98)
	FOR LOCAL,0,CHARANUM
	FactionRank:LOCAL:98 = EZB_ESSENTIAL(LOCAL)
	NEXT
ELSE
	;filter out outsiders
	FOR LOCAL,0,MaxFactions
	SIF LOCAL%5 == 0
		CALL ANIMATION_LOAD_NAS(LOCAL, 0, MaxFactions, @"진영을 초기화한다..." ) ;nas loading
	SIF LOCAL == 98
		CONTINUE
	CALL ADDFACTION_INIT(LOCAL)
	NEXT
	;main areas
	FactionMainArea:0 = 0
	FactionMainArea:1 = -1
	FactionMainArea:2 = 1
	FactionMainArea:3 = 2
	FactionMainArea:4 = -1
	FactionMainArea:5 = -1
	FactionMainArea:6 = 3
	FactionMainArea:7 = 5
	FactionMainArea:8 = 5
	FactionMainArea:9 = 6
	FactionMainArea:10 = 7
	FactionMainArea:11 = 9
	FactionMainArea:19 = -1
ENDIF
;full control on main factions
FOR LOCAL,0,VARSIZE("FactionMainArea")
SIF FactionMainArea:LOCAL == -1
	CONTINUE
FactionAreaControl:(FactionMainArea:LOCAL):LOCAL = 1000
NEXT

@FactionVisting(nFaction)
#DIM nFaction
#DIM FV_ID
#DIM raidPoints
#DIM PeopleSpawned
#DIM nEnemy
#DIM DYNAMIC FactionGroup
VARSET PeopleSpawned
raidPoints = nFactionPatrolPointMax
PRINTFORM %TOLOWER(Pluralizer(FactionUnit(nFaction)))%들로 이루어진 그룹이
CALLF FactionColor(MASTER,nFaction)
PRINTFORM %FactionName(nFaction)%
RESETCOLOR
PRINTFORMW 방문하기 위해 왔다.
FactionGroup = RAND(1,65536)
VARSET FactionRaidRankSpawn
WHILE raidPoints > 0 && PeopleSpawned < MAX_MOBS
PeopleSpawned ++
CALL FactionEnemySpawn(nFaction,raidPoints,0)
FV_ID = CHARANUM-1
IF CFLAG:FV_ID:(450 + MAIN_MAP)
	CFLAG:FV_ID:現在位置 = CFLAG:FV_ID:(450 + MAIN_MAP)
ELSE
	CFLAG:FV_ID:現在位置 = MAXROOM
ENDIF
CFLAG:FV_ID:デート中 = MAIN_MAP
CFLAG:FV_ID:拠点来訪 = 1
CFLAG:FV_ID:最後に来訪した日 = DAY
CFLAG:FV_ID:PatrolGroup = FactionGroup
;set times
CFLAG:FV_ID:来訪時間 = TIME
CFLAG:FV_ID:帰宅時間 = TIME + 800
SIF CFLAG:FV_ID:帰宅時間 > 1440
	CFLAG:FV_ID:帰宅時間 = CFLAG:FV_ID:帰宅時間-1440
CFLAG:FV_ID:起床時間 = TIME
CFLAG:FV_ID:就寝時間 = TIME + 800
SIF CFLAG:FV_ID:就寝時間 > 1440
	CFLAG:FV_ID:就寝時間 = CFLAG:FV_ID:就寝時間-1440
;=============
TCVAR:FV_ID:Arrival_Time = TIME ;addition custom code, keep track of arrival time
CALL Add_Special_NPC_Travel(FV_ID) ;addition custom code, handle special travel mechanics
WEND

