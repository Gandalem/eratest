@AIA_ASSAIANS
IF RAND(100) < 90
	RETURN
ENDIF
SIF !nRyona || SaveIsEZB
	RETURN
;SIF	!nNecro
;	RETURN
SIF FLAG:70
	RETURN
SIF StateOfEmergency < 5
	RETURN
SIF !Omogatari_Raids()
	RETURN
CALL FACTION_ASSAIANS(MASTER,0)
;RECEIVING is the person being targeted
;ATTACKING is the person who's looking at ARG's faction infamy
;Goes off from a 0 to 1000 scale
;1000 is guaranteed, 0 is never
;RESULT:1 is the faction or relation
;RESULT:2 is the chance that it's lethal

@HostileAffinity(RECEIVING,ATTACKING)
#FUNCTION
#DIM RECEIVING
#DIM ATTACKING
#DIM nFaction,2
#DIM nHate
#DIM inControlArea
#DIM HA_THRESHOLD
VARSET nHate
VARSET RESULT
IF RELATION:ATTACKING:RECEIVING > 100
	;return relation
	RESULT:1 = RELATION:ATTACKING:RECEIVING
	RETURNF 0
ELSEIF TALENT:ATTACKING:8 || TALENT:ATTACKING:3
	RETURNF 0
ELSEIF RELATION:ATTACKING:RECEIVING < 100 && RELATION:ATTACKING:RECEIVING
	IF nSocialFighting
		SELECTCASE RELATION:ATTACKING:RECEIVING
			; CASE IS >= 90
			; 	RESULT:2 = MAX(RESULT:2,0)
			; 	nHate = MAX(nHate,10)
			; CASE IS >= 80
			; 	RESULT:2 = MAX(RESULT:2,0)
			; 	nHate = MAX(nHate,25)
			; CASE IS >= 70
			; 	RESULT:2 = MAX(RESULT:2,0)
			; 	nHate = MAX(nHate,50)
			; CASE IS >= 60
			; 	RESULT:2 = MAX(RESULT:2,100)
			; 	nHate = MAX(nHate,100)
			CASE IS >= 50
				RESULT:2 = MAX(RESULT:2,50)
				nHate = MAX(nHate,50)
			CASE IS >= 40
				RESULT:2 = MAX(RESULT:2,100)
				nHate = MAX(nHate,200)
			CASE IS >= 30
				RESULT:2 = MAX(RESULT:2,150)
				nHate = MAX(nHate,500)
			CASE IS >= 20
				RESULT:2 = MAX(RESULT:2,250)
				nHate = MAX(nHate,650)
			CASE IS >= 10
				RESULT:2 = MAX(RESULT:2,500)
				nHate = MAX(nHate,800)
			CASEELSE
				RESULT:2 = MAX(RESULT:2,1000)
				nHate = MAX(nHate,1000)
		ENDSELECT
	ENDIF
ELSEIF MARK:ATTACKING:3 >= 4 && RECEIVING == MASTER
	RESULT:2 = MAX(RESULT:2,1000)
	nHate = MAX(nHate,1000)
ENDIF
IF (TALENT:ATTACKING:Bloodlust >= 3 || CharaTrauma:ATTACKING:0 == 2) && nSocialFighting
	;with bloodlust, 30% of being lethal
	RESULT:2 = MAX(RESULT:2,300)
	nHate = MAX(nHate,100)
ENDIF
SIF !nFactions || FactionDateTruce:RECEIVING:0 || FactionDateTruce:ATTACKING:0
	RETURNF nHate
FOR nFaction, 0, MaxFactions
inControlArea = FactionMainArea:GET_MAPID(CFLAG:ATTACKING:300) == nFaction
HA_THRESHOLD = inControlArea ? 25000 # 50000
;affiliated
SIF FactionFame:ATTACKING:nFaction - FactionInfamy:ATTACKING:nFaction < 25000 && !FactionRank:ATTACKING:nFaction
	CONTINUE
SIF FactionRank:ATTACKING:nFaction && FactionRank:RECEIVING:nFaction
	CONTINUE
FOR nFaction:1,0,MaxFactions
SIF (GETBIT(FactionWarring:nFaction:(nFaction:1),1) || GETBIT(FactionWarring:nFaction:(nFaction:1),2)) && FactionRank:RECEIVING:(nFaction:1)
	CONTINUE
IF FactionRelationComp2(RECEIVING,nFaction:0,nFaction:1) < -HA_THRESHOLD || (FactionRank:RECEIVING:(nFaction:1) && GETBIT(FactionWarring:nFaction:(nFaction:1),0))
	;return the faction name
	RESULT:1 = nFaction
	RESULT:2 = MAX(RESULT:2,1000)
	nHate = MAX(nHate,1000)
ENDIF
NEXT
NEXT
RETURNF nHate
;ARG is the person being targeted
;nTarget is the person who's looking at ARG's faction infamy

@FriendlyAffinity(ARG,nTarget)
#FUNCTION
#DIM nTarget
#DIM nEnemy
#DIM nFaction,2
VARSET RESULT
IF RELATION:nTarget:ARG > 100
	;return relation
	RESULT:1 = RELATION:nTarget:ARG
	RETURNF 1
ELSEIF (TALENT:nTarget:7 || TALENT:nTarget:3) && ARG == MASTER
	RETURNF 1
ELSEIF RELATION:nTarget:ARG <= 50 && RELATION:nTarget:ARG
	RETURNF 0
ELSEIF MARK:nTarget:3 && ARG == MASTER
	RETURNF 0
ENDIF
SIF !nFactions
	RETURNF 0
FOR nFaction, 0, MaxFactions
SIF FactionRank:nTarget:nFaction && FactionRank:ARG:nFaction
	RETURNF 1
SIF FactionFame:nTarget:nFaction - FactionInfamy:nTarget:nFaction < 25000
	CONTINUE
FOR nFaction:1,0,MaxFactions
IF FactionRelationComp2(ARG,nFaction:0,nFaction:1) >= 25000
	;return the faction name
	RESULT:1 = nFaction
	RETURNF 1
ENDIF
NEXT
NEXT
RETURNF 0

@FightIsPossible(ATTACKING,RECEIVING)
#FUNCTION
#DIM RECEIVING
#DIM ATTACKING
;EasyBattle
SIF SaveIsEZB
	RETURNF 0
;Invalid character
SIF RECEIVING > CHARANUM || RECEIVING < 0 || ATTACKING == RECEIVING
	RETURNF 0
;Not in the same location
SIF CFLAG:ATTACKING:現在位置 != CFLAG:(RECEIVING):現在位置
	RETURNF 0
SIF ATTACKING == RECEIVING
	RETURNF 0
;Are targets alive?
SIF !SHIRAHU(RECEIVING)
	RETURNF 0
SIF !SHIRAHU(ATTACKING)
	RETURNF 0
;Restrain mode
SIF TEQUIP:ATTACKING:拘束
	RETURNF 0
;Dead calm block
SIF COMBAT_AGGRESSIVENESS(ATTACKING) < RAND(1000)
	RETURNF 0
;If 2hu is ded
SIF TCVAR:(RECEIVING):Grievous_Harm
	RETURNF 0
IF RECEIVING == MASTER
	;Hate 3
	SELECTCASE MARK:ATTACKING:反発刻印
		CASE IS >= 4
			RETURNF 2
		CASE 3
			RETURNF RAND(100) < 30 ? 2 # 1
		CASE 2
			RETURNF RAND(100) < 30 ? 1 # 0
		CASE 1
		CASEELSE
	ENDSELECT
	SIF FLAG:POSTAL >= 3
		RETURNF 2
ENDIF
;Hostile affinity
H = HostileAffinity(RECEIVING,ATTACKING)
IF H && RAND(1000) < H
	RETURNF RAND(1000) < RESULT:2 ? 2 # 1
ENDIF
;Postal mode
SIF FLAG:POSTAL >= 4
	RETURNF 2

