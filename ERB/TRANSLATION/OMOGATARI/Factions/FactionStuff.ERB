;Determins cost of raid points via multiple things
;1. Rank of the unit
;2. Unit Health
;3. Unit Skill
;4. Unit equipment relative to technical level
;5. Bionics if any
;Minimum of 35 points, maximum of 10000

@RaidPointCost(ARG)
#FUNCTION
#DIM F_ID
#DIM DYNAMIC RPC
#DIM DYNAMIC RPC_WEAP
#DIM DYNAMIC RPC_WEAP_SCORE
F_ID = DT_CELL_GET("FactionUnits",ARG,"faction",1)
VARSET RPC
;rank
SELECTCASE DT_CELL_GET("FactionUnits",ARG,"rank",1)
	CASE 1
		RPC -= 50
	CASE 2
	CASE 3
		RPC += 100
	CASE 4
		RPC += 200
	CASE 5
		RPC += 500
	CASE 6
		RPC += 1000
ENDSELECT
;health
;2000 STA is standard, 1 raid point per 20 HP
;less HP means less raid points used.
RPC += ((DT_CELL_GET("FactionUnits",ARG,"hp",1)-2000)/15)
;Skill
;20 per skill point
RPC += (DT_CELL_GET("FactionUnits",ARG,"combat level",1)*35)
;Weapon
RPC_WEAP = (DT_CELL_GET("FactionUnits",ARG,"equip 24",1))
IF RPC_WEAP
	RPC += (WeaponRaidPointCost(F_ID,RPC_WEAP))
ELSE
	RPC += WeapPoolRaidCost(F_ID,DT_CELL_GETS("FactionUnits",ARG,"desired weapon",1))
ENDIF
RETURNF LIMIT(RPC,35,10000)

@WeaponRaidPointCost(ARG,nWeap)
#FUNCTION
#DIM nWeap
#DIM nWeapTech
#DIM DYNAMIC RPC_WEAP_SCORE
VARSET RPC_WEAP_SCORE
RPC_WEAP_SCORE = GetWeaponScore(nWeap,CSV_CHARANUM())/15
IF nWeap >= VAR_TEMP_MAX
	nWeapTech = GET_INT(CSV_CHARANUM(), "Weapon", GET_INT(CSV_CHARANUM(), "WeaponPreset", nWeap-1000, "Base Weapon"), "Tech Level")
ELSE
	nWeapTech = GET_INT(CSV_CHARANUM(), "Weapon", nWeap, "Tech Level")
ENDIF
SELECTCASE MAX(nWeapTech,GET_INT(CSV_CHARANUM(), "Weapon", nWeap, "Youjutsu Tier")) - FactionTech:ARG
	CASE IS <= -4
		;free
		TIMES RPC_WEAP_SCORE, 0
	CASE -3
		TIMES RPC_WEAP_SCORE, 0.2
	CASE -2
		TIMES RPC_WEAP_SCORE, 0.4
	CASE -1
		TIMES RPC_WEAP_SCORE, 0.7
	CASE 0
	CASE 1
		TIMES RPC_WEAP_SCORE, 1.3
	CASE 2
		TIMES RPC_WEAP_SCORE, 2
	CASE 3
		TIMES RPC_WEAP_SCORE, 2.5
	CASE IS >= 4
		TIMES RPC_WEAP_SCORE, 4
ENDSELECT
RETURNF (RPC_WEAP_SCORE)

@WeapPoolRaidCost(ARG,ARGS)
#FUNCTION
#DIM DYNAMIC RPC_WEAP_SCORE
#DIMS SELECTION_OFFERING, 200
#DIM DYNAMIC RPC_COUNT
#DIM DYNAMIC RPC_TOTAL
VARSET RPC_WEAP_SCORE
VARSET RPC_COUNT
VARSET RPC_TOTAL
RPC_COUNT = MakeDesiredWeapon(ARGS,1)
SPLIT RESULTS, "/",SELECTION_OFFERING
SIF !RPC_COUNT
	RETURNF 0
FOR LOCAL,0,VARSIZE("SELECTION_OFFERING")
SIF !TOINT(SELECTION_OFFERING:LOCAL)
	BREAK
RPC_TOTAL += WeaponRaidPointCost(ARG,TOINT(SELECTION_OFFERING:LOCAL))
NEXT
RPC_TOTAL /= RPC_COUNT
RETURNF RPC_TOTAL

