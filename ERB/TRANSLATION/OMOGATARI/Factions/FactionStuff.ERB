@AddInfamy(nTarget,nFaction,nPoints,ignoreAsso=0)
#DIM nTarget
#DIM nFaction
#DIM nPoints
#DIM ignoreAsso
CALL FactionChangeRelation(nTarget,nFaction,nPoints,ignoreAsso,0,1)

@AddFame(nTarget,nFaction,nPoints,ignoreAsso=0)
#DIM nTarget
#DIM nFaction
#DIM nPoints
#DIM ignoreAsso
CALL FactionChangeRelation(nTarget,nFaction,nPoints,ignoreAsso,0,0)

@FactionChangeRelation(nTarget,nFaction,nPoints,ignoreAsso=0,targetIsFaction=0,isInfamy=0)
#DIM nTarget
#DIM nFaction
#DIM nPoints
#DIM ignoreAsso
#DIM targetIsFaction
#DIM isInfamy
SIF !ignoreAsso
	CALLF StoreFactionTitles(targetIsFaction ? MASTER # nTarget,nFaction)
SIF !nFactions
	RETURN
IF !targetIsFaction
	SIF FactionPermaHostile:nTarget:nFaction || FactionPermaFriendly:nTarget:nFaction
		RETURN
	SIF TALENT:nTarget:妄想の産物
		RETURN
	IF isInfamy
		FactionInfamy:nTarget:nFaction = LIMIT(FactionInfamy:nTarget:nFaction + nPoints,0,100000)
	ELSE
	ENDIF
ELSE
	IF isInfamy
		FactionTeamInfamy:nFaction:nTarget = LIMIT(FactionTeamInfamy:nFaction:nTarget + nPoints,0,100000)
	ELSE
		FactionTeamFame:nTarget:nFaction = LIMIT(FactionTeamFame:nTarget:nFaction + nPoints,0,100000)
	ENDIF
ENDIF
IF isInfamy
	SETCOLOR nPoints > 0 ? C_RED # C_GREEN
ELSE
	SETCOLOR nPoints < 0 ? C_RED # C_GREEN
ENDIF
PRINTFORML %FactionName(nFaction)%\@ isInfamy ? 불명예 # 명성 \@ \@ nPoints > 0 ? 얻음 # 상실 \@: {ABS(nPoints)} (\@ targetIsFaction ? %FactionName(nTarget)% # %CALLNAME:nTarget% \@)
RESETCOLOR
SIF !ignoreAsso
	CALL CheckForFacitonTitleChanges(targetIsFaction ? MASTER # nTarget, @"\@ targetIsFaction ? %FactionName(nTarget)%의 # %조사처리(CALLNAME:nTarget,"의")% \@ \@ isInfamy ? 반감 # 우호적인 \@ 행동들")

@AddCombatInfamy(nTarget,nVictim,nDivideFactor)
#DIM nTarget
#DIM nVictim
#DIM nDivideFactor
SIF !nFactions
	RETURN
SIF TALENT:nVictim:妄想の産物 || TALENT:nTarget:妄想の産物
	RETURN
FOR LOCAL, 0, MaxFactions
IF FactionInfamy:nVictim:LOCAL-FactionFame:nVictim:LOCAL > 25000
	CALL AddFame(nTarget,LOCAL,FactionInfamy:nVictim:LOCAL/nDivideFactor)
ELSEIF FactionFame:nVictim:LOCAL > 25000
	CALL AddInfamy(nTarget,LOCAL,FactionFame:nVictim:LOCAL/nDivideFactor)
ENDIF
NEXT

@FactionColor(ARG,nFaction)
#FUNCTION
#DIM nFaction
SELECTCASE FactionRelationCompElse(ARG,nFaction)
	CASE IS > 0
		SETCOLOR Color_Gradient_PER(C_BLUE,C_GREEN,MIN(FactionFameCompElse(ARG,nFaction)/1000,100))
	CASE IS < 0
		SETCOLOR Color_Gradient_PER(C_BLUE,C_D_RED,MIN(FactionInfamyCompElse(ARG,nFaction)/1000,100))
	CASEELSE
		SETCOLOR C_BLUE
ENDSELECT

