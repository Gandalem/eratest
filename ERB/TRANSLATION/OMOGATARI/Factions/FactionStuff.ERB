@FACTION_DIPLOMACY(nFactionRepresent,nFactionTarget)
#DIM nFactionRepresent
#DIM nFactionTarget
#DIM FD_LINECOUNT, 3
#DIM FD_SURRENDER_PTS
#DIM FD_RECRUITER
#DIM FD_RESULT
FD_RECRUITER = FACTION_RECRUITER(nFactionTarget)
FD_SURRENDER_PTS = (FactionThreatPoints(-1,nFactionTarget)*2 + 500)
DRAWLINE
PRINTFORM ~와 협상하며
CALL FactionColorName(MASTER,nFactionTarget)
PRINT  대표하며
CALL FactionColorName(MASTER,nFactionRepresent)
PRINTL
DRAWLINE
VARSET FD_LINECOUNT
FD_LINECOUNT = LINECOUNT
DO
CLEARLINE LINECOUNT - FD_LINECOUNT
IF nFactionWar
	CALL PRINTLINE, "Manage Relations"
	SIF !FactionTruceAble(nFactionRepresent, nFactionTarget)
		SETCOLOR C_GRAY
	PRINTFORMLC [  0] 휴전 제안
	RESETCOLOR
	SIF !FactionAllianceAble(nFactionRepresent, nFactionTarget)
		SETCOLOR C_GRAY
	PRINTFORMLC [  1] 동맹을 제안한다
	RESETCOLOR
	SIF !GETBIT(FactionWarring:nFactionRepresent:nFactionTarget,2)
		SETCOLOR C_GRAY
	PRINTFORMLC [  4] - 동맹을 파기한다
	RESETCOLOR
	PRINTL
ENDIF
CALL PRINTLINE, "Deepen Frendship"
PRINTFORMLC [ 11] - 토론하기
PRINTFORMLC [ 12] - 병력 기부하기
;PRINTFORMLC [ 14] - Donate money
PRINTL
CALL PRINTLINE, "Demands"
PRINTFORMLC [ 20] - 항복 요구하기
PRINTFORMLC [ 21] - 병력 요구하기
SIF nFactionWar
	PRINTFORMLC [ 27] - 전쟁을 선포한다
PRINTFORMLC [ 28] - 공격
PRINTL
PRINTL
PRINTFORML [999] - 취소
INPUT
SELECTCASE RESULT
	CASE 0
		SIF !nFactionWar
			CONTINUE
		SIF !FactionTruceAble(nFactionRepresent, nFactionTarget)
			CONTINUE
		PRINTFORML %FactionName(nFactionTarget)%와 휴전을 선언하고 싶으신가요?
		CALL ASK_YN
		SIF !RESULT
			CALL FactionTreatyRecieve(nFactionRepresent, nFactionTarget,-1)
	CASE 1
		SIF !nFactionWar
			CONTINUE
		SIF !FactionAllianceAble(nFactionRepresent, nFactionTarget)
			CONTINUE
		PRINTFORML %FactionName(nFactionTarget)%와 동맹을 선언하고 싶나요?
		CALL ASK_YN
		IF !RESULT
			CALL FactionAllianceCheck(nFactionRepresent, nFactionTarget, "「Bypass RNG」")
			SIF !RESULT
				PRINTFORMW 불행하게도, 당신의 동맹 요청은 거절당했다.
		ENDIF
	CASE 4
		SIF !GETBIT(FactionWarring:nFactionRepresent:nFactionTarget,2)
			CONTINUE
		PRINTFORML %FactionName(nFactionTarget)%와의 동맹을 파기하고 싶습니까?
		PRINTFORML 당신은 더 이상 그들과 동맹 관계가 아닙니다.
		CALL ASK_YN
		IF !RESULT
			CALL FactionAllyLose(nFactionRepresent,nFactionTarget,-1)
		ENDIF
	CASE 11
		PRINTFORML 너는 %ANAME(FD_RECRUITER)%과의 관계를 개선하기로 결정했다.
		;PRINTFORML Traditionally, for entertainment, money or 「pleasure」 have been the way to go.
		PRINTFORML 둘 중 하나는 %ANAME(FD_RECRUITER)%에 대비해야 할 것이다...
		DRAWLINE
		; {
		; CALL ASK_MULTI_JUDGE(
		; 	@"Give money (Current funds:{MONEY:(CFLAG:MASTER:所属)})", 1,
		; 	"「Pleasure」", 1,
		; 	"Return", 1)
		; }
		CALL ASK_M( @"돈을 준다 (현재 자금: %金額表示(FactionWealth:nFactionRepresent)%)$$", 1, "반환", 1)
		SELECTCASE RESULT
			CASE 0
				CALL FACTION_DONATE_MENU(nFactionTarget, nFactionRepresent, "「No Withdraw」")
				;CASE 1
				;	CALL DIPLOMACY_TALK_SEX(提供先)
		ENDSELECT
	CASE 12
		CALL FACTION_DONATE_TROOPS_MENU(nFactionTarget, nFactionRepresent, "")
	CASE 20
		PRINTFORML 당신은 %FactionName(nFactionTarget)%에게 항복을 요구하고 싶습니까?
		CALL ASK_M( @"항복 요구 (위협도 {FactionThreatPoints(-1,nFactionRepresent)} / 필요 {FD_SURRENDER_PTS})", FactionThreatPoints(-1,nFactionRepresent) >= FD_SURRENDER_PTS, @"물러선다", 1 )
		SIF !RESULT
			CALL FactionDestroy(nFactionTarget, nFactionRepresent, 1)
	CASE 27
		SIF !nFactionWar
			CONTINUE
		PRINTFORML 어디를 상대로 전쟁을 선포하고 싶나요?
		CALL FACTION_AREA_LIST(nFactionTarget,1)
		PRINTL
		PRINTFORML [999] - 취소
		INPUT
		FD_RESULT = RESULT
		SELECTCASE RESULT
			CASE 999
				RESTART
			CASE 0 TO 20
				IF FactionWarringAreas:nFactionRepresent:nFactionTarget
					PRINTFORMW 이미 전쟁을 선포한 지역에는 전쟁을 선포할 수 없다.
					CONTINUE
				ENDIF
				PRINTFORML %FactionName(nFactionTarget)%에게 %GET_MAPNAME(FD_RESULT)%에서 전쟁을 선포하고 싶습니까?
				CALL ASK_YN()
				SIF !RESULT
					CALL FactionStartWar(nFactionRepresent,nFactionTarget,FD_RESULT)
		ENDSELECT
	CASE 28
		PRINTFORML 어디를 공격하고 싶습니까?
		CALL FACTION_AREA_LIST(nFactionTarget,1)
		PRINTL
		PRINTFORML [999] - 취소
		INPUT
		FD_RESULT = RESULT
		SELECTCASE RESULT
			CASE 999
				RESTART
			CASE 0 TO 20
				SIF !GET_EXISTMAP(FD_RESULT)
					CONTINUE
				DT_CLEAR "lcCombatants"
				PRINTFORML %GET_MAPNAME(FD_RESULT)%를 공격한다.
				IF SHIRAHU(MASTER)
					PRINTFORML 전투에 참가하고 싶습니까?
					CALL ASK_YN()
					SIF !RESULT
						CALL AddCombatantWithMessage(MASTER,0)
				ENDIF
				CALL FACTION_WAR_FIGHT(nFactionRepresent,nFactionTarget,FD_RESULT)
				SIF lcWarResult >= 0
					CALL FactionChangeRelation(nFactionTarget,nFactionRepresent,20000,0,1,1)
				WAIT
				RETURN
		ENDSELECT
	CASE 999
		RETURN 999
ENDSELECT
LOOP 1

