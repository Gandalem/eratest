@StoreFactionTitles(ARG,nFaction)
#FUNCTION
#DIM nFaction
VARSET FationTitleBefore
VARSET TempFactionFame
VARSET TempFactionInfamy
FOR LOCAL,0,MaxFactions
FationTitleBefore:LOCAL '= FACTION_RELATION_STRING(ARG,LOCAL)
TempFactionFame:LOCAL = FactionFameCompElse(ARG,LOCAL)
TempFactionInfamy:LOCAL = FactionInfamyCompElse(ARG,LOCAL)
NEXT

@CheckForFacitonTitleChanges(ARG,CFFTC_REASON)
#DIM nFaction
#DIM CFFTC_CHANGED
#DIMS CFFTC_REASON
#DIMS CFTTC_SPLIT, MaxFactions
VARSET FactionRelationChangedList
VARSET FactionRelationChangedListID
FOR LOCAL,0,MaxFactions
CFFTC_CHANGED = FationTitleBefore:LOCAL != FACTION_RELATION_STRING(ARG,LOCAL)
IF CFFTC_CHANGED
	FactionRelationChangedList += @"%FactionAbriv(LOCAL)%、"
	FactionRelationChangedListID += @"{LOCAL}、"
ENDIF
NEXT
IF FactionRelationChangedList != ""
	SETCOLOR C_ORANGE
	PRINTFORML \@ STRCOUNT(FactionRelationChangedList,"、") == 1 ? %LIST_IN_STRING(FactionRelationChangedList)%이 # %NUM_COUNT(STRCOUNT(FactionRelationChangedList,"、"),,1)% %PLNOUN("faction",STRCOUNT(FactionRelationChangedList,"、"))%가 가지고 있다 \@ %CALLNAME:ARG%의 관계가 %CFFTC_REASON%로 인해 변경되었다.
	RESETCOLOR
	SPLIT FactionRelationChangedListID, "、", CFTTC_SPLIT
	FOR LOCAL,0,MaxFactions
	SIF !STRLENS(CFTTC_SPLIT:LOCAL)
		BREAK
	PRINTFORM %FactionName(TOINT(CFTTC_SPLIT:LOCAL)),30,LEFT%:
	SELECTCASE TempFactionFame:(TOINT(CFTTC_SPLIT:LOCAL)) - TempFactionInfamy:(TOINT(CFTTC_SPLIT:LOCAL))
		CASE IS > 0
			SETCOLOR Color_Gradient_PER(GETCONFIG("TEXT COLOR"),C_GREEN,MIN(TempFactionFame:(TOINT(CFTTC_SPLIT:LOCAL))/1000,100))
		CASE IS < 0
			SETCOLOR Color_Gradient_PER(GETCONFIG("TEXT COLOR"),C_D_RED,MIN(TempFactionInfamy:(TOINT(CFTTC_SPLIT:LOCAL))/1000,100))
	ENDSELECT
	PRINTFORM 【%FationTitleBefore:(TOINT(CFTTC_SPLIT:LOCAL))%】
	RESETCOLOR
	PRINTFORM  ->
	SELECTCASE FactionRelationCompElse(ARG,(TOINT(CFTTC_SPLIT:LOCAL)))
		CASE IS > 0
			SETCOLOR Color_Gradient_PER(GETCONFIG("TEXT COLOR"),C_GREEN,MIN(FactionFameCompElse(ARG,(TOINT(CFTTC_SPLIT:LOCAL)))/1000,100))
		CASE IS < 0
			SETCOLOR Color_Gradient_PER(GETCONFIG("TEXT COLOR"),C_D_RED,MIN(FactionInfamyCompElse(ARG,(TOINT(CFTTC_SPLIT:LOCAL)))/1000,100))
	ENDSELECT
	PRINTFORM 【%FACTION_RELATION_STRING(ARG,TOINT(CFTTC_SPLIT:LOCAL))%】
	RESETCOLOR
	PRINTL
	NEXT
	FORCEWAIT
ENDIF

@JoinFaction(ARG,nFaction,isResign=0)
#DIM nFaction
#DIM isResign
CALLF StoreFactionTitles(ARG,nFaction)
IF isResign
	FactionRank:ARG:nFaction = 0
ELSE
	FactionRank:ARG:nFaction = 1
	SKIPDISP 1
	CALL FactionRankLevelingUp(ARG,nFaction,1)
	SKIPDISP 0
ENDIF
CALL CheckForFacitonTitleChanges(ARG,@"당신의 \@ isResign ? 새로운 연합으로부터의 사임 # 새로운 연합과의 관계 \@ %FactionAbriv(nFaction)%")

@FactionThreatPoints(ARG=-1,nFaction)
#FUNCTION
#DIM nFaction
#DIM DYNAMIC FTP = 0
;unit
FTP += (1*LIMIT(FactionUnits:nFaction:1/3,0,15000)) ;junior
FTP += (1*LIMIT(FactionUnits:nFaction:2/3,0,15000)) ;member
FTP += (2*LIMIT(FactionUnits:nFaction:3/3,0,15000)) ;senior
FTP += (25*LIMIT(FactionUnits:nFaction:4/3,0,1500)) ;officer
FTP += (100*LIMIT(FactionUnits:nFaction:5/3,0,1500)) ;officer
FTP += (300*LIMIT(FactionUnits:nFaction:6,0,3)) ;leader
;wealth
FTP += (LIMIT(FactionWEalth:nFaction/3000,0,15000))
;technical
SELECTCASE FactionTech:nFaction
	CASE 0
		TIMES FTP, 0.3
	CASE 1
		TIMES FTP, 0.4
	CASE 2
		TIMES FTP, 0.5
	CASE 3
		TIMES FTP, 0.75
	CASE 4
		TIMES FTP, 0.9
	CASE 5
		TIMES FTP, 1
	CASE 6
		TIMES FTP, 1.4
	CASE 7
		TIMES FTP, 1.7
	CASEELSE
		TIMES FTP, 2
ENDSELECT
;infamy
IF ARG > -1
	SELECTCASE FactionRelationCompElse(ARG,nFaction)
		CASE IS <= -15000
			TIMES FTP, 0.3
		CASE IS <= -25000
			TIMES FTP, 0.5
		CASE IS <= -50000
			TIMES FTP, 0.8
		CASE IS <= -75000
		CASEELSE
			RETURNF 0
	ENDSELECT
ENDIF
RETURNF FTP

@FactionThreatPrint(ARG,nFaction)
#DIM nFaction
SELECTCASE FactionThreatPoints(ARG,nFaction) - IntimidationFactor(ARG)
	CASE IS >= 30000
		SETCOLOR C_P_PURPLE
		LOCALS '= "위험"
	CASE IS >= 10000
		SETCOLOR C_D_RED
		LOCALS '= "극심"
	CASE IS >= 8000
