@FactionDestroyCheck(FactionbBeDestroy = -1, FactionDestroyer = -1)
#DIM DYNAMIC FactionbBeDestroy
#DIM DYNAMIC FactionDestroyer
;already destroyed
SIF FactionDisabled:FactionbBeDestroy == 1
	RETURN 0
;EZB
SIF SaveIsEZB
	RETURN 0
;unknown
SIF FactionDestroyer == -1
	RETURN 0
;remaining officer
SIF FactionUnits:FactionbBeDestroy:6 > 0 || FactionUnits:FactionbBeDestroy:5 > 0 || FactionUnits:FactionbBeDestroy:4 > 0
	RETURN 0
;has control
FOR LOCAL,0,20
;map doesns't exist
SIF !GET_EXISTMAP(LOCAL)
	CONTINUE
SIF FactionAreaControl:FactionbBeDestroy:LOCAL > 0
	RETURN 0
NEXT
CALL FactionDestroy(FactionbBeDestroy, FactionDestroyer)
RETURN 1

@FactionDestroy(FactionbBeDestroy=-1, FactionDestroyer=-1, isSurrender = 0)
#DIM DYNAMIC FactionbBeDestroy
#DIM DYNAMIC FactionDestroyer
#DIM DYNAMIC FD_RESEARCH_BE
#DIM DYNAMIC FD_RESEARCH_DE
#DIM DYNAMIC isSurrender
VARSET FD_RESEARCH_BE
VARSET FD_RESEARCH_DE
IF FactionDestroyer == -1
	; [AUTO-NEUTRALIZED] DEBUGPRINTFORML @FactionDestroy 오류: 정의되지 않은 점령자가 있는 파벌을 파괴할 수 없습니다.
	RETURN
ELSE
ENDIF
IF isSurrender
	SETCOLOR C_RED
	CALL FactionColorName(MASTER,FactionbBeDestroy)
	SETCOLOR C_RED
	PRINTFORM  항복했다
	CALL FactionColorName(MASTER,FactionDestroyer)
	SETCOLOR C_RED
	PRINTFORML !
ELSE
	SETCOLOR C_RED
	CALL FactionColorName(MASTER,FactionbBeDestroy)
	SETCOLOR C_RED
	PRINTFORM  패배했다
	CALL FactionColorName(MASTER,FactionDestroyer)
	SETCOLOR C_RED
	PRINTFORML  모든 지도자와 영토를 파괴했기 때문에!
ENDIF
PRINTFORM 모든 자산들로부터
CALL FactionColorName(MASTER,FactionbBeDestroy)
SETCOLOR C_RED
PRINTFORM  ~에 의해 가져가졌다
CALL FactionColorName(MASTER,FactionDestroyer)
PRINTFORML !
;units
FOR LOCAL,0,VARSIZE("FactionUnits",1)
FactionUnits:FactionDestroyer:LOCAL += FactionUnits:FactionbBeDestroy:LOCAL
NEXT
;wealth
FactionWealth:FactionDestroyer += FactionWealth:FactionbBeDestroy
FOR LOCAL,0,DT_ROW_LENGTH("ResearchProject")
SIF RESEARCH_DONE(FactionDestroyer,DT_CELL_GETS("ResearchProject",LOCAL,"defName"))
	CONTINUE
SIF !FACTION_RESEARCH_PROGRESS(FactionbBeDestroy,DT_CELL_GETS("ResearchProject",LOCAL,"defName"))
	CONTINUE
FD_RESEARCH_DE = FACTION_RESEARCH(FactionDestroyer, DT_CELL_GETS("ResearchProject",LOCAL,"defName"))
FD_RESEARCH_BE = FACTION_RESEARCH(FactionbBeDestroy,DT_CELL_GETS("ResearchProject",LOCAL,"defName"))
IF !FD_RESEARCH_DE
	DT_ROW_ADD @"ResearchProgress", "defName", @"%DT_CELL_GETS("ResearchProject",LOCAL,"defName")%", "progress", FACTION_RESEARCH_PROGRESS(FactionbBeDestroy,DT_CELL_GETS("ResearchProject",LOCAL,"defName")), "researched", 0, "faction", FactionDestroyer,
	FD_RESEARCH_DE = RESULT
	CONTINUE
ENDIF
DT_CELL_SET "ResearchProgress", FD_RESEARCH_DE, "progress", LIMIT(DT_CELL_GET("ResearchProgress",FD_RESEARCH_DE, "progress",1)+DT_CELL_GET("ResearchProgress",FD_RESEARCH_BE, "progress",1),0,DT_CELL_GET("ResearchProject",LOCAL, "baseCost")), 1
NEXT
FactionDisabled:FactionbBeDestroy = 1
WAIT

@FACTION_TREASURY_DAILY(nFaction)
