@FactionFameComp2(ARG,FR_Faction:0,FR_Faction:1)
#FUNCTION
#DIM DYNAMIC FR_Faction,2
#DIM DYNAMIC FR_FactionPoints
FR_FactionPoints = FactionFame:ARG:(FR_Faction:0)
;association current faction
;gives interpretation by other faction.
IF FactionRank:ARG:(FR_Faction:0)
	FR_FactionPoints += (FactionTeamFame:(FR_Faction:1):(FR_Faction:0)*FACTION_RANK_ASSOCIATION_MULT(FactionRank:ARG:(FR_Faction:0))/100)
ELSE
	FR_FactionPoints += FactionNonMemberFame:(FR_Faction:0)
ENDIF
IF FactionRank:ARG:(FR_Faction:1)
	FR_FactionPoints += (FactionTeamFame:(FR_Faction:0):(FR_Faction:1)*FACTION_RANK_ASSOCIATION_MULT(FactionRank:ARG:(FR_Faction:1))/100)
ENDIF
RETURNF FR_FactionPoints

@FactionInfamyComp2(ARG,FR_Faction:0,FR_Faction:1)
#FUNCTION
#DIM DYNAMIC FR_Faction,2
#DIM DYNAMIC FR_FactionPoints
FR_FactionPoints = FactionInfamy:ARG:(FR_Faction:0)
;association current faction
;gives interpretation by other faction.
IF FactionRank:ARG:(FR_Faction:0)
	FR_FactionPoints += (FactionTeamInfamy:(FR_Faction:1):(FR_Faction:0)*FACTION_RANK_ASSOCIATION_MULT(FactionRank:ARG:(FR_Faction:0))/100)
ELSE
	FR_FactionPoints += FactionNonMemberInfamy:(FR_Faction:0)
ENDIF
IF FactionRank:ARG:(FR_Faction:1)
	FR_FactionPoints += (FactionTeamInfamy:(FR_Faction:0):(FR_Faction:1)*FACTION_RANK_ASSOCIATION_MULT(FactionRank:ARG:(FR_Faction:1))/100)
ENDIF
RETURNF FR_FactionPoints

@FactionRelationComp2(ARG,FR_Faction:0,FR_Faction:1)
#FUNCTION
#DIM DYNAMIC FR_Faction,2
#DIM DYNAMIC FR_FactionPoints
FR_FactionPoints = FactionFameComp2(ARG,FR_Faction:0,FR_Faction:1)
FR_FactionPoints -= FactionInfamyComp2(ARG,FR_Faction:0,FR_Faction:1)
RETURNF FR_FactionPoints
