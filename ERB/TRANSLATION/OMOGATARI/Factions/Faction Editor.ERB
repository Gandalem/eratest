@FACTION_EDITOR_PAGE_0(ARG,CHEAT)
#DIM CHEAT
PRINTBUTTON @"[%FactionAbbreviation:ARG,6,LEFT%] ", 801
PRINTBUTTON @"%FactionNames:ARG%", 800
PRINTL
PRINTL
PRINTBUTTON @"%"Name",15,LEFT%: %FactionNames:ARG%", 800
PRINTL
PRINTBUTTON @"%"Tag",15,LEFT%: %FactionAbbreviation:ARG%", 801
PRINTL
PRINTBUTTON @"%"Member Name",15,LEFT%: %FactionMemberName:ARG%", 803
PRINTL
PRINTBUTTON @"%"Faction Disabled",15,LEFT%: %YesOrNo(FactionDisabled:ARG)%", 804
PRINTL

@FACTION_EDITOR_RESULT_0(ARG, CHEAT, nInput)
#DIM CHEAT
#DIM nInput
SELECTCASE nInput
CASE 800
	PRINTFORML Input a name that is less than 30 characters long
	PRINTBUTTON @"[Cancel] ", "[GOODBYECRUELWORLD]"
	PRINTL
	INPUTS
	IF !STRLENS(RESULTS)
		PRINTFORMW Faction name cannot be blank.
		RESTART
	ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
		RETURN
	ELSEIF STRLENS(RESULTS) > 30
		PRINTFORMW Faction name is longer than 30 characters.
		RESTART
	ELSE
		PRINTFORML Accepted.
		PRINTFORMW Faction name is now %RESULTS%
		FactionNames:ARG '= RESULTS
	ENDIF
CASE 801
	PRINTFORML Input an abbreviation that is less than 6 characters long
	PRINTBUTTON @"[Cancel] ", "[GOODBYECRUELWORLD]"
	PRINTL
	INPUTS
	IF !STRLENS(RESULTS)
		PRINTFORMW Abbreviation cannot be blank.
		RESTART
	ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
		RETURN
	ELSEIF STRLENS(RESULTS) > 6
		PRINTFORMW Abbreviation is longer than 6 characters.
		RESTART
	ELSE
		PRINTFORML Accepted.
		PRINTFORMW Abbreviation is now [%RESULTS,6,LEFT%]
		FactionAbbreviation:ARG '= RESULTS
	ENDIF
CASE 803
	PRINTFORML Input a general term for your members that is less than 15 characters long
	PRINTBUTTON @"[Cancel] ", "[GOODBYECRUELWORLD]"
	PRINTL
	INPUTS
	IF !STRLENS(RESULTS)
		PRINTFORMW Abbreviation cannot be blank.
		RESTART
	ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
		RETURN
	ELSEIF STRLENS(RESULTS) > 15
		PRINTFORMW Member term is longer than 15 characters.
		RESTART
	ELSE
		PRINTFORML Accepted.
		PRINTFORMW Member term is now %RESULTS%
		FactionMemberName:ARG '= RESULTS
	ENDIF
CASE 804
    FactionDisabled:ARG = !FactionDisabled:ARG
ENDSELECT

