@FACTION_EDITOR_PAGE_2(ARG,CHEAT)
#DIM FE_UNITS,100
#DIM FE_COUNT
#DIM FE_UNIT
#DIM E_ID
#DIM CHEAT
PRINTFORML [100] 기술 능력: %AllTechLevels(FactionTech:ARG)%
PRINTL
PRINTFORML [200] 부유함: %金額表示(FactionWealth:ARG),8%
CALL RESEARCH_MENU(ARG,CHEAT,"「Ability Listing」",RT_TAB)

@FACTION_EDITOR_RESULT_2(ARG, CHEAT, nInput)
#DIM CHEAT
#DIM nInput
SELECTCASE nInput
	CASE 100
		PRINTFORML 해당 세력이 어떤 기술 수준에 있는지 선택한다.
		FOR LOCAL,0,nMaxTech+1
		PRINTBUTTON "["+AllTechLevels(LOCAL)+"]", LOCAL
		PRINTL
		NEXT
		PRINTL
		PRINTFORML [-1] 취소
		INPUT
		SELECTCASE RESULT
			CASE IS < 0
				RETURN
			CASE 0 TO nMaxTech
				PRINTFORML 기술 수준은 이제 %AllTechLevels(RESULT)%이다.
				FactionTech:ARG = RESULT
				CALL CLEAR_FACTION_RESEARCH(ARG)
				CALL COMPLETE_RESEARCH_PREVIOUS(ARG)
		ENDSELECT
	CASE 200
		PRINTFORML 부의 변경 (%金額表示(FactionWealth:ARG)% 현재)
		PRINTL
		PRINTFORML [-1] 취소
		INPUT
		SELECTCASE RESULT
			CASE -1
				RETURN
			CASEELSE
				PRINTFORMW 부는 이제 %金額表示(RESULT)%이다.
				SIF RESULT < 0
					PRINTFORMW 이것은 파벌에게 부채를 지게 할 것이다! 
				FactionWealth:ARG = RESULT
		ENDSELECT
	CASE IS >= 60000000
		CALL RESEARCH_INPUT(nInput,ARG,CHEAT)
	CASE 2 TO VARSIZE("FactionTableTabs")+95000
		RT_TAB = nInput-95000
ENDSELECT
