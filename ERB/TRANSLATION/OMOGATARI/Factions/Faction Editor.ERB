@FACTION_EDITOR_PAGE_1(ARG,CHEAT)
#DIM FE_UNITS,100
#DIM FE_COUNT
#DIM FE_UNIT
#DIM E_ID
#DIM CHEAT
FE_COUNT = DT_SELECT("FactionUnits", @"faction = {ARG}", "",FE_UNITS)
FOR FE_UNIT,0,FE_COUNT
    CALL PRINTLINE, @"Unit {FE_UNIT}"
    PRINTFORML %DT_CELL_GETS(@"FactionUnits", FE_UNITS:FE_UNIT, "unit name",1)%
    PRINTFORML Rank: %FACTION_RANK_STRING_INDE(ARG,DT_CELL_GET(@"FactionUnits", FE_UNITS:FE_UNIT, "rank",1))%
    PRINTFORML Race: %RACE_TR(DT_CELL_GETS(@"FactionUnits", FE_UNITS:FE_UNIT, "race",1))%
    PRINTFORML STA: {DT_CELL_GET(@"FactionUnits", FE_UNITS:FE_UNIT, "hp",1)-500}
    PRINTFORML Combat Level: {DT_CELL_GET(@"FactionUnits", FE_UNITS:FE_UNIT, "combat level",1)}
    PRINTFORML Desired Weapon: %DT_CELL_GETS(@"FactionUnits", FE_UNITS:FE_UNIT, "desired weapon",1)%
    FOR LOCAL,0,25
        SIF GROUPMATCH(LOCAL,10)
            CONTINUE
        E_ID = DT_CELL_GET(@"FactionUnits", FE_UNITS:FE_UNIT, @"equip {LOCAL}",1)
        SIF !E_ID
            CONTINUE
        SELECTCASE LOCAL
        CASE 24
        PRINTFORML Weapon: %UNDIES_NAME_WITH_BRAND(CSV_CHARANUM(),E_ID,1,LOCAL)%
        CASEELSE
        PRINTFORML %表示ラベル:LOCAL%: %CLOTHNAME(LOCAL,E_ID)%
        ENDSELECT
    NEXT
    SETCOLOR C_YELLOW
    PRINTFORML Raid Point Cost: {RaidPointCost(FE_UNITS:FE_UNIT)}pts
    RESETCOLOR
    PRINTBUTTON "[Edit Unit]", FE_UNITS:FE_UNIT
    PRINTL
NEXT
DRAWLINE
FOR LOCAL:1,1,7
    IF LOCAL:1 == 6 && !FactionUnits:ARG:(LOCAL:1)
        SETCOLOR C_RED
    ENDIF
    IF CHEAT
    PRINTFORML [{LOCAL:1,3}] - %FACTION_RANK_STRING_INDE(ARG,LOCAL:1),15,LEFT%: %PALAM_NUM_NAS(FactionUnits:ARG:(LOCAL:1))%
    ELSE
    PRINTPLAINFORM %FACTION_RANK_STRING_INDE(ARG,LOCAL:1),15,LEFT%: %PALAM_NUM_NAS(FactionUnits:ARG:(LOCAL:1))%
    PRINTL
    ENDIF
    RESETCOLOR
NEXT
PRINTFORML [850] - New Unit

@FACTION_EDITOR_RESULT_1(ARG, CHEAT, nInput)
#DIM CHEAT
#DIM nInput, 2

SELECTCASE nInput
CASE IS >= 600000000000000000
    CALL FACTION_UNIT_EDIT(nInput, CHEAT)
CASE 850
		{
		DT_ROW_ADD @"FactionUnits",
		"faction", ARG,
		"unit name", @"New %FactionAbriv(ARG)% Unit",
		"race", "町娘",
		"hp", 2000,
		"rank", 1,
		"combat level", 0,
		}
    CALL FACTION_UNIT_EDIT(RESULT, CHEAT)
CASE 1 TO 6
    SIF !CHEAT
        RETURN
    PRINTFORML Changing %FACTION_RANK_STRING_INDE(ARG,nInput)% unit count (currently %PALAM_NUM_NAS(FactionUnits:ARG:nInput)%)
    PRINTL
    PRINTFORML [-1] - Cancel
    INPUT
    nInput:1 = RESULT
    SELECTCASE RESULT
    CASE -1
        RETURN
    CASE IS < 0
        PRINTFORMW Unit count must be over 0!
    CASEELSE
    PRINTFORMW %FACTION_RANK_STRING_INDE(ARG,nInput)% count is now %PALAM_NUM_NAS(nInput:1)%
    FactionUnits:ARG:(nInput) = nInput:1
    ENDSELECT
ENDSELECT

@FACTION_UNIT_EDIT(ARG, CHEAT)
#DIM CHEAT
#DIM nInput
#DIM FUE_LINECOUNT
#DIM FUE_FACTION
#DIM FUE_RANK
#DIM FUE_COST
#DIM FUE_LEVEL
#DIMS nInputs
FUE_LINECOUNT = LINECOUNT
$REPRINT
FUE_FACTION = DT_CELL_GET(@"FactionUnits", ARG, "faction",1)
FUE_RANK = DT_CELL_GET(@"FactionUnits", ARG, "rank",1)
FUE_COST = RaidPointCost(ARG)
FUE_LEVEL = DT_CELL_GET(@"FactionUnits", ARG, "combat level",1)
CLEARLINE LINECOUNT-FUE_LINECOUNT
DRAWLINE
PRINTFORML Editing %DT_CELL_GETS(@"FactionUnits", ARG, "unit name",1)%
DRAWLINE
PRINTFORML [100] - Name: %DT_CELL_GETS(@"FactionUnits", ARG, "unit name",1)%
PRINTFORML [110] - Max Stamina: {DT_CELL_GET(@"FactionUnits", ARG, "hp",1)-500}
PRINTFORML [111] - Rank: %Faction_rank_string_inde(FUE_FACTION,FUE_RANK)%
PRINTFORM [112] - Combat Level: 
CALL PRINT_RANK(RANK_TO_LEVEL(FUE_LEVEL),"MAX_6")
PRINTFORML  {FUE_LEVEL}
PRINTFORML [150] - Race: %RACE_TR(DT_CELL_GETS(@"FactionUnits", ARG, "race",1))%
PRINTL
PRINTFORML [400] - Desired Weapon: %DT_CELL_GETS(@"FactionUnits", ARG, "desired weapon",1)%
PRINTFORML [410] - Equipment config
PRINTL
SETCOLOR C_YELLOW
PRINTFORML Raid Point Cost: {FUE_COST}pts
RESETCOLOR
PRINTL
PRINTFORML [980] - DELETE UNIT
PRINTFORML [999] - Leave Unit Editor
DO
    INPUT
    nInput = RESULT
    SELECTCASE nInput
    CASE 100
    PRINTFORML This is a general name your unit will have
	PRINTFORML Input a name that is less than 30 characters long
	PRINTBUTTON @"[Cancel] ", "[GOODBYECRUELWORLD]"
	PRINTL
	INPUTS
	IF !STRLENS(RESULTS)
		PRINTFORMW Unit name cannot be blank.
		RESTART
	ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
		CONTINUE
	ELSEIF STRLENS(RESULTS) > 30
		PRINTFORMW Unit name is longer than 30 characters.
		RESTART
	ELSE
		PRINTFORML Accepted.
		PRINTFORMW Unit name is now %RESULTS%
		DT_CELL_SET @"FactionUnits", ARG, "unit name", RESULTS,1
	ENDIF
    CASE 110
    gLineCount = LINECOUNT
    LOCAL:5 = RaidPointCost(ARG)
    LOCAL:6 = DT_CELL_GET(@"FactionUnits", ARG, "hp",1)
    DO
        CLEARLINE LINECOUNT-gLineCount
        PRINTFORM Enter a stamina value over 0 
        PRINTFORML (Max HP for %FACTION_RANK_STRING_INDE(DT_CELL_GET(@"FactionUnits", ARG, "faction",1),DT_CELL_GET(@"FactionUnits", ARG, "rank",1))%: {FACTION_MAX_HP(DT_CELL_GET(@"FactionUnits", ARG, "faction",1),DT_CELL_GET(@"FactionUnits", ARG, "rank",1))-500})
        PRINTFORML Every 20 STA points over 1500 cost 1 raid point.
        PRINTL
        PRINTBUTTON "[1000]", 1000
        PRINTBUTTON " [1500]", 1500
        PRINTBUTTON " [2000]", 2000
        PRINTBUTTON " [2500]", 2500
        PRINTBUTTON " [3000]", 3000
        PRINTBUTTON " [3500]", 3500
        PRINTBUTTON " [4000]", 4000
        PRINTL
        PRINTBUTTON "[Cancel]", -1
        INPUT
        LOCAL:2 = RESULT
        SELECTCASE RESULT
        CASE -1
            BREAK
        CASE IS <= 0
            PRINTFORMW Stamina is below 0!
        CASE IS > FACTION_MAX_HP(DT_CELL_GET(@"FactionUnits", ARG, "faction",1),DT_CELL_GET(@"FactionUnits", ARG, "rank",1))-500
            PRINTFORMW Stamina is above rank cap ({FACTION_MAX_HP(DT_CELL_GET(@"FactionUnits", ARG, "faction",1),DT_CELL_GET(@"FactionUnits", ARG, "rank",1))-500})!
        CASEELSE
            DT_CELL_SET @"FactionUnits", ARG, "hp", LOCAL:2+500 ,1
            PRINTFORML \@ LOCAL:2+500 > LOCAL:6 ? Increasing # Decreasing\@ health from {LOCAL:6} to {LOCAL:2+500}
            PRINTFORML Raid Point Cost: {LOCAL:5} -> {RaidPointCost(ARG)}
            PRINTFORML Do you want to keep these changes?
            CALL ASK_YN
            SELECTCASE RESULT
            CASE 0
            BREAK
            CASE 1
            DT_CELL_SET @"FactionUnits", ARG, "hp", LOCAL:6,1
            ENDSELECT
        ENDSELECT
    LOOP 1
    CASE 111
    gLineCount = LINECOUNT
    DO
        CLEARLINE LINECOUNT-gLineCount
        PRINTFORML Rank gives a boost to combat techniques and increases caps on STA and combat rank 
        PRINTFORML However, higher rank units are harder to come by and cost more raid points
        PRINTL
        FOR LOCAL,1,7
        PRINTBUTTON @"[%Faction_rank_string_inde(FUE_FACTION,LOCAL)% (%PALAM_NUM_NAS(FactionUnits:FUE_FACTION:LOCAL)% left)]", LOCAL
        NEXT
        PRINTL
        PRINTBUTTON "[Cancel]", -1
        INPUT
        LOCAL:2 = RESULT
        SELECTCASE RESULT
        CASE -1
            BREAK
        CASE IS <= 0
            PRINTFORMW Rank is below 0!
        CASE IS > 6
            PRINTFORMW There is no better rank than %Faction_rank_string_inde(FUE_FACTION,6)%!
        CASEELSE
            DT_CELL_SET @"FactionUnits", ARG, "rank", LOCAL:2 ,1
            PRINTFORML \@ LOCAL:2 > FUE_RANK ? Promoting # Demoting\@ from %Faction_rank_string_inde(FUE_FACTION,FUE_RANK)% to %Faction_rank_string_inde(FUE_FACTION,LOCAL:2)% (%PALAM_NUM_NAS(FactionUnits:FUE_FACTION:(LOCAL:2))% left)
            PRINTFORML Raid Point Cost: {FUE_COST} -> {RaidPointCost(ARG)}
            PRINTFORML Max STA: {FACTION_MAX_HP(FUE_FACTION,FUE_RANK)} -> {FACTION_MAX_HP(FUE_FACTION,LOCAL:2)}
            PRINTFORM Max Combat Level: 
		    CALL PRINT_RANK(RANK_TO_LEVEL(FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)),"MAX_6")
            PRINTFORM {FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)} -> 
		    CALL PRINT_RANK(RANK_TO_LEVEL(FACTION_MAX_LEVEL(FUE_FACTION,LOCAL:2)),"MAX_6")
            PRINTFORML  {FACTION_MAX_LEVEL(FUE_FACTION,LOCAL:2)}
            PRINTFORML Do you want to keep these changes?
            CALL ASK_YN
            SELECTCASE RESULT
            CASE 0
            DT_CELL_SET @"FactionUnits", ARG, "hp", MIN(DT_CELL_GET(@"FactionUnits", ARG, "hp",1),FACTION_MAX_HP(FUE_FACTION,LOCAL:2)),1
            DT_CELL_SET @"FactionUnits", ARG, "combat level", MIN(DT_CELL_GET(@"FactionUnits", ARG, "combat level",1),FACTION_MAX_LEVEL(FUE_FACTION,LOCAL:2)),1
            BREAK
            CASE 1
            DT_CELL_SET @"FactionUnits", ARG, "rank", FUE_RANK,1
            ENDSELECT
        ENDSELECT
    LOOP 1
    CASE 112
    gLineCount = LINECOUNT
    DO
        CLEARLINE LINECOUNT-gLineCount
        PRINTFORM Enter a combat level 0 or higher
        PRINTFORM (Max level for %FACTION_RANK_STRING_INDE(FUE_FACTION,FUE_RANK)%: 
		CALL PRINT_RANK(RANK_TO_LEVEL(FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)),"MAX_6")
        PRINTFORML  {FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)})
        PRINTL
        FOR LOCAL,0,FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)+1
            CALL PRINT_RANK(RANK_TO_LEVEL(LOCAL),"MAX_6")
            PRINTBUTTON @" {LOCAL}", LOCAL
            PRINTFORML
        NEXT
        PRINTL
        PRINTBUTTON "[Cancel]", -1
        INPUT
        LOCAL:2 = RESULT
        SELECTCASE RESULT
        CASE -1
            BREAK
        CASE IS < 0
            PRINTFORMW Combat level can't be below 0!
        CASE IS > 10
            PRINTFORMW There is no higher level than level 10!
        CASE IS > FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)
            PRINTFORMW Combat level is above rank cap ({FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)})!
        CASEELSE
            DT_CELL_SET @"FactionUnits", ARG, "combat level", LOCAL:2 ,1
            PRINTFORML \@ LOCAL:2 > FUE_LEVEL ? Increasing # Decreasing \@ level from {FUE_LEVEL} to {LOCAL:2}
            PRINTFORML Raid Point Cost: {FUE_COST} -> {RaidPointCost(ARG)}
            PRINTFORM Combat Level: 
		    CALL PRINT_RANK(RANK_TO_LEVEL(FUE_LEVEL),"MAX_6")
            PRINTFORM {FUE_LEVEL} -> 
		    CALL PRINT_RANK(RANK_TO_LEVEL(LOCAL:2),"MAX_6")
            PRINTFORML  {LOCAL:2}
            PRINTFORML Do you want to keep these changes?
            CALL ASK_YN
            SELECTCASE RESULT
            CASE 0
            BREAK
            CASE 1
            DT_CELL_SET @"FactionUnits", ARG, "combat level", FUE_LEVEL,1
            ENDSELECT
        ENDSELECT
    LOOP 1
    CASE 150
        PRINTFORML Please select from the list below.
        PRINTBUTTON "[Village Girl] ", "町娘"
        PRINTBUTTON "[Married Woman] ", "人妻"
        PRINTBUTTON "[Fairy] ", "妖精"
        PRINTBUTTON "[Fairy Maid] ", "メイド妖精"
        PRINTBUTTON "[Zombie Fairy] ", "ゾンビフェアリー"
        PRINTBUTTON "[Kappa] ", "河童"
        PRINTBUTTON "[White Wolf Tengu] ", "白狼天狗"
        PRINTBUTTON "[Rabbit] ", "イナバ"
        PRINTBUTTON "[Moon Rabbit] ", "玉兎"
        PRINTBUTTON "[Oni] ", "鬼"
        PRINTBUTTON "[Tanuki] ", "化け狸"
        PRINTBUTTON "[Kitsune] ", "化け狐"
        PRINTBUTTON "[Bakeneko] ", "化け猫"
	    PRINTBUTTON @"[Cancel] ", "[GOODBYECRUELWORLD]"
        INPUTS
        nInputs '= RESULTS
        SELECTCASE nInputs
        CASE "[GOODBYECRUELWORLD]"
        CASEELSE
        IF RACE_TR(nInputs) == nInputs
            PRINTFORMW This race doesn't exist!
            GOTO REPRINT
        ENDIF
        PRINTFORMW Accepted. Race changed to %RACE_TR(nInputs)%
        DT_CELL_SET @"FactionUnits", ARG, "race", nInputs,1
        ENDSELECT
    CASE 980
        PRINTFORML Are you sure you want to delete this unit?
        PRINTFORML You will be unable to recover it.
        CALL ASK_YN()
        SELECTCASE RESULT
        CASE 0
            PRINTFORMW Unit deleted.
            DT_ROW_REMOVE "FactionUnits", ARG 
            RETURN
        CASE 1
        ENDSELECT
    CASE 400
        CALL PREF_WEAPON_SELECT(ARG)
    CASE 410
        CALL UNIT_EQUIP_CONFIG(ARG)
    CASE 999
        RETURN
    ENDSELECT
    BREAK
LOOP 1
GOTO REPRINT

;Desired Weapon
@PREF_WEAPON_SELECT(ARG)
#DIMS SELECTION_OFFERING, 200
#DIMS TEMP_SPLIT, 200
#DIM DYNAMIC SELECTION_INT
#DIMS CONST PFS_INT_TABS = "TYPE", "CLASS", "TECH", "CALIBER", "BRAND", "OTHER"
#DIMS CONST PFS_TABS = "Types", "Class", "Technical Level", "Caliber", "Brands", "Other"
#DIM DYNAMIC PFS_PAGE
#DIM DYNAMIC PFS_COUNT
#DIM CONST PFS_PADDING = 30
#DIM PFS_SIZE, 2
#DIMS DYNAMIC PFS_HTML
#DIM PFS_RESULT
#DIM PFS_LINECOUNT
#DIM PFS_CHANGING
#DIM PFS_WEAPS
#DIMS PFS_WEAPS_IDS
#DIMS PFS_WEAPS_ID_SPLIT,200
#DIMS PFS_WEAPS_NAMES,2000
#DIM PFS_WEAPS_POINTS,2000

FOR LOCAL,0,VAR_TEMP_MAX*2
    PFS_WEAPS_NAMES:LOCAL '= PrintWeaponName(0,LOCAL,1,2)
    PFS_WEAPS_POINTS:LOCAL = WeaponRaidPointCost(DT_CELL_GET(@"FactionUnits", ARG, "faction",1),LOCAL)
NEXT

gLinecount = LINECOUNT
DO
    CLEARLINE LINECOUNT - gLineCount
    VARSET SELECTION_OFFERING
    VARSET SELECTION_INT
    VARSET PFS_COUNT
    VARSET TEMP_SPLIT
    VARSET PFS_WEAPS_ID_SPLIT
    PRINTL Desired weapon selection
    DRAWLINE
    PFS_WEAPS = MakeDesiredWeapon(DT_CELL_GETS(@"FactionUnits", ARG, "desired weapon",1),1,ARG, "Weapon")
    PFS_WEAPS_IDS '= RESULTS
    IF !PFS_WEAPS
        PRINTFORML Your weapon selection found no weapons!
    ELSE
        PRINTFORML Your selection returned %NUM_COUNT(PFS_WEAPS)% ({PFS_WEAPS}) weapons.
        SPLIT PFS_WEAPS_IDS, "/", PFS_WEAPS_ID_SPLIT
        VARSET PFS_COUNT
        FOR LOCAL,0,VARSIZE("PFS_WEAPS_ID_SPLIT")
            SIF !TOINT(PFS_WEAPS_ID_SPLIT:LOCAL) && !TOINT(PFS_WEAPS_ID_SPLIT:(LOCAL+1))
                BREAK
            PRINTFORM %PFS_WEAPS_NAMES:(TOINT(PFS_WEAPS_ID_SPLIT:LOCAL))+@" ({PFS_WEAPS_POINTS:(TOINT(PFS_WEAPS_ID_SPLIT:LOCAL))}pts)",PFS_PADDING,LEFT%
            PFS_COUNT ++
            SIF PFS_COUNT % (MAXWIDTH()/PFS_PADDING)
                CONTINUE
            PRINTL
            VARSET PFS_COUNT
        NEXT
        SIF PFS_COUNT % (MAXWIDTH()/PFS_PADDING)
            PRINTL
        VARSET PFS_COUNT
    ENDIF
    DRAWLINE
    SELECTCASE PFS_PAGE
    CASEELSE
        FOR LOCAL,0,VAR_TEMP_MAX
            SPLIT WEAP_TOTAL_TAGS(MASTER,LOCAL), "/", TEMP_SPLIT
            FOR LOCAL:1,0,VARSIZE("SELECTION_OFFERING")
                SIF !STRLENS(TEMP_SPLIT:(LOCAL:1)) || TEMP_SPLIT:(LOCAL:1) == "0"
                    BREAK
                    LOCALS:1 '= TEMP_SPLIT:(LOCAL:1)+"/"
                ;got brand
                TRYCALLFORM PREF_WEAPON_%PFS_INT_TABS:PFS_PAGE%(TEMP_SPLIT:(LOCAL:1))
                IF RESULT
                    $LineCheck
                    IF FINDELEMENT(SELECTION_OFFERING, TEMP_SPLIT:(LOCAL:1)) == -1
                        SELECTION_OFFERING:SELECTION_INT '= TEMP_SPLIT:(LOCAL:1)
                        SELECTION_INT ++
                    ENDIF
                ENDIF
            NEXT
        NEXT
    ENDSELECT

    FOR LOCAL,0,VARSIZE("SELECTION_OFFERING")
        SIF !STRLENS(SELECTION_OFFERING:LOCAL) && !(PFS_PAGE == 4 && LOCAL == 0)
            CONTINUE
        SIF !STRLENS(UNDIES_TAGS(SELECTION_OFFERING:LOCAL))
            CONTINUE
		PFS_HTML += UndiePrefData(SELECTION_OFFERING:LOCAL, STRCOUNT(DT_CELL_GETS(@"FactionUnits", ARG, "desired weapon",1),SELECTION_OFFERING:LOCAL+"/"), PFS_PADDING, LOCAL)
		PFS_COUNT ++
		SIF PFS_COUNT % (MAXWIDTH()/PFS_PADDING)
			CONTINUE
        $FORCE_PRINT
		HTML_PRINT PFS_HTML
		VARSET PFS_HTML
        VARSET PFS_COUNT
    NEXT
    SIF PFS_COUNT % (MAXWIDTH()/PFS_PADDING)
        GOTO FORCE_PRINT

    DRAWLINE
    FOR LOCAL, 0, VARSIZE("PFS_TABS")
        SIF PFS_PAGE == LOCAL
            SETCOLOR 0x00FFFF
        ;exception for player character
        PRINTBUTTON PFS_TABS:LOCAL, LOCAL + 8000
        RESETCOLOR
        PRINTFORM 　　
    NEXT
    PRINTL
    DRAWLINE
    PRINTFORML [997] - Clear All
    PRINTFORML [998] - Leave
    ;PRINTFORML [999] - Cancel
    INPUT
    PFS_RESULT = RESULT
    SELECTCASE PFS_RESULT
    CASE 997
        DT_CELL_SET @"FactionUnits", ARG, "desired weapon", "",1
    CASE 998
        RETURN
    CASE 8000 TO 8000 + VARSIZE("PFS_TABS")
        PFS_PAGE = PFS_RESULT-8000
    CASE 0 TO VARSIZE("SELECTION_OFFERING")
        PFS_CHANGING = PFS_RESULT
        IF STRCOUNT(DT_CELL_GETS(@"FactionUnits", ARG, "desired weapon",1),@"%SELECTION_OFFERING:PFS_CHANGING%/")
            DT_CELL_SET @"FactionUnits", ARG, "desired weapon", REPLACE(DT_CELL_GETS(@"FactionUnits", ARG, "desired weapon",1), @"%SELECTION_OFFERING:PFS_CHANGING%/",""),1
        ELSE
            DT_CELL_SET @"FactionUnits", ARG, "desired weapon", DT_CELL_GETS(@"FactionUnits", ARG, "desired weapon",1)+@"%SELECTION_OFFERING:PFS_CHANGING%/",1
        ENDIF
    ENDSELECT
LOOP 1


@PREF_WEAPON_TYPE(ARGS)
SIF STRFIND(UNDERWEAR_TYPES,ARGS) > -1
    RETURN 1
SIF STRFIND(ARGS,"firearm") > -1
    RETURN 1
SIF STRFIND(ARGS,"melee") > -1
    RETURN 1
SIF STRFIND(ARGS,"explosive") > -1
    RETURN 1
SIF STRFIND(ARGS,"youjutsu") > -1
    RETURN 1
RETURN 0

@PREF_WEAPON_CLASS(ARGS)
SIF GROUPMATCH(ARGS, "1h blunt", "2h blunt", "1h blade", "2h blade")
    RETURN 1
SIF GROUPMATCH(ARGS, "pistol", "carbine", "rifle", "assault rifle", "machine gun", "light machine gun", "medium machine gun", "heavy machine gun")
    RETURN 1
SIF GROUPMATCH(ARGS, "revolver", "thrown", "spear", "shotgun", "sniper rifle", "autopistol", "bow", "battle rifle")
    RETURN 1
SIF GROUPMATCH(ARGS, "musket", "airgun")
    RETURN 1
SIF STRFIND(ARGS," magic") > -1
    RETURN 1
RETURN 0

@PREF_WEAPON_BRAND(ARGS)
#DIMS PFB_STR,2
SELECTCASE ARGS
CASEELSE
    PFB_STR:0 '= ALL_BRANDS_NAMES(ARGS,0)
    ;got brand
    IF ARGS != PFB_STR:0 
    RETURN 1
    ENDIF
ENDSELECT
RETURN 0

@PREF_WEAPON_TECH(ARGS)
FOR LOCAL,0,MAX_TECH_LEVEL+1
    SIF TOLOWER(AllTechLevels(LOCAL)) == ARGS
        RETURN 1
NEXT
RETURN 0

@PREF_WEAPON_CALIBER(ARGS)
