@FormingNewFaction
#DIM FNF_LINECOUNT
#DIM FNF_DEPOSIT
FNF_LINECOUNT = LINECOUNT
FNF_DEPOSIT = MIN(MONEY,50000)
SIF FactionNames:99 == "Player's Faction"
	FactionNames:99 '= @"%CALLNAME:MASTER%'s Faction"
SIF !STRLENS(FactionAbbreviation:99)
	FactionAbbreviation:99 '= @"PLAYER"

DO
CLEARLINE LINECOUNT - FNF_LINECOUNT
PRINTFORML Creating a new faction
PRINTL
PRINTBUTTON @"[%FactionAbbreviation:99,6,LEFT%] ", 801
PRINTBUTTON @"%FactionNames:99%", 800
PRINTL
PRINTBUTTON @"Name		   : %FactionNames:99%", 800
PRINTL
PRINTBUTTON @"Tag 		   : %FactionAbbreviation:99%", 801
PRINTL
PRINTBUTTON @"Initial Fund: %金額表示(FNF_DEPOSIT)%", 802
PRINTL
PRINTFORML [900] - Create Faction	
PRINTFORML [999] - Cancel
INPUT
SELECTCASE RESULT
CASE 800
	PRINTFORML Input a name that is less than 30 characters long
	PRINTBUTTON @"[Cancel] ", "[GOODBYECRUELWORLD]"
	PRINTL
	INPUTS
	IF !STRLENS(RESULTS)
		PRINTFORMW Faction name cannot be blank.
		RESTART
	ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
		CONTINUE
	ELSEIF STRLENS(RESULTS) > 30
		PRINTFORMW Faction name is longer than 30 characters.
		RESTART
	ELSE
		PRINTFORML Accepted.
		PRINTFORMW Faction name is now %RESULTS%
		FactionNames:99 '= RESULTS
	ENDIF
CASE 801
	PRINTFORML Input an abbreviation that is less than 6 characters long
	PRINTBUTTON @"[Cancel] ", "[GOODBYECRUELWORLD]"
	PRINTL
	INPUTS
	IF !STRLENS(RESULTS)
		PRINTFORMW Abbreviation cannot be blank.
		RESTART
	ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
		CONTINUE
	ELSEIF STRLENS(RESULTS) > 6
		PRINTFORMW Abbreviation is longer than 6 characters.
		RESTART
	ELSE
		PRINTFORML Accepted.
		PRINTFORMW Abbreviation is now [%RESULTS,6,LEFT%]
		FactionAbbreviation:99 '= RESULTS
	ENDIF
CASE 900
	PRINTFORML Are you sure you want to form a faction with these settings?
	PRINTFORML You can always change these from the faction menu.
	CALL ASK_YN
	SIF RESULT
		CONTINUE
	PlayersFactionLeader = MASTER
	PlayersFactionMade = 1
    FactionDisabled:99 = 0
	FactionRank:MASTER:99 = 6
	FactionUnits:99:6 ++
	FactionExperience:MASTER:99 = EXP_DEMAND_FACTION_RANK(6)
	FactionWealth:99 += FNF_DEPOSIT
    FactionPermaFriendly:MASTER:99 = 1
	CALL PAY_MONEY_YEN(FNF_DEPOSIT,2)
	RETURN
CASE 999
	RETURN
ENDSELECT
LOOP 1

