@FACTION_EDITOR_RESULT_2(ARG, CHEAT, nInput)
#DIM CHEAT
#DIM nInput
SELECTCASE nInput
CASE 100
    PRINTFORML Select a technical level the faction is in.
    FOR LOCAL,0,nMaxTech+1
        PRINTBUTTON "["+AllTechLevels(LOCAL)+"]", LOCAL
        PRINTL
    NEXT
    PRINTL
    PRINTFORML [-1] - Cancel
    INPUT
    SELECTCASE RESULT
    CASE IS < 0
        RETURN
    CASE 0 TO nMaxTech
    PRINTFORML Technical level is now %AllTechLevels(RESULT)%
    FactionTech:ARG = RESULT
    CALL CLEAR_FACTION_RESEARCH(ARG)
    CALL COMPLETE_RESEARCH_PREVIOUS(ARG)
    ENDSELECT
CASE 200
    PRINTFORML Changing wealth (currently %金額表示(FactionWealth:ARG)%)
    PRINTL
    PRINTFORML [-1] - Cancel
    INPUT
    SELECTCASE RESULT
    CASE -1
        RETURN
    CASEELSE
    PRINTFORMW Wealth is now %金額表示(RESULT)%
    SIF RESULT < 0
        PRINTFORMW This will put the faction in debt! 
    FactionWealth:ARG = RESULT
    ENDSELECT
CASE IS >= 60000000
    CALL RESEARCH_INPUT(nInput,ARG,CHEAT)
CASE 2 TO VARSIZE("FactionTableTabs")+95000
    RT_TAB = nInput-95000
ENDSELECT

