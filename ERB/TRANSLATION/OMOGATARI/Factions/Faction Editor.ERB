@FormingNewFaction
#DIM FNF_LINECOUNT
#DIM FNF_DEPOSIT
FNF_LINECOUNT = LINECOUNT
FNF_DEPOSIT = MIN(MONEY,50000)
SIF FactionNames:99 == "Player's Faction"
	FactionNames:99 '= @"%조사처리(CALLNAME:MASTER,"의")% 파벌"
SIF !STRLENS(FactionAbbreviation:99)
	FactionAbbreviation:99 '= @"PLAYER"
DO
CLEARLINE LINECOUNT - FNF_LINECOUNT
PRINTFORML 새로운 진영을 생성한다
PRINTL
PRINTBUTTON @"[%FactionAbbreviation:99,6,LEFT%] ", 801
PRINTBUTTON @"%FactionNames:99%", 800
PRINTL
PRINTBUTTON @"이름 : %FactionNames:99%", 800
PRINTL
PRINTBUTTON @"Tag 		   : %FactionAbbreviation:99%", 801
PRINTL
PRINTBUTTON @"초기 자금: %金額表示(FNF_DEPOSIT)%", 802
PRINTL
PRINTFORML [900] - 신규 진영 생성	
PRINTFORML [999] - 취소
INPUT
SELECTCASE RESULT
	CASE 800
		PRINTFORML 30자 미만의 이름을 입력하시오.
		PRINTBUTTON @"[취소] ", "[GOODBYECRUELWORLD]"
		PRINTL
		INPUTS
		IF !STRLENS(RESULTS)
			PRINTFORMW 진영 이름은 비어 있을 수 없다.
			RESTART
		ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
			CONTINUE
		ELSEIF STRLENS(RESULTS) > 30
			PRINTFORMW 진영 이름이 30자를 초과했습니다.
			RESTART
		ELSE
			PRINTFORML 수락됨.
			PRINTFORMW 패션 이름은 이제 %RESULTS%이다.
			FactionNames:99 '= RESULTS
		ENDIF
	CASE 801
		PRINTFORML 6자 미만의 약어를 입력하세요.
		PRINTBUTTON @"[취소] ", "[GOODBYECRUELWORLD]"
		PRINTL
		INPUTS
		IF !STRLENS(RESULTS)
			PRINTFORMW 약어는 비어 있을 수 없다.
			RESTART
		ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
			CONTINUE
		ELSEIF STRLENS(RESULTS) > 6
			PRINTFORMW 약어가 6자보다 길다.
			RESTART
		ELSE
			PRINTFORML 수락됨.
			PRINTFORMW 약어는 이제 [%RESULTS,6,LEFT%]이다.
			FactionAbbreviation:99 '= RESULTS
		ENDIF
	CASE 900
		PRINTFORML 이 설정으로 파벌을 형성하고 싶은 것이 확실한가요?
		PRINTFORML 언제든지 파벌 메뉴에서 변경할 수 있습니다.
		CALL ASK_YN
		SIF RESULT
			CONTINUE
		PlayersFactionLeader = MASTER
		PlayersFactionMade = 1
		FactionDisabled:99 = 0
		FactionRank:MASTER:99 = 6
		FactionUnits:99:6 ++
		FactionExperience:MASTER:99 = EXP_DEMAND_FACTION_RANK(6)
		FactionWealth:99 += FNF_DEPOSIT
		FactionPermaFriendly:MASTER:99 = 1
		CALL PAY_MONEY_YEN(FNF_DEPOSIT,2)
		RETURN
	CASE 999
		RETURN
ENDSELECT
