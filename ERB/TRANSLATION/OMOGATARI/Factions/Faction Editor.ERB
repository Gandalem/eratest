@UNIT_EQUIP_CONFIG_ITEM_CATEGORY(ARG,ARG:1)
SELECTCASE ARG:1
	CASE 24
		CALL Weapon_Chose_State(MASTER,,1)
		; DT_CELL_GET(@"FactionUnits", FE_UNITS:FE_UNIT, @"equip {LOCAL}",1)
		SIF RESULT >= 0
			DT_CELL_SET @"FactionUnits", ARG, @"equip {24}", RESULT, 1
