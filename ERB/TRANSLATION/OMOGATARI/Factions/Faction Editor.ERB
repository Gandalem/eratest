@SELECT_FACTION_EDIT
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
CREDRAW = CURRENTREDRAW()
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
REDRAW 0
DRAWLINE
PRINTL 수정할 진영을 선택해 주십시오. 이는 사실상 모든 보증을 무효화합니다.
PRINTL 
FOR LOCAL,0,MaxFactions
IF FactionName(LOCAL) == ""
	CONTINUE
ENDIF
PRINTFORML [{LOCAL,2}] - %FactionName(LOCAL)%
NEXT
PRINTL
PRINTL [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 0 TO CHARANUM-1
		IF FactionName(RESULT) == ""
			PRINTFORMW 죄송하지만 " "이 누구인지 또는 무엇인지 전혀 모르겠어요.
			GOTO REPRINT
		ENDIF
		CALL FACTION_EDIT(RESULT, 1)
	CASE 999
		RETURN
ENDSELECT
GOTO REPRINT

@FACTION_EDIT(ARG, CHEAT=0)
#DIM DYNAMIC CHEAT
#DIM DYNAMIC nLineCnt_Head
#DIM DYNAMIC PAGE       ;表示中のページ
#DIMS CONST FE_CATEGORY = "Name", "Units", "Technical Ability", "Areas", "Relations", "Info"
DRAWLINE
nLineCnt_Head = LINECOUNT
REDRAW 0
$Reprint
CLEARLINE LINECOUNT - nLineCnt_Head
PRINTFORML %FactionName(ARG)% 편집하기
DRAWLINE
TRYCALLFORM FACTION_EDITOR_PAGE_{PAGE}(ARG,CHEAT)
DRAWLINE
RESETCOLOR
FOR LOCAL, 0, VARSIZE("FE_CATEGORY")
SIF PAGE == LOCAL
	SETCOLOR 0x00FFFF
; SIF GROUPMATCH(PAGE,2) && !CHEAT
;     CONTINUE
PRINTBUTTON FE_CATEGORY:LOCAL, LOCAL + 8002
RESETCOLOR
PRINTFORM 　　
NEXT
RESETCOLOR
PRINTFORML 
PRINTBUTTON "[9999] 커스터마이징 종료", 9999
DO
INPUT
SELECTCASE RESULT
	CASE 8002 TO VARSIZE("FE_CATEGORY")+8002
		PAGE = RESULT-8002
	CASE 9998 ;custom code
		BREAK
	CASE 9999 ;custom code
		IF !CHEAT
			PRINTFORML 파벌 편집기를 나가시겠습니까?
			CALL ASK_YN()
			SELECTCASE RESULT
				CASE 0
				CASE 1
					GOTO REPRINT
			ENDSELECT
		ENDIF
		RETURN 9999
	CASEELSE
		TRYCALLFORM FACTION_EDITOR_RESULT_{PAGE}(ARG, CHEAT, RESULT)
		;REUSELASTLINE Invalid Input
		;CONTINUE
ENDSELECT
BREAK
LOOP 1
GOTO REPRINT
