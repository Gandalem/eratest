;=============================================================================================================
;=============================================================================================================

@FACTION_EDITOR_PAGE_0(ARG,CHEAT)
#DIM CHEAT
PRINTBUTTON @"[%FactionAbbreviation:ARG,6,LEFT%] ", 801
PRINTBUTTON @"%FactionNames:ARG%", 800
PRINTL
PRINTL
PRINTBUTTON @"%"Name",15,LEFT%: %FactionNames:ARG%", 800
PRINTL
PRINTBUTTON @"%"Tag",15,LEFT%: %FactionAbbreviation:ARG%", 801
PRINTL
PRINTBUTTON @"%"Member Name",15,LEFT%: %FactionMemberName:ARG%", 803
PRINTL
PRINTBUTTON @"%"Faction Disabled",15,LEFT%: %YesOrNo(FactionDisabled:ARG)%", 804
PRINTL

@FACTION_EDITOR_RESULT_0(ARG, CHEAT, nInput)
#DIM CHEAT
#DIM nInput
SELECTCASE nInput
	CASE 800
		PRINTFORML 30자 미만의 이름을 입력하시오.
		PRINTBUTTON @"[취소] ", "[GOODBYECRUELWORLD]"
		PRINTL
		INPUTS
		IF !STRLENS(RESULTS)
			PRINTFORMW 진영 이름은 비어 있을 수 없다.
			RESTART
		ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
			RETURN
		ELSEIF STRLENS(RESULTS) > 30
			PRINTFORMW 진영 이름이 30자를 초과했습니다.
			RESTART
		ELSE
			PRINTFORML 수락됨.
			PRINTFORMW 패션 이름은 이제 %RESULTS%이다.
			FactionNames:ARG '= RESULTS
		ENDIF
	CASE 801
		PRINTFORML 6자 미만의 약어를 입력하세요.
		PRINTBUTTON @"[취소] ", "[GOODBYECRUELWORLD]"
		PRINTL
		INPUTS
		IF !STRLENS(RESULTS)
			PRINTFORMW 약어는 비어 있을 수 없다.
			RESTART
		ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
			RETURN
		ELSEIF STRLENS(RESULTS) > 6
			PRINTFORMW 약어가 6자보다 길다.
			RESTART
		ELSE
			PRINTFORML 수락됨.
			PRINTFORMW 약어는 이제 [%RESULTS,6,LEFT%]이다.
			FactionAbbreviation:ARG '= RESULTS
		ENDIF
	CASE 803
		PRINTFORML 멤버들을 위한 일반적인 용어를 15자 미만으로 입력하라
		PRINTBUTTON @"[취소] ", "[GOODBYECRUELWORLD]"
		PRINTL
		INPUTS
		IF !STRLENS(RESULTS)
			PRINTFORMW 약어는 비어 있을 수 없다.
			RESTART
		ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
			RETURN
		ELSEIF STRLENS(RESULTS) > 15
			PRINTFORMW 멤버 용어가 15자보다 길다.
			RESTART
		ELSE
			PRINTFORML 수락했다.
			PRINTFORMW 멤버 용어는 이제 %RESULTS%이다.
			FactionMemberName:ARG '= RESULTS
		ENDIF
	CASE 804
		FactionDisabled:ARG = !FactionDisabled:ARG
ENDSELECT
