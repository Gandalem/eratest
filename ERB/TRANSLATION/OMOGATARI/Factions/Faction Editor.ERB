@FACTION_EDITOR_PAGE_1(ARG,CHEAT)
#DIM FE_UNITS,100
#DIM FE_COUNT
#DIM FE_UNIT
#DIM E_ID
#DIM CHEAT
FE_COUNT = DT_SELECT("FactionUnits", @"faction = {ARG}", "",FE_UNITS)
FOR FE_UNIT,0,FE_COUNT
CALL PRINTLINE, @"유닛 {FE_UNIT}"
PRINTFORML %DT_CELL_GETS(@"FactionUnits", FE_UNITS:FE_UNIT, "unit name",1)%
PRINTFORML 계급: %FACTION_RANK_STRING_INDE(ARG,DT_CELL_GET(@"FactionUnits", FE_UNITS:FE_UNIT, "rank",1))%
PRINTFORML 종족: %RACE_TR(DT_CELL_GETS(@"FactionUnits", FE_UNITS:FE_UNIT, "race",1))%
PRINTFORML STA: {DT_CELL_GET(@"FactionUnits", FE_UNITS:FE_UNIT, "hp",1)-500}
PRINTFORML 전투 레벨: {DT_CELL_GET(@"FactionUnits", FE_UNITS:FE_UNIT, "combat level",1)}
PRINTFORML 희망 무기: %DT_CELL_GETS(@"FactionUnits", FE_UNITS:FE_UNIT, "desired weapon",1)%
FOR LOCAL,0,25
SIF GROUPMATCH(LOCAL,10)
	CONTINUE
E_ID = DT_CELL_GET(@"FactionUnits", FE_UNITS:FE_UNIT, @"equip {LOCAL}",1)
SIF !E_ID
	CONTINUE
SELECTCASE LOCAL
	CASE 24
		PRINTFORML 무기: %UNDIES_NAME_WITH_BRAND(CSV_CHARANUM(),E_ID,1,LOCAL)%
	CASEELSE
		PRINTFORML %表示ラベル:LOCAL%: %CLOTHNAME(LOCAL,E_ID)%
ENDSELECT
NEXT
SETCOLOR C_YELLOW
PRINTFORML 레이드 포인트 비용: {RaidPointCost(FE_UNITS:FE_UNIT)}점
RESETCOLOR
PRINTBUTTON "[단위 편집]", FE_UNITS:FE_UNIT
PRINTL
NEXT
DRAWLINE
FOR LOCAL:1,1,7
IF LOCAL:1 == 6 && !FactionUnits:ARG:(LOCAL:1)
	SETCOLOR C_RED
ENDIF
IF CHEAT
	PRINTFORML [{LOCAL:1,3}] - %FACTION_RANK_STRING_INDE(ARG,LOCAL:1),15,LEFT%: %PALAM_NUM_NAS(FactionUnits:ARG:(LOCAL:1))%
ELSE
	PRINTPLAINFORM %FACTION_RANK_STRING_INDE(ARG,LOCAL:1),15,LEFT%: %PALAM_NUM_NAS(FactionUnits:ARG:(LOCAL:1))%
	PRINTL
ENDIF
RESETCOLOR
NEXT
PRINTFORML [850] - 새로운 유닛

@FACTION_EDITOR_RESULT_1(ARG, CHEAT, nInput)
#DIM CHEAT
#DIM nInput, 2
SELECTCASE nInput
	CASE IS >= 600000000000000000
		CALL FACTION_UNIT_EDIT(nInput, CHEAT)
	CASE 850
		DT_ROW_ADD @"FactionUnits", "faction", ARG, "unit name", @"새로운 %FactionAbriv(ARG)% 유닛", "race", "町娘", "hp", 2000, "rank", 1, "combat level", 0,
		CALL FACTION_UNIT_EDIT(RESULT, CHEAT)
	CASE 1 TO 6
		SIF !CHEAT
			RETURN
		PRINTFORML %FACTION_RANK_STRING_INDE(ARG,nInput)% 유닛 수를 변경한다 (현재 %PALAM_NUM_NAS(FactionUnits:ARG:nInput)%개).
		PRINTL
		PRINTFORML [-1] 취소
		INPUT
		nInput:1 = RESULT
		SELECTCASE RESULT
			CASE -1
				RETURN
			CASE IS < 0
				PRINTFORMW 유닛 수는 0보다 커야 한다!
			CASEELSE
				PRINTFORMW %FACTION_RANK_STRING_INDE(ARG,nInput)%의 수가 이제 %PALAM_NUM_NAS(nInput:1)%이다.
				FactionUnits:ARG:(nInput) = nInput:1
		ENDSELECT
ENDSELECT

@FACTION_UNIT_EDIT(ARG, CHEAT)
#DIM CHEAT
#DIM nInput
#DIM FUE_LINECOUNT
#DIM FUE_FACTION
#DIM FUE_RANK
#DIM FUE_COST
#DIM FUE_LEVEL
#DIMS nInputs
FUE_LINECOUNT = LINECOUNT
$REPRINT
FUE_FACTION = DT_CELL_GET(@"FactionUnits", ARG, "faction",1)
FUE_RANK = DT_CELL_GET(@"FactionUnits", ARG, "rank",1)
FUE_COST = RaidPointCost(ARG)
FUE_LEVEL = DT_CELL_GET(@"FactionUnits", ARG, "combat level",1)
CLEARLINE LINECOUNT-FUE_LINECOUNT
DRAWLINE
PRINTFORML %DT_CELL_GETS(@"FactionUnits", ARG, "unit name",1)% 편집하기
DRAWLINE
PRINTFORML [100] - 이름: %DT_CELL_GETS(@"FactionUnits", ARG, "unit name",1)%
PRINTFORML [110] - 최대 스태미나: {DT_CELL_GET(@"FactionUnits", ARG, "hp",1)-500}
PRINTFORML [111] - 계급: %Faction_rank_string_inde(FUE_FACTION,FUE_RANK)%
PRINTFORM [112] - 전투 레벨: 
CALL PRINT_RANK(RANK_TO_LEVEL(FUE_LEVEL),"MAX_6")
PRINTFORML  {FUE_LEVEL}
PRINTFORML [150] - 종족: %RACE_TR(DT_CELL_GETS(@"FactionUnits", ARG, "race",1))%
PRINTL
PRINTFORML [400] - 원하는 무기: %DT_CELL_GETS(@"FactionUnits", ARG, "desired weapon",1)%
PRINTFORML [410] - 장비 설정
PRINTL
SETCOLOR C_YELLOW
PRINTFORML 레이드 포인트 비용: {FUE_COST}pt
RESETCOLOR
PRINTL
PRINTFORML [980] - 유닛 삭제
PRINTFORML [999] - 유닛 편집기 나가기
DO
INPUT
nInput = RESULT
SELECTCASE nInput
	CASE 100
		PRINTFORML 이것은 당신의 유닛이 갖게 될 일반적인 이름이다.
		PRINTFORML 30자 미만의 이름을 입력해라.
		PRINTBUTTON @"[취소] ", "[GOODBYECRUELWORLD]"
		PRINTL
		INPUTS
		IF !STRLENS(RESULTS)
			PRINTFORMW 유닛 이름은 비어 있을 수 없습니다.
			RESTART
		ELSEIF RESULTS == "[GOODBYECRUELWORLD]"
			CONTINUE
		ELSEIF STRLENS(RESULTS) > 30
			PRINTFORMW 유닛 이름이 30자를 초과한다.
			RESTART
		ELSE
			PRINTFORML 수락했다.
			PRINTFORMW 유닛 이름은 이제 %RESULTS%이다.
			DT_CELL_SET @"FactionUnits", ARG, "unit name", RESULTS,1
		ENDIF
	CASE 110
		gLineCount = LINECOUNT
		LOCAL:5 = RaidPointCost(ARG)
		LOCAL:6 = DT_CELL_GET(@"FactionUnits", ARG, "hp",1)
		DO
		CLEARLINE LINECOUNT-gLineCount
		PRINTFORML 스태미나 값을 0보다 크게 입력하시오 (최대 HP는 %FACTION_RANK_STRING_INDE(DT_CELL_GET(@"FactionUnits", ARG, "faction",1),DT_CELL_GET(@"FactionUnits", ARG, "rank",1))%: {FACTION_MAX_HP(DT_CELL_GET(@"FactionUnits", ARG, "faction",1),DT_CELL_GET(@"FactionUnits", ARG, "rank",1))-500})
		PRINTFORML 스태미나 포인트를 1500 초과할 때마다 20 포인트당 1회 레이드 포인트가 소모된다.
		PRINTL
		PRINTBUTTON "[1000]", 1000
		PRINTBUTTON " [1500]", 1500
		PRINTBUTTON " [2000]", 2000
		PRINTBUTTON " [2500]", 2500
		PRINTBUTTON " [3000]", 3000
		PRINTBUTTON " [3500]", 3500
		PRINTBUTTON " [4000]", 4000
		PRINTL
		PRINTBUTTON "[취소]", -1
		INPUT
		LOCAL:2 = RESULT
		SELECTCASE RESULT
			CASE -1
				BREAK
			CASE IS <= 0
				PRINTFORMW 스태미나가 0 미만이다!
			CASE IS > FACTION_MAX_HP(DT_CELL_GET(@"FactionUnits", ARG, "faction",1),DT_CELL_GET(@"FactionUnits", ARG, "rank",1))-500
				PRINTFORMW 스태미나가 계급 최대치({FACTION_MAX_HP(DT_CELL_GET(@"FactionUnits", ARG, "faction",1),DT_CELL_GET(@"FactionUnits", ARG, "rank",1))-500})보다 높다!
			CASEELSE
				DT_CELL_SET @"FactionUnits", ARG, "hp", LOCAL:2+500 ,1
				PRINTFORML \@ LOCAL:2+500 > LOCAL:6 ? 증가 # 감소 \@ {LOCAL:6}에서 {LOCAL:2+500}까지의 체력
				PRINTFORML 레이드 포인트 비용: {LOCAL:5} -> {RaidPointCost(ARG)}
				PRINTFORML 이 변경 사항들을 유지하시겠습니까?
				CALL ASK_YN
				SELECTCASE RESULT
					CASE 0
						BREAK
					CASE 1
						DT_CELL_SET @"FactionUnits", ARG, "hp", LOCAL:6,1
				ENDSELECT
		ENDSELECT
		LOOP 1
	CASE 111
		gLineCount = LINECOUNT
		DO
		CLEARLINE LINECOUNT-gLineCount
		PRINTFORML 랭크는 전투 기교에 보너스를 주고 STA와 전투 랭크의 상한을 증가시킨다. 
		PRINTFORML 하지만 더 높은 랭크의 유닛은 얻기 어렵고 레이드 포인트를 더 많이 소모한다.
		PRINTL
		FOR LOCAL,1,7
		PRINTBUTTON @"[%Faction_rank_string_inde(FUE_FACTION,LOCAL)% (FactionUnits:FUE_FACTION:LOCAL의 %PALAM_NUM_NAS(FactionUnits:FUE_FACTION:LOCAL)% 남음)]", LOCAL
		NEXT
		PRINTL
		PRINTBUTTON "[취소]", -1
		INPUT
		LOCAL:2 = RESULT
		SELECTCASE RESULT
			CASE -1
				BREAK
			CASE IS <= 0
				PRINTFORMW 등급이 0 미만이다!
			CASE IS > 6
				PRINTFORMW %Faction_rank_string_inde(FUE_FACTION,6)%보다 더 좋은 랭크는 없다!
			CASEELSE
				DT_CELL_SET @"FactionUnits", ARG, "rank", LOCAL:2 ,1
				PRINTFORML \@ LOCAL:2 > FUE_RANK ? 승진 # 강등 \@ %Faction_rank_string_inde(FUE_FACTION,FUE_RANK)%에서 %Faction_rank_string_inde(FUE_FACTION,LOCAL:2)%로 (%PALAM_NUM_NAS(FactionUnits:FUE_FACTION:(LOCAL:2))% 남음)
				PRINTFORML 레이드 포인트 비용: {FUE_COST} -> {RaidPointCost(ARG)}
				PRINTFORML 최대 STA: {FACTION_MAX_HP(FUE_FACTION,FUE_RANK)} -> {FACTION_MAX_HP(FUE_FACTION,LOCAL:2)}
				PRINTFORM 최대 전투 레벨: 
				CALL PRINT_RANK(RANK_TO_LEVEL(FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)),"MAX_6")
				PRINTFORM {FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)} -> 
				CALL PRINT_RANK(RANK_TO_LEVEL(FACTION_MAX_LEVEL(FUE_FACTION,LOCAL:2)),"MAX_6")
				PRINTFORML  {FACTION_MAX_LEVEL(FUE_FACTION,LOCAL:2)}
				PRINTFORML 이 변경 사항들을 유지하시겠습니까?
				CALL ASK_YN
				SELECTCASE RESULT
					CASE 0
						DT_CELL_SET @"FactionUnits", ARG, "hp", MIN(DT_CELL_GET(@"FactionUnits", ARG, "hp",1),FACTION_MAX_HP(FUE_FACTION,LOCAL:2)),1
						DT_CELL_SET @"FactionUnits", ARG, "combat level", MIN(DT_CELL_GET(@"FactionUnits", ARG, "combat level",1),FACTION_MAX_LEVEL(FUE_FACTION,LOCAL:2)),1
						BREAK
					CASE 1
						DT_CELL_SET @"FactionUnits", ARG, "rank", FUE_RANK,1
				ENDSELECT
		ENDSELECT
		LOOP 1
	CASE 112
		gLineCount = LINECOUNT
		DO
		CLEARLINE LINECOUNT-gLineCount
		PRINTFORM 전투 레벨 0 이상을 입력하세요.
		PRINTFORM (%FACTION_RANK_STRING_INDE(FUE_FACTION,FUE_RANK)%의 최대 레벨:) 
		CALL PRINT_RANK(RANK_TO_LEVEL(FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)),"MAX_6")
		PRINTFORML  {FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)})
		PRINTL
		FOR LOCAL,0,FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)+1
		CALL PRINT_RANK(RANK_TO_LEVEL(LOCAL),"MAX_6")
		PRINTBUTTON @" {LOCAL}", LOCAL
		PRINTFORML
		NEXT
		PRINTL
		PRINTBUTTON "[취소]", -1
		INPUT
		LOCAL:2 = RESULT
		SELECTCASE RESULT
			CASE -1
				BREAK
			CASE IS < 0
				PRINTFORMW 전투 레벨은 0 미만일 수 없다!
			CASE IS > 10
				PRINTFORMW 레벨 10보다 높은 레벨은 없다!
			CASE IS > FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)
				PRINTFORMW 전투 레벨이 랭크 한도({FACTION_MAX_LEVEL(FUE_FACTION,FUE_RANK)})보다 높다!
			CASEELSE
				DT_CELL_SET @"FactionUnits", ARG, "combat level", LOCAL:2 ,1
				PRINTFORML \@ LOCAL:2 > FUE_LEVEL ? 증가 # 감소 \@ 레벨을 {FUE_LEVEL}에서 {LOCAL:2}로 변경한다.
				PRINTFORML 레이드 포인트 비용: {FUE_COST} -> {RaidPointCost(ARG)}
				PRINTFORM 전투 레벨: 
				CALL PRINT_RANK(RANK_TO_LEVEL(FUE_LEVEL),"MAX_6")
				PRINTFORM {FUE_LEVEL} -> 
				CALL PRINT_RANK(RANK_TO_LEVEL(LOCAL:2),"MAX_6")
				PRINTFORML  {LOCAL:2}
				PRINTFORML 이 변경 사항들을 유지하고 싶습니까?
				CALL ASK_YN
				SELECTCASE RESULT
					CASE 0
						BREAK
					CASE 1
						DT_CELL_SET @"FactionUnits", ARG, "combat level", FUE_LEVEL,1
				ENDSELECT
		ENDSELECT
		LOOP 1
	CASE 150
		PRINTFORML 아래 목록에서 선택해 주세요.
		PRINTBUTTON "[마을 소녀] ", "町娘"
		PRINTBUTTON "[유부녀] ", "人妻"
		PRINTBUTTON "[요정] ", "妖精"
		PRINTBUTTON "[메이드 요정] ", "メイド妖精"
		PRINTBUTTON "[좀비 요정] ", "ゾンビフェアリー"
		PRINTBUTTON "[캇파] ", "河童"
		PRINTBUTTON "[화이트 울프 텐구] ", "白狼天狗"
		PRINTBUTTON "[토끼] ", "イナバ"
		PRINTBUTTON "[달토끼] ", "玉兎"
		PRINTBUTTON "[오니] ", "鬼"
		PRINTBUTTON "[타누키] ", "化け狸"
		PRINTBUTTON "[여우] ", "化け狐"
		PRINTBUTTON "[바케네코] ", "化け猫"
		PRINTBUTTON @"[취소] ", "[GOODBYECRUELWORLD]"
		INPUTS
		nInputs '= RESULTS
		SELECTCASE nInputs
			CASE "[GOODBYECRUELWORLD]"
			CASEELSE
				IF RACE_TR(nInputs) == nInputs
					PRINTFORMW 이 종족은 존재하지 않는다!
					GOTO REPRINT
				ENDIF
				PRINTFORMW 수락되었다. 종족이 %RACE_TR(nInputs)%으로 변경되었다.
				DT_CELL_SET @"FactionUnits", ARG, "race", nInputs,1
		ENDSELECT
	CASE 980
		PRINTFORML 이 유닛을 삭제하시겠습니까?
		PRINTFORML 복구할 수 없습니다.
		CALL ASK_YN()
		SELECTCASE RESULT
			CASE 0
				PRINTFORMW 유닛이 삭제되었다.
				DT_ROW_REMOVE "FactionUnits", ARG
				RETURN
			CASE 1
		ENDSELECT
	CASE 400
		CALL PREF_WEAPON_SELECT(ARG)
	CASE 410
		CALL UNIT_EQUIP_CONFIG(ARG)
	CASE 999
		RETURN
ENDSELECT
BREAK
LOOP 1
GOTO REPRINT
