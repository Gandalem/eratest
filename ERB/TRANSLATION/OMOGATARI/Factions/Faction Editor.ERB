@FACTION_EDITOR_RESULT_4(ARG, CHEAT, nInput)
#DIM CHEAT
#DIM nInput, 2
SELECTCASE nInput
	CASE MaxFactions
		gLineCount = LINECOUNT
		DO
		CLEARLINE LINECOUNT - gLineCount
		PRINTFORML %FactionName(ARG)%의 비회원과의 관계를 변경한다.
		PRINTFORML [100] - 명성: %DIGIT_GROUP(FactionNonMemberFame:ARG)%
		PRINTFORML [110] - 악명: %DIGIT_GROUP(FactionNonMemberInfamy:ARG)%
		PRINTL
		PRINTFORML [999] - 나가기
		INPUT
		nInput:1 = RESULT
		SELECTCASE nInput:1
			CASE 100
				PRINTFORML 설정 %FactionName(ARG)%의 명성을 비회원들에게 (현재 %DecimalPlace(FactionNonMemberFame:ARG,1),5,RIGHT%\%):
				FOR LOCAL, 0, 101000, 1000
				;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
				SELECTCASE LOCAL
					CASE 0, 5000, 10000, 30000, 50000, 70000, 80000, 100000, FactionNonMemberFame:ARG
					CASEELSE
						RESETCOLOR
						CONTINUE
				ENDSELECT
				SELECTCASE LOCAL
					CASE IS < 15000
						SETCOLOR C_D_RED
					CASE IS < 30000
						SETCOLOR C_RED
					CASE IS < 50000
						SETCOLOR 0xE9967A
					CASE 50000
						SETCOLOR C_YELLOW
					CASE IS < 60000
						SETCOLOR C_P_GREEN
					CASE IS < 80000
						SETCOLOR C_GREEN
					CASE IS < 100000
						SETCOLOR C_AQUA
					CASEELSE
						SETCOLOR C_PINK
				ENDSELECT
				PRINTBUTTON @"[{LOCAL}] ", LOCAL
				SIF FactionNonMemberFame:ARG == LOCAL
					PRINTFORM (현재)
				NEXT
				RESETCOLOR
				INPUT
				FactionNonMemberFame:ARG = RESULT
				PRINTFORMW 승인됨. %FactionName(ARG)%의 비회원들에게 명성이 {RESULT}가 되었다.
			CASE 110
				PRINTFORML 설정 %FactionName(ARG)%의 비난을 받는 상태 (현재 %DecimalPlace(FactionNonMemberInfamy:ARG,1),5,RIGHT%\%):
				FOR LOCAL, 0, 101000, 1000
				;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
				SELECTCASE LOCAL
					CASE 0, 5000, 10000, 30000, 50000, 70000, 80000, 100000, FactionNonMemberInfamy:ARG
					CASEELSE
						RESETCOLOR
						CONTINUE
				ENDSELECT
				SELECTCASE LOCAL
					CASE IS < 15000
						SETCOLOR C_PINK
					CASE IS < 30000
						SETCOLOR C_AQUA
					CASE IS < 50000
						SETCOLOR C_GREEN
					CASE 50000
						SETCOLOR C_P_GREEN
					CASE IS < 60000
						SETCOLOR C_YELLOW
					CASE IS < 80000
						SETCOLOR 0xE9967A
					CASE IS < 100000
						SETCOLOR C_RED
					CASEELSE
						SETCOLOR C_D_RED
				ENDSELECT
				PRINTBUTTON @"[{LOCAL}] ", LOCAL
				SIF FactionNonMemberInfamy:ARG == LOCAL
					PRINTFORM (현재)
				NEXT
				RESETCOLOR
				INPUT
				FactionNonMemberInfamy:ARG = RESULT
				PRINTFORMW 수락되었다. %FactionName(ARG)%의 비회원 대상 악명은 이제 {RESULT}이다.
			CASE 999
				RETURN
		ENDSELECT
		LOOP 1
	CASE 0 TO MaxFactions-1
		gLineCount = LINECOUNT
		DO
		CLEARLINE LINECOUNT - gLineCount
		PRINTFORML %FactionName(ARG)%'의 %FactionName(nInput)%와의 관계를 변경한다.
		PRINTFORML [100] - 명성: %DIGIT_GROUP(FactionTeamFame:ARG:nInput)%
		PRINTFORML [110] - 악명: %DIGIT_GROUP(FactionTeamInfamy:ARG:nInput)%
		PRINTFORML
		IF CHEAT
			PRINTFORML [200] - 전쟁 중인가: %YesOrNo(FactionWarring:ARG:nInput)%
			PRINTFORML 전쟁 지역:
			FOR LOCAL,0,20
			SIF !GET_EXISTMAP(LOCAL)
				CONTINUE
			PRINTBUTTON @"%GET_MAPNAME(LOCAL),30,LEFT%: %YesOrNo(GETBIT(FactionWarringAreas:ARG:nInput, LOCAL))%", 300+LOCAL 
			PRINTL
			NEXT
			PRINTL
		ENDIF
		PRINTFORML [999] - 나가기
		INPUT
		nInput:1 = RESULT
		SELECTCASE nInput:1
			CASE 100
				PRINTFORML %FactionName(ARG)%의 명성을 %FactionName(nInput)%로 설정한다 (현재 %DecimalPlace(FactionTeamFame:ARG:nInput,1),5,RIGHT%\%):
				FOR LOCAL, 0, 101000, 1000
				;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
				SELECTCASE LOCAL
					CASE 0, 5000, 10000, 30000, 50000, 70000, 80000, 100000, FactionTeamFame:ARG:nInput
					CASEELSE
						RESETCOLOR
						CONTINUE
				ENDSELECT
				SELECTCASE LOCAL
					CASE IS < 15000
						SETCOLOR C_D_RED
					CASE IS < 30000
						SETCOLOR C_RED
					CASE IS < 50000
						SETCOLOR 0xE9967A
					CASE 50000
						SETCOLOR C_YELLOW
					CASE IS < 60000
						SETCOLOR C_P_GREEN
					CASE IS < 80000
						SETCOLOR C_GREEN
					CASE IS < 100000
						SETCOLOR C_AQUA
					CASEELSE
						SETCOLOR C_PINK
				ENDSELECT
				PRINTBUTTON @"[{LOCAL}] ", LOCAL
				SIF FactionTeamFame:ARG:nInput == LOCAL
					PRINTFORM (현재)
				NEXT
				RESETCOLOR
				INPUT
				FactionTeamFame:ARG:nInput = RESULT
				PRINTFORMW 수락되었다. %FactionName(ARG)%의 명성이 %FactionName(nInput)%에게는 이제 {RESULT}이다.
			CASE 110
				PRINTFORML %FactionName(ARG)%의 명성을 %FactionName(nInput)%와 설정한다 (현재 %DecimalPlace(FactionTeamInfamy:ARG:nInput,1),5,RIGHT%\%):
				FOR LOCAL, 0, 101000, 1000
				;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
				SELECTCASE LOCAL
					CASE 0, 5000, 10000, 30000, 50000, 70000, 80000, 100000, FactionTeamInfamy:ARG:nInput
					CASEELSE
						RESETCOLOR
						CONTINUE
				ENDSELECT
				SELECTCASE LOCAL
					CASE IS < 15000
						SETCOLOR C_PINK
					CASE IS < 30000
						SETCOLOR C_AQUA
					CASE IS < 50000
						SETCOLOR C_GREEN
					CASE 50000
						SETCOLOR C_P_GREEN
					CASE IS < 60000
						SETCOLOR C_YELLOW
					CASE IS < 80000
						SETCOLOR 0xE9967A
					CASE IS < 100000
						SETCOLOR C_RED
					CASEELSE
						SETCOLOR C_D_RED
				ENDSELECT
				PRINTBUTTON @"[{LOCAL}] ", LOCAL
				SIF FactionTeamInfamy:ARG:nInput == LOCAL
					PRINTFORM (현재)
				NEXT
				RESETCOLOR
				INPUT
				FactionTeamInfamy:ARG:nInput = RESULT
				PRINTFORMW 인정되었다. %FactionName(ARG)%의 명성이 %FactionName(nInput)%에 대해 이제 {RESULT}이다.
			CASE 200
				SIF CHEAT
					FactionWarring:ARG:nInput = !FactionWarring:ARG:nInput
			CASE 300 TO 320
				SIF CHEAT
					INVERTBIT FactionWarringAreas:ARG:nInput, nInput:1-300
			CASE 999
				RETURN
		ENDSELECT
		LOOP 1
ENDSELECT
