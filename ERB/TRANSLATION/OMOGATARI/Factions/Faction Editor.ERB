@FACTION_EDITOR_PAGE_3(ARG,CHEAT)
#DIM FE_UNITS,100
#DIM FE_COUNT
#DIM FE_UNIT
#DIM E_ID
#DIM CHEAT
FOR LOCAL,0,20
SIF !GET_EXISTMAP(LOCAL)
	CONTINUE
PRINTBUTTON @"%GET_MAPNAME(LOCAL),30,LEFT%:", LOCAL 
IF FactionMainArea:LOCAL == ARG
	SETCOLOR C_YELLOW
	LOCALS = 소유 중
ELSEIF GETBIT(FactionPatrolArea:ARG,LOCAL)
	LOCALS = 순찰 중
ELSE
	SETCOLOR C_GRAY
	LOCALS = 순찰하지 않음
ENDIF
PRINTFORM %LOCALS,15,LEFT%
RESETCOLOR
SELECTCASE FactionAreaControl:ARG:LOCAL/10
	CASE IS > 90
		SETCOLOR BARCOLORSET("青")
	CASE IS > 75
		SETCOLOR BARCOLORSET("緑")
	CASE IS > 50
		SETCOLOR BARCOLORSET("黄色")
	CASE IS > 25
		SETCOLOR BARCOLORSET("オレンジ")
	CASE IS > 0
		SETCOLOR BARCOLORSET("赤")
	CASE IS <= 0
		SETCOLOR C_GRAY
ENDSELECT
PRINTFORM %@"%DecimalPlace(FactionAreaControl:ARG:LOCAL,1),5,RIGHT%\% 통제",15,LEFT%
RESETCOLOR
PRINTL
NEXT

@FACTION_EDITOR_RESULT_3(ARG, CHEAT, nInput)
#DIM CHEAT
#DIM nInput, 2
SELECTCASE nInput
	CASE 0 TO 20
		gLineCount = LINECOUNT
		DO
		$AREARETRY
		CLEARLINE LINECOUNT - gLineCount
		PRINTFORML %GET_MAPNAME(nInput)%의 편집 상태
		SIF CHEAT
			PRINTFORML [100] - 제어: %DecimalPlace(FactionAreaControl:ARG:nInput,1),5,RIGHT%\%
		PRINTFORML [110] - 순찰 중인가: %YesOrNo(GETBIT(FactionPatrolArea:ARG,nInput))%
		SIF CHEAT
			PRINTFORML [200] - 소유 지역으로 설정한다 (현재 소유자: \@ FactionMainArea:nInput > -1 ? %FactionName(FactionMainArea:nInput)% # 소유되지 않음 \@)
		PRINTL
		PRINTFORML [999] - 나가기
		INPUT
		nInput:1 = RESULT
		SELECTCASE nInput:1
			CASE 100
				SIF !CHEAT
					GOTO AREARETRY
				PRINTFORML 설정하는 %FactionName(ARG)%의 제어 (현재 %DecimalPlace(FactionAreaControl:ARG:nInput,1),5,RIGHT%\%):
				FOR LOCAL, 0, 1010, 10
				;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
				SELECTCASE LOCAL
					CASE 0, 50, 100, 300, 500, 700, 800, 1000, FactionAreaControl:ARG:nInput
					CASEELSE
						RESETCOLOR
						CONTINUE
				ENDSELECT
				SELECTCASE LOCAL
					CASE IS < 150
						SETCOLOR C_D_RED
					CASE IS < 300
						SETCOLOR C_RED
					CASE IS < 500
						SETCOLOR 0xE9967A
					CASE 500
						SETCOLOR C_YELLOW
					CASE IS < 600
						SETCOLOR C_P_GREEN
					CASE IS < 800
						SETCOLOR C_GREEN
					CASE IS < 1000
						SETCOLOR C_AQUA
					CASEELSE
						SETCOLOR C_PINK
				ENDSELECT
				PRINTBUTTON @"[{LOCAL}] ", LOCAL
				SIF FactionAreaControl:ARG:nInput == LOCAL
					PRINTFORM (현재)
				NEXT
				RESETCOLOR
				INPUT
				FactionAreaControl:ARG:nInput = RESULT
				PRINTFORMW 수락됨. %FactionName(ARG)%의 통제에 %GET_MAPNAME(nInput)% 이제 ~에 있다 %DecimalPlace(FactionAreaControl:ARG:nInput,1),5,RIGHT%\%
			CASE 110
				INVERTBIT FactionPatrolArea:ARG,nInput
			CASE 200
				SIF !CHEAT
					GOTO AREARETRY
				FactionMainArea:nInput = ARG
			CASE 999
				BREAK
		ENDSELECT
		LOOP 1
ENDSELECT
