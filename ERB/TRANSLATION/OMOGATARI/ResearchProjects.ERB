"defName", "Schedule3Drug",
"label", @"Schedule III Substances",
"description", @"%LOCALS%",
"techLevel", "Industrial",
"prerequisites", "Mixing/",
"tab", "Crafting",
"baseCost", 500,
}

LOCALS '= "Schedule II substances are described as those that have all of the following findings:\n"
LOCALS += "A: The drug or other substance has a currently accepted medical use in treatment in the United States, or a currently accepted medical use with severe restrictions\n"
LOCALS += "B: The drug or other substance has a currently accepted medical use in treatment in Gensokyo.\n"
LOCALS += "C: Abuse of the drug or other substance may lead to severe physical or psychological dependence.\n"
LOCALS += "Drugs in this category are addictive, powerful, and are used in higher-end recepies and drugs."
