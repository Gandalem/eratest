DT_ROW_ADD @"ResearchProject", "defName", "ComplexClothing", "label", @"복잡한 의상", "description", @"재봉사는 바지, 더스터, 카우보이 모자 같은 복잡한 의류를 만든다.", "techLevel", "Classical", "prerequisites", "BasicApparel/", "tab", "Clothing", "baseCost", 600,
DT_ROW_ADD @"ResearchProject", "defName", "PlateArmor", "label", @"판금 갑옷", "description", @"스미스의 판금 갑옷은 금속이나 나무로 만든다. 이 무거운 갑옷은 움직임을 눈에 띄게 느리게 하지만 매우 효과적으로 보호한다.", "techLevel", "Medieval", "prerequisites", "Smithing/ComplexClothing/", "tab", "Clothing", "baseCost", 600,
DT_ROW_ADD @"ResearchProject", "defName", "FlakArmor", "label", @"아라미드 갑옷", "description", @"금속판과 방탄 섬유를 박아 총알과 폭발에 저항하는 의류를 제작한다. 이 무게감 있는 갑옷은 움직임을 약간 느리게 한다.", "techLevel", "Midworld", "prerequisites", "Machining/PlateArmor/", "tab", "Clothing", "baseCost", 1200,
IF nOmutsu
	DT_ROW_ADD @"ResearchProject", "defName", "SuperAbsorbent", "label", @"초흡수성 고분자", "description", @"테이프형 및 풀업 기저귀와 같은 의료용 붕대 및 성인용 기저귀에 사용되는 흡수성 고분자를 만든다.", "techLevel", "Midworld", "prerequisites", "Mixing/", "tab", "Clothing", "baseCost", 800,
ENDIF
DT_ROW_ADD @"ResearchProject", "defName", "CMCarmor", "label", @"CMC 경갑 기술", "description", @"CMC 전력 갑옷을 건다.", "techLevel", "spacer", "prerequisites", "CMCTechlvl1/", "tab", "Clothing", "baseCost", 2000,
DT_ROW_ADD @"ResearchProject", "defName", "CMCarmorII", "label", @"CMC 중갑 기술", "description", @"CMC 헤비 파워 암어를 구축한다.", "techLevel", "spacer", "prerequisites", "CMCarmor/", "tab", "Clothing", "baseCost", 3000,
;replacement parts
DT_ROW_ADD @"ResearchProject", "defName", "Prosthetics", "label", @"의수/의족 교체", "description", @"상실된 사지를 대체할 저렴한 의족 부품을 제작한다. 장착하려면 숙련된 의사가 필요하다.", "techLevel", "machine", "prerequisites", "Machining/", "tab", "Clothing", "baseCost", 600,
DT_ROW_ADD @"ResearchProject", "defName", "Bionics", "label", @"바이오닉 대체품", "description", @"상실된 사지와 눈을 대체하기 위해 첨단 생체 공학 신체 부품을 제작한다. 장착하려면 숙련된 의사가 필요하다.", "techLevel", "Spacer", "prerequisites", "Prosthetics/", "tab", "Clothing", "baseCost", 2000,
DT_ROW_ADD @"ResearchProject", "defName", "GCBionics", "label", @"현상짱 실험용 생체공학", "description", @"분자 수준부터 생물학을 재창조하여 훨씬 우수한 기관들을 만들어낸다.", "techLevel", "archotech", "prerequisites", "Bionics/ArchotechBioMechanites/ArchotechVanometrics/", "tab", "Clothing", "baseCost", 15000,
DT_ROW_ADD @"ResearchProject", "defName", "CMCBio", "label", @"CMC 전투 칩", "description", @"CMC 전투 칩을 잠금 해제한다.", "techLevel", "spacer", "prerequisites", "Bionics/", "tab", "Clothing", "baseCost", 3000,
DT_ROW_ADD @"ResearchProject", "defName", "Sandevistan", "label", @"크로노레비스 산데비스탄스", "description", @"그 어떤 사람에게든 시간을 멈추는 힘을 부여하는 생체 공학 기술을 구축한다.", "techLevel", "spacer", "prerequisites", "Bionics/", "tab", "Clothing", "baseCost", 3000,
DT_ROW_ADD @"ResearchProject", "defName", "MaBouru", "label", @"마보루 육술 활성화", "description", @"어떤 사람에게 부여되든 그 사람이 마법을 사용할 수 있는 힘을 주고 이미 마법을 아는 이들에게 능력을 주는 바이오닉스를 만든다.", "techLevel", "spacer", "prerequisites", "Bionics/", "tab", "Clothing", "baseCost", 3000,

@Research_Weapons
#FUNCTION
DT_ROW_ADD @"ResearchProject", "defName", "BasicRangedWeapons", "label", @"원거리 무기", "description", @"간단한 원거리 무기 제작.", "techLevel", "Animal", "prerequisites", "Organization/", "tab", "Weapons", "baseCost", 25,
