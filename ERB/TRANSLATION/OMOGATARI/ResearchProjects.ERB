DT_ROW_ADD @"ResearchProject", "defName", "BasicCraftingFacilities", "label", @"제작 시설", "description", @"기본적인 제작 시설들.", "techLevel", "Neolithic", "prerequisites", "Organization/", "tab", "General", "baseCost", 50,
DT_ROW_ADD @"ResearchProject", "defName", "Mixing", "label", @"혼합하기", "description", @"기본적인 약물 합성용 혼합 도구를 제작한다. 특정 약물을 만들기 위해서는 추가 연구가 필요하다.", "techLevel", "Classical", "prerequisites", "BasicCraftingFacilities/", "tab", "General", "baseCost", 500,
DT_ROW_ADD @"ResearchProject", "defName", "Smithing", "label", @"대장장이", "description", @"칼이나 글라디우스, 메이스 같은 금속 무기를 제작하기 위해 대장간을 지어라. 금속으로 깨끗하고 아름다운 바닥 타일을 만들어라.", "techLevel", "Classical", "prerequisites", "BasicCraftingFacilities/", "tab", "General", "baseCost", 700,
DT_ROW_ADD @"ResearchProject", "defName", "MailOrder", "label", @"원거리 배송", "description", @"서류와 아이템을 우편으로 보내고 배송한다.", "techLevel", "industrial", "prerequisites", "Organization/", "tab", "General", "baseCost", 800,
DT_ROW_ADD @"ResearchProject", "defName", "Machining", "label", @"가공", "description", @"총, 수류탄, 대공 방어구 제작 및 아이템을 자원화하기 위한 기계 테이블을 구축한다.", "techLevel", "machine", "prerequisites", "Smithing/", "tab", "General", "baseCost", 1000,
DT_ROW_ADD @"ResearchProject", "defName", "CellularNetworking", "label", @"셀룰러 네트워킹", "description", @"전 세계 어디에서든 소통이 가능하다.", "techLevel", "Midworld", "prerequisites", "MicroelectronicsBasics/MailOrder/", "tab", "General", "baseCost", 2000,
DT_ROW_ADD @"ResearchProject", "defName", "EStim", "label", @"전기 자극", "description", @"움직임, 조작, 성적 쾌락 등을 조종하는 특정 신경을 자극한다.", "techLevel", "Midworld", "prerequisites", "MicroelectronicsBasics/", "tab", "General", "baseCost", 1000,
DT_ROW_ADD @"ResearchProject", "defName", "DynElect", "label", @"동적 전자기학", "description", @"전자기 부품을 사용하여 고급 건물을 제작할 수 있게 해준다. 이는 모든 글리터월드 설치물에서 발견되는 상위 단계의 발전 및 기술 잠금을 해제한다.", "techLevel", "Spacer", "prerequisites", "AdvancedFabrication/ShipBuild/", "tab", "General", "baseCost", 1800,
DT_ROW_ADD @"ResearchProject", "defName", "ElectroPlasmatics", "label", @"전기 플라스마틱", "description", @"자기장을 이용해 플라즈마를 조종할 수 있게 해준다. 플라즈마의 극단적인 힘을 다루는 매우 높은 등급의 기술이 해금된다.", "techLevel", "Spacer", "prerequisites", "DynElect/ShipBuild/", "tab", "General", "baseCost", 1900,
;major milestones
DT_ROW_ADD @"ResearchProject", "defName", "Electricity", "label", @"전기", "description", @"전기 에너지를 백 가지 다른 작업에 활용한다.", "techLevel", "industrial", "prerequisites", "Organization/", "tab", "General", "baseCost", 1600,
DT_ROW_ADD @"ResearchProject", "defName", "MicroelectronicsBasics", "label", @"마이크로일렉트로닉스", "description", @"복잡한 마이크로일렉트로닉스로 작업한다. 이것은 컴퓨터를 잠금 해제한다.", "techLevel", "Midworld", "prerequisites", "Electricity/", "tab", "General", "baseCost", 3000,
DT_ROW_ADD @"ResearchProject", "defName", "Fabrication", "label", @"제조", "description", @"부품 조립부터 파워 아머 제작에 이르는 첨단 프로젝트를 수행할 수 있는 제작용 작업대를 건설한다.", "techLevel", "Midworld", "prerequisites", "MicroelectronicsBasics/Machining/", "tab", "General", "baseCost", 4000,
DT_ROW_ADD @"ResearchProject", "defName", "AdvancedFabrication", "label", @"고급 제작", "description", @"표준 부품과 다른 재료로부터 고급 구성품을 제작한다.", "techLevel", "Midworld", "prerequisites", "Fabrication/", "tab", "General", "baseCost", 4000,
DT_ROW_ADD @"ResearchProject", "defName", "ShipBuild", "label", @"스타플라이기 기초", "description", @"성간 함선에 필요한 구조적 및 지지 요소를 구축한다. 이것은 이 항성계를 떠날 함선을 만드는 첫 번째 단계이다.", "techLevel", "spacer", "prerequisites", "AdvancedFabrication/", "tab", "General", "baseCost", 4000,
DT_ROW_ADD @"ResearchProject", "defName", "AdvancedFact", "label", @"고급 인수분해", "description", @"고급 제조 방법의 기초를 이해하고 당신의 진영에 최신 조립 기계를 사용하게 하는 첫 번째 단계이다.", "techLevel", "Ultra", "prerequisites", "ElectroPlasmatics/", "tab", "General", "baseCost", 6000,
DT_ROW_ADD @"ResearchProject", "defName", "Electrolysis", "label", @"전기분해", "description", @"전기를 이용해 화합물을 기본 원소로 분리하는 기계를 만들 수 있게 해준다.", "techLevel", "Ultra", "prerequisites", "AdvancedFact/", "tab", "General", "baseCost", 6500,
DT_ROW_ADD @"ResearchProject", "defName", "AtomicD", "label", @"원자 수준 해체", "description", @"원자 수준에서 물질을 분해하는 과정을 조작하는 방법, 특히 원자 단위의 공정을 이해하기 위한 첫 번째 구성 요소이다.", "techLevel", "Ultra", "prerequisites", "Electrolysis/", "tab", "General", "baseCost", 7000,
DT_ROW_ADD @"ResearchProject", "defName", "AtomicA", "label", @"원자적 조립", "description", @"원자 단위의 공정을 어떻게 제작할 수 있는지 이해하는 마지막 구성 요소다. 이것은 물질을 아원자 수준에서 제조하는 방법에 대한 완전한 이해를 줄 것이다. 대부분의 공정은 여전히 전력 요구 사항 측면에서 도달하기 어려우지만, 산업적으로 실현 가능한 몇 가지 선택된 요소들이 있다.", "techLevel", "Ultra", "prerequisites", "AtomicD/", "tab", "General", "baseCost", 8000,
DT_ROW_ADD @"ResearchProject", "defName", "ArchotechExotics", "label", @"이국적인 입자", "description", @"통용되는 물리 법칙을 확장하여 특이한 행동을 하는 다양한 입자들을 발견한다.", "techLevel", "Archotech", "prerequisites", "AtomicA/", "tab", "General", "baseCost", 10000,
DT_ROW_ADD @"ResearchProject", "defName", "ArchotechVanometrics", "label", @"바노메트릭스", "description", @"연료를 사용하지 않고 자유 에너지를 생성하는 전압차형 에너지 셀을 설계한다.", "techLevel", "Archotech", "prerequisites", "ArchotechExotics/", "tab", "General", "baseCost", 8000,
DT_ROW_ADD @"ResearchProject", "defName", "ArchotechMechanites", "label", @"메카나이트 조립", "description", @"물체를 원자 단위로 조립하거나 수리하기 위한 단순한 메카나이트를 설계한다.", "techLevel", "Archotech", "prerequisites", "ArchotechExotics/", "tab", "General", "baseCost", 5000,
DT_ROW_ADD @"ResearchProject", "defName", "ArchotechBioMechanites", "label", @"바이오 메카나이트 통합", "description", @"생물과 인터페이스하고 개선하기 위해 더 전문화된 메카나이트를 설계한다.", "techLevel", "Archotech", "prerequisites", "ArchotechMechanites/", "tab", "General", "baseCost", 6000,

