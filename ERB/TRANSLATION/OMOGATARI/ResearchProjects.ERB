DT_ROW_ADD @"ResearchProject", "defName", "BasicMagicWeapons", "label", @"무기화된 주술", "description", @"단순한 마법을 무기로 사용하는 것.", "techLevel", "Animal", "prerequisites", "Organization/", "tab", "Weapons", "baseCost", 25,
DT_ROW_ADD @"ResearchProject", "defName", "ProfessionalMagicWeapons", "label", @"전문 주술", "description", @"중간 마법을 무기로 사용하는 것. 기본 변형보다 더 강력한 -la 스펠을 잠금 해제한다.", "techLevel", "Medieval", "prerequisites", "BasicMagicWeapons/", "tab", "Weapons", "baseCost", 1000,
DT_ROW_ADD @"ResearchProject", "defName", "ExpertMagicWeapons", "label", @"전문가 주술", "description", @"고급 마법을 무기로 사용하는 것. -다인 주문이 해금된다.", "techLevel", "Machine", "prerequisites", "ProfessionalMagicWeapons/", "tab", "Weapons", "baseCost", 5000,
