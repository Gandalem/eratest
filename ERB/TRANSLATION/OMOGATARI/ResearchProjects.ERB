DT_ROW_ADD @"ResearchProject", "defName", "ESPKill", "label", @"원격 조종으로 소멸시키기", "description", @"악마에게 축복받은 센소-짱의 ESPKill 탄환은 대상의 정신에서 요술 에너지를 빼앗는다. 이는 자연적인 요괴 갑옷뿐만 아니라 일반적인 방어에도 효과가 있는 것으로 증명되었다. ESPKill이 주로 정신에 손상을 입히지만, ESPKill을 장착한 화기들은 매우 치명적이기 때문에 스펠 카드 제한 단막에서는 여전히 금지되어 있다.", "techLevel", "ultra", "prerequisites", "Gunsmith/", "tab", "Weapons", "baseCost", 5000,
DT_ROW_ADD @"ResearchProject", "defName", "GuidingBullets", "label", @"추적탄", "description", @"탄환이 어느 방향으로 향하는지 추적하는 시스템을 설치한다. 보통 유도 미사일 발사기에만 사용되지만, Aimthropic 스마트 건에서도 발견된다.", "techLevel", "Midworld", "prerequisites", "MicroelectronicsBasics/Gunsmith/", "tab", "Weapons", "baseCost", 1200,
DT_ROW_ADD @"ResearchProject", "defName", "AdvancedGuidingBullets", "label", @"고급 투사체 추적", "description", @"아이엠스로틱 스마트건에서 발견된 세이호 시대의 인공지능을 활용한다.", "techLevel", "Spacer", "prerequisites", "ShipBuild/GuidingBullets/", "tab", "Weapons", "baseCost", 3000,
DT_ROW_ADD @"ResearchProject", "defName", "VehicleWeapons", "label", @"차량 탑재 무기", "description", @"자동차, 비행기, 탱크, 메카와 같은 차량에서 주로 사용되는 무기를 설치한다. 근현의 현상은 심지어 약한 유아도 이러한 무기를 편안하게 들고 사용할 수 있음을 의미한다.", "techLevel", "Midworld", "prerequisites", "Gunsmith/", "tab", "Weapons", "baseCost", 4000,
[IF_DEBUG]
DT_ROW_ADD @"ResearchProject", "defName", "BasicMech", "label", @"(디버그) 근육 추적기", "description", @"무거운 하중을 들고 장시간 기능하도록 설계된 효율적인 기계 작업 유닛이다. 이로부터 얼마 지나지 않아 그것들이 군사적 용도로 사용되었다. 바로 이때부터 일반적인 닭다리형 워커부터 더 진보된 휴머노이드 전투 MT에 이르기까지 많은 다양한 모델과 디자인이 등장했다.", "techLevel", "Midworld", "prerequisites", "MuscleTracer/", "tab", "Weapons", "baseCost", 4000,
DT_ROW_ADD @"ResearchProject", "defName", "AdvavncedMech", "label", @"(디버그) 장갑 코어", "description", @"기본 MT에 사지를 수용하고 추가 장갑을 갖춘 코어를 도입하여 이를 방어 코어(AC)로 진화시킨다.", "techLevel", "Spacer", "prerequisites", "MuscleTracer/", "tab", "Weapons", "baseCost", 4000,
[ENDIF]

