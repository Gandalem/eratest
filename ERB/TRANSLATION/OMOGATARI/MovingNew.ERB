ENDSELECT
RETURNF RAND(1000) < rngChance
;Determines when the Touhou wants to use their padding instead of going in the potty
;- Padded legends always wet, will not mess until messing addiction is at 5 or higher

@WantsToUseDiaperOverPotty(ARG,closestToilet=__INT_MAX__)
#FUNCTION
#DIM DYNAMIC closestToilet
#DIM DYNAMIC giveUpChance
#DIM DYNAMIC diaperHoldsAccident
#DIM DYNAMIC HasPiss
#DIM DYNAMIC HasScat
#DIM DYNAMIC retBit
#DIM DYNAMIC omoGuardianProc
#DIM DYNAMIC highestDesperation
#DIM DYNAMIC theThreshold
HasPiss = PeeBarStage(ARG) >= 2
HasScat = PooBarStage(ARG) >= 2
diaperHoldsAccident = ((HasPiss && DiapeCharges:ARG:0 >= BASE:MASTER:4) || !HasPiss) && ((HasScat && DiapePooCharges:ARG:0 >= BASE:MASTER:Poo) || !HasScat)
SIF HasPiss
	SETBIT retBit, 0
SIF HasScat
	SETBIT retBit, 1
highestDesperation = MAX(PeeBarStage(ARG),PooBarStage(ARG))
IF GETBIT(TALENT:ARG:OmoGuardian,2) && diaperHoldsAccident
	;padded legends always wet in their diapees.
	IF HasScat
		;		- Padded legends will not mess until messing addiction is at 5 or higher
		IF GETBIT(TALENT:ARG:OmoGuardian,1) || ABL:ARG:PooAddict
			omoGuardianProc = 1
		ENDIF
	ELSE
		omoGuardianProc = 1
	ENDIF
ELSEIF HasScat && GETBIT(TALENT:ARG:OmoGuardian,1)
	;messy legends always mess
	omoGuardianProc = 1
ELSEIF HasPiss && GETBIT(TALENT:ARG:OmoGuardian,0)
	;leaky legends always wet
	omoGuardianProc = 1
ENDIF
;if they have IBS and are diapered they will use it.
IF DT_SELECT(@"Hediff", @"chara = {ARG} and type = 54") && HasScat && diaperHoldsAccident
	RETURNF retBit
ENDIF
;leaky legends go when they need to pee except if they need to poop too
;messy legends go when they need to poop
IF omoGuardianProc
	IF IsPadded(ARG) && diaperHoldsAccident
		RETURNF retBit
	ELSE
		;if they are not padded or going in their padding will make it leak
		;this give it a much higher chance to just go and have their accident.
		giveUpChance = 6000
	ENDIF
ELSE
	IF IsPadded(ARG) && diaperHoldsAccident
		; RETURNF retBit
		;not padded
		SELECTCASE HasScat ? ABL:ARG:PooAddict # ABL:ARG:PeeAddict
			CASE 0
				giveUpChance = 0
			CASEELSE
				;+3% per point (at 9 this is 39%)
				;once leaky/messy legend is acquired this spikes to 60%
				giveUpChance = 1800+(500*(HasScat ? ABL:ARG:PooAddict # ABL:ARG:PeeAddict))
		ENDSELECT
	ELSE
		;not padded
		SELECTCASE HasScat ? ABL:ARG:PooAddict # ABL:ARG:PeeAddict
			CASE 0
				giveUpChance = 0
			CASEELSE
				;+3% per point (at 9 this is 39%)
				;once leaky/messy legend is acquired this spikes to 60%
				giveUpChance = 1000+(300*(HasScat ? ABL:ARG:PooAddict # ABL:ARG:PeeAddict))
		ENDSELECT
	ENDIF
ENDIF
;if they are in a line and its like at least an hour long queue they will use their padding
IF PottyLinePosition(ARG) > -1 && diaperHoldsAccident
	SELECTCASE highestDesperation
		CASE 4
			theThreshold = 9
		CASE 5
			theThreshold = 6
		CASE 6
			theThreshold = 3
		CASE 7
			theThreshold = 0
		CASEELSE
			theThreshold = __INT_MAX__
	ENDSELECT
	SIF PottyLinePosition(ARG) > theThreshold
		RETURNF retBit
ENDIF
;if a toilet is too far compared to their desperation they will use their padding.
;if they are working and diapered they will use their padding.
;sex stuff is covered by UFUFU_OMORASHI
;normal circumstances
IF RAND(10000) < giveUpChance
	RETURNF retBit
ENDIF

@AutoGoPlaceShits(ARG,nTypeInput)
#DIM CONST nBits = 7,2,5,3,4,11,12,14
#DIMS CONST nLabels = "Toilet", "Bath", "Study Area", "Kitchen", "Training Spot", "Garden", "Water Spot", "Laundry"
#DIM DYNAMIC bestSpot
#DIM DYNAMIC nTypeInput
CALL OptimalPlace(ARG, nBits:nTypeInput)
bestSpot = RESULT
IF !bestSpot
	CALL COLORMESSAGE(@"현재 지도에서 【%nLabels:nTypeInput%】을(를) 찾을 수 없었다.",C_ORANGE,1)
	CALL COLORMESSAGE(@"이것은 버그가 아니다.",C_ORANGE,2)
	RETURN
ENDIF
SELECTCASE nTypeInput
	CASE 0
		;NAS: auto toilet
		SIF !IS_TOILET(CFLAG:ARG:現在位置,ARG)
			CALL SKIP_MOVE(CFLAG:ARG:現在位置, bestSpot)
		RETURN
	CASE 1
		;auto bath
		SIF !BATHROOM(CFLAG:ARG:現在位置)
			CALL SKIP_MOVE(CFLAG:ARG:現在位置, bestSpot)
		RETURN
	CASE 2
		;auto study
		SIF !勉強可(CFLAG:ARG:現在位置)
			CALL SKIP_MOVE(CFLAG:ARG:現在位置, bestSpot)
		RETURN
	CASE 3
		;auto kitchen
		SIF !KITCHEN(CFLAG:ARG:現在位置)
			CALL SKIP_MOVE(CFLAG:ARG:現在位置, bestSpot)
		RETURN
	CASE 4
		;auto training
		SIF !戦闘訓練可(CFLAG:ARG:現在位置)
			CALL SKIP_MOVE(CFLAG:ARG:現在位置, bestSpot)
		RETURN
	CASE 5
		;auto garden
		SIF !家庭菜園可(CFLAG:ARG:現在位置)
			CALL SKIP_MOVE(CFLAG:ARG:現在位置, bestSpot)
		RETURN
	CASE 6
		;auto draw
		SIF !水汲み可(CFLAG:ARG:現在位置)
			CALL SKIP_MOVE(CFLAG:ARG:現在位置, bestSpot)
		RETURN
	CASE 7
		;auto laundry
		SIF !LAUNDRY_ROOM(CFLAG:ARG:現在位置)
			CALL SKIP_MOVE(CFLAG:ARG:現在位置, bestSpot)
		RETURN
	CASEELSE
		CALL COLORMESSAGE(@"@AutoGoPlaceShits에 유효하지 않은 입력이 있습니다. 보고하세요!",C_ORANGE,2)
		RETURN
ENDSELECT
