@AdvancePottyLine(pottyPosition)
#DIM pottyPosition
#DIM pottyChara
#DIM pottyTableID
#DIM pottyQueueLength
pottyQueueLength = DT_SELECT("PottyLine", @"location = {pottyPosition}", "", TempHediffList)
IF pottyQueueLength
	IF !ToiletIsOccupied(pottyPosition)
		pottyTableID = TempHediffList:0
		pottyChara = DT_CELL_GET("PottyLine", pottyTableID, "character",1)
		PRINTFORMW %조사처리(CALLNAME:pottyChara,"가")% 화장실에 들어갔다.
		CFLAG:(pottyChara):300 = pottyPosition
		SIF BATHROOM(pottyPosition)
			CALL ODEKAKE_OFURO(pottyChara)
		SIF IS_TOILET(pottyPosition, pottyChara)
			CALL DumpingShit(pottyChara)
		DT_ROW_REMOVE "PottyLine", pottyTableID
		IF !DT_SELECT("PottyLine", @"location = {pottyPosition}")
			PRINTFORMW 대기열이 이제 비었다.
		ELSE
			PRINTFORMW 대기열은 현재 {DT_SELECT("PottyLine", @"location = {pottyPosition}")}명이다.
		ENDIF
	ENDIF
	pottyQueueLength = DT_SELECT("PottyLine", @"location = {pottyPosition}","",TempHediffList)
	FOR LOCAL:4,0,pottyQueueLength
	pottyTableID = TempHediffList:(LOCAL:4)
	pottyChara = DT_CELL_GET("PottyLine", pottyTableID, "character",1)
	LOCAL:5 = DT_CELL_GET("PottyLine", pottyTableID, "waitingPlace",1)
	IF !INRANGE(pottyChara,0,CHARANUM-1)
		;null character
		DT_ROW_REMOVE "PottyLine", pottyTableID
		CONTINUE
	ENDIF
	;#;PRINTFORMDL QUEUE #{LOCAL:4+1} (PottyLinePosition {PottyLinePosition(pottyChara,pottyPosition)}) FOR {pottyPosition} %NAME_FROM_PLACE(pottyPosition)% | CHARACTER {pottyChara} %NAME:(pottyChara)% | WAITING IN {CFLAG:(pottyChara):300} %NAME_FROM_PLACE(CFLAG:(pottyChara):300)% | SUPPOSED TO BE WAITING IN {LOCAL:5} %NAME_FROM_PLACE(LOCAL:5)%
	IF CFLAG:(pottyChara):300 != LOCAL:5 && !DT_EXIST(@"Movement_{pottyChara}")
		PRINTFORMW %조사처리(CALLNAME:pottyChara,"는")% 줄에서 빠져나갔다.
		DT_ROW_REMOVE "PottyLine", pottyTableID
		$RedoQueue
		IF !DT_SELECT("PottyLine", @"location = {pottyPosition}")
			PRINTFORMW 대기열은 이제 비었다.
		ELSE
			PRINTFORMW 대기열에는 이제 {DT_SELECT("PottyLine", @"location = {pottyPosition}")}명이 남았다.
		ENDIF
	ELSEIF !SHIRAHU(pottyChara)
		PRINTFORMW %조사처리(CALLNAME:pottyChara,"는")% 의식을 잃어 줄에서 제외됐다.
		DT_ROW_REMOVE "PottyLine", pottyTableID
		GOTO RedoQueue
	ENDIF
	NEXT
ENDIF

