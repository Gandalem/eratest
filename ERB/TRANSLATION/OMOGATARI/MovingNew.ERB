;--------------------------
;PathMoveStage
;Makes the Touhou move in their path every 2 minutes (dependent on movement)
;--------------------------

@PathMoveStage(ARG)
#DIM MoveTime
SIF charaMovementStep:ARG:0 >= DT_ROW_LENGTH(@"Movement_{ARG}") || !DT_EXIST(@"Movement_{ARG}")
	RETURN
;NAS: preoccupied path
MoveTime = 100*CapacityStats:ARG:3/100*(TIME_PROGRESS(TIME:1)/2)/100
;;#; PRINTFORML %NAME:ARG% has {MoveTime} time slots
FOR LOCAL, 0, MoveTime
IF charaMovementStep:ARG:0 >= DT_ROW_LENGTH(@"Movement_{ARG}")
	;reached destination, delete table
	CALL PathMoveEnd(ARG)
	DT_RELEASE @"Movement_{ARG}"
	charaMovementStep:ARG:0 = 0
	RETURN
ENDIF
;;#; PRINTFORML #{charaMovementStep:ARG:0}. Moving %NAME:ARG% to {DT_CELL_GET(@"Movement_{ARG}", charaMovementStep:ARG:0, "place")} %NAME_FROM_PLACE(DT_CELL_GET(@"Movement_{ARG}", charaMovementStep:ARG:0, "place"))%
CFLAG:ARG:300 = DT_CELL_GET(@"Movement_{ARG}", charaMovementStep:ARG:0, "place")
charaMovementStep:ARG:0 ++
NEXT
RETURN

