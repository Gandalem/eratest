@BENCHMARK_INFO
SETCOLOR C_YELLOW
PRINTFORML "Benchmark" Info
RESETCOLOR
PRINTFORML The "Benchmark" will benchmark your system for it's performance in eraNAS.
PRINTFORML As NAS is a very single-thread dependent game, it is recommended to have a relatively modern system for best performance.
PRINTFORML Currently, NAS does not grab system info. You will have to grab them manually.
PRINTL
{
CALL ASK_M(
    @"Start Benchmark", 1,
    @"Cancel", 1
    )
}
SELECTCASE RESULT
CASE 0
    DELALLCHARA
    RESETDATA
    benchMarkStart = 1
    inCharaCreator = 0
    LOOP_BREAK = 1
    CLEARLINE LINECOUNT+15
    PRINTFORML Starting benchmark. The game may freeze for a slight amount of time.
    TWAIT 500, 1
    BEGIN TITLE
ENDSELECT

@BENCHMARK_CHARASET
NAME:MASTER = Benchmark at date
CALLNAME:MASTER = Benchmark-chan
nameArray:MASTER:na_Name '= NAME:MASTER
nameArray:MASTER:na_CallName '= CALLNAME:MASTER
nameArray:MASTER:na_FirstName '= ""
nameArray:MASTER:na_LastName '= ""
CALLF GAMANME(MASTER,5)

@BENCHMARK_START_STAGE
benchMarkTime:benchMarkStage:0 = GETMILLISECOND()

@BENCHMARK_ADVANCE_STAGE
benchMarkTime:benchMarkStage:1 = GETMILLISECOND()
benchMarkStage++
SIF benchMarkStage >= VARSIZE("benchMarkTime")
    CALL BENCHMARK_RESULTS

@BENCHMARK_CurInfo
#DIMS benchMarkTitles = "Initialization", "Character creation", "Day start", "Weapon equipping", "Day end"
#DIM benchMarkScoreMax = 100000, 30000, 100000, 100000, 10000

FOR LOCAL, 0, VARSIZE("benchMarkTime")
    SIF !benchMarkScoreBest:2
        benchMarkScoreBest:1 += benchMarkScoreMax:LOCAL
    LOCALS '= @"%benchMarkTitles:LOCAL,20,LEFT%"
    IF LOCAL > benchMarkStage
        LOCALS += @"%" (Pending....): ",16%"
    ELSE
        benchMarkTime:LOCAL:2 = (benchMarkTime:LOCAL:1 ? benchMarkTime:LOCAL:1 # GETMILLISECOND())-benchMarkTime:LOCAL:0
        LOCALS += @" %@" ({benchMarkTime:LOCAL:2}ms): ",15%"
        IF LOCAL == benchMarkStage
            LOCALS += @" Benching..."
        ELSE
            benchMarkScore:LOCAL = (benchMarkScoreMax:LOCAL*1000)/MAX(1,benchMarkTime:LOCAL:2)
            LOCALS += @"{benchMarkScore:LOCAL,7,LEFT}/{benchMarkScoreMax:LOCAL,7,RIGHT}"
        ENDIF
    ENDIF
    PRINTFORML %LOCALS%
NEXT
benchMarkScoreBest:2 = 1

@BENCHMARK_RESULTS
CLEARLINE LINECOUNT+NUM_EXPONENT(10,6)
benchMarkStart = 0
CUSTOMDRAWLINE ─
SETCOLOR C_YELLOW
PRINTFORML Benchmark Results
RESETCOLOR
CUSTOMDRAWLINE ─
CALL BENCHMARK_CurInfo
FOR LOCAL, 0, VARSIZE("benchMarkTime")
    benchMarkScoreBest:0 += benchMarkScore:LOCAL
NEXT
CUSTOMDRAWLINE ─
FONTBOLD
PRINTFORML Score: {benchMarkScoreBest:0,7,LEFT}/{benchMarkScoreBest:1,7,RIGHT}
FONTREGULAR
;PRINTFORM Your score indicates your computer is as powerful as a 
PRINTFORML Submit your result on the eraNAS Discord by pinging @mr_pops_alot with this screenshot or log as well as the name of your CPU.
{
CALL ASK_M(
    @"Close", 1
    )
}
DELALLCHARA
RESETDATA
benchMarkStart = 0
inCharaCreator = 0
LOOP_BREAK = 1
CLEARLINE LINECOUNT+15
PRINTFORML Returning to title
TWAIT 500, 1
BEGIN TITLE
;Day start:
;Weapon giving:

;Your system is roughly equivalent to a:
[SKIPSTART]
AMD EPYC 9124: 
[SKIPEND]