PRINTBUTTON "[＋]", 1001
RESETCOLOR
PRINTL

CALL COM616_BARS(ARG, "気力", 28, "青",,NEWBASE:1)
SETCOLOR 0x70C070
PRINTBUTTON "[－]", 2000
PRINTBUTTON "[＋]", 2001
RESETCOLOR
PRINTL

IF HAS_PENIS(ARG)
	CALL COM616_BARS(ARG, "精力", 28, "黄",,NEWBASE:6)
	SETCOLOR 0x70C070
	PRINTBUTTON "[－]", 7000
	PRINTBUTTON "[＋]", 7001
