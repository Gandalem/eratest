#DIM REF TIMESTAY
#DIM REF CurCost

FOR LOCAL:300, 0, VARSIZE("TALENT")
    SIF TALENT_TR(LOCAL:300) == ""
        CONTINUE
	SIF !TALENT_CATEGORY_RACE(LOCAL:300)
		CONTINUE
    
    SELECTCASE TALENT_CATEGORY_BODY_CHANGE_BLACKLIST(LOCAL:300)
	CASE 1
		CONTINUE
	CASEELSE
		TRYCCALLFORM COM616_BODY_CHANGE_TALENT_SELECTION_{LOCAL:300}(ARG,NEWVAL,TIMESTAY,CurCost)
		CATCH
			IF TALENT:ARG:(LOCAL:300) != 0 || NEWVAL:(LOCAL:300) != TALENT:ARG:(LOCAL:300)
				IF NEWVAL:(LOCAL:300) != OLDVAL:(LOCAL:300)
					SETCOLOR C_ORANGE
				ENDIF
			PRINTFORML [{LOCAL:300}] %TALENT_TR(LOCAL:300)%: %GET_TALENTNAME_TR(LOCAL:300,NEWVAL:(LOCAL:300),ARG)%
			ELSE
			PRINTFORML [{LOCAL:300}] %TALENT_TR(LOCAL:300)%: Unset
			ENDIF
			RESETCOLOR
		ENDCATCH
    ENDSELECT
NEXT

