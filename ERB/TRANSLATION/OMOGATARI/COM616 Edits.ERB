@COM616_BODY_CHANGE_TALENT_121(ARG,NEWVAL)
#DIM REF NEWVAL,
PRINTFORML Please chose which tier do you want to manifest?
FOR LOCAL:301, -5, 7
	SIF NEWVAL:121 == LOCAL:301
		SETCOLOR C_ORANGE
	PRINTFORML [{LOCAL:301}] - 【%TOSTR_DRINKADDICT(LOCAL:301)%】
	RESETCOLOR
NEXT
PRINTFORML
PRINTFORML
PRINTFORML [999] Back
INPUT
SIF RESULT == 999
	RETURN 999
NEWVAL:121 = RESULT

@COM616_BODY_CHANGE_TALENT_COST_121(ARG,NEWVAL,TIMESTAY,CurCost)
#DIM REF NEWVAL,
#DIM REF TIMESTAY
#DIM REF CurCost
IF NEWVAL:(121) != AlcoholAddict:ARG:0
	TIMESTAY ++
	CurCost += 15000
ENDIF

@COM616_BODY_CHANGE_TALENT_EFFECT_121(ARG,NEWVAL)
#DIM REF NEWVAL,
AlcoholAddict:ARG:0 = NEWVAL:121
DrinkingExp:ARG:0 = EXP_DEMAND_22(0,91,ARG)
CALLF SILENT_ENDURANCECHANGE(ARG)



@COM616_BARS(C_ID, BASE_NAME, BAR_LENGTH, COLOR_NAME, OP, TEMPMAX)
#DIM  C_ID
#DIMS BASE_NAME
#DIM  BAR_LENGTH
#DIMS COLOR_NAME
#DIMS OP
#DIM  BASE_ID
#DIM TEMPMAX
BASE_ID = FINDELEMENT(BASENAME, BASE_NAME)
SIF BASE_ID < 0
	THROW 存在しないBASE_NAME %BASE_NAME%
SIF !TEMPMAX
	TEMPMAX = MAXBASE:C_ID:BASE_ID
SIF !STRCOUNT(OP, "「種類表記無し」")
	;Custom code, BASE_TR translates "体力" to "STA" etc.
	PRINTFORM %BASE_TR(BASE_NAME), 4% 
CALL PRINT_COLORBAR(BASE:C_ID:BASE_ID, TEMPMAX, BAR_LENGTH, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET(COLOR_NAME), RESULT:1)
IF !STRCOUNT(OP, "「数字表記無し」")
	IF MAXBASE:C_ID:BASE_ID != TEMPMAX
		SETCOLOR C_ORANGE
	ENDIF
	PRINTFORM  ({BASE:C_ID:BASE_ID,5}/{TEMPMAX,5}) 
	RESETCOLOR
ENDIF
SIF STRCOUNT(OP, "「改行」")
	PRINTFORML 


