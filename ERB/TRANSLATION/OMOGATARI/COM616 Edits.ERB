; Modular ERB: OMOGATARI/COM616 Edits.ERB

@COM616_BODY_CHANGE(ARG)
#DIM NEWTRAIT
#DIM OLDVAL, VARSIZE("TALENT")
#DIM NEWVAL, VARSIZE("TALENT")
#DIM CBC_PRIVATES, VARSIZE("TALENT")
#DIM OLDBASE, 10
#DIM NEWBASE, 10
#DIM TIMESTAY
#DIM CurCost
#DIM PAGE
#DIMS CONST DISP_NAME = "Base", "Race", "Body", "Endurance", "Sensitivities"
#DIM COM616LINECOUNT
VARSET CurCost
VARSET LOCAL
COM616LINECOUNT = LINECOUNT
;store old values
FOR LOCAL:300, 0, 999
SIF TALENT_TR(LOCAL:300) == ""
	CONTINUE
OLDVAL:(LOCAL:300) = TALENT:ARG:(LOCAL:300)
NEWVAL:(LOCAL:300) = TALENT:ARG:(LOCAL:300)
NEXT
FOR LOCAL:300, 0, 9
OLDBASE:(LOCAL:300) = MAXBASE:ARG:(LOCAL:300)
NEWBASE:(LOCAL:300) = MAXBASE:ARG:(LOCAL:300)
NEXT
;endurance values, gender, age
NEWVAL:2 = GET_GENDER(ARG)
NEWVAL:17 = CharaAge:ARG:0
NEWVAL:(56) = DrugAddict:ARG:0
NEWVAL:(57) = PeeHold:ARG:0
NEWVAL:(58) = PooHold:ARG:0
NEWVAL:(121) = AlcoholAddict:ARG:0
NEWVAL:(95) = OrgasmDeny:ARG:0
DO
$PickTrait
VARSET LOCAL
VARSET TIMESTAY
VARSET CurCost
CLEARLINE LINECOUNT - COM616LINECOUNT
DRAWLINE
PRINTFORML 몸을 어떻게 바꿀지 선택한다.
DRAWLINE
;base calc
FOR LOCAL:300, 0, 9
IF NEWBASE:(LOCAL:300) != OLDBASE:(LOCAL:300)
	TIMESTAY ++
	CurCost += (NEWBASE:(LOCAL:300) - OLDBASE:(LOCAL:300))*10000
ENDIF
NEXT
;talent cost
FOR LOCAL:300, 0, VARSIZE("TALENT")
TRYCCALLFORM COM616_BODY_CHANGE_TALENT_COST_{LOCAL:300}(ARG,NEWVAL,TIMESTAY,CurCost)
CATCH
IF NEWVAL:(LOCAL:300) != OLDVAL:(LOCAL:300)
	TIMESTAY ++
	CurCost += ABS((ABS(NEWVAL:(LOCAL:300))) - (ABS(OLDVAL:(LOCAL:300))))*10000
ENDIF
ENDCATCH
NEXT
SELECTCASE PAGE
	CASE 0
		TRYCALLFORM COM616_BODY_CHANGE_TALENT_PAGE_0(ARG,OLDBASE,NEWBASE,CurCost,TIMESTAY)
	CASEELSE
		TRYCALLFORM COM616_BODY_CHANGE_TALENT_PAGE_{PAGE}(ARG,OLDVAL,NEWVAL,CurCost,TIMESTAY)
ENDSELECT
DRAWLINE
FOR LOCAL, 0, VARSIZE("DISP_NAME")
SIF PAGE == LOCAL
	SETCOLOR 0x00FFFF
;exception for player character
PRINTBUTTON DISP_NAME:LOCAL, LOCAL + 8000
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTL
PRINTFORML 비용: %金額表示(CurCost)%, {MAX(TIMESTAY,3)}일
PRINTFORML [999] - 설정!
PRINTFORML [ -1] - 여기서 나가게 해줘!
INPUT
SELECTCASE RESULT
	CASE 999
		TIMESTAY = MAX(TIMESTAY,3)
		LOCALS '= @"필요한 치료는 약 {TIMESTAY}일이 걸립니다. 당신은 %MedicalCenterName()%에 머물게 됩니다."
		LOCALS += @"우리는 어떠한 장기적인 부작용이나 당신의 건강에 어떤 방식으로든 해를 끼치지 않기 위해 우리가 할 수 있는 모든 것을 할 것입니다."
		LOCALS += @"「이 모든 것에 상당한 비용이 들 것이라는 것은 말할 필요가 없다 \@ CurCost >= 100000 ? 많이 # 조금 \@. 준비됐나?」"
		CALL COM616_EIRINSPEAK, LOCALS
		CALL ASK_YN
		SIF RESULT
			GOTO PickTrait
		CALL COM616_CHECK(CurCost)
		SIF RESULT
			GOTO PickTrait
		FOR LOCAL:302, 0, 400
		IF NEWVAL:(LOCAL:302) != OLDVAL:(LOCAL:302)
			;effects
			TRYCCALLFORM COM616_BODY_CHANGE_TALENT_EFFECT_{LOCAL:302}(ARG,NEWVAL)
			CATCH
			TALENT:ARG:(LOCAL:302) = NEWVAL:(LOCAL:302)
			ENDCATCH
		ENDIF
		NEXT
		FOR LOCAL:300, 0, 9
		MAXBASE:ARG:(LOCAL:300) = NEWBASE:(LOCAL:300)
		NEXT
		;age
		SIF NEWVAL:17 != charaAge:ARG:0
			charaAge:ARG:0 = NEWVAL:17
		CALL newGenderSystemConvert(MASTER)
		CALL COM616_PAY(CurCost)
		PRINTFORMW 그 조치는 당신이 '예'라고 말한 직후 즉시 시작된다.
		PRINTFORMW 당신은 %MedicalCenterName()%에서 %NUM_COUNT(TIMESTAY)%일 후에 퇴원하며, 그때 집으로 돌아간다.
		PRINTFORMW 대부분 괜찮게 느껴지며, 새로운 몸을 본 광경이 짜릿함을 안겨준다.
		PRINTFORMW 당장 자랑하고 싶어서 견딜 수가 없다...
		FOR LOCAL, 0, TIMESTAY
		;PRINTFORMW DAY:3 - {DAY:3}
		DAY ++
		DAY:3 ++
		CALL CHANGE_MONTH
		;PRINTFORMW AFTER {DAY:3}
		NEXT
		CFLAG:MASTER:現在位置 = CFLAG:MASTER:初期位置
		CFLAG:MASTER:就寝時間 = DAY * 1440 + TIME
		;day ends here
		CALL OYASUMI()
		RETURN 1
	CASE -1
		RETURN -1
	CASE 8000 TO VARSIZE("DISP_NAME")+8000
		PAGE = RESULT-8000
	CASE IS >= 1000
		NEWTRAIT = (RESULT / 1000) - 1
		SELECTCASE RESULT % 1000
			CASE 0
				SIF NEWBASE:NEWTRAIT > 100
					NEWBASE:NEWTRAIT -= 100
			CASE 1
				NEWBASE:NEWTRAIT += 100
		ENDSELECT
	CASEELSE
		NEWTRAIT = RESULT
		CBC_PRIVATES:RESULT = TALENT:ARG:NEWTRAIT
		TRYCCALLFORM COM616_BODY_CHANGE_TALENT_{NEWTRAIT}(ARG,NEWVAL)
		CATCH
		IF GET_TALENTNAME(NEWTRAIT,-1) != GET_TALENTNAME(NEWTRAIT,1) || GET_TALENTNAME(NEWTRAIT,2) != GET_TALENTNAME(NEWTRAIT,1)
			PRINTFORML 어떤 티어를 발현하고 싶은지 선택해 주세요?
			FOR LOCAL:301, -10, 20
			SIF GET_TALENTNAME_TR(NEWTRAIT,LOCAL:301) == "" && LOCAL:301 != 0
				CONTINUE
			SIF NEWVAL:NEWTRAIT == LOCAL:301
				SETCOLOR C_ORANGE
			IF NEWTRAIT == 2
				SIF TOSTR_GENDER(LOCAL:301) == "" && LOCAL:301 != 0
					CONTINUE
				PRINTFORML [{LOCAL:301}] - 【%TOSTR_GENDER(LOCAL:301)%】
			ELSE
				PRINTFORML [{LOCAL:301}] - 【%GET_TALENTNAME_TR(NEWTRAIT,LOCAL:301)%】
			ENDIF
			RESETCOLOR
			NEXT
			PRINTFORML
			PRINTFORML
			PRINTFORML [999] 되돌리기
			INPUT
			SIF RESULT == 999
				GOTO PickTrait
			NEWVAL:NEWTRAIT = RESULT
		ELSEIF NEWVAL:NEWTRAIT == 1
			NEWVAL:NEWTRAIT = 0
		ELSE
			NEWVAL:NEWTRAIT = 1
		ENDIF
		ENDCATCH
		SIF RESULT == 999
			GOTO PickTrait
ENDSELECT
LOOP 1

@COM616_BODY_CHANGE_TALENT_PAGE_0(ARG,OLDBASE,NEWBASE,CurCost,TIMESTAY)
