; Modular ERB: OMOGATARI/INTERNET/Internet_4.ERB

@Internet_4
#DIM SelectedSkillID
#DIM nInput
#DIMS STATIC TrainerName = "Basic", "Intermediate", "Advanced"
#DIMS STATIC TrainerDesc = "Our most basic trainer. Perfect for those on a budget", "Higher level training that increases your potential.", "Vigorous training by one of our top teachers. Increase your potential fast.",
#DIM STATIC TrainerPrice = 8000, 25000, 100000
#DIM STATIC TrainerEXP = 30, 65, 250
#DIM STATIC TrainerPot = 0, 1, 4
#DIM DYNAMIC teachLevelStudent
#DIMS skillLabel
FONTSTYLE 1
SETCOLOR C_GREEN
PRINTFORML 스킬 공유하기
RESETCOLOR
FONTREGULAR
FONTITALIC
PRINTFORML 고속 차선에서의 학습
FONTREGULAR
FONTSTYLE
PRINTFORML ───────────────────────────────
PRINTFORML 안녕 %CALLNAME:MASTER%!
PRINTBUTTON "Home | 집 ", 1000
PRINTBUTTON "스킬 | ", 1001
PRINTBUTTON "유술 ", 1002
PRINTL
PRINTFORML ───────────────────────────────
PRINTL
SELECTCASE SiteSubpage
	CASE 1000
		SelectedSkillID = -1
		PRINTFORML 시작하려면 스킬 타입을 선택한다.
		PRINTL
		PRINTFORML 스킬은 사격이나 지식, 또는 대화와 같이 누구나 할 수 있는 일반적인 기술이다.
		PRINTFORML 요술은 마법을 포함하며 불을 발사하거나 정수로 물건을 만들거나 심지어 사람들을 치유하는 것과 같은 일들을 가능하게 한다.
		PRINTFORML  *요술 훈련은 해당 요술이 훈련된 자만이 할 수 있다.
		PRINTL
		SETCOLOR 0x99ffff
		PRINTBUTTON "스킬", 1001
		RESETCOLOR
		PRINT   | 
		SETCOLOR 0xff9999
		PRINTBUTTON "유술", 1002
		RESETCOLOR
		PRINTL
		; PRINTL
		; PRINTFORML Or pick one of these skills we think you could train.
		; PRINTL
	CASE 1001
		SELECTCASE SelectedSkillID
			CASE -1
				PRINTFORML 훈련: 선택된 항목 없음
			CASEELSE
				SELECTCASE SelectedSkillID
					CASE 45 TO 49
						teachLevelStudent = TALENT:MASTER:SelectedSkillID
					CASEELSE
						teachLevelStudent = ABL:MASTER:SelectedSkillID
				ENDSELECT
				skillLabel '= ABL_TR(SelectedSkillID)
		ENDSELECT
		GOTO PickTrainer
	CASE 1002
		SELECTCASE SelectedSkillID
			CASE -1
				PRINTFORML 훈련: 선택된 것 없음
			CASEELSE
				TRYCALLFORMF NAS_ESP_{SelectedSkillID}
				teachLevelStudent = YoujutsuLevel:MASTER:SelectedSkillID
				skillLabel '= NAS_ESP_NAME
		ENDSELECT
		$PickTrainer
		IF SelectedSkillID != -1
			PRINTFORM 훈련: 
			PRINTFORM %skillLabel% (
			RESETCOLOR
			CALL PRINT_RANK(teachLevelStudent,"MAX_6")
			PRINTFORML  {teachLevelStudent,2})
			PRINTL
			PRINTFORML 세 가지 트레이너 레벨 중 하나를 선택하라.
			PRINTFORML 가격은 회당이다.
			PRINTL
			FOR LOCAL,0,VARSIZE("TrainerName")
			FONTBOLD
			PRINTFORML [{LOCAL}] %TrainerName:LOCAL,12,LEFT% %金額表示(TrainerPrice:LOCAL),6,LEFT%
			FONTREGULAR
			SETCOLOR C_GRAY
			PRINTFORMSL TrainerDesc:LOCAL
			SIF nSpoilerMode
				PRINTFORML 경험치: +{TrainerEXP:LOCAL,4} | 잠재력: +{TrainerPot:LOCAL,2}
			RESETCOLOR
			NEXT
		ENDIF
		PRINTL
		PRINTFORML [-2] %COND_STR("Youjutsu ",SiteSubpage==1002)% 스킬을 선택한다.
ENDSELECT
INPUT
nInput = RESULT
SELECTCASE nInput
	CASE -2
		SELECTCASE SiteSubpage
			CASE 1001
				;Skills
				FOR LOCAL,0,VARSIZE("ABL")
				SIF ABL_TO_EXP(LOCAL) == -1
					CONTINUE
				SELECTCASE LOCAL
					CASE 45 TO 49
						teachLevelStudent = TALENT:MASTER:LOCAL
					CASEELSE
						teachLevelStudent = ABL:MASTER:LOCAL
				ENDSELECT
				;[ 0] - Fire
				PRINTFORM [{LOCAL,2}] %ABL_TR(LOCAL), 15, LEFT% (
				RESETCOLOR
				CALL PRINT_RANK(teachLevelStudent,"MAX_6")
				PRINTFORM  {teachLevelStudent,2})
				NEXT
				PRINTL
				PRINTFORML [-1] 뒤로
				INPUT
				SELECTCASE RESULT
					CASE 0 TO VARSIZE("ABL")
						SIF ABL_TO_EXP(RESULT) == -1
							RETURN SiteSubpage
						SelectedSkillID = RESULT
				ENDSELECT
			CASE 1002
				;Youjutsu
				FOR LOCAL, 0, 64
				IF GETBIT(TALENT:MASTER:ESP, LOCAL) && STRLENS(EsperAbilitySTR(LOCAL))
					SELECTCASE LOCAL
						CASE 18
							SIF !GETBIT(nPee,1) && !GETBIT(nScat,2)
								CONTINUE
						CASE 19
							SIF !nHypno
								CONTINUE
						CASEELSE
							SIF !EXISTFUNCTION(@"%TOUPPER("EsperMenuPage_")%{LOCAL}")
								CONTINUE
					ENDSELECT
					;[ 0] - Fire
					TRYCALLFORMF NAS_ESP_{LOCAL}
					PRINTFORM [{LOCAL,2}] %NAS_ESP_NAME, 15, LEFT% (
					RESETCOLOR
					CALL PRINT_RANK(YoujutsuLevel:MASTER:LOCAL,"MAX_6")
					PRINTFORM  {YoujutsuLevel:MASTER:LOCAL,2}
					PRINTL )
				ENDIF
				NEXT
				PRINTL
				PRINTFORML [-1] 뒤로
				INPUT
				SELECTCASE RESULT
					CASE 0 TO 64
						SIF !GETBIT(TALENT:MASTER:ESP, RESULT)
							RETURN SiteSubpage
						SelectedSkillID = RESULT
				ENDSELECT
		ENDSELECT
	CASE 0 TO VARSIZE("TrainerName")
		SELECTCASE SiteSubpage
			CASE 1001
				IF ABL_TO_EXP(SelectedSkillID) == -1
					PRINTFORML 스킬에 대한 트레이너를 찾을 수 없습니다: %ABL_TR(SelectedSkillID)%
					PRINTFORMW 나중에 다시 시도해 주세요.
					RETURN SiteSubpage
				ENDIF
			CASE 1002
				IF !INRANGE(SelectedSkillID,0,63) || !EXISTFUNCTION(@"NAS_ESP_{SelectedSkillID}")
					PRINTFORML 스킬에 대한 트레이너를 찾을 수 없습니다: 미지정
					PRINTFORMW 나중에 다시 시도해 주세요.
					RETURN SiteSubpage
				ELSEIF !GETBIT(TALENT:MASTER:ESP,SelectedSkillID)
					TRYCALLFORMF NAS_ESP_{SelectedSkillID}
					PRINTFORML 요술 스킬 '%NAS_ESP_NAME%'를 훈련할 수 없다.
					PRINTFORMW 이 스킬을 습득하지 않았다.
					RETURN SiteSubpage
				ENDIF
			CASEELSE
				PRINTFORML 스킬에 대한 트레이너를 찾을 수 없습니다: 미지정
				PRINTFORMW 나중에 다시 시도해 주세요.
				RETURN SiteSubpage
		ENDSELECT
		CALL PAY_MONEY_YEN(TrainerPrice:nInput,1)
		SETCOLOR C_GREEN
		PRINTFORML 이용해 주셔서 감사합니다!
		RESETCOLOR
		PRINTFORMW 트레이너가 연결될 때까지 기다려 주세요.
		PRINTL ...
		TWAIT 150, 1
		PRINTL ..
		TWAIT 150, 1
		PRINTL .
		TWAIT 150, 1
		PRINTL
		PRINTFORML 트레이너 연결됨. 즐겁게 해라.
		PRINTL
		SELECTCASE SiteSubpage
			CASE 1001
				PRINTFORMW 당신과 선생님은 %ABL_TR(SelectedSkillID)% 기교를 가르치기 시작한다.
				VARSET LOCAL, -1
				LOCAL = ABL_TO_EXP(SelectedSkillID)
				LOCAL:1 = RESULT:1
				LOCAL:2 = RESULT:2
				FOR LOCAL:3, 0, 3
				SIF LOCAL:(LOCAL:3) > -1
					CALL AddEXP(EXPNAME:(LOCAL:(LOCAL:3)),MASTER,TrainerEXP:nInput)
				NEXT
				IF TrainerPot:nInput
					FOR LOCAL:3, 0, 3
					SIF LOCAL:(LOCAL:3) > -1
						CALL EXPPotentialChangeMsg(MASTER,LOCAL:(LOCAL:3),TrainerPot:nInput)
					NEXT
				ENDIF
			CASE 1002
				TRYCALLFORMF NAS_ESP_{SelectedSkillID}
				PRINTFORML 당신과 선생님이 %NAS_ESP_NAME% 유술을 가르치기 시작한다.
				CALL AddYoujutsuEXP(MASTER,SelectedSkillID,TrainerEXP:nInput)
				CALL YoujutsuPotentialChangeMsg(MASTER,SelectedSkillID,TrainerPot:nInput)
		ENDSELECT
	CASE IS >= 1000
		SelectedSkillID = -1
		SiteSubpage = nInput
ENDSELECT
RETURN SiteSubpage
;Basic Trainer
;   +30 EXP | 0 Pot | 2500 Yen
;Intermediate Trainer
;   +50 EXP | +1 Pot | 8000 Yen
;Advanced Trainer
;   +100 EXP | +2 Pot | 25000 Yen
