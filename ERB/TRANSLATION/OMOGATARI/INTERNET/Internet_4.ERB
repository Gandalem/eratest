@Internet_4
#DIM SelectedSkillID
#DIM nInput
#DIMS STATIC TrainerName = "Basic", "Intermediate", "Advanced"
{
#DIMS STATIC TrainerDesc =
"Our most basic trainer. Perfect for those on a budget",
"Higher level training that increases your potential.",
"Vigorous training by one of our top teachers. Increase your potential fast.",
}
#DIM STATIC TrainerPrice = 8000, 25000, 100000
#DIM STATIC TrainerEXP = 30, 65, 250
#DIM STATIC TrainerPot = 0, 1, 4
#DIM DYNAMIC teachLevelStudent
#DIMS skillLabel

FONTSTYLE 1
SETCOLOR C_GREEN
PRINTFORML Share A Skill
RESETCOLOR
FONTREGULAR
FONTITALIC
PRINTFORML Learning in the fast lane
FONTREGULAR
FONTSTYLE
PRINTFORML ───────────────────────────────
PRINTFORML Hello %CALLNAME:MASTER%!
PRINTBUTTON "Home | ", 1000
PRINTBUTTON "Skills | ", 1001
PRINTBUTTON "Youjutsu | ", 1002
PRINTL
PRINTFORML ───────────────────────────────
PRINTL
SELECTCASE SiteSubpage
CASE 1000
    SelectedSkillID = -1
    PRINTFORML To get started, select at a skill type.
    PRINTL
    PRINTFORML Skills are regular skills that anyone can do such as shooting, knowledge, or talking.
    PRINTFORML Youjutsu involves magic and allows for stuff like casting fire, creating objects with essense, or even healing people.
    PRINTFORML  *Youjutsu training can only be done by those with that Youjutsu trained.
    PRINTL
    SETCOLOR 0x99ffff
    PRINTBUTTON "Skills", 1001
    RESETCOLOR
    PRINT   | 
    SETCOLOR 0xff9999
    PRINTBUTTON "Youjutsu", 1002
    RESETCOLOR
    PRINTL
    ; PRINTL
    ; PRINTFORML Or pick one of these skills we think you could train.
    ; PRINTL
CASE 1001
    SELECTCASE SelectedSkillID
    CASE -1
        PRINTFORML Training: Nothing Selected
    CASEELSE
        SELECTCASE SelectedSkillID
        CASE 45 TO 49
            teachLevelStudent = TALENT:MASTER:SelectedSkillID
        CASEELSE
            teachLevelStudent = ABL:MASTER:SelectedSkillID
        ENDSELECT
        skillLabel '= ABL_TR(SelectedSkillID)
    ENDSELECT
    GOTO PickTrainer
CASE 1002
    SELECTCASE SelectedSkillID
    CASE -1
        PRINTFORML Training: Nothing Selected
    CASEELSE
        TRYCALLFORMF NAS_ESP_{SelectedSkillID}
        teachLevelStudent = YoujutsuLevel:MASTER:SelectedSkillID
        skillLabel '= NAS_ESP_NAME
    ENDSELECT
    $PickTrainer
    IF SelectedSkillID != -1
        PRINTFORM Training: 
        PRINTFORM %skillLabel% (
        RESETCOLOR
        CALL PRINT_RANK(teachLevelStudent,"MAX_6")
        PRINTFORML  {teachLevelStudent,2})
        PRINTL
        PRINTFORML Pick from one of our three trainer levels.
        PRINTFORML The price is per session.
        PRINTL
        FOR LOCAL,0,VARSIZE("TrainerName")
            FONTBOLD
            PRINTFORML [{LOCAL}] %TrainerName:LOCAL,12,LEFT% %金額表示(TrainerPrice:LOCAL),6,LEFT%
            FONTREGULAR
            SETCOLOR C_GRAY
            PRINTFORMSL TrainerDesc:LOCAL
            SIF nSpoilerMode
            PRINTFORML EXP: +{TrainerEXP:LOCAL,4} | Potential: +{TrainerPot:LOCAL,2}
            RESETCOLOR
        NEXT
    ENDIF
    PRINTL
    PRINTFORML [-2] Select a %COND_STR("Youjutsu ",SiteSubpage==1002)%skill
ENDSELECT
INPUT
nInput = RESULT
SELECTCASE nInput
CASE -2
    SELECTCASE SiteSubpage
    CASE 1001
		;Skills
		FOR LOCAL,0,VARSIZE("ABL")
			SIF ABL_TO_EXP(LOCAL) == -1
				CONTINUE
			SELECTCASE LOCAL
			CASE 45 TO 49
				teachLevelStudent = TALENT:MASTER:LOCAL
			CASEELSE
				teachLevelStudent = ABL:MASTER:LOCAL
			ENDSELECT
			;[ 0] - Fire
			PRINTFORM [{LOCAL,2}] %ABL_TR(LOCAL), 15, LEFT% (
			RESETCOLOR
			CALL PRINT_RANK(teachLevelStudent,"MAX_6")
			PRINTFORM  {teachLevelStudent,2})
		NEXT
        PRINTL
        PRINTFORML [-1] Back
        INPUT
        SELECTCASE RESULT
        CASE 0 TO VARSIZE("ABL")
            SIF ABL_TO_EXP(RESULT) == -1
                RETURN SiteSubpage
            SelectedSkillID = RESULT
        ENDSELECT
    CASE 1002
		;Youjutsu
		FOR LOCAL, 0, 64
			IF GETBIT(TALENT:MASTER:ESP, LOCAL) && STRLENS(EsperAbilitySTR(LOCAL))
				SELECTCASE LOCAL
				CASE 18
					SIF !GETBIT(nPee,1) && !GETBIT(nScat,2)
						CONTINUE
				CASE 19
					SIF !nHypno
						CONTINUE
				CASEELSE
					SIF !EXISTFUNCTION(@"%TOUPPER("EsperMenuPage_")%{LOCAL}")
						CONTINUE
				ENDSELECT
				;[ 0] - Fire
				TRYCALLFORMF NAS_ESP_{LOCAL}
				PRINTFORM [{LOCAL,2}] %NAS_ESP_NAME, 15, LEFT% (
				RESETCOLOR
                CALL PRINT_RANK(YoujutsuLevel:MASTER:LOCAL,"MAX_6")
                PRINTFORM  {YoujutsuLevel:MASTER:LOCAL,2}
				PRINTL )
			ENDIF
		NEXT
        PRINTL
        PRINTFORML [-1] Back
        INPUT
        SELECTCASE RESULT
        CASE 0 TO 64
            SIF !GETBIT(TALENT:MASTER:ESP, RESULT)
                RETURN SiteSubpage
            SelectedSkillID = RESULT
        ENDSELECT
    ENDSELECT
CASE 0 TO VARSIZE("TrainerName")
    SELECTCASE SiteSubpage
    CASE 1001
        IF ABL_TO_EXP(SelectedSkillID) == -1
            PRINTFORML Cannot find a trainer for the skill: %ABL_TR(SelectedSkillID)%
            PRINTFORMW Please try again later.
            RETURN SiteSubpage
        ENDIF
    CASE 1002
        IF !INRANGE(SelectedSkillID,0,63) || !EXISTFUNCTION(@"NAS_ESP_{SelectedSkillID}")
            PRINTFORML Cannot find a trainer for the skill: Unspecified
            PRINTFORMW Please try again later.
            RETURN SiteSubpage
        ELSEIF !GETBIT(TALENT:MASTER:ESP,SelectedSkillID)
            TRYCALLFORMF NAS_ESP_{SelectedSkillID}
            PRINTFORML Cannot train the Youjutsu skill: %NAS_ESP_NAME%
            PRINTFORMW You do not have this skill learned.
            RETURN SiteSubpage
        ENDIF
    CASEELSE
        PRINTFORML Cannot find a trainer for the skill: Unspecified
        PRINTFORMW Please try again later.
        RETURN SiteSubpage
    ENDSELECT
    CALL PAY_MONEY_YEN(TrainerPrice:nInput,1)
    SETCOLOR C_GREEN
    PRINTFORML Thank you for your patronage!
    RESETCOLOR
    PRINTFORMW Please wait for a trainer to connect to you.
    PRINTL ...
    TWAIT 150, 1
    PRINTL ..
    TWAIT 150, 1
    PRINTL .
    TWAIT 150, 1
    PRINTL
    PRINTFORML Trainer connected. Have fun.
    PRINTL
    SELECTCASE SiteSubpage
    CASE 1001
        PRINTFORMW You and the teacher begin teaching %ABL_TR(SelectedSkillID)% techniques.
        VARSET LOCAL, -1
        LOCAL = ABL_TO_EXP(SelectedSkillID)
        LOCAL:1 = RESULT:1
        LOCAL:2 = RESULT:2
        FOR LOCAL:3, 0, 3
            SIF LOCAL:(LOCAL:3) > -1
                CALL AddEXP(EXPNAME:(LOCAL:(LOCAL:3)),MASTER,TrainerEXP:nInput)
        NEXT
        IF TrainerPot:nInput
            FOR LOCAL:3, 0, 3
                SIF LOCAL:(LOCAL:3) > -1
                    CALL EXPPotentialChangeMsg(MASTER,LOCAL:(LOCAL:3),TrainerPot:nInput)
            NEXT
        ENDIF
    CASE 1002
			TRYCALLFORMF NAS_ESP_{SelectedSkillID}
			PRINTFORML You and the teacher begin teaching %NAS_ESP_NAME% Youjutsu.
            CALL AddYoujutsuEXP(MASTER,SelectedSkillID,TrainerEXP:nInput)
            CALL YoujutsuPotentialChangeMsg(MASTER,SelectedSkillID,TrainerPot:nInput)
    ENDSELECT
CASE IS >= 1000
    SelectedSkillID = -1
    SiteSubpage = nInput
ENDSELECT

RETURN SiteSubpage

;Basic Trainer
;   +30 EXP | 0 Pot | 2500 Yen
;Intermediate Trainer
;   +50 EXP | +1 Pot | 8000 Yen
;Advanced Trainer
;   +100 EXP | +2 Pot | 25000 Yen