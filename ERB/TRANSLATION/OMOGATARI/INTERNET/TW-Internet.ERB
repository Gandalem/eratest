PRINTFORML Advertisement:
;shitpost articles
CALL FISHER_YATES_SHAFFLE(100)
FOR GetRep, 0, 100
	Rep = SHAFFLE_ARRAY:(GetRep)
	TRYCALLFORM NEWSPAPER_{Rep}
	SIF RESULT > 0
		BREAK
NEXT
