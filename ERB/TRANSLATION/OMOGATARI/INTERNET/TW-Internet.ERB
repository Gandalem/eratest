@Internet_Home
CALL InternetHeader
TRYCALLFORM Internet_{CurrentSite}
IF RESULT == 999999
    RETURN
ELSEIF RESULT == 9999
    CurrentSite = 0
    RESTART
ELSEIF INRANGE(RESULT,1,WebSiteCount)
    ;SIF WebSitesKnown:RESULT
    CurrentSite = RESULT
    RESTART
ELSEIF !RESULT
    CALL Internet_Error
    CurrentSite = 0
    RESTART
ELSE
    RESTART
ENDIF



