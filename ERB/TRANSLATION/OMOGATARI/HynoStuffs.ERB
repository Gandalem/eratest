; Modular ERB: OMOGATARI/HynoStuffs.ERB
;-------------------------------------------------
; custom code
; a dump of Mr Pops Alot's hypnosis-related stuff
;-------------------------------------------------
;-------------------------------------------------
; ResetHypno
; Sets their max hypnosis resistance
; ARGS: ARG (Target, required)
;-------------------------------------------------

@ResetHypno(ARG)
MAXBASE:ARG:Hypno = 500
;buff bladders
IF OrgasmDeny:ARG:0 >= 5
	MAXBASE:ARG:Hypno = MAXBASE:ARG:Hypno*5
ELSEIF OrgasmDeny:ARG:0 == 4
	MAXBASE:ARG:Hypno = MAXBASE:ARG:Hypno*3
ELSEIF OrgasmDeny:ARG:0 == 3
	MAXBASE:ARG:Hypno = MAXBASE:ARG:Hypno*2
ELSEIF OrgasmDeny:ARG:0 == 2
	MAXBASE:ARG:Hypno = MAXBASE:ARG:Hypno*3/2
ELSEIF OrgasmDeny:ARG:0 == 1
	MAXBASE:ARG:Hypno = MAXBASE:ARG:Hypno*5/4
ENDIF
;-------------------------------------------------
; HypnoFlavor
; Gets the color of pee from their TCVAR
; ARGS: ARG (Target, required)
;-------------------------------------------------

@HypnoFlavor(ARG)
CALL ResetHypno(ARG)
SETCOLOR C_P_PURPLE
IF BASE:ARG:Hypno >= MAXBASE:ARG:Hypno*9/10
	PRINTFORML 당신의 속임수에 취해, %CALLNAME:ARG%은(는) 당신이 무엇을 하고 있는지 모르거나 신경 쓰지 않는 것 같다.
	PRINTFORML 곱셈 계수로 {(25-(ABL:ARG:HypnoAddict*2))/100}을 얻었다
	TIMES CUP:ARG:反感 , 0
	;increase pleasure
ELSEIF BASE:ARG:Hypno >= MAXBASE:ARG:Hypno*3/4
	PRINTFORML %CALLNAME:ARG%은(는) 무언가를 상상하며 집중하지 못한다.
	TIMES CUP:ARG:反感 , 0.1
ELSEIF BASE:ARG:Hypno >= MAXBASE:ARG:Hypno*6/5
	TIMES CUP:ARG:反感 , 0.25
ELSEIF BASE:ARG:Hypno >= MAXBASE:ARG:Hypno*1/2
	PRINTFORML %CALLNAME:ARG%는 최면적인 오라에 정신을 빼앗긴다.
	TIMES CUP:ARG:反感 , 0.4
ELSEIF BASE:ARG:Hypno >= MAXBASE:ARG:Hypno*1/4
	PRINTFORML %CALLNAME:ARG%은(는) 최면이 작용하는 것을 느끼기 시작한다.
	TIMES CUP:ARG:反感 , 0.5
ENDIF
RESETCOLOR
