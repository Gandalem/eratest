; 体图差分{
@AIDL_BUILD_BodyNude(Version, CHARA, buildPregnant, buildBreasts, buildPenis, buildClothes, buildClothSpecial)
#DIMS Version
#DIM G_ID
#DIM CHARA
#DIMS buildPregnant
#DIMS buildBreasts
#DIMS buildPenis
#DIMS buildClothes
#DIMS buildClothSpecial
#DIMS bodyDef

bodyDef = %AIDL_bodyDef(Version, CHARA, buildPregnant, buildBreasts, buildPenis, buildClothes, buildClothSpecial)%
SIF SPRITECREATED(bodyDef)
	RETURN

G_ID = 0
;CALL COMPOSE_IMAGE(G_ID, "ダミー", 0, 0, 300, 300)
CALL COMPOSE_IMAGE(G_ID, "ダミー", 0, 0, 1024,1024)

; Body
CALL AIDL_GET_BodyNude(Version, CHARA, buildPregnant)
SIF RESULT
	CALL COMPOSE_IMAGE(G_ID, RESULTS)

; Torso
CALL AIDL_GET_TorsoNude(Version, CHARA, buildBreasts)
SIF RESULT
	CALL COMPOSE_IMAGE(G_ID, RESULTS)

; Belly
CALL AIDL_GET_BellyNude(Version, CHARA, buildPregnant, buildBreasts)
SIF RESULT
	CALL COMPOSE_IMAGE(G_ID, RESULTS)

; Penis
CALL AIDL_GET_Penis(Version, CHARA, buildPenis)
SIF RESULT
	CALL COMPOSE_IMAGE(G_ID, RESULTS)

; 合成体图
SPRITECREATE bodyDef, G_ID
RETURN


@AIDL_BUILD_BodyUnderwear(Version, CHARA, buildPregnant, buildBreasts, buildPenis, buildClothes, buildClothSpecial)
#DIMS Version
#DIM G_ID
#DIM CHARA
#DIMS buildPregnant
#DIMS buildBreasts
#DIMS buildPenis
#DIMS buildClothes
#DIMS buildClothSpecial
#DIM buildSpecial
#DIMS bodyDef
#DIMS buildDef,2	; 0是胖次，1是胸罩

bodyDef = %AIDL_bodyDef(Version, CHARA, buildPregnant, buildBreasts, buildPenis, buildClothes, buildClothSpecial)%
SIF SPRITECREATED(bodyDef)
	RETURN

G_ID = 0
;CALL COMPOSE_IMAGE(G_ID, "ダミー", 0, 0, 300, 300)
CALL COMPOSE_IMAGE(G_ID, "ダミー", 0, 0, 1024,1024)

; Underwear，由于有些特殊下着不支持膨腹状态，故优先判定
CALL AIDL_GET_Underwear(Version, CHARA, buildPregnant, buildBreasts, buildPenis, buildClothes, buildClothSpecial, buildSpecial)
buildDef:0 = %RESULTS:0%
buildDef:1 = %RESULTS:1%
DEBUGPRINTFORML AIDL IMG: underwear defs %buildDef:0% - %buildDef:1%

; 躯干差分
CALL AIDL_GET_BodyNude(Version, CHARA, buildPregnant)
IF RESULT
	DEBUGPRINTFORML AIDL IMG: nude defs  %RESULTS%
	CALL COMPOSE_IMAGE(G_ID, RESULTS)
ENDIF

; 胸部差分
CALL AIDL_GET_TorsoNude(Version, CHARA, buildBreasts)
SIF RESULT
	CALL COMPOSE_IMAGE(G_ID, RESULTS)

; 腹部差分
CALL AIDL_GET_BellyNude(Version, CHARA, buildPregnant, buildBreasts)
SIF RESULT
	CALL COMPOSE_IMAGE(G_ID, RESULTS)

; Underwear
SIF buildDef:0 != ""
	CALL COMPOSE_IMAGE(G_ID, buildDef:0)
SIF buildDef:1 != ""
	CALL COMPOSE_IMAGE(G_ID, buildDef:1)

; Penis
CALL AIDL_GET_Penis(Version, CHARA, buildPenis)
SIF RESULT
	CALL COMPOSE_IMAGE(G_ID, RESULTS)

; 合成体图
SPRITECREATE bodyDef, G_ID
RETURN


