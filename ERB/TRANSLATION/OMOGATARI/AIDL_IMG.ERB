;////////////////////////////////////////
;Functions
;////////////////////////////////////////

;////////////////////////
; GET_BASE_RESOURCE{
;When the function is called, the expression may be "オナニー" "通常"，Clothing may be "服" "裸"
;JP terms for TW compatibility. will be translated to AIDL friendly terms in the pipeline
;////////////////////////
@AIDL_GET_BASE_RESOURCE(CHARA, gbrClothes = "", gbrExpression:0 = "")
#DIM CHARA
#DIMS gbrPregnant
#DIMS gbrBreasts
#DIMS gbrPenis
#DIMS gbrClothes
#DIMS gbrClothSpecial
#DIM gbrClothSpecialRet		; 0: Naked, 1: bra and panties, 2: one-piece bottoms
#DIMS gbrExpression, 2
#DIMS gbrImageDefName, 2
#DIMS Version

;AIDL_{gbrPregnant}_{gbrBreasts}_{gbrPenis}_{gbrClothes}_{gbrExpression}_{CHARA}

;Initialization
IF gbrClothes == ""
	gbrClothes = %AIDL_GetClothesState(CHARA)%
ELSE
	gbrClothes = %AIDL_TranslateClothesState(gbrClothes)%
ENDIF
gbrPregnant = %AIDL_GetPregnancy(CHARA)%
gbrBreasts = %AIDL_GetBreasts(CHARA)%
gbrPenis = %AIDL_GetDick(CHARA, gbrClothes)%
gbrClothSpecial = 

Version = 
RESULT = 0
TRYCALLFORM AIDL_Version{NO:CHARA}
SIF RESULT
	Version = %RESULTS%

IF gbrClothes == "cClothed"
	TRYCCALLFORM AIDL__DetectClothesSpecial%Version%_{NO:CHARA}
	IF RESULT
		gbrClothSpecial = %RESULTS%
	ENDIF
	CATCH
	ENDCATCH
ELSEIF STRFIND(gbrClothes,"cBra") > -1 || STRFIND(gbrClothes,"cPanties") > -1
	TRYCCALLFORM AIDL_DetectUndiesSpecial%Version%_{NO:CHARA}
	IF RESULT
		gbrClothSpecial = %RESULTS%
		gbrClothSpecialRet = RESULT
	ENDIF
	CATCH
	ENDCATCH
ENDIF

IF gbrExpression:0 == ""
	CALL AIDL_GetExpression(CHARA)
	gbrExpression:0 = %RESULTS:0%
	gbrExpression:1 = %RESULTS:1%
ELSE
	gbrExpression:0 '= AIDL_TranslateExpressionState(gbrExpression:0)

ENDIF

gbrImageDefName:0 = %AIDL_GetDefName(Version, CHARA, gbrPregnant, gbrBreasts, gbrPenis, gbrClothes, gbrClothSpecial, gbrExpression:0)%
SIF !SPRITECREATED(gbrImageDefName:0)
	CALL AIDL_BUILD_BASE_IMAGE(Version, CHARA, gbrPregnant, gbrBreasts, gbrPenis, gbrClothes, gbrClothSpecial, gbrExpression:0, gbrClothSpecialRet)

IF gbrExpression:1 == ""
	gbrImageDefName:1 = 
ELSE
	gbrImageDefName:1 = %AIDL_GetDefName(Version, CHARA, gbrPregnant, gbrBreasts, gbrPenis, gbrClothes, gbrClothSpecial, gbrExpression:1)%
	SIF !SPRITECREATED(gbrImageDefName:1)
		CALL AIDL_BUILD_BASE_IMAGE(Version, CHARA, gbrPregnant, gbrBreasts, gbrPenis, gbrClothes, gbrClothSpecial, gbrExpression:1, gbrClothSpecialRet)
ENDIF


IF !FLAG:立ち絵種類
	; Standing
	RESULTS:0 = %gbrImageDefName:0%
	RESULTS:1 = %gbrImageDefName:1%
	; DEBUGPRINTFORML AIDL IMG: standing img returning with %gbrImageDefName:0% - %gbrImageDefName:1%
ELSE
	; Face
	CALL AIDL_BUILD_Face(Version, CHARA, gbrImageDefName:0, gbrImageDefName:1)
ENDIF

RETURN

@AIDL_BUILD_BASE_IMAGE(Version, CHARA, buildPregnant, buildBreasts, buildPenis, buildClothes, buildClothesSpecial, buildExpress, buildSpecial)
#DIMS Version
#DIM G_ID
#DIM CHARA
#DIMS buildPregnant
#DIMS buildBreasts
#DIMS buildPenis
#DIMS buildClothes
#DIMS buildClothesSpecial
#DIMS buildExpress
#DIM buildSpecial
#DIMS bodyDef
#DIMS expDef
#DIMS defName

bodyDef = %AIDL_BodyDef(Version, CHARA, buildPregnant, buildBreasts, buildPenis, buildClothes, buildClothesSpecial)%
expDef = %AIDL_ExpressionDef(Version, CHARA, buildExpress)%
defName = %AIDL_GetDefName(Version, CHARA, buildPregnant, buildBreasts, buildPenis, buildClothes, buildClothesSpecial, buildExpress)%

IF !SPRITECREATED(bodyDef)
	DEBUGPRINTFORML AIDL IMG: building body %bodyDef%
	IF buildClothes == "cNude"
		CALL AIDL_BUILD_BodyNude(Version, CHARA, buildPregnant, buildBreasts, buildPenis, buildClothes, buildClothesSpecial)
	ELSEIF buildClothes == "cClothed"
		CALL AIDL_BUILD_BodyClothed(Version, CHARA, buildPregnant, buildBreasts, buildPenis, buildClothes, buildClothesSpecial)
	ELSEIF STRFIND(buildClothes,"cBra") > -1 || STRFIND(buildClothes,"cPanties") > -1
		CALL AIDL_BUILD_BodyUnderwear(Version, CHARA, buildPregnant, buildBreasts, buildPenis, buildClothes, buildClothesSpecial)
	ENDIF
ENDIF

IF !SPRITECREATED(expDef)
	DEBUGPRINTFORML AIDL IMG: building expression %expDef%
	CALL AIDL_BUILD_Emotion(Version, CHARA, buildExpress)
ENDIF

G_ID = 0
;CALL COMPOSE_IMAGE(G_ID, "ダミー", 0, 0, 300, 300)
CALL COMPOSE_IMAGE(G_ID, "ダミー", 0, 0, 1024,1024)
CALL COMPOSE_IMAGE(G_ID, bodyDef)
CALL COMPOSE_IMAGE(G_ID, expDef)

SPRITECREATE defName, G_ID
RETURN

@AIDL_BUILD_Face(Version, CHARA, defName:0, defName:1)
#DIMS Version
#DIM CHARA
#DIMS defName, 2
#DIMS FaceDef, 2

FaceDef:0 = %AIDL_FaceDef(defName:0)%
SIF !SPRITECREATED(FaceDef:0)
	CALL AIDL_SegmentIMG(Version, CHARA, defName:0)

IF defName:1 == ""
	FaceDef:1 = 
ELSE
	FaceDef:1 = %AIDL_FaceDef(defName:1)%
	SIF !SPRITECREATED(FaceDef:1)
		CALL AIDL_SegmentIMG(Version, CHARA, defName:1)
ENDIF

RESULTS:0 = %FaceDef:0%
RESULTS:1 = %FaceDef:1%
RETURN


@AIDL_SegmentIMG(Version, CHARA, defName)
#DIMS Version
#DIM G_ID
#DIM CHARA
#DIMS defName
#DIMS FaceDef
#DIM faceRect,4

IF SPRITECREATED(@"%Version%AIDL{NO:CHARA}_颜像范围")
	faceRect:0 = SPRITEPOSX(@"%Version%AIDL{NO:CHARA}_颜像范围")
	faceRect:1 = SPRITEPOSY(@"%Version%AIDL{NO:CHARA}_颜像范围")
	faceRect:2 = SPRITEWIDTH(@"%Version%AIDL{NO:CHARA}_颜像范围")
	faceRect:3 = SPRITEHEIGHT(@"%Version%AIDL{NO:CHARA}_颜像范围")
ELSE
	faceRect:0 = -256
	faceRect:1 = 0
	faceRect:2 = 512
	faceRect:3 = 512
ENDIF

FaceDef = %AIDL_FaceDef(defName)%

G_ID = 0
CALL COMPOSE_IMAGE(G_ID, "ダミー", 0, 0, faceRect:2, faceRect:3)
;CALL COMPOSE_IMAGE(G_ID, defName, faceRect:0, faceRect:1, 300, 300)
CALL COMPOSE_IMAGE(G_ID, defName, faceRect:0, faceRect:1, 1024,1024)

SPRITECREATE FaceDef, G_ID

RETURN


;more detailed clothe DEFs
;vests, diapers + soil stages, holding guns, etc
@AIDL_GetClothesState(ARG)
#FUNCTIONS
#DIMS DYNAMIC undiesBuild, 3
LOCAL = NudityCheck(ARG)
SELECTCASE LOCAL
CASE 0
	RETURNF "cNude" 
CASE 1, 2, 3
	IF GROUPMATCH(LOCAL,1,2) || !CFLAG:ARG:衣装一時変更
		IF EQUIP:ARG:6
			undiesBuild:1 '= @"cPanties{EQUIP:ARG:6}"
			IF SoiledDiaper(ARG,2,,33) && SoiledDiaper(ARG,1,,33)
				undiesBuild:1 = %@"%undiesBuild:1%_DUAL"%
			ELSEIF SoiledDiaper(ARG,2,,33)
				undiesBuild:1 = %@"%undiesBuild:1%_MESS"%
			ELSEIF SoiledDiaper(ARG,1,,33)
				undiesBuild:1 = %@"%undiesBuild:1%_WET"%
			ENDIF
		ENDIF
		SIF STRLENS(undiesBuild:1)
			undiesBuild:0 += undiesBuild:1+"、"

		SIF EQUIP:ARG:8
			undiesBuild:2 '= @"cBra{EQUIP:ARG:8}"
		SIF STRLENS(undiesBuild:2)
			undiesBuild:0 += undiesBuild:2+"、"
		RETURNF LIST_IN_STRING(undiesBuild:0, , "","_")
		;RETURNF @"cPanties%EQUIP:ARG:6%"
	ENDIF
ENDSELECT
RETURNF "cClothed"

;translate clothing terms from TW to variables AIDL uses
@AIDL_TranslateClothesState(ARGS)
#FUNCTIONS
SELECTCASE ARGS
CASE "服"
	RETURNF "cClothed"
CASE "裸"
	RETURNF "cNude"
ENDSELECT
RETURNF ARGS


@AIDL_TranslateExpressionState(ARGS)
#FUNCTIONS
SELECTCASE ARGS
CASE "通常"
	RETURNF "Neutral"
CASE "裸"
	RETURNF "cNude"
ENDSELECT
RETURNF ARGS


