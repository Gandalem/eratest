@AIDL_GET_OmorashiPee(ARG)
#FUNCTION
SIF TFLAG:103!=ARG
	RETURNF 0

SIF SoiledSelf:ARG:0
	RETURNF 1

RETURNF 0

@AIDL_GET_OmorashiScat(ARG)
#FUNCTION
SIF TFLAG:103!=ARG
	RETURNF 0

SIF SoiledSelf:ARG:1
	RETURNF 1

RETURNF 0


@AIDL_GET_DrinkCum(ARG)
#FUNCTION
SIF TFLAG:103 != ARG || !NOWEX:MASTER:射精
	RETURNF 0

; 主动指令
SELECTCASE PREVCOM
CASE 120,125,140,81,88
	RETURNF 1
ENDSELECT

;特殊指令
SELECTCASE TFLAG:前回の特殊COM
CASE 11,1,12,8,9
	RETURNF 1
ENDSELECT

RETURNF 0


@AIDL_GET_指令失败判定(ARG)
#FUNCTION

;うふふ指令失败
SIF CFLAG:ARG:うふふ && TFLAG:前回のコマンド結果 == 0
	RETURNF 1

; 移动指令不判定失败
SIF PREVCOM == 400
	RETURNF 0

SIF TFLAG:前回のコマンド結果 < 0
	RETURNF 1

SELECTCASE PREVCOM
CASE 300
	;会話指令失败
	SIF TCVAR:ARG:302 && !TALENT:ARG:恋慕 && TCVAR:ARG:301 < 100
		RETURNF 1
CASE 331
	;薬入茶失败
	SIF TIME_PROGRESS(TCVAR:ARG:300) > 30
		RETURNF 1
ENDSELECT

RETURNF 0