;ARG = Character
;nDate:0 = Age
;nDate:1 = Year when in that age
;nDate:2 = Birth Month
;nDate:3 = Birth Day
;ie: SetBirthDate(ARG, 18, 1998, 1, 1)
;This sets the character to be 18 at 1998.
;SetBirthDate(24, 3, 2023, 1, 17, 0)
;PRINT_DATE_F(DateFromStamp(SetBirthDate(24, 3, 2023, 1, 17, 0)),2)

@SetBirthDate(ARG, nDate:0 = 0, nDate:1 = (__INT_MIN__+1), nDate:2 = 1, nDate:3 = 1, AffectAge = 1)
#FUNCTION
#DIM nDate,5
#DIM AffectAge
#DIM localYear
#DIM localMonth
#DIM localDay
SIF nDate:1 == (__INT_MIN__+1)
	nDate:1 = GET_YEAR()
; SIF nDate:1 < 0
; 	nDate:1 = -nDate:1
;end of year fuckery
; SIF nDate:2 == 4 && nDate:3 == 31
; 	nDate:1 --
;Dates
localYear = (YearLength*(nDate:1))-(YearLength*nDate)
localMonth = (((YearLength)/4)*(nDate:2-1))
localDay = (nDate:3)
;Year
CharaAge:ARG:2 = localYear
;DEBUGPRINTFORML Y: {localYear} M: {localMonth} DD: {localDay}
;Month
CharaAge:ARG:2 += localMonth
;Day
CharaAge:ARG:2 += localDay
;===================================
charaAge:ARG:1 = ((TimeStamp())-CharaAge:ARG:2)/YearLength
SIF AffectAge
	charaAge:ARG:0 = charaAge:ARG:1
CharaAge:ARG:4 = ((TimeStamp())-CharaAge:ARG:2)%YearLength
RETURNF CharaAge:ARG:2

@RELATION_IS_INCEST(ARG,ARG:1)
#FUNCTION
;no family relation
SIF !CharaFamily:ARG:(ARG:1) || !CharaFamily:(ARG:1):ARG
	RETURNF 0
;first-hand
SIF GROUPMATCH(CharaFamily:ARG:(ARG:1), 1, 2, 4) || GROUPMATCH(CharaFamily:(ARG:1):ARG, 1, 2, 4)
	RETURNF 1
;second-hand
SIF GROUPMATCH(CharaFamily:ARG:(ARG:1), 3, 5, 7, 8, 10) || GROUPMATCH(CharaFamily:(ARG:1):ARG, 3, 5, 7, 8, 10)
	RETURNF 2
;third-hand and lower we don't count
; refactored child multiple functions

@CHILD_MULTIPLE_LAST_NAS(Character,Child)
#FUNCTION
#DIM DYNAMIC Character
#DIM DYNAMIC Child
#DIM DYNAMIC LastChild
#DIM DYNAMIC ChildList, 2000
#DIM DYNAMIC ChildCount
LastChild = -1
ChildCount = 0
DEBUGPRINTFORML 컴파레 캐릭터: {Child} - 컴파레 연령 {CharaAge:(Child):2}
FOR LOCAL,0,CHARANUM
SIF RealChildren:LOCAL:1 != Character
	CONTINUE
DEBUGPRINTFORML 자식: {LOCAL} - 연령 {CharaAge:(LOCAL):2}
IF CharaAge:Child:2 == CharaAge:LOCAL:2 && RealChildren:Child:1 == RealChildren:LOCAL:1 && RealChildren:Child:2 == RealChildren:LOCAL:2
	LastChild = LOCAL
	ChildCount++
	SIF ChildCount == CFLAG:Character:子供人数
		RETURNF LastChild
ELSEIF LastChild > -1
	RETURNF LastChild
ENDIF
NEXT
RETURNF -1
