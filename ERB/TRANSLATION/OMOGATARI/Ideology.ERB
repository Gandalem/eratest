					CASE 1
						RETURNF "임신은 고귀한 일로 여긴다."
				ENDSELECT
			CASE 2
				SELECTCASE ARG:1
					CASE 0
						RETURNF "성스러움"
					CASE 1
						RETURNF "임신은 존중받아 마땅한 의무다. 여성은 우리 사회를 다음 세대로 이어 간다."
				ENDSELECT
			CASE 3
				SELECTCASE ARG:1
					CASE 0
						RETURNF "의무"
					CASE 1
						RETURNF "여성은 임신해야 하며 그렇지 않은 자는 자격이 없다고 여긴다."
				ENDSELECT
		ENDSELECT
	CASE "Prays per Day"
		SELECTCASE ARG
			CASE 0
				SELECTCASE ARG:1
					CASE 0
						RETURNF @"%NUM_COUNT(ARG,,1)%"
					CASE 1
						RETURNF "기도는 의무가 아니다."
				ENDSELECT
			CASE 1 TO 5
				SELECTCASE ARG:1
					CASE 0
						RETURNF @"%NUM_COUNT(ARG,,1)%"
					CASE 1
						RETURNF @"모든 신자는 하루에 {ARG}번 기도해야 하며, 그렇지 않으면 죄를 지게 된다."
					CASE 3
						RETURNF "30"
				ENDSELECT
		ENDSELECT
ENDSELECT
RETURNF

