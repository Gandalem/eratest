@CheckSinsForSex(nTarget, nTarget:1, notCon = 0)
#DIM nTarget, 2
#DIM nSinRange, 2
#DIM notCon
;Physical Love
SIF ReligionBlocksSex(nTarget, nTarget:1)
	CALL CharacterSinned(nTarget,"Physical Love",@"%CALLNAME:(nTarget:1)%을(를) 섹스하도록 밀어붙였다.")
SIF ReligionBlocksSex(nTarget:1, nTarget)
	CALL CharacterSinned(nTarget:1,"Physical Love",@"%CALLNAME:nTarget%에게 밀려 내려갔다")
;Age
SIF CharaAge:(nTarget:1):0 < GET_RELIGION_PRECEPT(TALENT:nTarget:Religion, "Minimum Age for Sex")
	CALL CharacterSinned(nTarget,"Minimum Age for Sex",@"%CALLNAME:(nTarget:1)%과(와) 성관계를 가졌다 ({CharaAge:(nTarget:1):0}%ShortGender(nTarget:1)%)")
SIF CharaAge:nTarget:0 < GET_RELIGION_PRECEPT(TALENT:(nTarget:1):Religion, "Minimum Age for Sex")
	CALL CharacterSinned(nTarget:1,"Minimum Age for Sex",@"%CALLNAME:nTarget%와 성관계를 가졌다 ({CharaAge:nTarget:0}%ShortGender(nTarget)%)")
;Incest
SELECTCASE RELATION_IS_INCEST(nTarget,nTarget:1)
	CASE 0
		nSinRange:0 = 1
		nSinRange:1 = 1
	CASE 1
		nSinRange:0 = -3
		nSinRange:1 = -1
	CASE 2
		nSinRange:0 = -3
		nSinRange:1 = -2
ENDSELECT
IF RELATION_IS_INCEST(nTarget,nTarget:1) || RELATION_IS_INCEST(nTarget:1,nTarget:0)
	CALL CharacterSinned(nTarget:0,"Incest",@"%CALLNAME:(nTarget:1)%와 (%(GET_TALENTNAME_TR(1215, CharaFamily:(nTarget:0):(nTarget:1), nTarget:1))%)와 성관계를 가졌다.", nSinRange:0, nSinRange:1)
	CALL CharacterSinned(nTarget:1,"Incest",@"%CALLNAME:(nTarget:0)%와 성관계를 가졌다 (%GET_TALENTNAME_TR(1215, CharaFamily:(nTarget:1):(nTarget:0), nTarget:0)%)", nSinRange:0, nSinRange:1)
ENDIF
IF notCon
	CALL CharacterSinned(nTarget,"Rape",@"%CALLNAME:(nTarget:1)%을(를) 섹스하라고 밀어붙였다.", -3, -1)
ENDIF

