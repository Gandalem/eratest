@changeCertainty(ARG,nNum,nReligion = -1)
#DIM nNum
#DIM nReligion
SIF !GETBIT(nReligions,0) || !GETBIT(nReligions,1)
	RETURN 0
SIF nReligion == -1
	nReligion = TALENT:ARG:Religion
charReligionCertainty:ARG:nReligion = LIMIT(charReligionCertainty:ARG:nReligion + nNum, 0, 1000)
CALL COLORMESSAGE(@"%CALLNAME:ARG%의 「%TOSTR_Religion(nReligion)%」에 대한 확신이 \@ nNum >= 0 ? 증가했다. # 감소했다. \@에서 {charReligionCertainty:ARG:nReligion/10}까지 \%로 변했다.", C_YELLOW, 2, 1)
CALL crisisOfBelief(ARG)

@crisisOfBelief(ARG)
#DIM DYNAMIC targetReligion
#DIM DYNAMIC bestCertainty
VARSET bestCertainty
VARSET targetReligion
SIF currentCertainty(ARG) > 0 && currentFaith(ARG) > 0
	RETURN 0
FOR LOCAL,0,20
SIF !charReligionCertainty:ARG:LOCAL
	CONTINUE
IF charReligionCertainty:ARG:LOCAL >= bestCertainty
	targetReligion = LOCAL
	bestCertainty = MAX(charReligionCertainty:ARG:LOCAL,bestCertainty)
ENDIF
NEXT
;cannot change religion if certainty is at 0% and they aren't certain on any
SIF TALENT:ARG:Religion == targetReligion && !targetReligion
	RETURN 0
TALENT:ARG:Religion = targetReligion
charReligionCertainty:ARG:targetReligion = MAX(charReligionCertainty:ARG:targetReligion,500)
charReligionFaith:ARG:targetReligion = LIMIT(charReligionFaith:ARG:targetReligion, 50, 1000)
IF currentFaith(ARG) <= 0
	CALL COLORMESSAGE(@"%HIS_HER(ARG)%의 종교에 대한 모든 신뢰를 잃고, %CALLNAME:ARG%는 무엇을 믿어야 할지 혼란스러워한다.", C_D_ORANGE, 1, 1)
ELSE
	CALL COLORMESSAGE(@"%HIS_HER(ARG)%의 종교에 질려버린 %CALLNAME:ARG%는 무엇을 믿어야 할지 갈등하게 된다.", C_D_ORANGE, 1, 1)
ENDIF
IF targetReligion
	CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) 잠시 생각한 후 【%TOSTR_Religion(TALENT:ARG:Religion)%】을 믿기로 결심한다.", C_YELLOW, 2, 1)
ELSE
	CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) 모든 정신적 믿음을 포기하고 【%TOSTR_Religion(TALENT:ARG:Religion, 1)%】로 갔다.", C_YELLOW, 2, 1)
ENDIF
SIF targetReligion == TALENT:MASTER:Religion
	CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("convertReligion")

@ChangeFaith(ARG,nNum,nReligion = -1, nAlwaysShow = 0)
#DIM nNum
#DIM nReligion
#DIM nAlwaysShow
SIF !GETBIT(nReligions,0) || !GETBIT(nReligions,1)
	RETURN 0
SIF nReligion == -1
	nReligion = TALENT:ARG:Religion
charReligionFaith:ARG:nReligion = LIMIT(charReligionFaith:ARG:nReligion + nNum, 0, 1000)
SIF CAN_SEE(ARG) || nAlwaysShow
	CALL COLORMESSAGE(@"%CALLNAME:ARG%의 믿음이%TOSTR_Religion(nReligion)%)에 가지고 있다 \@ nNum >= 0 ? 증가했다. # 감소했다. \@ ~에 {charReligionFaith:ARG:nReligion/10}\%", C_YELLOW, 2, 1)
CALL crisisOfBelief(ARG)
;Low faith will use lesser precepts.

@ApplicablePrecept(ARG, ARGS)
#FUNCTION
#DIM nReligion
SIF !GETBIT(nReligions,0)
	RETURNF 0
;Except you.
SIF ARG == MASTER
	RETURNF GET_RELIGION_PRECEPT(TALENT:ARG:Religion, ARGS)
nReligion = TALENT:ARG:Religion
FOR LOCAL, GET_RELIGION_PRECEPT(TALENT:ARG:Religion, ARGS), 0 , GET_RELIGION_PRECEPT(TALENT:ARG:Religion, ARGS) > 0 ? -1 # 1
SIF charReligionFaith:ARG:nReligion >= TOINT((TOSTR_PRECEPT_RANKING(ARGS, GET_RELIGION_PRECEPT(nReligion, ARGS), 4)))
	RETURNF LOCAL
NEXT
RETURNF 0
;--------------------------------------------
;CharacterSinned
;Reports when a character has an incident which goes against the Touhou's beliefs.
;IE:
; Anon peed in her diaper, which is a sin in 【Player's Religion】(Incontinence: Abhorrent).
; Anon's faith in 【Player's Religion】 has decreased to 96%
;--------------------------------------------

@CharacterSinned(ARG,ARGS,nReason, nRange:0 = 0, nRange:1 = 0, nAlwaysShow = -1)
#DIM nNum
#DIM nReligion
#DIMS nReason
#DIM nRange,2
#DIM nChange
#DIM nAlwaysShow
SIF IsDead:ARG:0
	RETURN
nReligion = TALENT:ARG:Religion
nChange = TOINT(TOSTR_PRECEPT_RANKING(ARGS, GET_RELIGION_PRECEPT(nReligion, ARGS), 3))
SIF !nChange || !GETBIT(nReligions,0) || !GETBIT(nReligions,1)
	RETURN
SIF INRANGE(GET_RELIGION_PRECEPT(nReligion, ARGS), nRange:0, nRange:1) || (!nRange:0 && !nRange:1)
	nChange = -nChange
IF CAN_SEE(ARG) || nAlwaysShow
	IF nChange > 0
		CALL COLORMESSAGE(@"%CALLNAME:ARG%은(는) %nReason%를 가지고 있으며, 그것은 【%TOSTR_Religion(nReligion)%】에서 정조이다 (%ARGS%: %TOSTR_PRECEPT_RANKING(ARGS, GET_RELIGION_PRECEPT(nReligion, ARGS),0)%)", C_GREEN, 2, 1)
	ELSE
		CALL COLORMESSAGE(@"%CALLNAME:ARG%은 %nReason%를 가지고 있으며, 그것은 【%TOSTR_Religion(nReligion)%】에서 죄이다 (%ARGS%: %TOSTR_PRECEPT_RANKING(ARGS, GET_RELIGION_PRECEPT(nReligion, ARGS),0)%)", C_RED, 2, 1)
	ENDIF
ENDIF
CALL ChangeFaith(ARG,nChange*GET_CertaintyLoss(ARG)/100, , nAlwaysShow)

