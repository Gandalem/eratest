@ReligionPrecepts(ARG,makeButtons = 0, showAll = 0)
#DIM makeButtons
#DIM L_COUNT
#DIM DYNAMIC nRank
#DIMS html
#DIM CONST nLength = 40
#DIM DYNAMIC showAll
#DIMS nPreceptSTR
#DIM nPreceptINT
#DIM nLoop
SELECTCASE ARG
	CASE 0, 1
		PRINTFORML 이 종교는 어떠한 계율도 가지고 있지 않다.
	CASEELSE
		VARSET html
		VARSET L_COUNT
		FOR nRank, 30, -60, -10
		FOR nLoop,0, VARSIZE("nPreceptList")
		nPreceptSTR '= TOSTR_PRECEPT_RANKING(nPreceptList:nLoop, GET_INT(0, "Religion", ARG, nPreceptList:nLoop),0)
		nPreceptINT = TOINT(TOSTR_PRECEPT_RANKING(nPreceptList:nLoop, GET_INT(0, "Religion", ARG, nPreceptList:nLoop),2))
		SIF !STRLENS(nPreceptList:nLoop)
			CONTINUE
		SIF !STRLENS(nPreceptSTR) && !showAll
			CONTINUE
		SIF (nPreceptINT != nRank && STRLENS(nPreceptSTR))
			CONTINUE
		SIF !STRLENS(nPreceptSTR) && nRank != -50
			CONTINUE
		html += PreceptName(ARG, nLoop, makeButtons)
		L_COUNT ++
		SIF L_COUNT && L_COUNT % (MAXWIDTH()/nLength) == 0
			html += "<br>"
		NEXT
		NEXT
		HTML_PRINT html
ENDSELECT
;PreceptName(4,4)

@PreceptName(R_ID, P_ID, makeButtons = 0)
#FUNCTIONS
#DIM DYNAMIC R_ID
#DIM DYNAMIC P_ID
#DIM DYNAMIC P_SCORE
#DIM makeButtons
P_SCORE = TOINT(TOSTR_PRECEPT_RANKING(nPreceptList:P_ID, GET_INT(0, "Religion", R_ID, nPreceptList:P_ID),2))
LOCALS =
LOCALS:1 = %HTML_ESCAPE(TOSTR_PRECEPT_RANKING(nPreceptList:P_ID, GET_INT(0, "Religion", R_ID, nPreceptList:P_ID),1))%
IF makeButtons
	LOCALS += @"<button value='{P_ID}' title='%LOCALS:1%'>"
ELSE
	LOCALS += @"<nonbutton title='%LOCALS:1%'>"
ENDIF
LOCALS:2 '= @"%HTML_ESCAPE(nPreceptList:P_ID)%: "
IF STRLENS(TOSTR_PRECEPT_RANKING(nPreceptList:P_ID, GET_INT(0, "Religion", R_ID, nPreceptList:P_ID),0))
	LOCALS:2 += @"%HTML_ESCAPE(TOSTR_PRECEPT_RANKING(nPreceptList:P_ID, GET_INT(0, "Religion", R_ID, nPreceptList:P_ID),0))%"
ELSE
	LOCALS:2 += "No Opinion"
	P_SCORE = -50
ENDIF
LOCALS += @"%LOCALS:2%%HTML_SPACE(MAX(40-HTML_STRINGLEN(LOCALS:2),0))%"
IF makeButtons
	LOCALS += @"</button>"
ELSE
	LOCALS += @"</nonbutton>"
ENDIF
SIF P_SCORE
	LOCALS '= @"<font color='#%COLOR_FROM_VALUE(P_SCORE)%'>%LOCALS%</font>"
RETURNF LOCALS

