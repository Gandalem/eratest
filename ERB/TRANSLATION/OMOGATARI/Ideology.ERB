@EXIST_Religion6
#LOCALSIZE 1
#LOCALSSIZE 1
;your religion (technically shinki's)
;the one where you steal undies

@Religion6(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		IF nOmutsu
			CALLF MAKE_STR(V_NAME, "무츠이즘")
		ELSE
			CALLF MAKE_STR(V_NAME, "팬츠이즘")
		ENDIF
	CASE "Unit"
		IF nOmutsu
			CALLF MAKE_STR(V_NAME, "무츠이스트")
		ELSE
			CALLF MAKE_STR(V_NAME, "팬츠이스트")
		ENDIF
	CASE "Deity"
		IF nOmutsu
			CALLF MAKE_STR(V_NAME, "오무츠 님")
		ELSE
			CALLF MAKE_STR(V_NAME, "오판츠 님")
		ENDIF
	CASE "Desc"
		IF nOmutsu
			CALLF MAKE_STR(V_NAME, "무츠교는 기저귀 페티시즘에 헌신하는 종교이다. 일반적으로 기저귀 연인의 판스주의 버전으로 여겨진다.\n 그 이름은 기저귀를 뜻하는 일본어 「おむつ (omutsu)」에서 유래했으며, 그들의 신은 오무츠사마라고 불린다.\n 무츠교는 숭배 방식 면에서는 대체로 판스주의와 유사하지만, 일반적으로 더 더러워지고 흡수성이 있는 의류를 선호한다.\n 무츠교가 모 종교와 약간 다르긴 하지만, 오무츠사마는 사용하지 않은 기저귀에 대한 공물을 전혀 가치를 두지 않는다.\n 무츠교도들은 대체로 판스주의자들이 타인에게 속옷을 빼앗는 것과 같은 방식을 사용하며, 신토 사원이나 기독교 교회에서도 숭배한다." )
		ELSE
			CALLF MAKE_STR(V_NAME, "팬티즘은 팬티와 일반 속옷 페티시즘에 헌신하는 종교이다.\n 일본어의 「pants/panties」 해석에서 유래했으며, 팬티즘은 일반적으로 오판츠사마(Opantsu-sama)라고 알려진 전지전능한 신을 숭배한다.\n 신봉자들은 보통 축복을 위해 팬티를 공물로 사용하며, 의식을 치르기 위해 주로 신도나 기독교 예배 장소를 이용한다.\n 오판츠사마는 한 번 입히지 않은 속옷에는 가치를 주지 않는다. 따라서 팬티스트들은 큰 은혜를 받기 위해 다른 사람의 속옷을 훔치는 데 자유롭게 행동한다.\n 대부분의 팬티스트들은 흡수체에 대해 혐오하거나 매력을 느끼지 않지만, 끌리는 소수의 경우는 종교가 무츠이즘으로 변모하게 된다." )
		ENDIF
	CASE "Panty Stealing"
		CALLF MAKE_INT(V_NAME, 3)
	CASE "Incontinence"
		IF GETBIT(nUnfair,2) && ARG != 102
			CALLF MAKE_INT(V_NAME, 3)
		ELSE
			CALLF MAKE_INT(V_NAME, 2)
		ENDIF
	CASE "Body Modification"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Religion」")
ENDSELECT

