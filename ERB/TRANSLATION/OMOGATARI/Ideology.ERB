#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		IF !STRLENS(YourReligionSTR)
			;placeholder
			CALLF MAKE_STR(V_NAME, "플레이어의 종교")
			RETURNF
		ENDIF
		CALLF MAKE_STR(V_NAME, YourReligionSTR)
	CASE "Unit"
		CALLF MAKE_STR(V_NAME, YourReligionSTR:1)
	CASE "Deity"
		CALLF MAKE_STR(V_NAME, YourReligionSTR:2)
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"%NAME:YourReligionDeity%가 만든 커스텀 종교.")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Religion」")
