@GET_CertaintyLoss(ARG)
#FUNCTION
#DIM DYNAMIC nVal
VARSET nVal, 100
;Sanity
SELECTCASE OrgasmDeny:ARG:0
	CASE IS >= 4
		TIMES nVal, 0.25
	CASE 3
		TIMES nVal, 0.5
	CASE 2
		TIMES nVal, 0.75
	CASE 1
		TIMES nVal, 0.90
	CASE -1
		TIMES nVal, 1.10
	CASE -2
		TIMES nVal, 1.5
	CASE -3
		TIMES nVal, 2
	CASE -4
		TIMES nVal, 3
	CASE -5
		TIMES nVal, 10
ENDSELECT
;Cheeky
SELECTCASE TALENT:ARG:12
	CASE -1
		TIMES nVal, 2
	CASE 1
		TIMES nVal, 0.5
ENDSELECT
;Empathy
SELECTCASE TALENT:ARG:12
	CASE -1
		TIMES nVal, 1.5
	CASE 1
		TIMES nVal, 0.8
	CASE 2
		TIMES nVal, 0.5
ENDSELECT
;Wimp
SIF TALENT:ARG:40 == 1
	TIMES nVal, 2
;Slow learner
SIF TALENT:ARG:50 == -1
	TIMES nVal, 0.5
;Deity Status
SELECTCASE charReligionStatus:ARG:(TALENT:ARG:Religion)
	CASE 1
		TIMES nVal, 0.3
	CASE 2
		TIMES nVal, 0.5
ENDSELECT
;Apostasy
SELECTCASE GET_INT(ARG, "Religion", TALENT:ARG:Religion, "Apostasy")
	CASE -1
		TIMES nVal, 0.8
	CASE -2
		TIMES nVal, 0.6
	CASE -3
		TIMES nVal, 0.4
ENDSELECT
RETURNF nVal

@ConversionPower(ARG)
#FUNCTION
#DIM nConversion
#DIM DYNAMIC nValue,10
#DIM DYNAMIC nInfluence, 10
nConversion = 3000
nConversion += (2334*ABL:ARG:41)
nValue:1 = LIMIT(CapacityStats:ARG:5+5,0,100) ; talking: 90% weight, allowed defect of 0.05 and a max at 100%, meaning improvement over 95% does not affect conversion power.
nValue:2 = LIMIT(CapacityStats:ARG:5+20,0,100); Hearing: 90% weight, allowed defect of 0.20 and a max at 100%, meaning improvement over 80% does not affect conversion power.
nInfluence = (100 + (nValue:1-100) * 90/100)
nInfluence:1 = (100 + (nValue:2-100) * 90/100)
nConversion = nConversion * nInfluence/100 * nInfluence:1/100
nConversion /= 100
;min 40%
nConversion = MAX(nConversion,40)
RETURNF nConversion
;ARG = Value
;ARG:1 = Convertee
;ARG:2 = Converter

@WeightedConvert(ARG, ARG:1, ARG:2)
#FUNCTION
IF TALENT:(ARG:1):Religion == TALENT:(ARG:2):Religion
	;reassurance
	RETURNF ARG*ConversionPower(ARG:2)/100
ELSE
	RETURNF ARG*ConversionPower(ARG:2)/100*GET_CertaintyLoss(ARG:1)/100
ENDIF
