;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_一般依頼37
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです
@一般依頼37(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
CASE "依頼名"
	CALLF MAKE_STR(V_NAME, "Hitman (Faction)")
CASE "依頼内容表示"
	CALLF MAKE_STR(V_NAME, @"Kill the target")
CASE "依頼報酬表示"
	CALLF MAKE_STR(V_NAME, @"Money")
CASE "依頼実行コマンド名"
	CALLF MAKE_STR(V_NAME, "Challenge")
CASE "依頼内容"
	CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(FREE_MOB_SLOT(), "faction hitman"))	
CASE "依頼サブ"
	CALLF MAKE_INT(V_NAME, RAND_HUNTING_FACTION_MOB(TALENT:ARG:Recruiter-1))	
CASE "依頼期限"
;発生時ではなく受託時に確定します
	CALLF MAKE_INT(V_NAME, 30)
CASE "依頼発生率"
;これは他の一般依頼との相対確率なんで10％ではありません
;percentage change of being shown. (set to 100 to always show)
	;CALLF MAKE_INT(V_NAME, 100)
	CALLF MAKE_INT(V_NAME, 5)
CASE "依頼発生条件"
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼受託可能条件"
;あなたの戦闘能力が1以上
	IF TALENT:ARG:Recruiter == 0
		;not a recruiter
		CALLF MAKE_INT(V_NAME, 0)
		RETURNF 0
	ENDIF
	SIF ABL:MASTER:戦闘能力 >= 1 && nNecro && FactionRank:MASTER:(TALENT:ARG:Recruiter-1)
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼実行可能条件"
	CALLF MAKE_INT(V_NAME, 1)
;成功/失敗処理はCARRYOUTで直接書く
;SOURCEやITEM入手、消費が煩雑になるので
CASE "依頼消滅条件"
	SIF Add_Request_Should_Discard(ARG)
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼人連れ出し可能"
CASE "Faction Only"
	CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@IRAI_一般37(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  CHK_SLOT
#DIM  OPPONENT_REMAIN
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
CHK_SLOT  = SEARCH_IRAI_SLOT(IRAI_ID)
SELECTCASE SCENE
CASE "依頼成功時"
;成功報告時の報酬など
	SELECTCASE LEVEL_TO_RANK(BestCombatAbility(IRAI_SLOT_TO_PERSON(CHK_SLOT)))
	CASE IS <= 1
		SOURCE:歓楽 = 1000
		CALL CHANGE_CFLAG(2, CLIENT_ID, 10 + RAND:5)
		CALL CHANGE_CFLAG(4, CLIENT_ID, 15 + RAND:5)
		CALL GET_SPELL_CARD_BONUS_YEN(30000, 2)
	    CALL CHANGE_FACTION_EXP(MASTER,TALENT:CLIENT_ID:Recruiter-1,5)
	CASE 2
		SOURCE:歓楽 = 1500
		CALL CHANGE_CFLAG(2, CLIENT_ID, 15 + RAND:5)
