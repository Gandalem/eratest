		CALL GET_SPELL_CARD_BONUS_YEN(75000, 2)
	    CALL CHANGE_FACTION_EXP(MASTER,TALENT:CLIENT_ID:Recruiter-1,10)
	CASE 3
		SOURCE:歓楽 = 2000
		CALL CHANGE_CFLAG(2, CLIENT_ID, 20 + RAND:10)
		CALL CHANGE_CFLAG(4, CLIENT_ID, 25 + RAND:10)
		CALL GET_SPELL_CARD_BONUS_YEN(150000, 2)
	    CALL CHANGE_FACTION_EXP(MASTER,TALENT:CLIENT_ID:Recruiter-1,15)
	CASE 4
		SOURCE:歓楽 = 2500
		CALL CHANGE_CFLAG(2, CLIENT_ID, 25 + RAND:10)
		CALL CHANGE_CFLAG(4, CLIENT_ID, 30 + RAND:10)
		CALL GET_SPELL_CARD_BONUS_YEN(250000, 2)
	    CALL CHANGE_FACTION_EXP(MASTER,TALENT:CLIENT_ID:Recruiter-1,25)
	CASE 5
		SOURCE:歓楽 = 3000
		CALL CHANGE_CFLAG(2, CLIENT_ID, 30 + RAND:20)
		CALL CHANGE_CFLAG(4, CLIENT_ID, 35 + RAND:20)
		CALL GET_SPELL_CARD_BONUS_YEN(500000, 2)
	    CALL CHANGE_FACTION_EXP(MASTER,TALENT:CLIENT_ID:Recruiter-1,35)
	CASEELSE
		SOURCE:歓楽 = 4000
		CALL CHANGE_CFLAG(2, CLIENT_ID, 40 + RAND:20)
		CALL CHANGE_CFLAG(4, CLIENT_ID, 40 + RAND:20)
		CALL GET_SPELL_CARD_BONUS_YEN(750000, 2)
	    CALL CHANGE_FACTION_EXP(MASTER,TALENT:CLIENT_ID:Recruiter-1,50)
	ENDSELECT
CASEELSE
    CALL IRAI_一般30(CHARA, IRAI_ID, SCENE)
ENDSELECT

;creates a mob that you need to kill
@RAND_HUNTING_FACTION(ARG)
#FUNCTION
#DIM RHF_FACTIONS, MaxFactions
#DIM RHF_PICK_FACTION

SIF ARG < 0
    RETURNF 0

VARSET RHF_FACTIONS
FOR LOCAL, 0, MaxFactions
	SIF !FactionExist(LOCAL) ;disabled
		CONTINUE
	SIF ARG == LOCAL ;themselves
		CONTINUE

	RHF_FACTIONS:LOCAL = 10 ;default value
    ;warring
    SIF GETBIT(FactionWarring:ARG:LOCAL,0)
	    RHF_FACTIONS:LOCAL += 200 ;at war
	IF FactionTeamRelation(ARG,LOCAL) != 0 ;special checks for established relationship
		IF FactionTeamRelation(ARG,LOCAL) >= 50000 || GETBIT(FactionWarring:ARG:LOCAL,1) || GETBIT(FactionWarring:ARG:LOCAL,2) ;very positive relationship, don't fight
			RHF_FACTIONS:LOCAL = 0
		ELSEIF FactionTeamRelation(ARG,LOCAL) > 0 ;positive, less conflict
			RHF_FACTIONS:LOCAL -= ((FactionTeamRelation(ARG,LOCAL)) * 2 / 10000)
		ELSE ;negative relationship, increase chances massively
			RHF_FACTIONS:LOCAL -= ((FactionTeamRelation(ARG,LOCAL)) * 500 / 10)
		ENDIF
	ENDIF
	SIF RHF_FACTIONS:LOCAL < 0
		RHF_FACTIONS:LOCAL = 0
NEXT
IF SUMARRAY(RHF_FACTIONS, 0, MaxFactions - 1) == 0
	DEBUGPRINTFORML No factions available to fight against %FactionName(ARG)%.
    RETURNF ARG ;no valid results, somehow. try to fight the request giver instead
ENDIF

DEBUGPRINTFORML Valid targets for %FactionName(ARG)%:
FOR LOCAL, 0, MaxFactions
	SIF RHF_FACTIONS:LOCAL
		DEBUGPRINTFORML %TOSTR(LOCAL), 3, RIGHT% %FactionName(LOCAL), 15, LEFT%: {RHF_FACTIONS:LOCAL}
NEXT

RETURNF ARRAY_HIT(RHF_FACTIONS, MaxFactions)

;creates a mob that you need to kill
@RAND_HUNTING_FACTION_CHARA(ARG)
#FUNCTION
#DIM RHF_FACTIONS, MaxFactions
#DIM RHF_PICK_FACTION

SIF ARG < 0
    RETURNF 0

VARSET RHF_FACTIONS
FOR LOCAL, 0, MaxFactions
	SIF !FactionExist(LOCAL) ;disabled
		CONTINUE

	RHF_FACTIONS:LOCAL = 10 ;default value
	IF FactionRelationCompElse(ARG,LOCAL) != 0 ;special checks for established relationship
		IF FactionRelationCompElse(ARG,LOCAL) >= 50000 ;very positive relationship, don't fight
			RHF_FACTIONS:LOCAL = 0
		ELSEIF FactionRelationCompElse(ARG,LOCAL) > 0 ;positive, less conflict
			RHF_FACTIONS:LOCAL -= ((FactionRelationCompElse(ARG,LOCAL)) * 2 / 10000)
		ELSE ;negative relationship, increase chances massively
			RHF_FACTIONS:LOCAL -= ((FactionRelationCompElse(ARG,LOCAL)) * 500 / 10)
		ENDIF
	ENDIF
	SIF RHF_FACTIONS:LOCAL < 0
		RHF_FACTIONS:LOCAL = 0
NEXT
IF SUMARRAY(RHF_FACTIONS, 0, MaxFactions - 1) == 0
	DEBUGPRINTFORML No factions available to fight against %CALLNAME:(ARG)%.
    RETURNF 11 ;no valid results, somehow. return T-NC
ENDIF

DEBUGPRINTFORML Valid targets for %CALLNAME:(ARG)%:
FOR LOCAL, 0, MaxFactions
	SIF RHF_FACTIONS:LOCAL
		DEBUGPRINTFORML %TOSTR(LOCAL), 3, RIGHT% %FactionName(LOCAL), 15, LEFT%: {RHF_FACTIONS:LOCAL}
NEXT

RETURNF ARRAY_HIT(RHF_FACTIONS, MaxFactions)

;for grabbing faction units
@RAND_HUNTING_FACTION_MOB(ARG)
#FUNCTION
#DIM RHFM_UNITS, 100
#DIM RHFM_FYS, 100
#DIM RHFM_PICK_FACTION
#DIM RHFM_TOTAL_UNITS

RHFM_PICK_FACTION = RAND_HUNTING_FACTION(ARG)
RHFM_TOTAL_UNITS = DT_SELECT("FactionUnits", @"faction = {RHFM_PICK_FACTION}", "", RHFM_UNITS)
CALLF FUNC_FISHER_YATES_SHAFFLE(RHFM_FYS, RHFM_TOTAL_UNITS)
FOR LOCAL,0,VARSIZE("RHFM_UNITS")
	SIF RHFM_FYS:LOCAL < 0
		CONTINUE
    SIF RHFM_UNITS:(RHFM_FYS:LOCAL) > 0
        RETURNF RHFM_UNITS:(RHFM_FYS:LOCAL)
NEXT
