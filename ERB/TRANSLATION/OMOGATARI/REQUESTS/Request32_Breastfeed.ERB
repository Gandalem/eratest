;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_一般依頼32
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです
@一般依頼32(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
CASE "依頼名"
		CALLF MAKE_STR(V_NAME, @"I want milkey")
CASE "依頼内容表示"
	CALLF MAKE_STR(V_NAME, @"Feed %CALLNAME:ARG% with your milk or with a bottle")
CASE "依頼報酬表示"
	CALLF MAKE_STR(V_NAME, @"Favor + Regression Gems")
CASE "依頼実行コマンド名"
	CALLF MAKE_STR(V_NAME, "Feed")
CASE "依頼内容"
    CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(ARG, "person"))
CASE "依頼サブ"
CASE "依頼期限"
;発生時ではなく受託時に確定します
	CALLF MAKE_INT(V_NAME, 0)
CASE "依頼発生率"
;これは他の一般依頼との相対確率なんで10％ではありません
;percentage change of being shown. (set to 100 to always show)
	;CALLF MAKE_INT(V_NAME, 100)
	CALLF MAKE_INT(V_NAME, 50)
CASE "依頼発生条件"
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼受託可能条件"
;あなたの戦闘能力が1以上
	SIF MARK:ARG:RegressionMark >= 3 || IS_BABY(ARG)
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼実行可能条件"
	CALLF MAKE_INT(V_NAME, 1)
;成功/失敗処理はCARRYOUTで直接書く
;SOURCEやITEM入手、消費が煩雑になるので
CASE "依頼消滅条件"
	SIF Add_Request_Should_Discard(ARG)
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼人連れ出し可能"
ENDSELECT

@IRAI_一般32(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  CHK_SLOT
#DIM  OPPONENT_REMAIN
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
CHK_SLOT  = SEARCH_IRAI_SLOT(IRAI_ID)
SELECTCASE SCENE
CASE "依頼条件表示"
;何か専用の表示情報を設けたい時用
;受託済みの依頼表示で使用されます
;
;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
;ここ以外の表示項目は
;PRINTFORML 　　　　　：
;となっているのでスペースを揃えたほうが見栄えが良いです

CASE "依頼実行時"
;このCASEに限り、RESULTが意味を持ちます
;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
;
;
	;実行できないパターン
	;拠点では屋内だとダメ（原作だとめっちゃやってるけど）
	;ほぼ弾幕勝負のコピペ
	CALL ASK_M("Breastfeed",TALENT:MASTER:母乳体質,"Bottle",ITEM:GensouBottle,"Cancel",1)

	SELECTCASE RESULT
	CASE 0
		PRINTFORML You open up your %SHOW_TOP(MASTER)% and gently lean your %OPPAI_DESCRIPTION_TR(MASTER)% to %CALLNAME:TARGET%.
		PRINTFORML %CALLNAME:TARGET% accepts your offering with open arms, sucking on your nipples dry.
		CALL RECOVER(TARGET,ABL:MASTER:Ｂ感覚 * 10,"体力")
		CALL RECOVER(TARGET,ABL:MASTER:Ｂ感覚 * 20,"気力")
		CALL RECOVER(TARGET,ABL:MASTER:Ｂ感覚 * 10,"精力")
	CASE 1
		PRINTFORML You give a sippy bottle to %CALLNAME:TARGET%
		CALL ADD_UseItem(533,TARGET)
	CASE 2
	RETURN
	ENDSELECT
	RETURN IRAI_CONST_RESULT("実行して成功")
CASE "依頼成功時"
;成功報告時の報酬など
	SOURCE:歓楽 = 3000
	CALL CHANGE_CFLAG(2, TARGET, 10 + RAND:5)
	CALL CHANGE_CFLAG(4, TARGET, 15 + RAND:5)
	RELATION:TARGET:MASTER = LIMIT(RELATION:TARGET:MASTER+5,10,300)
CASE "依頼失敗時"
;失敗報告時の処理
;過酷な依頼なので少しだけ
	PRINTFORML %CALLNAME:TARGET% seems upset that you didn't feed %HIM_HER(TARGET)%
	CALL CHANGE_CFLAG(2, TARGET, -3)
	CALL CHANGE_CFLAG(4, TARGET, -2)
ENDSELECT