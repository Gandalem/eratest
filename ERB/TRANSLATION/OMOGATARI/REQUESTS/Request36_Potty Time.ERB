; Modular ERB: OMOGATARI/REQUESTS/Request36_Potty Time.ERB
;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう

@EXIST_一般依頼36
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです

@一般依頼36(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "依頼名"
		CALLF MAKE_STR(V_NAME, @"I need to go potty!")
	CASE "依頼内容表示"
		LOCALS '= @"%CALLNAME:ARG%를 화장실에 데려가라"
		CALLF MAKE_STR(V_NAME, @"%LOCALS%")
	CASE "依頼報酬表示"
		CALLF MAKE_STR(V_NAME, @"호의")
	CASE "依頼実行コマンド名"
		CALLF MAKE_STR(V_NAME, @"Relieve %CALLNAME:ARG%")
	CASE "依頼内容"
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(ARG, "person"))
	CASE "依頼サブ"
	CASE "依頼期限"
		;発生時ではなく受託時に確定します
		CALLF MAKE_INT(V_NAME, 0)
	CASE "依頼発生率"
		;これは他の一般依頼との相対確率なんで10％ではありません
		;percentage change of being shown. (set to 100 to always show)
		;CALLF MAKE_INT(V_NAME, 100)
		CALLF MAKE_INT(V_NAME, 50)
	CASE "依頼発生条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼受託可能条件"
		;あなたの戦闘能力が1以上
		;we're skirting along a fine line here.
		IF TALENT:ARG:BornChild && CharaAge:ARG:0 < ICSexThreshold()
			CALLF MAKE_INT(V_NAME, 0)
			RETURNF
		ENDIF
		IF PeeBarStage(ARG) < 4 && PooBarStage(ARG) < 4
			CALLF MAKE_INT(V_NAME, 0)
			;ELSEIF (INRANGE(CharaAge:ARG:0, 3, 7)) ;we're skirting along a fine line here.
			;	CALLF MAKE_INT(V_NAME, 1)
		ELSEIF (PeeHold:ARG:2 <= -2 && PeeBarStage(ARG) >= 4) || (PooHold:ARG:2 <= -2 && PooBarStage(ARG) >= 4)
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
		RETURNF 1
	CASE "依頼実行可能条件"
		; IF IsPadded(ARG,"diaper") && !SoiledDiaper(ARG)
		; CALLF MAKE_INT(V_NAME, 0)
		; ELSE
		; ENDIF
		;SIF IS_TOILET(CFLAG:ARG:現在位置, ARG)
		CALLF MAKE_INT(V_NAME, 1)
		;成功/失敗処理はCARRYOUTで直接書く
		;SOURCEやITEM入手、消費が煩雑になるので
	CASE "依頼消滅条件"
		;cancel
		SIF Add_Request_Should_Discard(ARG)
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼人連れ出し可能"
		CALLF MAKE_INT(V_NAME, 1)
ENDSELECT

@IRAI_一般36(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  CHK_SLOT
#DIM  OPPONENT_REMAIN
#DIM HasPiss
#DIM HasScat
VARSET HasPiss
VARSET HasScat
SIF PeeBarStage(CHARA) >= 4
	HasPiss = 1
SIF PooBarStage(CHARA) >= 4
	HasScat = 1
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
CHK_SLOT  = SEARCH_IRAI_SLOT(IRAI_ID)
SELECTCASE SCENE
	CASE "依頼条件表示"
		;何か専用の表示情報を設けたい時用
		;受託済みの依頼表示で使用されます
		;
		;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
		;ここ以外の表示項目は
		;PRINTFORML 　　　　　：
		;となっているのでスペースを揃えたほうが見栄えが良いです
	CASE "依頼実行時"
		;このCASEに限り、RESULTが意味を持ちます
		;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
		;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
		;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
		;
		;
		;実行できないパターン
		;拠点では屋内だとダメ（原作だとめっちゃやってるけど）
		;ほぼ弾幕勝負のコピペ
		;wetting or messing, no way to save this 2hu from an accident.
		IF PeeBarStage(CHARA) >= 7 || PooBarStage(CHARA) >= 7
			PRINTFORML 하지만 당신이 말하는 동안, %CALLNAME:CHARA%은 지금 사고를 치고 있다!
			PRINTFORML 당신은 어쩔 수 없이 %CALLNAME:CHARA%이 %PeeAndPoo(HasPiss,HasScat, "flood", "fill")% %HIS_HER(CHARA)% %PeeProtectType(CHARA,1)%하는 것을 지켜보게 된다.
			RETURN IRAI_CONST_RESULT("実行して失敗")
		ELSEIF PeeBarStage(CHARA) < 4 && PooBarStage(CHARA) < 4 ;bladder and bowels are empty
			RETURN IRAI_CONST_RESULT("実行して成功")
		ELSEIF SoiledSelf:CHARA:0 || SoiledSelf:CHARA:1 ; had an accident
			RETURN IRAI_CONST_RESULT("実行して失敗")
		ENDIF
		; [AUTO-NEUTRALIZED] CALL ASK_M(@"%CALLNAME:CHARA%에게 %HE_SHE(CHARA)%가 그것을 참아야 할 것(취소)이라고 전하라.", 1, @"%CALLNAME:CHARA%를 변기에 앉혀라", IS_TOILET(CFLAG:CHARA:現在位置, CHARA), @"\@ nOmutsu ? 기저귀 %CALLNAME:CHARA% # ????? \@", 0, @"옷을 벗기고 %CALLNAME:CHARA% 밖에 나가서 화장실에 가도록 만든다 %HIM_HER(CHARA)%.", OUTROOF(MASTER), @"%CALLNAME:CHARA%에게 %HIS_HER(CHARA)% %PeeProtectType(CHARA,2)%을 사용하라고 말한다.", IsPadded(CHARA), @"[\@ !TALENT:CHARA:BornChild || CharaAge:CHARA:0 > ICSexThreshold()] ? %CALLNAME:CHARA%이 당신의 %PeeProtectType(MASTER,2)%를 사용한다 # ????? \@", IsPadded(MASTER) && !HasScat && (!TALENT:CHARA:BornChild || CharaAge:CHARA:0 > ICSexThreshold()), )
		SELECTCASE RESULT
			CASE 0
			CASE 1
				CALL PottyPants(CHARA,HasPiss,HasScat)
				P = RESULT
				PRINTFORML 당신은 %CALLNAME:CHARA%에게 변기에 올라가라고 말한다.
				CALL GoToilet(CHARA,HasPiss,HasScat)
				IF RESULT == -1
					RETURN IRAI_CONST_RESULT("実行して失敗")
				ELSE
					RETURN IRAI_CONST_RESULT("実行して成功")
				ENDIF
			CASE 4
				PRINTFORMW %PARSE("You decide",5,,MASTER)%그것이 %CALLNAME:CHARA%에게... %PARSE("yourself",,,CHARA)%를 해소하는 것이 최선일지도 모른다.
				PRINTFORMW %PARSE("You consider",5,,CHARA)%그 %PARSE("your",5,,MASTER)% 결정이 미치는 영향을 잠시 고려한 후, %PARSE("yourself",5,,CHARA)%을 다잡고 그 %PARSE("your",5,,MASTER)%식 유치한 결정을 계속한다.
				PRINTL
				CALL INTENTIONAL_ACCIDENT(CHARA,HasPiss,HasScat, 1)
				IF SoiledSelf:CHARA:0 || SoiledSelf:CHARA:1 ; had an accident
					PRINTFORMW %CALLNAME:CHARA%는 당신의 조언을 듣고 얼굴이 새빨개졌다.
					PRINTFORMW 아마 현장에서 %HIM_HER(CHARA)%에게 %PeeAndPoo(HasPiss,HasScat,"wet","mess")% 하라고 말한 것은 현명하지 않았던 것 같다.
					RETURN IRAI_CONST_RESULT("実行して失敗")
				ELSE
					PRINTFORMW %CALLNAME:CHARA%은(는) 다시 %HIS_HER(CHARA)%에게 신뢰를 받은 것 같아 안도하는 듯하다.
					PRINTFORMW %HE_SHE(CHARA,1)%은(는) %HE_SHE(CHARA)%가 변기에 가고 싶어 했다는 사실을 잊으려고 노력한다.
					JUEL:CHARA:Regression += 5000
					CALL COLORMESSAGE(@"%CALLNAME:CHARA% 회귀 보석 +{5000}",C_PINK,1)
					RETURN IRAI_CONST_RESULT("実行して成功")
				ENDIF
			CASE 5
				PRINTFORMDW 당신은 스트레칭을 시작하며 %PeeProtectType(MASTER)%의 허리띠에 양 엄지손가락을 넣고 %PeeProtectType(MASTER,1)%를 앞으로 내밀어 통로를 만든다.
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 왜 기저귀를 차고 있는지 의문을 제기하지만, 어쨌든 진행하기로 결정한다.
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% 당신의 어깨를 잡고 몸을 앞으로 숙이기 전에 천천히 다가온다.
				PRINTL
				IF HAS_PENIS(CHARA)
					PRINTFORMDW %HE_SHE(TARGET,1)%은(는) 당신의 %PeeProtectType(MASTER,1)%에서 %HIS_HER(CHARA)% %TINKO_TR(CHARA)%을 꺼내서 %HIS_HER(CHARA)% %PeeProtectType(CHARA)%에 넣는다.
				ELSE
					PRINTFORMDW %HE_SHE(TARGET,1)%은/는 %HIS_HER(CHARA)% %PeeProtectType(CHARA)%를/을 옆으로 밀어낸 후 당신을 단단히 끌어안는다.
				ENDIF
				PRINTL
				PRINTFORMDW 한 줄기의 %URINE(CHARA,1)%이 당신의 %FSYN("crotch")% 위로 분수처럼 뿜어져 나온다.
				PRINTFORMDW %URINE(CHARA)%는 축축함의 감각이 당신의 %FSYN("crotch")%를 타고 흘러내리기 시작하면서 매우 따뜻하다.
				PRINTFORMDW 당신의 %PeeProtectType(MASTER,2)%에서 안도감을 찾은 후, %CALLNAME:CHARA%가 한숨을 쉬자 분수는 홍수로 바뀐다.
				PRINTFORMDW %URINE(CHARA)%는 당신의 누출 방지 장치에 의해 붙잡힌 채 다리 사이 공간에 고이기 시작한다.
				PRINTFORMDW %CALLNAME:CHARA%는 %HIS_HER(CHARA)% 방광이 완전히 비워질 때까지 계속해서 %FSYN("pee")%한다.
				IF PeeBarStage(MASTER) >= 2
					PRINTL
					PRINTFORMDW 그것을 도울 수 없자, 당신도 자신의 %PeeProtectType(MASTER,2)%를 다른 사람이 사용하도록 내버려 두고 %FSYN("pee")%하기 시작한다.
					PRINTFORMDW 그게 당신의 소변인지, 아니면 %CALLNAME:CHARA%의 것인지는 상관없지만, 그것이 당신의 피부와 패드에 닿자 안도감에 얼굴을 붉힌다.
					HasPiss = 2
				ENDIF
				PRINTL
				IF HasPiss == 2
					PRINTFORMDW %CALLNAME:CHARA%은 왜 %HE_SHE(CHARA)%가 그렇게 많이 소변을 봤는지 묻지만, 당신은 자신도 소변을 봤다고 대답한다.
					PRINTFORMDW 완전히 젖어버린 %PeeProtectType(MASTER,1)% 속에서 당신이 호사스럽게 누워 있으면서, %HES_SHES(CHARA)%가 정말로 배변 훈련을 할 준비가 되었는지 궁금해한다.
					CALL OMORASHI_END(MASTER, 1, 0)
				ELSE
					PRINTFORMDW %CALLNAME:CHARA%는 당신의 행동에 감사하며, %HE_SHE(CHARA)%가 화장실을 갔다고 말한다.
					PRINTFORMDW 당신은 %HIM_HER(CHARA)%가 기저귀 사용을 변기에 가는 것으로 간주하는지 궁금해하지만, 결국 그것이 배변이 아니라 사고도 아니라는 결론에 도달한다.
				ENDIF
				CALLF MessUndies(MASTER, "liquid", 0, BASE:CHARA:4)
				CALL OMORASHI_END(CHARA, 1, 0, 1, 1, 1)
		ENDSELECT
		;bladder and bowels are empty
		SIF PeeBarStage(CHARA) < 4 && PooBarStage(CHARA) < 4
			RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼成功時"
		;成功報告時の報酬など
		SOURCE:歓楽 = 3000
		CALL CHANGE_CFLAG(2, CHARA, 10 + RAND:5)
		CALL CHANGE_CFLAG(4, CHARA, 15 + RAND:5)
		RELATION:CHARA:MASTER = LIMIT(RELATION:CHARA:MASTER+5,10,300)
		CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("urgencyPass")
	CASE "依頼失敗時"
		;失敗報告時の処理
		;過酷な依頼なので少しだけ
		;PRINTFORML %CALLNAME:TARGET% seems upset that you didn't change %HIM_HER(TARGET)%
		PRINTFORML %CALLNAME:CHARA%는 당신이 %HIM_HER(CHARA)%가 사고를 치도록 내버려 둔 것에 대해 속상해하는 것 같다.
		CALL CHANGE_CFLAG(2, CHARA, -3)
		CALL CHANGE_CFLAG(4, CHARA, -2)
		CALLF Add_SPECIAL_REQUEST_CREATION(CHARA, 31, 100, 1, 1)
ENDSELECT
