;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_一般依頼30
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです
@一般依頼30(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
CASE "依頼名"
	CALLF MAKE_STR(V_NAME, "Hitman")
CASE "依頼内容表示"
	CALLF MAKE_STR(V_NAME, @"Kill the target")
CASE "依頼報酬表示"
	CALLF MAKE_STR(V_NAME, @"Money")
CASE "依頼実行コマンド名"
	CALLF MAKE_STR(V_NAME, "Challenge")
CASE "依頼内容"
	CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(RAND_HANTING_TR(ARG), "討伐"))	
CASE "依頼サブ"
CASE "依頼期限"
;発生時ではなく受託時に確定します
	CALLF MAKE_INT(V_NAME, 30)
CASE "依頼発生率"
;これは他の一般依頼との相対確率なんで10％ではありません
;percentage change of being shown. (set to 100 to always show)
	;CALLF MAKE_INT(V_NAME, 100)
	CALLF MAKE_INT(V_NAME, 5)
CASE "依頼発生条件"
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼受託可能条件"
;あなたの戦闘能力が1以上
	SIF ABL:MASTER:戦闘能力 >= 1 && nNecro && (CharaAge:ARG:0 >= 7 || !TALENT:ARG:BornChild)
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼実行可能条件"
	CALLF MAKE_INT(V_NAME, 1)
;成功/失敗処理はCARRYOUTで直接書く
;SOURCEやITEM入手、消費が煩雑になるので
CASE "依頼消滅条件"
	SIF Add_Request_Should_Discard(ARG)
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼人連れ出し可能"
ENDSELECT

@IRAI_一般30(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  CHK_SLOT
#DIM  OPPONENT_REMAIN
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
CHK_SLOT  = SEARCH_IRAI_SLOT(IRAI_ID)
SELECTCASE SCENE
CASE "依頼条件表示"
;何か専用の表示情報を設けたい時用
;受託済みの依頼表示で使用されます
;
;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
;ここ以外の表示項目は
;PRINTFORML 　　　　　：
;となっているのでスペースを揃えたほうが見栄えが良いです
IF IsDead:CLIENT_ID:0 || !INRANGE(IRAI_SLOT_TO_PERSON(CHK_SLOT),0,CHARANUM-1)
	CALL SET_IRAI_PROGRESS(CLIENT_ID, "依頼失敗")
ELSEIF IsDead:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):0
	CALL SET_IRAI_PROGRESS(CLIENT_ID, "依頼達成")
ENDIF
CASE "依頼実行時"
;このCASEに限り、RESULTが意味を持ちます
;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
;
;
	;実行できないパターン
	;拠点では屋内だとダメ（原作だとめっちゃやってるけど）
	;ほぼ弾幕勝負のコピペ
	PRINTFORML Do you warn %CALLNAME:TARGET% about %CALLNAME:CLIENT_ID%'s hit on %HIS_HER(TARGET)%?
	PRINTFORML [0] - Attack Unprovoked
	PRINTFORML [1] - Warn %CALLNAME:TARGET%
	PRINTFORML [2] - Do nothing
	INPUT
	SELECTCASE RESULT
	CASE 0
		CALL KNIFE_FIGHT(MASTER,TARGET,1,1)

		SIF AT_HOME(MASTER)
			YOGORE:(CFLAG:MASTER:現在位置) = LIMIT(YOGORE:(CFLAG:MASTER:現在位置) + 3000, 0, 6000)
		IF TCVAR:TARGET:Grievous_Harm 
			PRINTL 
			SETCOLOR C_YELLOW
			PRINTFORMW %CALLNAME:TARGET% has been subjugated!
			RESETCOLOR
			RETURN IRAI_CONST_RESULT("実行して成功")
		ELSE
			SETCOLOR C_GREEN
			PRINTFORML Failed to subjugate %CALLNAME:TARGET%...
			PRINTFORMW ... %PARSE("You'll")% have to challenge %HIM_HER(TARGET)% at a later date.
			RESETCOLOR
			RETURN IRAI_CONST_RESULT("実行して未解決")
		ENDIF
	CASE 1
		PRINTFORMW You inform %CALLNAME:TARGET% about %CALLNAME:CLIENT_ID%'s hit on %HIS_HER(TARGET)% and tell %HIM_HER(TARGET)% to hide.
		PRINTFORML You give %CALLNAME:TARGET% a pistol and tell %HIM_HER(TARGET)% to use it to kill %CALLNAME:CLIENT_ID% if %HE_SHE(CLIENT_ID)% comes.
		SIF GET_INT(TARGET, "Weapon",EQUIP:TARGET:Weapon, "Grade") < 5
		CALLF EQUIPWEAPON(TARGET,27)		
		RELATION:TARGET:MASTER = LIMIT(RELATION:TARGET:MASTER+100,10,300)
		RELATION:TARGET:CLIENT_ID = 10
		CALL COLORMESSAGE(@"%CALLNAME:TARGET% now hates %CALLNAME:CLIENT_ID%!",C_RED,2,1)

		SOURCE:歓楽 = 4000
		CALL CHANGE_CFLAG(2, TARGET, 40 + RAND:20)
		CALL CHANGE_CFLAG(4, TARGET, 40 + RAND:20)		
		
		IF !RAND:2
		CFLAG:CLIENT_ID:現在位置 = KICKOUT()
		PRINTFORML Betrayed by your act, %CALLNAME:CLIENT_ID% does the dirty deed %HIMSELF_HERSELF(CLIENT_ID)%...
		CALL KNIFE_FIGHT(CLIENT_ID,TARGET,1,1)
		CALL KNIFE_FIGHT(CLIENT_ID,MASTER,1,1)
		ENDIF
		RETURN IRAI_CONST_RESULT("実行して失敗")
	ENDSELECT
CASE "依頼成功時"
;成功報告時の報酬など
	SELECTCASE LEVEL_TO_RANK(ABL:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):戦闘能力)
	CASE IS <= 1
		SOURCE:歓楽 = 1000
		CALL CHANGE_CFLAG(2, TARGET, 10 + RAND:5)
		CALL CHANGE_CFLAG(4, TARGET, 15 + RAND:5)
		CALL GET_SPELL_CARD_BONUS_YEN(100000, 2)
	CASE 2
		SOURCE:歓楽 = 1500
		CALL CHANGE_CFLAG(2, TARGET, 15 + RAND:5)
		CALL CHANGE_CFLAG(4, TARGET, 20 + RAND:10)
		CALL GET_SPELL_CARD_BONUS_YEN(200000, 2)
	CASE 3
		SOURCE:歓楽 = 2000
		CALL CHANGE_CFLAG(2, TARGET, 20 + RAND:10)
		CALL CHANGE_CFLAG(4, TARGET, 25 + RAND:10)
		CALL GET_SPELL_CARD_BONUS_YEN(500000, 2)
	CASE 4
		SOURCE:歓楽 = 2500
		CALL CHANGE_CFLAG(2, TARGET, 25 + RAND:10)
		CALL CHANGE_CFLAG(4, TARGET, 30 + RAND:10)
		CALL GET_SPELL_CARD_BONUS_YEN(1000000, 2)
	CASE 5
		SOURCE:歓楽 = 3000
		CALL CHANGE_CFLAG(2, TARGET, 30 + RAND:20)
		CALL CHANGE_CFLAG(4, TARGET, 35 + RAND:20)
		CALL GET_SPELL_CARD_BONUS_YEN(1500000, 2)
	CASEELSE
		SOURCE:歓楽 = 4000
		CALL CHANGE_CFLAG(2, TARGET, 40 + RAND:20)
		CALL CHANGE_CFLAG(4, TARGET, 40 + RAND:20)
		CALL GET_SPELL_CARD_BONUS_YEN(3000000, 2)
	ENDSELECT
	RELATION:TARGET:MASTER = LIMIT(RELATION:TARGET:MASTER+50,10,300)
CASE "依頼失敗時"
;失敗報告時の処理
;過酷な依頼なので少しだけ
	PRINTFORML BoNus FAilEd...
	CALL CHANGE_CFLAG(2, TARGET, -3)
	CALL CHANGE_CFLAG(4, TARGET, -2)
ENDSELECT