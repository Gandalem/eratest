;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_一般依頼31
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです
@一般依頼31(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME

SELECTCASE O_DATA
CASE "依頼名"
	;;you need some bratty ones and some shy ones, along with acceptance in the fact they require a diaper change
	{
	SELECTCASE IFRAND(
	"0", 1,
	"1TO3", SoiledDiaper(ARG),
	"4TO9", IRAI_31_Is_Diaper_Lover(ARG) && SoiledDiaper(ARG),
	"10TO13", IRAI_31_Is_Diaper_Lover(ARG) && !IsPadded(ARG),
	"14TO16", SoiledDiaper(ARG) && EffectivePottyLevel(ARG) <= -2,
	"17TO19", EffectivePottyLevel(ARG) <= -2 && !IsPadded(ARG)
	)
	}
		CASE 0
			CALLF MAKE_STR(V_NAME, @"%CAPITALIZE(PeeProtectType(ARG,3))% Change")
		CASE 1
			CALLF MAKE_STR(V_NAME, @"I had an accident...")
		CASE 2
			CALLF MAKE_STR(V_NAME, @"I couldn't hold it...")
		CASE 3
			CALLF MAKE_STR(V_NAME, @"I \@ SoiledDiaper(ARG,2,,15) ? pooped # peed \@...")
		CASE 4
			CALLF MAKE_STR(V_NAME, @"Wah, I'm stinky...")
		CASE 5
			CALLF MAKE_STR(V_NAME, @"My padding's so full")
		CASE 6
			CALLF MAKE_STR(V_NAME, @"I need \@ nOmutsu ? a new diapee # some new undies \@")
		CASE 7
			CALLF MAKE_STR(V_NAME, @"Change me!")
		CASE 8
			CALLF MAKE_STR(V_NAME, @"I made an uh oh")
		CASE 9
			CALLF MAKE_STR(V_NAME, @"I'm \@ SoiledDiaper(ARG,2,,15) ? messy # soggy \@")
		CASE 10
			CALLF MAKE_STR(V_NAME, "I want my diapees")
		CASE 11
			CALLF MAKE_STR(V_NAME, "I feel unprotected")
		CASE 12
			CALLF MAKE_STR(V_NAME, "My crotch feels like there's something missing to it")
		CASE 13
			CALLF MAKE_STR(V_NAME, "Put me in a diaper")
		CASE 14
			CALLF MAKE_STR(V_NAME, @"Routine %PeeProtectType(ARG,3)% change")
		CASE 15
			CALLF MAKE_STR(V_NAME, @"I'm never dry...")
		CASE 16
			CALLF MAKE_STR(V_NAME, @"My %PeeProtectType(ARG,3)%'s a mess")
		CASE 17
			CALLF MAKE_STR(V_NAME, @"Can't be trusted for big %PRINT_MALE("boy",ARG)% panties")
		CASE 18
			CALLF MAKE_STR(V_NAME, @"Am incontinent, need padding")
		CASE 19
			CALLF MAKE_STR(V_NAME, "I feel unprotected")
	ENDSELECT
CASE "依頼内容表示"
	LOCALS '= @"Change %CALLNAME:ARG%"
	CALLF MAKE_STR(V_NAME, @"%LOCALS%")
CASE "依頼報酬表示"
	CALLF MAKE_STR(V_NAME, @"Favor + Regression Gems")
CASE "依頼実行コマンド名"
	CALLF MAKE_STR(V_NAME, "Change")
CASE "依頼内容"
    CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(ARG, "person"))
CASE "依頼サブ"
CASE "依頼期限"
;発生時ではなく受託時に確定します
	CALLF MAKE_INT(V_NAME, 0)
CASE "依頼発生率"
;これは他の一般依頼との相対確率なんで10％ではありません
;percentage change of being shown. (set to 100 to always show)
	;CALLF MAKE_INT(V_NAME, 100)
	CALLF MAKE_INT(V_NAME, 50)
CASE "依頼発生条件"
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼受託可能条件"
;あなたの戦闘能力が1以上
	IF (!nOmutsu && !GETBIT(nPee,1) && !GETBIT(nScat,2)) || (IsPadded(ARG,"diaper") && !SoiledDiaper(ARG)) || ARG == 93
		CALLF MAKE_INT(V_NAME, 0)
	ELSEIF SoiledDiaper(ARG) || ((ABL:ARG:DiaperAttraction >= 5 || IS_BABY(ARG)) && !IsPadded(ARG)) || PeeHold:ARG:2 <= -2 || PooHold:ARG:2 <= -2
		CALLF MAKE_INT(V_NAME, 1)
	ENDIF
CASE "依頼実行可能条件"
	IF IsPadded(ARG,"diaper") && !SoiledDiaper(ARG)
	CALLF MAKE_INT(V_NAME, 0)
	ELSE
	CALLF MAKE_INT(V_NAME, 1)
	ENDIF
;成功/失敗処理はCARRYOUTで直接書く
;SOURCEやITEM入手、消費が煩雑になるので
CASE "依頼消滅条件"
	;cancel
	SIF Add_Request_Should_Discard(ARG)
		CALLF MAKE_INT(V_NAME, 1)
CASE "依頼人連れ出し可能"
ENDSELECT

@IRAI_一般31(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  CHK_SLOT
#DIM  OPPONENT_REMAIN
#DIM  DIAPER
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
CHK_SLOT  = SEARCH_IRAI_SLOT(IRAI_ID)
SELECTCASE SCENE
CASE "依頼条件表示"
;何か専用の表示情報を設けたい時用
;受託済みの依頼表示で使用されます
;
;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
;ここ以外の表示項目は
;PRINTFORML 　　　　　：
;となっているのでスペースを揃えたほうが見栄えが良いです

CASE "依頼実行時"
;このCASEに限り、RESULTが意味を持ちます
;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
;
;
	;実行できないパターン
	;拠点では屋内だとダメ（原作だとめっちゃやってるけど）
	;ほぼ弾幕勝負のコピペ
	
	PRINTFORML Please pick a diaper to change %CALLNAME:CHARA% into
	CALL Com_DiaperGrab(CHARA, 1)
	IF RESULT != 999
	DIAPER = RESULT
	ELSE
	RETURN IRAI_CONST_RESULT("実行して未解決")
	ENDIF
	IF !IS_BABY(CHARA)
		PRINTFORML You can choose to either punish %CALLNAME:CHARA% for the accident or to forgive %HIM_HER(CHARA)%.
		{
			CALL ASK_YN(
			"Punish",
			"Forgive"
			)
		}
		SIF !RESULT
			CALL PunishmentPointChange(CHARA,PUNISHMENT_POINT_GAIN(CHARA))
	ENDIF
	PRINTFORML You put %CALLNAME:CHARA% down on %HIS_HER(CHARA)% back, spreading %HIS_HER(CHARA)% legs.
	CALL 脱衣処理(CHARA, "くすねる")
	PRINTFORMW Cleaning up %CALLNAME:CHARA%'s \@ SoiledDiaper(CHARA) ? %"messy "% #\@%FSYN("crotch")%, you start grabbing a %CLOTHNAME(6,DIAPER)% from your bag.	
	IF IsPadded(CHARA, "diaper", DIAPER)
	PRINTFORMW You open the diaper and place the padded side against %CALLNAME:CHARA% and slide the side with the tabs on %HIS_HER(CHARA)% back.
	PRINTFORMW You then open up both tabs and adhere them to the front of %HIS_HER(CHARA)% clean diaper, ensuring a tight fit, before you and %CALLNAME:CHARA% stand back up. 
	ELSEIF IsPadded(CHARA, "pull-up", DIAPER)
	PRINTFORMW You side the new pull-up diaper up %HIS_HER(CHARA)% legs and into %HIS_HER(CHARA)% crotch, ensuring a tight fit, before you and %CALLNAME:CHARA% stand back up.
	ELSE
	PRINTFORMW You side the new underwear up %HIS_HER(CHARA)% legs and into %HIS_HER(CHARA)% crotch, ensuring a tight fit, before you and %CALLNAME:CHARA% stand back up.
	ENDIF
	IF IsPadded(CHARA, , DIAPER)
		IF PeeBarStage(CHARA) >= 5 || PooBarStage(CHARA) >= 5
			;CALL PlayAccidentSound(CHARA,PeeBarStage(CHARA) >= 2 ? 1 # 0,"loc",PooBarStage(CHARA) >= 2 ? 1 # 0,"loc")
			PRINTFORMW %CALLNAME:CHARA% blushes as %HE_SHE(CHARA)%'s begins to use it to relieve %HIMSELF_HERSELF(CHARA)%...
			CALL OMORASHI_END(CHARA,PeeBarStage(CHARA) >= 5,PooBarStage(CHARA) >= 5)
		ELSE
			SELECTCASE ABL:CHARA:DiaperAttraction
			CASE 0
				PRINTFORMW %CALLNAME:CHARA% wishes you just gave %HIM_HER(CHARA)% new underwear instead...
			CASE 1
				PRINTFORMW While %CALLNAME:CHARA% doesn't completely hate you for diapering %HIM_HER(CHARA)%, %HE_SHE(CHARA)% still wants some panties over it.
			CASE 2
				PRINTFORMW  %CALLNAME:CHARA% gives a slight pout.
			CASE 3
				PRINTFORMW %HE_SHE(CHARA,1)% seems to be a bit opening to being padded.
			CASE 4
				PRINTFORMW %HE_SHE(CHARA,1)% looks rather comfortable in their new diaper.	
			CASE 5
				PRINTFORMW %HE_SHE(CHARA,1)% looks very happy to be diapered.	
			CASE IS < 10
				PRINTFORMW %HE_SHE(CHARA,1)% seems to have gotten a bit more horny from %HIS_HER(CHARA)% diaper change.
			CASEELSE
				CALL PlayAccidentSound(CHARA,PeeBarStage(CHARA) >= 2 ? 1 # 0,"loc",PooBarStage(CHARA) >= 2 ? 1 # 0,"loc")
				PRINTFORMW %CALLNAME:CHARA% is completely turned on from %HIS_HER(CHARA)% new diaper, and before you can look away, %HE_SHE(CHARA)%'s already using it...
				CALL OMORASHI_END(CHARA,PeeBarStage(CHARA) >= 2 ? 1 # 0,PooBarStage(CHARA) >= 2 ? 1 # 0)
			ENDSELECT
		ENDIF
	ELSE
		PRINTFORMW %CALLNAME:CHARA% looks rather comfortable in their new undies.
	ENDIF
	CALLF PANTY_REWORK_CHANGE(CHARA, DIAPER)
	CFLAG:CHARA:パンツ2 = 1
	RETURN IRAI_CONST_RESULT("実行して成功")
CASE "依頼成功時"
;成功報告時の報酬など
	SOURCE:歓楽 = 3000
	CALL CHANGE_CFLAG(2, CHARA, 10 + RAND:5)
	CALL CHANGE_CFLAG(4, CHARA, 15 + RAND:5)
	RELATION:CHARA:MASTER = LIMIT(RELATION:CHARA:MASTER+5,10,300)
CASE "依頼失敗時"
;失敗報告時の処理
;過酷な依頼なので少しだけ
	PRINTFORML %CALLNAME:CHARA% seems upset that you didn't change %HIM_HER(CHARA)%
	CALL CHANGE_CFLAG(2, CHARA, -3)
	CALL CHANGE_CFLAG(4, CHARA, -2)
ENDSELECT

@IRAI_31_Is_Diaper_Lover(ARG)
#FUNCTION
RETURNF (ABL:ARG:DiaperAttraction >= 5 || IS_BABY(ARG) || MARK:ARG:RegressionMark >= 3)