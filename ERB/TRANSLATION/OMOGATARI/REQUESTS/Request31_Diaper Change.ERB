; Modular ERB: OMOGATARI/REQUESTS/Request31_Diaper Change.ERB
;hardcore content toggle, <abdl>
;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう

@EXIST_一般依頼31
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです

@一般依頼31(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "依頼名"
		;;you need some bratty ones and some shy ones, along with acceptance in the fact they require a diaper change
		SELECTCASE IFRAND( "0", 1, "1TO3", SoiledDiaper(ARG), "4TO9", IRAI_31_Is_Diaper_Lover(ARG) && SoiledDiaper(ARG), "10TO13", IRAI_31_Is_Diaper_Lover(ARG) && !IsPadded(ARG), "14TO16", SoiledDiaper(ARG) && EffectivePottyLevel(ARG) <= -2, "17TO19", EffectivePottyLevel(ARG) <= -2 && !IsPadded(ARG) )
			CASE 0
				CALLF MAKE_STR(V_NAME, @"%CAPITALIZE(PeeProtectType(ARG,3))% Change")
			CASE 1
				CALLF MAKE_STR(V_NAME, @"I had an accident...")
			CASE 2
				CALLF MAKE_STR(V_NAME, @"I couldn't hold it...")
			CASE 3
				CALLF MAKE_STR(V_NAME, @"I \@ SoiledDiaper(ARG,2,,15) ? pooped # peed \@...")
			CASE 4
				CALLF MAKE_STR(V_NAME, @"Wah, I'm stinky...")
			CASE 5
				CALLF MAKE_STR(V_NAME, @"My padding's so full")
			CASE 6
				CALLF MAKE_STR(V_NAME, @"I need \@ nOmutsu ? a new diapee # some new undies \@")
			CASE 7
				CALLF MAKE_STR(V_NAME, @"Change me!")
			CASE 8
				CALLF MAKE_STR(V_NAME, @"I made an uh oh")
			CASE 9
				CALLF MAKE_STR(V_NAME, @"I'm \@ SoiledDiaper(ARG,2,,15) ? messy # soggy \@")
			CASE 10
				CALLF MAKE_STR(V_NAME, "I want my diapees")
			CASE 11
				CALLF MAKE_STR(V_NAME, "I feel unprotected")
			CASE 12
				CALLF MAKE_STR(V_NAME, "My crotch feels like there's something missing to it")
			CASE 13
				CALLF MAKE_STR(V_NAME, "Put me in a diaper")
			CASE 14
				CALLF MAKE_STR(V_NAME, @"Routine %PeeProtectType(ARG,3)% change")
			CASE 15
				CALLF MAKE_STR(V_NAME, @"I'm never dry...")
			CASE 16
				CALLF MAKE_STR(V_NAME, @"My %PeeProtectType(ARG,3)%'s a mess")
			CASE 17
				CALLF MAKE_STR(V_NAME, @"Can't be trusted for big %PRINT_MALE("boy",ARG)% panties")
			CASE 18
				CALLF MAKE_STR(V_NAME, @"Am incontinent, need padding")
			CASE 19
				CALLF MAKE_STR(V_NAME, "I feel unprotected")
		ENDSELECT
	CASE "依頼内容表示"
		LOCALS '= @"%CALLNAME:ARG%변경한다"
		CALLF MAKE_STR(V_NAME, @"%LOCALS%")
	CASE "依頼報酬表示"
		CALLF MAKE_STR(V_NAME, @"호의 + 퇴행 보석")
	CASE "依頼実行コマンド名"
		CALLF MAKE_STR(V_NAME, "Change")
	CASE "依頼内容"
		CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(ARG, "person"))
	CASE "依頼サブ"
	CASE "依頼期限"
		;発生時ではなく受託時に確定します
		CALLF MAKE_INT(V_NAME, 0)
	CASE "依頼発生率"
		;これは他の一般依頼との相対確率なんで10％ではありません
		;percentage change of being shown. (set to 100 to always show)
		;CALLF MAKE_INT(V_NAME, 100)
		CALLF MAKE_INT(V_NAME, 50)
	CASE "依頼発生条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼受託可能条件"
		;あなたの戦闘能力が1以上
		IF (!nOmutsu && !GETBIT(nPee,1) && !GETBIT(nScat,2)) || (IsPadded(ARG,"diaper") && !SoiledDiaper(ARG)) || ARG == 93
			CALLF MAKE_INT(V_NAME, 0)
		ELSEIF SoiledDiaper(ARG) || ((ABL:ARG:DiaperAttraction >= 5 || IS_BABY(ARG)) && !IsPadded(ARG)) || PeeHold:ARG:2 <= -2 || PooHold:ARG:2 <= -2
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
	CASE "依頼実行可能条件"
		IF IsPadded(ARG,"diaper") && !SoiledDiaper(ARG)
			CALLF MAKE_INT(V_NAME, 0)
		ELSE
			CALLF MAKE_INT(V_NAME, 1)
		ENDIF
		;成功/失敗処理はCARRYOUTで直接書く
		;SOURCEやITEM入手、消費が煩雑になるので
	CASE "依頼消滅条件"
		;cancel
		SIF Add_Request_Should_Discard(ARG)
			CALLF MAKE_INT(V_NAME, 1)
	CASE "依頼人連れ出し可能"
ENDSELECT

@IRAI_一般31(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  CHK_SLOT
#DIM  OPPONENT_REMAIN
#DIM  DIAPER
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
CHK_SLOT  = SEARCH_IRAI_SLOT(IRAI_ID)
SELECTCASE SCENE
	CASE "依頼条件表示"
		;何か専用の表示情報を設けたい時用
		;受託済みの依頼表示で使用されます
		;
		;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
		;ここ以外の表示項目は
		;PRINTFORML 　　　　　：
		;となっているのでスペースを揃えたほうが見栄えが良いです
	CASE "依頼実行時"
		;このCASEに限り、RESULTが意味を持ちます
		;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
		;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
		;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
		;
		;
		;実行できないパターン
		;拠点では屋内だとダメ（原作だとめっちゃやってるけど）
		;ほぼ弾幕勝負のコピペ
		PRINTFORML 갈 기저귀를 골라주세요 %CALLNAME:CHARA%에게
		CALL Com_DiaperGrab(CHARA, 1)
		IF RESULT != 999
			DIAPER = RESULT
		ELSE
			RETURN IRAI_CONST_RESULT("実行して未解決")
		ENDIF
		IF !IS_BABY(CHARA)
			PRINTFORML 당신은 사고에 대해 %CALLNAME:CHARA%를 처벌하거나 %HIM_HER(CHARA)%를 용서할 수 있다.
			CALL ASK_YN( "처벌하다", "용서해라" )
			SIF !RESULT
				CALL PunishmentPointChange(CHARA,PUNISHMENT_POINT_GAIN(CHARA))
		ENDIF
		PRINTFORML 당신은 %CALLNAME:CHARA%을 %HIS_HER(CHARA)%의 등에 내려놓고, %HIS_HER(CHARA)%의 다리를 벌렸다.
		CALL 脱衣処理(CHARA, "くすねる")
		PRINTFORMW %CALLNAME:CHARA%의 \@ SoiledDiaper(CHARA) ? %"messy "% #  \@%FSYN("crotch")%를 치우면서, 당신은 가방에서 %CLOTHNAME(6,DIAPER)%를 집기 시작한다.	
		IF IsPadded(CHARA, "diaper", DIAPER)
			PRINTFORMW 기저귀를 열어 패드 부분이 %CALLNAME:CHARA%에게 닿도록 하고, 탭이 있는 쪽을 %HIS_HER(CHARA)%의 뒤로 밀어 넣는다.
			PRINTFORMW 그리고 양쪽 탭을 열어 %HIS_HER(CHARA)%의 깨끗한 기저귀 앞부분에 단단히 부착하여 잘 고정시킨 후, 당신과 %CALLNAME:CHARA%는 다시 일어선다. 
		ELSEIF IsPadded(CHARA, "pull-up", DIAPER)
			PRINTFORMW 당신은 새 기저귀를 %HIS_HER(CHARA)%의 다리와 %HIS_HER(CHARA)%의 사타구니 쪽으로 단단히 밀어 넣고, 그 후 당신과 %CALLNAME:CHARA%은 일어선다.
		ELSE
			PRINTFORMW 당신은 새 속옷을 %HIS_HER(CHARA)%의 다리 위로 그리고 %HIS_HER(CHARA)%의 사타구니 안으로 밀어 넣어 몸에 꼭 맞추고, 그 후 당신과 %CALLNAME:CHARA%은 다시 일어선다.
		ENDIF
		IF IsPadded(CHARA, , DIAPER)
			IF PeeBarStage(CHARA) >= 5 || PooBarStage(CHARA) >= 5
				;CALL PlayAccidentSound(CHARA,PeeBarStage(CHARA) >= 2 ? 1 # 0,"loc",PooBarStage(CHARA) >= 2 ? 1 # 0,"loc")
				PRINTFORMW %CALLNAME:CHARA% %HE_SHE(CHARA)%가 그것을 사용해 %HIMSELF_HERSELF(CHARA)%를 해방시키기 시작하자 얼굴이 붉어진다.
				CALL OMORASHI_END(CHARA,PeeBarStage(CHARA) >= 5,PooBarStage(CHARA) >= 5)
			ELSE
				SELECTCASE ABL:CHARA:DiaperAttraction
					CASE 0
						PRINTFORMW %CALLNAME:CHARA%는 당신이 대신 %HIM_HER(CHARA)%에게 새 속옷을 입혀줬으면 좋겠다고 바란다...
					CASE 1
						PRINTFORMW %CALLNAME:CHARA%이 %HIM_HER(CHARA)%의 기저귀 사용에 완전히 미워하지 않는 한, %HE_SHE(CHARA)%는 여전히 그 위에 팬티를 원한다.
					CASE 2
						PRINTFORMW  %CALLNAME:CHARA%는 살짝 입술을 내민다.
					CASE 3
						PRINTFORMW %HE_SHE(CHARA,1)%는 패딩에 조금 열려 있는 것 같다.
					CASE 4
						PRINTFORMW %HE_SHE(CHARA,1)%은 새 기저귀를 입고 꽤 편안해 보인다.	
					CASE 5
						PRINTFORMW %HE_SHE(CHARA,1)%은 기저귀를 차게 되어 매우 행복해 보인다.	
					CASE IS < 10
						PRINTFORMW %HE_SHE(CHARA,1)%은(는) %HIS_HER(CHARA)%의 기저귀를 갈고 나서 좀 더 흥분한 것 같다.
					CASEELSE
						CALL PlayAccidentSound(CHARA,PeeBarStage(CHARA) >= 2 ? 1 # 0,"loc",PooBarStage(CHARA) >= 2 ? 1 # 0,"loc")
						PRINTFORMW %CALLNAME:CHARA%는 %HIS_HER(CHARA)%의 새 기저귀 덕분에 완전히 흥분했고, 네가 눈을 돌리기 전에 %HE_SHE(CHARA)%가 이미 그것을 사용하고 있었다...
						CALL OMORASHI_END(CHARA,PeeBarStage(CHARA) >= 2 ? 1 # 0,PooBarStage(CHARA) >= 2 ? 1 # 0)
				ENDSELECT
			ENDIF
		ELSE
			PRINTFORMW %CALLNAME:CHARA%는 새 속옷을 입고 꽤 편안해 보인다.
		ENDIF
		CALLF PANTY_REWORK_CHANGE(CHARA, DIAPER)
		CFLAG:CHARA:パンツ2 = 1
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼成功時"
		;成功報告時の報酬など
		SOURCE:歓楽 = 3000
		CALL CHANGE_CFLAG(2, CHARA, 10 + RAND:5)
		CALL CHANGE_CFLAG(4, CHARA, 15 + RAND:5)
		RELATION:CHARA:MASTER = LIMIT(RELATION:CHARA:MASTER+5,10,300)
	CASE "依頼失敗時"
		;失敗報告時の処理
		;過酷な依頼なので少しだけ
		PRINTFORML %CALLNAME:CHARA%는 당신이 %HIM_HER(CHARA)%를 바꾸지 않은 것에 대해 언짢아 보인다.
		CALL CHANGE_CFLAG(2, CHARA, -3)
		CALL CHANGE_CFLAG(4, CHARA, -2)
ENDSELECT

@IRAI_31_Is_Diaper_Lover(ARG)
#FUNCTION
RETURNF (ABL:ARG:DiaperAttraction >= 5 || IS_BABY(ARG) || MARK:ARG:RegressionMark >= 3)
