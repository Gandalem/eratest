;-------------------------------------------------
;■ランダムキャラの名前に関する変数
;-------------------------------------------------
;姓の候補リスト
#DIMS GLOBAL FAMILY_NAME_LIST, 200
;読み仮名
#DIMS GLOBAL FAMILY_NAME_RUBY, 200
;次に記録する配列番号
#DIM GLOBAL FAMILY_NAME_ADDRESS

;名の候補リスト
#DIMS GLOBAL FIRST_NAME_LIST, 200
;読み仮名
#DIMS GLOBAL FIRST_NAME_RUBY, 200
;次に記録する配列番号
#DIM GLOBAL FIRST_NAME_ADDRESS

;カナ性の候補リスト
#DIMS GLOBAL FAMILY_NAME_K_LIST, 300000
#DIM GLOBAL FAMILY_NAME_K_ADDRESS

;カナ名(男)の候補リスト
#DIMS GLOBAL FIRST_NAME_KM_LIST, 10000
;次に記録する配列番号
#DIM GLOBAL FIRST_NAME_KM_ADDRESS

;カナ名(女)の候補リスト
#DIMS GLOBAL FIRST_NAME_KF_LIST, 10000
;次に記録する配列番号
#DIM GLOBAL FIRST_NAME_KF_ADDRESS

;日本性の候補リスト
#DIMS GLOBAL FAMILY_NAME_J_LIST, 10000
#DIMS GLOBAL FAMILY_NAME_J_RUBY, 10000
#DIM GLOBAL FAMILY_NAME_J_ADDRESS

;日本名(男)の候補リスト
#DIMS GLOBAL FIRST_NAME_JM_LIST, 10000
;読み仮名
#DIMS GLOBAL FIRST_NAME_JM_RUBY, 10000
;次に記録する配列番号
#DIM GLOBAL FIRST_NAME_JM_ADDRESS

;日本名(女)の候補リスト
#DIMS GLOBAL FIRST_NAME_JF_LIST, 10000
;読み仮名
#DIMS GLOBAL FIRST_NAME_JF_RUBY, 10000
;次に記録する配列番号
#DIM GLOBAL FIRST_NAME_JF_ADDRESS

;字の候補リスト
#DIMS GLOBAL MIDDLE_NAME_LIST, 200
;読み仮名
#DIMS GLOBAL MIDDLE_NAME_RUBY, 200
;次に記録する配列番号
#DIM GLOBAL MIDDLE_NAME_ADDRESS

;男性の真名の候補リスト
#DIMS GLOBAL TRUE_NAME_M_LIST, 200
;読み仮名
#DIMS GLOBAL TRUE_NAME_M_RUBY, 200
;次に記録する配列番号
#DIM GLOBAL TRUE_NAME_M_ADDRESS

;女性の真名の候補リスト
#DIMS GLOBAL TRUE_NAME_F_LIST, 200
;読み仮名
#DIMS GLOBAL TRUE_NAME_F_RUBY, 200
;次に記録する配列番号
#DIM GLOBAL TRUE_NAME_F_ADDRESS


;fairy names
#DIMS GLOBAL FAMILY_NAME_FAIRY_LIST, 1000
#DIMS GLOBAL FAMILY_NAME_FAIRY_RUBY, 1000
#DIM GLOBAL FAMILY_NAME_FAIRY_ADDRESS

#DIMS GLOBAL FIRST_NAME_FAIRY_LIST, 1000
#DIMS GLOBAL FIRST_NAME_FAIRY_RUBY, 1000
#DIM GLOBAL FIRST_NAME_FAIRY_ADDRESS