
;create tip table
@TIPS_INIT
DT_CREATE "NAS_TIPS"
DT_COLUMN_ADD "NAS_TIPS", "defName"
DT_COLUMN_ADD "NAS_TIPS", "chara", "int16"
DT_COLUMN_ADD "NAS_TIPS", "tipType"
DT_COLUMN_ADD "NAS_TIPS", "tipGame"

CALL TIPS_ADD_LIST()
CALL TIPS_ADD_LIST("ATW")
CALL TIPS_ADD_LIST("NAS")

;add entries to the table
@TIP_ADD(tipDef,charaAttribute=-1,tipType,tipGame="TW")
#FUNCTION
#DIMS tipDef
#DIM charaAttribute
#DIMS tipType
#DIMS tipGame
{
DT_ROW_ADD @"NAS_TIPS",
"defName",         @"%tipDef%",
"chara",        charaAttribute,
"tipType",      tipType,
"tipGame",      tipGame,
}

;displaying the tips
@TIPS_DISPLAY
#DIM tipPick, 3
#DIM theTipIDs, 1000
SIF !DT_EXIST("NAS_TIPS")
    CALL TIPS_INIT
SIF !OBJ_EXIST("EXIST", "WeaponPreset")
	CALL InitAllWeaponTat
tipPick:2 = DT_ROW_LENGTH("NAS_TIPS")
CALL FISHER_YATES_SHAFFLE(tipPick:2)
tipPick = DT_CELL_GET("NAS_TIPS", SHAFFLE_ARRAY, "id", 0)
LOCALS:1 '= DT_CELL_GETS("NAS_TIPS", tipPick, "tipType", 1)
LOCALS:2 '= DT_CELL_GETS("NAS_TIPS", tipPick, "tipGame", 1)

; There are some commands that can't be executed unless they're in the spot.
; *General #1/54 | Total #53/384*
; "[Wriggle] goes into heat every Spring. Maybe she'll ask you to help satisfy her if she likes you enough..."
; *AnonTW: Character #1/54 | Total #53/384 | Wriggle Nightbug*
; "Don't ask me why Cirno's ID isn't 9."
; *AnonTW: Funny #1/54 | Total #53/384 | Cirno*
LOCALS:3 '= COND_STR(@"%TIPS_GAME_TR(LOCALS:2)%: ",STRLENS(LOCALS:2) && LOCALS:2 != "TW")+TIPS_TYPES_TR(LOCALS:1)
VARSET RESULT
tipPick:1 = DT_SELECT("NAS_TIPS", @"tipType = '%LOCALS:1%' and tipGame = '%LOCALS:2%'")
LOCALS '= @"【%LOCALS:3% #{FINDELEMENT(RESULT,tipPick)}/{tipPick:1} | TIP #{SHAFFLE_ARRAY:0,3}/{tipPick:2,3}"
LOCAL:1 = DT_CELL_GET("NAS_TIPS", tipPick, "chara", 1)
IF LOCAL:1 > -1
    ;getting name of the attributed character
    CALL IndividualNameGet(LOCAL:1)
    LOCALS += @"| %nameArrayTemp:na_CallName%"
ENDIF
LOCALS += @"】"

SETCOLOR C_YELLOW
FONTBOLD
PRINTFORMSL LOCALS
FONTREGULAR
PRINTFORMSL TIPS_TR(DT_CELL_GETS("NAS_TIPS", tipPick, "defName", 1))
RESETCOLOR

;ERROR: "forceEffects" has no translated string!

@TIPS_ADD_LIST(ARGS)
TRYCALLFORM TIPS_%COND_STR(@"%ARGS%_",STRLENS(ARGS))%GENERAL
TRYCALLFORM TIPS_%COND_STR(@"%ARGS%_",STRLENS(ARGS))%SEX
TRYCALLFORM TIPS_%COND_STR(@"%ARGS%_",STRLENS(ARGS))%CHARACTER
TRYCALLFORM TIPS_%COND_STR(@"%ARGS%_",STRLENS(ARGS))%COMBAT
TRYCALLFORM TIPS_%COND_STR(@"%ARGS%_",STRLENS(ARGS))%EXCRETE
TRYCALLFORM TIPS_%COND_STR(@"%ARGS%_",STRLENS(ARGS))%FUNNY
FOR LOCAL,0,64
    TRYCALLFORM TIPS_%COND_STR(@"%ARGS%_",STRLENS(ARGS))%YOUJUTSU_{LOCAL}
NEXT

