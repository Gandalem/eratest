; Modular ERB: OMOGATARI/TalentPoints.ERB

@CalcTalentPointsUsed(ARG)
#FUNCTION
#DIM DYNAMIC CTPU
VARSET CTPU
;crippleeffects does the same thing now
; CALLF ReinitAllCharaCapacity(ARG)
IF IS_HERM(ARG)
	CTPU += 10
ELSEIF HAS_PENIS(ARG)
	CTPU += 5
ENDIF
CTPU += ((MAXBASE:ARG:0-2000)/10)
CTPU += ((MAXBASE:ARG:1-2000)/15)
SIF HAS_PENIS(ARG)
	CTPU += ((MAXBASE:ARG:6-1500)/10)
;Endurance
CTPU += ((PeeHold:ARG:0)*5)
CTPU += ((PooHold:ARG:0)*5)
CTPU += ((OrgasmDeny:ARG:0)*5)
CTPU += ((AlcoholAddict:ARG:0)*5)
CTPU += (-(DrugAddict:ARG:0)*5)
CTPU += (-(CharaTrauma:ARG:0)*10)
;Capacity
CTPU += ((CapacityStats:ARG:0-100))
CTPU += ((CapacityStats:ARG:1-100)/2)
CTPU += ((CapacityStats:ARG:2-100)/2)
CTPU += ((CapacityStats:ARG:3-100)/2)
CTPU += ((CapacityStats:ARG:4-100)/2)
CTPU += ((CapacityStats:ARG:5-100)/2)
CTPU += ((CapacityStats:ARG:6-100)/2)
CTPU += ((CapacityStats:ARG:7-100)/2)
CTPU += ((CapacityStats:ARG:8-100)/2)
CTPU += ((CapacityStats:ARG:9-100)/2)
; ;Skill
; ;20 per skill point
; CTPU += (DT_CELL_GET("FactionUnits",ARG,"combat level",1)*35)
SELECTCASE MAXBASE:ARG:7
	CASE IS <= 0
	CASE IS <= 100
		CTPU += 10
	CASE IS <= 200
		CTPU += 15
	CASE IS <= 500
		CTPU += 20
	CASE IS <= 800
		CTPU += 25
	CASE IS <= 1500
		CTPU += 30
	CASE IS <= 2500
		CTPU += 37
	CASE IS <= 4000
		CTPU += 45
	CASE IS <= 8000
		CTPU += 54
	CASE IS <= 16000
		CTPU += 65
	CASE IS <= 32000
		CTPU += 73
	CASE IS <= 64000
		CTPU += 80
ENDSELECT
SELECTCASE MAXBASE:ARG:8
	CASE IS <= 0
	CASE IS <= 100
		CTPU += 15
	CASE IS <= 200
		CTPU += 20
	CASE IS <= 500
		CTPU += 25
	CASE IS <= 800
		CTPU += 30
	CASE IS <= 1500
		CTPU += 37
	CASE IS <= 2500
		CTPU += 45
	CASE IS <= 4000
		CTPU += 55
	CASE IS <= 8000
		CTPU += 70
	CASE IS <= 16000
		CTPU += 90
	CASE IS <= 32000
		CTPU += 120
	CASE IS <= 64000
		CTPU += 150
ENDSELECT
FOR LOCAL,0,VARSIZE("TALENT")
CTPU += (TALENT_POINTS_PER_TALENT(LOCAL,TALENT:ARG:LOCAL))
NEXT
FOR LOCAL,0,VARSIZE("ABL")
SELECTCASE LOCAL
	CASE 46, 47, 48, 49
		CTPU += (TALENT:ARG:LOCAL)*12
	CASE 40 TO 45, 50 TO 56, 66 TO 70
		CTPU += (ABL:ARG:LOCAL)*12
	CASEELSE
		CTPU += (ABL:ARG:LOCAL)*2
ENDSELECT
NEXT
RETURNF CTPU

@TALENT_POINTS_DISPLAY(C_ID,CHEAT)
#DIM C_ID
#DIM CHEAT
SIF nTalentPoints == -999
	RETURN
PRINTFORM 사용된 재능 포인트: 
PRINTFORM {CalcTalentPointsUsed(C_ID)} 
IF !CHEAT
	SELECTCASE TalentPointOffset-CalcTalentPointsUsed(C_ID)
		CASE IS > 0
			SETCOLOR C_GREEN
		CASE IS < 0
			SETCOLOR C_RED
	ENDSELECT
	PRINTFORM ({TalentPointOffset-CalcTalentPointsUsed(C_ID)} 남음)
ENDIF
RESETCOLOR
PRINTL

@TALENT_POINTS_PER_TALENT(ARG,ARG:1)
#FUNCTION
SELECTCASE ARG
	CASE 10
		SELECTCASE ARG:1
			CASE -1
				RETURNF -5
			CASE 0
				RETURNF 0
			CASE 1
				RETURNF 5
		ENDSELECT
	CASE 11
		SELECTCASE ARG:1
			CASE -1
				RETURNF -5
			CASE 0
				RETURNF 0
			CASE 1
				RETURNF 5
		ENDSELECT
	CASE 12
		SELECTCASE ARG:1
			CASE 0
				RETURNF 0
			CASE 1
				RETURNF 3
		ENDSELECT
	CASE 20
		SIF ARG:1
			RETURNF -10
	CASE 13
		RETURNF (ARG:1)*3
	CASE 21
		SELECTCASE ARG:1
			CASE -1
				RETURNF 5
		ENDSELECT
	CASE 24
		SELECTCASE ARG:1
			CASE -1, 1
				RETURNF 2
		ENDSELECT
	CASE 25
		SIF ARG:1
			RETURNF -10
	CASE 26
		SIF ARG:1
			RETURNF 5
	CASE 40
		RETURNF (-ARG:1)*10
	CASE 41
		SELECTCASE ARG:1
			CASE -1
				RETURNF -5
			CASE 1
				RETURNF 5
		ENDSELECT
	CASE 50
		RETURNF ARG:1*8
	CASE 51, 52
		;use skill levels
	CASE 53
		SIF ARG:1
			RETURNF 5
	CASE 54
		SIF ARG:1
			RETURNF -3
	CASE 55
		SIF ARG:1
			RETURNF 6
	CASE 59
		;ESP
		LOCAL = 0
		SIF GETBIT(ARG:1,0)
			LOCAL += 5
		SIF GETBIT(ARG:1,1)
			LOCAL += 5
		SIF GETBIT(ARG:1,2)
			LOCAL += 15
		RETURNF LOCAL
	CASE 60
		;Masturb
		SIF ARG:1
			RETURNF 3
	CASE 61
		SELECTCASE ARG:1
			CASE -2
				RETURNF -8
			CASE -1
				RETURNF -3
			CASE 0
				RETURNF 0
			CASE 1
				RETURNF 4
			CASE 2
				RETURNF 8
		ENDSELECT
	CASE 62
		;Devoted
		SIF ARG:1
			RETURNF 3
	CASE 70
		RETURNF (ARG:1)*8
	CASE 71
		RETURNF (ARG:1)*10
	CASE 72
		RETURNF (ARG:1)*4
	CASE 80
		RETURNF (ARG:1)*4
	CASE 82, 83
		RETURNF (ARG:1)*5
	CASE 92
		RETURNF (ARG:1)*5
	CASE 93
		RETURNF (ARG:1)*10
	CASE 94
		RETURNF (ARG:1)*8
	CASE 96,97
		RETURNF (-ARG:1)*8
	CASE 100
		SELECTCASE ARG:1
			CASE -5
				RETURNF -30
			CASE -4
				RETURNF -20
			CASE -3
				RETURNF -15
			CASE -2
				RETURNF -10
			CASE -1
				RETURNF -5
			CASE 0
				RETURNF 0
			CASE 1
				RETURNF 3
			CASE 2
				RETURNF 6
			CASE 5
				RETURNF 15
		ENDSELECT
	CASE 101 TO 104, 106, 107
		RETURNF (ARG:1)*3
	CASE 130
		RETURNF (ARG:1)*12
	CASE 133,134
		RETURNF (ARG:1)*2
	CASE 137
		RETURNF (-ARG:1)*6
	CASE 161
		SIF ARG:1
			RETURNF 5
	CASE 162
		SIF ARG:1
			RETURNF 10
	CASE 190
		SIF ARG:1
			RETURNF 5
	CASE 192
		SIF ARG:1
			RETURNF 15
	CASE 193
		SIF ARG:1
			RETURNF 30
	CASE 194
		SIF ARG:1
			RETURNF 20
	CASE 100
		SELECTCASE ARG:1
			CASE 0
				RETURNF 0
			CASE 1
				RETURNF 3
			CASE 2
				RETURNF 10
			CASE 3
				RETURNF 3
			CASE 4
				RETURNF 30
		ENDSELECT
	CASE 227
		SIF ARG:1
			RETURNF 20
	CASE 228, 229, 231
		SIF ARG:1
			RETURNF 10
	CASE 234
		SELECTCASE ARG:1
			CASE 0
				RETURNF -30
			CASE 1
				RETURNF -20
			CASE 2
				;classical
				RETURNF -15
			CASE 3
				;early medieval
				RETURNF -10
			CASE 4
				;late medieval
				RETURNF -5
			CASE 5
				;rennisance
				RETURNF 0
			CASE 6
				;industrial
				RETURNF 1
			CASE 7
				;machine
				RETURNF 3
			CASE 8
				RETURNF 5
			CASE 9
				;spacer
				RETURNF 8
			CASE 10
				;ultra
				RETURNF 15
			CASE 11
				RETURNF 30
		ENDSELECT
	CASE 235
		SELECTCASE ARG:1
			CASE -1
				RETURNF -20
			CASE 0
				RETURNF -10
			CASE 1
				RETURNF -8
			CASE 2
				;advanced
				RETURNF -5
			CASE 3
				;teacher
				RETURNF -3
			CASE 4
				;sage
				RETURNF 0
			CASE 5
				;forbidden
				RETURNF 20
		ENDSELECT
	CASE 244
