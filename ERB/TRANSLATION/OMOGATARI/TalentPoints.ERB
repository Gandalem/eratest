    CASE -5
        RETURNF -30
    CASE -4
        RETURNF -20
    CASE -3
        RETURNF -15
    CASE -2
        RETURNF -10
    CASE -1
        RETURNF -5
    CASE 0
        RETURNF 0
    CASE 1
        RETURNF 3
    CASE 2
