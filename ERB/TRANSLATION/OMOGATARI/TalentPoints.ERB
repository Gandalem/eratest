@CalcTalentPointsUsed(ARG)
#FUNCTION
#DIM DYNAMIC CTPU
VARSET CTPU

;crippleeffects does the same thing now
; CALLF ReinitAllCharaCapacity(ARG)

IF IS_HERM(ARG)
    CTPU += 10
ELSEIF HAS_PENIS(ARG)
    CTPU += 5
ENDIF

CTPU += ((MAXBASE:ARG:0-2000)/10)
CTPU += ((MAXBASE:ARG:1-2000)/15)
SIF HAS_PENIS(ARG)
CTPU += ((MAXBASE:ARG:6-1500)/10)

;Endurance
CTPU += ((PeeHold:ARG:0)*5)
CTPU += ((PooHold:ARG:0)*5)
CTPU += ((OrgasmDeny:ARG:0)*5)
CTPU += ((AlcoholAddict:ARG:0)*5)
CTPU += (-(DrugAddict:ARG:0)*5)
CTPU += (-(CharaTrauma:ARG:0)*10)

;Capacity
CTPU += ((CapacityStats:ARG:0-100))
CTPU += ((CapacityStats:ARG:1-100)/2)
CTPU += ((CapacityStats:ARG:2-100)/2)
CTPU += ((CapacityStats:ARG:3-100)/2)
CTPU += ((CapacityStats:ARG:4-100)/2)
CTPU += ((CapacityStats:ARG:5-100)/2)
CTPU += ((CapacityStats:ARG:6-100)/2)
CTPU += ((CapacityStats:ARG:7-100)/2)
CTPU += ((CapacityStats:ARG:8-100)/2)
CTPU += ((CapacityStats:ARG:9-100)/2)


; ;Skill
; ;20 per skill point
; CTPU += (DT_CELL_GET("FactionUnits",ARG,"combat level",1)*35)
SELECTCASE MAXBASE:ARG:7
CASE IS <= 0
CASE IS <= 100
    CTPU += 10
CASE IS <= 200
    CTPU += 15
CASE IS <= 500
    CTPU += 20
CASE IS <= 800
    CTPU += 25
CASE IS <= 1500
    CTPU += 30
CASE IS <= 2500
    CTPU += 37
CASE IS <= 4000
    CTPU += 45
CASE IS <= 8000
    CTPU += 54
CASE IS <= 16000
    CTPU += 65
CASE IS <= 32000
    CTPU += 73
CASE IS <= 64000
    CTPU += 80
ENDSELECT

SELECTCASE MAXBASE:ARG:8
CASE IS <= 0
CASE IS <= 100
    CTPU += 15
CASE IS <= 200
    CTPU += 20
CASE IS <= 500
    CTPU += 25
CASE IS <= 800
    CTPU += 30
CASE IS <= 1500
    CTPU += 37
CASE IS <= 2500
    CTPU += 45
CASE IS <= 4000
    CTPU += 55
CASE IS <= 8000
    CTPU += 70
CASE IS <= 16000
    CTPU += 90
CASE IS <= 32000
    CTPU += 120
CASE IS <= 64000
    CTPU += 150
ENDSELECT

FOR LOCAL,0,VARSIZE("TALENT")
    CTPU += (TALENT_POINTS_PER_TALENT(LOCAL,TALENT:ARG:LOCAL))
NEXT

FOR LOCAL,0,VARSIZE("ABL")
    SELECTCASE LOCAL
    CASE 46, 47, 48, 49
        CTPU += (TALENT:ARG:LOCAL)*12
    CASE 40 TO 45, 50 TO 56, 66 TO 70
        CTPU += (ABL:ARG:LOCAL)*12
    CASEELSE
        CTPU += (ABL:ARG:LOCAL)*2
    ENDSELECT
NEXT

RETURNF CTPU

@TALENT_POINTS_DISPLAY(C_ID,CHEAT)
#DIM C_ID
#DIM CHEAT
SIF nTalentPoints == -999
    RETURN
PRINTFORM Talent Points Used: 
PRINTFORM {CalcTalentPointsUsed(C_ID)} 
IF !CHEAT
    SELECTCASE TalentPointOffset-CalcTalentPointsUsed(C_ID)
    CASE IS > 0
        SETCOLOR C_GREEN
    CASE IS < 0
        SETCOLOR C_RED
    ENDSELECT
    PRINTFORM ({TalentPointOffset-CalcTalentPointsUsed(C_ID)} left)
ENDIF
RESETCOLOR
PRINTL

@TALENT_POINTS_PER_TALENT(ARG,ARG:1)
#FUNCTION
SELECTCASE ARG
CASE 10
    SELECTCASE ARG:1
    CASE -1
        RETURNF -5
    CASE 0
        RETURNF 0
    CASE 1
        RETURNF 5
    ENDSELECT
CASE 11
    SELECTCASE ARG:1
    CASE -1
        RETURNF -5
    CASE 0
        RETURNF 0
    CASE 1
        RETURNF 5
    ENDSELECT
CASE 12
    SELECTCASE ARG:1
    CASE 0
        RETURNF 0
    CASE 1
        RETURNF 3
    ENDSELECT
CASE 20
    SIF ARG:1
    RETURNF -10
CASE 13
    RETURNF (ARG:1)*3
CASE 21
    SELECTCASE ARG:1
    CASE -1
        RETURNF 5
    ENDSELECT
CASE 24
    SELECTCASE ARG:1
    CASE -1, 1
        RETURNF 2
    ENDSELECT
CASE 25
    SIF ARG:1
    RETURNF -10
CASE 26
    SIF ARG:1
    RETURNF 5
CASE 40
    RETURNF (-ARG:1)*10
CASE 41
