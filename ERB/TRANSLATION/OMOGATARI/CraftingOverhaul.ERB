RESULTS:1 '= @"%CratExpectation%"
RESULTS:2 '= @"%CratExpectation:1%"
RESULTS:3 '= @"%CraftRequires%"
RESULTS:4 '= @"%CraftRequires:2%"
RESULT:1 = CraftRequire
RESULT:2 = CraftRequire:1
FOR LOCAL,0, VARSIZE("CratExpectation")
SIF !STRLENS(CratExpectation:LOCAL)
	CONTINUE
SIF STRLENS(CratExpectation:LOCAL) && CratExpectation:LOCAL != "research"
	CD_REQUIRE_SCORE ++
SELECTCASE CratExpectation:LOCAL
	CASE "intimacy"
		SIF MASTER == CraftRequire
			GOTO SCORE_GET
		IF ABL:CraftRequire:親密 < CraftRequire:1
			CONTINUE
		ENDIF
	CASE "quest"
		SIF MASTER == CraftRequire
			GOTO SCORE_GET
		IF CharaQuestline:CraftRequire:(CraftRequire:2):0 < CraftRequire:1
			CONTINUE
		ENDIF
	CASE "research"
		;and
		SIF CraftRequires:2 == "AND" || !STRLENS(CratExpectation:0) || !STRLENS(CratExpectation:1)
			CD_REQUIRE_SCORE ++
		;check for research
		FOR LOCAL:1,0,STRCOUNT(CraftRequires, "/")
		SIF !KNOW_RESEARCH(SPLIT_SINGLE(CraftRequires, LOCAL:1, "/"))
			GOTO SCORE_NOGET
		NEXT
	CASE "love"
		SIF MASTER == CraftRequire
			GOTO SCORE_GET
		IF !TALENT:CraftRequire:3
			CONTINUE
		ENDIF
	CASE "wife"
		SIF MASTER == CraftRequire
			GOTO SCORE_GET
		IF !TALENT:CraftRequire:225
			CONTINUE
		ENDIF
	CASE "lust"
		SIF MASTER == CraftRequire
			GOTO SCORE_GET
		IF !TALENT:CraftRequire:184
			CONTINUE
		ENDIF
	CASE "lewd"
		SIF MASTER == CraftRequire
			GOTO SCORE_GET
		IF !TALENT:CraftRequire:4
			CONTINUE
		ENDIF
	CASE "techknow"
		IF TALENT:MASTER:234 < CraftRequire:1
			CONTINUE
		ENDIF
	CASE "tsp"
		IF BASE:MASTER:TSP < CraftRequire:1
			CONTINUE
		ENDIF
	CASE "item"
		IF !ITEM:(CraftRequire:1) || ITEM:(CraftRequire:1) < CraftRequire:2
			CONTINUE
		ENDIF
ENDSELECT
$SCORE_GET
CD_SCORE ++
$SCORE_NOGET
NEXT
RETURNF CD_SCORE >= CD_REQUIRE_SCORE

@PHARMACY_LIST_NAS
#DIMS DYNAMIC ITEM_NAME
#DIM  DYNAMIC nTier
#DIM  DYNAMIC ShowHeader,2
#DIM  DYNAMIC nRankRequired
#DIMS DYNAMIC PL_ITEM_TIERS,65
#DIMS DYNAMIC PL_CACHE,100
#DIMS CONST DISP_NAME = "Items", "Bionics", "Weapons"
;unfucked jank code with a loop
;-Mr Pops Alot
;cache suff here.
VARSET PL_CACHE
VARSET PL_ITEM_TIERS
SELECTCASE globalLineSave
	CASE 0
		FOR LOCAL:0 ,0, 2000
		PL_ITEM_TIERS:(PHARMACY_RANK(LOCAL:0)) += @"{LOCAL:0}/"
		NEXT
	CASE 1
		FOR LOCAL:0 ,0, VAR_TEMP_MAX
		PL_ITEM_TIERS:(BIONIC_RANK(LOCAL:0)) += @"{LOCAL:0}/"
		NEXT
	CASE 2
		FOR LOCAL:0 ,0, 2*VAR_TEMP_MAX
		SIF !STRLENS(PrintWeaponName(,LOCAL,-1))
			CONTINUE
		SIF BLACKLISTED_WEAPON(LOCAL)
			CONTINUE
		SIF GET_INT(MASTER, "Weapon", LOCAL, "Quest Only")
			CONTINUE
		nRankRequired = WEAP_RANK_REQUIRE(LOCAL:0)
		PL_ITEM_TIERS:(nRankRequired) += @"{LOCAL:0}/"
		NEXT
ENDSELECT
FOR nTier, 1, MaxNonHLevel+1
VARSET ShowHeader
VARSET LOCAL
IF TALENT:MASTER:調合Lv >= nTier-3
	;LOCAL:1 = 999
	LOCAL:1 = 0
	SELECTCASE globalLineSave
		CASE 0
			LOCALS '= ""
		CASE 1
			LOCALS '= "Bionic"
		CASE 2
			LOCALS '= "Weapon"
	ENDSELECT
	SPLIT PL_ITEM_TIERS:nTier, "/", PL_CACHE
	FOR LOCAL:0 ,0, VARSIZE("PL_CACHE")
	LOCAL:1 = TOINT(PL_CACHE:LOCAL)
	SIF !LOCAL:1
		BREAK
	ShowHeader = 1
	SIF !ShowHeader:1
		CALL MakePharmacyHeader(nTier,@"%COND_STR(@"%LOCALS% ",STRLENS(LOCALS))% 제작")
	ShowHeader:1 = 1
	;体質変化薬は【禁断の知識】がない場合はスキップ
	IF globalLineSave == 0
		SIF PHARMA_VOLATILE(LOCAL:1) && TALENT:MASTER:SexKnow < 3
			CONTINUE
	ENDIF
	CALL PHARMACY_LIST_REVAMP_BUTTON(LOCAL:1, LOCALS, LOCAL:2)
	LOCAL:2 = RESULT
	NEXT
	SIF ShowHeader
		PRINTL
ELSE
	;SETCOLOR 0x666666
	;PRINTFORM 　　？？？？
	;RESETCOLOR
	BREAK
ENDIF
NEXT
DRAWLINE
FOR LOCAL, 0, VARSIZE("DISP_NAME")
SIF globalLineSave == LOCAL
	SETCOLOR 0x00FFFF
PRINTBUTTON DISP_NAME:LOCAL, LOCAL + 8000
PRINTFORM %" "*5%
RESETCOLOR
NEXT
PRINTL
DRAWLINE
PRINTL 　　[1000] 리턴
