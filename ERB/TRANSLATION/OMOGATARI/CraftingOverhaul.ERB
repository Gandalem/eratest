@BIONIC_RANK(ARG:0)
#FUNCTION
SELECTCASE ARG:0
	;(酒造パッチ)追加酒の調合難易度は1
	CASE 1 TO 5, 88, 89
		RETURNF 1
		;(酒造パッチ)あくまきの調合難易度は2
	CASE 6 TO 18, 122, 127
		RETURNF UniversalRank("C")
	CASE 123, 128
		RETURNF UniversalRank("B")
	CASE 19 TO 35, 120, 124, 129
		RETURNF UniversalRank("A")
	CASE 56 TO 70, 85, 86, 121, 125, 130
		RETURNF UniversalRank("S")
	CASE 37 TO 55, 126, 131
		RETURNF UniversalRank("Extra")
ENDSELECT
RETURNF 0

