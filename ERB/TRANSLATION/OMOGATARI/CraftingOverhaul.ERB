IF ARG > 1000
	baseWeapon = GET_INT(MASTER, "WeaponPreset", ARG%VAR_TEMP_MAX, "Base Weapon")
	nTechLevel = GET_INT(MASTER, "Weapon", baseWeapon, "Tech Level")
ELSE
	baseWeapon = ARG
	nTechLevel = GET_INT(MASTER, "Weapon", ARG, "Tech Level")
ENDIF
SELECTCASE nTechLevel
	CASE 0
		;none
	CASE 1
		;2 wood
		nITEMSPool:610 = 2
	CASE 2
		;2 steel and 1 wood
		nITEMSPool:680 = 2
		nITEMSPool:610 = 1
	CASE 3,4
		;4 steel and 2 wood
		nITEMSPool:680 = 4
		nITEMSPool:610 = 2
	CASE 5
		;2 steel and 2 wood, 1 component
		nITEMSPool:680 = 2
		nITEMSPool:610 = 2
		nITEMSPool:681 = 1
	CASE 6
		;4 steel and 2 wood, 1 component
		nITEMSPool:680 = 4
		nITEMSPool:610 = 2
		nITEMSPool:681 = 1
	CASE 7
		;2 wood, 2 steel, 1 component, 1 firearm part
		nITEMSPool:680 = 2
		nITEMSPool:681 = 1
		nITEMSPool:684 = 1
		nITEMSPool:680 = 2
	CASE 8
		;2 steel, 2 components, 1 firearm part
		nITEMSPool:680 = 2
		nITEMSPool:681 = 2
		nITEMSPool:684 = 1
	CASE 9
		;5 plasteel, 2 ADVANCED components, 1 firearm part
		nITEMSPool:685 = 5
		nITEMSPool:682 = 2
		nITEMSPool:684 = 1
	CASE 10
		;10 plasteel, 4 ADVANCED components, 2 firearm parts, 1 dark matter
		nITEMSPool:685 = 10
		nITEMSPool:682 = 4
		nITEMSPool:684 = 2
		nITEMSPool:639 = 1
	CASE 11
		;10 plasteel, 4 ADVANCED components, 2 firearm parts, 1 dark matter, 1 phoenix feather
		nITEMSPool:685 = 10
		nITEMSPool:682 = 4
		nITEMSPool:684 = 2
		nITEMSPool:639 = 1
		nITEMSPool:640 = 1
ENDSELECT
;raw material costs doubled for long guns and two-handed
IF GROUPMATCH(GET_STR(MASTER, "Weapon", baseWeapon, "Class"), "1H Blunt", "2H Blunt")
	CALLF WMN_REMOVE_COMPONENTS(nITEMSPool)
ELSEIF GROUPMATCH(GET_STR(MASTER, "Weapon", baseWeapon, "Class"), "1H Blade", "2H Blade")
	CALLF WMN_REMOVE_COMPONENTS(nITEMSPool)
	CALLF WMN_MULTIPLY_RAW(nITEMSPool,2)
ELSEIF GROUPMATCH(GET_STR(MASTER, "Weapon", baseWeapon, "Class"), "Choking")
	CALLF WMN_REMOVE_COMPONENTS(nITEMSPool)
ELSEIF GROUPMATCH(GET_STR(MASTER, "Weapon", baseWeapon, "Class"), "Pistol", "Automatic Pistol")
ELSEIF GROUPMATCH(GET_STR(MASTER, "Weapon", baseWeapon, "Class"), "Rifle", "Semi-Automatic Rifle", "Assault Rifle", "Bolt-Action Rifle", "Sniper Rifle", "Anti-Material Rifle") || GROUPMATCH(GET_STR(MASTER, "Weapon", ARG, "Type"), "Explosive")
	CALLF WMN_MULTIPLY_RAW(nITEMSPool,2)
ELSEIF GROUPMATCH(GET_STR(MASTER, "Weapon", baseWeapon, "Class"), "Shotgun")
	CALLF WMN_MULTIPLY_RAW(nITEMSPool,2)
ELSEIF GROUPMATCH(GET_STR(MASTER, "Weapon", baseWeapon, "Class"), "Sub-Machine Gun", "Light Machine Gun", "Medium Machine Gun", "Heavy Machine Gun")
	CALLF WMN_MULTIPLY_RAW(nITEMSPool,2)
	;two more components
	nITEMSPool:681 += 2
ELSEIF GROUPMATCH(GET_STR(MASTER, "Weapon", baseWeapon, "Type"), "Explosive")
	nITEMSPool:621 += 5
ELSEIF GROUPMATCH(GET_STR(MASTER, "Weapon", baseWeapon, "Class"), "Bow")
	CALLF WMN_REMOVE_COMPONENTS(nITEMSPool)
ELSEIF GROUPMATCH(GET_STR(MASTER, "Weapon", baseWeapon, "Type"), "Youjutsu")
	CALLF WMN_REMOVE_COMPONENTS(nITEMSPool)
	nITEMSPool:647 += 3
ENDIF
CALLF WMN_MATS_NEED_COUNT(ING,nITEMSPool)

