@PHARMACY_LIST_REVAMP_BUTTON(ARG, ARGS,STR_LEN)
#DIMS ITEM_NAME, 2
#DIM STR_LEN
#DIM R_ID
#DIM R_TEM
#DIM R_PICK
SELECTCASE ARGS
	CASE "Bionic"
		SIF GET_STR(MASTER, "Hediff", (ARG+100), "名前") == "" || GET_STR(MASTER, "Hediff", (ARG+100), "名前") == "0"
			RETURN
		ITEM_NAME = %GET_STR(MASTER, "Hediff", (ARG+100), "名前"), 32, LEFT%
		R_TEM = (ARG*10) + BionicOffset
		R_PICK = R_TEM
	CASE "Weapon"
		ITEM_NAME = %PrintWeaponName(,ARG,,1), 32, LEFT%
		R_TEM = (ARG*10) + WeaponOffset
		R_PICK = R_TEM
	CASEELSE
		ITEM_NAME = %ITEMNAME_TR(ARG), 32, LEFT%
		R_TEM = ARG * 10
		R_PICK = ARG
ENDSELECT
STR_LEN += STRLENS(ITEM_NAME)
IF STR_LEN > MAXWIDTH()-1
	PRINTL 
	STR_LEN = STRLENS(ITEM_NAME)
ENDIF
SIF LineIsEmpty()
	PRINT 　　
;一旦灰色にセット
SETCOLOR 0x666666
FOR LOCAL,1,6
R_ID = R_TEM + LOCAL
;可能なレシピがあれば白に戻す
SIF CAN_PHARMA(R_ID)
	RESETCOLOR
NEXT
PRINTBUTTON @"%ITEM_NAME%", R_PICK
RESETCOLOR
RETURN STR_LEN

@CraftingDenyReason(R_ID, nType, preConvert = 1)
#DIM  DYNAMIC R_ID
#DIMS DYNAMIC nType
#DIMS  DYNAMIC CratExpectation,2
#DIM  DYNAMIC CraftRequire, 3
#DIMS DYNAMIC CraftRequires, 3
#DIMS DYNAMIC TEMP_NAME
#DIM  DYNAMIC preConvert
#DIM  DYNAMIC CDR_RESEARCH
#DIM  DYNAMIC CDR_CANDO
VARSET RESULT
VARSET RESULTS
VARSET CratExpectation
VARSET CraftRequire
VARSET CraftRequires
CDR_CANDO = CraftingDeny(R_ID, nType, preConvert)
CratExpectation:0 '= RESULTS:1
CratExpectation:1 '= RESULTS:2
CraftRequire:0     = RESULT:1
CraftRequire:1     = RESULT:2
CraftRequires:0   '= RESULTS:3
CraftRequires:2   '= RESULTS:4
;#;PRINTFORML ID: {R_ID} | EXPECT: %NAME:CraftRequire% (%CratExpectation% {CraftRequire:1}) (%CratExpectation:1% %CraftRequires%)
SIF !nSpoilerMode
	RETURN CDR_CANDO
FOR LOCAL,0,VARSIZE("CratExpectation")
IF STRLENS(CratExpectation:0) && STRLENS(CratExpectation:1) && LOCAL == 1
	IF CraftRequires:2 != "AND"
		SETCOLOR C_AQUA
		FONTBOLD
		PRINTFORML OR
		FONTREGULAR
		RESETCOLOR
	ELSE
		SETCOLOR C_AQUA
		FONTBOLD
		PRINTFORML AND
		FONTREGULAR
		RESETCOLOR
	ENDIF
ENDIF
SELECTCASE CratExpectation:LOCAL
	CASE "intimacy"
		IF !CDR_CANDO
			PRINTFORML 이 것을 제작하기 위해 %NAME:CraftRequire%과 친밀도를 얻으세요 {CraftRequire:1}.
		ENDIF
	CASE "quest"
		IF !CDR_CANDO
			TRYCALLFORMF 固有依頼{CraftRequire}(CraftRequire:1+100,"依頼名",@"TestVar{CraftRequire:1+100}")
			TEMP_NAME = %TEMP_GET("GET_ID",@"TestVar{CraftRequire:1+100}")%
			LOCALS = %REQUEST_NAMES_TR(TEMP_RE_STR(@"TestVar{CraftRequire:1+100}"))%
			PRINTFORML 이것을 제작하려면 %LOCALS% (%NAME:CraftRequire%의 %ORDINAL(CraftRequire:1)%) 퀘스트를 깨야 한다.
		ENDIF
	CASE "love"
		IF !CDR_CANDO
			PRINTFORML 이 것을 제작하려면 %NAME:CraftRequire%이 당신에게 연모하게 만들어라
		ENDIF
	CASE "techknow"
		CALL TechCheck(MASTER,CraftRequire:1)
	CASE "research"
		IF !CDR_CANDO
			PRINTFORML 모든 필수 연구가 완료되지 않았다! 다음 연구를 완료하거나 이미 이 연구들을 완료한 세력에 가라!
			PRINTFORML 필요한 연구: 
			;check for research
			FOR LOCAL:1,0,STRCOUNT(CraftRequires, "/")
			VARSET RESULT
			LOCALS '= SPLIT_SINGLE(CraftRequires,LOCAL:1,"/")
			DT_SELECT "ResearchProject", @"defName = '%LOCALS%'"
			CDR_RESEARCH = RESULT:1
			SETCOLOR TechLevelColor(TechLevelStrToInt(DT_CELL_GETS("ResearchProject", CDR_RESEARCH, "techLevel", 1)))
			SIF KNOW_RESEARCH(LOCALS)
				SETCOLOR C_GRAY
			PRINTFORM %DT_CELL_GETS("ResearchProject", CDR_RESEARCH, "label", 1)%
			IF KNOW_RESEARCH(LOCALS)
				PRINTFORM  (완료됨)
			ENDIF
			RESETCOLOR
			PRINTL
			NEXT
		ENDIF
	CASE "tsp"
		IF !CDR_CANDO
			PRINTFORML 충분한 TSP가 없다. 이 아이템을 제작하려면 최소 {CraftRequire:1}개 이상의 최대 TSP를 가져야 한다.
		ENDIF
	CASE "item"
		IF !CDR_CANDO
			PRINTFORML 이 것을 제작하려면 %ARTICLE(ITEMNAME_TR(CraftRequire:1))%가 필요하다.
		ENDIF
ENDSELECT
NEXT
RETURN CDR_CANDO
