@WMN_MATS_NEED_COUNT(ING,nITEMSPool)
#FUNCTION
#DIM REF ING
#DIM REF nITEMSPool
#DIM DYNAMIC WMN_COUNT
VARSET WMN_COUNT
FOR LOCAL,0,VARSIZE("nITEMSPool")
IF nITEMSPool:LOCAL
	FOR LOCAL:1,0,nITEMSPool:LOCAL
	ING:WMN_COUNT = LOCAL
	WMN_COUNT++
	NEXT
ENDIF
NEXT

@WMN_REMOVE_COMPONENTS(nITEMSPool)
#FUNCTION
#DIM REF nITEMSPool
;no components or firearm parts
nITEMSPool:681 = 0
nITEMSPool:684 = 0
nITEMSPool:682 = 0

@WMN_MULTIPLY_RAW(nITEMSPool, nMult = 2)
#FUNCTION
#DIM REF nITEMSPool
#DIM nMult
;multiply raw material cost
nITEMSPool:680 *= nMult
nITEMSPool:685 *= nMult
nITEMSPool:610 *= nMult

