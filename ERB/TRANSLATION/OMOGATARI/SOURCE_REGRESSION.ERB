; Modular ERB: OMOGATARI/SOURCE_REGRESSION.ERB

@SOURCE_REGRESSION(ARG)
VARSET LOCAL
LOCAL = SOURCE:ARG:Regression
SIF WITH_MOB()
	TIMES LOCAL, 0.70
SIF TALENT:ARG:動物耳 && !TCVAR:ARG:発情
	TIMES LOCAL, 0.80
IF TALENT:ARG:付喪神
	LOCAL:1 = MIN(100, 80 + EXP:MASTER:道具使用経験 / 100)
	LOCAL = LOCAL * LOCAL:1 / 100
ENDIF
IF TALENT:ARG:行きずり == 1
	TIMES LOCAL, 1.50
	SIF CFLAG:ARG:体目当て
		TIMES LOCAL, 2.00
ENDIF
;欲望を見る
LOCAL = ABL補正(LOCAL,ABL:ARG:欲望,2)
CUP:ARG:Regression += LOCAL
