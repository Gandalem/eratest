; Modular ERB: OMOGATARI/CHARA/165 Unzan/Chara_data_158_Uzan.ERB

@CHARAMOVE_DATA_165(ARG, ARG:2)
LOCAL = 165
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
		RESULT:1 = [[一輪]]
		;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
		;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;命蓮寺メンバーの私室はあんまり入らない
			CASE P113ナズーリン私室, P114ムラサ私室, P115星私室, P117ぬえ私室, P118白蓮私室, P109女苑私室, P136響子私室
				RETURN -5
				;離れ、マミゾウの棲家には入らない,神霊廟内部は行かない
			CASE P119離れ, P137マミゾウの棲家, P125屠自古私室 TO P134蔵, P138鐘楼, P139邪仙楼
				RETURN -100
				;居間に行きやすい
			CASE P108居間
				RETURN 5
		ENDSELECT
		;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE お地蔵通り, 枝垂れ柳の下, 命蓮寺境内, 命蓮寺方丈, 墓地
				RETURN 1
			CASE 広場, 商家町
				RETURN 1
			CASE 天界
				RETURN 1
		ENDSELECT
		;引力設定
	CASE 8
		;白蓮が本堂にいる時はやってくる
		SIF CFLAG:[[白蓮]]:現在位置 == P103本堂 && !CFLAG:[[白蓮]]:うふふ && SHIRAHU([[白蓮]])
			TCVAR:LOCAL:引力点 = P103本堂
ENDSELECT

@EXIST_キャラデータ165
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ165(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "呼び名"
		CALLF MAKE_STR(V_NAME, "Unzan")
		;料理関連
	CASE "料理：好きな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：嫌いな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：助手効果"
		CALLF MAKE_STR(V_NAME, "/")
		;贈り物関連
	CASE "感性：好き"
		CALLF MAKE_STR(V_NAME, "/" * 5)
	CASE "感性：嫌い"
		CALLF MAKE_STR(V_NAME, "/" * 10)
ENDSELECT
