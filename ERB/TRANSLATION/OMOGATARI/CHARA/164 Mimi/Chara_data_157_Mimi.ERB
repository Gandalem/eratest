@CHARAMOVE_DATA_164(ARG, ARG:2)
LOCAL = 164
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;神社のよくいるところ
			CASE P2境内, P10縁側
				RETURN 5
			;よく居る
			CASE P502香霖堂, P507キノコ群生地
				RETURN 5
			;引きこもらない
			CASE P512魔理沙宅・寝室
				RETURN -10
			;アリス以外の私室には入らない
			CASE P522人形の館・神綺の部屋, P523人形の館・夢子の部屋, P526人形の館・風呂, P531人形の館・空き部屋
				RETURN -100
			CASE P535エレン宅・寝室, P537エレン宅・風呂, P541朱鷺子の棲み処, P542リグルの棲み処, P543ルーミアの棲み処, P544成美の小屋
				RETURN -100
			;addition custom code 図書館
			CASE P310図書館
				RETURN 10
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜並木の鳥居, 神社境内, 神社縁側, 夢幻遺跡
				RETURN 1
			CASE 広場, 商家町, 呑屋小道, 長屋街
				RETURN 1
			CASE 霧の湖, 正門, 広間, 食堂, 大図書館, 地下室
				RETURN 1
			CASE 竹林入り口, 迷いの小道, 斜角の竹林, 永遠亭, 夢幻館
				RETURN 1
			CASE 森の入り口, 香霖堂, 古木の大樹, 霧雨魔法店, 人形の洋館, 再思の道, 無縁塚
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ164
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ164(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "呼び名"
	CALLF MAKE_STR(V_NAME, "Mimi")
CASE "固有下着透ける(前)"
	CALLF MAKE_INT(V_NAME, 0)
CASE "固有下着透ける(後)"
	CALLF MAKE_INT(V_NAME, 0)
CASE "固有下着生地厚さ"
	CALLF MAKE_INT(V_NAME, 3)
ENDSELECT

;-------------------------------------------------
;固有料理設定
;DISH_NAME          料理名
;RESULTS            料理の種類（軽食/主食/デザート）
;CALL 材料設定("")  材料の指定。"汎用"を入れると自動で汎用食材になる
;DISH_TASTE         味の設定
;DISH_COMMENT       （任意）一行コメント
;DISH_TIME          （任意）調理にかかる時間
;DISH_MAXLIMIT      （任意）料理の持続時間
;-------------------------------------------------
@SPECIAL_MENU_164
DISH_NAME = Rocket Fuel
RESULTS = デザート
CALL 材料設定("汎用")
DISH_TASTE = "ドリンク"
DISH_COMMENT '= @"Fuel made for missiles and jet fighters, diluted to the point it's safe for Youkai consumption." 
RETURN 1
