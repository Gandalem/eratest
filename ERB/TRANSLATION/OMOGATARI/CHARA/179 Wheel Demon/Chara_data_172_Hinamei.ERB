@CHARAMOVE_DATA_179(ARG, ARG:2)
LOCAL = 179
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;魔理沙家,アリス家,エレン家,妖怪の棲み処
			CASE P510霧雨魔法店 TO P515魔理沙宅・倉庫, P521人形の館・アリスの部屋 TO P531人形の館・空き部屋
				RETURN -100
			CASE P535エレン宅・寝室 TO P537エレン宅・風呂, P541朱鷺子の棲み処, P543ルーミアの棲み処, P544成美の小屋
				RETURN -100
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 竹林入り口, 迷いの小道, 斜角の竹林, 兎の洞穴, 無名の丘, 太陽の畑
				RETURN 1
			CASE 森の入り口, 古木の大樹, 再思の道, 無縁塚
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ179
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ179(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "呼び名"
	CALLF MAKE_STR(V_NAME, "Hinamei")
;こっから衣装設定
CASE "今日のパジャマ"
	CALLF MAKE_STR(V_NAME, "パジャマ（ワンピース）セット")

CASE "普段着：靴"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴", "靴"))
CASE "普段着：靴下"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "靴下"))
CASE "普段着：スカート"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("スカート", "スカート"))
CASE "普段着：上半身上着２"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("上半身上着２", "ブラウス"))
CASE "普段着：その他１"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("その他１", "リボン"))

CASE "固有下着形容詞"
	CALLF MAKE_STR(V_NAME, "organic")
CASE "固有下半身下着名"
	CALLF MAKE_STR(V_NAME, "leafy panties")
CASE "固有上半身下着"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身下着名"
	CALLF MAKE_STR(V_NAME, "leafy bra")
CASE "固有下着着用条件"
	SIF !RAND:(3 - (2 * 勝負下着判定([[Hinamei]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有下着透ける(前)"
	CALLF MAKE_INT(V_NAME, 0)
CASE "固有下着透ける(後)"
	CALLF MAKE_INT(V_NAME, 0)
CASE "固有下着生地厚さ"
	CALLF MAKE_INT(V_NAME, 3)

;料理関連
CASE "料理：好きな味"
	CALLF MAKE_STR(V_NAME, "/")
CASE "料理：嫌いな味"
	CALLF MAKE_STR(V_NAME, "/")
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "/")
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "/")
ENDSELECT

;-------------------------------------------------
;固有料理設定
;DISH_NAME          料理名
;RESULTS            料理の種類（軽食/主食/デザート）
;CALL 材料設定("")  材料の指定。"汎用"を入れると自動で汎用食材になる
;DISH_TASTE         味の設定
;DISH_COMMENT       （任意）一行コメント
;DISH_TIME          （任意）調理にかかる時間
;DISH_MAXLIMIT      （任意）料理の持続時間
;-------------------------------------------------
@SPECIAL_MENU_179
DISH_NAME = Holy Bread
RESULTS = デザート
CALL 材料設定("汎用")
DISH_TASTE = もちもち
DISH_COMMENT '= @"A light rice cracker, often symbolized as the \"Body of Christ\"." 
RETURN 1
