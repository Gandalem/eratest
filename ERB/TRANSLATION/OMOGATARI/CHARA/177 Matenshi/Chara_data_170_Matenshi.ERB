@CHARAMOVE_DATA_177(ARG, ARG:2)
LOCAL = 177
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;他所の家には行かない
			CASE P807椛宅, P808文宅, P809はたて宅, P851久侘歌の小屋, P852駒草の小屋, P853魅須丸の小屋, P854龍宅, P855虹龍洞, P856百々世の住処
				RETURN -100
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜並木の鳥居, 神社境内, 神社縁側
				RETURN 1
			CASE 広場, 商家町, 呑屋小道, 長屋街
				RETURN 1
			CASE 麓の樹海, 玄武の沢, 大蝦蟇の池
				RETURN 1
			CASE 九天の滝, 絶景の丘, 山の湖, 守矢神社境内, 天界
				RETURN 1
		ENDSELECT
	;引力設定
	CASE 8
ENDSELECT

@EXIST_キャラデータ177
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ177(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "呼び名"
	CALLF MAKE_STR(V_NAME, "Matenshi")
;こっから衣装設定
CASE "今日のパジャマ"
	CALLF MAKE_STR(V_NAME, "パジャマ（ワンピース）セット")

CASE "普段着：ワンピース"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("ワンピース", "ワンピース"))
CASE "普段着：アクセサリ"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("アクセサリ", "袖"))
CASE "普段着：靴"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴", "靴"))
CASE "普段着：靴下"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "靴下"))	

CASE "固有下着形容詞"
	CALLF MAKE_STR(V_NAME, "barly present")
CASE "固有下半身下着名"
	CALLF MAKE_STR(V_NAME, "holy panties")
CASE "固有上半身下着"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身下着名"
	CALLF MAKE_STR(V_NAME, "holy bra")
CASE "固有下着着用条件"
	SIF !RAND:(3 - (2 * 勝負下着判定([[Matenshi]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有下着透ける(前)"
	CALLF MAKE_INT(V_NAME, 0)
CASE "固有下着透ける(後)"
	CALLF MAKE_INT(V_NAME, 0)
CASE "固有下着生地厚さ"
	CALLF MAKE_INT(V_NAME, 3)

;料理関連
CASE "料理：好きな味"
	CALLF MAKE_STR(V_NAME, "/")
CASE "料理：嫌いな味"
	CALLF MAKE_STR(V_NAME, "/")
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "天界風/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "/")
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "/")
ENDSELECT