; Modular ERB: OMOGATARI/CHARA/176 Hikariko/Chara_data_169_Hikariko.ERB

@CHARAMOVE_DATA_176(ARG, ARG:2)
LOCAL = 176
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
		;たまに連動
		;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
		;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;永遠亭の奥には行かない
			CASE P405調剤室, P407廊下 TO P430地下室
				RETURN -100
				;他人の家には入らない
			CASE P432影狼の家, P437メディスンの家, P439ラルバの家, P443ミスティアの家, P445妹紅の家
				RETURN -100
				;ダイニング,リビング,自室によく居る
			CASE P453ダイニング, P461リビング, P457夢月私室
				RETURN 5
		ENDSELECT
		;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 竹林入り口, 迷いの小道, 斜角の竹林, 無名の丘, 太陽の畑, 夢幻館
				RETURN 1
			CASE 森の入り口, 古木の大樹, 人形の洋館, 再思の道, 無縁塚
				RETURN 1
			CASE 広場, 商家町, 呑屋小道
				RETURN 1
		ENDSELECT
		;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ176
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ176(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "呼び名"
		CALLF MAKE_STR(V_NAME, "Hikariko")
		;こっから衣装設定
	CASE "今日のパジャマ"
		CALLF MAKE_STR(V_NAME, "パジャマ（ネグリジェ）セット")
	CASE "普段着：ワンピース"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("ワンピース", "ワンピース"))
	CASE "普段着：靴"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴", "靴"))
	CASE "普段着：靴下"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "靴下"))
	CASE "固有下着形容詞"
		CALLF MAKE_STR(V_NAME, "깜빡이는")
	CASE "固有下半身下着名"
		CALLF MAKE_STR(V_NAME, "shining scanties")
	CASE "固有上半身下着"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "固有上半身下着名"
		CALLF MAKE_STR(V_NAME, "shining bra")
	CASE "固有下着着用条件"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "固有下着透ける(前)"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "固有下着透ける(後)"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "固有下着生地厚さ"
		CALLF MAKE_INT(V_NAME, 2)
		;料理関連
	CASE "料理：好きな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：嫌いな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：助手効果"
		CALLF MAKE_STR(V_NAME, "/")
		;贈り物関連
	CASE "感性：好き"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "感性：嫌い"
		CALLF MAKE_STR(V_NAME, "/")
ENDSELECT
