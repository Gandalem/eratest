; Modular ERB: OMOGATARI/CHARA/178 Noroiko/Chara_data_171_Noroiko.ERB

@CHARAMOVE_DATA_178(ARG, ARG:2)
LOCAL = 178
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
		;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
		;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;地霊殿には行かない
			CASE P901地霊殿前 TO P930旧血の池地獄
				RETURN -100
				;酒場と鬼の溜まり場に行きやすい
			CASE P933酒場, P938鬼の溜まり場
				RETURN 5
		ENDSELECT
		;出現場所
	CASE 7
		SELECTCASE ARG:2
			;春と秋だけ
			CASE 呑屋小道
				SIF GROUPMATCH(DAY:2, 1, 3)
					RETURN 1
			CASE 麓の樹海, 玄武の沢, 大蝦蟇の池
				SIF GROUPMATCH(DAY:2, 1, 3)
					RETURN 1
			CASE 幻想風穴, 地獄の深道, 旧地獄街道
				RETURN 1
		ENDSELECT
		;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
		;夜はよく酒場
		SIF CFLAG:LOCAL:今日の運勢 % 4 == 0 && INRANGE(TIME, 1200, 1440)
			TCVAR:LOCAL:引力点 = P933酒場
ENDSELECT

@EXIST_キャラデータ178
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ178(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "呼び名"
		CALLF MAKE_STR(V_NAME, "Noroiko")
		;こっから衣装設定
	CASE "今日のパジャマ"
		CALLF MAKE_STR(V_NAME, "パジャマ（ワンピース）セット")
	CASE "普段着：ワンピース"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("ワンピース", "ワンピース"))
	CASE "普段着：アクセサリ"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("アクセサリ", "袖"))
	CASE "普段着：その他１"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("その他１", "リボン"))
	CASE "普段着：靴"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴", "靴"))
	CASE "普段着：靴下"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "靴下"))
	CASE "固有下着形容詞"
		CALLF MAKE_STR(V_NAME, "정전된")
	CASE "固有下半身下着名"
		CALLF MAKE_STR(V_NAME, "cursed panties")
	CASE "固有上半身下着"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "固有上半身下着名"
		CALLF MAKE_STR(V_NAME, "cursed bra")
	CASE "固有下着着用条件"
		SIF !RAND:(3 - (2 * 勝負下着判定([[Noroiko]])))
			CALLF MAKE_INT(V_NAME, 1)
	CASE "固有下着透ける(前)"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "固有下着透ける(後)"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "固有下着生地厚さ"
		CALLF MAKE_INT(V_NAME, 3)
		;料理関連
	CASE "料理：好きな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：嫌いな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：助手効果"
		CALLF MAKE_STR(V_NAME, "/")
		;贈り物関連
	CASE "感性：好き"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "感性：嫌い"
		CALLF MAKE_STR(V_NAME, "/")
ENDSELECT
