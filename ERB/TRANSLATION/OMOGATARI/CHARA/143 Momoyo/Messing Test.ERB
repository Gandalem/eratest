; Modular ERB: OMOGATARI/CHARA/143 Momoyo/Messing Test.ERB
;==================================================
;Overflow Messing
;ARG = Scene
;ARG:1: Circumstances (Bit)
;0 - Dual accident (+ Pee)
;1 - Diapered
;2 - Leaked
;For "Sudden" messings, only the voiding and after void stages are used.
;There's many messages based on the realization that the Touhou is about to have an accident.
;This is because there's many detailed accident descriptions and we needed calls for every circumstance.
;==================================================

@M_KOJO_EVENT_K142_112(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Realization of their inevitable accident (4 long)(part 1)
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_LONG4_REALIZE1
		$LONG4_REALIZE1
		CALL CUTSCENESPEAK_NAS(@"「크아악!!!」/「자, 계속 넣어봐.」", "発情", 142, 0)
		PRINTFORMDW %CALLNAME:142% 둘 다 감싸 안는다 %HIS_HER(142)% 팔을 배 안으로 %HIS_HER(142)% 배에, 분명히 모든 것을 해서 유지시키려고 %HIS_HER(142)% %SCAT(142)% 안에 두는 것
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Realization of their inevitable accident (4 long)(part 2)
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_LONG4_REALIZE2
		$LONG4_REALIZE2
		CALL CUTSCENESPEAK_NAS(@"「아직 갈 때가 아니야。」/「나는 아직 해낼 수 있어.」", "発情", 142, 0)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Realization of their inevitable accident (4 long)(part 3)
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_LONG4_REALIZE3
		$LONG4_REALIZE3
		PRINTFORMDW 갑자기 %CALLNAME:142%에게 경련이 일어난다. 왜냐하면 %HIS_HER(142)%의 눈이 흐려지기 시작했기 때문이다.
		CALL CUTSCENESPEAK_NAS(@"「아아악! 못하겠어! 너무 많아.」", "怒り", 142, 0)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Realization of their inevitable accident (4 long)(part 4)
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_LONG4_REALIZE4
		$LONG4_REALIZE4
		IF ABL:142:PooAddict >= 5
			CALL CUTSCENESPEAK_NAS(@"「나... 나 변기 써야 해❤」", "発情", 142, 0)
		ELSE
			CALL CUTSCENESPEAK_NAS(@"「이게 그거야! 나오고 있어!!!!」", "発情", 142, 0)
		ENDIF
		PRINTFORMDW %HIMSELF_HERSELF(142)%이 %HIS_HER(142)% 사고로 퇴직한 뒤, %CALLNAME:142%가 자세를 잡기 시작한다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Realization of their inevitable accident (3 long)(part 1)
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_LONG3_REALIZE1
		$LONG3_REALIZE1
		GOTO LONG4_REALIZE1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Realization of their inevitable accident (3 long)(part 2)
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_LONG3_REALIZE2
		$LONG3_REALIZE2
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Realization of their inevitable accident (3 long)(part 3)
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_LONG3_REALIZE3
		$LONG3_REALIZE3
		GOTO LONG4_REALIZE4
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Realization of their inevitable accident (2 long)(part 1)
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_LONG3_REALIZE1
		$LONG2_REALIZE1
		GOTO LONG4_REALIZE3
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Realization of their inevitable accident (2 long)(part 2)
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_LONG3_REALIZE2
		$LONG2_REALIZE2
		GOTO LONG4_REALIZE4
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Realization of their inevitable accident (1 long)
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_LONG1_REALIZE
		$LONG1_REALIZE
		CALL CUTSCENESPEAK_NAS(@"「크아앙!!!」/「더는 참을 수 없어!」", "発情", 142, 0)
		GOTO LONG4_REALIZE4
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Getting into position (Squatting down/standing)
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_POSITION
		SELECTCASE ACCIDENT_EV_POSITION
			CASE "standing"
			CASE "squatting"
				PRINTFORMDW %CALLNAME:142%은(는) %HIS_HER(142)%의 엉덩이를 내리고 %HIS_HER(142)%의 다리를 벌린다.
				IF ABL:142:PooAddict >= 5
					PRINTFORMDW %HE_SHE(142,1)%은(는) %HE_SHE(142)%가 미소 짓자 짧게 한숨을 내쉰다.
					CALL CUTSCENESPEAK_NAS(@"「또 나 자신을 채울 거야...」", "怒り:照れ", 142, 0)
				ELSE
					PRINTFORMDW %HE_SHE(142,1)%은(는) 얼굴이 붉어지기 시작하자 %HIS_HER(142)%가 짧게 한숨을 내쉰다.
					CALL CUTSCENESPEAK_NAS(@"「제발 이거만 빨리 끝내게 해줘...」", "怒り:照れ", 142, 0)
				ENDIF
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Voiding in undies
	;DO NOT USE WAITS
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_VOIDING
		SELECTCASE ACCIDENT_EV_POSITION
			CASE "sudden"
				IF ABL:142:PooAddict >= 5
					CALL CUTSCENESPEAK_NAS(@"「아아악! 대변을 본다❤」", "発情", 142, 0)
				ELSE
					CALL CUTSCENESPEAK_NAS(@"「아아악! 또야!」", "発情", 142, 0)
				ENDIF
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;After soiling
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == ACCIDENT_EV_STAGE_AFTER
		SELECTCASE ABL:142:PooAddict
			CASE IS >= 10
				PRINTFORMDW %CALLNAME:142%의 사고 냄새가 %HIM_HER(142)%를 넋을 잃게 만든다.
				CALL CUTSCENESPEAK_NAS(@"「정말 좋다...」", "発情", 142, 0)
				WAIT
				CALL CUTSCENESPEAK_NAS(@"「왜 나 자신을 배설하는 게 이렇게 기분 좋을까!」", "発情", 142, 0)
				WAIT
				CALL CUTSCENESPEAK_NAS(@"「이게 훨씬 기분 좋은데 왜 변기를 사용하겠어.」", "怒り:照れ", 142, 0)
				PRINTFORMDW %CALLNAME:142%이 %HIM_HER(142)% 주변에 지저분한 것을 퍼뜨리고, 그 따뜻함과 물컹거림이 %HIM_HER(142)%를 이상하게 몽롱하게 만든다.
				WAIT
			CASE IS >= 8
				PRINTFORMDW %CALLNAME:142%의 사고 냄새가 공기를 가득 채우지만 이번에는 %HE_SHE(142)%이 그것을 즐긴다.
				CALL CUTSCENESPEAK_NAS(@"「또 대변을 봤어... 기분이 좋네...」", "発情", 142, 0)
				WAIT
			CASE IS >= 5
				PRINTFORMDW %CALLNAME:142%의 사고 냄새가 공기를 가득 채우지만, %HE_SHE(142)%는 역겨워하기는커녕 비웃는다.
				CALL CUTSCENESPEAK_NAS(@"「내가 미친 건가, 아니면 이 상황을 즐기기 시작한 걸까?」/「엉망이고 지독하게 역겹지만, 정말 기분이 좋아.」", "発情", 142, 0)
				WAIT
				CALL CUTSCENESPEAK_NAS(@"「이곳에 머물러 보려고 노력할지도 몰라.」", "笑顔:照れ", 142, 0)
				WAIT
			CASE IS >= 3
				PRINTFORMDW %CALLNAME:142%의 사고 냄새가 공기를 가득 채웠지만, %HE_SHE(142)%는 예전보다 그것에 대해 덜 역겹게 느낀다.
				CALL CUTSCENESPEAK_NAS(@"「냄새는 나는데 너무... 이상해. 나 똥 싼 것 같아.」", "笑顔:照れ", 142, 0)
				PRINTFORMDW %HE_SHE([[百々世]],1)%이 주변을 더듬어 %HIS_HER([[百々世]])%의 바닥을 %PeeProtectType([[百々世]],2)% 통해 %HIS_HER([[百々世]])%의 %SHOW_BOTTOM([[百々世]],1)%를 느낀다.
				CALL CUTSCENESPEAK_NAS(@"「응. 확실히 지저분하네.」/「교환해 줄 사람을 찾아야겠어...」", "通常:照れ", 142, 0)
				WAIT
			CASE 1 TO 2
				$MomoyoShitsHerselfAgain
				PRINTFORMDW %CALLNAME:[[百々世]]%는 공기를 맡고 움츠러든다.
				CALL CUTSCENESPEAK_NAS(@"「으윽! 또 나 자신을 망쳤나 봐...」", "発情", 142, 0)
				PRINTFORMDW %HE_SHE([[百々世]],1)%이 주변을 더듬어 %HIS_HER([[百々世]])%의 바닥을 %PeeProtectType([[百々世]],2)% 통해 %HIS_HER([[百々世]])%의 %SHOW_BOTTOM([[百々世]],1)%를 느낀다.
				CALL CUTSCENESPEAK_NAS(@"「응. 확실히 바꿔야 해.」/「%nameArray:140:na_LastName%가 자유롭길 바라는데...」", "通常:照れ", 142, 0)
				WAIT
			CASE 0
				IF FIRSTTIME("MomoyoShitsHerself") && PooHold:142:2 > -5
					PRINTFORMDW 공기를 맡았지만, %CALLNAME:[[百々世]]%은(는) %HIS_HER(142)%와 %SCAT(142)%에게 마주쳤다.
					CALL CUTSCENESPEAK_NAS(@"「아아악! 너무 지독하게 냄새나...」/「그리고 정말 역겹다.」", "発情", 142, 0)
					PRINTFORMDW %HE_SHE([[百々世]],1)%이 팔을 뻗어 %HIS_HER([[百々世]])%의 최근에 가득 찬 바닥을 만진다 %PeeProtectType([[百々世]],2)%.
					IF GETBIT(ARG:1,2)
						CALL CUTSCENESPEAK_NAS(@"「어디에나 있어!」/「내 바지가 망가졌어!」", "発情", 142, 0)
						PRINTFORMDW 아래를 내려다보니, %CALLNAME:142%은 터져 나온 한 조각의 %SCAT(142)%을 보았고, 그 모습이 %HIM_HER(142)%을 진홍색으로 만들었다.
					ENDIF
					CALL CUTSCENESPEAK_NAS(@"「나는 어떻게 설명해야 할까 %nameArray:140:na_LastName% 내가 망쳤다는 걸 %PeeProtectType([[百々世]],3)% 그리고 변화가 필요하다고 설명해야 해./까마귀들은 쉽게 하는 것 같지만 다들 그렇게 하니까 그런 거야.」", "怒り", 142, 0)
					WAIT
					CALL CUTSCENESPEAK_NAS(@"「이 상황에서 당장 벗어나야 해.」", "怒り:照れ", 142, 0)
					WAIT
				ELSE
					GOTO MomoyoShitsHerselfAgain
				ENDIF
		ENDSELECT
		RETURN 1
	ENDIF
ENDIF
