LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(Add_Custom_COM_To_Number(ADD_SELECTCUSTOMCOM))
		PRINTFORMW 
		;momoyo drinks
		PRINTFORMW 「나한테 모유 수유하고 싶어? 확실해?」
		SIF CFLAG:[[百々世]]:育児人数
			PRINTFORMW 「그걸 아기한테 아껴두는 게 맞지 않아?」
		PRINTFORMW 「\@ CFLAG:[[百々世]]:育児人数 ? 게다가 나는 # I \@은 실수로 너를 물고 싶지 않다.」
		PRINTFORMDW %HES_SHES([[百々世]],1)%이 점수를 얻었다. 잠시 생각하더니 아이디어가 떠오른다.
		PRINTFORMDW 당신은 요청한다 %CALLNAME:[[百々世]]% 당의 젖꼭지를 핥으라고
		PRINTFORMDW %BREAKENG(@"모모요가 그러는 동안, 이빨이 닿을 걱정 없이 자신의 가슴을 짜 그 입안에 모유를 뿜어 넣을 수 있다.")%
		PRINTFORMW 「흥... 나쁜 생각이 아니군.」
		CALL HPH_PRINT, @"「좋아, 간다... %PRINT_MALE("Daddy", MASTER)%HPH」", "W"
		PRINTFORMDW %CALLNAME:[[百々世]]%이 그녀의 머리를 당신의 노출된 가슴 가까이에 가져가 유두 끝의 하얀 물방울을 핥는다.
		PRINTFORMDW 그리고 %HE_SHE([[百々世]])%는 %HIS_HER([[百々世]])%의 혀로 그것 주위를 맴돈다. 이미 %HIS_HER([[百々世]])%의 침 때문에 조금 저리기 시작한다.
		PRINTFORMDW 당신은 가슴을 힘껏 움켜쥐고, 약간의 우유가 %CALLNAME:[[百々世]]%의 혀 위로 뿜어져 나온다.
		PRINTFORMDW %HE_SHE([[百々世]],1)%는 그것을 다시 %HIS_HER([[百々世]])%의 입속으로 가져가 삼킨다.
		PRINTFORMW 「우와. 정말 달콤해.」
		CALL HPH_PRINT, @"「바로 당신처럼」", "W"
		PRINTFORMDW %HE_SHE([[百々世]],1)%은 다시 당신의 유두를 핥는다.
		PRINTFORMW 「더 먹어도 될까?」
		RETURN 1
	ENDIF
	;Set
	IF VAR_OR_DEFAULT("DEBUG_Target") == MASTER
		;touhou drinks
	ELSE
		;you drink
	ENDIF
ENDIF
RETURN 1
