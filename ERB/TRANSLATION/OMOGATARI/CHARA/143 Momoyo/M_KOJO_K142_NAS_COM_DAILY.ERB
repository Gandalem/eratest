;330,Convert
;==================================================

@M_KOJO_MESSAGE_CUSTOM_COM_K142_330
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_CUSTOM_COM_K142_330_1
RETURN RESULT

@M_KOJO_MESSAGE_CUSTOM_COM_K142_330_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「음... 나는 종교적인 타입은 아니야.」
		PRINTFORMW 「하지만 들어줄 수는 있을 것 같아.」
		RETURN 1
	ENDIF
	;基本セット
	;NAS: Dialogue by success
	SELECTCASE TFLAG:193
		CASE 1 ;good
			PRINTFORML 「뭐라고? 말도 안 돼.」
			PRINTFORMW 「몰랐어! 더 말해줘!」
			PRINTFORMDW %CALLNAME:[[百々世]]%는 당신이 %HIM_HER([[百々世]])%에게 계속 설교하는 것을 모든 말에 귀 기울이며 듣는다.
		CASE 0 ;normal
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「정말? 잘 모르겠는데, 좀 믿기 힘든 것 같아...」
					PRINTFORMW 「좀 생각해 봐야겠다.」
					PRINTFORMDW %CALLNAME:[[百々世]]% %HIS_HER([[百々世]])%는/은 미간을 찌푸리며 당신이 %HIS_HER([[百々世]])%의 다음 질문을 기다리는 것을 지켜본다.
				CASE 1
					PRINTFORMW 「음, 어쩌면... 하지만 왜 그런 거지...?」
				CASE 2
					PRINTFORMW 「모르겠어.... 증거라도 있어?」
			ENDSELECT
		CASE -1 ;bad
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「뭐라고? 말도 안 돼. 여기서 나가.」
					PRINTFORMW 「"너무 좋으면 가짜일지도 모른다," 그게 내 좌우명이다.」
				CASE 1
					PRINTFORML 「뭐라고? 그거 불공평해!」
					PRINTFORMW 「난 그런 걸 우상으로 삼지 않을 거야!」
				CASE 2
					PRINTFORMW 「하지만 왜...?」
			ENDSELECT
		CASE -2 ;awful
			PRINTFORML 「자, 내가 얼마나 바보라고 생각해?」
			PRINTFORMW 「그런 개소리를 믿을 리 없어.」
	ENDSELECT
ENDIF
RETURN 1
