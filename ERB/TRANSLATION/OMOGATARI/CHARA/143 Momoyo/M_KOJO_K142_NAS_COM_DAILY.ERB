RETURN RESULT

@M_KOJO_MESSAGE_CUSTOM_COM_K142_330_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
    ;-------------------------------------------------
    ;小分岐
    ;-------------------------------------------------
    ;初めて
    ;記入チェック
	LOCAL:1 = 1
    ;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 「Uhh... I'm not really the religious type.」
		PRINTFORMW 「But I guess I can hear you out.」
		RETURN 1
	ENDIF
	;基本セット
	;NAS: Dialogue by success
	SELECTCASE TFLAG:193
		CASE 1 ;good
			PRINTFORML 「What? No way.」
			PRINTFORMW 「I didn't know that! Tell me more!」
			PRINTFORMDW %CALLNAME:[[百々世]]% hangs on your every word as you continue preaching to %HIM_HER([[百々世]])%.
		CASE 0 ;normal
			SELECTCASE RAND:3
				CASE 0
					PRINTFORMW 「Really? I dunno, seems kinda hard to believe...」
					PRINTFORMW 「Lemme think about it a little.」
					PRINTFORMDW %CALLNAME:[[百々世]]% furrows %HIS_HER([[百々世]])% brow as you wait for %HIS_HER([[百々世]])% next question.
				CASE 1
					PRINTFORMW 「Well, maybe... but how come...?」
				CASE 2
					PRINTFORMW 「I dunno.... you got any proof?」
			ENDSELECT
		CASE -1 ;bad
			SELECTCASE RAND:3
				CASE 0
					PRINTFORML 「What? No way. Get outta here.」
					PRINTFORMW 「"If it sounds too good to be true, it probably is," that's my motto.」
				CASE 1
					PRINTFORML 「What? That ain't fair!」
					PRINTFORMW 「I'm not gonna worship something like that!」
				CASE 2
					PRINTFORMW 「But then why did...?」
			ENDSELECT

		CASE -2 ;awful
			PRINTFORML 「C'mon, how dumb do you think I am?」
			PRINTFORMW 「There's no way I'm gonna believe that crap.」
	ENDSELECT
ENDIF
RETURN 1

