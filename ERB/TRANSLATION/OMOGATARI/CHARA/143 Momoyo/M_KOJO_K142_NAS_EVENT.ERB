;==================================================
;Character Dying
;==================================================
@M_KOJO_EVENT_K142_101(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	PRINTFORMW 「Mama...」
	PRINTFORMDW %CALLNAME:[[百々世]]% lets out a hacking cough. Blood dribbles down %HIS_HER([[百々世]])% chin.
	PRINTFORMW 「I'm comin' to join ya...」
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Death by gunshot
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF 

	;-------------------------------------------------
	;Cut to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF	

	;-------------------------------------------------
	;Burned to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF	

	;-------------------------------------------------
	;Crushed to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML
		RETURN 1
	ENDIF	

	;-------------------------------------------------
	;Electrocution
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF	
ENDIF

;==================================================
;Reaction Towards Death
;==================================================
@M_KOJO_EVENT_K142_102(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Sees it firsthand
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF 
	;-------------------------------------------------
	;Reports the dead body
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2

		IF TALENT:(ARG:1):Raider
			IF FactionRank:(ARG:1):5 ;Youkai Mountain Tengu raider
				PRINTFORMW 「Goddammit...」
				PRINTFORMDW %CALLNAME:[[百々世]]% closes %CALLNAME:(ARG:1)%'s eyelids.
				PRINTFORMW 「Rest in peace, %nameArray:(ARG:1):na_LastName%. We won't let your death be in vain.」
			ELSEIF FactionRank:(ARG:1):20 ;Keiga Family raider
				PRINTFORMW 「One of %nameArray:133:na_LastName%'s %PRINT_MALE("boy", ARG:1)%s...」
				PRINTFORMDW %CALLNAME:[[百々世]]% closes %CALLNAME:(ARG:1)%'s eyelids.
				PRINTFORMW 「I'll take you back to your boss so %HE_SHE(133)% can give you a proper burial.」
			ELSEIF FactionRank:(ARG:1):21 || FactionRank:(ARG:1):22
				PRINTFORMW 「Hmph. Shoulda known \@ FactionRank:(ARG:1):21 ? %nameArray:130:na_LastName% # %nameArray:143:na_LastName%\@'s %PRINT_MALE("boy", ARG:1)%s couldn't fight worth a damn.」
			ELSE
				PRINTFORMW 「If you're weak, don't pick fights you can't win.」
				PRINTFORMDW %CALLNAME:[[百々世]]% shakes %HIS_HER([[百々世]])% head.
			ENDIF
			RETURN 1
		ENDIF

		IF AutoReviveCondition(ARG:1)

			SELECTCASE ARG:1
				CASE 61 ;Mokou
					PRINTFORMW 「Oi, oi.」
					PRINTFORMDW %CALLNAME:[[百々世]]% squats down and stares at %CALLNAME:61%'s corpse. There's an ugly smile on %HIS_HER([[百々世]])% face.
					PRINTFORMW 「Let me have a crack at %HIM_HER(ARG:1)%, too. I've got a score to settle with that %PRINT_MALE("son of a bitch:bitch", ARG:1)%...」

				CASE 118 ;Larva
					GOTO MOMOYO_LARVA_DEATH_REACTION

				CASE 138 ;Misumaru
					PRINTFORMW 「Looks like we won't have to deal with %HIM_HER(139)% for a while.」

				CASE 141 ;Chimata
					PRINTFORML 「Someone thought they killed %nameArray:(ARG:1):na_LastName%, huh?」
					PRINTFORMDW %CALLNAME:[[百々世]]% smirks.
					PRINTFORMW 「Dumbass didn't realize that you can't kill a %PRINT_MALE("god:goddess", 141)%.」
					PRINTFORML 「And when %HE_SHE(141)% comes back and tells me who did it...」
					PRINTFORMDW %HE_SHE([[百々世]],1)% cracks %HIS_HER([[百々世]])% knuckles.
					PRINTFORMW 「I'm gonna teach 'em what happens when you fuck with us.」

				CASEELSE
					PRINTFORML 「Well... shit.」
					PRINTFORMDW %CALLNAME:[[百々世]]% kneels down and picks up %CALLNAME:(ARG:1)%'s body.
					PRINTFORML 「Better take %HIM_HER(ARG:1)% somewhere safe.」
					PRINTFORMW 「Don't want some jackass multilatin' %HIS_HER(ARG:1)% corpse before %HE_SHE(ARG:1)% resurrects.」
			ENDSELECT
		ELSE
			SELECTCASE ARG:1
				CASE 10 ;Suika
					PRINTFORMW 「They didn't even take your gourd...」
					PRINTFORMDW %CALLNAME:[[百々世]]% picks it up and shakes it. It's still full.
					PRINTFORMW 「I'll bury it with you. It'd be wrong for anyone but you to have it.」
					GOTO MOMOYO_VOWS_REVENGE

				CASE 11 ;Marisa
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%?!」
					PRINTFORMDW %CALLNAME:[[百々世]]%'s grabs %HIS_HER(ARG:1)% shoulder and shakes %HIM_HER(ARG:1)%.
					PRINTFORMW 「C'mon, get up. I know you ain't dead.」
					PRINTFORMW 「You resolved all those incidents. You even beat me in Danmaku. There's no way you're just gonna die like that.」
					PRINTFORMW 「And I ain't gonna let you die before we have our rematch.」
					PRINTFORMW 「So go on, get up.」
					PRINTFORMDW %CALLNAME:[[百々世]]% shakes %HIM_HER(ARG:1)% again.
					PRINTFORMW 「Get up, dammit! This ain't funny!」
					PRINTFORMDW %CALLNAME:[[百々世]]% starts to sob.

				CASE 27 ;Wriggle
					PRINTFORMW 「%CALLNAME:[[リグル]]%...」
					PRINTFORMDW %CALLNAME:[[百々世]]% kneels down and cradle's %CALLNAME:[[リグル]]%'s body in %HIS_HER([[百々世]])% arms.
					PRINTFORMW 「How could...」
					PRINTFORMW 「Why the fuck would anyone want you dead?!」
					PRINTFORMW 「All you ever wanted was to be a hero and make people love bugs! You're the nicest %PRINT_MALE("guy", [[リグル]])% I know!」
					PRINTFORMDW %CALLNAME:[[百々世]]% starts to sob.
					PRINTFORMW 「You idiot... why didn't you run away? Why couldn't you have been a coward just this one damn time?!」

				CASE 58 ;Meiling
					PRINTFORMW 「Someone killed the gatekeeper...」
					PRINTFORMDW %CALLNAME:[[百々世]]% kneels down and stares at %CALLNAME:58%'s body.
					PRINTFORMW 「I know I shouldn't. %HE_SHE(58,1)% wasn't my enemy.」
					SIF !KnowsDeadBodies:[[百々世]]:16
						PRINTFORMW 「And besides, I don't want %HIS_HER(58)% \@ IS_MALE(16) ? master # mistress\@ goin' after me.」
					PRINTFORMW 「But %HE_SHE(58)% smells so damn good...」
					PRINTFORMW 「Damn it all!」
					PRINTFORMDW %CALLNAME:[[百々世]]% jumps to %HIS_HER([[百々世]])% feet and runs away.
					CFLAG:[[百々世]]:現在位置 = KICKOUT()

				CASE 61 ;Mokou
					CALL PRINT_STRW, @"「@ITALIC@Motherfucker.@」"
					PRINTFORMDW %CALLNAME:[[百々世]]% squats down and stares at %CALLNAME:61%'s corpse in disbelief.
					PRINTFORMW 「Not only did someone rob me of my revenge...」
					PRINTFORMW 「But they managed to kill a friggin' Hourai immortal.」
					PRINTFORMW 「And that shouldn't be possible, right?」
					PRINTFORMDW %CALLNAME:[[百々世]]% stands up.
					PRINTFORMW 「We've got a problem on our hands. Someone's runnin' around killin' people that shouldn't be able to die.」
					PRINTFORMW 「But before I spread the word...」
					PRINTFORMDW %CALLNAME:[[百々世]]% turns around and spits on %CALLNAME:61%'s corpse.
					PRINTFORMW 「That was for Mama, you worthless %PRINT_MALE("son of a bitch:bitch", ARG:1)%.」

				CASE 64 ;Yuugi
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%?! No...」
					PRINTFORMDW %CALLNAME:[[百々世]]% stares at %CALLNAME:(ARG:1)%'s body.
					PRINTFORMW 「You're the strongest damn person I know! How the hell...」
					$MOMOYO_VOWS_REVENGE
					PRINTFORMDW %CALLNAME:[[百々世]]% closes %CALLNAME:(ARG:1)%'s eyelids.
					PRINTFORMW 「Rest easy, %nameArray:(ARG:1):na_LastName%. I'm gonna avenge ya.」
					PRINTFORMW 「I swear it on my mother's grave.」

				CASE 68 ;Yuuka
					PRINTFORMW 「Someone... killed %nameArray:(ARG:1):na_LastName%?」
					PRINTFORMDW %CALLNAME:[[百々世]]% reaches out and touches %CALLNAME:(ARG:1)%'s face.
					PRINTFORMW 「But how? Nobody I know could even beat %HIM_HER(68)% in Danmaku, never mind a fight to the death...」
					SIF !KnowsDeadBodies:[[百々世]]:27
						PRINTFORMW 「And poor %CHAN_KUN([[リグル]])%'s gonna be devastated when %HE_SHE([[リグル]])% finds out %HIS_HER([[リグル]])% best friend's dead...」
					GOTO MOMOYO_VOWS_REVENGE

				CASE 69 ;Mamizou
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%... who did this to you?」
					PRINTFORMW 「Was it the tengu? I know you guys were enemies... but I never cared about that.」
					PRINTFORMW 「And neither did you. You never let politics get in the way when your drinking buddies were around.」
					PRINTFORMDW %CALLNAME:[[百々世]]% sniffles.
					PRINTFORMW 「I'm gonna find out who it was. And if it wasn't a tengu... I'm gonna avenge you. I swear it.」

				CASE 84 ;Yamame
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%?」
					PRINTFORMDW %CALLNAME:[[百々世]]%'s blood runs cold.
					PRINTFORMW 「Is %HE_SHE(ARG:1)%...?」
					PRINTFORMDW %HE_SHE([[百々世]],1)% kneels down and touches %CALLNAME:84%'s cheek. It's cold. Too cold.
					PRINTFORMW 「No...」
					GOTO MOMOYO_VOWS_REVENGE

				CASE 118 ;Larva
					$MOMOYO_LARVA_DEATH_REACTION
					PRINTFORMW 「%CALLNAME:(ARG:1)%...」
					PRINTFORMDW %CALLNAME:[[百々世]]% buries %HIS_HER([[百々世]])% face in %HIS_HER([[百々世]])% hands.
					PRINTFORMW 「Who did this to you?! What kinda sick fuck kills an innocent little fairy?!」
					PRINTFORMW 「I'm gonna find them. I swear it. And when I do...」
					CALL PRINT_STRW, @"「@ITALIC@I'm gonna eat 'em alive and screaming.@」"

				CASE 130, 143 ;Yachie, Yuuma
					PRINTFORMW 「Someone whacked %nameArray:(ARG:1):na_LastName%? %nameArray:133:na_LastName%'s gonna be \@ KnowsDeadBodies:[[百々世]]:133 ? happy... wherever %HE_SHE(133)% is. # happy.\@」
					IF ARG:1 == 130
						PRINTFORMDW %CALLNAME:[[百々世]]% starts to drool.
						PRINTFORMW 「But not as happy as me...」
					ENDIF

				CASE 133 ;Saki
					PRINTFORMW 「I guess I shoulda known it was gonna happen one of these days.」
					PRINTFORMW 「But...」
					PRINTFORMDW %CALLNAME:[[百々世]]% closes %HIS_HER([[百々世]])% eyes.
					PRINTFORMW 「God damn it, %nameArray:(ARG:1):na_LastName%! Why'd ya have to die?!」

				CASE 136 ;Takane
					PRINTFORMW 「Good riddance.」
					PRINTFORMDW %CALLNAME:[[百々世]]% sneers at %CALLNAME:136%'s corpse.
					PRINTFORMW 「%PRINT_MALE("Son of a bitch:Bitch", ARG:1)% had it comin' for tryin' to take over the Ability Card market.」

				CASE 138, 141 ;Misumaru, Chimata
					PRINTFORMW 「Someone got %nameArray:(ARG:1):na_LastName%? No way...」
					PRINTFORMDW %CALLNAME:[[百々世]]% squats down and stares at %CALLNAME:(ARG:1)%'s corpse in disbelief.
					PRINTFORMW 「%HES_SHES(ARG:1,1)% a friggin' %PRINT_MALE("god:goddess", ARG:1)%. And gods don't die even if you kill them.」
					$MOMOYO_NERVOUS
					PRINTFORMW 「I don't like this. Not one bit.」
					IF !KnowsDeadBodies:[[百々世]]:1
						PRINTFORMW 「I'm gonna tell the shrine maiden.」
					ELSEIF !KnowsDeadBodies:[[百々世]]:26
						PRINTFORMW 「I'm gonna tell %nameArray:26:na_LastName%.」
					ELSE
						PRINTFORMW 「But who'm I gonna tell? %nameArray:1:na_LastName%'s dead, %nameArray:26:na_LastName%'s dead...」
					ENDIF

				CASE 139 ;Tsukasa
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%...」
					PRINTFORMDW %CALLNAME:[[百々世]]% kneels down and scoops up %CALLNAME:139%'s body.
					PRINTFORMW 「What the hell are we gonna do now?」
					PRINTFORMW 「You always had great advice for us. Whenever I was down, you always knew just what to say...」
					PRINTFORMDW %CALLNAME:[[百々世]]% starts to sob.
					PRINTFORMW 「We need you, %nameArray:(ARG:1):na_LastName%!」

				CASE 140 ;Megumu
					PRINTFORMDW %CALLNAME:[[百々世]]% sinks to %HIS_HER([[百々世]])% knees.
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%!!!」
					PRINTFORMDW %HE_SHE([[百々世]],1)% scoops up %CALLNAME:(ARG:1)%'s body.
					PRINTFORMW 「I'm takin' you to Eientei. There's gotta be somethin' they can do!」
					PRINTFORMW 「I won't let you die, goddammit! I won't!」

				CASEELSE
					IF RELATION:TARGET:(ARG:1) < 100
						PRINTFORMW 「Hmph. Good riddance.」
					ELSEIF TALENT:(ARG:1):神霊 || TALENT:(ARG:1):幽霊 || TALENT:(ARG:1):妖精 || TALENT:(ARG:1):追加種族 == 4 || ARG:1 == 51 || ARG:1 == 92
						PRINTFORMW 「What in the hell...?」
						PRINTFORMDW %CALLNAME:[[百々世]]% touches %CALLNAME:(ARG:1)%'s body. It's deathly cold.
						PRINTFORMW 「Someone... killed %nameArray:(ARG:1):na_LastName%? But how...?」
						PRINTFORMW 「You can't kill immortals! They're... immortal!」
						GOTO MOMOYO_NERVOUS
					ELSE
						PRINTFORMW 「Well... shit.」
						PRINTFORMDW %CALLNAME:[[百々世]]% kneels down and picks up %CALLNAME:(ARG:1)%'s body.
						PRINTFORMW 「Least I can do is take %HIM_HER(ARG:1)% somewhere and give %HIM_HER(ARG:1)% a decent burial.」
					ENDIF

			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Finds X is missing
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF 	
	;-------------------------------------------------
	;Reports to Nazrin
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF 	
ENDIF

