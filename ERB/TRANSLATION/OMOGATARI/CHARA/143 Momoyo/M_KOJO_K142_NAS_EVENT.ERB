;==================================================

@M_KOJO_EVENT_K142_101(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	PRINTFORMW 「엄마...」
	PRINTFORMDW %CALLNAME:[[百々世]]%가 기침을 한다. 피가 %HIS_HER([[百々世]])%의 턱을 타고 흘러내린다.
	PRINTFORMW 「나도 갈게...」
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Death by gunshot
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Cut to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Burned to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Crushed to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Electrocution
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
;==================================================
;Reaction Towards Death
;==================================================

@M_KOJO_EVENT_K142_102(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Sees it firsthand
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Reports the dead body
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:(ARG:1):Raider
			IF FactionRank:(ARG:1):5 ;Youkai Mountain Tengu raider
				PRINTFORMW 「제기랄...」
				PRINTFORMDW %CALLNAME:[[百々世]]%는 %CALLNAME:(ARG:1)%의 눈꺼풀을 감는다.
				PRINTFORMW 「편히 잠들어요, %nameArray:(ARG:1):na_LastName%. 당신의 죽음이 헛되지 않게 할 거예요.」
			ELSEIF FactionRank:(ARG:1):20 ;Keiga Family raider
				PRINTFORMW 「%nameArray:133:na_LastName%의 %PRINT_MALE("소년", ARG:1)%들 중 하나가...」
				PRINTFORMDW %CALLNAME:[[百々世]]%이 %CALLNAME:(ARG:1)%의 눈꺼풀을 감는다.
				PRINTFORMW 「당신을 상사에게 돌려보내 %HE_SHE(133)%이 제대로 된 장례를 치러줄 수 있게 할게요.」
			ELSEIF FactionRank:(ARG:1):21 || FactionRank:(ARG:1):22
				PRINTFORMW 「흥. 당연하지 \@ FactionRank:(ARG:1):21 ? %nameArray:130:na_LastName% # %nameArray:143:na_LastName% \@의 %PRINT_MALE("소년", ARG:1)%들은 제대로 싸울 수 없었어.」
			ELSE
				PRINTFORMW 「약하면, 이길 수 없는 싸움은 걸지 마라.」
				PRINTFORMDW %CALLNAME:[[百々世]]%는 %HIS_HER([[百々世]])%의 고개를 흔든다.
			ENDIF
			RETURN 1
		ENDIF
		IF AutoReviveCondition(ARG:1)
			SELECTCASE ARG:1
				CASE 61 ;Mokou
					PRINTFORMW 「어이, 어이.」
					PRINTFORMDW %CALLNAME:[[百々世]]%은/는 %CALLNAME:61%의 시체에 주저앉아 응시한다. %HIS_HER([[百々世]])%의 얼굴에는 우스꽝스러운 미소가 떠 있다.
					PRINTFORMW 「나도 %HIM_HER(ARG:1)%에게 한 번 해보자고. 저 %PRINT_MALE("개자식:개년", ARG:1)%한테는 할 말이 있으니까...」
				CASE 118 ;Larva
					GOTO MOMOYO_LARVA_DEATH_REACTION
				CASE 138 ;Misumaru
					PRINTFORMW 「%HIM_HER(139)%은/는 당분간 상대할 필요가 없을 것 같군.」
				CASE 141 ;Chimata
					PRINTFORML 「누군가 %nameArray:(ARG:1):na_LastName%을 죽였다고 생각했나, 응?」
					PRINTFORMDW %CALLNAME:[[百々世]]%는 비웃었다.
					PRINTFORMW 「멍청이는 당신이 %PRINT_MALE("남신:여신", 141)%을 죽일 수 없다는 걸 깨닫지 못했다.」
					PRINTFORML 「그리고 %HE_SHE(141)%가 돌아와 나에게 누가 그랬는지 말해준다면...」
					PRINTFORMDW %HE_SHE([[百々世]],1)%는 손가락 마디를 꺾는다, %HIS_HER([[百々世]])%.
					PRINTFORMW 「우리를 건드리면 무슨 일이 생기는지 가르쳐 주겠어.」
				CASEELSE
					PRINTFORML 「음... 망했다.」
					PRINTFORMDW %CALLNAME:[[百々世]]%는 무릎을 꿇고 %CALLNAME:(ARG:1)%의 시신을 줍는다.
					PRINTFORML 「%HIM_HER(ARG:1)%를 안전한 곳으로 옮겨야겠어.」
					PRINTFORMW 「%HE_SHE(ARG:1)%가 부활하기 전에 어떤 바보 같은 라틴계 %HIS_HER(ARG:1)%의 시신을 보고 싶지 않아.」
			ENDSELECT
		ELSE
			SELECTCASE ARG:1
				CASE 10 ;Suika
					PRINTFORMW 「그들은 네 호박조차 가져가지 않았어...」
					PRINTFORMDW %CALLNAME:[[百々世]]%가 그것을 집어 흔든다. 여전히 가득 차 있다.
					PRINTFORMW 「너와 함께 묻어 줄게. 너 말고 다른 누군가가 그걸 가지는 건 잘못이야.」
					GOTO MOMOYO_VOWS_REVENGE
				CASE 11 ;Marisa
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%?!」
					PRINTFORMDW %CALLNAME:[[百々世]]%'s가 %HIS_HER(ARG:1)%의 어깨를 잡고 %HIM_HER(ARG:1)%을 흔든다.
					PRINTFORMW 「이리 와, 일어나. 네가 죽지 않았다는 걸 알아.」
					PRINTFORMW 「너는 그 모든 사건들을 해결했잖아. 심지어 단마쿠에서도 나를 이겼다고. 그렇게 그냥 죽을 리 없어.」
					PRINTFORMW 「그리고 우리가 재대결하기 전에 너를 죽게 둘 수는 없지.」
					PRINTFORMW 「그러니 어서, 일어나 봐.」
					PRINTFORMDW %CALLNAME:[[百々世]]%이 %HIM_HER(ARG:1)%을 다시 흔든다.
					PRINTFORMW 「일어나라고, 제발! 이건 농담이 아니야!」
					PRINTFORMDW %CALLNAME:[[百々世]]%이 울기 시작한다.
				CASE 27 ;Wriggle
					PRINTFORMW 「%CALLNAME:[[リグル]]%...」
					PRINTFORMDW %CALLNAME:[[百々世]]% 무릎을 꿇고 %CALLNAME:[[リグル]]%가 %HIS_HER([[百々世]])% 몸을 품에 안는다.
					PRINTFORMW 「어떻게...」
					PRINTFORMW 「대체 누가 너를 죽이고 싶어 하는 거야?!」
					PRINTFORMW 「네가 원했던 건 그저 영웅이 되어서 사람들이 벌레들을 사랑하게 만드는 거였잖아! 네가 내가 아는 가장 좋은 %PRINT_MALE("녀석", [[リグル]])%야!」
					PRINTFORMDW %CALLNAME:[[百々世]]% 울기 시작한다.
					PRINTFORMW 「바보야... 왜 도망치지 않았어? 딱 이번 한 번만 겁쟁이가 될 수도 있었을 텐데?!」
				CASE 58 ;Meiling
					PRINTFORMW 「누군가 문지기를 죽였다...」
					PRINTFORMDW %CALLNAME:[[百々世]]%는 무릎을 꿇고 %CALLNAME:58%의 시체를 응시한다.
					PRINTFORMW 「나는 그러면 안 된다는 걸 알고 있다. %HE_SHE(58,1)%은 나의 적이 아니었다.」
					SIF !KnowsDeadBodies:[[百々世]]:16
						PRINTFORMW 「그리고 게다가 나는 원하지 않아 %HIS_HER(58)% \@ IS_MALE(16) ? 주인님 # 마님 \@ 나를 따라가는 것.」
					PRINTFORMW 「근데 %HE_SHE(58)% 너무 지독하게 좋은 냄새가 나...」
					PRINTFORMW 「젠장!」
					PRINTFORMDW %CALLNAME:[[百々世]]%는 %HIS_HER([[百々世]])%의 발로 뛰어 도망간다.
					CFLAG:[[百々世]]:現在位置 = KICKOUT()
				CASE 61 ;Mokou
					CALL PRINT_STRW, @"「이 자식아.」"
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) 믿을 수 없다는 듯 %CALLNAME:61%의 시신을 내려다보며 몸을 숙였다.
					PRINTFORMW 「누군가 내 복수를 빼앗았을 뿐만 아니라...」
					PRINTFORMW 「빌어먹을 후라이 불멸자를 죽이는 데 성공했지.」
					PRINTFORMW 「그건 불가능해야 하는데, 그렇지 않아?」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) 일어섰다.
					PRINTFORMW 「우리는 큰 문제에 봉착했다. 죽을 수 없는 사람들을 몰래 죽이는 누군가가 돌아다니고 있다.」
					PRINTFORMW 「하지만 소문을 내기 전에...」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) 몸을 돌려 %CALLNAME:61%의 시신에 침을 뱉었다.
					PRINTFORMW 「그건 엄마를 위해서야, 이 쓸모없는 %PRINT_MALE("개자식:개년", ARG:1)%.」
				CASE 64 ;Yuugi
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%?! No...」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) %CALLNAME:(ARG:1)%의 몸을 응시한다.
					PRINTFORMW 「너는 내가 아는 가장 강한 빌어먹을 사람이군! 도대체 어떻게...」
					$MOMOYO_VOWS_REVENGE
					PRINTFORMDW %CALLNAME:[[百々世]]%는 %CALLNAME:(ARG:1)%의 눈꺼풀을 감는다.
					PRINTFORMW 「편히 쉬어라, %nameArray:(ARG:1):na_LastName%. 내가 복수해 주겠다.」
					PRINTFORMW 「내 어머니의 무덤에 맹세하건대.」
				CASE 68 ;Yuuka
					PRINTFORMW 「누군가... %nameArray:(ARG:1):na_LastName%를 죽였어?」
					PRINTFORMDW %CALLNAME:[[百々世]]%가 손을 뻗어 %CALLNAME:(ARG:1)%의 얼굴을 만진다.
					PRINTFORMW 「하지만 어떻게? 내가 아는 누구도 Danmaku에서 %HIM_HER(68)%를 이길 수 없는데, 죽음까지 가는 싸움은 말할 것도 없어...」
					SIF !KnowsDeadBodies:[[百々世]]:27
						PRINTFORMW 「그리고 가여운 %CHAN_KUN([[リグル]])%은 %HE_SHE([[リグル]])%가 %HIS_HER([[リグル]])%의 가장 친한 친구가 죽었다는 것을 알게 되었을 때 망연자실할 것이다...」
					GOTO MOMOYO_VOWS_REVENGE
				CASE 69 ;Mamizou
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%... 누가 당신에게 이랬지?」
					PRINTFORMW 「텐구였어? 너희가 적이었다는 건 알아... 하지만 난 전혀 신경 쓰지 않았어.」
					PRINTFORMW 「너도 그러지 않았잖아. 술 마시러 온 친구들 앞에서는 정치 같은 걸 방해 요소로 만들지 않던걸.」
					PRINTFORMDW %CALLNAME:[[百々世]]%는(은) 훌쩍인다.
					PRINTFORMW 「누구였는지 알아낼 거야. 그리고 만약 텐구가 아니라면... 내가 복수할 테니까. 맹세해.」
				CASE 84 ;Yamame
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%?」
					PRINTFORMDW %CALLNAME:[[百々世]]%의 피가 차갑게 식는다.
					PRINTFORMW 「Is %HE_SHE(ARG:1)%...?」
					PRINTFORMDW %HE_SHE([[百々世]],1)%가 무릎을 꿇고 %CALLNAME:84%의 뺨을 만진다. 차갑다. 너무 차갑다.
					PRINTFORMW 「싫어...」
					GOTO MOMOYO_VOWS_REVENGE
				CASE 118 ;Larva
					$MOMOYO_LARVA_DEATH_REACTION
					PRINTFORMW 「%CALLNAME:(ARG:1)%...」
					PRINTFORMDW %CALLNAME:[[百々世]]% %HIS_HER([[百々世]])%는(은) %HIS_HER([[百々世]])%의 손에 얼굴을 묻는다.
					PRINTFORMW 「누가 너한테 이랬지?! 순진한 작은 요정을 죽이는 역겨운 새끼는 뭐야?!」
					PRINTFORMW 「찾아버릴 거야. 맹세해. 그리고 내가 찾으면...」
					CALL PRINT_STRW, @"「나, 그놈들을 비명 지르면서 통째로 먹어치울 거야.」"
				CASE 130, 143 ;Yachie, Yuuma
					PRINTFORMW 「누군가 %nameArray:(ARG:1):na_LastName%을 때렸나? %nameArray:133:na_LastName%는 \@ KnowsDeadBodies:[[百々世]]:133 ? 행복할 거다... %HE_SHE(133)%가 어디에 있든. # 행복하다. \@」
					IF ARG:1 == 130
						PRINTFORMDW %CALLNAME:[[百々世]]%가 침을 흘리기 시작한다.
						PRINTFORMW 「하지만 나만큼 행복하진 않아...」
					ENDIF
				CASE 133 ;Saki
					PRINTFORMW 「어느 날은 이런 일이 일어날 거라고 생각했어야 했나 봐.」
					PRINTFORMW 「하지만...」
					PRINTFORMDW %CALLNAME:[[百々世]]%는 %HIS_HER([[百々世]])%의 눈을 감았다.
					PRINTFORMW 「젠장, %nameArray:(ARG:1):na_LastName%! 왜 죽어야 했던 거야?!」
				CASE 136 ;Takane
					PRINTFORMW 「이제 사라져라.」
					PRINTFORMDW %CALLNAME:[[百々世]]%은(는) %CALLNAME:136%의 시신을 비웃는다.
					PRINTFORMW 「%PRINT_MALE("개자식:개년", ARG:1)%가 능력 카드 시장을 차지하려 했던 것에 응당 당할 줄 알았다.」
				CASE 138, 141 ;Misumaru, Chimata
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%이 누군가에게 잡혔다고? 말도 안 돼...」
					PRINTFORMDW %CALLNAME:[[百々世]]% 웅크리고 앉아 응시한다 %CALLNAME:(ARG:1)%의식을 잃은 시신을 믿을 수 없다는 듯 응시한다.
					PRINTFORMW 「%HES_SHES(ARG:1,1)%은 빌어먹을 %PRINT_MALE("남신:여신", ARG:1)%다. 그리고 신들은 네가 죽여도 죽지 않는다.」
					$MOMOYO_NERVOUS
					PRINTFORMW 「이거 정말 싫어. 조금도 안 좋아.」
					IF !KnowsDeadBodies:[[百々世]]:1
						PRINTFORMW 「신사 계집에게 말할 거야.」
					ELSEIF !KnowsDeadBodies:[[百々世]]:26
						PRINTFORMW 「%nameArray:26:na_LastName%에게 말해주려고 해.」
					ELSE
						PRINTFORMW 「하지만 누구한테 말할 수 있겠어? %nameArray:1:na_LastName%는 죽었어, %nameArray:26:na_LastName%도 죽었어...」
					ENDIF
				CASE 139 ;Tsukasa
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%...」
					PRINTFORMDW %CALLNAME:[[百々世]]%가 무릎을 꿇고 %CALLNAME:139%'의 몸을 안았다.
					PRINTFORMW 「이제 대체 어떻게 해야 하지?」
					PRINTFORMW 「너는 언제나 우리에게 좋은 조언을 해줬어. 내가 힘들 때마다, 너는 항상 뭐라고 말해줘야 할지 알고 있었는데...」
					PRINTFORMDW %CALLNAME:[[百々世]]%가 울음을 터뜨렸다.
					PRINTFORMW 「우리는 당신이 필요해요, %nameArray:(ARG:1):na_LastName%님!」
				CASE 140 ;Megumu
					PRINTFORMDW %CALLNAME:[[百々世]]%는 자신의 %HIS_HER([[百々世]])% 무릎으로 주저앉았다.
					PRINTFORMW 「%nameArray:(ARG:1):na_LastName%!!!」
					PRINTFORMDW %HE_SHE([[百々世]],1)%는 %CALLNAME:(ARG:1)%의 몸을 집어든다.
					PRINTFORMW 「영원정로 데려갈 거야. 그들이 해줄 수 있는 게 분명 있어!」
					PRINTFORMW 「네가 죽게 놔두지 않을 거야, 빌어먹을! 안 돼!」
				CASEELSE
					IF RELATION:TARGET:(ARG:1) < 100
						PRINTFORMW 「흥. 잘 가라.」
					ELSEIF TALENT:(ARG:1):神霊 || TALENT:(ARG:1):幽霊 || TALENT:(ARG:1):妖精 || TALENT:(ARG:1):追加種族 == 4 || ARG:1 == 51 || ARG:1 == 92
						PRINTFORMW 「도대체 뭐야...?」
						PRINTFORMDW %CALLNAME:[[百々世]]%는 %CALLNAME:(ARG:1)%의 몸을 만진다. 죽음처럼 차갑다.
						PRINTFORMW 「누군가... %nameArray:(ARG:1):na_LastName%를 죽였어? 하지만 어떻게...?」
						PRINTFORMW 「불멸자를 죽일 수 없어! 그들은... 불멸이라고!」
						GOTO MOMOYO_NERVOUS
					ELSE
						PRINTFORMW 「음... 망했네.」
						PRINTFORMDW %CALLNAME:[[百々世]]%은 무릎을 꿇고 %CALLNAME:(ARG:1)%의 시신을 집는다.
						PRINTFORMW 「내가 할 수 있는 건 %HIM_HER(ARG:1)%를 어딘가에 데려가 제대로 장례를 치러 주는 것뿐이다.」
					ENDIF
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Finds X is missing
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Reports to Nazrin
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
