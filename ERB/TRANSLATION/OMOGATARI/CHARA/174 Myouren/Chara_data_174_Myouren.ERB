@CHARAMOVE_DATA_174(ARG, ARG:2)
LOCAL = 174
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;遺跡によく行く
			CASE P36夢幻遺跡前 TO P51夢幻遺跡・倉庫
				RETURN 5
			;蓮メリの部屋,広場
			CASE P232蓮子の部屋, P233メリーの部屋, P202中央広場
				RETURN 5
			;私室には行かない
			CASE P221稗田邸, P224慧音宅, P222寺子屋, P226小鈴私室, P229阿求私室
				RETURN -100
			CASE P208雷鼓の部屋, P209八橋の部屋, P210弁々の部屋
				RETURN -100
			CASE P231蛮奇の部屋, P234ユキの部屋, P235マイの部屋, P239美宵の部屋
				RETURN -100
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜並木の鳥居, 神社境内, 神社本堂, 神社縁側, 夢幻遺跡
				RETURN 1
			CASE お地蔵通り, 枝垂れ柳の下, 命蓮寺境内, 墓地, 神霊廟広場
				RETURN 1
			CASE 広場, 商家町, 呑屋小道, 長屋街
				RETURN 1
			CASE 竹林入り口, 迷いの小道, 斜角の竹林, 兎の洞穴, 無名の丘, 太陽の畑
				RETURN 1
			CASE 中有の道, 三途の川
				RETURN 1
		ENDSELECT
	;引力設定
	CASE 8
ENDSELECT

@EXIST_キャラデータ174
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ174(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "呼び名"
	CALLF MAKE_STR(V_NAME, "Myouren")
;こっから衣装設定
CASE "今日のパジャマ"
	CALLF MAKE_STR(V_NAME, "パジャマ（襦袢）セット")

CASE "普段着：外衣"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("外衣", "マント"))
CASE "普段着：靴"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴", "ロングブーツ"))
CASE "普段着：靴下"
	IF FLAG:2 > 0
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "ガーターストッキング"))
	ELSE
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "靴下"))
	ENDIF
CASE "普段着：ワンピース"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("ワンピース", "ゴスロリドレス"))

CASE "固有下着形容詞"
	CALLF MAKE_STR(V_NAME, "何度も繕った跡がある")
CASE "固有下半身下着名"
	CALLF MAKE_STR(V_NAME, "さらし布のパンツ")
CASE "固有下着着用条件"
	SIF !RAND:(1 + (2 * 勝負下着判定([[Myouren]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有下着透ける(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有下着透ける(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有下着生地厚さ"
	CALLF MAKE_INT(V_NAME, 3)

;料理関連
CASE "料理：好きな味"
	CALLF MAKE_STR(V_NAME, "米/キノコ/和食/中華/葉物/甘い/ヘルシー/淡白/質素/野趣/家庭的/とろとろ/魔界風/すっぱい/すっぱい/すっぱい/")
CASE "料理：嫌いな味"
	CALLF MAKE_STR(V_NAME, "洋食/濃厚/上品/鮮やか/しょっぱい/しょっぱい/" + "肉料理/魚料理/ジャンキー/冥界風/地獄風/化学的/" * 3)
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "魔界風/得意料理＊質素＊/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "白/秩序/美しい/シンプル/大陸風/派手/巫術/" + "光/魔法/法具/巻物/" * 3 + "魔界蝶の/魔神の/法界の/" * 5) ;addition custom code, 巻物
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "混沌/ロリータ/" + "死生/刃物/小手/" * 3 + "死神の/死の/" * 10)

;農民関連
;精進料理用
CASE "農民：説明"
	CALLF MAKE_STR(V_NAME, "大豆農家")
CASE "農民：作物"
	CALLF MAKE_STR(V_NAME, "大豆")
CASE "農民：畑の種類"
	CALLF MAKE_STR(V_NAME, "大豆畑")
CASE "農民：畑のマップ"
	CALLF MAKE_STR(V_NAME, "命蓮寺")

CASE "農民：マップID"
	CALLF MAKE_INT(V_NAME, 1)
CASE "農民：場所ID"
	CALLF MAKE_INT(V_NAME, 106)
CASE "農民：報酬"
	CALLF MAKE_INT(V_NAME, 400)
CASE "農民：金利"
	CALLF MAKE_INT(V_NAME, 2)
ENDSELECT