@CHARAMOVE_DATA_171(ARG, ARG:2)
LOCAL = 171
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;あんまり入らない
			CASE P512魔理沙宅・寝室, P522人形の館・神綺の部屋, P523人形の館・夢子の部屋
				RETURN -5
			;引きこもらない
			CASE P521人形の館・アリスの部屋
				RETURN -10
			;リビング, 研究室に行きやすい
			CASE P524人形の館・研究室, P525人形の館・リビング
				RETURN 5
			;他所の私室には入らない
			CASE P514魔理沙宅・風呂, P515魔理沙宅・倉庫, P535エレン宅・寝室, P536エレン宅・倉庫, P537エレン宅・風呂
				RETURN -100
			CASE P541朱鷺子の棲み処 TO P544成美の小屋
				RETURN -100
			;addition custom code, eientei
			CASE P404診察室, P405調剤室
				RETURN 5
			;addition custom code, kourindou
			CASE P502香霖堂
				RETURN 3
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜並木の鳥居, 神社境内, 神社縁側
				RETURN 1
			CASE 広場, 商家町, 呑屋小道
				RETURN 1
			CASE 広間, 食堂, 大図書館
				RETURN 1
			CASE 森の入り口, 香霖堂, 古木の大樹, 霧雨魔法店, 人形の洋館, 再思の道, 無縁塚
				RETURN 1
			;addition custom code, eientei
			CASE 永遠亭, 永遠亭奥ノ院
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ171
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ171(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "呼び名"
	CALLF MAKE_STR(V_NAME, "Goliath")
;こっから衣装設定
CASE "今日のパジャマ"
	CALLF MAKE_STR(V_NAME, "パジャマ（ワンピース）セット")

CASE "普段着：着物"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("着物", "着物"))
CASE "普段着：その他１"
	CALLF MAKE_INT(V_NAME, CLOTHES_ID("その他１", "リボン"))

CASE "固有下着形容詞"
	CALLF MAKE_STR(V_NAME, "razor-sharp")
CASE "固有下半身下着名"
	CALLF MAKE_STR(V_NAME, "doll panties")
CASE "固有上半身下着"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身下着名"
	CALLF MAKE_STR(V_NAME, "doll bra")
CASE "固有下着着用条件"
	SIF !RAND:(3 - (2 * 勝負下着判定([[Goliath]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有下着透ける(前)"
	CALLF MAKE_INT(V_NAME, 0)
CASE "固有下着透ける(後)"
	CALLF MAKE_INT(V_NAME, 0)
CASE "固有下着生地厚さ"
	CALLF MAKE_INT(V_NAME, 3)

;料理関連
CASE "料理：好きな味"
	CALLF MAKE_STR(V_NAME, "甘い/甘い")
CASE "料理：嫌いな味"
	CALLF MAKE_STR(V_NAME, "すっぱい/謎料理/")
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "幸運/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "高級/金/宝石/かわいい/オシャレ/ポップ/" + "黄金の/" * 3 + "ネコの/幸運の/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "奇妙/" + "安物/水/" * 3 + "イヌの/オオカミの/" * 10)
ENDSELECT