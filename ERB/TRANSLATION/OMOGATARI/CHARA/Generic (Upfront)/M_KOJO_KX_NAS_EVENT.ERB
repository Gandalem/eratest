;==================================================
;Reaction Towards Death
;ARG:1 is the dead body
;==================================================
@M_KOJO_EVENT_G3_102(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Sees it firsthand
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMDL %CALLNAME:TARGET% sees %CALLNAME:(ARG:1)% dying on the ground
		PRINTFORMW 「%CALLNAME:(ARG:1)%!」
		;todo: most of this event
		RETURN 1
	ENDIF 
	;-------------------------------------------------
	;Reports the dead body
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF KilledBy:(ARG:1):0 == TARGET
			PRINTFORMDW %CALLNAME:TARGET% kicks the now dead %CALLNAME:(ARG:1)%'s head.
			RETURN 1
		ENDIF
		PRINTFORMDL %CALLNAME:TARGET% finds %CALLNAME:(ARG:1)% laying in a slumped position
		PRINTFORMW 「Is... %HE_SHE(ARG:1)%... dead?」
		PRINTFORMDL %CALLNAME:TARGET% puts %HIS_HER(TARGET)% hand on %CALLNAME:(ARG:1)%'s body, finding out that it's cold.
		PRINTFORMDW %HE_SHE(TARGET,1)% then moves the body a bit, but %CALLNAME:(ARG:1)% doesn't seem to react.
		SELECTCASE RELATION:TARGET:(ARG:1)
		CASE IS >= 150
			PRINTFORMW 「Don't tell me this is happening!」
			PRINTFORMW 「%CALLNAME:(ARG:1)%...」
			PRINTFORMDW Tears weep from %HIS_HER(TARGET)% face as %HE_SHE(TARGET)% shakes %CALLNAME:(ARG:1)% more, trying to wake %HIM_HER(ARG:1)% up, but to no avail.
			PRINTFORMW 「Please... wake up...」
			PRINTFORMW 「No... No... Uhfuuuuuuuu～～～」
			PRINTFORMDW %CALLNAME:TARGET% starts to cry  a pool of tears as the reality of %CALLNAME:(ARG:1)%'s death sinks in
		CASE IS > 100
			PRINTFORMW 「No... No!」
			PRINTFORMW 「Don't tell me this is real...」
			PRINTFORMDW Tears weep from %HIS_HER(TARGET)% face as %HE_SHE(TARGET)% realizes that %HIS_HER(TARGET)% friend is dead.
		CASE 100
			PRINTFORMW 「No... This can't be...」
			PRINTFORMW 「%HES_SHES(ARG:1,1)% dead.」
		CASE IS < 100
			PRINTFORML 「Got what %HE_SHE(ARG:1)% deserved, didn't %HE_SHE(ARG:1)%.」
		CASE IS <= 50
			PRINTFORML 「Good riddance.」
			PRINTFORMW 「Shouldn't've messed with me.」
		ENDSELECT
		RETURN 1
	ENDIF 	
	;-------------------------------------------------
	;Finds X is missing
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「Where did %CALLNAME:(ARG:1)% go?」
		PRINTFORMW 「%HES_SHES(ARG:1,1)% been missing for a while...」
		RETURN 1
	ENDIF 	
	;-------------------------------------------------
	;Reports to Nazrin
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF 	
ENDIF

