;==================================================
;Reaction Towards Death
;ARG:1 is the dead body
;==================================================

@M_KOJO_EVENT_G3_102(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Sees it firsthand
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) %CALLNAME:(ARG:1)%이 땅 위에서 죽어가는 것을 본다.
		PRINTFORMW 「%CALLNAME:(ARG:1)%!」
		;todo: most of this event
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Reports the dead body
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF KilledBy:(ARG:1):0 == TARGET
			PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")%(는) 이제 죽은 %CALLNAME:(ARG:1)%의 머리를 찬다.
			RETURN 1
		ENDIF
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%/는 축 늘어진 자세로 쓰러져 있는 %CALLNAME:(ARG:1)%를 발견한다.
		PRINTFORMW 「... %HE_SHE(ARG:1)%은/는 죽었나?」
		PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%/는 %HIS_HER(TARGET)%의 손을 %CALLNAME:(ARG:1)%의 몸에 대고, 그것이 차갑다는 것을 알게 된다.
		PRINTFORMDW %HE_SHE(TARGET,1)%은/는 그 후 몸을 조금 움직여 보았지만, %CALLNAME:(ARG:1)%는 반응하는 것 같지 않다.
		SELECTCASE RELATION:TARGET:(ARG:1)
			CASE IS >= 150
				PRINTFORMW 「이게 일어나고 있다고 말하지 마!」
				PRINTFORMW 「%CALLNAME:(ARG:1)%...」
				PRINTFORMDW %HIS_HER(TARGET)%의 얼굴에서 눈물이 흘러내린다. %HE_SHE(TARGET)%은(는) %CALLNAME:(ARG:1)%을 더 흔들며 %HIM_HER(ARG:1)%을 깨우려 하지만, 소용이 없다.
				PRINTFORMW 「제발... 일어나줘...」
				PRINTFORMW 「안 돼... 안 돼... 우우우우웅~~」
				PRINTFORMDW %조사처리(CALLNAME:TARGET,"는")% %CALLNAME:(ARG:1)%의 죽음이라는 현실을 깨닫고 눈물을 흘리기 시작한다.
			CASE IS > 100
				PRINTFORMW 「No... No!」
				PRINTFORMW 「이게 진짜라고 말하지 마...」
				PRINTFORMDW %HIS_HER(TARGET)%의 얼굴에서 눈물이 흘러내린다. %HE_SHE(TARGET)%는 %HIS_HER(TARGET)%의 친구가 죽었다는 것을 깨닫는다.
			CASE 100
				PRINTFORMW 「아니... 그럴 리가...」
				PRINTFORMW 「%HES_SHES(ARG:1,1)% 죽었다.」
			CASE IS < 100
				PRINTFORML 「%HE_SHE(ARG:1)%이 받을 만한 걸 얻었어, 안 그래, %HE_SHE(ARG:1)%?」
			CASE IS <= 50
				PRINTFORML 「잘 가라.」
				PRINTFORMW 「나 건드리지 말았어야 했는데.」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Finds X is missing
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「%CALLNAME:(ARG:1)%는 어디로 갔지?」
		PRINTFORMW 「%HES_SHES(ARG:1,1)%가 한동안 사라져 있었어...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Reports to Nazrin
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
