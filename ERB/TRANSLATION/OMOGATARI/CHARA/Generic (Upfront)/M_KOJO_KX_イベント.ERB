LOCAL = 0
;-------------
IF LOCAL
	SELECTCASE ARG
	CASE 0
		;▼考え事,（～は考えに耽っている。）
		IF !ARG:1
			;行動中
			PRINTFORML 
		ELSE
			;完了時
			PRINTFORML 
		ENDIF
	CASE 1
		;▼遊ぶ,（～は走り回っている。）
		;※[幼稚]持ちのみ
		IF !ARG:1
			;行動中
			PRINTFORML 
		ELSE
			;完了時
			PRINTFORML 
		ENDIF
