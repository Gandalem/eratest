			SELECTCASE TFLAG:193
				CASE -1
					RESULTS = ざんね～ん
				CASE 0
					RESULTS = やったね！
				CASE 1
					RESULTS = すごーい！
				CASE 2
					RESULTS = すごい綺麗に割れた！
