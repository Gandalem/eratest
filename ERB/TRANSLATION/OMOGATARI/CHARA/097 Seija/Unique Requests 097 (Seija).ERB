				CALLF MAKE_STR(V_NAME, @"호의도 100과 Я 명성")
			CASE "依頼実行コマンド名"
				CALLF MAKE_STR(V_NAME, "Give Money")
			CASE "依頼内容"
				CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "作業"))
			CASE "依頼サブ"
			CASE "依頼期限"
				CALLF MAKE_INT(V_NAME, 14)
