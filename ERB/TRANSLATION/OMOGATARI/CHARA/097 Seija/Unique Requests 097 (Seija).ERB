@M_KOJO_IRAI_106_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「헤이, %CALLNAME:MASTER%님.」
		PRINTFORMW 「겐소쿄 대부분이 중독된 약을 알고 있나요?」
		IF ABL:MASTER:43 >= UniversalRank("B")
			PRINTFORMDW 당신은 %HIM_HER(97)%에게 그것이 술이라고 말한다.
			PRINTL
			PRINTFORMW 「빙고! 정확하게 맞췄군.」
			PRINTFORML 「그냥 쓸모 있는 바보라고 부르기엔 더 나은 별명이 생겼나 보네.」
			PRINTFORML 「이곳에 알코올 중독자가 얼마나 많은지 이미 알고 있을 테지.」 
		ELSEIF BASE:MASTER:酒気
			PRINTFORMW 「당신에게서 그 냄새가 나는군...」
		ELSE
			PRINTFORMW 「추측 없어?」
			PRINTFORMW 「음, 만찬에 갔다면 알겠지.」
			PRINTFORML 「술이야.」
		ENDIF
		PRINTFORMW 「판타지 세계의 독이다.」
		PRINTFORMW 「새로운 기술을 연구하는 대신, 그들은 바지가 젖거나 쓰러질 때까지 술에 절어있다.」
		PRINTFORMW 「그리고 나는 저 얼간이들이 쓸모 있게 되도록 노력하고 있다.」
		PRINTL
		PRINTFORML 「내가 실현할 수 있는 천재적인 아이디어를 얻었어.」
		PRINTFORML 「인간 마을로 가서 그들의 술집에 잠입해 오길 원해.」
		PRINTFORML 「안으로 들어가면 이 독을 가져가서 사케, 브랜디, 아니면 그들이 마시는 뭐든 거기에 뿌려.」
		PRINTFORML 「이 독은 효과가 다양해. 어떤 것들은 그냥 설사만 하고 똥이라도 싸겠지만...」
		PRINTFORMW 「다른 것들은 한 모금 마시자마자 날아가 버릴 거야.」
		PRINTFORML
		PRINTFORMW 「그리고 내가 침투하라고 했지, 급습하지 말라고.」
		PRINTFORMW 「술집의 찬장에 걸리면 소용없어질 거야.」
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「그녀에게 그 일에 대해 한마디 해줘야겠어...」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTDATAW
			DATAFORM 「고마워요. 당신에게 의지할 수 있어서 기뻐요.」
		ENDDATA
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「마을 술집에 가서 술을 독살해라.」
		PRINTFORML 「빠르고 교묘하게 해라. 소란 피우지 마라.」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「네 선택을 재고하고 있나요?」
		PRINTFORML 「음... 돌아갈 의향이 있다면 언제든 여기 있어요.」
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		PRINTFORML 「잘했어 %CALLNAME:MASTER%!」
		PRINTFORML 「만약 연회에 가게 된다면, 네 보상이 빛을 발하는 것을 볼 수 있을 거야.」
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「뭐 하는 짓이야! 이건 잠입 작전이었잖아!」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
