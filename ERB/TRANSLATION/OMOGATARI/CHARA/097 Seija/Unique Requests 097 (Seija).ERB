@M_KOJO_IRAI_101_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「아, %CALLNAME:MASTER%. 광고 봤죠?」
		PRINTFORML 「저를 죽이러 온 건 아니시겠죠?」
		PRINTFORML 「저는 역전혁명의 유일한 지도자입니다. 오랫동안 멤버들을 모으려고 노력했지만, 그들의 반응을 거의 얻지 못하고 있어요..」
		PRINTFORML 「혁명을 재건하려면 \\100,000이 필요합니다.」
		PRINTFORML 「그 돈이면 광고 비용이랑 우리와 혁명가들에게 쓸 괜찮은 무기를 살 수 있을 겁니다.」
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「하아... 이 혁명은 일어나지 않는 것 같군...」
			DATAFORM 「음... 날 돈을 던져줄 의향이 있다면, 난 언제나 여기 있어.」
			DATAFORM 「그 일로 그녀에게 한마디 해줘야겠어...」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTDATAW
			DATAFORM 「당신이 해줄 거야? 고마워. 죽지 않고 돈 벌러 나가기는 힘드니까.」
			DATAFORM 「고마워. 당신에게 의지할 수 있어서 기뻐.」
		ENDDATA
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「\\에 100,000엔이 필요하다며 혁명을 시작해야 한다.」
		PRINTFORML 「빨리 필요해. 빈틈없이 해.」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「네 선택을 재고하고 있나요?」
		PRINTFORML 「음... 돌아갈 의향이 있다면 언제든 여기 있어요.」
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		PRINTFORML 「고마워, 이제 정말 시작할 수 있겠군.」
		PRINTFORML 「그건 네가 이제 역사의 반란의 일원이 되었다는 뜻이기도 해.」
		PRINTFORML 「나중에 할 임무들을 줄 테니. 지금은 그냥 편히 쉬면서 남은 하루를 즐기도록 해.」
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「젠장, 사람아!? 이렇게 많이 못 줄 거라고 믿기 힘든데.」
			DATAFORM 「이 정도 요청이 너무 하찮아서 그걸 잊어버리기로 결정한 거였나?」
			DATAFORM 「필요한 돈 없이는 내 대의를 위해 아무것도 할 수 없어!」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
