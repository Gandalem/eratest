;固有依頼の設定用
;この関数は実行/成功/失敗時の
;報酬とペナルティと地の文のみを扱います
;各キャラのメッセージは別所にて
@IRAI_固有97(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
;個々の依頼名で分岐
CASE "Kickstart the Revolution"
	SELECTCASE SCENE
	CASE "依頼条件表示"
	;何か専用の表示情報を設けたい時用
	;受託済みの依頼表示で使用されます
	;
	;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
	;ここ以外の表示項目は
	;PRINTFORML 　　　　　：
	;となっているのでスペースを揃えたほうが見栄えが良いです
	
	CASE "依頼実行時"
	;このCASEに限り、RESULTが意味を持ちます
	;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
	;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
	;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
		SOURCE:歓楽 = 3000
		CALL LOST_MONEY_YEN(100000, 2)
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼成功時"
	;成功報告時の報酬など
		CharaQuestline:TARGET:0:0 ++
		;システムメッセージつき好感度変化
		;最後の引数だけ好感度が変化
		CALL CHANGE_CFLAG(2, TARGET, 100)
		;システムメッセージつき信頼度変化
		;最後の引数だけ信頼度が変化
		CALL CHANGE_CFLAG(4, TARGET, 20)
		CALL AddFame(MASTER,10,25000)
	CASE "依頼失敗時"
	;失敗報告時の処理
		CALL CHANGE_CFLAG(2, TARGET, -10)
		CALL CHANGE_CFLAG(4, TARGET, -10)
	ENDSELECT
CASE "Get me some milk"
CASE "Hi there! Would you like to sign my petition?"
CASE "No More Shrine Maidens"
CASE @"Piss on %CALLNAME:162%"
CASE "Election Day"
CASE "Poisoning the Well"
CASE "Bad Touch"
CASE "A Flame in Your Heart"
CASE "Soylent Green"
CASE @"Happy Birthday %CALLNAME:30%!"
	SELECTCASE SCENE
	CASE "依頼条件表示"
	;何か専用の表示情報を設けたい時用
	;受託済みの依頼表示で使用されます
	;
	;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
	;ここ以外の表示項目は
	;PRINTFORML 　　　　　：
	;となっているのでスペースを揃えたほうが見栄えが良いです
	
	CASE "依頼実行時"
	;このCASEに限り、RESULTが意味を持ちます
	;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
	;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
	;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
		SOURCE:97:歓楽 = 10000
		PRINTFORMW You stand back and hide in a tree while %CALLNAME:30% opens %HIS_HER(30)% present...
		PLAYSOUND "firearms/Frag Grenade.wav"
		PRINTFORMW %CALLNAME:30% is caught in a explosion big enough to blast %HIM_HER(30)% up in the air...
		PRINTFORMW The explosion also sent shrapnel everywhere, completely annihilating %HIS_HER(30)% body...
		PRINTFORMW %CALLNAME:30% is left looking like a thousand arrows had cut through %HIS_HER(30)%...
        CALL SET_HISTORY_DEATH(30,97,"eirin_chemicals")
        CALLF BroadDamage(30,"fullbody",1000,6,97,"improvised explosive")
        CALLF BroadDamage(30,"fullbody",1500,1,97,"improvised explosive")

		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE "依頼成功時"
	;成功報告時の報酬など
		CharaQuestline:TARGET:0:0 ++
		;システムメッセージつき好感度変化
		;最後の引数だけ好感度が変化
		CALL CHANGE_CFLAG(2, TARGET, 1000)
		;システムメッセージつき信頼度変化
		;最後の引数だけ信頼度が変化
		CALL CHANGE_CFLAG(4, TARGET, 200)
		CALL AddFame(MASTER,10,25000)
	CASE "依頼失敗時"
	;失敗報告時の処理
		CALL CHANGE_CFLAG(2, TARGET, -10)
		CALL CHANGE_CFLAG(4, TARGET, -10)
	ENDSELECT
CASE "The Apocalypse"
ENDSELECT

;give seija moneies
@M_KOJO_IRAI_101_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「Ah, %CALLNAME:MASTER%. You saw the ad, right?」
	PRINTFORML 「Not here to just kill me, right?」
	PRINTFORML 「I'm the sole leader of the Reverse Revolution. I've been trying for so long to get any members, but I'm barely getting any returns of them..」
	PRINTFORML 「I need \\100,000 to start rebuilding the revolution.」
	PRINTFORML 「That'll cover advertising fees and some decent weaponry for us and the revolutionarties.」
	RETURN 1
CASE "依頼非受託時"
	PRINTDATAL
		DATAFORM 「Sigh... I guess this revolution is never going to happen...」
		DATAFORM 「Well... If you're willing to toss me the money, I'm always here.」
		DATAFORM 「I ought to give her an earful for that...」
	ENDDATA
	RETURN 1
CASE "依頼受託時"
	PRINTDATAW
		DATAFORM 「You will? Thanks. Can't really go out and make money without getting killed.」
		DATAFORM 「Thank you. I'm glad I can rely on you.」
	ENDDATA
	RETURN 1
CASE "依頼確認時"
	PRINTFORML 「I need \\100,000 yen to start on the revolution.」
	PRINTFORML 「Need it quick too. Don't slack off.」
	RETURN 1
CASE "依頼破棄時"
	PRINTFORML 「Reconsidering your choice?」
	PRINTFORML 「Well... If you're willing to go back, I'm always here.」
	RETURN 1
CASE "依頼実行直前"
	
	RETURN 0
CASE "依頼実行直後"
	
	RETURN 0
CASE "成功報告時"
;報酬：
	PRINTFORML 「Thanks, now we can really get started.」
	PRINTFORML 「That also means you're part of the Reverse Revolution now.」
	PRINTFORML 「I'll give you tasks that'll come later on. Right now, just relax and enjoy the rest of your day.」
	RETURN 1
CASE "失敗報告時"
	PRINTDATAL
		DATAFORM 「The fuck man!? I find it hard to believe you couldn't give this much.」
		DATAFORM 「Was this request that insignificant that you decided to forget about it?」
		DATAFORM 「Without the money needed, I can't do anything for my cause!」
	ENDDATA
	RETURN 1
	;IF !RESULT
	;	PRINTFORML
CASE "依頼報告不要"
	
	RETURN 0
ENDSELECT

;poison the liquor
@M_KOJO_IRAI_106_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「Hey, %CALLNAME:MASTER%.」
	PRINTFORMW 「Do you know the drug that most of Gensokyo's addicted to?」
	IF ABL:MASTER:43 >= UniversalRank("B")
	PRINTFORMDW You tell %HIM_HER(97)% that it's alcohol.
	PRINTL
	PRINTFORMW 「Bingo! You got it right on the money.」
	PRINTFORML 「Guess I can call you more thn just a useful idiot.」
	PRINTFORML 「Bet you already know how many alcohol addicts are in this place.」 
	ELSEIF BASE:MASTER:酒気
	PRINTFORMW 「I can smell it off you...」
	ELSE
	PRINTFORMW 「No guess?」
	PRINTFORMW 「Well, if you went to a banquet you'll know.」
	PRINTFORML 「It's alcohol.」
	ENDIF
	PRINTFORMW 「The poison of the fantasy land.」
	PRINTFORMW 「Instead of researching new technology, they're drinking their asses off until they wet their pants or collapse.」
	PRINTFORMW 「And I'm here trying to make those retards start being useful.」
	PRINTL
	PRINTFORML 「I got this genius idea that you could enact.」
	PRINTFORML 「I want you to go to the human village, and infiltrate their liquor store.」
	PRINTFORML 「When you're in, take this poison, put it on the sake, brandy, or whatever the fuck they're drinking.」
	PRINTFORML 「This poison varries in effectiveness. Some will simply just get the runs and shit themselves...」
	PRINTFORMW 「Others are going to drop like flies when they take one sip.」
	PRINTFORML
	PRINTFORMW 「And remember that I said infiltrate, not raid.」
	PRINTFORMW 「If you get caught in the liquor store's cabnet then it's no good.」
	RETURN 1
CASE "依頼非受託時"
	PRINTDATAL
		DATAFORM 「I ought to give her an earful for that...」
	ENDDATA
	RETURN 1
CASE "依頼受託時"
	PRINTDATAW
		DATAFORM 「Thank you. I'm glad I can rely on you.」
	ENDDATA
	RETURN 1
CASE "依頼確認時"
	PRINTFORML 「Go to the village liquor store and poison the alcohol.」
	PRINTFORML 「Do it quick and sly too. Don't go loud.」
	RETURN 1
CASE "依頼破棄時"
	PRINTFORML 「Reconsidering your choice?」
	PRINTFORML 「Well... If you're willing to go back, I'm always here.」
	RETURN 1
CASE "依頼実行直前"
	
	RETURN 0
CASE "依頼実行直後"
	
	RETURN 0
CASE "成功報告時"
;報酬：
	PRINTFORML 「Nice job %CALLNAME:MASTER%!」
	PRINTFORML 「If you manage to find yourself at a banquet, you'll see your reward pay off.」
	RETURN 1
CASE "失敗報告時"
	PRINTDATAL
		DATAFORM 「What the fuck are you doing! This was meant to be a stealth operation!」
	ENDDATA
	RETURN 1
	;IF !RESULT
	;	PRINTFORML
CASE "依頼報告不要"
	
	RETURN 0
ENDSELECT

;==================================================
;Request 30: Hitman
;==================================================
@M_KOJO_IRAI_30_K97(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
CASE "依頼提示時"
	PRINTFORML 「Can I have a moment of your time? Make sure no one is listening.」
	PRINTFORMDL Seija motions you to go around the corner as she starts whispering on your ear.
	PRINTFORML 「...So, let's get straight to it. I want you to go and assassinate a certain someone...」
	PRINTFORML 「And I mean it, for real.」
	PRINTFORML 「None of that Danmaku bullshit, I want you to use your weapons, real firearms.」
	PRINTFORML 「Take a picture of the corpse when you're done. Hide the body as well so no one finds out.」	
	SELECTCASE ABL:MASTER:戦闘能力
		CASE 1, 2
			PRINTFORML 「...Do you even know how to do it, though? There won't be any backup, I can't go with you. You gotta understand.」
			PRINTFORML 「I won't blame you if you choose to back out now.」
		CASE 3, 4
			PRINTFORML 「Make sure you prepare some of those cheat items just in case. I'd like to see you win, not the other way around.」
		CASE IS > 4
			PRINTFORML 「Heh, though at this point they're all just pushovers for ya. Well, have fun.」
	ENDSELECT
	RETURN 1
CASE "依頼非受託時"
	
	RETURN 0
CASE "依頼受託時"
	
	RETURN 0
CASE "依頼確認時"
	
	RETURN 0
CASE "依頼破棄時"
	
	RETURN 0
CASE "依頼実行直前"
;○この依頼では討伐される側の口上です
	IF CANNOT_DANMAKU() == 1
	;屋内のとき（勝負できない）
	;【◆口上】
	;【W 屋外で挑もう…】
		PRINTFORML 「...C'mon, we'll make a mess here. If you wanna go let's do it outside.」
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 2
	;仕事中（勝負できない）
	;【◆口上】
	;【W お取り込み中だ…】
		PRINTFORML 「Nope, no can do. I'm in the middle of something.」
		PRINTFORML 「...Calling me a coward won't help your case either. Come back later.」
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 3
	;あなたが疲労中（勝負できない）
	;【◆口上】
	;【W 今は疲れている…】
		PRINTFORML 「I'm too tired for this stuff... Though I respect your decision to get a jump on me when I'm at my weakest.」
		PRINTFORML 「Unfortunately, the rules of this land prevent it from happening. Sucks, huh?」
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 4
	;口上主が疲労竜（勝負できない）
	;【◆口上】
	;【W 今挑むのはフェアじゃない…】
		PRINTFORML 「I don't think I like these odds too much. Feels like I've got no chance whatsoever.」
		RETURN 1
	ELSEIF CANNOT_DANMAKU() == 5
	;既に今日一度弾幕勝負をしている（勝負できない）
	;【◆口上】
	;【W 今日はもう挑めない…】
		PRINTFORML 「Again? Don't be a sore loser. You've had enough. Go home already.」
		RETURN 1
	ELSE
	;【◆口上】
	;【W 勝負開始！！】
	;【以降はそのまま弾幕口上が呼ばれます】
		PRINTFORML 「Assassinate? Well then!」
		PRINTFORML 「Don't cry to me when your legs have been shot off and your wetting the bed with your blood!」
		RETURN 1
	ENDIF
	;【▼そのまま下の口上へ】
CASE "依頼実行直後"
;○この依頼では討伐される側の口上です
	IF CFLAG:CLIENT_ID:依頼状況 == 2
		IF CANNOT_DANMAKU() == 0
			;負け犬
			;【▲上の口上から続き】
			;【L ［彼女］の討伐に失敗した……】
			;【W ……こうなったら後日出直すしかない】
			;【◆口上】
			IF TALENT:97:恋慕
				PRINTFORML 「...Sorry, but I won't make it easy for anyone, even for you.」
				PRINTFORML 「You'll have to try your best, %CALLNAME:MASTER%.」
			ELSE
				PRINTFORML 「Oh, so you were after me? Not today it seems!」
				PRINTFORML 「Kyahaha, later nerd!」
			ENDIF
			RETURN 1
		ELSE
			;挑めなかった場合
			;【▲上の口上から続き】
			;【◆口上】
			RETURN 0
		ENDIF
	ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
	;勝利
	;【▲上の口上から続き】
	;【W ［彼女］を懲らしめた！】
	;【◆口上】
		IF TALENT:97:恋慕
			PRINTFORML 「...Oof. So rough, %K97_DUDE()%.」
			PRINTFORML 「I'll make you... recompensate me in other ways later.」
