SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「잠깐 시간 좀 내줄 수 있겠어? 아무도 듣지 못하게 해줘.」
		PRINTFORMDL 세이가 당신에게 귀에 속삭이기 시작하며 모퉁이로 돌아가라고 손짓한다.
		PRINTFORML 「...그래서, 바로 본론으로 들어갈게. 네게 어떤 사람을 암살해 달라는 부탁이야...」
		PRINTFORML 「진심이라고 말하는 거야, 정말로.」
		PRINTFORML 「단마쿠 같은 개소리는 집어치고, 진짜 총기 같은 무기를 사용하길 바라.」
		PRINTFORML 「일을 마친 후 시체를 사진으로 찍어둬. 그리고 아무도 찾지 못하게 시신을 숨겨야 해.」	
		SELECTCASE ABL:MASTER:戦闘能力
			CASE 1, 2
				PRINTFORML 「...넌 그걸 어떻게 하는지도 모르면서? 백업도 없을 거고, 난 너랑 같이 못 가. 이해해야 해.」
				PRINTFORML 「지금 빠지기로 선택한다면 널 탓하지 않겠어.」
			CASE 3, 4
				PRINTFORML 「혹시 모르니까 그런 치트 아이템들을 좀 준비해 두는 게 좋겠어. 네가 이기는 걸 보고 싶지, 반대인 건 보고 싶지 않으니까.」
			CASE IS > 4
				PRINTFORML 「흥, 하지만 이 시점에서는 전부 너한테는 그냥 만만한 상대일 뿐이야. 뭐, 즐겁게 해.」
		ENDSELECT
		RETURN 1
	CASE "依頼非受託時"
		RETURN 0
	CASE "依頼受託時"
		RETURN 0
	CASE "依頼確認時"
		RETURN 0
	CASE "依頼破棄時"
		RETURN 0
	CASE "依頼実行直前"
		;○この依頼では討伐される側の口上です
		IF CANNOT_DANMAKU() == 1
			;屋内のとき（勝負できない）
			;【◆口上】
			;【W 屋外で挑もう…】
			PRINTFORML 「...자, 여기서 난장판 만들 거니까. 나가고 싶으면 밖에 나가서 하자.」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 2
			;仕事中（勝負できない）
			;【◆口上】
			;【W お取り込み中だ…】
			PRINTFORML 「아니, 안 돼. 지금 다른 일 중이야.」
			PRINTFORML 「...나를 비겁자라고 불러봤자 네 주장에 도움이 되진 않아. 나중에 다시 와.」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 3
			;あなたが疲労中（勝負できない）
			;【◆口上】
			;【W 今は疲れている…】
			PRINTFORML 「이 일에 너무 지쳤어... 하지만 내가 가장 약할 때 나를 공격하기로 한 너의 결정은 존중해.」
			PRINTFORML 「안타깝게도 이 땅의 규칙이 그런 일이 일어나지 못하게 막아. 짜증나, 그치?」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 4
			;口上主が疲労竜（勝負できない）
			;【◆口上】
			;【W 今挑むのはフェアじゃない…】
			PRINTFORML 「이런 확률, 별로 안 좋은 것 같아. 도저히 승산이 없는 기분이야.」
			RETURN 1
		ELSEIF CANNOT_DANMAKU() == 5
			;既に今日一度弾幕勝負をしている（勝負できない）
			;【◆口上】
			;【W 今日はもう挑めない…】
			PRINTFORML 「또? 패배를 인정 못 하는 건 그만둬. 충분히 했잖아. 이제 집에 가라.」
			RETURN 1
		ELSE
			;【◆口上】
			;【W 勝負開始！！】
			;【以降はそのまま弾幕口上が呼ばれます】
			PRINTFORML 「암살이라고? 좋다!」
			PRINTFORML 「네 다리가 잘리고 피로 침대에서 범벅이 될 때 나한테 울지 마라!」
			RETURN 1
		ENDIF
		;【▼そのまま下の口上へ】
	CASE "依頼実行直後"
		;○この依頼では討伐される側の口上です
		IF CFLAG:CLIENT_ID:依頼状況 == 2
			IF CANNOT_DANMAKU() == 0
				;負け犬
				;【▲上の口上から続き】
				;【L ［彼女］の討伐に失敗した……】
				;【W ……こうなったら後日出直すしかない】
				;【◆口上】
				IF TALENT:97:恋慕
					PRINTFORML 「...미안하지만 당신에게조차 쉽게 해주지는 않을 거예요.」
					PRINTFORML 「최선을 다해야 할 겁니다, %CALLNAME:MASTER%.」
				ELSE
					PRINTFORML 「오호, 나를 노리고 있었나? 오늘은 안 될 것 같군!」
					PRINTFORML 「캬하하, 다음에 봐, 너 같은 바보야!」
				ENDIF
				RETURN 1
			ELSE
				;挑めなかった場合
				;【▲上の口上から続き】
				;【◆口上】
				RETURN 0
			ENDIF
		ELSEIF CFLAG:CLIENT_ID:依頼状況 == 3
			;勝利
			;【▲上の口上から続き】
			;【W ［彼女］を懲らしめた！】
			;【◆口上】
			IF TALENT:97:恋慕
				PRINTFORML 「…윽. 너무 거칠었어, %K97_DUDE()%.」
				PRINTFORML 「나중에 다른 방식으로 나에게 보답하게 해 줄게.」
				PRINTFORMDL 세이가 눈을 찡긋하며 당신의 무릎이 풀리게 만든다...
			ELSE
				PRINTFORML 「아악, 젠장! 방금 저렇게 질 줄은 몰랐어!」
				PRINTFORML 「이걸 기억할 거야... 언젠가 다시 붙자, 약속해!」
			ENDIF
			RETURN 1
		ENDIF
	CASE "成功報告時"
		;報酬：賞金（時価）
		PRINTFORML 「잘했어! 당신이 최고야, %CALLNAME:MASTER%!」
		PRINTFORML 「Always knew I can count on you when push comes to shove.」
		RETURN 0
	CASE "失敗報告時"
		PRINTFORML 「뭐야, 이 자식아! 그렇게 나를 배신하다니!」
		PRINTFORML 「내 대의를 위해 그들이 죽어야 했어!」
		RETURN 0
		;CASE "依頼報告不要"
		;＜この依頼にはありません＞
		;	RETURN 0
ENDSELECT
