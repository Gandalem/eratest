#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE ARG % 1000
;ID101：カリスマ切れ
CASE 101
	SELECTCASE O_DATA
	CASE "依頼名"
		CALLF MAKE_STR(V_NAME, "Kickstart the Revolution")
	CASE "依頼内容表示"
		CALLF MAKE_STR(V_NAME, "Give Seija ￥100,000")
