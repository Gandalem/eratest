; Modular ERB: OMOGATARI/CHARA/169 Layla/Chara_data_162_Layla.ERB

@CHARAMOVE_DATA_169(ARG, ARG:2)
LOCAL = 169
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
		;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
		;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;遺跡によく行く
			CASE P36夢幻遺跡前 TO P51夢幻遺跡・倉庫
				RETURN 5
				;蓮メリの部屋,広場
			CASE P232蓮子の部屋, P233メリーの部屋, P202中央広場
				RETURN 5
				;私室には行かない
			CASE P221稗田邸, P224慧音宅, P222寺子屋, P226小鈴私室, P229阿求私室
				RETURN -100
			CASE P208雷鼓の部屋, P209八橋の部屋, P210弁々の部屋
				RETURN -100
			CASE P231蛮奇の部屋, P234ユキの部屋, P235マイの部屋, P239美宵の部屋
				RETURN -100
		ENDSELECT
		;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜並木の鳥居, 神社境内, 神社本堂, 神社縁側, 夢幻遺跡
				RETURN 1
			CASE お地蔵通り, 枝垂れ柳の下, 命蓮寺境内, 墓地, 神霊廟広場
				RETURN 1
			CASE 広場, 商家町, 呑屋小道, 長屋街
				RETURN 1
			CASE 竹林入り口, 迷いの小道, 斜角の竹林, 兎の洞穴, 無名の丘, 太陽の畑
				RETURN 1
			CASE 中有の道, 三途の川
				RETURN 1
		ENDSELECT
		;引力設定
	CASE 8
ENDSELECT

@EXIST_キャラデータ169
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ169(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "呼び名"
		CALLF MAKE_STR(V_NAME, "Layla")
		;こっから衣装設定
	CASE "今日のパジャマ"
		CALLF MAKE_STR(V_NAME, "パジャマ（ワンピース）セット")
	CASE "普段着：着物"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("着物", "着物"))
	CASE "普段着：その他１"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("その他１", "リボン"))
	CASE "固有下着形容詞"
		CALLF MAKE_STR(V_NAME, "해진")
	CASE "固有下半身下着名"
		CALLF MAKE_STR(V_NAME, "old panties")
	CASE "固有上半身下着"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "固有上半身下着名"
		CALLF MAKE_STR(V_NAME, "old bra")
	CASE "固有下着着用条件"
		SIF !RAND:(3 - (2 * 勝負下着判定([[Layla]])))
			CALLF MAKE_INT(V_NAME, 1)
	CASE "固有下着透ける(前)"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "固有下着透ける(後)"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "固有下着生地厚さ"
		CALLF MAKE_INT(V_NAME, 3)
		;料理関連
	CASE "料理：好きな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：嫌いな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：助手効果"
		CALLF MAKE_STR(V_NAME, "/")
		;贈り物関連
	CASE "感性：好き"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "感性：嫌い"
		CALLF MAKE_STR(V_NAME, "/")
ENDSELECT
;-------------------------------------------------
;固有料理設定
;DISH_NAME          料理名
;RESULTS            料理の種類（軽食/主食/デザート）
;CALL 材料設定("")  材料の指定。"汎用"を入れると自動で汎用食材になる
;DISH_TASTE         味の設定
;DISH_COMMENT       （任意）一行コメント
;DISH_TIME          （任意）調理にかかる時間
;DISH_MAXLIMIT      （任意）料理の持続時間
;-------------------------------------------------

@SPECIAL_MENU_169
DISH_NAME = Hamburger Steak
RESULTS = 主食
CALL 材料設定("汎用")
DISH_TASTE = もちもち
DISH_COMMENT '= @"그레이비 소스를 올린 햄버그 패티와 감자가 곁들여 있다."
RETURN 1
