; Modular ERB: OMOGATARI/CHARA/161 Rin Satsuki/Chara_data_165_Rin Satsuki.ERB

@CHARAMOVE_DATA_161(ARG, ARG:2)
LOCAL = 161
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
		SIF YOUBI_MATCH(DAY, "土日") && CFLAG:LOCAL:今日の運勢 % 8 == 0
			RETURN [[妹紅]]
		;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
		;Frequency（±～10=More frequently goes to/Goes to less frequently, -100=Will never go）
	CASE 4
		SELECTCASE ARG:2
			;Places that the 2hu likes to go to
			CASE P202中央広場, P221稗田邸, P224慧音宅, P222寺子屋, P202中央広場
				RETURN 5
				;Places the 2hu will never go
			CASE P208雷鼓の部屋, P209八橋の部屋, P210弁々の部屋, P226小鈴私室, P229阿求私室
				RETURN -100
			CASE P231蛮奇の部屋, P232蓮子の部屋, P233メリーの部屋, P234ユキの部屋, P235マイの部屋, P239美宵の部屋
				RETURN -100
		ENDSELECT
		;Places the 2hu can go out
	CASE 7
		SELECTCASE ARG:2
			CASE 広場, 商家町, 呑屋小道, 寺子屋, 長屋街
				RETURN 1
			CASE 竹林入り口, 迷いの小道, 斜角の竹林, 永遠亭
				RETURN 1
		ENDSELECT
		;引力設定
	CASE 8
ENDSELECT

@EXIST_キャラデータ161
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ161(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "呼び名"
		CALLF MAKE_STR(V_NAME, "Rin")
		;こっから衣装設定
	CASE "今日のパジャマ"
		CALLF MAKE_STR(V_NAME, "パジャマ（ワンピース）セット")
	CASE "普段着：靴"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴", "靴"))
	CASE "普段着：靴下"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "靴下"))
	CASE "普段着：スカート"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("スカート", "スカート"))
	CASE "普段着：上半身上着２"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("上半身上着２", "ブラウス"))
	CASE "普段着：その他１"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("その他１", "リボン"))
	CASE "固有下着形容詞"
		CALLF MAKE_STR(V_NAME, "유기적인")
	CASE "固有下半身下着名"
		CALLF MAKE_STR(V_NAME, "leafy panties")
	CASE "固有上半身下着"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "固有上半身下着名"
		CALLF MAKE_STR(V_NAME, "leafy bra")
	CASE "固有下着着用条件"
		SIF !RAND:(3 - (2 * 勝負下着判定([[Satsuki]])))
			CALLF MAKE_INT(V_NAME, 1)
	CASE "固有下着透ける(前)"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "固有下着透ける(後)"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "固有下着生地厚さ"
		CALLF MAKE_INT(V_NAME, 3)
		;料理関連
	CASE "料理：好きな味"
		CALLF MAKE_STR(V_NAME, "葉物/" * 2 + "淡泊/" * 2 + "ヘルシー/" * 5 + "中華/" * 5 + "薬効/" * 5)
	CASE "料理：嫌いな味"
		CALLF MAKE_STR(V_NAME, "虫肉/" * 5 + "カエル/" * 5 + "卵/" * 5 + "鳥肉/" * 5 + "獣肉/" * 5 + "魚料理" * 5)
	CASE "料理：助手効果"
		CALLF MAKE_STR(V_NAME, "薬効/")
		;贈り物関連
	CASE "感性：好き"
		CALLF MAKE_STR(V_NAME, "美しい/美麗な/天人の/知恵の/" * 2 + "巫女の/風の/花の/印籠/" * 3 + "東方の/" * 5)
	CASE "感性：嫌い"
		CALLF MAKE_STR(V_NAME, "魔神の/" + "忘れられた/" * 10)
ENDSELECT
;-------------------------------------------------
;固有料理設定
;DISH_NAME          料理名
;RESULTS            料理の種類（軽食/主食/デザート）
;CALL 材料設定("")  材料の指定。"汎用"を入れると自動で汎用食材になる
;DISH_TASTE         味の設定
;DISH_COMMENT       （任意）一行コメント
;DISH_TIME          （任意）調理にかかる時間
;DISH_MAXLIMIT      （任意）料理の持続時間
;-------------------------------------------------

@SPECIAL_MENU_161
DISH_NAME = Holy Bread
RESULTS = デザート
CALL 材料設定("汎用")
DISH_TASTE = もちもち
DISH_COMMENT '= @"가벼운 쌀 과자, 종종 상징되듯이 \"그리스도의 몸\"."
RETURN 1
