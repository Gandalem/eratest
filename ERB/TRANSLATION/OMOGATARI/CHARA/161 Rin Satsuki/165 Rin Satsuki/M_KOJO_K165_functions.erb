;==================================================
;RIN'S INFO
;==================================================
@CHARA_INFO_KOJO_K161()
CALL M_KOJO_COLOR_K161
PRINTFORMDL %nameArray:165:na_Title%
RESETCOLOR
PRINTL
PRINTFORML A kirin nurse from the Human Village.
PRINTFORML She is responsible for the kids at the Temple School infirmary. In good terms with Keine and helps her fulfill her role as the village guardian.
PRINTFORML She is not as outgoing as her friend, and not many people can tell you a lot about her.
PRINTFORML It's as if most people don't even remember she exists. %CALLNAME:161%, although quiet she may be, is a friendly person.
RETURN 1
;==================================================
;FIRST GREETING OF THE DAY
;SPECIAL GREETINGS for holidays
;ARG 0 = Player enter, 1 = Rin enter
;==================================================
@K161_FIRST_GREETING_OF_DAY_LINES(ARG)
	;-------------------------------------------------
	;christmas
	IF DAY:2 == 4 && DAY:3 == 25
        IF TALENT:恋人
            PRINTFORML 「Merry Christmas, honey!」
            PRINTFORMDW %CALLNAME:161% approaches you. She wears a red scarf and mittens. Her rosy cheeks are bright as her dress.
            PRINTFORMW 「Do you have any plans for today? I would love to spend this day with you.」
            PRINTFORML 「Well, I want to spend every day with you, but today in particular.」
            PRINTFORMW 「The last time I spent Christmas with my human friends was ages ago. I hadn’t expected it would happen again...」
            PRINTFORMDL 。。。
            PRINTFORMDL 。。
            PRINTFORMDL 。
            PRINTFORMDW You spend some time walking around with %CALLNAME:161%. A sad smile never left her face all that time.
            PRINTFORMW 「No, it's fine, really.」
            PRINTFORML 「But, you know, every year's end brought back memories of old friends. That I will never see again.」
            PRINTFORML 「We would walk to a festival, eat sweets, play games, watch fireworks, and do many other fun things.」
            PRINTFORMW 「I still regret that I couldn't do much more for them. I wish I could have spent more time with them...」
            PRINTFORMDW Tears stream down her cheeks as her voice shakes at the conclusion. You hug %CALLNAME:161% from behind.
            PRINTFORMDL She takes a deep breath and intertwines her fingers with yours. You stood like this for a while.
            PRINTFORMDW Little snowflakes fall around you. %CALLNAME:161% turns her head toward you.
            PRINTFORMW 「But we will be together as much as we can, my beloved %CALLNAME:MASTER%.」
            PRINTFORMDW She gives you a sweet kiss.
        ENDIF
    ;halloween 
    ELSEIF DAY:2 == 3 && DAY:3 == 30
        PRINTFORMW 「Happy Halloween, %CALLNAME:MASTER%.」
        PRINTFORMW 「Would you like some sweets? You can take only one, don't be greedy.」
        PRINTFORMW 「Children these days take as many sweets as they can on Halloween, but you wouldn't want to harm your teeth, would you?」
    ELSEIF DAY:2 == 4 && DAY:3 == 14
        IF TALENT:恋人
            PRINTFORMW 「Honey!」
            PRINTFORMDL You hear a cheerful voice behind you.
            PRINTFORMDW %CALLNAME:161% jumps into your arms and kisses you.
            PRINTFORMW 「Happy Valentine, honey.」
            PRINTFORML 「Keine-sensei told me that today in the Outside World people celebrate romance and love.」
            PRINTFORMW 「She said people usually go on dates and give chocolate to each other.」
            PRINTFORMDW %CALLNAME:161% looks at you with eyes full of adoration.
            PRINTFORMW 「For me, every date we go on is Valentine's Day.」
        ENDIF
        SELECTCASE CFLAG:好感度
            CASE 1000 TO 3000
                PRINTFORMW 「%CALLNAME:MASTER%, it's for you.」
                PRINTFORMDL %CALLNAME:161% gives you a small chocolate decorated with a cute pink bow.
                PRINTFORMW 「I hope your life will be full of love. Without love, people cannot gain knowledge and be always happy.」
                PRINTFORMW 「The philanthropic man will find peace in love, the wise man will find profit.」
            CASE 3001 TO 5000
                PRINTFORMDW %CALLNAME:161% approaches you, hiding something behind her back.
                PRINTFORMW 「%CALLNAME:MASTER%, guess what I have for you.」
                PRINTFORMDW She gives you a small chocolate box.
                PRINTFORMW 「I wanted to give you something to thank you for a good time.」
            CASE IS > 5000
                IF EXP:15:愛情経験 > 100
                    PRINTFORMW 「Uhm… %CALLNAME:MASTER%, I have something for you.」
                    PRINTFORMDW %CALLNAME:161% gives you an expensive looking cake.
                    PRINTFORMW 「Sorry, I didn't have much time to do it myself, but I hope you will like it.」
                    PRINTFORMW 「I noticed this cake in sweet shop in Human Village and I thought about you...」
                    PRINTFORMDL %CALLNAME:161%'s face fills with red as she fidgets and twists around.
                    PRINTFORMW 「Happy Valentine, %CALLNAME:MASTER%.」
                ELSE
                    PRINTFORMW 「Honey, this is for you.」
                    PRINTFORMW 「I've never cooked such a complicated thing, but Keine-sensei volunteered to help me. I think it should be good.」
                    PRINTFORMDW %CALLNAME:161% gives you a chocolate cake. There's a rough drawing of you and %CALLNAME:161% inside a heart shape.
                    PRINTFORMW 「Ah, and one more thing.」
                    PRINTFORMDW %CALLNAME:161% gives you a big smooch on the cheek. She gets closer to your ear.
                    PRINTFORMW 「And if it's still not enough for you, we can do something more fun this evening. Ehehe～」
                ENDIF
            ENDSELECT
    ;bunny day
    ELSEIF DAY:3 == 28
        PRINTFORML 「I used to feel embarrassed to wear this clothing on this day. I still do not understand the origins of this tradition.」
        PRINTFORMW 「But bunny ears are cute for sure...」
        PRINTFORMW 「Why are you looking at me like that?」
    ;usual days
    ELSE
		IF TALENT:恋人
			PRINTFORML 「Honey!」
			PRINTFORMDL %CALLNAME:161% runs up and wraps her arms around yours.
			PRINTFORML 「I was wondering where you were. Do you have a free minute?」
			PRINTFORML 「I've been thinking about spending time with you. Maybe we should go eat somewhere?」
		ELSEIF TALENT:思慕
			SELECTCASE RAND:2
				CASE 0
					PRINTFORML 「Ah! Hi, %CALLNAME:MASTER%.」
					PRINTFORML 「Are you doing well? Are you busy?」
					PRINTFORML 「N-no, nothing. Just curious」
				CASE 1
					PRINTFORML 「Hi, %CALLNAME:MASTER%. How is your day?」
					PRINTFORML 「Has anything new happened?」
			ENDSELECT
		ELSE
			PRINTFORML 「Hello, %CALLNAME:MASTER%.」
			PRINTFORML 「What brings you here?」
			PRINTFORML 「Are you doing well? If you need a medical examination, you can always visit me.」
		ENDIF
    ENDIF
;==================================================
;EVERYDAY COMMANDS
;==================================================
;both public bath and usual
@K161_BATHING(ARG)
    IF LOCAL
        LOCAL:1 = 1
        IF LOCAL:1 && ARG == 1
		    PRINTFORMW 「Kyah! Get out!」
		    PRINTFORMW 「Uuu, %CALLNAME:MASTER%, you pervert.」
		    RETURN 1
    	ENDIF
        LOCAL:1 = 1
        IF LOCAL:1 && ARG == 2
            SIF TALENT:恋人
                PRINTFORML 「Honey, please, come in.」
                PRINTFORMDW %CALLNAME:161% invites you with a shy gesture.
                PRINTFORMW 「We are lovers after all.」
            RETURN 1
        ENDIF
    ENDIF
;Have and Serve meal
@K161_RIN_MEAL
IF TFLAG:193 == 1
	SELECTCASE RAND:2
		CASE 0
			PRINTFORMW 「You should have told me sooner. I could have prepared us tea.」
		CASE 1
			PRINTFORML 「Thank you for your care, %CALLNAME:MASTER%. Itadakimasu～」
			PRINTFORMDW %CALLNAME:161% takes one bite and her face lights up.
			PRINTFORMW 「Wow, what a nice balance of ingredients! I can taste every single one of them.」
			PRINTFORMW 「That saltiness with a hint of sweetness. Can I ask you for the recipe, please?」
	ENDSELECT
ELSEIF TFLAG:193 == 0
	PRINTFORM 「%CALLNAME:MASTER%, remember to wash your hands before eating.」
ELSE
	IF STRCOUNT(DISH_TASTE, ESCAPE("獣肉/"))
		PRINTFORMW 「... Sorry, %CALLNAME:MASTER%, I don't eat animals. How about I give to you and I'll eat the side dish.」
		PRINTFORMW 「As a man, you should eat a lot.」
	ELSE
		PRINTFORMDL After one bite, %CALLNAME:161% struggles to find words. She has a worried look on her face.
		PRINTFORMW 「... How often do you cook, %CALLNAME:MASTER%? I can help you learn how. Do not be afraid to ask.」
	ENDIF
ENDIF
