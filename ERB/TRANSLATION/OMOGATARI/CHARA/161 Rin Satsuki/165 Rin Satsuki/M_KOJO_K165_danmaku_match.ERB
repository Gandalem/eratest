; Modular ERB: OMOGATARI/CHARA/161 Rin Satsuki/165 Rin Satsuki/M_KOJO_K165_danmaku_match.ERB
;==================================================
;弾幕勝負
;==================================================
;

@M_KOJO_MESSAGE_COM_K161_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	SIF FLAG:口上色
		TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The larger the handicap, the more of a disadvantage the player is at
	;Negative numbers mean the player has an advantage
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Handicap (doesn't apply if the character's handicap is 0)
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORMW 「솔직히 말하면 싸움에는 별로 관심 없어 게다가 단마쿠도 한 지 오래됐거든.」
		PRINTFORMW 「내가 당신에게 적절한 상대가 될 거라고 생각하지 않아 우리 정말 이걸 해야 해?」
		PRINTFORMDW %CALLNAME:161%은(는) 깊게 한숨을 내쉰다.
		PRINTFORMW 「좋아, 만약 연습 때문이라면 괜찮아. 하지만 그만두고 싶을 때는 언제든지 말해줘, 알겠지?」
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾"
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORMDL 당신의 총알 세례는 %CALLNAME:161%을 깜짝 놀라게 했다.
				PRINTFORMW 「잠깐, 아직 준비가 안 됐는데!」
			CASE 2
				PRINTFORMDL %CALLNAME:161%은(는) 마지막 순간에 당신의 총알을 피한다. 그녀의 이마에는 땀방울이 보였다.
				PRINTFORMW 「매우 숙련되었군, 플레이어. 하지만 당신에 대한 존경심으로 항복하지 않겠다.」
				PRINTFORML 「꽃 부채(Flower Sign)」
				PRINTFORMDW 갑자기 총알들이 당신을 둘러싸고 피어나는 꽃봉오리처럼 꽃 모양으로 흩어진다.
			CASE 1
				PRINTFORMDL %CALLNAME:161%은(는) 공중에서 회전하며 당신의 빠른 공격 이후 균형을 잡으려 한다.
				PRINTFORMW (이게 내가 할 수 있는 전부인가? 나 자신조차 지키지 못한다면, 사람들을 지킬 수도 없다.)
				PRINTFORML 「바람의 징표」
				PRINTFORMDL %CALLNAME:161%은(는) 당신 쪽으로 회전하는 탄막의 소용돌이를 발사한다.
			CASE 0
				PRINTFORML 
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
	ENDIF
	;-------------------------------------------------
	;After the fight
	;The case statement is for the number of lives the character has remaining
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後"
		PRINTFORML 
		;Case 4 only applies to hus with【Deep Knowledge Of Life】
		;Cases 3-1 are for when you lose, Case 0 is for when you win
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 
			CASE 1
				PRINTFORMW 「괜찮으세요? 제가 좀 살펴볼게요.」
				PRINTFORMDW 당신은 %CALLNAME:161%이(가) 상처와 멍을 살피는 그녀의 걱정스러운 눈빛을 본다.
				PRINTFORML 「밴드가 여기 있어요, 조금만 참아주세요.」
				PRINTFORMDW %CALLNAME:161%은(는) 당신을 치료한 후 애원하는 듯한 눈으로 당신을 바라본다.
				PRINTFORMW 「제발, 이런 종류의 훈련은 그만합시다. 좋은 체조를 알고 있어요.」
			CASE 0
				IF TALENT:恋人
					PRINTFORMDW %CALLNAME:161%은(는) 거칠게 숨을 몰아쉬며 다리에 힘이 풀린다. 당신은 그녀가 바닥에 쓰러지기 전에 %CALLNAME:161%를 품에 안는다.
					PRINTFORMDW 그녀는 피로함을 잊은 듯 보이고, 홍조가 뺨 위로 퍼진다.
				ELSE
					PRINTFORMDL 그녀에게 너무 가혹했던 것을 사과한다.
					PRINTFORMW 「아니야, 걱정 마. 말했듯이 난 오래전에 단마쿠 기술을 잃었어. 괜찮아!」
					PRINTFORMW 「다음엔 좀 더 평화로운 걸 하자, 응?」
				ENDIF
		ENDSELECT
	ENDIF
	RESETCOLOR
ENDIF
RETURN 1
