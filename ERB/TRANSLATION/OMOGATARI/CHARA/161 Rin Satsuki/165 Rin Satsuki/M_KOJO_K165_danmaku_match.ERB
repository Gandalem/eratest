;==================================================
;弾幕勝負
;==================================================
;
@M_KOJO_MESSAGE_COM_K161_DANMAKU(ARGS, 相手残機)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】

;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;The larger the handicap, the more of a disadvantage the player is at
	;Negative numbers mean the player has an advantage
	;戦闘前
	HANDICAP_FIXED = 0
	HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘前"
		PRINTFORML 
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;Handicap (doesn't apply if the character's handicap is 0)
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "ハンデ"
		;ハンデつけなかったら表示されないので無記入でよい
		PRINTFORMW 「To be honest, I'm not really into fights. In addition, I haven't done danmaku in a long time.」
		PRINTFORMW 「I don't think I'd be a suitable opponent for you. Do we really have to do this?」
		PRINTFORMDW %CALLNAME:161% sighs deeply.
		PRINTFORMW 「Fine, if it's just for the sake of training. But when you want to stop, just say so, okay?」
		RETURN 0
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "被弾" 
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORMDL Your bullet barrage took %CALLNAME:161% by surprise.
				PRINTFORMW 「Wait, I wasn't ready yet!」
			CASE 2
				PRINTFORMDL %CALLNAME:161% dodges your bullets at the last moment. Sweat drops can be seen on her forehead.
				PRINTFORMW 「Very skillful, Player. But out of respect for you, I won't yield.」
				PRINTFORML 「Flower Sign」
				PRINTFORMDW Out of nowhere, bullets surround you and scatter in flower patterns like opening buds.
			CASE 1
				PRINTFORMDL %CALLNAME:161% spins in mid-air and tries to find her footing after your swift attack.
				PRINTFORMW (Is that really all I can do? If I cannot protect myself, I cannot protect people.)
				PRINTFORML 「Wind Sign」
				PRINTFORMDL %CALLNAME:161% sends spinning whirlwinds of danmaku in your direction.
			CASE 0
				PRINTFORML 
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "残忍酷薄"
		
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "乾坤一擲"
		
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "怪力乱神"
		
	ENDIF
	
	;-------------------------------------------------
	;After the fight
	;The case statement is for the number of lives the character has remaining	
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == "戦闘後" 
		PRINTFORML 
		;Case 4 only applies to hus with【Deep Knowledge Of Life】
		;Cases 3-1 are for when you lose, Case 0 is for when you win
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
			CASE 4
				PRINTFORML 
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 
			CASE 1
				PRINTFORMW 「Are you alright? Let me take a look.」
				PRINTFORMDW You see %CALLNAME:161%'s concerned look as she examines your scratches and bruises.
				PRINTFORML 「I've got some band aids here, just hold on a little bit.」
				PRINTFORMDW %CALLNAME:161% looks at you with pleading eyes after treating you.
				PRINTFORMW 「Please, let's refrain from this kind of training. I know some good physical exercises.」
			CASE 0
				IF TALENT:恋人
					PRINTFORMDW %CALLNAME:161% huffs heavily, her legs growing weaker. You catch %CALLNAME:161% in your arms before she falls to the ground.
					PRINTFORMDW She appears to have forgotten about her exhaustion, and flush spread across her cheeks.
				ELSE
					PRINTFORMDL You apologize for being overly harsh on her.
					PRINTFORMW 「Oh no, don't worry. As I said, I lost my danmaku skills a long time ago. I'm fine!」
					PRINTFORMW 「Next time, let's do something a little more peaceful, okay?」
				ENDIF
		ENDSELECT
	ENDIF
RESETCOLOR
ENDIF
RETURN 1

