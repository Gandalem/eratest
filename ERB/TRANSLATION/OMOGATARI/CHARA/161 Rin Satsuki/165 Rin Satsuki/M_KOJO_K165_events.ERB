@M_KOJO_MESSAGE_COM_K161_MUSHI_BATTLE(ARGS, ARG)
#DIM 残りムシ数
#DIM 順位
SELECTCASE ARGS
	CASE "試合前"
		;-------------------------------------------------
		;The battle begins
		;ARG is not accessible
		;No more than 50 characters per line
		;キャラセレクト時,ARGは使えません
		;全角50文字くらいまで
		;記入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 0
		;-------------------------------------------------
		IF LOCAL:1
			;		RESULTS = 「I'm gonna blow you away!」
		ENDIF
	CASE "戦場に出した"
		;-------------------------------------------------
		;Immediately after "CHARACTER sent out BUG!"
		;No more than 40 characters per line
		;"【（キャラ）】は《（ムシ）》を戦場に出した！」"の直後
		;全角40文字まで（カギカッコ含む）
		;記入チェック（=0, 非表示、1, 表示）
