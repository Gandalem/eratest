IF LOCAL
	IF TALENT:恋人
		PRINTFORMW 「Yes, honey, I will keep your pace.」
	ELSE
		PRINTDATAW
			DATAFORM 「If we had gone earlier, we wouldn't have had to be in a hurry, %CALLNAME:MASTER%.」
			DATAFORM 「Are we running late?」
		ENDDATA
	ENDIF
ENDIF
RETURN 1