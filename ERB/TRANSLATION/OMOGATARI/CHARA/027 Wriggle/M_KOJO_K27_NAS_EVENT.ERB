;==================================================
;Character Dying
;==================================================
@M_KOJO_EVENT_K27_101(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Death by gunshot
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF 

	;-------------------------------------------------
	;Cut to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF	

	;-------------------------------------------------
	;Burned to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF	

	;-------------------------------------------------
	;Crushed to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML
		RETURN 1
	ENDIF	

	;-------------------------------------------------
	;Electrocution
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF	

	PRINTFORMW 「No! Impossible!」
	PRINTFORMW 「The great %NAME:[[リグル]]%... can't...」
ENDIF

;==================================================
;Reaction Towards Death
;==================================================
@M_KOJO_EVENT_K27_102(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Sees it firsthand
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		RETURN 1
	ENDIF 
	;-------------------------------------------------
	;Reports the dead body
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2

		IF TALENT:(ARG:1):Raider
			PRINTFORML 「I know I should be glad that this villain won't be hurting any more innocents...」
			PRINTFORMW 「But I just feel sad. Why couldn't %HE_SHE(ARG:1)% have chosen to be a hero instead?」
			RETURN 1
		ENDIF

		IF AutoReviveCondition(ARG:1)
			SELECTCASE ARG:1
				CASE 13, 14, 118 ;Daiyousei, Cirno, Eternity
					PRINTFORMW 「Someone killed... %CALLNAME:(ARG:1)%?」
					PRINTFORMDW %CALLNAME:[[リグル]]% grits %HIS_HER([[リグル]])% teeth.
					PRINTFORMW 「I dunno who did this... but when %HE_SHE(ARG:1)% comes back tomorrow, I'm gonna find out.」
					PRINTFORMW 「And then I'm gonna make 'em pay for hurting my friend.」

				CASE 61, 62 ;Mokou, Kaguya
					PRINTFORMW 「Oh... I guess %CALLNAME:61%-san and %CALLNAME:62%-san were fighting again.」

				CASE 66 ;Yuyuko
					PRINTFORMW (I kinda wish %HE_SHE(66)%'d stay dead this time...)

				CASEELSE
					PRINTFORMW 「Someone killed... %CALLNAME:(ARG:1)%?」
					PRINTFORMW 「I better tell someone. They can take %HIS_HER(ARG:1)% body somewhere safe until %HE_SHE(ARG:1)% comes back.」
			ENDSELECT

		ELSE
			PRINTFORMDW %CALLNAME:[[リグル]]% falls to %HIS_HER([[リグル]])% hands and knees.

			SELECTCASE ARG:1
				CASE 12, 13, 14, 28, 118 ;Rumia, Daiyousei, Cirno, Mystia, Eternity
					PRINTFORMW 「%CALLNAME:(ARG:1)%!!」
					PRINTFORMDW %CALLNAME:[[リグル]]% reaches out with a trembling hand and touches %CALLNAME:(ARG:1)%'s cheek.
					PRINTFORMDW %HE_SHE([[リグル]],1)% shakes %HIM_HER(ARG:1)%, desperately hoping that %HES_SHES(ARG:1)% just sleeping.
					IF ARG:1 == 12
						PRINTFORMW 「I know you eat people, but... you're a youkai! That's what we do!」
						PRINTFORMDW %CALLNAME:[[リグル]]% starts to sob.
						PRINTFORMW 「You idiot... you stupid idiot!」
						PRINTFORMW 「Why didn't you run away! Why did you stay and fight?!」
					ELSEIF ARG:1 == 13
						PRINTFORMW 「You're a fairy! Fairies can't die!」
					ELSEIF ARG:1 == 14
						PRINTFORMW 「You can't die! You're the strongest! You always said you were the strongest!」
						PRINTFORMW 「And you're a fairy! Fairies can't die!」
					ELSEIF ARG:1 == 28
						PRINTFORMW 「You're my best friend! You can't be dead!」
						PRINTFORMW 「And you're the terror that stalks the night roads! You wouldn't die, even if somebody killed you!」
					ELSE
						PRINTFORMW 「You can't die! You're a goddess! That's what your worshippers said!」
					ENDIF
					PRINTFORMDW %CALLNAME:[[リグル]]% is on the verge of hysterics now.
					PRINTFORMW 「THIS ISN'T HAPPENING!!!」

				CASE 66 ;Yuyuko
					PRINTFORMW 「Well. %HE_SHE(66,1)% won't be trying to eat Misty anymore!」
					SIF KnowsDeadBodies:[[リグル]]:28
						PRINTFORMW 「I bet %HES_SHES(28)%'s happy about this... wherever %HE_SHE(28)% is.」
					PRINTFORMW 「But how did somebody manage to kill a ghost?」
					$IMMORTAL_DIED
					PRINTFORMDW %CALLNAME:[[リグル]]% swallows.
					PRINTFORMW 「This is bad. I should tell \@ KnowsDeadBodies:[[リグル]]:1 ? somebody # %CALLNAME:1%-san\@ about this...」

				CASE 68, 142 ;Yuuka, Momoyo
					PRINTFORMW 「No.」
					PRINTFORMDW %CALLNAME:[[リグル]]% lets out a high-pitched, hysterical giggle.
					PRINTFORMW 「This isn't happening. %CALLNAME:(ARG:1)%-san is too strong. There's no way anyone could kill %HIM_HER(ARG:1)%.」
					PRINTFORMW 「So this has gotta be a nightmare. All I gotta do is pinch myself.」
					PRINTFORMDW %CALLNAME:[[リグル]]% pinches %HIMSELF_HERSELF([[リグル]])%. Then %HE_SHE([[リグル]])% pinches %HIMSELF_HERSELF([[リグル]])% again.
					PRINTFORMDW Then again, harder.
					PRINTFORMW 「Why isn't it working?!」
					PRINTFORMW 「WHY CAN'T I WAKE UP?!」

				CASE 84 ;Yamame
					PRINTFORML 「...」
					PRINTFORMDW %CALLNAME:[[リグル]]% stares down at %CALLNAME:84%'s body.
					PRINTFORMDW %HE_SHE(84,1)% doesn't look scary anymore. %HE_SHE(84,1)% just looks... pitiful.
					PRINTFORMDW %CALLNAME:[[リグル]]% sniffs.
					PRINTFORMW 「Maybe...」
					PRINTFORMDW She reaches out and closes %CALLNAME:84%'s eyes.
					PRINTFORMW 「Maybe %HE_SHE(84)% really did just want to be my friend after all.」
					PRINTFORMW 「I'm sorry, %CALLNAME:84%-san...」

				CASEELSE
					PRINTFORMW 「%CALLNAME:(ARG:1)%-san?!」
					IF TALENT:(ARG:1):人間 == 6
						PRINTFORMW 「I know Outsiders are fair game for youkai, but...」
						PRINTFORMDW %CALLNAME:[[リグル]]% sighs.
						PRINTFORMW 「I can't help feeling bad for 'em.」
						SIF !IS_NONHUMAN(MASTER) && !GROUPMATCH(nStartingBackstory, 23, 28, 29, 31, 32)
							PRINTFORMW 「Some of them are nice! Like %K27_MASTER()%!」
					ELSEIF TALENT:(ARG:1):神霊 || TALENT:(ARG:1):幽霊 || TALENT:(ARG:1):妖精 || TALENT:(ARG:1):追加種族 == 4 || ARG:1 == 51 || ARG:1 == 92
						PRINTFORMW 「How?! %HES_SHES(ARG:1,1)% supposed to be immortal!」
						GOTO IMMORTAL_DIED
					ELSE
						PRINTFORMW 「But... you're supposed to settle things with Danmaku!」
						IF IS_NONHUMAN(ARG:1)
							PRINTFORMW 「And exterminations aren't supposed to be lethal!」
						ELSEIF GROUPMATCH(ARG:1, 70, 80)
							PRINTFORMW 「And you're not supposed to attack villagers!」
						ENDIF
						PRINTFORMDW %CALLNAME:[[リグル]]% bites %HIS_HER([[リグル]])% lip.
						PRINTFORMW 「I'm gonna tell \@ KnowsDeadBodies:[[リグル]]:1 ? somebody # %CALLNAME:1%-san\@ about this. Somebody's breaking the rules of Gensokyo.」
					ENDIF

			ENDSELECT
		ENDIF

		; I originally thought this subsection was for a character reporting the dead character's death, but it wasn't
		; Commenting these lines out for now in case a KOJO call gets added for that

		; IF GROUPMATCH(ARG:1, 12, 13, 14, 28, 68, 118, 142)
		; 	PRINTFORMW 「Somebody killed my friend.」
		; 	PRINTFORMDW %CALLNAME:[[リグル]]% grits %HIS_HER([[リグル]])% teeth.
		; 	PRINTFORML 「And when I find out who did it...」
		; 	CALL PRINT_STRW, @"「@ITALIC@I'll get my bug friends to eat 'em alive from the inside out.@」"
		; ELSEIF (TALENT:(ARG:1):神霊 || TALENT:(ARG:1):幽霊 || TALENT:(ARG:1):妖精 || TALENT:(ARG:1):追加種族 == 4 || ARG:1 == 51 || ARG:1 == 92) && !AutoReviveCondition(ARG:1)
		; 	PRINTFORMW 「Somebody killed %CALLNAME:(ARG:1)%-san.」
		; 	PRINTFORMW 「Permanently.」
		; 	PRINTFORMW 「And that shouldn't be possible. Something really bad is happening...」
		; ELSEIF GROUPMATCH(ARG:1, 70, 80)
		; 	PRINTFORMW 「Somebody killed %CALLNAME:(ARG:1)%-san. And you aren't supposed to attack villagers.」
		; 	PRINTFORMW 「Somebody's breaking the rules of Gensokyo, and we gotta stop 'em before they kill somebody else.」
		; ELSE
		; 	PRINTFORMW 「Somebody killed %CALLNAME:(ARG:1)%-san.」
		; 	PRINTFORMW 「I know that's just how it is in Gensokyo, but... someone should at least hold a funeral for them.」
		; ENDIF
		RETURN 1
	ENDIF 	
	;-------------------------------------------------
	;Finds X is missing
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「I haven't seen %CALLNAME:(ARG:1)% in a while.」
		PRINTFORMW 「I'm starting to get kinda worried...」
		RETURN 1
	ENDIF 	
	;-------------------------------------------------
	;Reports to Nazrin
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「Hey, %CALLNAME:39%-san?」
		PRINTFORMW 「I haven't seen %CALLNAME:(ARG:1)% in a while. Can you dowse for them for me?」
		RETURN 1
	ENDIF 	
ENDIF

