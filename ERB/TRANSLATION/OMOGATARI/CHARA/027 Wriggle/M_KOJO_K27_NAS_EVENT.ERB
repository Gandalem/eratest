	;-------------------------------------------------
	;Pedophile
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 24
		CALL PRINT_STRL, @"「If you even @ITALIC@look@ at %CHAN_KUN([[ルーミア]])%, %CHAN_KUN([[大妖精]])%, or %CHAN_KUN([[チルノ]])%...」"
		CALL PRINT_STRW, @"「@ITALIC@You're gonna be bug chow.@」"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Tentacle Handler
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 25
		PRINTFORMW 「Umm... you aren't planning on doing anything bad with those tentacles, are you?」
		PRINTFORMW 「'Cause I, um, wanna learn more about 'em...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Burglar
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 26
		PRINTFORMW 「Seriously, %CALLNAME:MASTER%?」
		PRINTFORMW 「If it doesn't belong to you, don't take it. Everyone knows that!」
		RETURN 1
	ENDIF
ENDIF

