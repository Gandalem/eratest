	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 20
		PRINTFORMW 「Uhh...」
		PRINTFORMW 「I'm not trying to police your sex life, but I don't think that's healthy.」
		PRINTFORMW 「You do eat other stuff too, don't you?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Sperm Chef
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 21
		PRINTFORMW 「No wonder the food you cooked for me always tasted salty...」
		PRINTFORMDW %CALLNAME:[[リグル]]% gags.
		PRINTFORMW 「I'm gonna %CALLNAME:[[リグル]]% Kick your nuts so hard they explode!」
		RETURN 1
	ENDIF
