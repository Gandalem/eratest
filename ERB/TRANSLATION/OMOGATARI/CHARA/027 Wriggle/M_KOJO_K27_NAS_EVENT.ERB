	;-------------------------------------------------
	IF LOCAL:1 && ARG == 19
		PRINTFORMW 「Eww eww eww eww! Why would you even think about doing that to a dead body?!」
		SIF CFLAG:[[リグル]]:既成事実 & 合意_うふふ
			PRINTFORMW (Now I gotta go have a really embarrassing talk with %CALLNAME:72%-san...)
		RETURN 1
