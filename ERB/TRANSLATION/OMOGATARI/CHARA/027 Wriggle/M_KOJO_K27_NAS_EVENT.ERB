@M_KOJO_EVENT_K27_101(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Death by gunshot
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Cut to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Burned to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Crushed to death
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Electrocution
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORML
		RETURN 1
	ENDIF
	PRINTFORMW 「안 돼! 불가능해!」
	PRINTFORMW 「위대한 %NAME:[[リグル]]%는... 할 수 없어...」
ENDIF
