		PRINTFORMW 「I'm glad %CALLNAME:29%-san exposed you as the liar you are.」
		PRINTFORMW 「I can't believe I trusted you!」
		SIF TALENT:[[リグル]]:恋人
			PRINTFORMW 「When you told me you loved me, was that a lie too?!」
		RETURN 1
	ENDIF
