	;-------------------------------------------------
	IF LOCAL:1 && ARG == 14
		PRINTFORMW 「A fellow hero of justice!」
		PRINTFORMDW %CALLNAME:[[リグル]]% grins at you.
		PRINTFORMW 「Wanna be my sidekick?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Cleaner
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 15
		PRINTFORMW 「I'm glad you're cleaning up around Gensokyo!」
		PRINTFORMW 「Just be careful not to hurt any bugs when you're doing it, okay?」
		RETURN 1
	ENDIF
