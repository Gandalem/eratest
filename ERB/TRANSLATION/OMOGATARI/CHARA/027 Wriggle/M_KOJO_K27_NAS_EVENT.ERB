	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMW 「Wait, what? You can stop time!」
		PRINTFORMW 「That's so cool!! Can you teach me?! Please?!」
		RETURN 1
	ENDIF
