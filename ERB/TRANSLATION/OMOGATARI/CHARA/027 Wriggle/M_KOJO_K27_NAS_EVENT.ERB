	;Not Potty Trained
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		SELECTCASE ARG:1
			CASE 1
				PRINTFORMW 「Uhh... do you need a change of clothes?」
		;wetting
			CASE 2
		;messing
				PRINTFORMW 「Eww... it stinks!」
			CASE 3, 4
				PRINTFORMW 「I guess you couldn't hold it, huh...」
				PRINTFORMW 「But that's still gross.」
