@M_KOJO_EVENT_K27_104(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Has TSP
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		PRINTFORMW 「잠깐, 뭐라고? 시간을 멈출 수 있어!」
		PRINTFORMW 「진짜 멋지다!! 나한테 가르쳐 줄 수 있어?! 제발?!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Slut
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML 「헤이, 난 너를 판단하지 않을 거야.」
		CALL PRINT_STRW, @"「내 버그 친구들 대부분은 모노가미가 뭔지도 몰라.」"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Panty Snatcher
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「너 대체 무슨 일이야, %CALLNAME:MASTER%?!」
		SIF TALENT:[[リグル]]:恋人
			PRINTFORMW 「우선 말하자면, 내 팬티가 네가 필요로 하는 유일한 팬티여야 해! 그리고 두 번째로는...」
		PRINTFORMW 「훔치는 것은 잘못이야! 특히 사람들의 속옷은 말이지!」
		PRINTFORMW 「나의 벌레 친구들이 이제부터 너를 지켜볼 테니까...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Skirt Flipper
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW 「으윽. 반바지 입어서 다행이다.」
		PRINTFORMW 「내 벌레 친구들이 이제부터 너를 지켜볼 거야...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Rapist
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:[[リグル]]:恋人
			PRINTFORMW 「%CALLNAME:MASTER%... 어찌 그럴 수 있어?!」
			PRINTFORMDW %CALLNAME:[[リグル]]%가 울기 시작한다.
			PRINTFORMW 「나는 당신을 사랑했어요! 어찌 그렇게 사악한 일을 할 수 있는 거죠?!」
		ELSE
			PRINTFORMW 「다음에 너를 보면, 내 집의 장수풍뎅이 친구들을 소개해 줄게.」
			PRINTFORMW 「그들이 네가 다시는 누구에게도 상처를 주지 않도록 지켜줄 거야.」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Impregnator
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORMW 「축하해, %CALLNAME:MASTER%!」
		PRINTFORMW 「네 새로운 패들을 책임지길 바라!」
		PRINTFORMW 「안 그러면 내가 네 엉덩이를 박살 내버릴 테니까! 말 그대로 말이야!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Bedwetter
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		PRINTFORMW 「으윽...」
		PRINTFORMW 「에이텐이에 약속을 잡는 게 좋을 것 같아.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Not Potty Trained
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		SELECTCASE ARG:1
			CASE 1
				PRINTFORMW 「음... 옷 갈아입을 필요 있어?」
				;wetting
			CASE 2
				;messing
				PRINTFORMW 「으윽... 역겹다!」
			CASE 3, 4
				PRINTFORMW 「참 참지 못했나 보네...」
				PRINTFORMW 「하지만 그래도 역겨워.」
				;open urination/defecation
			CASE 5
				;diaper check
			CASE 6, 7
				PRINTFORMW 「뭔가 정말 역겨운 냄새가 난다.」
				PRINTFORMW 「너 때문은 아니지, 그렇지?」
				;smell
				; CASE 7
				;smell, dirty panties
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Exhibitionist
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORMW 「%K27_MASTER()%씨, 공공장소에서는 옷을 입어야 하는 거잖아요.」
		PRINTFORMW 「당신은 동물이 아니에요!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Danmaku Master
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		PRINTFORML 「이런 힘이라니...」
		PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 당신을 바라보며 별처럼 눈을 빛냈다.
		PRINTFORMW 「당신의 비밀을 가르쳐 주세요, 센세!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Can't Control Arousal
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 10
		PRINTFORMW 「발정기라면 끝날 때까지 그냥 집에 있는 게 좋을 거야.」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Sadist
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 11
		PRINTFORMW 「%MOAN("m")%... %MOAN("m")%...」
		PRINTFORMW (내 인생에서 이렇게 흥분한 적은 없었다…)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Masochist
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 12
		PRINTFORMW 아, 알겠다 %K27_MASTER()%~이다 %PRINT_MALE("man", MASTER)% 문화로서도
		PRINTFORMW 이제 어떻게 말해야 할까 %HIM_HER(MASTER)% 그것에 대해 이상하게 보이지 않으면서 어떻게 말해야 할까?
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Parent
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 13
		PRINTFORMW 「너는 멋진 %PRINT_MALE("아빠:엄마", MASTER)%가 될 거야!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Helping Hand
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 14
		PRINTFORMW 「정의로운 동료라니!」
		PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 당신을 보며 미소 짓는다.
		PRINTFORMW 「내 조수가 되어주지 않겠어?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Cleaner
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 15
		PRINTFORMW 「겐소쿄 주변을 청소해 주니 기쁘군!」
		PRINTFORMW 「청소할 때 벌들을 다치게 하지 않도록 조심해야 해, 알겠지?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Hypnoist
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 16
		PRINTFORMW (%HIM_HER(MASTER)%의 생각이 나를 왜 이렇게... 흥분하게 만드는 거지?)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;False God
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 17
		PRINTFORMW 「%CALLNAME:29%-씨가 당신이 거짓말쟁이라는 것을 폭로해줘서 기뻐.」
		PRINTFORMW 「내가 너를 믿었다니 믿을 수가 없어!」
		SIF TALENT:[[リグル]]:恋人
			PRINTFORMW 「나를 사랑한다고 말했을 때, 그것도 거짓이었어?!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Murderer
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 18
		PRINTFORMW 「나-나는 네가 이걸 그냥 넘어가는 걸 못 보겠어!」
		PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 포즈를 취하려 하지만, %HES_SHES([[リグル]])%은(는) 너무 심하게 떨어서 해내지 못한다.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Necrophile
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 19
		PRINTFORMW 「으윽 으윽 으윽 으윽! 죽은 시체한테 그런 짓을 생각할 리가 있나?!」
		SIF CFLAG:[[リグル]]:既成事実 & 合意_うふふ
			PRINTFORMW (이제 정말 창피한 이야기를 %CALLNAME:72% 씨랑 해야겠군...)
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Semen Demon
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 20
		PRINTFORMW 「음...」
		PRINTFORMW 「네 성생활을 감시하려는 건 아니지만, 그건 건강하지 않다고 생각한다.」
		PRINTFORMW 「다른 것도 먹잖아, 그렇지 않아?」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Sperm Chef
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 21
		PRINTFORMW 「네가 나에게 해준 요리가 항상 짜서 그럴 만했구나...」
		PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 구토한다.
		PRINTFORMW 「난 %CALLNAME:[[リグル]]%의 고환을 터질 때까지 세게 찰 거야!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Terrorist
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 22
		IF IS_FALLEN([[リグル]])
			PRINTFORMW 「%CALLNAME:MASTER%?! No...」
			PRINTFORMW 「왜? 왜 사람들을 죽이고 싶어 하는 거지? 왜 환상향을 파괴하고 싶어 하는 거야?」
			PRINTFORMDW %CALLNAME:[[リグル]]%는 코를 킁킁거린다.
			PRINTFORMW 「이런 일을 해야 한다는 게 바라지 않지만...」
		ENDIF
		PRINTFORMW 「모든 버그들 주목!」
		PRINTFORMW 「%조사처리(CALLNAME:MASTER,"가")% 종려의 역사상 최악의 사건을 일으키고 있고, %HE_SHE(TARGET)%는 술식 카드 규칙 따위 신경 쓰지 않는다.」
		PRINTFORMW 「만약 %HIM_HER(MASTER)%를 본다면...」
		CALL PRINT_STRW, @"「ITALIC군집 %HIM_HER(MASTER)%, 물어라 %HIM_HER(MASTER)%. 쏘아라 %HIM_HER(MASTER)%. 그리고 %HES_SHES(MASTER)%이 죽을 때까지 멈추지 마라.」"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Grave Digger
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 23
		PRINTFORMW 「그 사람들의 시신에 대해 뭘 할 생각이었는지 모르겠고, 알고 싶지도 않아.」
		PRINTFORMW 「하지만 네가 또 그걸 하는 걸 잡으면, %CALLNAME:[[リグル]]% 너희 모두를 달까지 날려버릴 거야!」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Pedophile
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 24
		CALL PRINT_STRL, @"「만약 당신이 심지어 「%CHAN_KUN([[ルーミア]])%」, 「%CHAN_KUN([[大妖精]])%」 또는 「%CHAN_KUN([[チルノ]])%」을 바라본다면...」"
		CALL PRINT_STRW, @"「너는 벌레 음식(bug chow)이 될 거야.」"
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Tentacle Handler
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 25
		PRINTFORMW 「음... 그 촉수들로 나쁜 짓 할 생각은 없는 거지?」
		PRINTFORMW 「왜냐면 난, 음, 그것들에 대해 더 알고 싶거든...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Burglar
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 26
		PRINTFORMW 「정말로, %조사처리(CALLNAME:MASTER,"에게")%?」
		PRINTFORMW 「자신 것이 아니라면 가져가지 마라. 모두가 그걸 알고 있다!」
		RETURN 1
	ENDIF
ENDIF
