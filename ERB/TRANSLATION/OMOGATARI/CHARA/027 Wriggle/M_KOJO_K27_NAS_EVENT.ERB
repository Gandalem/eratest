@M_KOJO_EVENT_K27_102(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Sees it firsthand
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Reports the dead body
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:(ARG:1):Raider
			PRINTFORML 「이 악당이 더 이상 무고한 사람들을 해치지 않는다는 사실에 기뻐해야 한다는 건 알지만...」
			PRINTFORMW 「하지만 나는 그냥 슬퍼. %HE_SHE(ARG:1)%는 왜 영웅이 되는 것을 선택할 수 없었던 걸까?」
			RETURN 1
		ENDIF
		IF AutoReviveCondition(ARG:1)
			SELECTCASE ARG:1
				CASE 13, 14, 118 ;Daiyousei, Cirno, Eternity
					PRINTFORMW 「누군가 죽였다... %CALLNAME:(ARG:1)%?」
					PRINTFORMDW %CALLNAME:[[リグル]]%는(은) 이를 악문다.
					PRINTFORMW 「누가 그랬는지 모르겠지만... 내일 %HE_SHE(ARG:1)%가 돌아오면 알아낼 거야.」
					PRINTFORMW 「그리고 내 친구를 해친 대가를 치르게 할 거야.」
				CASE 61, 62 ;Mokou, Kaguya
					PRINTFORMW 「오... %CALLNAME:61%씨와 %CALLNAME:62%씨가 또 싸우고 있었나 보네.」
				CASE 66 ;Yuyuko
					PRINTFORMW (%HE_SHE(66)%가 이번에도 죽어 있었으면 좋겠는데...)
				CASEELSE
					PRINTFORMW 「누군가 죽였어... %CALLNAME:(ARG:1)%가?」
					PRINTFORMW 「내가 누군가에게 말해줘야겠어. 그들이 %HE_SHE(ARG:1)%가 돌아올 때까지 %HIS_HER(ARG:1)%의 시신을 안전한 곳에 맡아 줄 수 있을 거야.」
			ENDSELECT
		ELSE
			PRINTFORMDW %CALLNAME:[[リグル]]%은(는) %HIS_HER([[リグル]])%의 손과 무릎으로 쓰러진다.
			SELECTCASE ARG:1
				CASE 12, 13, 14, 28, 118 ;Rumia, Daiyousei, Cirno, Mystia, Eternity
					PRINTFORMW 「%CALLNAME:(ARG:1)%!!」
					PRINTFORMDW %CALLNAME:[[リグル]]%은 떨리는 손을 뻗어 %CALLNAME:(ARG:1)%의 뺨을 만진다.
					PRINTFORMDW %HE_SHE([[リグル]],1)% 흔든다 %HIM_HER(ARG:1)%필사적으로 바라며 %HES_SHES(ARG:1)% 그냥 자고 있기를
					IF ARG:1 == 12
						PRINTFORMW 「사람을 먹는 건 알지만... 너 요괴잖아! 그게 우리가 하는 일이라고!」
						PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 울음을 터뜨린다.
						PRINTFORMW 「이 바보야... 이 멍청한 바보 같아!」
						PRINTFORMW 「왜 도망치지 않았어! 왜 남아 싸웠어?!」
					ELSEIF ARG:1 == 13
						PRINTFORMW 「너는 요정이야! 요정은 죽을 수 없어!」
					ELSEIF ARG:1 == 14
						PRINTFORMW 「너는 죽을 수 없어! 네가 가장 강하잖아! 항상 네가 가장 강하다고 말했잖아!」
						PRINTFORMW 「그리고 너는 요정이야! 요정들은 죽지 못해!」
					ELSEIF ARG:1 == 28
						PRINTFORMW 「너는 나의 가장 친한 친구야! 죽을 리 없어!」
						PRINTFORMW 「그리고 너는 밤길을 배회하는 공포 그 자체잖아! 누군가 널 죽인다 해도 죽지 않을 테니까!」
					ELSE
						PRINTFORMW 「너는 죽을 수 없어! 너는 여신이야! 네 신도들이 그렇게 말했어!」
					ENDIF
					PRINTFORMDW %CALLNAME:[[リグル]]%은 지금 히스테리에 걸릴 지경이다.
					PRINTFORMW 「이럴 리 없어!!!」
				CASE 66 ;Yuyuko
					PRINTFORMW 「음. %HE_SHE(66,1)%는 더 이상 미스티를 먹으려고 하지 않을 거야!」
					SIF KnowsDeadBodies:[[リグル]]:28
						PRINTFORMW 「나는 %HES_SHES(28)%이 이걸 기뻐할 거라고 내기해... %HE_SHE(28)%가 어디에 있든.」
					PRINTFORMW 「하지만 도대체 누가 유령을 죽일 수 있었던 걸까?」
					$IMMORTAL_DIED
					PRINTFORMDW %CALLNAME:[[リグル]]%은(는) 삼킨다.
					PRINTFORMW 「이건 안 좋아. \@ KnowsDeadBodies:[[リグル]]:1 ? 누군가에게 # %CALLNAME:1%-상 \@ 이 사실을 알려야 해...」
				CASE 68, 142 ;Yuuka, Momoyo
					PRINTFORMW 「싫어.」
					PRINTFORMDW %CALLNAME:[[リグル]]%가 높고 히스테릭한 웃음을 터뜨린다.
					PRINTFORMW 「이건 일어나선 안 돼 %CALLNAME:(ARG:1)%-씨는 너무 강해. 누구든 죽일 방법은 없어 %HIM_HER(ARG:1)%.」
					PRINTFORMW 「그럼 이건 악몽일 거야. 그냥 나 자신을 꼬집어 보면 돼.」
					PRINTFORMDW %CALLNAME:[[リグル]]%이 %HIMSELF_HERSELF([[リグル]])%를 꼬집는다. 그러고 나서 %HE_SHE([[リグル]])%가 %HIMSELF_HERSELF([[リグル]])%를 다시 꼬집는다.
					PRINTFORMDW 다시, 더 강하게.
					PRINTFORMW 「왜 효과가 없는 거야?!」
					PRINTFORMW 「WHY CAN'T I WAKE UP?!」
				CASE 84 ;Yamame
					PRINTFORML 「...」
					PRINTFORMDW %CALLNAME:[[リグル]]%은(는) %CALLNAME:84%의 몸을 내려다본다.
					PRINTFORMDW %HE_SHE(84,1)%은 더 이상 무섭게 보이지 않는다. %HE_SHE(84,1)%은 그저... 가련해 보인다.
					PRINTFORMDW %CALLNAME:[[リグル]]%은 코를 킁킁거린다.
					PRINTFORMW 「어쩌면...」
					PRINTFORMDW 그녀는 손을 뻗어 %CALLNAME:84%의 눈을 감겨준다.
					PRINTFORMW 「어쩌면 %HE_SHE(84)%은 정말로 내 친구가 되고 싶었던 것일지도 몰라.」
					PRINTFORMW 「미안해, %CALLNAME:84%-상...」
				CASEELSE
					PRINTFORMW 「%CALLNAME:(ARG:1)%님?!」
					IF TALENT:(ARG:1):人間 == 6
						PRINTFORMW 「아웃사이더가 요괴들에게 먹잇감이 될 수 있다는 건 알지만...」
						PRINTFORMDW %CALLNAME:[[リグル]]%는 한숨을 내쉰다.
						PRINTFORMW 「그들을 위해 안타까운 마음이 드네.」
						SIF !IS_NONHUMAN(MASTER) && !GROUPMATCH(nStartingBackstory, 23, 28, 29, 31, 32)
							PRINTFORMW 「그들 중 일부는 착해! %K27_MASTER()%처럼!」
					ELSEIF TALENT:(ARG:1):神霊 || TALENT:(ARG:1):幽霊 || TALENT:(ARG:1):妖精 || TALENT:(ARG:1):追加種族 == 4 || ARG:1 == 51 || ARG:1 == 92
						PRINTFORMW 「어떻게?! %HES_SHES(ARG:1,1)%가 불멸이어야 하는데!」
						GOTO IMMORTAL_DIED
					ELSE
						PRINTFORMW 「하지만... 단마쿠로 일을 정리해야 하는 거잖아!」
						IF IS_NONHUMAN(ARG:1)
							PRINTFORMW 「그리고 학살은 치명적이어야 하는 게 아니라고!」
						ELSEIF GROUPMATCH(ARG:1, 70, 80)
							PRINTFORMW 「그리고 마을 사람들을 공격해서는 안 된다고!」
						ENDIF
						PRINTFORMDW %CALLNAME:[[リグル]]%은(는) %HIS_HER([[リグル]])%의 입술을 깨문다.
						PRINTFORMW 「이걸 \@ KnowsDeadBodies:[[リグル]]:1 ? 누군가에게 # %CALLNAME:1%-상 \@ 말할 거야. 누가 인연의 규칙을 어기고 있어.」
					ENDIF
			ENDSELECT
		ENDIF
		; I originally thought this subsection was for a character reporting the dead character's death, but it wasn't
		; Commenting these lines out for now in case a KOJO call gets added for that
		; IF GROUPMATCH(ARG:1, 12, 13, 14, 28, 68, 118, 142)
		; 	PRINTFORMW 「Somebody killed my friend.」
		; 	PRINTFORMDW %CALLNAME:[[リグル]]% grits %HIS_HER([[リグル]])% teeth.
		; 	PRINTFORML 「And when I find out who did it...」
		; 	CALL PRINT_STRW, @"「@ITALIC@I'll get my bug friends to eat 'em alive from the inside out.@」"
		; ELSEIF (TALENT:(ARG:1):神霊 || TALENT:(ARG:1):幽霊 || TALENT:(ARG:1):妖精 || TALENT:(ARG:1):追加種族 == 4 || ARG:1 == 51 || ARG:1 == 92) && !AutoReviveCondition(ARG:1)
		; 	PRINTFORMW 「Somebody killed %CALLNAME:(ARG:1)%-san.」
		; 	PRINTFORMW 「Permanently.」
		; 	PRINTFORMW 「And that shouldn't be possible. Something really bad is happening...」
		; ELSEIF GROUPMATCH(ARG:1, 70, 80)
		; 	PRINTFORMW 「Somebody killed %CALLNAME:(ARG:1)%-san. And you aren't supposed to attack villagers.」
		; 	PRINTFORMW 「Somebody's breaking the rules of Gensokyo, and we gotta stop 'em before they kill somebody else.」
		; ELSE
		; 	PRINTFORMW 「Somebody killed %CALLNAME:(ARG:1)%-san.」
		; 	PRINTFORMW 「I know that's just how it is in Gensokyo, but... someone should at least hold a funeral for them.」
		; ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Finds X is missing
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML 「%CALLNAME:(ARG:1)%을(를) 한동안 못 봤어.」
		PRINTFORMW 「좀 걱정되기 시작했어...」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Reports to Nazrin
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 「헤이, %CALLNAME:39%-씨?」
		PRINTFORMW 「%CALLNAME:(ARG:1)%을(를) 한동안 못 봤어. 그들을 대신 찾아줄 수 있니?」
		RETURN 1
	ENDIF
ENDIF
