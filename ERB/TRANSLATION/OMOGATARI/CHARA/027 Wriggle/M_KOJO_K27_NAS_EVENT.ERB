	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「What the heck's wrong with you, %CALLNAME:MASTER%?!」
		SIF TALENT:[[リグル]]:恋人
			PRINTFORMW 「First of all, my panties should be the only panties you need! And second of all...」
		PRINTFORMW 「It's wrong to steal! Especially people's underwear!」
