	;-------------------------------------------------
	IF LOCAL:1 && ARG == 18
		PRINTFORMW 「I-I'm not gonna let you get away with this!」
		PRINTFORMDW %CALLNAME:[[リグル]]% tries to strike a pose, but %HES_SHES([[リグル]])% trembling too hard to pull it off.
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Necrophile
	;Showing Check=0, Don't show、1, Show）
