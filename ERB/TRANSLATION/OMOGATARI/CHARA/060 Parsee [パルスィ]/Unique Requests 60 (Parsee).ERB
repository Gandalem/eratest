; Modular ERB: OMOGATARI/CHARA/060 Parsee [パルスィ]/Unique Requests 60 (Parsee).ERB

@固有依頼60(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE ARG % 1000
	;ID101：Padded Jealousy 1
	CASE 101
		SELECTCASE O_DATA
			CASE "依頼名"
				CALLF MAKE_STR(V_NAME, "Padded Jealousy I")
			CASE "依頼内容表示"
				CALLF MAKE_STR(V_NAME, @"%CALLNAME:60%의 사타구니 경련을 알아낸다")
			CASE "依頼報酬表示"
				CALLF MAKE_STR(V_NAME, @"호의성 + 신뢰도 + 선택 의존 보상")
			CASE "依頼実行コマンド名"
				CALLF MAKE_STR(V_NAME, "Help")
			CASE "依頼内容"
				CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "作業"))
			CASE "依頼サブ"
			CASE "依頼期限"
				CALLF MAKE_INT(V_NAME, YearLength)
			CASE "依頼発生率"
				;これは他の固有依頼との相対確率なんで10％ではありません
				CALLF MAKE_INT(V_NAME, 10)
			CASE "依頼発生条件"
				CALLF MAKE_INT(V_NAME, 1)
			CASE "依頼受託可能条件"
				;受託可能は@COM_ABLE366も確認のこと
				;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
				[IF_NDEBUG]
				IF CharaQuestline:102:0:0 < 11 || CharaQuestline:60:0:0 != 0
					CALLF MAKE_INT(V_NAME, 0)
				ELSE
					CALLF MAKE_INT(V_NAME, 1)
				ENDIF
				[ELSE]
				CALLF MAKE_INT(V_NAME, 1)
				[ENDIF]
			CASE "依頼実行可能条件"
				;実行可能は@COM_ABLE367も確認のこと
				CALLF MAKE_INT(V_NAME, 1)
				;成功/失敗処理はCARRYOUTで直接書く
				;SOURCEやITEM入手など、内容が複雑なので
			CASE "依頼消滅条件"
				;30％で消失
				SIF Add_Request_Should_Discard(ARG)
					CALLF MAKE_INT(V_NAME, 1)
		ENDSELECT
		;ID101：Padded Jealousy 2
	CASE 101
		SELECTCASE O_DATA
			CASE "依頼名"
				CALLF MAKE_STR(V_NAME, "Padded Jealousy II")
			CASE "依頼内容表示"
				CALLF MAKE_STR(V_NAME, @"%CALLNAME:60%의 침실을 청소한다.")
			CASE "依頼報酬表示"
				CALLF MAKE_STR(V_NAME, @"호의성 + 신뢰도 + 선택 의존 보상")
			CASE "依頼実行コマンド名"
				CALLF MAKE_STR(V_NAME, "Help")
			CASE "依頼内容"
				CALLF MAKE_INT(V_NAME, MAKE_IRAI_DATA(0, "作業"))
			CASE "依頼サブ"
			CASE "依頼期限"
				CALLF MAKE_INT(V_NAME, 5)
			CASE "依頼発生率"
				;これは他の固有依頼との相対確率なんで10％ではありません
				CALLF MAKE_INT(V_NAME, 10)
			CASE "依頼発生条件"
				CALLF MAKE_INT(V_NAME, 1)
			CASE "依頼受託可能条件"
				;受託可能は@COM_ABLE366も確認のこと
				;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
				[IF_NDEBUG]
				IF CharaQuestline:102:0:0 < 11 || CharaQuestline:60:0:0 != 1
					CALLF MAKE_INT(V_NAME, 0)
				ELSE
					CALLF MAKE_INT(V_NAME, 1)
				ENDIF
				[ELSE]
				CALLF MAKE_INT(V_NAME, 1)
				[ENDIF]
			CASE "依頼実行可能条件"
				;実行可能は@COM_ABLE367も確認のこと
				CALLF MAKE_INT(V_NAME, 1)
				;成功/失敗処理はCARRYOUTで直接書く
				;SOURCEやITEM入手など、内容が複雑なので
			CASE "依頼消滅条件"
				;30％で消失
				SIF Add_Request_Should_Discard(ARG)
					CALLF MAKE_INT(V_NAME, 1)
		ENDSELECT
ENDSELECT
