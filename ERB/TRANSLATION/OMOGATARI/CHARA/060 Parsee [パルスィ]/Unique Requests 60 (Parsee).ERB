@M_KOJO_IRAI_UNIQUE_102_K60(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		B = (CFLAG:60:3100 / 10)
		PRINTFORMDW %CALLNAME:60%는 당신을 바라보고 있고, %HIS_HER(60)%은 벽에 등을 기댄 채 돌아선다.
		PRINTFORML 「%CALLNAME:MASTER%... I....」
		PRINTFORMDL %HIS_HER(60,1)%의 목소리가 갈라지며 말을 찾으려 애쓴다.
		PRINTFORML 「나 침대에서 응가했어.」
		PRINTFORML 「엄청 지독해. 청소하는 것 좀 도와줘.」
		PRINTFORMDW %HE_SHE(60,1)%는 당황하며 고개를 떨군다.
		PRINTL
		PRINTFORML 「어젯밤 잠을 자고 있었는데 갑자기 온몸에 지독한 악취와 불편한 축축함이 느껴지며 깨어났다.」
		IF B == 2
			PRINTFORML 「죄송해요. 자기 전에 화장실에 가지 않았어요.」
			PRINTFORML 「미리 갈 필요성을 느끼지 못했어요.」
		ELSE
			PRINTFORML 「죄송해요. 잠자리에 들 때 기저귀를 안 하고 있었어요.」
			PRINTFORML 「제 실수 문제는 낮에만 있는 거라고 생각했어요.」
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「나를 무지한 채로 두지 마! 지금 너무 창피해서 죽을 지경이야!」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTFORMW 「내 방으로 와라.」
		PRINTFORMDW 방에 들어서자, 익숙한 변기 실수(?)의 악취가 나기 시작한다.
		PRINTFORMDW 침대의 파란 시트 위에는 커다란 갈색 얼룩이 져 있고, 더러워진 잠옷 한 벌이 바닥에 놓여 있다.
		CALL PRINT_STRW, @"「만약 ITALIC누군가가 내가 침대를 어지럽혔다는 걸 알게 된다면, 내 정당성은 나락으로 떨어질 거야..」"
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「내 몸에 무슨 일이 일어난 건지 알아내 주세요!」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「나를 무지한 채로 두지 마! 지금 너무 창피해서 죽을 지경이야!」
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		PRINTFORMDW 당신은 더러운 팬티를 집어 주머니에 넣는다.
		PRINTFORML 「그냥 가져가. 기저귀님께서 분명 용도를 찾으실 거야.」
		PRINTFORML 「사실, 잠옷도 가져가도록 해.」
		PRINTFORMDL 당신은 잠옷도 안전한 곳으로 옮긴다.
		PRINTL
		PRINTFORMDL 당신은 피해를 확인하기 위해 침대로 걸어간다.
		PRINTFORMDL 오염물은 굳은 갈색인 듯하면서 반쯤 액체 상태이기도 하다. 이곳의 냄새는 더욱 지독하다.
		PRINTFORMDL 시트를 세탁한다 해도 %CALLNAME:60%의 사고 일부는 여전히 남아있을 것이다.
		PRINTFORMDL 당신은 매트리스가 괜찮은지 확인하려 침대 모퉁이의 오염된 시트를 들어 올린다.
		PRINTL
		;You take off the soiled sheets.
		PRINTFORMDW 오 이런, 침대가 망가졌어.
		PRINTFORMDW 얼룩이 매트리스를 더럽혔고 전혀 지워지지 않아.
		PRINTFORMDW 최고의 청소를 해도 누군가 사고 친 것처럼 냄새가 날 거야.
		PRINTFORML 「신이시여 저를 도와주소서.」
		PRINTFORML 「이건... 생각보다 훨씬 심하네. 내 침대를 구할 방법 같은 건 없어?」
		PRINTFORML 「그냥 이 악몽이 끝나기만 하면 좋겠어...」
		PRINTFORMDL %CALLNAME:60%은(는) 벽 쪽으로 걸어가 아래를 내려다본다.
		PRINTL
		PRINTFORML 「이것을 처리하려고 가게에서 완완만 침대 패드 한 팩을 방금 샀어.」
		PRINTFORML 「하나 꺼내서 얼룩에 대고 닦아봐. 사라지길 바라야지?」
		PRINTFORMDL 당신은 침대 옆의 「우니무 완완만」 패드 팩을 열고 하나를 뜯는다.
		PRINTFORMDL 패드를 열어 흡수되는 면에 패드를 놓고, 침대에 스며드는 액체 얼룩을 닦기 시작한다.
		PRINTFORMDL 상당히 시간이 걸리지만, 대부분의 오염 물질이 제거된다.
		PRINTFORMDL 희미한 냄새와 매트리스 위의 얼룩만이 이 사고가 일어났음을 알려주는 유일한 흔적으로 남는다.
		PRINTL
		PRINTFORML 「이런 일이 다시 일어나길 원하지 않아.」
		PRINTFORML 「이걸 막을 만한 조언 같은 게 있니?」
		CALL ASK_M( @"%CALLNAME:60%에게 기저귀를 채우고 잠자면서 지저분하게 만들라고 말한다.", 1, @"배변 훈련 가이드를 건네줘", ITEM:113, "취소", 1, )
		TFLAG:144 = RESULT
		SELECTCASE TFLAG:144
			CASE 0
				PRINTFORMDW 당신은 %CALLNAME:60%에게 그것에 대해 걱정하지 말라고 말한다.
				PRINTFORMDW 그냥 기저귀를 갈고, 자면서 대변을 보고 계속 잠만 잔다.
				PRINTFORMDW 그녀를 건조하게 유지하는 것도 중요하니, 당신은 또한 %CALLNAME:60%에게 보호를 우선시하라고 말한다.
				PRINTFORMDW 커버가 있는 두꺼운 기저귀, 침대젖 패드, 플라스틱 시트.
				PRINTL
				PRINTFORML 「음.... 잠잘 때 기저귀 차는 건 낮에 차는 것만큼 창피하진 않아.」
				PRINTFORML 「그리고 혹시라도 새면 저 완완맨들 잘 쓰도록 할게.」
				PRINTFORML 「아. 아... %K60_NAME_WITH_HONORIFICS("Yuugi")%이 왔을 때는 어떡하지.」
				PRINTFORML 「그녀는 밤용 패드를 금방 알아챌 거야.」
				PRINTL
				PRINTFORML 「이 기저귀들로는 내 사고 때문에 침대가 망가진 걸 생각하면 충분치 않을지도 몰라.」
				PRINTFORML 「그 '겐소우짱' 테이프 같은 거 사러 가게에 가봐야겠어.」
				PRINTFORML 「고마워, 그런 거지 뭐. 낮에는 그랬는데 이제 밤이네.」
				PRINTFORML 「나 정말 하루 종일 기저귀 차게 되는 건가 봐.」
			CASE 1
				PRINTFORMDW %CALLNAME:60%에게 화장실에 갈 수 있도록 기상 일정을 설정하라고 말한다.
				PRINTFORMW 「내가 자고 있을 때도 오는 거 아닐까? 깨어 있을 때의 모든 충동이 갑자기 밀려온다.」
				; PRINTFORMW 「Oh great, now I have to wake up on a schedule to make sure I don't shit the bed.」
				; PRINTFORMW 「Gee, thanks %CALLNAME:MASTER%.」
				PRINTL
		ENDSELECT
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「이걸 남은 평생을 살아야 한다니 말하지 마...」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
;parsee discovers her IBS

@M_KOJO_IRAI_UNIQUE_103_K60(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		B = (CFLAG:60:3100 / 10)
		C = (CFLAG:60:3101 / 10)
		PRINTFORML 「그래서 %nameArray:72:na_LastName%-씨에게 갔더니 %HE_SHE(72)%가 내가 "IBS"를 가지고 있다고 말했다.」
		PRINTFORML 「좀 더 구체적으로는 설사 같은 "IBS-D"라고 했다.」
		PRINTFORML 「그래서 내 배가 계속 아프고 갑자기 급하게 화장실에 가야 하는 일이 자꾸 생긴 것이다.」
		PRINTFORML 「%HE_SHE(72)%는 더 이상의 조치를 취하기 전에 "배뇨 일지"를 써야 한다고 말했다.」
		CALL PRINT_STRW, @"「이 망할 ITALIC년은 나를 계속 자지러지는 삶으로 버렸다.」"
		PRINTL
		IF B == 1
			;prioritize containment
			PRINTFORML 「다리 위의 사람들이 자꾸 나를 "응석받이 공주님", "겐소우짱 베이비", "기저귀 소녀"라고 부른다.」
			CALL PRINT_STRW, @"「그 마카이 신이 나에게 그 술을 주었을 때 내 인생은 뒤집혔지만, 이건 완전히 다른 차원의 일이야.」"
			CALL PRINT_STRW, @"「게다가, %K60_NAME_WITH_HONORIFICS("Yuugi")%은 우리가 어느 날 술을 마시면서 내 속옷이 더 두꺼워진 것을 봤다.」"
			PRINTFORML 「그녀는 내가 지금 기저귀를 찬다는 것을 알고 있어...」
			PRINTL
			PRINTFORML 「치마를 꼭 붙이고 다리를 모으려고 노력했지만, 너무 취해버렸어!」
			PRINTFORML 「그녀는 내 치마 밑을 들여다보더니 내가 그 "겐소우짱 팬티"를 입고 있는 걸 봤어.」
			PRINTFORMDW 파르시는 그녀의 치마를 들어 패드를 드러냈다.
			PRINTFORML 「그리고 확인하려고 기저귀를 만졌는데... 결국 다 망해버렸지.」
			PRINTFORMDW 그녀는 자신의 기저귀를 찰싹 때리자, 공기 중에 플라스틱이 구겨지는 소리가 울렸다.
			PRINTFORML 「그리고... 상황을 더 악화시키듯이... 배가 뒤틀리더니 나는 그냥...」
			PRINTFORML 「바로 그 바에서 유우기의 손이 내 패드에 닿은 채, 기저귀에 대고 변을 싸버렸어.」
			PRINTFORML 「너무 시끄럽고 지독한 냄새가 났어.... 집에 돌아와 갈아치울 때까지 나는 그것밖에 맡지 못했지.」
			PRINTFORMDW 그녀는 치마에서 손을 뗐다.
			PRINTL
			PRINTFORML 「그녀는 나의 실수가 바닥으로 향하고 있다는 점을 걱정한다, 그리고 정말 그렇다.」
			PRINTFORML 「하지만 그녀는 패드의 필요성과 유용성을 이해한다.」
			PRINTFORML 「그녀의 친구 중 한 명도 기저귀가 필요했다.」
			PRINTFORML 「심지어 긴 음주 세션 때도 그것들을 착용한다.」
			PRINTL
			PRINTFORML 「뭐, 적어도 이 물건이 내 문으로 배달됐잖아.」
			PRINTFORMDW 파르시가 주머니에서 흰 머리 인형을 꺼냈다.
			PRINTFORMDW 미니-%CALLNAME:102%야. 네가 유일하게 가지고 있어야 한다고 생각했는데.
			PRINTFORML 「그녀의 모든 작은 것들이 하나씩 가지게 돼.」
			PRINTFORMDW 그녀는 그 인형을 자신의 셔츠 위에 앉혔다.
			PRINTFORML 「가끔 말을 하고, 가끔은 조용해져 있어. 하지만 내가 그것에게 말을 걸 때마다 ~인 것 같아-」
			PRINTFORMDW 인형이 활성화되며 파르시의 셔츠에서 어깨로 부드럽게 이동했다.
			CALL SET_KOJO_COLOR(102)
			PRINTFORML 「당신의 작은 대변 문제에 대해 %조사처리(CALLNAME:MASTER,"에게")% 말해 줄까요?」
			CALL SET_KOJO_COLOR(60)
			PRINTFORML 「이 %CALLNAME:102%-상에게 소금을 뿌릴 필요는 없어...」
			PRINTFORMDW 인형은 조용해진다.
			PRINTFORML 「하지만 그녀가 있는 것의 가장 좋은 점은 내가 더 이상 혼자 기저귀를 갈 필요가 없다는 거야.」
			PRINTFORML 「그녀는 나를 정말 잘 바꿔주고 무료로 패드도 챙겨줘.」
		ELSEIF B == 2
			;prioritize prevention
		ELSEIF B == 3
			;you are an idiot that did the irish goodbye
			CALL M_KOJO_COLOR_K60_JEALOUS
			CALL PRINT_STRW, @"「그리고 내가 네 방 청소하길 바랐을 때 너는 그냥 꺼지기로 결정했으니까....」"
			CALL PRINT_STRW, @"「냄새가 더 심해졌다.」"
			CALL PRINT_STRW, @"「치라이덴의 모든 사람이 내가 나 자신을 배설한다는 것을 알고 있다.」"
		ENDIF
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「나를 무지한 채로 두지 마! 지금 너무 창피해서 죽을 지경이야!」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTFORMW 「고마워. 정말 목숨을 구해줬어」
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「내 몸에 무슨 일이 일어난 건지 알아내 주세요!」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「나를 무지한 채로 두지 마! 지금 너무 창피해서 죽을 지경이야!」
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「이걸 남은 평생을 살아야 한다니 말하지 마...」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
