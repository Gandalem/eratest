@M_KOJO_IRAI_UNIQUE_101_K60(ROLE, SCENE, CLIENT_ID)
#DIMS ROLE     ;キャラの立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
;--------------------------------------------------
;RETURN 0 の部分は共通の口上が表示されます
;依頼ごとの口上を表示する部分は RETURN 0 を RETURN 1 にしてください
;--------------------------------------------------
SELECTCASE SCENE
	CASE "依頼提示時"
		PRINTFORML 「마카이의 그 신은 나에게 도대체 무슨 짓을 한 거야...」
		PRINTFORMDL 파르시는 당신을 바라보며 입가에 찌푸림을 만든다.
		CALL PRINT_STRL, @"「나는 그게... ITALIC 악취 풍기는 사이코패스가 나에게 준 쓰레기 같은 걸 마셨다.」"
		PRINTFORML 「그리고 이제 일하는 도중에 가끔 배 주변이 아파요.」
		PRINTFORML 「그 경련을 없애려고 하면 다리를 건너는 사람들이 제가 악취가 난다고 하면서 목욕을 해야 한다고 말해요.」
		PRINTFORML 「저도 실수로 소변을 봐요! 정말 끔찍해요!」
		PRINTFORML 「참으려고 하면 너무 고통스러워서 전혀 일을 할 수가 없어요!」
		PRINTFORML 「팬티를 내리면 그 안에 불규칙한 갈색 물질이 있어요.」
		PRINTFORMDL 그녀는 지금 대변을 봐야 하지만, 아직 그것을 명확히 모르고 있다.
		PRINTL
		PRINTFORML 「나를 도와줘야 해! 이대로는 더 이상 살 수 없어!」
		RETURN 1
	CASE "依頼非受託時"
		PRINTDATAL
			DATAFORM 「나를 무지한 채로 두지 마! 지금 너무 창피해서 죽을 지경이야!」
		ENDDATA
		RETURN 1
	CASE "依頼受託時"
		PRINTFORMW 「고마워. 정말 목숨을 구해줬어」
		RETURN 1
	CASE "依頼確認時"
		PRINTFORML 「내 몸에 무슨 일이 일어난 건지 알아내 주세요!」
		RETURN 1
	CASE "依頼破棄時"
		PRINTFORML 「나를 무지한 채로 두지 마! 지금 창피해서 죽겠어!」
		RETURN 1
	CASE "依頼実行直前"
		RETURN 0
	CASE "依頼実行直後"
		RETURN 0
	CASE "成功報告時"
		;報酬：
		SELECTCASE TFLAG:144
			CASE 0
				PRINTFORMDW 당신은 가방에서 풀업 기저귀를 꺼내 %CALLNAME:60%에게 보여준다.
				PRINTFORMDW %HE_SHE(60,1)%이 그것을 가져가서 %HE_SHE(60)%이 고무줄을 당기는 동안 들어 보이며, %HIS_HER(60)%의 얼굴에 인상을 찌푸린 채 살펴본다.
				PRINTFORML 「%CALLNAME:MASTER%. 저게 뭐야?」
				PRINTFORMDW 당신은 그것이 풀업 기저귀라고 %HIM_HER(60)%에게 말한다.
				PRINTFORMW 「그게 내 경련에 어떻게 도움이 된다는 거야!」
				PRINTFORMDW 당신은 한숨을 쉬며 %HIM_HER(60)%에게 %HE_SHE(60)%이 지금 대변을 봐야 한다고 말한다.
				PRINTL
				PRINTFORMDW %CALLNAME:60%이 진홍색으로 변한다.
				PRINTFORMW 「그게... 경련의 원인인가...」
				PRINTFORMW 「그리고 왜 그걸 없애려고 할 때 내가 냄새가 나는지...」
				PRINTFORMDW %HE_SHE(60,1)%은 절망하며 %HIS_HER(60)%의 손을 %HIS_HER(60)%의 얼굴에 묻는다.
				PRINTFORMW 「풀업... 기저귀! 내가 통제할 수 없으니까 기저귀를 차야 해!」
				PRINTFORMDW 너는 쓰다듬는다 %CALLNAME:60%의 어깨를 토닥이며 당신이 말하길 %HIM_HER(60)% ~라는 것을 %HE_SHE(60)% 그것이 익숙해질 때까지 필요할 뿐 %HE_SHE(60)% 익숙해질 때까지
				PRINTL
				PRINTFORMW 「음, 이 빌어먹을 것들을 익숙해질 때까지 계속 차야겠지...」
				RESETCOLOR
				CALL DiaperChangeDesc(60,73,MASTER)
				CALL SET_KOJO_COLOR(60)
				PRINTFORMW 「적어도 입기에 편하니까.」
				PRINTFORMW 「내 팬티를 입고 악취나 발진을 일으키는 것보단 이쪽이 나아.」
				PRINTL
				PRINTFORMDW 아무런 경고도 없이, %CALLNAME:60%에게 갑작스럽고 절박한 경련이 찾아오며 %HE_SHE(60)%는 본능적으로 방출하기 시작한다.
				PRINTFORML 「아... 지금 하나 나올 것 같아...」 
				PRINTFORMDW %CALLNAME:60%는 몸을 웅크리고, 길게 숨을 들이마신 후 힘을 주기 시작했다.
				CALLF POOME(60)
				RESETCOLOR
				CALL PoopyDescribe(60,1)
				PRINTL
				CALL OMORASHI_END(60,0,1)
				CALL SET_KOJO_COLOR(60)
				PRINTFORMW 「하아아아........ 그것을 내뱉으니 기분이 좋았어....」
				PRINTFORMW 「게다가 냄새도 훨씬 덜 나네.」
				PRINTL
				PRINTFORMDW 방금 채운 %HIS_HER(60)% %PeeProtectType(60,2)%, 당신은 말한다 %CALLNAME:60% 라고 %HES_SHES(60)% 풀업에 전혀 맞지 않다고.
				PRINTFORMDW %CALLNAME:60%은 다시 새빨개진다.
				PRINTFORMW 「하지만... 정말 가야 했기 때문이야.」
				PRINTFORMDW 너는 갈아준다 %CALLNAME:60% 을 테이프 기저귀로 바꾸고 나서 %HIM_HER(60)% 내보내기 전에
				PRINTFORMDW 하지만 %HE_SHE(60)%은 %HES_SHES(60)%가 청소하고, 갈고, 보살핌을 받는 동안 살짝 미소를 짓는다.
				PRINTFORMW 「이거 익숙해지려면 꽤 오래 걸릴 거야, 확실히.」
				CALL COLORMESSAGE(@"%CALLNAME:60%은(는) 【%GET_TALENTNAME_TR(GETNUM(TALENT,"ContinenceIgnorant"),1)%】을(를) 잃었다!",C_AQUA,1)
				TALENT:60:ContinenceIgnorant = 0
				CALLF Panty_Rework_Change(60,102)
				CFLAG:60:3100 += 10
				RETURN IRAI_CONST_RESULT("実行して成功")
			CASE 1
				PRINTFORMDW 당신은 %CALLNAME:60%에게 배변 훈련 가이드를 건넨다.
				PRINTFORMDW %HE_SHE(60,1)%는 그것을 받아들고 %HIS_HER(60)%의 얼굴에 찡그린 채 살펴보았다.
				PRINTFORMW 「배변 훈련 가이드라니...」
				PRINTFORMW 「%CALLNAME:MASTER%. 나는 배변 훈련이 필요 없어.」
				PRINTFORMDW 당신은 %CALLNAME:60%에게 그것을 %HIS_HER(60)% 자신의 이익을 위해 읽으라고 말한다.
				PRINTFORMW 「그게 어떻게 내 생리통에 도움이 되겠어!」
				PRINTFORMDW 당신은 %HIM_HER(60)%에게 그것을 읽으라고 말한다.
				PRINTL
				PRINTFORMW 『방광에서 오는 압박감은 소변을 봐야 한다는 뜻이고, 위에서 오는 경련은 배변이 임박했음을 의미했다.』
				PRINTFORMW 「젠장? 나 지금 똥 싸야 돼!?」
				PRINTFORMDW 당신은 혼잣말로 한숨을 쉬고 %HIM_HER(60)%에게 %HE_SHE(60)%가 지금 배변해야 한다고 확인해 주었다.
				PRINTL
				PRINTFORMDW %CALLNAME:60%이 진홍색으로 변한다.
				PRINTFORMW 「이게... 경련의 원인인가...」
				PRINTFORMW 「그리고 그걸 없애려고 할 때 왜 내가 지독한 냄새가 나는 거지...」
				PRINTFORMDW %HE_SHE(60,1)%은(는) 절망하여 %HIS_HER(60)%의 얼굴에 %HIS_HER(60)%의 손을 박는다.
				PRINTL
				PRINTFORMW 「항상 소변이 마렵긴 했는데, 변의는 어때?」
				PRINTFORMW 「그건 정말로 말하고 싶지 않은 거야...」
				PRINTFORMW 「하지만 난 해야 해-」
				PRINTFORMDW 아무런 경고 없이 갑작스럽고 절박한 경련이 %CALLNAME:60% ~하면서 %HE_SHE(60)% 본능적으로 풀리기 시작한다.
				PRINTFORML 「오... 지금 뭔가 나오는 것 같아...」
				PRINTFORMDW %CALLNAME:60%는 쭈그리고 앉아 깊게 숨을 들이쉬며 밀기 시작한다.
				PRINTFORMDW 당신은 미친 듯이 %CALLNAME:60%의 %PeeProtectType(60)% 직전에 %HE_SHE(60)% 푸석한 엉망을 밀어내기 시작한다.
				CALLF POOME(60)
				PRINTL
				PRINTFORMDW 그것은 반액체 같으면서도 매우 부드럽다. %CALLNAME:60%가 비우는 데는 몇 초밖에 걸리지 않는다.
				PRINTL
				CALL TOILETING_END(60,0,1,1)
				CALL SET_KOJO_COLOR(60)
				PRINTFORMW 「하아아........ 그걸 내뱉으니 기분이 좋네....」
				; PRINTFORMW 「Just wished there was a potty nearby though.」
				; PRINTFORMW 「It's embarrassing to do it in the open...」
				PRINTFORMDW %HIS_HER(60)% 바지 이외의 곳에서 방금 %HIMSELF_HERSELF(60)%를 해치운 후, 당신은 %CALLNAME:60%의 등을 두드린다.
				PRINTFORMDW %CALLNAME:60% 머리가 아래로 움찔한다 %HE_SHE(60)% 그가 만든 난장판을 본다 %HE_SHE(60)% 방금 바닥에 만든
				PRINTFORMW 「이거... 내 변이야!?」
				PRINTFORMDW 당신은 정말로 말한다 %CALLNAME:60% 그것이 ~라는 것을 %HIS_HER(60)% 그녀가 방금 낳은 변
				PRINTFORMW 「사람들 앞에서 이렇게 하는 거 부끄러워...」
				PRINTFORMW 「특히 그렇게... 역겨워 보인다면.」
				PRINTFORMDW 너는 다음부터 바닥을 더럽히지 않으려면 %CALLNAME:60%가 화장실이나 변기에 가야 한다고 %CALLNAME:60%에게 말한다. 
				PRINTL
				PRINTFORMDW %CALLNAME:60%이 다시 진홍색으로 변한다.
				PRINTFORMW 「하지만... 정말 가야 할 필요가 있어서뿐이야.」
				PRINTFORMW 「근처에 화장실이 있었으면 좋았을 텐데. 공공장소에서 이러는 건 창피하잖아...」
				PRINTFORMDW 당신과 %CALLNAME:60% 화장실 의자를 두는 아이디어를 고려하다 %HE_SHE(60)% 보통 서 있는 곳에, 그래서 %HE_SHE(60)% 갈 수 있게 될 것이다 ~ 할 때 %HE_SHE(60)% 필요할 때
				PRINTFORMDW 당신은 물티슈를 집는다 %CALLNAME:60% 닦아내면서 %HE_SHE(60)% 대신한다 %HIS_HER(60)% 바지들을 갈아입고 다시 일어서다. 
				PRINTFORMW 「이거 익숙해지려면 꽤 오래 걸릴 거야, 확실히.」
				PRINTFORMW 「적어도 나는 다른 애들처럼 팬티를 적시지는 않아.」
				CALL COLORMESSAGE(@"%CALLNAME:60%은(는) 배변 조절에서 세 레벨을 얻었다!",C_AQUA,1)
				CALLF GAMANME_SEP(60,,PooHold:60:0+3)
				CALLF Panty_Rework_Change(60,102)
				CFLAG:60:3100 += 20
				RETURN IRAI_CONST_RESULT("実行して成功")
		ENDSELECT
		RETURN 1
	CASE "失敗報告時"
		PRINTDATAL
			DATAFORM 「이걸 남은 평생을 살아야 한다니 말하지 마...」
		ENDDATA
		RETURN 1
		;IF !RESULT
		;	PRINTFORML
	CASE "依頼報告不要"
		RETURN 0
ENDSELECT
