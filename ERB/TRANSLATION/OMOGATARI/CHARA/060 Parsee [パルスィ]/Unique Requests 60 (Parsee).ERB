		; 	RETURN IRAI_CONST_RESULT("実行して未解決")
		; ENDSELECT
		; ;CALL SET_REP(102,7,1,1)
		; 	SOURCE:歓楽 = 3000
		; 	RETURN IRAI_CONST_RESULT("実行して成功")
		; CASE "依頼成功時"
		; ;成功報告時の報酬など
		; 	CharaQuestline:TARGET:0:0 ++
		; 	;システムメッセージつき好感度変化
