SELECTCASE STR_DATA_IRAI(IRAI_ID, "依頼名", CLIENT_ID)
	;個々の依頼名で分岐
	CASE "Padded Jealousy I"
		SELECTCASE SCENE
			CASE "依頼条件表示"
				;何か専用の表示情報を設けたい時用
				;受託済みの依頼表示で使用されます
				;
				;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
				;ここ以外の表示項目は
				;PRINTFORML 　　　　　：
				;となっているのでスペースを揃えたほうが見栄えが良いです
			CASE "依頼実行時"
				;このCASEに限り、RESULTが意味を持ちます
				;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
				;可能な引数は"キャンセル", "実行して成功", "実行して失敗", "実行して未解決"です
				;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
				CALL ASK_M(@"「\@ nOmutsu ? 기저귀 %CALLNAME:60% #  \@」", nOmutsu, @"배변 훈련 가이드를 건네줘", ITEM:113, "취소", 1)
				TFLAG:144 = RESULT
				SELECTCASE TFLAG:144
					CASE 0
						PunishChange:60:0 = 1
					CASE 1
					CASE 2
						RETURN IRAI_CONST_RESULT("実行して未解決")
				ENDSELECT
				;CALL SET_REP(102,7,1,1)
				SOURCE:歓楽 = 3000
				RETURN IRAI_CONST_RESULT("実行して成功")
			CASE "依頼成功時"
				;成功報告時の報酬など
				CharaQuestline:TARGET:0:0 ++
				;システムメッセージつき好感度変化
				;最後の引数だけ好感度が変化
				CALL CHANGE_CFLAG(2, TARGET, 100)
				;システムメッセージつき信頼度変化
				;最後の引数だけ信頼度が変化
				CALL CHANGE_CFLAG(4, TARGET, 20)
			CASE "依頼失敗時"
				;失敗報告時の処理
				CALL CHANGE_CFLAG(2, TARGET, -10)
				CALL CHANGE_CFLAG(4, TARGET, -10)
		ENDSELECT
	CASE "Padded Jealousy II"
		;TODO
		; SELECTCASE SCENE
		; CASE "依頼条件表示"
		; ;何か専用の表示情報を設けたい時用
		; ;受託済みの依頼表示で使用されます
		; ;
		; ;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
		; ;ここ以外の表示項目は
		; ;PRINTFORML 　　　　　：
		; ;となっているのでスペースを揃えたほうが見栄えが良いです
