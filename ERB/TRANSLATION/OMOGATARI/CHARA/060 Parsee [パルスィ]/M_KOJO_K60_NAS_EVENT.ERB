@M_KOJO_EVENT_K60_102(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Sees it firsthand
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Reports the dead body
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:(ARG:1):Raider
			PRINTFORMW 「안타깝게도 %HE_SHE(ARG:1)%은 인생에서 다른 길을 선택하지 않았던 것 같군...」
			RETURN 1
		ENDIF
		SELECTCASE ARG:1
			CASE 1 ;Reimu
				IF KnowsDeadBodies:[[パルスィ]]:26
					;Using CALLNAME here in case Reimu already died and got replaced by another shrine maiden
					PRINTFORMW 「%K60_NAME_WITH_HONORIFICS(CALLNAME:1)%도?」
					$PARSEE_FREAKS_OUT
					PRINTFORMDW %CALLNAME:[[パルスィ]]%의 손이 떨리고 있다.
					PRINTFORMW 「이 미친놈은 우리가 모두 죽을 때까지 멈추지 않을 것이다. 그리고 이제 그들을 막을 사람이 아무도 없다...」
					PRINTFORMDW %CALLNAME:[[パルスィ]]% ~에게 쓰러져 %HIS_HER([[パルスィ]])% 손과 무릎으로 엎드려 히스테릭하게 울기 시작한다.
				ELSE
					PRINTFORMW 「신사 계곡의 여신이라고?!」
					PRINTFORMDW %CALLNAME:[[パルスィ]]% 삼킨다.
					PRINTFORMW 「이건 안 좋아. 정말로 나빠.」
					PRINTFORMW 「적어도 %HIM_HER(1)%은(는) %K60_NAME_WITH_HONORIFICS("Yukari")%가 복수해 줄 거야...」
				ENDIF
			CASE 17, 39, 87, 102, 103, 104, 105, 171 ;Makai People
				PRINTFORMW 「흥. 더러운 악마가 마땅한 대가를 치렀군.」
			CASE 26 ;Yukari
				IF KnowsDeadBodies:[[パルスィ]]:1
					PRINTFORMW 「%K60_NAME_WITH_HONORIFICS("Yukari")%도 벌써?」
					GOTO PARSEE_FREAKS_OUT
				ELSE
					PRINTFORMW 「아니. 이건... 그럴 리가...」
					PRINTFORMDW %CALLNAME:[[パルスィ]]%는 %CALLNAME:26%를 거의 다정하게 만진다.
					PRINTFORMDW %HIS_HER(26,1)%의 피부는 차갑다. 너무 차갑다.
					PRINTFORMW 「어떻게 사람에게 전설 속 현자의 목숨을 빼앗길 수 있지? 마치 태양을 꺼내려는 것 같아.」
					PRINTFORMW 「악몽일 뿐이야. 언제든 깨어나 따뜻한 침대에 누워 이런 일은 아무 일도 없었던 걸로 끝날 거야.」
				ENDIF
			CASE 37 ;Okuu
				PRINTFORMW 「%K60_NAME_WITH_HONORIFICS(CALLNAME:(ARG:1))%...」
				PRINTFORMDW %CALLNAME:[[パルスィ]]%는 흐느낌을 삼킨다.
				PRINTFORMW 「너는 항상 나에게 너무 친절했어. 그런데 이제 너는...」
				PRINTFORMW 「어떻게? 어떻게 누군가가 너처럼 강한 사람을 죽일 수 있지?」
				GOTO PRAYER_FOR_THE_SOUL_OF_THE_DEAD
			CASE 49 ;Satori
				PRINTFORMW 「%K60_NAME_WITH_HONORIFICS(CALLNAME:(ARG:1))%?!」
				PRINTFORMDW %CALLNAME:[[パルスィ]]%은(는) 무릎을 꿇고 %CALLNAME:(ARG:1)%의 목에 손을 올렸다.
				PRINTFORMDW 차갑고 뻣뻣했다.
				PRINTFORMDW %CALLNAME:[[パルスィ]]%은(는) %HIS_HER([[パルスィ]])%의 손을 내려 %CALLNAME:(ARG:1)%의 어깨로 옮기고 %HIM_HER(ARG:1)%를 흔들었다.
				PRINTFORMDW %BREAKENG(@"Then again. Then again and again, harder and harder until it finally gets through to %HIM_HER([[パルスィ]])% that %CALLNAME:(ARG:1)% is dead and %HE_SHE([[パルスィ]])% turns aside and buries %HIS_HER([[パルスィ]])% face in %HIS_HER([[パルスィ]])% hands.")%
			CASE 55 ;Byakuren
				PRINTFORMW 「%HE_SHE(ARG:1,1)%은 이제 %HIS_HER(ARG:1)%의 거짓말로 다른 누구도 잘못 이끌지 않을 것이다.」
				PRINTFORMDW %CALLNAME:[[パルスィ]]%는 비웃는다.
			CASE 64 ;Yuugi
				PRINTFORMW 「%K60_NAME_WITH_HONORIFICS("Yuugi")%?! No...」
				PRINTFORMDW %CALLNAME:[[パルスィ]]%는 %HIS_HER([[パルスィ]])%의 무릎으로 쓰러진다.
				PRINTFORMW 「이건 현실일 리 없어. 당신은 산의 4대 강자 중 가장 강한 사람이잖아.」
				PRINTFORMW 「그럴 리가...」
			CASE 83, 84 ;Kisume, Yamame
				PRINTFORMW 「누군가…」
				PRINTFORMW 「%K60_NAME_WITH_HONORIFICS(CALLNAME:(ARG:1))%를 죽였단 말인가?!」
				PRINTFORMW 「어떻게…?」
				PRINTFORMDW %CALLNAME:[[パルスィ]]%가 손을 뻗어 %CALLNAME:(ARG:1)%의 눈을 감는다.
				PRINTFORMW 「너는 나를 참아줄 유일한 사람들이었다. 그리고 지금은…」
				$PRAYER_FOR_THE_SOUL_OF_THE_DEAD
				PRINTFORMDW %CALLNAME:[[パルスィ]]%은/는 %CALLNAME:(ARG:1)%의 몸 위에서 무릎을 꿇고 조로아스터교 기도를 중얼거리기 시작한다.
				PRINTFORMW 「내가 너를 위해 복수할게, %K60_NAME_WITH_HONORIFICS(CALLNAME:(ARG:1))%. 약속해...」
				PRINTFORMDW 눈물이 %CALLNAME:[[パルスィ]]%의 얼굴을 타고 흘러 %CALLNAME:(ARG:1)%가 기도하면서 %HE_SHE([[パルスィ]])%의 몸 위로 떨어진다.
			CASE 97 ;Seija
				PRINTFORMW 「저 바보 아마노자쿠가 엉뚱한 사람에게 지껄인 것 같군.」
			CASEELSE
				PRINTFORMW 「%CALLNAME:(ARG:1)%?!」
				PRINTFORMDW %CALLNAME:[[パルスィ]]%은 무릎을 꿇고 %CALLNAME:(ARG:1)%의 어깨를 흔든다. %HE_SHE(ARG:1,1)%는 반응하지 않는다.
				SIF RELATION:TARGET:(ARG:1) < 100
					PRINTFORMW 「너를 좋아하지 않았어... 하지만 네가 죽는 건 원치 않았어!」
				IF IS_NONHUMAN(ARG:1)
					PRINTFORMW 「누가 너에게 이런 짓을 한 거니...?」
				ELSEIF !AutoReviveCondition(ARG:1) && (TALENT:(ARG:1):神霊 || TALENT:(ARG:1):幽霊 || TALENT:(ARG:1):妖精 || TALENT:(ARG:1):追加種族 == 4 || ARG:1 == 51 || ARG:1 == 92)
					PRINTFORMW 「어떻게...」
					PRINTFORMW 「너는 불멸자잖아! 죽을 리가 없어!」
					PRINTFORMDW %CALLNAME:[[パルスィ]]%의 등줄기를 타고 한기가 흘렀다.
					PRINTFORMW 「뱀파이어 사건만으로도 충분히 심각했어. 하지만 이것은...」
					PRINTFORMW 「이걸 한 녀석을 막지 못한다면 누가 그랬든 환상향 전체가 무너질 거야.」
				ELSE
					PRINTFORMW 「요괴는 먹어야 한다는 건 알지만... 그래도...」
				ENDIF
				PRINTFORMDW %CALLNAME:[[パルスィ]]%%CALLNAME:(ARG:1)%의 몸 위에서 무릎을 꿇고 조로아스터교 기도를 중얼거리기 시작한다.
		ENDSELECT
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Finds X is missing
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Reports to Nazrin
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
