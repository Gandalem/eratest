;Reputations
;This is for YOU getting the reputation
;【X now knows you as a Y】
;==================================================

@M_KOJO_EVENT_K60_104(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Has TSP
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		IF K60_TIMESTOP_MISCHIEF_DONE()
			PRINTFORMW 「네가 그놈이었어?!」
			PRINTFORMDW %CALLNAME:[[パルスィ]]% 이 악물고 %HIS_HER([[パルスィ]])% 있다.
			PRINTFORMW 「내가 네게 한 것에 대한 대가를 치르게 해줄 거야...」
		ELSE
			SELECTCASE K60_ATTITUDE()
				CASE 0, 1
					CALL M_KOJO_COLOR_K60_JEALOUS
					PRINTFORMW 「어떻게?」
					PRINTFORMDW %CALLNAME:[[パルスィ]]%가 너를 응시한다.
					PRINTFORMW 「그 힘을 어떻게 얻었지?」
					PRINTFORMW 「너, 그걸... 남용하지는 않았겠지?」
					CALL M_KOJO_COLOR_K60
				CASE 2
					PRINTFORMDW %CALLNAME:[[パルスィ]]% 당신에게서 뒷걸음질 친다. %HIS_HER([[パルスィ]],1)% 눈은 공포로 크게 떠 있다.
					PRINTFORMW 「너... 너는 시간을 멈출 수 있어?!」
					PRINTFORMW 「미안해! 내가 너에게 했던 말들에 대해 미안해!」
					PRINTFORMW 「제발 나를 해치지 말아줘...」
					;TODO set "knows you can stop time" flag once that update gets merged into NAS
				CASE 3
					CALL M_KOJO_COLOR_K60_JEALOUS
					PRINTFORMW 「너... 시간을 멈출 수 있단 거야?!」
					PRINTFORMDW %CALLNAME:[[パルスィ]]%의 턱이 빠진다.
					PRINTFORMW 「그래서 내가 너희들이 방에 드나드는 걸 한 번도 못 봤던 거구나...」
					CALL M_KOJO_COLOR_K60
					;TODO set "knows you can stop time" flag once that update gets merged into NAS
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Slut
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		SELECTCASE K60_ATTITUDE()
			CASE 0
				PRINTFORMW 「...네가 항상 나에게 돌아온다면, 나는 상관없을 거라고 생각해.」
				PRINTFORMW (그리고 어차피 나 같은 사람을 감당해 줄 다른 사람은 없을 테니 말이야...)
			CASE 1
				PRINTFORMW 「...뭐, 어차피 우리 전용 관계는 아니었잖아.」
			CASE 2
				PRINTFORMW 「%CALLNAME:MASTER%? 걸레라고?」
				PRINTFORMW 「정말? 난 상상도 못 했어.」
				PRINTFORMW 「다음엔 물이 젖는다고 하거나, %nameArray:55:na_LastName%가 악마들의 연인이라고 말할 거겠지.」
				$TEETH_GRIND
				PRINTFORMDW %CALLNAME:[[パルスィ]]%는 당신을 노려보며 %HIS_HER([[パルスィ]])%의 이를 갈았다.
			CASE 3
				PRINTFORMW 「바람을 타고 있군, 그건가. 알겠어.」
				GOTO TEETH_GRIND
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Panty Snatcher
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		SELECTCASE K60_ATTITUDE()
			CASE 0, 1
				PRINTFORMW 「%CALLNAME:MASTER%, 어떻게 그럴 수 있어?」
				PRINTFORMW 「속옷을 원했다면, 내가 가진 만큼 전부 줄 수도 있었는데!」
			CASE 2, 3
				PRINTFORMW 「만약 \@ IS_MALE(MASTER) ? 네가 그렇게 심하게 크로스드레스를 하고 싶다면, 왜 # 다른 여자들의 속옷에 그렇게 질투하는 거야, 왜 \@ 그냥 좀 사지 않았어?」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Skirt Flipper
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		SELECTCASE K60_ATTITUDE()
			CASE 0, 1
				PRINTFORMW 「그래서 말인데, 왜 그렇게 치마를 휘날리는 거야?」
				PRINTFORMW 「내 속옷이 너한테 충분히 섹시하지 않은 거니?」
			CASE 2
				PRINTFORMW 「너 정말 타락했구나.」
				PRINTFORMW 「나 이제 바지 입어야 할 것 같아. 그런데 존재하지도 않는 월급으로 그걸 어떻게 살 수 있지?」
			CASE 3
				PRINTFORMW 「정말로, %CALLNAME:MASTER%? 정말로?」
				PRINTFORMW 「누군가 네 속옷을 계속 들춰보는 상황이 어떤 기분일지 상상해 봤어?」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Rapist
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		SELECTCASE K60_ATTITUDE()
			CASE 0, 1
				PRINTFORMW 「%CALLNAME:MASTER%...」
				PRINTFORMDW %CALLNAME:[[パルスィ]]%는 %HIS_HER([[パルスィ]])%의 눈으로 믿을 수 없다는 듯 당신을 응시했다.
				PRINTFORMW 「당신이 욕망에 사로잡혀 있었다는 건 알고 있지만...」
				PRINTFORMW 「이게 그렇게 보이는 게 아니라고 말해줘! 제발...」
			CASE 2, 3
				PRINTFORMW 「당신은 저를 역겹게 만드네요.」
				PRINTFORMW 「죽음이야말로 당신에게 더 좋을 거예요.」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Impregnator
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		SELECTCASE K60_ATTITUDE()
			CASE 0
				IF EXP:[[パルスィ]]:出産経験
					PRINTFORMW 「하지만 우리는 이미 \@ EXP:出産経験 > 1 ? 아이들 # 아이를 가졌다 \@」
					$PARSAD
					PRINTFORMDW %CALLNAME:[[パルスィ]]%은 눈물 어린 %HIS_HER([[パルスィ]])%의 눈으로 당신을 응시한다.
					PRINTFORMW 「...나는 더 이상 충분하지 않은 걸까?」
					PRINTFORMW 「무엇을 해야 하는 거지?! 말해줘! 제발...!」
				ELSEIF VAR_OR_DEFAULT("MORELOVER")
					IF EXP:[[パルスィ]]:出産経験
						CALL M_KOJO_COLOR_K60_JEALOUS
						PRINTFORMW 「보아하니 우리 \@ EXP:出産経験 > 1 ? 아이들 # 아이 \@에게 곧 또 다른 놀이 친구가 생기겠네.」
						CALL M_KOJO_COLOR_K60
						PRINTFORMDW %CALLNAME:[[パルスィ]]%은(는) %HIS_HER([[パルスィ]])% 목소리에서 질투를 숨길 수 없다.
					ELSE
						GOTO NO_CHILDREN
					ENDIF
				ELSEIF CFLAG:[[パルスィ]]:生解禁 == 2
					PRINTFORMW 「하지만... 우리는 함께 아이를 가질 예정이었잖아...」
					PRINTFORMW 「너무 두려웠지만, 당신이 내 저주가 대물로 이어지지 않을 거라고 설득해 주었으니까...」
					PRINTFORMW 「그럼 왜 다른 여자에게 임신을 시킨 거야?」
					GOTO PARSAD
				ELSE
					$NO_CHILDREN
					CALL M_KOJO_COLOR_K60_JEALOUS
					PRINTFORMW 「나와는 아이를 가질 수 없는데도, 혹시 아이를 갖고 싶었니?」
					PRINTFORMW 「알겠어. 다른 여자들과 더 많은 아이를 원한다면, 나는 화내지 않을 거야.」
					CALL M_KOJO_COLOR_K60
				ENDIF
			CASE 1
				PRINTFORMW 「새로운 아이를 축하해요!」
