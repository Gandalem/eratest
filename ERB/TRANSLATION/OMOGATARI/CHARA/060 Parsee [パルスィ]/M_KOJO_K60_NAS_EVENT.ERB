	;-------------------------------------------------
	IF LOCAL:1 && ARG == 26
		SELECTCASE K60_ATTITUDE()
			CASE 0
				PRINTFORMW 「네가 훔친 모든 것을 돌려주고 피해자들에게 사과해라, 그렇지 않으면 나는 너와 헤어질 것이다.」
			CASE 1
				PRINTFORMW 「네가 훔친 모든 것을 돌려주고 피해자들에게 사과해라, 그렇지 않으면 다시는 너와 잠자지 않을 테니까.」
			CASE 2
				PRINTFORMW 「네가 훔친 모든 것을 돌려주고 피해자들에게 사과해라, 그렇지 않으면 네 손을 찢어버릴 테니.」
			CASE 3
