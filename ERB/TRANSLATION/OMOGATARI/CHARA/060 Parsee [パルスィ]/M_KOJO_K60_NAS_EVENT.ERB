				PRINTFORMW 「너처럼 퇴폐한 자는 살아남을 수 없다.」
		ENDSELECT
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Semen Demon
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 20
		SELECTCASE K60_ATTITUDE()
