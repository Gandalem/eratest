; Modular ERB: OMOGATARI/CHARA/180 Fortuneteller/Chara_data_180_Fortuneteller.ERB

@CHARAMOVE_DATA_180(ARG, ARG:2)
LOCAL = 180
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
		;たまに連動
		;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
		;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;よく居る
			CASE P621庭, P626台所, P628居間
				RETURN 5
				;幽々子様の私室にはあまり入らない
			CASE P623幽々子私室
				RETURN -5
				;私室系
			CASE P608潤美の家, P609瓔花の家, P615映姫の部屋, P616小町の部屋, P633紫私室, P635橙私室, P636八雲邸風呂, P638藍私室
				RETURN -100
			CASE P643霊長園の風呂 TO P655尤魔宅の風呂
				RETURN -100
				;是非曲直庁、畜生界は行きにくい
			CASE P610是非曲直庁ホール TO P618空き部屋, P640異界の関所 TO P655尤魔宅の風呂
				RETURN -5
		ENDSELECT
		;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜並木の鳥居, 神社境内, 神社縁側
				RETURN 1
			CASE お地蔵通り, 枝垂れ柳の下, 神霊廟広場, 神霊廟道場
				RETURN 1
			CASE 広場, 商家町, 呑屋小道, 長屋街
				RETURN 1
			CASE 中有の道, 三途の川, マヨヒガ, 彼岸, 白玉楼庭, 白玉楼
				RETURN 1
		ENDSELECT
		;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ180
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ180(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "呼び名"
		CALLF MAKE_STR(V_NAME, "Fortuneteller")
		;こっから衣装設定
	CASE "今日のパジャマ"
		CALLF MAKE_STR(V_NAME, "パジャマ（襦袢）セット")
	CASE "普段着：外衣"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("外衣", "マント"))
	CASE "普段着：靴"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴", "ロングブーツ"))
	CASE "普段着：靴下"
		IF FLAG:2 > 0
			CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "ガーターストッキング"))
		ELSE
			CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "靴下"))
		ENDIF
	CASE "普段着：ワンピース"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("ワンピース", "ゴスロリドレス"))
	CASE "固有コマンド"
		CALLF MAKE_STR(V_NAME, "FortuneTeller")
	CASE "固有コマンド実行可能"
		CALLF MAKE_INT(V_NAME, 1)
		;料理関連
	CASE "料理：好きな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：嫌いな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：助手効果"
		CALLF MAKE_STR(V_NAME, "/")
		;贈り物関連
	CASE "感性：好き"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "感性：嫌い"
		CALLF MAKE_STR(V_NAME, "/")
ENDSELECT

@UNIQUE_COM_FortuneTeller
#DIM CLIENT_ID
IF CFLAG:[[霊夢]]:現在位置 == CFLAG:MASTER:現在位置 && SHIRAHU(1) && !PLAYING_AS(1)
	PRINTFORML 갑자기 %CALLNAME:1% ~을 향해 휘두른다 %CALLNAME:180% 머리 쪽으로 %HIS_HER(1)% 정화봉으로
	PRINTFORML 가엾은 점술가는 둘로 갈라진다.
	FOR LOCAL,1,CHARANUM
	IF CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置
		BASE:LOCAL:理性 = MAXBASE:LOCAL:理性
		BASE:LOCAL:ムード = 0
	ENDIF
	NEXT
	IF nNecro
		CALL SET_HISTORY_DEATH(180,1,EQUIP:1:Weapon)
	ELSE
		CALLF BEGONE(180)
	ENDIF
	LOCAL:1 ++
ELSE
	PRINTFORML 「점술이 당신 앞에 길을 열어준다.」
	$EKISYA
	CALL ASK_M("오늘의 운세", !GETBIT(FLAG:999, 1), "도움이 필요한 사람을 찾아라", 1, "손톱깎이", BASE:MASTER:TSP >= 20, "미라다의 돌을 없앤다 (매력 100)", MONEY:2 >= 100, "엄지 척", 1, "공물을 바쳐라", TALENT:MASTER:Religion == 6)
	SELECTCASE RESULT
		CASE 0
			SELECTCASE RAND:10
				CASE 0
					TFLAG:幸運補正 = 3
					PRINTFORML 「굉장하지 않아, 복권이라도 해보는 건 어때?」
				CASE 1 TO 3
					TFLAG:幸運補正 = 1
					PRINTFORML 「좋아, 많은 행운이 쌓였어.」
				CASE 4,5
					PRINTFORML 「좋지도 나쁘지도 않다.」
				CASE 6 TO 8
					TFLAG:幸運補正 = -1
					PRINTFORML 「너무 좋지 않아, 무모하게 굴지 마라.」
				CASE 9
					TFLAG:幸運補正 = -3
					PRINTFORML 「... 이건 안 좋아, 조용히 해둬.」
			ENDSELECT
		CASE 1
			CLIENT_ID = SEARCH_UNIQUE_COM_人助け()
			IF !CLIENT_ID
				PRINTFORML 「음... 특별히 보이는 사람은 없다.」
				PRINTFORML 「다른 건 없으니, 현재 신사 마이가 나를 노리고 있다.」
				PRINTFORML 아무도 없는 것 같다.
			ELSE
				PRINTFORML 「%CALLNAME:CLIENT_ID%는 도움이 필요한 것 같다」
			ENDIF
		CASE 2
			PRINTFORMW 당신이 %CALLNAME:180%를 보면 갑자기 그를 괴롭히고 싶어진다.
			PRINTFORMW ...저 손톱은 뭐야?
			PRINTFORML 그가 더 이상 인간이 아니기 때문인지 모르겠지만, 저렇게 긴 손톱은 이상해 보인다.
			PRINTFORML 불편하지 않아? 실수로 사람을 할지도 않잖아?
			PRINTFORML 너는 섬세한 부위를 안전하게 만지기 위해 매일 네 손톱을 확인한다.
			PRINTFORML 그가 실수로 누군가를 긁으면 상당히 아플 것이다.
			PRINTFORMW 우선, 손톱 밑에는 더러움이 쌓인다.
			PRINTFORMW 참지 못하고 너는 시간을 멈추고 %CALLNAME:180%의 손톱을 자른다.
			PRINTFORMW 당신은 엄청난 성취감을 느낀다...
			PRINTFORML 반면에, %CALLNAME:180%는 갑자기 짧아진 자신의 손톱에 혼란스러워한다...
			CALL RECOVER_PERMIL(MASTER,40,"気力")
			BASE:MASTER:TSP -= 20
		CASE 3
			PRINTFORML 누구를 사라지게 해야 할까요?
			FOR LOCAL,1,CHARANUM
			SIF CFLAG:LOCAL:体目当て
				PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
			NEXT
			PRINTFORML 
			DRAWLINE
			PRINTFORML [999] 신경 쓰지 마
			INPUT
			IF RESULT == 999
				GOTO EKISYA
			ELSEIF CFLAG:RESULT:体目当て
				PRINTFORML 「그런 도구들은 소용없다고 생각한다.」
				PRINTFORMW %CALLNAME:180%가 복잡한 의식을 행하자, 미라다의 돌은 빛을 잃고 부서진다.
				TIME += 25
				CFLAG:RESULT:体目当て = 0
				MONEY:2 -= 100
			ENDIF
		CASE 4
			PRINTFORML 당신은 %CALLNAME:180%의 시선과 마주하고 그에게 엄지손가락을 치켜세운다.
			PRINTFORML 그는 잠시 망설이다가, 이내 전력을 다해 엄지손가락을 치켜세운다.
			PRINTFORMW 강한 우정이 맺어졌다.
			GOTO EKISYA
		CASE 5
			PRINTFORML 당신은 시간을 멈추고, %CALLNAME:180%의 옷을 벗긴 뒤 그의 속옷을 신에게 바친다.
			CALL BUFF_BASE(MASTER,BASE_TSP,100,1)
			PRINTFORMW %CALLNAME:180%은 갑자기 벌거벗겨져서 모든 평정을 잃는다.
	ENDSELECT
	PRINTFORMW 
	DRAWLINE
	$EKISYA_DIVIDE
	IF SHIRAHU(1) && nRyona
		PRINTFORML %CALLNAME:1%이 갑자기 나타나더니 정화봉으로 %CALLNAME:180%의 머리를 휘두른다...
		CALLF TP(1)
		CALL KNIFE_FIGHT(1,180)
	ELSE
		PRINTFORML 점쟁이가 틈으로 뛰어들더니 사라지고, 그 틈이 닫힌다.
		CALLF BEGONE
	ENDIF
ENDIF
