; Modular ERB: OMOGATARI/CHARA/159 SinGyoku/Chara_data_156_SinGyoku.ERB

@CHARAMOVE_DATA_159(ARG, ARG:2)
LOCAL = 159
SELECTCASE ARG
	;連動設定（RETURN=依存するキャラ, RESULT:1～3=対等に連動するキャラ）
	CASE 1
		;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
		;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;よく居る
			CASE P2境内, P10縁側
				RETURN 5
				;他所
			CASE P30三妖精の家・風呂, P39夢幻遺跡・浴室, P56あうんの棲家
				RETURN -100
				;addition custom code, kourindou
			CASE P502香霖堂
				RETURN 3
		ENDSELECT
		;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜並木の鳥居, 神社境内, 神社本堂, 神社縁側
				RETURN 1
			CASE 広場, 商家町, 呑屋小道, 長屋街
				RETURN 1
				;addition custom code, kourindou
			CASE 香霖堂
				RETURN 1
		ENDSELECT
		;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ159
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ159(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "呼び名"
		CALLF MAKE_STR(V_NAME, "SinGyoku")
		;こっから衣装設定
	CASE "今日のパジャマ"
		CALLF MAKE_STR(V_NAME, "パジャマ（ワンピース）セット")
	CASE "上半身上着２"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("上半身上着２", "長着"))
	CASE "普段着：外衣"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("外衣", "ケープ"))
	CASE "普段着：その他１"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("その他１", "リボン"))
	CASE "普段着：靴"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴", "靴"))
	CASE "普段着：靴下"
		CALLF MAKE_INT(V_NAME, CLOTHES_ID("靴下", "靴下"))
	CASE "固有下着形容詞"
		CALLF MAKE_STR(V_NAME, "끊임없이 변하는")
	CASE "固有下半身下着名"
		CALLF MAKE_STR(V_NAME, "shapeshifting panties")
	CASE "固有上半身下着"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "固有上半身下着名"
		CALLF MAKE_STR(V_NAME, "shapeshifting bra")
	CASE "固有下着着用条件"
		SIF !RAND:(3 - (2 * 勝負下着判定([[SinGyoku]])))
			CALLF MAKE_INT(V_NAME, 1)
	CASE "固有下着透ける(前)"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "固有下着透ける(後)"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "固有下着生地厚さ"
		CALLF MAKE_INT(V_NAME, 3)
		;料理関連
	CASE "料理：好きな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：嫌いな味"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "料理：助手効果"
		CALLF MAKE_STR(V_NAME, "/")
		;贈り物関連
	CASE "感性：好き"
		CALLF MAKE_STR(V_NAME, "/")
	CASE "感性：嫌い"
		CALLF MAKE_STR(V_NAME, "/")
ENDSELECT
