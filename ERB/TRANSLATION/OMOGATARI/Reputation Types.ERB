	CASE "Label"
		CALLF MAKE_STR(V_NAME, "야뇨증 환자")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"당신은 침대 위에서 사고를 치는 것이 발각되었다. 아마 보호받으며 잠자리에 들었어야 했을지도 모른다.")
	CASE "Score"
		IF TALENT:ARG:OmoGuardian
			LOCAL = 5
		ELSEIF EffectivePottyLevel(ARG) <= -2 || TALENT:ARG:汚臭耐性 >= 2
			LOCAL = 0
		ELSE
			LOCAL = -3
		ENDIF
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Reputation」")
