@EXIST_Reputation_ID
#LOCALSIZE 1
#LOCALSSIZE 1
;GET_INT(C_ID, "Weapon", P_ID, "Accuracy")
;要素名→ID変換用関数
;必要なら各オブジェクトで同様に作成のこと

@Reputation_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
	C_NAME:O_ID = %GET_STR(, "Reputation", O_ID, "Name")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF

@EXIST_Reputation0
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Reputation0(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "Has TSP")
	CASE "Label"
		CALLF MAKE_STR(V_NAME, "TSPer")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"당신은 시간 조작 능력을 사용하다가 발각되었다. 다른 TSP자들은 개의치 않지만.")
	CASE "Score"
		IF MAXBASE:ARG:0
			LOCAL = 0
		ELSE
			LOCAL = -5
		ENDIF
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Reputation」")
ENDSELECT

