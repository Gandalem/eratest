@Reputation7(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SIF !GETBIT(nPee,1) && !GETBIT(nScat,2)
	RETURNF
SELECTCASE O_DATA
	CASE "Name"
		CALLF MAKE_STR(V_NAME, "Not Potty Trained")
	CASE "Label"
		CALLF MAKE_STR(V_NAME, "포티 팬츠")
	CASE "Desc"
		CALLF MAKE_STR(V_NAME, @"당신은 사고를 내거나 요실금 문제가 있음을 암시하는 다른 행동을 했다.")
	CASE "Score"
		IF TALENT:ARG:OmoGuardian
			LOCAL = 5
		ELSEIF MAX(ABL:ARG:PeeAddict,ABL:ARG:PeeDrinkAddict,ABL:ARG:PooAddict,ABL:ARG:PooEatAddict) >= 2
			LOCAL = MIN(5,MAX(ABL:ARG:PeeAddict,ABL:ARG:PeeDrinkAddict,ABL:ARG:PooAddict,ABL:ARG:PooEatAddict)/2)
		ELSEIF EffectivePottyLevel(ARG) <= -2 || CharaDiaperChecker(ARG) || TALENT:ARG:汚臭耐性 >= 2 || PeeHold:MASTER:2 <= -5 || PooHold:MASTER:2 <= -5
			LOCAL = 0
		ELSE
			LOCAL = -5
		ENDIF
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Reputation」")
ENDSELECT

