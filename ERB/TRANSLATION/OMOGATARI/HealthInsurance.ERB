	PRINTFORMW ...
	PRINTFORMW ..
	PRINTFORMW .
    CALL MarketeersRecoverChara_After
ENDSELECT

@MarketeersRecoverChara_BillPlayer(ARG)
#DIM DYNAMIC medBill
SELECTCASE HealthInsuranceLevel
CASE IS >= 3
    ;iron or diamond
    RETURN
CASE 1
    medBill = 40000
CASE 2
    IF IsDead:ARG:0
        medBill = 40000
    ELSEIF !SHIRAHU(ARG)
        medBill = 18000
    ELSE
        medBill = 7500
    ENDIF
ENDSELECT

IF medBill
    PRINTFORML A squad member gives you a medical bill.
    PRINTFORMW The bill demands %金額表示(medBill)%
    IF MONEY >= medBill
        PRINTFORML You give the nurse the money needed, and the squad flies off.
        CALL PAY_MONEY_YEN(medBill,2)
    ELSE
        PRINTFORML However, you don't have the money to fully pay for it.
        PRINTFORML You pay the bill with the rest of the money you have and tell the team that you will pay for it later.
        CALL MarketeersDebtAdd(medBill-MONEY)
        MONEY = 0
    ENDIF
ENDIF

@MarketeersRecoverChara_After
#DIM medBill
medBill = 40000
PRINTFORML You were taken to a local clinic, where the doctors patch you up.
PRINTFORMW You get discharged 3 days later from the clinic, at which point you return back home.
PRINTFORMW You feel fine for the most part, and the sight of your repaired body fills you with thrill.
