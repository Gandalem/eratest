		; PRINTL
		; CALL PRINT_GP("W", @"The squad fines you %金額表示(5000)% for misusing the medic recovery system.")
		; CALL MarketeersDebtAdd(5000)
	CASE 87
		;dead player recovery (permadeath)
		CALL PRINT_GP("W", @"회복 대원이 와서 당신의 몸에 다가온다.")
		CALL PRINT_GP("W", @"그들은 당신의 맥박을 확인한다... 아무것도 없다.")
		CALL PRINT_GP("W", @"분대는 당신의 몸을 땅에 버리고 날아가 버린다.")
	CASE 88
		;dead player recovery (stone+)
		CALL PRINT_GP("W", @"네가 생명 없는 시신으로 땅에 누워 있는 것을 보며 작은 부대의 토끼 소녀들이 너에게 걸어오는 것이 보인다.")
		CALL PRINT_GP("W", @"흰색과 빨간색 옷을 입고 등에 소총을 메고 있는 그들은 당신이 등록한 의무병들인 것 같다.")
		PRINTL
		CALL PRINT_GP("W", @"회복 소대가 와서 당신의 몸에 접근한다.")
