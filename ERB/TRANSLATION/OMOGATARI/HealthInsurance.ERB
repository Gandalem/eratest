@MarketeersPharmacy
#DIM DYNAMIC nInput
#DIM DYNAMIC nCurrentPage
#DIM DYNAMIC nTempItem
#DIM DYNAMIC nPrice
#DIM DYNAMIC nColCount
#DIM DYNAMIC nThingOffset
#DIM DYNAMIC nThingGroup
#DIM DYNAMIC nThingCount,2
#DIM DYNAMIC nColLoop
#DIMS pharmacyCategories = "medCombat", "medDaily", "sexToy", "medIncontinence", "medBionic"
nCurrentPage = 0
;for some reason if the pharmacy does not have any items in 
IF !DT_EXIST("MarketeersPharmacy")
    CALL MarketeersPharmacyInvTablePopulate
    CALL MarketeersPharmacySellingTablePopulate
ENDIF

$REDO_LINE
PRINTDATAL
DATAFORM 「Take a look.」
DATAFORM 「%CALLNAME:47% may sell the tools that kill, but I sell tools that save.」
DATAFORM 「With a Marketeers Insurance subscription, you can save even more within the pharmacy.」
DATAFORM 「I sell my stuff at 20\% lower than market value to keep my customers happy.」
DATAFORM \@ nOmutsu ?「Gensou-chan makes the best pamps. Change my diaper.」 # REFRESH\@
DATAFORM \@ nPee ?「Get your pee going with a nice diuretic. It helps keep my bladder empty.」 # REFRESH\@
ENDDATA
IF HTML_GETPRINTEDSTR() == "REFRESH"
    ;refresh if genned line doesn't fit within fetish toggles
    CLEARLINE 1
    GOTO REDO_LINE
ENDIF

gLineCount = LINECOUNT
DO
FOR LOCAL, 0, VARSIZE("ITEM")
	CALL ITEMDATA(LOCAL, "SALES")
	ITEMSALES:LOCAL = RESULT
NEXT
CLEARLINE LINECOUNT-gLineCount
nColCount = 0
PRINTFORML Marketeers Pharmacy
CALL COLOR_LINE
; {
; DT_ROW_ADD @"MarketeersPharmacyAllItems",
; "defID", itemIsFake ? DT_CELL_GET("MarketeersPharmacyAllItems",LOCAL,"fakeID",0) # DT_CELL_GET("MarketeersPharmacyAllItems",LOCAL,"defID",0),
; "stock", DT_CELL_GET("MarketeersPharmacyAllItems",LOCAL,"stock",0),
; "itemType", DT_CELL_GETS("MarketeersPharmacyAllItems",LOCAL,"itemType",0),
; "category", DT_CELL_GETS("MarketeersPharmacyAllItems",LOCAL,"category",0),
; "price", itemIsFake ? DT_CELL_GET("MarketeersPharmacyAllItems",LOCAL,"fakePrice",0) # DT_CELL_GET("MarketeersPharmacyAllItems",LOCAL,"price",0),
; }
VARSET nThingCount
FOR nColLoop,0,DT_ROW_LENGTH("MarketeersPharmacy")
	SIF DT_CELL_GETS("MarketeersPharmacy",nColLoop,"category",0) != pharmacyCategories:nCurrentPage
		CONTINUE
    nThingCount:1++
NEXT

FOR nColLoop,0,DT_ROW_LENGTH("MarketeersPharmacy")
    nTempItem = DT_CELL_GET("MarketeersPharmacy",nColLoop,"defID",0)
    nThingOffset = 0
	SIF DT_CELL_GETS("MarketeersPharmacy",nColLoop,"category",0) != pharmacyCategories:nCurrentPage
		CONTINUE
    nThingCount:0++
	; ;diapers require diaper flag
	; SIF IsPadded(MASTER, , nColLoop:1) && !nOmutsu && nGroup == 6
	; 	CONTINUE
	nPrice = DT_CELL_GET("MarketeersPharmacy",nColLoop,"price",0)
	SELECTCASE DT_CELL_GETS("MarketeersPharmacy",nColLoop,"itemType",0)
    CASE "clothes"
        nThingGroup = nTempItem/10000
        nTempItem = nTempItem%10000
        nThingOffset = nThingGroup*10000
        IF BoughtClothing:nThingGroup:(nTempItem)
        	LOCALS:1 = Sold-out
        	SETCOLOR C_GRAY
        ELSEIF MONEY < nPrice
        	LOCALS:1 = %金額表示(nPrice)%
        	SETCOLOR C_GRAY
        ELSE
        	LOCALS:1 = %金額表示(nPrice)%
        ENDIF
    CASE "hediff"
        nThingGroup = -2
        nTempItem = nTempItem%1000000
        nThingOffset = 1000000
        IF HasBionic:(nTempItem-100) >= 所持数制限
        	LOCALS:1 = Full
        	SETCOLOR C_GRAY
        ELSEIF MONEY < nPrice
        	LOCALS:1 = %金額表示(nPrice)%
        	SETCOLOR C_GRAY
        ELSE
        	LOCALS:1 = %金額表示(nPrice)%
        ENDIF
    CASEELSE
        nThingGroup = -1
        SELECTCASE ITEMSTOCK(nTempItem, nPrice)
        CASE 1
            LOCALS:1 = Unavail.
            CONTINUE
        CASE 2
            LOCALS:1 = Sold-out
            SETCOLOR C_GRAY
        CASE 3
            LOCALS:1 = %金額表示(nPrice)%
            SETCOLOR C_GRAY
        CASE 4
            LOCALS:1 = Sealed
            CONTINUE
        CASE 5
            LOCALS:1 = Full
            SETCOLOR C_GRAY
        CASEELSE
            LOCALS:1 = %金額表示(nPrice)%
        ENDSELECT
    ENDSELECT

    LOCALS '= UNDIES_NAME_WITH_BRAND(MASTER,nTempItem,0,nThingGroup)
	PRINTBUTTON @"%LOCALS, 48, LEFT% %LOCALS:1, 11% ", (nTempItem+nThingOffset)
	RESETCOLOR
	nColCount ++
	IF nColCount % 3 == 0 || nThingCount:0 == (nThingCount:1)
		PRINTL 
		;表示行 ++
	ENDIF
NEXT
CALL COLOR_LINE
FOR nColLoop, 0, VARSIZE("pharmacyCategories")
    SIF nColLoop == nCurrentPage
        SETCOLOR C_AQUA
    PRINTBUTTON @"%MarketeersPharmacyCategoryLabel(pharmacyCategories:nColLoop)%   ", -1000-nColLoop
    RESETCOLOR
NEXT
PRINTL
PRINTFORML [-99] - Leave
INPUT
nInput = RESULT
VARSET LOCAL
SELECTCASE nInput
CASE -99
    RETURN
CASE IS <= -1000
    nCurrentPage = (nInput+1000)*(-1)
CASE IS >= 1000000
    LOCAL:2 = DT_SELECT("MarketeersPharmacy", @"defID = {nInput}")
    LOCAL:1 = RESULT:1
    nTempItem = nInput%1000000
    IF LOCAL:2
        IF HasBionic:(nTempItem-100)
            PRINTW Cannot carry any more.
            CONTINUE
        ELSE
            LOCAL:3 = DT_CELL_GET("MarketeersPharmacy",LOCAL:1,"price",1)
            PRINTFORML Purchase %UNDIES_NAME_WITH_BRAND(MASTER,nTempItem,1,nThingGroup)%?
            PRINTFORML Cost: %MONEYSTR(LOCAL:3)%
            LOCAL:4 = 1
            CALL PAY_YEN_OR_CM((LOCAL:3*LOCAL:4),(LOCAL:3*LOCAL:4)/CHARISMA_NOW())
            IF RESULT
                HasBionic:(nTempItem-100) ++
            ENDIF
        ENDIF
    ELSE
        PRINTFORMW Could not find an entry for bionic ID {nTempItem} (entry {nInput})! Report this!
    ENDIF
CASE IS >= 10000
    LOCAL:2 = DT_SELECT("MarketeersPharmacy", @"defID = {nInput}")
    LOCAL:1 = RESULT:1
    nThingGroup = nInput/10000
    nTempItem = nInput%10000
    nThingOffset = nThingGroup*10000
    IF LOCAL:2
        IF BoughtClothing:nThingGroup:(nTempItem)
            PRINTL Already have this.
            PRINTW (Go to your room to equip this item.)
            CONTINUE
        ELSE
            LOCAL:3 = DT_CELL_GET("MarketeersPharmacy",LOCAL:1,"price",1)
            PRINTFORML Purchase %UNDIES_NAME_WITH_BRAND(MASTER,nTempItem,1,nThingGroup)%?
            PRINTFORML Cost: %MONEYSTR(LOCAL:3)%
            LOCAL:4 = 1
            CALL PAY_YEN_OR_CM((LOCAL:3*LOCAL:4),(LOCAL:3*LOCAL:4)/CHARISMA_NOW())
            IF RESULT
                BoughtClothing:nThingGroup:nTempItem ++
            ENDIF
        ENDIF
    ELSE
        PRINTFORMW Could not find an entry for clothing ID {nInput}! Report this!
    ENDIF
CASE 0 TO 9999
    LOCAL:2 = DT_SELECT("MarketeersPharmacy", @"defID = {nInput}")
    LOCAL:1 = RESULT:1
    IF LOCAL:2
        SELECTCASE ITEMSTOCK(nInput)
        CASE 1, 4
            PRINTW Incorrect input
        CASE 2
            PRINTW Out of stock.
        CASE 5
            PRINTW Cannot carry any more.
        CASEELSE
            LOCAL:3 = DT_CELL_GET("MarketeersPharmacy",LOCAL:1,"price",1)
            CALL PRINT_ITEM_DESC(nInput)

            IF ITEMSALES:nInput != 1
                LOCAL:5 = MAX(MONEY/LOCAL:3,(MONEY:2*CHARISMA_NOW())/(LOCAL:3))
                PRINTFORML Please select the desired number of %ItemName_Full(nInput)% to purchase. (Cost %MONEYSTR(LOCAL:3)%/item  Owned: {ITEM:nInput})
                PRINTL [   1] １　　
                SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 5
                    PRINTL [   5] ５　　
                SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 10
                PRINTL [  10] １０　
                SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 20
                PRINTL [  20] ２０　
                SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 50
                PRINTL [  50] ５０　
                SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 100
                PRINTL [ 100] １００
                SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 250
                PRINTL [ 250] ２５０
                SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 500
                PRINTL [ 500] ５００
                SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 1000
                PRINTL [1000] １０００
                PRINTFORML [{MIN(所持数制限 - ITEM:nInput, LOCAL:5), 4}] As many as possible
                PRINTL
                PRINTFORML [-1] Back
                INPUT
                LOCAL:4 = RESULT
                IF LOCAL:4 <= 0
                    CONTINUE
                ENDIF
            ELSE
                PRINTFORML Purchase %ItemName_Full(nInput)%?
                LOCAL:4 = 1
            ENDIF
            CALL PAY_YEN_OR_CM((LOCAL:3*LOCAL:4),(LOCAL:3*LOCAL:4)/CHARISMA_NOW())
            IF RESULT
                CALL GET_ITEM(ITEMNAME:nInput, LOCAL:4, 2)
            ENDIF
        ENDSELECT
    ELSE
        PRINTFORMW Could not find an entry for item ID {nInput}! Report this!
    ENDIF
ENDSELECT
LOOP 1

;begin making the marketeers table
;this is the possible loot items
@MarketeersPharmacyInvTableStart(ARGS = "MarketeersPharmacyAllItems")
#FUNCTION
#DIMS nTableName
nTableName '= ARGS
DT_CREATE nTableName
DT_COLUMN_ADD nTableName, "defID", "int32"
;id for the counterfeit item. an ID of -1 means no fakes
DT_COLUMN_ADD nTableName, "fakeID", "int32"
;probability of the item being a counterfeit daily
;0 means always real, 255 means always fake
DT_COLUMN_ADD nTableName, "fakeChance", "int8"
;amount that will be sold.
DT_COLUMN_ADD nTableName, "stock", "int8"
;available types: "item", "weapon", "clothes"
DT_COLUMN_ADD nTableName, "itemType"
;price before insurance discounts
;by default this is 80% of the base price.
DT_COLUMN_ADD nTableName, "price", "int32"
;price of the counterfeit
DT_COLUMN_ADD nTableName, "fakePrice", "int32"
;category of the item in the shop
DT_COLUMN_ADD nTableName, "category"

@MarketeersPharmacySellingTableStart(ARGS = "MarketeersPharmacy")
#FUNCTION
#DIMS nTableName
nTableName '= ARGS
DT_CREATE nTableName
DT_COLUMN_ADD nTableName, "defID", "int32"
;amount that will be sold.
DT_COLUMN_ADD nTableName, "stock", "int8"
;available types: "item", "weapon", "clothes"
DT_COLUMN_ADD nTableName, "itemType"
;price before insurance discounts
;by default this is 80% of the base price.
DT_COLUMN_ADD nTableName, "price", "int32"
;category of the item in the shop
DT_COLUMN_ADD nTableName, "category"

;populate the tables
