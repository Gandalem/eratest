PRINTL
PRINTFORML [-99] - 나가기
INPUT
nInput = RESULT
VARSET LOCAL
SELECTCASE nInput
	CASE -99
		RETURN
	CASE IS <= -1000
		nCurrentPage = (nInput+1000)*(-1)
	CASE IS >= 1000000
		LOCAL:2 = DT_SELECT("MarketeersPharmacy", @"defID = {nInput}")
		LOCAL:1 = RESULT:1
		nTempItem = nInput%1000000
		IF LOCAL:2
			IF HasBionic:(nTempItem-100)
				PRINTW 더 이상 들 수 없다.
				CONTINUE
			ELSE
				LOCAL:3 = DT_CELL_GET("MarketeersPharmacy",LOCAL:1,"price",1)
				PRINTFORML %UNDIES_NAME_WITH_BRAND(MASTER,nTempItem,1,nThingGroup)%을 구매할 것인가?
				PRINTFORML 비용: %MONEYSTR(LOCAL:3)%
				LOCAL:4 = 1
				CALL PAY_YEN_OR_CM((LOCAL:3*LOCAL:4),(LOCAL:3*LOCAL:4)/CHARISMA_NOW())
				IF RESULT
					HasBionic:(nTempItem-100) ++
				ENDIF
			ENDIF
		ELSE
			PRINTFORMW 바이오닉 아이디 {nTempItem}(항목 {nInput}의 항목)에 대한 항목을 찾을 수 없습니다! 이것을 보고하세요!
		ENDIF
	CASE IS >= 10000
		LOCAL:2 = DT_SELECT("MarketeersPharmacy", @"defID = {nInput}")
		LOCAL:1 = RESULT:1
		nThingGroup = nInput/10000
		nTempItem = nInput%10000
		nThingOffset = nThingGroup*10000
		IF LOCAL:2
			IF BoughtClothing:nThingGroup:(nTempItem)
				PRINTL 이미 가지고 있습니다.
				PRINTW (이 아이템을 장착하려면 방으로 가세요.)
				CONTINUE
			ELSE
				LOCAL:3 = DT_CELL_GET("MarketeersPharmacy",LOCAL:1,"price",1)
				PRINTFORML 구매 %UNDIES_NAME_WITH_BRAND(MASTER,nTempItem,1,nThingGroup)%?
				PRINTFORML 비용: %MONEYSTR(LOCAL:3)%
				LOCAL:4 = 1
				CALL PAY_YEN_OR_CM((LOCAL:3*LOCAL:4),(LOCAL:3*LOCAL:4)/CHARISMA_NOW())
				IF RESULT
					BoughtClothing:nThingGroup:nTempItem ++
				ENDIF
			ENDIF
		ELSE
			PRINTFORMW 의류 아이디 {nInput}에 대한 항목을 찾을 수 없습니다! 이것을 보고하세요!
		ENDIF
	CASE 0 TO 9999
		LOCAL:2 = DT_SELECT("MarketeersPharmacy", @"defID = {nInput}")
		LOCAL:1 = RESULT:1
		IF LOCAL:2
			SELECTCASE ITEMSTOCK(nInput)
				CASE 1, 4
					PRINTW 잘못된 입력
				CASE 2
					PRINTW 품절입니다.
				CASE 5
					PRINTW 더 이상 들 수 없다.
				CASEELSE
					LOCAL:3 = DT_CELL_GET("MarketeersPharmacy",LOCAL:1,"price",1)
					CALL PRINT_ITEM_DESC(nInput)
					IF ITEMSALES:nInput != 1
						LOCAL:5 = MAX(MONEY/LOCAL:3,(MONEY:2*CHARISMA_NOW())/(LOCAL:3))
						PRINTFORML 구매할 %ItemName_Full(nInput)%의 원하는 수량을 선택해 주십시오. (개당 비용 %MONEYSTR(LOCAL:3)%, 보유량: {ITEM:nInput})
						PRINTL [   1] １　　
						SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 5
							PRINTL [   5] ５　　
						SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 10
							PRINTL [  10] １０　
						SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 20
							PRINTL [  20] ２０　
						SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 50
							PRINTL [  50] ５０　
						SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 100
							PRINTL [ 100] １００
						SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 250
							PRINTL [ 250] ２５０
						SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 500
							PRINTL [ 500] ５００
						SIF MIN(所持数制限 - ITEM:nInput, LOCAL:5) >= 1000
							PRINTL [1000] １０００
						PRINTFORML [최소(보유수 제한 - 아이템:nInput, LOCAL:5), 4] 가능한 한 많이
						PRINTL
						PRINTFORML [-1] 뒤로
						INPUT
						LOCAL:4 = RESULT
						IF LOCAL:4 <= 0
							CONTINUE
						ENDIF
					ELSE
						PRINTFORML %ItemName_Full(nInput)%을 구매한다?
						LOCAL:4 = 1
					ENDIF
					CALL PAY_YEN_OR_CM((LOCAL:3*LOCAL:4),(LOCAL:3*LOCAL:4)/CHARISMA_NOW())
					IF RESULT
						CALL GET_ITEM(ITEMNAME:nInput, LOCAL:4, 2)
					ENDIF
			ENDSELECT
		ELSE
			PRINTFORMW 아이템 ID {nInput}에 대한 항목을 찾을 수 없다! 이것을 보고해라!
		ENDIF
ENDSELECT
