@UNIQUE_COM_ChimataServices
#DIM SS_LINECOUNT
#DIM PAGE
#DIM SS_INPUT
#DIMS DISP_NAME = "General", "Insurance"
PAGE = 0
CALL M_KOJO_COLOR_K102
PRINTFORMDW %CALLNAME:141% smiles at you.
CALL SPTALK, 141, "笑顔", 0 , @"「Yea yeah. What do you want?」", 1
RESETCOLOR
CUSTOMDRAWLINE ━
SS_LINECOUNT = LINECOUNT
DO
	CLEARLINE LINECOUNT - SS_LINECOUNT
    RESETCOLOR
	TRYCALLFORM ChimataServices_Page_{PAGE}
    SETCOLOR C_GRAY
    CUSTOMDRAWLINE ━
    RESETCOLOR
    FOR LOCAL, 0, VARSIZE("DISP_NAME")
        SIF !STRLENS(DISP_NAME:LOCAL)
            CONTINUE
        SIF PAGE == LOCAL
            SETCOLOR 0x00FFFF
        ;exception for player character
        PRINTBUTTON DISP_NAME:LOCAL, LOCAL + 8000
        RESETCOLOR
        PRINTFORM 　　
    NEXT
	PRINTL
	CUSTOMDRAWLINE ━
    PRINTFORML [999] - Never mind
    INPUT
	SS_INPUT = RESULT
    SELECTCASE SS_INPUT
    CASE 8000 TO VARSIZE("DISP_NAME")+8000
        PAGE = SS_INPUT-8000
	CASE 999
		;CALL M_KOJO_COLOR_K102
		RETURN 1
	CASEELSE
		TRYCALLFORM ChimataServices_Input_{PAGE}(SS_INPUT)
    ENDSELECT
LOOP 1

@ChimataServices_Page_0


@ChimataServices_Page_1
PRINTFORM Your plan: 
IF HealthInsuranceLevel
    PRINTFORMSL HealthInsuranceLabels:HealthInsuranceLevel
    PRINTFORML Renews %PRINT_DATE_F(HealthInsuranceSignDay+31)%
ELSE
    SETCOLOR C_RED
    PRINTFORML NONE
    PRINTL
    RESETCOLOR
ENDIF
PRINTL
IF HealthInsuranceLevel
    PRINTFORML [100] - Change subscription tier
    PRINTFORML [101] - Cancel insurance
ELSE
    PRINTFORML [100] - Sign up
ENDIF
PRINTFORML [110] - Pharmacy

@ChimataServices_Input_1(nInput)
#DIM nInput,2
SELECTCASE nInput
CASE 100
    PRINTFORML Select a subscription level
    FOR LOCAL, 1, 5
        PRINTFORM [{LOCAL,2}] - %HealthInsuranceLabels:LOCAL% (%金額表示(HealthInsuranceCost:LOCAL)%/month)
        SIF LOCAL == HealthInsuranceLevel
            PRINTFORM (Current)
        PRINTL
    NEXT
    PRINTL
    PRINTFORML [-1] Back
    INPUT
    nInput:1 = RESULT
    SELECTCASE nInput:1
    CASE 1 TO 4
        CALL MarketeersInsuranceDescribe_Chimata(nInput:1)
        PRINTL
        PRINTFORML 「Do you want to sign up to this plan?」
        PRINTFORML 「The monthly cost is %金額表示(HealthInsuranceCost:(nInput:1))%/month」
        CALL ASK_YN()
        SELECTCASE RESULT
        CASE 0
            CALL PAY_MONEY_YEN(HealthInsuranceCost:(nInput:1), 1)
            HealthInsuranceLevel = nInput:1
            HealthInsuranceSignDay = DAY
            SIF !HealthInsuranceFirstSignDay
                HealthInsuranceFirstSignDay = DAY
            PRINTFORMW 「Thanks for signing up!」
            ; Thanks for coming back to us!
            PRINTL
            PRINTFORML 「Your subscription is valid for one month.」
            PRINTFORMW 「It will auto renew in 31 days.」
        CASEELSE
            RETURN
        ENDSELECT
    ENDSELECT
CASE 101
    CALL MarketeersInsuranceDescribe_Chimata(0)
    CALL ASK_YN()
    IF !RESULT
        HealthInsuranceLevel = 0
        HealthInsuranceSignDay = 0
        PRINTFORML The contract will be terminated.
    ELSE
    ENDIF
CASE 110
    CALL MarketeersPharmacy
ENDSELECT

