@MarketeersPharmacy
#DIM DYNAMIC nInput
#DIM DYNAMIC nCurrentPage
#DIM DYNAMIC nTempItem
#DIM DYNAMIC nPrice
#DIM DYNAMIC nColCount
#DIM DYNAMIC nThingOffset
#DIM DYNAMIC nThingGroup
#DIM DYNAMIC nThingCount,2
#DIM DYNAMIC nColLoop
#DIMS pharmacyCategories = "medCombat", "medDaily", "sexToy", "medIncontinence", "medBionic"
nCurrentPage = 0
;for some reason if the pharmacy does not have any items in
IF !DT_EXIST("MarketeersPharmacy")
	CALL MarketeersPharmacyInvTablePopulate
	CALL MarketeersPharmacySellingTablePopulate
ENDIF
$REDO_LINE
PRINTDATAL
	DATAFORM 「한번 보시죠.」
	DATAFORM 「%CALLNAME:47%은 죽이는 도구를 팔지 몰라도 나는 구하는 도구를 판다.」
	DATAFORM 「마케터스 보험 구독으로 약국 내에서 더욱 많은 비용을 절약할 수 있다.」
	DATAFORM 「나는 고객들을 만족시키기 위해 시장 가치보다 20\% 낮게 물건을 판매한다.」
	DATAFORM \@ nOmutsu ? 겐소우쨩이 제일 좋은 기저귀를 만들어줘. 내 기저귀 갈아줘. # REFRESH \@
	DATAFORM \@ nPee ? 좋은 이뇨제로 소변을 보게 해라. 방광이 비어 있게 도와준다. # REFRESH \@
ENDDATA
IF HTML_GETPRINTEDSTR() == "REFRESH"
	;refresh if genned line doesn't fit within fetish toggles
	CLEARLINE 1
	GOTO REDO_LINE
ENDIF
gLineCount = LINECOUNT
DO
FOR LOCAL, 0, VARSIZE("ITEM")
CALL ITEMDATA(LOCAL, "SALES")
ITEMSALES:LOCAL = RESULT
NEXT
CLEARLINE LINECOUNT-gLineCount
nColCount = 0
PRINTFORML 마케터스 약국
CALL COLOR_LINE
; {
; DT_ROW_ADD @"MarketeersPharmacyAllItems",
; "defID", itemIsFake ? DT_CELL_GET("MarketeersPharmacyAllItems",LOCAL,"fakeID",0) # DT_CELL_GET("MarketeersPharmacyAllItems",LOCAL,"defID",0),
; "stock", DT_CELL_GET("MarketeersPharmacyAllItems",LOCAL,"stock",0),
; "itemType", DT_CELL_GETS("MarketeersPharmacyAllItems",LOCAL,"itemType",0),
; "category", DT_CELL_GETS("MarketeersPharmacyAllItems",LOCAL,"category",0),
; "price", itemIsFake ? DT_CELL_GET("MarketeersPharmacyAllItems",LOCAL,"fakePrice",0) # DT_CELL_GET("MarketeersPharmacyAllItems",LOCAL,"price",0),
; }
VARSET nThingCount
FOR nColLoop,0,DT_ROW_LENGTH("MarketeersPharmacy")
SIF DT_CELL_GETS("MarketeersPharmacy",nColLoop,"category",0) != pharmacyCategories:nCurrentPage
	CONTINUE
nThingCount:1++
NEXT
FOR nColLoop,0,DT_ROW_LENGTH("MarketeersPharmacy")
nTempItem = DT_CELL_GET("MarketeersPharmacy",nColLoop,"defID",0)
nThingOffset = 0
SIF DT_CELL_GETS("MarketeersPharmacy",nColLoop,"category",0) != pharmacyCategories:nCurrentPage
	CONTINUE
nThingCount:0++
; ;diapers require diaper flag
; SIF IsPadded(MASTER, , nColLoop:1) && !nOmutsu && nGroup == 6
; 	CONTINUE
nPrice = DT_CELL_GET("MarketeersPharmacy",nColLoop,"price",0)
SELECTCASE DT_CELL_GETS("MarketeersPharmacy",nColLoop,"itemType",0)
	CASE "clothes"
		nThingGroup = nTempItem/10000
		nTempItem = nTempItem%10000
		nThingOffset = nThingGroup*10000
		IF BoughtClothing:nThingGroup:(nTempItem)
			LOCALS:1 = Sold-out
			SETCOLOR C_GRAY
		ELSEIF MONEY < nPrice
			LOCALS:1 = %金額表示(nPrice)%
			SETCOLOR C_GRAY
		ELSE
			LOCALS:1 = %金額表示(nPrice)%
		ENDIF
	CASE "hediff"
		nThingGroup = -2
		nTempItem = nTempItem%1000000
		nThingOffset = 1000000
		IF HasBionic:(nTempItem-100) >= 所持数制限
			LOCALS:1 = Full
			SETCOLOR C_GRAY
		ELSEIF MONEY < nPrice
			LOCALS:1 = %金額表示(nPrice)%
			SETCOLOR C_GRAY
		ELSE
			LOCALS:1 = %金額表示(nPrice)%
		ENDIF
	CASEELSE
		nThingGroup = -1
		SELECTCASE ITEMSTOCK(nTempItem, nPrice)
			CASE 1
				LOCALS:1 = Unavail.
				CONTINUE
			CASE 2
				LOCALS:1 = Sold-out
				SETCOLOR C_GRAY
			CASE 3
				LOCALS:1 = %金額表示(nPrice)%
				SETCOLOR C_GRAY
			CASE 4
				LOCALS:1 = Sealed
				CONTINUE
			CASE 5
				LOCALS:1 = Full
				SETCOLOR C_GRAY
			CASEELSE
				LOCALS:1 = %金額表示(nPrice)%
		ENDSELECT
ENDSELECT
LOCALS '= UNDIES_NAME_WITH_BRAND(MASTER,nTempItem,0,nThingGroup)
PRINTBUTTON @"%LOCALS, 48, LEFT% %LOCALS:1, 11% ", (nTempItem+nThingOffset)
RESETCOLOR
nColCount ++
IF nColCount % 3 == 0 || nThingCount:0 == (nThingCount:1)
	PRINTL 
	;表示行 ++
ENDIF
NEXT
CALL COLOR_LINE
FOR nColLoop, 0, VARSIZE("pharmacyCategories")
SIF nColLoop == nCurrentPage
	SETCOLOR C_AQUA
PRINTBUTTON @"%MarketeersPharmacyCategoryLabel(pharmacyCategories:nColLoop)%   ", -1000-nColLoop
RESETCOLOR
