		CALL PRINT_GP("W", @"분대가 당신의 시신을 회수하고 날아간다.")
		PRINTFORMW ...
		PRINTFORMW ..
		PRINTFORMW .
		CALL MarketeersRecoverChara_After
ENDSELECT

@MarketeersRecoverChara_BillPlayer(ARG)
#DIM DYNAMIC medBill
SELECTCASE HealthInsuranceLevel
	CASE IS >= 3
		;iron or diamond
		RETURN
	CASE 1
		medBill = 40000
	CASE 2
		IF IsDead:ARG:0
			medBill = 40000
		ELSEIF !SHIRAHU(ARG)
			medBill = 18000
		ELSE
			medBill = 7500
		ENDIF
ENDSELECT
IF medBill
	PRINTFORML 한 분대원이 당신에게 의료비를 건넨다.
	PRINTFORMW 그 청구서는 %金額表示(medBill)%를 요구한다.
	IF MONEY >= medBill
		PRINTFORML 당신이 간호사에게 필요한 돈을 주면, 분대는 날아간다.
		CALL PAY_MONEY_YEN(medBill,2)
	ELSE
		PRINTFORML 하지만, 당신은 그것을 전부 지불할 돈이 없다.
		PRINTFORML 당신은 가지고 있는 나머지 돈으로 청구서를 지불하고 팀에게 나중에 지불하겠다고 말한다.
		CALL MarketeersDebtAdd(medBill-MONEY)
		MONEY = 0
	ENDIF
ENDIF

@MarketeersRecoverChara_After
#DIM medBill
medBill = 40000
PRINTFORML 당신은 지역 병원으로 이송되어 의사들에게 치료를 받았다.
PRINTFORMW 당신은 3일 후 병원에서 퇴원하고 집으로 돌아간다.
PRINTFORMW 대체로 괜찮다고 느끼며, 복구된 자신의 몸을 본 모습에 전율을 느낀다.
SELECTCASE HealthInsuranceLevel
	CASE IS >= 3
		medBill = 0
		PRINTFORMW 간호사가 당신에게 진료비를 주지만, 건강보험 등급 덕분에 당신의 비용은 아주 두툼한 0이다.
		PRINTFORMW 당신은 영수증을 쓰레기통에 넣으며 미소를 지은 채 클리닉을 나선다.
	CASEELSE
		IF HealthInsuranceLevel == 2
			medBill = 18000
			SIF IsDead:MASTER:0
				medBill = 40000
		ENDIF
		PRINTFORML 간호사가 당신에게 진료비를 건다.
		PRINTFORMW 그 청구서는 %金額表示(medBill)%을 요구한다.
		IF MONEY >= medBill
			PRINTFORML 당신은 간호사에게 필요한 돈을 주고 병원을 떠난다.
			PRINTFORMW 간호사는 행복해 보인다.
			CALL PAY_MONEY_YEN(medBill,2)
		ELSE
			PRINTFORML 하지만, 당신은 그것을 전부 지불할 돈이 없다.
			PRINTFORML 남은 돈으로 청구서를 내고 간호사에게 나중에 지불하겠다고 말한다.
			CALL MarketeersDebtAdd(medBill-MONEY)
			MONEY = 0
		ENDIF
ENDSELECT
