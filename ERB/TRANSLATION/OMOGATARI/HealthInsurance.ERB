@ChimataServices_Input_1(nInput)
#DIM nInput,2
SELECTCASE nInput
	CASE 100
		PRINTFORML 구독 레벨을 선택해라
		FOR LOCAL, 1, 5
		PRINTFORM [{LOCAL,2}] - [%HealthInsuranceLabels:LOCAL%] (%金額表示(HealthInsuranceCost:LOCAL)%/월)
		SIF LOCAL == HealthInsuranceLevel
			PRINTFORM (현재)
		PRINTL
		NEXT
		PRINTL
		PRINTFORML [-1] 뒤로
		INPUT
		nInput:1 = RESULT
		SELECTCASE nInput:1
			CASE 1 TO 4
				CALL MarketeersInsuranceDescribe_Chimata(nInput:1)
				PRINTL
				PRINTFORML 「이 플랜에 가입하시겠습니까?」
				PRINTFORML 「월 비용은 %金額表示(HealthInsuranceCost:(nInput:1))%/월입니다」
				CALL ASK_YN()
				SELECTCASE RESULT
					CASE 0
						CALL PAY_MONEY_YEN(HealthInsuranceCost:(nInput:1), 1)
						HealthInsuranceLevel = nInput:1
						HealthInsuranceSignDay = DAY
						SIF !HealthInsuranceFirstSignDay
							HealthInsuranceFirstSignDay = DAY
						PRINTFORMW 「가입해 주셔서 감사합니다!」
						; Thanks for coming back to us!
						PRINTL
						PRINTFORML 「당신의 구독은 한 달 동안 유효합니다.」
						PRINTFORMW 「그것은 31일 후에 자동 갱신될 것입니다.」
					CASEELSE
						RETURN
				ENDSELECT
		ENDSELECT
	CASE 101
		CALL MarketeersInsuranceDescribe_Chimata(0)
		CALL ASK_YN()
		IF !RESULT
			HealthInsuranceLevel = 0
			HealthInsuranceSignDay = 0
			PRINTFORML 계약은 해지될 것이다.
		ELSE
		ENDIF
	CASE 110
		CALL MarketeersPharmacy
ENDSELECT
