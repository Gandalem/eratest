@MarketeersInsuranceRenew
#DIM renewCost
IF HealthInsuranceLevel
    renewCost = HealthInsuranceCost:HealthInsuranceLevel
    renewCost += HealthInsuranceDebt
    ; SIF !MAIN_MAP
    ;     renewCost = 30
    IF MONEY:2 < renewCost
        PRINTFORML Ran out of money, so the insurance contract has ended.
        HealthInsuranceLevel = 0
        HealthInsuranceSignDay = 0
    ELSE
        ;custom code, show cm cost and current charisma
        PRINTFORML Renew your health insurance contract?
        PRINTFORML Current Plan: %HealthInsuranceLabels:HealthInsuranceLevel% (%金額表示(renewCost)%)
        PRINTFORML Debt: %金額表示(HealthInsuranceDebt)%
        PRINTFORML Renewal Cost: %金額表示(renewCost)%
        PRINTL
        PRINTFORML Current Money: %金額表示(MONEY)%
        CALL ASK_YN
        IF !RESULT
            PRINTFORMW The contract has been renewed.
            CALL PAY_MONEY_YEN(renewCost, 2)
            HealthInsuranceSignDay = DAY
            HealthInsuranceDebt = 0
        ELSE
            HealthInsuranceLevel = 0
            HealthInsuranceSignDay = 0
            PRINTFORMW The contract will be terminated.
        ENDIF
    ENDIF
ENDIF