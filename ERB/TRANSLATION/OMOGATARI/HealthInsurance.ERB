@MarketeersPharmacySellingTablePopulate
#DIM DYNAMIC fakeChance
#DIM DYNAMIC itemIsFake
DT_RELEASE "MarketeersPharmacy"
CALLF MarketeersPharmacySellingTableStart
FOR LOCAL, 0, DT_ROW_LENGTH("MarketeersPharmacyAllItems")
    fakeChance = DT_CELL_GET("MarketeersPharmacyAllItems",LOCAL,"fakeChance",0)
    itemIsFake = 0
