		CALL PRINT_GP("W", @"작은 버니걸 분대 하나가 당신의 구역으로 날아오지만 목표가 바닥에 쓰러져 있는 것을 본다.")
		CALL PRINT_GP("W", @"그들은 %HIS_HER(ARG)%의 맥박을 확인한다... 아무것도 없다.")
		IF PermaDeath >= 2
			CALL PRINT_GP("W", @"분대는 구출하기에 너무 멀어서 생명 없는 %CALLNAME:ARG%를 돌보기를 거부한다.")
		ELSE
			CALL PRINT_GP("W", @"분대는 당신의 보험 플랜이 불충분하여 생명 없는 %CALLNAME:ARG%를 돌보기를 거부한다.")
