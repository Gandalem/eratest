;Knowledge
;;#; PRINTFORMW Leveling Knowledge
WHILE EXP:ARG:学習経験 > EXPLV:(MAX(ABL:ARG:教養 + 3 - TALENT:ARG:50,0)) || (EXP:ARG:学習経験 > 5 && ABL:ARG:教養 == 0)
SIF ABL:ARG:教養 >= MaxNonHLevel
	BREAK
ABL:ARG:教養 ++
CALL NAMED_ABLCHANGE(ARG,43,ABL:ARG:43,ABL:ARG:43-1)
