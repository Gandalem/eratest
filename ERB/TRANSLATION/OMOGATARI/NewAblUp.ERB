SIF TALENT:ARG:234 >= nMaxTech
	BREAK
TALENT:ARG:234++
PRINTFORMW %CALLNAME:ARG%의 기술적 지식이 【%AllTechLevels(TALENT:ARG:234)%】로 증가했다!
WEND
;Cooking
;;#; PRINTFORMW Leveling Cooking
WHILE EXP:ARG:料理経験 > EXPLV:(MAX(ABL:ARG:料理技能 + 3 - TALENT:ARG:50,0)) || (EXP:ARG:料理経験 > 5 && ABL:ARG:料理技能 == 0)
SIF ABL:ARG:料理技能 >= MaxNonHLevel
	BREAK
ABL:ARG:料理技能 ++
CALL NAMED_ABLCHANGE(ARG,44,ABL:ARG:料理技能,ABL:ARG:料理技能-1)
;技能レベルアップ口上,5,料理技能
CALL KOJO_MESSAGE_SEND("EVENT", 34, ARG, 5)
IF ARG == MASTER && ABL:ARG:料理技能 >= 9 && !TALENT:MASTER:健啖
	PRINTFORMW 당신은 이제【대식가】입니다!
	TALENT:MASTER:健啖 = 1
ENDIF
WEND
;Foraging
;;#; PRINTFORMW Leveling Foraging
WHILE EXP:ARG:採集経験 > EXPLV:(MAX(TALENT:ARG:採集Lv + 3 - TALENT:ARG:50,0)) || (EXP:ARG:採集経験 > 5 && TALENT:ARG:採集Lv == 0)
SIF TALENT:ARG:採集Lv >= MaxNonHLevel
	BREAK
TALENT:ARG:採集Lv ++
CALL NAMED_ABLCHANGE(ARG,46,TALENT:ARG:採集Lv,TALENT:ARG:採集Lv-1)
WEND
;Music
;;#; PRINTFORMW Leveling Music
WHILE (MAX(EXP:ARG:演奏経験, EXP:ARG:歌唱経験, EXP:ARG:舞踏経験) > EXPLV:(MAX(ABL:ARG:音楽技能 + 3 - TALENT:ARG:50,0))) || (MAX(EXP:ARG:演奏経験, EXP:ARG:歌唱経験, EXP:ARG:舞踏経験) > 20 && ABL:ARG:音楽技能 == 0)
SIF ABL:ARG:音楽技能 >= MaxNonHLevel
	BREAK
ABL:ARG:音楽技能 ++
CALL NAMED_ABLCHANGE(ARG,45,ABL:ARG:音楽技能,ABL:ARG:音楽技能-1)
IF ARG == MASTER && ABL:ARG:音楽技能 == UniversalRank("C")
	PRINTW 이제 바이올린을 연주할 수 있게 되었다!
ENDIF
;技能レベルアップ口上,7-0,音楽技能（7-1～はEVENTTURNENDで）
CALL KOJO_MESSAGE_SEND("EVENT", 34, ARG, 7, 0)
WEND
IF ARG == MASTER && EXP:ARG:演奏経験 >= 1000 && ABL:ARG:技巧 >= 9 && !TALENT:ARG:音楽知識 == 1
	PRINTFORMW 당신은 악기에 대한 광범위한 지식을 얻었다.
	PRINTFORMW 이제 【음악적 지식】을 가지고 있다.
	TALENT:ARG:音楽知識 = 1
	CALL QoL_Info_Write(ARG, Qol_Dates_Musicality) ;qol custom code
ENDIF
IF ARG == MASTER && EXP:ARG:演奏経験 >= 5000 && !TALENT:ARG:音感 == 1
	PRINTFORMW 당신의 목소리는 완벽하게 단련되었다.
	PRINTFORMW 당신은 이제 【음감】을 갖게 되었다.
	TALENT:ARG:音感 = 1
	CALL QoL_Info_Write(ARG, Qol_Dates_Sound) ;qol custom code
ENDIF
;Fishing
;;#; PRINTFORMW Leveling Fishing
WHILE EXP:ARG:釣り経験 > EXPLV:(MAX(TALENT:ARG:釣りLv + 3 - TALENT:ARG:50,0)) || (EXP:ARG:釣り経験 > 5 && TALENT:ARG:釣りLv == 0)
