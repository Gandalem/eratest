;Finger
;;#; PRINTFORMW Leveling Finger
LOCAL = EXP:ARG:手淫経験
LOCAL:1 = 10 + ABL:ARG:技巧 / 2 + TALENT:ARG:器用な指 * 2 + TALENT:ARG:習得速度
WHILE LOCAL * LOCAL:1 / 10 > EXPLV:(MAX(ABL:ARG:指 + 3 - TALENT:ARG:50,0)) / 2; && EXP_UP(24,ARG)
