;Youjutsu
;Youjutsu Danmaku is already covered above so we don't need that
FOR LOCAL,1,64
SIF !YoujutsuPossible(ARG,LOCAL)
	CONTINUE
WHILE YoujutsuExp:ARG:LOCAL:0 > EXPLV:(YoujutsuLevel:ARG:LOCAL + 3) || (YoujutsuExp:ARG:LOCAL:0 > 5 && YoujutsuLevel:ARG:LOCAL == 0)
SIF YoujutsuLevel:ARG:LOCAL >= MaxNonHLevel
	BREAK
YoujutsuLevel:ARG:LOCAL++
CALL NAMED_ABLCHANGE(ARG,66600+LOCAL,YoujutsuLevel:ARG:LOCAL,YoujutsuLevel:ARG:LOCAL-1)
WEND
NEXT
;orgasm denial
LOCAL:90 = OrgasmDeny:ARG:0
;Endurance skills use two while loops.
WHILE OrgasmDenyExp:ARG:0 >= EXP_DEMAND_19(0,90,ARG,1)
SIF OrgasmDeny:ARG:0 >= 5
	BREAK
OrgasmDeny:ARG:0 ++
CALL NAMED_ABLCHANGE(ARG,19,OrgasmDeny:ARG:0,LOCAL:90)
