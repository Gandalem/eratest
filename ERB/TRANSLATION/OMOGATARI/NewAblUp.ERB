; Modular ERB: OMOGATARI/NewAblUp.ERB
;NAS ABLUP
;Allows for better and more symmetrical leveling ups
;Now levers up all when possible

@SOURCE_ABLUP_NAS(ARG)
TFLAG:145 = 0
;Danmaku
;;#; PRINTFORMW Leveling Danmaku
WHILE EXP:ARG:戦闘経験 > EXPLV:(MAX(ABL:ARG:戦闘能力 + 3 - TALENT:ARG:50,0)) || (EXP:ARG:戦闘経験 > 5 && ABL:ARG:戦闘能力 == 0)
SIF ABL:ARG:戦闘能力 >= MaxNonHLevel
	BREAK
ABL:ARG:戦闘能力 ++
CALL NAMED_ABLCHANGE(ARG,42,ABL:ARG:42,ABL:ARG:42-1)
;技能レベルアップ口上,1,戦闘能力
CALL KOJO_MESSAGE_SEND("EVENT", 34, ARG, 1)
WEND
;Shooting
;;#; PRINTFORMW Leveling Shooting
WHILE EXP:ARG:Shooting > EXPLV:(MAX(ABL:ARG:Shooting + 3 - TALENT:ARG:50,0)) || (EXP:ARG:Shooting > 5 && ABL:ARG:Shooting == 0)
SIF ABL:ARG:Shooting >= MaxNonHLevel
	BREAK
ABL:ARG:Shooting ++
CALL NAMED_ABLCHANGE(ARG,66,ABL:ARG:66,ABL:ARG:66-1)
;技能レベルアップ口上,1,戦闘能力
CALL KOJO_MESSAGE_SEND("EVENT", 34, ARG, 1)
WEND
;Melee
