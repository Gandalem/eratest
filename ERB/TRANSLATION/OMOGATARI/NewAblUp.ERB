;orgasm denial
LOCAL:90 = OrgasmDeny:ARG:0
;Endurance skills use two while loops.
WHILE OrgasmDenyExp:ARG:0 >= EXP_DEMAND_19(0,90,ARG,1)
	SIF OrgasmDeny:ARG:0 >= 5
		BREAK
	OrgasmDeny:ARG:0 ++
	CALL NAMED_ABLCHANGE(ARG,19,OrgasmDeny:ARG:0,LOCAL:90)
WEND
WHILE (OrgasmDenyExp:ARG:0 < (EXP_DEMAND_19(0,90,ARG,-1)) || (OrgasmDenyExp:ARG:0 < EXP_DEMAND_19(0,90,ARG) && OrgasmDenyExp:ARG:0 > 0))
	SIF OrgasmDeny:ARG:0 <= -5
		BREAK
	OrgasmDeny:ARG:0 --
	CALL NAMED_ABLCHANGE(ARG,19,OrgasmDeny:ARG:0,LOCAL:90)
WEND
