	IF ARG == MASTER
		PRINTFORMW 이제 최음제를 사용할 수 있게 되었다!
	ELSE
		PRINTFORMW %HE_SHE(ARG,1)%은 이제 최음제를 사용할 수 있게 되었다!
	ENDIF
ENDIF
;技能レベルアップ口上,4,教養
CALL KOJO_MESSAGE_SEND("EVENT", 34, ARG, 4)
WEND
;Technology Knowledge
;;#; PRINTFORMW Leveling Tech Knowledge
