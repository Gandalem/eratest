; Modular ERB: OMOGATARI/GoingOutEvents.ERB

@YukariFlashBangsYou
#DIM nFlashFadeFrames
nFlashFadeFrames = 300
CALL PRINT_GP("L", "걸어가는데 갑자기 몸에 돌 같은 것이 부딪히는 것을 느꼈다.")
CALL COLORMESSAGE("!!! 섬광탄이다 !!!",C_RED,1,1)
PRINTL [0] 고개를 돌려라
PRINTL [1] 점프해!
IF MAXBASE:MASTER:TSP
	PRINTL [2] - 세계다! 시간을 멈춰라! (35 TSP)
ELSE
	PRINTPLAINFORM [2] - ？？？？？
	PRINTL
ENDIF
IF MAXBASE:MASTER:TSP
	PRINTL [3] - 건너뛰기! (50 MP)
ELSE
	PRINTPLAINFORM [3] - ？？？？？
	PRINTL
ENDIF
TINPUT 1500, 1, -1
SELECTCASE RESULT
	CASEELSE
		PLAYSOUND "OMOGATARI/flashBang.wav"
		CLEARLINE LINECOUNT
		SETBGCOLOR 0xffffff
		REPEAT nFlashFadeFrames
		SETCOLOR Color_Gradient_PER(0xffffff, GETCONFIG("Background Color"), COUNT*100/nFlashFadeFrames)
		REND
		CALL PRINT_GP("L", "정말 숨이 멎을 정도였다.")
		CALL PRINT_GP("L", "너는 하기 전 무엇을 하고 있었는지 기억하지 못한다.")
ENDSELECT
