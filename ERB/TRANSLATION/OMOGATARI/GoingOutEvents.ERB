@YukariFlashBangsYou
#DIM nFlashFadeFrames
nFlashFadeFrames = 300

CALL PRINT_GP("L", "As you're walking, you suddenly feel some sort of rock hit your body.")
CALL COLORMESSAGE("!!! IT'S A FLASHBANG !!!",C_RED,1,1)
PRINTL [0] - Look your head away
PRINTL [1] - Jump!
IF MAXBASE:MASTER:TSP
	PRINTL [2] - The World! Stop Time! (35 TSP)
ELSE
	PRINTPLAINFORM [2] - ？？？？？
	PRINTL
ENDIF
IF MAXBASE:MASTER:TSP
	PRINTL [3] - Skip! (50 MP)
ELSE
	PRINTPLAINFORM [3] - ？？？？？
	PRINTL
ENDIF
TINPUT 1500, 1, -1
SELECTCASE RESULT
CASEELSE
	PLAYSOUND "OMOGATARI/flashBang.wav"
	CLEARLINE LINECOUNT
	SETBGCOLOR 0xffffff
	REPEAT nFlashFadeFrames
	SETCOLOR Color_Gradient_PER(0xffffff, GETCONFIG("Background Color"), COUNT*100/nFlashFadeFrames)
	REND
	CALL PRINT_GP("L", "That really knocked the wind out of you.")
	CALL PRINT_GP("L", "You don't remember what you were doing before.")
ENDSELECT