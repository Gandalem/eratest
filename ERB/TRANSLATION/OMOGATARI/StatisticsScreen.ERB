VARSET KillCount
VARSET InconCount
淫乳人数 = 0
淫壺人数 = 0
尻穴狂い人数 = 0
キス魔人数 = 0
自慰狂い人数 = 0
VARSET MindBreakCount

FOR LOCAL, 40,48
	SIF ABL:MASTER:LOCAL > MaxNonHLevel
		CheatedStats = 1
NEXT
FOR LOCAL, 50,57
	SIF ABL:MASTER:LOCAL > MaxNonHLevel
		CheatedStats = 1
NEXT

FOR LOCAL,1,CHARANUM
	SIF TALENT:LOCAL:行きずり
		CONTINUE
	SIF TALENT:LOCAL:恋慕
		LoverCount ++
	SIF TALENT:LOCAL:セフレ
		SexFriendCount ++
	SIF CFLAG:LOCAL:生解禁 >= 2
		AllowsRawCount ++
	SIF CFLAG:LOCAL:清い交際
		PureRelationCount ++
	SIF CFLAG:LOCAL:ヤラせちゃった
		RapeCount ++
	SIF CFLAG:LOCAL:既成事実 & 合意_うふふ
		ConsentCount ++
	IF IsDead:LOCAL:0
		KillCount:1 ++
		SIF KilledBy:LOCAL:0 == MASTER
			KillCount ++
	ENDIF
	SIF TALENT:LOCAL:淫乳 || GETBIT (CFLAG:LOCAL:引き継ぎ, 5)
		淫乳人数 ++
	SIF TALENT:LOCAL:淫壺 || GETBIT (CFLAG:LOCAL:引き継ぎ, 3)
		淫壺人数 ++
	SIF TALENT:LOCAL:尻穴狂い || GETBIT (CFLAG:LOCAL:引き継ぎ, 4)
		尻穴狂い人数 ++
	SIF TALENT:LOCAL:キス魔 || GETBIT (CFLAG:LOCAL:引き継ぎ, 6)
		キス魔人数 ++
	SIF TALENT:LOCAL:自慰狂い
		自慰狂い人数 ++		
	SIF TALENT:LOCAL:5 && CharaTrauma:LOCAL:0 >= 3
		MindBreakCount ++
	SIF PeeHold:LOCAL:2 < 0 || PooHold:LOCAL:2 < 0
		InconCount:4 ++		
	SIF PeeHold:LOCAL:2 < 0
		InconCount ++
	SIF PooHold:LOCAL:2 < 0
		InconCount:1 ++				
	SIF PeeHold:LOCAL:2 <= -5
		InconCount:2 ++
	SIF PooHold:LOCAL:2 <= -5
		InconCount:3 ++						
NEXT


