@WeaponTypeDisplay(RawType)
#FUNCTIONS
#DIMS RawType
SELECTCASE RawType
	CASE "Firearm"
		RETURNF "화기"
	CASE "Explosive"
		RETURNF "폭발 무기"
	CASE "Youjutsu"
		RETURNF "요술"
	CASE "Melee"
		RETURNF "근접 무기"
	CASEELSE
		RETURNF RawType
ENDSELECT

@WeaponClassDisplay(RawClass)
#FUNCTIONS
#DIMS RawClass
SELECTCASE RawClass
	CASE "1H Blunt"
