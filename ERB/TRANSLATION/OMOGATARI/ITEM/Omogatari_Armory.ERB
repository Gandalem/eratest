		;cracked
		RETURN
	CASE "badUser"
		;unauthroized
		SETCOLOR C_RED
		FONTBOLD
		PRINTFORML %"잘못된 서명",44,RIGHT%
		FONTREGULAR
		RESETCOLOR
		PRINTL
		PRINTFORML 요미하리가 무기의 사용자가 진품이 아니었음을 감지했다.
		PRINTFORML 당신은 해당 무기의 등록된 소유자가 아닐 수 있다.
		PRINTL
		PRINTFORML 이 경우, 해당 무기를 당국에 압수해 주십시오.
		WAIT
		RETURN
	CASE "goodUser"
		;authorized
	CASE "canUse"
		$CanUse
		IF DT_CELL_GET("WeaponInventory", WeaponID, "antiTheftCracked", 1) || WeaponID < 600000000000000000
		ELSE
			SETCOLOR C_GREEN
			FONTBOLD
			PRINTFORML %"인증 유효",44,RIGHT%
			FONTREGULAR
			PRINTFORML %"요미하리를 이용해 주셔서 감사합니다",50,RIGHT%
			RESETCOLOR
		ENDIF
		WAIT
	CASE "setup"
		;setup
		TWAIT 500, 1
		PRINTFORML 무기 손잡이를 잡은 채로 유지해 주세요.
		PRINTFORML 무기를 놓지 마세요.
		FOR LOCAL, 0, 6
		CALL PRINT_COLORBAR(LOCAL, 5, 30, UNICODE(0x2585), UNICODE(0x2585), BASE_BCS(1), RESULT:1)
		PRINTFORM  {(100/5)*LOCAL,3}\%
		TWAIT 1000, 1
		SIF LOCAL != 5
			CLEARLINE 1
		NEXT
		TWAIT 500, 1
		PRINTL
		SETCOLOR C_GREEN
		FONTBOLD
		PRINTFORML %"무기를 등록해 주셔서 감사합니다",44,RIGHT%
		FONTREGULAR
		PRINTFORML %"요미하리 등록 완료",50,RIGHT%
		RESETCOLOR
		PRINTFORML
		PRINTFORML 앞으로 당신의 무기는 사용하기 위해 생체 인증을 요구하게 됩니다.
		PRINTFORML 이것은 당신의 무기가 잘못된 손에 들어가는 것을 방지합니다.
		PRINTL
		PRINTFORML 요미하리가 시작할 때, 이 메시지가 나타나며 무기의 소유주를 보여준다.
		PRINTL
		PRINTFORML %CENTER(@"다음 무기는 ~에게 등록되어 있다.",50)%
		PRINTFORML %CENTER(@"%NAME:ARG%",50)%
ENDSELECT
