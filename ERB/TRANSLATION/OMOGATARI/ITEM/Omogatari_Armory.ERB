;weaponPrice(DT_CELL_GET("WeaponInventory", 0, "id"),10)
@weaponPrice(ARG,nValueMultiplier=100,toDevelop=0,nValueMultiplierDeveloped=100)
#FUNCTION
#DIM DYNAMIC nValueMultiplier
#DIM DYNAMIC nValue
#DIM DYNAMIC nPresetID
#DIM DYNAMIC nWeaponID
#DIM DYNAMIC nAttID
#DIM DYNAMIC toDevelop
#DIM DYNAMIC nValueMultiplierDeveloped


SELECTCASE ARG
CASE IS >= 600000000000000000
nPresetID = DT_CELL_GET("WeaponInventory", ARG, "detectedPreset", 1)
nWeaponID = DT_CELL_GET("WeaponInventory", ARG, "def", 1)
CASE IS >= VAR_TEMP_MAX
nPresetID = ARG%VAR_TEMP_MAX
nWeaponID = GET_INT(, "WeaponPreset", nPresetID, "Base Weapon")
CASEELSE
nPresetID = 0
nWeaponID = ARG
ENDSELECT


IF toDevelop
	IF DevelopedWeapon:nWeaponID
		nValue = (GET_INT(, "Weapon", nWeaponID, "Price")*nValueMultiplierDeveloped/100)
	ELSE
		nValue = GET_INT(, "Weapon", nWeaponID, "Price")
	ENDIF
ELSE
	nValue = GET_INT(, "Weapon", nWeaponID, "Price")
ENDIF

IF ARG > VAR_TEMP_MAX
	FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
		SELECTCASE ARG
		CASE IS >= 600000000000000000
		nAttID = DT_CELL_GET("WeaponInventory", ARG, GetAttachmentType(LOCAL), 1)
		CASE IS >= VAR_TEMP_MAX
		nAttID = PresetAttachment(nPresetID,GetAttachmentType(LOCAL))
		ENDSELECT
		IF toDevelop
			IF GETVAR(@"Developed%GetAttachmentType(LOCAL,0)%:{nAttID}")
				nValue += (GET_INT(, GetAttachmentType(LOCAL,0), nAttID, "Price")*nValueMultiplierDeveloped/100)
			ELSE
				nValue += (GET_INT(, GetAttachmentType(LOCAL,0), nAttID, "Price"))
			ENDIF
		ELSE
			nValue += (GET_INT(, GetAttachmentType(LOCAL,0), nAttID, "Price"))
		ENDIF
	NEXT
ENDIF
SELECTCASE ARG
CASE IS >= 600000000000000000
	IF WeaponHasAntiTheft(,ARG)
		IF DT_CELL_GET("WeaponInventory", ARG, "antiTheftCracked", 1)
			nValue = (nValue*125/100)
		ELSEIF DT_CELL_GET("WeaponInventory", ARG, "antiTheftID", 1) 
			nValue = (nValue*35/100)
		ENDIF
	ENDIF
ENDSELECT


RETURNF (nValue*nValueMultiplier/100)


