@GetWeaponScore(ARG, GWR_CHARA = -1, GWR_MODE= -1)
#FUNCTION
#DIM DYNAMIC GWR_SCORE
#DIM DYNAMIC GWR_CHARA
#DIM DYNAMIC GWR_MODE
#DIM DYNAMIC GWR_INFLUENCE
SIF GWR_CHARA == -1
	GWR_CHARA = CSV_CHARANUM()
IF ARG > -1
	IF GWR_MODE == -1 && GET_INT(0, "Weapon", ARG, "Modes") > 1
		LOCAL:10 = 0
		LOCAL:11 = 0
		FOR LOCAL, 0, GET_INT(0, "Weapon", ARG, "Modes")
		IF GetWeaponScore(ARG, , LOCAL) > LOCAL:11
			LOCAL:10 = LOCAL
			LOCAL:11 = GetWeaponScore(ARG, , LOCAL)
		ENDIF
		NEXT
		RESULT:1 = LOCAL:10
		RETURNF LOCAL:11
	ENDIF
	;DEBUGPRINTFORML Getting points score for %GET_STR(GWR_CHARA, "Weapon", ARG, "名前")%
	CALLF COM_WEAPSTATS(GWR_CHARA, ARG, 1, GWR_MODE, 1)
ENDIF
GWR_SCORE = previewWeaponInts:Damage
GWR_SCORE *= MAX(1,previewWeaponInts:Pellets)
IF previewWeaponInts:MagSize
	GWR_SCORE *= LIMIT(previewWeaponInts:Burst,1,previewWeaponInts:MagSize)
ELSE
	GWR_SCORE *= MAX(1,previewWeaponInts:Burst)
ENDIF
GWR_SCORE *= MAX(1,previewWeaponInts:MultiHit)
GWR_SCORE = GWR_SCORE*previewWeaponInts:Accuracy/100
;penetration, minimum 1
GWR_INFLUENCE = (100 + (LIMIT(previewWeaponInts:Penetration,1,72)-5) * 50/100)
GWR_SCORE = GWR_SCORE*GWR_INFLUENCE/100
;range
GWR_INFLUENCE = (100 + (LIMIT(previewWeaponInts:Range,1,40)-6) * 20/100)
GWR_SCORE = GWR_SCORE*GWR_INFLUENCE/100
;MAX(1,previewWeaponInts:MagSize/previewWeaponInts:Burst)
IF previewWeaponInts:MagSize
	GWR_INFLUENCE = (80 + ((LIMIT(MAX(1,previewWeaponInts:MagSize/MAX(1,previewWeaponInts:Burst)),1,20)*3)-15) * 20/100)
	GWR_SCORE = GWR_SCORE*GWR_INFLUENCE/100
ENDIF
RETURNF GWR_SCORE

