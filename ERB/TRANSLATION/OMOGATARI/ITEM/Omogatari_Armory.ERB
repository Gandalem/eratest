	RETURN
CASE "goodUser"
;authorized
CASE "canUse"
	$CanUse
	IF DT_CELL_GET("WeaponInventory", WeaponID, "antiTheftCracked", 1) || WeaponID < 600000000000000000
	ELSE
		SETCOLOR C_GREEN
		FONTBOLD
		PRINTFORML %"Authentication Valid",44,RIGHT%
		FONTREGULAR
		PRINTFORML %"Thank you for using Yomihari",50,RIGHT%
		RESETCOLOR
	ENDIF
	WAIT
CASE "setup"
;setup
	TWAIT 500, 1
	PRINTFORML Please keep your hand on the weapon's grip.
	PRINTFORML Do not release the weapon.
	FOR LOCAL, 0, 6
		CALL PRINT_COLORBAR(LOCAL, 5, 30, UNICODE(0x2585), UNICODE(0x2585), BASE_BCS(1), RESULT:1)
		PRINTFORM  {(100/5)*LOCAL,3}\%
		TWAIT 1000, 1
		SIF LOCAL != 5
		CLEARLINE 1
	NEXT
	TWAIT 500, 1
	PRINTL
	SETCOLOR C_GREEN
	FONTBOLD
	PRINTFORML %"Thank you for registering your weapon",44,RIGHT%
	FONTREGULAR
	PRINTFORML %"with Yomihari",50,RIGHT%
	RESETCOLOR
	PRINTFORML 
	PRINTFORML In the future, your weapon will now require biometric authentication to order to use it.
	PRINTFORML This ensure that your weapon does not fall into the wrong hands.
	PRINTL
	PRINTFORML When Yomihari starts, this message will appear, showing the owner of the weapon.
	PRINTL
	PRINTFORML %CENTER(@"The following weapon is registered to",50)% 
	PRINTFORML %CENTER(@"%NAME:ARG%",50)% 
ENDSELECT

;Your MARLin has been reset to its factory state.


@WeaponAntiTheftCrack(ARG)
#DIM DYNAMIC PlayerStrength
#DIM DYNAMIC AntiTheftStrength
#DIM DYNAMIC WeaponBase

WeaponBase = DT_CELL_GET("WeaponInventory", ARG, "def", 1)
PlayerStrength = (LEVEL_TO_RANK(ABL:MASTER:43)*3)+(LEVEL_TO_RANK(ABL:MASTER:50)*3)
AntiTheftStrength = GET_INT(MASTER, "Weapon", WeaponBase, "Anti-Theft Strength")*5

PRINTFORML Attempt to crack this %PrintWeaponName(MASTER,ARG,1)%'s anti-theft system?
SELECTCASE AntiTheftStrength-PlayerStrength
    CASE IS <= -30
        PRINTFORML The anti-theft system in this weapon is a joke.
	CASE IS <= -18
		PRINTFORML Even with a blindfold, dead drunk, about to pee yourself, and unbearably horny, %PARSE("you")% can still crack it.
	CASE -17 TO -13
		PRINTFORML Even with a blindfold, dead drunk, and about to pee yourself, %PARSE("you")% can crack it.
	CASE -12 TO -8
		PRINTFORML Even with a blindfold and dead drunk %PARSE("you")% can crack it.
	CASE -7 TO -4
		PRINTFORML Even with a blindfold %PARSE("you")% can crack it.
	CASE -3 TO -1
		PRINTFORML It looks easy to crack the anti-tamper.
	CASE 0
		PRINTFORML Might be possible to crack it.
	CASE 1 TO 3
		PRINTFORML Cracking it might not be possible.
	CASE 4 TO 7
		PRINTFORML This anti-tamper is very robust.
	CASE 8 TO 12
		PRINTFORML The anti-tamper seems to be at least twice as strong as %PARSE("your")% capibilities.
	CASE 13 TO 17
		PRINTFORML Unless a miracle occurs %PARSE("you")%'ll won't even scratch the anti-theft system.
	CASEELSE
		PRINTFORML The anti-theft is a masterpiece of code, and you're just a script kiddie in comparison.
ENDSELECT
CALL ASK_YN
SIF RESULT == 1
	RETURN
PRINTFORML You attempt to crack the anti-theft system.
NOSKIP ;addition custom code
REPEAT 5
	REUSELASTLINE  Cracking.%"." * COUNT%
	TWAIT 150, 1
REND
ENDNOSKIP
PRINTL
IF PlayerStrength >= (AntiTheftStrength*RAND(70,125)/100)
	PRINTFORML Your %PrintWeaponName(MASTER,ARG,1)% has successfully been cracked. It can now be used by anyone.
	DT_CELL_SET "WeaponInventory", ARG, "antiTheftID", 0, 1
	DT_CELL_SET "WeaponInventory", ARG, "antiTheftCracked", 1, 1
ELSE
PRINTFORML You fail to crack the anti-theft system...
ENDIF
WAIT

