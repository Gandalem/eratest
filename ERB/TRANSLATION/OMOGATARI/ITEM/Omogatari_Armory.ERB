RETURN
ELSEIF charaWeaponInts:ARG:Loudness <= 5
CALL LC_PRINT("pew...", C_ORANGE, 1)
ELSEIF charaWeaponInts:ARG:Loudness >= 10
CALL LC_PRINT("BOOM!", C_ORANGE, 1)
ELSE
CALL LC_PRINT("BANG!", C_ORANGE, 1)
ENDIF
