@WeaponAntiTheftYomihari(ARG,WeaponID,realOwner,DisplayType)
#DIM WeaponID
#DIM DYNAMIC realOwner
#DIMS DisplayType
SELECTCASE DisplayType
	CASE "init"
		;WEAPON DETECTED: Gensou-chan MakaiTech MARLin
		SETCOLOR C_PINK
		FONTBOLD
		PRINTFORML %"요미하리",44,RIGHT%
		FONTREGULAR
		PRINTFORML %"케이가 엔터프라이즈 제작",50,RIGHT%
		RESETCOLOR
		PRINTFORML %PrintWeaponName(ARG,WeaponID,3),50,RIGHT%
		PRINTFORML %TOSTR(WeaponID),50,RIGHT%
		PRINTL
		IF DT_CELL_GET("WeaponInventory", WeaponID, "antiTheftCracked", 1) || WeaponID < 600000000000000000
			SETCOLOR C_RED
			PRINTFORML %CENTER(@"인증 비활성화",50)%
			RESETCOLOR
		ENDIF
		PRINTFORML %CENTER(@"다음 무기는 ~에게 등록되어 있다.",50)%
