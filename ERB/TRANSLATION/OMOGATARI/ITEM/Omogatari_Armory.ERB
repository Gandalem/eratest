@PrintWeaponName(C_ID,weapArg=-1,ARG,ARG:1,isFullName=0)
#FUNCTIONS
#DIM C_ID
#DIM weapArg
#DIM nWeapon
#DIM isFullName
#DIM DYNAMIC detectedPreset
nWeapon = weapArg
SIF NWeapon == -1
	NWeapon = EQUIP:C_ID:Weapon
$BackLoop
IF nWeapon > 600000000000000000
	;weaponinventory entry
	detectedPreset = DT_CELL_GET("WeaponInventory", nWeapon, "detectedPreset", 1)
	nWeapon = DT_CELL_GET("WeaponInventory", nWeapon, "def", 1)
ELSEIF nWeapon > VAR_TEMP_MAX
	;is a preset
	detectedPreset = nWeapon % 1000
	nWeapon = GET_INT(C_ID,"WeaponPreset",detectedPreset,"Base Weapon")
ELSEIF ARG:1 == 1
	detectedPreset = GetWeaponPreset(C_ID,NWeapon)
	SIF detectedPreset
		nWeapon = 1000+detectedPreset
ELSEIF ARG:1 == 2
ELSE
	IF CHARANUM && weapArg == -1
		IF charaWeaponInts:C_ID:WeaponInventory
			;if it's an inventory weapon
			NWeapon = charaWeaponInts:C_ID:WeaponInventory
			GOTO BackLoop
		ENDIF
		detectedPreset = (CFLAG:C_ID:DetectedWeaponPreset && NWeapon == EQUIP:C_ID:Weapon ? 1000+CFLAG:C_ID:DetectedWeaponPreset # 0)
	ENDIF
ENDIF
IF isFullName
	IF detectedPreset
		RETURNF GET_STR(C_ID,"WeaponPreset",detectedPreset,"FullName")
	ELSE
		RETURNF GET_STR(C_ID,"Weapon",nWeapon,"FullName")
	ENDIF
ELSE
	RETURNF UNDIES_NAME_WITH_BRAND(C_ID,detectedPreset ? detectedPreset+1000 # NWeapon,ARG,24)
ENDIF

