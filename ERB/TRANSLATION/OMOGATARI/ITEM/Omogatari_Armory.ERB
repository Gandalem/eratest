@EQUIPWEAPON(nTarget,ARG,NoReloadWeapon=0)
#FUNCTION
#DIM nTarget
#DIM nGetPreset
#DIMS nWeaponName
#DIM BaseWeapon
#DIM DYNAMIC NoReloadWeapon
VARSET nGetPreset
VARSET nWeaponName
SIF !WEAPONS_ENABLED()
	RETURNF
BaseWeapon = ARG
IF ARG > 600000000000000000
	;weaponinventory entry
	BaseWeapon = DT_CELL_GET("WeaponInventory", ARG, "def", 1)
ELSEIF ARG >= VAR_TEMP_MAX
	;weapon preset mode
	nGetPreset = ARG%1000
	IF !EXISTFUNCTION(@"WeaponPreset{nGetPreset}")
		DEBUGPRINTFORML 값 {ARG}에 대한 무기 프리셋을 찾지 못했습니다.
		RETURNF 0
	ENDIF
	BaseWeapon = GET_INT(nTarget, "WeaponPreset", nGetPreset, "Base Weapon")
	nWeaponName '= GET_STR(nTarget, "WeaponPreset", nGetPreset, "Name")
	ARG = BaseWeapon
ENDIF
SIF !STRLENS(nWeaponName)
	nWeaponName '= GET_STR(nTarget, "Weapon", BaseWeapon, "名前")
EQUIP:nTarget:Weapon = BaseWeapon
DEBUGPRINTFORML %nWeaponName%을 %CALLNAME:nTarget%에게 준다
charaWeaponInts:nTarget:Mode = BestWeaponMode(nTarget,ARG)
CALLF COM_WEAPSTATS(nTarget,ARG,NoReloadWeapon,,,nGetPreset)

@WeaponReload(ARG)
#DIM AmmoNeeded
#DIM AddExtraRound
;reset negative ammo
charaWeaponInts:ARG:Ammo = MAX(charaWeaponInts:ARG:Ammo,0)
AddExtraRound = STRFIND(charaWeaponStrs:ARG:0,"closed-bolt/") > -1 && charaWeaponInts:ARG:Ammo
AmmoNeeded = charaWeaponInts:ARG:MagSize-charaWeaponInts:ARG:Ammo+AddExtraRound
IF DT_EXIST("TGC_Map")
	CALL TGC_LogAdd(@"%PARSE("You reload your",,,ARG)%무기")
ELSE
	PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 무기를 재장전한다.
ENDIF
SIF ARG == MASTER
	PLAYSOUND "se/reload3.m4a"
IF charaWeaponAtts:ARG:WeaponAmmo && ARG == MASTER
	IF AmmoStock:(charaWeaponAtts:ARG:WeaponAmmo) <= 0
		AmmoStock:(charaWeaponAtts:ARG:WeaponAmmo) = 0
		PRINTFORMW 하지만 탄약이 다 떨어졌어!
		RETURN
	ELSEIF AmmoStock:(charaWeaponAtts:ARG:WeaponAmmo) < AmmoNeeded
		charaWeaponInts:ARG:Ammo += AmmoStock:(charaWeaponAtts:ARG:WeaponAmmo)
		AmmoStock:(charaWeaponAtts:ARG:WeaponAmmo) = 0
		PRINTFORMW 당신은 남은 탄약을 예비량에서 사용한다.
		RETURN
	ENDIF
	AmmoStock:(charaWeaponAtts:ARG:WeaponAmmo) = MAX(AmmoStock:(charaWeaponAtts:ARG:WeaponAmmo)-AmmoNeeded,0)
	charaWeaponInts:ARG:Ammo = charaWeaponInts:ARG:MagSize+AddExtraRound
ELSE
	charaWeaponInts:ARG:Ammo = charaWeaponInts:ARG:MagSize+AddExtraRound
ENDIF

@PlayFireSound(ARG)
IF charaWeaponInts:ARG:Ammo < 0 && EQUIP:ARG:Weapon
