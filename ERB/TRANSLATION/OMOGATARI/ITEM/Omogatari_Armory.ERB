			IF INRANGE(realOwner,0,CHARANUM-1)
				PRINTFORML %CENTER(@"%NAME:realOwner%",50)%
			ELSE
				PRINTFORML %CENTER(@"사용자 이름",50)%
			ENDIF
		ELSE
			PRINTFORML %CENTER(@"UNREGISTERED",50)%
		ENDIF
		FONTREGULAR
		PRINTL
		PRINTFORML 무기의 손잡이에 당신의 손을 넣어주세요
