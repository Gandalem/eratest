@WeaponAntiTheft(ARG,WeaponID)
#DIM WeaponID
#DIMS ATFunc
#DIM WeaponBase
#DIM WeaponPreset
#DIM WeaponInv
#DIM DYNAMIC realOwner

WeaponBase = WeaponID
IF WeaponID > 600000000000000000
	;weaponinventory entry
	WeaponInv = WeaponID
	;WeaponPreset = DT_CELL_GET("WeaponInventory", ARG, "detectedPreset", 1)
	WeaponBase = DT_CELL_GET("WeaponInventory", WeaponID, "def", 1)
ELSEIF WeaponID >= VAR_TEMP_MAX
	WeaponPreset = WeaponID % 1000
	WeaponBase = GET_INT(ARG,"WeaponPreset",WeaponPreset,@"Base Weapon")
ENDIF

ATFunc '= GET_STR(ARG,"Weapon",WeaponBase,"Anti-Theft Message")
realOwner = DT_CELL_GET("WeaponInventory", WeaponID, "antiTheftID", 1)-1

; DEBUGPRINTFORML Attempting to equip weapon: ID: {WeaponID} BASE: {WeaponBase}
; DEBUGPRINTFORML Anti-Theft Function: %ATFunc%

TRYCCALLFORM %ATFunc%(ARG,WeaponID,realOwner,"init")
CATCH
RETURN 1
ENDCATCH
;custom fail conditions
SIF RESULT == -1
	RETURN 0

IF DT_CELL_GET("WeaponInventory", WeaponInv, "antiTheftCracked", 1) || WeaponInv == 0
;cracked
	TRYCALLFORM %ATFunc%(ARG,WeaponID,realOwner,"cracked")
	GOTO CanUse
ELSEIF realOwner > -1 && ARG != realOwner
	;unauthroized
	TRYCALLFORM %ATFunc%(ARG,WeaponID,realOwner,"badUser")
	RETURN 0
ELSEIF realOwner > -1 && ARG == realOwner
;authorized
	TRYCALLFORM %ATFunc%(ARG,WeaponID,realOwner,"goodUser")
ELSE
	;setup
	TRYCALLFORM %ATFunc%(ARG,WeaponID,realOwner,"setup")
	SIF WeaponInv
		DT_CELL_SET "WeaponInventory", WeaponID, "antiTheftID", ARG+1, 1
	PRINTL
ENDIF

$CanUse
TRYCALLFORM %ATFunc%(ARG,WeaponID,realOwner,"canUse")
RETURN 1


