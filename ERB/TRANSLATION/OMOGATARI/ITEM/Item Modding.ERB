					PRINTFORML [9] 반환한다
					INPUT
					SELECTCASE RESULT
						CASE 1
							PRINTFORML 다른 %printWeaponName(,ITEM_PICKED,,1,1)%을 구매할까?
							CALL PAY_YEN_OR_CM(weaponPrice(ITEM_PICKED,10,0),weaponPrice(ITEM_PICKED,10,0)/MAX(1,CHARISMA_NOW()))
							IF RESULT
								CALLF CREATE_WEAPON(ITEM_PICKED)
								PRINTFORMW %printWeaponName(,ITEM_PICKED,,1,1)%을(를) 구입했다!
							ELSE
								CONTINUE
							ENDIF
						CASE 9
							CONTINUE
					ENDSELECT
				ENDIF
			CASE 1
				ITEM_PICKED = RESULT-1000
				IF !GETVAR(@"Developed%GetAttachmentType(TD_SubPage)%:{ITEM_PICKED}")
					PRINTFORML 개발하다 %GET_STR(, GetAttachmentType(TD_SubPage), ITEM_PICKED, "名前")%?
					CALL PAY_YEN_OR_CM(weaponPrice(ITEM_PICKED,10,0),weaponPrice(ITEM_PICKED,10,0)/MAX(1,CHARISMA_NOW()))
					IF RESULT
						SETVAR @"Developed%GetAttachmentType(TD_SubPage)%:{ITEM_PICKED}", 1
						PRINTFORML %GET_STR(, GetAttachmentType(TD_SubPage), ITEM_PICKED, "名前")%!을 개발했다.
						WAIT
					ELSE
						CONTINUE
					ENDIF
				ENDIF
		ENDSELECT
	CASE 998
		DO
		PRINTFORML 몇 레벨을 올리고 싶으신가요 (레벨당 100CM)?
		FOR LOCAL,0,TD_MAX+1
		SELECTCASE LOCAL
			CASE 1,2,5,10,25,50
			CASEELSE
				CONTINUE
		ENDSELECT
		SIF MIN(TD_MAX-NitoriRND,LOCAL) > 0
			PRINTFORML [{MIN(TD_MAX-NitoriRND,LOCAL)}]
		NEXT
		PRINTFORML [{Limit(MONEY:2/TD_UP_COST-NitoriRND,0,TD_MAX-NitoriRND)}] 가능한 한 많이
		PRINTL
		PRINTFORML [-1] 나가기
		INPUT
		TD_LEVELING = RESULT
		IF TD_LEVELING > 0
			CALL PAY_CM_INPUT(TD_UP_COST*TD_LEVELING)
			IF RESULT
				PRINTFORMW {TD_LEVELING}만큼 레벨이 증가했다!
				NitoriRND += TD_LEVELING
			ENDIF
		ELSE
			BREAK
		ENDIF
		LOOP 1
	CASE 999
		RETURN
	CASE 997
		CALL CreateAWeapon
	CASE -7000
		TD_PAGE ++
	CASE -7001
		TD_PAGE --
	CASE -7002
		SIF TD_CATEGORY != 1
			CONTINUE
		TD_PAGE = 0
		TD_SubPAGE = -1
	CASE -8000 TO -8000+VARSIZE("TD_CAT_NAME")
		TD_CATEGORY = RESULT+8000
		TD_SubPAGE = -1
	CASE 0 TO VARSIZE("CharaWeaponAtts")
		SIF TD_CATEGORY != 1
			CONTINUE
		TD_PAGE = 1
		TD_SubPAGE = RESULT
		VARSET TD_ATTACH_LIST
		VARSET TD_ATTACH_COUNT
		$TD_ATTACHMENTS
		FOR LOCAL,1,VAR_TEMP_MAX-1
		IF EXIStFUNCTION(@"%GetAttachmentType(TD_SubPAGE)%{LOCAL}")
			TD_ATTACH_LIST:TD_ATTACH_COUNT = LOCAL
			TD_ATTACH_COUNT++
		ENDIF
		NEXT
	CASEELSE
ENDSELECT
