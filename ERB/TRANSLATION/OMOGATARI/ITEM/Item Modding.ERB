@PAY_CM_INPUT(ARG)
;custom code
LOCAL = MAX(STRLENS(DIGIT_GROUP(ARG)))
LOCAL:1 = MAX(STRLENS(DIGIT_GROUP(MONEY:2)))
LOCAL:2 = GETCOLOR()
RESETCOLOR
PRINTFORML [0] 반환한다
;custom code LOCAL
PRINTFORML [1] 지급 CM%三桁区切(ARG), LOCAL% (현재 카리스마: CM%三桁区切(MONEY:2), LOCAL:1%)
$INPUT_LOOP
INPUT
SELECTCASE RESULT
	CASE 0
	CASE 1
		IF MONEY:2 < ARG
			PRINTFORMW 카리스마가 충분하지 않다.
			GOTO INPUT_LOOP
		ENDIF
		MONEY:2 -= ARG
	CASEELSE
		GOTO INPUT_LOOP
ENDSELECT
SETCOLOR LOCAL:2
RETURN RESULT

