		TD_BASE_ID:2 = ToInt(SPLIT_SINGLE(TD_LIST:LOCAL,LOCAL:1,"/"))
		IF TD_BASE_ID >= VAR_TEMP_MAX
			TD_BASE_ID:1 = TD_BASE_ID:2-VAR_TEMP_MAX
			TD_BASE_ID:0 = GET_INT(,"WeaponPreset", TD_BASE_ID:1, "Base Weapon")
		ELSE
			TD_BASE_ID:1 = 0
			TD_BASE_ID:0 = TD_BASE_ID:2
		ENDIF
		IF DevelopedWeapon:(TD_BASE_ID:2)
			LOCALS:1 = %金額表示(TD_PRICE:(TD_BASE_ID:2):0)%
			SETCOLOR C_AQUA
		ELSEIF !DevelopedWeapon:(GET_INT(MASTER, "Weapon", TD_BASE_ID, "Prerequisite")) && GET_INT(MASTER, "Weapon", TD_BASE_ID, "Prerequisite")
			LOCALS:1 = Req. Dev.
