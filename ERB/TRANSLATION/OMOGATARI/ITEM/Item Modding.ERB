@NAS_TOOL_MODS(ARG)
#DIM nItemMod
#DIM nCostSum
#DIM IM_UP_LOOP, 2
;NAS upgrade system
VARSET NAS_UPGRADE_VARNAME
VARSET nCostSum
SIF !ITEM:ARG
	RETURN

TRYCALLFORMF ItemMod_%ITEMNAME:ARG%
SIF (!EXISTVAR(NAS_UPGRADE_VARNAME) && STRFIND(NAS_UPGRADE_VARNAME,"FLAG:") == -1) || NAS_UPGRADE_VARNAME == ""
	RETURN


LOCAL:99 = LINECOUNT
DO
	SIF LINECOUNT - LOCAL:99 > 0
		CLEARLINE LINECOUNT - LOCAL:99

	;upgrade
	FOR LOCAL,0,64
		VARSET NAS_UPGRADE_NAME
		TRYCALLFORMF ItemMod_%ITEMNAME:ARG%_{LOCAL}
		SIF !STRLENS(NAS_UPGRADE_NAME)
			CONTINUE
		SIF !NAS_UPGRADE_ABLE
			CONTINUE

		IF !GETBIT(GETVAR(NAS_UPGRADE_VARNAME), LOCAL) || NAS_UPGRADE_REPEAT
			nItemMod = 0
			BREAK
		ELSE
			nItemMod = 1
			CONTINUE
		ENDIF
	NEXT
	CUSTOMDRAWLINE ━
	;set initial sum
	VARSET nCostSum
	FOR LOCAL,0,64
		VARSET NAS_UPGRADE_NAME
		TRYCALLFORMF ItemMod_%ITEMNAME:ARG%_{LOCAL}
		SIF !STRLENS(NAS_UPGRADE_NAME)
			CONTINUE

		;see if other upgrades purchased
		IF (!GETBIT(GETVAR(NAS_UPGRADE_VARNAME), LOCAL) || NAS_UPGRADE_REPEAT) && NAS_UPGRADE_ABLE
			nCostSum += NAS_UPGRADE_COST
		ENDIF
	NEXT
	SIF !STRLENS(NAS_UPGRADE_NITORI)
		NAS_UPGRADE_NITORI '= "「How do you want to change it?」"
	CALL SPTALK, [[にとり]], "笑顔", 0, NAS_UPGRADE_NITORI, 1
	PRINTD Current state: 
	;upgrades purchased
	CALL ShowItemMods_Individual(ARG)
	PRINTL
	CUSTOMDRAWLINE ━

	FOR LOCAL,0,64
		VARSET NAS_UPGRADE_NAME
		VARSET NAS_UPGRADE_DESC
		TRYCALLFORMF ItemMod_%ITEMNAME:ARG%_{LOCAL}
		SIF !STRLENS(NAS_UPGRADE_NAME)
			CONTINUE

		IF NAS_UPGRADE_ABLE
		IF !GETBIT(GETVAR(NAS_UPGRADE_VARNAME), LOCAL) || NAS_UPGRADE_REPEAT
			HTML_PRINT @"%HTML_BUTTON(@"%HTML_ESCAPE(NAS_UPGRADE_NAME),30,LEFT%",LOCAL,3)% (%MoneySTR_HTML(NAS_UPGRADE_COST)%): %HTML_ESCAPE(NAS_UPGRADE_DESC:0)%"
		ELSE
			SETCOLOR C_GRAY
			HTML_PRINT MO_TALENT(@"[ X ] %NAS_UPGRADE_NAME,30,LEFT%: %NAS_UPGRADE_DESC:1%")
			RESETCOLOR
		ENDIF
		ELSE
			SETCOLOR C_GRAY
			HTML_PRINT MO_TALENT(@"[ X ] \@ STRLENS (NAS_UPGRADE_DESC:2) ? %NAS_UPGRADE_DESC:2% # ?????\@")
			RESETCOLOR
		ENDIF
	NEXT
	PRINTL
	IF nItemMod == 0
		HTML_PRINT @"%HTML_BUTTON(@"%"Add all of them",30,LEFT%",990,3)% (%MoneySTR_HTML(nCostSum)% in total)"
	ELSE
		PRINTL 　　　　It can't be modified any more.
	ENDIF

	PRINTL [999] - Never mind
	INPUT
	VARSET IM_UP_LOOP
	IM_UP_LOOP = RESULT
	SELECTCASE RESULT
	CASE 999
		RETURN
	CASE 0 TO 63
		$UPGRADEING
		VARSET NAS_UPGRADE_NAME
		TRYCALLFORMF ItemMod_%ITEMNAME:ARG%_{IM_UP_LOOP}
		SIF !STRLENS(NAS_UPGRADE_NAME)
			CONTINUE

		IF (!GETBIT(GETVAR(NAS_UPGRADE_VARNAME), IM_UP_LOOP) || NAS_UPGRADE_REPEAT) && MONEY >= NAS_UPGRADE_COST && NAS_UPGRADE_ABLE
			SIF IM_UP_LOOP:1
				PRINTFORML %NAS_UPGRADE_NAME% installed!
			PRINTFORML %NAS_UPGRADE_APPLY_DESC%
			TRYCCALLFORM ItemMod_%ITEMNAME:ARG%_{IM_UP_LOOP}_APPLY
			CATCH
				IF STRFIND(NAS_UPGRADE_VARNAME,"FLAG:") > -1
					SETBIT FLAG:(SUBSTRING(NAS_UPGRADE_VARNAME,5)), IM_UP_LOOP
				ELSE
				SETVAR @"%NAS_UPGRADE_VARNAME%", SETBIT_SVAR(GETVAR(NAS_UPGRADE_VARNAME), IM_UP_LOOP)
				ENDIF
			ENDCATCH
			TIME += NAS_UPGRADE_TIME
			CALL PAY_MONEY_YEN(NAS_UPGRADE_COST, 2)
		ELSE
			CONTINUE
		ENDIF
		IF IM_UP_LOOP:1
			;loop here
			IM_UP_LOOP ++
			GOTO LOOPING
		ENDIF
	CASE 990
		IF nItemMod == 0
			;upgrades purchased
			IM_UP_LOOP:1 = 1
			FOR IM_UP_LOOP,0,64
				$LOOPING
				;#; PRINTFORML Upgrade #{IM_UP_LOOP}
				GOTO UPGRADEING
			NEXT
		ELSE
			RETURN
		ENDIF
		VARSET IM_UP_LOOP
	ENDSELECT
LOOP 1

@ShowItemMods_Individual(SIMI_ITEM)
#DIM SIMI_ITEM
#DIM SIM_MOD
TRYCCALLFORM Add_ItemModList_%ITEMNAME:SIMI_ITEM%
CATCH
	IF EXISTFUNCTION(@"ItemMod_%ITEMNAME:SIMI_ITEM%")
		TRYCALLFORMF ItemMod_%ITEMNAME:SIMI_ITEM%
		FOR SIM_MOD,0,64
			VARSET NAS_UPGRADE_NAME
			TRYCALLFORMF ItemMod_%ITEMNAME:SIMI_ITEM%_{SIM_MOD}
			SIF !STRLENS(NAS_UPGRADE_NAME)
				CONTINUE

			IF GETBIT(GETVAR(NAS_UPGRADE_VARNAME), SIM_MOD)
				PRINTFORM [%NAS_UPGRADE_NAME%]
			ENDIF
		NEXT
	ELSE
		PRINTFORM Unknown Mod List! Report This!
	ENDIF
ENDCATCH
PRINTFORML

@TOOL_DEVELOP
#DIM ITEM_PICKED
#DIM 割引
#DIM 表示数
#DIM 表示行
#DIM DYNAMIC TD_CATEGORY
#DIM DYNAMIC TD_PAGE
#DIM DYNAMIC TD_SubPAGE
#DIM DYNAMIC TD_PAGELast
#DIM CONST TD_MAX = 99
#DIM CONST TD_UP_COST = 100
#DIM TD_LEVELING
#DIM TD_BASE_ID,3
#DIM TD_PRICE,2000,2
#DIM TD_ATTACH_COUNT
#DIM TD_ATTACH_LIST, VAR_TEMP_MAX
#DIM TD_COUNT
#DIM TD_LINE
#DIMS TD_LIST,100
#DIMS TD_NAME,2000
#DIMS TD_CAT_NAME = "Weapons", "Attachments", "Inventory"
表示数 = 0
表示行 = 0
VARSET TD_LIST
VARSET TD_PRICE
FOR TD_COUNT,0,VAR_TEMP_MAX*2
	IF TD_COUNT >= VAR_TEMP_MAX
		TD_BASE_ID:1 = TD_COUNT-VAR_TEMP_MAX
		TD_BASE_ID:0 = GET_INT(,"WeaponPreset", TD_BASE_ID:1, "Base Weapon")
		SIF !STRLENS(GET_STR(MASTER, "WeaponPreset", TD_BASE_ID:1, "Name"))
			CONTINUE
	ELSE
		TD_BASE_ID:1 = 0
		TD_BASE_ID:0 = TD_COUNT
	ENDIF
	SIF !ExistFunction(@"Weapon{TD_BASE_ID:0}")
	CONTINUE
	SIF GET_STR(MASTER, "Weapon", TD_BASE_ID:0, "Type") == "Youjutsu"
	CONTINUE
	SIF GET_INT(MASTER, "Weapon", TD_BASE_ID:0, "Firearm Template") && !TD_BASE_ID:1
	CONTINUE
	TD_LIST:(WeaponRankCache:(TD_COUNT)) += @"{TD_COUNT}/"
	TD_PRICE:(TD_COUNT):0 = weaponPrice(TD_COUNT,100,1,10)
	TD_PRICE:(TD_COUNT):1 = weaponPrice(TD_COUNT,10)
	TD_NAME:(TD_COUNT) '= printWeaponName(,TD_COUNT,1,1)
	
NEXT
TD_LINE = LINECOUNT
TD_SubPAGE = -1
DO
	SIF SaveIsEZB && TD_PAGE == 0
		TD_CATEGORY = 1
	CLEARLINE LINECOUNT-TD_LINE
	;未実装
	CUSTOMDRAWLINE ━
	SELECTCASE TD_CATEGORY
	CASE 0
		TD_SubPAGE = -1
		FOR LOCAL,(TD_PAGE*10),MIN(NitoriRND+1,MIN((TD_PAGE+1)*10,TD_MAX+1))
			CALL PRINT_RANK(LOCAL, @"MAX_6")
			PRINTFORML  {LOCAL}★
			表示数 = 0	
			FOR LOCAL:1,0,STRCOUNT(TD_LIST:LOCAL,"/")
				TD_BASE_ID:2 = ToInt(SPLIT_SINGLE(TD_LIST:LOCAL,LOCAL:1,"/"))
				IF TD_BASE_ID >= VAR_TEMP_MAX
					TD_BASE_ID:1 = TD_BASE_ID:2-VAR_TEMP_MAX
					TD_BASE_ID:0 = GET_INT(,"WeaponPreset", TD_BASE_ID:1, "Base Weapon")
				ELSE
					TD_BASE_ID:1 = 0
					TD_BASE_ID:0 = TD_BASE_ID:2
				ENDIF
				IF DevelopedWeapon:(TD_BASE_ID:2)
					LOCALS:1 = %金額表示(TD_PRICE:(TD_BASE_ID:2):0)%
					SETCOLOR C_AQUA
				ELSEIF !DevelopedWeapon:(GET_INT(MASTER, "Weapon", TD_BASE_ID, "Prerequisite")) && GET_INT(MASTER, "Weapon", TD_BASE_ID, "Prerequisite")
					LOCALS:1 = Req. Dev.
					SETCOLOR C_GRAY
				ELSEIF GET_INT(MASTER, "Weapon", TD_BASE_ID, "Quest Only")
					LOCALS:1 = Quest Only
					SETCOLOR C_GRAY
				ELSE
					LOCALS:1 = %金額表示(TD_PRICE:(TD_BASE_ID:2):0)%
					SIF MONEY < TD_PRICE:(TD_BASE_ID:2):0
					SETCOLOR C_GRAY
				ENDIF

				LOCALS = [{(TD_BASE_ID:2)+1000,4}]
				LOCALS += @"%TD_NAME:(TD_BASE_ID:2)%"
				PRINTFORM %LOCALS, 32, LEFT% %LOCALS:1, 12% 
				RESETCOLOR
				表示数 ++
				IF 表示数 % 4 == 0
					PRINTL 
					表示行 ++
				ENDIF		
			NEXT
			IF 表示数 % 4 != 0
				PRINTL 
				表示行 ++
			ENDIF	
		NEXT
		CUSTOMDRAWLINE ━
		IF TD_PAGE
			PRINTBUTTON @"[Previous Page] ", -7001
		ELSE
			SETCOLOR C_GRAY
			PRINTPLAIN [Previous Page] 
		ENDIF
		RESETCOLOR

		PRINTFORM  Page {TD_PAGE+1}  

		IF ((TD_PAGE+1)*10) > MIN(NitoriRND, TD_MAX)
			SETCOLOR C_GRAY
			PRINTPLAIN [Next Page]
		ELSE
			PRINTBUTTON @"[Next Page]", -7000
		ENDIF
		RESETCOLOR
		PRINTL
		CUSTOMDRAWLINE ━
	CASE 1
		SELECTCASE TD_SubPAGE
		CASE -1
			FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
				PRINTFORML [%TOSTR(LOCAL,"00")%] - %PLNOUN(GetAttachmentType(LOCAL,1))%
			NEXT
			CUSTOMDRAWLINE ━
		CASEELSE
			IF TD_ATTACH_COUNT <= 0
				PRINTFORML ＜N/A＞　%GetAttachmentType(TD_SubPAGE,1)%
				PRINTFORML 
				DRAWLINE
				FOR LOCAL, 0, 30
					PRINTL
				NEXT
			;項目あり
			ELSE
				;現在のタイプの総グループ数を更新
				TD_PAGELast = 1 + (TD_ATTACH_COUNT - 1) / 30
				PRINTFORML (Applicable for {TD_ATTACH_COUNT} attachments {TD_PAGE}/{TD_PAGELast}) %GetAttachmentType(TD_SubPAGE,1)%
				PRINTFORM 
				SETCOLOR C_GRAY
				CUSTOMDRAWLINE ━
				RESETCOLOR
				FOR LOCAL, (TD_PAGE - 1) * 30, TD_PAGE * 30
					IF INRANGE(LOCAL, 0, TD_ATTACH_COUNT - 1)
						IF GETVAR(@"Developed%GetAttachmentType(TD_SubPAGE,0)%:{TD_ATTACH_LIST:LOCAL}")
							LOCALS:1 = %金額表示(GET_INT(, GetAttachmentType(TD_SubPage), TD_ATTACH_LIST:LOCAL, "Price")/10)%
							SETCOLOR C_AQUA
						ELSE
							LOCALS:1 = %金額表示(GET_INT(, GetAttachmentType(TD_SubPage), TD_ATTACH_LIST:LOCAL, "Price"))%
						ENDIF
						PRINTFORML [%TOSTR(TD_ATTACH_LIST:LOCAL+1000,"0000")%] (%LOCALS:1,5,LEFT%) %GET_STR(, GetAttachmentType(TD_SubPage), TD_ATTACH_LIST:LOCAL, "名前")%
					ELSE
						PRINTL
					ENDIF
					RESETCOLOR
				NEXT
				;TRYCALLFORM Weapon_Chose_Make(PAGE, inDelusion)
			ENDIF

			CUSTOMDRAWLINE ━
			IF TD_PAGE > 1
				PRINTBUTTON @"[Previous Page] ", -7001
			ELSE
				SETCOLOR C_GRAY
				PRINTPLAIN [Previous Page] 
			ENDIF
			RESETCOLOR

			PRINTFORM  Page {TD_PAGE}  

			IF (TD_PAGE+1) > TD_PAGELast
				SETCOLOR C_GRAY
				PRINTPLAIN [Next Page]
			ELSE
				PRINTBUTTON @"[Next Page]", -7000
			ENDIF
			RESETCOLOR
			PRINTL
			PRINTBUTTON @"[Back]", -7002
			PRINTL
			CUSTOMDRAWLINE ━
		ENDSELECT
	CASE 2
		CALL Weapon_Chose_State(MASTER,,,1)
		TD_CATEGORY = 0
		TD_SubPage = 0
		TD_SubPage = 0
		CONTINUE
	ENDSELECT
	FOR LOCAL, 0, VARSIZE("TD_CAT_NAME")
		SIF !STRLENS(TD_CAT_NAME:LOCAL)
			CONTINUE
		SIF !LOCAL && SaveIsEZB; legend of gensokyo, you don't develop weapons
			CONTINUE
		SIF TD_CATEGORY == LOCAL
			SETCOLOR 0x00FFFF
		;exception for player character
		PRINTBUTTON TD_CAT_NAME:LOCAL, LOCAL-8000
		RESETCOLOR
		PRINTFORM 　　
	NEXT
	PRINTL
	PRINTL [997] - Create-A-Weapon
	PRINTL
	SIF NitoriRND < TD_MAX+1
	PRINTL [998] - Donate 100 Charisma
	PRINT [999] - Never mind
	INPUT
	SELECTCASE RESULT
	CASE IS >= 1000
		SELECTCASE TD_CATEGORY
		CASE 0
			ITEM_PICKED = RESULT-1000
			TempMod = ITEM_PICKED
			DRAWLINE
			CALL WeaponDescription(ITEM_PICKED)
			PRINTFORML
			CALL WeaponHoldingDisclaimers(ITEM_PICKED)
			DRAWLINE
			IF !DevelopedWeapon:(GET_INT(MASTER, "Weapon", ITEM_PICKED, "Prerequisite")) && GET_INT(MASTER, "Weapon", ITEM_PICKED, "Prerequisite")
				PRINTFORML Requires the %GET_STR(MASTER, "Weapon", GET_INT(MASTER, "Weapon", ITEM_PICKED, "Prerequisite"), "FullName")% to be developed first.
				PRINTFORML [0] Return
				INPUT
				CONTINUE
			ELSEIF GET_INT(MASTER, "Weapon", ITEM_PICKED, "Quest Only") && !DevelopedWeapon:ITEM_PICKED	
				PRINTFORML This weapon can only be acquired from a quest or by other means
				PRINTFORML [0] Return
				INPUT
				CONTINUE
			ELSEIF !DevelopedWeapon:ITEM_PICKED	
				PRINTFORML Develop the %printWeaponName(,ITEM_PICKED,,1,1)%?
					PRINTFORML By developing this weapon, you will also develop:
					IF ITEM_PICKED > VAR_TEMP_MAX
						TD_BASE_ID:1 = ITEM_PICKED-VAR_TEMP_MAX
						TD_BASE_ID:0 = GET_INT(, "WeaponPreset", TD_BASE_ID:1, "Base Weapon")
						IF !DevelopedWeapon:(TD_BASE_ID:0)
							PRINTFORML ・Weapon Template "%GET_STR(, "Weapon", TD_BASE_ID:0, "名前")%" (%金額表示(GET_INT(, "Weapon", TD_BASE_ID:0, "Price"))%)
						ENDIF
					ELSE
						TD_BASE_ID:0 = ITEM_PICKED
					ENDIF
					FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
						IF ITEM_PICKED > VAR_TEMP_MAX
							LOCAL:1 = PresetAttachment(TD_BASE_ID:1,GetAttachmentType(LOCAL))
						ELSE
							LOCAL:1 = GET_INT(, "Weapon", TD_BASE_ID:0, GetAttachmentType(LOCAL)+"/Default")
						ENDIF
						SIF !LOCAL:1
							CONTINUE
						IF GETVAR(@"Developed%GetAttachmentType(LOCAL,0)%:{LOCAL:1}")
						ELSE
							PRINTFORML ・%GET_STR(, GetAttachmentType(LOCAL), LOCAL:1, "名前")% (%金額表示(GET_INT(, GetAttachmentType(LOCAL), LOCAL:1, "Price"))%)
						ENDIF
					NEXT
				CALL PAY_YEN_OR_CM(weaponPrice(ITEM_PICKED,100,1,10),weaponPrice(ITEM_PICKED,100,1,10)/CHARISMA_NOW())
				IF RESULT
					CALLF CREATE_WEAPON(ITEM_PICKED)
					DevelopedWeapon:ITEM_PICKED = 1
					PRINTFORML Developed the %printWeaponName(,ITEM_PICKED,,1,1)%!
					PRINTFORML You also developed:
					IF ITEM_PICKED > VAR_TEMP_MAX
						TD_BASE_ID:1 = ITEM_PICKED-VAR_TEMP_MAX
						IF !DevelopedWeapon:(TD_BASE_ID:0)
							PRINTFORML ・Weapon Template "%GET_STR(, "Weapon", TD_BASE_ID:0, "名前")%" (%金額表示(GET_INT(, "Weapon", TD_BASE_ID:0, "Price"))%)
							DevelopedWeapon:(TD_BASE_ID:0) = 1
						ENDIF
					ELSE
						TD_BASE_ID:0 = ITEM_PICKED
					ENDIF
					FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
						IF ITEM_PICKED > VAR_TEMP_MAX
							LOCAL:1 = PresetAttachment(TD_BASE_ID:1,GetAttachmentType(LOCAL))
						ELSE
							LOCAL:1 = GET_INT(, "Weapon", TD_BASE_ID:0, GetAttachmentType(LOCAL)+"/Default")
						ENDIF
						SIF !LOCAL:1
							CONTINUE
						IF GETVAR(@"Developed%GetAttachmentType(LOCAL,0)%:{LOCAL:1}")
						ELSE
							PRINTFORML ・%GET_STR(, GetAttachmentType(LOCAL), LOCAL:1, "名前")% (%金額表示(GET_INT(, GetAttachmentType(LOCAL), LOCAL:1, "Price"))%)
							SETVAR @"Developed%GetAttachmentType(LOCAL)%:{LOCAL:1}", 1
						ENDIF
					NEXT
					WAIT
					CONTINUE
				ELSE
					CONTINUE
				ENDIF
			ELSE
				PRINTFORML [1] Buy another
				PRINTFORML [9] Return
				INPUT
				SELECTCASE RESULT
				CASE 1
					PRINTFORML Buy another %printWeaponName(,ITEM_PICKED,,1,1)%?
					CALL PAY_YEN_OR_CM(weaponPrice(ITEM_PICKED,10,0),weaponPrice(ITEM_PICKED,10,0)/MAX(1,CHARISMA_NOW()))
					IF RESULT
						CALLF CREATE_WEAPON(ITEM_PICKED)
						PRINTFORMW Bought a %printWeaponName(,ITEM_PICKED,,1,1)%!
					ELSE
						CONTINUE
					ENDIF	
				CASE 9
					CONTINUE
				ENDSELECT
			ENDIF
		CASE 1
			ITEM_PICKED = RESULT-1000
			IF !GETVAR(@"Developed%GetAttachmentType(TD_SubPage)%:{ITEM_PICKED}")
				PRINTFORML Develop the %GET_STR(, GetAttachmentType(TD_SubPage), ITEM_PICKED, "名前")%?
				CALL PAY_YEN_OR_CM(weaponPrice(ITEM_PICKED,10,0),weaponPrice(ITEM_PICKED,10,0)/MAX(1,CHARISMA_NOW()))
				IF RESULT
					SETVAR @"Developed%GetAttachmentType(TD_SubPage)%:{ITEM_PICKED}", 1
					PRINTFORML Developed the %GET_STR(, GetAttachmentType(TD_SubPage), ITEM_PICKED, "名前")%!
					WAIT
				ELSE
					CONTINUE
				ENDIF	
			ENDIF
		ENDSELECT
	CASE 998
		DO
			PRINTFORML How many levels do you want to increase by (100 CM/level)?
			FOR LOCAL,0,TD_MAX+1
				SELECTCASE LOCAL
				CASE 1,2,5,10,25,50
				CASEELSE 
				CONTINUE
				ENDSELECT
				SIF MIN(TD_MAX-NitoriRND,LOCAL) > 0
				PRINTFORML [{MIN(TD_MAX-NitoriRND,LOCAL)}]
			NEXT
			PRINTFORML [{Limit(MONEY:2/TD_UP_COST-NitoriRND,0,TD_MAX-NitoriRND)}] As many as possible
			PRINTL
			PRINTFORML [-1] Leave
			INPUT
			TD_LEVELING = RESULT
			IF TD_LEVELING > 0
				CALL PAY_CM_INPUT(TD_UP_COST*TD_LEVELING)
				IF RESULT
					PRINTFORMW Increased levels by {TD_LEVELING}!
					NitoriRND += TD_LEVELING
				ENDIF
			ELSE 
			BREAK
			ENDIF
		LOOP 1
	CASE 999
		RETURN
	CASE 997
		CALL CreateAWeapon
	CASE -7000
		TD_PAGE ++
	CASE -7001
		TD_PAGE --
	CASE -7002
		SIF TD_CATEGORY != 1
			CONTINUE
		TD_PAGE = 0
		TD_SubPAGE = -1
	CASE -8000 TO -8000+VARSIZE("TD_CAT_NAME")
		TD_CATEGORY = RESULT+8000
		TD_SubPAGE = -1
	CASE 0 TO VARSIZE("CharaWeaponAtts")
		SIF TD_CATEGORY != 1
			CONTINUE
		TD_PAGE = 1
		TD_SubPAGE = RESULT
		VARSET TD_ATTACH_LIST
		VARSET TD_ATTACH_COUNT
		$TD_ATTACHMENTS
		FOR LOCAL,1,VAR_TEMP_MAX-1
			IF EXIStFUNCTION(@"%GetAttachmentType(TD_SubPAGE)%{LOCAL}")
				TD_ATTACH_LIST:TD_ATTACH_COUNT = LOCAL
				TD_ATTACH_COUNT++
			ENDIF
		NEXT
	CASEELSE
	ENDSELECT
LOOP 1

@TOOL_DEVELOP_PAGE_0(TD_PAGE,TD_SubPAGE)
#DIM TD_PAGE
#DIM TD_SubPAGE

@CreateAWeapon
#DIM CAW_PARTS,4
#DIMS CAW_TYPE_LABELS = "Type", "Form", "Tech Level", "Action"
#DIM CAW_STEP
#DIM CAW_RESULT
#DIMS CAW_STRING
#DIM CAW_BASE
#DIM CAW_LINE
#DIM CAW_COST
#DIM CAW_WEAPON
CAW_STEP = 0
CAW_LINE = LINECOUNT
DO
	CLEARLINE LINECOUNT-CAW_LINE
	CUSTOMDRAWLINE ━
	PRINTFORML Create-A-Weapon
	SETCOLOR C_GRAY
	CUSTOMDRAWLINE ━
	RESETCOLOR
	VARSET CAW_STRING
	SELECTCASE CAW_STEP
	CASE 0
		FOR LOCAL,0,4
			IF LOCAL == 3
				IF GROUPMATCH(CAW_PARTS:0,4,5)
					CAW_STRING '= SUBSTRING(CAW_STRING,0,STRLENS(CAW_STRING)-1)
					CONTINUE
				ENDIF
			ENDIF

			PRINTBUTTON @"%CAW_TYPE_LABELS:LOCAL,16,LEFT%: %CAW_STRINGS(LOCAL,CAW_PARTS:LOCAL,0)%", LOCAL
			PRINTL
			IF 1
				CAW_STRING += CAW_STRINGS(LOCAL,CAW_PARTS:LOCAL,1)
				SIF LOCAL != 3
					CAW_STRING += "-"
			ENDIF
		NEXT
	CASE 1
		TempMod = CAW_WEAPON
		CALLF COM_WEAPSTATS(,CAW_WEAPON,1,,1)
		FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
			IF !WeaponHasAttachmentSlot(CAW_WEAPON,LOCAL)
				CONTINUE
			ENDIF
			
			PRINTBUTTON @"%GetAttachmentType(LOCAL,1),16,LEFT%: %GET_STR(MASTER, GetAttachmentType(LOCAL,0), DT_CELL_GET("WeaponInventory", CAW_WEAPON, GetAttachmentType(LOCAL,0), 1), "名前")%", LOCAL
			PRINTL
		NEXT
	ENDSELECT
	CUSTOMDRAWLINE ━
	CAW_BASE = CLOTHES_ID("Weapon", CAW_STRING)
	SELECTCASE CAW_STEP
	CASE 0
		IF CAW_BASE == -1
			SETCOLOR C_GRAY
			PRINTPLAINFORM [900] No weapons with this specification were found.
			RESETCOLOR
		ELSEIF !DevelopedWeapon:CAW_BASE
			SETCOLOR C_GRAY
			PRINTPLAINFORM [900] Template not developed.
			RESETCOLOR
			PRINTL
			PRINTFORML [902] Develop Template (%金額表示(weaponPrice(CAW_BASE))%)
		ELSE
			PRINTFORML [900] Move to Attachments
		ENDIF
	CASE 1
		PRINTFORML Cost: %金額表示(weaponPrice(CAW_WEAPON,10))%
		PRINTFORML [900] Create!
		PRINTL
		PRINTFORML [901] Back to Base
	ENDSELECT
	PRINTL
	PRINTFORML [999] Return
	INPUT
	CAW_RESULT = RESULT
	SELECTCASE RESULT
	CASE 999
		DT_ROW_REMOVE "WeaponInventory", CAW_WEAPON
		VARSET TempMod
		RETURN
	CASEELSE
		SELECTCASE CAW_STEP
		CASE 0
			SELECTCASE CAW_RESULT
			CASE 0 TO 3
				PRINTFORML Select a %CAW_TYPE_LABELS:CAW_RESULT%
				FOR LOCAL,1,(CAW_RESULT == 2 ? nMaxTech+1 # 25)
					SIF !STRLENS(CAW_STRINGS(CAW_RESULT,LOCAL,0))
						CONTINUE
					PRINTFORML [{LOCAL,2}] - %CAW_STRINGS(CAW_RESULT,LOCAL,0)%
				NEXT
				PRINTL
				PRINTFORML [999] - Return
				INPUT
				SIF STRLENS(CAW_STRINGS(CAW_RESULT,RESULT,0)) && RESULT != 999
					CAW_PARTS:CAW_RESULT = RESULT
				CONTINUE
			CASE 900
				SIF !DevelopedWeapon:CAW_BASE
					CONTINUE
				CAW_WEAPON = CREATE_WEAPON_FROM_BASE(CAW_BASE)
				CAW_STEP = 1
			CASE 902
				SIF DevelopedWeapon:CAW_BASE
					CONTINUE
				PRINTFORML Develop this template?
				CALL PAY_YEN_OR_CM(weaponPrice(CAW_BASE,100),weaponPrice(CAW_BASE,100)/CHARISMA_NOW())
				IF RESULT
					DevelopedWeapon:CAW_BASE = 1
					PRINTFORMW Template developed!
					CONTINUE
				ELSE
					CONTINUE
				ENDIF
			ENDSELECT
		CASE 1
			SELECTCASE CAW_RESULT
			CASE 901
				DT_ROW_REMOVE "WeaponInventory", CAW_WEAPON
				CAW_STEP = 0
				CAW_WEAPON = 0
			CASE 900
				PRINTFORML Create this weapon?
				CALL PAY_YEN_OR_CM(weaponPrice(CAW_WEAPON,10),weaponPrice(CAW_WEAPON,10)/CHARISMA_NOW())
				IF RESULT
					PRINTFORMW Weapon created!
					RETURN
				ENDIF
			CASE 0 TO VARSIZE("CharaWeaponAtts")
				CALL SelectWeaponMod(GetAttachmentType(RESULT,0), 1)
			ENDSELECT
		ENDSELECT
	ENDSELECT
LOOP 1

