@CreateAWeapon
#DIM CAW_PARTS,4
#DIMS CAW_TYPE_LABELS = "무기 종류", "형태", "기술 수준", "작동 방식"
#DIM CAW_STEP
#DIM CAW_RESULT
#DIMS CAW_STRING
#DIM CAW_BASE
#DIM CAW_LINE
#DIM CAW_COST
#DIM CAW_WEAPON
CAW_STEP = 0
CAW_LINE = LINECOUNT
DO
CLEARLINE LINECOUNT-CAW_LINE
CUSTOMDRAWLINE ━
PRINTFORML 무기 생성하기
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
VARSET CAW_STRING
SELECTCASE CAW_STEP
	CASE 0
		FOR LOCAL,0,4
		IF LOCAL == 3
			IF GROUPMATCH(CAW_PARTS:0,4,5)
				CAW_STRING '= SUBSTRING(CAW_STRING,0,STRLENS(CAW_STRING)-1)
				CONTINUE
			ENDIF
		ENDIF
		PRINTBUTTON @"%CAW_TYPE_LABELS:LOCAL,16,LEFT%: %CAW_STRINGS(LOCAL,CAW_PARTS:LOCAL,0)%", LOCAL
		PRINTL
		IF 1
			CAW_STRING += CAW_STRINGS(LOCAL,CAW_PARTS:LOCAL,1)
			SIF LOCAL != 3
				CAW_STRING += "-"
		ENDIF
		NEXT
	CASE 1
		TempMod = CAW_WEAPON
		CALLF COM_WEAPSTATS(,CAW_WEAPON,1,,1)
		FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
		IF !WeaponHasAttachmentSlot(CAW_WEAPON,LOCAL)
			CONTINUE
		ENDIF
		PRINTBUTTON @"%GetAttachmentType(LOCAL,1),16,LEFT%: %GET_STR(MASTER, GetAttachmentType(LOCAL,0), DT_CELL_GET("WeaponInventory", CAW_WEAPON, GetAttachmentType(LOCAL,0), 1), "名前")%", LOCAL
		PRINTL
		NEXT
ENDSELECT
CUSTOMDRAWLINE ━
CAW_BASE = CLOTHES_ID("Weapon", CAW_STRING)
SELECTCASE CAW_STEP
	CASE 0
		IF CAW_BASE == -1
			SETCOLOR C_GRAY
			PRINTPLAINFORM [900] 이 사양의 무기는 발견되지 않았습니다.
			RESETCOLOR
		ELSEIF !DevelopedWeapon:CAW_BASE
			SETCOLOR C_GRAY
			PRINTPLAINFORM [900] 템플릿이 개발되지 않았다.
			RESETCOLOR
			PRINTL
			PRINTFORML [902] 개발 템플릿(%金額表示(weaponPrice(CAW_BASE))%)
		ELSE
			PRINTFORML [900] 부속품으로 이동한다.
		ENDIF
	CASE 1
		PRINTFORML 비용: %金額表示(weaponPrice(CAW_WEAPON,10))%
		PRINTFORML [900] 생성!
		PRINTL
		PRINTFORML [901] 기본 설정으로 돌아가기
ENDSELECT
PRINTL
PRINTFORML [999] 돌아가기
INPUT
CAW_RESULT = RESULT
SELECTCASE RESULT
	CASE 999
		DT_ROW_REMOVE "WeaponInventory", CAW_WEAPON
		VARSET TempMod
		RETURN
	CASEELSE
		SELECTCASE CAW_STEP
			CASE 0
				SELECTCASE CAW_RESULT
					CASE 0 TO 3
						PRINTFORML %CAW_TYPE_LABELS:CAW_RESULT%을(를) 선택한다.
						FOR LOCAL,1,(CAW_RESULT == 2 ? nMaxTech+1 # 25)
						SIF !STRLENS(CAW_STRINGS(CAW_RESULT,LOCAL,0))
							CONTINUE
						PRINTFORML [{LOCAL,2}] - %CAW_STRINGS(CAW_RESULT,LOCAL,0)%
						NEXT
						PRINTL
						PRINTFORML [999] - 반환
						INPUT
						SIF STRLENS(CAW_STRINGS(CAW_RESULT,RESULT,0)) && RESULT != 999
							CAW_PARTS:CAW_RESULT = RESULT
						CONTINUE
					CASE 900
						SIF !DevelopedWeapon:CAW_BASE
							CONTINUE
						CAW_WEAPON = CREATE_WEAPON_FROM_BASE(CAW_BASE)
						CAW_STEP = 1
					CASE 902
						SIF DevelopedWeapon:CAW_BASE
							CONTINUE
						PRINTFORML 이 템플릿을 개발할까?
						CALL PAY_YEN_OR_CM(weaponPrice(CAW_BASE,100),weaponPrice(CAW_BASE,100)/CHARISMA_NOW())
						IF RESULT
							DevelopedWeapon:CAW_BASE = 1
							PRINTFORMW 템플릿이 개발되었다!
							CONTINUE
						ELSE
							CONTINUE
						ENDIF
				ENDSELECT
			CASE 1
				SELECTCASE CAW_RESULT
					CASE 901
						DT_ROW_REMOVE "WeaponInventory", CAW_WEAPON
						CAW_STEP = 0
						CAW_WEAPON = 0
					CASE 900
						PRINTFORML 이 무기를 만들까요?
						CALL PAY_YEN_OR_CM(weaponPrice(CAW_WEAPON,10),weaponPrice(CAW_WEAPON,10)/CHARISMA_NOW())
						IF RESULT
							PRINTFORMW 무기가 생성되었다!
							RETURN
						ENDIF
					CASE 0 TO VARSIZE("CharaWeaponAtts")
						CALL SelectWeaponMod(GetAttachmentType(RESULT,0), 1)
				ENDSELECT
		ENDSELECT
ENDSELECT
