CUSTOMDRAWLINE ━
CALL Add_ShowItemMods
PRINT [999] - Never mind
INPUT
SELECTCASE RESULT
CASE 999
	RETURN
CASEELSE
	CALL Add_ItemMod(RESULT) ;addition custom code
	RESTART
