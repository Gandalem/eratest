;NAS code for having an input for pay in charisma
@PAY_CM_INPUT(ARG)
;custom code
LOCAL = MAX(STRLENS(DIGIT_GROUP(ARG))) 
LOCAL:1 = MAX(STRLENS(DIGIT_GROUP(MONEY:2)))
LOCAL:2 = GETCOLOR()
RESETCOLOR
PRINTFORML [0] Return
;custom code LOCAL
PRINTFORML [1] Pay CM%三桁区切(ARG), LOCAL% （Current Charisma：CM%三桁区切(MONEY:2), LOCAL:1%）
$INPUT_LOOP
INPUT
SELECTCASE RESULT
	CASE 0
	CASE 1
		IF MONEY:2 < ARG
			PRINTFORMW Not enough Charisma.
			GOTO INPUT_LOOP
		ENDIF
		MONEY:2 -= ARG
	CASEELSE
		GOTO INPUT_LOOP
ENDSELECT
SETCOLOR LOCAL:2
RETURN RESULT

