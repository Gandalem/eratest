		ELSEIF GET_INT(MASTER, "Weapon", TD_BASE_ID, "Quest Only")
			LOCALS:1 = Quest Only
			SETCOLOR C_GRAY
		ELSE
			LOCALS:1 = %金額表示(TD_PRICE:(TD_BASE_ID:2):0)%
			SIF MONEY < TD_PRICE:(TD_BASE_ID:2):0
				SETCOLOR C_GRAY
		ENDIF
		LOCALS = [{(TD_BASE_ID:2)+1000,4}]
		LOCALS += @"%TD_NAME:(TD_BASE_ID:2)%"
		PRINTFORM %LOCALS, 32, LEFT% %LOCALS:1, 12% 
		RESETCOLOR
		表示数 ++
		IF 表示数 % 4 == 0
			PRINTL 
			表示行 ++
		ENDIF
		NEXT
		IF 表示数 % 4 != 0
			PRINTL 
			表示行 ++
		ENDIF
		NEXT
