@NAS_TOOL_MODS(ARG)
#DIM nItemMod
#DIM nCostSum
#DIM IM_UP_LOOP, 2
;NAS upgrade system
VARSET NAS_UPGRADE_VARNAME
VARSET nCostSum
SIF !ITEM:ARG
	RETURN
TRYCALLFORMF ItemMod_%ITEMNAME:ARG%
SIF (!EXISTVAR(NAS_UPGRADE_VARNAME) && STRFIND(NAS_UPGRADE_VARNAME,"FLAG:") == -1) || NAS_UPGRADE_VARNAME == ""
	RETURN
LOCAL:99 = LINECOUNT
DO
SIF LINECOUNT - LOCAL:99 > 0
	CLEARLINE LINECOUNT - LOCAL:99
;upgrade
FOR LOCAL,0,64
VARSET NAS_UPGRADE_NAME
TRYCALLFORMF ItemMod_%ITEMNAME:ARG%_{LOCAL}
SIF !STRLENS(NAS_UPGRADE_NAME)
	CONTINUE
SIF !NAS_UPGRADE_ABLE
	CONTINUE
IF !GETBIT(GETVAR(NAS_UPGRADE_VARNAME), LOCAL) || NAS_UPGRADE_REPEAT
	nItemMod = 0
	BREAK
ELSE
	nItemMod = 1
	CONTINUE
ENDIF
NEXT
CUSTOMDRAWLINE ━
;set initial sum
VARSET nCostSum
FOR LOCAL,0,64
VARSET NAS_UPGRADE_NAME
TRYCALLFORMF ItemMod_%ITEMNAME:ARG%_{LOCAL}
SIF !STRLENS(NAS_UPGRADE_NAME)
	CONTINUE
;see if other upgrades purchased
IF (!GETBIT(GETVAR(NAS_UPGRADE_VARNAME), LOCAL) || NAS_UPGRADE_REPEAT) && NAS_UPGRADE_ABLE
	nCostSum += NAS_UPGRADE_COST
ENDIF
NEXT
SIF !STRLENS(NAS_UPGRADE_NITORI)
	NAS_UPGRADE_NITORI '= "「어떻게 바꾸고 싶어?」"
CALL SPTALK, [[にとり]], "笑顔", 0, NAS_UPGRADE_NITORI, 1
PRINTD 현재 상태: 
;upgrades purchased
CALL ShowItemMods_Individual(ARG)
PRINTL
CUSTOMDRAWLINE ━
FOR LOCAL,0,64
VARSET NAS_UPGRADE_NAME
VARSET NAS_UPGRADE_DESC
TRYCALLFORMF ItemMod_%ITEMNAME:ARG%_{LOCAL}
SIF !STRLENS(NAS_UPGRADE_NAME)
	CONTINUE
IF NAS_UPGRADE_ABLE
	IF !GETBIT(GETVAR(NAS_UPGRADE_VARNAME), LOCAL) || NAS_UPGRADE_REPEAT
		HTML_PRINT @"%HTML_BUTTON(@"%HTML_ESCAPE(NAS_UPGRADE_NAME),30,LEFT%",LOCAL,3)% (%MoneySTR_HTML(NAS_UPGRADE_COST)%): %HTML_ESCAPE(NAS_UPGRADE_DESC:0)%"
	ELSE
		SETCOLOR C_GRAY
		HTML_PRINT MO_TALENT(@"[ X ] %NAS_UPGRADE_NAME,30,LEFT%: %NAS_UPGRADE_DESC:1%")
		RESETCOLOR
	ENDIF
ELSE
	SETCOLOR C_GRAY
	HTML_PRINT MO_TALENT(@"[ X ] \@ STRLENS (NAS_UPGRADE_DESC:2) ? %NAS_UPGRADE_DESC:2% # ?????\@")
	RESETCOLOR
ENDIF
NEXT
PRINTL
IF nItemMod == 0
	HTML_PRINT @"%HTML_BUTTON(@"%"전부 추가",30,LEFT%",990,3)% (%MoneySTR_HTML(nCostSum)% 총합)"
ELSE
	PRINTL 　　　　더 이상 수정할 수 없다.
ENDIF
PRINTL [999] 신경 쓰지 마
INPUT
VARSET IM_UP_LOOP
IM_UP_LOOP = RESULT
SELECTCASE RESULT
	CASE 999
		RETURN
	CASE 0 TO 63
		$UPGRADEING
		VARSET NAS_UPGRADE_NAME
		TRYCALLFORMF ItemMod_%ITEMNAME:ARG%_{IM_UP_LOOP}
		SIF !STRLENS(NAS_UPGRADE_NAME)
			CONTINUE
		IF (!GETBIT(GETVAR(NAS_UPGRADE_VARNAME), IM_UP_LOOP) || NAS_UPGRADE_REPEAT) && MONEY >= NAS_UPGRADE_COST && NAS_UPGRADE_ABLE
			SIF IM_UP_LOOP:1
				PRINTFORML %NAS_UPGRADE_NAME% 설치 완료!
			PRINTFORML %NAS_UPGRADE_APPLY_DESC%
			TRYCCALLFORM ItemMod_%ITEMNAME:ARG%_{IM_UP_LOOP}_APPLY
			CATCH
			IF STRFIND(NAS_UPGRADE_VARNAME,"FLAG:") > -1
				SETBIT FLAG:(SUBSTRING(NAS_UPGRADE_VARNAME,5)), IM_UP_LOOP
			ELSE
				SETVAR @"%NAS_UPGRADE_VARNAME%", SETBIT_SVAR(GETVAR(NAS_UPGRADE_VARNAME), IM_UP_LOOP)
			ENDIF
			ENDCATCH
			TIME += NAS_UPGRADE_TIME
			CALL PAY_MONEY_YEN(NAS_UPGRADE_COST, 2)
		ELSE
			CONTINUE
		ENDIF
		IF IM_UP_LOOP:1
			;loop here
			IM_UP_LOOP ++
			GOTO LOOPING
		ENDIF
	CASE 990
		IF nItemMod == 0
			;upgrades purchased
			IM_UP_LOOP:1 = 1
			FOR IM_UP_LOOP,0,64
			$LOOPING
			;#; PRINTFORML Upgrade #{IM_UP_LOOP}
			GOTO UPGRADEING
			NEXT
		ELSE
			RETURN
		ENDIF
		VARSET IM_UP_LOOP
ENDSELECT
LOOP 1

