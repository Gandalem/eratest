;-------------------------------------------------
;Rika's Arms Depot
;-------------------------------------------------
@RikaArmsRefresh
#DIM nCount
#DIM nItem
#DIM nPreset
#DIM nBase
CALL FISHER_YATES_SHAFFLE(2000)
VARSET nCount
FOR LOCAL, 0, 2000
	nItem = SHAFFLE_ARRAY:LOCAL
	SIF PrintWeaponName(,nItem,-1) == ""
		CONTINUE
	SIF !CHECK_WEAPON(nItem)
		CONTINUE
	SIF !weaponPrice(nItem)
		CONTINUE
	IF nItem > VAR_TEMP_MAX
		nPreset = nItem%VAR_TEMP_MAX
		nBase = GET_INT(MASTER, "WeaponPreset", nItem, "Base Weapon")
	ELSE
		nPreset = 0
		nBase = nItem
	ENDIF
	SIF GET_INT(MASTER, "Weapon", nBase, "Quest Only")
		CONTINUE
	IF nPreset
		SIF GET_INT(MASTER, "WeaponPreset", nPreset, "Quest Only")
			CONTINUE
	ENDIF
	SIF nItem == 0
		CONTINUE

	RikaGuns:nCount = nItem
	nCount++
	SIF nCount > 7
		RETURN
NEXT


@UNIQUE_COM_RikaArms
#DIM buyingItem
#DIM itemsInLine
#DIM printedItemLines
#DIM baseWeapon
#DIM weapPrice
itemsInLine = 0
printedItemLines = 0

TFLAG:194 = 1
;WebSitesKnown:9 = 1
DRAWLINE
CALL LIST_ITEM("Weapon")
DRAWLINE
CALL SET_KOJO_COLOR(47)
PRINTL 「Don't be caught dead! Protection for everyone!」
RESETCOLOR
PRINTFORML Please select items to purchase. Available money: %金額表示(MONEY)%
DRAWLINE
FOR LOCAL:1,0,10
	SIF PrintWeaponName(,RikaGuns:(LOCAL:1)) == ""
		CONTINUE
	SIF RikaGuns:(LOCAL:1) == 0
		CONTINUE

	weapPrice = weaponPrice(RikaGuns:(LOCAL:1),20)
	LOCALS:1 = %金額表示(weapPrice)%
	IF MONEY < weapPrice
		SETCOLOR C_GRAY
	ENDIF

	LOCALS = [{(LOCAL:1)+1000,4}]%PrintWeaponName(,RikaGuns:(LOCAL:1),,1)%
	PRINTFORM %LOCALS, 32, LEFT% %LOCALS:1, 12% 
	RESETCOLOR
	itemsInLine ++
	IF itemsInLine % 4 == 0
		PRINTL 
		printedItemLines ++
	ENDIF		
NEXT
DRAWLINE
;未実装
;PRINTL [990] - 道具の改造　[991] - 道具の開発
PRINTL [999] - Return　　　　　
INPUT

IF RESULT == 999
	RETURN -1
ELSEIF INRANGE((RESULT-1000),0,VARSIZE("RikaGuns"))
	buyingItem = RikaGuns:(RESULT-1000)
	DRAWLINE
	CALL WeaponDescription(buyingItem)
	DRAWLINE	
	PRINTFORML Buy the %PrintWeaponName(,buyingItem,1,1)%?
	CALL PAY_YEN_OR_CM(weaponPrice(buyingItem,20),weaponPrice(buyingItem,20)/CHARISMA_NOW())
	IF RESULT
		CALLF Create_weapon(buyingItem)
		PRINTFORML Bought a %PrintWeaponName(,buyingItem,1,1,1)%!
		RESTART
	ELSE
		RESTART
	ENDIF
ELSE
	REUSELASTLINE Invalid Input
	RESTART
ENDIF


