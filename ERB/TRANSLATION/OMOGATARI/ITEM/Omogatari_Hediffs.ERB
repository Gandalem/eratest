@EXIST_Hediff_ID
#LOCALSIZE 1
#LOCALSSIZE 1

;GET_INT(C_ID, "Weapon", P_ID, "Accuracy")

;要素名→ID変換用関数
;必要なら各オブジェクトで同様に作成のこと
@Hediff_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
		C_NAME:O_ID = %GET_STR(, "Hediff", O_ID, "名前")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF

@EXIST_Hediff1
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@Hediff1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "Gunshot")	
CASE "FullName"
	CALLF MAKE_STR(V_NAME, "Gunshot wound")	
CASE "Abriv"
	CALLF MAKE_STR(V_NAME, "GUN")	
CASE "描写"
	CALLF MAKE_STR(V_NAME, "A deep craterous wound characterized by the burnt flesh surrounding the impact zone, the shards of burning hot shrapnel embedded in the surrounding tissue and the chaotic death throes of the sufferer. If you fuck around, you find out.")			
CASE "Destroyed String"
	CALLF MAKE_STR(V_NAME, "Shot off")	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Hediff」")
CASE "Hediff Type"
	CALLF MAKE_STR(V_NAME, "Damage")
CASE "Bleed Threshold"
	CALLF MAKE_INT(V_NAME, 100)
CASE "Pain Multiplier"
	CALLF MAKE_INT(V_NAME, 3)	
ENDSELECT


