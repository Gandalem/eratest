;Spell cards
;CharacterID+Card ID
;Example: 1026


@SHOW_COLLECTION_SPELLCARD
PRINTFORML ☆Received SpellCards☆
FOR LOCAL, 0, CHARANUM
	;SIF LOCAL == MASTER
	;	CONTINUE
	IF (!CFLAG:LOCAL:出禁 && !IsDead:LOCAL:0) && !TALENT:LOCAL:行きずり
		SIF !HasCardsOfChara(LOCAL)
			SETCOLOR C_GRAY
		PRINTFORMLC [{LOCAL}] %STNAME(LOCAL), 15, LEFT%
		RESETCOLOR
	ENDIF
NEXT
PRINTL 
DRAWLINE
PRINTFORML [999] - Return
INPUT

IF RESULT == 999
		RETURN
ELSEIF INRANGE(RESULT, 0, CHARANUM) && !CFLAG:RESULT:出禁 && !TALENT:RESULT:行きずり
	CALL SHOW_CARD_GAVE(RESULT)
ENDIF
RESTART

@SHOW_CARD_GAVE(CHARA)
#DIM CHARA
#DIM SCORE
#DIM GIFT_NUM
#DIM LINE
#DIM FAVO
;custom code
#DIM nLineCnt_Head
nLineCnt_Head = LINECOUNT
DO
SIF LINECOUNT - nLineCnt_Head > 0
	CLEARLINE LINECOUNT - nLineCnt_Head

PRINTFORML 　☆Spell Cards from %CALLNAME:CHARA%                 ●Select and review
CALL SpellCardList(CHARA,1)
DRAWLINE
PRINTFORML [996] - Previous character
PRINTFORML [997] - Next character
PRINTFORML [999] - Return
INPUT
IF RESULT == 999
	FAVO = 0
	RETURN
ELSEIF RESULT == 998
	ITEM:お気に入りアイテム = FAVO
ELSEIF RESULT == 997
	FOR LOCAL, CHARA + 1, CHARANUM
		IF HasSpellCards:LOCAL:1
			CHARA = LOCAL
			CLEARLINE 7 + LINE
			RESTART
		ENDIF
	NEXT
	FOR LOCAL, 0, CHARA + 1
		IF HasSpellCards:LOCAL:1
			CHARA = LOCAL
			CLEARLINE 7 + LINE
			RESTART
		ENDIF
	NEXT
ELSEIF RESULT == 996
	FOR LOCAL, 0, CHARA
		LOCAL:1 = CHARA - LOCAL
		IF HasSpellCards:(LOCAL:1):1
			CHARA = LOCAL:1
			CLEARLINE 7 + LINE
			RESTART
		ENDIF
	NEXT
	FOR LOCAL, 0, CHARANUM
		LOCAL:1 = CHARANUM - LOCAL
		IF HasSpellCards:(LOCAL:1):1
			CHARA = LOCAL:1
			CLEARLINE 7 + LINE
			RESTART
		ENDIF
	NEXT
ELSEIF INRANGE(RESULT, 0, 100) && HasSpellCards:CHARA:RESULT

ENDIF
LOOP 1

@SpellCardList(CHARA,ifButton = 0)
#DIM CHARA
#DIM SCORE
#DIM GIFT_NUM
#DIM LINE
#DIM FAVO
#DIM ifButton

IF !GETBIT(TALENT:CHARA:ESP,0)
	PRINTFORML This character is incapable of Danmaku
	RETURN 0
ENDIF

FOR LOCAL, 1, 100
	;フラグ0番が100を兼ねているのでこの形に
	IF GET_STR(CHARA, "SpellCard", LOCAL, "名前") != ""
		;IF HasSpellCards:CHARA:LOCAL
		;	PRINTBUTTON @"%GET_STR(CHARA, "SpellCard", LOCAL, "名前")%", LOCAL
		;ELSE
			IF ifButton
			PRINTBUTTON @"%GET_STR(CHARA, "SpellCard", LOCAL, "名前"), 80, LEFT%", LOCAL
			ELSE
			PRINTFORM %GET_STR(CHARA, "SpellCard", LOCAL, "名前"), 80, LEFT%
			ENDIF
		;ENDIF
		CALL PRINT_RANK(GET_INT(CHARA, "SpellCard", LOCAL, "Grade"), "MAX_6")
		PRINTFORM  {GET_INT(CHARA, "SpellCard", LOCAL, "Grade"), 2} 
		IF GET_INT(CHARA, "SpellCard", LOCAL, "TSP")
		CALL PRINT_COLORBAR((GET_INT(CHARA, "SpellCard", LOCAL, "TSP")), 4000, 30, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("水色"), RESULT:1)
		PRINTFORM  {GET_INT(CHARA, "SpellCard", LOCAL, "TSP")} TSP/use 
		ENDIF		
		IF GET_INT(CHARA, "SpellCard", LOCAL, "ESP")
		CALL PRINT_COLORBAR((GET_INT(CHARA, "SpellCard", LOCAL, "ESP")), 4000, 30, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("オレンジ"), RESULT:1)
		PRINTFORM  {GET_INT(CHARA, "SpellCard", LOCAL, "ESP")} ESP/use 
		ENDIF
		SIF GET_INT(CHARA, "SpellCard", LOCAL, "Last Spell")
			PRINTFORM (Last Spell) 
		PRINTL
	ELSE
		LINE = LOCAL
		BREAK
	ENDIF
NEXT

@HasCardsOfChara(ARG)
#FUNCTION
FOR LOCAL, 0, 100
	SIF HasSpellCards:ARG:LOCAL
		RETURNF 1
	SIF ARG == MASTER
		RETURNF 1
	SIF GET_STR(ARG, "SpellCard", LOCAL, "名前") == ""
		RETURNF 0
NEXT

@SpellCardCount(ARG)
#FUNCTION

FOR LOCAL, 1, 100
	SIF GET_STR(ARG, "SpellCard", LOCAL, "名前") == ""
		BREAK
NEXT
LOCAL--
RETURNF LOCAL

@EXIST_SpellCard_ID
#LOCALSIZE 1
#LOCALSSIZE 1

;要素名→ID変換用関数
;必要なら各オブジェクトで同様に作成のこと
@SpellCard_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
		C_NAME:O_ID = %GET_STR(, "SpellCard", O_ID, "名前")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF

