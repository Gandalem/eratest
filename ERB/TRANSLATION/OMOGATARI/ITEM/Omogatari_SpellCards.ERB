; Modular ERB: OMOGATARI/ITEM/Omogatari_SpellCards.ERB
;Spell cards
;CharacterID+Card ID
;Example: 1026

@SHOW_COLLECTION_SPELLCARD
PRINTFORML ☆획득한 스펠카드☆
FOR LOCAL, 0, CHARANUM
;SIF LOCAL == MASTER
;	CONTINUE
IF (!CFLAG:LOCAL:出禁 && !IsDead:LOCAL:0) && !TALENT:LOCAL:行きずり
	SIF !HasCardsOfChara(LOCAL)
		SETCOLOR C_GRAY
	PRINTFORMLC [{LOCAL}] %STNAME(LOCAL), 15, LEFT%
	RESETCOLOR
ENDIF
NEXT
PRINTL 
DRAWLINE
PRINTFORML [999] - 반환
INPUT
IF RESULT == 999
	RETURN
ELSEIF INRANGE(RESULT, 0, CHARANUM) && !CFLAG:RESULT:出禁 && !TALENT:RESULT:行きずり
	CALL SHOW_CARD_GAVE(RESULT)
ENDIF
RESTART

@SHOW_CARD_GAVE(CHARA)
#DIM CHARA
#DIM SCORE
#DIM GIFT_NUM
#DIM LINE
#DIM FAVO
;custom code
#DIM nLineCnt_Head
nLineCnt_Head = LINECOUNT
DO
SIF LINECOUNT - nLineCnt_Head > 0
	CLEARLINE LINECOUNT - nLineCnt_Head
PRINTFORML 　%CALLNAME:CHARA%의 마법 카드들 ●선택하고 검토
CALL SpellCardList(CHARA,1)
DRAWLINE
PRINTFORML [996] - 이전 캐릭터
PRINTFORML [997] - 다음 캐릭터
PRINTFORML [999] - 반환
INPUT
IF RESULT == 999
	FAVO = 0
	RETURN
ELSEIF RESULT == 998
	ITEM:お気に入りアイテム = FAVO
ELSEIF RESULT == 997
	FOR LOCAL, CHARA + 1, CHARANUM
	IF HasSpellCards:LOCAL:1
		CHARA = LOCAL
		CLEARLINE 7 + LINE
		RESTART
	ENDIF
	NEXT
	FOR LOCAL, 0, CHARA + 1
	IF HasSpellCards:LOCAL:1
		CHARA = LOCAL
		CLEARLINE 7 + LINE
		RESTART
	ENDIF
	NEXT
ELSEIF RESULT == 996
	FOR LOCAL, 0, CHARA
	LOCAL:1 = CHARA - LOCAL
	IF HasSpellCards:(LOCAL:1):1
		CHARA = LOCAL:1
		CLEARLINE 7 + LINE
		RESTART
	ENDIF
	NEXT
	FOR LOCAL, 0, CHARANUM
	LOCAL:1 = CHARANUM - LOCAL
	IF HasSpellCards:(LOCAL:1):1
		CHARA = LOCAL:1
		CLEARLINE 7 + LINE
		RESTART
	ENDIF
	NEXT
ELSEIF INRANGE(RESULT, 0, 100) && HasSpellCards:CHARA:RESULT
ENDIF
LOOP 1

