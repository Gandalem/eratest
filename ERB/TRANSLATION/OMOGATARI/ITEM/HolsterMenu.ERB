@Weapon_Chose_State(C_ID = -1,LIST_TYPE = "Blunt Melee",inDelusion = 0,inModification)
#DIM        C_ID       ;登録番号
#DIM        PAGE       ;表示中のページ
#DIMS CONST DispName = "Blunt Melee", "Blades", "Throwing", "Pistols", "Rifles", "Shotguns", "Machine Guns", "Explosives", "Bows", "Youjutsu", "Hybrid", "All"
;#DIMS CONST DispName = "Blunt Melee", "Blades", "Concealed", "Pistols", "Rifles", "Shotguns", "Machine Guns", "Explosives", "Bows", "Youjutsu", "Hybrid", "All"
#DIM        CRedraw
#DIM        FirstLine
#DIM        inDelusion
#DIM        WeapCount
#DIM        WeapList, VARSIZE("RESULT")
#DIM        L_CLASS_ID                    ;リストのクラス内ID
#DIMS       LIST_TYPE                     ;リストの種別
#DIM        GET_LIST = 1
#DIM        SORT_TYPE                     ;キャラリストのソートタイプ
#DIM        NOW_GROUP = 1                 ;表示中のキャラグループ
#DIM        LAST_GROUP                    ;キャラグループ総数
#DIMS       LIST_TYPE_TR                  ;リストの種別
#DIM        DISP_TYPE
#DIM        L_ID
#DIM 		SelectedWeapon
#DIM		inModification
;inDelusion is for delusions
SIF C_ID == -1
	C_ID = MASTER
SIF PAGE == 0 && !GETBIT(nWeapons,1)
	PAGE = 3
SIF PAGE == 3 && !GETBIT(nWeapons,2)
	PAGE = 9
FirstLine = LINECOUNT
CRedraw = CURRENTREDRAW()
$REPRINT
CLEARLINE LINECOUNT - FirstLine
REDRAW 0
IF GET_LIST
	CALLF MakeWeaponList(LIST_TYPE, L_CLASS_ID, WeapList, WeapCount, inDelusion)
	GET_LIST = 0
	SORT_TYPE = -1
ENDIF
PRINTFORML %CALLNAME:C_ID%의 현재 무기: %UNDIES_NAME_WITH_BRAND(C_ID,EQUIP:C_ID:Weapon,1,24)%
CUSTOMDRAWLINE ━
IF WeapCount <= 0
	PRINTFORML ＜N/A＞　%LIST_TYPE_TR%
	PRINTFORML 
	DRAWLINE
	FOR LOCAL, 0, 30
	PRINTL
	NEXT
	;項目あり
ELSE
	;現在のタイプの総グループ数を更新
	LAST_GROUP = 1 + (WeapCount - 1) / 30
	PRINTFORML ({WeapCount} 무기 {NOW_GROUP}/{LAST_GROUP}에 적용 가능) %LIST_TYPE_TR%
	PRINTFORM 
	CALL WeapListButton(-1, , DISP_TYPE, SORT_TYPE)
	SETCOLOR C_GRAY
	CUSTOMDRAWLINE ━
	RESETCOLOR
	FOR L_ID, (NOW_GROUP - 1) * 30, NOW_GROUP * 30
	IF INRANGE(L_ID, 0, WeapCount - 1)
		CALL WeapListButton(L_ID, WeapList:L_ID, DISP_TYPE, SORT_TYPE)
	ELSE
		PRINTL
	ENDIF
	NEXT
	;TRYCALLFORM Weapon_Chose_Make(PAGE, inDelusion)
ENDIF
;modded to have infinite scroll
IF LAST_GROUP == 1
	SETCOLOR 0x606060
	PRINTFORM %"Prev page",15,LEFT%
	RESETCOLOR
ELSE
	PRINTBUTTON @"%"Prev page",15,LEFT%", 888
ENDIF
PRINTFORM 
IF LAST_GROUP == 1
	SETCOLOR 0x606060
	PRINTFORM %"Next page",15,LEFT%
	RESETCOLOR
ELSE
	PRINTBUTTON @"%"Next page",15,LEFT%", 222
ENDIF
PRINTL
CUSTOMDRAWLINE ━
FOR LOCAL, 0, VARSIZE("DispName")
SELECTCASE LOCAL
	CASE 0 TO 2
		SIF !GETBIT(nWeapons,1)
			CONTINUE
	CASE 3 TO 8
		SIF !GETBIT(nWeapons,2)
			CONTINUE
	CASE 9
		SIF !GETBIT(nWeapons,3)
			CONTINUE
ENDSELECT
SIF PAGE == LOCAL
	SETCOLOR 0x00FFFF
;exception for player character
PRINTBUTTON DispName:LOCAL, LOCAL + 8002
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTFORML 
IF charaWeaponInts:C_ID:MagSize && !inDelusion && !inModification
	PRINTFORM [880] 재장전 ({charaWeaponInts:C_ID:Ammo}/{charaWeaponInts:C_ID:MagSize})
	SIF DT_CELL_GET("WeaponInventory", CharaWeaponInts:C_ID:WeaponInventory, "WeaponAmmo", 1)
		PRINTFORM  ({AmmoStock:(DT_CELL_GET("WeaponInventory", CharaWeaponInts:C_ID:WeaponInventory, "WeaponAmmo", 1))} 남음)
	PRINTFORML )
ENDIF
IF GET_INT(C_ID, "Weapon", EQUIP:C_ID:Weapon, "Modes") && !inDelusion && !inModification
	PRINTFORML [881] 모드를 전환한다 (현재 %GET_STR(C_ID, "Weapon", EQUIP:C_ID:Weapon, @"{charaWeaponInts:C_ID:Mode}/Name")%)
ENDIF
PRINTFORML
[IF_DEBUG]
RESETCOLOR
SIF TFLAG:989
	SETCOLOR C_ORANGE
PRINTFORML [-99] - 디버그
RESETCOLOR
[ENDIF]
IF HasFallState(TARGET) && TARGET != MASTER && !inModification
	IF C_ID == MASTER
		PRINTFORML [997] - %조사처리(CALLNAME:TARGET,"로")% 전환한다 
	ELSE
		PRINTFORML [997] %조사처리(CALLNAME:MASTER,"로")% 전환한다. 
	ENDIF
ENDIF
IF !inModification
	IF (EQUIP:C_ID:Weapon == 0)
		IF GETBIT(TALENT:C_ID:ESP,0)
			PRINTFORML [998] - 난마쿠로 전환
		ENDIF
	ELSEIF (EQUIP:C_ID:Weapon == 1)
		PRINTFORML [998] 주먹으로 전환한다.
	ELSEIF (EQUIP:C_ID:Weapon || inDelusion)
		PRINTFORML [998] 홀스터
	ENDIF
ENDIF
PRINTFORML [999] 신경 쓰지 마
CALL LoG_AdvanceTutorial(60)
SIF RESULT
	RESTART
DO
INPUT
SELECTCASE RESULT
	CASE IS == -99
		TFLAG:989 = !TFLAG:989
		GET_LIST = 1
		NOW_GROUP = 1
	CASE 222, 888
		SIF LAST_GROUP == 1
			GOTO REPRINT
		NOW_GROUP = PAGE_HANDLE(RESULT, 888, NOW_GROUP, 1, LAST_GROUP)
	CASE 997
		IF HasFallState(TARGET) && TARGET != MASTER
			IF C_ID == MASTER
				C_ID = TARGET
			ELSE
				C_ID = MASTER
			ENDIF
		ENDIF
	CASE 998
		IF inDelusion
			COM460_Setting:26 = 0
			RETURN
		ENDIF
		;danmaku switching
		IF (EQUIP:C_ID:Weapon == 0)
			IF GETBIT(TALENT:C_ID:ESP,0)
				PRINTFORMW %PARSE("You",,,C_ID)%단막으로 전환한다.
				CALLF EquipWeapon(C_ID,1)
			ENDIF
			RETURN 0
		ELSEIF (EQUIP:C_ID:Weapon == 1)
			PRINTFORMW %PARSE("You",,,C_ID)%으로 전환한다. %PARSE("your",5,,C_ID)% 주먹을.
			CALLF EquipWeapon(C_ID,0)
			RETURN 0
		ENDIF
		SIF !EQUIP:C_ID:Weapon
			RESTART
		;PRINTFORMDL %PARSE("You holster")% the %CLOTHES_TR(CLOTHNAME(24, EQUIP:C_ID:Weapon))%.
		CALL HolsterWeaponSwitch(C_ID)
		RETURN 0
	CASE 999
		VARSET TempMod
		RETURN -5
	CASE 8002 TO 8013
		PAGE = RESULT-8002
		LIST_TYPE '= DispName:PAGE
		GET_LIST = 1
		NOW_GROUP = 1
	CASE 880
		CALL WeaponReload(C_ID)
		VARSET TempMod
		RETURN
	CASE 881
		IF GET_STR(C_ID, "Weapon", EQUIP:C_ID:Weapon, @"{charaWeaponInts:C_ID:Mode+1}/Name") == ""
			charaWeaponInts:C_ID:Mode = 0
		ELSE
			charaWeaponInts:C_ID:Mode++
		ENDIF
		PRINTFORMDW %GET_STR(C_ID, "Weapon", EQUIP:C_ID:Weapon, @"{charaWeaponInts:C_ID:Mode}/Name")% 모드로 전환했다.
		CALLF COM_WEAPSTATS(C_ID,EQUIP:C_ID:Weapon,1,charaWeaponInts:C_ID:Mode)
	CASE 5000 TO 5050
		SORT_TYPE = RESULT
		CALL SORT_LIST_WEAPON(RESULT, WeapList, WeapCount)
		GOTO REPRINT
	CASE IS >= 0
		SelectedWeapon = RESULT
		TempMod = SelectedWeapon
		PRINTFORMDW 당신은 가방에서 %CAPITALIZE(PrintWeaponName(C_ID,SelectedWeapon,-1,,0))%를 꺼낸다. 
		CALL WeaponDescription(SelectedWeapon)
		PRINTFORML
		CALL WeaponHoldingDisclaimers(SelectedWeapon)
		CALL ASK_M( @"장착한다%COND_STR(" (Religion Forbids)", !RELIGION_ALLOWS_WEAPON(MASTER,SelectedWeapon))%%COND_STR(@" (Cannot Hold: %CANT_HOLD_WEAPON_REASON(CANT_HOLD_WEAPON(C_ID,SelectedWeapon))%)", CANT_HOLD_WEAPON(C_ID,SelectedWeapon))%", RELIGION_ALLOWS_WEAPON(C_ID,SelectedWeapon) && !CANT_HOLD_WEAPON(C_ID,SelectedWeapon) && !inModification, @"수정", !inDelusion && SelectedWeapon > 600000000000000000, @"던지다", SelectedWeapon > 600000000000000000 && !inModification, COND_STR("Clone",TFLAG:989), TFLAG:989, COND_STR("Anti-Theft Settings",WeaponHasAntiTheft(C_ID,SelectedWeapon)), WeaponHasAntiTheft(C_ID,SelectedWeapon), @"돌아가다", 1 )
		SELECTCASE RESULT
			CASE 0
				COM460_Setting:26 = SelectedWeapon
				IF inDelusion == 1
					RETURN SelectedWeapon
				ELSE
					CALL WeaponAntiTheft(C_ID,SelectedWeapon)
					SIF RESULT == 0
						RESTART
				ENDIF
				CALLF EquipWeapon(C_ID,SelectedWeapon)
				VARSET TempMod
				RETURN
			CASE 1
				TempMod = SelectedWeapon
				CALL WEAPON_MODIFY(SelectedWeapon, inModification)
				GET_LIST = 1
			CASE 2
				SETCOLOR C_RED
				PRINTFORML 당신은 가방에서 %CAPITALIZE(PrintWeaponName(C_ID,SelectedWeapon,1,,0))%를 던지려 한다.
				PRINTFORML 이것은 아이템을 영구적으로 제거할 것입니다!
				RESETCOLOR
				PRINTFORML 정말로 그래?
				CALL ASK_YN
				SELECTCASE RESULT
					CASE 0
						PRINTFORMW 당신은 %CAPITALIZE(PrintWeaponName(C_ID,SelectedWeapon,1,,0))%를 버린다.
						GET_LIST = 1
						NOW_GROUP = 1
						DT_ROW_REMOVE "WeaponInventory", SelectedWeapon
					CASE 1
				ENDSELECT
			CASE 3
				IF TFLAG:989
					PRINTFORML 몇 개요?
					PRINTL   
					PRINTBUTTON "[0] 정지", 0
					PRINT     
					PRINTBUTTON "[1] 1", 1
					PRINT     
					PRINTBUTTON "[5] 5", 5
					PRINT     
					PRINTBUTTON "[10] 10", 10
					PRINT    
					PRINTBUTTON "[20] 20", 20
					PRINT    
					PRINTBUTTON "[50] 50", 50
					PRINT    
					PRINTBUTTON "[99] 99", 99
					PRINT    
					PRINTL
					INPUT
					LOCAL:5 = RESULT
					FOR LOCAL,0,LOCAL:5
					CALLF CREATE_WEAPON(SelectedWeapon)
					NEXT
				ENDIF
				GET_LIST = 1
			CASE 4
				CALL ASK_M( @"인증 해제", WeaponAntiTheftOwner(C_ID,SelectedWeapon) == C_ID, @"균열", 1, @"돌아가다", 1 )
				SELECTCASE RESULT
					CASE 0
						PRINTFORMW 당신은 %CAPITALIZE(PrintWeaponName(C_ID,SelectedWeapon,1,,0))%를 아무도 소유하지 않도록 초기화했다.
						DT_CELL_SET "WeaponInventory", SelectedWeapon, "antiTheftID", 0, 1
					CASE 1
						CALL WeaponAntiTheftCrack(SelectedWeapon)
					CASE 2
				ENDSELECT
			CASE 5
		ENDSELECT
	CASEELSE
		$RETRY
		REUSELASTLINE 잘못된 입력
		CONTINUE
ENDSELECT
BREAK
LOOP 1
GOTO REPRINT

@WeaponSameSource(ARG,nTargetWound,nComparingWound)
#FUNCTION
#DIM nPart
#DIM nTargetWound
#DIM nComparingWound
SIF !nTargetWound || !nComparingWound
	RETURNF 0
SIF DT_CELL_GET(@"WeaponInventory", nTargetWound, "def", 1) != DT_CELL_GET(@"WeaponInventory", nComparingWound, "def", 1)
	RETURNF 0
SIF DT_CELL_GET(@"WeaponInventory", nTargetWound, "detectedPreset", 1) != DT_CELL_GET(@"WeaponInventory", nComparingWound, "detectedPreset", 1)
	RETURNF 0
SIF DT_CELL_GET(@"WeaponInventory", nTargetWound, "antiTheftCracked", 1) != DT_CELL_GET(@"WeaponInventory", nComparingWound, "antiTheftCracked", 1)
	RETURNF 0
SIF DT_CELL_GET(@"WeaponInventory", nTargetWound, "antiTheftID", 1) != DT_CELL_GET(@"WeaponInventory", nComparingWound, "antiTheftID", 1)
	RETURNF 0
FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
SIF DT_CELL_GET(@"WeaponInventory", nTargetWound, GetAttachmentType(LOCAL), 1) != DT_CELL_GET(@"WeaponInventory", nComparingWound, GetAttachmentType(LOCAL), 1)
	RETURNF 0
NEXT
RETURNF 1

@WeaponInventoryName(ARG,nWeapon,SetFormat,nameFormat,stack = 1)
#FUNCTIONS
#DIM nWeapon
#DIM ShowAtts
#DIM DYNAMIC stack
#DIM DYNAMIC SetFormat
#DIM totalWeaponCount
#DIM hediffStack, 10
#DIM nameFormat
#DIMS AttachmentList
#DIM AttachmentCount
#DIM DYNAMIC nPadding
VARSET hediffStack
VARSET AttachmentCount
hediffStack:0 = 1
IF nWEAPON > 600000000000000000
	hediffStack:3 = DT_CELL_GET(@"WeaponInventory", nWeapon, "detectedPreset", 1)
	hediffStack:4 = DT_CELL_GET(@"WeaponInventory", nWeapon, "def", 1)
	totalWeaponCount = DT_SELECT(@"WeaponInventory", @"def = %TOSTR(hediffStack:4)% and detectedPreset = %TOSTR(hediffStack:3)%", "", tempHediffList)
ELSE
	hediffStack:3 = nWEAPON > 1000 ? nWeapon % 1000 # 0
	hediffStack:4 = hediffStack:3 ? GET_INT(0,"WeaponPreset",hediffStack:3,"Base Weapon") # nWeapon
	totalWeaponCount = 1
ENDIF
LOCALS =
;count attachments
IF nWEAPON > 600000000000000000
	FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
	SIF DT_CELL_GET(@"WeaponInventory", nWeapon, GetAttachmentType(LOCAL), 1) != PresetAttachment(hediffStack:3,GetAttachmentType(LOCAL))
		AttachmentCount++
	NEXT
	;check stack for copies
	IF stack
		FOR LOCAL, 0, totalWeaponCount
		SIF tempHediffList:LOCAL == nWeapon
			CONTINUE
		IF WeaponSameSource(ARG,nWeapon,tempHediffList:LOCAL)
			hediffStack:0 ++
		ENDIF
		NEXT
	ENDIF
ENDIF
IF SetFormat == 8
	LOCALS += @"<button value='{nWeapon}'>["
ELSEIF SetFormat > 0
	LOCALS += @"<nonbutton>"
ENDIF
SELECTCASE SetFormat
	CASE -1
		nPadding = 25
	CASE -2
		nPadding = 55
	CASE 8
		nPadding = 32
ENDSELECT
;weapon name
IF SetFormat == 8
	LOCALS:1 '= @"%PrintWeaponName(ARG, hediffStack:3 ? hediffStack:3+VAR_TEMP_MAX # hediffStack:4,nameFormat,1),nPadding,LEFT%"
	LOCALS += HTML_ESCAPE(LOCALS:1)
ELSE
	LOCALS += @"%PrintWeaponName(ARG, hediffStack:3 ? hediffStack:3+VAR_TEMP_MAX # hediffStack:4,nameFormat,1),nPadding,LEFT%"
ENDIF
$BYPASS
IF SetFormat > 0
	IF SetFormat == 2 || SetFormat == 8
		LOCALS += @"]</button>"
	ELSEIF SetFormat
		LOCALS += @"</nonbutton>"
	ENDIF
ENDIF
;number of attachments
;stack
SIF AttachmentCount
	LOCALS += @" +{AttachmentCount} "
;stack
IF hediffStack > 1 || GROUPMATCH(SetFormat,-1,-2)
	IF GROUPMATCH(SetFormat,-1,-2)
		LOCALS += @"×{hediffStack}"
	ELSE
		LOCALS += @" {hediffStack}x"
	ENDIF
ENDIF
RETURNF LOCALS
;count number of the same hediffs

@WeaponStackCount(ARG,nTargetWound)
#FUNCTION
#DIM nTargetWound
#DIM weapStacks
#DIM WSC,VARSIZE("RESULT")
#DIM WSC_COUNT
VARSET weapStacks
VARSET WeapPartStack
WSC_COUNT = DT_ROW_LENGTH("WeaponInventory")
FOR LOCAL, 0, WSC_COUNT
;SIF LOCAL == nTargetWound
;    CONTINUE
SIF LOCAL > VARSIZE("RESULT")
	BREAK
IF WeaponSameSource(ARG,nTargetWound,DT_CELL_GET("WeaponInventory",LOCAL,"id"))
	weapStacks++
	;woundGot:LOCAL = 1
	WeapPartStack:(VARSIZE("RESULT")-LOCAL) = 90
ENDIF
NEXT
RETURNF weapStacks
