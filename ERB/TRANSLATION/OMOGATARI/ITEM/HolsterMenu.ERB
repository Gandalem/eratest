@WeapListButton(LABEL, C_ID, DISP_TYPE = 0, SORT_TYPE)
#DIM  LABEL
#DIM  C_ID
#DIM DISP_TYPE
#DIM SORT_TYPE
#DIMS 表示文
#DIM  表示ステータス番号
#DIM  CONST バー長さ = 10
#DIM TM_SAVE
VARSET LOCALS
TM_SAVE = TempMod
IF LABEL < 0
	PRINTFORM
ELSE
	LOCALS += @"<font color='#%TO_HEX(C_ID < 6000000000 ? C_ORANGE # GETCOLOR())%'>%WeaponInventoryName(0,C_ID,8,0,1)%</font>"
	LOCALS += @"%" "*MAX(0,44-HTML_STRINGLEN(LOCALS))%"
ENDIF
SELECTCASE DISP_TYPE
	CASE 0 ;Basic Stats
		IF LABEL < 0
			PRINTFORM %"　" * 22%
			FOR LOCAL, 0, 8
			SELECTCASE LOCAL
				CASE 1
					PRINTFORM %" "*1%
				CASE 6
					PRINTFORM %" "*12%
			ENDSELECT
			CALL MAKE_SORT_BUTTON_HOLSTER(SORT_TYPE, LOCAL)
			SIF LOCAL != 7
				PRINT |
			NEXT
		ELSE
			TempMod = 998
			CALLF COM_WEAPSTATS(0,C_ID, , , 1)
			FOR LOCAL,0,8
			SELECTCASE LOCAL
				CASE 0
					LOCAL:1 = GetWeaponRank(-1,-1,GetWeaponScore(-1, -1, -1))
					LOCALS += @"%PRINT_RANK_HTML(LOCAL:1,"LEVEL_REWORK")% {LOCAL:1,2} |"
				CASE 1
					LOCALS:1 '= @"{PreviewWeaponInts:Damage,4}"
					SIF PreviewWeaponInts:Pellets > 1
						LOCALS:1 += @"x{PreviewWeaponInts:Pellets,2,LEFT}"
					LOCALS += @" %LOCALS:1,7% |"
				CASE 2
					LOCALS:1 '= @"{PreviewWeaponInts:Accuracy,3}"
					LOCALS += @" %LOCALS:1,3%\% |"
				CASE 3
					LOCALS:1 '= @"{PreviewWeaponInts:Penetration,5}"
					LOCALS += @" %LOCALS:1,3% u |"
				CASE 4
					LOCALS:1 '= @"{PreviewWeaponInts:Range,3}"
					LOCALS += @" %LOCALS:1,3% u |"
				CASE 5
					LOCALS:1 '= @"{PreviewWeaponInts:Burst,5}"
					LOCALS += @" %LOCALS:1,5% |"
				CASE 6
					LOCALS:1 '= @"%PreviewWeaponStrs:1,16%"
					IF PreviewWeaponInts:MagSize
						LOCALS:1 += " ("
						SIF PreviewWeaponInts:MagSize
							LOCALS:1 += @"{PreviewWeaponInts:MagSize,3}"
						LOCALS:1 += ")"
					ELSE
						LOCALS:1 '= @"%" ",6%%LOCALS:1%"
					ENDIF
					LOCALS += @" %LOCALS:1,18% |"
				CASE 7
					SIF C_ID < 60000000000
						CONTINUE
					LOCALS:1 '= ""
					FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
					IF DT_CELL_GET(@"WeaponInventory", C_ID, GetAttachmentType(LOCAL), 1) != PresetAttachment(DT_CELL_GET(@"WeaponInventory", C_ID, "detectedPreset", 1),GetAttachmentType(LOCAL))
						SIF !STRLENS(LOCALS:1)
							LOCALS:1 '= " "
						LOCALS:1 += @"%GET_STR(,GetAttachmentType(LOCAL), DT_CELL_GET(@"WeaponInventory", C_ID, GetAttachmentType(LOCAL), 1), "ShortName")%、"
					ENDIF
					NEXT
					LOCALS += @"<font color='#%TO_HEX(C_GRAY)%'>"+LIST_IN_STRING(LOCALS:1,,",",)+"</font>"
			ENDSELECT
			NEXT
		ENDIF
ENDSELECT
TempMod = TM_SAVE
IF STRLENS(LOCALS)
	HTML_PRINT LOCALS
ELSE
	PRINTL
ENDIF

@MakeWeaponList(LIST_TYPE, L_ID, WEAP_LIST, WEAP_CNT, IN_DELUSION)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS LIST_TYPE
#DIM C_ID
#DIM REF L_ID       ;リストのクラスID
#DIM REF WEAP_LIST ;キャラ一覧
#DIM REF WEAP_CNT  ;キャラカウンタ
#DIM MWL_TOTAL
#DIM MWL_LOOP
#DIM IN_DELUSION
MWL_LOOP = 0
VARSET WEAP_LIST
VARSET WEAP_CNT
$LOOPING_MW
IF MWL_LOOP
	MWL_TOTAL = 2000
ELSE
	MWL_TOTAL = DT_ROW_LENGTH("WeaponInventory")
ENDIF
FOR LOCAL, 0, MWL_TOTAL
IF MWL_LOOP
	C_ID = LOCAL
	IF LOCAL > 1000
		SIF !EXISTFUNCTION(@"WeaponPreset{C_ID%1000}")
			CONTINUE
	ELSE
		SIF !EXISTFUNCTION(@"Weapon{C_ID}")
			CONTINUE
	ENDIF
	SIF !CHECK_WEAPON(C_ID, LIST_TYPE)
		CONTINUE
	WEAP_LIST:WEAP_CNT = C_ID
	WEAP_CNT ++
	CONTINUE
ENDIF
C_ID = DT_CELL_GET("WeaponInventory",LOCAL,"id")
SIF !CHECK_WEAPON(C_ID, LIST_TYPE)
	CONTINUE
CALLF WeaponStackCount(0,C_ID)
IF (VARSIZE("WeapPartStack")-1)-LOCAL == FINDELEMENT(WeapPartStack, 90)
	WEAP_LIST:WEAP_CNT = C_ID
	WEAP_CNT ++
ENDIF
NEXT
IF (TFLAG:989 || IN_DELUSION) && !MWL_LOOP
	MWL_LOOP++
	GOTO LOOPING_MW
ENDIF

@CHECK_WEAPON(C_ID, TYPE = "Exists")
#FUNCTION
#LOCALSIZE  1
#LOCALSSIZE 1
#DIMS DYNAMIC TYPE ;判定タイプ、DYNAMICしたので多重呼び出し可能
#DIM          C_ID ;Weapon ID
#DIM		  BASE_WEAPON
IF C_ID > 600000000000
	BASE_WEAPON = DT_CELL_GET("WeaponInventory",C_ID,"def",1)
ELSEIF C_ID > VAR_TEMP_MAX
	BASE_WEAPON = GET_INT(0, "WeaponPreset", C_ID%VAR_TEMP_MAX, "Base Weapon")
ELSE
	SIF GET_INT(0, "Weapon", C_ID, "Firearm Template")
		RETURNF 0
	BASE_WEAPON = C_ID
ENDIF
SELECTCASE TYPE
	;Comparing
	CASE "Exists"
		RETURNF 1
	CASE "Firearm"
		RETURNF 0
	CASE "Blunt Melee"
		SIF GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Class"), "1H Blunt", "2H Blunt")
			RETURNF 1
	CASE "Blades"
		SIF GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Class"), "1H Blade", "2H Blade")
			RETURNF 1
	CASE "Throwing"
		SIF GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Class"), "Throwing")
			RETURNF 1
	CASE "Concealed"
		SIF GET_INT(, "Weapon", BASE_WEAPON, "Concealed Weapon")
			RETURNF 1
	CASE "Pistols"
		SIF GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Class"), "Pistol", "Automatic Pistol")
			RETURNF 1
	CASE "Rifles"
		SIF GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Class"), "Rifle", "Semi-Automatic Rifle", "Assault Rifle", "Bolt-Action Rifle", "Sniper Rifle", "Anti-Material Rifle") && !GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Type"), "Explosive")
			RETURNF 1
	CASE "Shotguns"
		SIF GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Class"), "Shotgun")
			RETURNF 1
	CASE "Machine Guns"
		SIF GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Class"), "Sub-Machine Gun", "Light Machine Gun", "Medium Machine Gun", "Heavy Machine Gun")
			RETURNF 1
	CASE "Explosives"
		SIF GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Type"), "Explosive")
			RETURNF 1
		SIF GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Class"), "Flamethrower")
			RETURNF 1
	CASE "Bows"
		SIF GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Class"), "Bow")
			RETURNF 1
	CASE "Youjutsu"
		SIF GROUPMATCH(GET_STR(, "Weapon", BASE_WEAPON, "Type"), "Youjutsu")
			RETURNF 1
	CASE "Hybrid"
		SIF GET_INT(, "Weapon", BASE_WEAPON, "Modes")
			RETURNF 1
	CASEELSE
		RETURNF 1
ENDSELECT
;###############################################
;SORT_TYPE, <45 descending, >45 ascending
;BUTTON, which button it is, corresponds with DISP_MEMO
;starting value of a first button with modulo % should be equal to 0! update all button values accordingly afterward!
;main thing is the total amount of items in DISP_MEMO (aka headers for sorting, must be the same everywhere)
;you'll need to change the button modulo with it (%41) (41 is the amount of items), then see which nearest value of 1000%41 produces 0, that'll be the starting value of a button
;next you update the button result code where it's handled (min-max range)

@MAKE_SORT_BUTTON_HOLSTER(SORT_TYPE, BUTTON)
#DIM SORT_TYPE ;現在のソートタイプ
#DIM BUTTON    ;基本のボタン名
#DIM StartingValue
#DIM isFaction
#DIMS MSB_VAR
#DIMS CONST DISP_MEMO = "Rank", "Damage", "Acc.", "Penetr.", "Range", "Burst", "Ammunition", "Attachments"
;auto sort
SortListSize = VARSIZE("DISP_MEMO")
FOR LOCAL, 5000, 9999
IF LOCAL%SortListSize == 0
	;this is much easier to do than shitty guesswork
	StartingValue = LOCAL
	BREAK
ENDIF
NEXT
IF SORT_TYPE%SortListSize != BUTTON
	;LOCAL = 1032+BUTTON+24	;PRINT
	;BUTTON @"{LOCAL}", LOCAL
	PRINTBUTTON @"　%GETVARS(@"DISP_MEMO:{BUTTON}")%", StartingValue+BUTTON
ELSEIF SORT_TYPE < StartingValue+SortListSize ;this is the sum of <button value> + total amount of items in DISP_MEMO
	PRINTBUTTON @"▼%GETVARS(@"DISP_MEMO:{BUTTON}")%", StartingValue+BUTTON+SortListSize
ELSEIF SORT_TYPE >= StartingValue+SortListSize
	PRINTBUTTON @"▲%GETVARS(@"DISP_MEMO:{BUTTON}")%", StartingValue+BUTTON
ENDIF

@SORT_LIST_WEAPON(SORT_TYPE, CHARA_LIST, CHARA_CNT)
#DIM      SORT_TYPE  ;ソート内容の指示
#DIM      MEMO_TYPE  ;今回のソート項目、CSVでの要素数
#DIMS     CHECK_VAR  ;チェック対象となる変数名
#DIMS     CHECK_TYPE ;比較演算子の種類
#DIM      NUM_LOOP   ;ループ回数
#DIM  REF CHARA_LIST ;キャラリストの内容配列
#DIM      CHARA_CNT  ;リストに含まれるキャラ数
#DIM	  EndingValue ; NAS stuff
#DIMS CONST DISP_MEMO = "Rank", "Damage", "Accuracy", "Penetration", "Range", "Burst", "Ammunition", "Attachments"
#DIM CONST MEMO_ID = 0, 0, 6, 5, 7, 2, 4, 0
;ソート項目の検索
MEMO_TYPE = 0
NUM_LOOP = SortListSize
MEMO_TYPE = SORT_TYPE%SortListSize
;auto sort
FOR LOCAL, 5000, 9999
IF LOCAL%SortListSize == 0
	;this is much easier to do than shitty guesswork
	EndingValue = LOCAL+SortListSize
	BREAK
ENDIF
NEXT
SELECTCASE DISP_MEMO:MEMO_TYPE ;refer to CHARA_COMPARE for CHECK_VAR
	CASE "Rank"
	CASE "Damage"
		CHECK_VAR '= "Damage"
	CASE "Attachments"
		CHECK_VAR '= "Attachments"
	CASE "Rank", "Damage", "Accuracy", "Penetration", "Range", "Burst", "Ammunition"
		CHECK_VAR '= "WeapStats"
ENDSELECT
IF SORT_TYPE < EndingValue
	CHECK_TYPE '= ">="
ELSEIF SORT_TYPE >= EndingValue
	CHECK_TYPE '= "<="
ENDIF
;ソート実処理
LOCAL:0 = 1
WHILE LOCAL:0 < CHARA_CNT
SIF !(LOCAL:0)
	LOCAL:0 ++
;PRINTW Okay, wait, so, what?
IF WEAP_COMPARE(CHECK_VAR, MEMO_ID:MEMO_TYPE, CHECK_TYPE, CHARA_LIST:(LOCAL:0 - 1), CHARA_LIST:(LOCAL:0))
	LOCAL:0 ++
ELSE
	SWAP CHARA_LIST:(LOCAL:0 - 1), CHARA_LIST:(LOCAL:0)
	LOCAL:0 --
ENDIF
WEND

@WEAP_COMPARE(VAR_NAME, VAR_ID, TYPE, CHARA_A, CHARA_B)
#FUNCTION
#DIMS VAR_NAME ;比較対象キャラ変数
#DIM  VAR_ID   ;比較対象キャラ変数のID
#DIM  CHARA_A  ;比較対象キャラAの登録番号
#DIMS TYPE     ;比較内容
#DIM  CHARA_B  ;比較対象キャラBの登録番号
#DIM  DYNAMIC VAR_A
#DIM  DYNAMIC VAR_B
SELECTCASE VAR_NAME
	CASE "Damage"
		TempMod = CHARA_A
		CALLF COM_WEAPSTATS(,CHARA_A,,, 1)
		VAR_A = PreviewWeaponInts:Damage*MAX(1,PreviewWeaponInts:Pellets)
		VARSET PreviewWeaponInts
		TempMod = CHARA_B
		CALLF COM_WEAPSTATS(,CHARA_B,,, 1)
		VAR_B = PreviewWeaponInts:Damage*MAX(1,PreviewWeaponInts:Pellets)
	CASE "WeapStats"
		TempMod = CHARA_A
		CALLF COM_WEAPSTATS(,CHARA_A,,, 1)
		VAR_A = PreviewWeaponInts:VAR_ID
		VARSET PreviewWeaponInts
		TempMod = CHARA_B
		CALLF COM_WEAPSTATS(,CHARA_B,,, 1)
		VAR_B = PreviewWeaponInts:VAR_ID
	CASE "Rank"
		TempMod = CHARA_A
		CALLF COM_WEAPSTATS(,CHARA_A,,, 1)
		VAR_A = GetWeaponRank(-1,-1,GetWeaponScore(-1, -1, -1))
		VARSET PreviewWeaponInts
		TempMod = CHARA_B
		CALLF COM_WEAPSTATS(,CHARA_B,,, 1)
		VAR_B = GetWeaponRank(-1,-1,GetWeaponScore(-1, -1, -1))
	CASE "Attachments"
		IF CHARA_A > 600000000
			LOCAL:1 = DT_CELL_GET(@"WeaponInventory", CHARA_A, "detectedPreset", 1)
			FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
			SIF DT_CELL_GET(@"WeaponInventory", CHARA_A, GetAttachmentType(LOCAL), 1) != PresetAttachment(LOCAL:1,GetAttachmentType(LOCAL))
				VAR_A++
			NEXT
		ENDIF
		IF CHARA_B > 600000000
			LOCAL:1 = DT_CELL_GET(@"WeaponInventory", CHARA_B, "detectedPreset", 1)
			FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
			SIF DT_CELL_GET(@"WeaponInventory", CHARA_B, GetAttachmentType(LOCAL), 1) != PresetAttachment(LOCAL:1,GetAttachmentType(LOCAL))
				VAR_B++
			NEXT
		ENDIF
ENDSELECT
VARSET TempMod
DEBUGPRINTFORML 비교 중: {VAR_A} 대 {VAR_B}
;comparing the variables
SELECTCASE TYPE
	CASE "=="
		RETURNF VAR_A == VAR_B
	CASE ">"
		RETURNF VAR_A > VAR_B
	CASE ">="
		RETURNF VAR_A >= VAR_B
	CASE "<"
		RETURNF VAR_A < VAR_B
	CASE "<="
		RETURNF VAR_A <= VAR_B
	CASEELSE
		THROW Unknown TYPE　%TYPE%
ENDSELECT

@HolsterWeaponSwitch(C_ID)
#DIM DYNAMIC C_ID
#DIMS DYNAMIC WeaponList
WeaponList '= "0、"
PRINTFORMDL %PARSE("You holster")% 그 %CLOTHES_TR(CLOTHNAME(24, EQUIP:C_ID:Weapon))%.
SIF GETBIT(TALENT:C_ID:ESP,0)
	WeaponList +=  "1、"
SIF HasBionicPart(C_ID,77)
	WeaponList +=  "606、"
SIF HasBionicPart(C_ID,141)
	WeaponList +=  "423、"
IF STRCOUNT(WeaponList,"、") > 1
	PRINTFORM %PARSE("You",,,C_ID)%둘 중 하나일 수 있다 
	LOCALS '= ""
	FOR LOCAL, 0, STRCOUNT(WeaponList,"、")
	SELECTCASE LOCAL
		CASE 0
			LOCALS += @"주먹을 사용해라."
		CASEELSE
			LOCALS += @"당신의 %PrintWeaponName(C_ID,ToInt(SPLIT_SINGLE(WeaponList, LOCAL, "、")),1,1)%으로 전환한다."
	ENDSELECT
	NEXT
	PRINTSL LIST_IN_STRING(LOCALS,," or")
	FOR LOCAL, 0, STRCOUNT(WeaponList,"、")
	PRINTFORML [{ToInt(SPLIT_SINGLE(WeaponList, LOCAL, "、"))}] - %PrintWeaponName(C_ID,ToInt(SPLIT_SINGLE(WeaponList, LOCAL, "、")),1,1)%로 무기 전환한다.
	NEXT
	$RestartYouIdiot
	INPUT
	IF STRFIND(WeaponList,@"%TOSTR(RESULT)%、") == -1
		;anti-exploit check
		CLEARLINE 1
		GOTO RestartYouIdiot
	ENDIF
	CALLF EquipWeapon(C_ID,RESULT)
ELSE
	WAIT
	CALLF EquipWeapon(C_ID,0)
ENDIF
