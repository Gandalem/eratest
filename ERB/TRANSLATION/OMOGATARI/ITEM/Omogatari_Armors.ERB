; Modular ERB: OMOGATARI/ITEM/Omogatari_Armors.ERB
;=============================================================================================================
; Armor
; (they're diapers but instead of being on your crotch they're on your everywhere)
; (also stops bullets and blades instead of pee and poop)
;
;=============================================================================================================
;-------------------------------------------------
; ArmorStats
; sets the type of protection and how much it can absorb
; works like DiapeStats but it's armor not diapers
; ARGS: ARG (Target, required), nArmor (panties, required), ARG:1 (override), ARG:2 (only get stats)
;-------------------------------------------------

@ArmorStats(ARG,nArmor,ARG:1 = 0, ARG:2 = 0, ClothingType)
#FUNCTION
#DIM DYNAMIC PeeCharges
#DIM DYNAMIC PeeBuff
#DIM DYNAMIC ClothingType
#DIM DYNAMIC nArmStrength
#DIMS DYNAMIC Type
#DIM nLoop
#DIM nBdyPart
#DIMS DYNAMIC nPlaceHolderType
#DIM nArmor
PeeBuff = 0
;IF !ARG:2
;CFLAG:ARG:ArmorSet = 1
;ENDIF
SELECTCASE ClothingType
	CASE 2
		Type = %GET_STR(ARG, "頭装備", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "頭装備", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "頭装備", nArmor, "Armor Health")
		nPlaceHolderType '= "1"
	CASE 3
		Type = %GET_STR(ARG, "靴", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "靴", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "靴", nArmor, "Armor Health")
		nPlaceHolderType '= "83/93"
	CASE 4
		Type = %GET_STR(ARG, "靴下", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "靴下", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "靴下", nArmor, "Armor Health")
		nPlaceHolderType '= "83/93"
	CASE 5
		Type = %GET_STR(ARG, "下半身下着_ずらし不可", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "下半身下着_ずらし不可", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "下半身下着_ずらし不可", nArmor, "Armor Health")
		nPlaceHolderType '= "61"
	CASE 6
		IF GET_INT(ARG, "下半身下着_ずらし可能", nArmor, "Armor")
			Type = %GET_STR(ARG, "下半身下着_ずらし可能", nArmor, "Armor Coverage")%
			nArmStrength = GET_INT(ARG, "下半身下着_ずらし可能", nArmor, "Armor")
			PeeCharges = GET_INT(ARG, "下半身下着_ずらし可能", nArmor, "Armor Health")
		ELSEIF IsPadded(ARG, "bulky", nArmor)
			Type '= "61"
			nArmStrength = 5
			PeeCharges = 2000
		ELSEIF IsPadded(ARG, "thick", nArmor)
			Type '= "61"
			nArmStrength = 4
			PeeCharges = 1450
		ELSEIF IsPadded(ARG, nArmor)
			Type '= "61"
			nArmStrength = 2
			PeeCharges = 650
		ELSE
		ENDIF
		nPlaceHolderType '= "61"
	CASE 7
		Type = %GET_STR(ARG, "上半身下着_はだけ不可", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "上半身下着_はだけ不可", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "上半身下着_はだけ不可", nArmor, "Armor Health")
		nPlaceHolderType '= "40"
	CASE 8
		Type = %GET_STR(ARG, "上半身下着_はだけ可能", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "上半身下着_はだけ可能", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "上半身下着_はだけ可能", nArmor, "Armor Health")
		nPlaceHolderType '= "40"
	CASE 9
		Type = %GET_STR(ARG, "レオタード", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "レオタード", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "レオタード", nArmor, "Armor Health")
		nPlaceHolderType '= "40/53/61"
	CASE 10
		Type = %GET_STR(ARG, "ボディースーツ", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "ボディースーツ", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "ボディースーツ", nArmor, "Armor Health")
		nPlaceHolderType '= "40/53/61"
	CASE 11
		Type = %GET_STR(ARG, "ズボン", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "ズボン", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "ズボン", nArmor, "Armor Health")
		nPlaceHolderType '= "61/81/91"
	CASE 12
		;Type = %GET_STR(ARG, "下半身上着", nArmor, "Armor Coverage")%
		;nArmStrength = GET_INT(ARG, "下半身上着", nArmor, "Armor")
		;PeeCharges = GET_INT(ARG, "下半身上着", nArmor, "Armor Health")
	CASE 13
		Type = %GET_STR(ARG, "ワンピース", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "ワンピース", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "ワンピース", nArmor, "Armor Health")
		nPlaceHolderType '= "40/53/61/81/91"
	CASE 14
		Type = %GET_STR(ARG, "着物", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "着物", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "着物", nArmor, "Armor Health")
		nPlaceHolderType '= "40/53/61/81/91/20/30"
	CASE 15
		SELECTCASE nArmor
			CASE 9
				Type '= "61/81/91"
				nArmStrength = 5
				PeeCharges = 5500
			CASEELSE
				Type = %GET_STR(ARG, "スカート", nArmor, "Armor Coverage")%
				nArmStrength = GET_INT(ARG, "スカート", nArmor, "Armor")
				PeeCharges = GET_INT(ARG, "スカート", nArmor, "Armor Health")
		ENDSELECT
		nPlaceHolderType '= "61"
	CASE 16
		SELECTCASE nArmor
			CASE 4
				Type '= "40/53/61/20/30/81/91"
				nArmStrength = 7
				PeeCharges = 9000
			CASEELSE
				Type = %GET_STR(ARG, "上半身上着_はだけ不可", nArmor, "Armor Coverage")%
				nArmStrength = GET_INT(ARG, "上半身上着_はだけ不可", nArmor, "Armor")
				PeeCharges = GET_INT(ARG, "上半身上着_はだけ不可", nArmor, "Armor Health")
		ENDSELECT
		nPlaceHolderType '= "40/53"
	CASE 17
		SELECTCASE nArmor
			CASE 4
				Type '= "40/53/61/20/30/81/91"
				nArmStrength = 7
				PeeCharges = 9000
			CASE 20
				Type '= "40/53/61"
				nArmStrength = 5
				PeeCharges = 5500
			CASEELSE
				Type = %GET_STR(ARG, "上半身上着_はだけ可能", nArmor, "Armor Coverage")%
				nArmStrength = GET_INT(ARG, "上半身上着_はだけ可能", nArmor, "Armor")
				PeeCharges = GET_INT(ARG, "上半身上着_はだけ可能", nArmor, "Armor Health")
		ENDSELECT
		nPlaceHolderType '= "40/53"
	CASE 18
		SELECTCASE nArmor
			CASE 15
				Type '= "40/53/61"
				nArmStrength = 5
				PeeCharges = 5500
			CASEELSE
				Type = %GET_STR(ARG, "外衣", nArmor, "Armor Coverage")%
				nArmStrength = GET_INT(ARG, "外衣", nArmor, "Armor")
				PeeCharges = GET_INT(ARG, "外衣", nArmor, "Armor Health")
		ENDSELECT
		nPlaceHolderType '= "40/53/61"
	CASE 19, 20, 21
		Type = %GET_STR(ARG, "その他衣装", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "その他衣装", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "その他衣装", nArmor, "Armor Health")
	CASE 22
		SELECTCASE nArmor
			CASE 6
				Type '= "22/23/32/33/"
				nArmStrength = 7
				PeeCharges = 5000
			CASEELSE
				Type = %GET_STR(ARG, "腕部装束", nArmor, "Armor Coverage")%
				nArmStrength = GET_INT(ARG, "腕部装束", nArmor, "Armor")
				PeeCharges = GET_INT(ARG, "腕部装束", nArmor, "Armor Health")
		ENDSELECT
	CASE 23
		Type = %GET_STR(ARG, "Back", nArmor, "Armor Coverage")%
		nArmStrength = GET_INT(ARG, "Back", nArmor, "Armor")
		PeeCharges = GET_INT(ARG, "Back", nArmor, "Armor Health")
ENDSELECT
SIF ArmorSet:ARG:ClothingType == 1 && !ARG:1 && !ARG:2
	RETURNF
SIF Type == ""
	Type = %nPlaceHolderType%
IF ARG:2
	RESULT:1 = PeeCharges
	RESULTS:1 = %Type%
	;PRINTFORML {PeeCharges}kJ (%Type%)
	RETURNF
ELSE
	ArmorCharges:ARG:ClothingType:1 = PeeCharges
	ArmorCharges:ARG:ClothingType:2 = nArmor
	ArmorStrength:ARG:ClothingType = nArmStrength
	ArmorCharges:ARG:ClothingType:0 = ArmorCharges:ARG:ClothingType:1
	ArmorSet:ARG:ClothingType = 1
ENDIF
RETURNF

@RaceArmorArray(ARG,nDealer)
#FUNCTION
#DIM DYNAMIC nPen
#DIM DYNAMIC nLoop
#DIM nDealer
; IF !TALENT:(nDealer):DirgeofDecay
; SIF TALENT:ARG:妖怪
; 	nPen = 5
; SIF TALENT:ARG:神霊
; 	nPen = 7
; SIF TALENT:ARG:幽霊
; 	nPen = 7
; ENDIF
IF HasBionicPart(ARG,58)
	nPen += GET_INT(ARG, "Hediff", 158, "Armor")
ELSEIF HasBionicPart(ARG,57)
	nPen += GET_INT(ARG, "Hediff", 157, "Armor")
ELSEIF HasBionicPart(ARG,56)
	nPen += GET_INT(ARG, "Hediff", 156, "Armor")
ENDIF
RETURNF nPen
;more precise soiling stage

@ArmorDamageStage(ARG,nPart)
#FUNCTION
#DIM nType
#DIM nStage, 2
#DIM ArmorDamge
#DIM ArmorDamagePercent
#DIM nPart
ArmorDamge = ABS(ArmorCharges:ARG:nPart:0 - ArmorCharges:ARG:nPart:1)
ArmorDamagePercent = (ArmorDamge*100)/MAX(ArmorCharges:ARG:nPart:1,1)
SELECTCASE ArmorDamagePercent
	CASE IS >= 100
		nStage = 7
	CASE IS > 90
		nStage = 6
	CASE IS > 75
		nStage = 5
	CASE IS > 50
		nStage = 4
	CASE IS > 25
		nStage = 3
	CASE IS > 12
		nStage = 2
	CASE IS > 0
		nStage = 1
	CASEELSE
		nStage = 0
ENDSELECT
RETURNF nStage:0

@EffectivePenetration(ARG,nPart,nDealer)
#FUNCTION
#DIM nPart
#DIM nDealer
#DIM DYNAMIC extraArmor
#DIM nLoop,2
#DIM DYNAMIC nStrength
#DIM DYNAMIC nCloth
IF nPart == 61
	extraArmor += (SoiledDiaper(ARG,1,2,0)/300)
	extraArmor += (SoiledDiaper(ARG,2,2,0)/300)
ENDIF
FOR nLoop,1, VARSIZE("表示部位")
CALLF ARMORSTATS(ARG,EQUIP:ARG:nLoop,1,1,nLoop)
LOCALS = %RESULTS:1%
FOR nLoop:1,0,100
LOCAL = TOINT(SPLIT_SINGLE(LOCALS, nLoop:1, "/"))
;PRINTFORML %CALLNAME:ARG%'s %表示ラベル:nLoop%: %LOCALS% ({LOCAL})
SIF !LOCAL
	BREAK
IF LOCAL == nPart
	LOCAL:1 = LIMIT((ArmorStrength:ARG:nLoop+RaceArmorArray(ARG,nDealer)+extraArmor)*ArmorCharges:ARG:nLoop:0*200/MAX((ArmorCharges:ARG:nLoop:1),1),RaceArmorArray(ARG,nDealer)*100,(ArmorStrength:ARG:nLoop+RaceArmorArray(ARG,nDealer)+extraArmor)*100)
	nStrength = MAX(LOCAL:1, nStrength)
	SIF nStrength == LOCAL:1
		nCloth = nLoop
	CONTINUE
ENDIF
NEXT
NEXT
RESULT:1 = nCloth
RETURNF nStrength

@DamageMitigate(ARG,nDealer, nDMG,nPart, AffectArmor = 1, AffectSTA = 0, shutUP = 0)
#FUNCTION
#DIM DYNAMIC nDealer
#DIM DYNAMIC nDMG
#DIM DYNAMIC nPart
#DIM DYNAMIC DIFFERENCE
#DIM DYNAMIC AffectArmor
#DIM DYNAMIC shutUP
#DIM DYNAMIC AffectSTA
#DIM DYNAMIC nCloth
#DIM DYNAMIC effectPen
#DIMS DYNAMIC nClothName = "natural armor"
;invalid character
IF !INRANGE(nDealer,0,CHARANUM-1)
	shutUP = 1
	LOCAL = EffectivePenetration(ARG,nPart,ARG)
	effectPen = nDMG/1000
	GOTO CalculatePen
ENDIF
SIF charaWeaponInts:(nDealer):Burst > 30 || nNASQOL:1
	shutUP = 1
;cancer ray bypass
SIF GROUPMATCH(charaWeaponInts:nDealer:DamageType,11)
	RETURNF nDMG
LOCAL = EffectivePenetration(ARG,nPart,nDealer)
nCloth = RESULT:1
SIF !LOCAL
	RETURNF nDMG
IF nCloth
	SIF CLOTHES_TR(CLOTHNAME(nCloth,EQUIP:ARG:nCloth)) != ""
		nClothName '= @"%CLOTHES_TR(CLOTHNAME(nCloth,EQUIP:ARG:nCloth))%"
ENDIF
effectPen = charaWeaponInts:nDealer:Penetration
IF DT_EXIST("lcCombatants")
	effectPen += (3*DT_CELL_GET(@"lcCombatants", GetCombatant(nDealer) , "pierceBuff", 1))
ENDIF
$CalculatePen
DIFFERENCE = LOCAL - effectPen*100
;PRINTFORML Armor Strength: {LOCAL}, Penetraion Power: {GET_INT(ARG, "Weapon", EQUIP:nDealer:Weapon, "Penetration")*100}
RESULT:1 = DIFFERENCE
IF DIFFERENCE <= 0
	$BulletPen
	SIF !shutUP
		PRINTFORML %CALLNAME:ARG%의 %nClothName%를 관통했다!
	IF AffectArmor && ArmorCharges:ARG:nCloth:0 > 0
		ArmorCharges:ARG:nCloth:0 -= (nDMG*5/10)
		SIF ArmorCharges:ARG:nCloth:0 < 0
			PRINTFORML %CALLNAME:ARG%의 %nClothName%가 부서졌다!!
	ENDIF
	nDMG = nDMG * MIN(60 - MIN(DIFFERENCE,0),100)/100
	RETURNF nDMG
ELSE
	IF RAND(400) > DIFFERENCE
		GOTO BulletPen
	ELSE
		SIF !shutUP
			PRINTFORML 피해는 %CALLNAME:ARG%의 %nClothName%에 의해 완화되었다!
		IF AffectArmor && ArmorCharges:ARG:nCloth:0 > 0
			ArmorCharges:ARG:nCloth:0 -= (nDMG*8/10)
			SIF ArmorCharges:ARG:nCloth:0 < 0
				PRINTFORML %CALLNAME:ARG%'의 %nClothName%가(이) 부서졌다!!
		ENDIF
		nDMG = nDMG * 50/DIFFERENCE/10
		RETURNF MAX(nDMG,0)
	ENDIF
ENDIF

