@EXIST_RestraintCrotch_ID
#LOCALSIZE 1
#LOCALSSIZE 1
;GET_INT(C_ID, "Weapon", P_ID, "Accuracy")
;要素名→ID変換用関数
;必要なら各オブジェクトで同様に作成のこと

@RestraintCrotch_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
	C_NAME:O_ID = %GET_STR(, "RestraintCrotch", O_ID, "名前")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF

@RestrainCrotch1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "chastity cage")
	CASE "FullDesc"
		CALLF MAKE_STR(V_NAME, @"매끈하고 가볍고 통기성까지 좋은 우리 안에 귀여운 자지를 가두는 것보다 사랑스러운 일이 또 있을까? 아래쪽을 향하게 해%COND_STR(@" 착용자가 앉아서 소변을 보게 만들고",nPee)%, 즐겨 입는 속옷 위로는 조금도 불룩 튀어나오지 않는다!")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「RestraintCrotch」")
	CASE "Chastity"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "Tags"
		CALLF MAKE_STR(V_NAME, "safe virtue/")
ENDSELECT
