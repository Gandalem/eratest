#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "Gensou-chan romper")
CASE "描写"
	CALLF MAKE_STR(V_NAME, "diaperGensou")
CASE "FullDesc"
	IF CFLAG:102:面識 && nOmutsu
	LOCALS '= @"Romper with the design of %CALLNAME:102%. The art is cutesy and makes you want to coo, but %HE_SHE(102)% seems to be holding a thick diaper on one of %HIS_HER(102)% arms."
	ELSEIF CFLAG:102:面識
	LOCALS '= @"Romper with the design of %CALLNAME:102%. The art is cutesy and makes you want to coo, but %HE_SHE(102)% seems to be holding something thick in one of %HIS_HER(102)% arms."
	ELSEIF !CFLAG:102:面識
	LOCALS '= "A romper with a design of a demon. The art is cutesy and makes you want to coo."
	ENDIF
	CALLF MAKE_STR(V_NAME, LOCALS)
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「ボディースーツ」")
CASE "Armor"
	CALLF MAKE_INT(V_NAME, 4)
CASE "Armor Health"
	CALLF MAKE_INT(V_NAME, 3500)
CASE "Armor Coverage"
	CALLF MAKE_STR(V_NAME, "40/53/60")
CASE "Price"
	CALLF MAKE_INT(V_NAME, 18000)
CASE "Tags"
    CALLF MAKE_STR(V_NAME, "gensou-chan-ab/romper/")
;旧装備処理との照会用、上半身上着２の6
ENDSELECT

@ボディースーツ35(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	IF GETBIT(nVerboseItems,2)
		CALLF MAKE_STR(V_NAME, "Librebody")
	ELSE
		CALLF MAKE_STR(V_NAME, "EVA suit")
	ENDIF
CASE "FullName"
	IF GETBIT(nVerboseItems,2)
		CALLF MAKE_STR(V_NAME, "Cactus Company Extravehicular Activity Suit「Librebody」")
	ELSE
		CALLF MAKE_STR(V_NAME, "extravehicular activity suit")
	ENDIF
CASE "FullDesc"
	CALLF MAKE_STR(V_NAME, @"A hermetically sealed suit capable of protecting the user from hard vacuum with its own onboard air rebreather and O2 tank. Even unpowered it's better than nothing, by about four layers of insulation.")
CASE "Armor"
	CALLF MAKE_INT(V_NAME, 5)
CASE "Armor Health"
	CALLF MAKE_INT(V_NAME, 54000)
CASE "Armor Coverage"
	CALLF MAKE_STR(V_NAME, "40/53/61/20/30/81/91")	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「ボディースーツ」")
CASE "Price"
	CALLF MAKE_INT(V_NAME, 80000)
CASE "Tags"
    CALLF MAKE_STR(V_NAME, "cactus-comp/")
;旧装備処理との照会用、ボディースーツの1
ENDSELECT