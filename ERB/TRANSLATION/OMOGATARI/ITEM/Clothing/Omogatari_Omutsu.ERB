@EXIST_下半身下着_ずらし可能158
#LOCALSIZE 1
#LOCALSSIZE 1

@下半身下着_ずらし可能158(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "padded fundoshi")
	CASE "FullName"
		CALLF MAKE_STR(V_NAME, "RW 테일러 푹신한 훈도시")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "기저귀 하의 옷")
	CASE "FullDesc"
		CALLF MAKE_STR(V_NAME, @"버즈아이나 거즈처럼 두꺼운 기저귀급 천을 사용해 소변과 대변 실수를 흡수하고 담아낼 수 있는 훈도시입니다. 물론 새지 않으려면 여전히 비닐 팬티가 필요합니다.")
	CASE "透ける(前)"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "透ける(後)"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "はける"
		IF !nOmutsu
			CALLF MAKE_INT(V_NAME, 0)
			RETURNF
		ENDIF
		CALLF MAKE_INT(V_NAME, 1)
	CASE "関連下着"
		CALLF MAKE_INT(V_NAME, 0)
	CASE "Priority"
		CALLF MAKE_INT(V_NAME, 100)
	CASE "Unisex"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "Panties Type"
		CALLF MAKE_STR(V_NAME, "Diaper")
	CASE "Pee Capacity"
		CALLF MAKE_INT(V_NAME, 1250)
	CASE "Poo Capacity"
		CALLF MAKE_INT(V_NAME, 833)
	CASE "Armor"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "Armor Health"
		CALLF MAKE_INT(V_NAME, 650)
	CASE "Armor Coverage"
		CALLF MAKE_INT(V_NAME, 61)
	CASE "Can Wash"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "コレクション解禁条件"
		CALLF MAKE_STR(V_NAME, "Diaper")
	CASE "コレクション表示可能"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "Tags"
		CALLF MAKE_STR(V_NAME, "rw tailor/plain/washable/belted/")
ENDSELECT
