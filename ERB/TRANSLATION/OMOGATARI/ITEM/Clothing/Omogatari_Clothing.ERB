@clothing_DiapieBulgie(ARG)
#FUNCTION
#DIM nLoop
#DIM nDisc
#DIM nThreshold
#DIM nHighestLayer
#DIMS nClothingName
nDisc = 5
FOR nHighestLayer, 15, 4, -1
SIF GROUPMATCH(nHighestLayer, 8, 7)
	CONTINUE
nClothingName '= LOOK_AT_CLOTHNAME(ARG, nHighestLayer)
SIF !STRLENS(nClothingName)
	CONTINUE
BREAK
NEXT
nHighestLayer++
FOR nLoop, 15, 4, -1
SIF GROUPMATCH(nLoop, 8, 7, 6)
	CONTINUE
nClothingName '= LOOK_AT_CLOTHNAME(ARG, nLoop)
SIF !STRLENS(nClothingName)
	CONTINUE
nDisc = MIN(nDisc,clothing_UndiesDiscreteness(CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(nLoop)), EQUIP:ARG:nLoop, ARG))
NEXT
;DEBUGPRINTFORML Most conceablable Level: {nDisc}
IF nHighestLayer == 6 || nDisc == 5 || TEQUIP:ARG:PANTY_STATE != PANTY_WORN || CFLAG:うふふ
	;only wearing panties
	;or if pantsu has been manipulated, mainly during sex
	;or the "Her clothes are pulled up, revealing her ass" message is up, mainly in sex
	RETURNF 99
ELSEIF (IsPadded(ARG, "extreme") && SoiledDiaper(ARG,1,,50)) || IsPadded(ARG, "hyper")
	;HYPER diapers
	nThreshold = 0
ELSEIF (IsPadded(ARG, "bulky") && SoiledDiaper(ARG,1,,50)) || IsPadded(ARG, "extreme")
	;heavy diapers
	nThreshold = 1
ELSEIF (IsPadded(ARG, "thick") && SoiledDiaper(ARG,1,,50)) || IsPadded(ARG, "bulky")
	;heavy diapers
	nThreshold = 2
ELSEIF (IsPadded(ARG, "diaper") && SoiledDiaper(ARG,1,,50)) || IsPadded(ARG, "thick")
	;heavy diapers
	nThreshold = 3
ELSEIF IsPadded(ARG, "diaper")
	;diapers
	nThreshold = 4
ELSEIF IsPadded(ARG) || GROUPMATCH(EQUIP:ARG:6,53, 12)
	;all diapers
	nThreshold = 5
ELSE
	nThreshold = 6
ENDIF
;diaper cover
SIF EQUIP:ARG:7
	nThreshold --
;light diaper
SIF IsPadded(ARG, "thin")
	nThreshold ++
SIF STRFIND(GET_STR(ARG, "ボディースーツ", EQUIP:ARG:10, "Tags"), "romper/") > -1
	nThreshold += 2
;layers
;DEBUGPRINTFORML Threshold: {nThreshold}
IF nDisc >= nThreshold
	SELECTCASE nHighestLayer
		CASE 11
			RETURNF 2
		CASEELSE
			RETURNF 1
	ENDSELECT
ENDIF
IF HAS_PENIS(ARG) && BASE:ARG:勃起 == MAXBASE:ARG:勃起 && IsPadded(ARG)
	nThreshold -= 2
	IF nDisc >= nThreshold
		IF HAS_PENIS(ARG) && BASE:ARG:勃起 == MAXBASE:ARG:勃起
			RETURNF 4
		ENDIF
	ENDIF
ENDIF
