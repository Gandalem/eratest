@EXIST_頭装備50
#LOCALSIZE 1
#LOCALSSIZE 1

@頭装備50(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "삼각 머리 장식")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「帽子」")
	CASE "Price"
		CALLF MAKE_INT(V_NAME, 500)
	CASE "Tags"
		CALLF MAKE_STR(V_NAME, "rw tailor/")
		;旧装備処理との照会用、帽子の1
ENDSELECT

@EXIST_頭装備51
#LOCALSIZE 1
#LOCALSSIZE 1

@頭装備51(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		IF GETBIT(nVerboseItems,0)
			CALLF MAKE_STR(V_NAME, "SI-α901")
		ELSE
			CALLF MAKE_STR(V_NAME, "인이어 모니터")
		ENDIF
	CASE "FullName"
		CALLF MAKE_STR(V_NAME, "스이오토 레퍼런스급 인이어 모니터「SI-α901」")
	CASE "FullDesc"
		CALLF MAKE_STR(V_NAME, @"라이브 녹음 중 음향을 모니터링하기 위한 스튜디오급 인이어 헤드폰이다. 보통 인이어 모니터 또는 IEM이라 부르며, 일반 이어버드보다 착용감과 음질이 뛰어나다.")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「帽子」")
	CASE "Price"
		CALLF MAKE_INT(V_NAME, 55000)
	CASE "Tags"
		CALLF MAKE_STR(V_NAME, "suioto/")
		;旧装備処理との照会用、帽子の1
ENDSELECT

