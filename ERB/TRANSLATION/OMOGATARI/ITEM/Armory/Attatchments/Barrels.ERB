@EXIST_WeaponBarrelBody_ID
#LOCALSIZE 1
#LOCALSSIZE 1
;GET_INT(C_ID, "Weapon", P_ID, "Accuracy")
;要素名→ID変換用関数
;必要なら各オブジェクトで同様に作成のこと

@WeaponBarrelBody_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
	C_NAME:O_ID = %GET_STR(, "WeaponBarrelBody", O_ID, "名前")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF

@EXIST_WeaponBarrelBody1
#LOCALSIZE 1
#LOCALSSIZE 1

@WeaponBarrelBody1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "M602 브라우턴 20인치 (508mm) 총열")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "M602 소총용 풀 길이 20인(508mm)이다.")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「WeaponBarrelBody」")
	CASE "Barrel"
		CALLF MAKE_STR(V_NAME, "5.56x45mm")
	CASE "Accuracy"
		LOCAL = 30
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Platform"
		CALLF MAKE_STR(V_NAME, "AR-15/ar barrel/")
	CASE "Price"
		; default damage in a normal hit
		LOCAL = 4715
		CALLF MAKE_INT(V_NAME, LOCAL)
ENDSELECT

