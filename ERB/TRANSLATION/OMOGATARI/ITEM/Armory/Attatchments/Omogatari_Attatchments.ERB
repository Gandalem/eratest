@SetDefaultAttachments(ARG,nWeapon)
#FUNCTION
#DIM nWeapon
#DIM WeapInv
VARSET WeapInv
IF nWeapon > 600000000000000000
	;weaponinventory entry
	WeapInv = nWeapon
	;WeaponPreset = DT_CELL_GET("WeaponInventory", ARG, "detectedPreset", 1)
	nWeapon = DT_CELL_GET("WeaponInventory", nWeapon, "def", 1)
ENDIF
FOR LOCAL,0,VARSIZE("charaWeaponAtts")
IF GET_INT(ARG, "Weapon", nWeapon, @"%GetAttachmentType(LOCAL,0)%/Default")
	IF WeapInv && !DT_CELL_GET("WeaponInventory", nWeapon, GetAttachmentType(LOCAL,0), 1)
		DT_CELL_SET "WeaponInventory", nWeapon, GetAttachmentType(LOCAL,0), GET_INT(ARG, "Weapon", nWeapon, @"%GetAttachmentType(LOCAL,0)%의 기본"), 1
	ELSEIF EQUIP:ARG:Weapon == nWeapon
		;DEBUGPRINTFORML setting attachment's for {ARG} %CALLNAME:ARG%'s weapon no {nWeapon}.
		charaWeaponAtts:ARG:LOCAL = GET_INT(ARG, "Weapon", nWeapon, @"%GetAttachmentType(LOCAL,0)%의 기본값")
	ENDIF
ENDIF
NEXT

@RemoveCharaAttachments(ARG)
