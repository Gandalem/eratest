@ShowWeaponPreset(ARG,nWeaponPreset)
#DIM nWeaponPreset
#DIM SWP_LOOP
#DIM SWP_WEAPON
#DIM SWP_INPUT
SWP_WEAPON = GET_INT(ARG, "WeaponPreset", nWeaponPreset, "Base Weapon")
;show weapon stats
CALL WeaponDescription(nWeaponPreset+1000)
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
FOR SWP_LOOP,0,9
IF !GET_INT(ARG, "Weapon", SWP_WEAPON, GetAttachmentType(SWP_LOOP,2)) && SWP_LOOP
	CONTINUE
ENDIF
PRINTFORMS @"%GetAttachmentType(SWP_LOOP,1),16,LEFT%: %AttachmentDisplayName(ARG, GetAttachmentType(SWP_LOOP,0), PresetAttachment(nWeaponPreset,GetAttachmentType(SWP_LOOP,0)))%"
PRINTL
NEXT
IF PresetAttachment(nWeaponPreset,"WeaponAmmo")
	PRINTFORMS @"%"탄약",16,LEFT%: %AttachmentDisplayName(ARG, "WeaponAmmo", PresetAttachment(nWeaponPreset,"WeaponAmmo"))%"
	PRINTL
ENDIF
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
IF CAN_APPLY_PRESET(nWeaponPreset)
	PRINTFORML [100] - 모두 적용하기
	PRINTFORML [101] - 필수 항목만 적용하기
ELSE
	PRINTFORML [200] - 개발
ENDIF
PRINTL
PRINTFORML [999] - 취소
INPUT
SWP_INPUT = RESULT
SELECTCASE SWP_INPUT
	CASE 999
		RETURN
	CASE 100, 101
		FOR SWP_LOOP,0,9
		IF !GET_INT(ARG, "Weapon", GET_INT(ARG, "WeaponPreset", nWeaponPreset, "Base Weapon"), GetAttachmentType(SWP_LOOP,2)) && SWP_LOOP && SWP_INPUT == 101
			CONTINUE
		ENDIF
		DT_CELL_SET "WeaponInventory", TempMod, GetAttachmentType(SWP_LOOP,0), PresetAttachment(nWeaponPreset,GetAttachmentType(SWP_LOOP,0)), 1
		;SETVAR @"%GetAttachmentType(SWP_LOOP,0)%:{SWP_WEAPON}", PresetAttachment(nWeaponPreset, GetAttachmentType(SWP_LOOP,0))
		NEXT
		IF PresetAttachment(nWeaponPreset,"WeaponAmmo")
			DT_CELL_SET "WeaponInventory", TempMod, "WeaponAmmo", PresetAttachment(nWeaponPreset,"WeaponAmmo"), 1
			;WeaponAmmo:SWP_WEAPON = PresetAttachment(nWeaponPreset,"WeaponAmmo")
		ENDIF
	CASEELSE
ENDSELECT

@PresetAttachment(nWeaponPreset,nAttachmentType)
#FUNCTION
#DIM nWeaponPreset
#DIMS nAttachmentType
LOCAL:1 = GET_INT(MASTER, "WeaponPreset", nWeaponPreset, nAttachmentType+"/Required")
LOCAL:2 = GET_INT(MASTER, "WeaponPreset", nWeaponPreset, nAttachmentType+"/Default")
SIF !LOCAL:1 && !LOCAL:2
	RETURNF 0
IF LOCAL:1
	RETURNF LOCAL:1
ELSEIF LOCAL:2
	RETURNF LOCAL:2
ENDIF

