@GetWeaponPreset(ARG,nWeapon)
#FUNCTION
#DIM DYNAMIC nWeapon
#DIM DYNAMIC BestPreset,2
#DIM DYNAMIC nPreset
#DIM DYNAMIC nInventoryID
#DIM DYNAMIC nBaseID
nBaseID = nWeapon
IF !nWeapon
	RETURNF 0
ELSEIF nWeapon > 600000000000000000
	;weaponinventory entry
	nInventoryID = nWeapon
	;WeaponPreset = DT_CELL_GET("WeaponInventory", ARG, "detectedPreset", 1)
	nBaseID = DT_CELL_GET("WeaponInventory", nInventoryID, "def", 1)
ENDIF
SIF !STRLENS(PossibleWeaponPresets:nBaseID)
	RETURNF 0
LOCAL:4 = STRCOUNT(PossibleWeaponPresets:nBaseID,"/")
nPreset = 0
WHILE nPreset < LOCAL:4+1
CALLF DWP_SINGLE(ARG,nWeapon,TOINT(SPLIT_SINGLE(PossibleWeaponPresets:nBaseID,nPreset,"/")),BestPreset)
nPreset ++
WEND
;DEBUGPRINTFORML best matching preset is {BestPreset:0} with {BestPreset:1} points
RETURNF BestPreset

@DWP_SINGLE(ARG,nWeapon,nPreset,BestPreset)
#FUNCTION
#DIM DYNAMIC nWeapon
#DIM nPreset
#DIM DYNAMIC GUP_SCORE,2
#DIM REF BestPreset
#DIM DYNAMIC nBaseID
#DIM DYNAMIC nInventoryID
nBaseID = nWeapon
IF nWeapon > 600000000000000000
	;weaponinventory entry
	nInventoryID = nWeapon
	;WeaponPreset = DT_CELL_GET("WeaponInventory", ARG, "detectedPreset", 1)
	nBaseID = DT_CELL_GET("WeaponInventory", nInventoryID, "def", 1)
ENDIF
; SIF DetectingWeapPreset
; 	RETURNF
SIF !EXISTFUNCTION(@"WeaponPreset{nPreset}")
	RETURNF
SIF GET_INT(ARG,"WeaponPreset",nPreset,@"Base Weapon") != nBaseID
	RETURNF
VARSET GUP_SCORE
FOR LOCAL,0,VARSIZE("charaWeaponAtts")
IF GET_INT(ARG,"WeaponPreset",nPreset,@"%GetAttachmentType(LOCAL,0)%/Required")
	GUP_SCORE:1++
	SIF CurrentAttachment(ARG,nWeapon,GetAttachmentType(LOCAL,0)) == GET_INT(ARG,"WeaponPreset",nPreset,@"%GetAttachmentType(LOCAL,0)%/Required") || (CurrentAttachment(ARG,nWeapon,GetAttachmentType(LOCAL,0)) <= 0 && GET_INT(ARG,"WeaponPreset",nPreset,@"%GetAttachmentType(LOCAL,0)%/Required") < 0)
		GUP_SCORE:0++
ELSE
	CONTINUE
ENDIF
NEXT
IF GUP_SCORE:0 >= GUP_SCORE:1 && GUP_SCORE:1
	IF GUP_SCORE:1 > BestPreset:1
		BestPreset:0 = nPreset
		BestPreset:1 = GUP_SCORE:1
	ENDIF
ENDIF

