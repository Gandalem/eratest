@PickWeaponPresets(CanDev)
#DIM CanDev
#DIM DYNAMIC nPreset
#DIM DYNAMIC PWP_LINE
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
PWP_LINE = LINECOUNT
DO
CLEARLINE LINECOUNT-PWP_LINE
FOR nPreset, 0, VAR_TEMP_MAX
SIF !EXISTFUNCTION(@"WeaponPreset{nPreset}")
	CONTINUE
SIF GET_INT(0,"WeaponPreset",nPreset,@"Base Weapon") != TempMod
	CONTINUE
PRINTFORML [{nPreset,3}] - %ALL_BRANDS_NAMES(GET_STR(0,"WeaponPreset",nPreset,@"제조사"),1)% %GET_STR(0,"WeaponPreset",nPreset,@"이름")%
NEXT
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
PRINTFORML [999] - 반환
INPUT
SELECTCASE RESULT
	CASE 999
		RETURN
	CASEELSE
		SIF !EXISTFUNCTION(@"WeaponPreset{RESULT}")
			CONTINUE
		SIF GET_INT(0,"WeaponPreset",RESULT,@"Base Weapon") != TempMod
			CONTINUE
		CALL ShowWeaponPreset(MASTER,RESULT)
ENDSELECT
LOOP 1

@ShowWeaponPreset(ARG,nWeaponPreset)
#DIM nWeaponPreset
#DIM SWP_LOOP
#DIM SWP_WEAPON
#DIM SWP_INPUT
SWP_WEAPON = GET_INT(ARG, "WeaponPreset", nWeaponPreset, "Base Weapon")
;show weapon stats
CALL WeaponDescription(nWeaponPreset+1000)
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
FOR SWP_LOOP,0,9
IF !GET_INT(ARG, "Weapon", SWP_WEAPON, GetAttachmentType(SWP_LOOP,2)) && SWP_LOOP
	CONTINUE
ENDIF
PRINTFORMS @"%GetAttachmentType(SWP_LOOP,1),16,LEFT%: %AttachmentDisplayName(ARG, GetAttachmentType(SWP_LOOP,0), PresetAttachment(nWeaponPreset,GetAttachmentType(SWP_LOOP,0)))%"
PRINTL
NEXT
IF PresetAttachment(nWeaponPreset,"WeaponAmmo")
	PRINTFORMS @"%"탄약",16,LEFT%: %AttachmentDisplayName(ARG, "WeaponAmmo", PresetAttachment(nWeaponPreset,"WeaponAmmo"))%"
	PRINTL
ENDIF
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
IF CAN_APPLY_PRESET(nWeaponPreset)
	PRINTFORML [100] - 모두 적용하기
	PRINTFORML [101] - 필수 항목만 적용하기
ELSE
	PRINTFORML [200] - 개발
ENDIF
PRINTL
PRINTFORML [999] - 취소
INPUT
SWP_INPUT = RESULT
SELECTCASE SWP_INPUT
	CASE 999
		RETURN
	CASE 100, 101
		FOR SWP_LOOP,0,9
		IF !GET_INT(ARG, "Weapon", GET_INT(ARG, "WeaponPreset", nWeaponPreset, "Base Weapon"), GetAttachmentType(SWP_LOOP,2)) && SWP_LOOP && SWP_INPUT == 101
			CONTINUE
		ENDIF
		DT_CELL_SET "WeaponInventory", TempMod, GetAttachmentType(SWP_LOOP,0), PresetAttachment(nWeaponPreset,GetAttachmentType(SWP_LOOP,0)), 1
		;SETVAR @"%GetAttachmentType(SWP_LOOP,0)%:{SWP_WEAPON}", PresetAttachment(nWeaponPreset, GetAttachmentType(SWP_LOOP,0))
		NEXT
		IF PresetAttachment(nWeaponPreset,"WeaponAmmo")
			DT_CELL_SET "WeaponInventory", TempMod, "WeaponAmmo", PresetAttachment(nWeaponPreset,"WeaponAmmo"), 1
			;WeaponAmmo:SWP_WEAPON = PresetAttachment(nWeaponPreset,"WeaponAmmo")
		ENDIF
	CASEELSE
ENDSELECT

@PresetAttachment(nWeaponPreset,nAttachmentType)
#FUNCTION
#DIM nWeaponPreset
#DIMS nAttachmentType
LOCAL:1 = GET_INT(MASTER, "WeaponPreset", nWeaponPreset, nAttachmentType+"/Required")
LOCAL:2 = GET_INT(MASTER, "WeaponPreset", nWeaponPreset, nAttachmentType+"/Default")
SIF !LOCAL:1 && !LOCAL:2
	RETURNF 0
IF LOCAL:1
	RETURNF LOCAL:1
ELSEIF LOCAL:2
	RETURNF LOCAL:2
ENDIF

@CAN_APPLY_PRESET(nWeaponPreset)
#FUNCTION
#DIM nWeaponPreset
#DIM CAP_POINTS,2
#DIM SWP_LOOP
VARSET CAP_POINTS
SIF TFLAG:989
	RETURNF 1
FOR SWP_LOOP,0,9
IF !GET_INT(0, "Weapon", GET_INT(0, "WeaponPreset", nWeaponPreset, "Base Weapon"), GetAttachmentType(SWP_LOOP,2)) && SWP_LOOP
	CONTINUE
ENDIF
PRINTFORMS @"%GetAttachmentType(SWP_LOOP,1),16,LEFT%: %AttachmentDisplayName(0, GetAttachmentType(SWP_LOOP,0), PresetAttachment(nWeaponPreset,GetAttachmentType(SWP_LOOP,0)))%"
PRINTL
NEXT
