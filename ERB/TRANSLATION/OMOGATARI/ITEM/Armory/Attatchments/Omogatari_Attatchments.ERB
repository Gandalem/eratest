@AttachmentMatchesWeapon(Attachment,weapon,AttachmentType)
#FUNCTION
#DIMS AttachmentType
#DIM weapon
#DIM Attachment
#DIM weaponBase
SIF !STRLENS(GET_STR(MASTER, AttachmentType, Attachment, "名前")) && Attachment != 0
	RETURNF 0
;knife exception
SIF PreviewWeaponStrs:1 == "knife/"
	RETURNF 1
;supports all
SIF GET_STR(MASTER, AttachmentType, Attachment, "Platform") == "everything/"
	RETURNF 1
IF weapon > 600000000000000000
	weaponBase = DT_CELL_GET("WeaponInventory", weapon, "def", 1)
ELSE
	weaponBase = weapon
ENDIF
SELECTCASE AttachmentType
	CASE "WeaponAmmo"
		SIF PreviewWeaponStrs:1 != GET_STR(MASTER, "WeaponAmmo", Attachment, "Ammo") && Attachment != 0
			RETURNF 0
	CASE "WeaponBarrel"
		; SIF PreviewWeaponStrs:1 != GET_STR(MASTER, "WeaponBarrel", Attachment, "Ammo") && Attachment != 0
		; 	RETURNF 0
		SIF !STRLENS(PreviewWeaponStrs:0)
			RETURNF 0
		; FOR LOCAL:1, 0,STRCOUNT(PreviewWeaponStrs:0,"/")
		; 	SIF STRFIND(GET_STR(MASTER, AttachmentType, Attachment, "Platform"),SPLIT_SINGLE(PreviewWeaponStrs:0,LOCAL:1,"/")) == -1 && Attachment != 0
		; 		CONTINUE
		; 	GOTO BarrelCheckAfter
		; NEXT
		; RETURNF 0
		; $BarrelCheckAfter
		FOR LOCAL:1, 0,MAX(1,STRCOUNT(GET_STR(MASTER, AttachmentType, Attachment, "Ammo"),"/"))
		SIF STRFIND(PreviewWeaponStrs:1,SPLIT_SINGLE(GET_STR(MASTER, AttachmentType, Attachment, "Ammo"),LOCAL:1,"/")) == -1 && Attachment != 0
			CONTINUE
		RETURNF 1
		NEXT
		RETURNF 0
	CASE "WeaponSight"
		SIF WeaponHasAttachmentSlot(weapon, 3) < GET_INT(MASTER, "WeaponSight", Attachment, "Sight Slot") && Attachment != 0
			RETURNF 0
	CASE "WeaponMag"
		SIF STRFIND(GET_STR(MASTER, AttachmentType, Attachment, "Ammo"),PreviewWeaponStrs:1) == -1 && Attachment != 0
			RETURNF 0
		RETURNF 1
		$WeaponAmmoAfter
	CASE "WeaponTactical", "WeaponForegrip"
		RETURNF 1
	CASE "WeaponReceiver"
		SIF GET_INT(MASTER, AttachmentType, Attachment, "Base Weapon") == weaponBase
			RETURNF 1
		RETURNF 0
	CASEELSE
		SIF !STRLENS(PreviewWeaponStrs:0)
			RETURNF 0
		$PlatformCheck
		FOR LOCAL:1, 0,STRCOUNT(PreviewWeaponStrs:0,"/")
		SIF STRFIND(GET_STR(MASTER, AttachmentType, Attachment, "Platform"),SPLIT_SINGLE(PreviewWeaponStrs:0,LOCAL:1,"/")) == -1 && Attachment != 0
			CONTINUE
		RETURNF 1
		NEXT
		RETURNF 0
ENDSELECT
RETURNF 1

@WeaponHasAttachmentSlot(weapon, attachmentTypeID)
#FUNCTION
#DIM attachmentTypeID
#DIM weapon
#DIM weaponBase
#DIM weaponAtt
#DIM weaponAttGet
weaponBase = weapon
IF weapon > 600000000000000000
	weaponBase = DT_CELL_GET("WeaponInventory", weapon, "def", 1)
ENDIF
; SIF (GET_STR(, "Weapon", weaponBase, "Type") == "Firearm") && attachmentTypeID == 9
; 	RETURNF 1
SELECTCASE attachmentTypeID
	CASE 0
		SIF GET_STR(, "Weapon", weaponBase, "Type") == "Firearm"
			RETURNF 1
		SIF GET_INT(, "Weapon", weaponBase, "Receiver Slot") == -1
			RETURNF 0
	CASE 9
		;GET_STR(, "Weapon", weaponBase, "Type") == "Firearm"
		SIF GET_STR(, "Weapon", weaponBase, "Ammo") != ""
			RETURNF 1
		SIF GET_STR(, "Weapon", weaponBase, "Type") == "Firearm"
			RETURNF 1
		; SIF (GET_INT(, "Weapon", weaponBase, "Firearm Template"))
		; 	RETURNF 1
ENDSELECT
IF weapon > 600000000000000000
	weaponAttGet = GET_INT(MASTER, "WeaponReceiver", DT_CELL_GET("WeaponInventory", weapon, "WeaponReceiver", 1), GetAttachmentType(attachmentTypeID,2))
	FOR LOCAL,1,VARSIZE("charaWeaponAtts")
	weaponAtt = DT_CELL_GET("WeaponInventory", weapon, GetAttachmentType(LOCAL), 1)
	SIF !weaponAtt
		CONTINUE
	LOCAL:1 = GET_INT(MASTER, GetAttachmentType(LOCAL), weaponAtt, GetAttachmentType(attachmentTypeID,2))
	SELECTCASE LOCAL:1
		CASE IS != 0
			weaponAttGet = LOCAL:1
	ENDSELECT
	NEXT
ENDIF
SELECTCASE weaponAttGet
	CASE 0
		RETURNF GET_INT(MASTER, "Weapon", weaponBase, GetAttachmentType(attachmentTypeID,2))
	CASE IS > 0
		RETURNF weaponAttGet
	CASE IS < 0
		RETURNF 0
ENDSELECT

