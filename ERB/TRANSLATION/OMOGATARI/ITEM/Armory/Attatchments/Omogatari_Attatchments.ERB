@SelectWeaponMod(AttachmentType, CanDev)
#DIM Attachment
#DIMS AttachmentType
#DIM CanDev
#DIM SWM_LINECOUNT
SWM_LINECOUNT = LINECOUNT
DO
CLEARLINE LINECOUNT-SWM_LINECOUNT
IF AttachmentMatchesWeapon(999,TempMod,AttachmentType)
	PRINTFORML [999] %GET_STR(MASTER, AttachmentType, 999, "名前")%
ENDIF
FOR LOCAL, 0, VAR_TEMP_MAX-1
SIF !AttachmentMatchesWeapon(LOCAL,TempMod,AttachmentType) && LOCAL != 0
	CONTINUE
SIF LOCAL == 0 && GROUPMATCH(AttachmentType,"WeaponReceiver")
	CONTINUE
PRINTFORML [{LOCAL,3}] %GET_STR(MASTER, AttachmentType, LOCAL, "名前")%
NEXT
PRINTFORML [-10] - 반환
INPUT
Attachment = RESULT
SELECTCASE Attachment
	CASE -10
		RETURN -533
	CASE 0 TO VAR_TEMP_MAX
		IF !AttachmentMatchesWeapon(Attachment,TempMod,AttachmentType) && LOCAL != 0
			REUSELASTLINE "호환되지 않는 부착물입니다."
		ENDIF
		CALL DevelopWeaponMod(Attachment,AttachmentType,CanDev)
ENDSELECT
LOOP 1

@DevelopWeaponMod(Attachment,AttachmentType,CanDev)
#DIM Attachment
#DIMS AttachmentType
#DIM CanDev
IF RESULT <= CHARANUM
	Attachment = RESULT
	CALL WeaponDescription(TempMod,Attachment,AttachmentType)
	IF !GETVAR(@"Developed%AttachmentType%:{Attachment}") && Attachment && !TFLAG:989
		IF CanDev
			PRINTFORML %GET_STR(MASTER, AttachmentType, Attachment, "名前")%를 개발한다?
			CALL PAY_YEN_OR_CM(GET_INT(MASTER, AttachmentType, Attachment, "Price"),GET_INT(MASTER, AttachmentType, Attachment, "Price")/MAX(1,CHARISMA_NOW()))
			IF RESULT
				;SETVAR @"%AttachmentType%:{TempMod}", Attachment
				;DT_CELL_SET "WeaponInventory", TempMod, AttachmentType, Attachment, 1
				SETVAR @"Developed%AttachmentType%:{Attachment}", 1
				SIF AttachmentType == "WeaponAmmo"
					AmmoStock:Attachment = 20
				PRINTFORML %GET_STR(MASTER, AttachmentType, Attachment, "名前")%를 개발했다!
				RETURN -533
			ELSE
				RETURN -533
			ENDIF
		ELSE
			PRINTFORMW %CALLNAME:51%에게 가거나 인터넷에서 이것을 개발해라.
			RETURN -533
		ENDIF
	ELSE
		PRINTFORML [  0] 장비
		SIF Attachment && CanDev && AttachmentType == "WeaponAmmo"
			PRINTFORML [  1] - 재고 구매하기 (현재 소지량 {AmmoStock:Attachment})
		PRINTFORML [999] - 반환
		INPUT
		IF RESULT == 0
			;SETVAR @"%AttachmentType%:{TempMod}", Attachment
			DT_CELL_SET "WeaponInventory", TempMod, AttachmentType, Attachment, 1
			SIF TFLAG:989 && AttachmentType == "WeaponAmmo"
				AmmoStock:Attachment = MAX(AmmoStock:Attachment,9999)
			PRINTFORML 장착한 것은 %GET_STR(MASTER, AttachmentType, Attachment, "名前")%이다!
			RETURN -533
		ELSEIF RESULT == 1 && AttachmentType == "WeaponAmmo"
			SIF !CanDev
				RETURN -533
			IF GET_INT(MASTER, "WeaponAmmo", Attachment, "Unit Price")
				LOCAL = GET_INT(MASTER, "WeaponAmmo", Attachment, "Unit Price")
			ELSE
				LOCAL = GET_INT(MASTER, "WeaponAmmo", Attachment, "Price")/1000
			ENDIF
			PRINTFORML 구매할 원하는 %GET_STR(MASTER, "WeaponAmmo", Attachment, "名前")%의 개수를 선택하십시오. (비용 \\{LOCAL}/라운드 보유량: {AmmoStock:Attachment})
			PRINTL [  10] １０　
			PRINTL [  20] ２０　
			PRINTL [  50] ５０　
			PRINTL [ 100] １００
			PRINTL [ 250] ２５０
			PRINTL [ 500] ５００
			PRINTL [1000] １０００								
			PRINTFORML [{MONEY/LOCAL}] 가능한 한 많이
			PRINTL [ 0] 취소
			INPUT
			LOCAL:1 = RESULT
			IF RESULT > 0
				CALL PAY_YEN_OR_CM(LOCAL*(LOCAL:1),(LOCAL*(LOCAL:1))/CHARISMA_NOW())
				IF RESULT
					AmmoStock:Attachment += LOCAL:1
					PRINTFORML %GET_STR(MASTER, "WeaponAmmo", Attachment, "名前")% 탄 {LOCAL:1}개를 구매했다!
					PRINTFORMW 이제 당신은 {AmmoStock:Attachment}발의 탄약을 가지고 있다.
					RETURN -533
				ELSE
					RETURN -533
				ENDIF
			ELSE
				RETURN -533
			ENDIF
		ELSE
			RETURN -533
		ENDIF
	ENDIF
ELSE
	RETURN -533
ENDIF
