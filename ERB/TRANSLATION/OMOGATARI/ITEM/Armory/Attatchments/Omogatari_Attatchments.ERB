@WEAPON_MODIFY(TempMod,CanDev=0)
#DIM CanDev
#DIM WM_LINE
#DIM WM_BASE
WM_BASE = TempMod
IF TempMod > 600000000000000000
	;weaponinventory entry
	WM_BASE = DT_CELL_GET("WeaponInventory", TempMod, "def", 1)
ENDIF
PRINTFORML 무기 플랫폼: %LIST_IN_STRING(GET_STR(MASTER, "Weapon", TempMod, "Platform"), "/")%
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
WM_LINE = LINECOUNT
CALLF SetDefaultAttachments(MASTER,TempMod)
$ModMenu
CLEARLINE LINECOUNT-WM_LINE
FOR LOCAL,0,VARSIZE("CharaWeaponAtts")
IF !WeaponHasAttachmentSlot(TempMod,LOCAL)
	CONTINUE
ENDIF
PRINTBUTTON @"%GetAttachmentType(LOCAL,1),16,LEFT%: %AttachmentDisplayName(MASTER, GetAttachmentType(LOCAL,0), DT_CELL_GET("WeaponInventory", TempMod, GetAttachmentType(LOCAL,0), 1))%", LOCAL
PRINTL
NEXT
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
