@WeaponPreset1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "Name"
		IF GETBIT(nVerboseItems,3)
			CALLF MAKE_STR(V_NAME, "HK33")
		ELSEIF GETBIT(nVerboseItems,1)
			CALLF MAKE_STR(V_NAME, "GH33")
		ELSE
			CALLF MAKE_STR(V_NAME, "외부 세계 돌격소총")
		ENDIF
	CASE "FullName"
		IF GETBIT(nVerboseItems,3)
			CALLF MAKE_STR(V_NAME, "헤클러 앤 코흐 「HK33」 돌격소총")
		ELSEIF GETBIT(nVerboseItems,1)
			CALLF MAKE_STR(V_NAME, "게이브 허버트 「GH33」 돌격소총")
		ELSE
			CALLF MAKE_STR(V_NAME, "외부 세계 돌격소총")
		ENDIF
	CASE "Description"
		CALLF MAKE_STR(V_NAME, "GH31을 기반으로 한 돌격소총인 GH33은 비교적 흔한 파생형 중 하나로, 전출력 7.62x51mm 대신 중간위력 5.56x45mm 탄을 사용한다. 검은색 플라스틱 가구와 40발 탄창이 기본 장착된다.")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「WeaponPreset」")
	CASE "Tags"
		CALLF MAKE_STR(V_NAME, @"civilian/military/cold war/modern/western/battle rifle/")
	CASE "Platform"
		CALLF MAKE_STR(V_NAME, "CETME/")
	CASE "Manufacturer"
		CALLF MAKE_STR(V_NAME, @"\@ GETBIT(nVerboseItems,3) ? heckler&koch # gabe-hubert\@")
	CASE "Base Weapon"
		CALLF MAKE_INT(V_NAME, 401)
	CASE "WeaponReceiver/Required"
		CALLF MAKE_INT(V_NAME, 116)
	CASE "WeaponBarrelBody/Default"
		CALLF MAKE_INT(V_NAME, 96)
	CASE "WeaponMag/Default"
		CALLF MAKE_INT(V_NAME, 16)
	CASE "WeaponGrip/Default"
		CALLF MAKE_INT(V_NAME, 2)
	CASE "WeaponStock/Default"
		CALLF MAKE_INT(V_NAME, 55)
ENDSELECT

