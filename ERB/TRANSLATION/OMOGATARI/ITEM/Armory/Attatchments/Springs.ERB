; Modular ERB: OMOGATARI/ITEM/Armory/Attatchments/Springs.ERB

@WeaponSpring_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
	C_NAME:O_ID = %GET_STR(, "WeaponSpring", O_ID, "名前")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF

@WeaponSpring1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "SPP GKO622 3J spring")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "SPP 권총용 3 줄 가벼운 스프링.")
	CASE "ShortName"
		CALLF MAKE_STR(V_NAME, "SPP 3J")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「WeaponBarrelBody」")
	CASE "Damage"
		LOCAL = 50
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Range"
		LOCAL = 2
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Platform"
		CALLF MAKE_STR(V_NAME, "MP-53/")
	CASE "Price"
		; default damage in a normal hit
		LOCAL = 750
		CALLF MAKE_INT(V_NAME, LOCAL)
ENDSELECT

