		CALLF MAKE_STR(V_NAME, "FS LC200N")
	CASE "Damage"
		LOCAL = 500
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Penetration"
		LOCAL = 3
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Accuracy"
		LOCAL = 50
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Burst"
		LOCAL = 2
		CALLF MAKE_INT(V_NAME, LOCAL)
