@WeaponBlade_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
		C_NAME:O_ID = %GET_STR(, "WeaponBlade", O_ID, "名前")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF	

@WeaponBlade1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "Free Spirit Cunnyco LC200N blade")
CASE "描写"
	CALLF MAKE_STR(V_NAME, "LC200N nitrogen alloyed steel blade for Free Spirit knife.")
CASE "ShortName"
	CALLF MAKE_STR(V_NAME, "FS LC200N")
CASE "Damage"
	LOCAL = 500
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Penetration"
	LOCAL = 3
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Accuracy"
	LOCAL = 50
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Burst"
	LOCAL = 2
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Pellets"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Range"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Price"
	; default damage in a normal hit
	LOCAL = 750
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Platform"
	CALLF MAKE_STR(V_NAME, "knife/")
ENDSELECT

