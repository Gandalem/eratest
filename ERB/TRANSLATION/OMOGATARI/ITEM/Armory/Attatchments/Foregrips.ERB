@EXIST_WeaponForegrip_ID
#LOCALSIZE 1
#LOCALSSIZE 1
;GET_INT(C_ID, "Weapon", P_ID, "Accuracy")
;要素名→ID変換用関数
;必要なら各オブジェクトで同様に作成のこと

@WeaponForegrip_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
	C_NAME:O_ID = %GET_STR(, "WeaponForegrip", O_ID, "名前")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF

@EXIST_WeaponForegrip1
#LOCALSIZE 1
#LOCALSSIZE 1

@WeaponForegrip1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "MOE Foregrip")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "마크소프트 오퍼레이터 장비 전술 수직 그립은 형태와 기능을 통합했다. 하이브리드 디자인의 형상은 일반적인 포어그립으로도 작동하고, 엄지손가락을 사용하는 방식일 때는 편안한 손잡이 역할도 한다. 이 그립은 사용자가 자신감을 가지고 무기를 다룰 수 있게 하며, 유기적인 디자인은 오퍼레이터가 어떤 순간에도 가장 편안한 방식으로 소총을 조작할 수 있도록 한다.")
	CASE "ShortName"
		CALLF MAKE_STR(V_NAME, "MOE")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「WeaponForegrip」")
	CASE "Price"
		; default damage in a normal hit
		LOCAL = 4715
		CALLF MAKE_INT(V_NAME, LOCAL)
ENDSELECT

