;Arrows:
;- Broadhead (for unarmored)
;- Bodkin point (for armored targets)
;- Poison arrow
;- Sleep arrow
;- Arousal arrow
;- Healing arrow
;- Pee-soaked arrow (decay damage)
;- High explosive (explodes on impact)
;- Gensou-chan ESPKill (magic arrows with Shinki's blessing)
;- LUNINCO Youkai Killer (ESPKill at home, psychosis damage)
;- Phantom Dynamics GunArrow .308 (shoot 7.62x51mm from a bow!)
;A modification that turns the bow into a single shot firearm. Attatches to the bow with two screws and the string going through a hook on the hammer. To load, just open the latch, place your cartridge in, close the latch, aim, pull the string, and release to fire.
;Weapon personalization: Rename weapons!
;ESPKill-Agi
;ESPKill-Bufu
;ESPKill-Zio
;ESPKill-Zan
;ESPKill-Frei
;ESPKill-Psi

@BulletNameGeneric(ARGS)
#FUNCTIONS
SELECTCASE ARGS
	CASE "espkill-psi"
		RETURNF "Gensou-chan \"ESPKill-Psi\" Psychosis Yojipowder cartridge"
	CASE "espkill-agi"
		RETURNF "Gensou-chan \"ESPKill-Agi\" Incendiary Yojipowder cartridge"
	CASE "espkill-bufu"
		RETURNF "Gensou-chan \"ESPKill-Bufu\" Frostbite Yojipowder cartridge"
	CASE "espkill-frei"
		RETURNF "Gensou-chan \"ESPKill-Frei\" Uranium Yojipowder cartridge"
	CASE "espkill-zio"
		RETURNF "Gensou-chan \"ESPKill-Zio\" Electric Yojipowder cartridge"
	CASE "espkill-zan"
		RETURNF "Gensou-chan \"ESPKill-Zan\" High Explosive Yojipowder cartridge"
	CASE "espkill-dorima"
		RETURNF "Gensou-chan \"ESPKill-Dorima\" Tranquilizing Yojipowder cartridge"
	CASE "luninco-youkai"
		RETURNF "LUNINCO \"Youkai Killer\" Psychosis cartridge"
	CASE "simunition"
		RETURNF "ArmTeck \"F2F\" non-lethal cartridge"
	CASEELSE
		RETURNF ARGS
ENDSELECT

@BulletDescGeneric(ARGS)
#FUNCTIONS
