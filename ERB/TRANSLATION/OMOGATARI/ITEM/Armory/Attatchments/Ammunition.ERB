@BulletDescGeneric(ARGS)
#FUNCTIONS
SELECTCASE ARGS
	CASE "espkill"
		RETURNF "게은짱 에스피킬은 부여된 속성에 따라 서로 다른 피해를 주는 특수 탄환 계열이다. 요괴의 타고난 방어력은 물론 일반 방탄 장비에도 뛰어난 효과가 입증됐다. 강력한 추진제로는 요술의 정수를 원료로 만든 요지파우더를 사용한다."
	CASE "espkill-arrow"
		RETURNF "게은짱 에스피킬 화살은 부여된 속성에 따라 서로 다른 피해를 주는 특수 화살 계열이다. 요괴의 타고난 방어력과 일반 보호 장비 모두에 효과적이다. 발사 순간에는 요술의 정수를 고농축한 추진제, 요지파우더가 화살을 힘껏 밀어낸다."
	CASE "espkill-psi"
		RETURNF "에스피킬-사이는 정신 공격에 특화되어 있지만 실탄 무기인 이상 치명성은 남아 있다. 따라서 스펠 카드 규칙을 적용하는 탄막 승부에서는 사용이 금지된다."
	CASE "espkill-zan"
		RETURNF "에스피킬-잔은 폭발과 함께 충격 피해를 퍼뜨리는 대인용 고폭탄이다. 철갑 관통자가 일반 방탄 장비를 뚫은 뒤 표적의 몸속에서 터져 치명상을 남긴다. 실제 화약 대신 착탄 순간 잔 술식을 발동하기 때문에 이런 이름이 붙었다."
	CASE "espkill-agi"
		RETURNF "에스피킬-아기는 소이탄답게 화염 피해를 주며 일정 확률로 표적에게 화상을 입힌다."
	CASE "espkill-bufu"
		RETURNF "에스피킬-부후는 명중 부위를 급속 냉각해 동상을 일으키는 초저온 탄환이다. 총상은 보통 열을 남기지만 맞은 부위는 오히려 차갑게 얼어붙는다."
	CASE "espkill-frei"
		RETURNF "에스피킬-프레이는 방사성 우라늄 관통자를 이용해 방사능 피해를 준다."
	CASE "espkill-dorima"
		RETURNF "에스피킬-도리마는 살상 대신 표적을 전투에서 이탈시키도록 설계된 진정탄이다. 일반적인 제압 수단보다 안전하고 오래 적을 무력화한다. 짧게 기절시키거나 연속으로 명중시켜 기력을 완전히 소진한 뒤 의식을 잃게 할 수도 있다."
	CASE "luninco-youkai"
		RETURNF "게은짱 에스피킬을 모방해 정신 붕괴 효과만 남긴 과압 탄약이다."
	CASE "simunition"
		RETURNF "속이 빈 1그램짜리 PLA 플라스틱 탄자를 넣은 둥근 탄두 탄약이다. 대인 모의 교전, 즉 F2F 훈련용으로 만든 저살상탄이며 뇌관의 힘만으로 발사된다. 목적은 살해가 아니라 행동 불능이다."
	CASE "gpt"
		RETURNF "지상군 방호 상의는 연방 보병이 피해를 막기 위해 사용하는 주력 보호 장비다."
	CASE "pissAmmo"
		RETURNF "인간과 요괴를 비롯한 여러 동물의 소변에 담가 둔 탄환이다. 완전피갑탄이 장갑과 피부를 뚫으면 열린 상처를 통로 삼아 세균을 퍼뜨린다. 부패 피해를 주며, 달의 주민처럼 「순수한」 존재를 상대할 때 특히 효과적이다."
	CASE "youpan"
		RETURNF "케이가 엔터프라이즈의 유팬은 은밀한 마법을 품은 팬티다. 배설물에서 나온 요술 에너지로 주문을 발동하므로 마법이 필요할 때 안에 오줌이나 똥을 싸기만 하면 된다. 양이 많을수록 주문도 강해진다. 단, 이미 새거나 넘친 상태라면 깨끗이 갈아입기 전까지 발동하지 않는다."
	CASE "emag"
		RETURNF "이매그는 에스퍼식 최대 흡수 의복의 약자로, 매그의 흡수력에 에스퍼 기술을 더한 전술용 기저귀다. 새어 나온 배설물을 동력으로 삼아 착용자 대신 주문을 시전하며 한 번에 많이 쌀수록 주문도 강해진다. 벨트형이라 교체가 쉽고 초흡수 소재와 샘 방지벽으로 소변 세 번과 대변 두 번을 버틸 수 있다."
	CASE "brim"
		RETURNF "당장 마법이 필요한가? 코프로다인을 난사하는 적에게 반격하고 싶은가? 그렇다면 블로트 반응 즉석 마법, 줄여서 브림을 챙겨라. 오줌이나 똥으로 속옷을 더럽히면 조율된 속성의 주문이 발동한다. 안에 싼 양에 따라 주문이 달라지며 새거나 넘치기 전까지 계속 쓸 수 있다."
	CASE "brim-agi"
		RETURNF "아기에 조율된 속옷은 오줌을 싸면 아기, 아기라오, 아기다인 같은 단일 대상 화염 주문을 시전한다. 똥을 싸면 다중 대상 주문으로 바뀐다."
	CASE "brim-bufu"
		RETURNF "부후에 조율된 속옷은 오줌을 싸면 부후, 부후라, 부후다인 같은 단일 대상 냉기 주문을 시전한다. 똥을 싸면 다중 대상 주문으로 바뀐다."
	CASE "brim-dia"
		RETURNF "디아에 조율된 속옷은 오줌을 싸면 디아, 디아라마, 디아라한 같은 단일 대상 회복 주문을 시전한다. 똥을 싸면 다중 대상 주문으로 바뀐다."
	CASE "brim-psi"
		RETURNF "사이에 조율된 속옷은 오줌을 싸면 사이, 사이오, 사이오다인 같은 단일 대상 정신 주문을 시전한다. 똥을 싸면 다중 대상 주문으로 바뀐다."
	CASE "brim-frei"
		RETURNF "프레이에 조율된 속옷은 오줌을 싸면 프레이, 프레이라, 프레이다인 같은 단일 대상 방사능 주문을 시전한다. 똥을 싸면 다중 대상 주문으로 바뀐다."
	CASE "brim-zan"
		RETURNF "잔에 조율된 속옷은 오줌을 싸면 잔, 잔마, 잔다인 같은 단일 대상 충격 주문을 시전한다. 똥을 싸면 다중 대상 주문으로 바뀐다."
	CASE "brim-tarakaja"
		RETURNF "타루카자에 조율된 속옷은 오줌을 싸면 타루카자를 시전한다. 똥을 싸면 다중 대상 주문으로 바뀌며 더 심하게 더럽힐수록 상위 주문이 발동한다."
	CASE "brim-fb"
		RETURNF "브림-FB는 판타스타밥의 파생형이다. 두꺼운 초흡수 코어, 보송함을 지키는 비비 코팅, 빳빳한 비닐 겉감, 세워진 샘 방지벽, 네 개의 재부착 테이프와 젖음 표시선까지 원형의 장점을 고스란히 갖췄다."
	CASE "brim-dd"
		RETURNF "BRIM-DD는 다이-기저귀의 압도적인 흡수력에 요술 마법을 결합한 제품으로, 정신을 녹일 만큼 귀여운 무작위 동방 캐릭터 무늬도 들어간다. FB보다 두꺼운 패드는 존재감을 숨길 생각이 없어 착용자가 어디서든 뒤뚱거리게 만든다. 물론 그게 단점인지는 별개의 문제다."
	CASE "brim-fbp"
		RETURNF "판타스타밥+의 FBP형에는 3세대 초흡수체가 들어가 엄청난 양의 소변을 받아낸다. 신축성 비닐 겉감과 아주 높은 샘 방지벽은 많은 대변도 단단히 가둔다. 아무리 지저분하게 싸더라도 강력한 주문으로 피어나 전황을 유리하게 뒤집어 줄 것이다."
	CASE "brim-ddp"
		RETURNF "브림-DDP는 다이-기저귀+에 요술을 더한, 다른 무엇과도 비교하기 힘든 초대형 기저귀다. 마른 상태에서도 무릎 길이 치마 밖으로 튀어나와 원피스로도 가릴 수 없고, 젖고 더러워지면 꿈결 같은 축축한 빈백으로 변한다. 신축성 비닐 겉감, 초고형 샘 방지벽, 귀여운 캐릭터 무늬, 젖음 표시선, 푹신한 허리 밴드와 재부착 테이프까지 일반 다이-기저귀+의 사양을 모두 갖췄다."
	CASE "brim-pu"
		RETURNF @"판타스타밥을 풀업 형태로 만든 BRIM-PU는 두꺼운 코어와 신축성 허리 밴드, 게은짱 특유의 캐릭터 무늬를 갖춘 도톰한 기저귀다. 필요할 때 내릴 수는 있지만, 착용자가 습관적으로 바지에 오줌을 \@ nScat ? 싸고 대변까지 본다 # 싼다 \@는 상황을 전제로 설계됐다."
	CASEELSE
ENDSELECT

@DD17Hit(ARG,ARG:1)
#DIM nChance
nChance = 30 - (10*DamageResist:(ARG):(7):1)
IF RAND(100) <= nChance
	;lose their turn
	SETCOLOR C_RED
	CALL LC_PRINT(@"%CALLNAME:ARG%은(는) 충격을 받고 턴을 놓쳤다!", , 2,)
	RESETCOLOR
	DT_CELL_SET "lcCombatants", GetCombatant(ARG), "didAttack", 2, 1
ENDIF

@ArousalBulletHit(ARG,ARG:1)
CFLAG:ARG:溜まってる度 += 300
SETCOLOR C_YELLOW
CALL LC_PRINT(@"%CALLNAME:ARG%은(는) 조금 더 당황하기 시작한다.", , 2,)
RESETCOLOR

@SleepBulletHit(ARG,ARG:1)
SETCOLOR C_RED
CALL LC_PRINT(@"%CALLNAME:ARG%은(는) 맞아서 잠들었다!", , 2,)
