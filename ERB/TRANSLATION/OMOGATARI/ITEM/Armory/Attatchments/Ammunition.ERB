@DD17Hit(ARG,ARG:1)
#DIM nChance
nChance = 30 - (10*DamageResist:(ARG):(7):1)
IF RAND(100) <= nChance
	;lose their turn
	SETCOLOR C_RED
	CALL LC_PRINT(@"%CALLNAME:ARG%은(는) 충격을 받고 턴을 놓쳤다!", , 2,)
	RESETCOLOR
	DT_CELL_SET "lcCombatants", GetCombatant(ARG), "didAttack", 2, 1
ENDIF

