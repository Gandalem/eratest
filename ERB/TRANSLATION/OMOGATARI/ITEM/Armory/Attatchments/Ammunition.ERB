@CaliberTR(ARGS)
#FUNCTIONS
SELECTCASE ARGS
	CASE "5.56x45mm"
		RETURNF "5.56x45mm NATO"
	CASE "7.62x51mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".308 윈더거"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "5.6x15mmR"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".22 롱 라이플"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "10x25mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF "10mm 오토"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "18.5x70mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF "12게이지 2.75인치"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "15.63x70mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF "20게이지 2.75인치"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "12.7x99mm"
		SELECTCASE nAmmoNameType
			CASE 0
				IF GETBIT(nVerboseItems,3)
					RETURNF ".50 BMG"
				ELSE
					RETURNF ARGS
				ENDIF
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "11.43x23mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".45 ABP"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "9x19mm"
		RETURNF "9x19mm 파라벨룸"
	CASE ".41 Volcanic"
		RETURNF ".41 볼리셔널"
	CASE "9x29mmR"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".38 스페셜"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "9x33mmR"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".357 매그넘"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "10.9x29mmR"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".44 매그넘"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "10.8x33mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".44-40 윈더거"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "6.35x16mmSR"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".25 ABP"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "7.62x67mmRB"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".300 윈더거 매그넘"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "7.62x63mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".30 슈퍼 포인트"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "8.3x30mm"
		RETURNF "8.3x30mm 에임트로픽"
	CASE "7.62x20mm"
		RETURNF "7.62x20mm 캑터스"
	CASE "5.8x62mm"
