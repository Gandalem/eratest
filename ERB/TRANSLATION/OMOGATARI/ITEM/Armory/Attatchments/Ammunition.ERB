@VelocityToBarrelCurve(ammoType,currentBarrel,currentWeight)
#FUNCTION
#DIMS ammoType
#DIM idealVelocity
#DIM idealBarrel
#DIM idealWeight
#DIM currentBarrel
#DIM currentWeight
#DIM returnVelocity
SELECTCASE ammoType
	CASE "5.56x45mm"
		idealVelocity = 3020
		idealBarrel = 508
		idealWeight = 55
		;5.56x45mm ammo stuff
		;multiply returned value by another curve by difference in ammo weight
		RETURNF returnVelocity
ENDSELECT

@EXIST_WeaponAmmo_ID
#LOCALSIZE 1
#LOCALSSIZE 1
;GET_INT(C_ID, "Weapon", P_ID, "Accuracy")
;要素名→ID変換用関数
;必要なら各オブジェクトで同様に作成のこと

@WeaponAmmo_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
	C_NAME:O_ID = %GET_STR(, "WeaponAmmo", O_ID, "名前")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF

