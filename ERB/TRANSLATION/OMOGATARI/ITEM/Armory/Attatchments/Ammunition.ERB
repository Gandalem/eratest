		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".44-40 Windurger"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "6.35x16mmSR"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".25 ABP"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "7.62x67mmRB"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".300 Windurger Magnum"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "7.62x63mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".30 Super Point"
			CASE 1
				RETURNF ARGS
