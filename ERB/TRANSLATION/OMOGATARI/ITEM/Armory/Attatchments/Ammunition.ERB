@CaliberTR(ARGS)
#FUNCTIONS
SELECTCASE ARGS
	CASE "5.56x45mm"
		RETURNF "5.56x45mm NATO"
	CASE "7.62x51mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".308 Windurger"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "5.6x15mmR"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF ".22 Long Rifle"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "10x25mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF "10mm Auto"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "18.5x70mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF "12 Gauge 2.75in"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "15.63x70mm"
		SELECTCASE nAmmoNameType
			CASE 0
				RETURNF "20 Gauge 2.75in"
			CASE 1
				RETURNF ARGS
		ENDSELECT
	CASE "12.7x99mm"
