@EXIST_WeaponStock_ID
#LOCALSIZE 1
#LOCALSSIZE 1
;GET_INT(C_ID, "Weapon", P_ID, "Accuracy")
;要素名→ID変換用関数
;必要なら各オブジェクトで同様に作成のこと

@WeaponStock_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
	C_NAME:O_ID = %GET_STR(, "WeaponStock", O_ID, "名前")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF

@EXIST_WeaponStock999
#LOCALSIZE 1
#LOCALSSIZE 1

@WeaponStock999(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "No Stock")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "\"Accuracy is overrated\"\n- No one ever")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「WeaponMag」")
	CASE "Platform"
		CALLF MAKE_STR(V_NAME, "everything/")
	CASE "Price"
		; default damage in a normal hit
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
ENDSELECT

