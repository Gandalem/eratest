#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "MR-70 파이널 익스텐션즈 팬텀 5.56x45 소염기")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "최종 익스텐션즈에서 제조한 MR-70 플랫폼용 팬텀 플래시 하이더. 5.56x45 탄창에 장착 가능함.")
	CASE "ShortName"
		CALLF MAKE_STR(V_NAME, "유령")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「WeaponBarrel」")
	CASE "Accuracy"
		LOCAL = 15
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Ammo"
		CALLF MAKE_STR(V_NAME, "5.56x45mm/")
	CASE "Price"
