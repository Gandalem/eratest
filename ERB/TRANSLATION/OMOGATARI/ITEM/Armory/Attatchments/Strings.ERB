@WeaponString_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
		C_NAME:O_ID = %GET_STR(, "WeaponString", O_ID, "名前")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF

@WeaponString1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "Flax simple bow string")
CASE "描写"
	CALLF MAKE_STR(V_NAME, "A simple string made out of flax.")
CASE "ShortName"
	CALLF MAKE_STR(V_NAME, "Flax string")
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「WeaponBarrelBody」")
CASE "Damage"
	LOCAL = 150
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Burst"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Penetration"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Accuracy"
	LOCAL = 35
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Range"
	LOCAL = 2
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Platform"
	CALLF MAKE_STR(V_NAME, "bow/")
CASE "Price"
	; default damage in a normal hit
	LOCAL = 750
	CALLF MAKE_INT(V_NAME, LOCAL)	
ENDSELECT

