@EXIST_Weapon287
#LOCALSIZE 1
#LOCALSSIZE 1

@Weapon287(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "「Napalm Death」")	
CASE "FullName"
	CALLF MAKE_STR(V_NAME, "『「Napalm Death」』book")	
CASE "描写"
	CALLF MAKE_STR(V_NAME, "Ultimate Fire attack to 1 Enemy. If the Target is defeated, fully restore User's HP")			
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Weapon」")
CASE "Damage"
	; default damage in a normal hit
	LOCAL = 24000
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Accuracy"
	;	chance to HIT, 0-100%
	LOCAL = 98
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Burst"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Pellets"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Loudness"
	LOCAL = 5
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "Range"
	LOCAL = 4
	CALLF MAKE_INT(V_NAME, LOCAL)	    
CASE "Penetration"
	LOCAL = 999
	CALLF MAKE_INT(V_NAME, LOCAL)	    	
CASE "Damage Type"
	LOCAL = 3
	CALLF MAKE_INT(V_NAME, LOCAL)  	
CASE "Tech Level"
	LOCAL = 11
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Youjutsu Tier"
	LOCAL = 10
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Hit Effect"
	CALLF MAKE_STR(V_NAME, "AgiHit")		
CASE "Kill Effect"
	CALLF MAKE_STR(V_NAME, "LifeStealFull")		
CASE "MP Cost"
	LOCAL = 180
	CALLF MAKE_INT(V_NAME, LOCAL)		
CASE "Research Required"
	CALLF MAKE_STR(V_NAME, "FireMagic/DivineMagicWeapons/")
CASE "Type"
	CALLF MAKE_STR(V_NAME, "Youjutsu")
CASE "Class"
	CALLF MAKE_STR(V_NAME, "Fire")	
CASE "Ammo"
	CALLF MAKE_STR(V_NAME, "MP")  
CASE "Tags"
	CALLF MAKE_STR(V_NAME, "fire/single-target magic/divine magic")  
CASE "Fire Sound"
	CALLF MAKE_STR(V_NAME, "firearms/attack3.wav")				
;旧装備処理との照会用、Weaponの1
ENDSELECT

@LifeStealFull(ARG,ARG:1)
#DIM nChance

SETCOLOR C_RED
CALL LC_PRINT(@"%CALLNAME:(ARG:1)% was fully healed due to the effects of %GET_STR(ARG:1, "Weapon", EQUIP:(ARG:1):Weapon, "名前")%!", , 2,)
RESETCOLOR
BASE:(ARG:1):0 = MAXBASE:(ARG:1):0