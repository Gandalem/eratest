; Modular ERB: OMOGATARI/ITEM/Armory/200 Youjutsu/241 Mazan.ERB

@EXIST_Weapon241
#LOCALSIZE 1
#LOCALSSIZE 1

@Weapon241(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "Mazan")
	CASE "FullName"
		CALLF MAKE_STR(V_NAME, "『마잔』 마도서")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "최대 10명의 적에게 약한 힘 대미지를 준다.")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Weapon」")
	CASE "Damage"
		; default damage in a normal hit
		LOCAL = YOUJUTSU_MAGIC_DAMAGE(0,ARG)
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Accuracy"
		;	chance to HIT, 0-100%
		LOCAL = 98
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Burst"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Pellets"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Loudness"
		LOCAL = 5
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Range"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Penetration"
		LOCAL = 5
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Damage Type"
		LOCAL = 38
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Tech Level"
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Youjutsu Tier"
		LOCAL = 3
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Multi Hit"
		LOCAL = YOUJUTSU_MAGIC_MULTI_HIT(1,ARG)
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "MP Cost"
		LOCAL = 15
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Research Required"
		CALLF MAKE_STR(V_NAME, "ForceMagic/BasicMagicWeapons/")
	CASE "Type"
		CALLF MAKE_STR(V_NAME, "Youjutsu")
	CASE "Class"
		CALLF MAKE_STR(V_NAME, "Force")
	CASE "Ammo"
		CALLF MAKE_STR(V_NAME, "MP")
	CASE "Tags"
		CALLF MAKE_STR(V_NAME, "force/multi-target magic/basic magic")
	CASE "Fire Sound"
		CALLF MAKE_STR(V_NAME, "firearms/attack3.wav")
		;旧装備処理との照会用、Weaponの1
ENDSELECT
