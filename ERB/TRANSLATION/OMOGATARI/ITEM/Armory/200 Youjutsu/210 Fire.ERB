;normal: 3
;-la    : 	 5
;-dyne  :  10
;-barion:  20
;-of god:  35

@YOUJUTSU_MAGIC_DAMAGE(ARG,C_ID)
#FUNCTION
#DIM C_ID
#DIM DYNAMIC YMD
SELECTCASE ARG
	CASE 0
		;normal
		YMD = 380
	CASE 1
		;la
		YMD = 800
	CASE 2
		;dyne
		YMD = 2150
	CASE 3
		;barion
		YMD = 5300
	CASE 4
		;of god
		YMD = 8500
	CASE 5
		;of god+
		YMD = 20000
ENDSELECT
RETURNF YMD

@YOUJUTSU_MAGIC_MULTI_HIT(ARG,C_ID)
#FUNCTION
#DIM C_ID
#DIM DYNAMIC YMD
SELECTCASE ARG
	CASE 0
		;normal
		YMD = 1
	CASE 1
		;ma
		YMD = 10
ENDSELECT
RETURNF YMD
