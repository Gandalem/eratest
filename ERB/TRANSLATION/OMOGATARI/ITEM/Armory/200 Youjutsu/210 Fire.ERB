@AgiHit(ARG,ARG:1)
#DIM nChance
nChance = 25 - (10*DamageResist:(ARG):(3):1)
IF RAND(100) <= nChance
	SETCOLOR C_RED
	CALL LC_PRINT(@"%CALLNAME:ARG%이/가 타기 시작했다!", , 2,)
	RESETCOLOR
	DT_CELL_SET "lcCombatants", GetCombatant(ARG), "burnAilment", 3, 1
ENDIF

