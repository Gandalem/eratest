; Modular ERB: OMOGATARI/ITEM/Armory/200 Youjutsu/Electric/286 All Guns Blazing.ERB

@EXIST_Weapon286
#LOCALSIZE 1
#LOCALSSIZE 1

@Weapon286(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SIF !INRANGE(ARG,0,CHARANUM)
	RETURNF
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "「All Guns Blazing」")
	CASE "FullName"
		CALLF MAKE_STR(V_NAME, "『전탄 발사』 마도서")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "적 1에게 전기 공격을 가한다. 피해는 사용자 MP의 3배를 기반으로 한다. 사용자의 MP가 0이 된다.")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Weapon」")
	CASE "Damage"
		; default damage in a normal hit
		LOCAL = (BASE:ARG:7*3)
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Accuracy"
		;	chance to HIT, 0-100%
		LOCAL = 100
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Burst"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Pellets"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Loudness"
		LOCAL = 5
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Range"
		LOCAL = 4
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Penetration"
		LOCAL = 999
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Damage Type"
		LOCAL = 7
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Tech Level"
		LOCAL = 8
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Multi Hit"
		LOCAL = YOUJUTSU_MAGIC_MULTI_HIT(0,ARG)
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "MP Cost"
		LOCAL = BASE:ARG:7
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Research Required"
		CALLF MAKE_STR(V_NAME, "ElectricityMagic/ExpertMagicWeapons/")
	CASE "Type"
		CALLF MAKE_STR(V_NAME, "Youjutsu")
	CASE "Class"
		CALLF MAKE_STR(V_NAME, "Electricity")
	CASE "Ammo"
		CALLF MAKE_STR(V_NAME, "MP")
	CASE "Tags"
		CALLF MAKE_STR(V_NAME, "electricity/single-target magic/expert magic")
	CASE "Fire Sound"
		CALLF MAKE_STR(V_NAME, "firearms/attack3.wav")
		;旧装備処理との照会用、Weaponの1
ENDSELECT
