; Modular ERB: OMOGATARI/ITEM/Armory/200 Youjutsu/273 Mudoom.ERB

@EXIST_Weapon273
#LOCALSIZE 1
#LOCALSSIZE 1

@Weapon273(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "Mudoom")
	CASE "FullName"
		CALLF MAKE_STR(V_NAME, "『무도온』 마도서")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "죽음: 적 하나를 즉시 처치하며, 명중률이 높다. 부패 타입.")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Weapon」")
	CASE "Damage"
		; default damage in a normal hit
		LOCAL = 5
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Accuracy"
		;	chance to HIT, 0-100%
		LOCAL = 60
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Max Accuracy"
		; Max chance to hit
		LOCAL = 60
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Burst"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Pellets"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Loudness"
		LOCAL = 5
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Range"
		LOCAL = 4
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Penetration"
		LOCAL = 999
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Damage Type"
		LOCAL = 3
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Tech Level"
		LOCAL = 5
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Youjutsu Tier"
		LOCAL = 3
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Multi Hit"
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "MP Cost"
		LOCAL = 80
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Research Required"
		CALLF MAKE_STR(V_NAME, "DarkMagic/AdvancedMagicWeapons/")
	CASE "Hit Effect"
		CALLF MAKE_STR(V_NAME, "DieForMe")
	CASE "Type"
		CALLF MAKE_STR(V_NAME, "Youjutsu")
	CASE "Class"
		CALLF MAKE_STR(V_NAME, "Decay")
	CASE "Ammo"
		CALLF MAKE_STR(V_NAME, "MP")
	CASE "Tags"
		CALLF MAKE_STR(V_NAME, "decay/single-target magic/advanced magic")
	CASE "Fire Sound"
		CALLF MAKE_STR(V_NAME, "firearms/attack3.wav")
		;旧装備処理との照会用、Weaponの1
ENDSELECT
