; Modular ERB: OMOGATARI/ITEM/Armory/200 Youjutsu/000 Danmaku.ERB

@EXIST_Weapon0
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@Weapon0(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM isMuted
#DIM combatantID
SIF !INRANGE(ARG,0,CHARANUM) || !CHARANUM
	RETURNF
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "fists")
	CASE "FullName"
		CALLF MAKE_STR(V_NAME, "fists")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "축하한다. 너는 그리고쿄에 도착했고 마법을 어떻게 사용하는지 모른다. 좋은 운이 있기를 빌어주마.")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Weapon」")
	CASE "Damage"
		; default damage in a normal hit
		LOCAL = 400 + (ABL:ARG:67*100)
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Accuracy"
		;	chance to HIT, 0-100%
		LOCAL = 80 + (ABL:ARG:67*3)
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Burst"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Pellets"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Loudness"
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Range"
		LOCAL = 3
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Penetration"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Grade"
		LOCAL = -1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Tech Level"
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Concealed Weapon"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Type"
		CALLF MAKE_STR(V_NAME, "Melee")
	CASE "Class"
		CALLF MAKE_STR(V_NAME, "2H Blunt")
		;旧装備処理との照会用、Weaponの1
ENDSELECT
;オブジェクト本体

@Weapon1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
#DIM isMuted
#DIM combatantID
SIF !INRANGE(ARG,0,CHARANUM) || !CHARANUM
	RETURNF
; IF DT_EXIST("lcCombatants")
; 	;check if muted
; 	combatantID = GetCombatant(ARG)
; 	SIF combatantID && DT_CELL_GET("lcCombatants", combatantID, "muteAilment", 1)
; 		GOTO NoDanmaku
; ENDIF
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "danmaku")
	CASE "FullName"
		CALLF MAKE_STR(V_NAME, "danmaku")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "무기가 없는 사람들을 위한 비상용 무기. 어차피 대부분은 마법 카드 규칙에 따라 날아다니고 단마쿠 사용법을 알고 있으니까 (우린 그런 거 신경 안 쓰지만).")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Weapon」")
	CASE "Damage"
		; default damage in a normal hit
		LOCAL = 380
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Damage Type"
		LOCAL = 36
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Accuracy"
		;	chance to HIT, 0-100%
		LOCAL = 5 + (LEVEL_TO_RANK(ABL:ARG:戦闘能力)*2)
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Burst"
		LOCAL = 6 + LEVEL_TO_RANK(ABL:ARG:戦闘能力)
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Pellets"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Loudness"
		LOCAL = 10
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Range"
		LOCAL = 10
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Penetration"
		LOCAL = 5
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Grade"
		LOCAL = -1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Tech Level"
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Concealed Weapon"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Multi Hit"
		SELECTCASE ABL:ARG:戦闘能力
			; CASE IS >= UniversalRank("QuadUltra")
			; 	LOCAL = 10
			; CASE IS >= UniversalRank("TriUltra")
			; 	LOCAL = 9
			; CASE IS >= UniversalRank("OverDrive")
			; 	LOCAL = 8
			; CASE IS >= UniversalRank("Phantasm")
			; 	LOCAL = 7
			CASE IS >= UniversalRank("Extra")
				LOCAL = 4
				; CASE IS >= UniversalRank("SS")
				; 	LOCAL = 5
			CASE IS >= UniversalRank("S")
				LOCAL = 3
				; CASE IS >= UniversalRank("A")
				; 	LOCAL = 3
			CASE IS >= UniversalRank("B")
				LOCAL = 2
			CASEELSE
				LOCAL = 1
		ENDSELECT
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "MP Cost"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Type"
		CALLF MAKE_STR(V_NAME, "Youjutsu")
	CASE "Class"
		CALLF MAKE_STR(V_NAME, "Danmaku")
	CASE "Ammo"
		CALLF MAKE_STR(V_NAME, "MP")
	CASE "Fire Sound"
		CALLF MAKE_STR(V_NAME, "firearms/attack3.wav")
		;旧装備処理との照会用、Weaponの1
ENDSELECT
