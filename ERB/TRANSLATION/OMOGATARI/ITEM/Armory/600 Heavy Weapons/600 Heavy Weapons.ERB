		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Barrel Slot"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Barrel Body Slot"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Tactical Slot"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Sight Slot"
		LOCAL = 3
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Stock Slot"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Grip Slot"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "WeaponReceiver/Default"
		CALLF MAKE_INT(V_NAME, 144)
	CASE "WeaponBarrelBody/Default"
		CALLF MAKE_INT(V_NAME, 128)
	CASE "WeaponMag/Default"
		CALLF MAKE_INT(V_NAME, 156)
	CASE "WeaponGrip/Default"
		CALLF MAKE_INT(V_NAME, 3)
