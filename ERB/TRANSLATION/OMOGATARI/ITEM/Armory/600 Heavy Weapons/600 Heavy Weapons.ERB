@Weapon600(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		IF GETBIT(nVerboseItems,1)
			CALLF MAKE_STR(V_NAME, "Ares")
		ELSE
			CALLF MAKE_STR(V_NAME, "LMG")
		ENDIF
	CASE "FullName"
		IF GETBIT(nVerboseItems,1)
			CALLF MAKE_STR(V_NAME, "Rika's Arms Light Machine Gun「Ares」")
		ELSE
			CALLF MAKE_STR(V_NAME, "light machine gun")
		ENDIF
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "아레스는 레노프 제조 공장에서 제조한 PG-69 기관총의 센고키아 복제품으로, 현재 그리즈보프 그룹으로 알려져 있다. PS 기관총이 연식을 먹어가면서 소련군은 PS 탄약을 사용하면서도 기준에 맞는 기관총을 필요로 했다. 그리즈보프 씨는 SVG-67을 재활용하고 급탄 시스템을 벨트 급탄 방식으로 교체하여 PG-69를 만들었다. 아레스는 7.62x39mm 대신 Vandal과 동일한 5.56x45mm 탄약을 사용하도록 개조되었다.")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Weapon」")
	CASE "Tech Level"
		LOCAL = 8
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Grade"
		LOCAL = 3
		CALLF MAKE_INT(V_NAME, LOCAL)
