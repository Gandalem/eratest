@Weapon2(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "club")
	CASE "FullName"
		CALLF MAKE_STR(V_NAME, "wooden club")
	CASE "描写"
		CALLF MAKE_STR(V_NAME, "한쪽 끝은 잡도록 만들어지고 다른 쪽 끝은 때리는 용도로 만들어진 나무 클럽이다.")
	CASE "装備部位"
		CALLF MAKE_STR(V_NAME, "「Weapon」")
	CASE "Damage"
		; default damage in a normal hit
		LOCAL = 650
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Accuracy"
		;	chance to HIT, 0-100%
		LOCAL = 40
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Burst"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Pellets"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Loudness"
		LOCAL = 1
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Range"
		LOCAL = 2
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Grade"
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Tech Level"
		LOCAL = 0
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Price"
		LOCAL = 4000
		CALLF MAKE_INT(V_NAME, LOCAL)
	CASE "Two-Handed"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "Type"
		CALLF MAKE_STR(V_NAME, "Melee")
	CASE "Class"
		CALLF MAKE_STR(V_NAME, "2H Blunt")
	CASE "Tags"
		CALLF MAKE_STR(V_NAME, "makeshift/")
		;旧装備処理との照会用、Weaponの1
ENDSELECT

