@Weapon7(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SIF ARG >= CHARANUM
	RETURNF
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "purification rod")
CASE "FullName"
	CALLF MAKE_STR(V_NAME, "purification rod")		
CASE "描写"
	CALLF MAKE_STR(V_NAME, "A stick with a white ribbon, used to purify youkai. Can be used either as a melee weapon or Danmaku casting tool.")	
CASE "装備部位"
	CALLF MAKE_STR(V_NAME, "「Weapon」")
CASE "Modes"
	LOCAL = 2
	CALLF MAKE_INT(V_NAME, LOCAL)
;Melee Mode
CASE "0/Name"
	CALLF MAKE_STR(V_NAME, "Melee")
CASE "0/Damage"
	; default damage in a normal hit
	LOCAL = 1000
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "0/Accuracy"
	;	chance to HIT, 0-100%
	LOCAL = 100
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "0/Burst"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "0/Pellets"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "0/Loudness"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "0/Penetration"
	LOCAL = 999
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "0/Range"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)   
CASE "0/Type"
	CALLF MAKE_STR(V_NAME, "Melee") 
CASE "0/Class"
	CALLF MAKE_STR(V_NAME, "2H Blunt")
	
;Danmaku Mode
CASE "1/Name"
	CALLF MAKE_STR(V_NAME, "Danmaku")
CASE "1/Damage"
	; default damage in a normal hit
	LOCAL = 1230
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "1/Accuracy"
	;	chance to HIT, 0-100%
	LOCAL = 15 + (LEVEL_TO_RANK(ABL:ARG:戦闘能力)*3)
	CALLF MAKE_INT(V_NAME, LOCAL)
CASE "1/Burst"
	LOCAL = 6 + LEVEL_TO_RANK(ABL:ARG:戦闘能力)
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "1/Pellets"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "1/Loudness"
	LOCAL = 7
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "1/Penetration"
	LOCAL = 9
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "1/Range"
	LOCAL = 3
	CALLF MAKE_INT(V_NAME, LOCAL)   
CASE "1/Multi Hit"
	SELECTCASE ABL:ARG:戦闘能力
	CASE IS >= UniversalRank("QuadUltra")
		LOCAL = 10
	CASE IS >= UniversalRank("TriUltra")
		LOCAL = 9
	CASE IS >= UniversalRank("OverDrive")
		LOCAL = 8
	CASE IS >= UniversalRank("Phantasm")
		LOCAL = 7
	CASE IS >= UniversalRank("Extra")
		LOCAL = 6
	CASE IS >= UniversalRank("SS")
		LOCAL = 5
	CASE IS >= UniversalRank("S")
		LOCAL = 4
	CASE IS >= UniversalRank("A")
		LOCAL = 3
	CASE IS >= UniversalRank("B")
		LOCAL = 2
	CASEELSE
		LOCAL = 1
	ENDSELECT
	CALLF MAKE_INT(V_NAME, LOCAL)  	
CASE "1/MP Cost"
	LOCAL = 8
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "1/Type"
	CALLF MAKE_STR(V_NAME, "Firearm") 
CASE "1/Class"
	CALLF MAKE_STR(V_NAME, "Danmaku")	
CASE "1/Ammo"
	CALLF MAKE_STR(V_NAME, "MP")
CASE "1/Damage Type"
	LOCAL = 37
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "1/Fire Sound"
	CALLF MAKE_STR(V_NAME, "firearms/attack3.wav")			
CASE "Grade"
	CALLF MAKE_INT(V_NAME, 1)
CASE "Tech Level"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)	
CASE "Type"
	CALLF MAKE_STR(V_NAME, "Hybrid") 
CASE "Class"
	CALLF MAKE_STR(V_NAME, "2H Blunt/Danmaku/")
CASE "Research Required"
	CALLF MAKE_STR(V_NAME, "BasicMeleeWeapons/")		 
CASE "Quest Only"
	LOCAL = 1
	CALLF MAKE_INT(V_NAME, LOCAL)		
;旧装備処理との照会用、Weaponの1
ENDSELECT

