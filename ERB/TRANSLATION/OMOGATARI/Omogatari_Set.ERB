;toEquip - Whether to equip the item or not (0: Unequip, 1: Equip, 2: Force Equip (will take slot 3))

@AddAccessory(ARG,AccessoryID,toEquip=1)
#FUNCTION
#DIM DYNAMIC AccessoryID
#DIM DYNAMIC toEquip
#DIM DYNAMIC AccessorySlot
#DIM DYNAMIC RepeatInt
;check accessory slot
FOR RepeatInt,19,22
IF (toEquip && !EQUIP:ARG:RepeatInt) || (!toEquip && EQUIP:ARG:RepeatInt == AccessoryID)
	AccessorySlot = RepeatInt
	BREAK
ENDIF
NEXT
IF !AccessorySlot
	;could not find a slot
	IF toEquip == 2
		;force
		DEBUGPRINTFORML {AccessoryID} %undies_name_with_brand(ARG,AccessoryID,1,19)%을 %CALLNAME:ARG%에 추가하려 했으나 빈 슬롯을 찾을 수 없었다!
		DEBUGPRINTFORML 강제로 슬롯 21을 사용한다.
		AccessorySlot = 21
	ELSEIF toEquip
		DEBUGPRINTFORML {AccessoryID} %undies_name_with_brand(ARG,AccessoryID,1,19)%을(를) %CALLNAME:ARG%에 추가하려고 시도했지만 빈 슬롯을 찾지 못했다!
		RETURNF -1
	ELSE
		DEBUGPRINTFORML {AccessoryID} %undies_name_with_brand(ARG,AccessoryID,1,19)%을(를) %CALLNAME:ARG%에서 찾을 수 없었다!
		RETURNF -1
	ENDIF
ENDIF
IF toEquip
	CFLAG:ARG:(200+AccessorySlot) = AccessoryID
	CFLAG:ARG:(240+AccessorySlot) = AccessoryID
	EQUIP:ARG:AccessorySlot = AccessoryID
	DEBUGPRINTFORML %CALLNAME:ARG%의 액세서리 : {AccessoryID} %undies_name_with_brand(ARG,AccessoryID,1,19)% (슬롯 {AccessorySlot})로 변경했다.
ELSE
	CFLAG:ARG:(200+AccessorySlot) = 0
	CFLAG:ARG:(240+AccessorySlot) = 0
	EQUIP:ARG:AccessorySlot = 0
	DEBUGPRINTFORML %CALLNAME:ARG%액세서리(슬롯 {AccessorySlot}의)를 제거했다.
ENDIF
RETURNF 1

