@EnduranceColors(ARG = 0)
#FUNCTION
VARSET LOCAL
SELECTCASE ARG
	CASE IS >= 6
		LOCAL:20 = 1
		LOCAL = 0x990099
	CASE 5
		LOCAL:20 = 1
		LOCAL = 0xC070C0
	CASE 4
		LOCAL = 0x0078B4
	CASE 3
		LOCAL = 0x66FFFF
	CASE 2
		LOCAL = 0x00FF00
	CASE 1
		LOCAL = 0x70C070
	CASE -2
		LOCAL = 0xFFFF00
	CASE -1
		LOCAL = 0xFFFFCC
	CASE -3
		LOCAL = 0xFFA500
	CASE -4
		LOCAL = 0xFF0000
	CASE -5
		LOCAL:20 = 1
		LOCAL = 0xFFCCFF
	CASEELSE
		LOCAL = 0xC0C0C0
ENDSELECT
RETURNF LOCAL

