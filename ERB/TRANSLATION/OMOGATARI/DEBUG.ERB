;==========================================================================
;Random weapons
;==========================================================================
@OurGodGivenRightToBearArms(AllowBook=0)
#FUNCTION
#DIM DYNAMIC AllowBook
FOR LOCAL, 0, CHARANUM
    DO
        CALLF FISHER_YATES_SHUFFLE_F(VAR_TEMP_MAX)
        FOR LOCAL:3, 0, 5
			LOCAL:2 = SHAFFLE_ARRAY:(LOCAL:3)
			SIF GET_STR(LOCAL, "Weapon", LOCAL:2, "名前") == ""
				CONTINUE
			;ARMS not BOOKS
			SIF GET_STR(LOCAL, "Weapon", LOCAL:2, "Type") == "Youjutsu" && !AllowBook
				CONTINUE
			CALLF EQUIPWEAPON(LOCAL,LOCAL:2)
			GOTO LoopContinue
        NEXT
    LOOP 1
	$LoopContinue
NEXT


