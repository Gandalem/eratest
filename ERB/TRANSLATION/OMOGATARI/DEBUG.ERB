;==========================================================================
@KillIt(ARG)
IF ARG == -2
	FOR LOCAL, 1, CHARANUM
		BASE:LOCAL:体力 = -5000
		DOWNBASE:LOCAL:体力 = 5000
		BASE:LOCAL:気力 = 0
		CALL SET_HISTORY_DEATH(LOCAL,MASTER,"Cheat")
	NEXT
ELSE
