@NAS_ACHIEVEMENT_COUNT(nSelect)
#FUNCTION
#DIMS DYNAMIC nSelect
#DIM DYNAMIC nLoves
VARSET nLoves
FOR LOCAL,0,CHARANUM
SIF TALENT:LOCAL:行きずり
	CONTINUE
SIF LOCAL == MASTER
	CONTINUE
SIF TALENT:LOCAL:恋慕 && nSelect == "love"
	nLoves ++
SIF TALENT:LOCAL:4 && nSelect == "lewd"
	nLoves ++
SIF TALENT:LOCAL:7 && nSelect == "engaged"
	nLoves ++
SIF TALENT:LOCAL:妻 && nSelect == "spouse"
	nLoves ++
NEXT
RETURNF nLoves

