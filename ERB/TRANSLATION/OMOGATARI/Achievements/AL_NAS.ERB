ENDSELECT

@AbnormalProductionConfig(ARG,excretaType="pee")
#DIM APP_HIT
#DIM APP_TALENT
#DIMS APP_TR
#DIMS excretaType
SELECTCASE excretaType
	CASE "pee"
		APP_TR '= "소변"
		APP_TALENT = 350
	CASE "poop"
		APP_TR '= "변변"
		APP_TALENT = 351
	CASE "cum"
		APP_TR '= "정액"
		APP_TALENT = 232
ENDSELECT
PRINTFORML %TW_PORT_STR(TALENT_TR(APP_TALENT))% 구성:
PRINTFORML 이곳에 설정된 양만큼 %APP_TR%의 생산량을 곱한다. 0으로 설정하면 100\%로 설정한 것과 같은 역할을 한다.
PRINTL
PRINTFORML %COND_STR(@"%CALLNAME:ARG%'s ", ARG != MASTER)%현재: {TALENT:ARG:APP_TALENT  ? TALENT:ARG:APP_TALENT # 100}\% (%(AbnormalProductionSTR(TALENT:ARG:APP_TALENT))%)
PRINTL
PRINTBUTTON @"1\%[%AbnormalProductionSTR(1)%]",1
PRINTL
PRINTBUTTON @"25\%[%AbnormalProductionSTR(25)%]",25
PRINTL
PRINTBUTTON @"75\%[%AbnormalProductionSTR(75)%]",75
PRINTL
PRINTBUTTON @"1x[%AbnormalProductionSTR(100)%]",100
PRINTL
PRINTBUTTON @"3x[%AbnormalProductionSTR(300)%]",300
PRINTL
PRINTBUTTON @"10x[%AbnormalProductionSTR(1000)%]",1000
PRINTL
PRINTBUTTON @"100x[%AbnormalProductionSTR(10000)%]",10000
PRINTL
PRINTBUTTON @"1000x[%AbnormalProductionSTR(100000)%]",100000
PRINTL
PRINTBUTTON @"10000x[%AbnormalProductionSTR(1000000)%]",1000000
PRINTL
PRINTBUTTON @"100000000x[%AbnormalProductionSTR(10000000000)%]",10000000000
PRINTL
PRINTL
PRINTBUTTON @"-1[Return]",-1
PRINTL
INPUT
APP_HIT = RESULT
SELECTCASE APP_HIT
	CASE -1
		RETURN
	CASE IS >= 300
		PRINTFORMW 당신은 자신의 %APP_TR% 생산량을 {APP_HIT}\%로 설정했다.
		PRINTFORMW 이것은 당신의 %APP_TR% 생산량을 상당히 증가시키며 이뇨제와 중첩된다.
		PRINTFORMW 당신은 자신의 %APP_TR% 생산량을 {APP_HIT}\%로 설정했다.
		TALENT:MASTER:APP_TALENT = APP_HIT
	CASE IS < 0
		REUSELASTLINE Invalid Input
		RESTART
	CASE 1 TO 99
		PRINTFORMW 당신은 설정했습니다 %APP_TR% 생산량을 {APP_HIT}\%
		PRINTFORMW 이것은 너의 %APP_TR% 생산량을 감소시키고, 네가 %APP_TR%를 해야 하는 횟수를 줄인다.
		TALENT:MASTER:APP_TALENT = APP_HIT
	CASE 100
		PRINTFORMW %Capitalize(APP_TR)% 생산 설정이 기본으로 지정되었다.
		TALENT:MASTER:APP_TALENT = 0
	CASEELSE
		PRINTFORMW 너는 너의 %APP_TR% 생산량을 {APP_HIT}\%으로 설정했다.
		TALENT:MASTER:APP_TALENT = APP_HIT
ENDSELECT

@AbnormalProductionSTR(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 1 TO 25-1
		RETURNF "Severely Limited"
	CASE 25 TO 75-1
		RETURNF "Limited"
	CASE 75 TO 99
		RETURNF "Reduced"
	CASE 100,0
		RETURNF "Regular"
	CASE 100 TO 300-1
		RETURNF "Expanded"
	CASE 300 TO 1000-1
		RETURNF "Bucket"
	CASE 1000 TO 10000-1
		RETURNF "Sink"
	CASE 10000 TO 100000-1
		RETURNF "Bathtub"
	CASE 100000 TO 1000000-1
		RETURNF "Bathroom"
	CASE 1000000 TO 10000000000-1
		RETURNF "Building"
	CASE IS >= 10000000000
		RETURNF "City"
ENDSELECT

