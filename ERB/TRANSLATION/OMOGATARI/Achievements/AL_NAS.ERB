@OuroborosOrgasmConfig
PRINTFORML %TW_PORT_STR(GET_TALENTNAME_TR(224,1))% Configuration:
PRINTFORML With%TW_PORT_STR(GET_TALENTNAME_TR(224,1))%, ejaculation will steal some STA depending on what mode it's set to.
PRINTFORML On Pull mode, you will drain a slight amount the Touhou's STA and be benefited with some more STA.
PRINTFORML On Push mode, you will be drained and the Touhou will get some STA.
PRINTL
PRINTFORM Current Mode: 
SELECTCASE TALENT:MASTER:224
CASE 5
PRINTFORML Pull
CASE 10
PRINTFORML Push
CASE 0
PRINTFORML None
CASEELSE
PRINTFORML Error
ENDSELECT
PRINTL
{
CALL ASK_M(
    "Cancel",1,
    "Set to Pull mode", 1,
    "Set to Push mode", 1,
    "Remove this talent", 1
)
}
SELECTCASE RESULT
CASE 1
    PRINTFORML %TW_PORT_STR(GET_TALENTNAME_TR(224,1))%set to Pull mode
    TALENT:MASTER:採陰補阳／採阳補陰 = 5
CASE 2
    PRINTFORML %TW_PORT_STR(GET_TALENTNAME_TR(224,1))%set to Push mode
    TALENT:MASTER:採陰補阳／採阳補陰 = 10
CASE 3
    PRINTFORML %TW_PORT_STR(GET_TALENTNAME_TR(224,1))%deactivated.
    TALENT:MASTER:採陰補阳／採阳補陰 = 0
ENDSELECT


@AbnormalProductionConfig(ARG,excretaType="pee")
#DIM APP_HIT
#DIM APP_TALENT
#DIMS APP_TR
#DIMS excretaType
SELECTCASE excretaType
CASE "pee"
    APP_TR '= "pee"
    APP_TALENT = 350
CASE "poop"
    APP_TR '= "poop"
    APP_TALENT = 351
CASE "cum"
    APP_TR '= "cum"
    APP_TALENT = 232
ENDSELECT

PRINTFORML %TW_PORT_STR(TALENT_TR(APP_TALENT))% Configuration:
PRINTFORML Multiplies %APP_TR% production by the amount set here. If set to 0, it'll act like it's set to 100\%
PRINTL
PRINTFORML %COND_STR(@"%CALLNAME:ARG%'s ", ARG != MASTER)%Current: {TALENT:ARG:APP_TALENT  ? TALENT:ARG:APP_TALENT # 100}\% (%(AbnormalProductionSTR(TALENT:ARG:APP_TALENT))%)
PRINTL
PRINTBUTTON @"1\%[%AbnormalProductionSTR(1)%]",1
PRINTL
PRINTBUTTON @"25\%[%AbnormalProductionSTR(25)%]",25
PRINTL
PRINTBUTTON @"75\%[%AbnormalProductionSTR(75)%]",75
PRINTL
PRINTBUTTON @"1x[%AbnormalProductionSTR(100)%]",100
PRINTL
PRINTBUTTON @"3x[%AbnormalProductionSTR(300)%]",300
PRINTL
PRINTBUTTON @"10x[%AbnormalProductionSTR(1000)%]",1000
PRINTL
PRINTBUTTON @"100x[%AbnormalProductionSTR(10000)%]",10000
PRINTL
PRINTBUTTON @"1000x[%AbnormalProductionSTR(100000)%]",100000
PRINTL
PRINTBUTTON @"10000x[%AbnormalProductionSTR(1000000)%]",1000000
PRINTL
PRINTBUTTON @"100000000x[%AbnormalProductionSTR(10000000000)%]",10000000000
PRINTL
PRINTL
PRINTBUTTON @"-1[Return]",-1
PRINTL
INPUT
APP_HIT = RESULT
SELECTCASE APP_HIT
CASE -1
    RETURN
CASE IS >= 300
    PRINTFORMW You have set your %APP_TR% production to {APP_HIT}\%
    PRINTFORMW This SIGNIFICANTLY increases your %APP_TR% production and stacks with diuretics.
    PRINTFORMW Make sure you have some protection.
    TALENT:MASTER:APP_TALENT = APP_HIT
CASE IS < 0
    REUSELASTLINE Invalid Input
    RESTART
CASE 1 TO 99
    PRINTFORMW You have set your %APP_TR% production to {APP_HIT}\%
    PRINTFORMW This decreases your %APP_TR% production, resulting in less times where you'll have to %APP_TR%.
    TALENT:MASTER:APP_TALENT = APP_HIT
CASE 100
    PRINTFORMW %Capitalize(APP_TR)% production set to default.
    TALENT:MASTER:APP_TALENT = 0
CASEELSE
    PRINTFORMW You have set your %APP_TR% production to {APP_HIT}\%
    TALENT:MASTER:APP_TALENT = APP_HIT

ENDSELECT

@AbnormalProductionSTR(ARG)
#FUNCTIONS
SELECTCASE ARG
CASE 1 TO 25-1
RETURNF "Severely Limited"
CASE 25 TO 75-1
RETURNF "Limited"
CASE 75 TO 99
RETURNF "Reduced"
CASE 100,0
RETURNF "Regular"
CASE 100 TO 300-1
RETURNF "Expanded"
CASE 300 TO 1000-1
RETURNF "Bucket"
CASE 1000 TO 10000-1
RETURNF "Sink"
CASE 10000 TO 100000-1
RETURNF "Bathtub"
CASE 100000 TO 1000000-1
RETURNF "Bathroom"
CASE 1000000 TO 10000000000-1
RETURNF "Building"
CASE IS >= 10000000000
RETURNF "City"
ENDSELECT

