@VIRGIN_SET_NAS_CHARACTERS
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
NAS_VIRGIN_SET_COUNT = 0
PRINT Characters in 
SETCOLOR C_P_GREEN
PRINT green 
RESETCOLOR
PRINTFORML will be included when setting up.
DRAWLINE
FOR LOCAL, 0, CHARANUM-1
	IF CFLAG:LOCAL:NAS_VIRGIN_SET_SELECTED
		SETCOLOR C_P_GREEN
		NAS_VIRGIN_SET_COUNT++
	ENDIF
	PRINTFORMLC [{LOCAL,3}] %CALLNAME:LOCAL%
	RESETCOLOR
NEXT

PRINTL
DRAWLINE
PRINTL [900] - Save Settings　　   [901] - Load Settings	
PRINTL [910] - Select All　　[911] - Player Only　　[912] - NPC Only　　
PRINTL [997] - Invert Selection　　[998] - Reset
PRINTFORML [999] - Finish (Included: %PRINT_PLUR("character",NAS_VIRGIN_SET_COUNT)%)
INPUT
IF INRANGE(RESULT, 0, CHARANUM-1)
	CFLAG:RESULT:NAS_VIRGIN_SET_SELECTED = !CFLAG:RESULT:NAS_VIRGIN_SET_SELECTED
	GOTO REPRINT
ELSEIF RESULT == 910
	FOR LOCAL, 0, CHARANUM-1
		CFLAG:LOCAL:NAS_VIRGIN_SET_SELECTED = 1
	NEXT
	GOTO REPRINT
ELSEIF RESULT == 911
	FOR LOCAL, 0, CHARANUM-1
		CFLAG:LOCAL:NAS_VIRGIN_SET_SELECTED = 0
	NEXT
	CFLAG:MASTER:NAS_VIRGIN_SET_SELECTED = 1
	GOTO REPRINT
ELSEIF RESULT == 912
	FOR LOCAL, 0, CHARANUM-1
		CFLAG:LOCAL:NAS_VIRGIN_SET_SELECTED = 1
	NEXT
	CFLAG:MASTER:NAS_VIRGIN_SET_SELECTED = 0
	GOTO REPRINT
ELSEIF RESULT == 900
	LOADGLOBAL
	FOR LOCAL,0,CHARANUM
		NAS_VIRGIN_SET_GLOBAL_CHARA:LOCAL = CFLAG:RESULT:NAS_VIRGIN_SET_SELECTED
	NEXT
	PRINTFORMW Saved selections globally.
	GOTO REPRINT
ELSEIF RESULT == 901
	LOADGLOBAL
	FOR LOCAL,0,CHARANUM
		CFLAG:RESULT:NAS_VIRGIN_SET_SELECTED = NAS_VIRGIN_SET_GLOBAL_CHARA:LOCAL
	NEXT
	PRINTFORMW Loaded selections globally.
	GOTO REPRINT
ELSEIF RESULT == 997
	FOR LOCAL, 0, CHARANUM-1
		CFLAG:LOCAL:NAS_VIRGIN_SET_SELECTED = !CFLAG:LOCAL:NAS_VIRGIN_SET_SELECTED
	NEXT
	GOTO REPRINT
ELSEIF RESULT == 998
	FOR LOCAL, 0, CHARANUM-1
		CFLAG:LOCAL:NAS_VIRGIN_SET_SELECTED = 0
	NEXT
	GOTO REPRINT
ELSEIF RESULT == 999
	PRINTW Inclusions set up.
ENDIF

;character count string
@NAS_VIRGIN_CHARA_STR()
#FUNCTIONS
#DIM C_COUNT
#DIM IN_COUNT
#DIMS IN_STR, 2
#DIMS OUT_STR
VARSET IN_COUNT
VARSET IN_STR
VARSET OUT_STR

FOR C_COUNT,0,CHARANUM
	SIF IS_MOB(C_COUNT)
		CONTINUE
	IF CFLAG:C_COUNT:NAS_VIRGIN_SET_SELECTED
		IN_COUNT ++
		IN_STR += @"{C_COUNT+1}/"
	ELSE
		IN_STR:1 += @"{C_COUNT+1}/"
	ENDIF
NEXT

SELECTCASE IN_COUNT
CASE IS >= CHARANUM-1
RETURNF "Everyone"
CASE IS >= CHARANUM-6
	FOR LOCAL:1,0,5
		LOCAL = TOINT(SPLIT_SINGLE(IN_STR:1, LOCAL:1, "/"))
		SIF !LOCAL
			BREAK
		OUT_STR += @"%CALLNAME:(LOCAL-1)%、"
	NEXT
	RETURNF @"Everyone except %LIST_IN_STRING(OUT_STR)%"
CASE IS >= 5
	RETURNF @"%CALLNAME:(TOINT(SPLIT_SINGLE(IN_STR, 0, "/"))-1)% and the others"
CASE 1 TO 4
	FOR LOCAL:1,0,5
		LOCAL = TOINT(SPLIT_SINGLE(IN_STR, LOCAL:1, "/"))
		SIF !LOCAL
			BREAK
		OUT_STR += @"%CALLNAME:(LOCAL-1)%、"
	NEXT
	RETURNF @"%LIST_IN_STRING(OUT_STR)%"
CASE 0
	RETURNF "No one"
ENDSELECT