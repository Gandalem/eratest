; Modular ERB: OMOGATARI/VIRGIN_SETTING_NAS.ERB
;New virgin set menu that separates options into categories

@VIRGIN_SET_NAS
#DIM nLineCnt_Head
VARSET LOCAL
DEBUG_Target = TARGET
DRAWLINE
PRINTL 게임이 시작되기 전에 캐릭터에 대한 다양한 설정을 여기서 할 수 있다.
PRINTL 
nLineCnt_Head = LINECOUNT
REDRAW 0
DO
SIF LINECOUNT - nLineCnt_Head > 0
	CLEARLINE LINECOUNT - nLineCnt_Head
CALL VIRGIN_SET_NAS_STATE
SELECTCASE RESULT
	CASE 0
		PRINTW 설정이 완료되었다.
		RETURN
	CASEELSE
ENDSELECT
LOOP 1

@VIRGIN_SET_NAS_STATE
#DIM     PAGE       ;表示中のページ
#DIMS CONST DISP_NAME = "Virginity", "Body", "Mind", "Other"
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
;call command to get a name
FOR LOCAL, 0, 100
VARSET RESULTS
RESULT:3 = 0
TRYCALLFORM VIRGIN_SET_NAS_EFFECT_{PAGE}_{LOCAL}(MASTER,2)
;we get a name of the command
IF STRLENS(RESULTS)
	RESULTS:1 '= RESULTS
	SIF RESULT:3
		RESULTS:1 += " (Selection Independent)"
	PRINTFORML [{LOCAL,2}] - %RESULTS:1%
ENDIF
NEXT
DRAWLINE
FOR LOCAL, 0, VARSIZE("DISP_NAME")
SIF !STRLENS(DISP_NAME:LOCAL)
	CONTINUE
SIF PAGE == LOCAL
	SETCOLOR 0x00FFFF
;exception for player character
PRINTBUTTON DISP_NAME:LOCAL, LOCAL + 8002
RESETCOLOR
PRINTFORM 　　
NEXT
PRINTFORML 
PRINTBUTTON "[0] 완료", 0
PRINTBUTTON @" [-1] 캐릭터 설정 ({NAS_VIRGIN_SET_COUNT}명 선택됨)", -1
PRINTBUTTON " [-2] 설정을 개별적으로 선택한다", -2
DO
INPUT
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE -1
		CALL VIRGIN_SET_NAS_CHARACTERS
	CASE -2
		CALL SET_VIRGINITY_MOD
	CASE 8002 TO VARSIZE("DISP_NAME")+8002
		PAGE = RESULT-8002
	CASEELSE
		$RETRY
		A = RESULT
		RESULT:3 = 0
		TRYCALLFORM VIRGIN_SET_NAS_EFFECT_{PAGE}_{A}(MASTER,2)
		IF !NAS_VIRGIN_SET_COUNT && !RESULT:3
			PRINTFORML 영향을 줄 캐릭터에 대한 설정이 선택되지 않았습니다.
			PRINTFORMW 다시 시도하기 전에 일부 캐릭터를 선택해 주세요.
			GOTO REPRINT
		ENDIF
		TRYCALLFORM VIRGIN_SET_NAS_RESULT(PAGE,A)
ENDSELECT
BREAK
LOOP 1
GOTO REPRINT

@VIRGIN_SET_NAS_RESULT(nTab,nInput)
#DIM nTab
#DIM nInput
#DIM makeMessage
VARSET makeMessage
RESULT:3 = 0
CALLFORM VIRGIN_SET_NAS_EFFECT_{nTab}_{nInput}(LOCAL,2)
;bypass selection
IF RESULT:3
	CALLFORM VIRGIN_SET_NAS_EFFECT_{nTab}_{nInput}(MASTER,0)
	CALLFORM VIRGIN_SET_NAS_EFFECT_{nTab}_{nInput}(MASTER,1)
	RETURN
ENDIF
FOR LOCAL,0,CHARANUM
IF !CFLAG:LOCAL:NAS_VIRGIN_SET_SELECTED
	CONTINUE
ENDIF
SIF LOCAL >= CHARANUM
	CONTINUE
CALLFORM VIRGIN_SET_NAS_EFFECT_{nTab}_{nInput}(LOCAL,0)
NEXT
CALLFORM VIRGIN_SET_NAS_EFFECT_{nTab}_{nInput}(MASTER,1)
;=================================================
;Template
;X is the page the effect is in
;Y is the entry the command is
;C_ID is the character ID
;ARG determines what effects will be returned
;0: Character edits
;1: Message when the command is executed
;2: Name of the command
;=================================================

@VIRGIN_SET_NAS_EFFECT_X_Y(C_ID,ARG)
#DIM C_ID
SELECTCASE ARG
	CASE 0
		;How will this option affect characters
	CASE 1
		;Message when this command is executed
		PRINTFORMW
	CASE 2
		;Name of the option
		RESULTS '= @"옵션의 이름"
ENDSELECT
;=================================================
;Sets everyone as a virgin
