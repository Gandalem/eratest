; Modular ERB: OMOGATARI/NAS_CHARALIST.ERB
;NAS: For non-futanaris

@EXIST_キャラリスト50
#LOCALSIZE 1
#LOCALSSIZE 1
;オブジェクト本体

@キャラリスト50(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	CASE "名前"
		CALLF MAKE_STR(V_NAME, "NonFutaList")
	CASE "SHOP表示"
		CALLF MAKE_INT(V_NAME, 1)
	CASE "判定"
		SIF CHECK_CHARA(ARG, "NonFuta")
			CALLF MAKE_INT(V_NAME, 1)
ENDSELECT
