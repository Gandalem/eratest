; Modular ERB: OMOGATARI/OMO/MagicUnderwear.ERB
;activate the magical underwear

@MagicalUnderwearActivate(ARG,HasPiss=0,HasScat=0,nTarget=-1)
#DIM HasPiss
#DIM HasScat
#DIM nTarget
#DIM nCurPantsu
#DIM nGetStage
#DIM nSoilPer
#DIM nMagicID
nCurPantsu = EQUIP:ARG:6
;not magical
IF !STRLENS(DiapeMagicAttunement:ARG:0)
	RETURN
ENDIF
nMagicID = MagicUnderwear_GetID(DiapeMagicAttunement:ARG:0)
;neyou
IF DiapeMagicAttunement:ARG:0 == "goToSleep" && SHIRAHU(ARG)
	PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 네오우 속옷의 동조로 기절한다.
	CALL CHARA_ACTION_FAINT(ARG)
	SIF ARG == MASTER
		CALL OYASUMI
ENDIF
;dual accidents cast twice
;cast the scat spell first
IF HasScat && DiapeCharges:ARG:0
	nSoilPer = (BASE:ARG:Poo*100)/MAXBASE:ARG:Poo
	FOR LOCAL, 0, 10
	DEBUGPRINTFORML 배설물: {nSoilPer} 대 {DT_CELL_GET("DiapeMagic",nMagicID,@"배설물레벨{LOCAL}", 1)}
	IF (nSoilPer < DT_CELL_GET("DiapeMagic",nMagicID, @"pooLevel{LOCAL}", 1)) || (LOCAL > 0 && !DT_CELL_GET("DiapeMagic",nMagicID, @"pooLevel{LOCAL}", 1))
		BREAK
	ENDIF
	NEXT
	LOCAL = MAX(0,LOCAL-2)
	DEBUGPRINTFORML 마법 단계 {LOCAL}을(를) 골랐다
	NAS_ESP_DiaperSpell:ARG:0 = DT_CELL_GET("DiapeMagic",nMagicID, @"pooSpell{LOCAL}", 1)
ENDIF
IF HasPiss && DiapePooCharges:ARG:0
	nSoilPer = (BASE:ARG:4*100)/MAXBASE:ARG:4
	FOR LOCAL, 0, 10
	DEBUGPRINTFORML 소변: {nSoilPer} 대 {DT_CELL_GET("DiapeMagic",nMagicID,@"peeLevel{LOCAL}", 1)}
	IF (nSoilPer < DT_CELL_GET("DiapeMagic",nMagicID, @"peeLevel{LOCAL}", 1)) || (LOCAL > 0 && !DT_CELL_GET("DiapeMagic",nMagicID, @"peeLevel{LOCAL}", 1))
		BREAK
	ENDIF
	NEXT
	LOCAL = MAX(0,LOCAL-2)
	DEBUGPRINTFORML 스펠 스테이지가 선택되었다 {LOCAL}
	IF NAS_ESP_DiaperSpell:ARG:0
		NAS_ESP_DiaperSpell:ARG:1 = DT_CELL_GET("DiapeMagic",nMagicID, @"peeSpell{LOCAL}", 1)
	ELSE
		NAS_ESP_DiaperSpell:ARG:0 = DT_CELL_GET("DiapeMagic",nMagicID, @"peeSpell{LOCAL}", 1)
	ENDIF
ENDIF
DEBUGPRINTFORML 소일 주문을 사용한다 {NAS_ESP_DiaperSpell:ARG:0}, {NAS_ESP_DiaperSpell:ARG:1}.

