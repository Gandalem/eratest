@MagicUnderwear_GetID(defName)
#FUNCTION
#DIMS DYNAMIC defName
SIF !STRLENS(defName) || STRLENS(defName) >= 40
	RETURNF
DEBUGPRINTFORML 정의 %defName%
VARSET RESULT
DT_SELECT "DiapeMagic", @"defName = '%defName%'"
RETURNF RESULT:1

@MagicUnderwear_GetName(defName)
#FUNCTIONS
#DIMS DYNAMIC defName
#DIMS DYNAMIC gotName
SIF !STRLENS(defName) || STRLENS(defName) >= 40
	RETURNF
gotName '= DT_CELL_GETS("DiapeMagic", MagicUnderwear_GetID(defName), "label", 1)
SIF !STRLENS(gotName)
	gotName '= defName
RETURNF gotName

@MagicUnderwear_Cost(C_ID,U_ID,M_DEF)
#FUNCTION
#DIM C_ID
#DIM U_ID
#DIM M_ID
#DIM M_YJ
#DIMS M_DEF
#DIM MP_COST
M_ID = MagicUnderwear_GetID(M_DEF)
M_YJ = DT_CELL_GET("DiapeMagic", M_ID, "youjutsuType", 1)
SIF !INRANGE(M_YJ,0,64)
	RETURNF 0
IF IsPadded(C_ID,,U_ID)
	MP_COST = 175
ELSE
	MP_COST = 50
ENDIF
SIF IsPadded(C_ID,"pull-up",U_ID)
	TIMES MP_COST, 0.75
SELECTCASE GET_STR(C_ID, "下半身下着_ずらし可能", U_ID, "Sub Type")
	CASE "Thin"
		TIMES MP_COST, 0.75
	CASE "Thick"
		TIMES MP_COST, 1.40
	CASE "Bulky"
		TIMES MP_COST, 2.00
	CASE "Extreme"
		TIMES MP_COST, 3.50
	CASE "Hyper"
		TIMES MP_COST, 8.00
ENDSELECT
SELECTCASE YoujutsuLevel:C_ID:M_YJ
	CASE 1
		;D
		TIMES MP_COST, 0.90
	CASE 2
		;C
		TIMES MP_COST, 0.75
	CASE 3
		;B
		TIMES MP_COST, 0.60
	CASE 4
		;A
		TIMES MP_COST, 0.50
	CASE 5
		;S
		TIMES MP_COST, 0.40
	CASE 6
		;Extra
		TIMES MP_COST, 0.20
	CASE 7
		;Phantasm
		TIMES MP_COST, 0.15
	CASE 8
		;OverDrive
		TIMES MP_COST, 0.12
	CASE 9
		;TriUltra
		TIMES MP_COST, 0.08
	CASE 10
		;QuadUltra
		TIMES MP_COST, 0.05
ENDSELECT
RETURNF MP_COST

