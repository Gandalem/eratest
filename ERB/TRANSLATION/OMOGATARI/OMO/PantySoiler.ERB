;========================================
;Determines if Touhou will not wear diapers
;Dependent on talents.
;No talents mean 100% of wearing a diaper
;========================================

@NoDiaperDay(ARG)
#FUNCTION
#DIM DYNAMIC nThreshold
VARSET nThreshold, 900
;forced diapers
SIF nOmutsu >= 3
	RETURNF 0
;we already get it
SIF TCVAR:ARG:NoDiaperDay
	RETURNF 1
nThreshold = NDD_THRESHOLD(ARG)
;incontinent, bypass
SIF PeeHold:ARG:2 <= -5
	RETURNF 1
SIF PooHold:ARG:2 <= -5
	RETURNF 1
;ending
C = RAND(1000)
;DEBUGPRINTFORML Checking if %CALLNAME:ARG% has a no diaper day: {C} (threshold {nThreshold})
IF C > nThreshold
	TCVAR:ARG:NoDiaperDay = 1
	RETURNF 1
ELSE
	RETURNF 0
ENDIF

@NDD_THRESHOLD(ARG)
#FUNCTION
#DIM DYNAMIC nThreshold
VARSET nThreshold, 900
;brave
SELECTCASE TALENT:ARG:10
	CASE 1
		nThreshold -= 100
	CASE -1
		nThreshold += 100
ENDSELECT
;docile/defiant
SELECTCASE TALENT:ARG:11
	CASE 1
		nThreshold -= 250
	CASE -1
		nThreshold += 100
ENDSELECT
;calm cheeky
SELECTCASE TALENT:ARG:12
	CASE 1
		nThreshold -= 100
	CASE -1
		nThreshold += 100
ENDSELECT
;prideful
SELECTCASE TALENT:ARG:13
	CASE 1
		nThreshold -= 250
	CASE -1
		nThreshold += 250
ENDSELECT
;self control
SIF TALENT:ARG:20
	nThreshold -= 250
;curious about wearing diapers
SIF TALENT:ARG:23 == -1
	nThreshold += 100
;virtuous
;virtuous believe that incontinent is a sin
SELECTCASE TALENT:ARG:30
	CASE 1
		nThreshold -= 250
	CASE -1
		nThreshold += 100
ENDSELECT
;shameless
;more likely to show off diapers while those who are shy try to be discrete.
SELECTCASE TALENT:ARG:33
	CASE 1
		nThreshold -= 200
	CASE -1
		nThreshold += 200
ENDSELECT
;incontinence precept
;wearing diapers means that they accept that they have potty issues.
SELECTCASE ApplicablePrecept(ARG, "Incontinence")
	CASE -3
		nThreshold = 0
	CASE -2
		nThreshold -= 300
	CASE -1
		nThreshold -= 100
	CASE 1
		nThreshold += 100
	CASE 2
		nThreshold += 300
	CASE 3
		nThreshold = 1000
ENDSELECT
RETURNF nThreshold
