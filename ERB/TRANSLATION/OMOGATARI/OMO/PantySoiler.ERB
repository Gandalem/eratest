;========================================
;Detects what liquid is soiling the underwear the most.
;========================================
@DOMINANT_LIQUID_SOIL(ARG)
#FUNCTION
#DIM DYNAMIC DominantType,2
VARSET DominantType
;clean
SIF DiapeCharges:ARG:0 == DiapeCharges:ARG:1
    RETURNF 99

;cycle through all types of soiling
FOR LOCAL, 0, VARSIZE("DiapeLiquidSoil")
    IF DiapeLiquidSoil:ARG:LOCAL > DominantType:1
        DominantType:0 = LOCAL
        DominantType:1 = DiapeLiquidSoil:ARG:LOCAL
    ENDIF
NEXT
RETURNF DominantType

