@TODAYS_PANTIES_NAS(ARG)
#FUNCTION
#DIM DYNAMIC TODAYS_PANTS
#DIM RAND_PANTS, MAXPANTS
#DIM P_TABLE
#DIM DYNAMIC EG_LAST
VARSET RAND_PANTS , 0
SIF CANT_UNDIES(ARG)
	RETURNF 0
CALLF FISHER_YATES_SHUFFLE_F(MAXPANTS)
ARRAYCOPY "SHAFFLE_ARRAY", "RAND_PANTS"
$RETRY
FOR P_TABLE, 0, MAXPANTS
IF GET_INT(ARG, "下半身下着_ずらし可能", RAND_PANTS:P_TABLE, "はける")
	;unisex check
	IF IS_MALE(ARG) && (!GET_INT(ARG, "下半身下着_ずらし可能", RAND_PANTS:P_TABLE, "Unisex") && !GET_INT(ARG, "下半身下着_ずらし可能", RAND_PANTS:P_TABLE, "男性下着"))
		CONTINUE
	ENDIF
	;potty training check
	CALLF DiapeStats(ARG,RAND_PANTS:P_TABLE,1,1)
	LOCALS:0 '= RESULTS
	LOCALS:1 '= RESULTS:2
	LOCAL     = GET_INT(ARG, "下半身下着_ずらし可能", RAND_PANTS:P_TABLE, "Diaper Lover")
	; SIF !CanWearUnderwear(ARG, LOCALS:0,LOCALS:1,LOCAL)
	; 	CONTINUE
	;master underwear check
	SIF !BoughtClothing:6:(RAND_PANTS:P_TABLE) && ARG == MASTER
		CONTINUE
	;last underwear checked fallback
	EG_LAST = RAND_PANTS:P_TABLE
	;priority means a second chance roll (d100)
	; IF RAND(100) < GET_INT(ARG, "下半身下着_ずらし可能", RAND_PANTS:P_TABLE, "Priority")
	; 	TODAYS_PANTS = RAND_PANTS:P_TABLE
	; 	BREAK
	; ENDIF
	;underwear preference
	;IF !RAND:5
	IF RAND(1,201) < (100+UnderwearTagScore(ARG,RAND_PANTS:P_TABLE))
		TODAYS_PANTS = RAND_PANTS:P_TABLE
		BREAK
	ELSE
		CONTINUE
	ENDIF
ELSE
	CONTINUE
ENDIF
SIF P_TABLE == MAXPANTS - 1
	THROW %CALLNAME:ARG%のぱんつ抽選に失敗
NEXT
;return briefs if it can't find anything
IF !TODAYS_PANTS
	IF EG_LAST
		;last underwear checked fallback
		RETURNF EG_LAST
	ELSE
		;i owe you tag
		RETURNF 174
	ENDIF
ENDIF
RETURNF TODAYS_PANTS

