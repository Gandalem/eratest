                PantiesType:ARG:2 '= PantyPad
            ENDIF
        ENDIF

        ;apply pad
        IF STRLENS(PantyPad)
            CALLF UNDERWEAR_PAD_TYPES(PantyPad)
            PeeBuff += UNDERWEAR_PAD_TYPES_LIQUID
            PooBuff += UNDERWEAR_PAD_TYPES_SOLID
            SIF !Previewing
                PadCount:ARG:0 = 1
            ;fecal containment buff
            SIF UNDERWEAR_PAD_TYPES_COUNT_AS_PAD
                PooBuff += (PooCharges*30/100)
        ENDIF
        ; buff fecal containment for normal undies
        ;PooCharges *= 20
    ELSEIF STRFIND(Type, "Diaper") > -1 || STRFIND(Type, "Pull-Up") > -1
        DO
            SIF PadCount:ARG:0 >= 5
                BREAK
            SIF !(MAXBASE:ARG:4 > PeeCharges+PeeBuff)
                BREAK

            CALLF UNDERWEAR_PAD_TYPES("Booster")
            PeeBuff += UNDERWEAR_PAD_TYPES_LIQUID
            PooBuff += UNDERWEAR_PAD_TYPES_SOLID
            IF !Previewing
                PadCount:ARG:0 += 1
                PantiesType:ARG:2 '= "Booster"
            ENDIF
        LOOP 1
    ENDIF
ENDIF

IF Previewing
    RESULT:1 = PeeCharges+PeeBuff
    RESULT:2 = PooCharges+PooBuff
    RESULTS:0 = %Type%
    RESULTS:1 = %Tags%
    RESULTS:2 = %SubType%
    RETURNF
ELSE
    DiapeCharges:ARG:1 = PeeCharges
    DiapePooCharges:ARG:1 = PooCharges
    IF PadCount:ARG:0
        DiapeCharges:ARG:2 = PeeBuff
        DiapePooCharges:ARG:2 = PooBuff
        DiapeCharges:ARG:1 += PeeBuff
        DiapePooCharges:ARG:1 += PooBuff
    ENDIF
    PantiesType:ARG:0 = %Type%
    PantiesType:ARG:1 = %SubType%
    ;0 = current
    ;1 = max
    ;2 = buffs only
    DiapeCharges:ARG:0 = DiapeCharges:ARG:1
    DiapePooCharges:ARG:0 = DiapePooCharges:ARG:1
    SoiledSelf:ARG:0 = 0
    SoiledSelf:ARG:1 = 0		
ENDIF
IF !DS_NoCharaNum
    DELCHARA CHARANUM-1
ENDIF
RETURNF

