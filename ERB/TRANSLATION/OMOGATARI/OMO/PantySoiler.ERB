@UndiesCanSoil(nType,ARG = -1)
#DIMS nType
#FUNCTION
SIF ARG == -1
	ARG = MASTER
SELECTCASE TOLOWER(nType)
	CASE "liquid"
		SIF GETBIT(nPee,1) ; Pee accidents
			RETURNF 1
		SIF GETBIT(nSexExcrete,2) && HAS_VAGINA(ARG); Menstration
			RETURNF 1
		SIF GETBIT(nSexExcrete,1) && HAS_VAGINA(ARG); Pussy Juice
			RETURNF 1
