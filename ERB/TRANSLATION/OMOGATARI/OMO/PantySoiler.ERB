;========================================
;Determines if Touhou will not wear diapers
;Dependent on talents.
;No talents mean 100% of wearing a diaper
;========================================

@NoDiaperDay(ARG)
#FUNCTION
#DIM DYNAMIC nThreshold
VARSET nThreshold, 900
;forced diapers
SIF nOmutsu >= 3
	RETURNF 0
;we already get it
SIF TCVAR:ARG:NoDiaperDay
	RETURNF 1
nThreshold = NDD_THRESHOLD(ARG)
;incontinent, bypass
SIF PeeHold:ARG:2 <= -5
	RETURNF 1
SIF PooHold:ARG:2 <= -5
	RETURNF 1
;ending
C = RAND(1000)
;DEBUGPRINTFORML Checking if %CALLNAME:ARG% has a no diaper day: {C} (threshold {nThreshold})
IF C > nThreshold
	TCVAR:ARG:NoDiaperDay = 1
	RETURNF 1
ELSE
	RETURNF 0
ENDIF

@NDD_THRESHOLD(ARG)
#FUNCTION
#DIM DYNAMIC nThreshold
VARSET nThreshold, 900
;brave
SELECTCASE TALENT:ARG:10
	CASE 1
		nThreshold -= 100
	CASE -1
		nThreshold += 100
ENDSELECT
;docile/defiant
SELECTCASE TALENT:ARG:11
	CASE 1
		nThreshold -= 250
	CASE -1
		nThreshold += 100
ENDSELECT
;calm cheeky
SELECTCASE TALENT:ARG:12
	CASE 1
		nThreshold -= 100
	CASE -1
		nThreshold += 100
ENDSELECT
;prideful
SELECTCASE TALENT:ARG:13
	CASE 1
		nThreshold -= 250
	CASE -1
		nThreshold += 250
ENDSELECT
;self control
SIF TALENT:ARG:20
	nThreshold -= 250
;curious about wearing diapers
SIF TALENT:ARG:23 == -1
	nThreshold += 100
;virtuous
;virtuous believe that incontinent is a sin
SELECTCASE TALENT:ARG:30
	CASE 1
		nThreshold -= 250
	CASE -1
		nThreshold += 100
ENDSELECT
;shameless
;more likely to show off diapers while those who are shy try to be discrete.
SELECTCASE TALENT:ARG:33
	CASE 1
		nThreshold -= 200
	CASE -1
		nThreshold += 200
ENDSELECT
;incontinence precept
;wearing diapers means that they accept that they have potty issues.
SELECTCASE ApplicablePrecept(ARG, "Incontinence")
	CASE -3
		nThreshold = 0
	CASE -2
		nThreshold -= 300
	CASE -1
		nThreshold -= 100
	CASE 1
		nThreshold += 100
	CASE 2
		nThreshold += 300
	CASE 3
		nThreshold = 1000
ENDSELECT
RETURNF nThreshold
;Checks to see if relative fetishes allows for underwear to get soiled

@UndiesCanSoil(nType,ARG = -1)
#DIMS nType
#FUNCTION
SIF ARG == -1
	ARG = MASTER
SELECTCASE TOLOWER(nType)
	CASE "liquid"
		SIF GETBIT(nPee,1) ; Pee accidents
			RETURNF 1
		SIF GETBIT(nSexExcrete,2) && HAS_VAGINA(ARG); Menstration
			RETURNF 1
		SIF GETBIT(nSexExcrete,1) && HAS_VAGINA(ARG); Pussy Juice
			RETURNF 1
		SIF GETBIT(nSexExcrete,0) && HAS_PENIS(ARG); Semen Soiling
			RETURNF 1
	CASE "solid"
		SIF GETBIT(nScat,2) ; Poo accidents
			RETURNF 1
ENDSELECT
RETURNF 0
;========================================
;Function to soil underwear by a certain amount
;========================================

@MessUndies(ARG,nForm = "liquid", nType = 0, nAmount = -1, nBypass = 0)
#FUNCTION
#DIMS nForm
#DIM nType
#DIM nAmount
#DIM nBypass
;underwear will not be soiled if not worn or open
SIF !GROUPMATCH(TEQUIP:ARG:PANTY_STATE,PANTY_WORN,DIAPER_OPEN)
	RETURNF 0
SELECTCASE TOLOWER(nForm)
	CASE "liquid"
		;default to full bladder loss (of urine)
		SIF nAmount == -1 && !nType
			nAmount = BASE:ARG:4
		;bound on potty chair
		IF ARG == MASTER && K102_PunishPottyTimeLeft && K102_ABDLMode() == 2
			IF DiapeCharges:ARG:0-nAmount <= 0
				K102_PunishPottyExcreted:0 += MIN(ABS(DiapeCharges:ARG:0-nAmount), nAmount)
			ENDIF
		ENDIF
		DiapeCharges:ARG:0 = DiapeCharges:ARG:0-nAmount
		SIF !nBypass
			DiapeCharges:ARG:0 = MAX(DiapeCharges:ARG:0,0)
		DiapeLiquidSoil:ARG:nType += nAmount
	CASE "solid"
		;default to full colon loss (of poop)
		SIF nAmount == -1 && !nType
			nAmount = BASE:ARG:17
		;bound on potty chair
		IF ARG == MASTER && K102_PunishPottyTimeLeft && K102_ABDLMode() == 2
			IF DiapePooCharges:ARG:0-nAmount <= 0
				K102_PunishPottyExcreted:1 += MIN(ABS(DiapePooCharges:ARG:0-nAmount), nAmount)
			ENDIF
