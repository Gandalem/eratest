@UNDERWEAR_IN_CONT_RANGE(ARG,CHKUndSet,CHKUndSet:1)
#FUNCTION
#DIMS CHKUndSet,2
#DIM WorstHoldingStat
WorstHoldingStat = EffectivePottyLevel(ARG)
CALLF UNDERWEAR_TYPES(CHKUndSet,CHKUndSet:1)
SELECTCASE MERGE_UNDIES_NAME(CHKUndSet,CHKUndSet:1)
	CASE "Thin Pull-Up"
		SELECTCASE WorstHoldingStat
			CASE IS < -1
				;has potty issues
				;would think a light pull-up isn't enough
				RETURNF 0
			CASEELSE
				;if last accident was less than 5 days ago.
				;then touhou would have a chance to wear a pull-up as a precaution
				SIF (LastAccident:ARG:0-DAY > MAX(DAY-5,0) || LastPooAccident:ARG:0-DAY > MAX(DAY-5,0))
					RETURNF 1
		ENDSELECT
	CASEELSE
		;diaper lover
		SIF IsDiaperLover(ARG) && UNDERWEAR_TYPES_IS_DIAPER > 1
			RETURNF 2
		;priority wear
		SIF INRANGE(WorstHoldingStat,UNDERWEAR_TYPES_FORCE_POTTY_LEVEL:0,UNDERWEAR_TYPES_FORCE_POTTY_LEVEL:1)
			RETURNF 2
		;can wear
		SIF INRANGE(WorstHoldingStat,UNDERWEAR_TYPES_POTTY_LEVEL:0,UNDERWEAR_TYPES_POTTY_LEVEL:1)
			RETURNF 1
ENDSELECT
;no diaper
SIF !nOmutsu && !UNDERWEAR_TYPES_IS_DIAPER
	RETURNF 2
;always diapered
SIF nOmutsu >= 3 && UNDERWEAR_TYPES_IS_DIAPER
	RETURNF 2
SIF UnderwearOffPoints(ARG, , MERGE_UNDIES_NAME(CHKUndSet,CHKUndSet:1)) >= 3
	RETURNF 2
;track range outside
D:0 = UNDERWEAR_TYPES_POTTY_LEVEL:0-WorstHoldingStat
D:1 = UNDERWEAR_TYPES_POTTY_LEVEL:1-WorstHoldingStat
SIF D:0 > 0
	D:0 *= -1
SIF D:1 > 0
	D:1 *= -1
RETURNF MAX(D:0,D:1)
;preferred underwear matching
;0 is neutral
;+100 or higher will always be chosesn if rolled on
;-100 or lower will never be chosen
;tag matching is based on continence, diaper attraction, and sanity

@UnderwearTagScore(ARG,ARG:1)
#FUNCTION
#DIM DYNAMIC SCORE,4
#DIMS TEMP_SPLIT, 100
#DIM DYNAMIC nInfluence, 10
VARSET SCORE
VARSET RESULTS
VARSET LOCALS
CALLF DiapeStats(ARG,ARG:1,1,1)
ARRAYCOPY "RESULTS", "LOCALS"
CALLF UNDERWEAR_TYPES(LOCALS,LOCALS:2)
SIF UNDERWEAR_TYPES_IS_DIAPER && !nOmutsu ; diaper flag
	RETURNF -100
; SIF !CanWearUnderwear(ARG,LOCALS,LOCALS:2,0)
;     RETURNF -100
;punishment points
SIF !UnderwearOffPoints(ARG, , MERGE_UNDIES_NAME(LOCALS,LOCALS:2))
	RETURNF -100
;continence ignorant
SIF ARG != MASTER && TALENT:ARG:ContinenceIgnorant && LOCALS != "Underwear"
	RETURNF -100
;when preferences are on
P:4 = 0
IF ARG == MASTER
	P:4 = UNDERWEAR_TYPE_MATCHING(LOCALS,LOCALS:2)
	;threshold
	SIF P:4 <= -8
		RETURNF -100
ENDIF
;continence
Z = UNDERWEAR_IN_CONT_RANGE(ARG,LOCALS,LOCALS:2)
;double if negative
SIF Z < 0
	TIMES Z, 2
Z += P:4
; Z += UNDERWEAR_TAG_AFFINITY(ARG,@"%LOCALS%/")
; Z += UNDERWEAR_TAG_AFFINITY(ARG,@"%LOCALS:2%/")
; Z += UNDERWEAR_TAG_AFFINITY(ARG,@"%MERGE_UNDIES_NAME(LOCALS,LOCALS:2)%/")
SCORE:0 = (50*Z)
Z = 0
Z += UNDERWEAR_TAG_AFFINITY(ARG,@"%LOCALS%/")
Z += UNDERWEAR_TAG_AFFINITY(ARG,@"%LOCALS:2%/")
Z += UNDERWEAR_TAG_AFFINITY(ARG,@"%MERGE_UNDIES_NAME(LOCALS,LOCALS:2)%/")
SCORE:0 = (20*Z)
;preferences
SPLIT LOCALS:1, "/", TEMP_SPLIT
;get tags
FOR LOCAL:1,0,VARSIZE("TEMP_SPLIT")
SIF !STRLENS(TEMP_SPLIT:(LOCAL:1))
	BREAK
LOCALS:5 '= TEMP_SPLIT:(LOCAL:1)+"/"
SCORE:1 += (15*UNDERWEAR_TAG_AFFINITY(ARG,LOCALS:5))
NEXT
;SCORE:2 = (SCORE:0*80/100)+(SCORE:1*20/100)
;SCORE:2 = (SCORE:0*60/100) + (SCORE:1*40/100)
;60% continence, 40% other
nInfluence = (100 + (SCORE:0-100) * 60/100)
nInfluence:1 = (100 + (SCORE:1-100) * 40/100)
SCORE:2 = nInfluence + nInfluence:1
RETURNF SCORE:2

