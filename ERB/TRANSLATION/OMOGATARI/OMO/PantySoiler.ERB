@PeeAndPoo(HasPiss,HasScat, PeeMessage, PooMessage, endSTR = " and")
#FUNCTIONS
#DIM HasPiss
#DIM HasScat
#DIMS PeeMessage
#DIMS PooMessage
#DIMS nMessage
#DIMS endSTR
nMessage '= ""
