;-------------------------------------------------
; PANTY_REWORK_CHANGE
; Switches to a new underwear
; ARGS:
;   - ARG (Target, required)
;   - ARG:1 (Underwear, required)
;   - ARG:2 (Overwrite underwear pads, see UnderwearPadPick for list)
;   - ARG:3 (Changer)
;   - ARGS (Magic Type)
;-------------------------------------------------

@PANTY_REWORK_CHANGE(ARG,ARG:1,ARG:2=-2,ARG:3=-1,ARGS="default")
#FUNCTION
RESET_STAIN ARG
; CFLAG:ARG:指定パンツ = ARG:1
; CALL SET_PANTS(ARG)
; CALL SET_PANTS(ARG,"今日のパジャマ")
; CFLAG:ARG:指定パンツ = 0
;auto pad override
IF ARG:2 == -2
	IF ARG == MASTER
		ARG:2 = UNDERWEAR_PAD_AUTO_USE
	ELSE
		ARG:2 = 0
	ENDIF
ENDIF
CFLAG:ARG:206 = ARG:1
CFLAG:ARG:246 = ARG:1
CFLAG:ARG:きょうのぱんつ = ARG:1
CFLAG:ARG:パジャマパンツ = ARG:1
CFLAG:ARG:DiapeSet = 0
EQUIP:ARG:下半身下着２ = ARG:1
CFLAG:ARG:InconPantyDetections = 0
CALLF DiapeStats(ARG,ARG:1,1,,ARG:2)
CALLF ArmorStats(ARG,ARG:1,1,,6)
IF ARGS == "default"
	IF ARG:3 == MASTER
		IF ARG == MASTER
			LOCALS '= UNDERWEAR_MAGIC_AUTO_USE_SELF
		ELSE
			LOCALS '= UNDERWEAR_MAGIC_AUTO_USE_OTHER
		ENDIF
		DiapeMagicAttunement:ARG:0 '= LOCALS
	ELSE
		DiapeMagicAttunement:ARG:0 '= ""
	ENDIF
ELSE
	DiapeMagicAttunement:ARG:0 '= ARGS
ENDIF
CFLAG:ARG:ノーパン = 0
DEBUGPRINTFORML %CALLNAME:ARG%의 팬티가 변경됨:{ARG:1} %undies_name_with_brand(ARG,ARG:1,1)% (%PeeProtectType(ARG,2)%, {DiapeCharges:ARG:1}ml/{DiapePooCharges:ARG:1}g)
;legacy support

@DiaperChange(ARG,ARG:1)
RETURN PANTY_REWORK_CHANGE(ARG,ARG:1)

