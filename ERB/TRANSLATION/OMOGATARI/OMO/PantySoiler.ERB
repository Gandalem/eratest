;-------------------------------------------------
; SoiledDiaper
; checks to see if the 2hu's underwear is soiled enough to give a change
; ARGS: ARG (target), ExcreteType (check pee, poo),
; SoilBool (0: return as bool, 1: return as percentage, 2: return as absolute value)
;-------------------------------------------------

@SoiledDiaper(ARG, ExcreteType, SoilBool, SoilThreshold = 50)
#FUNCTION
#DIM SoilBool
#DIM ExcreteType
#DIM SoilThreshold
#DIM PeeSoil
#DIM PooSoil
#DIM PeeSoilPercent
#DIM PooSoilPercent
SIF !DiapeCharges:ARG:1 || !DiapePooCharges:ARG:1
	RETURNF 0
PeeSoil = ABS(DiapeCharges:ARG:0 - DiapeCharges:ARG:1)
PooSoil = ABS(DiapePooCharges:ARG:0 - DiapePooCharges:ARG:1)
PeeSoilPercent = (PeeSoil*100)/DiapeCharges:ARG:1
PooSoilPercent = (PooSoil*100)/DiapePooCharges:ARG:1
SELECTCASE ExcreteType
	CASE 0
		SELECTCASE SoilBool
			CASE 0
				IF SoiledDiaper(ARG, 2)
					RETURNF 2
				ELSEIF SoiledDiaper(ARG, 1)
					RETURNF 1
				ENDIF
			CASE 1
				IF SoiledDiaper(ARG, 2, 1)
					RETURNF SoiledDiaper(ARG, 2, 1)
				ELSEIF SoiledDiaper(ARG, 1, 1)
					RETURNF SoiledDiaper(ARG, 1, 1)
				ENDIF
			CASE 2
				IF SoiledDiaper(ARG, 2, 2)
					RETURNF SoiledDiaper(ARG, 2, 2)
				ELSEIF SoiledDiaper(ARG, 1, 2)
					RETURNF SoiledDiaper(ARG, 1, 2)
				ENDIF
		ENDSELECT
	CASE 1
		IF PeeSoilPercent >= SoilThreshold
			SELECTCASE SoilBool
				CASE 0
					RETURNF 1
				CASE 1
					RETURNF PeeSoilPercent
				CASE 2
					RETURNF PeeSoil
			ENDSELECT
		ENDIF
	CASE 2
		IF PooSoilPercent >= SoilThreshold
			SELECTCASE SoilBool
				CASE 0
					RETURNF 1
				CASE 1
					RETURNF PooSoilPercent
				CASE 2
					RETURNF PooSoil
			ENDSELECT
		ENDIF
ENDSELECT
RETURNF 0
