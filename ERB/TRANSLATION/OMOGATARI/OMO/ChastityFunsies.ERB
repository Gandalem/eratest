@IN_CHASTITY(ARG)
#FUNCTION
#DIM CHASTITY_INTS
VARSET CHASTITY_INTS
FOR LOCAL,1,29
SIF LOCAL == 12
	CONTINUE
SIF STRLENS(EQUIPNAME:(LOCAL))
	CHASTITY_INTS |= CHASTITY_ITEM(LOCAL,EQUIP:ARG:LOCAL)
NEXT
SIF DiapeMagicAttunement:ARG:0 == "lockDiaper"
	CHASTITY_INTS |= 39
SIF ACCESSORY_EQUIPPED(ARG,67)
	TEQUIP:ARG:ボールギャグ = 1
RETURNF CHASTITY_INTS

@CHASTITY_ITEM(ARG,ARG:1)
#FUNCTION
SIF ARG == 12 || ARG == 0
	RETURNF 0
RETURNF GET_INT(, CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(ARG:0)), ARG:1, "Chastity")

@ChastityInfo(ARG)
#DIMS TypeName = "C", "V", "A", "B", "M", "U", "Arns", "Legs"
#DIM holesBlocked
holesBlocked = IN_CHASTITY(ARG)
IF GETBIT(holesBlocked,0) || GETBIT(holesBlocked,1) || GETBIT(holesBlocked,2) || GETBIT(holesBlocked,3) || GETBIT(holesBlocked,4) || GETBIT(holesBlocked,5)
	VARSET LOCALS
	FOR LOCAL,0,6
	SIF GETBIT(holesBlocked,LOCAL)
		LOCALS += TypeName:LOCAL+"、"
	NEXT
	PRINTFORM <In Chastity (%LIST_IN_STRING(LOCALS,"、",",",)%)>
ENDIF
IF GETBIT(holesBlocked,6) || GETBIT(holesBlocked,7)
	VARSET LOCALS
	FOR LOCAL,6,8
	SIF GETBIT(holesBlocked,LOCAL)
		LOCALS += TypeName:LOCAL+"、"
	NEXT
	PRINTFORM <Bound (%LIST_IN_STRING(LOCALS,"、",",",)%)>
ENDIF

