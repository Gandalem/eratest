@IN_CHASTITY(ARG)
#FUNCTION
#DIM CHASTITY_INTS
VARSET CHASTITY_INTS
FOR LOCAL,1,29
    SIF LOCAL == 12
        CONTINUE
    SIF STRLENS(EQUIPNAME:(LOCAL))
        CHASTITY_INTS |= CHASTITY_ITEM(LOCAL,EQUIP:ARG:LOCAL)
NEXT
SIF DiapeMagicAttunement:ARG:0 == "lockDiaper"
    CHASTITY_INTS |= 39
SIF ACCESSORY_EQUIPPED(ARG,67)
    TEQUIP:ARG:ボールギャグ = 1
RETURNF CHASTITY_INTS

@CHASTITY_ITEM(ARG,ARG:1)
#FUNCTION
SIF ARG == 12 || ARG == 0
    RETURNF 0
RETURNF GET_INT(, CLOTHES_PARTS_TO_CATEGORY(EQUIPNAME:(ARG:0)), ARG:1, "Chastity")

