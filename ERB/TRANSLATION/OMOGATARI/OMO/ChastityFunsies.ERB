@ChangeRestraint(ARG,RestrainType,AccessoryID)
#FUNCTION
#DIM DYNAMIC AccessoryID
#DIMS DYNAMIC RestrainType
#DIM DYNAMIC AccessorySlot
#DIM DYNAMIC RepeatInt
AccessorySlot = FINDELEMENT(EQUIPNAME,RestrainType)
SIF AccessorySlot == -1
	RETURNF
;check accessory slot
CFLAG:ARG:(200+AccessorySlot) = AccessoryID
CFLAG:ARG:(240+AccessorySlot) = AccessoryID
EQUIP:ARG:AccessorySlot = AccessoryID
DEBUGPRINTFORML %CALLNAME:ARG%의 액세서리가 변경되었습니다: {AccessoryID} %undies_name_with_brand(ARG,AccessoryID,1,AccessorySlot)% (슬롯 {AccessorySlot})
RETURNF 1
