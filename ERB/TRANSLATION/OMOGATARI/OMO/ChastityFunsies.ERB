@CHASITY_PU_POINT_GAIN(ARG,ARG:1)
#FUNCTION
#DIM DYNAMIC PPCHANGE
#DIM DYNAMIC WITNESSED_COUNT
#DIM POINTS_TO_ADD
#DIM POINTS_LEVEL_MIN
VARSET PPCHANGE
VARSET WITNESSED_COUNT
POINTS_LEVEL_MIN = 1
POINTS_TO_ADD = 3
;TALENTS
IF TALENT:(ARG:1):25
	POINTS_LEVEL_MIN ++
	POINTS_TO_ADD += 3
ENDIF
IF TALENT:(ARG:1):30 == 1
	POINTS_LEVEL_MIN += 2
	POINTS_TO_ADD += 7
ENDIF
IF ARG == MASTER || CFLAG:(ARG):300 == CFLAG:MASTER:300
	FOR LOCAL, 1, GET_TARGETNUM() + 1
	IF (CFLAG:(TARGET:LOCAL):うふふ || CFLAG:(TARGET:LOCAL):イタズラ) && !GETBIT(FLAG:潜伏,0)
		WITNESSED_COUNT ++
	ENDIF
	NEXT
ENDIF
IF WITNESSED_COUNT > 0
	POINTS_LEVEL_MIN ++
	POINTS_TO_ADD += 1
ENDIF
PPCHANGE = PP_SCALE_POINTS(ARG,POINTS_LEVEL_MIN,POINTS_TO_ADD)
RETURNF PPCHANGE

@CHASTITY_BYPASS_ATTEMPT(ARG)
#DIM CBA_RESULT
PRINTFORMW 당신은 여러 방법을 통해 순결 장치를 우회할 수 있습니다.
CALL ASK_M( "취소",1, "자물쇠 따기", 1, "사격한다", 1, "비틀어 연다", 1 )
SELECTCASE RESULT
	CASE 0
	CASE 1
		EXP:MASTER:手淫経験 ++
		IF RAND:60 < LEVEL_TO_RANK(ABL:MASTER:指)*10
			PRINTFORMW 당신은 순식간에 자물쇠를 해제했다!
			RETURN 1
		ELSE
			PRINTFORML 자물쇠를 따는 데 실패했다.
			IF FLAG:70
				BASE:ARG:TSP -= 12
			ELSE
				TIME += 2
			ENDIF
		ENDIF
ENDSELECT
SELECTCASE CBA_RESULT
	CASE IS > 0
	CASE IS < 0
		FOR LOCAL, 0, CHARANUM
		SIF CFLAG:LOCAL:300 != CFLAG:ARG:300
			CONTINUE
		SIF !CharaDiaperChecker(LOCAL)
			CONTINUE
		IF (SHIRAHU(LOCAL)) && !FLAG:70 && !CFLAG:LOCAL:出禁 && !IsDead:LOCAL:0
			;PRINT 物音に気づいた
			PRINTFORML %CALLNAME:LOCAL%은(는) 당신이 순결 장치를 우회하려 하는 것을 알아챈다.
			CALL CHARA_AWAKE(LOCAL,1)
			IF !CFLAG:LOCAL:睡眠 && !CFLAG:LOCAL:隠密中
				PRINTFORMW %CALLNAME:ARG%은(는) 당신을 수상하게 여겨 수색한다.
				FORCEWAIT
				RETURN
			ENDIF
		ENDIF
		NEXT
ENDSELECT
RETURN CBA_RESULT

@SET_CAGE_MESSAGE_BEFORE(CHANGEE,CHANGER,CAGE_LEVEL)
#DIM CHANGER
#DIM CHANGEE
#DIM CAGE_LEVEL
SELECTCASE CAGE_LEVEL
	CASE 1
		PRINTFORMW %조사처리(CALLNAME:CHANGER,"는")% %CALLNAME:CHANGEE%에게 맞는 케이지와 고리를 꺼냈다.
		PRINTFORMW 고리를 %CALLNAME:CHANGEE%의 고환 뒤쪽에 밀어 넣고, 손가락으로 단단히 자리 잡았는지 확인했다.
		PRINTFORMW 케이지 본체를 %CALLNAME:CHANGEE%의 %TINKO_TR(CHANGEE)% 위에 씌운 뒤 고리의 홈에 밀어 넣었다.
		PRINTFORMW 마지막으로 구멍에 자물쇠를 끼우고 돌려 잠갔다.
	CASE 2
		PRINTFORMW 당신은 금속 부분 전체에 작은 구멍들이 그려진 가죽과 금속 벨트를 꺼낸다.
		PRINTFORMW
ENDSELECT

