@CHASITY_PU_POINT_GAIN(ARG,ARG:1)
#FUNCTION
#DIM DYNAMIC PPCHANGE
#DIM DYNAMIC WITNESSED_COUNT
#DIM POINTS_TO_ADD
#DIM POINTS_LEVEL_MIN
VARSET PPCHANGE
VARSET WITNESSED_COUNT
POINTS_LEVEL_MIN = 1
POINTS_TO_ADD = 3
;TALENTS
IF TALENT:(ARG:1):25
    POINTS_LEVEL_MIN ++
    POINTS_TO_ADD += 3
ENDIF
IF TALENT:(ARG:1):30 == 1
    POINTS_LEVEL_MIN += 2
    POINTS_TO_ADD += 7
ENDIF

IF ARG == MASTER || CFLAG:(ARG):300 == CFLAG:MASTER:300
    FOR LOCAL, 1, GET_TARGETNUM() + 1
        IF (CFLAG:(TARGET:LOCAL):うふふ || CFLAG:(TARGET:LOCAL):イタズラ) && !GETBIT(FLAG:潜伏,0)
            WITNESSED_COUNT ++
        ENDIF
    NEXT
ENDIF
IF WITNESSED_COUNT > 0
    POINTS_LEVEL_MIN ++
    POINTS_TO_ADD += 1
ENDIF

PPCHANGE = PP_SCALE_POINTS(ARG,POINTS_LEVEL_MIN,POINTS_TO_ADD)
RETURNF PPCHANGE


