	PRINTFORMW \@ ACCIDENT_CHARA == MASTER ? %PARSE("You smile")% # %HE_SHE(ACCIDENT_CHARA)% 미소 짓는다 \@ in relief with the knowledge that \@ ACCIDENT_CHARA == MASTER ? %PARSE("your")% # %HIS_HER(ACCIDENT_CHARA)% \@ %PeeProtectType(ACCIDENT_CHARA)% is there to take care of \@ ACCIDENT_CHARA == MASTER ? %PARSE("your")% # %HIS_HER(ACCIDENT_CHARA)% \@ 화장실 사용이 필요하다.    
ELSE
	CLEARLINE LINECOUNT - ACCIDENT_LINECOUNT
	ACCIDENT_LINECOUNT = LINECOUNT
	CALL ACCIDENT_EV_CATCHSPEAK(ACCIDENT_EV_KOJO_WET,999,ACCIDENT_EV_KOJO_EXTRA,@"「...」", "発情", ACCIDENT_CHARA, 0)
	PRINTFORMW \@ ACCIDENT_CHARA == MASTER ? %PARSE("Your")% # %CALLNAME:ACCIDENT_CHARA%'s \@cheeks become flustered as \@ ACCIDENT_CHARA == MASTER ? %PARSE("you wish you")% # %HE_SHE(ACCIDENT_CHARA)%은 %HE_SHE(ACCIDENT_CHARA)%를 원한다. \@가 지금 새 기저귀를 차고 있었기 때문이다.
ENDIF
