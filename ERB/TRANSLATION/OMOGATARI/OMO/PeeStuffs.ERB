@AIB_INIT(ARG,HasPiss=0,HasScat=0,bypassAnticipation=0,isIntentional=0,theTarget=-1)
#DIM DYNAMIC HasPiss
#DIM DYNAMIC HasScat
#DIM DYNAMIC bypassAnticipation
#DIM DYNAMIC isIntentional
#DIM DYNAMIC theTarget
IF PooBarStage(ARG) >= 7
	HasScat = 1
	SIF PeeBarStage(ARG) >= 4
		HasPiss = 1
ENDIF
IF PeeBarStage(ARG) >= 7
	HasPiss = 1
	SIF PooBarStage(ARG) >= 4
		HasScat = 1
ENDIF
SIF BASE:ARG:4 >= GetMaxBladder(ARG,7)*3/2
	HasPiss = 2
SIF BASE:ARG:Poo >= GetMaxBowels(ARG,7)*3/2
	HasScat = 2
