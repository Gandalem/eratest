@TSP_RELIEF_INIT(ARG,inAccident=0,HasPiss,HasScat)
#DIM DYNAMIC inAccident
#DIM DYNAMIC nVicitm
#DIM DYNAMIC HasPiss
#DIM DYNAMIC HasScat
IF !HasPiss && !HasScat
	PRINTFORML 아직 화장실에 갈 필요는 없다.
	WAIT
	RETURN -1
ELSEIF BASE:ARG:TSP < 350
	PRINTFORML TSP가 충분하지 않습니다.
	WAIT
	RETURN -1
ENDIF
PRINTFORML 어디에 용변을 보고 싶나요?
FOR LOCAL,0,CHARANUM-1
SIF LOCAL == ARG
	CONTINUE
SIF CFLAG:LOCAL:300 != CFLAG:MASTER:300
	CONTINUE
SIF !EQUIP:LOCAL:6
	CONTINUE
PRINTFORML [{LOCAL,3}] - %CALLNAME:LOCAL%
NEXT
PRINTL
PRINTFORML [-1] 그 자리에서
SIF !inAccident
	PRINTFORML [-9] 됐어
INPUT
nVicitm = RESULT
IF GROUPMATCH(RESULT,-9)
	RETURN -9
ELSEIF GROUPMATCH(RESULT,-1,-2)
	nVicitm = RESULT
ELSEIF !INRANGE(RESULT,0,CHARANUM-1)
	nVicitm = -1
ELSEIF CFLAG:RESULT:300 != CFLAG:ARG:300
	nVicitm = -1
ELSE
	nVicitm = RESULT
ENDIF
SIF inAccident
	RETURN nVicitm
CALL TSP_RELIEF(ARG,nVicitm,HasPiss,HasScat)

@TSP_RELIEF(theCulprit,theVictim,HasPiss,HasScat)
#DIM theCulprit
#DIM theVictim
#DIM oldTS
#DIM DYNAMIC HasPiss
#DIM DYNAMIC HasScat
#DIM DYNAMIC shouldMasterKnowAboutIt
oldTS = FLAG:70
;if another touhou's in TS master should see it
;else prompt player if they know TSP
shouldMasterKnowAboutIt = theCulprit == MASTER || oldTS
IF BASE:MASTER:TSP && !shouldMasterKnowAboutIt
	PRINTFORMDW %CALLNAME:theCulprit%이(가) 시간을 멈추려고 하는 것 같다.
	PRINTFORMDW 응답으로 시간 정지?
	CALL ASK_YN
	shouldMasterKnowAboutIt = !RESULT
ENDIF
IF shouldMasterKnowAboutIt
	FLAG:70 = 1
	SETBGCOLOR C_THE_WORLD
	SETCOLOR C_YELLOW
	PRINTL ＴＳＰ　ＲＥＬＩＥＦ
	RESETCOLOR
	PRINTFORMDW 통제력을 잃기 직전, %조사처리(CALLNAME:theCulprit,"는")% 시간을 멈춰 세우고 세상의 모든 움직임을 얼린다.
	IF ImminentAccident_SpellFailureLevel
		PRINTFORMDW 당신이 무엇을 해야 할지 생각하느라 바쁠 때, 자신의 %PeeAndPoo(HasPiss,HasScat,"방광","장")%가 통제 없이 나오기 시작하는 것을 느낀다.
		ACCIDENT_CHARA = theCulprit
		ACCIDENT_HasPiss = HasPiss
		ACCIDENT_HasScat = HasScat
		ACCIDENT_LINECOUNT = LINECOUNT
		CALL CUTSCENESPEAK_NAS(@"「%MOAN("h")%...」", "笑顔:照れ", theCulprit, 0)
		CALL ACCIDENT_SHOW_BAR_RELIEVE()
		CALL CUTSCENESPEAK_NAS(@"「....」", "発情", theCulprit, 0)
		SIF HasPiss
			CALLF MessUndies(theCulprit, "liquid", 0, ACCIDENT_BLADDER_STORAGE-BASE:theCulprit:4)
		SIF HasScat
			CALLF MessUndies(theCulprit, "solid", 0, ACCIDENT_BLADDER_STORAGE:1-BASE:theCulprit:Poo)
		SELECTCASE ImminentAccident_SpellFailureLevel
			CASE 1
				IF HasScat
					PRINTFORMDW 당신은 무언가 따뜻하고 지독한 것이 %PeeProtectType(theCulprit,2)%의 뒤쪽으로 들어오는 것을 느낀다.
					PRINTFORMDW 뒤쪽을 확인해보니, 당신이 조금 대변을 흘린 것 같다.
				ELSE
					PRINTFORMDW 당신은 따뜻하고 축축한 무언가가 %PeeProtectType(theCulprit,2)% 안으로 들어오는 것을 느낀다.
					PRINTFORMDW 사타구니를 확인해보니, 당신이 소변을 좀 봤던 것 같다.
				ENDIF
			CASE 2
				IF HasScat
					PRINTFORMDW 정신 차리기 전에, 상당히 큰 나무토막이 당신의 항문에서 나와 %PeeProtectType(theCulprit,2)% 안으로 들어간다.
					PRINTFORMDW 주변에 사고 냄새가 풍기는 것을 느낄 수 있다.
				ELSE
					PRINTFORMDW 당신이 모르는 사이에 많은 양의 소변이 흘러 나와 %PeeProtectType(theCulprit,2)% 안으로 들어간다.
					PRINTFORMDW 따뜻하고 축축한 감각이 사타구니를 타고 퍼지는 것을 느낀다.
				ENDIF
			CASE 3
				PRINTFORMDW 결국 통제권을 되찾지만, 그 전에 방광과 장 속 내용물의 상당 부분이 %PeeProtectType(theCulprit,2)% 안으로 들어가 버린다.
		ENDSELECT
	ENDIF
	PRINTL
	IF theVictim != -1
		PRINTFORMDW 그냥 당신의 %PeeProtectType(MASTER,2)% 안으로 들어갈 수도 있지만, 그건 지루하다. 대신 당신은 당신의 %PeeProtectType(MASTER,2)%의 온전함을 지키기 위해 프레임을 세우기 시작한다.
		PRINTFORMDW 피해자로 %CALLNAME:theVictim%을 선택하고, 통제력을 유지하며 몸을 붙인 채 그에게 다가간다.
		PRINTL
		CALL PottyInTouhouUndies(theCulprit,theVictim,HasPiss,HasScat,1)
	ELSE
		PRINTFORMDW 당신은 그냥 모든 하의를 벗고 마음껏 풀어주기로 결정한다.
		CALL PottyOutside(theCulprit,HasPiss,HasScat,1)
	ENDIF
	; SIF DAILY_Lucid_Stats:1
	; 	CALLF PEEME(MASTER,0)
	; SIF DAILY_Lucid_Stats:2
	; 	CALLF POOME(MASTER,0)
	PRINTL
	RESETBGCOLOR
	FLAG:70 = oldTS
ELSE
	IF theVictim == MASTER
		IF HasScat
			PRINTFORMDW 번쩍, 당신은 무언가 따뜻하고 악취 나며 무거운 것이 %PeeProtectType(theCulprit,2)%의 뒤쪽으로 들어오는 것을 느낀다.
			PRINTFORMDW 뒤쪽을 확인하니 당신에게서 나온 것이 아닌 변 같은 것이 느껴진다.
			PRINTFORMDW 그것은 다르게 느껴지며, 당신의 더러운 것보다 훨씬 더 지독하게 냄새난다.
		ELSE
			PRINTFORMDW 번쩍, 당신은 따뜻하고 축축한 무언가가 %PeeProtectType(theCulprit,2)%를 적시는 것을 느낀다.
			PRINTFORMDW 당신은 잠시 가랑이를 만져보는데, 그것은 당신에게서 나온 소변 같지 않다.
			PRINTFORMDW 그것은 다르고, 평소의 축축함보다 훨씬 더 역겹게 냄새난다.
		ENDIF
		PRINTFORMDW 누군가 당신의 %PeeProtectType(MASTER,2)%를 변기로 사용했을 것이다.
	ELSEIF theVictim != -1
		IF HasScat
			PRINTFORMDW 섬광처럼, %CALLNAME:theVictim%은 %HIS_HER(theVictim)%의 뒤쪽에서 이상한 느낌을 감지한다 %PeeProtectType(theVictim,1)%.
			PRINTFORMDW 뒤를 확인해 보니, 그 것은 %HIM_HER(theVictim)%에게서 나온 것이 아닌 것 같다.
			PRINTFORMDW 그것은 다르게 느껴지고, %HIS_HER(theVictim)%의 흔적보다 훨씬 더 지독하다.
		ELSE
			PRINTFORMDW 섬광처럼, %CALLNAME:theVictim%은 당신의 %PeeProtectType(theCulprit,2)%에 이상한 축축함을 알아챈다.
			PRINTFORMDW 잠시 %HIS_HER(theVictim)%의 사타구니를 확인해 보니, 그 오줌이 %HIM_HER(theVictim)%에게서 온 것 같지 않다..
			PRINTFORMDW 느낌이 다르고, %HIS_HER(theVictim)% 특유의 사고보다 훨씬 더 지독하게 냄새난다.
		ENDIF
		PRINTFORMDW %CALLNAME:theVictim%는 누군가 %HIS_HER(theVictim)%%PeeProtectType(MASTER,2)%을 화장실로 사용했을 거라고 생각하며 수치심에 얼굴을 붉혔다.
	ELSE
		PRINTFORMW 섬광이 지나간 뒤 %CALLNAME:theCulprit%의 요의는 사라졌지만, 갓 나온 \@ HasPiss ? 소변 # \@\@ HasPiss&&HasScat ? 과 # \@\@ HasScat ? 대변 # \@의 모습과 냄새가 공기를 가득 채운다.
		PRINTFORMW %HE_SHE(theCulprit,1)%는 억지로 표정을 유지하려 애쓰며 당신을 바라보지만, 얼굴이 새빨갛게 달아오른다.
		CALL TOILETING_END(theCulprit,HasPiss,HasScat,1)
	ENDIF
	IF theVictim != -1
		SIF HasPiss
			CALLF MessUndies(theVictim, "liquid", 0, BASE:theCulprit:4)
		SIF HasScat
			CALLF MessUndies(theVictim, "solid", 0, BASE:theCulprit:17)
		CALL OMORASHI_END(theCulprit, HasPiss, HasScat, 1, 1, 1)
	ENDIF
ENDIF
