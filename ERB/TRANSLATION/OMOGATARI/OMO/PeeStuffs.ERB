	SELECTCASE RAND:5
		CASE 0
			PRINTFORMW %조사처리(CALLNAME:ARG,"의")%은/는 %FSYN("belly")%가 화장실로 달려가는 동안 %CALLNAME:ARG%이 고통스럽게 경련한다.
