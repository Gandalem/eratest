;-------------------------------------------------
; PeeBar
; Visual pee bars
;
; ARGS: ARG (Target, required), LENGTH, ARG:1 (ignore incon and can't pee), ARG:2 (show name)
;-------------------------------------------------

@PeeBar(ARG, LENGTH = 10, ARG:1, ARG:2)
#DIM LENGTH, 5
IF ARG:2 == 1
	PRINTFORM %"PEE ("+CALLNAME:ARG+")", 12%
ELSEIF ARG:2 == 2
	PRINTFORM 소변
ELSE
	PRINTFORM %"PEE", 4%
ENDIF
IF ((PeeHold:ARG:0 >= 6 && !TALENT:MASTER:LogicBreaker)) && !ARG:1
	SETCOLOR EnduranceColors(PeeHold:ARG:2)
	IF PeeHold:ARG:0 >= 6
		IF ARG:2 == 2
			CALL PRINT_RAINBOW(@"%"Unable",17,LEFT%")
		ELSE
			CALL PRINT_RAINBOW(@"%GET_TALENTNAME_TR(1514, TALENT:ARG:57),LENGTH*2+1,LEFT%")
		ENDIF
	ELSE
		PRINTFORM %GET_TALENTNAME_TR(1514, TALENT:ARG:57, ARG),LENGTH*2+1,LEFT%
	ENDIF
	RESETCOLOR
ELSEIF MAXBASE:ARG:尿意 <= 0
	SETCOLOR C_D_RED
	PRINTFORM %"방광 용량이 0입니다!! 반드시 보고해 주세요!!",LENGTH*2+1,LEFT%
	RESETCOLOR
ELSE
	CALL PRINT_COLORBAR(BASE:ARG:尿意, MAXBASE:ARG:尿意, LENGTH, UNICODE(0x2585), UNICODE(0x2585), PeeColor_C(ARG), RESULT:1)
	SETCOLOR EnduranceColors(PeeHold:ARG:2)
	IF ARG:2 == 2
		IF PeeHold:ARG:0 >= 6
			CALL PRINT_RAINBOW(@"({BASE:ARG:4, 5})")
		ELSE
			PRINTFORM ({BASE:ARG:4, 5})
		ENDIF
	ELSE
		IF PeeHold:ARG:0 >= 6
			CALL PRINT_RAINBOW(@" ({BASE:ARG:尿意,4}/{GetMaxBladder(ARG),4} ({MAXBASE:ARG:尿意,4}ml)) ")
		ELSE
			PRINTFORM  ({BASE:ARG:尿意,4}/{GetMaxBladder(ARG),4} ({MAXBASE:ARG:尿意,4}ml))
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF

