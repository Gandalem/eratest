@CombatLeakOnHit(ARG,nDMG,forDreamUse=0)
#DIM nDMG ; damage
#DIM nWetAt ;% damage to leak
#DIM nLeakAt ;% damage to wet
#DIM nWetting ;touhou is wetting
#DIM nLeakAmount, 2 ;amount leaked
#DIMS nLeakText
#DIM nThreaholdsABS,2
#DIM nDespLevel
#DIM forDreamUse
VARSET nWetting
VARSET nLeakAmount
VARSET nLeakText
REPEAT 2
SELECTCASE COUNT
	CASE 0
		;pee
		;can leak pee, so set leak and wet thresholds here
		nDespLevel = PeeBarStage(ARG)
		SELECTCASE nDespLevel
			CASE IS < 2
				;don't need to go
				CONTINUE
			CASE 2
				nLeakAt = 80
				nWetAt = 1000 ;can't lose control until desperate
			CASE 3
				nLeakAt = 70
				nWetAt = 1000 ;can't lose control until desperate
			CASE 4
				nLeakAt = 50
				nWetAt = 90 ;can't lose control until desperate
			CASE 5
				nLeakAt = 30
				nWetAt = 75 ;can't lose control until desperate
			CASE 6
				;already leaking, so no damage needed.
				nLeakAt = 0
				nWetAt = 40
			CASE IS >= 7
				;wetting!!!!!
				nLeakAt = 0
				nWetAt = 0
		ENDSELECT
	CASE 1
		;poo
		nDespLevel = PooBarStage(ARG)
		SELECTCASE nDespLevel
			CASE IS < 2
				;don't need to go
				CONTINUE
			CASE 2
				nWetAt = 90
				nLeakAt = 65
			CASE 3
				nWetAt = 75
				nLeakAt = 45
			CASE 4
				nWetAt = 60
				nLeakAt = 30
			CASE 5
				nWetAt = 45
				nLeakAt = 10
			CASE 6
				nWetAt = 25
				nLeakAt = 0
			CASE IS >= 7
				;messing!!!!!
				nWetAt = 0
		ENDSELECT
ENDSELECT
nThreaholdsABS:0 = (MAXBASE:ARG:0-500)*nWetAt/100
nThreaholdsABS:1 = (MAXBASE:ARG:0-500)*nLeakAt/100
;;#;PRINTFORML {ARG} %NAME:ARG% (\@ COUNT ? Poop # Pee\@ Desp {nDespLevel}): Damage {nDmg}, Wet {nThreaholdsABS:0}, Leak {nThreaholdsABS:1}
IF nDMG >= nThreaholdsABS:0 && !GETBIT(YoujutsuEffects:ARG:18,34)
	;instantly WET or MESS
	SETBIT nWetting, COUNT
	CONTINUE
ELSEIF nDMG < nThreaholdsABS:1
	;check if damage if high enough
	CONTINUE
ENDIF
;leak
;aprox: 2ml/1% damage, add regular spurts as well if leaking
nLeakAmount:COUNT = GetPercent(nDMG-(nThreaholdsABS:1),MAXBASE:ARG:0-500)*2
SIF PeeBarStage(ARG) >= 6 && !COUNT
	nLeakAmount:COUNT += 10
REND
IF nWetting && !GETBIT(YoujutsuEffects:ARG:18,34)
	SIF forDreamUse
		RETURN -1
	CALL AIB_INIT(ARG)
ELSEIF nLeakAmount:0 || nLeakAmount:1
	SETCOLOR C_RED
	nLeakText '= @"%PARSE("You leak",,,ARG)%이(가) %PeeAndPoo(nLeakAmount:0,nLeakAmount:1,@"{nLeakAmount:0}ml",@"{nLeakAmount:1}g")%로 %조사처리(CALLNAME:ARG,"의")%에 %PeeProtectType(ARG,1)%한다."
	CALL LC_PRINT(nLeakText, , 1,)
	RESETCOLOR
	SKIPDISP 1
	CALLF MessUndies(ARG, "liquid", 0, nLeakAmount:0)
	CALLF MessUndies(ARG, "solid", 0, nLeakAmount:1)
	BASE:ARG:4 -= nLeakAmount:0
	BASE:ARG:17 -= nLeakAmount:0
	SKIPDISP 0
ENDIF

