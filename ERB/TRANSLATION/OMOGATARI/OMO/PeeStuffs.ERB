		ELSE
			PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 힘을 주어 방귀마저 나오지 않도록 붙잡는다.
			BASE:ARG:Poo -= 3
		ENDIF
		SIF PALAM:ARG:苦痛 < 40000
			PALAM:ARG:苦痛 += 10000
		PooHoldExp:ARG:0 += 3
	ELSEIF PooBarStage == 4
		$PooDesperate
		CALL POOSOUNDS("hs")
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 복통이 배를 움켜쥐자 %조사처리(CALLNAME:ARG,"는")% 엉덩이 뒤로 두 손을 모은다.
			CASE 1
				PRINTFORMW 배가 요란하게 울리며 지금 당장 배변해야 한다고 경고한다.
			CASE 2
				PRINTFORMW 배 속의 통증이 점점 심해지며 갑작스러운 배변 욕구가 몰려온다.
		ENDSELECT
		SIF PALAM:ARG:苦痛 < 20000
			PALAM:ARG:苦痛 += 1000
		PooHoldExp:ARG:0 += 2
	ELSEIF PooBarStage == 3
		$PooSquirm
		CALL POOSOUNDS("s")
		SELECTCASE RAND:2
			CASE 0
				PRINTFORMW 배가 경련하며 이제 화장실에 가야 한다고 신호를 보낸다.
			CASE 1
				PRINTFORMW %조사처리(CALLNAME:ARG,"의")%%FSYN("belly")%는 배변 욕구 때문에 %조사처리(CALLNAME:ARG,"의")%에서 공격적으로 으르렁거린다.
		ENDSELECT
		PooHoldExp:ARG:0 += 1
	ELSEIF PooBarStage == 2
		$PooNotice
		PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 배가 살살 아프기 시작하는 것을 느낀다.
	ENDIF
	$SkipToPee
	SIF !GETBIT(nPee,1)
		GOTO SkipToEnd
	;store linecount
	NFP_KOJO:0 = LINECOUNT
	SIF PeeBarStage < 7 && !NFP_KOJO:1
		CALL KOJO_MESSAGE_SEND("EVENT",ACCIDENT_EV_KOJO_BLADDER,ARG,PeeBarStage,0)
	SIF LINECOUNT != NFP_KOJO:0
		NFP_KOJO:1 = 1
	IF PeeBarStage == 10
		$SevereRupture
	ELSEIF PeeBarStage == 9
		$LightRupture
	ELSEIF PeeBarStage == 8
		$Wetting
		IF GETBIT(YoujutsuEffects:ARG:18,34)
			PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 방광에 힘을 주어 소변을 보려 하지만 아무것도 나오지 않는다...
			SIF PALAM:ARG:苦痛 < 80000
				PALAM:ARG:苦痛 += 10000
			RETURN 1
		ENDIF
		SIF PooBarStage(ARG) >= 4
			LOCAL:1 = 1
		CALL ImminentAccident(ARG,1,LOCAL:1)
		RETURN 1
	ELSEIF PeeBarStage == 7
		GOTO Wetting
	ELSEIF PeeBarStage == 6
		$Leaking
		CALL PEESOUNDS("l")
		SELECTCASE RAND:5
			CASE 0
				PRINTFORMW 「\@ ARG == MASTER ? 당신의 # %CALLNAME:ARG%'의 방광이 스스로 비우려고 애쓰면서 해방을 갈망하며 비명을 질렀다. \@」
			CASE 1
				PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 방광이 고통스럽게 경련하며 새기 시작하자 몸을 숙이고, 화장실에 갈 시간을 조금이라도 벌려 애쓴다...
			CASE 2
				PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ %PeeProtectType(ARG)% 앞쪽을 움켜쥔 채, 화장실이 급한 아이처럼 발을 동동 구른다...
			CASE 3
				PRINTFORMW 급한 욕구를 견디며 \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 아이처럼 발을 동동 구른다.
				PRINTFORMW 눈을 질끈 감고 이를 악문 채, 화장실에 갈 시간을 단 1분이라도 더 벌려고 필사적으로 버틴다...
			CASE 4
				PRINTFORMW 방광의 압박감이 견딜 수 없을 만큼 커지자 %조사처리(CALLNAME:ARG,"는")% 점점 더 초조해진다.
				PRINTFORMW 절망이 %조사처리(CALLNAME:ARG,"의")%의 마음을 즐거움으로 채운다.
		ENDSELECT
		CALL PEESOUNDS("s")
		IF RAND(100) > (10*PeeHold:ARG:0)
			IF ARG == MASTER
				PRINTFORML 만약 당신 스스로를 붙잡지 못한다면... 당신은 스스로를 %FSYN("pee")%하게 될 것이다...
				CALL ASK_M( "견딘다(50 ENE)",BASE:ARG:気力 >= 50, "참는다(200 ENE)",BASE:ARG:気力 >= 200, "긴장을 풀라",1)
				SELECTCASE RESULT
					CASE 0
						$Gaman
						DOWNBASE:ARG:気力 += 50
						BASE:ARG:尿意 += 25
						CALL PEESOUNDS("hs")
						IF !RAND:2
							PRINTFORMW 통제를 벗어난 소변이 금방이라도 새어 나올 듯한 감각이 밀려온다...
							PRINTFORMW 끝났다......
							IF RAND(100) <= (10*PeeHold:ARG:2) && PeeHold:ARG:2 >= 2
								PRINTFORMW 아니면 그것일까...
								CALL PEESOUNDS("hs")
								PRINTFORMW 기적적으로 또 한 번의 분출을 간신히 참아 냈다.
								PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 반드시 지금 화장실에 가야 한다. 그렇지 않으면 %PeeProtectType(ARG,1)% 안에서 실수하고 말 것이다.
								DiapeCharges:ARG:0 -= 50
								BASE:ARG:尿意 -= 50
							ELSE
								GOTO Wetting
							ENDIF
						ELSE
							PRINTFORMW \@ ARG == MASTER ? 당신 # %HE_SHE(ARG,1)% \@ 는 한 번 분출했을 뿐이다.
							PRINTFORMW 하지만 \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 반드시 서둘러 화장실에 가야 한다.
							DiapeCharges:ARG:0 -= 10
							BASE:ARG:尿意 -= 10
						ENDIF
					CASE 1
						PRINTFORMW 당신은 미친 듯이 소변을 참아 낸다.
						DOWNBASE:MASTER:気力 += 200
					CASE 2
						GOTO Wetting
				ENDSELECT
			ELSE
				GOTO Gaman
			ENDIF
		ENDIF
		DiapeCharges:ARG:0 -= 10
		SIF PALAM:ARG:苦痛 < 4
			PALAM:ARG:苦痛 += 1
		PeeHoldExp:ARG:0 -= 1
	ELSEIF PeeBarStage == 5
		$Bursting
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 새지 않으려 필사적으로 몸을 꼬며 완벽한 소변 춤을 춘다.
			CASE 1
				PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 금방이라도 %PeeProtectType(ARG,1)% 안에 새어 버릴 것 같다.
			CASE 2
				PRINTFORMW %CALLNAME:ARG%더 이상 버티기 힘들다!
			CASE 3
				PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 안절부절못하며 몸을 뒤척인다. 방광은 금방이라도 터질 듯하다.
		ENDSELECT
		SIF PALAM:ARG:苦痛 < 4
			PALAM:ARG:苦痛 += 1
		PeeHoldExp:ARG:0 += 3
	ELSEIF PeeBarStage == 4
		$Desperate
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 두 다리를 꼭 모으고 실수하지 않으려 필사적으로 버틴다.
			CASE 1
				PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 방광이 더는 오래 버티지 못할 것 같다고 느낀다.
			CASE 2
				PRINTFORMW 갑작스럽고 거센 요의가 몰려오자 \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 곧바로 소변 춤을 추기 시작한다.
		ENDSELECT
		SIF PALAM:ARG:苦痛 < 2
			PALAM:ARG:苦痛 += 1
		PeeHoldExp:ARG:0 += 2
	ELSEIF PeeBarStage == 3
		$Squirming
		SELECTCASE RAND:4
			CASE 0
				PRINTFORMW 방광이 부풀어 오르면서 서서히 압박감이 느껴지기 시작한다.
			CASE 1
				PRINTFORMW 방광 안의 압박감이 눈에 띄게 강해진다.
			CASE 2
				PRINTFORMW %조사처리(CALLNAME:ARG,"의")%의 방광에 압력이 강하게 증가한다.
		ENDSELECT
		PeeHoldExp:ARG:0 ++
	ELSEIF PeeBarStage == 2
		$Noticeable
		PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 슬슬 소변을 볼 수 있을 것 같은 느낌이 든다.
	ELSEIF PeeBarStage == 1
		;incon stuffs.
		IF PeeHold:ARG:0 <= -3
			IF RAND:4
				SELECTCASE RAND:10
					CASE 0, 1
					CASE 2, 3
						CALL PEESOUNDS("l")
						PRINTFORMW \@ ARG == MASTER ? 당신의 # %조사처리(CALLNAME:ARG,"의")% \@ 방광에서는 가는 소변 방울이 이동하는 곳마다 뚝뚝 떨어진다...
					CASE 4, 5
						CALL PEESOUNDS("l")
						PRINTFORMW %CAPITALIZE(FSYN("pee:n"))% ~에서 흘러내린다 \@ ARG == MASTER ? 당신의 # %HIS_HER(ARG)% \@ %FSYN("crotch")% 무의식적으로...
					CASE 6, 7
						CALL PEESOUNDS("s")
						PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 딱히 소변이 마렵지 않지만, 방광은 제멋대로 새기 시작한다...
					CASE 8
						PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 방광 안에서 묘한 감각을 느낀다...
						GOTO Leaking
					CASE 9
						PRINTFORMW 「\@ ARG == MASTER ? 당신의 # %CALLNAME:ARG%의 \@ 방광이 움찔거린다...」
						GOTO Wetting
				ENDSELECT
			ENDIF
		ENDIF
	ENDIF
ELSE
	IF PeeBarStage >= 6 && GETBIT(nPee,1)
		SIF PooBarStage >= 4 * !(AnalObstructed(ARG))
			LOCAL:1 = 1
		CALL UFUFU_OMORASHI(ARG, 1, LOCAL:1)
		RETURN 1
	ELSEIF PeeBarStage >= 2 && PeeHold:ARG:2 <= -3 && !RAND:2
		PRINTFORML %CALLNAME:ARG%가 소변을 조금 새긴다...
		CALLF MessUndies(ARG, "liquid", 0, 10)
	ENDIF
	IF PooBarStage >= 6 && GETBIT(nScat,2)
		SIF PooBarStage >= 2 * !(AnalObstructed(ARG))
			LOCAL:1 = 1
		CALL UFUFU_OMORASHI(ARG, LOCAL:1, 1)
		RETURN 1
	ENDIF
	$SkipToEnd
	;prevent negative stats during sex
	SIF BASE:ARG:尿意 < 0
		BASE:ARG:尿意 = 0
	SIF BASE:ARG:Poo < 0
		BASE:ARG:Poo = 0
ENDIF
RETURN 1
