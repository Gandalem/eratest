		IF IsPadded(ARG)
			PRINTFORM \@ DiapeCharges:ARG:0 !=  DiapeCharges:ARG:1 ? 그것이 이미 차 있는 불어터진 소변과 합쳐져 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG)%를 가득 채우고, %CALLNAME:ARG%가 %조사처리(CALLNAME:ARG,"의")% 다리를 닫는 것이 불가능해진다 #  \@.
			PRINTFORM %조사처리(CALLNAME:ARG,"는")% 움직일 때마다 부푼 패딩이 음부에 달라붙어 질척이는 감각을 느낀다.
			SIF ACCIDENT_EV_POSITION == "facesiting over"
				PRINTFORML , 그리고 숨을 쉬기 위해 몸부림치는 %CALLNAME:ACCIDENT_EV_CHARA_TARGET%의 울음소리도 있었다.
			SIF ARG == MASTER
				PRINTFORM 그리고
		ELSEIF ACCIDENT_EV_POSITION == "facesiting over"
			PRINTFORML \@ EQUIP:ARG:6 ? %PeeProtectType(ARG)%을 범람시키며 # 그대로 \@ %조사처리(CALLNAME:ACCIDENT_EV_CHARA_TARGET,"의")% 얼굴에 소변을 퍼붓는다.
			SIF ACCIDENT_EV_POSITION == "facesiting over"
				PRINTFORML \@ ACCIDENT_EV_CHARA_TARGET == MASTER ? 너는 오줌 웅덩이 속에서 숨을 쉬기 위해 몸부림치는 것을 느낀다. # 들을 수 있다 %CALLNAME:ACCIDENT_EV_CHARA_TARGET% 신선한 공기를 찾으려고 애쓰는 %URINE(ACCIDENT_EV_CHARA_TARGET)% ~로 흘러들어 가다 %HIS_HER(ACCIDENT_EV_CHARA_TARGET)% 목구멍에 \@
			IF EQUIP:ARG:6
				PRINTFORM %조사처리(CALLNAME:ARG,"는")% 움직일 때마다 미끄럽고 축축한 천이 %PRINT_CLIT(ARG)%에 달라붙어 질척이는 감각을 느낀다.
				SIF ARG == MASTER
					PRINTFORM 그리고
			ELSE
				SIF ARG == MASTER
				PRINTFORM 그것은
			ENDIF
		ELSE
			PRINTFORML \@ EQUIP:ARG:6 ? %PeeProtectType(ARG)%을 넘치게 하고 # 바닥에 큰 웅덩이를 만들고 \@ 말았다.
			IF EQUIP:ARG:6
				PRINTFORM %조사처리(CALLNAME:ARG,"는")% 움직일 때마다 축축한 천이 %PRINT_CLIT(ARG)%에 달라붙어 질척이는 감각을 느낀다.
				SIF ARG == MASTER
					PRINTFORM 그리고
			ELSE
				SIF ARG == MASTER
				PRINTFORM 그것은
			ENDIF
		ENDIF
	CASE IS <= 10
		PRINTFORML %조사처리(CALLNAME:ARG,"의")%무거운 물결이 %조사처리(CALLNAME:ARG,"의")% 앞에서 빠져나오도록 힘을 가하기 시작하면서 요도가 크게 벌어진다.
		IF IsPadded(ARG)
			PRINTFORML %CALLNAME:ARG%은 거대한 양의 %URINE(ARG)%가 계속해서 뿜어져 나오며 %조사처리(CALLNAME:ARG,"의")%의 방광을 비우는 동시에 %조사처리(CALLNAME:ARG,"의")%의 %PeeProtectType(ARG,1)%를 채워나가는 소리인 %조사처리(CALLNAME:ARG,"의")%와 %PeeProtectType(ARG)%의 쉬익거림을 느낀다.
			PRINTFORML 너무 많은 것들이 있어서 %URINE(ARG)% 끼어들어야만 한다 %조사처리(CALLNAME:ARG,"의")% 허벅지 사이로 비집고 뒤쪽으로 스며들다 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG,1)%.
			;%CALLNAME:ARG%
			IF !DiapeStand
				PRINTFORML 이토록 큰 홍수를 막지 못하니 당신의 %조사처리(CALLNAME:ARG,"의")% %URINE()%가 %PeeProtectType(ARG,1)%에서 일부 새어 나와 물웅덩이를 형성했다.
			ELSE
			PRINTFORML %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG)%은 어떻게든 엄청난 양의 소변을 받아 냈다\@ DiapeCharges:ARG:0 != DiapeCharges:ARG:1 ? . 이미 젖은 패딩에는 소변이 한층 더 고였다 # \@.
			ENDIF
			SIF ARG == MASTER
			PRINTFORM 그것은
		ELSEIF ACCIDENT_EV_POSITION == "facesiting over"
			PRINTFORML %CALLNAME:ACCIDENT_EV_CHARA_TARGET%은(는) 거대한 양의 %URINE(ARG)%이 계속해서 꿈틀거리며 %조사처리(CALLNAME:ARG,"의")%의 방광을 비우지만, 동시에 %조사처리(CALLNAME:ACCIDENT_EV_CHARA_TARGET,"의")%의 입과 코를 채우고 물웅덩이를 만드는 동안 %조사처리(CALLNAME:ACCIDENT_EV_CHARA_TARGET,"의")%의 얼굴이 튀고 튀는 것을 느낀다.
			SIF ARG == MASTER
			PRINTFORM 그것은
		ELSE
			PRINTFORML %조사처리(CALLNAME:ARG,"는")% 거대한 양의 %URINE(ARG)%이 방광에서 빠져나와 큰 웅덩이를 만드는 동안 %PeeProtectType(ARG)%이 세차게 쉬익거리는 것을 느낀다.
			SIF ARG == MASTER
			PRINTFORM 그것은
		ENDIF
	CASE IS <= 15
		PRINTFORMW 당신이 들어본 가장 품위 없는 소리와 함께, %조사처리(CALLNAME:ARG,"의")% 과도하게 찬 방광이 비워지기 시작한다.
		IF IsPadded(ARG)
			PRINTFORMW %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG)% 급격히 바깥쪽으로 팽창하며 모든 방향에서 압박을 받는다 %URINE(ARG)% 나와 나오도록 강요하는 %조사처리(CALLNAME:ARG,"의")% 요도에서
			PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 홍수처럼 쏟아지는 소변을 도저히 멈출 수 없다. 한 방울이 더해질 때마다 받아 낼 자리도 줄어든다.
			PRINTFORMW 곧 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG)% 는 이전 크기의 거의 두 배가 되어 압력에 힘을 주며 %조사처리(CALLNAME:ARG,"의")% %URINE(ARG)% 자신을 사이에 끼우다 %조사처리(CALLNAME:ARG,"의")% 다리 사이로 그리고 뒷부분으로 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG,1)%그쪽도 가득 채우며
			PRINTFORML 완전히 충격을 받은 채 %CALLNAME:ARG% 떨고 신음하며 누르기밖에 할 수 없다 %조사처리(CALLNAME:ARG,"의")% 손을 대다 %조사처리(CALLNAME:ARG,"의")% 패딩을 대고 가장 큰 오줌의 %조사처리(CALLNAME:ARG,"의")% 삶이 계속된다.
			PRINTFORMW %URINE(ARG,1)% 뒤따라 빠르게 움직이는 %조사처리(CALLNAME:ARG,"의")% 거대하고 흡수되지 않은 웅덩이, 그것을 위해 남겨진 소량의 마른 패딩을 빨아들이며.
			IF !DiapeStand
				PRINTFORML 이 많은 소변을 참을 수 없자, 당신의 %PeeProtectType(ARG,1)%에서 %조사처리(CALLNAME:ARG,"의")%%URINE()%가 새기 시작하며 한 웅덩이를 형성했다.
			ENDIF
		ELSE
			SIF ACCIDENT_EV_POSITION == "facesiting over"
