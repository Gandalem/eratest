;-------------------------------------------------
; URINE
; Describes urine much like how SEMEN() does
; ARG for target to get pee concentration
; ARG:1 for additional description
; ARG:2 for capitalization
;-------------------------------------------------
@URINE(ARG,ARG:1,ARG:2)
#FUNCTIONS
LOCALS = 
IF ARG:1
	SELECTCASE RAND:26
		CASE 1 TO 5
			LOCALS += "warm"
		CASE 6 TO 11
			LOCALS += "hot"
		CASE 12 TO 16
			LOCALS += "fluid"
		CASE 16 TO 19
			LOCALS += "thin"
		CASEELSE
	ENDSELECT
    ;putting a space
	SIF LOCALS != ""
		LOCALS += " "
	LOCALS += @"%PeeColor(ARG)%"    

	;putting a space
	SIF LOCALS != ""
		LOCALS += " "
	IF ARG >= 0
		SIF TALENT:ARG:0 && !RAND:3
			LOCALS = %SPLIT_G("virgin ")%
	ENDIF
ENDIF

IF !RAND:10
    SELECTCASE TCVAR:ARG:PeeConcentration
    CASE 0
    LOCALS += @"%SPLIT_G(@"water:liquid silver:overhydrated %FSYN("pee:n")%")%"
    CASE 4 TO 6
    LOCALS += @"%SPLIT_G(@"liquid amber:precious %FSYN("pee:n")%")%"
    CASE 7 TO 10
    LOCALS += @"%SPLIT_G(@"murky water:concentrated %FSYN("pee:n")%")%"
    CASE 11
    LOCALS += @"%SPLIT_G(@"liquid topaz:orange %FSYN("pee:n")%")%"
    CASE 12, 13
    LOCALS += @"%SPLIT_G(@"bloody water:forbidden blood")%"
    CASEELSE
    LOCALS += @"%SPLIT_G(@"liquid gold")%"
    ENDSELECT
ELSE
LOCALS += @"%FSYN("pee:n")%"
ENDIF

IF !ARG:2
	RETURNF LOCALS
ELSE
	RETURNF CAPITALIZE(LOCALS)
ENDIF

;-------------------------------------------------
; SCAT
; Describes scat much like how SEMEN() does
; ARG for target to get poo shape
; ARG:1 for additional description
; ARG:2 for capitalization
;-------------------------------------------------
@SCAT(ARG,ARG:1,ARG:2)
#FUNCTIONS
LOCALS = 
IF ARG:1
    IF TCVAR:ARG:BowelState > 0
        SELECTCASE RAND:3
        CASE 0
        LOCALS += "liquidy"
        CASE 1
        LOCALS += "viscious fluid of"
        CASE 2
        LOCALS += "free flowing"
        ENDSELECT
    ELSE   
        IF TCVAR:ARG:PooShape == 1
        LOCALS += "hard"
        ELSE
            SELECTCASE RAND:3
            CASE 0
            LOCALS += "soft"
            CASE 1
            LOCALS += "mushy"
            CASE 2
            LOCALS += "warm"
            ENDSELECT
            SIF PooBarStage(ARG) > 4 && !RAND:3
            LOCALS += " and thick"

        ENDIF
    ENDIF
	;putting a space
	SIF LOCALS != ""
		LOCALS += " "
ENDIF

IF !RAND:10
    SELECTCASE TCVAR:ARG:PooShape
    CASE -4
    LOCALS += @"%SPLIT_G(@"enema fluid:anal pee:murky water")%"
    CASE 0
    SIF !RAND:3 && ARG:1
    LOCALS += " log of"
    LOCALS += @"%SPLIT_G(@"water:liquid silver:overhydrated %FSYN("pee:n")%")%"
    CASE 4
    LOCALS += @"%SPLIT_G(@"rock solid %FSYN("poo:n")%")%"
    ENDSELECT
ELSE
	LOCALS += @"%FSYN("poo:n")%"
ENDIF

IF !ARG:2
	RETURNF LOCALS
ELSE
	RETURNF CAPITALIZE(LOCALS)
ENDIF

