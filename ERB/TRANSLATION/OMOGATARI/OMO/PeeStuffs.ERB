@PeePeeDescribe(ARG,DiapeStand)
#DIM DiapeStand
#DIMS DYNAMIC nEndingPlace
; ACCIDENT_EV_POSITION
; ACCIDENT_EV_CHARA_TARGET
SELECTCASE BASE:ARG:4/100
	CASE IS <= 3
		LOCALS:0 =
		IF IsPadded(ARG)
			LOCALS:0 '= @"안으로 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG)%"
		ELSEIF ACCIDENT_EV_POSITION == "facesiting over"
			LOCALS:0 '= @"직접적으로 %조사처리(CALLNAME:ACCIDENT_EV_CHARA_TARGET,"의")% 코와 입으로"
		ELSE
			LOCALS:0 '= @"바닥 위로"
		ENDIF
		PRINTFORMW 소량의 %URINE(ARG)%이 %조사처리(CALLNAME:ARG,"의")% 요도를 통해 빠져나와 %LOCALS:0%으로 나간다.
		IF ARG == MASTER
			IF DiapePooCharges:ARG:0 !=  DiapePooCharges:ARG:1
				PRINTFORM 합쳐진 축축함
