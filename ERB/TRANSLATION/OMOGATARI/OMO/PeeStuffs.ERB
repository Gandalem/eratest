;-------------------------------------------------
; URINE
; Describes urine much like how SEMEN() does
; ARG for target to get pee concentration
; ARG:1 for additional description
; ARG:2 for capitalization
;-------------------------------------------------

@URINE(ARG,ARG:1,ARG:2)
#FUNCTIONS
LOCALS =
IF ARG:1
	SELECTCASE RAND:26
		CASE 1 TO 5
			LOCALS += "따뜻한"
		CASE 6 TO 11
			LOCALS += "뜨거운"
		CASE 12 TO 16
			LOCALS += "묽은"
		CASE 16 TO 19
			LOCALS += "옅은"
		CASEELSE
	ENDSELECT
	;putting a space
	SIF LOCALS != ""
		LOCALS += " "
	LOCALS += @"%PeeColor(ARG)%"
	;putting a space
	SIF LOCALS != ""
		LOCALS += " "
	IF ARG >= 0
		SIF TALENT:ARG:0 && !RAND:3
			LOCALS = %SPLIT_G("처녀의 ")%
	ENDIF
ENDIF
IF !RAND:10
	SELECTCASE TCVAR:ARG:PeeConcentration
		CASE 0
			LOCALS += @"%SPLIT_G(@"물:은빛 액체:수분이 넘치는 %FSYN("pee:n")%")%"
		CASE 4 TO 6
			LOCALS += @"%SPLIT_G(@"액체 호박:귀중한 %FSYN("pee:n")%")%"
		CASE 7 TO 10
			LOCALS += @"%SPLIT_G(@"탁한 물:농축된 %FSYN("pee:n")%")%"
		CASE 11
			LOCALS += @"%SPLIT_G(@"액체 토파즈:주황빛 %FSYN("pee:n")%")%"
		CASE 12, 13
			LOCALS += @"%SPLIT_G(@"피 섞인 물:금단의 피")%"
		CASEELSE
			LOCALS += @"%SPLIT_G(@"액체 황금")%"
	ENDSELECT
ELSE
	LOCALS += @"%FSYN("pee:n")%"
ENDIF
IF !ARG:2
	RETURNF LOCALS
ELSE
	RETURNF CAPITALIZE(LOCALS)
ENDIF
;-------------------------------------------------
; SCAT
; Describes scat much like how SEMEN() does
; ARG for target to get poo shape
; ARG:1 for additional description
; ARG:2 for capitalization
;-------------------------------------------------

@SCAT(ARG,ARG:1,ARG:2)
#FUNCTIONS
LOCALS =
IF ARG:1
	IF TCVAR:ARG:BowelState > 0
		SELECTCASE RAND:3
			CASE 0
				LOCALS += "물 같은"
			CASE 1
				LOCALS += "끈적한 액체 같은"
			CASE 2
				LOCALS += "줄줄 흐르는"
		ENDSELECT
	ELSE
		IF TCVAR:ARG:PooShape == 1
			LOCALS += "단단한"
		ELSE
			SELECTCASE RAND:3
				CASE 0
				LOCALS += "부드러운"
				CASE 1
				LOCALS += "죽 같은"
				CASE 2
				LOCALS += "따뜻한"
			ENDSELECT
			SIF PooBarStage(ARG) > 4 && !RAND:3
				LOCALS += "하고 굵은"
		ENDIF
	ENDIF
	;putting a space
	SIF LOCALS != ""
		LOCALS += " "
ENDIF
IF !RAND:10
	SELECTCASE TCVAR:ARG:PooShape
		CASE -4
			LOCALS += @"%SPLIT_G(@"관장액:항문에서 나온 소변:탁한 물")%"
		CASE 0
			SIF !RAND:3 && ARG:1
				LOCALS += " 통나무 같은"
			LOCALS += @"%SPLIT_G(@"물:은빛 액체:수분이 넘치는 %FSYN("pee:n")%")%"
		CASE 4
			LOCALS += @"%SPLIT_G(@"돌처럼 단단한 %FSYN("poo:n")%")%"
	ENDSELECT
ELSE
	LOCALS += @"%FSYN("poo:n")%"
ENDIF
IF !ARG:2
	RETURNF LOCALS
ELSE
	RETURNF CAPITALIZE(LOCALS)
ENDIF

