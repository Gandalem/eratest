				PRINTFORM 그렇게 많진 않지만 그래도
			ENDIF
		ENDIF
	CASE IS <= 5
		PRINTFORM 적당량의 %URINE(ARG)%이 %조사처리(CALLNAME:ARG,"의")%에서 나온다 \@ HAS_PENIS(ARG) ? %TINKO(ARG)% # %SLIT(ARG)% \@ 그리고
		IF IsPadded(ARG)
			PRINTFORML 「\@ DiapeCharges:ARG:0 !=  DiapeCharges:ARG:1 ? 기존의 부푼 패딩에 합류한다 #  \@%조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG)%를 채운다. %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG,1)%는 이제 눈에 띄게 무거워졌다」
			SIF ACCIDENT_EV_POSITION == "facesiting over"
				PRINTFORML , %조사처리(CALLNAME:ACCIDENT_EV_CHARA_TARGET,"의")%의 얼굴을 향해 확장하면서.
		ELSEIF ACCIDENT_EV_POSITION == "facesiting over"
			PRINTFORM %조사처리(CALLNAME:ACCIDENT_EV_CHARA_TARGET,"의")% 얼굴에 직접적으로, 그것을 %URINE(ARG)%로 적신다.
		ELSE
			PRINTFORM 웅덩이를 만든다.
		ENDIF
		SIF ARG == MASTER
			PRINTFORM 그것은
	CASE IS <= 8
