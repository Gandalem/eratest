			PRINTFORMW 변기에 도착할 무렵에는 더 이상 나올 소변조차 남지 않았다.
		CASE 4
			PRINTFORMW %조사처리(CALLNAME:ARG,"는")% %PeeProtectType(ARG,1)%을 양손으로 붙잡고 방 안을 빠르게 가로지른다.
			PRINTFORMW 화장실에 가까워질수록 차라리 %PeeProtectType(ARG,1)% 안에 소변을 볼까 하는 생각이 고개를 든다.
			PRINTFORMW 빠르게 결정을 내리려 하지만, 몸이 먼저 답을 정해 버린다:
			CALL PlayAccidentSound(MASTER,HasPiss,"loc",HasScat,"loc")
			PRINTFORMW 안도감으로 %조사처리(CALLNAME:ARG,"의")% 정신을 범람시키며, %CALLNAME:ARG% 홍수가 소변으로 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG,1)%를 채운다.
		CASE 5
			PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 가능한 한 빨리 화장실로 향하지만 충분히 빠르지 못하다.
			CALL PlayAccidentSound(MASTER,HasPiss,"loc",HasScat,"loc")
			PRINTFORMW 변기에 닿으려는 순간 수문이 열리고 %PeeProtectType(ARG)%을 흠뻑 적신다.
			PRINTFORMW %CALLNAME:ARG%은 안도의 한숨을 쉰다.
		CASE 6
			PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 더는 참을 수 없다는 것을 느끼고 변기를 향해 몸을 돌린다.
			CALL PEESOUNDS("l")
			PRINTFORMW 걸음을 옮길 때마다 몇 방울씩 새어 나온다...
			CALL PlayAccidentSound(MASTER,HasPiss,"s")
			PRINTFORMW 그러더니 분수처럼 뿜어냈다...
			CALL PlayAccidentSound(MASTER,HasPiss,"hs")
			PRINTFORMW 그러자 작은 물줄기가 나온다.
			PRINTFORMW 필사적으로 변기에 뛰어오르는 순간 수문이 열려 %PeeProtectType(ARG)% 안으로 홍수가 터져 나온다.
			CALL PlayAccidentSound(MASTER,HasPiss,"loc",HasScat,"loc")
			PRINTFORMW %PeeProtectType(ARG,1)% 안쪽이 점점 따뜻하고 축축해지는 동안, 온몸에 안도감이 밀려온다.
			PRINTFORMW 변기에 앉은 채 스스로를 적시고 있다는 사실을 깨닫자 %조사처리(CALLNAME:ARG,"는")% 당황해 얼굴을 붉힌다.
			PRINTFORMW 어떤 종류의 %TOLOWER(TOSTR_LifeStage(CharaAge:ARG:0))% 벗는 걸 기억 못하는 %PeeProtectType(ARG,1)% 화장실 사용하기 전에
		CASE 7
			PRINTFORMW 갑자기 %PeeProtectType(ARG)% 안에 소변을 쌀 것 같은 강렬한 욕구가 밀려온다.
			PRINTFORMW 지금 당장 가야 한다! %조사처리(CALLNAME:ARG,"는")% 황급히 변기에 앉아 수문을 연다...
			CALL PlayAccidentSound(MASTER,HasPiss,"loc",HasScat,"loc")
			PRINTFORMW 안도의 한숨을 쉬며 %CALLNAME:ARG% 성공했으니 %조사처리(CALLNAME:ARG,"의")% %FSYN("pee:n")% 자유롭게 흘러들기 시작하다 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG,1)%.
		CASE 8
			PRINTFORMW %조사처리(CALLNAME:ARG,"의")% 방광이 알려준다 %CALLNAME:ARG% ~라고 %CALLNAME:ARG% 가야 해, 지금 당장!
			PRINTFORM %조사처리(CALLNAME:ARG,"는")% 변기를 세 걸음 앞에 두고 멈춰 선다. 화장실을 쓴다는 것은
			FONTITALIC
			PRINTFORM 아니
			FONTREGULAR
			PRINTFORML %조사처리(CALLNAME:ARG,"의")%의 바지를 적신다.
			WAIT
			CALL PlayAccidentSound(MASTER,HasPiss,"loc",HasScat,"loc")
			PRINTFORMW 갑작스러운 해방감에 깜짝 놀란 %조사처리(CALLNAME:ARG,"는")% 어린아이처럼 %PeeProtectType(ARG,1)% 안에 방광을 전부 비운다.
		CASE 9
			PRINTFORMW %CALLNAME:ARG%두 손으로 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG)%을 잡고 방 안으로 재빨리 움직였다.
			PRINTFORMW 걸음을 옮길 때마다 더 많은 소변이 새어 나왔다...
			CALL PlayAccidentSound(MASTER,HasPiss,"s")
			PRINTFORMW 안으로...
			CALL PlayAccidentSound(MASTER,HasPiss,"hs")
			PRINTFORMW %조사처리(CALLNAME:ARG,"의")%...
			CALL PlayAccidentSound(MASTER,HasPiss,"loc",HasScat,"loc")
			PRINTFORMW  %PeeProtectType(ARG,1)%....
			PRINTFORMW 막상 변기에 도착하고 나니 이미 요의는 완전히 사라져 있다...
		CASE 10
			PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 최대한 빨리 화장실로 향하지만 충분히 빠르지 못하다.
			PRINTFORMW 변기에 닿으려는 순간 둑이 무너지고...
			CALL PlayAccidentSound(MASTER,HasPiss,"loc",HasScat,"loc")
			PRINTFORMW %PeeProtectType(ARG)%을 흠뻑 적시고 만다...
			PRINTFORMW 안도의 한숨도 잠시, %조사처리(CALLNAME:ARG,"는")% 또 한 번의 사고가 또 한 번의 목욕을 뜻한다는 사실을 깨닫는다.
	ENDSELECT
	SIF ARG:1 != 2
		CALL WetFeelings(ARG)
	PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ \@ HasPiss ? 소변을 # \@\@ HasPiss&&HasScat ? 보고 # \@\@ HasScat ? 배변하는 것을 # \@ 멈추고 자신의 흔적에서 벗어나려 한다.
	CALL OMORASHI_END(ARG,HasPiss,HasScat,,-1,ARG:1)
	RETURN
ENDIF
;-------------------------------------------------
; PlayAccidentSound
; Plays a specific wetting sound
; ARGS: ARG (target), HasPiss, ARGS (type (pee)), HasScat, ARGS:1 (type (poo))
;-------------------------------------------------

@PlayAccidentSound(ARG,HasPiss,ARGS,HasScat,ARGS:1)
#DIM HasPiss
#DIM HasScat
STOPSOUND
IF HasScat
	CALL POOSOUNDS(ARGS, ARG)
	SELECTCASE ARGS:1
		CASE "loc"
			IF IsPadded(ARG)
				PLAYSOUND "peestuffs/poo/messy2.wav"
			ELSE
				PLAYSOUND "peestuffs/poo/messy1.wav"
			ENDIF
	ENDSELECT
ENDIF
IF HasPiss
	CALL PEESOUNDS(ARGS:1, ARG)
	SELECTCASE ARGS
		CASE "loc"
			IF IsPadded(ARG)
				PLAYSOUND "peestuffs/pee/おむつおもらしスタンダード.m4a"
			ELSE
				PLAYSOUND "peestuffs/pee/おもらし1.m4a"
			ENDIF
	ENDSELECT
ENDIF
;-------------------------------------------------
; DRINK
; Increases liquid intake, decreases pee concentartion, and detemrines if a bottle should be given
; ARGS: ARG (target), ARG:1 (amount), ARG:2 (give bottle)
;-------------------------------------------------

@DRINK(ARG, ARG:1, ARG:2)
SIF !GETBIT(nPee, 1)
	RETURN -1
SIF ARG == MASTER
	PLAYSOUND "se/drink02.m4a"
SIF ARG:2
	CALL GET_ITEM("EmptyBottle", 1, 1)
TCVAR:ARG:LiquidIntake += ARG:1
LOCAL = MAX((ARG:1/250)*2,1)
TCVAR:ARG:PeeConcentration -= LOCAL
SIF TCVAR:ARG:PeeConcentration <= 0
	TCVAR:ARG:PeeConcentration = 0
CALL COLORMESSAGE(@"{ARG:1}ml를 마셨다 (%CALLNAME:ARG%) %LOCALS%",C_YELLOW,1)
SIF ARG == MASTER
	BladderDiary += @"%時刻表示(TIME)%이 마신 {ARG:1}ml\n"
CALL INTERACTIVE_TUTORIAL_GET(102,401,"Intake",3)
;-------------------------------------------------
; EAT
; Like DRINK, but for food
; Increases food intake, decreases hunger
; ARGS: ARG (target), ARG:1 (amount), ARG:2 (give bottle)
;-------------------------------------------------

@EAT(ARG, ARG:1, ARG:2)
SIF !GETBIT(nScat, 2)
	RETURN -1
SIF ARG == MASTER
	PLAYSOUND "se/eat02.m4a"
TCVAR:ARG:FoodIntake += ARG:1
CALL COLORMESSAGE(@"먹었다 {ARG:1}g (%CALLNAME:ARG%)%LOCALS%",C_YELLOW,1)
SIF ARG == MASTER
	BladderDiary += @"%時刻表示(TIME)%: {ARG:1}g 먹었다\n"
CALL INTERACTIVE_TUTORIAL_GET(102,401,"Intake",3)

@EffectivePottyLevel(ARG,nHole = 0,nRealCon = 0)
#FUNCTION
#DIM nHole
#DIM nPottyLev
#DIM nCompare,2
#DIM nRealCon
; nCompare:0 = PeeHold:ARG:2 - MAX(TALENT:ARG:BladderSize,0)
; nCompare:1 = PooHold:ARG:2 - MAX(TALENT:ARG:BowelSize,0)
VARSET nCompare, 999
SIF nPee
	nCompare:0 = PeeHold:ARG:2 - TALENT:ARG:BladderSize
SIF nScat
	nCompare:1 = PooHold:ARG:2 - TALENT:ARG:BowelSize
SELECTCASE nHole
	CASE 0
		nPottyLev = MIN(nCompare:0,nCompare:1)
		IF HasIBS(ARG)
			nPottyLev -= 3
		ELSEIF HasOAB(ARG)
			nPottyLev -= 2
		ENDIF
	CASE 1
		nPottyLev = nCompare:0
		IF HasOAB(ARG)
			nPottyLev -= 2
		ENDIF
	CASE 2
		nPottyLev = nCompare:1
		IF HasIBS(ARG) || TALENT:ARG:BlortProne
			nPottyLev -= 3
		ENDIF
ENDSELECT
IF (CapacityStats:ARG:10 == -99 && GROUPMATCH(nHole,0,1)) || (CapacityStats:ARG:11 == -99 && GROUPMATCH(nHole,0,2))
	RETURNF -99
ELSEIF (PeeHold:ARG:2 <= -5 && GROUPMATCH(nHole,0,1)) || (PooHold:ARG:2  <= -5 && GROUPMATCH(nHole,0,2))
	RETURNF -5
ENDIF
;incontinence precept
IF !nRealCon
	IF GET_INT(ARG, "Religion", TALENT:ARG:Religion, "Incontinence") >= 3
		nPottyLev = -5
	ELSE
		nPottyLev -= GET_INT(ARG, "Religion", TALENT:ARG:Religion, "Incontinence")
	ENDIF
ENDIF
;count babies as having regressing bladder
SIF IS_BABY(ARG)
	nPottyLev = -3
RETURNF nPottyLev

@PottyChart
#DIM 予定種別 = 0
#DIM CREDRAW
#DIM FIRST_LINE
#DIM DYNAMIC C_ID
#DIM DYNAMIC YOUBI
#DIMS DYNAMIC curLine
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
;[SKIPSTART]
VARSET LOCAL
YOUBI = DAY % 7
FOR COUNT, 0, 9
LOCAL:COUNT = (DAY:3-YOUBI) + COUNT - 1
LOCAL:(COUNT + 10) = (DAY-YOUBI) + COUNT - 1
IF LOCAL:COUNT > 31
	LOCAL:COUNT -= 31
	LOCAL:(COUNT + 100) = 1
ENDIF
NEXT
curLine '= @"┌─────────%@"%"─"*9%"*7%<br>"
curLine += @"%GET_MAPNAME(MAIN_MAP)% 배변 차트<br>"
curLine += @"┌────────┬%@"%"─"*8%┬"*7%<br>"
curLine += @"이름"
FOR LOCAL, 1, 8
IF LOCAL:LOCAL == DAY
	curLine += @"<font color='#00FF00'>{LOCAL:LOCAL,16}</font>"
ELSE
	curLine += @"{LOCAL:LOCAL,16}"
ENDIF
curLine += "│"
NEXT
curLine += "<br>"
HTML_PRINT curLine
VARSET curLine
FOR C_ID, 0, CHARANUM
;not a resident
SIF CFLAG:C_ID:311 == SUKIMA() || CFLAG:C_ID:311/100 != MAIN_MAP
	CONTINUE
;mob, dead or can't pee
SIF IS_MOB(C_ID) || IsDead:C_ID:0 || (PeeHold:C_ID:0 >= 6 && PooHold:C_ID:0 >= 6)
	CONTINUE
;dry and clean in the last week (and in undies), doesn't need a chart
SIF (DAY - LastAccident:C_ID:0 > 7 || !LastAccident:C_ID:0) && (DAY - LastPooAccident:C_ID:0 > 7 || !LastPooAccident:C_ID:0) && BestUnderwear(C_ID) == "Underwear"
	CONTINUE
curLine '= @"├────────┼%@"%"─"*8%┼"*7%<br>"
curLine += "│"
IF C_ID == MASTER
	SETCOLOR C_AQUA
ENDIF
; Daytime Accidents:
; (1): 15 (10 padded), last Day 21
; (2): 9 (8 padded), last Day 21
; Nighttime Accidents:
; (1): 17 (12 padded), last Day 21
; (2): 14 (12 padded), last Day 21
curLine += MO_TALENT(@"%CALLNAME:C_ID,16,LEFT%", @" \@ nPee ? 소변 참기: %TOSTR_CONTINENCE(PeeHold:C_ID:2)%\n #  \@ \@ nScat ? 푸 홀딩: %TOSTR_CONTINENCE(PooHold:C_ID:2)%\n #  \@ 처벌 포인트: {PunishChange:C_ID:0}\n 마지막 사고 후 경과일: {DAY-LastAccident:C_ID:0}\n 마지막 더러운 사고 후 경과일: {DAY-LastPooAccident:C_ID:0}" )
RESETCOLOR
curLine += "│"
;day and night status
FOR LOCAL, 0, 7
IF LOCAL > YOUBI
	curLine += @"%" "*16%│"
	CONTINUE
ENDIF
curLine += MO_TALENT("Day:", PottyChartLines(C_ID,LOCAL,0))
IF PottyChartStatus:C_ID:(LOCAL)
	;accident
	SIF GETBIT(PottyChartStatus:C_ID:LOCAL,0)
		SETCOLOR C_YELLOW
	SIF GETBIT(PottyChartStatus:C_ID:LOCAL,1)
		CALLF C_JELLYORPOO()
	curLine += MO_TALENT("⚫")
	RESETCOLOR
ELSE
	curLine += MO_TALENT("★")
ENDIF
curLine += MO_TALENT(" Night:", PottyChartLines(C_ID,LOCAL,1))
IF PottyChartNightStatus:C_ID:(LOCAL)
	;accident
	SIF GETBIT(PottyChartNightStatus:C_ID:LOCAL,0)
		SETCOLOR C_YELLOW
	SIF GETBIT(PottyChartNightStatus:C_ID:LOCAL,1)
		CALLF C_JELLYORPOO()
	curLine += MO_TALENT("⚫")
	RESETCOLOR
ELSE
	curLine += MO_TALENT("★")
ENDIF
curLine += " │"
NEXT
HTML_PRINT curLine
VARSET curLine
;line 2
curLine += "│"
IF nOmutsu
	curLine += @"(%BestUnderwear(C_ID),14,LEFT%)"
ELSE
	curLine += @"%" "*16%"
ENDIF
curLine += "│"
;toileting and accident count
FOR LOCAL, 0, 7
IF LOCAL > YOUBI
	curLine += @"%" "*16%│"
	CONTINUE
ENDIF
curLine += MO_TALENT("Toil:")
curLine += @"{PottyChartToileting:C_ID:(LOCAL),2}"
curLine += MO_TALENT(" Acci:")
curLine += @"{PottyChartAccident:C_ID:(LOCAL),2}"
curLine += " │"
NEXT
HTML_PRINT curLine
NEXT
PRINTFORML ├────────┴%@"%"─"*8%┴"*7%
PRINTL [0] - 반환
INPUT
IF RESULT >= 1 && RESULT <= CHARANUM
	GOTO REPRINT
ELSEIF RESULT >= 900 && RESULT <= 901
	;900:お仕事予定(予定=0)
	;901:危険日予定(予定=1)
	予定種別 = RESULT - 900
	GOTO REPRINT
ENDIF
;[SKIPEND]
RETURN

@INTENTIONAL_ACCIDENT_TEXT(ARG,HasPiss,HasScat)
#DIM HasPiss
#DIM HasScat
IF HasScat
	IF ABL:ARG:PooAddict >= 10
		PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 더 이상 장을 붙들고 있을 이유가 없다고 생각한다.
		PRINTFORMW 일을 치르기 전 %PeeProtectType(ARG,1)%을 내려다보며, 늘어난 무게를 새지 않고 받아 주기를 기대한다.
	ELSEIF ABL:ARG:PooAddict >= 5
		PRINTFORMW %조사처리(CALLNAME:ARG,"의")% 배가 꾸르륵 소리를 내며 당신이 ~할 필요가 있음을 나타낸다. %FSYN("poo")%.
		PRINTFORMW 화장실까지 가지 못할 것 같아, 차라리 바지를 입은 채 해결하기로 마음먹는다.
		PRINTFORMW %조사처리(CALLNAME:ARG,"는")% %PeeProtectType(ARG,1)%을 내려다보며 오물을 온전히 받아 주기를 바란다.
	ELSE
		PRINTFORMW %조사처리(CALLNAME:ARG,"의")%의 배 속 통증은 매 순간 더 심해진다.
		PRINTFORMW 신음을 흘리며, 차라리 이 자리에서 스스로 해결하는 편이 나을지도 모른다고 생각한다...
		PRINTFORMW 잠시 그 결정과 유치한 행동이 무엇을 뜻하는지 생각하지만, 결국 그대로 계속한다.
	ENDIF
ELSE
	IF ABL:ARG:PeeAddict >= 10
		IF IsPadded(ARG,"Diaper")
			PRINTFORMW %CALLNAME:ARG% 더 이상 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG,1)%을 사용할 수 있기를 기다릴 수가 없다.
		ELSE
			PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 충분히 절박해졌다고 판단한다. 이제 %PeeProtectType(ARG,1)%을 사용할 시간이다.
		ENDIF
	ELSEIF ABL:ARG:PeeAddict >= 5
		IF IsPadded(ARG,"Diaper")
			PRINTFORMW 멀쩡한 %PeeProtectType(ARG,1)%을 입고 있으니 더는 스스로를 괴롭힐 이유가 없다고 판단한다.
		ELSE
			PRINTFORMW 지금까지 충분히 오래 소변을 참았다고 판단한다.
		ENDIF
	ELSE
		SELECTCASE RAND:6
			CASE 0
				PRINTFORMW 미칠 듯한 요의를 견디느니 그냥 끝내는 편이 낫다고 판단한다.
			CASE 1
				PRINTFORMW 오랫동안 참느라 초조해진 %조사처리(CALLNAME:ARG,"는")% 이제 놓아줄 때라 생각하고 방광 근육의 긴장을 푼다.
			CASE 2
				PRINTFORMW %CALLNAME:ARG% 더 이상 %조사처리(CALLNAME:ARG,"의")% 방광을 참아야 하는 것을 견딜 수 없다.
			CASE 3
				PRINTFORMW 가고 싶은 절박한 욕구가 너무 크다.
			CASE 4
				PRINTFORMW 절박한 요의 탓에 다른 것은 아무것도 보이지 않는다. %조사처리(CALLNAME:ARG,"는")% 저항을 포기하고 전부 내보내기로 한다.
			CASE 5
				PRINTFORMW 해방을 갈망하는 방광의 통증에, %조사처리(CALLNAME:ARG,"는")% 그저 항복하기로 한다...
		ENDSELECT
		;PRINTFORMW %조사처리(CALLNAME:ARG,"의")% cheeks glow red as %PARSE("you give",5,,ARG)% up trying to hold it in.
	ENDIF
	PRINTFORMW %조사처리(CALLNAME:ARG,"는")% %PeeProtectType(ARG,1)%을 내려다본 뒤 다리를 조금 벌리고 온몸의 긴장을 푼다...
ENDIF

