				; ### Under B
				PRINTDATAL
					DATAFORM 더 이상 참을 수 없어 %PARSE("you",,,ARG)% 완전히 %PeeAndPoo(HasPiss,HasScat,FSYN("pee:s",,,ARG != MASTER),FSYN("poo:s",,,ARG != MASTER)+" in")% %PARSE("your",5,,ARG)% %PeeProtectType(ARG,1)%.
