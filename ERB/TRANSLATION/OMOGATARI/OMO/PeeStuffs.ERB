		ENDSELECT
		IF !RAND:2
			PRINTFORMW \@ ARG == MASTER ? 당신은 # %조사처리(CALLNAME:ARG,"는")% \@ 방귀를 내보낸다.
			CALL POOSOUNDS("hf")
