@BladderFillAmount(ARG=-1,nSide=0,nTime,BFA_BPS=0)
#FUNCTION
#DIM nSide
#DIM nTime
#DIM BFA_CONST
#DIM BFA_INTAKE
#DIM BFA_CONCEN
#DIM BFA_APPLY
#DIM BFA_AFTERDIL
#DIM BFA_FULLELAPSE
#DIM BFA_MULT
#DIM BFA_BPS
VARSET BFA_INTAKE
VARSET BFA_CONCEN, 1
SIF ARG > -1
	TCVAR:ARG:PeeConcentration = LIMIT(TCVAR:ARG:PeeConcentration,0,13)
SELECTCASE nSide
	CASE 0
		;pee
		BFA_CONST = 15
		BFA_MULT = nBladderFill
		IF ARG > -1
			BFA_INTAKE = LIMIT(TCVAR:ARG:LiquidIntake,0,1000)
			BFA_CONCEN = LIMIT(TCVAR:ARG:PeeConcentration+1,1,14)
			IF DT_SELECT(@"Hediff", @"chara = {ARG} and type = 52") || (BFA_BPS && GETBIT(BedProtectSettings:5,1))
				BFA_CONST = BFA_CONST*2/3
			ELSE
				SIF TCVAR:ARG:お薬
					BFA_CONST = BFA_CONST*3/2
				SIF TCVAR:ARG:利尿剤 || (BFA_BPS && GETBIT(BedProtectSettings:5,0))
					BFA_CONST = BFA_CONST*3
				SIF DT_SELECT(@"Hediff", @"chara = {ARG} and type = 40") ;KyuuKyuu-Nyo
					BFA_CONST = BFA_CONST*5
			ENDIF
			SIF TEQUIP:ARG:SWIMMING
				BFA_CONST = BFA_CONST*3
		ENDIF
	CASE 1
		;poop
		BFA_CONST = 10
		BFA_CONCEN = 2
		BFA_MULT = nBowelFill
		IF ARG > -1
			BFA_INTAKE = LIMIT(TCVAR:ARG:FoodIntake,0,1000)
			IF DT_SELECT(@"Hediff", @"chara = {ARG} and type = 51")  || (BFA_BPS && GETBIT(BedProtectSettings:5,3))
				BFA_CONST = BFA_CONST*2/3
			ELSE
				SIF TCVAR:ARG:お薬
					BFA_CONST = BFA_CONST*3/2
				IF DT_SELECT(@"Hediff", @"chara = {ARG} and type = 49") ;KyuuKyuu-Un
					IF TCVAR:ARG:BowelState > 0 || DrugStats:ARG:LaxativeTime || (BFA_BPS && GETBIT(BedProtectSettings:5,2))
						BFA_CONST = BFA_CONST*3
					ELSE
						BFA_CONST = BFA_CONST*25
					ENDIF
				ENDIF
				SIF DrugStats:ARG:EnemaTime
					BFA_CONST = BFA_CONST*DrugStats:ARG:EnemaStrength
				SIF DrugStats:ARG:OliveOilTime
					BFA_CONST = BFA_CONST*5
				SIF DrugStats:ARG:CastorOilTime
					BFA_CONST = BFA_CONST*15
				IF TCVAR:ARG:BowelState > 0 || DrugStats:ARG:LaxativeTime || (BFA_BPS && GETBIT(BedProtectSettings:5,2))
					BFA_CONST = BFA_CONST*15
				ELSEIF TCVAR:ARG:BowelState < 0
					BFA_CONST = BFA_CONST/2
				ENDIF
			ENDIF
		ENDIF
ENDSELECT
IF ARG >= 0
	BFA_CONST = BFA_CONST*HyperMesserMultiplier(TALENT:ARG:(350+nSide)) ;hyper messing
ENDIF
BFA_AFTERDIL = BFA_INTAKE/(BFA_CONCEN)/120
BFA_FULLELAPSE = BFA_AFTERDIL * nTime
BFA_APPLY = BFA_AFTERDIL
;     DEBUGPRINTFORML %CALLNAME:ARG%'s dilution factor is {BFA_CONCEN}, adding {BFA_APPLY} to the value.
;     DEBUGPRINTFORML Limited %CALLNAME:ARG% kidney output from {TCVAR:ARG:LiquidIntake}ml to {BFA_APPLY}ml
BFA_APPLY *= 10
BFA_APPLY += BFA_CONST
;bladder filling
BFA_APPLY = BFA_APPLY * BFA_MULT / 100
BFA_APPLY *= nTime
;DEBUGPRINTFORML Accounting for time change ({nTime} minutes), %CALLNAME:ARG%'s bladder gain is now {BFA_APPLY}ml
SIF BFA_APPLY <= 0 ;null
	RETURNF 0
SIF ARG > -1 && BFA_BPS == 0
	BFA_APPLY = MAX(1,RAND((BFA_APPLY)*2/3,(BFA_APPLY)))
IF inTrain == 3 || PottyMonsterGame
	BFA_APPLY /= 3
ELSE
	BFA_APPLY /= TALENT:MASTER:(350+nSide) ? 3 # 10
ENDIF
; SIF ARG == MASTER
; DEBUGPRINTFORML Filled %CALLNAME:ARG% with {BFA_APPLY}ml and took away {BFA_FULLELAPSE}ml from intake
BFA_LOSING = BFA_FULLELAPSE
TIMES BFA_LOSING, 2.25
BFA_GAIN = BFA_APPLY
RETURNF BFA_APPLY

