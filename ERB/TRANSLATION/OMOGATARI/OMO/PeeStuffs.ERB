; PEECOLOR
; Gets the color of pee from their TCVAR
; ARGS: ARG (Target, required)
;-------------------------------------------------

@PEECOLOR(ARG, ARG:2 = -1); 1 = words, 2 = color
#FUNCTIONS
SIF ARG:2 == -1
	ARG:2 = TCVAR:ARG:PeeConcentration
VARSET LOCAL
SELECTCASE ARG:2
	CASE 0
		LOCALS '= @"맑은"
	CASE 1
