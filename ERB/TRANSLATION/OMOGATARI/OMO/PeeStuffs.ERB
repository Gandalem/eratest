			CALL PlayAccidentSound(MASTER,HasPiss,"loc",HasScat,"loc")
			PRINTFORMW %SCAT(MASTER,1,1)%는 %조사처리(CALLNAME:ARG,"의")% %PeeProtectType(ARG, 1)%에 강제로 들어갔다.
		CASE 1
			PRINTFORMW %CALLNAME:ARG%화장실 근처에 다가가자 거의 걸을 수가 없다.
			PRINTFORMW %조사처리(CALLNAME:ARG,"의")%목표는 가깝지만, 충분히 가깝지는 않다.
			PRINTFORMW %조사처리(CALLNAME:ARG,"의")%몸이 더 이상 버틸 수 없고, %조사처리(CALLNAME:ARG,"의")% 근육이 풀린다.
			CALL PlayAccidentSound(MASTER,HasPiss,"loc",HasScat,"loc")
			PRINTFORMW %SCAT(MASTER,1,1)%는 빠르게 %조사처리(CALLNAME:ARG,"의")% 안으로 밀려 들어간다. %PeeProtectType(ARG, 1)%
		CASE 2
			PRINTFORMW 뒤쪽에서 %FSYN("poo:n")%이 나오기 시작하는 감각에 %조사처리(CALLNAME:ARG,"는")% 뻣뻣한 걸음으로 변기를 향한다.
			PRINTFORMW 화장실에 다가가는 동안 장 근육을 조여 단 몇 초라도 더 버티려고 몸부림친다.
			CALL POOSOUNDS("v")
			PRINTFORMW 변기에 거의 닿은 순간 근육이 풀리고, %SCAT(ARG,1)%이 %PeeProtectType(ARG)% 안으로 밀려드는 감각이 전해진다.
			CALL PlayAccidentSound(ARG,HasPiss,"loc",HasScat,"loc")
			PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 얼어붙은 채 엉덩이를 움켜쥐지만, %SCAT(MASTER,1)%이 %PeeProtectType(ARG,1)% 뒤쪽으로 밀려드는 것을 막지 못한다.
		CASE 3
			PRINTFORMW %조사처리(CALLNAME:ARG,"는")% 배를 단단히 움켜쥔 채 비틀거리며 변기로 향한다.
			PRINTFORMW 패닉이 스쳐 지나간다 %조사처리(CALLNAME:ARG,"의")% 마음속으로 %조사처리(CALLNAME:ARG,"의")% 근육들이 겨우 혼란을 붙잡고 있다.
			PRINTFORMW 가까스로 변기에 닿자 황급히 주저앉아 있는 힘껏 밀어 낸다.
			CALL PlayAccidentSound(MASTER,HasPiss,"loc",HasScat,"loc")
