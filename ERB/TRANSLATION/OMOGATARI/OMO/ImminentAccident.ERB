; Modular ERB: OMOGATARI/OMO/ImminentAccident.ERB
; New menu: Immiment Accident Settings
; - Toggle on-person protections such as diapers, catheter systems when sleeping
;      - Chose between different levels of protection as well
; - Change between different bed pads: Unimu Wanwanman (disposable), Play mat (resuable light), Gensou-chan Last Line (resusable heavy)
; - Toggle the bedwetting alarm
; - Prioritze between waking up to stay dry or to keep sleeping and risk a bedwetting incident.
; - Auto-take dream drops (more lucid dreams) or dream suppressants (less lucid dreams)
; - Auto-take diuretics, laxatives, antidiurethics, antidiarrheals, water, to change bedwetting chance
; - Auto-masturbate before bed is moved here
;===========================================
;★★Imminent Accident Settings★★
;When you're about to have an accident...
; [ 0] - Acicdent (4th): Pee/poop in your underwear
; [ 1] - TSP Relief (2nd): Use TSP to relieve yourself on the spot.
; [ 2] - Aphedron (1st): Use MP to empty your bladder and bowels.
; [ 3] - Waste Diversion (3rd): Use MP to divert your excretions to another person.
; Yell and get the attention of everyone.
; [ 4] - Ask the player before an accident: Yes
;
; Current Priority
; 「Aphedron」 -> 「TSP Relief」 -> 「Waste Diversion」 -> 「Acicdent」
; [100] - Return
;===========================================

@ImminentAccidentSettings
#DIMS CONST iasLabel = "Accident", "TSP Relief", "Aphedron", "Waste Diversion"
#DIMS CONST iasDesc = "Give up and soil your underwear.", "Use TSP to relieve yourself on the spot.", "Use MP to empty your bladder and bowels.", "Use MP to divert your excretions to another person."
#DIM DYNAMIC iasLineCount,2
#DIM DYNAMIC iasInput
#DIM DYNAMIC iasCanSpell
SIF MAXBASE:MASTER:TSP >= 350
	SETBIT iasCanSpell, 1
CALL YoujutsuMagicCanDo(MASTER,18,28)
SIF RESULT
	SETBIT iasCanSpell, 2
CALL YoujutsuMagicCanDo(MASTER,18,37)
SIF RESULT
	SETBIT iasCanSpell, 3
FONTBOLD
SETCOLOR C_YELLOW
PRINTFORML ★임박한 사고 설정★
RESETCOLOR
FONTREGULAR
iasLineCount = LINECOUNT
DO
CLEARLINE LINECOUNT-iasLineCount
IF iasCanSpell
	PRINTFORML 사고가 나기 직전이라면...
	FOR LOCAL,0,VARSIZE("iasLabel")
	SIF LOCAL && !GETBIT(iasCanSpell,LOCAL)
		CONTINUE
	IF FINDELEMENT(ImminentAccidentSettings_Priority,LOCAL) == -1
		LOCALS:0 '= "(해제됨)"
	ELSE
		LOCALS:0 '= @"(%ORDINAL(FINDELEMENT(ImminentAccidentSettings_Priority,LOCAL)+1)%)"
	ENDIF
	PRINTFORML [{LOCAL,2}] %iasLabel:LOCAL% %LOCALS:0% - %iasDesc:LOCAL%
	NEXT
	PRINTL
	PRINTFORML [20] 사고가 발생하기 전에 플레이어에게 물어보기: %YesOrNo(ImminentAccidentSettings_AskPlayer)%
	SIF GETBIT(iasCanSpell,3)
		PRINTFORML [21] 리다이렉션된 적이 있다면 체인 리디렉션을 할 것인가: %YesOrNo(ImminentAccident_AutoRedirect)%
	PRINTL
	SETCOLOR C_YELLOW
	PRINTFORML 현재 우선순위:
	RESETCOLOR
	FOR LOCAL,0,VARSIZE("iasLabel")
	SIF ImminentAccidentSettings_Priority:LOCAL > 0 && !GETBIT(iasCanSpell,ImminentAccidentSettings_Priority:LOCAL)
		CONTINUE
	SIF ImminentAccidentSettings_Priority:LOCAL == -1
		CONTINUE
	PRINTFORM 「%iasLabel:(ImminentAccidentSettings_Priority:LOCAL)%」
	IF LOCAL+1 > VARSIZE("ImminentAccidentSettings_Priority")-1
	ELSEIF ImminentAccidentSettings_Priority:(LOCAL+1) == -1
	ELSE
		PRINTFORMS " -> "
	ENDIF
	NEXT
	PRINTL
ELSE
	PRINTFORML 당신은 어떤 마법도 없으니 사고를 치는 것이 유일한 선택이다...
ENDIF
PRINTL
PRINTFORML [100] - 반환
INPUT
iasInput = RESULT
SELECTCASE iasInput
	CASE 0 TO VARSIZE("iasLabel")-1
		iasLineCount:1 = LINECOUNT
		DO
		CLEARLINE LINECOUNT-(iasLineCount:1)
		PRINTFORML %iasLabel:iasInput%의 우선순위를 변경한다.
		FOR LOCAL,0,VARSIZE("iasLabel")
		PRINTFORML [{LOCAL,2}]을 %ORDINAL(LOCAL+1)%로 설정한다 (현재 \@ ImminentAccidentSettings_Priority:LOCAL > -1 ? %iasLabel:(ImminentAccidentSettings_Priority:LOCAL)% # 아무것도 없다 \@).
		IF ImminentAccidentSettings_Priority:LOCAL == -1
			IF LOCAL >= VARSIZE("iasLabel")-1
				BREAK
			ELSEIF ImminentAccidentSettings_Priority:(LOCAL+1) == -1
				BREAK
			ENDIF
		ENDIF
		NEXT
		PRINTFORML [-250] 비활성화
		PRINTL
		PRINTFORML [-999] 종료
		INPUT
		LOCAL:0 = RESULT
		LOCAL:1 = FINDELEMENT(ImminentAccidentSettings_Priority,iasInput)
		SELECTCASE LOCAL:0
			CASE 0 TO VARSIZE("iasLabel")-1
				IF LOCAL == FINDELEMENT(ImminentAccidentSettings_Priority,iasInput)
					CONTINUE
				ELSEIF ImminentAccidentSettings_Priority:LOCAL == -1
					IF LOCAL:1 > -1
						PRINTFORMW 이미 우선순위 목록에 있다.
						CONTINUE
					ENDIF
					ImminentAccidentSettings_Priority:LOCAL = iasInput
				ELSE
					IF LOCAL:1 == -1
						; FOR LOCAL:2, LOCAL:0, VARSIZE("iasLabel")-1
						;     SIF ImminentAccidentSettings_Priority:(LOCAL:2+1) == -1
						;         BREAK
						;     ImminentAccidentSettings_Priority:(LOCAL:2+1) = ImminentAccidentSettings_Priority:(LOCAL:2)
						; NEXT
						ARRAYSHIFT ImminentAccidentSettings_Priority, 1, iasInput
						SWAP ImminentAccidentSettings_Priority:(0), ImminentAccidentSettings_Priority:(LOCAL)
						; ImminentAccidentSettings_Priority:LOCAL = iasInput
					ELSE
						SWAP ImminentAccidentSettings_Priority:(LOCAL:1), ImminentAccidentSettings_Priority:(LOCAL)
					ENDIF
				ENDIF
			CASE -250
				IF RESULT == -250 && iasInput == 0
					PRINTFORMW 사고를 없앨 수는 없다!
					CONTINUE
				ENDIF
				ImminentAccidentSettings_Priority:(LOCAL:1) = -1
				FOR LOCAL:2, LOCAL:1, VARSIZE("iasLabel")-1
				ImminentAccidentSettings_Priority:(LOCAL:2) = ImminentAccidentSettings_Priority:(LOCAL:2+1)
				NEXT
			CASE -999
				BREAK
		ENDSELECT
		LOOP 1
	CASE 20
		ImminentAccidentSettings_AskPlayer = !ImminentAccidentSettings_AskPlayer
	CASE 21
		ImminentAccident_AutoRedirect = !ImminentAccident_AutoRedirect
	CASE 100
		RETURN
ENDSELECT
LOOP 1

@IAS_OPTION_NAME(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF "Accident"
	CASE 1
		RETURNF "TSP Relief"
	CASE 2
		RETURNF "Aphedron"
	CASE 3
		RETURNF "Waste Diversion"
ENDSELECT
;i can make it so that they can try to stop their accidents

@ImminentAccident(ARG,HasPiss,HasScat)
#DIM HasPiss
#DIM HasScat
#DIM DYNAMIC CanSpell
#DIM DYNAMIC nInput
nInput = 0
FOR LOCAL,1,VARSIZE("ImminentAccidentSettings_Priority")
CALL ImminentAccident_AbleToDo(ARG,LOCAL)
SIF RESULT
	SETBIT CanSpell, LOCAL
NEXT
SIF !CanSpell || !SHIRAHU(ARG)
	GOTO Accident
SETCOLOR C_RED
PRINTFORML ★★임박한 사고%COND_STR(@" (%CALLNAME:ARG%)",ARG != MASTER)%★★
RESETCOLOR
SELECTCASE ARG
	CASE MASTER
		IF ImminentAccidentSettings_AskPlayer
			PRINTFORML 당신의 \@ HasScat ? 장은 파열될 것 같다 # 방광이 파열될 지경이다 \@!!
			FOR LOCAL, 1, 4
			SIF GETBIT(CanSpell,LOCAL)
				PRINTFORML [{LOCAL,2}] %IAS_OPTION_NAME(LOCAL)%
			NEXT
			SIF ImminentAccident_RedirectionCaster > -1
				PRINTFORML [86] 리디렉션을 계속한다.
			;[1] TSP Relief
			;[2] Waste Redirection
			PRINTL
			PRINTFORML [ 0] 내보내라...
			TINPUT 5000, 0, 1
			nInput = RESULT
		ELSE
			FOR LOCAL,1,VARSIZE("ImminentAccidentSettings_Priority")
			CALL ImminentAccident_AbleToDo(ARG,ImminentAccidentSettings_Priority:LOCAL)
			IF RESULT
				;we can do the spell
				nInput = ImminentAccidentSettings_Priority:LOCAL
				BREAK
			ENDIF
			NEXT
			IF ImminentAccident_AutoRedirect && ImminentAccident_RedirectionCaster > -1
				CALL ImminentAccident_AbleToDo(ARG,3)
				SIF RESULT
					nInput = 86
			ENDIF
		ENDIF
	CASEELSE
		IF WantsToUseDiaperOverPotty(ARG,1)
			GOTO Accident
		ENDIF
		CALL FISHER_YATES_SHAFFLE(VARSIZE("ImminentAccidentSettings_Priority"))
		FOR LOCAL,0,VARSIZE("ImminentAccidentSettings_Priority")
		;don't allow omorashi unless all rolls fail
		SIF SHAFFLE_ARRAY:LOCAL == 0
			CONTINUE
		IF RAND(10000) <= ImminentAccident_NPCUseAbility(ARG,SHAFFLE_ARRAY:LOCAL,HasPiss,HasScat) && !nInput
			;done
			nInput = SHAFFLE_ARRAY:LOCAL
			BREAK
		ELSE
		ENDIF
		NEXT
		SIF nInput == 0
			GOTO Accident
ENDSELECT
CALL ImminentAccident_OmorashiNoGacha(ARG,HasPiss,HasScat,nInput)
ImminentAccident_SpellFailureLevel = RESULT
IF ImminentAccident_SpellFailureLevel > 0
	ImminentAccident_SpellCast = nInput
	SIF ARG == MASTER
		ImminentAccident_FailurePity++
ELSEIF ImminentAccident_SpellFailureLevel == -1
	nInput = 0
ELSE
	SIF ARG == MASTER
		ImminentAccident_FailurePity = 0
ENDIF
SIF nInput == 86
	nInput = 3
SELECTCASE nInput
	CASE 1
		IF ImminentAccident_SpellFailureLevel != 99
			CALL TSP_RELIEF(ARG,ImminentAccident_ChooseVictim,HasPiss,HasScat)
		ELSE
			CALL ImminentAccident_SpellFailure(ARG,1,ImminentAccident_SpellFailureLevel,HasPiss,HasScat)
			GOTO Accident
		ENDIF
	CASE 2
		; PRINTFORML You cast Aphedron at yourself...
		; PRINTFORML .
		; PRINTFORML ..
		; PRINTFORML ...
		IF !GETBIT(CanSpell,2)
			;lmfao good job cheater
			ImminentAccident_SpellFailureLevel = 99
			CALL ImminentAccident_PrintSpellOutcome(ImminentAccident_SpellFailureLevel)
			CALL PRINT_GPC("W", @"「아페드론!」", ARG)
			CALL PRINT_GP("W", @"아뇨... 아무것도 안 하고 있어요!")
			CALL PRINT_GP("W", @"그리고 이미 아무것도 할 수 없어... 나오고 있어!")
			GOTO Accident
		ENDIF
		;     CALL PRINT_GP("W", @"You realize that you know a chant that can clear your bowels.")
		;     CALL PRINT_GPC("W", @"「Aph....」", MASTER)
		;     CALL PRINT_GPC("W", @"「Aphe....」", MASTER)
		;     CALL PRINT_GPC("W", @"「Aphedra...」", MASTER)
		;     CALL PRINT_GP("W", @"Unable to focus, you're unable to cast the spell in time...")
		;DIARAHAN!
		; CALL PRINT_GPC("W", @"「\@ GROUPMATCH(NAS_ESP_RADIUS,4,5,6) ? %TOUPPER(NAS_ESP_NAME)%!!! # %NAS_ESP_NAME%!\@」", PYC_CASTER)
		IF !ImminentAccident_SpellFailureLevel
			CALL PROCESS_YOUJUTSU_COMMAND(ARG,ARG,18,28,1)
			IF RESULT != 9530
				CALL ImminentAccident_PrintSpellOutcome(0)
				IF ARG == MASTER
					PRINTFORMW 휴. 이제 훨씬 기분이 좋아졌을 거야.
					PRINTFORMW 또 비상사태가 발생하지 않도록 배변 욕구를 참아보렴.
					BladderDiary += @"%時刻表示(TIME)%: 임박한 사고가 아페드론에 개입했다\n"
				ELSE
					PRINTFORMW %CALLNAME:ARG%는 이제 훨씬 기분이 좋다.
				ENDIF
				RETURN
			ELSE
				ImminentAccident_SpellFailureLevel = 4
				CALL ImminentAccident_PrintSpellOutcome(ImminentAccident_SpellFailureLevel)
				PRINTFORMW 아, 안 돼... 작동하지 않아!
				PRINTFORMW 그리고 이제 뭘 할 수도 없어... 나오고 있어!
				PRINTL
				GOTO Accident
			ENDIF
		ELSE
			CALL ImminentAccident_SpellFailure(ARG,2,ImminentAccident_SpellFailureLevel,HasPiss,HasScat)
			GOTO Accident
		ENDIF
	CASE 3
		IF !GETBIT(CanSpell,3)
			CALL PRINT_GPC("W", @"「오염물 우회」", ARG)
			CALL PRINT_GP("W", @"아냐... 아무것도 안 하고 있어!")
			CALL PRINT_GP("W", @"그리고 이미 아무것도 할 수 없을 정도로 늦었다... 나오고 있어!")
			GOTO Accident
		ELSEIF !GET_TARGETNUM()
			PRINTFORMW 하지만 어디로?
			PRINTFORMW 갈 곳이 없어... 
			PRINTFORMW 오 안 돼. 오 안 돼! 나오고 있어!
			GOTO Accident
		ENDIF
		IF !ImminentAccident_SpellFailureLevel
			ImminentAccident_RedirectionCaster = ARG
			CALL WasteRedirection(ARG,ImminentAccident_ChooseVictim)
		ELSE
			CALL ImminentAccident_SpellFailure(ARG,3,ImminentAccident_SpellFailureLevel,HasPiss,HasScat)
			GOTO Accident
		ENDIF
	CASE 4
		PRINTFORML 미안하다. 아직 끝나지 않았다!
		GOTO Accident
	CASEELSE
		$Accident
		IF HasScat
			CALL UNCHI_OMORASHI(ARG,HasPiss)
		ELSE
			CALL OSHIKKO_OMORASHI(ARG,HasScat)
		ENDIF
ENDSELECT
ImminentAccident_ChooseVictim = -1
ImminentAccident_RedirectionCaster = -1
;roulette wheel
;spin the wheel,
;1 point will ALWAYS be Failure to Cast

@ImminentAccident_OmorashiNoGacha(ARG,HasPiss,HasScat,wsfSpell)
#DIM DYNAMIC wsfSpell
#DIM DYNAMIC wsfEntries, 101
#DIM DYNAMIC wsfOdds, 5
#DIM DYNAMIC wsfProbs, 5
#DIM DYNAMIC wsfSize
#DIM DYNAMIC wsfRand
#DIM DYNAMIC wsfMaxRolls = 150
#DIM DYNAMIC wsfTotal
#DIM DYNAMIC wsfContinueRedirect
#DIMS DYNAMIC wsfGood
#DIMS DYNAMIC wsfBad
#DIM HasPiss
#DIM HasScat
#DIMS CONST wsfRollLabel = "Success", "Minor Failure", "Moderate Failure", "MAJOR FAILURE", "FAILURE TO CAST"
#DIM CONST wsfRollColors = C_GREEN, C_YELLOW, C_ORANGE, C_RED, C_GRAY
; wsfOdds:0 = 1000
; wsfOdds:1 = 0
; wsfOdds:2 = 0
; wsfOdds:3 = 0
; wsfOdds:4 = 0
; wsfOdds:5 = 1000
; VARSET wsfOdds, 1000
; wsfOdds:5 = 4000
IF wsfSpell == 86
	ImminentAccident_ChooseVictim = ImminentAccident_RedirectionCaster
	wsfSpell = 3
	wsfContinueRedirect = 1
ENDIF
CALL ImminentAccident_SpellChance(ARG,HasPiss,HasScat,wsfSpell)
ARRAYCOPY "RESULT", "wsfOdds"
wsfGood '= RESULTS:0
wsfBad '= RESULTS:1
wsfOdds:4 = MAX(10,wsfOdds:4)
FOR LOCAL,0,VARSIZE("wsfOdds")
wsfTotal += wsfOdds:LOCAL
NEXT
FOR LOCAL,0,VARSIZE("wsfOdds")
wsfProbs:LOCAL += (1000*wsfOdds:LOCAL)/wsfTotal
NEXT
VARSET wsfEntries, 0
FOR LOCAL,0,VARSIZE("wsfEntries")
wsfRand = RAND:1000+1
IF wsfRand <= wsfProbs:0
	wsfEntries:LOCAL = 0
ELSEIF wsfRand <= wsfProbs:0+wsfProbs:1
	wsfEntries:LOCAL = 1
ELSEIF wsfRand <= wsfProbs:0+wsfProbs:1+wsfProbs:2
	wsfEntries:LOCAL = 2
ELSEIF wsfRand <= wsfProbs:0+wsfProbs:1+wsfProbs:2+wsfProbs:3
	wsfEntries:LOCAL = 3
ELSEIF wsfRand <= wsfProbs:0+wsfProbs:1+wsfProbs:2+wsfProbs:3+wsfProbs:4
	wsfEntries:LOCAL = 99
ELSE
	wsfEntries:LOCAL = 0
ENDIF
NEXT
; FOR LOCAL,0,50
;     wsfEntries:LOCAL = 99
; NEXT
wsfEntries:50 = 99
wsfSize = VARSIZE("wsfEntries")
; RETURNF 99
CALL FISHER_YATES_SHAFFLE(wsfSize)
SELECTCASE wsfSpell
	CASE 3
		IF wsfContinueRedirect
		ELSEIF GET_TARGETNUM()
			IF ARG == MASTER
				PRINTFORMW 누구에게?
				FOR LOCAL,0,CHARANUM-1
				SIF LOCAL == MASTER
					CONTINUE
				SIF CFLAG:LOCAL:300 != CFLAG:MASTER:300
					CONTINUE
				PRINTFORML [{LOCAL,3}] - %CALLNAME:LOCAL%
				NEXT
				PRINTL
				PRINTFORML [-1] 내보내라...
				INPUT
				ImminentAccident_ChooseVictim = RESULT
				SELECTCASE ImminentAccident_ChooseVictim
					CASE -1, MASTER
						PRINTFORMDW 당신은 배설 기능을 이기도록 내버려 두었다...
						RETURN -1
					CASEELSE
						IF !INRANGE(LOCAL,0,CHARANUM-1)
							PRINTFORMDW 그건 진짜 사람이 아니야.
							PRINTFORMW 안 돼. 안 돼! 나오고 있어!
							RETURN -1
						ENDIF
				ENDSELECT
			ELSE
				ImminentAccident_ChooseVictim = ImminentAccident_PickRedirectionTarget(ARG)
			ENDIF
		ELSE
			RETURN 99
		ENDIF
	CASE 2
		PRINTFORML %PARSE("You cast",,,ARG)% 아페더넘이 %PARSE("yourself",,,ARG)%....이다.
	CASE 1
		IF ARG == MASTER
			CALL TSP_RELIEF_INIT(MASTER,1,HasPiss,HasScat)
			ImminentAccident_ChooseVictim = RESULT
		ELSE
			ImminentAccident_ChooseVictim = ImminentAccident_PickRedirectionTarget(ARG)
		ENDIF
	CASE 0
		PRINTFORML %PARSE("You choose",,,ARG)%포기하고 \@ IsDiapered(ARG) ? %PARSE("your",5,,ARG)% 기저귀를 사용한다 # %PARSE("yourself",,,ARG)% 더럽힌다 \@...
		RETURN 99
ENDSELECT
PRINTL
SETCOLOR C_YELLOW
PRINTFORML 둘의 오줌 가챠
RESETCOLOR
PRINTFORML .
PRINTFORM 배설 술법: 
CALL PRINT_RANK(YoujutsuLevel:ARG:18,"MAX_6")
PRINTFORM  {YoujutsuLevel:ARG:18}
PRINTL
PRINTFORML ..
PRINTFORML ★EPL: %TOSTR_EPL(EffectivePottyLevel(ARG))% {EffectivePottyLevel(ARG)}
PRINTFORML ...
IF STRLENS(wsfGood) || STRLENS(wsfBad)
	IF STRLENS(wsfGood)
		SETCOLOR C_GREEN
		PRINTFORML ★%LIST_IN_STRING(wsfGood,,", ")%
		RESETCOLOR
	ENDIF
	IF STRLENS(wsfBad)
		SETCOLOR C_RED
		PRINTFORML ★%LIST_IN_STRING(wsfBad,,", ")%
		RESETCOLOR
	ENDIF
	PRINTFORML ....
ENDIF
FOR LOCAL,0,VARSIZE("wsfOdds")
SETCOLOR wsfRollColors:LOCAL
PRINTFORML ★%wsfRollLabel:LOCAL%:{wsfProbs:LOCAL/10}.{wsfProbs:LOCAL%10}\%
; IF wsfOdds:LOCAL <= 0
;     PRINTFORML ∞/1
; ELSE
;     PRINTFORML {(1000*wsfOdds:LOCAL)/wsfTotal}/{wsfTotal}
;     ; PRINTFORML {1001-wsfOdds:LOCAL}/1
; ENDIF
NEXT
RESETCOLOR
REPEAT wsfMaxRolls
PRINTFORMSL (" "*34)+"↓"
FOR LOCAL,25,-25,-1
IF iNRANGE(COUNT % wsfSize+LOCAL,0,wsfSize-1)
	LOCAL:1 = (COUNT % wsfSize)+LOCAL
ELSE
	; LOCAL:1 = wsfSize-1
	LOCAL:1 = wsfSize-LOCAL
ENDIF
SELECTCASE wsfEntries:(SHAFFLE_ARRAY:(LOCAL:1))
	CASE 0
		SETCOLOR C_GREEN
	CASE 1
		SETCOLOR C_YELLOW
	CASE 2
		SETCOLOR C_ORANGE
	CASE 3
		SETCOLOR C_RED
	CASE 4
		SETCOLOR C_D_RED
	CASE 99
		SETCOLOR C_GRAY
ENDSELECT
PRINTFORM %UNICODE(0x2585)%
RESETCOLOR
NEXT
PRINTL
PRINTFORMSL (" "*34)+"↑"
SELECTCASE wsfMaxRolls-COUNT
	CASE IS > 31
		TWAIT 10, 1
	CASE IS > 7
		TWAIT 50, 1
	CASE IS > 3
		TWAIT 250, 1
	CASE IS > 0
		TWAIT 500, 1
	CASE 1
		TWAIT 1000, 1
ENDSELECT
TWAIT 20, 1
SIF COUNT != wsfMaxRolls && COUNT != wsfMaxRolls-1
	CLEARLINE 3
IF COUNT % wsfSize == 0
	CALL FISHER_YATES_SHAFFLE(wsfSize)
ENDIF
REND
LOCAL:6 = wsfEntries:(SHAFFLE_ARRAY:((COUNT-1) % wsfSize))
IF LOCAL:6 == 0 && ARG == MASTER
	SIF wsfProbs:0 <= 10
		CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("omoGachaSSRPull")
	SIF ImminentAccident_FailurePity >= 12
		CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("omoGachaHardPity")
ENDIF
RETURN wsfEntries:(SHAFFLE_ARRAY:((COUNT-1) % wsfSize))

@ImminentAccident_SpellFailure(ARG,sfSpell,sfFailLevel,HasPiss,HasScat)
#DIM sfSpell
#DIM sfFailLevel
#DIM HasPiss
#DIM HasScat
CALL ImminentAccident_PrintSpellOutcome(sfFailLevel)
SELECTCASE sfSpell
	CASE 1
		SELECTCASE sfFailLevel
			CASE 99
				PRINTFORMW ...아니면 적어도 시도해 보든지.
				CALL SET_KOJO_COLOR(ARG)
				PRINTFORML 「그것이...」
				PRINTFORML 「음...」
				PRINTFORMW 「Uh.......」
				RESETCOLOR
				PRINTFORMW 집중할 수 없어, 시간이 이긴다 %PARSE("you",,,ARG)% ...
			CASE 1 TO 3
				SETBGCOLOR C_THE_WORLD
				PRINTFORMW %PARSE("You manage",,,ARG)% 시간을 멈추게 하기 위해, 하지만 %PARSE("your",5,,ARG)% 배설 시스템을 파괴하는 것...
		ENDSELECT
	CASE 2
		SELECTCASE sfFailLevel
			CASE 99
				;failure to cast (no mitigation)
				PRINTFORMW ...아니면 적어도 시도해 봐라.
				CALL SET_KOJO_COLOR(ARG)
				PRINTFORML 「아프....」
				PRINTFORML 「애프....」
				PRINTFORMW 「아페드라...」
				RESETCOLOR
				PRINTFORMW 집중할 수 없어, %PARSE("you're",,,ARG)% 제때 주문을 시전하지 못한다...
