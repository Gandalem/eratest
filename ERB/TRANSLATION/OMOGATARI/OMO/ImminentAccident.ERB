@ImminentAccident_OmorashiNoGacha(ARG,HasPiss,HasScat,wsfSpell)
#DIM DYNAMIC wsfSpell
#DIM DYNAMIC wsfEntries, 101
#DIM DYNAMIC wsfOdds, 5
#DIM DYNAMIC wsfProbs, 5
#DIM DYNAMIC wsfSize
#DIM DYNAMIC wsfRand
#DIM DYNAMIC wsfMaxRolls = 150
#DIM DYNAMIC wsfTotal
#DIM DYNAMIC wsfContinueRedirect
#DIMS DYNAMIC wsfGood
#DIMS DYNAMIC wsfBad
#DIM HasPiss
#DIM HasScat
{
#DIMS CONST wsfRollLabel =
"Success",
"Minor Failure",
"Moderate Failure",
"MAJOR FAILURE",
"FAILURE TO CAST"
}
{
#DIM CONST wsfRollColors =
C_GREEN,
C_YELLOW,
C_ORANGE,
C_RED,
C_GRAY
}
; wsfOdds:0 = 1000
; wsfOdds:1 = 0
; wsfOdds:2 = 0
; wsfOdds:3 = 0
; wsfOdds:4 = 0
; wsfOdds:5 = 1000
; VARSET wsfOdds, 1000
; wsfOdds:5 = 4000
IF wsfSpell == 86
    ImminentAccident_ChooseVictim = ImminentAccident_RedirectionCaster
    wsfSpell = 3
    wsfContinueRedirect = 1
ENDIF


CALL ImminentAccident_SpellChance(ARG,HasPiss,HasScat,wsfSpell)
ARRAYCOPY "RESULT", "wsfOdds"
wsfGood '= RESULTS:0
wsfBad '= RESULTS:1

wsfOdds:4 = MAX(10,wsfOdds:4)
FOR LOCAL,0,VARSIZE("wsfOdds")
    wsfTotal += wsfOdds:LOCAL
NEXT
FOR LOCAL,0,VARSIZE("wsfOdds")
    wsfProbs:LOCAL += (1000*wsfOdds:LOCAL)/wsfTotal
NEXT

VARSET wsfEntries, 0
FOR LOCAL,0,VARSIZE("wsfEntries")
    wsfRand = RAND:1000+1
    IF wsfRand <= wsfProbs:0
        wsfEntries:LOCAL = 0
    ELSEIF wsfRand <= wsfProbs:0+wsfProbs:1
        wsfEntries:LOCAL = 1
    ELSEIF wsfRand <= wsfProbs:0+wsfProbs:1+wsfProbs:2
        wsfEntries:LOCAL = 2
    ELSEIF wsfRand <= wsfProbs:0+wsfProbs:1+wsfProbs:2+wsfProbs:3
        wsfEntries:LOCAL = 3
    ELSEIF wsfRand <= wsfProbs:0+wsfProbs:1+wsfProbs:2+wsfProbs:3+wsfProbs:4
        wsfEntries:LOCAL = 99
    ELSE
        wsfEntries:LOCAL = 0
    ENDIF
NEXT
; FOR LOCAL,0,50
;     wsfEntries:LOCAL = 99
; NEXT
wsfEntries:50 = 99
wsfSize = VARSIZE("wsfEntries")
; RETURNF 99
CALL FISHER_YATES_SHAFFLE(wsfSize)
SELECTCASE wsfSpell
CASE 3
    IF wsfContinueRedirect
    ELSEIF GET_TARGETNUM()
        IF ARG == MASTER
            PRINTFORMW To who?
            FOR LOCAL,0,CHARANUM-1
                SIF LOCAL == MASTER
                    CONTINUE
                SIF CFLAG:LOCAL:300 != CFLAG:MASTER:300
                    CONTINUE
                PRINTFORML [{LOCAL,3}] - %CALLNAME:LOCAL%
            NEXT
            PRINTL
            PRINTFORML [-1] Let it out...
            INPUT
            ImminentAccident_ChooseVictim = RESULT
            SELECTCASE ImminentAccident_ChooseVictim
            CASE -1, MASTER
                PRINTFORMDW You let your excretory functions win you over..
                RETURN -1
            CASEELSE
                IF !INRANGE(LOCAL,0,CHARANUM-1)
                    PRINTFORMDW That's not a real person.
                    PRINTFORMW Oh no. Oh no! It's coming out!
                    RETURN -1
                ENDIF
            ENDSELECT
        ELSE
            ImminentAccident_ChooseVictim = ImminentAccident_PickRedirectionTarget(ARG)
        ENDIF
    ELSE
        RETURN 99
    ENDIF
CASE 2
	PRINTFORML %PARSE("You cast",,,ARG)% Aphedron at %PARSE("yourself",,,ARG)%....
CASE 1
    IF ARG == MASTER
        CALL TSP_RELIEF_INIT(MASTER,1,HasPiss,HasScat)
        ImminentAccident_ChooseVictim = RESULT
    ELSE
        ImminentAccident_ChooseVictim = ImminentAccident_PickRedirectionTarget(ARG)
    ENDIF
CASE 0
    PRINTFORML %PARSE("You choose",,,ARG)% to give up and \@ IsDiapered(ARG) ? use %PARSE("your",5,,ARG)% diaper # soil %PARSE("yourself",,,ARG)%\@...
    RETURN 99
ENDSELECT
PRINTL
SETCOLOR C_YELLOW
PRINTFORML ★★Omorashi No Gacha★★
RESETCOLOR
PRINTFORML .
PRINTFORM ★Excretion Youjutsu: 
CALL PRINT_RANK(YoujutsuLevel:ARG:18,"MAX_6")
PRINTFORM  {YoujutsuLevel:ARG:18}
PRINTL
PRINTFORML ..
PRINTFORML ★EPL: %TOSTR_EPL(EffectivePottyLevel(ARG))% {EffectivePottyLevel(ARG)}
PRINTFORML ...
IF STRLENS(wsfGood) || STRLENS(wsfBad)
    IF STRLENS(wsfGood)
        SETCOLOR C_GREEN
        PRINTFORML ★%LIST_IN_STRING(wsfGood,,", ")%
        RESETCOLOR
    ENDIF
    IF STRLENS(wsfBad)
        SETCOLOR C_RED
        PRINTFORML ★%LIST_IN_STRING(wsfBad,,", ")%
        RESETCOLOR
    ENDIF
    PRINTFORML ....
ENDIF

FOR LOCAL,0,VARSIZE("wsfOdds")
    SETCOLOR wsfRollColors:LOCAL
    PRINTFORM ★%wsfRollLabel:LOCAL%: 
    PRINTFORML {wsfProbs:LOCAL/10}.{wsfProbs:LOCAL%10}\%
    ; IF wsfOdds:LOCAL <= 0
    ;     PRINTFORML ∞/1
    ; ELSE
    ;     PRINTFORML {(1000*wsfOdds:LOCAL)/wsfTotal}/{wsfTotal}
    ;     ; PRINTFORML {1001-wsfOdds:LOCAL}/1
    ; ENDIF
NEXT
RESETCOLOR
REPEAT wsfMaxRolls
    PRINTFORMSL (" "*34)+"↓"
    FOR LOCAL,25,-25,-1
        IF iNRANGE(COUNT % wsfSize+LOCAL,0,wsfSize-1)
            LOCAL:1 = (COUNT % wsfSize)+LOCAL
        ELSE
            ; LOCAL:1 = wsfSize-1
            LOCAL:1 = wsfSize-LOCAL
        ENDIF
        SELECTCASE wsfEntries:(SHAFFLE_ARRAY:(LOCAL:1))
        CASE 0
            SETCOLOR C_GREEN
        CASE 1
            SETCOLOR C_YELLOW
        CASE 2
            SETCOLOR C_ORANGE
        CASE 3
            SETCOLOR C_RED
        CASE 4
            SETCOLOR C_D_RED
        CASE 99
            SETCOLOR C_GRAY
        ENDSELECT
        PRINTFORM %UNICODE(0x2585)%
        RESETCOLOR
    NEXT
    PRINTL
    PRINTFORMSL (" "*34)+"↑"
    SELECTCASE wsfMaxRolls-COUNT
    CASE IS > 31
        TWAIT 10, 1
    CASE IS > 7
        TWAIT 50, 1
    CASE IS > 3
        TWAIT 250, 1
    CASE IS > 0
        TWAIT 500, 1
    CASE 1
        TWAIT 1000, 1
    ENDSELECT
    TWAIT 20, 1
    SIF COUNT != wsfMaxRolls && COUNT != wsfMaxRolls-1
        CLEARLINE 3
    IF COUNT % wsfSize == 0
        CALL FISHER_YATES_SHAFFLE(wsfSize)
    ENDIF
REND
LOCAL:6 = wsfEntries:(SHAFFLE_ARRAY:((COUNT-1) % wsfSize))
IF LOCAL:6 == 0 && ARG == MASTER
    SIF wsfProbs:0 <= 10
        CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("omoGachaSSRPull")
    SIF ImminentAccident_FailurePity >= 12
        CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("omoGachaHardPity")
ENDIF

RETURN wsfEntries:(SHAFFLE_ARRAY:((COUNT-1) % wsfSize))

