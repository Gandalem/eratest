@ImminentAccident_PickRedirectionTarget(ARG,HasPiss,HasScat)
#FUNCTION
#DIM DYNAMIC characterList,キャラクタ数上限
#DIM DYNAMIC characterPriority,キャラクタ数上限
#DIM DYNAMIC characterIndex
#DIM DYNAMIC canHoldWaste
#DIM HasPiss
#DIM HasScat

;will continue a redirection chain
SIF ImminentAccident_RedirectionCaster > -1
    RETURNF  ImminentAccident_RedirectionCaster
IF GET_TARGETNUM() == 1
    ;if only you and the target are in the same place
    ;always target MASTER
    RETURNF MASTER
ELSE
    ;getting all characters in area
    FOR LOCAL,0,CHARANUM
        IF CFLAG:LOCAL:300 == CFLAG:ARG:300
            SIF IsDead:LOCAL:0
                CONTINUE
            SIF LOCAL == ARG
                CONTINUE
            canHoldWaste = 0
            characterList:characterIndex = LOCAL
            IF LOCAL == MASTER
            characterPriority:characterIndex = 3000
            ELSE
            characterPriority:characterIndex = 1000
            ENDIF
            SIF !SHIRAHU(LOCAL)
                characterPriority:characterIndex += 3000
            SIF RELATION:ARG:LOCAL
                characterPriority:characterIndex += (100*(100-(RELATION:ARG:LOCAL)))    
            SIF LOCAL == MASTER && HasFallState(ARG)
                TIMES characterPriority:characterIndex, 0.7
            ;if bladder can fit 
            IF HasScat
                SIF DiapePooCharges:LOCAL:0 >= (BASE:LOCAL:Poo + BASE:ARG:Poo)
                    canHoldWaste = 2
                SIF BASE:LOCAL:Poo + BASE:ARG:Poo > (MAXBASE:LOCAL:Poo*12/10)
                    canHoldWaste = 1
            ELSEIF HasPiss
                SIF DiapeCharges:LOCAL:0 >= (BASE:LOCAL:4 + BASE:ARG:4)
                    canHoldWaste = 2
                SIF BASE:LOCAL:4 + BASE:ARG:4 > (MAXBASE:LOCAL:4*12/10)
                    canHoldWaste = 1
            ENDIF
            

            IF canHoldWaste == 1
                ;bladder can fit
                    characterPriority:characterIndex += 5000
            ELSEIF canHoldWaste == 2
                ;diaper can fit
                    characterPriority:characterIndex += 5000
            ENDIF


            characterIndex++
        ENDIF
    NEXT
    RETURNF characterList:ARRAY_HIT(characterPriority, characterIndex+1)

    ;leaky/messy legend NPC wants to make you mess

    ;if she knoes you aren't potty trained she'll rub it in.
ENDIF