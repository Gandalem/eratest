@ImminentAccident_SpellChance(ARG,HasPiss,HasScat,scSpell)
#DIM DYNAMIC scSpell
#DIM DYNAMIC scWeights,5
#DIM DYNAMIC HasPiss
#DIM DYNAMIC HasScat
#DIMS DYNAMIC scModReason,2
VARSET scWeights, 1000
VARSET RESULT
VARSET RESULTS

;youjutsu level
; Casting skill: :check:
SELECTCASE scSpell
CASE 1
    ;TSP Relief
    SELECTCASE MAXBASE:ARG:TSP
    CASE IS >= 64000
        scWeights = 3000, 0, 0, 0, 10
    CASE IS >= 32000
        scWeights = 2500, 20, 10, 10, 40
    CASE IS >= 16000
        scWeights = 2000, 50, 25, 10, 70
    CASE IS >= 8000
        scWeights = 1500, 50, 25, 10, 180
    CASE IS >= 4000
        scWeights = 1000, 50, 25, 10, 300
    CASE IS >= 2500
        scWeights = 700, 80, 50, 100, 500
    CASE IS >= 1500
        scWeights = 500, 90, 90, 180, 650
    CASE IS >= 800
        scWeights = 100, 100, 150, 200, 700
    CASE IS >= 500
        scWeights = 45, 100, 170, 220, 700
    CASEELSE
        scWeights = 10, 100, 200, 300, 800
    ENDSELECT
CASE 2
    ;Aphedron
    SELECTCASE YoujutsuLevel:ARG:18
    CASE IS >= 10
        ;QuadUltra
        scWeights = 3000, 0, 0, 0,  10
    CASE 9
        ;TriUltra
        scWeights = 2500, 20, 10, 10, 40
    CASE 8
        ;OverDrive
        scWeights = 2000, 50, 25, 10, 70
    CASE 7
        ;Phantasm
        scWeights = 1500, 50, 25, 10, 180
    CASE 6
        ;Extra
        scWeights = 1000, 50, 25, 10, 300
    CASE 5
        ;S
        scWeights = 700, 80, 50, 100, 500
    CASE 4
        ;A
        scWeights = 500, 90, 90, 180, 650
    CASE 3
        ;B
        scWeights = 100, 100, 150, 200, 700
    CASE 2
        ;C
        scWeights = 45, 100, 170, 220, 700
    CASE IS < 2
        ;D/E/G
        scWeights = 10, 100, 200, 300, 800
    ENDSELECT
CASE 3
    ;waste redirection
    ;this is a G rank skill
    SELECTCASE YoujutsuLevel:ARG:18
    CASE IS >= 10
        ;QuadUltra
        scWeights = 6000, 0, 0, 0, 10
    CASE 9
        ;TriUltra
        scWeights = 3000, 0, 0, 0, 10
    CASE 8
        ;OverDrive
        scWeights = 2500, 20, 10, 10, 40
    CASE 7
        ;Phantasm
        scWeights = 2000, 50, 25, 10, 70
    CASE 6
        ;Extra
        scWeights = 1500, 50, 25, 10, 180
    CASE 5
        ;S
        scWeights = 1000, 50, 25, 10, 300
    CASE 4
        ;A
        scWeights = 700, 80, 50, 100, 500
    CASE 3
        ;B
        scWeights = 500, 90, 90, 180, 650
    CASE 2
        ;C
        scWeights = 100, 100, 150, 200, 700
    CASE 1
        ;D
        scWeights = 45, 100, 170, 220, 700
    CASE 0
        ;G
        scWeights = 10, 100, 200, 300, 800
    ENDSELECT
ENDSELECT

; Continence of self :check:
SELECTCASE EffectivePottyLevel(ARG)
CASE IS > 5
    scWeights:0 += (300*EffectivePottyLevel(ARG))
CASE 5
    scWeights:0 += 1500
CASE 4
    scWeights:0 += 970
CASE 3
    scWeights:0 += 640
CASE 2
    scWeights:0 += 230
CASE 1
    scWeights:0 += 100
CASE -1
    scWeights:4 += 250
CASE -2
    scWeights:4 += 470
CASE -3
    scWeights:4 += 950
CASE -4
    scWeights:4 += 1400
CASE IS <= -5
    scWeights:4 += 2000
ENDSELECT

; Pottypants or no :check:
IF HasScat
    IF GETBIT(TALENT:ARG:OmoGuardian,1)
        scModReason:1 += "Messy Legend、"
        scWeights:4 += 750
    ELSE
        scWeights:4 += (35*ABL:ARG:PooAddict)
    ENDIF
ELSE
    IF GETBIT(TALENT:ARG:OmoGuardian,0)
        scModReason:1 += "Leaky Legend、"
        scWeights:4 += 750
    ELSE
        scWeights:4 += (35*ABL:ARG:PeeAddict)
    ENDIF
ENDIF

;Diapered or not :check:
IF IsDiapered(ARG)
    scModReason:1 += "Diapered、"
    IF GETBIT(TALENT:ARG:OmoGuardian,2)
        scWeights:4 += 750
    ELSE
        scWeights:4 += 450
    ENDIF
ENDIF

IF HasScat
; What if the PC is under a laxative
    IF DrugStats:ARG:LaxativeTime
        scModReason:0 += "Laxative、"
        scWeights:4 += 750
    ENDIF
    IF DrugStats:ARG:EnemaTime
        ;anal obstructed should make this affect characters less 
        scModReason:1 += "Enema、"
        scWeights:4 += 1200
    ENDIF
; or has IBS/blort prone
    IF HasIBS(ARG)
        scModReason:1 += "Irritable bowel syndrome、"
        scWeights:4 += 750
        ;IBS Flaring Up!!!!!
    ENDIF
ENDIF

IF HasPiss
; What if the PC is under a diuretic
    IF TCVAR:ARG:141
        scModReason:1 += "Diuretic、"
        scWeights:4 += 750
    ENDIF
; overactive bladder
    IF HasOAB(ARG)
        scModReason:1 += "Overactive bladder、"
        scWeights:4 += 750
        ;oab flare could make it harder to hold
        ;i need to make an oae flare hediff first though
    ENDIF
ENDIF

IF AL_IS_CLAIMED("omoGachaSSRPull")
    ;SSR LUCK!
    scModReason:0 += "SSR Luck!!!、"
    scWeights:0 += 1000
    ;could make this random
    ;free 777 bonus weight?
ENDIF

IF AL_IS_CLAIMED("omoGachaHardPity")
    ;Hard pity
    scModReason:0 += "Pity Trauma、"
    scWeights:0 += 1000
    ;could make this random
    ;free 777 bonus weight?
ENDIF

IF ImminentAccident_FailurePity && ARG == MASTER
    IF ImminentAccident_FailurePity >= 12
    ;hard pity
        scModReason:0 += @"Pity: {ImminentAccident_FailurePity}x (HARD PITY)、"
        scWeights:0 += 100000000
    ELSE
    ;soft pity
        scModReason:0 += @"Pity: {ImminentAccident_FailurePity}x、"
        scWeights:0 += 350*ImminentAccident_FailurePity
    ENDIF
ENDIF

IF ImminentAccident_RedirectionChain
