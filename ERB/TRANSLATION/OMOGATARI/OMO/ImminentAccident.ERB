; New menu: Immiment Accident Settings
; - Toggle on-person protections such as diapers, catheter systems when sleeping
;      - Chose between different levels of protection as well 
; - Change between different bed pads: Unimu Wanwanman (disposable), Play mat (resuable light), Gensou-chan Last Line (resusable heavy) 
; - Toggle the bedwetting alarm
; - Prioritze between waking up to stay dry or to keep sleeping and risk a bedwetting incident. 
; - Auto-take dream drops (more lucid dreams) or dream suppressants (less lucid dreams)
; - Auto-take diuretics, laxatives, antidiurethics, antidiarrheals, water, to change bedwetting chance
; - Auto-masturbate before bed is moved here
;===========================================
;★★Imminent Accident Settings★★
;When you're about to have an accident...

; [ 0] - Acicdent (4th): Pee/poop in your underwear
; [ 1] - TSP Relief (2nd): Use TSP to relieve yourself on the spot.
; [ 2] - Aphedron (1st): Use MP to empty your bladder and bowels.
; [ 3] - Waste Diversion (3rd): Use MP to divert your excretions to another person.
; Yell and get the attention of everyone. 
; [ 4] - Ask the player before an accident: Yes
;
; Current Priority
; 「Aphedron」 -> 「TSP Relief」 -> 「Waste Diversion」 -> 「Acicdent」

; [100] - Return
;===========================================
@ImminentAccidentSettings
#DIMS CONST iasLabel = "Accident", "TSP Relief", "Aphedron", "Waste Diversion"
{
#DIMS CONST iasDesc =
"Give up and soil your underwear.", 
"Use TSP to relieve yourself on the spot.",
"Use MP to empty your bladder and bowels.",
"Use MP to divert your excretions to another person."
}
#DIM DYNAMIC iasLineCount,2
#DIM DYNAMIC iasInput
#DIM DYNAMIC iasCanSpell
SIF MAXBASE:MASTER:TSP >= 350
    SETBIT iasCanSpell, 1
CALL YoujutsuMagicCanDo(MASTER,18,28)
SIF RESULT
    SETBIT iasCanSpell, 2
CALL YoujutsuMagicCanDo(MASTER,18,37)
SIF RESULT
    SETBIT iasCanSpell, 3
FONTBOLD
SETCOLOR C_YELLOW
PRINTFORML ★★Imminent Accident Settings★★
RESETCOLOR
FONTREGULAR
iasLineCount = LINECOUNT
DO
CLEARLINE LINECOUNT-iasLineCount
IF iasCanSpell
    PRINTFORML When you're about to have an accident...
    FOR LOCAL,0,VARSIZE("iasLabel")
        SIF LOCAL && !GETBIT(iasCanSpell,LOCAL)
            CONTINUE
        IF FINDELEMENT(ImminentAccidentSettings_Priority,LOCAL) == -1
            LOCALS:0 '= "(Off)"
        ELSE
            LOCALS:0 '= @"(%ORDINAL(FINDELEMENT(ImminentAccidentSettings_Priority,LOCAL)+1)%)"
        ENDIF
        PRINTFORML [{LOCAL,2}] %iasLabel:LOCAL% %LOCALS:0% - %iasDesc:LOCAL%
    NEXT
    PRINTL
    PRINTFORML [20] Ask the player before an accident: %YesOrNo(ImminentAccidentSettings_AskPlayer)%
    SIF GETBIT(iasCanSpell,3)
        PRINTFORML [21] Chain redirections if you've been redirected: %YesOrNo(ImminentAccident_AutoRedirect)%
    PRINTL
    SETCOLOR C_YELLOW
    PRINTFORML Current Priority:
    RESETCOLOR
    FOR LOCAL,0,VARSIZE("iasLabel")
        SIF ImminentAccidentSettings_Priority:LOCAL > 0 && !GETBIT(iasCanSpell,ImminentAccidentSettings_Priority:LOCAL)
            CONTINUE
        SIF ImminentAccidentSettings_Priority:LOCAL == -1
            CONTINUE
        PRINTFORM 「%iasLabel:(ImminentAccidentSettings_Priority:LOCAL)%」
        IF LOCAL+1 > VARSIZE("ImminentAccidentSettings_Priority")-1
        ELSEIF ImminentAccidentSettings_Priority:(LOCAL+1) == -1
        ELSE
            PRINTFORMS " -> "
        ENDIF
    NEXT
    PRINTL
ELSE
    PRINTFORML You don't have any spells, so having an accident is your only choice...
ENDIF
PRINTL
PRINTFORML [100] - Return
INPUT
iasInput = RESULT
SELECTCASE iasInput
CASE 0 TO VARSIZE("iasLabel")-1
    iasLineCount:1 = LINECOUNT
    DO
        CLEARLINE LINECOUNT-(iasLineCount:1)
        PRINTFORML Changing priority of %iasLabel:iasInput%.
        FOR LOCAL,0,VARSIZE("iasLabel")
            PRINTFORML [{LOCAL,2}] Set to %ORDINAL(LOCAL+1)% (currently \@ ImminentAccidentSettings_Priority:LOCAL > -1 ? %iasLabel:(ImminentAccidentSettings_Priority:LOCAL)% # nothing\@)
            IF ImminentAccidentSettings_Priority:LOCAL == -1
                IF LOCAL >= VARSIZE("iasLabel")-1
                    BREAK
                ELSEIF ImminentAccidentSettings_Priority:(LOCAL+1) == -1
                    BREAK
                ENDIF
            ENDIF
        NEXT
        PRINTFORML [-250] Disable
        PRINTL
        PRINTFORML [-999] Exit
        INPUT
        LOCAL:0 = RESULT
        LOCAL:1 = FINDELEMENT(ImminentAccidentSettings_Priority,iasInput)
        SELECTCASE LOCAL:0
        CASE 0 TO VARSIZE("iasLabel")-1
            IF LOCAL == FINDELEMENT(ImminentAccidentSettings_Priority,iasInput)
                CONTINUE
            ELSEIF ImminentAccidentSettings_Priority:LOCAL == -1
                IF LOCAL:1 > -1
                    PRINTFORMW Already in the priority list.
                    CONTINUE
                ENDIF
                ImminentAccidentSettings_Priority:LOCAL = iasInput
            ELSE
                IF LOCAL:1 == -1
                    ; FOR LOCAL:2, LOCAL:0, VARSIZE("iasLabel")-1
                    ;     SIF ImminentAccidentSettings_Priority:(LOCAL:2+1) == -1
                    ;         BREAK
                    ;     ImminentAccidentSettings_Priority:(LOCAL:2+1) = ImminentAccidentSettings_Priority:(LOCAL:2) 
                    ; NEXT
                    ARRAYSHIFT ImminentAccidentSettings_Priority, 1, iasInput
                    SWAP ImminentAccidentSettings_Priority:(0), ImminentAccidentSettings_Priority:(LOCAL)

                    ; ImminentAccidentSettings_Priority:LOCAL = iasInput
                ELSE
                    SWAP ImminentAccidentSettings_Priority:(LOCAL:1), ImminentAccidentSettings_Priority:(LOCAL)
                ENDIF
            ENDIF
        CASE -250
            IF RESULT == -250 && iasInput == 0
                PRINTFORMW You can't turn off having an accident!
                CONTINUE
            ENDIF
            ImminentAccidentSettings_Priority:(LOCAL:1) = -1
            FOR LOCAL:2, LOCAL:1, VARSIZE("iasLabel")-1
                ImminentAccidentSettings_Priority:(LOCAL:2) = ImminentAccidentSettings_Priority:(LOCAL:2+1) 
            NEXT

        CASE -999
            BREAK
        ENDSELECT
    LOOP 1
CASE 20
    ImminentAccidentSettings_AskPlayer = !ImminentAccidentSettings_AskPlayer
CASE 21
    ImminentAccident_AutoRedirect = !ImminentAccident_AutoRedirect
CASE 100
RETURN
ENDSELECT
LOOP 1

