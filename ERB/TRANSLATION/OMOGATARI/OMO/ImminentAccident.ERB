@WasteRedirection(theCulprit,theVictim,redirectMult=-1)
#DIM DYNAMIC theCulprit
#DIM DYNAMIC theVictim
#DIM DYNAMIC redirectMult
IF redirectMult == -1
	IF ACCIDENT_BLADDER_STORAGE:1 == 0 && ACCIDENT_BOWEL_STORAGE:1 == 0
		redirectMult = 100
	ELSE
		redirectMult = MAX(100*ACCIDENT_BOWEL_STORAGE:1/MAX(ACCIDENT_BOWEL_STORAGE,1),100*ACCIDENT_BLADDER_STORAGE:1/MAX(ACCIDENT_BLADDER_STORAGE,1))
	ENDIF
ENDIF
PRINTFORML %PARSE("You redirect your",,,theCulprit)%는 %PARSE("you",,,theVictim)%로 폐기물을 보낸다.
PRINTW
BASE:theVictim:4 += redirectMult == 100 ? BASE:theCulprit:4 # (BASE:theCulprit:4*(redirectMult))/100
BASE:theVictim:Poo += redirectMult == 100 ? BASE:theCulprit:Poo # (BASE:theCulprit:Poo*(redirectMult))/100
BASE:theCulprit:4 = redirectMult == 100 ? 0 # (BASE:theCulprit:4*(redirectMult))/100
BASE:theCulprit:Poo = redirectMult == 100 ? 0 # (BASE:theCulprit:Poo*(redirectMult))/100
ImminentAccident_RedirectionChain++
IF PeeBarStage(theVictim) >= 7|| PooBarStage(theVictim) >= 7
	; You can't cope with the sudden amount of pee filling your bladder and has to let go.
	; You move your legs apart and let go.
	PRINTFORML %PARSE("You",,,theVictim)%은 갑자기 늘어난 양의 \@ PooBarStage(theVictim) >= 7 ? %SCAT(theVictim)% # %URINE(theVictim)% \@ filling %PARSE("your",5,,theVictim)% \@ PooBarStage(theVictim) >= 7 ? 장 # 방광 \@에 대처할 수 없었다.
	CALL NeedForPee(theVictim)
ENDIF

@ImminentAccident_PickRedirectionTarget(ARG,HasPiss,HasScat)
#FUNCTION
#DIM DYNAMIC characterList,キャラクタ数上限
#DIM DYNAMIC characterPriority,キャラクタ数上限
#DIM DYNAMIC characterIndex
#DIM DYNAMIC canHoldWaste
#DIM HasPiss
#DIM HasScat
;will continue a redirection chain
SIF ImminentAccident_RedirectionCaster > -1
	RETURNF  ImminentAccident_RedirectionCaster
IF GET_TARGETNUM() == 1
	;if only you and the target are in the same place
	;always target MASTER
	RETURNF MASTER
ELSE
	;getting all characters in area
	FOR LOCAL,0,CHARANUM
	IF CFLAG:LOCAL:300 == CFLAG:ARG:300
		SIF IsDead:LOCAL:0
			CONTINUE
		SIF LOCAL == ARG
			CONTINUE
		canHoldWaste = 0
		characterList:characterIndex = LOCAL
		IF LOCAL == MASTER
			characterPriority:characterIndex = 3000
		ELSE
			characterPriority:characterIndex = 1000
		ENDIF
		SIF !SHIRAHU(LOCAL)
			characterPriority:characterIndex += 3000
		SIF RELATION:ARG:LOCAL
			characterPriority:characterIndex += (100*(100-(RELATION:ARG:LOCAL)))
		SIF LOCAL == MASTER && HasFallState(ARG)
			TIMES characterPriority:characterIndex, 0.7
		;if bladder can fit
		IF HasScat
			SIF DiapePooCharges:LOCAL:0 >= (BASE:LOCAL:Poo + BASE:ARG:Poo)
				canHoldWaste = 2
			SIF BASE:LOCAL:Poo + BASE:ARG:Poo > (MAXBASE:LOCAL:Poo*12/10)
				canHoldWaste = 1
		ELSEIF HasPiss
			SIF DiapeCharges:LOCAL:0 >= (BASE:LOCAL:4 + BASE:ARG:4)
				canHoldWaste = 2
			SIF BASE:LOCAL:4 + BASE:ARG:4 > (MAXBASE:LOCAL:4*12/10)
				canHoldWaste = 1
		ENDIF
		IF canHoldWaste == 1
			;bladder can fit
			characterPriority:characterIndex += 5000
		ELSEIF canHoldWaste == 2
			;diaper can fit
			characterPriority:characterIndex += 5000
		ENDIF
		characterIndex++
	ENDIF
	NEXT
	RETURNF characterList:ARRAY_HIT(characterPriority, characterIndex+1)
	;leaky/messy legend NPC wants to make you mess
	;if she knoes you aren't potty trained she'll rub it in.
ENDIF
