SIF RESULT
    RETURN 0
CALL PREF_UNDERWEAR_BRAND(ARGS)
SIF RESULT
    RETURN 0
CALL PREF_UNDERWEAR_MATER(ARGS)
SIF RESULT
    RETURN 0



RETURN 1


