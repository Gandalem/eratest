@PREF_UNDERWEAR_BRAND(ARGS)
#DIMS PFB_STR,2
SELECTCASE ARGS
CASEELSE
    PFB_STR:0 '= ALL_BRANDS_NAMES(ARGS,0)
    ;got brand
    IF ARGS != PFB_STR:0 
    RETURN 1
    ENDIF
ENDSELECT
RETURN 0

@PREF_UNDERWEAR_OTHER(ARGS)
