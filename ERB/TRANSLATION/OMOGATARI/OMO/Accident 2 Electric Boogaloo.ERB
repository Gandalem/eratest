@ACCIDENT_CONSCIOUS(ARG)
#FUNCTION
SIF ((!CFLAG:ARG:睡眠 && BASE:ARG:体力 > 0) || ARG == MASTER)
    RETURNF 1

@ACCIDENT_SHOW_BAR_RELIEVE()
#DIM DYNAMIC ACCIDENT_HAS_WETNESS_INDICATOR
#DIM ASBR_LINECOUNT
#DIM ASBR_MitigateMax = 0, 99, 75, 40, 0, 0 
#DIM ASBR_MitigateMin = 0, 85, 60, 20, 0, 0 
#DIM DYNAMIC ASBR_INTERRUPT
#DIM DYNAMIC ASBR_FailLevel
; #DIM DYNAMIC ASBR_ExcretoryMult,2
SIF MESSKIP()
    RETURN

ACCIDENT_HAS_WETNESS_INDICATOR = PANTY_HAS_WETNESS_INDICATOR(EQUIP:ACCIDENT_CHARA:6)
VARSET ACCIDENT_BLADDER_STORAGE
VARSET ACCIDENT_BOWEL_STORAGE
ASBR_FailLevel = ImminentAccident_SpellFailureLevel
SIF ASBR_FailLevel == 99
    ASBR_FailLevel = 0

;toileting
IF ACCIDENT_Nude == 2
    IF ACCIDENT_HasPiss
        SELECTCASE PeeBarStage(ACCIDENT_CHARA)
        CASE IS >= 6
            PLAYSOUND "peestuffs/pee/尿意レベル3.m4a"
        CASE IS >= 4
            PLAYSOUND "peestuffs/pee/尿意レベル2.m4a"
        CASE IS >= 2
            PLAYSOUND "peestuffs/pee/尿意レベル1.m4a"
        ENDSELECT
    ENDIF
     SIF ACCIDENT_HasScat
        PLAYSOUND "peestuffs/poo/U_omorashi.m4a"
    ;     PLAYSOUND "peestuffs/poo/messy1.wav"
    ; IF ACCIDENT_HasScat
    ;     SELECTCASE PeeBarStage(ACCIDENT_CHARA)
    ;     CASE IS >= 6
    ;         PLAYSOUND "peestuffs/pee/尿意レベル3.m4a"
    ;     CASE IS >= 4
    ;         PLAYSOUND "peestuffs/pee/尿意レベル2.m4a"
    ;     CASE IS >= 2
    ;         PLAYSOUND "peestuffs/pee/尿意レベル1.m4a"
    ;     ENDSELECT
    ; ENDIF
ELSE
    IF ACCIDENT_HasScat
        IF IsPadded(ACCIDENT_CHARA) && !ACCIDENT_Nude
            PLAYSOUND "peestuffs/poo/U_omorashi_diaper01.m4a"
        ELSE
            PLAYSOUND "peestuffs/poo/U_omorashi.m4a"
        ENDIF
    ENDIF
    IF ACCIDENT_HasPiss
        IF IsPadded(ACCIDENT_CHARA) && !ACCIDENT_Nude
            PLAYSOUND "peestuffs/pee/おむつおもらしスタンダード.m4a"
        ELSE
            PLAYSOUND "peestuffs/pee/おもらし1.m4a"
        ENDIF
    ENDIF
    ;CALL PlayAccidentSound(ACCIDENT_CHARA,ACCIDENT_HasPiss,"loc",0,"loc")
ENDIF

;TWAIT LIMIT(BASE:ARG:Poo*10,1000,15000), 1
ACCIDENT_BOWEL_STORAGE = BASE:ACCIDENT_CHARA:Poo
C:1 = PooBarStage(ACCIDENT_CHARA)
C:2 = 45
SIF C:1 >= 4
    C:2 = 20
SIF C:1 >= 6
    C:2 = 8
ACCIDENT_BLADDER_STORAGE = BASE:ACCIDENT_CHARA:4
D:1 = PeeBarStage(ACCIDENT_CHARA)
D:2 = 4
SIF D:1 >= 4
    D:2 = 3
I = DiapeCharges:ACCIDENT_CHARA:0
I:1 = DiapePooCharges:ACCIDENT_CHARA:0
ASBR_LINECOUNT = LINECOUNT
WHILE 1
    SIF (!ACCIDENT_HasScat || BASE:ACCIDENT_CHARA:Poo <= 0) && (!ACCIDENT_HasPiss || BASE:ACCIDENT_CHARA:4 <= 0)
        BREAK
    ;has pee
    GETMILLISECOND
    X = RESULT
    IF ACCIDENT_HasPiss
        IF X % D:2 == 0 && BASE:ACCIDENT_CHARA:4 > 0
            D:3 = RAND(MAXBASE:ACCIDENT_CHARA:4*1/100,MAXBASE:ACCIDENT_CHARA:4*2/100)
            BASE:ACCIDENT_CHARA:4 -= (D:3)
            DiapeCharges:ACCIDENT_CHARA:0 -= (D:3)
        ENDIF
        CALL PeeBar(ACCIDENT_CHARA, 20, 1)
    ENDIF
    IF ACCIDENT_HasScat
        IF X % C:2 == 0 && BASE:ACCIDENT_CHARA:Poo > 0
            C:3 = RAND(MAXBASE:ACCIDENT_CHARA:Poo*10/100,MAXBASE:ACCIDENT_CHARA:Poo*15/100)
            BASE:ACCIDENT_CHARA:Poo -= (C:3)
            DiapePooCharges:ACCIDENT_CHARA:0 -= (C:3)
        ENDIF
        CALL PooBar(ACCIDENT_CHARA, 20, 1)
    ENDIF
    PRINTL
    IF ACCIDENT_HAS_WETNESS_INDICATOR && ACCIDENT_Nude == 2
        HTML_PRINT @"%PeeandPoo(ACCIDENT_HasPiss,ACCIDENT_HasScat, ACCIDENT_WETNESS_INDICATOR(ACCIDENT_CHARA, 1), ACCIDENT_WETNESS_INDICATOR(ACCIDENT_CHARA, 2), " ")%"
    ENDIF
    PRINTFORML [1] - Skip
    ;TWAIT 1, 1
    TINPUT 1, 0, 0
    SELECTCASE RESULT
    CASE 1
        ASBR_INTERRUPT = 1
        BREAK
    ENDSELECT
    IF GROUPMATCH(ImminentAccident_SpellCast,1,2,3) && ASBR_MitigateMax:ASBR_FailLevel && (X % D:2 == 0)
        IF MAX(BASE:ACCIDENT_CHARA:4*100/MAXBASE:ACCIDENT_CHARA:4,BASE:ACCIDENT_CHARA:Poo*100/MAXBASE:ACCIDENT_CHARA:Poo) <= ASBR_MitigateMin:ASBR_FailLevel
            ASBR_INTERRUPT = 2 
        ELSEIF MAX(BASE:ACCIDENT_CHARA:4*100/MAXBASE:ACCIDENT_CHARA:4,BASE:ACCIDENT_CHARA:Poo*100/MAXBASE:ACCIDENT_CHARA:Poo) <= ASBR_MitigateMax:ASBR_FailLevel
            ASBR_INTERRUPT = 2 
        ENDIF
        SIF ASBR_INTERRUPT == 2
            BREAK
    ENDIF
    CLEARLINE LINECOUNT - ASBR_LINECOUNT
WEND
STOPSOUND
IF GROUPMATCH(ImminentAccident_SpellCast,1,2,3) && ASBR_MitigateMax:ASBR_FailLevel && ASBR_INTERRUPT == 1
    ASBR_INTERRUPT = 2
    IF ACCIDENT_HasPiss
        BASE:ACCIDENT_CHARA:4 = MIN(D,RAND(MAXBASE:ACCIDENT_CHARA:4*ASBR_MitigateMin:ASBR_FailLevel/100,MAXBASE:ACCIDENT_CHARA:4*ASBR_MitigateMax:ASBR_FailLevel/100))
    ENDIF
    IF ACCIDENT_HasScat
        BASE:ACCIDENT_CHARA:Poo = MIN(C,RAND(MAXBASE:ACCIDENT_CHARA:Poo*ASBR_MitigateMin:ASBR_FailLevel/100,MAXBASE:ACCIDENT_CHARA:Poo*ASBR_MitigateMax:ASBR_FailLevel/100))
    ENDIF
ENDIF
IF ASBR_INTERRUPT == 2
    ACCIDENT_BLADDER_STORAGE:1 = BASE:ACCIDENT_CHARA:4 
    ACCIDENT_BOWEL_STORAGE:1 = BASE:ACCIDENT_CHARA:Poo
    ; IF ACCIDENT_HasPiss
    ;     C = BASE:ACCIDENT_CHARA:4
    ; ENDIF
    ; IF ACCIDENT_HasScat
    ;     D = BASE:ACCIDENT_CHARA:Poo
    ; ENDIF
ENDIF

BASE:ACCIDENT_CHARA:Poo = ACCIDENT_BOWEL_STORAGE
BASE:ACCIDENT_CHARA:4 = ACCIDENT_BLADDER_STORAGE
DiapeCharges:ACCIDENT_CHARA:0 = I
DiapePooCharges:ACCIDENT_CHARA:0 = I:1

;ARG: character
;excreteType: type of excretion
;ARG:1 display text
;indicatorType: type of wetness indicator
@ACCIDENT_WETNESS_INDICATOR(ARG,excreteType = 1, ARG:1 = 0, overrideValue = -1, indicatorType = 0)
#FUNCTIONS
#DIMS HTML
#DIM excreteType
#DIM Width
#DIM overrideValue
#DIM indicatorType
VARSET HTML

M:1 = overrideValue > -1 ? overrideValue # SoiledDiaper(ARG,excreteType,1,0)
M:1 = MIN(M:1,100)
IF !ARG:1        
    SELECTCASE excreteType
    CASE 1
    HTML += " WET "
    CASE 2
    HTML += " MESS"
    ENDSELECT
ENDIF
FOR LOCAL,-1,2
    FOR LOCAL:1, 0, 8
        M:5 = (LOCAL:1*6)
        IF !LOCAL
            M:2 = 100
        ELSEIF LOCAL == -1
            M:2 = M:5 + 60
        ELSE
            M:2 = 100 - (M:5)
        ENDIF
        M:2 = LIMIT(M:2,0,100)

        SELECTCASE excreteType
        CASE 1
            ; ;percentage
            ; SELECTCASE M:1
            ; ; CASE IS <= 20
            ; ;     ;yellow
            ; ;     M = 0
            ; ; CASE IS <= 23
            ; ;     ;yellow to green
            ; ;     M = Color_Gradient_PER(0xfffa00,0x7DB049,(M:1-20)*100/3 * M: 2/ 100)
            ; CASE IS <= 30
            ;     ;yellow  to blue
            ;     M:3 = M:1*100/30 * M:2 / 100
            ;     M:4 = 3
            ; CASEELSE
            ;     ;fade
            ;     $Pee_Type1_Fade
            ;     M:3 = M:1-30 * M:2 / 100
            ;     M:4 = 4
            ; ENDSELECT

            T = 15
            M:3 = M:1-T
            M:4 = 0
            SIF M:3 <= 0
                GOTO Pee_Type1_SetColors
            
            ;yellow to blue (15 -> 33%)
            M:3 = (M:1-T)*100/15 * M:2 / 100
            M:4 = 3

            IF M:3 > 100
                ;fade
                $Pee_Type1_Fade
                T = 33
                M:3 = (M:1-T)*100/60 * M:2 / 100
                M:4 = 4
            ENDIF

            $Pee_Type1_SetColors
            M:3 = LIMIT(M:3,0,100)
            ;color
            SELECTCASE M:4
            CASE 0
                ;yellow
                M = 0xfffa00
            ; CASE IS <= 23
            ;     ;yellow to green
            ;     M = Color_Gradient_PER(0xfffa00,0x7DB049,(M:1-20)*100/3 * M: 2/ 100)
            CASE 3
                M = Color_Gradient_PER(0xfffa00,0x01688f,M:3)
            ; CASE IS <= 40
            ;     ;yellow  to blue
            ;     M = Color_Gradient_PER(0xfffa00,0x01688f,M:1*100/30 * M:2 / 100)
            CASEELSE
                ;fade
                M = Color_Gradient_PER(0x01688f,0,M:3, 1p1)
            ENDSELECT
        CASE 2
            M:3 = M:1 * M:2 / 100
            M = Color_Gradient_PER(0xffffff,CF_JELLYORPOO(),M:3)
        ENDSELECT

        
        HTML += @"<font color='#%TOSTR(M,"X6")%'>%UNICODE(0x2585)%</font>"

        IF !LOCAL
            BREAK
        ENDIF
    NEXT
NEXT
SIF GROUPMATCH(ARG:1,0,2)
HTML += @" ({M:1,4}\%)"
RETURNF HTML