@RandomUnderwearCheck(ARG,BYPASS,Changee = -1)
#DIM DYNAMIC canWearIt
#DIM DYNAMIC BYPASS
#DIM DYNAMIC nUndies
#DIM DYNAMIC PPCHANGE
#DIM DYNAMIC Changee
#DIMS DYNAMIC PP_DIAP, 30
#DIMS DYNAMIC PP_PADS, 30
#DIM DYNAMIC CHOICE_INPUT, 2
#DIM DYNAMIC PP_SoilingBit
SIF Daily_Lucid_Stats:3 == 27 && DAILY_Lucid_Stats:7 == 3
    RETURN

SIF Changee == -1
    Changee = MASTER

SIF Changee == MASTER && K102_PunishPottyTimeLeft
    RETURN

IF ARG == 102
	FOR LOCAL:1, 0, VARSIZE("IRAI_SLOT")
		IF IRAI_SLOT:(LOCAL:1) == 102104
			RETURN -1
		ENDIF
	NEXT
ENDIF

;soiling bits
IF SoiledDiaper(Changee,2,,15)
    ;poop
    PP_SoilingBit = 2
ELSEIF SoiledDiaper(Changee,1,,33)
    ;liquids
    SELECTCASE DOMINANT_LIQUID_SOIL(Changee)
    CASE 1
    ;menstural blood
        PP_SoilingBit = 3
    CASE 2, 3
        PP_SoilingBit = 4
    CASEELSE
    ;urine
        PP_SoilingBit = 1
    ENDSELECT
ELSEIF !UnderwearOffPoints(Changee) && !PadOffPoints(Changee) && !CANT_UNDIES(Changee)
    ;bad undies
    PP_SoilingBit = 10
ENDIF

SELECTCASE BYPASS
CASE 1
	GOTO BYPAS
CASE 2
	GOTO BYPAS2
CASE 3
	GOTO DiaperChange
ENDSELECT

LOCAL:1 = SoiledFindOutChance(Changee)

IF RAND(1000) < LOCAL:1 && nPantyPunish
	$BYPAS
    CALL INTERACTIVE_TUTORIAL_GET(102,403,"Diaper Checks",6)
	PRINTL  
	PRINTFORMW %PARSE("You find",,,ARG)% %PARSE("you",,,Changee)% suspicious and %PARSE("do",,,ARG)% a \@ nOmutsu ? diaper # underwear\@ check on %PARSE("you",6,,Changee)%...
	SIF Changee == MASTER
    CALL KOJO_MESSAGE_SEND("EVENT",100,ARG,PP_SoilingBit,90)
    IF ARG == MASTER
        CHOICE_INPUT:1 = 1
    ELSEIF Changee == MASTER
        CHOICE_INPUT:1 = 0
        LOCAL = TALENT:Changee:ぱんつ密輸
        {
        CALL ASK_M(
            @"Comply to check", 1, 
            @"Lie ({MIN(ABL:ARG:話術技能,20)} Speech to pass)", 1,
            @"Deceive%COND_STR(@" (Requires【%GET_TALENTNAME_TR(158,1)%】)", !TALENT:MASTER:ぱんつ密輸)%", TALENT:MASTER:ぱんつ密輸,
            @"【TSP Change】 (350 TSP)", AL_IS_CLAIMED("lucidEV3BeatHypermesser") && BASE:MASTER:TSP >= 350 
            )
        }
        CHOICE_INPUT = RESULT
    ENDIF
    PRINTFORMW 
	PRINTFORMW 
	PRINTFORMW
    SELECTCASE CHOICE_INPUT:1
    CASE 0
        SELECTCASE CHOICE_INPUT
        CASE 0
        CASE 1
            PRINTFORML But you lie by telling %HIM_HER(ARG)% that you're clean and don't need a check.
            IF ABL:Changee:話術技能 >= MIN(ABL:ARG:話術技能,20)
            PRINTFORML %CALLNAME:ARG% is convinced and leaves.
            RETURN -1
            ELSE
            PRINTFORML %CALLNAME:ARG% says that you're bluffing and that you need to be checked.
            ENDIF
        CASE 2
            IF RAND:10
                PRINTFORMW But %PARSE("you",6,,Changee)% skillfully %PARSE("deceive",,,Changee)% %PARSE("you",5,,ARG)%.
                RETURN -1
            ENDIF
        ENDSELECT
    CASE 1
        IF RAND(1000) <= NDD_THRESHOLD(Changee) || SignificantRelationship(Changee)
        ELSE
            PRINTFORMW But %CALLNAME:Changee% starts to resist!
            {
            CALL ASK_M(
                @"Give up", 1, 
                @"Convince %HIM_HER(Changee)% ({MIN(ABL:Changee:話術技能*5,20)} Speech to pass)", 1,
                @"Sneakily check%COND_STR(@" (Requires【%GET_TALENTNAME_TR(158,1)%】)", !TALENT:MASTER:ぱんつ密輸)%", TALENT:MASTER:ぱんつ密輸
                )
            }
            CHOICE_INPUT = RESULT
            SELECTCASE CHOICE_INPUT
            CASE 0
            PRINTFORMW You give up on %CALLNAME:Changee% for now.
            RETURN -1
            CASE 1
                PRINTFORML You tell %HIM_HER(Changee)% that %HE_SHE(Changee)% needs to be checked.
                IF ABL:ARG:話術技能 >= MIN(ABL:Changee:話術技能,20)
                PRINTFORML %CALLNAME:Changee% blushes in embarrassment as %HE_SHE(Changee)% lets you check %HIM_HER(Changee)%
                ELSE
                PRINTFORML %CALLNAME:Changee% seems really mad about it.
                PRINTFORMW You give up on %CALLNAME:Changee% for now.
                RETURN -1
                ENDIF
            CASE 2
                IF !RAND:10
                    PRINTFORMW But %PARSE("you",6,,Changee)% skillfully %PARSE("deceive",,,Changee)% %PARSE("you",5,,ARG)%.
                    RETURN -1
                ENDIF
            ENDSELECT
        ENDIF
    CASE 3
        ;Oh no...
        ;Can't shift the blame to anyone else with TSP Change...
        CALL TSP_DIAPER_CHANGE_INIT()
    ENDSELECT
	$BYPAS2
	IF Changee == MASTER
        CALL KOJO_MESSAGE_SEND("EVENT",100,ARG,PP_SoilingBit,91)
    ENDIF
	IF SoiledDiaper(Changee,2,,15)
            IF Changee == MASTER
                CALL KOJO_MESSAGE_SEND("EVENT",100,ARG,0,3)
                SIF !RESULT
                    GOTO checkPoopGeneric
            ELSE
                $checkPoopGeneric
                IF IsPadded(Changee, "diaper")
                    PRINTFORMDW %PARSE("You squeeze",,,ARG)% the bottom of %PARSE("your",5,,Changee)% diaper and %PARSE("find",5,,ARG)% a big mess inside. 
                ELSEIF IsPadded(Changee, "pull-up")
                    PRINTFORMDW %PARSE("You pull",,,ARG)% the back of %PARSE("your",5,,Changee)% waistband and %PARSE("find",5,,ARG)% an awful stinky mess inside. 
                ELSE
                    PRINTFORMDW %PARSE("You giggle",,,ARG)% at the sorry state of %PARSE("your",5,,Changee)% %PeeProtectType(Changee,2)%. 
                ENDIF
            ENDIF
			IF Changee == MASTER
                CALL SET_REP(ARG,7,,1)
			ENDIF
            GOTO DiaperChange
	ELSEIF SoiledDiaper(Changee,1,,33)
			SELECTCASE DOMINANT_LIQUID_SOIL(Changee)
			CASE 1
			;menstural blood
                IF Changee == MASTER
                    CALL KOJO_MESSAGE_SEND("EVENT",100,ARG,0,7)
                    SIF !RESULT
                        GOTO checkMensesGeneric
                ELSE
                    $checkMensesGeneric
				    PRINTFORMDW %PARSE("You pull",,,ARG)% the back of %PARSE("your",5,,Changee)% waistband and finds it red with %PARSE("your",5,,Changee)% menstrual blood. 
				ENDIF
				GOTO DiaperChange
			CASE 2, 3
                IF Changee == MASTER
                    CALL KOJO_MESSAGE_SEND("EVENT",100,ARG,0,7)
                    SIF !RESULT
                        GOTO checkSexFluidGeneric
                ELSE
                    $checkSexFluidGeneric
				    PRINTFORMDW %PARSE("You pull",,,ARG)% the back of %PARSE("your",5,,Changee)% waistband and finds it wet with sexual fluids. 
				ENDIF
				GOTO DiaperChange
			CASEELSE
			;urine
                IF Changee == MASTER
		            CALL KOJO_MESSAGE_SEND("EVENT",100,ARG,0,1)
                    SIF !RESULT
                        GOTO checkPeeGeneric
				ELSE
                    $checkPeeGeneric
                    IF IsPadded(Changee, "diaper")
                        SELECTCASE RAND:2
                        CASE 0
                        PRINTFORMDW %PARSE("You put",,,ARG)% a finger inside %PARSE("your",5,,Changee)% diaper and %PARSE("find",,,ARG)% %PARSE("you",6,,Changee)% very wet inside. 
                        CASE 1
                        PRINTFORMDW %PARSE("You pat",,,ARG)% against the front of %PARSE("your",5,,Changee)% diaper and %PARSE("find",,,ARG)% it very squishy.
                        ENDSELECT
                    ELSEIF IsPadded(Changee, "pull-up")
                        PRINTFORMDW %PARSE("You pull",,,ARG)% the back of %PARSE("your",5,,Changee)% waistband and %PARSE("find",,,ARG)% it very wet inside. 
                    ELSE
                        PRINTFORMW %PARSE("You find",,,ARG)% %PARSE("you",5,,Changee)% in wet underwear...
                    ENDIF	
				ENDIF

                SELECTCASE SoiledDiaper(Changee,1,1)
				CASE IS >= 50
				CASEELSE
				PRINTFORMDW It's not wet enough for %PARSE("you",,,ARG)% to warrant a change though... 
				RETURN
				ENDSELECT
				GOTO DiaperChange
			ENDSELECT
	ELSEIF !UnderwearOffPoints(Changee) && !PadOffPoints(Changee) && !CANT_UNDIES(Changee)
		PRINTFORMW But %PARSE("realize",,,ARG)% %PARSE("you are",,,Changee)% not wearing the correct underwear nor pads. 
		PRINTL
        SIF Changee == MASTER
		    CALL KOJO_MESSAGE_SEND("EVENT",100,ARG,0,1)
		$DiaperChange
        VARSET LOCALS
		CALL PunishmentPointChange(Changee,PUNISHMENT_POINT_GAIN(Changee))
		CALLF UnderwearOffPoints(Changee)
        IF RESULTS:1 != ""
		LOCALS:1 '= RESULTS:1
		LOCALS '= @"%PLURALIZER(RESULTS:1)%、"
        ENDIF
        CALLF PadOffPoints(Changee,1)
        SIF RESULTS:1 != ""
		LOCALS += @"%PLURALIZER(RESULTS:1)%、"
		PRINTFORMDL %PARSE("You say",,,ARG)% that %PARSE("you need",5,,Changee)% to be in \@ LOCALS != "" ? %PARSE("your",5,,Changee)% %TOLOWER(LIST_IN_STRING(LOCALS, ," or"))% # some underwear\@.
        ;Still would love the option to stay in the same underwear when confronted with a Diaper Check though
        ;since the underwear type should be acceptable

        ;Nah, it's either succeeds because you're wearing an appropriate underwear type to the punishment level

        ;Also if you do ask to stay in the same diaper, the Caretaker will definitely tease you about it
        ;And also a chance for them to get handsy as well

        ; i thinking that the chance to be able to stay in your diaper should be depending on a few factors:
        ; 1. your diaper type
        ; 2. your diaper permissions
        ; 3. how soiled your diaper is
        ; 4. how many times that you leaked after being forgiven
        IF Changee == MASTER
            {
            CALL ASK_M(
                "Get changed", 1,
                @"Ask to stay in %PeeProtectType(MASTER,2)%", 1
            )
            }
            SELECTCASE RESULT
            CASE 0
            CASE 1
                IF !UnderwearOffPoints(Changee) && !PadOffPoints(Changee) && !CANT_UNDIES(Changee)
                    PRINTFORML %CALLNAME:ARG% says that you cannot wear your current underwear anymore and forces you to get changed
                ELSE
                    PRINTFORML %CALLNAME:ARG% teases you about wanting to stay in your soiled %PeeProtectType(Changee,1)%, but relents and lets you go.
                    TCVAR:Changee:DiaperCheckImmunity = 150
                    RETURN
                ENDIF
            ENDSELECT
        ENDIF


		CALL FISHER_YATES_SHAFFLE(VAR_TEMP_MAX)
		FOR LOCAL, 0, VAR_TEMP_MAX
			nUndies = SHAFFLE_ARRAY:LOCAL
            SIF !STRLENS(PANTSNAME(nUndies,Changee))
                CONTINUE

            CALLF DiapeStats(Changee,nUndies,1,1)
            LOCALS:2 '= RESULTS:0
            LOCALS:3 '= RESULTS:2
            LOCALS:4 '= MERGE_UNDIES_NAME(LOCALS:2,LOCALS:3)
			;IF UnderwearOffPoints(Changee,nUndies) && GET_INT(Changee, "下半身下着_ずらし可能", nUndies, "はける")
            ;conditions
            A:0 = (UnderwearOffPoints(Changee,nUndies) || !STRLENS(LOCALS:1))
            A:1 = (LOCALS:4 == LOCALS:1 || !STRLENS(LOCALS:1)) && GET_INT(Changee, "下半身下着_ずらし可能", nUndies, "はける")
            ;PRINTFORML {nUndies,3} %UNDIES_NAME_WITH_BRAND(Changee,nUndies,1),50,LEFT% | Type needed: "%LOCALS:1,20,LEFT%" | Type Got "%LOCALS:4,20,LEFT%"
			
            IF A:0 && A:1
            	BREAK
			ENDIF
		NEXT
            SIF !STRLENS(PANTSNAME(nUndies,Changee))
                nUndies = 174
        ;Teasing about how you like your pamps soggy and stinky with a smirk
        ;And getting all handsy with it
		CALL DiaperChangeDesc(Changee, nUndies, ARG, 0)
        SIF ARG == MASTER
            CFLAG:Changee:パンツ2 = 1
	ELSEIF !EQUIP:Changee:6
		PRINTFORMW But %PARSE("realize",,,ARG)% that %PARSE("you don't",,,Changee)% have any underwear.
		GOTO DiaperChange			
	ELSE
        IF Changee == MASTER
            CALL KOJO_MESSAGE_SEND("EVENT",100,ARG,0,0)
            SIF !RESULT
                GOTO checkCleanGeneric
        ELSE
            $checkCleanGeneric
		    PRINTFORMW %PARSE("You find",,,ARG)% %PARSE("you",6,,Changee)% clean...
        ENDIF
	ENDIF
	PunishChange:Changee:0 = LIMIT(PunishChange:Changee:0,0,PANTY_PUNISH_MAX)
    TCVAR:Changee:DiaperCheckImmunity = 60
ELSE
RETURN -1
ENDIF



@PunishmentPointChange(ARG,POINTS,nMainType="undies",SEEABLE=0)
#DIM DYNAMIC POINTS
#DIM LAST_POINTS
#DIM LAST_RANK
#DIM C_COL
#DIM nReq
#DIM DYNAMIC nBarDid
#DIM DYNAMIC nNighttime
#DIM SEEABLE
#DIMS BAR_VAR
#DIMS LABEL
#DIM POINT_MAX
#DIMS nMainType
SIF !POINTS
    RETURN 0
SIF SEEABLE == 0
    SEEABLE = CAN_SEE(ARG)

SELECTCASE nMainType
CASE "undiesNight"
    SIF !nPantyPunish
        RETURN 0
    LABEL '= "Nighttime Punishment Points"
    BAR_VAR '= "PunishNightChange"
    POINT_MAX = PANTY_PUNISH_MAX
CASE "undies"
    SIF !nPantyPunish
        RETURN 0
    LABEL '= "Diaper Punishment Points"
    BAR_VAR '= "PunishChange"
    POINT_MAX = PANTY_PUNISH_MAX
CASE "chastity"
    SIF !nChastityPunish
        RETURN 0
    LABEL '= "Chastity Punishment Points"
    BAR_VAR '= "PunishChastity"
    POINT_MAX = CHASTITY_PUNISH_MAX
ENDSELECT
SETVAR @"%BAR_VAR%:{ARG}:1", GET_PUNISHMENT_POINT_TIER(ARG,nMainType)
LAST_POINTS = GETVAR(@"%BAR_VAR%:{ARG}:0")
LAST_RANK   = GETVAR(@"%BAR_VAR%:{ARG}:1")
SETVAR @"%BAR_VAR%:{ARG}:0", LIMIT(GETVAR(@"%BAR_VAR%:{ARG}:0")+POINTS,0,POINT_MAX)


SIF LAST_RANK == 0 && POINTS <= 0
    RETURN 0

SIF SEEABLE > 0
CALL COLORMESSAGE(@"%LABEL,20,LEFT% \@ POINTS > 0 ? ＋ # ー\@%DIGIT_GROUP(ABS(POINTS)),3,LEFT% （%CALLNAME:ARG%）",POINTS < 0 ? C_GREEN # C_RED,1,1)

;animate the bar filling up
LOCAL = LAST_POINTS
LOCAL:2 = LAST_POINTS - LOCAL
LOCAL:1 = POINTS
LOCAL:3 = LAST_RANK
nReq = PunishmentPointTier(LOCAL:3+1)

;this is just bar stuff
IF SEEABLE <= 0
    SETVAR @"%BAR_VAR%:{ARG}:1", GET_PUNISHMENT_POINT_TIER(ARG,nMainType)
    RETURN
ENDIF
gLineCount = LINECOUNT
nBarDid = 0

REDRAW 0
DO
    ;number resetting
    IF POINTS >= 0
        LOCAL ++
        LOCAL:1 --
    ELSE
        LOCAL --
        LOCAL:1 ++
    ENDIF
    IF LOCAL <= 0
        LOCAL = 0
        LOCAL:1 = 0
    ELSEIF LOCAL >= POINT_MAX
        LOCAL = POINT_MAX
        LOCAL:1 = 0
    ENDIF

    ;show the bar
    $PicLoop
    LOCAL:3 = PUNISH_RANK_CALC(LOCAL)
    SIF LINECOUNT - gLineCount > 0
        CLEARLINE LINECOUNT - gLineCount
    CALL PunishmentPointBar(ARG,LOCAL,LOCAL:3,nMainType)
    SIF LOCAL:1 == PANTY_PUNISH_MAX || LOCAL:1 == 0
        BREAK
LOOP (LOCAL:1 != 0) && !nBarDid
IF !nBarDid
    nBarDid = 1
    GOTO PicLoop
ENDIF
SIF LOCAL:3 != PunishChange:ARG:1
    CALL PunishmentPointPromote(ARG,LOCAL:3,POINTS <= 0 ? 1 # -1, nMainType)
SIF PunishChange:ARG:0 >= PANTY_PUNISH_MAX && ARG == MASTER
	CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("maxDiaperPunishment")

@PunishmentPointBar(ARG,nPoints,nRank,nMainType="undies")
#DIM DYNAMIC nPoints
#DIM DYNAMIC nRank
#DIM DYNAMIC barRec
#DIMS DYNAMIC nMainType
#DIMS typeLabel
#DIMS privilegeLabel

SELECTCASE nMainType
CASE "undies"
typeLabel '= "Undies Punishment  "
privilegeLabel '= PunishmentPointTierName(nRank)
CASE "chastity"
typeLabel '= "Chastity Punishment"
privilegeLabel '= ChastityPunishmentPointTierName(nRank)
ENDSELECT

barRec = PunishmentPointTier(nRank)

PRINTFORM %typeLabel% Lv.{nRank}:　
CALL PRINT_COLORBAR(nPoints-PunishmentPointTier(nRank-1), barRec-PunishmentPointTier(nRank-1), 100, UNICODE(0x2585), UNICODE(0x2585), C_YELLOW, RESULT:1)
PRINTFORML 　{nPoints, 3}/{barRec} (%privilegeLabel%)
TWAIT 15, 0


@PunishmentPointPromote(ARG,ARG:1,ARG:2,nMainType="undies")
#DIMS DYNAMIC nMainType
#DIMS typeLabel
#DIMS privilegeLabel
#DIMS promoteLabel,2
#DIMS varToChange

SELECTCASE nMainType
CASE "undies"
typeLabel '= "Underwear Privilege"
promoteLabel:0 '= "Promotion"
promoteLabel:1 '= "Demotion"
varToChange '= "PunishChange"
CASE "chastity"
typeLabel '= "Chastity Restriction"
promoteLabel:0 '= "Decreased"
promoteLabel:1 '= "Increased"
varToChange '= "PunishChastity"
ENDSELECT

CALL COLORMESSAGE(@"%@"%typeLabel% \@ ARG:2 >= 0 ? %promoteLabel:0% # %promoteLabel:1%\@! (%CALLNAME:ARG%)",20,LEFT%",ARG:2 > 0 ? C_GREEN # C_RED,2,1)
SETVAR @"%varToChange%:{ARG}:1", ARG:1

SELECTCASE nMainType
CASE "undies"
privilegeLabel '= PunishmentPointTierName(ARG:1)
CASE "chastity"
privilegeLabel '= ChastityPunishmentPointTierName(ARG:1)
ENDSELECT

LOCALS '= @"%TOLOWER(PLURALIZER(privilegeLabel))%"
IF ARG:2 >= 0
    PRINTFORML Congratulations! %PARSE("You are",,,ARG)% now able to wear %LOCALS%!
ELSE
    PRINTFORML Unfortunately, %PARSE("you have",,,ARG)% to wear %LOCALS% now...
ENDIF
WAIT


