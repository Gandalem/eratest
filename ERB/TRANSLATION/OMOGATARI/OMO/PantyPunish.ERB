@UnderwearOffPoints(ARG, ARG:1, nUnderwearType = "")
#FUNCTION
#DIMS DYNAMIC nUnderwearType
#DIM DYNAMIC nCount
VARSET RESULTS
VARSET LOCALS
VARSET nCount, 1

SIF !nPantyPunish
    RETURNF 1
SIF !nOmutsu
    RETURNF 1

SELECTCASE PunishChange:ARG:1
CASE 0
    RETURNF 1
CASEELSE
    ;pull-up and diaper (so we get "X says that you need to be in your diapers" instead of "thick pull-ups")
    ;pull-up
    CALLF UNDERWEAR_TYPES(UNDERWEAR_TYPES:0)
    IF PunishChange:ARG:1 <= UNDERWEAR_TYPES_PUNISHMENT
        LOCALS:nCount '= @"%UNDERWEAR_TYPES:0%"
        nCount++
    ENDIF
    ;diaper
    CALLF UNDERWEAR_TYPES(UNDERWEAR_TYPES:1)
    IF PunishChange:ARG:1 <= UNDERWEAR_TYPES_PUNISHMENT
        LOCALS:nCount '= @"%UNDERWEAR_TYPES:1%"
        nCount++
    ENDIF
    ;thick diaper
    CALLF UNDERWEAR_TYPES(UNDERWEAR_TYPES:1,UNDERWEAR_SUB_TYPES:2)
    IF PunishChange:ARG:1 <= UNDERWEAR_TYPES_PUNISHMENT
        LOCALS:nCount '= @"%MERGE_UNDIES_NAME(UNDERWEAR_TYPES:1,UNDERWEAR_SUB_TYPES:2)%"
        nCount++
    ENDIF

    FOR LOCAL,0,VARSIZE("UNDERWEAR_TYPES")
        ;don't mention the forbidden types
        SIF (UNDERWEAR_TYPES:LOCAL == "Pull-Up") || (UNDERWEAR_TYPES:LOCAL == "Diaper") && !nOmutsu
            CONTINUE
        FOR LOCAL:1,0,VARSIZE("UNDERWEAR_SUB_TYPES")
            CALLF UNDERWEAR_TYPES(UNDERWEAR_TYPES:LOCAL, UNDERWEAR_SUB_TYPES:(LOCAL:1))
            IF PunishChange:ARG:1 <= UNDERWEAR_TYPES_PUNISHMENT
                LOCALS:nCount '= @"%MERGE_UNDIES_NAME(UNDERWEAR_TYPES:LOCAL,UNDERWEAR_SUB_TYPES:(LOCAL:1))%"
                nCount++
            ENDIF
        NEXT
    NEXT
ENDSELECT

;DEBUGPRINTFORML Allowed underwear types for %CALLNAME:ARG% ({PunishChange:ARG:1} punishment points):
FOR LOCAL, 0, 30
    IF LOCALS:LOCAL != ""
        ;DEBUGPRINTFORML ・%LOCALS:LOCAL%
        RESULTS:LOCAL = %LOCALS:LOCAL%
    ENDIF
NEXT

FOR LOCAL, 1, 10
    SIF LOCALS:LOCAL == ""
        BREAK 

    IF nUnderwearType != ""
        SIF TOLOWER(nUnderwearType) == TOLOWER(LOCALS:1)
            RETURNF 3
        SIF TOLOWER(nUnderwearType) == TOLOWER(LOCALS:LOCAL)
            RETURNF 2 
    ELSEIF ARG:1
        SIF IsPadded(ARG, LOCALS:LOCAL, ARG:1)
            RETURNF 2    
    ELSE
        SIF IsPadded(ARG, LOCALS:LOCAL)
            RETURNF 2
    ENDIF
NEXT
RETURNF

@PadOffPoints(ARG, ARG:1=0, nUnderwearType = "")
#FUNCTION
#DIMS DYNAMIC nUnderwearType
#DIM DYNAMIC nCount
VARSET RESULTS
VARSET LOCALS
VARSET nCount, 1

;diapered, always pass.
IF !ARG:1
SIF IsPadded(ARG,"Diaper") || IsPadded(ARG,"Pull-Up")
    RETURNF 1
ENDIF 

SELECTCASE PunishChange:ARG:1
CASE 0
    RETURNF 1
CASEELSE
    FOR LOCAL,0,VARSIZE("UNDERWEAR_PAD_TYPES")
        CALLF UNDERWEAR_PAD_TYPES(UNDERWEAR_PAD_TYPES:LOCAL)
        IF PunishChange:ARG:1 <= UNDERWEAR_PAD_TYPES_PUNISHMENT
            LOCALS:nCount '= @"%UNDERWEAR_PAD_TYPES:LOCAL%"
            nCount++
        ENDIF
    NEXT
ENDSELECT

DEBUGPRINTFORML Allowed pad types for %CALLNAME:ARG% ({PunishChange:ARG:1} punishment points):
FOR LOCAL, 0, 30
    IF LOCALS:LOCAL != ""
        DEBUGPRINTFORML ・%LOCALS:LOCAL%
        RESULTS:LOCAL = %LOCALS:LOCAL%
    ENDIF
NEXT

FOR LOCAL, 1, 10
    SIF LOCALS:LOCAL == ""
        BREAK 

    IF nUnderwearType != ""
        SIF TOLOWER(nUnderwearType) == TOLOWER(LOCALS:1)
            RETURNF 3
        SIF TOLOWER(nUnderwearType) == TOLOWER(LOCALS:LOCAL)
            RETURNF 2 
    ELSE
        SIF PantiesType:ARG:2 == TOLOWER(LOCALS:LOCAL)
            RETURNF 2
    ENDIF
NEXT
RETURNF

@PUNISHMENT_POINT_GAIN(ARG)
#FUNCTION
#DIM DYNAMIC PPCHANGE
VARSET PPCHANGE
IF SoiledDiaper(ARG,2,,15)
    SELECTCASE SoiledDiaper(ARG,2,1)
    CASE IS >= 80
    PPCHANGE = PP_SCALE_POINTS(ARG,3,7)
    CASE IS >= 50
    PPCHANGE = PP_SCALE_POINTS(ARG,3,4)
    CASEELSE
    PPCHANGE = PP_SCALE_POINTS(ARG,2,2)
    ENDSELECT	
ELSEIF SoiledDiaper(ARG,1,,33)
    ;liquid
    SELECTCASE DOMINANT_LIQUID_SOIL(ARG)
    CASE 1, 2, 3
    ;menstural blood
        SIF PunishChange:ARG:0 < 4
            PPCHANGE = 1
    CASEELSE
    ;urine
        SELECTCASE SoiledDiaper(ARG,1,1)
        CASE IS >= 90
            PPCHANGE = PP_SCALE_POINTS(ARG,2,3)
        CASE IS >= 50
            PPCHANGE = PP_SCALE_POINTS(ARG,2,2)
        CASEELSE
            PPCHANGE = PP_SCALE_POINTS(ARG,1,1)
        ENDSELECT
    ENDSELECT
ENDIF
RETURNF PPCHANGE

;character
;minimum rank
;point gain
@PP_SCALE_POINTS(ARG,nRank,nPointGain,nMainType="undies")
#FUNCTION
#DIM nRank
#DIM nPointGain
#DIM curVals,2
#DIMS DYNAMIC nMainType

SELECTCASE nMainType
CASE "undies"
    curVals = PunishChange:ARG:0
    curVals:1 = PunishChange:ARG:1
CASE "undiesNight"
    curVals = PunishNightChange:ARG:0
    curVals:1 = PunishNightChange:ARG:1
CASE "chastity"
    curVals = PunishChastity:ARG:0
    curVals:1 = PunishChastity:ARG:1
ENDSELECT

IF curVals:1 < nRank
    RETURNF PunishmentPointTier(nRank) - curVals
ENDIF
RETURNF nPointGain

@PatrolUnderwearChecking
#DIM PUC_CHARA
#DIM PUC_CHECKER
#DIM PUC_CHECKEE

FOR LOCAL,0,CHARANUM
	TCVAR:LOCAL:DiaperCheckDid = 0
NEXT
SIF !nPantyPunish
    RETURN
SIF FLAG:70
    RETURN
SIF GROUPMATCH(SELECTCOM, 400)
    RETURN
SIF TFLAG:102 >= 2
    RETURN

FOR PUC_CHECKER,1,GET_TARGETNUM()+1
	PUC_CHARA = TARGET:PUC_CHECKER
    SIF !CharaDiaperChecker(PUC_CHARA)
		CONTINUE
	SIF IS_BABY(PUC_CHARA)
		CONTINUE
	SIF PUC_CHARA == MASTER
		CONTINUE
	SIF !SHIRAHU(PUC_CHARA)
		CONTINUE
	SIF BASE:PUC_CHARA:0 <= 500 || IsDead:PUC_CHARA:0
		CONTINUE
    SIF CFLAG:PUC_CHARA:ディレイ > 0
        CONTINUE
    SIF BATHROOM(CFLAG:PUC_CHARA:300)
        CONTINUE
	FOR PUC_CHECKEE,0,CHARANUM
        SIF !IS_HERE_NAS(PUC_CHARA,PUC_CHECKEE)
	        CONTINUE
        SIF TCVAR:PUC_CHECKEE:DiaperCheckDid
            CONTINUE
        SIF PUC_CHECKEE == PUC_CHARA
            CONTINUE
        SIF TCVAR:PUC_CHECKEE:DiaperCheckImmunity
            CONTINUE
        SIF BASE:PUC_CHECKEE:0 <= 500 || IsDead:PUC_CHECKEE:0
            CONTINUE
        CALL RandomUnderwearCheck(PUC_CHARA,0,PUC_CHECKEE)
        TCVAR:PUC_CHECKEE:DiaperCheckDid = 1
    NEXT
NEXT