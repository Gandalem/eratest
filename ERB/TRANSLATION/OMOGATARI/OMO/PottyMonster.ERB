@POTTY_MONSTER_0(ARG, HasPiss, HasScat, nScaryGet)
#DIM REF HasPiss
#DIM REF HasScat
#DIM REF nScaryGet
PRINTFORMDW 검은 긴 머리에 빨간색과 파란색 드레스를 입은 정령이 당신 앞에 나타난다. 그녀는 양쪽 다리가 없는 듯하지만 여전히 떠 있다.
PRINTFORML 「내 다리는 어디에?」
CALL ASK_M( @"당신 스스로 %PeeAndPoo(HasPiss,HasScat,"wet","mess")%로 진행한다.", 1, @"「에이니떼이 같은 거 확인해 봐...」", Level_to_rank(ABL:MASTER:43) < 2, "「메이신 고속도로에서.」", 1, "「타투루스 어딘가에.」", Level_to_rank(ABL:MASTER:43) < 4, "「요괴 산에서」", Level_to_rank(ABL:MASTER:43) < 3, "「미카도에서」", Level_to_rank(ABL:MASTER:43) < 2, @"「이제 네가 변기야~」(소변을 본다)", HasPiss, @"「섬멸해라!」 (무기를 뽑는다)", GROUPMATCH(GET_STR(MASTER, "Weapon", EQUIP:MASTER:Weapon, "Type"),"Firearm","Explosive"), "「모르겠어」", Level_to_rank(ABL:MASTER:43) < 1, )
SELECTCASE RESULT
	CASE 2
		PRINTFORML 「누구에게 들었어?」
		CALL ASK_M( @"「%NAME:1%」", Level_to_rank(ABL:MASTER:43) < 2, "「YHVH」", Level_to_rank(ABL:MASTER:43) < 3, "「카시마 레이코」", 1, "「변기 괴물 루이」", Level_to_rank(ABL:MASTER:43) < 2, "「모르겠어」", Level_to_rank(ABL:MASTER:43) < 1, )
		SELECTCASE RESULT
			CASE 2
				PRINTFORML 「좋아. 내가 누군지 알겠지.」
				PRINTFORMW 변기 정령이 사라지고 당신은 변기 앞에 서게 된다.
			CASEELSE
				GOTO WrongAnswer
		ENDSELECT
	CASE 0
		RETURN -2
	CASE 6
		PRINTFORMDW 당신은 %PeeProtectType(MASTER,2)%를 내리고 정령에게 소변을 보기 시작한다.
		;new accident scenes
		ACCIDENT_CHARA = ARG
		ACCIDENT_HasPiss = HasPiss
		ACCIDENT_HasScat = 0
		ACCIDENT_Stand = 0
		ACCIDENT_Nude = 1
		ACCIDENT_LINECOUNT = LINECOUNT
		CALL CUTSCENESPEAK_NAS(@"「....」", "発情", ARG, 0)
		CALL ACCIDENT_SHOW_BAR_RELIEVE()
		CLEARLINE LINECOUNT - ACCIDENT_LINECOUNT
		CALL CUTSCENESPEAK_NAS(@"「%MOAN("h")%...」", "笑顔:照れ", ACCIDENT_CHARA, 0)
		PRINTFORMW 변기 정령이 사라지고 당신은 변기 앞에 홀로 서 있게 된다.
		RETURN -3
	CASE 7
		RETURN 5
	CASEELSE
		$WrongAnswer
		PRINTFORML 「틀린 대답이야!」
		PRINTFORML 정령이 당신의 다리 하나를 찢어 바닥에 쓰러지게 한다.
		PRINTFORML 다리 하나를 빼앗긴 고통 때문에 충격으로 %PeeAndPoo(HasPiss,HasScat,"bladder","bowels")%을 방출한다.
		RETURN -99
ENDSELECT

