@POTTY_MONSTER_ENCOUNTER(ARG,HasPiss,HasScat,CHEAT)
#DIM DYNAMIC HasPiss
#DIM DYNAMIC HasScat
#DIM DYNAMIC nScaryGet
#DIM DYNAMIC PME_RESULT
#DIM DYNAMIC CHEAT
PRINTFORMW 당신은 변기 뚜껑을 들어 올리고, 그 안에서 배변 정령이 나타났다.
CALL FISHER_YATES_SHAFFLE(30)
IF CHEAT
	PRINTFORML 하지만 어느 쪽이지?
	FOR LOCAL,0,30
	IF EXISTFUNCTION(@"POTTY_MONSTER_{LOCAL}_INFO")
		TRYCALLFORM POTTY_MONSTER_{LOCAL}_INFO(ARG, HasPiss, HasScat, nScaryGet)
		PRINTFORML [{LOCAL,3}] - %PottyMonsterName%
	ENDIF
	NEXT
	INPUT
	TRYCALLFORM POTTY_MONSTER_{RESULT}(ARG, HasPiss, HasScat, nScaryGet)
	PME_RESULT = RESULT
ELSE
	FOR LOCAL,0,30
	IF EXISTFUNCTION(@"POTTY_MONSTER_{SHAFFLE_ARRAY:LOCAL}_INFO")
		TRYCALLFORM POTTY_MONSTER_{SHAFFLE_ARRAY:LOCAL}_INFO(ARG, HasPiss, HasScat, nScaryGet)
		SIF !PottyMonsterCando
			CONTINUE
		TRYCALLFORM POTTY_MONSTER_{SHAFFLE_ARRAY:LOCAL}(ARG, HasPiss, HasScat, nScaryGet)
		PME_RESULT = RESULT
		BREAK
	ENDIF
	NEXT
ENDIF
SELECTCASE PME_RESULT
	CASE 1
	CASE 5
		PRINTFORMDW 당신은 무기를 뽑고 정령을 향해 발사한다.
		charaWeaponInts:(MASTER):Ammo --
		CALL PlayFireSound(MASTER)
		firedWeapon:MASTER:0 = charaWeaponInts:MASTER:Loudness
		PRINTFORMW 변기 정령이 사라지고 당신은 변기 앞에 홀로 서 있게 된다.
		CALL FIRE_WEAPON_CHECK_ALL
	CASE -2
		PRINTFORMW 당신은 비명을 지르고 다리가 공포에 떨리는 가운데 서서, 익숙한 온기가 사타구니에서 느껴지기 시작한다.
		GOTO END_ACCIDENT
	CASE -99
		$END_ACCIDENT
		PRINTFORMW 변기 정령이 사라지고 당신은 변기 앞에 홀로 서 있다.
		PRINTFORMW 몸의 통제권을 되찾으면서 더 이상 배변할 필요가 없다는 것을 깨닫지만, 당신의 %PeeProtectType(ARG,1)%는 이제 %PeeAndPoo(HasPiss,HasScat,"wet","messy")%하게 느껴진다...
ENDSELECT
RETURN PME_RESULT

@PottyMonsterChance(ARG)
#FUNCTION
#DIM DYNAMIC PMC
PMC = 0
PMC += (50*(-OrgasmDeny:ARG:0))
PMC += (50*CharaTrauma:ARG:0)
SELECTCASE TALENT:ARG:10
	CASE -1
		PMC += 25
	CASE 1
		PMC -= 25
ENDSELECT
SELECTCASE TALENT:ARG:11
	CASE -1
		PMC += 25
	CASE 1
		PMC -= 25
ENDSELECT
SELECTCASE TALENT:ARG:13
	CASE -1
		PMC += 25
	CASE 1
		PMC -= 25
ENDSELECT
SELECTCASE TALENT:ARG:20
	CASE 1
		PMC -= 60
ENDSELECT
SELECTCASE TALENT:ARG:21
	CASE 1
		PMC += 25
	CASE 2
		PMC += 50
ENDSELECT
SIF K102_InconChipPussyOut == 2
	PMC += 200
RETURNF PMC

