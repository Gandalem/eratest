@POTTY_MONSTER_7(ARG, HasPiss, HasScat, nScaryGet)
#DIM REF HasPiss
#DIM REF HasScat
#DIM REF nScaryGet
#DIM PM7_LINECOUNT
#DIM PM7_HEALTH, 2
#DIM nDealer
SELECTCASE IS_NONHUMAN(MASTER)
	CASE 0
		LOCALS '= "인간"
	CASE 1
		LOCALS '= "요괴"
	CASE 2
		LOCALS '= "비요괴 비인간"
	CASE 3
		LOCALS '= "인형"
ENDSELECT
PRINTFORML 한 %TOLOWER(GET_TALENTNAME_TR(100,TALENT:MASTER:100))% %LOCALS%가 당신에게 다가온다.
PRINTFORML %HE_SHE(ARG,1)%이 당신 앞에 서서 당신의 정확한 반영처럼 보인다.
PRINTFORM %SHOW_TOP(ARG,1)%와 \@ EQUIP:ARG:ズボン ? %SHOW_BOTTOM(ARG)% # %SHOW_BOTTOM(ARG, 1)% \@에서 %HIS_HER(ARG)% %UNDIES_NAME_WITH_BRAND(ARG,EQUIP:ARG:6,1)%을 드러내는 구멍이 있다.
SIF EQUIP:MASTER:Weapon
	PRINTFORM 또한 %UNDIES_NAME_WITH_BRAND(ARG,EQUIP:ARG:Weapon,1,1)%를 %HIS_HER(ARG)%의 팔에 두었다.
PRINTW .
PRINTFORMW 모방체가 당신에게 말을 걸기 시작한다.
CALL SET_KOJO_COLOR(MASTER)
PRINTFORMW 「%NAME:MASTER%.」
PRINTFORMW 「너는 내 이름을 쓰고 모습을 취한 위조자다.」
PRINTFORMW 「네 죄값을 치르게 될 것이다!」
RESETCOLOR
PRINTFORMW 행복해 보이지 않아... 싸움이 기다리고 있어!
;new system
PM7_LINECOUNT = LINECOUNT
PM7_HEALTH:1 = BASE:MASTER:0*2
PM7_HEALTH:0 = PM7_HEALTH:1
DO
TCVAR:(MASTER):Weap_Dodge = GetDodgeChance(MASTER)
CLEARLINE LINECOUNT - PM7_LINECOUNT
PRINTFORML %CALLNAME:MASTER%: 
CALL Add_STAMINA_BAR(MASTER, 20, 1) ;custom code: replaced bars with one that shows true stamina
IF HasPiss
	CALL PeeBar(MASTER,20,1)
ENDIF
RESETCOLOR
IF HasScat
	CALL PooBar(MASTER,20,1)
ENDIF
RESETCOLOR
PRINTL
PRINTFORML 모방하기:
PRINTFORM  STA 
CALL PRINT_COLORBAR, PM7_HEALTH, MAXBASE:ARG:0*2, 20, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET("青")
PRINTFORM  ({PM7_HEALTH,5}/{MAXBASE:ARG:0*2,5})
PRINTL
CALL ASK_M( @"싸운다", 1, @"제출", 1, )
SELECTCASE RESULT
	CASE 0
		nDealer = MASTER
		IF CFLAG:ARG:溜まってる度 >= 800
			PRINTFORML 미믹이 당신의 흥분을 알아차린 듯, 차가운 물을 당신에게 뿌린다!
			PRINTFORMW 당신은 차가운 물에 발길을 멈추었고, 잠시 다른 것에는 집중할 수 없었다. 다시 따뜻해지는 것에만 신경 쓰게 되었다.
			CFLAG:ARG:溜まってる度 -= (RAND(200,400))
			GOTO PlayerLoseTurn
		ELSEIF (PeeBarStage(MASTER) >= 7 && HasPiss) || (PooBarStage(MASTER) >= 7 && HasScat)
			GOTO PlayerSubmit
		ENDIF
		$DoBattle
		VARSET lcDamageDeal
		LOCALS = %GET_STR((MASTER), "Weapon", EQUIP:MASTER:Weapon, "名前")%
		IF STRCOUNT(GET_STR((MASTER), "Weapon", EQUIP:MASTER:Weapon, "Class"), "Blunt")
			CALL LC_PRINT(@"\@ (nDealer) == MASTER ? %PARSE("You")% 휘두른다 # 모방체가 휘두른다 \@ \@ (nDealer) == MASTER ? %PARSE("your")% # %HIS_HER((MASTER))% \@ %LOCALS% %TOSTR(charaWeaponInts:(nDealer):Burst)% times at \@ nDealer == MASTER ? 모방체는 # 너를 \@.", , 2,)
		ELSEIF STRCOUNT(GET_STR((nDealer), "Weapon", EQUIP:MASTER:Weapon, "Class"), "Blade")
			CALL LC_PRINT(@"\@ (nDealer) == MASTER ? %PARSE("You")% 휘두른다 # 모방체가 휘두른다 \@ \@ (nDealer) == MASTER ? %PARSE("your")% # %HIS_HER((MASTER))% \@ %LOCALS% %TOSTR(charaWeaponInts:(nDealer):Burst)% times at \@ nDealer == MASTER ? 모방체는 # 너를 \@.", , 2,)
		ELSEIF GET_STR((MASTER), "Weapon", EQUIP:MASTER:Weapon, "Type") == "Firearm"
			CALL LC_PRINT(@"\@ (nDealer) == MASTER ? %PARSE("You")% 발사 # 미믹이 발사한다 \@ off %TOSTR(charaWeaponInts:(MASTER):Burst)% shots off \@ (nDealer) == MASTER ? %PARSE("your")% # %HIS_HER((MASTER))% \@ %LOCALS% at \@ nDealer == MASTER ? 미믹 # 당신에게 \@.", , 2,)
		ELSEIF GET_STR((MASTER), "Weapon", EQUIP:MASTER:Weapon, "Type") == "Youjutsu"
			CALL LC_PRINT(@"\@ (nDealer) == MASTER ? %PARSE("You")%이 발사한다 # 그 모방체가 발사한다 \@ %TOSTR(charaWeaponInts:(MASTER):Burst)% shots off \@ (nDealer) == MASTER ? %PARSE("your")% # %HIS_HER((MASTER))% \@ %LOCALS% at \@ nDealer == MASTER ? 흉내가 그곳에 있다. # 너는 \@.", , 2,)
		ELSE
			CALL LC_PRINT(@"\@ (nDealer) == MASTER ? %PARSE("You")% 발사 # 미믹이 발사한다 \@ off %TOSTR(charaWeaponInts:(MASTER):Burst)% shots off \@ (nDealer) == MASTER ? %PARSE("your")% # %HIS_HER((MASTER))% \@ %LOCALS% at \@ nDealer == MASTER ? 미믹 # 당신에게 \@.", , 2,)
		ENDIF
		FOR LOCAL:6, 1, charaWeaponInts:(MASTER):Burst+1
		FOR LOCAL:7, 1, charaWeaponInts:(MASTER):Pellets+1
		IF RAND:(100) > (charaWeaponInts:(MASTER):Accuracy) || charaWeaponInts:(MASTER):Accuracy <= 0
			CALL LC_PRINT(@"\@ (nDealer) == MASTER ? %PARSE("You")% # 모방자의 \@completely \@ (nDealer) == MASTER ? 놓친다. # 놓친다. \@를 놓친다!  ", , 1,)
			GOTO MissCheck
		ELSEIF RAND:(100) <= TCVAR:(MASTER):Weap_Dodge
			CALL LC_PRINT(@"\@ (nDealer) == MASTER ? %PARSE("Your")% # 변신체의 \@attack was dodged by \@ (nDealer) != MASTER ? 너 # 그 모방자 \@에 의해 회피당했다!  ", , 1,)
			GOTO MissCheck
		ENDIF
		IF nDealer == MASTER
			lcDamageDeal:MASTER:0 += DamageMitigate(MASTER,MASTER,charaWeaponInts:(MASTER):Damage/4,40,0,0,1)
		ELSE
			lcDamageDeal:MASTER:0 += DamageMitigate(MASTER,MASTER,charaWeaponInts:(MASTER):Damage,40,0,0,1)
		ENDIF
		$MissCheck
		NEXT
		NEXT
		IF lcDamageDeal:MASTER:0
			IF nDealer == MASTER
				CALL LC_PRINT(@"당신은 미믹에게 {lcDamageDeal:MASTER:0}의 피해를 준다!", , 1,)
				PM7_HEALTH -= (lcDamageDeal:MASTER:0)
			ELSE
				CALL LC_PRINT(@"미믹이 당신에게 {lcDamageDeal:MASTER:0}의 피해를 입힌다!", , 1,)
				BASE:MASTER:0 -= (lcDamageDeal:MASTER:0)
			ENDIF
		ENDIF
		IF PM7_HEALTH <= 0
			PRINTFORMW 도플갱어는 너무 많은 대미지를 받아 기절한다.
			PRINTFORMW 땅으로 떨어지며, 공백이 의식을 잃은 모방자를 가져간다.
			RETURN
		ELSEIF BASE:MASTER:0 <= 500
			PRINTFORML 당신의 도플갱어는 승리에 찬 표정으로 쓰러진 당신의 모습을 보며 %HIS_HER(ARG)%의 주먹을 치켜들고 있다.
			PRINTFORML %HE_SHE(ARG,1)%은 재빨리 당신의 가방을 뒤지고, %HE_SHE(ARG)%이 지폐를 한 움큼 훔쳐 %HIS_HER(ARG)%%PeeProtectType(ARG,1)%에게 던지는 동전 소리가 들린다.
			PRINTFORMW 의식이 희미해지면서, 이런 종류의 적과 싸우는 어떤 비법이 있는 건 아닌지 궁금해진다...
			CALL LOST_MONEY_YEN(MIN(MONEY/10,50000),2)
			RETURN -99
		ENDIF
		SIF nDealer == -555
			CONTINUE
		$PlayerLoseTurn
		SIF !RAND:4 & GETPERCENT(PM7_HEALTH:0, PM7_HEALTH:1) <= 33
			GOTO MimicHeal
		SELECTCASE RAND:5
			CASE 0
				nDealer = -555
				GOTO DoBattle
			CASE 1
				IF HAS_PENIS(MASTER)
					PRINTFORML 갑자기, 당신의 도플갱어가 %HIS_HER(MASTER)% %PeeProtectType(ARG,1)% 안으로 손을 넣어 %HIS_HER(MASTER)%의 거시기를 쓰다듬으며 쾌감에 신음한다!
					PRINTFORMW 지금 가장 이상한 발기가 오고 있다!
				ELSE
					PRINTFORML 갑자기, 당신의 도플갱어가 %HIS_HER(MASTER)%의 %PeeProtectType(ARG,1)% 안으로 손을 넣어 %HIS_HER(MASTER)% 클리토스를 마사지하며 쾌감에 신음한다!
					PRINTFORMW 당신은 혼란과 흥분이 뒤섞인 이상한 느낌을 받는다!
				ENDIF
				CFLAG:ARG:溜まってる度 += (150)
			CASE 2
				SIF !HasPiss
					GOTO FillBowels
				$FillBladder
				PRINTFORMW 갑자기 당신의 도플갱어가 %HIS_HER(MASTER)%의 가방을 뒤진다.
				PRINTFORMW 병 하나를 꺼내 %HE_SHE(MASTER)%는 그것을 몇 모금 빠르게 들이킨 후 다시 넣는다.
				PRINTFORMW %HE_SHE(MASTER)%가 마시는 동안, 당신은 자신의 뱃속에 차가운 액체가 생기는 것을 느끼고 배가 고파진다!
				CALLF PeeMe(MASTER,PeeBarStage(MASTER)+1)
			CASE 3
				SIF !HasScat
					GOTO FillBladder
				$FillBowels
				PRINTFORMW 갑자기 당신의 쌍둥이가 %HIS_HER(MASTER)%의 가방에 손을 넣는다.
				PRINTFORMW 병 하나를 꺼낸 후, %HE_SHE(MASTER)%는 빈 병으로 교체하기 전에 재빨리 마신다.
				PRINTFORMW %HE_SHE(MASTER)%가 먹자 당신은 그 병 안의 내용물이 자신의 위에서 나타나 화장실 가고 싶은 욕구를 증가시키는 것을 느낀다!
				CALLF PooMe(MASTER,PooBarStage(MASTER)+1)
			CASE 4
				$MimicHeal
				PRINTFORMW 당신의 모방자는 %HIS_HER(MASTER)%의 주머니에서 익숙해 보이는 녹색 돌을 꺼낸다.
				PRINTFORMW %HE_SHE(MASTER)%가 그것을 높이 들자, 그것은 %HIM_HER(MASTER)%를 초록빛으로 감싼다.
				PRINTFORMW 당신은 %HE_SHE(MASTER)%가 방금 더 건강해졌다는 좋지 않은 예감이 든다...
				PM7_HEALTH:0 = PM7_HEALTH:1
		ENDSELECT
	CASE 1
		$PlayerSubmit
		PRINTFORMW 도플갱어가 %CALLNAME:MASTER%경계하는 미소를 지으며 %HE_SHE(ARG)% 싸울 의지를 잃었음을 깨닫는
		PRINTFORMW %HE_SHE(ARG,1)% 찰칵 소리를 내며 %HIS_HER(ARG)% 손가락을 튕기자 갑자기 네 사지가 적과 똑같은 자세로 휘어진다.
		PRINTFORMW 너는 이제 네 몸을 전혀 통제할 수 없음을 깨닫는다.
		PRINTFORMW 소리 없이 웃으며 모방자는 %CALLNAME:MASTER%웅크리며 살짝 몸을 숙인다.
		PRINTFORMW 네 몸이 따르자, 너는 곧 무슨 일이 벌어질지 너무 늦게 깨닫는다.
		IF HasScat
			PRINTFORMW 당신은 미믹의 %PeeProtectType(ARG,1)%이 %HIM_HER(ARG)% 뒤에서 확장되는 것을 강요당하며, 당신 자신의 %PeeProtectType(ARG,1)%도 너무나 현실적인 오물로 가득 차면서 똑같이 커지는 것을 느낀다.
			IF HasPiss
				PRINTFORM 설상가상으로, 당신의 방광이 동시에 이완된다. 
				IF IsPadded(MASTER)
					PRINTFORMW 따뜻한 오줌으로 당신의 %PeeProtectType(ARG,1)%를 적신다.
				ELSE
					PRINTFORMW 동시에 두 개의 %PEECOLOR(MASTER)% 웅덩이가 생성되며 하나로 합쳐진다.
				ENDIF
			ENDIF
		ELSE
			PRINTFORMW 당신은 미믹이 %HIS_HER(ARG)%의 방광을 이완시키는 것을 강요받고, 그로 인해 당신의 방광도 동시에 이완된다.
			IF IsPadded(MASTER)
				PRINTFORMW 뜨거운 소변으로 패딩을 채우자 당신의 %PeeProtectType(ARG,1)% 앞부분이 따뜻해지는 것을 느낀다.
			ELSE
				PRINTFORMW 한 줄기의 %PEECOLOR(MASTER)% 액체가 %HIS_HER(ARG)% %PeeProtectType(ARG,1)% 안에서 흘러나와 %HIS_HER(ARG)% 피트 지점에 %PEECOLOR(MASTER)% 웅덩이를 만들고, 당신 자신의 %PeeProtectType(ARG,1)%에서부터 내려오는 당신의 %PEECOLOR(MASTER)%-색을 띤 웅덩이에서 흐르는 물줄기와 일치한다. 
			ENDIF
		ENDIF
		PRINTFORMW 마침내, 미믹은 한 번 더 웃더니 틈 속으로 들어가 시야에서 사라졌다.
		PRINTFORMW 당신은 이제 매우 잘 사용된 %PeeProtectType(ARG,1)%을 입고 있는 자신의 몸을 다시 제어하게 된다.
		RETURN -99
ENDSELECT
