SELECTCASE RESULT
	CASE 0
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 노트북이 당신 앞으로 펄럭이며 허공에서 멈추고 당신을 향한다.
				SELECTCASE RAND:3
