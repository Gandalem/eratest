;-------------------------------------------------
;EQUIP_INCERT_U
;does the sex thingy but with your urethra
;-------------------------------------------------
;挿入継続の処理
@EQUIP_INCERT_U(ARG)
#DIM 竿役

竿役 = TEQUIP:ARG:55
;-------------------------------------------------
;行為者
;-------------------------------------------------
TCVAR:ARG:116 = 竿役
;TCVAR:2 射精箇所フラグ（-1=コンドーム 1=膣内 2=アナル 3=手淫 4=口淫 5=パイズリ 6=素股 7=足コキ 8=体表 9=アナル奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
;TCVAR:4 射精快感強度

CSTR:竿役:10 = @"/{ARG}/"
TCVAR:竿役:射精箇所 = 21

CSTR:ARG:10 += @"{TEQUIP:ARG:55}/"
SIF TCVAR:ARG:射精箇所 == 0 || TCVAR:ARG:射精箇所 >= 8
	TCVAR:ARG:射精箇所 = 22


IF ARG == MASTER
	PRINTFORML ＜U Insertion From %CALLNAME:竿役%＞

	TCVAR:竿役:射精快感強度 = 850 + TEQUIP:ARG:子宮 * 100
	TCVAR:ARG:射精快感強度 = 500 + (100 * ABL:ARG:Ｖ感覚)

	DOWNBASE:竿役:体力 += 15
	DOWNBASE:竿役:気力 += 20
	DOWNBASE:ARG:体力 += 10
	DOWNBASE:ARG:気力 += 20
	SOURCE:ARG:UPleas += 200
	SOURCE:竿役:快Ｃ += 200
	SOURCE:竿役:情愛 += 25
	SOURCE:竿役:性行動 += 250
	SOURCE:竿役:達成 += 25
	SOURCE:竿役:征服 += 500
	SOURCE:竿役:逸脱 += 50

	Qol_Info_Count_Array:竿役:Qol_Count_UGiveSex ++ ;qol custom code
	SIF FLAG:70 == 1 || CFLAG:竿役:イタズラ
		Qol_Info_Count_Array:竿役:Qol_Count_UncUGiveSex ++ ;qol custom code
ELSE
	PRINTFORML ＜U Insert In %CALLNAME:ARG%＞

	TCVAR:竿役:射精快感強度 = 700 + TEQUIP:ARG:子宮 * 100
	TCVAR:ARG:射精快感強度 = 750
	DOWNBASE:竿役:体力 += 15
	DOWNBASE:竿役:気力 += 20
	;時間停止中
	IF FLAG:70
		SOURCE:ARG:UPleas += 150
		CALL TrackPainInsertU(ARG)

	ELSE
		DOWNBASE:ARG:体力 += 10
		DOWNBASE:ARG:気力 += 20
		SIF TEQUIP:ARG:体位 == 6
			SOURCE:ARG:苦痛 += 300
		SIF TALENT:竿役:形状 == 5
			SOURCE:ARG:苦痛 += 200
		SOURCE:ARG:UPleas += 150
		SOURCE:ARG:情愛 += 75
		SOURCE:ARG:露出 += 25
		SIF TCVAR:ARG:無理矢理
			SOURCE:ARG:反感 += 1000
		;体位ボーナス
		IF TEQUIP:ARG:体位 == CFLAG:ARG:好きな体位
			SOURCE:ARG:情愛 += 100
			SOURCE:ARG:恭順 += 50
		ENDIF
		CALL TrackPainInsertU(ARG)
	ENDIF

	IF CFLAG:ARG:うふふ == 2
		SOURCE:ARG:UPleas += 150
		SOURCE:ARG:情愛 += 100
		TCVAR:竿役:射精快感強度 += 150
	ENDIF
	
	Qol_Info_Count_Array:ARG:Qol_Count_USex ++ ;qol custom code
	SIF FLAG:70 == 1 || CFLAG:ARG:イタズラ
		Qol_Info_Count_Array:ARG:Qol_Count_UncUSex ++ ;qol custom code
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
EXP:竿役:挿入経験 ++
EXP:ARG:UExp ++
SIF !FLAG:70 && !CFLAG:ARG:イタズラ
EXP:ARG:USex ++
SIF TEQUIP:ARG:体位 == 6
	EXP:ARG:UStretch ++
SIF FLAG:70 == 1
	EXP:MASTER:時姦経験 += 1
IF CFLAG:MASTER:イタズラ == 2
	EXP:MASTER:睡眠姦経験 += 1
	EXP:ARG:睡眠姦経験 += 1
ENDIF
RETURN 1

@TrackPainInsertU(ARG)
; u pain stuffs
LOCAL = 200
LOCAL:1 = 150
IF EXP:ARG:Ｖ経験 < EXPLV:2
	TIMES LOCAL , 0.80
	TIMES LOCAL:1 , 1.20
ELSEIF EXP:ARG:Ｖ経験 < EXPLV:3
	TIMES LOCAL , 0.40
ELSEIF EXP:ARG:Ｖ経験 < EXPLV:4
	TIMES LOCAL , 0.10
ELSEIF EXP:ARG:Ｖ経験 < EXPLV:5
	TIMES LOCAL , 0.00
ELSEIF EXP:ARG:Ｖ経験 >= EXPLV:5
	TIMES LOCAL , 0.00
ENDIF

;PALAM:潤滑をみる
IF PALAM:ARG:潤滑 < PALAMLV:1
	TIMES LOCAL, 3.00
	TIMES LOCAL:1 , 3.00
ELSEIF PALAM:ARG:潤滑 < PALAMLV:2
	TIMES LOCAL , 2.00
	TIMES LOCAL:1 , 2.50
ELSEIF PALAM:ARG:潤滑 < PALAMLV:3
	TIMES LOCAL , 0.60
	TIMES LOCAL:1 , 1.50
ELSEIF PALAM:ARG:潤滑 < PALAMLV:4
	TIMES LOCAL , 0.50
	TIMES LOCAL:1 , 1.00
ELSEIF PALAM:ARG:潤滑 < PALAMLV:5
	TIMES LOCAL , 0.10
	TIMES LOCAL:1 , 0.50
ELSEIF PALAM:ARG:潤滑 >= PALAMLV:5
	TIMES LOCAL , 0.02
	TIMES LOCAL:1 , 0.30
ENDIF

SOURCE:ARG:苦痛 += LOCAL

SIF !FLAG:70
	SOURCE:ARG:反感 += LOCAL:1