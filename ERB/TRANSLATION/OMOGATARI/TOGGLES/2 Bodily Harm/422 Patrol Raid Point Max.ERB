@CUSTOM_FETISH_NAME_FACTIONS_422(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nFactionPatrol
    RETURNF
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Max Raid Points for Patrols"
CASE "enabled"
    CFM_RETURN '= @"{nFactionPatrolPointMax}pts"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Max raid points when faction patrols are generated."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_422
FOR LOCAL, 100, 3100,100
    ;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
    SELECTCASE LOCAL
    CASE 100, 300, 500, 700, 800, 1000, 1200, 1500, 1700, 2000 ,3000, nFactionPatrolPointMax
    CASEELSE
        RESETCOLOR
        CONTINUE
    ENDSELECT

    ;color
    SELECTCASE LOCAL
    CASE IS < 300
        SETCOLOR C_PINK
    CASE IS < 600
        SETCOLOR C_AQUA
    CASE IS < 1000
        SETCOLOR C_GREEN
    CASE 1000
        RESETCOLOR
    CASE IS < 1300
        SETCOLOR C_YELLOW
    CASE IS < 2000
        SETCOLOR 0xE9967A
    CASE IS < 3000
        SETCOLOR C_RED
    CASEELSE
        SETCOLOR C_D_RED
    ENDSELECT
    PRINTBUTTON @"[{LOCAL}] ", LOCAL
    SIF nFactionPatrolPointMax == LOCAL
        PRINTFORM (current)
NEXT
PRINTL
RESETCOLOR
PRINTL  [-1] Back
INPUT

SELECTCASE RESULT
CASE -1
	RETURN
CASE IS >= 0
nFactionPatrolPointMax = RESULT 
ENDSELECT