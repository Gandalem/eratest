; Modular ERB: OMOGATARI/TOGGLES/2 Bodily Harm/422 Patrol Raid Point Max.ERB

@CUSTOM_FETISH_NAME_FACTIONS_422(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nFactionPatrol
	RETURNF
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"순찰에 대한 최대 레이드 포인트"
	CASE "enabled"
		CFM_RETURN '= @"{nFactionPatrolPointMax}pts"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"파벌 순찰대가 생성될 때 최대 레이드 포인트이다."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_422
FOR LOCAL, 100, 3100,100
;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
SELECTCASE LOCAL
	CASE 100, 300, 500, 700, 800, 1000, 1200, 1500, 1700, 2000 ,3000, nFactionPatrolPointMax
	CASEELSE
		RESETCOLOR
		CONTINUE
ENDSELECT
;color
SELECTCASE LOCAL
	CASE IS < 300
		SETCOLOR C_PINK
	CASE IS < 600
		SETCOLOR C_AQUA
	CASE IS < 1000
		SETCOLOR C_GREEN
	CASE 1000
		RESETCOLOR
	CASE IS < 1300
		SETCOLOR C_YELLOW
	CASE IS < 2000
		SETCOLOR 0xE9967A
	CASE IS < 3000
		SETCOLOR C_RED
	CASEELSE
		SETCOLOR C_D_RED
ENDSELECT
PRINTBUTTON @"[{LOCAL}] ", LOCAL
SIF nFactionPatrolPointMax == LOCAL
	PRINTFORM (현재)
NEXT
PRINTL
RESETCOLOR
PRINTL  [-1] 뒤로
INPUT
SELECTCASE RESULT
	CASE -1
		RETURN
	CASE IS >= 0
		nFactionPatrolPointMax = RESULT
ENDSELECT
