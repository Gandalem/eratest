; Modular ERB: OMOGATARI/TOGGLES/2 Bodily Harm/412 Raid Point Multiplier.ERB

@CUSTOM_FETISH_NAME_FACTIONS_412(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nRaids
	RETURNF
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"레이드 포인트 배율"
	CASE "enabled"
		CFM_RETURN '= @"{nRaidPointMultiplier}\%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"레이드가 생성될 때 레이드 포인트에 대한 배율을 조정한다. 이는 전투능력에 따라 레이드가 어떻게 성장하는지 조절한다."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_412
FOR LOCAL, 1, 301
;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
SELECTCASE LOCAL
	CASE 10, 30, 50, 70, 80, 100, 120, 150, 170, 200 ,300, nRaidPointMultiplier
	CASEELSE
		RESETCOLOR
		CONTINUE
ENDSELECT
;color
SELECTCASE LOCAL
	CASE IS < 30
		SETCOLOR C_D_RED
	CASE IS < 60
		SETCOLOR C_RED
	CASE IS < 100
		SETCOLOR 0xE9967A
	CASE 100
		RESETCOLOR
	CASE IS < 130
		SETCOLOR C_P_GREEN
	CASE IS < 200
		SETCOLOR C_GREEN
	CASE IS < 300
		SETCOLOR C_AQUA
	CASEELSE
		SETCOLOR C_PINK
ENDSELECT
PRINTBUTTON @"[{LOCAL}] ", LOCAL
SIF nRaidPointMultiplier == LOCAL
	PRINTFORM (현재)
NEXT
PRINTL
RESETCOLOR
PRINTL  [-1] 뒤로
INPUT
SELECTCASE RESULT
	CASE -1
		RETURN
	CASE IS >= 0
		nRaidPointMultiplier = RESULT
ENDSELECT
