@CUSTOM_FETISH_NAME_FACTIONS_412(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nRaids
    RETURNF
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Raid Point multiplier"
CASE "enabled"
    CFM_RETURN '= @"{nRaidPointMultiplier}\%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Multiplier for raid points when raids are generated. This adjusts how raids grow depending on combat ability"
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_412
FOR LOCAL, 1, 301
    ;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
    SELECTCASE LOCAL
    CASE 10, 30, 50, 70, 80, 100, 120, 150, 170, 200 ,300, nRaidPointMultiplier
    CASEELSE
        RESETCOLOR
        CONTINUE
    ENDSELECT

    ;color
    SELECTCASE LOCAL
    CASE IS < 30
        SETCOLOR C_D_RED
    CASE IS < 60
        SETCOLOR C_RED
    CASE IS < 100
        SETCOLOR 0xE9967A
    CASE 100
        RESETCOLOR
    CASE IS < 130
        SETCOLOR C_P_GREEN
    CASE IS < 200
        SETCOLOR C_GREEN
    CASE IS < 300
        SETCOLOR C_AQUA
    CASEELSE
        SETCOLOR C_PINK
    ENDSELECT
    PRINTBUTTON @"[{LOCAL}] ", LOCAL
    SIF nRaidPointMultiplier == LOCAL
        PRINTFORM (current)
NEXT
PRINTL
RESETCOLOR
PRINTL  [-1] Back
INPUT

SELECTCASE RESULT
CASE -1
	RETURN
CASE IS >= 0
nRaidPointMultiplier = RESULT 
ENDSELECT