; Modular ERB: OMOGATARI/TOGGLES/2 Bodily Harm/400 Factions.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_FACTIONS_400(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"파벌 시스템을 활성화한다"
	CASE "nameHCT"
		CFM_RETURN '= "FACTIONS"
	CASE "descriptionHCT"
		CFM_RETURN '= "Enables factions, as well as wars and raids."
	CASE "enabled"
		CFM_RETURN '= @" \@ nFactions ? 예 # 아니요 \@"
	CASE "header"
		CFM_RETURN '= @"세력"
	CASE "description"
		CFM_RETURN '= "Enables factions which characters are allied and hostile towards.\nCharacters who are allied in the same faction will help each other but if they're hostile, they'll fight."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_400
nFactions = !nFactions
