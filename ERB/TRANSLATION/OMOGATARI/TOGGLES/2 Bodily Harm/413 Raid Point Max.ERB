@CUSTOM_FETISH_NAME_FACTIONS_413(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nRaids
    RETURNF
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Max Raid Points"
CASE "enabled"
    CFM_RETURN '= @"{nRaidPointMax}pts"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Max raid points when raids are generated. This adjusts the max difficulty for raids"
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_413
FOR LOCAL, 1000, 31000,1000
    ;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
    SELECTCASE LOCAL
    CASE 1000, 3000, 5000, 7000, 8000, 10000, 12000, 15000, 17000, 20000 ,30000, nRaidPointMax
    CASEELSE
        RESETCOLOR
        CONTINUE
    ENDSELECT

    ;color
    SELECTCASE LOCAL
    CASE IS < 3000
        SETCOLOR C_PINK
    CASE IS < 6000
        SETCOLOR C_AQUA
    CASE IS < 10000
        SETCOLOR C_GREEN
    CASE 10000
        RESETCOLOR
    CASE IS < 13000
        SETCOLOR C_YELLOW
    CASE IS < 20000
        SETCOLOR 0xE9967A
    CASE IS < 30000
        SETCOLOR C_RED
    CASEELSE
        SETCOLOR C_D_RED
    ENDSELECT
    PRINTBUTTON @"[{LOCAL}] ", LOCAL
    SIF nRaidPointMax == LOCAL
        PRINTFORM (current)
NEXT
PRINTL
RESETCOLOR
PRINTL  [-1] Back
INPUT

SELECTCASE RESULT
CASE -1
	RETURN
CASE IS >= 35
nRaidPointMax = RESULT 
CASEELSE
REUSELASTLINE Invalid Input
RESTART
ENDSELECT