; Modular ERB: OMOGATARI/TOGGLES/2 Bodily Harm/402 Default Team.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_FACTIONS_402(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"레이드 및 전투의 기본 팀"
	CASE "enabled"
		SELECTCASE nRaiderPick
			CASE 0
				CFM_RETURN '= @"항상 묻는다"
			CASE 1
				CFM_RETURN '= @"피해자들"
			CASE 2
				CFM_RETURN '= @"약탈자들의"
			CASE 3
				CFM_RETURN '= @"관여하지 않는 한 절대 안 된다"
		ENDSELECT
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Default team to join when a raid or battle happens."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_402
IF nRaiderPick >= 3
	nRaiderPick = 0
ELSE
	nRaiderPick ++
ENDIF
