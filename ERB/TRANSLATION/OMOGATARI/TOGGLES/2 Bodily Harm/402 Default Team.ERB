;TEMPLATE

@CUSTOM_FETISH_NAME_FACTIONS_402(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Default team for Raids and Battles"
CASE "enabled"
    SELECTCASE nRaiderPick
    CASE 0
    CFM_RETURN '= @"Always Ask"
    CASE 1
    CFM_RETURN '= @"Victims'"
    CASE 2
    CFM_RETURN '= @"Raiders'"
    CASE 3
    CFM_RETURN '= @"Never unless you're involved"
    ENDSELECT
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Default team to join when a raid or battle happens."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_402
IF nRaiderPick >= 3
    nRaiderPick = 0
ELSE
    nRaiderPick ++
ENDIF