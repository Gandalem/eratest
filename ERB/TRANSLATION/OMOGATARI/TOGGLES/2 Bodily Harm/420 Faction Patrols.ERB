;TEMPLATE

@CUSTOM_FETISH_NAME_FACTIONS_420(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nFactions
    RETURNF
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Enable faction patrols"
CASE "enabled"
    CFM_RETURN '= @" \@ nFactionPatrol ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @"Faction Patrols"
CASE "description"
    CFM_RETURN '= @"Factions will send in a small amount of units to patrol around your home area."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_420
nFactionPatrol = !nFactionPatrol
