; Modular ERB: OMOGATARI/TOGGLES/2 Bodily Harm/420 Faction Patrols.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_FACTIONS_420(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nFactions
	RETURNF
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"진영 순찰 활성화"
	CASE "enabled"
		CFM_RETURN '= @" \@ nFactionPatrol ? Yes # No \@"
	CASE "header"
		CFM_RETURN '= @"파벌 순찰"
	CASE "description"
		CFM_RETURN '= @"세력들은 당신의 홈 지역 주변을 순찰하기 위해 소량의 유닛을 보낼 것이다."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_420
nFactionPatrol = !nFactionPatrol
