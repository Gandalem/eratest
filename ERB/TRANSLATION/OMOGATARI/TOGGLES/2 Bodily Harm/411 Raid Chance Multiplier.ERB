@CUSTOM_FETISH_NAME_FACTIONS_411(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nRaids
    RETURNF
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Raid Chance multiplier"
CASE "enabled"
    CFM_RETURN '= @"{nRaidChanceMultiplier}\%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Multiplier for chance of a raid happening every hour."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_411
FOR LOCAL, 1, 301
    ;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
    SELECTCASE LOCAL
    CASE 10, 30, 50, 70, 80, 100, 120, 150, 170, 200 ,300, nRaidChanceMultiplier
    CASEELSE
        RESETCOLOR
        CONTINUE
    ENDSELECT

    ;color
    SELECTCASE LOCAL
    CASE IS < 30
        SETCOLOR C_PINK
    CASE IS < 60
        SETCOLOR C_AQUA
    CASE IS < 100
        SETCOLOR C_GREEN
    CASE 100
        RESETCOLOR
    CASE IS < 130
        SETCOLOR C_YELLOW
    CASE IS < 200
        SETCOLOR 0xE9967A
    CASE IS < 300
        SETCOLOR C_RED
    CASEELSE
        SETCOLOR C_D_RED
    ENDSELECT
    PRINTBUTTON @"[{LOCAL}] ", LOCAL
    SIF nRaidChanceMultiplier == LOCAL
        PRINTFORM (current)
NEXT
PRINTL
RESETCOLOR
PRINTL  [-1] Back
INPUT

SELECTCASE RESULT
CASE -1
	RETURN
CASE IS >= 0
nRaidChanceMultiplier = RESULT 
ENDSELECT