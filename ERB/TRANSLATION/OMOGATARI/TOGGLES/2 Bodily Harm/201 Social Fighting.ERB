;TEMPLATE

@CUSTOM_FETISH_NAME_COMBAT_201(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Enable social fighting"
CASE "enabled"
    CFM_RETURN '= @" \@ nSocialFighting ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Characters with low affinities will fight each-other."
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_201
nSocialFighting = !nSocialFighting
