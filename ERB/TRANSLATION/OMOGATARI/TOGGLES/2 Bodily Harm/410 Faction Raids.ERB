;TEMPLATE

@CUSTOM_FETISH_NAME_FACTIONS_410(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nFactions
    RETURNF
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Interval for enemy raids"
CASE "enabled"
    CFM_RETURN '= @"\@ nRaids ? {nRaids} days per raid # Disabled \@"
CASE "header"
    CFM_RETURN '= @"Raids"
CASE "description"
    CFM_RETURN '= "Enables enemy raids, calculated by wealth and combat strength."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_410
PRINTFORML Pleae input how many break days there should be between raids
PRINTFORML [{0,2}] Disabled
FOR LOCAL,1,15
PRINTFORML [{LOCAL,2}] days
NEXT
RESETCOLOR
PRINTFORML [999] Stop
INPUT
IF RESULT < 0 && RESULT != 999
	PRINTFORML Minimum interval between raids can't be shorter than 1 day!
	FORCEWAIT
ELSEIF RESULT == 999
	RETURN
ELSE
	nRaids = RESULT
ENDIF
