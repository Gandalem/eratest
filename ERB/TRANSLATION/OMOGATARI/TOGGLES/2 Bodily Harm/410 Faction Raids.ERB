; Modular ERB: OMOGATARI/TOGGLES/2 Bodily Harm/410 Faction Raids.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_FACTIONS_410(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nFactions
	RETURNF
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"적의 습격 간격"
	CASE "enabled"
		CFM_RETURN '= @"\@ nRaids ? {nRaids}일당 레이드에 참여한다 # 비활성화 \@"
	CASE "header"
		CFM_RETURN '= @"레이드"
	CASE "description"
		CFM_RETURN '= "Enables enemy raids, calculated by wealth and combat strength."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_410
PRINTFORML 레이드 사이에 몇 개의 휴식일이 있어야 하는지 입력해 주세요.
PRINTFORML [{0,2}] 비활성화됨
FOR LOCAL,1,15
PRINTFORML [{LOCAL,2}] 날
NEXT
RESETCOLOR
PRINTFORML [999] 정지
INPUT
IF RESULT < 0 && RESULT != 999
	PRINTFORML 레이드 간의 최소 간격은 하루보다 짧을 수 없다!
	FORCEWAIT
ELSEIF RESULT == 999
	RETURN
ELSE
	nRaids = RESULT
ENDIF
