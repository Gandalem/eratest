; Modular ERB: OMOGATARI/TOGGLES/2 Bodily Harm/401 Faction Wars.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_FACTIONS_401(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"파벌 전쟁"
	CASE "enabled"
		CFM_RETURN '= @"\@ nFactionWar ? 활성화됨 # 비활성화됨 \@."
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Enables factions to formally declare war, alliances, and truces against other factions."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_401
nFactionWar = !nFactionWar
