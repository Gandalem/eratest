;TEMPLATE

@CUSTOM_FETISH_NAME_FACTIONS_401(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Faction wars"
CASE "enabled"
    CFM_RETURN '= @"\@ nFactionWar ? Enabled # Disabled \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Enables factions to formally declare war, alliances, and truces against other factions."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_401
nFactionWar = !nFactionWar