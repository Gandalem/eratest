;TEMPLATE

@CUSTOM_FETISH_NAME_COMBAT_300(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Enable character deaths"
CASE "nameHCT"
    CFM_RETURN '= "NECRO"
CASE "descriptionHCT"
    CFM_RETURN '= "Sexual depictions of death and snuff."
CASE "enabled"
    SELECTCASE nNecro
    CASE 0
        CFM_RETURN '= @"No"
    CASE 1
        CFM_RETURN '= @"Deaths Only"
    CASE 2
        CFM_RETURN '= @"Deaths + Necro"
    ENDSELECT
CASE "header"
    CFM_RETURN '= @"Necrophilia"
CASE "description"
    CFM_RETURN '= @"Allows characters to die and allows for sexual interaction between corpses (Body Part System must be enabled)"
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_300
IF nNecro == 2
nNecro = 0
ELSE
nNecro ++
ENDIF