; Modular ERB: OMOGATARI/TOGGLES/2 Bodily Harm/300 Necrophillia.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_COMBAT_300(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"캐릭터 사망 활성화"
	CASE "nameHCT"
		CFM_RETURN '= "NECRO"
	CASE "descriptionHCT"
		CFM_RETURN '= "Sexual depictions of death and snuff."
	CASE "enabled"
		SELECTCASE nNecro
			CASE 0
				CFM_RETURN '= @"No"
			CASE 1
				CFM_RETURN '= @"사망만"
			CASE 2
				CFM_RETURN '= @"죽음 + 네크로"
		ENDSELECT
	CASE "header"
		CFM_RETURN '= @"네크로필리아"
	CASE "description"
		CFM_RETURN '= @"캐릭터가 죽도록 허용하며 시체 간의 성적 상호작용을 가능하게 한다(신체 부위 시스템이 활성화되어 있어야 함)."
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_300
IF nNecro == 2
	nNecro = 0
ELSE
	nNecro ++
ENDIF
