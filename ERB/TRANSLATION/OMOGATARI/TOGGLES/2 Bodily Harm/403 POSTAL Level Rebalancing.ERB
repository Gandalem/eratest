@CUSTOM_FETISH_NAME_COMBAT_403(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"POSTAL Level Rebalancing"
CASE "enabled"
    CFM_RETURN '= @"\@ nPOSTALLevel != -1 ? Level {nPOSTALLevel} # None \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Characters in POSTAL mode will have their levels rebalanced to this level if lower than it."
ENDSELECT
@CUSTOM_FETISH_RESULT_COMBAT_403
#DIM curRank = -1
#DIM  RANK       ;評価ランク、数が小さいほど優秀
#DIM  RANK_NUM   ;評価尺度に含まれる評価の種数

PRINTFORML Please enter a value
PRINTFORML [-1] - Original Values
FOR LOCAL,0,(MaxNonHLevel+1)
	SELECTCASE LOCAL
	CASE 0 TO UniversalRank("Extra"), UniversalRank("Phantasm"), UniversalRank("OverDrive"), UniversalRank("TriUltra"), UniversalRank("QuadUltra")
		CALL PRINT_RANK(LOCAL,"MAX_6")
		PRINTBUTTON @" {LOCAL}", LOCAL
		PRINTFORML
	ENDSELECT
NEXT

PRINTFORML [-2] Cancel
INPUT
SIF RESULT != -2
nPOSTALLevel = RESULT