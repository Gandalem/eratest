; Modular ERB: OMOGATARI/TOGGLES/2 Bodily Harm/421 Patrol Chance Multiplier.ERB

@CUSTOM_FETISH_NAME_FACTIONS_421(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nFactionPatrol
	RETURNF
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"순찰 확률 배율"
	CASE "enabled"
		CFM_RETURN '= @"{nFactionPatrolChanceMultiplier}\%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"매시간 발생할 확률의 배율이다. 비활성화하려면 0으로 설정한다."
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_421
FOR LOCAL, 1, 301
;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
SELECTCASE LOCAL
	CASE 10, 30, 50, 70, 80, 100, 120, 150, 170, 200 ,300, nFactionPatrolChanceMultiplier
	CASEELSE
		RESETCOLOR
		CONTINUE
ENDSELECT
;color
SELECTCASE LOCAL
	CASE IS < 30
		SETCOLOR C_PINK
	CASE IS < 60
		SETCOLOR C_AQUA
	CASE IS < 100
		SETCOLOR C_GREEN
	CASE 100
		RESETCOLOR
	CASE IS < 130
		SETCOLOR C_YELLOW
	CASE IS < 200
		SETCOLOR 0xE9967A
	CASE IS < 300
		SETCOLOR C_RED
	CASEELSE
		SETCOLOR C_D_RED
ENDSELECT
PRINTBUTTON @"[{LOCAL}] ", LOCAL
SIF nFactionPatrolChanceMultiplier == LOCAL
	PRINTFORM (현재)
NEXT
PRINTL
RESETCOLOR
PRINTL  [-1] 뒤로
INPUT
SELECTCASE RESULT
	CASE -1
		RETURN
	CASE IS >= 0
		nFactionPatrolChanceMultiplier = RESULT
ENDSELECT
