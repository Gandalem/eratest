@CUSTOM_FETISH_NAME_FACTIONS_421(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nFactionPatrol
    RETURNF
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Patrol Chance multiplier"
CASE "enabled"
    CFM_RETURN '= @"{nFactionPatrolChanceMultiplier}\%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Multiplier for chance of a faction patrol every hour. Set to 0 to disable"
ENDSELECT

@CUSTOM_FETISH_RESULT_FACTIONS_421
FOR LOCAL, 1, 301
    ;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
    SELECTCASE LOCAL
    CASE 10, 30, 50, 70, 80, 100, 120, 150, 170, 200 ,300, nFactionPatrolChanceMultiplier
    CASEELSE
        RESETCOLOR
        CONTINUE
    ENDSELECT

    ;color
    SELECTCASE LOCAL
    CASE IS < 30
        SETCOLOR C_PINK
    CASE IS < 60
        SETCOLOR C_AQUA
    CASE IS < 100
        SETCOLOR C_GREEN
    CASE 100
        RESETCOLOR
    CASE IS < 130
        SETCOLOR C_YELLOW
    CASE IS < 200
        SETCOLOR 0xE9967A
    CASE IS < 300
        SETCOLOR C_RED
    CASEELSE
        SETCOLOR C_D_RED
    ENDSELECT
    PRINTBUTTON @"[{LOCAL}] ", LOCAL
    SIF nFactionPatrolChanceMultiplier == LOCAL
        PRINTFORM (current)
NEXT
PRINTL
RESETCOLOR
PRINTL  [-1] Back
INPUT

SELECTCASE RESULT
CASE -1
	RETURN
CASE IS >= 0
nFactionPatrolChanceMultiplier = RESULT 
ENDSELECT