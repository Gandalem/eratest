;TEMPLATE

@CUSTOM_FETISH_NAME_COMBAT_200(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Enable blood and hard pain"
CASE "enabled"
    LOCALS =
    IF nRyona == 2   
        IF GROUPMATCH(nSJW, 1, 3, 4, 5)
            nRyona = 1
            LOCALS += "STATE COMPLIANCE VIOLATION: RESETTING RYONA SETTINGS TO \"Yes\""
        ELSE
            LOCALS += "Yes, including gore"
        ENDIF
    ELSEIF nRyona == 1
        LOCALS += "Yes"
    ELSE
        LOCALS += "No"
    ENDIF
    CFM_RETURN '= @"%LOCALS%"
CASE "header"
    CFM_RETURN '= @"Physical Harm"
CASE "description"
    CFM_RETURN '= @"Enables characters to get harmed physically"
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_200
IF nRyona == 2
nRyona = 0
ELSE
nRyona ++
ENDIF