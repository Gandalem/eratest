; Modular ERB: OMOGATARI/TOGGLES/2 Bodily Harm/200 Physical Harm.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_COMBAT_200(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"피와 고통을 활성화한다."
	CASE "enabled"
		LOCALS =
		IF nRyona == 2
			IF GROUPMATCH(nSJW, 1, 3, 4, 5)
				nRyona = 1
				LOCALS += "STATE COMPLIANCE VIOLATION: RESETTING RYONA SETTINGS TO \"Yes\""
			ELSE
				LOCALS += "네, 고어 포함"
			ENDIF
		ELSEIF nRyona == 1
			LOCALS += "네"
		ELSE
			LOCALS += "No"
		ENDIF
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @"물리적 피해"
	CASE "description"
		CFM_RETURN '= @"캐릭터가 물리적인 피해를 입을 수 있게 한다."
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_200
IF nRyona == 2
	nRyona = 0
ELSE
	nRyona ++
ENDIF
