;TEMPLATE

@CUSTOM_FETISH_NAME_GENERAL_800(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Disable Traits"
CASE "enabled"
    CFM_RETURN '= @""
CASE "header"
    CFM_RETURN '= @"Game Customization"
CASE "description"
    CFM_RETURN '= @"Disable certain traits from the game."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_800
PRINTL 　Traits that are disabled will not appear in the game.
DRAWLINE
FOR LOCAL:1, 1, 300
	LOCAL = LOCAL:1
	SIF GET_TALENTNAME_TR(LOCAL,1) == ""
		CONTINUE
	SIF (GROUPMATCH(LOCAL,2,3,5,6,7,8,29,34,46,47,48,49,51,52,53,55,57,58,73,74,75,76,77,78,79,95,121,122,157,158,159,160,161,164,165,166,167,169,170,171,172,173,174,175,176,178,180,183,189,190,191,192,193,194,195,196,197,198,199,220,221,222,223,224,225,1215,230,232,234,250,254,255,256,257,258,259,260,261,262,263,264,270,271,272,273,274, 100, 105))
		CONTINUE
	SIF GROUPMATCH(LOCAL, 27, 144, 242, 243, 109, 110, 111)
		CONTINUE
	
	SIF GROUPMATCH(LOCAL, 96, 97)
		CONTINUE
	
	SIF TraitDisabled:LOCAL
		SETCOLOR C_D_RED
	PRINTFORMLC [{LOCAL, 3}] %GET_TALENTNAME_TR(LOCAL,1)%
	RESETCOLOR
NEXT
PRINTL 　
DRAWLINE
PRINTFORML [999] Finish (disabled: {TraitDisabledCount} \@ TraitDisabledCount != 1 ? traits # trait \@)　[998] Reset  [900] Disable negative traits
$LOOP
INPUT
IF RESULT >= 1 && RESULT <= 300
	IF TraitDisabled:RESULT
		TraitDisabled:RESULT = 0
		TraitDisabledCount --
	ELSE
		TraitDisabled:RESULT = 1
		TraitDisabledCount ++
	ENDIF
	RESTART
ELSEIF RESULT == 999
	PRINTW Settings applied.
ELSEIF RESULT == 900
	FOR LOCAL,1,300
		SIF (!GROUPMATCH(LOCAL,25, 20, 21, 22, 81))
			CONTINUE
		SIF !TraitDisabled:LOCAL
			TraitDisabledCount ++
		TraitDisabled:LOCAL = 1
	NEXT
	RESTART
ELSEIF RESULT == 998
	FOR LOCAL,1,300
		TraitDisabled:LOCAL = 0
	NEXT
	TraitDisabledCount = 0
	RESTART
ELSE
	GOTO LOOP
ENDIF