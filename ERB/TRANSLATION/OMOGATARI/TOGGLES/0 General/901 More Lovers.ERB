; Modular ERB: OMOGATARI/TOGGLES/0 General/901 More Lovers.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_GENERAL_901(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"더 많은 연인들"
	CASE "enabled"
		CFM_RETURN '= @"「\@ MORELOVER ? 예 # 아니요 \@」"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "By default, you can only have one lover. This setting bypasses that."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_901
CALL MORELOVER_TOGGLE
IF CHARANUM > 0
	CALL MORELOVERDLC
ENDIF
