;TEMPLATE

@CUSTOM_FETISH_NAME_GENERAL_901(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"More lovers"
CASE "enabled"
    CFM_RETURN '= @"\@ MORELOVER ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "By default, you can only have one lover. This setting bypasses that."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_901
CALL MORELOVER_TOGGLE
IF CHARANUM > 0
CALL MORELOVERDLC
ENDIF
