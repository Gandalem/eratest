; Modular ERB: OMOGATARI/TOGGLES/0 General/902 Eastern Names.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_VISUAL_902(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"동양식 이름 형식"
	CASE "enabled"
		SELECTCASE nNameSorting:0
			CASE 0
				LOCALS '= @"성(姓)/별 이름 먼저 (스마트)"
			CASE 1
				LOCALS '= @"이름 성 중간이름"
			CASE 2
				LOCALS '= @"마지막 중간 첫 번째"
			CASE 3
				LOCALS '= @"첫 번째 이름 마지막"
			CASE 4
				LOCALS '= @"마지막 이름이 첫 번째"
		ENDSELECT
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @"이름"
	CASE "description"
		CFM_RETURN '= @"%nameArrayTemp:na_Name% -> %NameChecker(-1)%"
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_902
IF nNameSorting:0 == 4
	nNameSorting:0 = 0
ELSE
	nNameSorting:0 ++
ENDIF
