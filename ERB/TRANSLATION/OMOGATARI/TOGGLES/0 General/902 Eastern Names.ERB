;TEMPLATE

@CUSTOM_FETISH_NAME_VISUAL_902(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Eastern name format"
CASE "enabled"
    SELECTCASE nNameSorting:0
    CASE 0
        LOCALS '= @"Last Middle/Nick First (Smart)"
    CASE 1
        LOCALS '= @"First Middle Last"
    CASE 2
        LOCALS '= @"Last Middle First"
    CASE 3
        LOCALS '= @"First Nick Last"
    CASE 4
        LOCALS '= @"Last Nick First"
    ENDSELECT
    CFM_RETURN '= @"%LOCALS%"
CASE "header"
    CFM_RETURN '= @"Names"
CASE "description"
    CFM_RETURN '= @"%nameArrayTemp:na_Name% -> %NameChecker(-1)%"
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_902
IF nNameSorting:0 == 4
nNameSorting:0 = 0
ELSE
nNameSorting:0 ++
ENDIF
