;TEMPLATE

@CUSTOM_FETISH_NAME_SEX_103(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Reverse Training"
CASE "enabled"
    CFM_RETURN =
    ;clit/peen
    SIF GETBIT(nReverseTrain,0)
        CFM_RETURN += "Ｃ"
    ;vagina
    SIF GETBIT(nReverseTrain,1)
        CFM_RETURN += "Ｖ"
    ;anus
    SIF GETBIT(nReverseTrain,2)
        CFM_RETURN += "Ａ"
    ;breasts
    SIF GETBIT(nReverseTrain,3)
        CFM_RETURN += "Ｂ"
    ;mouth
    SIF GETBIT(nReverseTrain,4)
        CFM_RETURN += "Ｍ"
    ;urethra
    SIF GETBIT(nReverseTrain,5)
        CFM_RETURN += "Ｕ"
    ;wings
    SIF GETBIT(nReverseTrain,6)
        CFM_RETURN += "Ｗ"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Allows for certain parts to be trained on the player by others."
ENDSELECT

@CUSTOM_FETISH_RESULT_SEX_103
#DIMS OPTION_NAME,6

OPTION_NAME:0 '= "Clit/Penis"
OPTION_NAME:1 '= "Vagina"
OPTION_NAME:2 '= "Anus"
OPTION_NAME:3 '= "Breasts"
OPTION_NAME:4 '= "Mouth"
OPTION_NAME:5 '= "Urethra"

DO
PRINTFORML Select which modules to enable.
FOR LOCAL, 0, VARSIZE("OPTION_NAME")
	SIF GETBIT(nReverseTrain,LOCAL)
		SETCOLOR C_YELLOW
	PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
	RESETCOLOR
NEXT
PRINTL  [999] Back
INPUT

SELECTCASE RESULT
CASE 999
	BREAK
CASEELSE
INVERTBIT nReverseTrain, RESULT 
ENDSELECT
LOOP 1

;RETURNF "Ｃo"
;RETURNF "Ｎl"