; Modular ERB: OMOGATARI/TOGGLES/0 General/103 Reverse Training.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_SEX_103(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"역방향 훈련"
	CASE "enabled"
		CFM_RETURN =
		;clit/peen
		SIF GETBIT(nReverseTrain,0)
			CFM_RETURN += "Ｃ"
		;vagina
		SIF GETBIT(nReverseTrain,1)
			CFM_RETURN += "Ｖ"
		;anus
		SIF GETBIT(nReverseTrain,2)
			CFM_RETURN += "Ａ"
		;breasts
		SIF GETBIT(nReverseTrain,3)
			CFM_RETURN += "Ｂ"
		;mouth
		SIF GETBIT(nReverseTrain,4)
			CFM_RETURN += "Ｍ"
		;urethra
		SIF GETBIT(nReverseTrain,5)
			CFM_RETURN += "Ｕ"
		;wings
		SIF GETBIT(nReverseTrain,6)
			CFM_RETURN += "Ｗ"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"다른 사람들이 플레이어에게 특정 부분을 훈련시키는 것을 허용한다."
ENDSELECT

@CUSTOM_FETISH_RESULT_SEX_103
#DIMS OPTION_NAME,6
OPTION_NAME:0 '= "음핵/음경"
OPTION_NAME:1 '= "질"
OPTION_NAME:2 '= "항문"
OPTION_NAME:3 '= "유방"
OPTION_NAME:4 '= "입"
OPTION_NAME:5 '= "요도"
DO
PRINTFORML 활성화할 모듈을 선택한다.
FOR LOCAL, 0, VARSIZE("OPTION_NAME")
SIF GETBIT(nReverseTrain,LOCAL)
	SETCOLOR C_YELLOW
PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
RESETCOLOR
NEXT
PRINTL  [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 999
		BREAK
	CASEELSE
		INVERTBIT nReverseTrain, RESULT
ENDSELECT
LOOP 1
;RETURNF "Ｃo"
;RETURNF "Ｎl"
