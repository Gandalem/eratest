@CUSTOM_FETISH_NAME_COMBAT_303(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nNecro
	RETURNF
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"시신들"
	CASE "enabled"
		CFM_RETURN '= @"\@ GETBIT(nExtraRooms,1) ? 예 # 아니오 \@"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Temporarily body storage."
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_303
INVERTBIT nExtraRooms, 1
