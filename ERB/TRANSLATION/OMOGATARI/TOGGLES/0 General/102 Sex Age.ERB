; Modular ERB: OMOGATARI/TOGGLES/0 General/102 Sex Age.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_SEX_102(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"최소 성인 연령"
	CASE "enabled"
		CFM_RETURN '= @" {nMinSexAge}년"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Minimum biological age for sexual activity to happen"
ENDSELECT

@CUSTOM_FETISH_RESULT_SEX_102
PRINTFORML 성관계를 가지기 위해 캐릭터가 가져야 할 최소 연령을 입력해 주십시오.
FOR N, 3, 81
SIF TOSTR_LifeStage(N) != LOCALS
	PRINTFORML [{N,2}] - %TOSTR_LifeStage(N)%
LOCALS '= TOSTR_LifeStage(N)
NEXT
PRINTL
PRINTFORML [-1] - 떠나다
INPUT
SIF INRANGE(RESULT, 3, 80)
	nMinSexAge = RESULT
