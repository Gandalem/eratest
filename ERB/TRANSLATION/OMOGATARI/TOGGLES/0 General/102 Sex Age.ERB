;TEMPLATE

@CUSTOM_FETISH_NAME_SEX_102(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Minimum Sex Age"
CASE "enabled"
    CFM_RETURN '= @" {nMinSexAge} years"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Minimum biological age for sexual activity to happen"
ENDSELECT

@CUSTOM_FETISH_RESULT_SEX_102
PRINTFORML Please input the minimum age that characters have to be to have sex.
FOR N, 3, 81
	SIF TOSTR_LifeStage(N) != LOCALS
		PRINTFORML [{N,2}] - %TOSTR_LifeStage(N)%
	LOCALS '= TOSTR_LifeStage(N)
NEXT
PRINTL
PRINTFORML [-1] - Leave
INPUT
SIF INRANGE(RESULT, 3, 80)
	nMinSexAge = RESULT