;TEMPLATE

@CUSTOM_FETISH_NAME_SEX_400(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
RETURNF ;not ready
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Allowed Forms"
CASE "enabled"
    LOCALS =
    SIF GETBIT(nHomo,0)
        LOCALS += @"Male-on-Male、"
    SIF GETBIT(nHomo,1)
        LOCALS += @"Female-on-Female、"
    IF LOCALS != ""
        LOCALS '= LIST_IN_STRING(LOCALS)
    ELSE
        LOCALS '= "None"
    ENDIF
    CFM_RETURN '= @"%LOCALS%"
CASE "header"
    CFM_RETURN '= @"Homosexuality (doesn't work yet)"
CASE "description"
    CFM_RETURN '= "Respective actions also includes Andro-on-Andro and Futa-on-Futa"
ENDSELECT

@CUSTOM_FETISH_RESULT_SEX_400
#DIMS OPTION_NAME,2

OPTION_NAME:0 '= "Male-on-Male"
OPTION_NAME:1 '= "Female-on-Female"

DO
PRINTFORML Select which modules to enable.
FOR LOCAL, 0, 2
	SIF GETBIT(nHomo,LOCAL)
		SETCOLOR C_YELLOW
	PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
	RESETCOLOR
NEXT
PRINTL  [999] Back
INPUT
SELECTCASE RESULT
CASE 999
	BREAK
CASEELSE
INVERTBIT nHomo, RESULT 
ENDSELECT
LOOP 1