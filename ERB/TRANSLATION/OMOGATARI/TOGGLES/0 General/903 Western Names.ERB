; Modular ERB: OMOGATARI/TOGGLES/0 General/903 Western Names.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_VISUAL_903(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"서양식 이름 형식"
	CASE "enabled"
		SELECTCASE nNameSorting:1
			CASE 0
				LOCALS '= @"이름 중간/닉네임 성(스마트)"
			CASE 1
				LOCALS '= @"이름 중간 성"
			CASE 2
				LOCALS '= @"마지막 중간 이름"
			CASE 3
				LOCALS '= @"이름 성"
			CASE 4
				LOCALS '= @"마지막 이름 우선"
		ENDSELECT
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"%nameArrayTemp:na_Name% -> %NameChecker(-1)%"
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_903
IF nNameSorting:1 == 4
	nNameSorting:1 = 0
ELSE
	nNameSorting:1 ++
ENDIF
