;TEMPLATE

@CUSTOM_FETISH_NAME_VISUAL_903(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Western name format"
CASE "enabled"
    SELECTCASE nNameSorting:1
    CASE 0
        LOCALS '= @"First Middle/Nick Last (Smart)"
    CASE 1
        LOCALS '= @"First Middle Last"
    CASE 2
        LOCALS '= @"Last Middle First"
    CASE 3
        LOCALS '= @"First Nick Last"
    CASE 4
        LOCALS '= @"Last Nick First"
    ENDSELECT
    CFM_RETURN '= @"%LOCALS%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"%nameArrayTemp:na_Name% -> %NameChecker(-1)%"
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_903
IF nNameSorting:1 == 4
nNameSorting:1 = 0
ELSE
nNameSorting:1 ++
ENDIF