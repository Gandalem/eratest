; Modular ERB: OMOGATARI/TOGGLES/0 General/802 More Toilets.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_EXCRETE_802(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"더 많은 변기들"
	CASE "enabled"
		CFM_RETURN '= @"\@ GETBIT(nExtraRooms,0) ? 예 # 아니오 \@"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Adds private toilets to all character's bedrooms. Disabling may cause long toilet queues."
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_802
INVERTBIT nExtraRooms, 0
