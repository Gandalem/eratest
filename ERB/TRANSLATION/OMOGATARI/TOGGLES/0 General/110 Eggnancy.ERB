;TEMPLATE

@CUSTOM_FETISH_NAME_SEX_110(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Eggnancy"
CASE "enabled"
    CFM_RETURN '= @"\@ GETBIT(EggnancyGlobs,0) ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @"Pr(Egg)nancy"
CASE "description"
    CFM_RETURN '= @"Egg or clutch layers keeps their eggs inside of their body and becomes visibly pregnant."
ENDSELECT

@CUSTOM_FETISH_RESULT_SEX_110
INVERTBIT EggnancyGlobs, 0
