; Modular ERB: OMOGATARI/TOGGLES/0 General/110 Eggnancy.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_SEX_110(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"임신"
	CASE "enabled"
		CFM_RETURN '= @"\@ GETBIT(EggnancyGlobs,0) ? Yes # No \@"
	CASE "header"
		CFM_RETURN '= @"임신"
	CASE "description"
		CFM_RETURN '= @"알 또는 산란하는 암컷은 몸 안에 알을 품고 눈에 띄게 임신한다."
ENDSELECT

@CUSTOM_FETISH_RESULT_SEX_110
INVERTBIT EggnancyGlobs, 0
