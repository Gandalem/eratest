;TEMPLATE

@CUSTOM_FETISH_NAME_VISUAL_904(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Verbose Item Names"
CASE "enabled"
    LOCALS =
    SIF GETBIT(nVerboseItems,3)
    LOCALS += "Real Names、"
    SIF GETBIT(nVerboseItems,2)
    LOCALS += "Underwear、"
    SIF GETBIT(nVerboseItems,1)
    LOCALS += "Weapons、"
    SIF GETBIT(nVerboseItems,0)
    LOCALS += "Items、"
    IF LOCALS != ""
    LOCALS '= LIST_IN_STRING(LOCALS)
    ELSE
    LOCALS '= "No"
    ENDIF
    CFM_RETURN '= @"%LOCALS%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Get fake brand names instead of generic labels for items."
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_904
#DIMS OPTION_NAME,4

OPTION_NAME:0 '= "Items"
OPTION_NAME:1 '= "Weapons"
OPTION_NAME:2 '= "Underwear"
OPTION_NAME:3 '= "Real Names"

DO
PRINTFORML Select which modules to enable.
FOR LOCAL, 0, 4
	SIF GETBIT(nVerboseItems,LOCAL)
		SETCOLOR C_YELLOW
	PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
	RESETCOLOR
NEXT
PRINTL  [999] Back
INPUT

SELECTCASE RESULT
CASE 999
	BREAK
CASEELSE
INVERTBIT nVerboseItems, RESULT 
ENDSELECT
LOOP 1