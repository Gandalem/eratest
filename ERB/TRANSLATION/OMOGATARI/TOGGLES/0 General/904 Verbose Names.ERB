; Modular ERB: OMOGATARI/TOGGLES/0 General/904 Verbose Names.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_VISUAL_904(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"상세한 아이템 이름들"
	CASE "enabled"
		LOCALS =
		SIF GETBIT(nVerboseItems,3)
			LOCALS += "실명、"
		SIF GETBIT(nVerboseItems,2)
			LOCALS += "속옷、"
		SIF GETBIT(nVerboseItems,1)
			LOCALS += "무기、"
		SIF GETBIT(nVerboseItems,0)
			LOCALS += "아이템、"
		IF LOCALS != ""
			LOCALS '= LIST_IN_STRING(LOCALS)
		ELSE
			LOCALS '= "아니오"
		ENDIF
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "아이템의 일반 명칭 대신 가상의 상표와 제품명을 표시합니다."
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_904
#DIMS OPTION_NAME,4
OPTION_NAME:0 '= "아이템"
OPTION_NAME:1 '= "무기"
OPTION_NAME:2 '= "속옷"
OPTION_NAME:3 '= "실명들"
DO
PRINTFORML 활성화할 모듈을 선택한다.
FOR LOCAL, 0, 4
SIF GETBIT(nVerboseItems,LOCAL)
	SETCOLOR C_YELLOW
PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
RESETCOLOR
NEXT
PRINTL  [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 999
		BREAK
	CASEELSE
		INVERTBIT nVerboseItems, RESULT
ENDSELECT
LOOP 1
