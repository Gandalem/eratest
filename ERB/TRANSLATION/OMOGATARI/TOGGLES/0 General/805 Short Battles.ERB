@CUSTOM_FETISH_NAME_COMBAT_805(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"짧은 전투 설명"
	CASE "enabled"
		CFM_RETURN '= @"\@ nNASQOL:1 ? 예 # 아니오 \@."
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "전투 중간 묘사를 생략하고 결과만 간단히 출력합니다."
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_805
