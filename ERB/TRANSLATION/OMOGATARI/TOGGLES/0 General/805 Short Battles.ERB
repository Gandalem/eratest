;TEMPLATE

@CUSTOM_FETISH_NAME_COMBAT_805(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Short Battle Descriptions"
CASE "enabled"
    CFM_RETURN '= @"\@ nNASQOL:1 ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Skips the semi-verbose descriptions and simply prints out the results during a battle."
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_805
nNASQOL:1 = !nNASQOL:1
