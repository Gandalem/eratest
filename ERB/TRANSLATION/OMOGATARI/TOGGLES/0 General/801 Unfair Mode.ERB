; Modular ERB: OMOGATARI/TOGGLES/0 General/801 Unfair Mode.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_GENERAL_801(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"메모리 및 불공정한 콘텐츠 활성화"
	CASE "enabled"
		CFM_RETURN '= @"「\@ nUnfair ? 예 # 아니오 \@」"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "캐릭터나 세계에 심각한 영향을 줄 수 있는 다소 불공정한 이벤트를 활성화합니다.\n(예: 남성 캐릭터 56번, 무작위 이름)"
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_801
#DIMS OPTION_NAME,5
OPTION_NAME:0 '= "일반 불공정 콘텐츠"
OPTION_NAME:1 '= "무작위 이름"
OPTION_NAME:2 '= "무츠교의 맹세"
OPTION_NAME:3 '= "오하이오식 작업"
OPTION_NAME:4 '= "새집에는 총배설강이 없다"
DO
PRINTFORML 활성화할 모듈을 선택한다.
FOR LOCAL, 0, VARSIZE("OPTION_NAME")
SIF !STRLENS(OPTION_NAME:LOCAL)
	CONTINUE
SIF GETBIT(nUnfair,LOCAL)
	SETCOLOR C_YELLOW
PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
RESETCOLOR
NEXT
PRINTL  [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 999
		BREAK
	CASEELSE
		INVERTBIT nUnfair, RESULT
ENDSELECT
LOOP 1
