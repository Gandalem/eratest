; Modular ERB: OMOGATARI/TOGGLES/0 General/801 Unfair Mode.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_GENERAL_801(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"메모리 및 불공정한 콘텐츠 활성화"
	CASE "enabled"
		CFM_RETURN '= @"「\@ nUnfair ? 예 # 아니오 \@」"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Enables rather unfair events which can severely affect a character or the world.\n(ie: Male character #56, Random Names)"
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_801
#DIMS OPTION_NAME,5
OPTION_NAME:0 '= "General Unfair Content"
OPTION_NAME:1 '= "Random Names"
OPTION_NAME:2 '= "Mutsuist Pledge"
OPTION_NAME:3 '= "Ohio Rizz"
OPTION_NAME:4 '= "Birdhous Don't Have Cloacas"
DO
PRINTFORML 활성화할 모듈을 선택한다.
FOR LOCAL, 0, VARSIZE("OPTION_NAME")
SIF !STRLENS(OPTION_NAME:LOCAL)
	CONTINUE
SIF GETBIT(nUnfair,LOCAL)
	SETCOLOR C_YELLOW
PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
RESETCOLOR
NEXT
PRINTL  [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 999
		BREAK
	CASEELSE
		INVERTBIT nUnfair, RESULT
ENDSELECT
LOOP 1
