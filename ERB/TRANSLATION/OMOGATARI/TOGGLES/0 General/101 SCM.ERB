; Modular ERB: OMOGATARI/TOGGLES/0 General/101 SCM.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_GENERAL_0(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
[IF_DEBUG]
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"상태 준수 모드"
	CASE "enabled"
		CFM_RETURN '= @"%StateComplienceMode()%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"NASGen을 위한 것은 아니지만, /EGG/에서는 5개의 페티시를 가진 게임을 삭제할 것이다."
ENDSELECT
[ENDIF]

@CUSTOM_FETISH_RESULT_GENERAL_0
[IF_NDEBUG]
RETURN
[ENDIF]
PRINTFORML 상태 준수 모드를 활성화하면 특정 기능이 영구적으로 비활성화됩니다.
PRINTFORML [0] - 사용 안 함
PRINTFORML 비활성화됨: 없음
PRINTL
PRINTFORML [1] - /EGG/ 승인됨 
PRINTFORML 비활성화됨: 고어, 네크로필리아, 스캣, 기저귀
PRINTL
PRINTFORML [2] - 느슨함
PRINTFORML 비활성화됨: 로리콘 (강제 연령 상승)
PRINTL
PRINTFORML [3] - 보통
PRINTFORML 비활성화됨: 로리콘, 고어, 하드 스캣(정돈 이상 모든 것), 네크로필리아
PRINTL
PRINTFORML [4] - 엄격함
PRINTFORML 비활성화됨: 로리콘, 고어, 하드 스캣, 네크로필리아, 비동의 콘텐츠
PRINTL
PRINTFORML [5] - 신성한 순수함
PRINTFORML 비활성화됨: 모든 것
INPUT
nSJW = RESULT
SELECTCASE RESULT
	CASE 0
		PRINTFORMW 좋은 선택이다.
	CASE 1
		PRINTFORMW 더 이상 기저귀는 없어 :cirhappy:	
	CASE 2
		PRINTFORMW 묘사된 모든 캐릭터는 이제 만 21세 이상이다
	CASE 3
		PRINTFORMW 그냥 이걸 하나씩 꺼도 되는데, 뭐 상관없지.
	CASE 4
		PRINTFORMW 내가 평범한 애가 이 게임을 한다고 기대했나?
	CASEELSE
		PRINTFORMW 유튜브가 이제 행복하다.
		nSJW = 5
ENDSELECT
