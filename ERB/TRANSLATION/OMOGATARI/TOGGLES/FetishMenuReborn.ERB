@PRINT_CUSTOM_FETISH_FMR(ARG, ARGS, ARGS:1, ARGS:2)
IF ARGS != "" || ARGS:1 != ""
	SELECTCASE ARGS:1
	CASE "Scatology"
		IF GROUPMATCH(nSJW, 1, 5)
		GOTO FetishDisabled
		ELSEIF GROUPMATCH(nSJW, 1, 3, 4, 5)
		PRINTFORML
		SETCOLOR C_YELLOW
		PRINTFORML %ARGS:1%
		PRINTFORML Restricted to softcore play (ie: messings)
		PRINTFORML
		RESETCOLOR		
		GOTO BYPASS
		ENDIF
	CASE "Necrophilia"
		IF GROUPMATCH(nSJW, 1, 3, 4, 5)
		$FetishDisabled
		[SKIPSTART]
		PRINTFORML
		SETCOLOR C_YELLOW
		PRINTFORML %TOUPPER(ARGS:1)% DISABLED DUE TO STATE COMPLIENCE MODE
		[SKIPEND]
		PRINTFORML
		RESETCOLOR
		RETURN
		ENDIF
	CASE "Adult Baby, Diaper Lover"
		IF GROUPMATCH(nSJW, 1, 5)
			GOTO FetishDisabled
		ENDIF	
	CASE "General Sexual Content", "Urine", "Ryona", "Factions"
		IF GROUPMATCH(nSJW, 5)
			GOTO FetishDisabled
		ENDIF
	CASE "Rape"
		IF GROUPMATCH(nSJW, 4, 5)
			GOTO FetishDisabled
		ENDIF
	ENDSELECT

	IF STRLENS(ARGS:1)
		SIF COLUMNDIV:0:LINE > 1
		CALL columnDivPRINTL
		CALL columnDivPRINTL, 0, ARGS:1, TO_HEX(C_YELLOW)
	ENDIF 
	$BYPASS
	SIF ARGS != ""
		CALL columnDivPRINTL, 0, @"[{ARG, 3}] - %ARGS%", , ARG

	IF ARGS:2 != ""
		FOR LOCAL,0,STRCOUNT(ARGS:2,"\n")+1
			CALL columnDivPRINTL, 0, SPLIT_SINGLE(ARGS:2, LOCAL,"\n"), TO_HEX(C_GRAY)
		NEXT
	ENDIF 
ENDIF

