; Modular ERB: OMOGATARI/TOGGLES/320 Public Mode.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_DEBUG_320(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
[IF_NDEBUG]
RETURNF
[ENDIF]
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"공개 모드"
	CASE "enabled"
		CFM_RETURN '= @"%YesOrNo(nPublicMode)%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"디버그: 빠르고 거친 공개 모드이며, 외설적인 이미지와 사운드를 비활성화한다."
ENDSELECT

@CUSTOM_FETISH_RESULT_DEBUG_320
nPublicMode = !nPublicMode
