;TEMPLATE

@CUSTOM_FETISH_NAME_DEBUG_320(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
[IF_NDEBUG]
RETURNF
[ENDIF]
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Public Mode"
CASE "enabled"
    CFM_RETURN '= @"%YesOrNo(nPublicMode)%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Debug: Quick and scuffed Public Mode, disables obscene images and sound."
ENDSELECT

@CUSTOM_FETISH_RESULT_DEBUG_320
nPublicMode = !nPublicMode
