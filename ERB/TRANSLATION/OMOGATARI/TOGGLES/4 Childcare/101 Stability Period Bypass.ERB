;TEMPLATE

@CUSTOM_FETISH_NAME_PREG_101(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Bypass Stable Period"
CASE "enabled"
    CFM_RETURN '= @" \@ nGlobalStableBypass ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Bypasses the period of pregnancy where you can't have sex"
ENDSELECT

@CUSTOM_FETISH_RESULT_PREG_101
nGlobalStableBypass = !nGlobalStableBypass