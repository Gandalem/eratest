@CUSTOM_FETISH_NAME_PREG_100(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Pregnancy"
CASE "enabled"
    CFM_RETURN '= @" \@ nChildren ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Enables pregnancy and the children system. This does NOT disable lolicon. Use the disable character feature for that. You NPC"
ENDSELECT

@CUSTOM_FETISH_RESULT_PREG_100
nChildren = !nChildren