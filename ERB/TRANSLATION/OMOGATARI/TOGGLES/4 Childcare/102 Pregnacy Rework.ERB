@CUSTOM_FETISH_NAME_PREG_102(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Pregnancy Rework"
CASE "enabled"
    CFM_RETURN '= @"\@ GETBIT(NASFeature,7) ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Reworks ejaculations and filling rates to be more realistic."
ENDSELECT




@CUSTOM_FETISH_RESULT_PREG_102
INVERTBIT NASFeature, 7