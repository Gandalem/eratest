@CUSTOM_FETISH_NAME_GENERAL_1(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Max Tech Level"
CASE "enabled"
    CFM_RETURN '= @"%AllTechLevels(nMaxTech)%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Maximum level of technology that can be found and researched in Gensokyo."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_1
FOR LOCAL,0, MAX_TECH_LEVEL+1
	PRINTFORML [{LOCAL}] - %AllTechLevels(LOCAL)%
NEXT
PRINTL
PRINTFORML [999] - Leave
INPUT
SIF RESULT <= MAX_TECH_LEVEL
	nMaxTech = RESULT