; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/308 Technical Knowledge from General.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_GENERAL_104(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"일반 지식으로부터 얻은 기술적 지식"
	CASE "enabled"
		CFM_RETURN '= @"%YesOrNo(GETBIT(NASFeature,12))%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"일반 지식을 레벨 업하여 기술적 지식을 레벨 업한다."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_104
INVERTBIT NASFeature,12
