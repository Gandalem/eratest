;TEMPLATE

@CUSTOM_FETISH_NAME_GENERAL_104(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Technical Knowledge from General Knowledge"
CASE "enabled"
    CFM_RETURN '= @"%YesOrNo(GETBIT(NASFeature,12))%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Level up technical knowledge by leveling up general knowledge."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_104
INVERTBIT NASFeature,12