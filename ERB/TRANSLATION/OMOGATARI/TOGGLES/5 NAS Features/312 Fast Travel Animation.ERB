; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/312 Fast Travel Animation.ERB

@CUSTOM_FETISH_NAME_VISUAL_312(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"빠른 이동 애니메이션"
	CASE "enabled"
		CFM_RETURN '= @"%YesOrNo(nFastTravelAnimations)%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Show an animation when a fast travel item such as vehicles are used."
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_312
nFastTravelAnimations = !nFastTravelAnimations
