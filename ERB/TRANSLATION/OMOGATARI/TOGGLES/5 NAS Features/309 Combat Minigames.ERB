@CUSTOM_FETISH_NAME_COMBAT_409(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Combat Minigames"
CASE "enabled"
    LOCALS =
    SIF GETBIT(nCombatMinigames,2)
    LOCALS += "TSP to increase accuracy、"
    SIF GETBIT(nCombatMinigames,1)
    LOCALS += "TSP to dodge、"
    SIF GETBIT(nCombatMinigames,0)
    LOCALS += "Dodging minigame、"
    IF LOCALS != ""
    LOCALS '= LIST_IN_STRING(LOCALS)
    ELSE
    LOCALS '= "No"
    ENDIF
    CFM_RETURN '= @"%LOCALS%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Allows for the dodging minigame and the option to use TSP to dodge."
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_409
#DIMS OPTION_NAME,3

OPTION_NAME:0 '= "Dodging minigame"
OPTION_NAME:1 '= "Option to use TSP to dodge"
OPTION_NAME:2 '= "Option to use TSP to increase accuracy"

DO
PRINTFORML Select which modules to enable.
FOR LOCAL, 0, 3
	SIF GETBIT(nCombatMinigames,LOCAL)
		SETCOLOR C_YELLOW
	PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
	RESETCOLOR
NEXT
PRINTL  [999] Back
INPUT

SELECTCASE RESULT
CASE 999
	BREAK
CASEELSE
INVERTBIT nCombatMinigames, RESULT 
ENDSELECT
LOOP 1