; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/309 Combat Minigames.ERB

@CUSTOM_FETISH_NAME_COMBAT_409(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"전투 미니게임"
	CASE "enabled"
		LOCALS =
		SIF GETBIT(nCombatMinigames,2)
			LOCALS += "명중률을 높이는 TSP、"
		SIF GETBIT(nCombatMinigames,1)
			LOCALS += "회피용 TSP、"
		SIF GETBIT(nCombatMinigames,0)
			LOCALS += "회피 미니게임、"
		IF LOCALS != ""
			LOCALS '= LIST_IN_STRING(LOCALS)
		ELSE
			LOCALS '= "아니오"
		ENDIF
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Allows for the dodging minigame and the option to use TSP to dodge."
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_409
#DIMS OPTION_NAME,3
OPTION_NAME:0 '= "회피 미니게임"
OPTION_NAME:1 '= "TSP를 사용하여 회피하는 옵션"
OPTION_NAME:2 '= "정확도를 높이기 위해 TSP를 사용할 수 있는 옵션"
DO
PRINTFORML 활성화할 모듈을 선택한다.
FOR LOCAL, 0, 3
SIF GETBIT(nCombatMinigames,LOCAL)
	SETCOLOR C_YELLOW
PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
RESETCOLOR
NEXT
PRINTL  [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 999
		BREAK
	CASEELSE
		INVERTBIT nCombatMinigames, RESULT
ENDSELECT
LOOP 1
