;TEMPLATE

@CUSTOM_FETISH_NAME_QOL_402(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Disable newspaper posts"
CASE "enabled"
    CFM_RETURN '= @""
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @""
ENDSELECT

@CUSTOM_FETISH_RESULT_QOL_402
DO
CALL ICPRINT(@"Posts marked in <Red> will not be triggered when starting a day.", "L", C_D_RED)
FOR LOCAL:2,0,VARSIZE("NEWSPAPER_DISABLE")
	VARSET NEWSPAPER_AD_NAME
	VARSET NEWSPAPER_AD_CANDO
	TRYCALLFORMF NEWSPAPER_{LOCAL:2}_INFO
	SIF NEWSPAPER_AD_NAME == ""
		CONTINUE
	SIF NEWSPAPER_DISABLE:(LOCAL:2)
		SETCOLOR C_D_RED
	PRINTFORMLC [{LOCAL:2}] %NEWSPAPER_AD_NAME%
	RESETCOLOR
NEXT
DRAWLINE
PRINTFORML [-5] Disable Tips
PRINTFORML [-4] Disable Ads
PRINTFORML [-3] Disable Game Ads
PRINTFORML [-2] Reenable All

PRINTFORML [-1] Stop
INPUT
SELECTCASE RESULT
	CASE -3,-4,-5
		SELECTCASE RESULT
		CASE -3
			LOCALS '= "Game Ad"
		CASE -4
			LOCALS '= "Ad"
		CASE -5
			LOCALS '= "Tips"
		ENDSELECT

		FOR LOCAL:2,0,VARSIZE("NEWSPAPER_DISABLE")
			VARSET NEWSPAPER_AD_TYPE
			TRYCALLFORMF NEWSPAPER_{LOCAL:2}_INFO
			SIF NEWSPAPER_AD_TYPE != LOCALS
				CONTINUE
			SIF NEWSPAPER_DISABLE:(LOCAL:2)
				SETCOLOR C_D_RED
			NEWSPAPER_DISABLE:(LOCAL:2) = 1
		NEXT
	CASE -2
		VARSET NEWSPAPER_DISABLE
	CASE -1
	RETURN
	CASE IS > -1
	NEWSPAPER_DISABLE:RESULT = !NEWSPAPER_DISABLE:RESULT
ENDSELECT
LOOP 1