@CUSTOM_FETISH_NAME_QOL_400(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Max daily events"
CASE "enabled"
    CFM_RETURN '= @"\@ nMaxEvents ? {nMaxEvents} # None \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Max number of daily events when the day ends"
ENDSELECT
@CUSTOM_FETISH_RESULT_QOL_400
DRAWLINE
PRINTFORML Select the maximum amount of possible daily events
FOR LOCAL, 0, 11
	PRINTFORML [{LOCAL}] events
NEXT
PRINTFORML [999] events
PRINTFORML
PRINTFORML [-1] - Get me out of here!
INPUT

IF RESULT >= 0
nMaxEvents = RESULT
ENDIF