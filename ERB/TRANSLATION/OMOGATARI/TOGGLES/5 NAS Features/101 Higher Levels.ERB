@CUSTOM_FETISH_NAME_GENERAL_101(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Higher Level Cap"
CASE "enabled"
    CFM_RETURN '= @" %YesOrNo(GETBIT(NASFeature,0))%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Expands the level cap from Extra {UniversalRank("Extra")} to QuadUltra {UniversalRank("QuadUltra")}."
ENDSELECT
@CUSTOM_FETISH_RESULT_GENERAL_101
INVERTBIT NASFeature, 0
