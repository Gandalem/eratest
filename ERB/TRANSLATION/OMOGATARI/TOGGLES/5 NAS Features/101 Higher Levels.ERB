; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/101 Higher Levels.ERB

@CUSTOM_FETISH_NAME_GENERAL_101(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"상위 레벨 한계"
	CASE "enabled"
		CFM_RETURN '= @" %YesOrNo(GETBIT(NASFeature,0))%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"레벨 상한을 Extra {UniversalRank("Extra")}에서 QuadUltra {UniversalRank("QuadUltra")}로 확장한다."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_101
INVERTBIT NASFeature, 0
