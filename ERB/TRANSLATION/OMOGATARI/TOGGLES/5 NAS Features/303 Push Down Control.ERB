; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/303 Push Down Control.ERB

@CUSTOM_FETISH_NAME_NPC_303(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"너를 쓰러뜨린 자를 제어해라"
	CASE "enabled"
		CFM_RETURN '= @" %YesOrNo(GETBIT(NASFeature,8))%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "You temporarily become the character that pushed you down during partner led sex."
ENDSELECT

@CUSTOM_FETISH_RESULT_NPC_303
INVERTBIT NASFeature, 8
