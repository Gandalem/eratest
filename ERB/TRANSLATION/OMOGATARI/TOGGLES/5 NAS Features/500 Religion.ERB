@CUSTOM_FETISH_NAME_GENERAL_500(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Enable the Religion System"
CASE "enabled"
    CFM_RETURN '= @"%YesOrNo(GETBIT(nReligions,0))%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Religions affect what characters can do what stuff."
ENDSELECT
@CUSTOM_FETISH_RESULT_GENERAL_500
INVERTBIT nReligions, 0