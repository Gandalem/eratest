; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/500 Religion.ERB

@CUSTOM_FETISH_NAME_GENERAL_500(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"종교 시스템 활성화"
	CASE "enabled"
		CFM_RETURN '= @"%YesOrNo(GETBIT(nReligions,0))%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"종교는 캐릭터가 무엇을 할 수 있는지에 영향을 준다."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_500
INVERTBIT nReligions, 0
