@CUSTOM_FETISH_NAME_NPC_306(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Endurance System"
CASE "enabled"
    CFM_RETURN '= @" %YesOrNo(nEnduranceScaleStats)%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Some scales such as Sanity, Continence, and Addiction use a scale which can go to either extreme."
ENDSELECT
@CUSTOM_FETISH_RESULT_NPC_306
nEnduranceScaleStats = !nEnduranceScaleStats