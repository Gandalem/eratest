@CUSTOM_FETISH_NAME_COMBAT_413(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Automatically Let Go Surrendees"
CASE "enabled"
    CFM_RETURN '= @"%YesOrNo(nAutoLetGoSurrendee)%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Automatically use the【Demand money】option when characters surrender in battle"
ENDSELECT
@CUSTOM_FETISH_RESULT_COMBAT_413
nAutoLetGoSurrendee = !nAutoLetGoSurrendee
