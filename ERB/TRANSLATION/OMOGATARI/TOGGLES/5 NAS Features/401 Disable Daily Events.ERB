; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/401 Disable Daily Events.ERB

@CUSTOM_FETISH_NAME_QOL_401(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"일일 이벤트 비활성화"
	CASE "enabled"
		CFM_RETURN '= @""
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @""
ENDSELECT

@CUSTOM_FETISH_RESULT_QOL_401
DO
CALL ICPRINT(@"<Red>에 표시된 이벤트는 하루가 끝날 때 발동되지 않는다.", "L", C_D_RED)
FOR LOCAL:2,0,1001
SIF DAILY_EV_NAMES(LOCAL:2) == ""
	CONTINUE
SIF eventDisabled:(LOCAL:2)
	SETCOLOR C_D_RED
PRINTFORMLC [{LOCAL:2}] %DAILY_EV_NAMES(LOCAL:2)%
RESETCOLOR
NEXT
DRAWLINE
PRINTFORML [-1] 정지
INPUT
SELECTCASE RESULT
	CASE -1
		RETURN
	CASEELSE
		eventDisabled:RESULT = !eventDisabled:RESULT
ENDSELECT
LOOP 1
