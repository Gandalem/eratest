; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/310 Max Conventional Weapon Tech.ERB

@CUSTOM_FETISH_NAME_COMBAT_410(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"최대 일반 무기 기술 레벨"
	CASE "enabled"
		CFM_RETURN '= @"%AllTechLevels(nMaxWeaponTech)%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Maximum tech level for conventional weaponry. Does not affect Youjutsu weapons."
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_410
FOR LOCAL,0, MAX_TECH_LEVEL+1
PRINTFORML [{LOCAL}] - %AllTechLevels(LOCAL)%
NEXT
PRINTL
PRINTFORML [999] - 나가기
INPUT
SIF RESULT <= MAX_TECH_LEVEL
	nMaxWeaponTech = RESULT
