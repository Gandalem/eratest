; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/201 Intrusive Sounds.ERB

@CUSTOM_FETISH_NAME_AUDIO_201(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"침범하는 소리"
	CASE "enabled"
		IF nIntrusiveSounds == -1
			LOCALS '= "게임을 강제 종료한다"
		ELSEIF nIntrusiveSounds == 1
			LOCALS '= "네"
		ELSE
			LOCALS '= "No"
		ENDIF
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "These are effects used in contexts like ejaculation and peeing made to be intrusive and break up text. Disable if you find this annoying"
ENDSELECT

@CUSTOM_FETISH_RESULT_AUDIO_201
IF nIntrusiveSounds == 1
	nIntrusiveSounds = -1
ELSE
	nIntrusiveSounds ++
ENDIF
