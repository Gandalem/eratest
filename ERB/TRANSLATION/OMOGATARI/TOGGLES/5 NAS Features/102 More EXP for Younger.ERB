@CUSTOM_FETISH_NAME_GENERAL_102(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"More EXP for Younger Touhous"
CASE "enabled"
    CFM_RETURN '= @" %YesOrNo(GETBIT(NASFeature,2))%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Younger Touhous gain more experience from every action."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_102
INVERTBIT NASFeature, 2