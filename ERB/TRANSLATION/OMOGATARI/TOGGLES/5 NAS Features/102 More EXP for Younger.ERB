; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/102 More EXP for Younger.ERB

@CUSTOM_FETISH_NAME_GENERAL_102(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"젊은 토우호에게 더 많은 경험치"
	CASE "enabled"
		CFM_RETURN '= @" %YesOrNo(GETBIT(NASFeature,2))%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"젊은 토우후들은 모든 행동으로부터 더 많은 경험을 얻는다."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_102
INVERTBIT NASFeature, 2
