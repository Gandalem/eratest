; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/305 Reputation.ERB

@CUSTOM_FETISH_NAME_NPC_305(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"평판 시스템"
	CASE "enabled"
		CFM_RETURN '= @" %YesOrNo(GETBIT(NASFeature,10))%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Doing good deads to others will give you a reputation which can spread, this can also apply to bad ones too."
ENDSELECT

@CUSTOM_FETISH_RESULT_NPC_305
INVERTBIT NASFeature, 10
