; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/203 Daily Comic.ERB

@CUSTOM_FETISH_NAME_VISUAL_203(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"일일 코믹"
	CASE "enabled"
		CFM_RETURN '= @" %YesOrNo(GETBIT(NASFeature,11))%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Shows a era-related meme when starting a day."
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_203
INVERTBIT NASFeature, 11
