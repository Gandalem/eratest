@CUSTOM_FETISH_NAME_VISUAL_202(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Orgasm flashes"
CASE "enabled"
    CFM_RETURN '= @"\@ nIntrusiveOrgasms ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Flashes in the same way eraReverse does it. Disable if you find this annoying"
ENDSELECT
@CUSTOM_FETISH_RESULT_VISUAL_202
IF nIntrusiveOrgasms == 1
nIntrusiveOrgasms = 0
ELSE
nIntrusiveOrgasms ++
ENDIF
