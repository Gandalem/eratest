; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/311 Research System.ERB

@CUSTOM_FETISH_NAME_GENERAL_311(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"연구 시스템"
	CASE "enabled"
		LOCALS =
		SIF GETBIT(nResearchSystem,2)
			LOCALS += "친밀도 대체 방식、"
		SIF GETBIT(nResearchSystem,1)
			LOCALS += "세력 연구、"
		SIF GETBIT(nResearchSystem,0)
			LOCALS += "개인 연구、"
		IF LOCALS != ""
			LOCALS '= LIST_IN_STRING(LOCALS)
		ELSE
			LOCALS '= "아니오"
		ENDIF
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Enables the research system, which is needed to craft or use some items."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_311
#DIMS OPTION_NAME,3
OPTION_NAME:0 '= "개인 연구"
OPTION_NAME:1 '= "진영 연구"
OPTION_NAME:2 '= "친밀도의 대안이 해제되었다."
DO
PRINTFORML 활성화할 모듈을 선택한다.
FOR LOCAL, 0, 3
SIF GETBIT(nResearchSystem,LOCAL)
	SETCOLOR C_YELLOW
PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
RESETCOLOR
NEXT
PRINTL  [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 999
		BREAK
	CASEELSE
		INVERTBIT nResearchSystem, RESULT
ENDSELECT
LOOP 1
