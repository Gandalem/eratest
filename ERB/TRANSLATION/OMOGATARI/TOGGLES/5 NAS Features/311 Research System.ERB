@CUSTOM_FETISH_NAME_GENERAL_311(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Research System"
CASE "enabled"
    LOCALS =
    SIF GETBIT(nResearchSystem,2)
    LOCALS += "Intimacy Alternative、"
    SIF GETBIT(nResearchSystem,1)
    LOCALS += "Faction Research、"
    SIF GETBIT(nResearchSystem,0)
    LOCALS += "Personal Research、"
    IF LOCALS != ""
    LOCALS '= LIST_IN_STRING(LOCALS)
    ELSE
    LOCALS '= "No"
    ENDIF
    CFM_RETURN '= @"%LOCALS%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Enables the research system, which is needed to craft or use some items."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_311
#DIMS OPTION_NAME,3

OPTION_NAME:0 '= "Personal Research"
OPTION_NAME:1 '= "Faction Research"
OPTION_NAME:2 '= "Alternative for Intimacy unlocks"

DO
PRINTFORML Select which modules to enable.
FOR LOCAL, 0, 3
	SIF GETBIT(nResearchSystem,LOCAL)
		SETCOLOR C_YELLOW
	PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
	RESETCOLOR
NEXT
PRINTL  [999] Back
INPUT

SELECTCASE RESULT
CASE 999
	BREAK
CASEELSE
INVERTBIT nResearchSystem, RESULT 
ENDSELECT
LOOP 1