@CUSTOM_FETISH_NAME_GENERAL_103(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Talent Points"
CASE "enabled"
    CFM_RETURN '= @"\@ nTalentPoints == -999 ? Disabled # {nTalentPoints} points\@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Use a point-based build system for character creation. Positive talents cost points, while negative ones give points."
ENDSELECT
@CUSTOM_FETISH_RESULT_GENERAL_103

PRINTFORML How many points should be given to the player for character creation
PRINTFORML Enter a number that's 0 or higher.
PRINTFORML [  15] - Default
PRINTFORML [-999] - Disable system
PRINTL
PRINTFORML [8888] - Cancel
INPUT
SELECTCASE RESULT
CASE 8888
CASE -999
    nTalentPoints = -999
CASE IS >= 0
    nTalentPoints = RESULT
ENDSELECT