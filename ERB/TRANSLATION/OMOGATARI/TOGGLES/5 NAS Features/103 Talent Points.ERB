; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/103 Talent Points.ERB

@CUSTOM_FETISH_NAME_GENERAL_103(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"재능 포인트"
	CASE "enabled"
		CFM_RETURN '= @"\@ nTalentPoints == -999 ? 비활성화됨 # {nTalentPoints} 포인트 \@"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"캐릭터 생성 시 점 기반 빌드 시스템을 사용한다. 긍정적 재능은 포인트를 소모하고, 부정적인 재능은 포인트를 준다."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_103
PRINTFORML 캐릭터 생성 시 플레이어에게 몇 점을 주어야 합니까
PRINTFORML 0 이상의 숫자를 입력하세요.
PRINTFORML [  15] - 기본값
PRINTFORML [-999] - 시스템 비활성화
PRINTL
PRINTFORML [8888] - 취소
INPUT
SELECTCASE RESULT
	CASE 8888
	CASE -999
		nTalentPoints = -999
	CASE IS >= 0
		nTalentPoints = RESULT
ENDSELECT
