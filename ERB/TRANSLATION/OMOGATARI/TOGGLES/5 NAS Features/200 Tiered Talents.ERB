; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/200 Tiered Talents.ERB

@CUSTOM_FETISH_NAME_QOL_200(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"계층적 재능"
	CASE "enabled"
		CFM_RETURN '= @" %YesOrNo(GETBIT(NASFeature,4))%"
	CASE "header"
		CFM_RETURN '= @"헤드업 디스플레이"
	CASE "description"
		CFM_RETURN '= "Ranks talents and puts them in their order by how good or bad they are."
ENDSELECT

@CUSTOM_FETISH_RESULT_QOL_200
INVERTBIT NASFeature, 4
