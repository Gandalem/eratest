@CUSTOM_FETISH_NAME_VISUAL_302(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Random Names for the Fan Name Characters"
CASE "enabled"
    CFM_RETURN '= @" %YesOrNo(GETBIT(NASFeature,6))%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Instead of 'Koakuma', you would get Jane 'Koakuma' Lester."
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_302
INVERTBIT NASFeature, 6