; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/501 Religion Conversion.ERB

@CUSTOM_FETISH_NAME_GENERAL_501(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"사람들은 다른 종교로 개종할 수 있다."
	CASE "enabled"
		CFM_RETURN '= @"%YesOrNo(GETBIT(nReligions,1))%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @"캐릭터들이 현재 종교에서 다른 종교로 개종할 수 있게 한다."
ENDSELECT

@CUSTOM_FETISH_RESULT_GENERAL_501
INVERTBIT nReligions, 1
