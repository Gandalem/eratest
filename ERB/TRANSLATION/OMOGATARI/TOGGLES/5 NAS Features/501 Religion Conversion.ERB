@CUSTOM_FETISH_NAME_GENERAL_501(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"People can convert to other religions"
CASE "enabled"
    CFM_RETURN '= @"%YesOrNo(GETBIT(nReligions,1))%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @"Allows characters to convert from their current religion to another's."
ENDSELECT
@CUSTOM_FETISH_RESULT_GENERAL_501
INVERTBIT nReligions, 1