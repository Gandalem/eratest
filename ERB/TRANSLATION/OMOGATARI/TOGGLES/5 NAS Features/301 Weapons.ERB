; Modular ERB: OMOGATARI/TOGGLES/5 NAS Features/301 Weapons.ERB

@CUSTOM_FETISH_NAME_COMBAT_401(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"무기"
	CASE "nameHCT"
		CFM_RETURN '= "WEAPONS"
	CASE "descriptionHCT"
		CFM_RETURN '= "Use of conventional weaponry such as firearms and melee weapons."
	CASE "enabled"
		LOCALS =
		SIF GETBIT(nWeapons,0)
			LOCALS += "Danmaku、"
		SIF GETBIT(nWeapons,1)
			LOCALS += "Melee、"
		SIF GETBIT(nWeapons,2)
			LOCALS += "Guns、"
		SIF GETBIT(nWeapons,3)
			LOCALS += "Magic、"
		IF LOCALS != ""
			LOCALS '= LIST_IN_STRING(LOCALS)
		ELSE
			LOCALS '= "No"
		ENDIF
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @"게임플레이"
	CASE "description"
		CFM_RETURN '= "Allow for conventional weaponry such as firearms and melee weapons."
ENDSELECT

@CUSTOM_FETISH_RESULT_COMBAT_401
#DIMS OPTION_NAME,4
OPTION_NAME:0 '= @"단막"
OPTION_NAME:1 '= @"근접 공격"
OPTION_NAME:2 '= @"화기"
OPTION_NAME:3 '= @"마법 주문"
DO
PRINTFORML 활성화할 모듈을 선택한다.
FOR LOCAL, 0, VARSIZE("OPTION_NAME")
SIF GETBIT(nWeapons,LOCAL)
	SETCOLOR C_YELLOW
PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
RESETCOLOR
NEXT
PRINTL  [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 999
		BREAK
	CASEELSE
		INVERTBIT nWeapons, RESULT
ENDSELECT
LOOP 1

@WEAPONS_ENABLED()
#FUNCTION
RETURNF GETBIT(nWeapons,1) || GETBIT(nWeapons,2) || GETBIT(nWeapons,3)
