@CUSTOM_FETISH_NAME_COMBAT_401(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Weapons"
CASE "nameHCT"
    CFM_RETURN '= "WEAPONS"
CASE "descriptionHCT"
    CFM_RETURN '= "Use of conventional weaponry such as firearms and melee weapons."
CASE "enabled"
    LOCALS =


    SIF GETBIT(nWeapons,0)
    LOCALS += "Danmaku、"
    SIF GETBIT(nWeapons,1)
    LOCALS += "Melee、"
    SIF GETBIT(nWeapons,2)
    LOCALS += "Guns、"
    SIF GETBIT(nWeapons,3)
    LOCALS += "Magic、"
    IF LOCALS != ""
    LOCALS '= LIST_IN_STRING(LOCALS)
    ELSE
    LOCALS '= "No"
    ENDIF
    CFM_RETURN '= @"%LOCALS%"
CASE "header"
    CFM_RETURN '= @"Gameplay"
CASE "description"
    CFM_RETURN '= "Allow for conventional weaponry such as firearms and melee weapons."
ENDSELECT
@CUSTOM_FETISH_RESULT_COMBAT_401
#DIMS OPTION_NAME,4

OPTION_NAME:0 '= @"Danmaku"
OPTION_NAME:1 '= @"Melee"
OPTION_NAME:2 '= @"Firearms"
OPTION_NAME:3 '= @"Magic Spells"

DO
PRINTFORML Select which modules to enable.
FOR LOCAL, 0, VARSIZE("OPTION_NAME")
	SIF GETBIT(nWeapons,LOCAL)
		SETCOLOR C_YELLOW
	PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
	RESETCOLOR
NEXT
PRINTL  [999] Back
INPUT

SELECTCASE RESULT
CASE 999
	BREAK
CASEELSE
INVERTBIT nWeapons, RESULT 
ENDSELECT
LOOP 1

@WEAPONS_ENABLED()
#FUNCTION
RETURNF GETBIT(nWeapons,1) || GETBIT(nWeapons,2) || GETBIT(nWeapons,3)