; Modular ERB: OMOGATARI/TOGGLES/1 Excretion/300 Diapers.ERB

@CUSTOM_FETISH_NAME_EXCRETE_300(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"지옥의 문에 기저귀를 추가한다"
	CASE "nameHCT"
		CFM_RETURN '= "ABDL"
	CASE "descriptionHCT"
		CFM_RETURN '= "기저귀와 그 사용을 페티시적으로 묘사하는 내용을 활성화합니다. 옷에 소변이나 대변을 보는 장면도 함께 전환됩니다."
	CASE "enabled"
		SELECTCASE nOmutsu
			CASE 0
				LOCALS '= "아니오"
			CASE 1
				LOCALS '= "유치하고 실금하는"
			CASE 2
				LOCALS '= "유치하고 절제되지 않으며 욕망이 넘친다."
			CASE 3
				LOCALS '= "모든 것"
			CASE 4
				LOCALS '= "강제"
		ENDSELECT
		CFM_RETURN '= @" %LOCALS%"
	CASE "header"
		CFM_RETURN '= @"성인 베이비, 기저귀 연인"
	CASE "description"
		CFM_RETURN '= "Padded expansion for the pee system. Characters with low potty training will wear diapers."
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_300
PRINTFORML 기저귀는 어떻게 분배되어야 하는가.
PRINTL
PRINTFORML [0] 기저귀 비활성화됨.
PRINTFORML [1] 미숙하거나(성인 아기·기저귀 애호가 포함) 실금하는 경우에만 기저귀를 사용한다.
PRINTFORML [2] 변태적인 기저귀가 이상향에 들어왔다. 어떤 캐릭터든 잠재적으로 사용할 수 있다.
PRINTFORML [3] 모두 기저귀 착용 상태이다. 항상.
PRINTFORML [4] 연중무휴 사용. 화장실은 접근 금지.
PRINTL
PRINTFORML [100] 에라 모르겠다
INPUT
SELECTCASE RESULT
	CASE 0 TO 4
		nOmutsu = RESULT
ENDSELECT
