@CUSTOM_FETISH_NAME_EXCRETE_402(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
	CFM_RETURN '= @"NPC Toileting Logic"
CASE "enabled"
	CFM_RETURN '= @"\@ nNPCToileting ? Complex # Simple \@"
CASE "header"
	CFM_RETURN '= @""
CASE "description"
	CFM_RETURN '= "Complex uses the same toileting systems as the player, simple is less intrusive however."
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_402
nNPCToileting = !nNPCToileting