@CUSTOM_FETISH_NAME_EXCRETE_400(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"성적 체액에 의한 오염을 활성화한다."
	CASE "enabled"
		LOCALS =
		SIF GETBIT(nSexExcrete,2)
			LOCALS += "Menstrual Blood、"
		SIF GETBIT(nSexExcrete,1)
			LOCALS += "Pussy Juice、"
		SIF GETBIT(nSexExcrete,0)
			LOCALS += "Semen、"
		IF LOCALS != ""
			LOCALS '= LIST_IN_STRING(LOCALS)
		ELSE
			LOCALS '= "No"
		ENDIF
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @"성적 배설물"
	CASE "description"
		CFM_RETURN '= "Enables soiling of underwear by sexual fluids."
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_400
#DIMS OPTION_NAME,3
OPTION_NAME:0 '= "정액"
OPTION_NAME:1 '= "복숭아 주스"
OPTION_NAME:2 '= "생리혈"
DO
PRINTFORML 활성화할 모듈을 선택한다.
FOR LOCAL, 0, 3
SIF GETBIT(nSexExcrete,LOCAL)
	SETCOLOR C_YELLOW
PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
RESETCOLOR
NEXT
PRINTL  [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 999
		BREAK
	CASEELSE
		INVERTBIT nSexExcrete, RESULT
ENDSELECT
LOOP 1
