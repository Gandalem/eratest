@CUSTOM_FETISH_NAME_EXCRETE_301(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nOmutsu
	RETURNF
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"퇴행 표시를 허용한다."
	CASE "enabled"
		CFM_RETURN '= @"\@ nAdultBaby ? 예 # 아니오 \@"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Allows mental regression and then physical regression at LV3+"
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_301
nAdultBaby = !nAdultBaby
