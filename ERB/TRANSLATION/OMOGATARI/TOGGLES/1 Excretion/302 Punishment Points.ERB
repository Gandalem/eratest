@CUSTOM_FETISH_NAME_EXCRETE_302(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Allow underwear checking and punishment points"
CASE "enabled"
    CFM_RETURN '= @"\@ nPantyPunish ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Allows caregivers (or you) to randomly check your (or another's) underwear to see if it's dry or not, and then change you into more absorbent underwear if you are."
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_302
nPantyPunish = !nPantyPunish
