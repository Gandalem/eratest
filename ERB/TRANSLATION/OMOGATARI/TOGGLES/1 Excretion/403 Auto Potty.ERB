;TEMPLATE

@CUSTOM_FETISH_NAME_EXCRETE_403(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Auto-Potty"
CASE "enabled"
    CFM_RETURN '= @"\@ nNASQOL:0 ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Automatically go to the toilet and bath when waking up and before going to bed."
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_403
nNASQOL = !nNASQOL
