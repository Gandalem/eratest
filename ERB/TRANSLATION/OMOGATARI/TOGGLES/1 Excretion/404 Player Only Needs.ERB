; Modular ERB: OMOGATARI/TOGGLES/1 Excretion/404 Player Only Needs.ERB
;TEMPLATE

@CUSTOM_FETISH_NAME_EXCRETE_404(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"플레이어는 오직 화장실이 필요하다"
	CASE "enabled"
		CFM_RETURN '= @"\@ nPlayerOnlyPottyNeed ? 예 # 아니요 \@"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Excretion needs will be player only if set on."
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_404
nPlayerOnlyPottyNeed = !nPlayerOnlyPottyNeed
