;TEMPLATE

@CUSTOM_FETISH_NAME_EXCRETE_404(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Player only potty needs"
CASE "enabled"
    CFM_RETURN '= @"\@ nPlayerOnlyPottyNeed ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Excretion needs will be player only if set on."
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_404
nPlayerOnlyPottyNeed = !nPlayerOnlyPottyNeed
