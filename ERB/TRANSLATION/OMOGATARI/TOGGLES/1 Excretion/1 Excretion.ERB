@CUSTOM_FETISH_NAME_EXCRETE_100(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Enable urination"
CASE "enabled"
    LOCALS =
    SIF GETBIT(nPee,2)
    LOCALS += "Pee Drinking、"
    SIF GETBIT(nPee,1)
    LOCALS += "Wettings、"
    SIF GETBIT(nPee,0)
    LOCALS += "In Sex Accidents、"
    IF LOCALS != ""
    LOCALS '= LIST_IN_STRING(LOCALS)
    ELSE
    LOCALS '= "No"
    ENDIF
    CFM_RETURN '= @"%LOCALS%"
CASE "header"
    CFM_RETURN '= @"Urine"
CASE "description"
    CFM_RETURN '= @"Enables an in-depth pee system with continence, accidents, and addictions."
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_100
#DIMS OPTION_NAME,3

OPTION_NAME:0 '= "Accidents (In Sex)"
OPTION_NAME:1 '= "Accidents (Outside Sex)"
OPTION_NAME:2 '= "Pee Drinking"

DO
PRINTFORML Select which modules to enable.
FOR LOCAL, 0, 3
	SIF GETBIT(nPee,LOCAL)
		SETCOLOR C_YELLOW
	PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
	RESETCOLOR
NEXT
PRINTL  [999] Back
INPUT

SELECTCASE RESULT
CASE 999
	BREAK
CASEELSE
SIF !nBladderFill
    nBladderFill = 100
INVERTBIT nPee, RESULT 
ENDSELECT
LOOP 1

@CUSTOM_FETISH_NAME_EXCRETE_101(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nPee
    RETURNF
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Allowed Pee Holding Levels"
CASE "enabled"
    LOCALS '= @"{nPeeMinTrain}【%TOSTR_CONTINENCE(nPeeMinTrain)%】 to "
    LOCALS += @"{nPeeMaxTrain}【%TOSTR_CONTINENCE(nPeeMaxTrain)%】"
    CFM_RETURN '= @"%LOCALS%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @""
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_101
DO
PRINTBUTTON @"Minimum pee holding level: {nPeeMinTrain}【%GET_TALENTNAME_TR(1514, nPeeMinTrain)%】", 0
PRINTL
PRINTBUTTON @"Maximum pee holding level: {nPeeMaxTrain}【%GET_TALENTNAME_TR(1514, nPeeMaxTrain)%】", 1
PRINTL
PRINTL  [999] Back
INPUT

SELECTCASE RESULT
CASE 999
	BREAK
CASE 0
	FOR LOCAL,-5,6
	SETCOLOR EnduranceColors(LOCAL)
	PRINTFORML [{LOCAL}] - 【%GET_TALENTNAME_TR(1514, LOCAL)%】 
	NEXT
	RESETCOLOR
	PRINTFORML [999] Stop
	INPUT
	IF RESULT > nPeeMaxTrain && RESULT != 999
		PRINTFORML Minimum pee holding ability cannot be higher than the maximum!
		FORCEWAIT
	ELSEIF INRANGE(RESULT,-5, 5)
		nPeeMinTrain = RESULT
	ELSE
	ENDIF
CASE 1
	FOR LOCAL,-5,6
	SETCOLOR EnduranceColors(LOCAL)
	PRINTFORML [{LOCAL}] - 【%GET_TALENTNAME_TR(1514, LOCAL)%】 
	NEXT
	RESETCOLOR
	PRINTFORML [999] Stop
	INPUT
	IF RESULT < nPeeMinTrain && RESULT != 999
		PRINTFORML Maximum pee holding ability cannot be lower than the minimum!
		FORCEWAIT
	ELSEIF INRANGE(RESULT,-5, 5)
		nPeeMaxTrain = RESULT
	ELSE
	ENDIF
ENDSELECT
LOOP 1


@CUSTOM_FETISH_NAME_EXCRETE_102(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Pee gain multiplier"
CASE "enabled"
    CFM_RETURN '= @"{nBladderFill}\% ({BladderFillAmount(-1,0,60)}ml/hour)"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= @""
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_102
FOR LOCAL, 1, 301
    ;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
    SELECTCASE LOCAL
    CASE 10, 30, 50, 70, 80, 100, 120, 150, 170, 200 ,300, nBladderFill
    CASEELSE
        RESETCOLOR
        CONTINUE
    ENDSELECT

    ;color
    SELECTCASE LOCAL
    CASE IS < 30
        SETCOLOR C_D_RED
    CASE IS < 60
        SETCOLOR C_RED
    CASE IS < 100
        SETCOLOR 0xE9967A
    CASE 100
        RESETCOLOR
    CASE IS < 130
        SETCOLOR C_P_GREEN
    CASE IS < 200
        SETCOLOR C_GREEN
    CASE IS < 300
        SETCOLOR C_AQUA
    CASEELSE
        SETCOLOR C_PINK
    ENDSELECT
    PRINTBUTTON @"[{LOCAL}] ", LOCAL
    SIF nBladderFill == LOCAL
        PRINTFORM (current)
NEXT
PRINTL
RESETCOLOR
PRINTL  [-1] Back
INPUT

SELECTCASE RESULT
CASE -1
	RETURN
CASE IS >= 0
nBladderFill = RESULT 
ENDSELECT

