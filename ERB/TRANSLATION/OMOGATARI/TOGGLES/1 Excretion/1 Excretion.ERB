@CUSTOM_FETISH_NAME_EXCRETE_100(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"배뇨 가능하게 하다"
	CASE "enabled"
		LOCALS =
		SIF GETBIT(nPee,2)
			LOCALS += "Pee Drinking、"
		SIF GETBIT(nPee,1)
			LOCALS += "Wettings、"
		SIF GETBIT(nPee,0)
			LOCALS += "In Sex Accidents、"
		IF LOCALS != ""
			LOCALS '= LIST_IN_STRING(LOCALS)
		ELSE
			LOCALS '= "No"
		ENDIF
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @"소변"
	CASE "description"
		CFM_RETURN '= @"절제, 사고, 중독을 포함하는 심층적인 배설 시스템을 활성화한다."
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_100
#DIMS OPTION_NAME,3
OPTION_NAME:0 '= "실수(성관계 중)"
OPTION_NAME:1 '= "사고 (성관계 외)"
OPTION_NAME:2 '= "오줌 마시기"
DO
PRINTFORML 활성화할 모듈을 선택한다.
FOR LOCAL, 0, 3
SIF GETBIT(nPee,LOCAL)
	SETCOLOR C_YELLOW
PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
RESETCOLOR
NEXT
PRINTL  [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 999
		BREAK
	CASEELSE
		SIF !nBladderFill
			nBladderFill = 100
		INVERTBIT nPee, RESULT
ENDSELECT
LOOP 1

@CUSTOM_FETISH_NAME_EXCRETE_101(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SIF !nPee
	RETURNF
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"허용되는 소변 참기 레벨"
	CASE "enabled"
		LOCALS '= @"{nPeeMinTrain}【%TOSTR_CONTINENCE(nPeeMinTrain)%】로 "
		LOCALS += @"{nPeeMaxTrain}【%TOSTR_CONTINENCE(nPeeMaxTrain)%】"
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @""
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_101
DO
PRINTBUTTON @"최소 소변 참 레벨: {nPeeMinTrain}【%GET_TALENTNAME_TR(1514, nPeeMinTrain)%】", 0
PRINTL
PRINTBUTTON @"최대 소변 참 레벨: {nPeeMaxTrain}【%GET_TALENTNAME_TR(1514, nPeeMaxTrain)%】", 1
PRINTL
PRINTL  [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 999
		BREAK
	CASE 0
		FOR LOCAL,-5,6
		SETCOLOR EnduranceColors(LOCAL)
		PRINTFORML [{LOCAL}] - 【%GET_TALENTNAME_TR(1514, LOCAL)%】 
		NEXT
		RESETCOLOR
		PRINTFORML [999] 정지
		INPUT
		IF RESULT > nPeeMaxTrain && RESULT != 999
			PRINTFORML 최소 소변 보유 능력은 최대치보다 높을 수 없다!
			FORCEWAIT
		ELSEIF INRANGE(RESULT,-5, 5)
			nPeeMinTrain = RESULT
		ELSE
		ENDIF
	CASE 1
		FOR LOCAL,-5,6
		SETCOLOR EnduranceColors(LOCAL)
		PRINTFORML [{LOCAL}] - 【%GET_TALENTNAME_TR(1514, LOCAL)%】 
		NEXT
		RESETCOLOR
		PRINTFORML [999] 정지
		INPUT
		IF RESULT < nPeeMinTrain && RESULT != 999
			PRINTFORML 최대 소변 보유 능력은 최소값보다 낮을 수 없다!
			FORCEWAIT
		ELSEIF INRANGE(RESULT,-5, 5)
			nPeeMaxTrain = RESULT
		ELSE
		ENDIF
ENDSELECT
LOOP 1

@CUSTOM_FETISH_NAME_EXCRETE_102(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"소변 획득 배율"
	CASE "enabled"
		CFM_RETURN '= @"{nBladderFill}의 \% ( {BladderFillAmount(-1,0,60)}ml/hour)"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= @""
ENDSELECT

@CUSTOM_FETISH_RESULT_EXCRETE_102
FOR LOCAL, 1, 301
;only show 10, 30, 50, 70, 80, 100, 130, 150, 170, 200, 300
SELECTCASE LOCAL
	CASE 10, 30, 50, 70, 80, 100, 120, 150, 170, 200 ,300, nBladderFill
	CASEELSE
		RESETCOLOR
		CONTINUE
ENDSELECT
;color
SELECTCASE LOCAL
	CASE IS < 30
		SETCOLOR C_D_RED
	CASE IS < 60
		SETCOLOR C_RED
	CASE IS < 100
		SETCOLOR 0xE9967A
	CASE 100
		RESETCOLOR
	CASE IS < 130
		SETCOLOR C_P_GREEN
	CASE IS < 200
		SETCOLOR C_GREEN
	CASE IS < 300
		SETCOLOR C_AQUA
	CASEELSE
		SETCOLOR C_PINK
ENDSELECT
PRINTBUTTON @"[{LOCAL}] ", LOCAL
SIF nBladderFill == LOCAL
	PRINTFORM (현재)
NEXT
PRINTL
RESETCOLOR
PRINTL  [-1] 뒤로
INPUT
SELECTCASE RESULT
	CASE -1
		RETURN
	CASE IS >= 0
		nBladderFill = RESULT
ENDSELECT

