@CUSTOM_FETISH_NAME_DEBUG_100(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"캐릭터 설정"
	CASE "enabled"
		CFM_RETURN '= @"%nameChecker(DevTestOptions)%"
	CASE "header"
		CFM_RETURN '= @"플레이어 설정"
	CASE "description"
		CFM_RETURN '= "Character set if the dev test random character setting isn't enabled.."
ENDSELECT

@CUSTOM_FETISH_RESULT_DEBUG_100
PRINTFORML 누구?
DRAWLINE
FOR LOCAL,0,CHARANUM-1
PRINTFORMLC [{LOCAL}] %nameChecker(LOCAL)%
NEXT
PRINTFORML 
DRAWLINE
PRINTFORML [999] 정지
INPUT
SELECTCASE RESULT
	CASE 0 TO CHARANUM-2
		DevTestOptions = RESULT
ENDSELECT

