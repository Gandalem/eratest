;TEMPLATE

@CUSTOM_FETISH_NAME_NPC_103(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Enable End of Day NPC Masturbation"
CASE "enabled"
    CFM_RETURN '= @" \@ nNPCMasturb ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Allow Touhous to masturbate at the end of a day"
ENDSELECT

@CUSTOM_FETISH_RESULT_NPC_103
nNPCMasturb = !nNPCMasturb