@CUSTOM_FETISH_NAME_NPC_200(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"관계 부정 허용"
	CASE "enabled"
		CFM_RETURN '= @"\@ nNTR ? 예 # 아니오 \@"
	CASE "header"
		CFM_RETURN '= @"관계 외도"
	CASE "description"
		CFM_RETURN '= "맙소사, 대체 왜. (게임 본편이 아니라 캐릭터 대사에만 관련 내용이 있습니다.)"
ENDSELECT

@CUSTOM_FETISH_RESULT_NPC_200
nNTR = !nNTR
