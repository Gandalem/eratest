;TEMPLATE

@CUSTOM_FETISH_NAME_NPC_200(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Enable relationship cheating"
CASE "enabled"
    CFM_RETURN '= @"\@ nNTR ? Yes # No \@"
CASE "header"
    CFM_RETURN '= @"Relationship Cheating"
CASE "description"
    CFM_RETURN '= "Oh god, WHY. (There's only content in character dialogues, not in the game)"
ENDSELECT

@CUSTOM_FETISH_RESULT_NPC_200
nNTR = !nNTR
