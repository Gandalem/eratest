;TEMPLATE

@CUSTOM_FETISH_NAME_RAPE_100(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Enable Rape"
CASE "enabled"
    LOCALS =
    SIF GETBIT(nRape,3)
    LOCALS += "Conscious、"
    SIF GETBIT(nRape,2)
    LOCALS += "Reverse、"
    SIF GETBIT(nRape,1)
    LOCALS += "Sleep、"
    SIF GETBIT(nRape,0)
    LOCALS += "TSP、"
    IF LOCALS != ""
    LOCALS += LIST_IN_STRING(LOCALS)
    ELSE
    LOCALS += "No"
    ENDIF
    CFM_RETURN '= @"%LOCALS%"
CASE "header"
    CFM_RETURN '= @"Rape"
CASE "description"
    CFM_RETURN '= "Allows for non-consensual sex"
ENDSELECT
@CUSTOM_FETISH_RESULT_RAPE_100
#DIMS OPTION_NAME,4

OPTION_NAME:0 '= "Time Stop Assault"
OPTION_NAME:1 '= "Sleep Rape"
OPTION_NAME:2 '= "Reverse Rape"
OPTION_NAME:3 '= "Conscious Rape"

DO
PRINTFORML Select which modules to enable.
FOR LOCAL, 0, 4
	SIF GETBIT(nRape,LOCAL)
		SETCOLOR C_YELLOW
	PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
	RESETCOLOR
NEXT
PRINTL  [999] Back
INPUT

SELECTCASE RESULT
CASE 999
	BREAK
CASEELSE
INVERTBIT nRape, RESULT 
ENDSELECT
LOOP 1