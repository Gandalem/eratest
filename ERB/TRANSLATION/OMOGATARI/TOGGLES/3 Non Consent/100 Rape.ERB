@CUSTOM_FETISH_NAME_RAPE_100(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"강간 허용"
	CASE "enabled"
		LOCALS =
		SIF GETBIT(nRape,3)
			LOCALS += "의식 있음、"
		SIF GETBIT(nRape,2)
			LOCALS += "역강간、"
		SIF GETBIT(nRape,1)
			LOCALS += "수면、"
		SIF GETBIT(nRape,0)
			LOCALS += "TSP、"
		IF LOCALS != ""
			LOCALS += LIST_IN_STRING(LOCALS)
		ELSE
			LOCALS += "아니오"
		ENDIF
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @"강간"
	CASE "description"
		CFM_RETURN '= "Allows for non-consensual sex"
ENDSELECT

@CUSTOM_FETISH_RESULT_RAPE_100
#DIMS OPTION_NAME,4
OPTION_NAME:0 '= "시간 정지 습격"
OPTION_NAME:1 '= "수면 강간"
OPTION_NAME:2 '= "역강간"
OPTION_NAME:3 '= "의식적인 강간"
DO
PRINTFORML 활성화할 모듈을 선택한다.
FOR LOCAL, 0, 4
SIF GETBIT(nRape,LOCAL)
	SETCOLOR C_YELLOW
PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
