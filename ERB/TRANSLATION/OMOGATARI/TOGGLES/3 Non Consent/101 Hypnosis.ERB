@CUSTOM_FETISH_NAME_RAPE_101(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"최면 활성화"
	CASE "enabled"
		CFM_RETURN '= @"%YesOrNo(nHypno)%"
	CASE "header"
		CFM_RETURN '= @""
