;TEMPLATE

@CUSTOM_FETISH_NAME_RAPE_101(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Enable Hypnosis"
CASE "enabled"
    CFM_RETURN '= @"%YesOrNo(nHypno)%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Enables the hypnosis system"
ENDSELECT

@CUSTOM_FETISH_RESULT_RAPE_101
nHypno = !nHypno