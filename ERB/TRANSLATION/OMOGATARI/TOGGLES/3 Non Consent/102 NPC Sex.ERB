;TEMPLATE

@CUSTOM_FETISH_NAME_NPC_102(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"NPC 간 상호작용을 활성화한다."
	CASE "enabled"
		LOCALS =
		SIF GETBIT(nNPCSex,3)
			LOCALS += "Corpse、"
		SIF GETBIT(nNPCSex,2)
			LOCALS += "Unconscious、"
		SIF GETBIT(nNPCSex,1)
			LOCALS += "Conscious Rape、"
		SIF GETBIT(nNPCSex,0)
			LOCALS += "Consensual、"
		IF LOCALS != ""
			LOCALS '= LIST_IN_STRING(LOCALS)
		ELSE
			LOCALS += "No"
		ENDIF
		CFM_RETURN '= @"%LOCALS%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Allows for sex between non-playable characters"
ENDSELECT

@CUSTOM_FETISH_RESULT_NPC_102
#DIMS CONST OPTION_NAME = "Consensual", "Conscious Rape", "Unconscious Rape", "Corpse Fucking",
DO
PRINTFORML 활성화할 모듈을 선택한다.
FOR LOCAL, 0, VARSIZE("OPTION_NAME")
SIF LOCAL == 3 && nNecro < 2
	CONTINUE
SIF GETBIT(nNPCSex,LOCAL)
	SETCOLOR C_YELLOW
PRINTFORML [{LOCAL}] %OPTION_NAME:LOCAL,14,LEFT%
RESETCOLOR
NEXT
PRINTL  [999] 되돌리기
INPUT
SELECTCASE RESULT
	CASE 999
		BREAK
	CASEELSE
		INVERTBIT nNPCSex, RESULT
ENDSELECT
LOOP 1
