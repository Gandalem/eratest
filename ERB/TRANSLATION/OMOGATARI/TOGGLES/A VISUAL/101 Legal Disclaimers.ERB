@CUSTOM_FETISH_NAME_VISUAL_101(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Show legal disclaimers"
CASE "enabled"
    SELECTCASE DismissDisclaimerSwitch
    CASE 0
    CFM_RETURN '= @"On"
    CASE 1
    CFM_RETURN '= @"Off"
    ENDSELECT
CASE "header"
    CFM_RETURN '= @"Visuals"
CASE "description"
    CFM_RETURN '= "Toggle showing legal disclaimers when starting the game"
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_101
DismissDisclaimerSwitch = !DismissDisclaimerSwitch
