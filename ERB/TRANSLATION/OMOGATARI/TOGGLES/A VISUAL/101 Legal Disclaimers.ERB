; Modular ERB: OMOGATARI/TOGGLES/A VISUAL/101 Legal Disclaimers.ERB

@CUSTOM_FETISH_NAME_VISUAL_101(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"법적 면책 조항을 보여준다."
	CASE "enabled"
		SELECTCASE DismissDisclaimerSwitch
			CASE 0
				CFM_RETURN '= @"On"
			CASE 1
				CFM_RETURN '= @"꺼짐"
		ENDSELECT
	CASE "header"
		CFM_RETURN '= @"시각 효과"
	CASE "description"
		CFM_RETURN '= "Toggle showing legal disclaimers when starting the game"
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_101
DismissDisclaimerSwitch = !DismissDisclaimerSwitch
