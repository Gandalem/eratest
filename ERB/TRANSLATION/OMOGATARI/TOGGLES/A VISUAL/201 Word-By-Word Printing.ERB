@CUSTOM_FETISH_NAME_VISUAL_201(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Word-By-Word Printing"
CASE "enabled"
    CFM_RETURN '= @"%YesOrNo(nVNGlobals:1)%"
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Print the entire sentence or one word at a time."
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_201
nVNGlobals:1 = !nVNGlobals:1