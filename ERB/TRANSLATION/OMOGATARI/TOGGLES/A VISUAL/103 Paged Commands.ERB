; Modular ERB: OMOGATARI/TOGGLES/A VISUAL/103 Paged Commands.ERB

@CUSTOM_FETISH_NAME_VISUAL_103(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"페이지 명령 필터"
	CASE "enabled"
		SELECTCASE nPagedCommandMenu
			CASE 1
				CFM_RETURN '= @"On"
			CASE 0
				CFM_RETURN '= @"꺼짐"
		ENDSELECT
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Commands are filtered via pages instead of being in one whole menu."
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_103
nPagedCommandMenu = !nPagedCommandMenu
