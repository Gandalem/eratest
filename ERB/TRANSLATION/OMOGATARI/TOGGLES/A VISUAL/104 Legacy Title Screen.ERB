; Modular ERB: OMOGATARI/TOGGLES/A VISUAL/104 Legacy Title Screen.ERB

@CUSTOM_FETISH_NAME_VISUAL_104(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"레거시 타이틀 화면"
	CASE "enabled"
		SELECTCASE nLegacyTitleScreen
			CASE 1
				CFM_RETURN '= @"On"
			CASE 0
				CFM_RETURN '= @"꺼짐"
		ENDSELECT
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Use the legacy title screen instead of the GUI one. Best used if the title screen is crashing or its flickering."
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_104
nLegacyTitleScreen = !nLegacyTitleScreen
