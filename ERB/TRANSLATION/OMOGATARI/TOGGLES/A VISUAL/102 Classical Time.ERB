@CUSTOM_FETISH_NAME_VISUAL_102(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Show classical time"
CASE "enabled"
    SELECTCASE IDontGiveAFuckAboutClassicalTime
    CASE 0
    CFM_RETURN '= @"On"
    CASE 1
    CFM_RETURN '= @"Off"
    ENDSELECT
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Toggle showing classical time on the time display"
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_102
IDontGiveAFuckAboutClassicalTime = !IDontGiveAFuckAboutClassicalTime
