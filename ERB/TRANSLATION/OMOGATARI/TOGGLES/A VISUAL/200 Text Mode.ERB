; Modular ERB: OMOGATARI/TOGGLES/A VISUAL/200 Text Mode.ERB

@CUSTOM_FETISH_NAME_VISUAL_200(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"텍스트 모드"
	CASE "enabled"
		SELECTCASE nVNGlobals:0
			CASE 0
				CFM_RETURN '= @"시대"
			CASE 1
				CFM_RETURN '= @"비주얼 노벨 같은"
		ENDSELECT
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "텍스트 출력 방식을 일반적인 era 형식이나 비주얼 노벨 형식으로 설정합니다."
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_200
nVNGlobals++
SIF nVNGlobals > 1
	nVNGlobals = 0
