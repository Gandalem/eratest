@CUSTOM_FETISH_NAME_VISUAL_200(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Text Mode"
CASE "enabled"
    SELECTCASE nVNGlobals:0
    CASE 0
    CFM_RETURN '= @"Era"
    CASE 1
    CFM_RETURN '= @"Visual Novel-Like"
    ENDSELECT
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Configure text printing to be like either regular Era, or render like a VN"
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_200
nVNGlobals++
SIF nVNGlobals > 1
    nVNGlobals = 0

