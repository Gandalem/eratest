@CUSTOM_FETISH_NAME_VISUAL_300(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Accident Noun/Adjective Preference"
CASE "enabled"
    CFM_RETURN '= ""
    FOR LOCAL,0,nExcretaTermSize
        SIF GETBIT(nExcretaTerms,LOCAL)
            CFM_RETURN += AccidentNounList(LOCAL,0)+"、"
    NEXT
    IF !STRLENS(CFM_RETURN)
        CFM_RETURN '= @"None Selected (using fallback)"
    ELSE
        CFM_RETURN '= LIST_IN_STRING(CFM_RETURN)
    ENDIF
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Change excretion related terms used"
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_300
#DIM nvLineCount
    nvLineCount = LINECOUNT
DO
    CLEARLINE LINECOUNT-nvLineCount
    SETCOLOR C_YELLOW
    PRINTFORML %TW_PORT_STR("Accident Noun/Adjective Preference")% Info
    RESETCOLOR
    PRINTFORML The random terms that can be used for excretion-related aspects are separated into {nExcretaTermSize} categories which can be toggled on or off.
    PRINTL
    FOR LOCAL,0,nExcretaTermSize
        SIF GETBIT(nExcretaTerms,LOCAL)
            SETCOLOR C_AQUA
        PRINTFORM [{LOCAL}] %TW_PORT_STR(AccidentNounList(LOCAL,0),1)%
        SIF GETBIT(nExcretaTerms,LOCAL)
            PRINTFORM  (Enabled)
        PRINTL
        RESETCOLOR
        PRINTFORML      - %AccidentNounList(LOCAL,1)%
        LOCALS '= ""
        FOR LOCAL:1,7,1,-1
            SELECTCASE LOCAL:1
            CASE 3,5
                CONTINUE
            ENDSELECT
            REPEAT 2
                SIF STRLENS(SPLIT_SINGLE(AccidentNounList(LOCAL,LOCAL:1),COUNT))
                    LOCALS += SPLIT_SINGLE(AccidentNounList(LOCAL,LOCAL:1),COUNT)+"、"
            REND
        NEXT
        PRINTFORML      - "%LIST_IN_STRING(LOCALS,,",")%"
    NEXT
    PRINTFORML
    PRINTFORML [999] Exit
    INPUT
    SELECTCASE RESULT
    CASE 0 To nExcretaTermSize
        INVERTBIT nExcretaTerms,RESULT
    CASE 999
        RETURN
    ENDSELECT
LOOP 1

