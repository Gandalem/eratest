@CUSTOM_FETISH_NAME_VISUAL_301(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Ammo Name Type"
CASE "enabled"
    SELECTCASE nAmmoNameType
    CASE 0
    CFM_RETURN '= @"Colloquial"
    CASE 1
    CFM_RETURN '= @"Metric"
    ENDSELECT
CASE "header"
    CFM_RETURN '= @""
CASE "description"
    CFM_RETURN '= "Change the name of ammunition to either be colloquial or metric."
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_301
nAmmoNameType = !nAmmoNameType