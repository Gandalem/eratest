			CASE 1
				RETURNF "말 그대로 지나치게 딱딱하고 학술적인 표현들입니다."
			CASE 2
				;pee noun
				RETURNF "소변"
			CASE 3
				;peeing
				RETURNF "배뇨하다:비우다"
			CASE 4
				;poop noun
				RETURNF @"배설물:변:장 운동:분변 %SPLIT_G("물질:재료")%:배출물:거름:똥:오물"
			CASE 5
				;pooping
				RETURNF "장운동을 하다:배변하다:비우다:배출하다:배설하다"
			CASE 6
				;pull-up diapers
				RETURNF @"%SPLIT_G("보호용 :흡수식 :풀업형 ")%속옷"
			CASE 7
				;diapers
				RETURNF @"%SPLIT_G("탭형 :테이프형 :테이프 스타일 :탭 스타일 :기저귀형 ")%팬티:요실금 속옷"
		ENDSELECT
	CASE 5
		SELECTCASE ARG:1
			CASE 0
				RETURNF "영국식"
			CASE 1
				RETURNF "영국에서 흔히 쓰는 표준 표현으로, 위 분류들을 보완합니다."
			CASE 2
				;pee noun
				RETURNF ""
			CASE 3
				;peeing
				RETURNF ""
			CASE 4
				;poop noun
				RETURNF "대변:똥"
			CASE 5
				;pooping
				RETURNF ""
			CASE 6
				;pull-up diapers
				RETURNF @"기저귀 바지"
			CASE 7
				;diapers
				RETURNF @"기저귀"
			CASE 8
				;go to the toilet
				RETURNF @"화장실로 가기:화장실 사용하기:변소 사용하기"
		ENDSELECT
	CASE 6
		SELECTCASE ARG:1
			CASE 0
				RETURNF "오하이오 리즈"
			CASE 1
				RETURNF "인터넷 밈을 모은 표현들입니다."
			CASE 2
				;pee noun
				RETURNF "게이머 주스"
			CASE 3
				;peeing
				RETURNF ""
			CASE 4
				;poop noun
				RETURNF ""
			CASE 5
				;pooping
				RETURNF ""
			CASE 6
				;pull-up diapers
				RETURNF @""
			CASE 7
				;diapers
				RETURNF @"게이머 바지"
		ENDSELECT
ENDSELECT
RETURNF

@CUSTOM_FETISH_NAME_VISUAL_301(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"탄약 이름 유형"
	CASE "enabled"
		SELECTCASE nAmmoNameType
			CASE 0
				CFM_RETURN '= @"구어체"
			CASE 1
				CFM_RETURN '= @"지표"
		ENDSELECT
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "탄약 이름을 구어식 또는 미터법 표기로 바꿉니다."
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_301
nAmmoNameType = !nAmmoNameType
