; Modular ERB: OMOGATARI/TOGGLES/A VISUAL/300 Accident Nouns.ERB

@CUSTOM_FETISH_NAME_VISUAL_300(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"사고 명사/형용사 선호도"
	CASE "enabled"
		CFM_RETURN '= ""
		FOR LOCAL,0,nExcretaTermSize
		SIF GETBIT(nExcretaTerms,LOCAL)
			CFM_RETURN += AccidentNounList(LOCAL,0)+"、"
		NEXT
		IF !STRLENS(CFM_RETURN)
			CFM_RETURN '= @"선택된 항목 없음 (대체값을 사용함)"
		ELSE
			CFM_RETURN '= LIST_IN_STRING(CFM_RETURN)
		ENDIF
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "사용할 배설 관련 용어를 바꿉니다"
ENDSELECT

@CUSTOM_FETISH_RESULT_VISUAL_300
#DIM nvLineCount
nvLineCount = LINECOUNT
DO
CLEARLINE LINECOUNT-nvLineCount
SETCOLOR C_YELLOW
PRINTFORML %TW_PORT_STR("배설 명사·형용사 선호도")%정보
RESETCOLOR
PRINTFORML 배설 관련 측면에 사용될 수 있는 무작위 용어들은 켜거나 끌 수 있는 {nExcretaTermSize} 카테고리로 분리된다.
PRINTL
FOR LOCAL,0,nExcretaTermSize
SIF GETBIT(nExcretaTerms,LOCAL)
	SETCOLOR C_AQUA
PRINTFORM [{LOCAL}] %TW_PORT_STR(AccidentNounList(LOCAL,0),1)%
SIF GETBIT(nExcretaTerms,LOCAL)
	PRINTFORM  (활성화됨)
PRINTL
RESETCOLOR
PRINTFORML      - %AccidentNounList(LOCAL,1)%
LOCALS '= ""
FOR LOCAL:1,7,1,-1
SELECTCASE LOCAL:1
	CASE 3,5
		CONTINUE
ENDSELECT
REPEAT 2
SIF STRLENS(SPLIT_SINGLE(AccidentNounList(LOCAL,LOCAL:1),COUNT))
	LOCALS += SPLIT_SINGLE(AccidentNounList(LOCAL,LOCAL:1),COUNT)+"、"
REND
NEXT
PRINTFORML      - "%LIST_IN_STRING(LOCALS,,",")%"
NEXT
PRINTFORML
PRINTFORML [999] 종료
INPUT
SELECTCASE RESULT
	CASE 0 To nExcretaTermSize
		INVERTBIT nExcretaTerms,RESULT
	CASE 999
		RETURN
ENDSELECT
LOOP 1

@AccidentNounList(ARG,ARG:1)
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		SELECTCASE ARG:1
			CASE 0
				;name
				RETURNF "아기 말투"
			CASE 1
				;description
				RETURNF "아이들이 쓸 법한 유아적인 표현들입니다."
			CASE 2
				;pee noun
				RETURNF "쉬야:축축이"
			CASE 3
				;peeing
				RETURNF "쉬야하다:축축하게 만들다:쉬하다:졸졸 싸다:찔끔 싸다:쉬하러 가다"
			CASE 4
				;poop noun
				RETURNF "응가:꼬리꼬리:지저분이:힘주기:뿌직뿌직:응가응가"
			CASE 5
				;pooping
				RETURNF "응가하다:꼬리꼬리하게 만들다:지저분하게 만들다:힘줘서 싸다:응가하러 가다"
			CASE 6
				;pull-up diapers
				RETURNF @"%SPLIT_G("풀업형:팬티형:팬티 스타일:큰아이용")% %AccidentNounList(ARG,-1)%"
			CASE 7
				;diapers
				RETURNF @"%AccidentNounList(ARG,-1)%:%SPLIT_G("탭형:테이프형:테이프 스타일")% %AccidentNounList(ARG,-1)%"
			CASE 8
				;go to the toilet
				RETURNF @"화장실 가자"
			CASE -1
				;diapers pt 2
				RETURNF @"기저귀"
		ENDSELECT
	CASE 1
		SELECTCASE ARG:1
			CASE 0
				RETURNF "츤츤"
			CASE 1
				RETURNF "츤츤이라는 이름처럼 직접 말하지 않고 새침하게 돌려 말하는 표현들입니다."
			CASE 2
				;pee noun
				RETURNF "금단의 감로:특별한 사과주스:레모네이드"
			CASE 3
				;peeing
				RETURNF "수문을 열다:1번 보러 가다:물을 빼다:갈기다"
			CASE 4
				;poop noun
				RETURNF "진흙:폐기용 반죽:갈색 빵:달콤한 빵:진흙 폭탄:흙:먼지:오물:배설물:찌꺼기:알갱이"
			CASE 5
				;pooping
				RETURNF "2번 보러 가다:배설물을 만들다:흙을 밀어내다:흙덩이를 밀어내다"
			CASE 6
				;pull-up diapers
				RETURNF @"만약을 위한 바: 패딩 속옷"
			CASE 7
				;diapers
				RETURNF @"개인용 변기: %SPLIT_G("명상용:야간용")% 바지:패드 팬티"
			CASE 8
				;go to the toilet
				RETURNF @"개와 관련해서 남자를 보라:자연의 부름에 응답하다:동전을 쓰다"
		ENDSELECT
	CASE 2
		SELECTCASE ARG:1
			CASE 0
				RETURNF "표준"
			CASE 1
				RETURNF "배설물을 다루는 매체에서 흔히 쓰는 표준적인 표현들입니다."
			CASE 2
				;pee noun
				RETURNF @"소변: %SPLIT_G("폐기용:노폐물:녹아내린:성스러운")%%SPLIT_G(" 주스: 감로: 꿀: 액체: 물")%"
			CASE 3
				;peeing
				RETURNF "소변:지리다"
			CASE 4
				;poop noun
				RETURNF "똥:응가:오물"
			CASE 5
				;pooping
				RETURNF "똥을 싸다:응가하다:더럽히다:가득 채우다"
			CASE 6
				;pull-up diapers
				RETURNF @"기저귀:기저귀형 팬티:패드:%SPLIT_G("풀업형:팬티형:팬티 스타일:팬티 타입")% 기저귀"
			CASE 7
				;diapers
				RETURNF @"%AccidentNounList(ARG,-1)%%SPLIT_G("탭형:테이프형:테이프 스타일:테이프 부착형")% 기저귀"
			CASE 8
				;go to the toilet
				RETURNF @"화장실에 간다: 변기를 사용한다."
			CASE -1
				;diapers
				RETURNF @"기저귀:패딩"
		ENDSELECT
	CASE 3
		SELECTCASE ARG:1
			CASE 0
				RETURNF "비속어"
			CASE 1
				RETURNF "배설물을 거칠고 천박하게 부르는 표현들입니다."
			CASE 2
				;pee noun
				RETURNF "오줌"
			CASE 3
				;peeing
				RETURNF "오줌을 갈기다:한바탕 싸다"
			CASE 4
				;poop noun
				RETURNF @"변변치 않은 것"
			CASE 5
				;pooping
				RETURNF "똥을 갈기다:똥 싸다:한 무더기 싸다"
			CASE 6
				;pull-up diapers
				RETURNF @""
			CASE 7
				;diapers
				RETURNF @"아기가 울었다"
		ENDSELECT
	CASE 4
		SELECTCASE ARG:1
			CASE 0
