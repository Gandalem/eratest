; Modular ERB: OMOGATARI/TOGGLES/3 NPC/304 Paranoia.ERB

@CUSTOM_FETISH_NAME_NPC_304(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"편집증 시스템"
	CASE "enabled"
		CFM_RETURN '= @" %YesOrNo(GETBIT(NASFeature,9))%"
	CASE "header"
		CFM_RETURN '= @""
	CASE "description"
		CFM_RETURN '= "Being careless and doing crimes will increase paranoia, which makes characters more likely to fight back."
ENDSELECT

@CUSTOM_FETISH_RESULT_NPC_304
INVERTBIT NASFeature, 9
