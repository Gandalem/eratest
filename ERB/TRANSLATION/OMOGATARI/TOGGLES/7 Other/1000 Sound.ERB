
@CUSTOM_FETISH_7_1000
PRINTFORM  %@"SE : {SOUNDVOLUME}\%",10, LEFT% 
PRINTBUTTON "-", 1000
PRINTBUTTON "+ ", 1001
CALL COLOR_BAR(SOUNDVOLUME,100,20,109,225,255,-160,10,18,6,2,UNICODE(0x25AE),UNICODE(0x25AE))
PRINTL

PRINTFORM  %@"BGM: {BGMVOLUME}\% ", 10,LEFT% 
PRINTBUTTON "-", 1010
PRINTBUTTON "+ ", 1011
CALL COLOR_BAR(BGMVOLUME,100,20,109,225,255,-160,10,18,6,2,UNICODE(0x25AE),UNICODE(0x25AE))
PRINTL

@CUSTOM_FETISH_RESULT_OTHER_1000
	SOUNDVOLUME = LIMIT(SOUNDVOLUME-10,0,100)
@CUSTOM_FETISH_RESULT_OTHER_1001
	SOUNDVOLUME = LIMIT(SOUNDVOLUME+10,0,100)
@CUSTOM_FETISH_RESULT_OTHER_1010
	BGMVOLUME = LIMIT(BGMVOLUME-10,0,100)
@CUSTOM_FETISH_RESULT_OTHER_1011
	BGMVOLUME = LIMIT(BGMVOLUME+10,0,100)