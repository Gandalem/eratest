; Modular ERB: OMOGATARI/TOGGLES/7 Other/100 Smells.ERB

@CUSTOM_FETISH_NAME_OTHER_100(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
	CASE "name"
		CFM_RETURN '= @"활성화된 향기"
	CASE "enabled"
		CFM_RETURN '= @" %YesOrNo(nSmellFetish)%"
	CASE "header"
		CFM_RETURN '= @"냄새가 난다"
	CASE "description"
		CFM_RETURN '= "어떤 냄새를 묘사할지 설정합니다."
ENDSELECT

@CUSTOM_FETISH_RESULT_OTHER_100
#DIM smell
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
DO
CLEARLINE LINECOUNT-FIRST_LINE
PRINTFORML 어떤 향을 활성화하고 싶습니까?
FOR smell, 0, 1
SIF GETBIT(nSmellFetish,LOCAL)
	SETCOLOR C_AQUA
PRINTFORML [0] - 모두
RESETCOLOR
NEXT
PRINTL
PRINTFORML [999] 나 여기서 나가게 해줘!
INPUT
SELECTCASE RESULT
	CASE IS >= 64
		RETURN
	CASEELSE
		INVERTBIT nSmellFetish, RESULT
ENDSELECT
LOOP 1
