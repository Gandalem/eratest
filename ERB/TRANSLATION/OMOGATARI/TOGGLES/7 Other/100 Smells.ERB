@CUSTOM_FETISH_NAME_OTHER_100(CF_STRING="name")
#FUNCTIONS
#DIMS CF_STRING
SELECTCASE CF_STRING
CASE "name"
    CFM_RETURN '= @"Enabled Smells"
CASE "enabled"
    CFM_RETURN '= @" %YesOrNo(nSmellFetish)%"
CASE "header"
    CFM_RETURN '= @"Smells"
CASE "description"
    CFM_RETURN '= "Toggle what smells you want to have descriptions to."
ENDSELECT
@CUSTOM_FETISH_RESULT_OTHER_100
#DIM smell
#DIM FIRST_LINE

FIRST_LINE = LINECOUNT
DO
CLEARLINE LINECOUNT-FIRST_LINE
PRINTFORML What smells do you want to enable?
FOR smell, 0, 1
	SIF GETBIT(nSmellFetish,LOCAL)
		SETCOLOR C_AQUA
	PRINTFORML [0] - All
	RESETCOLOR
NEXT
PRINTL
PRINTFORML [999] - Get me out of here!
INPUT
SELECTCASE RESULT
CASE IS >= 64
RETURN
CASEELSE
	INVERTBIT nSmellFetish, RESULT
ENDSELECT
LOOP 1