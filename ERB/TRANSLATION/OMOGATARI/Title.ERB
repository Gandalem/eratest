;revからパクリ

@TITLE_NAS
#DIMS CLASS_NAME, CLASS_NUM + 1
#DIM DYNAMIC titleNASTextID
#DIM DYNAMIC titleNASTextSize
#DIMS DYNAMIC titleNASText
#DIMS DYNAMIC titleNASTextFormatted
;#DIMS DYNAMIC titleNASTextMainOption = "Continue", "The World", "Legend of Gensokyo", "Lunatic Survival", "Free H", "Custom Characters", "Save Data Transfer", "Settings", "DEBUG"
#DIMS DYNAMIC titleNASTextMainOption = "continue", "tw", "ezb", "ls", "freeH", "charaCreator", "saveTransfer", "settings", "debug"
#DIMS DYNAMIC titleNASTextModeOption = "newGame", "loadSave", "devTest"
#DIMS DYNAMIC titleNASTextDebugOption = "lucidDream", "mapPath", "reloadGame"
#DIM DYNAMIC page
#DIM posX
#DIM posY
#DIM mousePosX
#DIM mousePosY
#DIM titleSize,2
#DIM index
#DIM indexSkipped
#DIM indexMax
#DIM mouseOverID
;CLEARLINE LINECOUNT
titleNASTextID = 1
WHILE 1
IF !ISACTIVE() || !CLIENTWIDTH() || !CLIENTHEIGHT()
	;should keep the game from crashing from minimizing
	AWAIT
	CONTINUE
ENDIF
CBGCLEAR
CLEARLINE LINECOUNT
; CLEARLINE 1
mouseOverID = -1
GDISPOSE titleNASTextID
;GCREATE titleNASTextID, VNConfig:GIWidth + VNConfig:GILeft, VNConfig:GIBottle + VNConfig:GIHeight
GCREATE titleNASTextID, CLIENTWIDTH(), CLIENTHEIGHT()
GCREATEFROMFILE RM_TITLE, @"OMOGATARI/Titles/Title %NASTitleFetish()%.webp"
SPRITECREATE @"TW_title", RM_TITLE
;get width, then we scale it off that
titleSize:0 = (SPRITEWIDTH("TW_title")*(((clientwidth()/2)*100/SPRITEWIDTH("TW_title"))))/100
titleSize:1 = (SPRITEHEIGHT("TW_title")*(((clientwidth()/2)*100/SPRITEWIDTH("TW_title"))))/100
GDRAWSPRITE titleNASTextID, "TW_title", (clientwidth()/2)-((clientwidth()/4)), -(titleSize:1*2/10), titleSize, titleSize:1
;edition
titleNASTextSize = 24
; titleNASText '= @"%CENTER("Gensokyo Xtreme Fighter Edition (Stage 2)",105)%"
titleNASText '= @"%CENTER("Gensokyo Xtreme Fighter Edition (Stage 1 Part 2 Hotfix 2)",105)%"
GSETFONT titleNASTextID, GETFONT(), titleNASTextSize, 0
GSETPEN titleNASTextID, GETDEFCOLOR(), 5
GDRAWTEXT titleNASTextID, titleNASText, (clientwidth()/2) - (STRLENS(titleNASText)*titleNASTextSize/4), (titleSize:1*9/16)+titleNASTextSize
;dates
titleNASTextSize = 24
titleNASText '= @"%CENTER(@"%GAMEBASE_YEAR%",105)%"
GSETFONT titleNASTextID, GETFONT(), titleNASTextSize, 0
GSETPEN titleNASTextID, GETDEFCOLOR(), 5
GDRAWTEXT titleNASTextID, titleNASText, (clientwidth()/2) - (STRLENS(titleNASText)*titleNASTextSize/4), (titleSize:1*9/16)+(titleNASTextSize*2)
;version
titleNASTextSize = 20
titleNASText '= NASVersionName(0)
GSETFONT titleNASTextID, GETFONT(), titleNASTextSize, 0
GSETPEN titleNASTextID, GETDEFCOLOR(), 0
GDRAWTEXT titleNASTextID, titleNASText, (clientwidth())-(STRLENS(titleNASText)*titleNASTextSize/2), 0
;reload game button
; titleNASTextSize = 20
; titleNASText '= "Reload Game"
; GSETFONT titleNASTextID, GETFONT(), titleNASTextSize, 0
; GSETPEN titleNASTextID, C_ORANGE, 5
; GDRAWTEXT titleNASTextID, titleNASText, 0, 0
; {
; SIF (mousePosX >= 0 && mousePosX <= (STRLENS(titleNASText)*titleNASTextSize/2)) &&
; 	(mousePosY >= 0) && mousePosY <= (titleNASTextSize)
; }
; 	mouseOverID = -564
;options
titleNASTextSize = 32
mousePosX = MOUSEX()
mousePosY = CLIENTHEIGHT() + MOUSEY()
;debug mouse thingy
; titleNASTextSize = 24
; titleNASText '= @"Current mouse position is {mousePosX}, {mousePosY}"
; GSETFONT titleNASTextID, GETFONT(), titleNASTextSize, 0
; GSETPEN titleNASTextID, 0xFFFFA00, 5
; GDRAWTEXT titleNASTextID, titleNASText, 0, CLIENTHEIGHT()-titleNASTextSize
;options
titleNASTextSize = 32
indexSkipped = 0
SELECTCASE page
	CASE 0
		indexMax = VARSIZE("titleNASTextMainOption")
	CASE 1,2,3
		indexMax = VARSIZE("titleNASTextModeOption")+1
	CASE 8
		indexMax = VARSIZE("titleNASTextDebugOption")+1
ENDSELECT
FOR index,0,indexMax
;text
SELECTCASE page
	CASE 0
		SELECTCASE index
			CASE 0
				IF CHKDATA(GLOBAL:998) != 0
					indexSkipped++
					CONTINUE
				ENDIF
			CASE 4
				indexSkipped++
				CONTINUE
			CASE 2,8
		ENDSELECT
		titleNASText '= titleNASTextMainOption:index
	CASE 1, 2, 3
		SELECTCASE index
			CASE 0
				titleNASText '= titleNASTextMainOption:page
			CASEELSE
				titleNASText '= titleNASTextModeOption:(index-1)
		ENDSELECT
	CASE 8
		SELECTCASE index
			CASE 0
				titleNASText '= titleNASTextMainOption:page
			CASEELSE
				titleNASText '= titleNASTextDebugOption:(index-1)
		ENDSELECT
ENDSELECT
;positioning
titleNASTextFormatted '= @"%CENTER(@"[%TITLE_NAS_STR(titleNASText)%]",30)%"
posX = (clientwidth()/2) - (STRLENS(titleNASTextFormatted)*titleNASTextSize/4)
posY = (titleSize:1*11/16)+((titleNASTextSize+10)*(index+1-indexSkipped))
SIF (mousePosX >= posX && mousePosX <= (posX) + (STRLENS(titleNASTextFormatted)*titleNASTextSize/2)) && (mousePosY >= (posY)) && mousePosY <= (titleNASTextSize + posY)
	mouseOverID = index
SIF mouseOverID == index
	titleNASTextFormatted '= @"%CENTER(@"> [%TITLE_NAS_STR(titleNASText)%] <",30)%"
GSETFONT titleNASTextID, GETFONT(), 32, 0
;colors
SELECTCASE page
	CASE 0
		SELECTCASE index
			CASE 0
				GSETPEN titleNASTextID, 0xaa000000 + C_ORANGE, 5
			CASEELSE
				GSETPEN titleNASTextID, GETDEFCOLOR(), 5
		ENDSELECT
	CASE 1, 2, 3, 8
		SELECTCASE index
			CASE 0
				GSETPEN titleNASTextID, 0xaa000000 + C_YELLOW, 5
			CASEELSE
				GSETPEN titleNASTextID, GETDEFCOLOR(), 5
		ENDSELECT
ENDSELECT
GDRAWTEXT titleNASTextID, titleNASTextFormatted, posX, posY
NEXT
;descriptions
IF mouseOverID > -1
	titleNASTextSize = 24
	SELECTCASE page
		CASE 0
			titleNASText '= @"%CENTER(@"%TITLE_NAS_STR(titleNASTextMainOption:mouseOverID+"Desc")%",105)%"
		CASE 1, 2, 3
			IF mouseOverID == 0
				titleNASText '= @"%CENTER(@"%TITLE_NAS_STR("returnDesc")%",105)%"
			ELSE
				titleNASText '= @"%CENTER(@"%TITLE_NAS_STR(titleNASTextModeOption:(mouseOverID-1)+"Desc")%",105)%"
			ENDIF
		CASE 8
			IF mouseOverID == 0
				titleNASText '= @"%CENTER(@"%TITLE_NAS_STR("returnDesc")%",105)%"
			ELSE
				titleNASText '= @"%CENTER(@"%TITLE_NAS_STR(titleNASTextDebugOption:(mouseOverID-1)+"Desc")%",105)%"
			ENDIF
	ENDSELECT
	GSETFONT titleNASTextID, GETFONT(), titleNASTextSize, 0
	GSETPEN titleNASTextID, GETDEFCOLOR(), 5
	GDRAWTEXT titleNASTextID, titleNASText, (clientwidth()/2) - (STRLENS(titleNASText)*titleNASTextSize/4), CLIENTHEIGHT()-titleNASTextSize
ENDIF
;last save
IF CHKDATA(GLOBAL:998) == 0 && page == 0
	LOADTEXT GLOBAL:998
	LOCALS '= RESULTS:0
	IF STRFIND(RESULTS:0,"[ENDSTATS]") > -1
		LOCALS '= SUBSTRING(LOCALS,0,STRFIND(LOCALS,"[ENDSTATS]")+11)
		SPLIT LOCALS, "\n", LOCALS
		titleNASTextSize = 24
		FOR index,0,2
		titleNASText '= @"%CENTER(LOCALS:index,105)%"
		GSETFONT titleNASTextID, GETFONT(), titleNASTextSize, 0
		GSETPEN titleNASTextID, 0xaa000000 + C_ORANGE, 5
		GDRAWTEXT titleNASTextID, titleNASText, (clientwidth()/2) - (STRLENS(titleNASText)*titleNASTextSize/4), CLIENTHEIGHT()-(titleNASTextSize*(4-index))
		NEXT
	ENDIF
ENDIF
CBGSETG titleNASTextID, 0, 0, -10
INPUTMOUSEKEY 15
IF RESULT == 1 && RESULT:1 == 0x100000
	; IF mouseOverID == -564
	; 	CBGCLEAR
	; 	PRINTFORML eraNAS is restarting, please wait
	; 	SKIPDISP 1
	; 	FORCE_QUIT_AND_RESTART
	; 	SKIPDISP 0
	; ENDIF
	SELECTCASE page
		CASE 0
			SELECTCASE mouseOverID
				CASE 0
					SAVEGLOBAL
					CBGCLEAR
					LOADDATA GLOBAL:998
				CASE 1
					page = 1
					ViewingTitlePage = 0
					SAVEGLOBAL
					LOADGLOBAL
					CALL SetWindowTitle
				CASE 2
					page = 2
					ViewingTitlePage = 1
					SAVEGLOBAL
					LOADGLOBAL
					CALL SetWindowTitle
				CASE 3
					page = 3
					ViewingTitlePage = 2
					SAVEGLOBAL
					LOADGLOBAL
					CALL SetWindowTitle
				CASE 5
					CBGCLEAR
					CALL MAKE_ALL_CLASS_LIST
					CALL Name_Array_Set ;additional call because we need it for master's name
					CALL INIT_FACTIONS
					CALL CUSTOM_CHARA_MENU
				CASE 6
					;Custom code for save transfer
					CBGCLEAR
					LOADGLOBAL
					inSaveTransfer = 1
					SAVEGLOBAL
					CALL LOAD_SAVE(0,1)
					LOADGLOBAL
					inSaveTransfer = 0
					SAVEGLOBAL
				CASE 7
					CBGCLEAR
					inCharaCreator = 1
					;SIF !FIRST_NAME_KM_ADDRESS
					;CALL CREATE_NAME_LIST
					;CALL MAKE_ALL_CLASS_LIST
					CLEARLINE LINECOUNT
					CALL NAS_SETTINGS
				CASE 8
					[IF_DEBUG]
					page = 8
					[ENDIF]
			ENDSELECT
		CASE 1, 2, 3
			SELECTCASE mouseOverID
				CASE 0
					page = 0
				CASE 1
					SAVEGLOBAL
					RESETDATA
					$NEWGAME
					CBGCLEAR
					LOADGLOBAL
					;CALL CREATE_NAME_LIST
					CALL Name_Array_Set ;additional call because we need it for master's name
					CALL ADDCHARA_INIT(0) ;custom code, init PC
					;CLEARBGIMAGE
					BEGIN FIRST
				CASE 2
					;Custom code for load-save menu
					CBGCLEAR
					CALL LOAD_SAVE(0,1)
					page = 0
				CASE 3
					RESETDATA
					DevTest = 1
					GOTO NEWGAME
			ENDSELECT
		CASE 8
			SELECTCASE mouseOverID
				CASE 0
					page = 0
				CASE 1
					DevTest = 3
					GOTO NEWGAME
				CASE 2
					CALL MAP_PATH_TEST
				CASE 3
					CBGCLEAR
					PRINTFORML eraNAS가 재시작 중이니 잠시 기다려 주세요.
					SKIPDISP 1
					FORCE_QUIT_AND_RESTART
					SKIPDISP 0
			ENDSELECT
	ENDSELECT
ENDIF
WEND

