@TITLE_NAS_STR(ARGS)
#FUNCTIONS
SELECTCASE ARGS
CASE "continue"
RETURNF "Continue"
CASE "tw"
RETURNF "The World"
CASE "ezb"
RETURNF "Legend of Gensokyo"
CASE "ls"
RETURNF "Lunatic Survival"
CASE "freeH"
RETURNF "Free H"
CASE "charaCreator"
RETURNF "Custom Characters"
CASE "saveTransfer"
RETURNF "Save Data Transfer"
CASE "settings"
RETURNF "Settings"
CASE "debug"
RETURNF "DEBUG"
CASE "newGame"
	RETURNF "Start Game"
CASE "loadSave"
	RETURNF "Load Save"
CASE "devTest"
	RETURNF "DEV QUICKTEST"
CASE "lucidDream"
	RETURNF "Lucid Dream Test"
CASE "mapPath"
	RETURNF "Map Path Test"
CASE "reloadGame"
	RETURNF "Reload Game"
CASE "legacyTWTitle"
	RETURNF "Use Legacy Title Screen"
CASE "continueDesc"
RETURNF "Load your most recent save."
CASE "twDesc"
RETURNF "Live your life in the World of Fantasy. This is the main mode of eraNAS."
CASE "ezbDesc"
RETURNF "Start as a nobody and work your way to to godhood by beating rivals throughout the World of Fantasy."
CASE "freeHDesc"
RETURNF "Have sex with any character of your choosing in eraNAS. You will be thrusted directly into an H scene"
CASE "lsDesc"
RETURNF "Work as a servant for the Scarlet Devil Mansion and avoid getting assaulted by the mansion's inhabitants."
CASE "charaCreatorDesc"
RETURNF "Create a custom character that you can play as or add to a The World or Legend of Gensokyo playthrough"
CASE "saveTransferDesc"
RETURNF "Transfer your save data from and to other forks of eraTW such as AnonTW, eraTW Neodev, and more."
CASE "settingsDesc"
RETURNF "Configure game settings to your liking. This is where fetishes are enabled and disabled"
CASE "debugDesc"
RETURNF "Special developer features"
CASE "reloadGameDesc"
RETURNF "Click this button to reload the game since Ctrl+R doesn't work"
CASE "legacyTWTitleDesc"
RETURNF "Return to the legacy title screen"
CASE "returnDesc"
RETURNF "Return to the title screen"
CASE "newGameDesc"
RETURNF "Start a new playthrough"
CASE "loadSaveDesc"
RETURNF "Load a saved playthrough"
CASE "devTestDesc"
RETURNF "Start a new playthrough using the dev quicktest settings"
ENDSELECT

@TITLE_NAS_LEGACY
#DIM DYNAMIC page
LOCAL:2 = LINECOUNT
DO
	REDRAW 0
	CLEARLINE LINECOUNT - LOCAL:2
	; FOR LOCAL:0, 0, 35
	; 	HTML_PRINT "<p align='center'><img src='TW_title" + TOSTR(LOCAL:0, "000") + "'></p>"
	; NEXT
	$START ;custm coode - keep the loop to avoid crashes
	ALIGNMENT CENTER
	CUSTOMDRAWLINE ━
	PRINTFORML %WINDOW_TITLE%
	PRINTFORML %NASVersionName()%
	PRINTFORML %GAMEBASE_YEAR%
