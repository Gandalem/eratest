@TITLE_NAS_STR(ARGS)
#FUNCTIONS
SELECTCASE ARGS
	CASE "continue"
		RETURNF "계속하기"
	CASE "tw"
		RETURNF "더 월드"
	CASE "ezb"
		RETURNF "환상향의 전설"
	CASE "ls"
		RETURNF "루나틱 서바이벌"
	CASE "freeH"
		RETURNF "프리 H"
	CASE "charaCreator"
		RETURNF "커스텀 캐릭터"
	CASE "saveTransfer"
		RETURNF "세이브 데이터 전송"
	CASE "settings"
		RETURNF "설정"
	CASE "debug"
		RETURNF "디버그"
	CASE "newGame"
		RETURNF "게임 시작"
	CASE "loadSave"
		RETURNF "세이브 불러오기"
	CASE "devTest"
		RETURNF "개발자 빠른 테스트"
	CASE "lucidDream"
		RETURNF "자각몽 테스트"
	CASE "mapPath"
		RETURNF "맵 경로 테스트"
	CASE "reloadGame"
		RETURNF "게임 다시 시작"
	CASE "legacyTWTitle"
