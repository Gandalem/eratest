; Modular ERB: OMOGATARI/REVERSE CHARAMAKE/Onboarding.ERB
;---------------------------------------------------------------------
;Onboarding
;30% Complete
;---------------------------------------------------------------------
;1[Sexual Content] (80% Complete)
;2[Excretion Content] (100% Complete)
;3[Physical Harm] (0% Complete)
;4[Differences from TW] (0% Complete)

@NAS_NewGame_Onboarding
#DIM OB_LINECOUNT
#DIM OB_INPUT
#DIM OB_IsCOMPLETED
LOADGLOBAL
CUSTOMDRAWLINE ━
PRINTFORML 온보딩
OB_LINECOUNT = LINECOUNT
DO
OB_IsCOMPLETED = 0
CLEARLINE LINECOUNT-OB_LINECOUNT
CUSTOMDRAWLINE ━
FOR LOCAL,1,6
CALL NAS_NewGame_Onboarding_Option(LOCAL,OB_IsCOMPLETED)
NEXT
PRINTL
PRINTFORML [999] 온보딩 건너뛰기
IF OB_IsCOMPLETED >= 5 && nOnboardingProgress:0 == 0
	CUSTOMDRAWLINE ━
	SETCOLOR C_RED
	PRINTFORML 온보딩이 완료되었습니다.
	RESETCOLOR
	PRINTFORML 이 설정들은 메인 메뉴의 옵션 화면이나 하루가 시작되기 전에 변경할 수 있다.
	PRINTL
	FONTITALIC
	PRINTFORMW 온보딩은 옵션 화면으로 가서 【온보딩 재설정】을 클릭함으로써 다시 시작할 수도 있다.
	FONTREGULAR
	nOnboardingProgress:0 = 1
	SAVEGLOBAL
	LOADGLOBAL
	RETURN 1
ENDIF
INPUT
OB_INPUT = RESULT
SELECTCASE OB_INPUT
	CASE 1 TO 5
		LOADGLOBAL
		SIF nOnboardingProgress:OB_INPUT == -1
			nOnboardingProgress:OB_INPUT = 0
		SAVEGLOBAL
		LOADGLOBAL
		TRYCALLFORM NAS_NewGame_Onboarding_{OB_INPUT}
		SAVEGLOBAL
		LOADGLOBAL
	CASE 999
		SETCOLOR C_RED
		PRINTFORML 온보딩 절차를 종료하고 싶은 것이 맞습니까?
		RESETCOLOR
		PRINTFORML 이 설정들은 메인 메뉴의 옵션 화면에서 또는 하루가 시작되기 전에 변경할 수 있다.
		PRINTL
		FONTITALIC
		PRINTFORML 온보딩은 옵션 화면으로 가서 【Onboarding 초기화】를 클릭하여 다시 시작할 수도 있다.
		FONTREGULAR
		CALL ASK_YN()
		SELECTCASE RESULT
			CASE 0
				nOnboardingProgress:0 = -1
				SAVEGLOBAL
				LOADGLOBAL
				RETURN
		ENDSELECT
ENDSELECT
LOOP 1

@NAS_NewGame_Onboarding_Option(ARG,OB_IsCOMPLETED)
#DIMS OB_OPTIONS = "", "Sexual Content", "Excretion Content", "Physical Harm", "Combat", "Additional Features"
#DIM  OB_MAX = 0, 3, 6, 4, 6, 5
#DIM DYNAMIC OB_COMPLETED
#DIM REF OB_IsCOMPLETED
FOR LOCAL,0,OB_MAX:(ARG)
SIF GETBIT(nOnboardingProgress:ARG,LOCAL)
	OB_COMPLETED++
NEXT
RESETCOLOR
IF nOnboardingProgress:ARG == -1 || OB_COMPLETED >= OB_MAX:ARG
	SETCOLOR C_GRAY
	OB_IsCOMPLETED++
ENDIF
LOCALS:0 = 
IF nOnboardingProgress:ARG == -1
	LOCALS:0 = (건너뜀)
ELSEIF OB_COMPLETED >= OB_MAX:ARG
	LOCALS:0 = (완료)
ELSE
	LOCALS:0 = ({OB_COMPLETED*100/OB_MAX:ARG}\% 완료)
ENDIF
PRINTFORML [{ARG}] %OB_OPTIONS:ARG% %LOCALS:0%

