@NAS_NewGame_Onboarding
#DIM OB_LINECOUNT
#DIM OB_INPUT
#DIM OB_IsCOMPLETED
LOADGLOBAL
CUSTOMDRAWLINE ━
PRINTFORML Onboarding
OB_LINECOUNT = LINECOUNT
DO
OB_IsCOMPLETED = 0
CLEARLINE LINECOUNT-OB_LINECOUNT
CUSTOMDRAWLINE ━
FOR LOCAL,1,6
CALL NAS_NewGame_Onboarding_Option(LOCAL,OB_IsCOMPLETED)
NEXT
PRINTL
PRINTFORML [999] Skip onboarding
IF OB_IsCOMPLETED >= 5 && nOnboardingProgress:0 == 0
    CUSTOMDRAWLINE ━
    SETCOLOR C_RED
    PRINTFORML Onboarding is now complete
    RESETCOLOR
    PRINTFORML You will be able to change these settings at the Options screen at the main menu or before the day starts
    PRINTL
    FONTITALIC
    PRINTFORMW Onboarding can also be restarted by going to the Options screen and clicking on 【Reset Onboarding】
    FONTREGULAR
    nOnboardingProgress:0 = 1
    SAVEGLOBAL
    LOADGLOBAL
    RETURN 1
ENDIF

INPUT
OB_INPUT = RESULT
SELECTCASE OB_INPUT
CASE 1 TO 5
    LOADGLOBAL
    SIF nOnboardingProgress:OB_INPUT == -1
        nOnboardingProgress:OB_INPUT = 0
    SAVEGLOBAL
    LOADGLOBAL
    TRYCALLFORM NAS_NewGame_Onboarding_{OB_INPUT}
    SAVEGLOBAL
    LOADGLOBAL
CASE 999
    SETCOLOR C_RED
    PRINTFORML Are you sure you want to exit the onboarding process?
    RESETCOLOR
    PRINTFORML You will be able to change these settings at the Options screen at the main menu or before the day starts
    PRINTL
    FONTITALIC
    PRINTFORML Onboarding can also be restarted by going to the Options screen and clicking on 【Reset Onboarding】
    FONTREGULAR
    CALL ASK_YN()
    SELECTCASE RESULT
    CASE 0
        nOnboardingProgress:0 = -1
        SAVEGLOBAL
        LOADGLOBAL
        RETURN
    ENDSELECT
ENDSELECT
LOOP 1

@NAS_NewGame_Onboarding_Option(ARG,OB_IsCOMPLETED)
{
#DIMS OB_OPTIONS = "",
"Sexual Content",
"Excretion Content",
"Physical Harm",
"Combat",
"Additional Features"
}
{
#DIM  OB_MAX = 0,
3,
6,
4,
6,
5
}
#DIM DYNAMIC OB_COMPLETED
#DIM REF OB_IsCOMPLETED
FOR LOCAL,0,OB_MAX:(ARG)
    SIF GETBIT(nOnboardingProgress:ARG,LOCAL)
        OB_COMPLETED++
NEXT

RESETCOLOR
IF nOnboardingProgress:ARG == -1 || OB_COMPLETED >= OB_MAX:ARG
    SETCOLOR C_GRAY
    OB_IsCOMPLETED++
ENDIF
PRINTFORM [{ARG}] %OB_OPTIONS:ARG% 
IF nOnboardingProgress:ARG == -1
    PRINTFORM (Skipped)
ELSEIF OB_COMPLETED >= OB_MAX:ARG
    PRINTFORM (Complete)
ELSE
    PRINTFORM ({OB_COMPLETED*100/OB_MAX:ARG}\% Complete)
ENDIF
PRINTL

