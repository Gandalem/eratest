		CALLF CM_PROF("攻撃",     +20)
		CALLF CM_PROF("衝動",     +10)
		CALLF CM_PROF("好奇心",   +20)
		CALLF CM_PROF("モラル",   -20)
		CALLF CM_PROF("知性",     +10)
		CALLF CM_PROF("被虐",     -20)
		CALLF CM_PROF("神経質",   +30)
	CASE 2
		PRINTFORML 「산이나 그런 곳에서 망을 보고 싶어?」
		CALLF CM_PROF("神経質",   +30)
		CALLF CM_PROF("プライド", +10)
		CALLF CM_PROF("好奇心",   +20)
		CALLF CM_PROF("モラル",   +10)
		CALLF CM_PROF("潔癖",     +10)
	CASE 3
		PRINTFORML 「혹시 누군가에게 원한을 품고 있기 때문일까?」
		PRINTFORML 「하지만 그 눈은 언젠가 당신에게 저주를 되돌릴 거라고 확신해.」
		CALLF CM_PROF("攻撃",     +30)
		CALLF CM_PROF("衝動",     +10)
		CALLF CM_PROF("倒錯",     +10)
		CALLF CM_PROF("モラル",   -20)
		CALLF CM_PROF("被虐",     -20)
	CASE 4
		PRINTFORML 「내 말은, 그런 정직함이라니. 그렇게 솔직한 건 좋은데, 내 시선에서 벗어나 주길 부탁해도 될까?」
		CALLF CM_PROF("素直さ",   +30)
		CALLF CM_PROF("プライド", -20)
		CALLF CM_PROF("モラル",   -20)
		CALLF CM_PROF("好奇心",   +10)
		CALLF CM_PROF("Ｂ好き",   +10)
		CALLF CM_PROF("羞恥",     -20)
		CALLF CM_PROF("潔癖",     -20)
ENDSELECT
SELECTCASE ARG
	CASE 0
		PRINTFORMW 「앞으로는 계속 같은 방식으로 질문을 받게 될 것이다. 다음 것은 저쪽에 있으니 가서 해라.」
	CASE 9
		PRINTFORMW 「질문 시간은 나로 끝난다. 다시 무의식 상태로 돌아갈 수 있다.」
	CASEELSE
		PRINTFORMW 「다음 건 저쪽에 있으니, 즐거운 여행 되길 바라.」
ENDSELECT
RETURN 1
