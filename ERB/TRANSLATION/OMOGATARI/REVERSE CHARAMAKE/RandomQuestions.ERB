INPUT
SELECTCASE RESULT
	CASE 0
		PRINTFORML 「어라? 생각이 안 나나? 아니면 내 말을 못 따라오는 건가?」
		CALLF CM_PROF("衝動", -10)
		CALLF CM_PROF("好奇心", -10)
