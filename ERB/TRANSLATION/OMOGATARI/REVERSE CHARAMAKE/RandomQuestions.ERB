@M_KOJO_NASMAKE_K37(ARG)
SELECTCASE ARG
	CASE 0 TO 1
		PRINTFORMW 「에?! 벌써 여기 왔어? 하지만 아직 질문을 생각해 본 적이 없는데...」
	CASE 7 TO 9
		PRINTFORML 「좀 너무 늦은 거 아니야? 기다리다 지쳤어.」
		PRINTFORMW 「좋아! 그럼 질문이야! 음...」
	CASEELSE
		PRINTFORMW 「내가 다음이다! 내 질문에 답하라고 너에게 요구할 차례니까 각오해라!」
ENDSELECT
PRINTL 
CALL CHARA_CUTIN(TNAME(TARGET, 1, 1), CSVNAME(TARGET), NAME:TARGET)
PRINTL 
SELECTCASE ARG
	CASE 7 TO 9
		PRINTFORML 「잠깐만, 잠깐! 질문을 깜빡했어!」
		PRINTFORMW 「음, 뭐, 아무거나 물어봐. 그러니 해 봐!」
		PRINTL 
		PRINTFORMDL [0] 정말 별거 없어
		PRINTFORMDL [1] 오늘 아주 귀엽네
		PRINTFORMDL [2] 융합은 기분이 어때?
		PRINTFORMDL [3] 세 가지 치수를 말해봐!
		PRINTFORMDL [4] 오늘은 무슨 속옷을 입었어?
		INPUT
		SELECTCASE RESULT
			CASE 0
				PRINTFORML 「흠, 뭐라고 들으려 했지?」
				CALLF CM_PROF("衝動", -10)
				CALLF CM_PROF("好奇心", -10)
				CALLF CM_PROF("羞恥", 10)
				CALLF CM_PROF("神経質", 10)
			CASE 1
				PRINTFORML 「어, 그건 사실 질문이 아니지만 고마워!」
				CALLF CM_PROF("素直さ",   -20)
				CALLF CM_PROF("好奇心",   +10)
				CALLF CM_PROF("羞恥",     +20)
				CALLF CM_PROF("倒錯",     -20)
				CALLF CM_PROF("潔癖",     +20)
				CALLF CM_PROF("モラル",   +30)
				CALLF CM_PROF("神経質",   +10)
			CASE 2
				PRINTFORML 「정말 굉장해! 하지만 남은 시간이 별로 없으니 다음에 얘기하자!」
				CALLF CM_PROF("攻撃",     +10)
				CALLF CM_PROF("被虐",     +10)
				CALLF CM_PROF("衝動",     +20)
				CALLF CM_PROF("好奇心",   +20)
				CALLF CM_PROF("楽観",     -20)
				CALLF CM_PROF("Ｖ好き",   +30)
			CASE 3
				PRINTFORML 「세 마일? 아, 섬이라고? 뭔가 들어본 것 같은데!」
				CALLF CM_PROF("攻撃",     +10)
				CALLF CM_PROF("プライド", -20)
				CALLF CM_PROF("衝動",     +20)
				CALLF CM_PROF("好奇心",   +20)
				CALLF CM_PROF("羞恥",     -20)
				CALLF CM_PROF("倒錯",     +10)
				CALLF CM_PROF("潔癖",     -20)
				CALLF CM_PROF("モラル",   -20)
				CALLF CM_PROF("Ｂ好き",   +30)
			CASE 4
				PRINTFORML 「오늘 나는 그것이 ... 잠깐만, 절대 대답 안 할 거야!」
				CALLF CM_PROF("攻撃",     +20)
				CALLF CM_PROF("プライド", -20)
				CALLF CM_PROF("衝動",     +30)
				CALLF CM_PROF("好奇心",   +20)
				CALLF CM_PROF("羞恥",     -20)
				CALLF CM_PROF("倒錯",     +10)
				CALLF CM_PROF("潔癖",     -20)
				CALLF CM_PROF("モラル",   -30)
				CALLF CM_PROF("Ｃ好き",   +30)
				CALLF CM_PROF("Ａ好き",   +20)
		ENDSELECT
	CASEELSE
		SELECTCASE ARG
			CASE 0 TO 1
				PRINTFORMW 「음, ... 태양에 대해 어떻게 생각해?」
			CASEELSE
				PRINTFORML 「오늘 햇살이 정말 눈부시고 밝네!」
				PRINTFORMW 「그에게 태양은 무엇인가?」
		ENDSELECT
		PRINTL 
		PRINTFORMDL [0] 대답하지 마라
		PRINTFORMDL [1] 하늘로부터의 축복
		PRINTFORMDL [2] 수소와 헬륨의 질량
		PRINTFORMDL [3] 우주의 에너지
		PRINTFORMDL [4] 그것은 네 미소와 똑같다!
		INPUT
		SELECTCASE RESULT
			CASE 0
				PRINTFORML 「에? 모르다니? 바보야?」
				CALLF CM_PROF("衝動", -10)
				CALLF CM_PROF("好奇心", -10)
				CALLF CM_PROF("羞恥", 10)
				CALLF CM_PROF("神経質", 10)
			CASE 1
				PRINTFORML 「태양이 우리 자비로운 신의 힘이다! 그러니 너무 거만해지지 마라. 그렇지 않으면 신성한 벌을 받을 수도 있다.」
				CALLF CM_PROF("モラル",   +20)
				CALLF CM_PROF("潔癖",     +20)
				CALLF CM_PROF("素直さ",   +20)
				CALLF CM_PROF("好奇心",   -10)
				CALLF CM_PROF("被虐",     -20)
			CASE 2
				PRINTFORML 「수소들을 많이 융합하면 거대한 폭발이 일어난다. 아주 잘 알고 있군!」
				CALLF CM_PROF("好奇心",   +20)
				CALLF CM_PROF("知性",     +20)
				CALLF CM_PROF("プライド", +10)
				CALLF CM_PROF("神経質",   +10)
				CALLF CM_PROF("衝動",     +10)
			CASE 3
				PRINTFORML 「후훗, 맞아! 태양이 궁극의 에너지원이야!」
				CALLF CM_PROF("衝動",     +30)
				CALLF CM_PROF("神経質",   -20)
				CALLF CM_PROF("倒錯",     +20)
				CALLF CM_PROF("好奇心",   +10)
			CASE 4
				PRINTFORML 「후후후, 그것을 듣게 되어 기쁘다!」
				CALLF CM_PROF("衝動",     +10)
				CALLF CM_PROF("羞恥",     -20)
				CALLF CM_PROF("素直さ",   +10)
				CALLF CM_PROF("好奇心",   +30)
				CALLF CM_PROF("Ｂ好き",   +10)
		ENDSELECT
ENDSELECT
SELECTCASE ARG
	CASE 9
		PRINTFORMW 「아, 이제 진행해도 돼! 어? 벌써 끝난 거야?」
	CASEELSE
		PRINTFORMW 「아, 이제 진행해도 돼.」
ENDSELECT
RETURN 1
