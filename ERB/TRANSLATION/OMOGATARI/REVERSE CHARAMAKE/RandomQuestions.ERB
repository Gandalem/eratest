		CALLF CM_PROF("楽観", 30)
		CALLF CM_PROF("Ａ好き", 20)
		CALLF CM_PROF("倒錯", 20)
		CALLF CM_PROF("素直さ", -40)
		CALLF CM_PROF("衝動", 20)
		CALLF CM_PROF("神経質", 40)
	CASE 3
		PRINTFORML 「정말 대단하군. 뛰어난 연기였어, 내가 보장해.」
		CALLF CM_PROF("知性", 30)
