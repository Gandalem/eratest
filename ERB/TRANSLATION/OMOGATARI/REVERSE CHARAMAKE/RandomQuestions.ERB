FOR LOCAL:2, 0, LOCAL
PRINTD ■
NEXT
PRINTL 
PRINTFORMDL [0] 떠나기
PRINTFORMDL [1] 돌을 쌓아라
PRINTFORMDL [2] 그녀를 깨워라
INPUT
IF RESULT == 0
	PRINTFORML 「뭐야, 아무 말도 안 하고 그냥 돌아가려는 거야?」
	PRINTFORMW 「쯧.」
	CALLF CM_PROF("衝動", -10)
	CALLF CM_PROF("好奇心", -10)
	CALLF CM_PROF("羞恥", 10)
	CALLF CM_PROF("神経質", 10)
	RETURN 1
ELSEIF RESULT == 1
	LOCAL++
ELSEIF RESULT == 2
	GOTO LOOP_BREAK
ENDIF
IF PERCENT((LOCAL-6)*10)
	PRINTFORMDW 바위 더미가 무너졌다...
	LOCAL = 2
	LOCAL:1++
ENDIF
GOTO SET_LOOP
$LOOP_BREAK
IF LOCAL:1 == 0
	SELECTCASE LOCAL
		CASE IS <= 3
			PRINTFORML 「흥, 잠시만, 이 근처에 쌓인 게 전혀 안 보이는데.」
			PRINTFORML 「뭐야, 그렇다면 뭐 어쩔 수 없지.」
			CALLF CM_PROF("素直さ", -20)
			CALLF CM_PROF("衝動", 30)
			CALLF CM_PROF("楽観", 30)
			CALLF CM_PROF("モラル", -30)
			CALLF CM_PROF("神経質", -30)
			CALLF CM_PROF("潔癖", -30)
			CALLF CM_PROF("Ｃ好き", 20)
			CALLF CM_PROF("Ｖ好き", -20)
			CALLF CM_PROF("Ｂ好き", -10)
			CALLF CM_PROF("Ａ好き", -10)
		CASE IS <= 10
			PRINTFORML 「음... 상당히 많은 것을 쌓아 두었군.」
			CALLF CM_PROF("素直さ", 10)
			CALLF CM_PROF("衝動", -10)
			CALLF CM_PROF("楽観", 10)
			CALLF CM_PROF("モラル", 10)
			CALLF CM_PROF("神経質", 10)
			CALLF CM_PROF("Ｃ好き", 10)
			CALLF CM_PROF("Ｖ好き", 10)
			CALLF CM_PROF("Ｂ好き", 10)
			CALLF CM_PROF("Ａ好き", -10)
		CASEELSE
			PRINTFORML 「호호호. 이건 정말 산이군, 네가 분명 너무 심하게 했어.」
			CALLF CM_PROF("素直さ", 30)
			CALLF CM_PROF("衝動", -30)
			CALLF CM_PROF("楽観", -30)
			CALLF CM_PROF("モラル", 30)
			CALLF CM_PROF("神経質", 30)
			CALLF CM_PROF("潔癖", 30)
			CALLF CM_PROF("Ｃ好き", -20)
			CALLF CM_PROF("Ｖ好き", 30)
			CALLF CM_PROF("Ｂ好き", 20)
			CALLF CM_PROF("Ａ好き", 20)
	ENDSELECT
ELSE
	IF LOCAL == 2 && LOCAL:1 == 1
		PRINTFORML 「흠, 무너졌다고? 뭐, 이런 일도 있는 거지.」
		PRINTFORML 「너무 신경 쓰지 마.」
		CALLF CM_PROF("楽観", -30)
		CALLF CM_PROF("モラル", -10)
		CALLF CM_PROF("神経質", -20)
		CALLF CM_PROF("潔癖", -30)
		CALLF CM_PROF("Ｃ好き", 10)
		CALLF CM_PROF("Ｖ好き", -10)
		CALLF CM_PROF("Ｂ好き", 10)
		CALLF CM_PROF("Ａ好き", -10)
	ELSE
		PRINTFORML 「와, 인상적이네. 중간에 무너졌지만 열심히 노력한 게 보여.」
		PRINTFORML 「수고했다, 정말 수고했어.」
		CALLF CM_PROF("楽観", 20)
		CALLF CM_PROF("モラル", 30)
		CALLF CM_PROF("神経質", 20)
		CALLF CM_PROF("潔癖", 30)
		CALLF CM_PROF("Ｃ好き", -10)
		CALLF CM_PROF("Ｖ好き", 30)
		CALLF CM_PROF("Ｂ好き", 10)
		CALLF CM_PROF("Ａ好き", 30)
	ENDIF
ENDIF
PRINTFORMW 「지금 돌아가야 해서, 잘 자.」
RETURN 1
;映姫＠Crow

@M_KOJO_NASMAKE_K30(ARG)
PRINTFORML 「눈을 떠 주세요.」
PRINTFORMW 「나 보여요? 후후후, 이쪽이에요.」
PRINTL 
CALL CHARA_CUTIN(TNAME(TARGET, 1, 1), CSVNAME(TARGET), NAME:TARGET)
PRINTL 
PRINTFORML 「그럼, 나에게 또 하나의 질문을 할게.」
PRINTFORML 「네가 저지른 최악의 잘못들을 생각해 봐.」
PRINTFORMW 「만약 네가 피해자였다면 가해자를 용서할 수 있겠어?」
PRINTL 
PRINTFORMDL [0] 대답하지 마라
PRINTFORMDL [1] 나는 결코 잘못을 저지르지 않았다
PRINTFORMDL [2] 전적으로 용서해 주십시오
PRINTFORMDL [3] 아마 용서할 것이다
PRINTFORMDL [4] 절대로 용서하지 않을 것이다
INPUT
SELECTCASE RESULT
	CASE 0
		PRINTFORML 「그렇게 되도록 하지。」
		CALLF CM_PROF("衝動", -10)
		CALLF CM_PROF("好奇心", -10)
		CALLF CM_PROF("羞恥", 10)
		CALLF CM_PROF("神経質", 10)
	CASE 1
		PRINTFORML 「네 거짓말은 너무 티가 나.」
		CALLF CM_PROF("攻撃",      +5)
		CALLF CM_PROF("プライド", +10)
		CALLF CM_PROF("素直さ",   -20)
		CALLF CM_PROF("楽観",     +20)
	CASE 2
		PRINTFORML 「후후, 아주 잘됐군.」
		PRINTFORML 「다시 이 땅으로 돌아왔을 때 아직도 그럴 수 있는지 지켜보도록 하지.」
		CALLF CM_PROF("モラル",   +20)
		CALLF CM_PROF("プライド", -10)
		CALLF CM_PROF("素直さ",   -10)
		CALLF CM_PROF("楽観",     +10)
	CASE 3
		PRINTFORML 「가해자와 피해자는 같은 행위를 완전히 다르게 본다.」
		PRINTFORML 「즉, 용서할 수 있다는 확신이 없다면 그것이 실제 상황일 것이라 의심한다.」
		CALLF CM_PROF("モラル",   +10)
		CALLF CM_PROF("プライド", -10)
		CALLF CM_PROF("素直さ",   +10)
		CALLF CM_PROF("神経質",   +10)
	CASE 4
		PRINTFORML 「네가 살아있는 동안, 네가 저지른 죄는 너와 네가 해를 입힌 사람들을 묶어둘 것이다.」
		PRINTFORML 「그것이 우리 같은 존재들이 죽음 이후에 필요한 이유이다.」
		CALLF CM_PROF("プライド",  20)
		CALLF CM_PROF("素直さ",   +20)
		CALLF CM_PROF("神経質",   +20)
ENDSELECT
