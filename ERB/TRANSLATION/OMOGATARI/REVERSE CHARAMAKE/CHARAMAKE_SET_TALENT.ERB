;ペニスがないと付きにくい
LOCAL /= !HAS_PENIS(MASTER)+1
SIF PERCENT(LOCAL/2)
	TALENT:MASTER:Ａ感度 = -1
;Ｂ敏感
;B Sensitive

@CM_SET_TALENT_106
;素質判定値
LOCAL = CM_TALENT_MAKE("Ｂ好き")
TALENT:MASTER:Ｂ感度 = PERCENT(LOCAL/2)
;Ｂ鈍感
;B Insensitive

@CM_SET_TALENT_107
;B Sensitive
SIF TALENT:MASTER:Ｂ感度
	RETURN 0
;素質判定値
LOCAL = CM_TALENT_MAKE("Ｂ好き逆")
SIF PERCENT(LOCAL/2)
	TALENT:MASTER:Ｂ感度 = -1
