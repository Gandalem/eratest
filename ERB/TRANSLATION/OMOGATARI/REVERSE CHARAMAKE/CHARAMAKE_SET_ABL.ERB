;ABL生成
;従順
@CM_SET_ABL_0, ARG = -999
SIF ARG == -999
	ARG = MASTER
;基本判定値10
LOCAL = 10
;素質判定値を利用
LOCAL += CM_TALENT_MAKE("プライド逆", "被虐", "素直さ", "素直さ", "モラル", "羞恥逆", "攻撃逆", "知性逆", "神経質逆")
;素直だと判定値+50
SIF TALENT:ARG:態度 == -1
	LOCAL += 50
;反抗的だと判定値-50
SIF TALENT:ARG:態度 == 1
	LOCAL -= 50
;臆病だと判定値+30
SIF TALENT:ARG:度胸 == -1
	LOCAL += 30
;気丈だと判定値-30
SIF TALENT:ARG:度胸 == 1
	LOCAL -= 30
;小柄だと判定値+30
SIF TALENT:ARG:体型 < 0
	LOCAL += 30
;大人しいと判定値+20
;SIF TALENT:ARG:大人しい
;	LOCAL += 20
;生意気だと判定値-40
SIF TALENT:ARG:応答 == 1
	LOCAL -= 40
;プライド == 1と判定値-50
SIF TALENT:ARG:プライド == 1
	LOCAL -= 50
;プライド == -1だと判定値+25
SIF TALENT:ARG:プライド == -1
	LOCAL += 25
;幼稚だと判定値+25
SIF TALENT:ARG:幼稚
	LOCAL += 25
WHILE 1
	;加算失敗したら終了
	SIF !PERCENT(LOCAL)
		BREAK
	ABL:ARG:従順++
	LOCAL /= 2
WEND

;欲望
@CM_SET_ABL_1, ARG = -999
SIF ARG == -999
	ARG = MASTER
;基本判定値10
LOCAL = 10
;素質判定値を利用
LOCAL += CM_TALENT_MAKE("被虐", "衝動", "好奇心", "羞恥", "楽観", "倒錯", "同性愛", "モラル逆")
;処女・童貞だと判定値+30
SIF TALENT:ARG:処女 || !TALENT:ARG:非童貞
	LOCAL += 30
;臆病だと判定値-20
SIF TALENT:ARG:度胸 == -1
	LOCAL -= 20
;気丈だと判定値-20
SIF TALENT:ARG:度胸 == 1
	LOCAL -= 20
;小柄だと判定値-20
SIF TALENT:ARG:体型 < 0
	LOCAL -= 20
;自制的だと判定値-50
;SIF TALENT:ARG:自制的
;	LOCAL -= 50
;衝動的だと判定値+30
;SIF TALENT:ARG:衝動的
;	LOCAL += 30
;好奇心だと判定値+50
SIF TALENT:ARG:無関心 == -1
	LOCAL += 50
;感情乏しいだと判定値-50
SIF TALENT:ARG:感情乏しい
	LOCAL -= 50
;情緒豊かだと判定値+20
;SIF TALENT:ARG:情緒豊か
;	LOCAL +=20
;一線越えないだと判定値-40
SIF TALENT:ARG:一線越えない
	LOCAL -= 40
;貞操 == 1だと判定値-30
SIF TALENT:ARG:貞操 == 1
	LOCAL -= 30
;貞操 == -1だと判定値+30
SIF TALENT:ARG:貞操 == -1
	LOCAL += 30
;快感応答 == -1だと判定値-50
SIF TALENT:ARG:快感応答 == -1
	LOCAL -= 50
;快感応答 == 1だと判定値+50
SIF TALENT:ARG:快感応答 == 1
	LOCAL += 50
;倒錯的だと判定値+30
SIF TALENT:ARG:倒錯的
	LOCAL += 30
;自慰しやすいだと判定値+50
SIF TALENT:ARG:自慰しやすい
	LOCAL += 50
WHILE 1
	;加算失敗したら終了
	SIF !PERCENT(LOCAL)
		BREAK
	ABL:ARG:欲望++
	LOCAL /= 2
WEND

;技巧
