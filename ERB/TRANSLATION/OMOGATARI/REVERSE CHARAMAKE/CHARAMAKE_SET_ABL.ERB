	LOCAL += 30
;献身的だと判定値+20
SIF TALENT:ARG:献身的
	LOCAL += 20
;受け身だと判定値-20
; SIF TALENT:ARG:受け身
; 	LOCAL -= 20
;サドだと判定値+50
SIF TALENT:ARG:サド
	LOCAL += 50
;一線越えないだと判定値+20
SIF TALENT:ARG:一線越えない
	LOCAL += 20
;意地悪だと判定値+20
; SIF TALENT:ARG:意地悪
; 	LOCAL += 20
WHILE 1
	;加算失敗したら終了
	SIF !PERCENT(LOCAL)
		BREAK
	ABL:ARG:技巧++
	LOCAL /= 2
WEND

