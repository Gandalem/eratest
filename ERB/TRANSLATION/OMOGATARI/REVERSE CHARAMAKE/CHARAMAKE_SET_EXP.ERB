;絶頂経験
@CM_SET_EXP_4, ARG = -999
SIF ARG == -999
	ARG = MASTER
;オトコ
IF IS_MALE(ARG)
	;部位経験の和を70～100倍にし、100で割るが、Ｃ経験を超えない
	EXP:ARG:絶頂経験 = MIN(SUMARRAY(EXP:ARG:0, 0, 4)*(70+RAND:31)/100, EXP:ARG:Ｃ経験)
;ふたなり
ELSEIF IS_HERM(ARG)
	;部位経験の和を70～100倍にし、100で割る
	EXP:ARG:絶頂経験 = SUMARRAY(EXP:ARG:0, 0, 4)*(70+RAND:31)/100
;女の子
ELSE
	;部位経験の和を40～80倍にし、100で割る
	EXP:ARG:絶頂経験 = SUMARRAY(EXP:ARG:0, 0, 4)*(40+RAND:41)/100
ENDIF

