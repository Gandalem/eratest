;露出快楽経験
@CM_SET_EXP_62, ARG = -999
SIF ARG == -999
	ARG = MASTER
;基本値は自慰経験を半分にして50を引いたもの
LOCAL = EXP:ARG:自慰経験/2-50
;素質判定地は半分にして使う
LOCAL += CM_TALENT_MAKE("プライド逆", "被虐", "羞恥", "羞恥", "倒錯", "倒錯", "潔癖逆", "衝動", "好奇心")/2
;体型 < 0だと判定値-30
SIF TALENT:ARG:体型 < 0
	LOCAL -= 30
;オトコだと判定値-30
SIF IS_MALE(ARG)
	LOCAL -= 30
;倒錯的だと判定値+50
SIF TALENT:ARG:倒錯的
	LOCAL += 30
;自制的だと判定値-50
; SIF TALENT:ARG:自制的
; 	LOCAL -= 30
;経験があるとした場合、量の処理
IF PERCENT(LOCAL)
	;基本値は判定値（負にはなりえない）の1/4にRAND:判定値を足す
	EXP:ARG:露出快楽経験 = LOCAL/4+RAND:LOCAL
	;慎重だと0.5倍
	; SIF TALENT:ARG:慎重
	; 	TIMES EXP:ARG:露出快楽経験, 0.50
	;倒錯的だと1.5倍
	SIF TALENT:ARG:倒錯的
		TIMES EXP:ARG:露出快楽経験, 1.50
	;羞恥心 == 1だと0.75倍
	SIF TALENT:ARG:羞恥心 == 1
		TIMES EXP:ARG:露出快楽経験, 0.75
	;羞恥心 == -1だと1.5倍
	SIF TALENT:ARG:羞恥心 == -1
		TIMES EXP:ARG:露出快楽経験, 1.50
	;最後にオトコなら10、そうでなければ4で割る
	EXP:ARG:露出快楽経験 /= 4+(IS_MALE(ARG)*6)
ENDIF

