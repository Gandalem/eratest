;EXP生成!TALENT:ARG:
;Ｃ経験
@CM_SET_EXP_0, ARG = -999
SIF ARG == -999
	ARG = MASTER
;まず経験自体の有無を判定
;基本判定値50　よっぽど潔癖じゃなければＣ経験はある
LOCAL = 50
;素質判定値を利用
LOCAL += CM_TALENT_MAKE("プライド逆", "被虐", "衝動", "羞恥逆", "モラル逆", "潔癖逆", "倒錯逆", "Ｃ好き", "Ｃ好き", "好奇心", "好奇心")
;ちんこあると判定値+50
SIF HAS_PENIS(ARG)
	LOCAL += 50
;体型 < 0だと判定値-40
SIF TALENT:ARG:体型 < 0
	LOCAL -= 40
;経験があるとした場合、量の処理
IF PERCENT(LOCAL)
	;基本値は判定値（負にはなりえない）の1/4にRAND:判定値を足す
	EXP:ARG:Ｃ経験 = LOCAL/4+RAND:LOCAL
	;体型 < 0だと0.75倍
	SIF TALENT:ARG:体型 < 0
		TIMES EXP:ARG:Ｃ経験, 0.75
	;Ｃ敏感だと1.5倍
	SIF TALENT:ARG:Ｃ感度 == 1
		TIMES EXP:ARG:Ｃ経験, 1.50
	;ペニスがあって童貞でない場合、腰使いだと1.5倍
	;SIF HAS_PENIS(ARG) && TALENT:ARG:非童貞 && TALENT:ARG:腰使い
	SIF HAS_PENIS(ARG) && TALENT:ARG:非童貞
		TIMES EXP:ARG:Ｃ経験, 1.50
	;Ｃ鈍感だと0.75倍
	SIF TALENT:ARG:Ｃ感度 == -1
		TIMES EXP:ARG:Ｃ経験, 0.75
	;自慰しやすいだと2倍
	SIF TALENT:ARG:自慰しやすい
		TIMES EXP:ARG:Ｃ経験, 2.00
ENDIF

;ちんこある非童貞の場合、もし0以下になっていれば、1+RAND:3で差し替える
SIF HAS_PENIS(ARG) && TALENT:ARG:非童貞 && EXP:ARG:Ｃ経験 <= 0
	EXP:ARG:Ｃ経験 = 1+RAND:3


;Ｖ経験
@CM_SET_EXP_1, ARG = -999
SIF ARG == -999
	ARG = MASTER
;オトコお断り
SIF !HAS_VAGINA(ARG)
	RETURN 0
;処女お断り
SIF TALENT:ARG:処女
	RETURN 0
;基本判定値30　処女ではないので必ず経験あり
LOCAL = 30
;素質判定値を利用
LOCAL += CM_TALENT_MAKE("プライド逆", "知性逆", "素直さ", "羞恥逆", "モラル逆", "潔癖逆", "潔癖逆", "Ｖ好き", "Ｖ好き", "好奇心", "好奇心")
;ちんこあると判定値-30
SIF HAS_PENIS(ARG)
	LOCAL -= 30
;体型 < 0だと判定値-20
SIF TALENT:ARG:体型 < 0
	LOCAL -= 20

;判定値が10以下なら、1+RAND:20で差し替える
SIF LOCAL <= 10
	LOCAL = 1+RAND:20

;↑を基本値として量の処理
;基本値は判定値（負にはなりえない）の1/4にRAND:判定値を足す
EXP:ARG:Ｖ経験 = LOCAL/4+RAND:LOCAL
;体型 < 0だと0.75倍
SIF TALENT:ARG:体型 < 0
	TIMES EXP:ARG:Ｖ経験, 0.75
;Ｖ敏感だと1.5倍
SIF TALENT:ARG:Ｖ感度 == 1
	TIMES EXP:ARG:Ｖ経験, 1.50;
;腰使いだと1.5倍
; SIF TALENT:ARG:腰使い
; 	TIMES EXP:ARG:Ｖ経験, 1.50
;Ｖ鈍感だと0.75倍
SIF TALENT:ARG:Ｖ感度 == -1
	TIMES EXP:ARG:Ｖ経験, 0.75
;自慰しやすいだと1.2倍
SIF TALENT:ARG:自慰しやすい
	TIMES EXP:ARG:Ｖ経験, 1.20
;最後に3で割る
EXP:ARG:Ｖ経験 /= 3

;もし0以下になっていれば、1+RAND:3で差し替える
SIF EXP:ARG:Ｖ経験 <= 0
	EXP:ARG:Ｖ経験 = 1+RAND:3

