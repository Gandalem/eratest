@SPEVENT_MESSAGE_4(ARG,ARG:1)
SELECTCASE ARG
	;フェラ、クンニで起こされる
	CASE 1
		CALL PRINT_FACE, TARGET, "発情", "服", "", "吐息"
		PRINTFORMD 깨어나자마자 당신은 그녀가 당신에게 주는 것을 받으며 다리 사이에 머리를 박고 있는 %조사처리(CALLNAME:TARGET,"를")% 보게 된다. 
		IF !HAS_PENIS(MASTER)
			PRINTFORMDL 구강성애.
			PRINTFORMDW 그녀의 얼굴에 맺힌 자신의 체액을 핥아내자, 그녀는 약간 간지러운 듯 몸을 떨며 부끄러워했다.
		ELSE
			PRINTFORMDL 구강 성교다.
			PRINTFORMDW 그녀는 당신의 %SEMEN(MASTER,1)%을 빨아 삼키고, 아무렇지도 않게 좋은 아침이라고 인사한다.
		ENDIF
		;パイズリで起こされる
	CASE 2
		CALL PRINT_FACE, TARGET, "発情", "裸", "", "吐息"
		PRINTFORMDL 당신은 아랫배에서 이상한 감각을 느끼며 잠에서 깨어난다.
		;貧乳の場合
		IF TALENT:バストサイズ < 0
			PRINTFORMDL 슬쩍 엿보자, 그녀가 자신의 %조사처리(CALLNAME:TARGET,"로")% 당신의 %TINKO(MASTER)%를 가지고 놀고 있는 것을 %OPPAI_DESCRIPTION_TR(TARGET)%을 통해 알아차린다.
			PRINTFORMDW 분명 그녀는 자신의 파이즈리 기술을 연습하려는 것 같다...
			;巨乳の場合
		ELSEIF TALENT:バストサイズ > 0
			PRINTFORMDW %BREAKENG(@"당신이 돌아보니 %CALLNAME:TARGET%당신의 사이에 끼인 %TINKO()% 그녀의 사이에 %OPPAI_DESCRIPTION_TR(TARGET)% 그리고 그것을 위아래로 문지르며.")%
			;それ以外
		ELSE
			PRINTFORMDW %BREAKENG(@"당신이 돌아보니 %CALLNAME:TARGET%당신의 %TINKO()% 그녀의 %OPPAI_DESCRIPTION_TR(TARGET)% 그리고 나오는 것을 삼키는 %SEMEN(MASTER,1)% 나오는 것")%
		ENDIF
		;騎乗位、貝合わせ
	CASE 3
		IF ARG:1 == 0
			CALL PRINT_FACE, TARGET, "オナニー", "裸", "", "吐息"
			IF HAS_PENIS(MASTER)
				PRINTFORMDL %BREAKENG(@"깨어나자 허리 주변에 부드러운 무게를 느끼고, 당신의 %TINKO()% 주위에 따뜻하고 꽉 조이는 무언가를 느낀다.")%
				PRINTFORMDW 당신은 숨을 몰아쉬며 위에서 당신 위에 타고 있는 %조사처리(CALLNAME:TARGET,"를")% 바라본다...
				PRINTFORMDL 갑자기 멈추더니, %조사처리(CALLNAME:TARGET,"는")% 얼굴에 미소를 지으며 당신에게서 하던 것을 그만둔다.
				PRINTFORMDL %BREAKENG(@"그녀는 이내 일어나 당신의 사용한 성기를 축축하게 '퍽' 소리를 내며 빼내고 당신의 정액이 그녀의 틈에서 흘러내린다...")%
			ELSE
				PRINTFORMDL 잠에서 깨어나자, 기이한 자세로 누워있는 자신을 발견한다.
				PRINTFORMDW %BREAKENG(@"당신이 뒤돌아보니 %조사처리(CALLNAME:TARGET,"는")%(는) 당신의 다리 하나를 들어 그 사이에 몸을 밀어 넣고, 신음하면서 질을 문질렀다...")%
			ENDIF
		ELSE
			IF TFLAG:193 == 1
				PRINTFORMDW 당신은 더 많은 것을 갈망하며 %TNAME(TARGET)%을 아래로 밀어붙인다.
			ELSE
				PRINTFORMDL 휴...
				PRINTFORMDL 너희 둘 다 이거 하고 나서 샤워할 필요가 있을 것 같아.
			ENDIF
		ENDIF
ENDSELECT
;朝イベント(日常)共通メッセージ群

@SPEVENT_MESSAGE_5(ARG,ARG:1)
SELECTCASE ARG
	;キスで起こされる
	CASE 1
		CALL PRINT_FACE, TARGET, "発情", "服", "", "吐息"
		PRINTFORMDL 입안에 달콤하고 부드러운 감각을 느끼며 잠에서 깬다.
		PRINTFORMDL 눈을 뜨자, %조사처리(CALLNAME:TARGET,"가")% 당신의 입술과 자신의 입술을 맞대고 있는 것이 보인다.
		PRINTFORMDW 마지못해 입술을 열자, 그녀는 뒤로 물러나 뺨에 홍조를 띠며 아침 인사를 건넨다.
		;揺さぶり起こされる
	CASE 2
		CALL PRINT_FACE, TARGET, "笑顔", "服"
		PRINTFORMDL 갑작스러운 충격에서 깨어났다.
		PRINTFORMDW 일어나자, %조사처리(CALLNAME:TARGET,"가")%(가) \@ CHARA_DISPOS(TARGET) >= 3 ? 비웃으며 # 미소 지으며 당신에게 좋은 아침이라고 인사하는 것을 본다. \@
		;起こしに来たけど寝てる
	CASE 3
		CALL PRINT_FACE, TARGET, "通常", "服"
		PRINTFORMDL 당신은 %조사처리(CALLNAME:TARGET,"가")%(가) 자신의 바로 옆에서 잠들어 있는 것을 보고 눈을 뜬다.
		PRINTFORMDW 그녀는 여전히 약간 졸린 듯, 당신에게 안기면서 부드럽게 흔들어 깨운다.
		;起きるまでじっと見てる
	CASE 4
		CALL PRINT_FACE, TARGET, "発情", "服"
		PRINTFORMDL 깨어나자, 위에서 자신을 내려다보고 있는 %조사처리(CALLNAME:TARGET,"의")% 시선과 마주한다.
		PRINTFORMDW 그녀는 황급히 얼굴을 돌리며 홍조를 띤 채 아침 인사를 건넨다.
		;イタズラで起こされる
	CASE 5
		CALL PRINT_FACE, TARGET, "笑顔", "服"
		PRINTFORMDL 당신은 잠든 사이에 %조사처리(CALLNAME:TARGET,"가")%(가) 장난을 치는 것을 알아차리며 이상한 불편함을 느끼며 깨어난다.
		PRINTFORMDL 그녀는 서둘러 당신에게서 물러나 얼굴에 미소를 지으며 좋은 아침이라고 인사한다.
		SIF TALENT:機嫌 < 0
			PRINTFORMDL 적어도 그녀의 작은 장난이 기분을 나아지게 한 것 같다.
		WAIT
ENDSELECT
;夜イベント(うふふ)共通メッセージ群

@SPEVENT_MESSAGE_6(ARG,ARG:1)
SELECTCASE ARG
	;夜這いキス
	CASE 1
		CALL PRINT_FACE, TARGET, "発情", "服", "", "吐息"
		PRINTFORMDW 잠자리에 들고 몇 분 뒤... %조사처리(CALLNAME:TARGET,"는")%(는) \@ CFLAG:現在位置 != CFLAG:MASTER:現在位置 ? 방으로 몰래 들어온다 # 돌아보며 당신을 응시한다 \@.
		PRINTFORMDW 그녀는 당신이 잠든 모습을 바라보다가, 자신의 감정을 더 이상 참지 못하고 당신의 입술에 키스를 훔친다.
		PRINTDL ...
		PRINTFORMDL 잠시 후, %조사처리(CALLNAME:TARGET,"는")%(는) 여전히 남아있는 감각을 회상하며 마지못해 입술을 달싹였다.
		PRINTFORMDW 그러더니 그녀는 \@ CFLAG:現在位置 != CFLAG:MASTER:現在位置 ? 조용히 빠져나간다 # 당신에게 조심스럽게 다가와 잠을 방해하지 않도록 한다 \@.
		;夜這い
	CASE 2
		SELECTCASE ARG:1
			CASE 0 ;intro
				CALL PRINT_FACE, TARGET, "発情", "裸", "", "吐息"
			CASE 1 ;actual sex event
				PRINTFORMDL 당신이 \@ CFLAG:現在位置 != CFLAG:MASTER:現在位置 ? 잠자리에 들 준비를 하고 있을 때, %조사처리(CALLNAME:TARGET,"가")% 갑자기 당신의 방에 방문하거나 # 잠들려고 할 무렵, %조사처리(CALLNAME:TARGET,"가")% 갑자기 당신을 어루만지기 시작한다 \@.
				PRINTFORMD 볼이 깊게 상기된 채, 그녀는 당신을 밀어 눕히고 
				IF (HAS_VAGINA(TARGET) && !HAS_VAGINA(MASTER)) || (HAS_PENIS(TARGET) && HAS_VAGINA(MASTER))
					IF !HAS_VAGINA(MASTER) && HAS_PENIS(MASTER) ;male only master, so nue would fuck female/futa master
						PRINTFORM 그녀는 당신의 %TINKO()%이 자신의 %FSYN("vagina")% 안으로 들어오는 것을 애타게 환영하며, 골반을 세차게 부딪쳤다.
					ELSE
						PRINTFORM 그녀는 격렬하게 %TINKO(TARGET)%을 당신의 %FSYN("slit")%에 밀어 넣은 후 한 번에 관통한다.
					ENDIF
					CALL PRINT_BREAK,,"dc"
				ELSE
					PRINTFORMDL 당신의 몸을 만지면서 그녀는 당신의 입술에 자신의 입술을 맞춘다.
				ENDIF
				IF (HAS_VAGINA(TARGET) && !HAS_VAGINA(MASTER)) || (HAS_PENIS(TARGET) && HAS_VAGINA(MASTER))
					IF !HAS_VAGINA(MASTER) && HAS_PENIS(MASTER)
						PRINTFORMDL %BREAKENG(@"배고픈 야수처럼 입가에 침을 흘리며, 그녀는 당신의 남성성과 함께 스스로를 완전히 즐기며, 그녀의 자궁의 갈증을 해소한다...")%
					ELSE
						PRINTFORMDL %BREAKENG(@"%CAPITALIZE(FSYN("thrust:ing"))% herself deep inside your womb with her unabated erection, she thoroughly enjoys herself with your vagina...")%
					ENDIF
				ELSE
					PRINTFORMDL %BREAKENG(@"당신의 몸을 끊임없이 괴롭히며 탐색하는 동안, %CALLNAME:TARGET%도 자신의 틈 안으로 손가락을 넣으며 자신을 지배하기 시작하는 저릿함을 달래려 애썼다...")%
				ENDIF
				PRINTDW ...
				PRINTFORMDL 여러 번의 절정을 이룬 후, 당신들은 서로의 욕망을 이루고 싶어 한다.
				PRINTFORMD 당신들은 서로를 다정하게 끌어안고 함께 깊은 잠에 빠진다. 
				IF (HAS_VAGINA(TARGET) && !HAS_VAGINA(MASTER)) || (HAS_PENIS(TARGET) && HAS_VAGINA(MASTER))
					PRINTFORMDW 여전히 서로 연결되어 있는 동안에도...
				ELSE
					PRINTFORMDW 몸이 여전히 얽힌 채로...
				ENDIF
		ENDSELECT
		;自慰
	CASE 3
ENDSELECT
