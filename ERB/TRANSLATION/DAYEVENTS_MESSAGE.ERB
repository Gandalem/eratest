@SPEVENT_MESSAGE_7(ARG,ARG:1)
SELECTCASE ARG
	;晩酌
	CASE 1
		CALL PRINT_FACE, TARGET, "笑顔", "服"
		PRINTFORMDL %BREAKENG(@"\@ CFLAG:現在位置 != CFLAG:MASTER:現在位置 ? 잠자리에 들 준비를 하고 있을 때, %조사처리(CALLNAME:TARGET,"가")% 찾아와 초대한다 # 잠들려고 할 무렵, %조사처리(CALLNAME:TARGET,"는")% 갑자기 너를 그녀와 저녁 식사 겸 술을 마시러 초대한다 \@.")%
		PRINTFORMDW 앞으로 몇 순간 동안, 당신과 %조사처리(CALLNAME:TARGET,"는")% 함께 술을 마시며 즐거운 시간을 보낸다...
		;夜風に当たる、お月見
	CASE 2
		;夜風に当たる（縁側で）
		CALL PRINT_FACE, TARGET, "笑顔", "服"
		IF MOON_WATCH(DAY:3, 1) == 9 && MAIN_MAP != MAP月 && TIME:5 < 4
			;お月見（満月）
			PRINTFORMDL %BREAKENG(@"\@ CFLAG:現在位置 != CFLAG:MASTER:現在位置 ? 잠자리에 들 준비를 하고 있을 때 %조사처리(CALLNAME:TARGET,"와")%서 초대한다 # 잠들려고 할 때 %CALLNAME:TARGET%갑자기 초대한다 \@ you to a moon viewing with a \@ (TALENT:妊娠 + TALENT:育児中) ? 찻잔 # 차를 마신다 \@ 그녀의 손에")%
			PRINTFORMDW %BREAKENG(@"적절한 장소로 나가 너와 %조사처리(CALLNAME:TARGET,"는")% 밤늦도록 함께 아름다운 보름달을 감상한다...")%
		ELSEIF TIME:5 <= 3
			;夜風に当たる（夜散歩）
			PRINTFORMDL %BREAKENG(@"「\@ CFLAG:現在位置 != CFLAG:MASTER:現在位置 ? 잠자리에 들 준비를 하고 있을 때, %조사처리(CALLNAME:TARGET,"가")% 다가와 초대한다 # 잠이 들려고 할 때, %조사처리(CALLNAME:TARGET,"가")% 갑자기 너를 밤 산책에 초대한다 \@」")%
			PRINTFORMDW 당신은 함께 수다를 떨며 밤 산책을 즐긴다…
		ELSE
			;夜風に当たる（縁側で）
			PRINTFORMDL %BREAKENG(@"\@ CFLAG:現在位置 != CFLAG:MASTER:現在位置 ? 잠자리에 들 준비를 하고 있을 때, %조사처리(CALLNAME:TARGET,"가")% 당신에게 말을 걸러 찾아온다 # 잠들기 직전에, %조사처리(CALLNAME:TARGET,"가")% 갑자기 당신과 대화를 나누기 시작한다 \@.")%
			IF TIME:5 == 4
				LOCALS = 부드러운 비
			ELSEIF TIME:5 == 8
				LOCALS = 춤추는 눈
			ELSE
				LOCALS = 밤바람
			ENDIF
			PRINTFORMDW %BREAKENG(@"두 분 모두 베란다로 나오자, 잠시 동안 당신과 %조사처리(CALLNAME:TARGET,"는")% %LOCALS%를 즐기며 친근한 대화를 나눈다...")%
		ENDIF
		;添い寝
	CASE 3
		CALL PRINT_FACE, TARGET, "笑顔", "服"
		IF TALENT:恋人
			PRINTFORMDW 잠자리에 들 때, %조사처리(CALLNAME:TARGET,"가")% 나타나 당신 옆에 파고든다.
			PRINTFORMDW 함께 포옹하며 그녀는 행복한 미소를 짓는다.
			PRINTDL ...
			PRINTFORMDL %조사처리(CALLNAME:TARGET,"는")%(는) 당신이 졸음에 빠져 잠든 것을 지켜보며 미소 짓는다.
			PRINTFORMDL 그녀가 자신도 잠자리에 들려던 바로 그 순간, 당신이 잠결에 뒤척이자 갑자기 당신에게 파묻힌다!
			PRINTFORMDL 당신의 웃음 소리를 듣고 편안한 자세로 몸을 기대어 서로를 끌어안은 채 함께 잠이 든다...
		ELSE
			PRINTFORMDW 당신이 잠자리에 들고 얼마 지나지 않아... %조사처리(CALLNAME:TARGET,"가")% 당신의 방에 몰래 들어온다.
			PRINTFORMDW 그녀는 당신이 자는 모습을 바라보며, 한동안 당신의 잠든 얼굴을 응시하다가 얼굴을 새빨갛게 물들인다.
			PRINTFORMDW 하지만 결국 그녀는 아무것도 할 수 없어 조용히 당신의 %BED_FUTON()% 안으로 미끄러져 들어간다.
			PRINTFORMDW 그녀는 계속 당신 쪽을 흘깃거리며 바라보는데, 그 모습이 극도로 열병에 걸린 듯한 느낌을 준다...
			PRINTDL ...
			PRINTFORMDL %BREAKENG(@"{(RAND:3+1) * 10}분 후, %조사처리(CALLNAME:TARGET,"가")% 거의 포기하고 일어나려던 찰나, 네가 잠결에 몸을 뒤척이며 갑자기 그녀를 덮어 버린다!")%
			PRINTFORMDL 그녀는 그 자리에서 얼굴을 더욱 붉히며 상황에 맡긴 채 얼어붙었다.
			PRINTFORMDL 잠 못 이루던 밤들이 끝나지 않은 모양이다...
		ENDIF
ENDSELECT
