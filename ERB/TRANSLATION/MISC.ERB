NEXT

@LAST_ROUND_CLIMAX(CharacterIndex=-1,ClimaxPart)
	;Returns 1 if the given climax type happened for the given character last round, or the total of any type if not specified.
	;If CharacterIndex is -1, checks all characters in the area. If -2, checks all characters except the player.
	;If anyone came, sets RESULT:1 to their ID, prioritizing the player's current target.
#FUNCTION
#DIM DYNAMIC CharacterIndex
#DIMS DYNAMIC ClimaxPart
#DIM DYNAMIC LoopStart
#DIM DYNAMIC LoopEnd
#DIM DYNAMIC Output,2
#DIM DYNAMIC CameIndex
#DIM DYNAMIC TargetCame
CameIndex = -1
SELECTCASE CharacterIndex
	CASE -1
		CharacterIndex = 0
		LoopEnd = GET_TARGETNUM()+1
	CASE -2
		CharacterIndex = TARGET:1
		LoopStart = 1
		LoopEnd = GET_TARGETNUM()+1
	CASEELSE
		LoopEnd = 1
ENDSELECT
FOR LOCAL,LoopStart,LoopEnd
	SIF LOCAL > 0
		CharacterIndex = TARGET:LOCAL
	SELECTCASE ClimaxPart
		CASE "C","V","A","B","M","Ejaculation"
			Output:0 = VAR_OR_DEFAULT(@"LastRound%ClimaxPart%Climax:{CharacterIndex}")
		CASEELSE
			Output:0 = VAR_OR_DEFAULT(@"LastRoundCClimax:{CharacterIndex}")+VAR_OR_DEFAULT(@"LastRoundVClimax:{CharacterIndex}")+VAR_OR_DEFAULT(@"LastRoundAClimax:{CharacterIndex}")+VAR_OR_DEFAULT(@"LastRoundBClimax:{CharacterIndex}")+VAR_OR_DEFAULT(@"LastRoundMClimax:{CharacterIndex}")+VAR_OR_DEFAULT(@"LastRoundEjaculationClimax:{CharacterIndex}")
	ENDSELECT
	IF TARGET == LOCAL && Output:0
		TargetCame = 1
		CameIndex = TARGET:LOCAL
	ENDIF
	SIF !TargetCame && Output:0
		CameIndex = TARGET:LOCAL
	Output:1 += Output:0
NEXT
RESULT:1 = CameIndex
RETURNF Output:1

@MOVE_CHARACTER(CharacterIndex,AreaIndex=-1,FullProcess)
	;Relocates the given character to the given map location and cancels Lead Around.
	;If CharacterIndex is omitted, defaults to the player. If AreaIndex is omitted, defaults to the player's location.
	;FullProcess will immediately process greetings, etc if moved to the player's location.
	;Also unlocks doors if the player is moved.
#DIM DYNAMIC CharacterIndex
#DIM DYNAMIC AreaIndex
#DIM DYNAMIC FullProcess
SIF AreaIndex == -1
	AreaIndex = CFLAG:MASTER:現在位置
IF CharacterIndex != MASTER
	IF CFLAG:CharacterIndex:神社在住/100 != MAIN_MAP
		IF !IN_HOME(CharacterIndex) && IN_HOME(AreaIndex)
			CFLAG:CharacterIndex:拠点来訪 = 1
			CALLF SET_VAR(@"TCVAR:{CharacterIndex}:Arrival_Time",TIME)
		ELSEIF !IN_HOME(AreaIndex)
			CFLAG:CharacterIndex:拠点来訪 = 0
		ENDIF
	ENDIF
	IF AreaIndex == CFLAG:MASTER:現在位置
		CFLAG:CharacterIndex:遭遇位置 = CFLAG:MASTER:現在位置
	ELSE
		CFLAG:CharacterIndex:同行 = 0
	ENDIF
	TCVAR:CharacterIndex:なるべく動かない = 1
ENDIF
SIF CharacterIndex == MASTER && AreaIndex != CFLAG:CharacterIndex:現在位置
	FLAG:自室施錠 = 0
CFLAG:CharacterIndex:現在位置 = GET_MAP_REPLACEMENT(AreaIndex)
SIF VAR_OR_DEFAULT("MOREDATE")
	TRYCALL REMOVE_FROM_GROUP_DATE(CharacterIndex)
IF FullProcess
	CALL INFO_RENEW_TARGET
ELSE
	CALL TARGETSET_CHACK("「同室更新無し」")
ENDIF

