@RETURN_TO_BEDROOM(CharacterNumber,OnlyHere)
	;Relocates the given character back to their initial location (or off the map, for visitors). If the character is -1, affects all characters.
	;If OnlyHere is 1, only affects characters in the same area as the player.
	;Unless the character is given as 0, it won't affect the player.
#DIM DYNAMIC CharacterNumber
#DIM DYNAMIC OnlyHere
#DIM DYNAMIC TargetCharacter
#DIM DYNAMIC CheckLimit
IF CharacterNumber > -1
	SIF !OnlyHere || CFLAG:CharacterNumber:現在位置 == CFLAG:MASTER:現在位置
		CALL MOVE_CHARACTER(CharacterNumber,CFLAG:CharacterNumber:初期位置)
	RETURN
ENDIF
IF OnlyHere
	CheckLimit = GET_TARGETNUM()
ELSE
	CheckLimit = CHARANUM
ENDIF
FOR LOCAL,1,CheckLimit
	IF OnlyHere
		TargetCharacter = TARGET:LOCAL
	ELSE
		TargetCharacter = LOCAL
	ENDIF
	SIF !OnlyHere || CFLAG:TargetCharacter:現在位置 == CFLAG:MASTER:現在位置
		CALL MOVE_CHARACTER(TargetCharacter,CFLAG:TargetCharacter:初期位置)
NEXT

