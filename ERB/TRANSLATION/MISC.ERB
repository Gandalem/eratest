;writes once, twice, x times
;TYPE can be "word" or "num", "word" prints it as a word through NUM_COUNT, while "num" keeps it a numeral
;thrice is not used
@NUM_ADVERB(NUM, TYPE = "word", CAPS)
#FUNCTIONS
#DIM NUM
#DIMS TYPE
#DIM CAPS

SELECTCASE NUM
	CASE 1
		LOCALS = once
	CASE 2
		LOCALS = twice
	CASEELSE
		LOCALS = \@ TYPE == "word" ? %NUM_COUNT(NUM)% # {NUM} \@ times
ENDSELECT

SIF CAPS
	LOCALS '= CAPITALIZE(LOCALS)

RETURNF LOCALS

