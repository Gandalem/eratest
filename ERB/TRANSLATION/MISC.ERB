;----------------------------------------------------------------------
;Like AddEXP, but unbolded and with the name at the front. Can be spaced out with OutputMode = 1 or hidden with OutputMode = -1.
;Additionally, gains will be increased according to Knowledge if the player owns the appropriate skill book.
;----------------------------------------------------------------------
@AddEXPOrdered(VAR_NAME,C_ID,変動数,OutputMode,AllowSkillBookBonus=1,AllowKnowledgeSkillBookBonus=1)
#DIMS DYNAMIC VAR_NAME
#DIM DYNAMIC VAR_ID
#DIM DYNAMIC C_ID
#DIM DYNAMIC 変動数
#DIM DYNAMIC OutputMode
#DIM DYNAMIC AllowSkillBookBonus
#DIM DYNAMIC AllowKnowledgeSkillBookBonus
#DIM DYNAMIC SkillBookBonus
SIF 変動数 == 0
	RETURN
VAR_ID = FINDELEMENT(EXPNAME, VAR_NAME,,,1)
SkillBookBonus = EXPERIENCE_BOOK(VAR_NAME)
IF AllowSkillBookBonus && SkillBookBonus > -1 && ITEM:SkillBookBonus
	SIF AllowKnowledgeSkillBookBonus ;Knowledge increases and requires the book bonus if enabled.
		変動数 += ABL:C_ID:教養/2
	TIMES 変動数,1.5
ENDIF
EXP:C_ID:VAR_ID += 変動数
IF OutputMode == 1
	CALL COLORMESSAGE(@"%CALLNAME:C_ID+"'s",14,LEFT% %EXP_TR(VAR_ID),18,LEFT% ＋%DIGIT_GROUP(変動数)%",C_YELLOW,1)
ELSEIF OutputMode == 0
	CALL COLORMESSAGE(@"%CALLNAME:C_ID+"'s"% %EXP_TR(VAR_ID)% ＋%DIGIT_GROUP(変動数)%",C_YELLOW,2)
