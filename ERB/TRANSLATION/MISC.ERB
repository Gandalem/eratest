@GETPERCENT, ARG:0, ARG:1, ARG:2
#FUNCTION
SIF ARG:0 == 0 || ARG:1 == 0
	RETURNF 0 
SIF ARG:2
	RETURNF ROUND_NEAREST(ARG:0*100, ARG:1)
LOCAL = ARG:0*100 / ARG:1
RETURNF LOCAL

