;*************************************************
;Print mutually exclusive terms depending on the condition per function
;Default returning terms defined here can be overridden with : to define your own
;Example: %PRINT_MALE("man:breeding sow")%
;Capitalization depends on the case of the arguments
;*************************************************
@PRINT_MALE(ARGS, ARG:0 = -1)
#FUNCTIONS
SIF ARG < 0
	ARG = TARGET
SIF !STRLENS(ARGS)
	ARGS = guy
IF STRFIND(ARGS, "_") >= 0 ;Old functionality for separating by _: instead of :.
	ARGS '= REPLACE(ARGS, "_", "")
	GOTO CUSTOM
ENDIF

SELECTCASE TOLOWER(ARGS)
	CASE "boy"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "girl" # "kid")
	CASE "man"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "woman" # "person")
	CASE "lad"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "lass" # TOLOWER(ARGS:0))
	CASE "guy"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "girl" # "person")
	CASE "fellow", "fella"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "gal" # TOLOWER(ARGS:0))
	CASE "male"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "female" # "non-binary")
	CASE "mister"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "miss" # "mixter")
	CASE "mr."
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "ms." # "mx.")
	CASE "incubus"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "succubus" # TOLOWER(ARGS:0))
	CASE "shota"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "loli" # "child")
	CASE "son"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "daughter" # "offspring")
	CASE "sir"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "miss" # TOLOWER(ARGS:0))
	CASE "men"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "women" # "persons")
	CASE "husband"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # (IS_FEMALE(ARG:0) ? "wife" # "spouse")
	CASE "lad2"
		LOCALS '= IS_MALE(ARG:0) ? "lad" # (IS_FEMALE(ARG:0) ? "lady" # "lad")
	CASE "fiancé", "fiance"
		LOCALS '= IS_MALE(ARG:0) ? "fiancé" # "fiancée"
	CASE "papa"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # "mama"
	CASE "brother"
		LOCALS '= IS_MALE(ARG:0) ? TOLOWER(ARGS:0) # "sister"
CASEELSE
	$CUSTOM
	LOCALS '= IS_MALE(ARG:0) ? SPLIT_SINGLE(TOLOWER(ARGS:0)) # SPLIT_SINGLE(TOLOWER(ARGS:0), 1)
	SIF SPLIT_SINGLE(TOLOWER(ARGS:0), 1) == "" ;Ensure the string is returned if there's no split.
		LOCALS '= TOLOWER(ARGS)
ENDSELECT
RETURNF IS_CAPITALIZED(ARGS:0) ? CAPITALIZE(LOCALS) # LOCALS

