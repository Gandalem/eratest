@SET_FALL_STATE(CharacterIndex,FallState,AllowReverse)
	;Adds the given fall state and all prerequisites to a character if they don't have it.
	;If AllowReverse is 1, will lock progression to that state regardless of whether it has been achieved.
	;Agreeability level, orgasm count, and Lust/Intimacy comparisons are excluded from being set.
	;Mistress is treated as a state of both Yearning and Sex Friend, so adding Sex Friend to a character with Yearning grants Mistress instead.
	;Lewd is omitted.
#DIM DYNAMIC CharacterIndex
#DIMS DYNAMIC FallState
#DIM DYNAMIC AllowReverse
VARSET LOCAL
SIF AllowReverse
	CALL REMOVE_FALL_STATE(CharacterIndex,FallState)
SELECTCASE FallState
	CASE "思慕","Yearning"
		CFLAG:CharacterIndex:好感度 = MAX(CFLAG:CharacterIndex:好感度,REQUIRED_FAVOR_思慕)
		CFLAG:CharacterIndex:信頼度 = MAX(CFLAG:CharacterIndex:信頼度,REQUIRED_TRUST_思慕)
		CALL SET_ABL_AND_XP(CharacterIndex,"親密",REQUIRED_AFFECTION_思慕)
		IF TALENT:CharacterIndex:セフレ
			TALENT:CharacterIndex:思慕 = 0
			TALENT:CharacterIndex:セフレ = 2
		ELSEIF !TALENT:CharacterIndex:恋慕
			TALENT:CharacterIndex:思慕 = 1
		ENDIF
	CASE "恋慕","Love"
		CFLAG:CharacterIndex:好感度 = MAX(CFLAG:CharacterIndex:好感度,REQUIRED_FAVOR_恋慕)
		CFLAG:CharacterIndex:信頼度 = MAX(CFLAG:CharacterIndex:信頼度,REQUIRED_TRUST_恋慕)
		CALL SET_ABL_AND_XP(CharacterIndex,"親密",REQUIRED_AFFECTION_恋慕)
		MARK:LOCAL:反発刻印 = 0
		IF !FLAG:陥落路線変化
			TALENT:CharacterIndex:セフレ = 0
			TALENT:CharacterIndex:愛欲 = 0
		ENDIF
		TALENT:CharacterIndex:恋慕 = 1
	CASE "恋人","Lover"
		SIF TALENT:CharacterIndex:セフレ == 1
			TALENT:CharacterIndex:セフレ = 0
		TALENT:CharacterIndex:恋人 = 1
	CASE "セフレ","Sex Friend"
		CFLAG:CharacterIndex:好感度 = MAX(CFLAG:CharacterIndex:好感度,REQUIRED_FAVOR_セフレ)
		CALL SET_ABL_AND_XP(CharacterIndex,"欲望",REQUIRED_DESIRE_セフレ)
		IF TALENT:CharacterIndex:思慕
			TALENT:CharacterIndex:思慕 = 0
			TALENT:CharacterIndex:セフレ = 2
		ELSEIF !TALENT:CharacterIndex:愛欲
			TALENT:CharacterIndex:セフレ = 1
		ENDIF
	CASE "愛欲","Lust"
		CFLAG:CharacterIndex:好感度 = MAX(CFLAG:CharacterIndex:好感度,REQUIRED_FAVOR_愛欲)
		CALL SET_ABL_AND_XP(CharacterIndex,"欲望",REQUIRED_DESIRE_愛欲)
		LOCAL = TALENT:CharacterIndex:思慕
		IF FLAG:陥落路線変化
			SIF TALENT:CharacterIndex:セフレ == 2
				TALENT:CharacterIndex:思慕 = 1
		ELSE
			TALENT:CharacterIndex:思慕 = 0
			TALENT:CharacterIndex:恋慕 = 0
		ENDIF
		TALENT:CharacterIndex:セフレ = 0
		TALENT:CharacterIndex:愛欲 = 1
	CASE "愛人","Mistress"
		CFLAG:CharacterIndex:好感度 = MAX(CFLAG:CharacterIndex:好感度,REQUIRED_FAVOR_思慕)
		CFLAG:CharacterIndex:好感度 = MAX(CFLAG:CharacterIndex:好感度,REQUIRED_FAVOR_セフレ)
		CFLAG:CharacterIndex:信頼度 = MAX(CFLAG:CharacterIndex:信頼度,REQUIRED_TRUST_思慕)
		CALL SET_ABL_AND_XP(CharacterIndex,"親密",REQUIRED_AFFECTION_思慕)
		CALL SET_ABL_AND_XP(CharacterIndex,"欲望",REQUIRED_DESIRE_セフレ)
		IF !TALENT:CharacterIndex:恋慕 && !TALENT:CharacterIndex:愛欲
			TALENT:CharacterIndex:思慕 = 0
			TALENT:CharacterIndex:セフレ = 2
		ENDIF
ENDSELECT

@REMOVE_FALL_STATE(CharacterIndex,FallState)
	;Removes the given fall state from the given character and sets all prerequisite parameters to the level of the previous fall state tier (or 0).
	;If a lower tier state is removed, removes higher tier ones as well.
	;Agreeability level, orgasm count, and Lust/Intimacy comparisons are excluded from being set.
	;Mistress is treated as a state of both Yearning and Sex Friend, so removing Sex Friend from a Mistress grants Yearning and so on.
	;Prerequisites for other fall states will be restored afterwards if they're missing (such as the required Favor for Yearning after removing Sex Friend).
	;Lewd is omitted.
#DIM DYNAMIC CharacterIndex
#DIMS DYNAMIC FallState
SELECTCASE FallState
	CASE "思慕","Yearning"
		SIF !TALENT:CharacterIndex:思慕 && !TALENT:CharacterIndex:思慕 && TALENT:CharacterIndex:セフレ != 2
			RETURN
		TALENT:CharacterIndex:恋慕 = 0
		TALENT:CharacterIndex:思慕 = 0
		TALENT:CharacterIndex:セフレ = MIN(TALENT:CharacterIndex:セフレ,1)
		CFLAG:CharacterIndex:好感度 = 0
		CFLAG:CharacterIndex:信頼度 = 0
		ABL:CharacterIndex:親密 = 0
		JUEL:CharacterIndex:好意 = 0
	CASE "恋慕","Love"
		SIF !TALENT:CharacterIndex:恋慕
			RETURN
		TALENT:CharacterIndex:恋慕 = 0
		TALENT:CharacterIndex:思慕 = 1
		CFLAG:CharacterIndex:好感度 = 0
		CFLAG:CharacterIndex:信頼度 = 0
		ABL:CharacterIndex:親密 = 0
		JUEL:CharacterIndex:好意 = 0
	CASE "恋人","Lover"
		SIF !TALENT:CharacterIndex:恋人
			RETURN
		TALENT:CharacterIndex:恋人 = 0
	CASE "セフレ","Sex Friend"
		SIF !TALENT:CharacterIndex:セフレ
			RETURN
		TALENT:CharacterIndex:愛欲 = 0
		TALENT:CharacterIndex:思慕 = TALENT:CharacterIndex:セフレ == 2
		TALENT:CharacterIndex:セフレ = MIN(TALENT:CharacterIndex:セフレ,1)
		CFLAG:CharacterIndex:好感度 = 0
		ABL:CharacterIndex:欲望 = 0
		JUEL:CharacterIndex:欲情 = 0
	CASE "愛欲","Lust"
		SIF !TALENT:CharacterIndex:愛欲
			RETURN
		TALENT:CharacterIndex:愛欲 = 0
		TALENT:CharacterIndex:セフレ = TALENT:CharacterIndex:思慕 ? 2 # 1
		TALENT:CharacterIndex:思慕 = 0
		CFLAG:CharacterIndex:好感度 = 0
		ABL:CharacterIndex:欲望 = 0
		JUEL:CharacterIndex:欲情 = 0
	CASE "愛人","Mistress"
		SIF !TALENT:CharacterIndex:セフレ
			RETURN
		CALL REMOVE_FALL_STATE(CharacterIndex,"Yearning")
		CALL REMOVE_FALL_STATE(CharacterIndex,"Sex Friend")
	CASE "全部","All"
		SIF !IS_FALLEN(CharacterIndex)
			RETURN
		CALL REMOVE_FALL_STATE(CharacterIndex,"Yearning")
		CALL REMOVE_FALL_STATE(CharacterIndex,"Sex Friend")
		TALENT:CharacterIndex:恋人 = 0
ENDSELECT
SIF TALENT:CharacterIndex:思慕 || TALENT:CharacterIndex:セフレ == 2
	CALL SET_FALL_STATE(CharacterIndex,"Yearning")
SIF TALENT:CharacterIndex:恋慕
	CALL SET_FALL_STATE(CharacterIndex,"Love")
SIF TALENT:CharacterIndex:セフレ
	CALL SET_FALL_STATE(CharacterIndex,"Sex Friend")
SIF TALENT:CharacterIndex:愛欲
	CALL SET_FALL_STATE(CharacterIndex,"Lust")

