; Modular ERB: WORK.ERB

@JOB_DEPICTION(ARG)
IF CFLAG:ARG:職種 == 48
	PRINTFORML %CALLNAME:ARG%은(는) \@ TALENT:ARG:恋慕 ? 바쁘게 # 준비하는 동안 당신을 생각한다 \@ %ADD_BANQUET_TERM(CFLAG:ARG:BANQUET)%에.
ELSEIF CFLAG:ARG:職種 == 50
	PRINTFORML %CALLNAME:ARG%은(는) \@ TALENT:ARG:恋慕 ? 당신을 생각하며 # 조용히 하고 있다 \@ %ADD_BANQUET_TERM(CFLAG:ARG:BANQUET_CLEANUP)%를 정리하는 중이다.
ELSEIF CFLAG:ARG:職種 == 46
	PRINTFORML %CALLNAME:ARG%은(는) %COND_STR(@", occasionally glancing at you", TALENT:ARG:恋慕)%로 연기한다.
ELSEIF CFLAG:ARG:職種 == 52
	SELECTCASE ARG
		;こっから女子会　※後々キャラ毎に個性持たせたいので分岐だけ作っておく
		CASE 4
			PRINTFORML %CALLNAME:ARG%은(는) 다른 소녀들과 시끄럽게 수다를 떨고 있다.
		CASE 26
			PRINTFORML %CALLNAME:ARG%은(는) 다른 여자들과 시끄럽게 수다를 떨고 있다.
		CASE 32
			PRINTFORML %CALLNAME:ARG%은(는) 다른 여자아이들과 시끄럽게 수다를 떨고 있다.
		CASE 55
			PRINTFORML %CALLNAME:ARG%는 다른 여자들과 시끄럽게 대화하고 있다.
		CASE 66
			PRINTFORML %CALLNAME:ARG%은(는) 다른 여자들과 큰 소리로 잡담하고 있다.
		CASE 72
			PRINTFORML %CALLNAME:ARG%은(는) 다른 소녀들과 시끄럽게 떠든다.
		CASE 102
			PRINTFORML %CALLNAME:ARG%은(는) 다른 여자아이들과 시끄럽게 수다를 떨고 있다.
		CASE 124
			PRINTFORML %CALLNAME:ARG%은(는) 다른 여자들과 시끄럽게 수다를 떨고 있다.
	ENDSELECT
	;女子会ここまで
ELSE
	SELECTCASE ARG
		CASE 30
			;custom code
			IF CFLAG:ARG:職種 == JOB_会話 ;exclude meeting with Hecatia
				PRINTFORML %CALLNAME:ARG%은(는) 여기에 %GET_JOBNAME_TR(ARG)%이다.
			ELSEIF INRANGE(TIME, CLOCK_TO_TIME(9, 0), CLOCK_TO_TIME(11, 59))
				PRINTFORML %CALLNAME:ARG%은/는 %GET_JOBNAME_TR(ARG)%을 조용히 한다.
			ELSEIF INRANGE(TIME, CLOCK_TO_TIME(12, 0), CLOCK_TO_TIME(12, 59))
				PRINTFORML %CALLNAME:ARG%은(는) %GET_JOBNAME_TR(ARG)%이다.
			ELSE
				PRINTFORML %CALLNAME:ARG%은(는) %GET_JOBNAME_TR(ARG)%하게 무심하다.
			ENDIF
		CASE 54
			PRINTFORML %CALLNAME:ARG%는 %HIS_HER(ARG)% 책에서 고개를 들지 않는다...
		CASE 57
			PRINTFORML %CALLNAME:ARG%는 %GET_JOBNAME_TR(ARG)%하게 느긋하다.
		CASE 67
			IF TIME >= 720 && TIME <= 780
				PRINTFORML %CALLNAME:ARG%은(는) \@ TALENT:ARG:恋慕 ? 당신에 대해 생각하며 # 있다 \@ 아이들과 함께 %GET_JOBNAME_TR(ARG)%을 하면서.
			ELSE
				PRINTFORML %CALLNAME:ARG%은(는) \@ TALENT:ARG:恋慕 ? 당신을 생각하며 # 이다 \@ %GET_JOBNAME_TR(ARG)%로.
			ENDIF
		CASE 70
			IF DAY % 7 == 3 || DAY % 7 == 4
				PRINTFORML %CALLNAME:ARG%은(는) %GET_JOBNAME_TR(ARG)%인 동안 책을 읽고 있다.
			ELSE
				PRINTFORML %CALLNAME:ARG%은(는) 내용물을 주의 깊게 살피며 %GET_JOBNAME_TR(ARG)%이다.
			ENDIF
		CASEELSE
			IF CFLAG:MASTER:現在位置 != CFLAG:ARG:現在位置
				PRINTFORML 당신은 %CALLNAME:ARG% %GET_JOBNAME_TR(ARG)% %AT_IN_ON(CFLAG:ARG:現在位置)%을 볼 수 있다.
			ELSE
				PRINTFORML %CALLNAME:ARG%은(는) 여기 있다 %GET_JOBNAME_TR(ARG)%로.
			ENDIF
	ENDSELECT
ENDIF
;return job description without printing it, customize it for plurality

@JOB_DEPICTION_STR(ARG, CHARACTERS, PLURAL)
#FUNCTIONS
#DIMS CHARACTERS
#DIM  PLURAL
IF CFLAG:ARG:職種 == 48
	SIF PLURAL
		RETURNF @"%CHARACTERS%은(는) \@ TALENT:ARG:恋慕 ? 당신을 생각하며 # 바쁘게 준비하고 있다 \@ %ADD_BANQUET_TERM(CFLAG:ARG:BANQUET)%를."
	RETURNF @"%CHARACTERS% \@ TALENT:ARG:恋慕 ? 너를 생각한다. # 은 바쁘게 준비하고 있다. \@ ...을 준비하며 %ADD_BANQUET_TERM(CFLAG:ARG:BANQUET)%."
ELSEIF CFLAG:ARG:職種 == 50
	SIF PLURAL
		RETURNF @"%CHARACTERS%은(는) \@ TALENT:ARG:恋慕 ? 당신을 생각하며 # 조용히 청소하고 있다 \@ %ADD_BANQUET_TERM(CFLAG:ARG:BANQUET_CLEANUP)%를."
	RETURNF @"%CHARACTERS%은(는) \@ TALENT:ARG:恋慕 ? 당신을 생각하며 # 조용히 %ADD_BANQUET_TERM(CFLAG:ARG:BANQUET_CLEANUP)%를 치우고 있다 \@."
ELSEIF CFLAG:ARG:職種 == 46
	RETURNF @"%CHARACTERS% \@ PLURAL ? %"play"% # %"plays"% \@\@ TALENT:ARG:恋慕 ? 가끔 너를 흘긋 본다. #  \@."
ELSEIF CFLAG:ARG:職種 == 52
	;this guy is never going to actually complete this. simplifying it.
	RETURNF @"%CHARACTERS%들은 서로 시끄럽게 수다를 떨고 있다."
ELSE
	SELECTCASE ARG
		;all but CASEELSE is unique to a single character, don't need plurals
		CASE 30
			IF INRANGE(TIME, CLOCK_TO_TIME(9, 0), CLOCK_TO_TIME(11, 59))
				RETURNF @"%CHARACTERS%는 조용히 %GET_JOBNAME_TR(ARG)%를 한다."
			ELSEIF INRANGE(TIME, CLOCK_TO_TIME(12, 0), CLOCK_TO_TIME(12, 59))
				RETURNF @"%CHARACTERS%는 %GET_JOBNAME_TR(ARG)%이다."
			ELSE
				RETURNF @"%CHARACTERS%는 %GET_JOBNAME_TR(ARG)%를 무심하게 한다."
			ENDIF
		CASE 54
			RETURNF @"%CHARACTERS%는 %HIS_HER(ARG)%의 책에서 고개를 들지 않는다."
		CASE 57
			RETURNF @"%CHARACTERS%는 %GET_JOBNAME_TR(ARG)%하게 여유롭다."
		CASE 67
			IF TIME >= 720 && TIME <= 780
				RETURNF @"%CHARACTERS% \@ TALENT:ARG:恋慕 ? 는 당신을 생각하고 있다 # 그는/그녀는 \@ %GET_JOBNAME_TR(ARG)% 아이들과 함께"
			ELSE
				RETURNF @"%CHARACTERS%는 \@ TALENT:ARG:恋慕 ? 당신을 생각하며 # (하고 있다) \@ %GET_JOBNAME_TR(ARG)%로서."
			ENDIF
		CASE 70
			IF DAY % 7 == 3 || DAY % 7 == 4
				RETURNF @"%CHARACTERS%는 %GET_JOBNAME_TR(ARG)%를 하면서 책을 읽고 있다."
			ELSE
				RETURNF @"%CHARACTERS%는 내용을 주의 깊게 살피며 %GET_JOBNAME_TR(ARG)% 상태이다."
			ENDIF
		CASEELSE
			IF CFLAG:MASTER:現在位置 != CFLAG:ARG:現在位置
				RETURNF @"당신은 %CHARACTERS%, %GET_JOBNAME_TR(ARG)%, %AT_IN_ON(CFLAG:ARG:現在位置)%를 볼 수 있다."
			ELSE
				RETURNF @"%CHARACTERS%는(은) \@ PLURAL ? 여기에 있다 # 여기 있다 \@ %GET_JOBNAME_TR(ARG)%가."
			ENDIF
	ENDSELECT
ENDIF
