		ELSEIF STRLENS(DISH_COMMENT) ;return untranslated
			RETURNF DISH_COMMENT
		ELSE
			;If there's no comment it just prints the name twice for some reason
			LOCALS = %DISHNAME_TR(DISH_NAME)%
		ENDIF
ENDSELECT
RETURNF LOCALS

