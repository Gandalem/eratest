; Modular ERB: Virgin_Process.ERB
;lets you pick like "50% futa"

@CCREATE_RANDOMIZE
#DIM VIRGIN_PERC
#DIM NON_VIRGIN_PERC
#DIM CLUELESS_PERC
#DIM KNOW_PERC
#DIM SLUT_PERC
#DIM INCHLING_PERC
#DIM FAIRY_PERC
#DIM LOLI_PERC
#DIM NORMAL_PERC
#DIM TALL_PERC
#DIM FUTA_PERC
#DIM CREDRAW
#DIM FIRST_LINE
#DIM CHARA_ID
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
DRAWLINE
PRINTL 카테고리와 퍼센트를 선택한다. 퍼센트는 분할된다.
PRINTL 만약 너가 처녀와 비처녀 둘 다 0%로 설정하면, 캐릭터는 기본 순결 상태로 시작한다.
PRINTL 카테고리와 비율을 선택한다. 비율은 분할된다.
PRINTL 　
PRINTFORML [ 0] - %"처녀·동정",12,LEFT% {VIRGIN_PERC}％
PRINTFORML [ 1] - %"경험 있음",12,LEFT% {NON_VIRGIN_PERC}％
PRINTL ----
PRINTFORML [ 2] - %"성 지식 없음",12,LEFT% {CLUELESS_PERC}％
PRINTFORML [ 3] - %"성 지식 있음",12,LEFT% {KNOW_PERC}％
PRINTFORML [ 4] - %"음란함",12,LEFT% {SLUT_PERC}％
PRINTL ----
PRINTFORML [ 5] - %"소인",12,LEFT% {INCHLING_PERC}％
PRINTFORML [ 6] - %"요정",12,LEFT% {FAIRY_PERC}％
PRINTFORML [ 7] - %"어린 체형",12,LEFT% {LOLI_PERC}％
PRINTFORML [ 8] - %"보통 체형",12,LEFT% {NORMAL_PERC}％
PRINTFORML [ 9] - %"큰 체형",12,LEFT% {TALL_PERC}％
PRINTL ----
PRINTFORML [10] - %"후타나리",12,LEFT% {FUTA_PERC}％
DRAWLINE
PRINTL [100] - 적용 및 완료
$INPUT_LOOP
INPUT
SELECTCASE RESULT
	CASE 0 TO 10
		LOCAL = RESULT
		PRINTL 퍼센트 삽입:
		INPUT
		IF !INRANGE(RESULT, 0, 100)
			PRINTW 잘못된 입력
			GOTO REPRINT
		ENDIF
		SELECTCASE LOCAL
			CASE 0
				IF RESULT+NON_VIRGIN_PERC > 100
					PRINTW 처녀와 비처녀의 합은 100퍼센트를 초과할 수 없다.
					GOTO REPRINT
				ENDIF
				VIRGIN_PERC = RESULT
			CASE 1
				IF RESULT+VIRGIN_PERC > 100
					PRINTW 처녀와 비처녀의 합은 100퍼센트를 초과할 수 없다.
					GOTO REPRINT
				ENDIF
				NON_VIRGIN_PERC = RESULT
			CASE 2
				IF RESULT+KNOW_PERC+SLUT_PERC > 100
					PRINTW 무지함과 지식, 그리고 걸레의 합은 100%를 넘을 수 없다.
					GOTO REPRINT
				ENDIF
				CLUELESS_PERC = RESULT
			CASE 3
				IF CLUELESS_PERC+RESULT+SLUT_PERC > 100
					PRINTW 무지한 자와 지적인 자, 그리고 걸레의 합은 100%를 넘을 수 없다.
					GOTO REPRINT
				ENDIF
				KNOW_PERC = RESULT
			CASE 4
				IF CLUELESS_PERC+KNOW_PERC+RESULT > 100
					PRINTW 무지와 지식과 창녀의 합은 100%를 넘을 수 없다.
					GOTO REPRINT
				ENDIF
				SLUT_PERC = RESULT
			CASE 5
				IF RESULT+FAIRY_PERC+LOLI_PERC+NORMAL_PERC+TALL_PERC > 100
					PRINTW 인클링, 요정, 로리, 일반, 그리고 키 큰 것의 합은 100%를 초과할 수 없다.
					GOTO REPRINT
				ENDIF
				INCHLING_PERC = RESULT
			CASE 6
				IF INCHLING_PERC+RESULT+LOLI_PERC+NORMAL_PERC+TALL_PERC > 100
					PRINTW 인클링, 요정, 로리, 노멀, 그리고 탈의 합은 100%를 넘을 수 없다.
					GOTO REPRINT
				ENDIF
				FAIRY_PERC = RESULT
			CASE 7
				IF INCHLING_PERC+FAIRY_PERC+RESULT+NORMAL_PERC+TALL_PERC > 100
					PRINTW 인클링, 요정, 로리, 노멀, 그리고 탈의 합은 100%를 넘을 수 없다.
					GOTO REPRINT
				ENDIF
				LOLI_PERC = RESULT
			CASE 8
				IF INCHLING_PERC+FAIRY_PERC+LOLI_PERC+RESULT+TALL_PERC > 100
					PRINTW 인클링, 요정, 로리, 일반 및 키 큰 것의 합은 100%를 넘을 수 없다.
					GOTO REPRINT
				ENDIF
				NORMAL_PERC = RESULT
			CASE 9
				IF INCHLING_PERC+FAIRY_PERC+LOLI_PERC+NORMAL_PERC+RESULT > 100
					PRINTW 인클링, 요정, 로리, 일반, 그리고 키 큰 것들의 합은 100퍼센트를 넘을 수 없다.
					GOTO REPRINT
				ENDIF
				TALL_PERC = RESULT
			CASE 10
				IF RESULT > 100
					PRINTW 100% 후타는 가질 수 없어, 미안해.
					GOTO REPRINT
				ENDIF
				FUTA_PERC = RESULT
		ENDSELECT
	CASE 100
		FOR CHARA_ID, 1, CHARANUM
		LOCAL = RAND:100+1
		IF LOCAL <= VIRGIN_PERC
			TALENT:CHARA_ID:処女 = 1
		ELSEIF LOCAL <= VIRGIN_PERC+NON_VIRGIN_PERC
			TALENT:CHARA_ID:処女 = 0
		ELSE
			TALENT:CHARA_ID:処女 = CSVTALENT(NO:CHARA_ID,0)
		ENDIF
		LOCAL = RAND:100+1
		IF LOCAL <= CLUELESS_PERC
			EXP:CHARA_ID:Ｃ経験 = 0
			EXP:CHARA_ID:Ｂ経験 = 0
			EXP:CHARA_ID:Ｖ経験 = 0
			EXP:CHARA_ID:Ａ経験 = 0
			ABL:CHARA_ID:Ｖ感覚 = 0
			ABL:CHARA_ID:Ａ感覚 = 0
			EXP:CHARA_ID:Ｖ性交経験 = 0
			EXP:CHARA_ID:Ｖ拡張経験 = 0
			EXP:CHARA_ID:Ａ性交経験 = 0
			EXP:CHARA_ID:Ａ拡張経験 = 0
			EXP:CHARA_ID:手淫経験 = 0
			EXP:CHARA_ID:口淫経験 = 0
			EXP:CHARA_ID:パイズリ経験 = 0
			EXP:CHARA_ID:キス経験 = 0
			EXP:CHARA_ID:奉仕快楽経験 = 0
			EXP:CHARA_ID:愛情経験 = 0
			EXP:CHARA_ID:苦痛快楽経験 = 0
			EXP:CHARA_ID:嗜虐快楽経験 = 0
			EXP:CHARA_ID:露出快楽経験 = 0
			EXP:CHARA_ID:緊縛経験 = 0
			EXP:CHARA_ID:絶頂経験 = 0
			EXP:CHARA_ID:射精経験 = 0
			EXP:CHARA_ID:噴乳経験 = 0
			EXP:CHARA_ID:放尿経験 = 0
			EXP:CHARA_ID:精液経験 = 0
			EXP:CHARA_ID:精飲経験 = 0
			EXP:CHARA_ID:出産経験 = 0
			TALENT:CHARA_ID:ヤリマン = 0
			TALENT:CHARA_ID:SexKnow = -1
		ELSEIF LOCAL <= CLUELESS_PERC+KNOW_PERC
			CALL RESET_PARTS(CHARA_ID)
			EXP:CHARA_ID:Ｖ経験 = MAX(EXP:CHARA_ID:Ｖ経験, 50)
			ABL:CHARA_ID:Ｖ感覚 = MAX(ABL:CHARA_ID:Ｖ感覚, 2)
			ABL:CHARA_ID:腰 = MAX(ABL:CHARA_ID:腰, 2)
			EXP:CHARA_ID:Ｖ性交経験 = MAX(EXP:CHARA_ID:Ｖ経験, 50)
			EXP:CHARA_ID:Ｖ拡張経験 = MAX(EXP:CHARA_ID:Ｖ拡張経験, 3)
			EXP:CHARA_ID:精液経験 = MAX(EXP:CHARA_ID:精液経験, 10)
		ELSEIF LOCAL <= CLUELESS_PERC+KNOW_PERC+SLUT_PERC
			CALL RESET_PARTS(CHARA_ID)
			SIF TALENT:CHARA_ID:性別嗜好 == 1
				TALENT:CHARA_ID:性別嗜好 = 0
			EXP:CHARA_ID:Ｖ経験 = MAX(EXP:CHARA_ID:Ｖ経験, 100)
			ABL:CHARA_ID:Ｖ感覚 = MAX(ABL:CHARA_ID:Ｖ感覚, 3)
			ABL:CHARA_ID:腰 = MAX(ABL:CHARA_ID:腰, 3)
			ABL:CHARA_ID:欲望 = 3
			EXP:CHARA_ID:Ｖ性交経験 = MAX(EXP:CHARA_ID:Ｖ経験, 100)
			EXP:CHARA_ID:Ｖ拡張経験 = MAX(EXP:CHARA_ID:Ｖ拡張経験, 3)
			EXP:CHARA_ID:精液経験 = MAX(EXP:CHARA_ID:精液経験, 50)
			TALENT:CHARA_ID:ヤリマン = 1
			TALENT:CHARA_ID:貞操 = -1
		ELSE
			CALL RESET_PARTS(CHARA_ID)
		ENDIF
		LOCAL = RAND:100+1
		IF LOCAL <= INCHLING_PERC
			TALENT:CHARA_ID:体型 = -5
		ELSEIF LOCAL <= INCHLING_PERC+FAIRY_PERC
			TALENT:CHARA_ID:体型 = -2
		ELSEIF LOCAL <= INCHLING_PERC+FAIRY_PERC+LOLI_PERC
			TALENT:CHARA_ID:体型 = -1
		ELSEIF LOCAL <= INCHLING_PERC+FAIRY_PERC+LOLI_PERC+NORMAL_PERC
			TALENT:CHARA_ID:体型 = 0
		ELSEIF LOCAL <= INCHLING_PERC+FAIRY_PERC+LOLI_PERC+NORMAL_PERC+TALL_PERC
			TALENT:CHARA_ID:体型 = 1
		ELSE
			TALENT:CHARA_ID:体型 = CSVTALENT(NO:CHARA_ID,100)
		ENDIF
		LOCAL = RAND:100+1
		IF LOCAL <= FUTA_PERC
			CALLF FUTAME(CHARA_ID,RAND:6 + 1) ;Custom code, replaced.
		ELSE
			TALENT:CHARA_ID:2 = CSVTALENT(NO:CHARA_ID,2)
			TALENT:CHARA_ID:形状 = CSVTALENT(NO:CHARA_ID,250)
		ENDIF
		NEXT
		PRINTW 설정이 저장되었습니다.
		RETURN
ENDSELECT
GOTO REPRINT

