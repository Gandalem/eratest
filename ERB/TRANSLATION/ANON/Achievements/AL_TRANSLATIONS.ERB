;For use with BBASaikou and JP we need to have a translated list of category strings.
;This is to make it easier for other languages to use this system
@AL_CATEGORIES_TR(ARGS)
#FUNCTIONS
#DIMS DYNAMIC AL_LANGUAGE = "eng"

AL_LANGUAGE '= AL_DETECT_LANGUAGE()

SELECTCASE ARGS
CASE "All"
    SELECTCASE AL_LANGUAGE
    CASE "zh-Hant"
        RETURNF "全部"
    CASE "ja"
        RETURNF "全部"
    ENDSELECT
CASE "Favor"
    SELECTCASE AL_LANGUAGE
    CASE "zh-Hant"
        RETURNF "好感系"
    CASE "ja"
        RETURNF "好感"
    ENDSELECT
CASE "Collections"
    SELECTCASE AL_LANGUAGE
    CASE "zh-Hant"
        RETURNF "收集系"
    CASE "ja"
        RETURNF "コレクション"
    ENDSELECT
CASE "Fall States"
    SELECTCASE AL_LANGUAGE
    CASE "zh-Hant"
        RETURNF "陷落系"
    CASE "ja"
        RETURNF "陥落"
    ENDSELECT
CASE "Pregnancy"
    SELECTCASE AL_LANGUAGE
    CASE "zh-Hant"
        RETURNF "懷孕系"
    CASE "ja"
        RETURNF "孕ませ"
    ENDSELECT
CASE "Ability"
    SELECTCASE AL_LANGUAGE
    CASE "zh-Hant"
        RETURNF "能力系"
    CASE "ja"
        RETURNF "技能"
    ENDSELECT
CASE "Combat"
    SELECTCASE AL_LANGUAGE
    CASE "zh-Hant"
        RETURNF "彈幕系"
    CASE "ja"
        RETURNF "弾幕勝負"
    ENDSELECT
CASE "Other"
    SELECTCASE AL_LANGUAGE
    CASE "zh-Hant"
        RETURNF "其他"
    CASE "ja"
        RETURNF "他の系"
    ENDSELECT
ENDSELECT
RETURNF ARGS

;For translated names, descriptions, and bonuses, these use the DEF/ID.
@AL_ENTRY_NAME_TR(ARGS)
#FUNCTIONS
#DIMS DYNAMIC AL_LANGUAGE = "eng"

AL_LANGUAGE '= AL_DETECT_LANGUAGE()

SELECTCASE ARGS
CASE "meet10"
    SELECTCASE AL_LANGUAGE
    ; CASE "zh-Hant"
    ;     RETURNF "好感系"
    ; CASE "ja"
    ;     RETURNF "好感"
    ENDSELECT
ENDSELECT
DT_SELECT "achievements", @"defName = '%ARGS%'"
RETURNF DT_CELL_GETS("achievements", RESULT:1, "label", 1)

@AL_ENTRY_DESC_TR(ARGS)
#FUNCTIONS
#DIMS DYNAMIC AL_LANGUAGE = "eng"

AL_LANGUAGE '= AL_DETECT_LANGUAGE()

SELECTCASE ARGS
CASE "meet10"
    SELECTCASE AL_LANGUAGE
    ; CASE "zh-Hant"
    ;     RETURNF "好感系"
    CASE "ja"
        RETURNF "面識10人以上"
    ENDSELECT
CASE "insightTime"
    SELECTCASE AL_LANGUAGE
    CASE "eng"
        RETURNF @"Push down a character addicted to unconscious pleasure induced by TSP Rape%COND_STR(" (RAPE mark 3)", nSpoilerMode)%."
    ENDSELECT
CASE "impregnateAll"
    SELECTCASE AL_LANGUAGE
    CASE "eng"
        RETURNF @"Impregnate every race ({AL_PROG:Pregnancy}/{AL_PROG:PregnancyRacesAll}) and S-rank Speech ({ABL:MASTER:41}/{UniversalRank("S")}), Finger ({ABL:MASTER:50}/{UniversalRank("S")}), Tongue ({ABL:MASTER:51}/{UniversalRank("S")}), and Waist skill ({ABL:MASTER:53}/{UniversalRank("S")})."
    ENDSELECT
ENDSELECT
DT_SELECT "achievements", @"defName = '%ARGS%'"
RETURNF DT_CELL_GETS("achievements", RESULT:1, "requirement", 1)

