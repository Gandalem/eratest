;for dealing with eastern languages that do not have spaces
;we can simply change the strMatch parameter to use "." to match any character instead of "\s" which checks for whitespaces

@AL_LINEBREAK(strInput, nIndent = 0, strBreakLine = "\n", nLength = 0, strMatch = "\s")
#FUNCTIONS
#DIM nIndent
#DIM nLength
#DIMS strInput
#DIMS strBreakLine
#DIMS strMatch
#DIMS nMaking
SELECTCASE AL_DETECT_LANGUAGE()
	CASE "zh-Hant", "ja"
		;variant of breakeng.
		nMaking '= REPLACE(strInput, @"(.\{1,{(nLength/2)-1}\})(.|$)", "$1$2\n")
		;remove strBreakLine contents at the end
		RETURNF SUBSTRING(nMaking, 0, STRLENS(nMaking) - STRLENS(strBreakLine))
	CASEELSE
		;account for branches that still use eastern brackets
		;regex is dum dum and counts full-length characters the same as half-lengths.
		nLength -= STRCOUNT(strInput, "【")
		nLength -= STRCOUNT(strInput, "】")
		nLength -= STRCOUNT(strInput, "『")
		nLength -= STRCOUNT(strInput, "』")
		RETURNF BREAKENG(strInput, nIndent, strBreakLine, nLength, strMatch)
ENDSELECT
;spacing with escaped characters

@AL_SPACING(strInput,nLength,nOrientation="LEFT")
#FUNCTIONS
#DIM nLength
#DIMS strInput
#DIMS strEscaped
#DIMS nOrientation
strEscaped '= HTML_ESCAPE(strInput)
IF HTML_STRINGLEN(strEscaped) < nLength
	RETURNF strEscaped + @"%" "*(nLength-HTML_STRINGLEN(strEscaped))%"
ENDIF
RETURNF strEscaped
