;ARG:1 is to ignore global unlocks

@AchievementClaimed(ARGS,ARG:1=0)
#DIM AC_TABLE
RESULT:1 = 0
AC_TABLE = 0
;check if we had done it previously
DT_SELECT "saveAchievements", @"defName = '%ARGS%'"
AC_TABLE = RESULT:1
IF AC_TABLE
	IF DT_CELL_GET("saveAchievements", AC_TABLE, "claimed", 1)
		TRYCCALLFORM AL_ENTRY_INFO_%ARGS%
		CATCH
		RETURN 0
		ENDCATCH
		IF AL_ENTRY_INTS:Removable
			RETURN -2
		ELSE
			RETURN -999
		ENDIF
	ELSEIF DT_CELL_GET("saveAchievements", AC_TABLE, "completed", 1)
		RETURN DT_CELL_GET("saveAchievements", AC_TABLE, "completed", 1)
	ENDIF
ENDIF
;else check if it's currently obtainable
TRYCCALLFORM AL_ENTRY_INFO_%ARGS%
CATCH
RETURN 0
ENDCATCH
IF AL_ENTRY_INTS:Obtained
	;edit the DT entry else we create our own
	IF DT_SELECT("saveAchievements", @"defName = '%ARGS%'")
		DT_CELL_SET "saveAchievements", RESULT:1, "claimed", 1, 1
		DT_CELL_SET "saveAchievements", RESULT:1, "completed", 1, 1
	ELSE
		DT_ROW_ADD "saveAchievements", "defName",                       ARGS, "claimed",     AL_ENTRY_INTS:Obtained, "completed",                        1,
	ENDIF
	IF AL_ENTRY_INTS:Removable
		RETURN -1
	ELSE
		RETURN -999
	ENDIF
ELSEIF AL_ENTRY_INTS:Obtainable
	;edit the DT entry else we create our own
	IF DT_SELECT("saveAchievements", @"defName = '%ARGS%'")
		DT_CELL_SET "saveAchievements", RESULT:1, "completed", 1, 1
	ELSE
		DT_ROW_ADD "saveAchievements", "defName",                       ARGS, "claimed",     AL_ENTRY_INTS:Obtained, "completed",                        1,
	ENDIF
	RETURN AL_ENTRY_INTS:Obtainable
ENDIF
;then check globals
IF !ARG:1
	DT_SELECT "globalAchievements", @"defName = '%ARGS%'"
	IF RESULT:1
		IF DT_CELL_GET("globalAchievements", RESULT:1, "completed", 1)
			RETURN 1
		ENDIF
	ENDIF
ENDIF

