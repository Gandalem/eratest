;for giving unique talents
;ARG is in case there's other characters that get talents as well
;defName is the def of the achievement, used for validation.
;talentBit is the bit of the talent to change, set to -1 to be a toggle from 0 to 1
;valueSet sets the talent value when claimed and valueReSet does the same when unclaiming
;spoilerModeInfo is meant to give detailed info when in spoiler mode
;regularModeInfo is meant to give more vague notes about the talent
;customGainString and customLoseString are for custom strings when getting and losing the tlaent

@AL_GIVE_TALENT(ARG,defName,nTalentID,talentBit=-1,spoilerModeInfo,regularModeInfo,customGainString,customLoseString,valueSet=1,valueReSet=0)
#DIM  DYNAMIC nTalentID
#DIM  DYNAMIC nCurrentTable
#DIM  DYNAMIC talentBit
#DIM  DYNAMIC hasGottenTalent
#DIM  DYNAMIC valueSet
#DIM  DYNAMIC valueReSet
#DIMS DYNAMIC defName
#DIMS DYNAMIC spoilerModeInfo
#DIMS DYNAMIC regularModeInfo
#DIMS DYNAMIC customGainString
#DIMS DYNAMIC customLoseString
RESULT:1 = 0
nCurrentTable = 0
;using the claimed stat since the previous way was very unreliable
DT_SELECT "saveAchievements", @"defName = '%defName%'"
nCurrentTable = RESULT:1
IF !nCurrentTable
	PRINTFORMW 정의 "%defName%"에 대한 저장된 업적 항목이 없다.
	RETURN
ENDIF
IF DT_CELL_GET("saveAchievements", nCurrentTable, "claimed", 1)
	IF !INRANGE(talentBit,0,63)
		TALENT:ARG:nTalentID = valueSet
	ELSE
		SETBIT TALENT:ARG:nTalentID, talentBit
	ENDIF
ELSE
	IF !INRANGE(talentBit,0,63)
		TALENT:ARG:nTalentID = valueReSet
	ELSE
		CLEARBIT TALENT:ARG:nTalentID, talentBit
	ENDIF
ENDIF
IF !INRANGE(talentBit,0,63)
	hasGottenTalent = TALENT:MASTER:nTalentID
ELSE
	hasGottenTalent = GETBIT(TALENT:MASTER:nTalentID,talentBit)
ENDIF
IF hasGottenTalent
	;obtaining
	IF ARG == MASTER
		IF STRLENS(customGainString)
			PRINTFORML %customGainString%
		ELSE
			PRINTFORML %GET_TALENTNAME_TR(nTalentID,valueSet)%을 얻었다.
		ENDIF
	ELSE
		PRINTFORML %CALLNAME:ARG%은(는) %GET_TALENTNAME_TR(nTalentID,valueSet)%을 얻었다.
	ENDIF
	;if spoiler mode is on or there's nothing for regular mode
	IF STRLENS(spoilerModeInfo) && (nSpoilerMode || !STRLENS(regularModeInfo))
		PRINTFORML %spoilerModeInfo%
	ENDIF
	;if spoiler mode is off or there's nothing for spoiler mode
	IF STRLENS(regularModeInfo) && (!nSpoilerMode || !STRLENS(spoilerModeInfo))
		PRINTFORML %regularModeInfo%
	ENDIF
	WAIT
ELSE
	IF STRLENS(customGainString)
		PRINTFORMW %customLoseString%
	ELSE
		PRINTFORMW %GET_TALENTNAME_TR(nTalentID,1)%을/를 잃었다.
	ENDIF
ENDIF
