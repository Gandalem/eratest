ELSE
	ITEM:nItemID = 0
ENDIF
hasGottenItem = ITEM:nItemID
IF hasGottenItem
	;obtaining
	IF STRLENS(customGainString)
		PRINTFORML %customGainString%
	ELSE
		PRINTFORMW %ITEMNAME_TR(nItemID)%을 얻었다.
	ENDIF
	;if spoiler mode is on or there's nothing for regular mode
	IF STRLENS(spoilerModeInfo) && (nSpoilerMode || !STRLENS(regularModeInfo))
		PRINTFORML %spoilerModeInfo%
	ENDIF
	;if spoiler mode is off or there's nothing for spoiler mode
	IF STRLENS(regularModeInfo) && (!nSpoilerMode || !STRLENS(spoilerModeInfo))
		PRINTFORML %regularModeInfo%
	ENDIF
	WAIT
ELSE
	IF STRLENS(customGainString)
		PRINTFORMW %customLoseString%
	ELSE
		PRINTFORMW %ITEMNAME_TR(nItemID)%을/를 잃었다.
	ENDIF
ENDIF

@AL_GIVE_FLAG(defName,nFlagID,talentBit=-1,spoilerModeInfo,regularModeInfo,customGainString,customLoseString,valueSet=1,valueReSet=0)
#DIM  DYNAMIC nFlagID
#DIM  DYNAMIC nCurrentTable
#DIM  DYNAMIC talentBit
#DIM  DYNAMIC hasGottenTalent
#DIM  DYNAMIC valueSet
#DIM  DYNAMIC valueReSet
#DIMS DYNAMIC defName
#DIMS DYNAMIC spoilerModeInfo
#DIMS DYNAMIC regularModeInfo
#DIMS DYNAMIC customGainString
#DIMS DYNAMIC customLoseString
RESULT:1 = 0
nCurrentTable = 0
;using the claimed stat since the previous way was very unreliable
DT_SELECT "saveAchievements", @"defName = '%defName%'"
nCurrentTable = RESULT:1
IF !nCurrentTable
	PRINTFORMW def "%defName%"에 대한 저장된 업적 항목이 없다.
	RETURN
ENDIF
IF DT_CELL_GET("saveAchievements", nCurrentTable, "claimed", 1)
	IF !INRANGE(talentBit,0,63)
		FLAG:nFlagID = valueSet
	ELSE
		SETBIT FLAG:nFlagID, talentBit
	ENDIF
ELSE
	IF !INRANGE(talentBit,0,63)
		FLAG:nFlagID = valueReSet
	ELSE
		CLEARBIT FLAG:nFlagID, talentBit
	ENDIF
ENDIF
IF !INRANGE(talentBit,0,63)
	hasGottenTalent = FLAG:nFlagID
ELSE
	hasGottenTalent = GETBIT(FLAG:nFlagID,talentBit)
ENDIF
IF hasGottenTalent
	;obtaining
	PRINTFORML %customGainString%
	;if spoiler mode is on or there's nothing for regular mode
	IF STRLENS(spoilerModeInfo) && (nSpoilerMode || !STRLENS(regularModeInfo))
		PRINTFORML %spoilerModeInfo%
	ENDIF
	;if spoiler mode is off or there's nothing for spoiler mode
	IF STRLENS(regularModeInfo) && (!nSpoilerMode || !STRLENS(spoilerModeInfo))
		PRINTFORML %regularModeInfo%
	ENDIF
	WAIT
ELSE
	PRINTFORMW %customLoseString%
ENDIF
