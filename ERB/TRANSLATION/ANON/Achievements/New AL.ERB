; Modular ERB: ANON/Achievements/New AL.ERB
;Create the achievement list.

@AL_LIST
#DIM               AL_LINECOUNT
#DIMS DYNAMIC      AL_CATEGORIES,15                ;A list of all available categories
#DIM               AL_CURRENT_CATEGORY             ;Current achievement category
#DIM               AL_ENTRIES,1000                 ;Achievement entries
#DIMS              AL_ROWS,100                     ;Achievement entry rows
#DIM               AL_COUNT                        ;Achievement entry count
#DIM               AL_COMPLETE                     ;Achievements completed count
#DIM               AL_HIT                          ;Result of the input
#DIM               AL_ROW_MAX                      ;Maximum rows per page
#DIM               AL_COL_MAX                      ;Maximum columns per page
#DIM               AL_ENT_MAX                      ;Maximum entries per page
#DIM DYNAMIC       GET_LIST = 1                    ;When set to 1, recreates the achievement list
#DIM               NOW_GROUP = 1                   ;Current achievement page
#DIM               LAST_GROUP                      ;Last page of the list
#DIM               AL_CURRENT                      ;Current entry in the page.
#DIM               AL_CURRENT_FIND                 ;Current entry in the page, used for FINDELEMENT
#DIM               CRedraw                         ;Current Redraw
#DIMS              AL_STR                          ;String that's being built
#DIM               AL_CURRENT_ROW                  ;Current row that's being built
#DIMS DYNAMIC      AL_SEARCHING                    ;Searching string, looks for the search query in requirements and in names
#DIMS DYNAMIC      AL_XML, 2                       ;Importing global achievements from an XML file.
;set up maximum achievements per row
AL_ROW_MAX = (CLIENTHEIGHT()/GETCONFIG("LINE HEIGHT")-10)/8
AL_COL_MAX = CLIENTWIDTH()/GETCONFIG("FONT SIZE")/(AL_BUTTON_LENGTH+2+7*(GETCONFIG("Line Height"))/GETCONFIG("Font Size"))
AL_ENT_MAX = AL_ROW_MAX*AL_COL_MAX
CALL AL_CATEGORIES(AL_CATEGORIES)
;release and recreate global achievements
DT_RELEASE "globalAchievements"
CALL MakeAchievementList(1)
DT_TOXML @"globalAchievements", AL_XML:0
AL_XML:1 '= LOADTEXT(@"sav/globalAchievements.xml")
DT_FROMXML @"globalAchievements", AL_XML:0, AL_XML:1
AL_LINECOUNT = LINECOUNT
CRedraw = CURRENTREDRAW()
DO
CLEARLINE LINECOUNT-AL_LINECOUNT
REDRAW 0
IF GET_LIST
	CALL AL_MAKE_LIST(AL_ENTRIES, AL_COUNT, AL_CATEGORIES:AL_CURRENT_CATEGORY,AL_COMPLETE,AL_CATEGORIES,AL_SEARCHING)
	GET_LIST = 0
ENDIF
;make the list here
AL_CURRENT_ROW = 0
LOCAL:1 = 0
VARSET AL_ROWS
LAST_GROUP = 1 + (AL_COUNT - 1) / AL_ENT_MAX
FOR AL_CURRENT, (NOW_GROUP - 1) * AL_ENT_MAX, NOW_GROUP * AL_ENT_MAX
IF DT_CELL_GET("achievements", AL_ENTRIES:AL_CURRENT, "id", 1)
	AL_ROWS:AL_CURRENT_ROW += @"{AL_ENTRIES:AL_CURRENT}/"
ELSE
	CONTINUE
ENDIF
LOCAL:1++
;when current count is equal to column max we make a new row
IF LOCAL:1 >= AL_COL_MAX
	LOCAL:1 = 0
	AL_CURRENT_ROW++
ENDIF
NEXT
CUSTOMDRAWLINE ━
SETCOLOR C_AQUA
FONTBOLD
PRINTFORML ★업적★
FONTREGULAR
RESETCOLOR
PRINTFORM {AL_COMPLETE}/{AL_COUNT} 완료 ({AL_COMPLETE*100/MAX(AL_COUNT,1)}\%)
PRINTBUTTON " [모두 주장하기]", -500
PRINTBUTTON " [전체]", -600
PRINTL
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
FOR LOCAL,0,VARSIZE("AL_CATEGORIES")
SIF !STRLENS(AL_CATEGORIES:LOCAL)
	CONTINUE
SIF AL_CURRENT_CATEGORY == LOCAL
	SETCOLOR C_AQUA
PRINTBUTTON @"[%AL_CATEGORIES_TR(AL_CATEGORIES:LOCAL)%]", 8000+LOCAL
RESETCOLOR
NEXT
PRINTL
SETCOLOR C_GRAY
CUSTOMDRAWLINE ━
RESETCOLOR
;PRINTBUTTON "[Claim Filtered]", -501
;PRINTL
FOR AL_CURRENT_ROW,0,AL_ROW_MAX
FOR LOCAL,0,8
IF AL_CURRENT_ROW || LOCAL
	VARSET AL_STR
ELSE
	;AL_STR = <br>
	AL_STR = <button value='-501'>[Claim Filtered]</button>
	IF STRLENS(AL_SEARCHING)
		AL_STR += @"<font color='#66FFFF'><button value='-502'>[검색 중: %AL_SEARCHING%]</button></font><font color='#FFA500'><button value='-503'>[검색 초기화]</button></font>"
	ELSE
		AL_STR += @"<button value='-502'>[검색]</button>"
	ENDIF
	AL_STR += @"<br>"
ENDIF
FOR AL_CURRENT, 0, STRCOUNT(AL_ROWS:AL_CURRENT_ROW,"/")
VARSET AL_ENTRY_INTS
LOCAL:2 = TOINT(SPLIT_SINGLE(AL_ROWS:AL_CURRENT_ROW,AL_CURRENT,"/"))
AL_CURRENT_FIND = FINDELEMENT(AL_ENTRIES,LOCAL:2)
SIF !DT_CELL_GET("achievements", LOCAL:2, "id", 1)
	CONTINUE
CALL AL_ENTRY(AL_CURRENT_FIND, AL_ENTRIES, AL_ROW_MAX, AL_COL_MAX, AL_STR, LOCAL,LOCAL:2)
NEXT
SIF STRLENS(AL_STR)
	HTML_PRINT AL_STR
NEXT
IF !STRLENS(AL_STR)
	HTML_PRINT "<br>"*(7+(AL_CURRENT_ROW==0))
ENDIF
NEXT
IF LAST_GROUP == 1
	SETCOLOR 0x606060
	PRINTFORM 이전 페이지
	RESETCOLOR
ELSE
	PRINTBUTTON @"이전 페이지", -888
ENDIF
PRINTFORM %CENTER(@"페이지 {NOW_GROUP}/{LAST_GROUP}",15)%
IF LAST_GROUP == 1
	SETCOLOR 0x606060
	PRINTFORM 다음 페이지
	RESETCOLOR
ELSE
	PRINTBUTTON @"다음 페이지", -222
ENDIF
PRINTL
CUSTOMDRAWLINE ━
PRINTBUTTON "[반환]", -9999
INPUT
AL_HIT = RESULT
SELECTCASE AL_HIT
	CASE 8000 TO 8000+VARSIZE("AL_CATEGORIES")
		;change filters
		AL_CURRENT_CATEGORY = RESULT-8000
		GET_LIST = 1
		NOW_GROUP = 1
	CASE -222, -888
		;page
		SIF LAST_GROUP == 1
			CONTINUE
		NOW_GROUP = PAGE_HANDLE(RESULT, -888, NOW_GROUP, 1, LAST_GROUP)
	CASE -9999
		RETURN
	CASE -500
		;claim all
		FOR LOCAL,0,DT_ROW_LENGTH("achievements")
		CALL ClaimAchievement(DT_CELL_GET("achievements", LOCAL, "id"),1)
		NEXT
		GET_LIST = 1
	CASE -501
		;claim only shown
		FOR LOCAL,0,AL_COUNT
		CALL ClaimAchievement(AL_ENTRIES:LOCAL,1)
		NEXT
		GET_LIST = 1
	CASE -502
		PRINTFORML 검색어를 입력하라
		PRINTBUTTON "[취소]", ""
		PRINTL
		INPUTS
		AL_SEARCHING '= RESULTS
		GET_LIST = 1
	CASE -503
		VARSET AL_SEARCHING
		GET_LIST = 1
	CASE -600
		;global
		PRINTFORML [100] 보존하기
		PRINTFORML [200] 초기화하기
		PRINTFORML [999] 취소하기
		INPUT
		SELECTCASE RESULT
			CASE 100
				PRINTFORML 이 세이브의 현재 업적 진행 상황을 글로벌 세이브로 복사하시겠습니까?
				PRINTFORML 이 세이브에서 완료된 모든 업적은 어떤 세이브에서도 수령할 수 있습니다.
				CALL ASK_YN
				IF !RESULT
					CALL CopyAchievementListToGlobal
					PRINTFORMW 완료했다.
				ENDIF
			CASE 200
				PRINTFORML 전역 저장 데이터의 모든 도전과제 진행 상황을 초기화하시겠습니까.
				PRINTFORML ※현재 저장된 상태는 영향을 받을 수도 있고 받지 않을 수도 있습니다.
				PRINTFORML 계속하시겠습니까?
				CALL ASK_YN
				IF !RESULT
					DT_RELEASE "globalAchievements"
					SAVETEXT "", @"sav/globalAchievements.xml"
					PRINTFORMW 완료.
				ENDIF
			CASEELSE
		ENDSELECT
	CASE IS >= 6000000000000
		CLEARLINE 1
		CALL ClaimAchievement(AL_HIT)
		GET_LIST = 1
ENDSELECT
LOOP 1

@ClaimAchievement(AL_HIT, ARG:1)
#DIM AL_HIT
#DIMS AL_DEF
#DIM AL_ENT_ID
AL_DEF '= DT_CELL_GETS("achievements", AL_HIT, "defName", 1)
CALL AchievementClaimed(AL_DEF,0)
LOCAL = RESULT
SELECTCASE ARG:1
	CASE 0
		SIF GROUPMATCH(LOCAL,0,-999)
			RETURN
	CASE 1
		SIF LOCAL != 1
			RETURN
ENDSELECT
SIF ARG:1
	PRINTFORMSL AL_CLAIMING_ACHIVEMENT_TR(DT_CELL_GETS("achievements", AL_HIT, "defName", 1))
;edit the DT entry else we create our own
IF DT_SELECT("saveAchievements", @"defName = '%AL_DEF%'")
	AL_ENT_ID = RESULT:1
	;set a reclaim flag instead of going back to front
	SIF DT_CELL_GET("saveAchievements", AL_ENT_ID, "claimed", 1)
		DT_CELL_SET "saveAchievements", AL_ENT_ID, "completed", -1, 1
	DT_CELL_SET "saveAchievements", AL_ENT_ID, "claimed", !DT_CELL_GET("saveAchievements", AL_ENT_ID, "claimed", 1), 1
ELSE
	DT_ROW_ADD "saveAchievements", "defName",              AL_DEF, "claimed",                   1, "completed",                 1,
ENDIF
TRYCCALLFORM AL_ENTRY_TOGGLE_%AL_DEF%
CATCH
SETCOLOR C_RED
PRINTL
PRINTFORML %"-"*89%
PRINTFORML 성취에 defName [%AL_DEF%]은 보너스 기능이 없다!
PRINTFORML !REPORT THIS!
PRINTFORML %"-"*89%
RESETCOLOR
FORCEWAIT
RETURN
ENDCATCH

@AL_ENTRY(ARG, AL_ENTRIES, AL_ROW_MAX, AL_COL_MAX, AL_STR, AL_SEQUENCE, AL_ACHIEVE)
#DIM AL_ROW_MAX
#DIM AL_COL_MAX
#DIM REF AL_ENTRIES
#DIMS REF AL_STR
#DIM AL_IMG_ID
#DIM AL_SEQUENCE
#DIMS AL_DESC
#DIM AL_ACHIEVE
#DIM AL_NUM_IN_PAGE
#DIM COL_FIRST
#DIM COL_LAST
#DIM COL_MIDDLE
#DIM ROW_FIRST
#DIM ROW_LAST
#DIM ROW_MIDDLE
#DIM AL_WIDTH_MAX
#DIM AL_IMAGE_EXIST
#DIM AL_IMAGE_SPACING
#DIMS AL_COLORS
#DIMS AL_BONUS
#DIM AL_CAN_CLAIM
;here we check the positions of the
AL_NUM_IN_PAGE = ARG%((AL_ROW_MAX*AL_COL_MAX))
COL_FIRST = AL_NUM_IN_PAGE%AL_COL_MAX == 0
COL_LAST = AL_NUM_IN_PAGE%AL_COL_MAX == AL_COL_MAX-1 || AL_ENTRIES:(ARG+1) == 0
COL_MIDDLE = !COL_FIRST && !COL_LAST
ROW_FIRST = AL_NUM_IN_PAGE/AL_COL_MAX == 0
ROW_LAST = AL_NUM_IN_PAGE/AL_COL_MAX == AL_ROW_MAX-1 || AL_ENTRIES:(ARG+AL_COL_MAX) == 0
AL_IMAGE_EXIST = EXISTFILE(@"RESOURCES/%DT_CELL_GETS("achievements", AL_ACHIEVE, "icon", 1)%") && STRLENS(DT_CELL_GETS("achievements", AL_ACHIEVE, "icon", 1))
;on 16 size and height we can fit a 96x96 image
;       - this would be 6
;on a 16 size and 20 height we can fit a 112x112 image
;       - this would be 7
AL_IMAGE_SPACING = AL_BUTTON_IMAGE_SIZE*(GETCONFIG("Line Height"))/GETCONFIG("Font Size")
AL_WIDTH_MAX = ((GETCONFIG("FONT SIZE")*AL_BUTTON_LENGTH))
SIF !AL_IMAGE_EXIST
	AL_WIDTH_MAX += (GETCONFIG("FONT SIZE")*AL_IMAGE_SPACING)
AL_WIDTH_MAX = (AL_WIDTH_MAX/(GETCONFIG("FONT SIZE")/2))
RESETCOLOR
IF AL_SEQUENCE == 5 || AL_SEQUENCE == 6
	AL_BONUS '= AL_ENTRY_BONUS_TR(DT_CELL_GETS("achievements", AL_ACHIEVE, "defName", 1))
	CALL AchievementClaimed(DT_CELL_GETS("achievements", AL_ACHIEVE, "defName", 1),0)
	AL_CAN_CLAIM = RESULT
	SELECTCASE AL_CAN_CLAIM
		CASE 1
			AL_COLORS '= TOSTR(C_AQUA,"X6")
			AL_BONUS '= @"CLAIM: %AL_BONUS%"
		CASE -1
			AL_COLORS '= TOSTR(C_P_BLUE,"X6")
			AL_BONUS '= @"회수: %AL_BONUS%"
		CASE -2
			AL_COLORS '= TOSTR(C_P_BLUE,"X6")
			AL_BONUS '= @"클레임 해제: %AL_BONUS%"
		CASE -999
			AL_COLORS '= "202020"
			AL_BONUS '= @"완료됨: %AL_BONUS%"
		CASEELSE
			AL_COLORS '= "858585"
	ENDSELECT
	AL_BONUS '= AL_LINEBREAK(AL_BONUS,,"<tempbr>",AL_WIDTH_MAX)
ELSEIF AL_SEQUENCE == 2 || AL_SEQUENCE == 3 || AL_SEQUENCE == 4
	TRYCCALLFORM AL_ENTRY_INFO_%DT_CELL_GETS("achievements", AL_ACHIEVE, "defName", 1)%
	CATCH
	ENDCATCH
	AL_DESC '= AL_ENTRY_DESC_TR(DT_CELL_GETS("achievements", AL_ACHIEVE, "defName", 1))
	SIF AL_ENTRY_INTS:Progress || AL_ENTRY_INTS:ProgressMax
		AL_DESC += @" ({AL_ENTRY_INTS:Progress}/{AL_ENTRY_INTS:ProgressMax})"
	AL_DESC '= AL_LINEBREAK(AL_DESC,,"<tempbr>",AL_WIDTH_MAX)
ENDIF
SELECTCASE AL_SEQUENCE
	CASE 0
		;first line
		IF COL_FIRST && ROW_FIRST
			AL_STR += "┌"
		ELSEIF ROW_FIRST
			AL_STR += "┬"
		ENDIF
		SIF ROW_FIRST
			AL_STR += @"%"─"*(AL_BUTTON_LENGTH+AL_IMAGE_SPACING)%"
		IF ROW_FIRST && COL_LAST
			AL_STR += @"┐"
		ENDIF
	CASE 1
		;second line
		SIF COL_FIRST
			AL_STR += "│"
		;icon
		;if icon does not exist we give the
		IF AL_IMAGE_EXIST
			AL_IMG_ID = RAND(2000000,20000000)
			LOCALS '= @"iconTest{AL_IMG_ID}"
			GCREATEFROMFILE AL_IMG_ID, @"%DT_CELL_GETS("achievements", AL_ACHIEVE, "icon", 1)%"
			SPRITECREATE LOCALS, AL_IMG_ID
			AL_STR += @"<img src='%LOCALS%' height='{(GETCONFIG("FONT SIZE")*AL_IMAGE_SPACING)}px' width='{(GETCONFIG("FONT SIZE")*AL_IMAGE_SPACING)}px' ypos='0px'>"
		ENDIF
		AL_STR += @"%AL_SPACING(AL_ENTRY_NAME_TR(DT_CELL_GETS("achievements", AL_ACHIEVE, "defName", 1)),AL_WIDTH_MAX,"LEFT")%"
		AL_STR += @"│"
	CASE 2
		SIF COL_FIRST
			AL_STR += "│"
		SIF AL_IMAGE_EXIST
			AL_STR += @"<shape type='space' param='{(GETCONFIG("FONT SIZE")*AL_IMAGE_SPACING)}px'>"
		AL_STR += @"<font color='#858585'>%AL_SPACING(SPLIT_SINGLE(AL_DESC,0,"<tempbr>"),AL_WIDTH_MAX,"LEFT")%</font>"
		AL_STR += @"│"
	CASE 3
		SIF COL_FIRST
			AL_STR += "│"
		SIF AL_IMAGE_EXIST
			AL_STR += @"<shape type='space' param='{(GETCONFIG("FONT SIZE")*AL_IMAGE_SPACING)}px'>"
		AL_STR += @"<font color='#858585'>%AL_SPACING(SPLIT_SINGLE(AL_DESC,1,"<tempbr>"),AL_WIDTH_MAX,"LEFT")%</font>"
		AL_STR += @"│"
	CASE 4
		SIF COL_FIRST
			AL_STR += "│"
		SIF AL_IMAGE_EXIST
			AL_STR += @"<shape type='space' param='{(GETCONFIG("FONT SIZE")*AL_IMAGE_SPACING)}px'>"
		AL_STR += @"<font color='#858585'>%AL_SPACING(SPLIT_SINGLE(AL_DESC,2,"<tempbr>"),AL_WIDTH_MAX,"LEFT")%</font>"
		AL_STR += @"│"
	CASE 5
		SIF COL_FIRST
			AL_STR += "│"
		SIF AL_IMAGE_EXIST
			AL_STR += @"<shape type='space' param='{(GETCONFIG("FONT SIZE")*AL_IMAGE_SPACING)}px'>"
		SIF AL_CAN_CLAIM > 0 || GROUPMATCH(AL_CAN_CLAIM,-1,-2)
			AL_STR += @"<button value='{AL_ACHIEVE}'>"
		AL_STR += @"<font color='#%AL_COLORS%'>"
		IF STRLENS(SPLIT_SINGLE(AL_BONUS,1,"<tempbr>"))
			AL_STR += @"%AL_SPACING((SPLIT_SINGLE(AL_BONUS,0,"<tempbr>")),AL_WIDTH_MAX,"LEFT")%"
		ELSE
			AL_STR += @"<shape type='space' param='{(GETCONFIG("FONT SIZE")*AL_BUTTON_LENGTH)}px'>"
			SIF !AL_IMAGE_EXIST
				AL_STR += @"<shape type='space' param='{(GETCONFIG("FONT SIZE")*AL_IMAGE_SPACING)}px'>"
		ENDIF
		AL_STR += @"</font>"
		SIF AL_CAN_CLAIM > 0 || GROUPMATCH(AL_CAN_CLAIM,-1,-2)
			AL_STR += @"</button>"
		AL_STR += @"│"
	CASE 6
		SIF COL_FIRST
			AL_STR += "│"
		SIF AL_IMAGE_EXIST
			AL_STR += @"<shape type='space' param='{(GETCONFIG("FONT SIZE")*AL_IMAGE_SPACING)}px'>"
		SIF AL_CAN_CLAIM > 0 || GROUPMATCH(AL_CAN_CLAIM,-1,-2)
			AL_STR += @"<button value='{AL_ACHIEVE}'>"
		AL_STR += @"<font color='#%AL_COLORS%'>"
		IF STRLENS(SPLIT_SINGLE(AL_BONUS,1,"<tempbr>"))
			AL_STR += @"%AL_SPACING(SPLIT_SINGLE(AL_BONUS,1,"<tempbr>"),AL_WIDTH_MAX,"LEFT")%"
		ELSE
			AL_STR += @"%AL_SPACING(SPLIT_SINGLE(AL_BONUS,0,"<tempbr>"),AL_WIDTH_MAX,"LEFT")%"
		ENDIF
		AL_STR += @"</font>"
		SIF AL_CAN_CLAIM > 0 || GROUPMATCH(AL_CAN_CLAIM,-1,-2)
			AL_STR += @"</button>"
		AL_STR += @"│"
	CASE 7
		;last line
		IF COL_FIRST && ROW_LAST
			AL_STR += "└"
		ELSEIF COL_FIRST
			AL_STR += "├"
		ELSEIF ROW_LAST && (AL_ENTRIES:(ARG+AL_COL_MAX-1) == 0 || (ARG+AL_COL_MAX-1)/((AL_ROW_MAX*AL_COL_MAX)) != ARG/((AL_ROW_MAX*AL_COL_MAX)))
			AL_STR += "┸"
		ELSE
			AL_STR += "╂"
		ENDIF
		AL_STR += @"%"─"*(AL_BUTTON_LENGTH+AL_IMAGE_SPACING)%"
		IF ROW_LAST && (COL_LAST||AL_ENTRIES:(ARG+1) == 0)
			AL_STR += @"┘"
		ELSEIF COL_LAST
			AL_STR += "┤"
		ENDIF
ENDSELECT
;Edit the category list to categories you have in your respective branch
;Keep in mind that base tags are in English. Translations are done in `@AL_CATEGORIES_TR`

@AL_CATEGORIES(AL_CATEGORIES)
#DIMS REF AL_CATEGORIES
AL_CATEGORIES '= "All", "Social", "Sexual", "Fall States", "Collections", "Combat", "Character/Story", "Excretion", "Legend of Gensokyo", "Other"
;Function to detect game language using multiple signs
;Ideally the best way to do it is to check for a variable like BBAS_VERSION which is only present in BBASaikou

@AL_DETECT_LANGUAGE()
#FUNCTIONS
#DIMS DYNAMIC AL_LANGUAGE = "eng"
IF EXISTVAR("BBAS_VERSION")
	AL_LANGUAGE '= "zh-Hant"
ELSEIF GAMEBASE_TITLE == "eraThe World" && GAMEBASE_INFO == "※画像が表示されない場合はreadmeを確認しリソースを導入してください"
	AL_LANGUAGE '= "ja"
ELSE
	AL_LANGUAGE '= "eng"
ENDIF
RETURNF AL_LANGUAGE

@AL_MAKE_LIST(AL_ENTRIES, AL_COUNT, AL_CATEGORY_MATCH, AL_COMPLETE, AL_CATEGORIES, AL_SEARCHING)
#DIM REF AL_ENTRIES
#DIM REF AL_COUNT
#DIM REF AL_COMPLETE
#DIMS REF AL_CATEGORIES
#DIMS REF AL_SEARCHING
#DIMS AL_CATEGORY_MATCH
VARSET AL_ENTRIES
VARSET AL_COUNT
VARSET AL_COMPLETE
VARSET AL_PROG
FOR LOCAL, 0, DT_ROW_LENGTH("achievements")
VARSET AL_ENTRY_INTS
SIF !DT_CELL_GET("achievements", LOCAL, "id")
	CONTINUE
SELECTCASE AL_CATEGORY_MATCH
	CASE "All"
	CASE "Other"
		SIF FINDELEMENT(AL_CATEGORIES,DT_CELL_GETS("achievements", LOCAL, "category")) != -1 && DT_CELL_GETS("achievements", LOCAL, "category") != "Other"
			CONTINUE
	CASEELSE
		SIF DT_CELL_GETS("achievements", LOCAL, "category") != AL_CATEGORY_MATCH
			CONTINUE
ENDSELECT
;searching
IF STRLENS(AL_SEARCHING)
	SIF STRFIND(TOLOWER(AL_ENTRY_NAME_TR(DT_CELL_GETS("achievements", LOCAL, "defName"))),TOLOWER(AL_SEARCHING)) == -1 && STRFIND(TOLOWER(AL_ENTRY_DESC_TR(DT_CELL_GETS("achievements", LOCAL, "defName"))),TOLOWER(AL_SEARCHING)) == -1
		CONTINUE
ENDIF
CALL AchievementClaimed(DT_CELL_GETS("achievements", LOCAL, "defName"))
IF RESULT
	AL_COMPLETE++
ELSEIF AL_ENTRY_INTS:Hidden
	CONTINUE
ENDIF
AL_ENTRIES:AL_COUNT = DT_CELL_GET("achievements", LOCAL, "id")
AL_COUNT ++
NEXT
;sort by completed, claimed, and whatever
LOCAL:0 = 1
WHILE LOCAL:0 < AL_COUNT
SIF !(LOCAL:0)
	LOCAL:0 ++
CALL AchievementClaimed(DT_CELL_GETS("achievements", AL_ENTRIES:(LOCAL:0 - 1), "defName", 1))
LOCAL:1 = RESULT
CALL AchievementClaimed(DT_CELL_GETS("achievements", AL_ENTRIES:(LOCAL:0), "defName", 1))
LOCAL:2 = RESULT
IF LOCAL:1 >= LOCAL:2
	LOCAL:0 ++
ELSE
	SWAP AL_ENTRIES:(LOCAL:0 - 1), AL_ENTRIES:(LOCAL:0)
	LOCAL:0 --
ENDIF
WEND
;make achievement lists

@MakeAchievementList(ARG)
#DIMS nTableName
IF ARG
	nTableName '= "globalAchievements"
ELSE
	nTableName '= "saveAchievements"
ENDIF
DT_CREATE nTableName
DT_COLUMN_ADD nTableName, "defName"
SIF !ARG
	DT_COLUMN_ADD nTableName, "claimed", "int16"
DT_COLUMN_ADD nTableName, "completed", "int16"

@MakeAchievementListTemp()
DT_RELEASE "achievements"
CALL MakeAchievementListModular("achievements")
CALL MakeAchievementList(0)
CALL MakeAchievementList(1)
CALL AL_ENTRY_MAKE
CALL AL_ENTRY_MAKE_NAS
SIF !AL_LEGACY_PROS
	CALL VerifyLegacyAchievements

@MakeAchievementListModular(ARGS="achievements")
#DIMS nTableName
nTableName '= ARGS
DT_CREATE nTableName
DT_COLUMN_ADD nTableName, "defName"
DT_COLUMN_ADD nTableName, "label"
DT_COLUMN_ADD nTableName, "requirement"
DT_COLUMN_ADD nTableName, "bonus"
DT_COLUMN_ADD nTableName, "icon"
DT_COLUMN_ADD nTableName, "category"

@CopyAchievementListToGlobal()
#DIM CAL_NUM
#DIM CAL_AC
#DIM CAL_MAX
#DIM CAL_ID
#DIMS CAL_DEF
#DIMS CAL_XML, 2
;copying to global
DT_RELEASE "globalAchievements"
