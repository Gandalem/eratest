[SKIPSTART]
;Template

;defName    : Internal definition of the achievement
;label      : Name of the achievement
;requirement: Requirement for the achievement
;bonus      : Bonus description
;icon       : Achievement icon. This ideally is a 1:1 ratio image
;category   : Category the achievement is in

;Insert this in AL_ENTRY_MAKE
{
DT_ROW_ADD @"achievements",
"defName",      @"Meet10", ;
"label",        @"Nice to Meet You!",
"requirement",  @"Meet 10 People",
"bonus",        @"%金額表示(5000)%",
"icon",         @"Achievements/%AL_ENTRY_STRS:Def%.webp",
"category",     "Meeting",
}

@AL_ENTRY_INFO_Meet10
AL_ENTRY_INTS:Obtained            = 0 ;Check if the bonus has been claimed
AL_ENTRY_INTS:Obtainable          = CONDITION_面識ボーナス(0) ; Check if the achievement is complete
AL_ENTRY_INTS:Removable           = 0 ;If the bonus can be removed
AL_ENTRY_INTS:Hidden              = 0 ;If the achievement is hidden. 0 for always visible, 1 to only show when completed

@AL_ENTRY_TOGGLE_Template
CALL GET_MONEY_YEN(5000,2)

;=====================================================
[SKIPEND]

