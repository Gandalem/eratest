; Modular ERB: ANON/SpoilerMode.ERB
;-------------------------------
;Custom config section for new player handholding
;-------------------------------

@CUSTOM_OPTION_309
PRINTFORML [309] - 스포일러 모드(전체): \@ nSpoilerMode ? 예 # 아니오 \@

@CUSTOM_OPTION_RESULT_309
SIF benchMarkStart
	RETURN
SIF DevTest && ゲーム開始処理中
	RETURN
LOADGLOBAL
SETCOLOR C_YELLOW
PRINTFORML "스포일러 모드" 정보
RESETCOLOR
PRINTFORML "스포일러 모드"는 불분명한 정보가 플레이어에게 더 명시적으로 표시되게 만든다.
PRINTFORML 여기에는 떨어지는 데 필요한 캐릭터, 숨겨진 재능, 그리고 더 상세한 정보가 필요한 다른 사용 사례들이 포함될 수 있다.
PRINTFORML 하지만 이것은 스스로 발견하는 것의 재미를 망칠 수도 있다.
PRINTFORML 정말로 길을 잃었을 때만 활성화할 것을 권장한다.
SIF ゲーム開始処理中
	PRINTFORML 모드 기능 설정에서 켜거나 끌 수 있다.
IF nSpoilerMode
	PRINTFORML 활성화했을 때 변경 사항 목록:
	PRINTFORML - 일부 숨겨진 재능이 이제 낙하 조건 메뉴에 표시된다.
	PRINTFORML - 주기 시각화가 항상 활성화된다.
	PRINTFORML - 아이템을 제작할 수 없을 경우 제작 요구 사항을 표시한다.
	PRINTFORML - 무언가를 할 권한이 없을 경우 떨어지는 데 필요한 캐릭터들이 목록에 나타난다.
	PRINTFORML - 일일 말일 임신 상태가 이제 표시된다.
	PRINTFORML - 현재 자궁 부피가 표시되며, 최대 부피와 가득 차면 노란색으로 변경된다.
	PRINTFORML - 명령어가 위험 수준별로 정렬된다. 
	PRINTFORML      흰색: 실행해도 안전함
	PRINTFORML      노란색: 신체적 또는 관계상 해를 끼칠 수 있음.
	PRINTFORML      주황색: 신체적 또는 관계상 해를 끼침.
	PRINTFORML      빨간색: 심각한 신체적 또는 관계상 해를 끼치며, 치명적일 수 있음.
	PRINTFORML      진한 빨간색: 동방을 죽이거나 적대적으로 만들 것이다.
ENDIF
$REINPUT
CALL ASK_M( @"스포일러 모드를 켠다", 1, @"스포일러 모드를 꺼라",1, )
nSpoilerMode = !RESULT
SAVEGLOBAL
;max cum amounts

@CHARA_MAX_CUM(ARG)
#FUNCTION
SELECTCASE TALENT:ARG:体型
	CASE -5
		RETURNF 300
	CASE -4 TO -2
		RETURNF 600
	CASE -1
		RETURNF 1000
	CASE 0
		RETURNF 1200
	CASE IS > 0
		RETURNF 1500
ENDSELECT
;for uterus cums

@NPG_CUMS(ARG)
IF EX:ARG:子宮内精液 > 0
	SIF nSpoilerMode && 充填率(ARG,4) >= 100
		SETCOLOR C_YELLOW
	PRINTFORM  자궁 내 정액: %DIGIT_GROUP(EX:ARG:子宮内精液),5,LEFT%
	;new player guide custom code
	SIF nSpoilerMode
		PRINTFORM /{CHARA_MAX_CUM(ARG)/2,5,RIGHT}
	SIF nSpoilerMode && 充填率(ARG,4) >= 100
		PRINTFORM (FULL)
	RESETCOLOR
ENDIF
