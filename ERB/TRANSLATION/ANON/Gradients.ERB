;ENDPOINT: colors at the start and end (HEX)
;PERCENTAGE_POINT: percentage through the gradient
;CHANGE_ASPECTS: What aspects are changed throughout the gradient
;	Bit 0: Hue
;	Bit 1: Saturation
;	Bit 2: Value
;OPOSING_WAY: Makes the gradient go the opposing way.
;Example:
	;TOSTR(Color_Gradient_PER(0xfffa00,0x01688f,100),"X6")
	;this should result in 01688F
@Color_Gradient_PER(ENDPOINT:0,ENDPOINT:1,PERCENTAGE_POINT,CHANGE_ASPECTS = 7,OPOSING_WAY = 0)
#FUNCTION
#DIM ENDPOINT,2
#DIM HUE,2
#DIM SATURATION,2
#DIM VALUE,2
#DIM FINAL_RESULT,3
#DIM PERCENTAGE_POINT
#DIM DIFFERENCE
#DIM change_Aspects
#DIM CONST HALF_VALUE = 128
#DIM OPOSING_WAY

;grab HSV values
FOR LOCAL,0,VARSIZE("endpoint")
	HUE:LOCAL        = RGB_TO_H(ENDPOINT:LOCAL)
	SATURATION:LOCAL = RGB_TO_S(ENDPOINT:LOCAL)
	VALUE:LOCAL		 = RGB_TO_V(ENDPOINT:LOCAL)
NEXT

;saturation correction
FOR LOCAL,0,VARSIZE("endpoint")
	SIF !SATURATION:LOCAL
		HUE:LOCAL = HUE:(!(LOCAL))
NEXT


FOR LOCAL,0,3

	SELECTCASE LOCAL
	CASE 0
		X:0	= HUE:0
		X:1 = HUE:1
	CASE 1
		X:0	= SATURATION:0
		X:1 = SATURATION:1
	CASE 2
		X:0	= VALUE:0
		X:1 = VALUE:1
	ENDSELECT
	;H,S, or V only
	IF !GETBIT(CHANGE_ASPECTS,LOCAL)
		;we set values to their starting ones above
		FINAL_RESULT:LOCAL = X:0
		CONTINUE
	ENDIF

	DIFFERENCE = ABS(X:1-X:0)

	;color
	;HUE:2 = (HUE:0*100) + ((HUE:1-HUE:0)*PERCENTAGE_POINT)
	IF OPOSING_WAY
		;rotate the opposite way
		X:0 += HALF_VALUE
		X:1 += HALF_VALUE
		X:0 %= 256
		X:1 %= 256
	ENDIF
	FINAL_RESULT:LOCAL = (X:0*100) + ((X:1-X:0)*PERCENTAGE_POINT)
	FINAL_RESULT:LOCAL /= 100
	IF OPOSING_WAY
		FINAL_RESULT:LOCAL += HALF_VALUE
		FINAL_RESULT:LOCAL %= 256
	ENDIF
NEXT

RETURNF HSV_TO_RGB(FINAL_RESULT:0,FINAL_RESULT:1,FINAL_RESULT:2)