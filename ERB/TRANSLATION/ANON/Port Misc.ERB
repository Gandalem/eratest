;==========================================================================
; Add_STAMINA_BAR
; Revamped Stamina bar that shows the true stamina
; ARGS: ARG (Target, required), LENGTH, ARG:1 (extended)
;==========================================================================
@Add_STAMINA_BAR(ARG, LENGTH = 10, ARG:1)
#DIM LENGTH, 5
#DIM DYNAMIC RemoveInt
#DIMS DYNAMIC barColor
#DIM DYNAMIC RIAfter, 3

; IF BASE:ARG:0 < 500
; 	RemoveInt = 0
; ELSE
	RemoveInt = 500
;ENDIF
RIAfter:0 = MAX(BASE:ARG:0-RemoveInt,0)
RIAfter:1 = MAX(MAXBASE:ARG:0-RemoveInt,0)
RIAfter:2 = GETPERCENT(RIAfter:0, RIAfter:1)


;color set
IF CFLAG:ARG:睡眠 && ARG != MASTER && !CFLAG:MASTER:313
barColor = 水色
ELSE
barColor = 緑
ENDIF

;gradients
;will be implemented fully in a future PR
SIF RIAfter:2 < 50
	SETCOLOR Color_Gradient_PER(C_YELLOW,C_RED,100 - ((RIAfter:2-25)*4))
SIF RIAfter:2 < 25
	SETCOLOR Color_Gradient_PER(C_RED,C_D_RED,100 - (RIAfter:2*4))
;=============================
; SIF RIAfter:2 < 50
; 	SETCOLOR C_YELLOW
; SIF RIAfter:2 < 25
; 	SETCOLOR C_RED
; SIF BASE:ARG:0 < 500
; 	SETCOLOR C_D_RED

IF ARG:1 == 1
PRINTFORM %"STA", 4% 
ELSEIF ARG:1 == 2
ELSE
PRINTFORM %"Sta", 3%
ENDIF
RESETCOLOR
CALL PRINT_COLORBAR(BASE:ARG:0 - RemoveInt, MAXBASE:ARG:0 - RemoveInt, LENGTH, UNICODE(0x2585), UNICODE(0x2585), BARCOLORSET(barColor), RESULT:1)
IF ARG:1
;PRINTFORM  ({RIAfter:0,5}/{RIAfter:1,5} ({MAXBASE:ARG:0,5}))

PRINTFORM  (%PALAM_NUM_NAS(RIAfter:0),5%/%PALAM_NUM_NAS(RIAfter:1),5%)
;PRINTFORM  (%PALAM_NUM_NAS(RIAfter:0,1),5%/%PALAM_NUM_NAS(RIAfter:1,1),5%)
ELSE
PRINTFORM (%PALAM_NUM_NAS(RIAfter:0),5%)
ENDIF
RESETCOLOR

;==========================================================================
; #FUNCTION version of the Fisher-Yates Shuffle
; This one works like the non #FUNCTION version
;==========================================================================
@FISHER_YATES_SHUFFLE_F(ARG:0)
#FUNCTION
VARSET SHAFFLE_ARRAY , 0
;SHAFFLE_ARRAYの初期化
FOR LOCAL:0 , 0 , ARG:0
	SHAFFLE_ARRAY:(LOCAL:0) = LOCAL:0
NEXT

FOR LOCAL:0 , 0 , ARG:0 - 1
	LOCAL:1 = RAND(LOCAL:0 , ARG:0)
	SWAP SHAFFLE_ARRAY:(LOCAL:0), SHAFFLE_ARRAY:(LOCAL:1)
NEXT
;終端用に-1をセット
SHAFFLE_ARRAY:(ARG:0) = -1
RETURNF 0
