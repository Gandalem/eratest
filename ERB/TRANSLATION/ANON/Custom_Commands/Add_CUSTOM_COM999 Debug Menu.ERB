		NAME:TestChara '= NameChecker(TESTCHARA)
	ELSE
		NAME:TestChara '= CSVNAME(LOCAL)
	ENDIF
	PRINTFORMLC [{LOCAL,4}] - %NAME:TESTCHARA%
NEXT
CALL DELETE_CHARA(TESTCHARA)
PRINTL
PRINTFORML [-1] - Return
INPUT
SELECTCASE RESULT
CASE -1
	RETURN 1
CASEELSE
	CALL ADDCHARA_INIT(RESULT)
	CALL SetOmoStats(CHARANUM-1)
	CALLF HESOYAM(CHARANUM-1)
	CALLF TP(CHARANUM-1)
