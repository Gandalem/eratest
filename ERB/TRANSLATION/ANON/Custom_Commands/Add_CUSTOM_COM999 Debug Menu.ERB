		CONTINUE
	NO:TESTCHARA = LOCAL
	NameArray:TESTCHARA:na_Name =
	NameArray:TESTCHARA:na_FirstName =
	NameArray:TESTCHARA:na_LastName =
	NameArray:TESTCHARA:na_CallName '= CSVCALLNAME(LOCAL)
