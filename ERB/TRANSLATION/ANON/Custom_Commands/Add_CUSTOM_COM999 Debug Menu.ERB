GOTO REPRINT

@PRINT_CUSTOM_DEBUG(ARG, ARGS, ARGS:1, ARGS:2)
#DIMS DYNAMIC HTML
HTML =
IF ARGS != "" || ARGS:1 != ""
	IF ARGS:1 != ""
		SETCOLOR C_YELLOW
		HTML += HTML_PRINT_NAS(ARGS:1)
		RESETCOLOR
		IF ARGS == ""
			HTML_PRINT HTML
			RETURN
		ENDIF
		HTML += "<br>"
	ENDIF
	$BYPASS
	SIF ARGS != ""
		HTML += HTML_PRINT_NAS(@"[{ARG}] - %ARGS% ",,,,,ARG)
	IF ARG == 102 && ARGS == "(PantsGet)"
		HTML += HTML_COLOR(ARGS:2,TOSTR(C_GRAY,"X6"))
	ELSEIF ARGS:2 != ""
		SETCOLOR C_GRAY
		HTML += HTML_PRINT_NAS(ARGS:2)
		RESETCOLOR
	ENDIF
	HTML_PRINT HTML
ENDIF
