SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE 1
		GOTO RETRY
	CASE 2 TO VARSIZE("DISP_NAME")+2
		PAGE = RESULT-2
	CASE 画像切り替え
		IF !FLAG:画像表示
			FLAG:画像表示 = !FLAG:画像表示
			FLAG:立ち絵種類 = 0
		ELSEIF !FLAG:立ち絵種類
			FLAG:立ち絵種類 = !FLAG:立ち絵種類
		ELSEIF FLAG:立ち絵種類
			FLAG:画像表示 = !FLAG:画像表示
		ENDIF
	CASE 98
		;alt portraits
		SIF CFLAG:DEBUG_Target:別顔有 || CFLAG:DEBUG_Target:別立ち有
			CFLAG:DEBUG_Target:差し替え適用 += 1
		SIF (CFLAG:DEBUG_Target:差し替え適用 > CFLAG:DEBUG_Target:別顔有 && FLAG:立ち絵種類) || (CFLAG:DEBUG_Target:差し替え適用 > CFLAG:DEBUG_Target:別立ち有 && !FLAG:立ち絵種類) ;custom code
			CFLAG:DEBUG_Target:差し替え適用 = 0
	CASE 1000
		PRINTFORML 누구?
		DRAWLINE
		FOR LOCAL,0,CHARANUM
		PRINTFORMLC [{LOCAL}] %NAME:LOCAL%
		NEXT
		PRINTFORML
		DRAWLINE
		PRINTFORML [-53] 정지
		INPUT
		SELECTCASE RESULT
			CASE 0 TO CHARANUM
				DEBUG_Target = RESULT
		ENDSELECT
	CASE 1001
		DEBUG_Target = TARGET
	CASE 1002
		DEBUG_Target = MASTER
	CASE IS >= 100
		TRYCALLFORM DEBUG_MENU_RESULT_{PAGE}_{RESULT}
		SIF LOOP_BREAK == 1
			RETURN 0
