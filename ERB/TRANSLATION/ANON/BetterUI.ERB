@universalRank(nRANK)
#FUNCTION
#DIMS nRANK
#DIMS SubStr
#DIM DYNAMIC nRerun
SubStr '= SUBSTRING(nRANK, STRLENS(nRANK)-1, STRLENS(nRANK))
A = 0
IF SubStr == "+" || SubStr == "-"
	nRank '= SUBSTRING(nRANK, 0, STRLENS(nRANK)-1)
	IF SubStr == "+"
		A = 1
	ELSEIF SubStr == "-"
		A = -1
	ENDIF
ENDIF
