	PRINT 　
	CALL COLORMESSAGE(@"- 잃음", C_YELLOW, 1)
ELSEIF ARG == MASTER
	;you
	PRINT 　
	CALL COND_COLORMESSAGE(CFLAG:ARG:2 >= 500,@"{500} 호의(현재:{CFLAG:ARG:2})")
	PRINT 　
	CALL COND_COLORMESSAGE(CFLAG:ARG:4 >= 100,@"{100} 신뢰도 (현재: {CFLAG:ARG:4})")
	PRINT 　
	CALL COND_COLORMESSAGE(ABL:ARG:43 >= UniversalRank("C") ,@"{UniversalRank("C")} 지식 (현재:{ABL:ARG:43})")
	PRINT 　
	CALL COND_COLORMESSAGE(ABL:MASTER:43 >= UniversalRank("C") ,@"%조사처리(CALLNAME:MASTER,"의")% 지식 {UniversalRank("C")} (현재:{ABL:MASTER:43})")
ELSE
	;other touhou
	IF ABL:ARG:43 < MaxNonHLevel
		;for some ungodly reason you managed to get an ignorant Touhou to Extra knowledge and not teach her about sex
		PRINT 　
		CALL COND_COLORMESSAGE(ABL:ARG:43 >= UniversalRank("C") ,@"지식 {UniversalRank("C")} (현재:{ABL:ARG:43})")
		PRINT 　
		CALL COND_COLORMESSAGE(ABL:MASTER:43 >= MAX(UniversalRank("C"),ABL:ARG:43)+1,@"%조사처리(CALLNAME:MASTER,"의")% 지식 {MAX(UniversalRank("C"),ABL:ARG:43)+1} (현재:{ABL:MASTER:43})")
		PRINT 　
		CALL COND_COLORMESSAGE(0,@"도서관에 가서 에로틱한 책을 읽는다.")
		SETCOLOR C_AQUA
		PRINTL 　OR
		RESETCOLOR
	ENDIF
	PRINT 　
	CALL COND_COLORMESSAGE(IGR_TIMES >= IGR_MASTURB,@"자위경험이 {IGR_MASTURB}보다 크다 (현재:{IGR_TIMES})")
ENDIF
