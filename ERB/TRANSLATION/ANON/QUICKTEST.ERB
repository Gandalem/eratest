; Modular ERB: ANON/QUICKTEST.ERB

@OPTION_MOD_QUICKTEST
#DIM nLineCnt_Head
LOADGLOBAL
FOR LOCAL, 0, 100
PRINTL
NEXT
CUSTOMDRAWLINE ＊
PRINTFORML 빠른 테스트 옵션
CUSTOMDRAWLINE ＊
nLineCnt_Head = LINECOUNT
DevTest = 2
IF !DAY
	CALL ADD_ALL_CHARACTERS()
	CALL Name_Array_Set
ENDIF
REDRAW 0
DO
SIF LINECOUNT - nLineCnt_Head > 0
	CLEARLINE LINECOUNT - nLineCnt_Head
CALL CUSTOM_QUICKTEST_STATE
SELECTCASE RESULT
	CASE 0
		IF !DAY
			;delete characters when done
			DELALLCHARA
		ENDIF
		DevTest = 0
		SAVEGLOBAL
		RETURN
	CASEELSE
ENDSELECT
LOOP 1
;==========================================================================
;Quicktest State Menu Formatting
;==========================================================================

@CUSTOM_QUICKTEST_STATE(C_ID,OP)
#DIMS    OP         ;実行オプション
#DIM     C_ID       ;登録番号
#DIM     PAGE       ;表示中のページ
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
TRYCALLFORM QUICKTEST_MENU
DRAWLINE
PRINTFORML 
PRINTBUTTON "[0] 반환한다", 0
DO
INPUT
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE IS >= 100
		TRYCALLFORM CUSTOM_QUICKTEST_OPTION_RESULT_{RESULT}
	CASEELSE
		$RETRY
		REUSELASTLINE 잘못된 입력
		CONTINUE
ENDSELECT
BREAK
LOOP 1
GOTO REPRINT

@PRINT_QUICKTEST_MENU(ARG, ARGS, ARGS:1, ARGS:2)
IF ARGS != ""
	IF ARGS:1 != ""
		PRINTFORML
		SETCOLOR C_YELLOW
		PRINTFORML %ARGS:1%
		PRINTFORML
		RESETCOLOR
	ENDIF
	PRINTFORML [{ARG}] - %ARGS%
	IF ARGS:2 != ""
		SETCOLOR C_GRAY
		PRINTFORML %ARGS:2%
		RESETCOLOR
	ENDIF
ENDIF
;==========================================================================
;Quicktest Menu Options
;==========================================================================

@QUICKTEST_MENU
#DIMS QuicktestOptionHeader,1000
#DIMS QuicktestOptionName,1000
#DIMS QuicktestOptionDescription,1000
VARSET QuicktestOptionName
QuicktestOptionHeader:100 '= "Player Settings"
QuicktestOptionName:100 '= @"캐릭터 설정(ID 0 복사): %nameArray:DevTestOptions:na_Name%"
QuicktestOptionDescription:100 '= "개발자 테스트의 무작위 캐릭터 설정을 사용하지 않을 때 적용할 캐릭터입니다."
QuicktestOptionName:101 '= @"랜덤 캐릭터: \@ DevTestOptions:1 ? 예 # 아니요 \@"
QuicktestOptionDescription:101 '= "새 개발자 테스트 게임을 시작할 때 무작위 캐릭터가 됩니다."
QuicktestOptionName:102 '= @"TSP: \@ DevTestOptions:2 ? 예 # 아니오 \@"
QuicktestOptionDescription:102 '= "시간 정지 능력을 얻습니다(4000 TSP)."
QuicktestOptionName:104 '= @"항상 후타나리: \@ DevTestOptions:4 ? 예 # 아니오 \@"
QuicktestOptionDescription:104 '= "성별을 무시하고 캐릭터를 항상 후타나리로 설정합니다."
QuicktestOptionName:105 '= @"위치짐작: \@ DevTestOptions:5 ? 예 # 아니오 \@"
QuicktestOptionDescription:105 '= "전역에서 해금하지 않았어도 위치 감지 기능을 빠르게 사용합니다."
QuicktestOptionName:106 '= @"임시 호칭 사용: \@ DevTestOptions:6 ? 예 # 아니오 \@."
QuicktestOptionDescription:106 '= "캐릭터의 이름 대신 \%CALLNAME:MASTER\%으로 불립니다."
QuicktestOptionName:107 '= @"금단의지식: \@ DevTestOptions:7 ? 예 # 아니오 \@"
QuicktestOptionDescription:107 '= "특수 성인 콘텐츠를 바로 이용할 수 있습니다."
QuicktestOptionName:108 '= @"전투 능력: \@ DevTestOptions:10 != -1 ? 레벨 {DevTestOptions:10} # 상속한다 \@"
QuicktestOptionDescription:108 '= "캐릭터의 전투 능력을 지정한 값으로 덮어씁니다."
QuicktestOptionName:109 '= @"모든 아이템: \@ DevTestOptions:11 ? 예 # 아니오 \@"
QuicktestOptionDescription:109 '= "시작부터 모든 아이템을 보유합니다."
QuicktestOptionName:110 '= @"월경 주기 시각화 : \@ DevTestOptions:12 ? 예 # 아니오 \@"
QuicktestOptionDescription:110 '= "여성 캐릭터의 생리 주기를 시연합니다."
FOR LOCAL, 0, 1000
CALL PRINT_QUICKTEST_MENU(LOCAL, QuicktestOptionName:LOCAL, QuicktestOptionHeader:LOCAL, QuicktestOptionDescription:LOCAL)
NEXT
