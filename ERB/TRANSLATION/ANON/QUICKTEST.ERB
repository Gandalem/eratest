; Modular ERB: ANON/QUICKTEST.ERB

@OPTION_MOD_QUICKTEST
#DIM nLineCnt_Head
LOADGLOBAL
FOR LOCAL, 0, 100
PRINTL
NEXT
CUSTOMDRAWLINE ＊
PRINTFORML 빠른 테스트 옵션
CUSTOMDRAWLINE ＊
nLineCnt_Head = LINECOUNT
DevTest = 2
IF !DAY
	CALL ADD_ALL_CHARACTERS()
	CALL Name_Array_Set
ENDIF
REDRAW 0
DO
SIF LINECOUNT - nLineCnt_Head > 0
	CLEARLINE LINECOUNT - nLineCnt_Head
CALL CUSTOM_QUICKTEST_STATE
SELECTCASE RESULT
	CASE 0
		IF !DAY
			;delete characters when done
			DELALLCHARA
		ENDIF
		DevTest = 0
		SAVEGLOBAL
		RETURN
	CASEELSE
ENDSELECT
LOOP 1
;==========================================================================
;Quicktest State Menu Formatting
;==========================================================================

@CUSTOM_QUICKTEST_STATE(C_ID,OP)
#DIMS    OP         ;実行オプション
#DIM     C_ID       ;登録番号
#DIM     PAGE       ;表示中のページ
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
TRYCALLFORM QUICKTEST_MENU
DRAWLINE
PRINTFORML 
PRINTBUTTON "[0] 반환한다", 0
DO
INPUT
SELECTCASE RESULT
	CASE 0
		RETURN 0
	CASE IS >= 100
		TRYCALLFORM CUSTOM_QUICKTEST_OPTION_RESULT_{RESULT}
	CASEELSE
		$RETRY
		REUSELASTLINE Invalid Input
		CONTINUE
ENDSELECT
BREAK
LOOP 1
GOTO REPRINT

@PRINT_QUICKTEST_MENU(ARG, ARGS, ARGS:1, ARGS:2)
IF ARGS != ""
	IF ARGS:1 != ""
		PRINTFORML
		SETCOLOR C_YELLOW
		PRINTFORML %ARGS:1%
		PRINTFORML
		RESETCOLOR
	ENDIF
	PRINTFORML [{ARG}] - %ARGS%
	IF ARGS:2 != ""
		SETCOLOR C_GRAY
		PRINTFORML %ARGS:2%
		RESETCOLOR
	ENDIF
ENDIF
;==========================================================================
;Quicktest Menu Options
;==========================================================================

@QUICKTEST_MENU
#DIMS QuicktestOptionHeader,1000
#DIMS QuicktestOptionName,1000
#DIMS QuicktestOptionDescription,1000
VARSET QuicktestOptionName
QuicktestOptionHeader:100 '= "Player Settings"
QuicktestOptionName:100 '= @"캐릭터 설정(ID 0 복사): %nameArray:DevTestOptions:na_Name%"
QuicktestOptionDescription:100 '= "Character set if the dev test random character setting isn't enabled."
QuicktestOptionName:101 '= @"랜덤 캐릭터: \@ DevTestOptions:1 ? 예 # 아니요 \@"
QuicktestOptionDescription:101 '= "Become a random character when starting a new devtest game"
QuicktestOptionName:102 '= @"TSP: \@ DevTestOptions:2 ? 예 # 아니오 \@"
QuicktestOptionDescription:102 '= "Have timestop (4000 TSP)"
QuicktestOptionName:104 '= @"항상 Futa: \@ DevTestOptions:4 ? 예 # 아니오 \@"
QuicktestOptionDescription:104 '= "Ignore gender and always have the character be a futanari"
QuicktestOptionName:105 '= @"위치짐작: \@ DevTestOptions:5 ? 예 # 아니오 \@"
QuicktestOptionDescription:105 '= "Have quick access to Whereabouts Sense, even if it's not unlocked globally"
QuicktestOptionName:106 '= @"Placeholder Callname은(는) \@ DevTestOptions:6 ? 예 # 아니오 \@."
QuicktestOptionDescription:106 '= "Instead of the character's first name, you'll be called \%CALLNAME:MASTER\%"
QuicktestOptionName:107 '= @"금단의지식: \@ DevTestOptions:7 ? 예 # 아니오 \@"
QuicktestOptionDescription:107 '= "Get access to cool sex stuff"
QuicktestOptionName:108 '= @"전투 능력: \@ DevTestOptions:10 != -1 ? 레벨 {DevTestOptions:10} # 상속한다 \@"
QuicktestOptionDescription:108 '= "Override the character's combat abilities with a different value"
QuicktestOptionName:109 '= @"모든 아이템: \@ DevTestOptions:11 ? 예 # 아니오 \@"
QuicktestOptionDescription:109 '= "Have all items from the start"
QuicktestOptionName:110 '= @"월경 주기 시각화 : \@ DevTestOptions:12 ? 예 # 아니오 \@"
QuicktestOptionDescription:110 '= "Showcases the girl's menstrual cycles"
FOR LOCAL, 0, 1000
CALL PRINT_QUICKTEST_MENU(LOCAL, QuicktestOptionName:LOCAL, QuicktestOptionHeader:LOCAL, QuicktestOptionDescription:LOCAL)
NEXT
