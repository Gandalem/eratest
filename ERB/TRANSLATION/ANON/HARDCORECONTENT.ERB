; Modular ERB: ANON/HARDCORECONTENT.ERB
;for the hardcore content toggle, now its own file
;each use of this toggle can be found by looking for the words 'hardcore content toggle', the tags for said content following it
;example: ;hardcore content toggle, <NTR> <VIOLENCE>
;HardcoreContentOff BEING 1 MEANS CONTENT IS OFF
;-------------------------------

@HARDCORECONTENT_MENU
#DIM nLineCnt_Head
LOADGLOBAL
;CALL HARDCORE_CONTENT_DEFAULT() ;if first time seeing this, let's make sure that everything is really off by default
FOR LOCAL, 0, 100
PRINTL
NEXT
CUSTOMDRAWLINE -
PRINTFORML 논란의 여지가 있는 콘텐츠 토글 (전체)
PRINTFORML ※ 원치 않는 캐릭터 및 게임 이벤트를 활성화하거나 비활성화하기 위함이며, 기본값은 OFF이다.
PRINTFORML ※ NAS 참고: 이것은 가장 필수적인 설정만을 담고 있는 NAS 페티시 설정 메뉴의 매우 축약된 버전이다.
CUSTOMDRAWLINE -
nLineCnt_Head = LINECOUNT
REDRAW 0
DO
SIF LINECOUNT - nLineCnt_Head > 0
	CLEARLINE LINECOUNT - nLineCnt_Head
FOR LOCAL, 0, 10
TRYCALLFORM HARDCORECONTENT_OPTION_{LOCAL}
NEXT
CALL EQUATE_LINE, (nLineCnt_Head + 1) ;tweak when there's more options
DRAWLINE
PRINTFORML [999] - 반환
INPUT
SELECTCASE RESULT
	CASE 999
		SAVEGLOBAL
		RETURN
	CASEELSE
		TRYCALLFORM HARDCORECONTENT_RESULT_{RESULT}
ENDSELECT
LOOP 1
;-------------------------------

@HARDCORE_CONTENT_DEFAULT
;Ensures hardcore content is off by default.
IF !HardcoreContentPrompt
	HardcoreContentOff:0 = 1
	HardcoreContentOff:1 = 1
	HardcoreContentPrompt = 1
	SAVEGLOBAL
ENDIF
;-------------------------------
;NAS QUICK OPTIONS

