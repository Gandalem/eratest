@SatoMai_HARDCORECONTENTOFF(ARG) ;called in M_KOJO_K122_イベント.ERB and M_KOJO_K123_イベント.ERB
IF (HardcoreContentOff:0 || HardcoreContentOff:1) && TALENT:ARG:狂気 && CFLAG:ARG:1001 == -1
	PRINTFORML
	TALENT:ARG:狂気 = 0
	PRINTFORML %CALLNAME:ARG%의 논란이 되는 이벤트들을 비활성화한다...
ELSEIF !HardcoreContentOff && !TALENT:ARG:狂気 && CFLAG:ARG:1001 == -1
	PRINTFORML
	TALENT:ARG:狂気 = 1
	PRINTFORML %CALLNAME:ARG%의 논란이 되는 이벤트들을 다시 활성화한다...
ENDIF
