;Description
;----------------------------------------------------------
;Terror SOURCE processing
;Essentially this is what I thought Fear was meant to be
;----------------------------------------------------------
;Parameters
;----------------------------------------------------------
;ARG: Character
;==========================================================

@SOURCE_TERROR(ARG)
VARSET LOCAL
;inherit fear for terror
SOURCE:ARG:Terror += SOURCE:ARG:恐怖
SOURCE:ARG:Terror += SOURCE:ARG:苦痛
LOCAL = SOURCE:ARG:Terror
;相手主導
SIF ARG != MASTER && CFLAG:ARG:うふふ == 2
	TIMES LOCAL, 0.50
;================================
;ABILITIES
;================================
;LOCAL = ABL補正(LOCAL,ABL:ARG:従順,1); commented, this makes NO sense
IF TCVAR:ARG:無理矢理
	;rape
	;set a flat 8x multipler and ignore obedience.
	;also adds 150 terror PALAMs
	TIMES LOCAL , 8.00
	LOCAL += 150
	GOTO SKIP_OBED
ENDIF
