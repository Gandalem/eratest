	CASE IS >= 20
		TIMES LOCAL , 0.10
	CASE IS >= 10
		TIMES LOCAL , 0.30
	CASE 9
		TIMES LOCAL , 0.50
	CASE 8
		TIMES LOCAL , 1.00
	CASE 7
		TIMES LOCAL , 1.50
	CASE 6
		TIMES LOCAL , 2.00
	CASE 5
		TIMES LOCAL , 2.50
	CASE 4
		TIMES LOCAL , 3.00
	CASE 3
		TIMES LOCAL , 3.50
	CASE 2
		TIMES LOCAL , 4.00
	CASE 1
		TIMES LOCAL , 5.00
	CASEELSE
		TIMES LOCAL , 6.00
ENDSELECT
