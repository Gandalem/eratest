;==========================================================
;RapeStatesGet
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Message for getting rape route fall states
;----------------------------------------------------------
;Parameters
;----------------------------------------------------------
;ARG: Character ID
;==========================================================

@RapeStatesGet(ARG)
SIF !nRape
	RETURN
IF RapeState2Requirement(ARG)
	PRINTFORML 반복적으로 괴롭힘과 성폭력을 당한 후, %CALLNAME:ARG%의 정신이 무너졌다...
	IF EXISTVAR("NAS_VERSION")
		LOCALS '= @"【%GET_TALENTNAME_TR(TALENT_RAPE2,1)%】"
	ELSE
		LOCALS '= @"[%GET_TALENTNAME_TR(TALENT_RAPE2,1)%]"
	ENDIF
	CALL KOJO_MESSAGE_SEND("EVENT", 21, ARG, 21)
	PRINTFORML %CALLNAME:ARG%는 이제 %LOCALS%를 가지고 있다.
	TALENT:ARG:TALENT_RAPE1 = 0
	TALENT:ARG:TALENT_RAPE2 = 1
	CALL QoL_Info_Write(LOCAL, Qol_Dates_RapeState1) ;qol custom code
	MARK:ARG:3 = 0
	CALL COLORMESSAGE("모든 증오의 흔적이 지워졌다.",C_AQUA,2)
ELSEIF RapeState1Requirement(ARG)
	PRINTFORML 여러 차례의 강간 세션 끝에, %CALLNAME:ARG%는 조금 부서지고 있음을 느끼기 시작했다...
	IF EXISTVAR("NAS_VERSION")
		LOCALS '= @"【%GET_TALENTNAME_TR(TALENT_RAPE1,1)%】"
	ELSE
		LOCALS '= @"[%GET_TALENTNAME_TR(TALENT_RAPE1,1)%]"
	ENDIF
	CALL KOJO_MESSAGE_SEND("EVENT", 21, ARG, 20)
	PRINTFORML %CALLNAME:ARG%이 당신에게 %LOCALS%를 시작했다.
	TALENT:ARG:TALENT_RAPE1 = 1
	CALL QoL_Info_Write(LOCAL, Qol_Dates_RapeState1) ;qol custom code
ENDIF
