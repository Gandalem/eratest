;Submission: 20%
;Denial: 20%
;Shame: 10%
;----------------------------------------------------------
;Parameters
;----------------------------------------------------------
;ARG: Target
;==========================================================

@SOURCE_FORCE(ARG)
#FUNCTION
#DIM SF_SOURCE,5
SIF FLAG:70
	RETURNF 0
; SF_SOURCE:0 = CUP:ARG:Terror * 50/100
; SF_SOURCE:1 = CUP:ARG:屈服 * 20/100
; ;SF_SOURCE:2 = CUP:ARG:否定 * 20/100
; SF_SOURCE:2 = CUP:ARG:抑鬱 * 20/100
; SF_SOURCE:3 = CUP:ARG:恥情 * 10/100
;revised
SF_SOURCE:0 = CUP:ARG:Terror
SF_SOURCE:1 = CUP:ARG:屈服
;SF_SOURCE:2 = CUP:ARG:否定 * 20/100
SF_SOURCE:2 = CUP:ARG:抑鬱
SF_SOURCE:3 = CUP:ARG:恥情
SF_SOURCE:4 = SF_SOURCE:0 + SF_SOURCE:1 + SF_SOURCE:2 + SF_SOURCE:3
IF CFLAG:ARG:うふふ == 2
	TIMES SF_SOURCE:4, 0.2
ELSEIF !TCVAR:ARG:無理矢理 && CFLAG:ARG:うふふ
	TIMES SF_SOURCE:4, 0.3
ENDIF
RETURNF SF_SOURCE:4
