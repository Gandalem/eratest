@FALLEN_RAPE_TRACK_COUNT(ARG)
#FUNCTION
#DIM DYNAMIC FRTC = 0
FOR LOCAL,0,64
SIF GETBIT(FALL_RAPE:ARG:0,0)
	FRTC ++
NEXT
RETURNF FRTC
