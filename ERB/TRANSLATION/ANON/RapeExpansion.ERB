; Modular ERB: ANON/RapeExpansion.ERB
;==========================================================
;NAS_RapeOption
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Allows the player to forcefully push down the target without their consent.
;Requires the player to fail the consent check.
;Base Power is determined by twice their Danmaku skill (Melee in NAS), and half of their finger skill
;----------------------------------------------------------
;Parameters
;----------------------------------------------------------
;ARG: Target
;==========================================================

@NAS_RapeOption(ARG)
#DIM DIFFERENCE
;requires the rape toggle, capturing skill, and rope
IF !RAPE_CONDITION()
	GOTO NoRape
ENDIF
SETCOLOR C_RED
PRINTFORML %CALLNAME:ARG%을 강압적으로 밀어붙인다?
RESETCOLOR
PRINTFORML
PRINTFORML [  0] 괜찮다.
PRINTFORML [999] 여기서 날 나가게 해줘!
INPUT
SELECTCASE RESULT
	CASE 0
		IF MARK:ARG:MARK_FORCE
			GOTO GoRape
		ELSE
			PRINTFORML 어떻게 그걸 할 건데?
			;options
			;danmaku (no lethal because player is very likely to kill the touhou)
			;force push
			CALL ASK_M( "단막", 1, "힘으로 밀어붙인다", 1, "취소", 1 )
			SELECTCASE RESULT
				CASE 0
				CASE 1
					TCVAR:ARG:793 = 2*ABL:ARG:42 + (ABL:ARG:指)
					TCVAR:MASTER:793 = 2*ABL:MASTER:42 + (ABL:MASTER:指)
					CALL SHOW_POWERFAVOR(TCVAR:MASTER:793,MASTER)
					SIF TCVAR:MASTER:793
						CALL POWERBUFFS(MASTER)
					DRAWLINE
					CALL SHOW_POWERFAVOR(TCVAR:ARG:793,ARG)
					SIF TCVAR:ARG:793
						CALL POWERBUFFS(ARG)
					;Size difference
					SELECTCASE TALENT:MASTER:形状
						CASE 0,3,4
							LOCAL = 0
						CASE 1
							LOCAL = -2
						CASE 2
							LOCAL = -1
						CASE 6
							LOCAL = 1
						CASE 5,10
							LOCAL = 2
					ENDSELECT
					LOCAL:1 = ((TALENT:MASTER:体型 - TALENT:ARG:体型) * 2 + LOCAL)*4
					IF LOCAL:1
						TCVAR:MASTER:793 = TCVAR:MASTER:793 + LOCAL:1
						CALL COLORMESSAGE(@"크기 차이",C_PINK,1,1)
						CALL SHOW_POWERFAVOR(TCVAR:MASTER:793,MASTER)
					ENDIF
					DIFFERENCE = (TCVAR:MASTER:793-TCVAR:ARG:793)
					IF DIFFERENCE >= 0
						$GoRape
						PRINTFORMW 모든 당신의 힘으로, 당신은 %CALLNAME:ARG%를 아래로 밀어붙인다.
						TFLAG:194 = 0
						TCVAR:抱き寄せ初回 = 20
						CALL COM_KOJO_CALL(ARG, 350)
						CALL NAS_StartRape(ARG)
					ELSE
						TFLAG:押し倒せない ++
						RETURN -1
					ENDIF
				CASE 2
					GOTO NoRape
			ENDSELECT
		ENDIF
	CASEELSE
		$NoRape
		TFLAG:押し倒せない ++
		RETURN -1
ENDSELECT

@NAS_StartRape(ARG)
SOURCE:ARG:反感 += 20000
TFLAG:98 = -10
TCVAR:ARG:無理矢理 = 1
CFLAG:ARG:うふふ = 1
CFLAG:MASTER:うふふ = 1
TCVAR:ARG:抱き寄せ初回 = 20
SOURCE:ARG:Terror += 1000
;TEQUIP:ARG:拘束 = 1
TFLAG:押し倒せない = 0
CFLAG:ARG:ヤラせちゃった = 1
SETBIT FALL_RAPE:ARG:0,  0 ;custom code, rape expansion

@NAS_ResumeTimeInRape
#DIM DYNAMIC RTIR_VICTIMS,VARSIZE("TARGET")
#DIMS DYNAMIC RITR_STRING
VARSET RTIR_VICTIMS, -1
VARSET RITR_STRING
IF !RAPE_CONDITION()
	RETURN -1
ENDIF
FOR LOCAL,1,GET_TARGETNUM()+1
IF CFLAG:(TARGET:LOCAL):うふふ
	RITR_STRING += @"%CALLNAME:(TARGET:LOCAL)%、"
	RTIR_VICTIMS:(LOCAL-1) = (TARGET:LOCAL)
ENDIF
NEXT
SETCOLOR C_RED
PRINTFORML !! 경고 !!
PRINTFORML 시간을 재개하는 것은 %LIST_IN_STRING(RITR_STRING)%의 의식적인 강간으로 간주될 것이다!
RESETCOLOR
PRINTFORML
PRINTFORML [  0] 괜찮아.
PRINTFORML [999] 여기서 나 좀 나가게 해줘!
INPUT
SELECTCASE RESULT
	CASE 0
		CALL 時間停止解除
		FOR LOCAL,1,GET_TARGETNUM()+1
		IF CFLAG:(TARGET:LOCAL):うふふ
			CALL NAS_StartRape(TARGET:LOCAL)
			CALL RE_HOSTILE_CHECK(TARGET:LOCAL)
		ENDIF
		NEXT
	CASEELSE
		RETURN -1
ENDSELECT
;checks for marks by setting the target.

@RE_HOSTILE_CHECK(ARG)
#DIM REHC_LASTCHARA
#DIM REHC_TSP
REHC_LASTCHARA = TARGET
REHC_TSP = FLAG:70
TARGET = ARG
FLAG:70 = 0
CALL SOURCE_反感(TARGET)
CALL MARK_GOT_CHECK(TARGET)
CALL KOJO_MESSAGE_SEND("MARK",-1,TARGET,-1,-1)
TARGET = REHC_LASTCHARA
FLAG:70 = REHC_TSP
