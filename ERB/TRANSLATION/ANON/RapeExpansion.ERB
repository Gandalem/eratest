;==========================================================
;NAS_RapeOption
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Allows the player to forcefully push down the target without their consent.
;Requires the player to fail the consent check.
;Base Power is determined by twice their Danmaku skill (Melee in NAS), and half of their finger skill
;----------------------------------------------------------
;Parameters
;----------------------------------------------------------
;ARG: Target
;==========================================================
@NAS_RapeOption(ARG)
#DIM DIFFERENCE

;requires the rape toggle, capturing skill, and rope
IF !RAPE_CONDITION()
	GOTO NoRape
ENDIF

SETCOLOR C_RED
PRINTFORML Push down %CALLNAME:ARG% with force?
RESETCOLOR
PRINTFORML
PRINTFORML [  0] - That's fine.
PRINTFORML [999] - Get me out of here!
INPUT
SELECTCASE RESULT
CASE 0
	IF MARK:ARG:MARK_FORCE
		GOTO GoRape
	ELSE
		PRINTFORML How are you going to do it?
		;options
		;danmaku (no lethal because player is very likely to kill the touhou)
		;force push
		{
			CALL ASK_M(
				"Danmaku", 1,
				"Push with Force", 1,
				"Cancel", 1 
			)
		}
		SELECTCASE RESULT
		CASE 0

		CASE 1
		TCVAR:ARG:793 = 2*ABL:ARG:42 + (ABL:ARG:指)
		TCVAR:MASTER:793 = 2*ABL:MASTER:42 + (ABL:MASTER:指)
		
		CALL SHOW_POWERFAVOR(TCVAR:MASTER:793,MASTER)
		SIF TCVAR:MASTER:793
		CALL POWERBUFFS(MASTER)
		DRAWLINE
		CALL SHOW_POWERFAVOR(TCVAR:ARG:793,ARG)
		SIF TCVAR:ARG:793
		CALL POWERBUFFS(ARG)

		;Size difference
		SELECTCASE TALENT:MASTER:形状
			CASE 0,3,4
				LOCAL = 0
			CASE 1
				LOCAL = -2
			CASE 2
				LOCAL = -1
			CASE 6
				LOCAL = 1
			CASE 5,10
				LOCAL = 2
		ENDSELECT
		LOCAL:1 = ((TALENT:MASTER:体型 - TALENT:ARG:体型) * 2 + LOCAL)*4
		IF LOCAL:1
		TCVAR:MASTER:793 = TCVAR:MASTER:793 + LOCAL:1
		CALL COLORMESSAGE(@"Size Difference",C_PINK,1,1)
		CALL SHOW_POWERFAVOR(TCVAR:MASTER:793,MASTER)
		ENDIF


		DIFFERENCE = (TCVAR:MASTER:793-TCVAR:ARG:793)

		IF DIFFERENCE >= 0
			$GoRape
			PRINTFORMW With all %PARSE("your")% might, you push down %CALLNAME:ARG%.
			TFLAG:194 = 0
			TCVAR:抱き寄せ初回 = 20
			CALL COM_KOJO_CALL(ARG, 350)
			CALL NAS_StartRape(ARG)
		ELSE
			TFLAG:押し倒せない ++
			RETURN -1
		ENDIF
		CASE 2
		GOTO NoRape
		ENDSELECT
	ENDIF
CASEELSE
$NoRape
TFLAG:押し倒せない ++
RETURN -1
ENDSELECT

@NAS_StartRape(ARG)
SOURCE:ARG:反感 += 20000
TFLAG:98 = -10
TCVAR:ARG:無理矢理 = 1
CFLAG:ARG:うふふ = 1
CFLAG:MASTER:うふふ = 1
TCVAR:ARG:抱き寄せ初回 = 20
SOURCE:ARG:Terror += 1000
;TEQUIP:ARG:拘束 = 1
TFLAG:押し倒せない = 0
CFLAG:ARG:ヤラせちゃった = 1
SETBIT FALL_RAPE:ARG:0,  0 ;custom code, rape expansion

@NAS_ResumeTimeInRape
#DIM DYNAMIC RTIR_VICTIMS,VARSIZE("TARGET")
#DIMS DYNAMIC RITR_STRING
VARSET RTIR_VICTIMS, -1
VARSET RITR_STRING
IF !RAPE_CONDITION()
	RETURN -1
ENDIF
FOR LOCAL,1,GET_TARGETNUM()+1
	IF CFLAG:(TARGET:LOCAL):うふふ
		RITR_STRING += @"%CALLNAME:(TARGET:LOCAL)%、"
		RTIR_VICTIMS:(LOCAL-1) = (TARGET:LOCAL)
	ENDIF
NEXT

SETCOLOR C_RED
PRINTFORML !! WARNING !!
PRINTFORML Resuming time will count as conscious rape with %LIST_IN_STRING(RITR_STRING)%!
RESETCOLOR
PRINTFORML
PRINTFORML [  0] - That's fine.
PRINTFORML [999] - Get me out of here!
INPUT
SELECTCASE RESULT
CASE 0
	CALL 時間停止解除
	FOR LOCAL,1,GET_TARGETNUM()+1
		IF CFLAG:(TARGET:LOCAL):うふふ
			CALL NAS_StartRape(TARGET:LOCAL)
			CALL RE_HOSTILE_CHECK(TARGET:LOCAL)
		ENDIF
	NEXT
CASEELSE
	RETURN -1
ENDSELECT

