;RapeState1Requirement
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Requirements for the first state of the rape route
; 50 Fallen Rape Exp
; Force Mark 1
; 2 Fall Rapce Conditions
;----------------------------------------------------------
;Parameters
;----------------------------------------------------------
;ARG: Character ID
;==========================================================

@RapeState1Requirement(ARG)
#FUNCTION
SIF TALENT:ARG:TALENT_RAPE1 || TALENT:ARG:TALENT_RAPE2
	RETURNF 0
SIF EXP:ARG:EXP_RAPE < REQUIRED_EXP_RAPE1
	RETURNF 0
SIF MARK:ARG:MARK_FORCE < REQUIRED_FORCE_RAPE1
	RETURNF 0
SIF FALLEN_RAPE_TRACK_COUNT(ARG) < REQUIRED_FRM_RAPE1
	RETURNF 0
RETURNF 1
