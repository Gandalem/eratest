;==========================================================
;COM_ABLE107_MOD
;----------------------------------------------------------
;Description
;----------------------------------------------------------
;Custom COM_ABLE107 function which allows restraining in TSP.
;----------------------------------------------------------
;Parameters
;----------------------------------------------------------
;None
;==========================================================

@COM_ABLE107_MOD
;拘束プレイ実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(107) && !FLAG:70 ;custom code: Rape Expansion
	RETURN RESULT
;縄でしばってるとダメ
SIF TEQUIP:縄
	RETURN 0
;睡眠姦中
SIF CFLAG:イタズラ > 1
	RETURN 0
;停止中は不可
;TSPer vs TSPer countermeasure
SIF FLAG:70 && MAXBASE:TARGET:TSP
	RETURN 0
;解除はいつでも可能
SIF TEQUIP:拘束
	RETURN 1
;アイテムを持っているか、アイテムなし設定でないとダメ
SIF ITEM:27 == 0 && NOITEM == 0
	RETURN 0
RETURN 1
