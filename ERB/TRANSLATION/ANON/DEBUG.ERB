;==========================================================================
;Better made in heaven
;Puts you in a menu that allows you to change each aspect
;This allows for changing year and day as well
;==========================================================================
@MADE_IN_HEAVEN_MOD()
#DIM FIRST_LINE
#DIM NewDate, 5
#DIM DIFF
FIRST_LINE = LINECOUNT
NewDate = DAY
NewDate:1 = DAY:1
NewDate:2 = DAY:2
NewDate:3 = DAY:3
NewDate:4 = GET_YEAR()


DO
	CLEARLINE LINECOUNT - FIRST_LINE

	NewDate = (NewDate:4*YearLength)+((NewDate:2-1)*(YearLength/MonthCount))+NewDate:3

	PRINTFORML Current Date: %PRINT_DATE_F(DAY,2)%
	PRINTFORML Travel Date: %PRINT_DATE_F(NewDate-StartingDay,2)%
	PRINTFORML [0] - Change Year: {NewDate:4}
	PRINTFORML [1] - Change Month: {NewDate:2}
	PRINTFORML [2] - Change Day: {NewDate:3}
	PRINTL
	PRINTFORML [998] - ＭＡＤＥ　ＩＮ　ＨＥＡＶＥＮ！！
	PRINTFORML [999] - Back
	INPUT
	SELECTCASE RESULT
	CASE 0
		PRINTFORMDL Enter the year
		INPUT
		NewDate:4 = RESULT
	CASE 1
		PRINTFORMDL Enter the month (1-4)
		INPUT
		SELECTCASE RESULT
			CASE 1 TO 4
				NewDate:2 = RESULT
			CASEELSE
				PRINTFORMDL Invalid Input
		ENDSELECT
	CASE 2
		$ENTER_THE_DAY
		PRINTFORMDL Enter the day (1-31)
		INPUT
		SELECTCASE RESULT
			CASE 1 TO 31
				NewDate:3 = RESULT
			CASEELSE
				PRINTFORMDL Invalid Input
		ENDSELECT
	CASE 998
	BREAK
	CASE 999
	RETURN
	ENDSELECT
LOOP 1
CALL SET_KOJO_COLOR(MASTER)
PRINTFORMW 「I feel it! The 「position」 is near!」
PRINTFORMW 「ＭＡＤＥ　ＩＮ　ＨＥＡＶＥＮ！！」
RESETCOLOR
PRINTFORMDW Time begins to accelerate...
DIFF = NewDate - TIMESTAMP(DAY)

NOSKIP ;addition custom code
REPEAT ABS(DIFF)
	REUSELASTLINE %PRINT_DATE_F(DAY,2)%
	IF DIFF > 0
		DAY ++
		DAY:3 ++
	ELSEIF DIFF < 0
		DAY --
		DAY:3 --
	ENDIF
	SELECTCASE ABS(DIFF)-COUNT
	CASE IS > YearLength*1000
		SIF COUNT % (YearLength*100) == 0
		TWAIT 1, 1
	CASE IS > YearLength*500
		SIF COUNT % (YearLength*10) == 0
		TWAIT 1, 1
	CASE IS > YearLength*250
		SIF COUNT % (YearLength*5) == 0
		TWAIT 1, 1
	CASE IS > YearLength*100
		SIF COUNT % YearLength == 0
		TWAIT 1, 1
	CASE IS > YearLength*10
		SIF COUNT % 31 == 0
		TWAIT 1, 1
	CASE IS > YearLength
		SIF COUNT % 7 == 0
		TWAIT 1, 1
	CASE IS > MONTH_LENGTH_NAS(DAY:2)
		TWAIT 1, 1
	CASE IS > 7
		TWAIT 50, 1
	CASE IS > 3
		TWAIT 250, 1
	CASE IS > 0
		TWAIT 500, 1
	CASE 1
		TWAIT 1000, 1
	ENDSELECT
	SKIPDISP 1
	CALL CHANGE_MONTH
	SKIPDISP 0
REND
ENDNOSKIP
PRINTFORMDL %PRINT_DATE_F(DAY,2)%
PRINTFORMDW Time resumes to normal...
CALL OYASUMI

