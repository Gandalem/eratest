@PANTY_CHECK_TOUCH_POINTS_FOR_PLAYER(ACTOR, TOUCH_PARTS, ACTOR_PART)
#FUNCTION
#DIM ACTOR
#DIM ACTOR_PART
#DIM REF TOUCH_PARTS
#DIM TOUCH_PART
FOR LOCAL, 0, VARSIZE("TOUCH_PARTS")
	TOUCH_PART = TOUCH_PARTS:LOCAL
	LOCAL:1 = ADD_CHARA_WHO_TOUCHING_ACTOR(ACTOR, TOUCH_PART, ACTOR_PART)
	IF LOCAL:1 >= 0
		RESULT:1 = LOCAL:1
		RETURNF TOUCH_PART
	ENDIF
NEXT
RETURNF 0

@IS_NPC_LED_COM(ARG, CHARA = -1)
#FUNCTION
#DIM CHARA
SIF CHARA == -1
	CHARA = TARGET
SIF !SHIRAHU(CHARA)
	RETURNF 0
SIF CHARA == PLAYER && GROUPMATCH(ARG, 121, 126) ;counts for both
	RETURNF 0
RETURNF GROUPMATCH(ARG, 9, 13, 22, 24, 65, 66, 80, 81, 82, 83, 85, 88, 90, 91, 92, 93, 94, 99, 120, 121, 125, 126, 127, 130, 131, 132, 133, 140, 144, 320, 322, 323)

;returns the closest allowed state for the current act
@CHECK_NEAREST_PANTY_STATE_ALLOWED(CHARA = -1)
#FUNCTION
#DIM CHARA
#DIM DYNAMIC V_INSERT
#DIM DYNAMIC A_INSERT
#DIM DYNAMIC P_INSERT
#DIM DYNAMIC U_INSERT; NAS CUSTOM
#DIM DYNAMIC PLAYER_INSERTED_CHARA
#DIM DYNAMIC NEAREST_ALLOWED
#DIM POSE
#DIM CHARA_LED
#DIM V_TOUCH_PARTS, 2 = SET_P, SET_YUBI
#DIM C_TOUCH_PARTS, 2 = SET_P, SET_C;, SET_YUBI
#DIM A_TOUCH_PARTS, 2 = SET_P, SET_YUBI
#DIM U_TOUCH_PARTS, 2 = SET_P, SET_YUBI; NAS Custom
#DIM P_TOUCH_PARTS, 8 = SET_YUBI, SET_M, SET_B, SET_V, SET_A, SET_LEG, SET_BELLY, SET_U
SIF CHARA == -1 && TARGET
	CHARA = TARGET

SIF !CFLAG:CHARA:うふふ
	RETURNF 0

IF NO:CHARA == MASTER ;different method because all insertions are character-based
	V_INSERT = PANTY_CHECK_TOUCH_POINTS_FOR_PLAYER(CHARA, V_TOUCH_PARTS, SET_V)
	IF V_INSERT
		PLAYER_INSERTED_CHARA = RESULT:1
	ELSE
		V_INSERT = PANTY_CHECK_TOUCH_POINTS_FOR_PLAYER(CHARA, C_TOUCH_PARTS, SET_C)
		SIF V_INSERT
			PLAYER_INSERTED_CHARA = RESULT:1
	ENDIF
	A_INSERT = PANTY_CHECK_TOUCH_POINTS_FOR_PLAYER(CHARA, A_TOUCH_PARTS, SET_A)
	SIF A_INSERT && !PLAYER_INSERTED_CHARA
		PLAYER_INSERTED_CHARA = RESULT:1
	;NAS Custom
	U_INSERT = PANTY_CHECK_TOUCH_POINTS_FOR_PLAYER(CHARA, U_TOUCH_PARTS, SET_U)
	SIF U_INSERT && !PLAYER_INSERTED_CHARA
		PLAYER_INSERTED_CHARA = RESULT:1
	;/////////////////////

	IF SELECTCOM == 99
		P_INSERT = -1
	ELSE
		P_INSERT = PANTY_CHECK_TOUCH_POINTS_FOR_PLAYER(CHARA, P_TOUCH_PARTS, SET_P)
	ENDIF

	SIF PLAYER_INSERTED_CHARA
		POSE = TOUCH_CURRENT_POSE(CHARA, PLAYER_INSERTED_CHARA)

	CHARA_LED = !IS_NPC_LED_COM(SELECTCOM)
ELSE
	;get current state
	IF TEQUIP:CHARA:バイブ
		V_INSERT = -1
	;NAS custom
	ELSEIF TEQUIP:CHARA:EStimVag || TEQUIP:CHARA:EStimClit
		A_INSERT = -1
	;/////////
	ELSEIF TARGET == CHARA && SELECTCOM == 40 ;rotor
		V_INSERT = -2
	ELSE
		LOCAL = ADD_TOUCH_PART_INSERTED_IN(CHARA, SET_V)
		IF LOCAL > 0
			V_INSERT = LOCAL
		ELSE
			SIF GROUPMATCH(ADD_TOUCH_PART_INSERTED_IN(CHARA, SET_C), SET_M, SET_C) ;maybe more? check command descriptions
				V_INSERT = -2
		ENDIF
	ENDIF

	IF TEQUIP:CHARA:アナルバイブ || TEQUIP:CHARA:アナルビーズ
		A_INSERT = -1
	;NAS custom
	ELSEIF TEQUIP:CHARA:アナル電極
		A_INSERT = -1
	;/////////
	ELSE
		LOCAL = ADD_TOUCH_PART_INSERTED_IN(CHARA, SET_A)
		SIF LOCAL > 0
			A_INSERT = LOCAL
	ENDIF

	;NAS custom
	IF TEQUIP:CHARA:UrethralSound || TEQUIP:CHARA:EStimUrethra
		U_INSERT = -1
	ELSE
		LOCAL = ADD_TOUCH_PART_INSERTED_IN(CHARA, SET_U)
		SIF LOCAL > 0
			U_INSERT = LOCAL
	ENDIF
	;//////////////////////

	IF TEQUIP:CHARA:オナホール
		P_INSERT = -1
	ELSE
		LOCAL = ADD_TOUCH_PART_INSERTED_IN(CHARA, SET_P)
		SIF LOCAL > 0
			P_INSERT = LOCAL
	ENDIF

	POSE = TOUCH_CURRENT_POSE(PLAYER, CHARA)
	CHARA_LED = IS_NPC_LED_COM(SELECTCOM)
ENDIF

RESULT:1 = P_INSERT ;for pants removal

SIF !EQUIP:CHARA:下半身下着２ ;not wearing any
	RETURNF 0

SIF TEQUIP:CHARA:PANTY_STATE == PANTY_ON_LEG ;already fully down
	RETURNF 0

IF V_INSERT
	IF CHECK_PANTIES("open_front", CHARA) ;open crotch is always allowed
	ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_UNZIPPED && CHECK_PANTIES("zippable_front", CHARA) ;already has access
	ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_ASIDE ;already has access
	ELSEIF TEQUIP:CHARA:PANTY_STATE == DIAPER_OPEN ;NAS custom code, already has access
	ELSEIF CHECK_PANTIES("are_pasties", CHARA) ;need to be removed
		NEAREST_ALLOWED = PANTY_OFF
	ELSE
		IF TEQUIP:CHARA:PANTY_STATE == PANTY_WORN && CHECK_PANTIES("zippable_front", CHARA)
			NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_UNZIPPED)
		ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_WORN && CHECK_PANTIES("can_shift_aside", CHARA)
			NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_ASIDE)
		ELSE
			IF POSE_FACING(POSE) || GROUPMATCH(POSE, POSE_ONAHOLE, POSE_STANDING_ONAHOLE)
				NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_ON_LEG)
			ELSEIF GROUPMATCH(POSE, POSE_COWGIRL, POSE_REV_COWGIRL)
				NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_ON_LEG)
			ELSEIF POSE_BEHIND(POSE)
				IF TEQUIP:CHARA:PANTY_STATE < PANTY_DOWN
					NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_DOWN)
				ENDIF
			ELSEIF V_INSERT != SET_P
				IF CHECK_PANTIES("diaper_tape", CHARA) || CHECK_PANTIES("diaper_pin", CHARA)
					NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, DIAPER_OPEN)
				ELSE
				NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_DOWN)
				ENDIF
			ELSE ;shouldn't be possible
				NEAREST_ALLOWED = PANTY_OFF
			ENDIF
		ENDIF
	ENDIF
	;more proper characters will take it off entirely
	SIF CHARA_LED && NEAREST_ALLOWED == PANTY_ON_LEG && (TALENT:CHARA:貞操 == 1 || TALENT:CHARA:性的興味 == -1 || CFLAG:CHARA:性格傾向 == 4)
		NEAREST_ALLOWED = PANTY_OFF
	;NAS customs
	;if you are too squeamish you have to take it off entirely.
	SIF Undressing_ShiftPantyBlock(CHARA,NEAREST_ALLOWED)
		NEAREST_ALLOWED = PANTY_OFF
	;///////////////////////
ENDIF

IF A_INSERT
	IF CHECK_PANTIES("open_back", CHARA) ;open crotch is always allowed
	ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_UNZIPPED && CHECK_PANTIES("zippable_back", CHARA) ;already has access
	ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_ASIDE ;already has access
	ELSEIF TEQUIP:CHARA:PANTY_STATE == DIAPER_OPEN ;NAS custom code, already has access
	ELSEIF CHECK_PANTIES("are_pasties", CHARA) ;need to be removed
		NEAREST_ALLOWED = PANTY_OFF
	ELSE
		IF TEQUIP:CHARA:PANTY_STATE == PANTY_WORN && CHECK_PANTIES("zippable_back", CHARA)
			NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_UNZIPPED)
		ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_WORN && CHECK_PANTIES("can_shift_aside", CHARA)
			NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_ASIDE)
		ELSE
			IF POSE_FACING(POSE) || GROUPMATCH(POSE, POSE_ONAHOLE, POSE_STANDING_ONAHOLE)
				NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_ON_LEG)
			ELSEIF GROUPMATCH(POSE, POSE_COWGIRL, POSE_REV_COWGIRL)
				NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_ON_LEG)
			ELSEIF POSE_BEHIND(POSE)
				IF TEQUIP:CHARA:PANTY_STATE < PANTY_DOWN && NEAREST_ALLOWED < PANTY_DOWN
					NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_DOWN)
				ENDIF
			ELSEIF A_INSERT != SET_P
				IF CHECK_PANTIES("diaper_tape", CHARA) || CHECK_PANTIES("diaper_pin", CHARA)
					NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, DIAPER_OPEN)
				ELSE
				NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_DOWN)
				ENDIF
			ELSE ;shouldn't be possible
				NEAREST_ALLOWED = PANTY_OFF
			ENDIF
		ENDIF
	ENDIF
	;more proper characters will take it off entirely
	SIF CHARA_LED && NEAREST_ALLOWED == PANTY_ON_LEG && (TALENT:CHARA:貞操 == 1 || TALENT:CHARA:性的興味 == -1 || CFLAG:CHARA:性格傾向 == 4)
		NEAREST_ALLOWED = PANTY_OFF
	;NAS customs
	;if you are too squeamish you have to take it off entirely.
	SIF Undressing_ShiftPantyBlock(CHARA,NEAREST_ALLOWED)
		NEAREST_ALLOWED = PANTY_OFF
	;///////////////////////
ENDIF

IF P_INSERT
	IF CHECK_PANTIES("open_front", CHARA) ;open crotch is always allowed
	ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_UNZIPPED && CHECK_PANTIES("zippable_front", CHARA) ;already has access
	ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_ASIDE ;already has access
	ELSEIF TEQUIP:CHARA:PANTY_STATE == DIAPER_OPEN ;NAS custom code, already has access
	ELSEIF CHECK_PANTIES("are_pasties", CHARA) ;need to be removed (shouldn't really occur)
		NEAREST_ALLOWED = PANTY_OFF
	ELSE
		IF TEQUIP:CHARA:PANTY_STATE == PANTY_WORN && CHECK_PANTIES("zippable_front", CHARA)
			NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_UNZIPPED)
		ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_WORN && CHECK_PANTIES("can_shift_aside", CHARA)
			NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_ASIDE)
		ELSEIF CHECK_PANTIES("can_pull_down", CHARA)
			NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_DOWN)
		ELSE
			NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_OFF)
		ENDIF
	ENDIF
	;more proper characters will take it off entirely
	SIF CHARA_LED && NEAREST_ALLOWED >= PANTY_ASIDE && (TALENT:CHARA:貞操 == 1 || TALENT:CHARA:性的興味 == -1 || CFLAG:CHARA:性格傾向 == 4)
		NEAREST_ALLOWED = PANTY_OFF
	;NAS customs
	;if you are too squeamish you have to take it off entirely.
	SIF Undressing_ShiftPantyBlock(CHARA,NEAREST_ALLOWED)
		NEAREST_ALLOWED = PANTY_OFF
	;///////////////////////
ENDIF

;NAS custom code
IF U_INSERT
	IF CHECK_PANTIES("open_front", CHARA) ;open crotch is always allowed
	ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_UNZIPPED && CHECK_PANTIES("zippable_front", CHARA) ;already has access
	ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_ASIDE ;already has access
	ELSEIF TEQUIP:CHARA:PANTY_STATE == DIAPER_OPEN ;NAS custom code, already has access
	ELSEIF CHECK_PANTIES("are_pasties", CHARA) ;need to be removed
		NEAREST_ALLOWED = PANTY_OFF
	ELSE
		IF TEQUIP:CHARA:PANTY_STATE == PANTY_WORN && CHECK_PANTIES("zippable_front", CHARA)
			NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_UNZIPPED)
		ELSEIF TEQUIP:CHARA:PANTY_STATE == PANTY_WORN && CHECK_PANTIES("can_shift_aside", CHARA)
			NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_ASIDE)
		ELSE
			IF POSE_FACING(POSE) || GROUPMATCH(POSE, POSE_ONAHOLE, POSE_STANDING_ONAHOLE)
				NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_ON_LEG)
			ELSEIF GROUPMATCH(POSE, POSE_COWGIRL, POSE_REV_COWGIRL)
				NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_ON_LEG)
			ELSEIF POSE_BEHIND(POSE)
				IF TEQUIP:CHARA:PANTY_STATE < PANTY_DOWN
					NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_DOWN)
				ENDIF
			ELSEIF U_INSERT != SET_P
				IF CHECK_PANTIES("diaper_tape", CHARA) || CHECK_PANTIES("diaper_pin", CHARA)
					NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, DIAPER_OPEN)
				ELSE
				NEAREST_ALLOWED = MAX(NEAREST_ALLOWED, PANTY_DOWN)
				ENDIF
			ELSE ;shouldn't be possible
				NEAREST_ALLOWED = PANTY_OFF
			ENDIF
		ENDIF
	ENDIF
	;more proper characters will take it off entirely
	SIF CHARA_LED && NEAREST_ALLOWED == PANTY_ON_LEG && (TALENT:CHARA:貞操 == 1 || TALENT:CHARA:性的興味 == -1 || CFLAG:CHARA:性格傾向 == 4)
		NEAREST_ALLOWED = PANTY_OFF
	;NAS customs
	;if you are too squeamish you have to take it off entirely.
	SIF Undressing_ShiftPantyBlock(CHARA,NEAREST_ALLOWED)
		NEAREST_ALLOWED = PANTY_OFF
	;///////////////////////
ENDIF
;/////////////////

SIF CFLAG:CHARA:NO_LEGS && INRANGE(NEAREST_ALLOWED, PANTY_DOWN, PANTY_ON_LEG)
	NEAREST_ALLOWED = PANTY_OFF

RETURNF NEAREST_ALLOWED

@SHIFT_PANTIES(ARG)
#DIM NEAREST
TEQUIP:ARG:PREV_PANTY_STATE = TEQUIP:ARG:PANTY_STATE

VARSET RESULT
NEAREST = CHECK_NEAREST_PANTY_STATE_ALLOWED(ARG)
IF NEAREST != 0 && NEAREST != TEQUIP:ARG:PANTY_STATE
	IF NEAREST == PANTY_OFF
		EQUIP:ARG:下半身下着２ = 0
	ENDIF
	TEQUIP:ARG:PANTY_STATE = NEAREST
ENDIF

SIF RESULT:1 && TEQUIP:ARG:0 & 4
	EQUIP:ARG:ズボン = 0

@HAS_PANTY_MOVEMENT(CHARA = -1)
#FUNCTION
#DIM CHARA
SIF CHARA < 0
	CHARA = TARGET

RETURNF TEQUIP:CHARA:PREV_PANTY_STATE != TEQUIP:CHARA:PANTY_STATE || (TEQUIP:CHARA:0 & 4 && !EQUIP:CHARA:ズボン)

@HAS_PANTY_MOVEMENT_EITHER(CHARA = -1)
#FUNCTION
#DIM CHARA

RETURNF HAS_PANTY_MOVEMENT(PLAYER) || HAS_PANTY_MOVEMENT(CHARA)

@PRINT_PANTY_MOVEMENT_BOTH_GENERAL(CHARA, FORM = "s", STYLE = "long", USE_NAME = 0, CHARA_DESC, DESC_P_CHARA = -1)
#FUNCTIONS
#DIM CHARA
#DIMS FORM
#DIMS STYLE
#DIM USE_NAME
#DIMS CHARA_DESC
#DIM DESC_P_CHARA
VARSET LOCALS

IF IS_NPC_LED_COM(SELECTCOM, CHARA)
	SIF HAS_PANTY_MOVEMENT(CHARA)
		LOCALS += PRINT_PANTY_MOVEMENT(CHARA, CHARA, FORM, STYLE, USE_NAME, CHARA_DESC, DESC_P_CHARA)
	IF HAS_PANTY_MOVEMENT(CHARA) && HAS_PANTY_MOVEMENT(PLAYER)
		IF FORM == "ing"
			IF TEQUIP:CHARA:PANTY_STATE == TEQUIP:PLAYER:PANTY_STATE
				LOCALS += @" and your %PANTSNAME(GET_ACTIVE_PANTY_ID(PLAYER), PLAYER)%"
				RETURNF LOCALS
			ELSE
				SIF DESC_P_CHARA == CHARA
					LOCALS += ","
				LOCALS += @" and "
			ENDIF
		ELSE
			LOCALS += ", "
		ENDIF
	ENDIF
	SIF HAS_PANTY_MOVEMENT(PLAYER)
		LOCALS += PRINT_PANTY_MOVEMENT(PLAYER, CHARA, FORM, STYLE,,, DESC_P_CHARA)
ELSE
	SIF HAS_PANTY_MOVEMENT(PLAYER)
		LOCALS += PRINT_PANTY_MOVEMENT(PLAYER, PLAYER, FORM, STYLE,,, DESC_P_CHARA)
	IF HAS_PANTY_MOVEMENT(PLAYER) && HAS_PANTY_MOVEMENT(CHARA)
		IF FORM == "ing"
			IF TEQUIP:PLAYER:PANTY_STATE == TEQUIP:CHARA:PANTY_STATE
				LOCALS += @" and \@ USE_NAME ? %CALLNAME:CHARA%'s # %HIS_HER(CHARA)% \@ %PANTSNAME(GET_ACTIVE_PANTY_ID(CHARA), CHARA)%"
				RETURNF LOCALS
			ELSE
				SIF DESC_P_CHARA == PLAYER
					LOCALS += ","
				LOCALS += " and "
			ENDIF
		ELSE
			LOCALS += ", "
		ENDIF
	ENDIF
	SIF HAS_PANTY_MOVEMENT(CHARA)
		LOCALS += PRINT_PANTY_MOVEMENT(CHARA, PLAYER, FORM, STYLE, USE_NAME, CHARA_DESC, DESC_P_CHARA)
ENDIF

RETURNF LOCALS

@PRINT_PANTY_MOVEMENT(CHARA, ACTOR, FORM = "s", STYLE = "long", USE_NAME = 0, CHARA_DESC, P_CHARA = -1)
#FUNCTIONS
#DIM CHARA
#DIM ACTOR
#DIMS FORM
#DIMS STYLE
#DIM USE_NAME
#DIMS CHARA_DESC
#DIMS DYNAMIC CHARA_TERM
#DIMS PANTY_TEXT
#DIM P_CHARA
#DIM PANTS_REMOVAL
VARSET LOCALS

IF USE_NAME == 2
	CHARA_TERM = %TNAME(TARGET,,1,1)%
ELSEIF CHARA != PLAYER && (USE_NAME == 1 || CHARA_DESC != "")
	CHARA_TERM = %ONGOING_G(CHARA)%
ELSE
	CHARA_TERM = %HIS_HER_YOUR(CHARA)%
ENDIF

SIF CHARA_DESC != ""
	CHARA_DESC += " "

PANTY_TEXT '= PANTSNAME(GET_ACTIVE_PANTY_ID(CHARA), CHARA)
PANTS_REMOVAL = TEQUIP:CHARA:0 & 4

IF PANTS_REMOVAL
	IF FORM == "s"
		LOCALS += @"remove%COND_STR("s", ACTOR != PLAYER)%"
	ELSE
		LOCALS += "removing"
	ENDIF
	IF STYLE == "long"
		IF CHARA == ACTOR && CHARA_DESC == "" && !USE_NAME
			LOCALS += @" %CHARA_TERM% %CLOTHNAME(11, GET_ACTIVE_CLOTHING_PART(CHARA, 11))%"
		ELSE
			LOCALS += @" %CHARA_DESC%%CHARA_TERM% %CLOTHNAME(11, GET_ACTIVE_CLOTHING_PART(CHARA, 11))%"
		ENDIF
	ENDIF

	SIF TEQUIP:CHARA:PREV_PANTY_STATE == TEQUIP:CHARA:PANTY_STATE
		RETURNF LOCALS
	LOCALS += " and "
ENDIF

SIF TEQUIP:CHARA:PREV_PANTY_STATE == TEQUIP:CHARA:PANTY_STATE
	RETURNF ""

SELECTCASE TEQUIP:CHARA:PANTY_STATE
	CASE PANTY_UNZIPPED
		IF FORM == "s"
			LOCALS += @"unzip%COND_STR("s", ACTOR != PLAYER)%"
		ELSE
			LOCALS += "unzipping"
		ENDIF
		IF STYLE == "long"
			LOCALS += @" %CHARA_DESC%%CHARA_TERM% %PANTY_TEXT%"
		ENDIF
	CASE PANTY_ASIDE
		IF FORM == "s"
			LOCALS += @"shift%COND_STR("s", ACTOR != PLAYER)%"
		ELSE
			LOCALS += "shifting"
		ENDIF
		IF STYLE == "long"
			IF CHARA == ACTOR && CHARA_DESC == "" && !USE_NAME
				LOCALS += @" aside %CHARA_TERM% %PANTY_TEXT%"
			ELSE
				LOCALS += @" %CHARA_DESC%%CHARA_TERM% %PANTY_TEXT% aside"
			ENDIF
		ELSE
			LOCALS += " aside"
		ENDIF
	CASE PANTY_DOWN
		IF FORM == "s"
			LOCALS += @"pull%COND_STR("s", ACTOR != PLAYER)%"
		ELSE
			LOCALS += "pulling"
		ENDIF
		IF STYLE == "long"
			IF CHARA == ACTOR && CHARA_DESC == "" && !USE_NAME
				LOCALS += @" down %CHARA_TERM% %PANTY_TEXT%"
			ELSE
				LOCALS += @" %CHARA_DESC%%CHARA_TERM% %PANTY_TEXT% down"
			ENDIF
		ELSE
			LOCALS += " down"
		ENDIF
	CASE PANTY_ON_LEG
		IF FORM == "s"
			LOCALS += @"pull%COND_STR("s", ACTOR != PLAYER)%"
		ELSE
			LOCALS += "pulling"
		ENDIF
		IF STYLE == "long"
			LOCALS += @" %CHARA_DESC%%CHARA_TERM% %PANTY_TEXT% off one of %HIS_HER_YOUR(CHARA)% legs"
		ELSE
			LOCALS += " off"
		ENDIF
	CASE PANTY_OFF
		IF CHECK_PANTIES("can_be_untied", CHARA) && GROUPMATCH(TEQUIP:CHARA:PREV_PANTY_STATE, PANTY_WORN, PANTY_UNZIPPED, PANTY_ASIDE)
			IF FORM == "s"
				LOCALS += @"untie%COND_STR("s", ACTOR != PLAYER)%"
			ELSE
				LOCALS += "untying"
			ENDIF
			IF STYLE == "long"
				LOCALS += @" %CHARA_TERM% %PANTY_TEXT%"
			ENDIF
		ELSE
			IF CHECK_PANTIES("are_pasties", CHARA)
				IF FORM == "s"
					LOCALS += @"peel%COND_STR("s", ACTOR != PLAYER)%"
				ELSE
					LOCALS += "peeling"
				ENDIF
			ELSE
				IF FORM == "s"
					LOCALS += @"take%COND_STR("s", ACTOR != PLAYER)%"
				ELSE
					LOCALS += "taking"
				ENDIF
			ENDIF
			IF STYLE == "long"
				IF CHARA == ACTOR && CHARA_DESC == "" && !USE_NAME
					LOCALS += @" off %CHARA_TERM% %PANTY_TEXT%"
				ELSE
					LOCALS += @" %CHARA_DESC%%CHARA_TERM% %PANTY_TEXT% off"
				ENDIF
			ELSE
				LOCALS += " off"
			ENDIF
		ENDIF
	CASE DIAPER_OPEN ;NAS Custom
		IF CHECK_PANTIES("diaper_pin", CHARA)
			IF FORM == "s"
				LOCALS += @"unpin%COND_STR("s", ACTOR != PLAYER)%"
			ELSE
				LOCALS += "unpin"
			ENDIF
		ELSE
			IF FORM == "s"
				LOCALS += @"untape%COND_STR("s", ACTOR != PLAYER)%"
			ELSE
				LOCALS += "untape"
			ENDIF
		ENDIF
		IF STYLE == "long"
			LOCALS += @" %CHARA_DESC%%CHARA_TERM% %PANTY_TEXT%, open it"
			LOCALS:1 '= ""
			;soiled
			;based on soiling amount not percentage
			;peed
			SELECTCASE SoiledDiaper(CHARA,1,2,0)
			CASE 0
				;clean
				; LOCALS:1 '= "a dry pad"
			CASE IS < 100
				LOCALS:1 += "a small part of the pad having been stained、"
			CASE IS < 300
				LOCALS:1 += @"a moderate %UndiesSoilingType("liquid",DOMINANT_LIQUID_SOIL(CHARA),0,0,1,CHARA)% stain present、"
			CASE IS < 700
				LOCALS:1 += @"much of pad stained wet %UndiesSoilingType("liquid",DOMINANT_LIQUID_SOIL(CHARA),0,0,1,CHARA)%、"
			CASE IS < 1400
				LOCALS:1 += @"the pad significantly soiled with %UndiesSoilingType("liquid",DOMINANT_LIQUID_SOIL(CHARA),0,0,1,CHARA)%、"
			CASE IS >= 1400
				LOCALS:1 += "the pad soaked completely "
				SELECTCASE DOMINANT_LIQUID_SOIL(CHARA)
				CASE 0
				;pee
					LOCALS:1 += "yellow"
				CASE 1
				;menses
					LOCALS:1 += "red"
				CASE 2,3
				;cum/juice
					LOCALS:1 += "milky white"
				ENDSELECT
				LOCALS:1 += " from front to back、"
			ENDSELECT
			;poopy
			SELECTCASE SoiledDiaper(CHARA,1,2,0)
			CASE 0
			CASE IS < 100
				LOCALS:1 += @"a tiny \@ GETBIT(nScat,4) ? brown # blue\@ stain、"
			CASE IS < 300
				LOCALS:1 += @"a small amount of %UndiesSoilingType("solid",DOMINANT_SOLID_SOIL(CHARA),0,0,1,CHARA)%、"
			CASE IS < 700
				LOCALS:1 += @"%UndiesSoilingType("solid",DOMINANT_SOLID_SOIL(CHARA),0,0,1,CHARA)% formed into a loaf、"
			CASE IS < 1400
				LOCALS:1 += @"a large \@ GETBIT(nScat,4) ? poopy # jelly\@ loaf formed at the middle、"
			CASE IS >= 1400
				IF STRLENS(LOCALS:1)
					LOCALS:1 += @" with %UndiesSoilingType("solid",DOMINANT_SOLID_SOIL(CHARA),0,0,1,CHARA)% caked with all over"
				ELSE
					LOCALS:1 += @"an absolutely filled diaper, caked with %UndiesSoilingType("solid",DOMINANT_SOLID_SOIL(CHARA),0,0,1,CHARA)%、"
				ENDIF
			ENDSELECT
			SIF STRLENS(LOCALS:1)
			LOCALS += @", %SPLIT_G("exposing:revealing:showing off")% %LIST_IN_STRING(LOCALS:1)%"

		ENDIF
	;//////////////////
ENDSELECT

SIF HAS_PENIS(CHARA) && P_CHARA == CHARA
	LOCALS += @", %SPLIT_G("exposing:releasing:revealing:freeing")% %HIS_HER_YOUR(CHARA)% %TINKO_TR(CHARA, 1)%"

RETURNF LOCALS

@HAS_PANTY_STATE(CHARA = -1)
#FUNCTION
#DIM CHARA
SIF CHARA < 0
	CHARA = TARGET
RETURNF INRANGE(TEQUIP:CHARA:PANTY_STATE, PANTY_UNZIPPED, PANTY_ON_LEG)

@PRINT_PANTY_STATE(CHARA, TENSE = "present")
#FUNCTIONS
#DIM CHARA
#DIMS TENSE
VARSET LOCALS

IF TENSE == "past"
	SELECTCASE TEQUIP:CHARA:PANTY_STATE
		CASE PANTY_UNZIPPED
			LOCALS '= @"%SHOW_BOTTOM(CHARA,2)% %HAS_HAVE_PANTIES(SHOW_BOTTOM(CHARA,2))% been unzipped"
		CASE PANTY_ASIDE
			LOCALS '= @"%SHOW_BOTTOM(CHARA,2)% %HAS_HAVE_PANTIES(SHOW_BOTTOM(CHARA,2))% been moved aside"
		CASE PANTY_DOWN
			LOCALS '= @"%SHOW_BOTTOM(CHARA,2)% %HAS_HAVE_PANTIES(SHOW_BOTTOM(CHARA,2))% been pulled down"
		CASE PANTY_ON_LEG
			LOCALS '= @"%SHOW_BOTTOM(CHARA,2)% %IS_ARE_PANTIES(SHOW_BOTTOM(CHARA,2))% dangling off %HIS_HER(CHARA)% leg"
		CASE DIAPER_OPEN; NAS custom code
			LOCALS '= @"%SHOW_BOTTOM(CHARA,2)% %HAS_HAVE_PANTIES(SHOW_BOTTOM(CHARA,2))% been opened"
	ENDSELECT
ELSE
	SELECTCASE TEQUIP:CHARA:PANTY_STATE
		CASE PANTY_UNZIPPED
			LOCALS '= @"%SHOW_BOTTOM(CHARA,2)% %IS_ARE_PANTIES(SHOW_BOTTOM(CHARA,2))% unzipped"
		CASE PANTY_ASIDE
			LOCALS '= @"%SHOW_BOTTOM(CHARA,2)% %IS_ARE_PANTIES(SHOW_BOTTOM(CHARA,2))% shifted aside"
		CASE PANTY_DOWN
			LOCALS '= @"%SHOW_BOTTOM(CHARA,2)% %IS_ARE_PANTIES(SHOW_BOTTOM(CHARA,2))% pulled down"
		CASE PANTY_ON_LEG
			LOCALS '= @"%SHOW_BOTTOM(CHARA,2)% %IS_ARE_PANTIES(SHOW_BOTTOM(CHARA,2))% dangling off %HIS_HER(CHARA)% leg"
		CASE DIAPER_OPEN; NAS custom code
			LOCALS '= @"%SHOW_BOTTOM(CHARA,2)% %HAS_HAVE_PANTIES(SHOW_BOTTOM(CHARA,2))% been opened"
	ENDSELECT
ENDIF

RETURNF LOCALS

@PRINT_PANTY_HOLE(CHARA, HOLE, POSTPEND_SPACE = 0, SKIP_PANTYNAME)
#FUNCTIONS
#DIM CHARA
#DIMS HOLE
#DIMS HOLE_POS
#DIM POSTPEND_SPACE
#DIM SKIP_PANTYNAME
#DIM UNZIPPED
SIF !EQUIP:CHARA:下半身下着２ ;not wearing any
	RETURNF ""

HOLE_POS '= \@ HOLE == "v" || HOLE == "u" ? front # back \@
UNZIPPED = TEQUIP:CHARA:PANTY_STATE == PANTY_UNZIPPED && CHECK_PANTIES(@"zippable_%HOLE_POS%", CHARA)
SIF TEQUIP:CHARA:PANTY_STATE != PANTY_WORN && !UNZIPPED ;not worn normally
	RETURNF ""
SIF !GROUPMATCH(HOLE, "v", "a", "u")
	RETURNF "INCORRECT ARGUMENT"

VARSET LOCALS

LOCAL = CHECK_PANTIES(@"open_\@ HOLE == "v" || hole == "u" ? front # back \@_type", CHARA)
SIF !LOCAL && UNZIPPED
	LOCAL = 1

SELECTCASE LOCAL
	CASE 1
		LOCALS '= @"through the hole in %HIS_HER(CHARA)% %COND_STR(SHOW_BOTTOM(CHARA,2), !SKIP_PANTYNAME)%"
	CASE 2
		LOCALS '= @"past %HIS_HER(CHARA)% %COND_STR(SHOW_BOTTOM(CHARA,2), !SKIP_PANTYNAME)%"
	CASE 4
		LOCALS '= @"through %HIS_HER(CHARA)% %COND_STR(SHOW_BOTTOM(CHARA,2), !SKIP_PANTYNAME)%"
ENDSELECT

IF LOCALS != ""
	IF POSTPEND_SPACE
		LOCALS '= @"%LOCALS% "
	ELSE
		LOCALS '= @" %LOCALS%"
	ENDIF
ENDIF

RETURNF LOCALS

