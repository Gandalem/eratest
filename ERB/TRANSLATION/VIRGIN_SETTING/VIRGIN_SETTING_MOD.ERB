			TALENT:CHARA_ID:1 = 1
		ELSE
			TALENT:CHARA_ID:処女 = CSVTALENT(NO:CHARA_ID,0)
			TALENT:CHARA_ID:1 = CSVTALENT(NO:CHARA_ID,1)
		ENDIF
		;CLUELESS KNOW SLUT
		LOCAL = RAND:100+1
		IF LOCAL <= PERC_SETS:3:CURRENT_GENDER
			EXP:CHARA_ID:Ｃ経験 = 0
			EXP:CHARA_ID:Ｂ経験 = 0
