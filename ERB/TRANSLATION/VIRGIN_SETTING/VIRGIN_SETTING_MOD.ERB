IDENTIFIER:(LOCAL * 3):1 = 0
IDENTIFIER:((LOCAL * 3)+ 1):0 = LOCAL
IDENTIFIER:((LOCAL * 3)+ 1):1 = 1
IDENTIFIER:((LOCAL * 3)+ 2):0 = LOCAL
IDENTIFIER:((LOCAL * 3)+ 2):1 = 2
IF LOCAL == 17
	PRINTBUTTON @" %\@PERC_SETS:LOCAL:0 == 1? ON # OFF\@, 7, LEFT%", (LOCAL * 3)
	PRINTBUTTON @"|  %\@PERC_SETS:LOCAL:1 == 1? ON # OFF\@, 5, LEFT% ", ((LOCAL * 3) + 1)
	PRINTBUTTON @"|  %\@PERC_SETS:LOCAL:2 == 1? ON # OFF\@, 6, LEFT% ", ((LOCAL * 3) + 2)
ELSE
	PRINTBUTTON @" %@"{PERC_SETS:LOCAL:0}％", 7, LEFT%", (LOCAL * 3)
	PRINTBUTTON @"%@"|  {PERC_SETS:LOCAL:1}％", 8, LEFT% ", ((LOCAL * 3) + 1)
	PRINTBUTTON @"%@"|  {PERC_SETS:LOCAL:2}％", 8, LEFT% ", ((LOCAL * 3) + 2)
ENDIF
;Add {LOCAL} to next line for debugging, number displayed is the TALENT_SETS:LOCAL and PERC_SETS:LOCAL equivalent
PRINTFORML
SIF LOCAL == 0 || LOCAL == 2 || LOCAL == 5 || LOCAL == 10 || LOCAL == 15 || LOCAL == 16 || LOCAL == 22 || LOCAL == 30
	PRINTL ------------------------------------------------------------
NEXT
PRINTL
SIF CHOOSE_BY_GENDER == 0
	PRINTLC [994] 성별로 선택하기
PRINTLC [995] - 현재 초기화
PRINTL [996] - 캐릭터 제외
PRINTLC [997] - 설정 저장
PRINTLC [998] - 설정 불러오기
PRINTL [999] - 현재 설정 적용
PRINTL
PRINTL [1000] - 반환
$INPUT_LOOP
INPUT
SELECTCASE RESULT
	CASE 51 TO 53 ;Keep Default Ears
		CURRENT_TALENT = IDENTIFIER:RESULT:0
		CURRENT_GENDER = IDENTIFIER:RESULT:1
		IF PERC_SETS:CURRENT_TALENT:CURRENT_GENDER == 1
			PERC_SETS:CURRENT_TALENT:CURRENT_GENDER = 0
			PRINTW 기본값 비활성화됨, 모든 캐릭터에게 무작위 귀가 적용될 예정입니다.
		ELSE
			PERC_SETS:CURRENT_TALENT:CURRENT_GENDER = 1
			PRINTW 기본값은 활성화되었으며, 캐릭터가 이미 귀를 가지고 있다면 교체되지 않는다.
		ENDIF
	CASE 0 TO 150
		CURRENT_TALENT = IDENTIFIER:RESULT:0
		CURRENT_GENDER = IDENTIFIER:RESULT:1
		;Set the limit for the talent sets
		IF INRANGE(RESULT, 0, 2) ; Gender
			LOCAL = 100-PERC_SETS:0:0-PERC_SETS:0:1-PERC_SETS:0:2+PERC_SETS:0:CURRENT_GENDER
		ELSEIF INRANGE(RESULT, 3, 8) ;Virgin
			LOCAL = 100-PERC_SETS:1:CURRENT_GENDER-PERC_SETS:2:CURRENT_GENDER+PERC_SETS:CURRENT_TALENT:CURRENT_GENDER
		ELSEIF INRANGE(RESULT, 9, 17) ;Clueless to slut
			LOCAL = 100-PERC_SETS:3:CURRENT_GENDER-PERC_SETS:4:CURRENT_GENDER-PERC_SETS:5:CURRENT_GENDER+PERC_SETS:CURRENT_TALENT:CURRENT_GENDER+PERC_SETS:CURRENT_TALENT:CURRENT_GENDER
		ELSEIF INRANGE(RESULT, 18, 32) ;Height
			LOCAL = 100-PERC_SETS:6:CURRENT_GENDER-PERC_SETS:7:CURRENT_GENDER-PERC_SETS:8:CURRENT_GENDER-PERC_SETS:9:CURRENT_GENDER-PERC_SETS:10:CURRENT_GENDER+PERC_SETS:CURRENT_TALENT:CURRENT_GENDER
		ELSEIF INRANGE(RESULT, 33, 47) ;Breasts
			LOCAL = 100-PERC_SETS:11:CURRENT_GENDER-PERC_SETS:12:CURRENT_GENDER-PERC_SETS:13:CURRENT_GENDER-PERC_SETS:14:CURRENT_GENDER-PERC_SETS:15:CURRENT_GENDER+PERC_SETS:CURRENT_TALENT:CURRENT_GENDER
		ELSEIF INRANGE(RESULT, 54, 68) ;Animal Ears
			LOCAL = 100-PERC_SETS:18:CURRENT_GENDER-PERC_SETS:19:CURRENT_GENDER-PERC_SETS:20:CURRENT_GENDER-PERC_SETS:21:CURRENT_GENDER-PERC_SETS:22:CURRENT_GENDER+PERC_SETS:CURRENT_TALENT:CURRENT_GENDER
		ELSEIF INRANGE(RESULT, 69, 92) ;Butt
			LOCAL = 100-PERC_SETS:23:CURRENT_GENDER-PERC_SETS:24:CURRENT_GENDER-PERC_SETS:25:CURRENT_GENDER-PERC_SETS:26:CURRENT_GENDER-PERC_SETS:27:CURRENT_GENDER-PERC_SETS:28:CURRENT_GENDER-PERC_SETS:29:CURRENT_GENDER-PERC_SETS:30:CURRENT_GENDER+PERC_SETS:CURRENT_TALENT:CURRENT_GENDER
		ELSEIF INRANGE(RESULT, 93, 113) ;Hypnosis
			LOCAL = 100-PERC_SETS:31:CURRENT_GENDER-PERC_SETS:32:CURRENT_GENDER-PERC_SETS:33:CURRENT_GENDER-PERC_SETS:34:CURRENT_GENDER-PERC_SETS:35:CURRENT_GENDER-PERC_SETS:36:CURRENT_GENDER-PERC_SETS:37:CURRENT_GENDER-PERC_SETS:38:CURRENT_GENDER+PERC_SETS:CURRENT_TALENT:CURRENT_GENDER
		ELSE
			LOCAL = 100
		ENDIF
		;Get and Set user input
		IF LOCAL > 0
			PRINTFORML 0과 {LOCAL} 사이에 퍼센트를 삽입한다.
			INPUT
			IF !INRANGE(RESULT, 0, LOCAL)
				PRINTW 잘못된 입력
				GOTO REPRINT
			ELSE
				IF CURRENT_TALENT == 0 || CHOOSE_BY_GENDER == 1
					PERC_SETS:CURRENT_TALENT:CURRENT_GENDER = RESULT
				ELSE
					PERC_SETS:CURRENT_TALENT:0 = RESULT
					PERC_SETS:CURRENT_TALENT:1 = RESULT
					PERC_SETS:CURRENT_TALENT:2 = RESULT
				ENDIF
			ENDIF
		ELSE
			PRINTW 관련 재능이 100%라서 증가시킬 수 없다.
		ENDIF
	CASE 994
		PRINTL 정말로 확신하는가, 이것은 초기화하거나 이 작업이 이루어지지 않은 세이브를 불러와야만 비활성화할 수 있다.
		CALL ASK_YN()
		IF RESULT == 0
			CHOOSE_BY_GENDER = 1
		ENDIF
	CASE 995
		PRINTL 정말 모든 것을 초기화하시겠습니까?
		CALL ASK_YN()
		IF RESULT == 0
			CHOOSE_BY_GENDER = 0
			FOR LOCAL, 0, 31
			PERC_SETS:LOCAL:0 = 0
			PERC_SETS:LOCAL:1 = 0
			PERC_SETS:LOCAL:2 = 0
			NEXT
		ENDIF
	CASE 996
		CALL EXCLUDE_CHARACTERS()
	CASE 997
		LOADGLOBAL
		PRINTL 설정 저장
		PRINTFORML [0] 슬롯 0 \@ STRLENS(RANDOM_SAVE_MENU_NAMES:0) > 0 ? - %RANDOM_SAVE_MENU_NAMES:0% #  \@
		PRINTFORML [1] 슬롯 1 \@ STRLENS(RANDOM_SAVE_MENU_NAMES:1) > 0 ? - %RANDOM_SAVE_MENU_NAMES:1% #  \@
		PRINTFORML [2] 슬롯 2 \@ STRLENS(RANDOM_SAVE_MENU_NAMES:2) > 0 ? - %RANDOM_SAVE_MENU_NAMES:2% #  \@
