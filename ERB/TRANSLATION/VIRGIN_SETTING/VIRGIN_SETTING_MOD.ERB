		ELSE
			TALENT:CHARA_ID:2 = CSVTALENT(NO:CHARA_ID,2)
			TALENT:CHARA_ID:形状 = CSVTALENT(NO:CHARA_ID,250)
		ENDIF
		CURRENT_GENDER = (TALENT:CHARA_ID:2 - 1)
		;VIRGIN NON_VIRGIN
		LOCAL = RAND:100+1
