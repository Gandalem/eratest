			TALENT:CHARA_ID:108 = CustomTraits_ButtSize(CHARA_ID)
		ENDIF
		;HYPNO_RESISTANCES, added
		IF LOCAL <= PERC_SETS:31:CURRENT_GENDER
			DamageResist:CHARA_ID:36:0 = -3
		ELSEIF LOCAL <= PERC_SETS:31:CURRENT_GENDER+PERC_SETS:32:CURRENT_GENDER
			DamageResist:CHARA_ID:36:0 = -2
		ELSEIF LOCAL <= PERC_SETS:31:CURRENT_GENDER+PERC_SETS:32:CURRENT_GENDER+PERC_SETS:33:CURRENT_GENDER
			DamageResist:CHARA_ID:36:0 = -1
		ELSEIF LOCAL <= PERC_SETS:31:CURRENT_GENDER+PERC_SETS:32:CURRENT_GENDER+PERC_SETS:33:CURRENT_GENDER+PERC_SETS:34:CURRENT_GENDER
			DamageResist:CHARA_ID:36:0 = 0
		ELSEIF LOCAL <= PERC_SETS:31:CURRENT_GENDER+PERC_SETS:32:CURRENT_GENDER+PERC_SETS:33:CURRENT_GENDER+PERC_SETS:34:CURRENT_GENDER+PERC_SETS:35:CURRENT_GENDER
			DamageResist:CHARA_ID:36:0 = 1
		ELSEIF LOCAL <= PERC_SETS:31:CURRENT_GENDER+PERC_SETS:32:CURRENT_GENDER+PERC_SETS:33:CURRENT_GENDER+PERC_SETS:34:CURRENT_GENDER+PERC_SETS:35:CURRENT_GENDER+PERC_SETS:36:CURRENT_GENDER
			DamageResist:CHARA_ID:36:0 = 2
		ELSEIF LOCAL <= PERC_SETS:31:CURRENT_GENDER+PERC_SETS:32:CURRENT_GENDER+PERC_SETS:33:CURRENT_GENDER+PERC_SETS:34:CURRENT_GENDER+PERC_SETS:35:CURRENT_GENDER+PERC_SETS:36:CURRENT_GENDER+PERC_SETS:37:CURRENT_GENDER
			DamageResist:CHARA_ID:36:0 = 3
		ELSEIF LOCAL <= PERC_SETS:31:CURRENT_GENDER+PERC_SETS:32:CURRENT_GENDER+PERC_SETS:33:CURRENT_GENDER+PERC_SETS:34:CURRENT_GENDER+PERC_SETS:35:CURRENT_GENDER+PERC_SETS:36:CURRENT_GENDER+PERC_SETS:37:CURRENT_GENDER+PERC_SETS:38:CURRENT_GENDER
			DamageResist:CHARA_ID:36:0 = 4
		ELSEIF LOCAL <= PERC_SETS:31:CURRENT_GENDER+PERC_SETS:32:CURRENT_GENDER+PERC_SETS:33:CURRENT_GENDER+PERC_SETS:34:CURRENT_GENDER+PERC_SETS:35:CURRENT_GENDER+PERC_SETS:36:CURRENT_GENDER+PERC_SETS:37:CURRENT_GENDER+PERC_SETS:38:CURRENT_GENDER+PERC_SETS:39:CURRENT_GENDER
			DamageResist:CHARA_ID:36:0 = 5
		ELSEIF LOCAL <= PERC_SETS:31:CURRENT_GENDER+PERC_SETS:32:CURRENT_GENDER+PERC_SETS:33:CURRENT_GENDER+PERC_SETS:34:CURRENT_GENDER+PERC_SETS:35:CURRENT_GENDER+PERC_SETS:36:CURRENT_GENDER+PERC_SETS:37:CURRENT_GENDER+PERC_SETS:38:CURRENT_GENDER+PERC_SETS:39:CURRENT_GENDER+PERC_SETS:40:CURRENT_GENDER
			DamageResist:CHARA_ID:36:0 = 6
		ELSEIF LOCAL <= PERC_SETS:31:CURRENT_GENDER+PERC_SETS:32:CURRENT_GENDER+PERC_SETS:33:CURRENT_GENDER+PERC_SETS:34:CURRENT_GENDER+PERC_SETS:35:CURRENT_GENDER+PERC_SETS:36:CURRENT_GENDER+PERC_SETS:37:CURRENT_GENDER+PERC_SETS:38:CURRENT_GENDER+PERC_SETS:39:CURRENT_GENDER+PERC_SETS:40:CURRENT_GENDER+PERC_SETS:41:CURRENT_GENDER
			DamageResist:CHARA_ID:36:0 = 7
		ELSE
			DamageResist:CHARA_ID:36:0 = CustomTraits_HypnoResistance(CHARA_ID)
		ENDIF
		NEXT
		PRINTFORMDW {LOCAL:3}에 무작위화가 적용되었다 \@ LOCAL:3 != 1 ? 캐릭터들 # 캐릭터 \@.
	CASE 1000
		RETURN
ENDSELECT
GOTO REPRINT

@EXCLUDE_CHARACTERS
#DIM EXCLUDED_CHARACTERS
#DIM CREDRAW
#DIM FIRST_LINE
FIRST_LINE = LINECOUNT
$REPRINT
CLEARLINE LINECOUNT - FIRST_LINE
CREDRAW = CURRENTREDRAW()
REDRAW 0
EXCLUDED_CHARACTERS = 0
PRINTL 빨간색 캐릭터는 무작위 선택에서 제외된다.
DRAWLINE
FOR LOCAL, 1, CHARANUM-1
IF CFLAG:LOCAL:RANDOM_MENU_EXCLUSION
	SETCOLOR C_D_RED
	EXCLUDED_CHARACTERS++
ENDIF
PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
RESETCOLOR
NEXT
PRINTL
DRAWLINE
PRINTL [995] - 설정 저장　[996] - 설정 불러오기	
PRINTL [997] - 선택 반전　[998] - 초기화
PRINTFORML [999] - 완료 (제외된 캐릭터: {EXCLUDED_CHARACTERS} \@ EXCLUDED_CHARACTERS != 1 ? 캐릭터들 # 캐릭터 \@)
INPUT
IF INRANGE(RESULT, 1, CHARANUM-1)
	CFLAG:RESULT:RANDOM_MENU_EXCLUSION = !CFLAG:RESULT:RANDOM_MENU_EXCLUSION
	GOTO REPRINT
ELSEIF RESULT == 995
	LOADGLOBAL
	PRINTL 제외 설정 저장.
	PRINTFORML [0] 슬롯 0 \@ STRLENS(RANDOM_SAVE_MENU_NAMES:3) > 0 ? - %RANDOM_SAVE_MENU_NAMES:3% #  \@
	PRINTFORML [1] 슬롯 1 \@ STRLENS(RANDOM_SAVE_MENU_NAMES:4) > 0 ? - %RANDOM_SAVE_MENU_NAMES:4% #  \@
	PRINTFORML [2] 슬롯 2 \@ STRLENS(RANDOM_SAVE_MENU_NAMES:5) > 0 ? - %RANDOM_SAVE_MENU_NAMES:5% #  \@
	INPUT
	IF !INRANGE(RESULT, 0, 2)
		PRINTW 지정된 옵션 내에서 유지해 주세요.
		GOTO REPRINT
	ENDIF
	LOCAL = RESULT
	PRINTFORML 슬롯 {LOCAL}에 이름을 지정해 주세요, 비워두면 취소합니다.
	INPUTS
	IF STRLENS(RESULTS) <= 0
		GOTO REPRINT
	ELSE
		CALL SAVE_EXCLUDE_CHARACTERS(RESULTS, LOCAL, 1)
		GOTO REPRINT
	ENDIF
ELSEIF RESULT == 996
	LOADGLOBAL
	PRINTL 제외 설정 로드하기
	PRINTFORML [0] 슬롯 0 \@ STRLENS(RANDOM_SAVE_MENU_NAMES:3) > 0 ? - %RANDOM_SAVE_MENU_NAMES:3% #  \@
	PRINTFORML [1] 슬롯 1 \@ STRLENS(RANDOM_SAVE_MENU_NAMES:4) > 0 ? - %RANDOM_SAVE_MENU_NAMES:4% #  \@
	PRINTFORML [2] 슬롯 2 \@ STRLENS(RANDOM_SAVE_MENU_NAMES:5) > 0 ? - %RANDOM_SAVE_MENU_NAMES:5% #  \@
	INPUT
	IF !INRANGE(RESULT, 0, 2)
		PRINTW 지정된 옵션 내에서 유지해 주세요.
		GOTO REPRINT
	ELSE
		CALL LOAD_EXCLUDE_CHARACTERS(RESULT, 1)
		GOTO REPRINT
	ENDIF
ELSEIF RESULT == 997
	FOR LOCAL, 1, CHARANUM-1
	CFLAG:LOCAL:RANDOM_MENU_EXCLUSION = !CFLAG:LOCAL:RANDOM_MENU_EXCLUSION
	NEXT
	GOTO REPRINT
ELSEIF RESULT == 998
	FOR LOCAL, 1, CHARANUM-1
	CFLAG:LOCAL:RANDOM_MENU_EXCLUSION = 0
	NEXT
	GOTO REPRINT
ELSEIF RESULT == 999
	PRINTW 제외 설정이 완료되었다.
ENDIF
;Saves excluded character configuration
;ARG:0 - Which slot to save to
;ARG:1 - Which type, 0 is tied to percentage and thus doesn't have a name. 1 is independent.

@SAVE_EXCLUDE_CHARACTERS(ARGS, ARG, ARG:1=0)
#DIM SAVE_SLOT_NUMBER
#DIM SAVE_SLOT
LOADGLOBAL
SAVE_SLOT_NUMBER = ARG
IF ARG:1 == 0
	SAVE_SLOT = SAVE_SLOT_NUMBER
ELSEIF ARG:1 == 1
	SAVE_SLOT = SAVE_SLOT_NUMBER + 3
ENDIF
SIF ARG:1
	RANDOM_SAVE_MENU_NAMES:SAVE_SLOT = %ARGS%
FOR LOCAL, 1, CHARANUM-1
RANDOM_MENU_EXCLUDE:SAVE_SLOT:LOCAL = CFLAG:LOCAL:RANDOM_MENU_EXCLUSION
NEXT
SAVEGLOBAL
IF ARG:1 == 1
	PRINTFORMW 슬롯 {SAVE_SLOT_NUMBER} 설정이 저장되었습니다.
ENDIF
;Loads excluded character configuration
;ARG:0 - Which slot to load
;ARG:1 - Which type, 0 is tied to percentage and thus doesn't have a name. 1 is independent.

@LOAD_EXCLUDE_CHARACTERS(ARG, ARG:1=0)
#DIM LOAD_SLOT_NUMBER
#DIM LOAD_SLOT
LOADGLOBAL
LOAD_SLOT_NUMBER = ARG
IF ARG:1 == 0
	LOAD_SLOT = LOAD_SLOT_NUMBER
ELSEIF ARG:1 == 1
	LOAD_SLOT = LOAD_SLOT_NUMBER + 3
ENDIF
FOR LOCAL, 1, CHARANUM-1
CFLAG:LOCAL:RANDOM_MENU_EXCLUSION = RANDOM_MENU_EXCLUDE:LOAD_SLOT:LOCAL
NEXT
IF ARG:1 == 1
	PRINTFORMW 슬롯 {LOAD_SLOT_NUMBER} 설정이 불러와졌다.
ENDIF
