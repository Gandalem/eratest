@MESSAGE_COM0_TR
IF FLAG:70 == 1
	PRINTFORM %ONGOING_NAME(MASTER)%가 조심스럽게 %ONGOING_G(TARGET)%를 어루만졌다.
	;小柄体型
	IF TALENT:体型 == -2
		PRINT  어린아이 같은
	ELSEIF TALENT:体型 == -1
		PRINT  작은
	ELSEIF TALENT:体型 == -5
		PRINT  인형 크기의
	ENDIF
	IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		PRINTFORML  시간이 멈춘 동안 %HIM_HER(TARGET)%을 강간하며 몸이...
	ELSE
		PRINTL  시간이 멈춘 동안 몸이…
	ENDIF
	IF NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂 || NOWEX:Ｂ絶頂 || NOWEX:Ｍ絶頂
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% \@ TEQUIP:50 == PLAYER ? 질 # 항문 \@이 당신의 %TINKO(PLAYER)% 위로 움켜쥐며, 그 감각을 즐기는 동안 떨린다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 완전히 움직이지 않은 채 절정에 도달하며 성적인 체액을 사방에 뿌린다...
		ENDIF
	ELSE
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORML 당신은 %조사처리(CALLNAME:TARGET,"의")% 몸을 더듬으며 %HIS_HER(TARGET)%를 즐긴다 \@ TEQUIP:50 == PLAYER ? %SLIT(TARGET)% # 항문 \@....
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 얼굴은 시간이 멈춘 듯 굳어 있는데, %HIS_HER(TARGET)%의 몸이 가지고 놀아지고 있다...
		ENDIF
	ENDIF
ELSEIF CFLAG:MASTER:イタズラ == 2
	PRINTFORM %ONGOING_NAME(MASTER)%조심스럽게 %SLEEPING_LIFELESS(TARGET)%의 %ONGOING_G(TARGET)%를 어루만졌다.
	;小柄体型
	IF TALENT:体型 == -2
		PRINT  어린아이 같은
	ELSEIF TALENT:体型 == -1
		PRINT  작은
	ELSEIF TALENT:体型 == -5
		PRINT  인형 크기의
	ENDIF
	IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		PRINTFORML  몸을 탐하며 %HIM_HER(TARGET)%를 범한다...
	ELSE
		PRINTL  본문...
	ENDIF
	IF NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂 || NOWEX:Ｂ絶頂 || NOWEX:Ｍ絶頂
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% \@ TEQUIP:50 == PLAYER ? 질 # 항문 \@이 당신의 %TINKO(PLAYER)% 위로 움켜쥐며, 그 감각을 즐기는 동안 떨린다...
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %SLEEPING_LIFELESS(TARGET),1%하는 동안 절정에 도달하며, 성적인 체액을 사방에 뿌린다.
		ENDIF
	ELSE
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORML 당신은 %SLEEPING_LIFELESS(TARGET)% %조사처리(CALLNAME:TARGET,"의")% %SLEEPING_LIFELESS(TARGET,2)%을 만지며 %HIS_HER(TARGET)%를 즐긴다 \@ TEQUIP:50 == PLAYER ? %SLIT(TARGET)% # 항문 \@...
		ELSE
			PRINTFORML %SLEEPING_LIFELESS(TARGET,3)%의 몸이 가지고 놀아진다... %HIS_HER(TARGET)%.
		ENDIF
	ENDIF
ELSE
	PRINTFORM %ONGOING_NAME(MASTER)%가 조심스럽게 %ONGOING_G(TARGET)%를 어루만졌다.
	;幼児体型
	SIF TALENT:体型 == -2
		PRINT  어린아이 같은
	PRINT  본문
	IF !RAND:2 && ((TEQUIP:50 == PLAYER && ABL:Ｖ感覚 >= 5) || (TEQUIP:51 == PLAYER && ABL:Ａ感覚 >= 5))
		SELECTCASE RAND:4
			CASE 3
				PRINTFORM , %HIS_HER(TARGET)%는 즐거움으로 녹아내리는 얼굴을 한다.
			CASE 2
				PRINTFORM %HIS_HER(TARGET)%의 뺨이 붉어진다.
			CASE 1
				PRINTFORM , %TNAME(TARGET)%이 달콤한 신음을 내뱉으며
			CASE 0
				PRINTFORM , %TNAME(TARGET)%이 크게 신음한다
		ENDSELECT
		SELECTCASE RAND:5
			CASE 4
				PRINTFORM  네가 골반을 밀어붙이자
			CASE 3
				PRINTFORM  %HE_SHE(TARGET)%이(가) %HIM_HER(TARGET)% 안의 %TINKO(PLAYER)%의 느낌을 즐긴다.
			CASE 2
				PRINTFORM  %HIS_HER(TARGET)%은(는) %TINKO(PLAYER)%의 질감을 음미한다.
			CASE 1
				PRINTFORM 완전히 쾌락에 몸을 맡긴 채
			CASE 0
				PRINTFORM  당신이 %HIM_HER(TARGET)%의 깊은 곳을 파고들 때
		ENDSELECT
	ELSEIF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
		SELECTCASE TEQUIP:体位
			CASE POSE_MISSIONARY, POSE_STANDING_MISSIONARY
				PRINTFORM  %HIM_HER(TARGET)%에게 밀어 넣으며
			CASE POSE_DOGGYSTYLE, POSE_STANDING_FROM_BEHIND
				PRINTFORM  뒤에서 %HIM_HER(TARGET)%에게 밀어붙이는 동안
			CASE POSE_COWGIRL, POSE_REVLOTUS, POSE_REV_SUSPENDED_CONGRESS, POSE_REV_COWGIRL
				PRINTFORM  아래에서부터 %HIM_HER(TARGET)%에게 박아 올리면서
			CASE POSE_LOTUS, POSE_SUSPENDED_CONGRESS
				PRINTFORM  서로를 안은 채로
			CASE POSE_ONAHOLE, POSE_STANDING_ONAHOLE
				PRINTFORM  %HIM_HER(TARGET)%을 장난감으로 사용하면서
			CASEELSE
				PRINTFORM  %HIM_HER(TARGET)%에게 박아 넣는 동안
		ENDSELECT
	ENDIF
	PRINTL ...
	IF NOWEX:Ｃ絶頂 || NOWEX:Ｖ絶頂 || NOWEX:Ａ絶頂 || NOWEX:Ｂ絶頂 || NOWEX:Ｍ絶頂
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORML %CALLNAME:TARGET%의은/는 \@ TEQUIP:50 == PLAYER ? 질 # 항문 \@이 당신을 감싼다 매번 당신이 %HIM_HER(TARGET)%를 만질 때.
		ELSE
			PRINTFORML %조사처리(CALLNAME:TARGET,"의")% 몸이 당신에게 %HE_SHE(TARGET)%가 만질 때마다 움찔거린다.
		ENDIF
		IF EXP_UP(27,TARGET)
			PRINTFORML %HIS_HER(TARGET,1)%의 얼굴은 쾌감으로 녹아내리고 있으며 %HE_SHE(TARGET)%는 당신의 입술에 닿으려고 노력한다...
		ELSE
			PRINTFORML %HE_SHE(TARGET,1)%은/는 숨을 거칠게 몰아쉬며 즐거움을 참으려 한다...
		ENDIF
	ELSE
		IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
			PRINTFORM %조사처리(CALLNAME:TARGET,"가")% 당신의 %TINKO(PLAYER)% 주위를 조인다.
		ELSE
			PRINTFORM %조사처리(CALLNAME:TARGET,"는")%(는) 당신에게 더 바짝 다가온다.
		ENDIF
		IF EXP_UP(27,TARGET)
			IF TEQUIP:50 == PLAYER || TEQUIP:51 == PLAYER
				PRINTFORML 더 가까워지고 싶어서...
			ELSE
				PRINTFORML 당신의 입술을 찾으며...
			ENDIF
		ELSE
			PRINTFORML 몸이 떨린다, 그 쾌감에 응답하며...
		ENDIF
	ENDIF
ENDIF
