@MESSAGE_COM1_TR
VARSET LOCAL
IF FLAG:70 == 1
	IF TALENT:体型 == -2
		IF TCVAR:100 == PLAYER
			IF TCVAR:102
				PRINTFORML %ONGOING_NAME(MASTER)%은 정액을 %조사처리(CALLNAME:TARGET,"에게")% 끝까지 쏟아내고 당신의 성기를 빼낸다.
				PRINTFORML %HIS_HER(TARGET,1)%한 작은 구멍은 비정상적으로 큰 물체가 제거된 후 천천히 모양을 되찾으며 조여온다.
				PRINTFORML 그것은 더 이상 정액이 새지 않도록 스스로 닫힌다.
			ELSE
				PRINTFORML %ONGOING_NAME(MASTER)% 자신의 성기를 %CALLNAME:TARGET%에게서 빼낸다.
				PRINTFORML %HIS_HER(TARGET,1)%의 작은 구멍은 불균형하게 큰 물체가 제거된 후 천천히 모양을 되찾고 조여온다.
			ENDIF
			PRINTFORM 당신은 젊은 %조사처리(CALLNAME:TARGET,"의")% 다리를 벌리고 시작한다. 
			IF EXP:PLAYER:時姦経験 >= EXP:TARGET:愛情経験 + 50 && !GETBIT(TALENT:性別,1)
				PRINTFORML 시간이 멈춘 동안 %HIS_HER(TARGET)%의 음핵을 빨고 있다...
			ELSEIF GETBIT(TALENT:性別,1)
				PRINTFORML 시간이 멈춘 동안 부드럽게 입을 축이고 %HIS_HER(TARGET)%를 어루만진다 %HIS_HER(TARGET)% %TINKO(TARGET)%.
			ELSE
				PRINTFORML 시간이 멈춘 동안 부드럽게 %HIS_HER(TARGET)%의 입을 핥았다...
			ENDIF
		ELSE
			PRINTFORM %ONGOING_NAME(MASTER)% 
			IF HAS_PANTY_MOVEMENT()
				PRINTFORM %PRINT_PANTY_MOVEMENT(TARGET, MASTER)%, 
			ELSEIF TEQUIP:0 & 1
				PRINTFORM %ONGOING_G(TARGET)%의 %SHOW_BOTTOM(TARGET,1)%를 말아 올렸다. 
			ENDIF
			SIF PALAM:潤滑 >= PALAMLV:4
				PRINTFORM 
			PRINTFORM 젊은이 %조사처리(CALLNAME:TARGET,"의")% 다리 %COND_STR(",", HAS_PANTY_MOVEMENT() || TEQUIP:0 & 1)%를 벌리고 
			IF EXP:PLAYER:時姦経験 >= EXP:TARGET:愛情経験 + 50 && !GETBIT(TALENT:性別,1)
				PRINTFORM 시간이 멈춘 듯... 탐욕스럽게 핥기 위해 %HIS_HER(TARGET)%의 입술을 벌린다.%PRINT_PANTY_HOLE(TARGET, "v")%
			ELSEIF GETBIT(TALENT:性別,1)
				PRINTFORM 시간이 멈춘 듯, 부드럽게 %HIS_HER(TARGET)% 구멍%PRINT_PANTY_HOLE(TARGET, "v")%을 핥으며 %HIS_HER(TARGET)% %TINKO(TARGET)%를 어루만진다...
			ELSE
				PRINTFORM 시간이 멈춘 가운데 %HIS_HER(TARGET)%의 개방부%PRINT_PANTY_HOLE(TARGET, "v")%를 부드럽게 핥았다.
			ENDIF
			CALL PRINT_BREAK
		ENDIF
	ELSE
		IF TCVAR:100 == PLAYER
			PRINTFORM %ONGOING_NAME(MASTER)%은/는 %ONGOING_G(TARGET)%의 질에서 거기를 빼낸다. 
			IF TCVAR:102
				PRINTFORM 너 방금 안에 사정했구나 
			ENDIF
		ELSEIF HAS_PANTY_MOVEMENT()
			PRINTFORM %ONGOING_NAME(MASTER)% %PRINT_PANTY_MOVEMENT(TARGET, MASTER,,,1)% 
		ELSEIF TEQUIP:0 & 1
			PRINTFORM %ONGOING_NAME(MASTER)% 말아 올리다 %ONGOING_G(TARGET)% %SHOW_BOTTOM(TARGET,1)% 
		ELSE
			PRINTFORM %ONGOING_NAME(MASTER)%이/가 %ONGOING_G(TARGET)%의 다리를 벌린다. 
		ENDIF
		PRINTFORM 그리고 %HIS_HER(TARGET)%의 핥기 시작한다. 
		IF TALENT:体型 < 0
			PRINT 작은 구멍
		ELSE
			PRINT 틈
		ENDIF
		PRINTFORM %PRINT_PANTY_HOLE(TARGET, "v")%
		;ふたなり＋欲情のPLAMLV4以上
		IF GETBIT(TALENT:性別,1) && PALAM:欲情 >= PALAMLV:4
			PRINTFORM 동시에 당신의 혀가 %HIS_HER(TARGET)%의 발기된 %TINKO(TARGET)% 위를 오르내리게 한다.
			;ふたなり
		ELSEIF GETBIT(TALENT:性別,1)
			PRINTFORM 또한 당신의 혀로 %HIS_HER(TARGET)%의 %TINKO(TARGET)% 주변을 핥으면서,
			;欲情のPALAMLV4以上
		ELSEIF PALAM:欲情 >= PALAMLV:4
			PRINTFORM 음핵을 빨고 혀로 때린다.
		ENDIF
		PRINT ...
		CALL PRINT_BREAK
	ENDIF
ELSEIF CFLAG:PLAYER:イタズラ == 2
	IF TALENT:体型 == -2
		IF TCVAR:100 == PLAYER
			IF TCVAR:102
				PRINTFORML %ONGOING_NAME(MASTER)% 정액을 %SLEEPING_LIFELESS(TARGET)%에 다 부은 후 빼라 %CALLNAME:TARGET%.
				PRINTFORML %HIS_HER(TARGET,1)%의 작은 구멍이 과도하게 큰 물체가 제거된 후 천천히 형상을 되찾고 조여왔다.
				PRINTFORML 더 이상 정액을 흘리지 않으며 스스로 닫혔다.
			ELSE
				PRINTFORML %ONGOING_NAME(MASTER)%당신의 거시기%SLEEPING_LIFELESS(TARGET)%에서 %조사처리(CALLNAME:TARGET,"를")% 빼내라.
				PRINTFORML %HIS_HER(TARGET,1)%그 불균형하게 큰 물체가 제거된 후, 작은 구멍은 천천히 형상을 되찾고 조여들었다.
			ENDIF
			PRINTFORM 당신은 %SLEEPING_LIFELESS(TARGET)%의 %CALLNAME:TARGET%'의 다리를 벌리고 시작한다. 
			IF EXP:PLAYER:時姦経験 >= EXP:TARGET:愛情経験 + 50 && !GETBIT(TALENT:性別,1)
				PRINTFORML %HIS_HER(TARGET)%의 음핵을 빨고 있다...
			ELSEIF GETBIT(TALENT:性別,1)
				PRINTFORML 부드럽게 핥으며 %HIS_HER(TARGET)%을 열고 %HIS_HER(TARGET)%을 어루만진다 %TINKO(TARGET)%...
			ELSE
				PRINTFORML 부드럽게 %HIS_HER(TARGET)%의 입을 핥는다...
			ENDIF
		ELSE
			PRINTFORM %ONGOING_NAME(MASTER)% 
			IF HAS_PANTY_MOVEMENT()
				PRINTFORM %PRINT_PANTY_MOVEMENT(TARGET, MASTER)%, 
			ELSEIF TEQUIP:0 & 1
				PRINTFORM %ONGOING_G(TARGET)%의 %SHOW_BOTTOM(TARGET,1)%를 말아 올렸다. 
			ENDIF
			SIF PALAM:潤滑 >= PALAMLV:4
				PRINTFORM 
			PRINTFORM 잠든 %조사처리(CALLNAME:TARGET,"의")% 다리를 벌리고 
			IF EXP:PLAYER:時姦経験 >= EXP:TARGET:愛情経験 + 50 && !GETBIT(TALENT:性別,1)
				PRINTFORM %HIS_HER(TARGET)%의 입술을 벌리고 탐욕스럽게 핥는다%PRINT_PANTY_HOLE(TARGET, "v")%...
			ELSEIF GETBIT(TALENT:性別,1)
				PRINTFORM 부드럽게 %HIS_HER(TARGET)% 입구%PRINT_PANTY_HOLE(TARGET, "v")%를 핥으면서 %HIS_HER(TARGET)% %TINKO(TARGET)%을 쓰다듬었다...
			ELSE
				PRINTFORM 부드럽게 %HIS_HER(TARGET)%의 개방된%PRINT_PANTY_HOLE(TARGET, "v")%를 핥는다...
			ENDIF
			CALL PRINT_BREAK
		ENDIF
	ELSE
		IF TCVAR:100 == PLAYER
			PRINTFORM %ONGOING_NAME(MASTER)%은/는 %ONGOING_G(TARGET)%의 질에서 거기를 빼낸다. 
			IF TCVAR:102
				PRINTFORM 너 방금 안에 사정했구나 
			ENDIF
		ELSEIF HAS_PANTY_MOVEMENT()
			PRINTFORM %ONGOING_NAME(MASTER)% %PRINT_PANTY_MOVEMENT(TARGET, MASTER,,,1)% 
		ELSEIF TEQUIP:0 & 1
			PRINTFORM %ONGOING_NAME(MASTER)% 말아 올리다 %ONGOING_G(TARGET)% %SHOW_BOTTOM(TARGET,1)% 
		ELSE
			PRINTFORM %ONGOING_NAME(MASTER)%이/가 %ONGOING_G(TARGET)%의 다리를 벌린다. 
		ENDIF
		PRINTFORM 그리고 %HIS_HER(TARGET)%의 핥기 시작한다. 
		IF TALENT:体型 < 0
			PRINT 작은 구멍
		ELSE
			PRINT 틈
		ENDIF
		;ふたなり＋欲情のPLAMLV4以上
		IF IS_HERM(TARGET) && PALAM:欲情 >= PALAMLV:4
			PRINTFORM 동시에 당신의 혀가 %HIS_HER(TARGET)%의 발기된 %TINKO(TARGET)% 위를 오르내리게 한다.
			;ふたなり
		ELSEIF IS_HERM(TARGET)
			PRINTFORM 또한 당신의 혀로 %HIS_HER(TARGET)%의 %TINKO(TARGET)% 주변을 핥으면서,
			;欲情のPALAMLV4以上
		ELSEIF PALAM:欲情 >= PALAMLV:4
			PRINTFORM 음핵을 빨고 혀로 때린다.
		ENDIF
		PRINT ...
		CALL PRINT_BREAK
	ENDIF
ELSE
	IF TCVAR:100 == PLAYER
		PRINTFORM %ONGOING_NAME(MASTER)%의 %TINKO(PLAYER)%를 %ONGOING_G(TARGET)% 안에서 꺼내라
	ELSEIF HAS_PANTY_MOVEMENT()
		IF TALENT:恋慕
			PRINTFORM %ONGOING_NAME(TARGET)% %PRINT_PANTY_MOVEMENT(TARGET, TARGET)%
			LOCAL = 1
		ELSE
			PRINTFORM %ONGOING_NAME(MASTER)% %PRINT_PANTY_MOVEMENT(TARGET, MASTER)%
		ENDIF
	ELSEIF TEQUIP:0 & 1
		IF TALENT:恋慕
			PRINTFORM %ONGOING_NAME(TARGET)%이(가) %HIS_HER(TARGET)%를/을 %SHOW_BOTTOM(TARGET,1)%로 끌어올린다.
			LOCAL = 1
		ELSE
			PRINTFORM %ONGOING_NAME(MASTER)%을/를 꺼내다 %ONGOING_G(TARGET)% %SHOW_BOTTOM(TARGET,1)%
		ENDIF
	ELSE
		IF TALENT:恋慕
			PRINTFORM %ONGOING_NAME(TARGET)%이/가 %HIS_HER(TARGET)% 다리를 벌리고 있다.
			LOCAL = 1
		ELSE
			PRINTFORM %ONGOING_NAME(MASTER)%이/가 %ONGOING_G(TARGET)%의 다리를 벌린다.
		ENDIF
	ENDIF
	IF LOCAL
		PRINTFORM 그리고 당신은 
	ELSE
		PRINTFORM  그리고 
	ENDIF
	PRINTFORM 핥기 시작한다 %HIS_HER(TARGET)% %SLIT_TR(TARGET)%%PRINT_PANTY_HOLE(TARGET, "v")%
	;ふたなり＋欲情のPLAMLV4以上
	IF IS_HERM(TARGET) && PALAM:欲情 >= PALAMLV:4
		PRINTFORM 그리고 당신의 혀를 위아래로 움직이며 %HIS_HER(TARGET)%의 %TINKO(TARGET)%까지 빨아들였다.
		;ふたなり
	ELSEIF IS_HERM(TARGET)
		PRINTFORM 그의 %HIS_HER(TARGET)%의 밑부분을 %TINKO(TARGET)%를 쓰다듬으며
		;欲情のPALAMLV4以上
	ELSEIF PALAM:欲情 >= PALAMLV:4
		PRINTFORM 당신의 혀로 %HIS_HER(TARGET)%의 음핵을 세게 문질렀다.
	ENDIF
	PRINT ...
	CALL PRINT_BREAK
ENDIF
