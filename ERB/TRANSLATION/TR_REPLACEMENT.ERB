@MESSAGE_COM2_TR
PRINTFORM %ONGOING_NAME(MASTER)%
SIF HAS_PANTY_MOVEMENT()
	PRINTFORM  %PRINT_PANTY_MOVEMENT(TARGET, PLAYER,,,1)%하고
PRINTFORM  %COND_STR(@" the %SLEEPING_LIFELESS(TARGET)%", CFLAG:MASTER:イタズラ == 2)%의 %CALLNAME:TARGET%'를 잡는다 
;欲情のPALAMLV4以上
SIF PALAM:欲情 >= PALAMLV:4
	PRINT 단단하고 발기된 
