; Modular ERB: 潜伏描写.ERB

@潜伏描写
;一行目 潜伏場所、現在のモード、潜伏率を表示
IF GETBIT(FLAG:潜伏,2)
	IF BASE:MASTER:潜伏率 >= 70
		PRINTFORM %CAPITALIZE(NAME_HIDING_PLACE_TR())% 
		SETCOLOR COLOR("赤")
		PRINTFORM 대화 모드
		RESETCOLOR
		SETCOLOR COLOR("緑")
		PRINTFORML (은/는) 은(는) 잠행률 {BASE:MASTER:潜伏率} 이다.
		RESETCOLOR
	ELSEIF BASE:MASTER:潜伏率 >= 40
		PRINTFORM %CAPITALIZE(NAME_HIDING_PLACE_TR())% 
		SETCOLOR COLOR("赤")
		PRINTFORM 대화 모드
		RESETCOLOR
		SETCOLOR COLOR("黄")
		PRINTFORML (은/는) 은(는) 숨김률 {BASE:MASTER:潜伏率}로 한다.
		RESETCOLOR
	ELSE
		PRINTFORM %CAPITALIZE(NAME_HIDING_PLACE_TR())% 
		SETCOLOR COLOR("赤")
		PRINTFORM 대화 모드
		RESETCOLOR
		SETCOLOR COLOR("赤")
		PRINTFORML (은(는) 잠복률 {BASE:MASTER:潜伏率})
		RESETCOLOR
	ENDIF
ELSEIF GETBIT(FLAG:潜伏,1)
	IF BASE:MASTER:潜伏率 >= 70
		PRINTFORM %CAPITALIZE(NAME_HIDING_PLACE_TR())% 
		SETCOLOR COLOR("黄")
		PRINTFORM 경계 모드
		RESETCOLOR
		SETCOLOR COLOR("緑")
		PRINTFORML (은/는) 은(는) 숨김률 {BASE:MASTER:潜伏率}로 한다.
		RESETCOLOR
	ELSEIF BASE:MASTER:潜伏率 >= 40
		PRINTFORM %CAPITALIZE(NAME_HIDING_PLACE_TR())% 
		SETCOLOR COLOR("黄")
		PRINTFORM 경계 모드
		RESETCOLOR
		SETCOLOR COLOR("黄")
		PRINTFORML (은/는) 은(는) 숨김률 {BASE:MASTER:潜伏率}로 한다.
		RESETCOLOR
	ELSE
		PRINTFORM %CAPITALIZE(NAME_HIDING_PLACE_TR())% 
		SETCOLOR COLOR("黄")
		PRINTFORM 경계 모드
		RESETCOLOR
		SETCOLOR COLOR("赤")
		PRINTFORML (은/는) 은(는) 숨김률 {BASE:MASTER:潜伏率}로 한다.
		RESETCOLOR
	ENDIF
ELSE
	IF BASE:MASTER:潜伏率 >= 70
		PRINTFORM %CAPITALIZE(NAME_HIDING_PLACE_TR())% 
		SETCOLOR COLOR("緑")
		PRINTFORM 잠행 모드
		RESETCOLOR
		SETCOLOR COLOR("緑")
		PRINTFORML (은/는) 은(는) 숨김률 {BASE:MASTER:潜伏率}로 한다.
		RESETCOLOR
	ELSEIF BASE:MASTER:潜伏率 >= 40
		PRINTFORM %CAPITALIZE(NAME_HIDING_PLACE_TR())% 
		SETCOLOR COLOR("緑")
		PRINTFORM 잠행 모드
		RESETCOLOR
		SETCOLOR COLOR("黄")
		PRINTFORML (은/는) 은(는) 숨김률 {BASE:MASTER:潜伏率}로 한다.
		RESETCOLOR
	ELSE
		PRINTFORM %CAPITALIZE(NAME_HIDING_PLACE_TR())% 
		SETCOLOR COLOR("緑")
		PRINTFORM 잠행 모드
		RESETCOLOR
		SETCOLOR COLOR("赤")
		PRINTFORML (은/는) 은(는) 숨김률 {BASE:MASTER:潜伏率}로 한다.
		RESETCOLOR
	ENDIF
ENDIF
