@SCHEDULE
;custom code
#DIM nLineCnt_Head
nLineCnt_Head = LINECOUNT
DO

SIF LINECOUNT - nLineCnt_Head > 0
	CLEARLINE LINECOUNT - nLineCnt_Head
PRINTFORML [ 0] - Set wake up time (Currently: %時刻表示(TIME:3)%)
PRINTFORML [ 1] - Change Sleeping Quarters (Currently: %NAME_FROM_PLACE(CFLAG:MASTER:初期位置)%%COND_STR(@", Landlord: %CALLNAME:拠点_大家%", 拠点_大家)%)
;SIF FLAG:住み込みキャラ== 0
;	PRINTL [2] - 住み込み
PRINTFORML [ 4] - Side Job (Currently：\@ FLAG:内職 ? On # Off \@)
PRINTFORML [ 5] - Change %CALLNAME:MASTER%'s name
SIF KNOW_RESEARCH("Alcohol"); research
PRINTFORML [ 6] - Move the jar with the sake bug (Currently: \@ !MAIN_MAP ? %STR_TR(拠点_酒虫)% # %STR_TR(拠点_酒虫 + 8000)% \@)
SIF ITEM:祭壇
	PRINTFORML [ 7] - Automatic prayer for love (Current target: \@ FLAG:自動縁結び ? %CALLNAME:(FLAG:自動縁結び)%# N/A\@)
;NAS: LiG Housing
IF PlayerLandBought
	SELECTCASE PlayerLandProgress
	CASE 0
		PRINTL [ 8] - Building
	CASE IS <= 4
		PRINTL [ 8] - Rebuilding
	CASE 4
		PRINTL [ 8] - Rebuilding
		PRINTL [ 9] - Renovation
	ENDSELECT
	FOR LOCAL,0,100
		IF ROOMDATA:LOCAL & ROOM_CUSTOM
			PRINTL [10] - Room remodeling
			BREAK
		ENDIF
	NEXT
	PRINTL [11] - Change the name of your plot
	SIF PlayerHouseMaxGuests()
	PRINTL [12] - List of Tenants
ENDIF
;custom code (plus below)
PRINTFORML [98] - Change【Follow】Target（Currently: \@ STALKED ? %CALLNAME:STALKED% # None\@）
SIF GETBIT(NAS_BEDWETALARM,1) && GETBIT(nPee,1)
PRINTFORML [327] - Change Bedwetting Alarm Interval (Currently: \@ !NAS_BedWetAlarm_Timer ? Soiling Only # Every {NAS_BedWetAlarm_Timer}min \@)
PRINTFORML [451] - Automatic masturbation when going to bed (Currently：\@ AutoFap ? On # Off \@)
PRINTFORML [452] - Remove all mob characters
PRINTFORML [453] - Bed Protection Settings
;PRINTFORML [998] - Credits
;#;PRINTFORML [-99] - Debug function for calling stuff
PRINTL [100] - Return
INPUT
IF RESULT == 100
	RETURN 0
ELSEIF RESULT == 0
	CALL 起床時間設定()
ELSEIF RESULT == 1
	CALL 恋慕ルーム
ELSEIF RESULT == 4
	FLAG:内職 = !FLAG:内職
	IF FLAG:内職
		PRINTFORMW After going to bed, remaining TSP will be spent on a side job.
	ELSE
		PRINTFORMW Side job has been turned off.
	ENDIF
ELSEIF RESULT == 5
	CALL NAME_CUSTOM(MASTER)
ELSEIF RESULT == 6
	CALL 酒虫引っ越し
ELSEIF RESULT == 7 && ITEM:祭壇
	CALL AUTO_ENMUSUBI
;NAS: LiG Housing
ELSEIF RESULT == 8
	CALL PlayerHouseRenovate
ELSEIF RESULT == 9
ELSEIF RESULT == 10
	CALL PlayerHouseRoomRemodel
ELSEIF RESULT == 11
	CALL PlayerHouseRename
ELSEIF RESULT == 12
	CALL PlayerHouseTenants
;=====================================
ELSEIF RESULT == 98 ;custom code
	CALL STALKER_CHANGE
ELSEIF RESULT == 327
	SIF !GETBIT(NAS_BEDWETALARM,1) || !GETBIT(nPee,1)
		RESTART

	gLineCount = LINECOUNT
	DO
	CLEARLINE LINECOUNT - gLineCount
	PRINTFORML Choose an interval for which the bedwetting alarm should activate (Enter 0 to only detect by soiling.)
	PRINTFORML [  0] - Soiling Only
	PRINTFORML [ 30] - 30 Minutes
	PRINTFORML [ 60] - 1 Hour (60 Minutes)
	PRINTFORML [120] - 2 Hours (120 Minutes)
	PRINTFORML [180] - 3 Hours (180 Minutes)
	PRINTFORML [360] - 6 Hours (360 Minutes)
	PRINTFORML [-1] - Leave
	PRINTL
	INPUT
	SELECTCASE RESULT
	CASE -1
		BREAK
	CASE 30 TO 1440
		IF RESULT % 30
			PRINTFORML Not an interval of 30 minutes!
			WAIT
			RESTART
		ENDIF
		NAS_BedWetAlarm_Timer = RESULT
		BREAK
	CASE 0
		PRINTFORMW 
		NAS_BedWetAlarm_Timer = 0
	ENDSELECT
	LOOP 1
ELSEIF RESULT == 451
	AutoFap = !AutoFap
ELSEIF RESULT == 452
	CALL COLORMESSAGE(@"Warning: This choice will permanently remove ALL mob characters!",C_RED,1,1)
	CALL COLORMESSAGE(@"Make sure you have saved any and all mobs you want to save as custom characters!",C_RED,2,1)
	CALL ASK_YN
	LOCAL = RESULT
	IF LOCAL == 0	
		CALLF KILL_ALL_MOBS()
		PRINTFORMW Success!
		RESULT = 1
	ELSE
		RESULT = 0
	ENDIF
ELSEIF RESULT == 453
	CALL BedProtectionSettings
ELSEIF RESULT == 998
	CALL SHOW_CREDITS_LIST
ELSEIF RESULT == -99
	;この項目ではなく
	;@TEST_動作テスト用の中身をいじって下さいね
	;#; CALL TEST_動作テスト用
ENDIF

LOOP 1

