@起床時間入力
#DIM 時間
#DIM 分数
PRINTL 알람이 울릴 시간을 hhmm 형식으로 입력하세요 (hh는 0-23, mm는 0-59, 범위를 벗어나 입력하면 취소됩니다).
PRINTL [2400] - 취소
INPUT
時間 = RESULT / 100
分数 = RESULT % 100
IF 0 <= 時間 && 時間 < 24 && 0 <= 分数 && 分数 < 60
	TIME:3 = 時間 * 60 + 分数
	PRINT 알람이 이제 ~에 울리도록 설정되었다. 
	CALL COLORMESSAGE(@"%時刻表示(TIME:3)%", C_YELLOW)
	PRINTFORMW .
ENDIF

@恋慕ルーム
;qol custom code, replace with QoL_LiveIn.ERB
CALL 恋慕ルーム_TR
RETURN RESULT
DRAWLINE
PRINTL 여기서 자신의 방을 바꿀 수 있다.
SIF CFLAG:MASTER:初期位置 == デフォルト初期位置
	SETCOLOR C_AQUA
PRINTFORML [  0] %NAME_FROM_PLACE(デフォルト初期位置)%은(는) (기본)
RESETCOLOR
FOR LOCAL, 1, CHARANUM
SIF !CFLAG:LOCAL:神社在住
	CONTINUE
SIF CFLAG:MASTER:初期位置 == CFLAG:LOCAL:初期位置
	SETCOLOR C_AQUA
SIF IS_LOVER(LOCAL)
	PRINTFORML [{LOCAL, 3}] - %NAME_FROM_PLACE(CFLAG:LOCAL:初期位置)%
RESETCOLOR
NEXT
DRAWLINE
PRINTFORML [999] - 취소
INPUT
IF RESULT == 999
	RETURN
ELSEIF RESULT == 0
	;初期あなた私室
	CFLAG:MASTER:初期位置 = デフォルト初期位置
	PRINTFORML %NAME_FROM_PLACE(CFLAG:MASTER:初期位置)%로 설정한다.
	PRINTFORMW 변경 사항은 내일 적용된다.
	RETURN
ELSEIF RESULT == [[針妙丸]] && TALENT:MASTER:体型 >= -4 && IS_LOVER(RESULT)
	PRINTFORMW 네가 아기라서 함께 살 수 없다.
ELSEIF IS_LOVER(RESULT) && CFLAG:RESULT:神社在住
	CFLAG:MASTER:初期位置 = CFLAG:RESULT:初期位置
	CALL KOJO_MESSAGE_SEND("EVENT", 19, RESULT, 3, 0)
	PRINTFORML %NAME_FROM_PLACE(CFLAG:MASTER:初期位置)%로 설정했다.
	PRINTFORMW 변경 사항은 내일부터 적용된다.
	RETURN
ENDIF
RESTART
