@酒虫引っ越し
#DIMS 引っ越し先名称
#DIM 引っ越し先地点
PRINTFORML Select a new location.

FOR LOCAL,1,100
	IF ROOMDATA:LOCAL & 場所_厨房
		IF MAIN_MAP == 0
			;Custom code
			LOCALS = %LOC_THE(LOCAL, 1)%%STR_TR(LOCAL)%
		ELSE
			;Custom code
			LOCALS = %LOC_THE(LOCAL + MAIN_MAP * 100, 1)%%STR_TR(LOCAL + 8000 + MAIN_MAP * 100)%
		ENDIF
		IF LOCAL == 拠点_酒虫 % 100
			SETCOLOR C_AQUA
		ELSEIF PRIVATEROOM:LOCAL && !TALENT:(PRIVATEROOM:LOCAL):恋慕
			SETCOLOR 100, 100, 100
		ENDIF
		PRINTFORML [{LOCAL}] %LOCALS%
		RESETCOLOR
	ENDIF
NEXT
DRAWLINE
PRINTFORML [100] Never mind
INPUT
IF INRANGE(RESULT,1,99) && ROOMDATA:RESULT & 場所_厨房
	IF PRIVATEROOM:RESULT && !TALENT:(PRIVATEROOM:RESULT):恋慕
		PRINTFORMW It will be a bit too awkward to put it there.
		RESTART
	ENDIF
	引っ越し先地点 = RESULT
	IF MAIN_MAP == 0
		;Custom code
		引っ越し先名称 = %LOC_THE(引っ越し先地点)%%STR_TR(引っ越し先地点)%
	ELSE
		;Custom code
		引っ越し先名称 = %LOC_THE(引っ越し先地点)%%STR_TR(引っ越し先地点 + 8000 + MAIN_MAP * 100)%
		引っ越し先地点 += MAIN_MAP * 100
	ENDIF
	
	PRINTFORML You decide to carry the jar to %引っ越し先名称%.
	PRINTFORML Carrying the jar is pretty hard work...
	CALL COLORMESSAGE(@"The sake bug is moved to %引っ越し先名称%",C_YELLOW,2)
	拠点_酒虫 = 引っ越し先地点
ENDIF

;時間(ARG)に起床する場合どれだけ睡眠するかを算出
@睡眠時間予測(ARG)
#FUNCTION
LOCAL = CFLAG:MASTER:就寝時間 - DAY * 1440
;LOCAL = 1440 * DAY + ARG ;seems sketch, revert for now
IF ARG >= LOCAL
	RETURNF ARG - LOCAL
ELSE
	RETURNF 1440 + ARG - LOCAL
	;RETURNF LOCAL - CFLAG:MASTER:就寝時間
ENDIF

@AUTO_ENMUSUBI
PRINTFORML With this, characters will be prayed for before going to bed unless they were prayed for during the day. 
PRINTFORML Select a target.
FOR LOCAL,1,CHARANUM
	SIF TALENT:LOCAL:行きずり
		CONTINUE
	SIF CFLAG:LOCAL:出禁
		CONTINUE
	SIF IsDead:LOCAL:0
		CONTINUE
	SIF FLAG:自動縁結び == LOCAL
		SETCOLOR C_YELLOW
	PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
	RESETCOLOR
NEXT
PRINTFORML 
DRAWLINE
PRINTFORML [999] Return
INPUT
IF RESULT == 999
	FLAG:自動縁結び = 0
ELSEIF INRANGE(RESULT,1,CHARANUM)
	FLAG:自動縁結び = RESULT
ENDIF

@最低睡眠時間設定
TIME:3 = (CFLAG:MASTER:就寝時間 - DAY * 1440) + 240
SIF TIME:3 >= 1440
	TIME:3 -= 1440
SIF TIME:3 < 0
	TIME:3 = 0

@起床時間設定
#DIM 同居人
#DIM 前日就寝時間
#DIM nStoreTime
CALL LS_RESTRICT_PRINT("Change waking time") ;Custom code, restrict changing waking time during Lunatic Survival.
SIF RESULT
	RETURN
nStoreTime = TIME:3 ;qol custom code
前日就寝時間 = CFLAG:MASTER:就寝時間 - DAY * 1440
同居人 = 0
FOR LOCAL,1,CHARANUM
	IF CFLAG:LOCAL:初期位置 == CFLAG:MASTER:初期位置
		同居人 = LOCAL
		BREAK
	ENDIF
NEXT
DO
 	;qol custom code, cleaner rendering of time slept (example: 10:0 becomes 10:00)
	PRINTFORML When should the alarm go off? (Went to bed at: %時刻表示(前日就寝時間)%) (Time slept: %時刻表示(睡眠時間予測(TIME:3))%)
	PRINTBUTTON "┏━ △ ", 60
	PRINTBUTTON "━△", 10
	PRINTBUTTON "△━┓", 1
	PRINTL 
	PRINT ┃　
	SIF TIME:3 < 600
		PRINT ０
	PRINTFORM %TOFULL(TOSTR(TIME:3 / 60))%：
	SIF TIME:3 % 60 < 10
		PRINT ０
	PRINTFORM %TOFULL(TOSTR(TIME:3 % 60))%　
	PRINTBUTTON "□", 5555
	PRINTL 
	PRINTBUTTON "┗━ ▽ ", -60
	PRINTBUTTON "━▽", -10
	PRINTBUTTON "▽━┛", -1
	PRINTL 
	SIF 同居人 < CHARANUM && 同居人
		PRINTFORM [2222] - Same as %CALLNAME:同居人%
	PRINTL 
	;custom code
	PRINT [2223] - Same as someone else
	PRINTL 
	PRINT [3333] - Calendar
	PRINT 　
	PRINTL [4444] - Direct input
	;qol custom code
	PRINTL [9999] - Cancel
	IF 睡眠時間予測(TIME:3) < 240
		PRINTFORM [5555] - 
		CALL COLORMESSAGE("At least 4 hours of sleep is needed", C_ORANGE, 1)
	ELSE
		PRINTFORML [{0,4}] - Done
	ENDIF
	INPUT
	IF RESULT == 0 && 睡眠時間予測(TIME:3) >= 240
		PRINTFORM The alarm is now set at 
		CALL COLORMESSAGE(@"%時刻表示(TIME:3)%", C_YELLOW)
		PRINTFORMW .
		RETURN 1
	ELSEIF RESULT == 9999 ;qol custom code
		TIME:3 = nStoreTime
		RETURN 0
	ELSEIF RESULT == 2222 && 同居人 < CHARANUM && 同居人
		TIME:3 = CFLAG:同居人:起床時間
	;custom code
	ELSEIF RESULT == 2223
		PRINTFORML Who?
		DRAWLINE
			FOR LOCAL,1,CHARANUM
				SIF CFLAG:LOCAL:出禁
					CONTINUE
				IF 同居人 == LOCAL
					SETCOLOR C_H_PINK
					PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL,15,LEFT%
					RESETCOLOR
					CONTINUE
				ENDIF
				PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL,15,LEFT%
			NEXT
		PRINTL 
		DRAWLINE
		PRINTL [999] Nevermind
		INPUT
		IF INRANGE(RESULT, 1, CHARANUM-1) && !CFLAG:RESULT:出禁
			TIME:3 = CFLAG:RESULT:起床時間
			PRINTFORML You will wake up at the same time as %CALLNAME:RESULT%.
		ELSEIF RESULT != 999
			PRINTFORML Nuh uh!!!!
		ENDIF
	ELSEIF RESULT == 3333
		CALL カレンダー()
	ELSEIF RESULT == 4444
		CALL 起床時間入力()
	ELSEIF RESULT == 5555
		CALL 最低睡眠時間設定()
	ELSEIF INRANGE(RESULT, -1360, 1360)
		TIME:3 += RESULT
		IF TIME:3 >= 1440
			TIME:3 -= 1440
		ELSEIF TIME:3 < 0
			TIME:3 += 1440
		ENDIF
		CLEARLINE 10 ;qol custom code
	ENDIF
LOOP 1
[SKIPSTART]
	;前のがいいってなったらこっちを戻して
	VARSET LOCAL
	FOR LOCAL, 0, 24
		IF 睡眠時間予測(LOCAL * 60) < 240
			SETCOLOR 50, 50, 50
			PRINTPLAINFORM [{LOCAL, 2}]
		ELSE
			SIF TIME:3 == LOCAL * 60
				SETCOLOR C_AQUA
			PRINTFORM [{LOCAL, 2}]
		ENDIF
		RESETCOLOR
		SIF LOCAL % 12 == 11
			PRINTL 
	NEXT
	IF 同居人 < CHARANUM && 同居人
		LOCAL:1 = CFLAG:同居人:起床時間 / 60
		DRAWLINE
		PRINTFORML [{LOCAL:1, 2}] - 同居中の%CALLNAME:同居人%の起床時間
	ENDIF
	$INPUT_LOOP
	INPUT
	SIF RESULT < 0 || RESULT > 23 || 睡眠時間予測(RESULT * 60) < 240
		GOTO INPUT_LOOP
	TIME:3 = RESULT * 60
	PRINTFORM 目覚ましを
	CALL COLORMESSAGE(@"%時刻表示(TIME:3)%", C_YELLOW)
	PRINTFORMW に設定しました。（{睡眠時間予測(TIME:3) / 60}時間{睡眠時間予測(TIME:3) % 60}分寝ます）
[SKIPEND]
