IF ボーナス内容
	SELECTCASE ボーナス内容
		CASE 4
			授与個数 = 1
		CASE 6 ;addition custom code
			授与個数 = 3
		CASE IS > 8
			授与個数 = 8
		CASE IS > 5
			授与個数 = 5
		CASEELSE
			授与個数 = 3
	ENDSELECT
	IF ITEM:TB_ITEM() + 授与個数 > 99
		ITEM:TB_ITEM() = 99
	ELSE
		ITEM:TB_ITEM() += 授与個数
	ENDIF
	IF ボーナス内容 == 4
		CALL COLORMESSAGE(@"당신은 %ITEMNAME_TR(TB_ITEM())%을/를 받았다!", C_YELLOW, 2, 1)
	ELSE
		CALL COLORMESSAGE(@"당신은 {授与個数}개의 %ITEMNAME_TR(TB_ITEM())%!을 받았다!", C_YELLOW, 2, 1)
	ENDIF
	;CLEARLINE 1
	;custom code, make sure player reads the above lines even with macro
	LOCAL = RAND(1000000) + 1000
	WHILE RESULT != LOCAL
	PRINTFORM [{LOCAL}] 확인
	INPUT
	SIF RESULT != LOCAL
		CLEARLINE 2
	WEND
	CLEARLINE LINECOUNT - LOCAL:9 + 1
	;--------------------------------
ENDIF
