; Modular ERB: SHOP_COLLECTION_FISH.ERB
;-----------------------------------------------------------
;釣った魚リストの表示
;-----------------------------------------------------------

@SHOW_COLLECTION_FISH
#DIM 選んだ魚
#DIM 全種数
#DIM 釣った種数
#DIM 釣った総数
#DIM 最大サイズ
#DIM 消去行数
VARSET LOCAL
全種数 = 0
釣った種数 = 0
釣った総数 = 0
最大サイズ = 0
消去行数 = 0
CLEARLINE 1
PRINTFORML 지금까지 잡은 물고기 목록이다.
DRAWLINE
FOR LOCAL, 1, 61
;魚が無名でない
IF FISH_NAME(LOCAL) != ""
	全種数 ++
	SIF LOCAL < 10
		PRINTFORM  
	IF FISH_EXP:(LOCAL)
		釣った種数 ++
		PRINTFORM [{LOCAL}] %CAPITALIZE(FISH_NAME_TR(LOCAL)), 28, LEFT%
		SETCOLOR C_L_GRAY
		PRINTFORM (물고기 수:) 
		SELECTCASE FISH_EXP:LOCAL
			CASE IS < 10
				PRINTFORM     
			CASE IS < 100
				PRINTFORM    
			CASE IS < 1000
				PRINTFORM   
			CASE IS < 10000
				PRINTFORM  
		ENDSELECT
		釣った総数 += FISH_EXP:LOCAL
		PRINTFORM {FISH_EXP:LOCAL}/가장 큰 물고기: 
		SELECTCASE FISHSIZE_RECORD:LOCAL
			CASE IS < 10
				PRINTFORM   
			CASE IS < 100
				PRINTFORM  
		ENDSELECT
		PRINTFORML {FISHSIZE_RECORD:LOCAL}cm）
		SIF FISHSIZE_RECORD:LOCAL > 最大サイズ
			最大サイズ = FISHSIZE_RECORD:LOCAL
	ELSE
		PRINTFORML [{LOCAL}] ????????????
	ENDIF
ENDIF
RESETCOLOR
NEXT
SETCOLOR 0x00FF00
PRINTFORM 잡은 물고기 종류: {釣った種数}/{全種数}
IF 釣った総数
	PRINTFORML 　잡은 물고기 총수: {釣った総数} 가장 큰 물고기: {最大サイズ}cm
ELSE
	PRINTL 
ENDIF
RESETCOLOR
DRAWLINE
PRINT [0] - 반환
$LOOP
INPUT
選んだ魚 = RESULT
SELECTCASE 選んだ魚
	CASE 1 TO 60
		IF FISH_NAME(選んだ魚) != ""
			CLEARLINE 1
			CALL PRINT_FISHINFO(選んだ魚)
			IF FISH_EXP:選んだ魚
				消去行数 = 9
			ELSE
				消去行数 = 2
			ENDIF
			CLEARLINE 消去行数
			GOTO LOOP
		ELSE
			CLEARLINE 1
			GOTO LOOP
		ENDIF
	CASE 0
		RETURN
	CASEELSE
		CLEARLINE 1
		GOTO LOOP
ENDSELECT
;-----------------------------------------------------------
;選択した魚の説明／ヒント表記
;ARG …選んだ魚番号
;-----------------------------------------------------------

@PRINT_FISHINFO(ARG)
DRAWLINE
IF FISH_EXP:ARG
	PRINTPLAINFORM [{ARG}] %CAPITALIZE(FISH_NAME_TR(ARG))%
	PRINTFORML (물고기 수: {FISH_EXP:ARG} / 최대 크기: {FISHSIZE_RECORD:ARG}cm)
	IF ABL:MASTER:教養 < 3
		CALL COLORMESSAGE(@"　　(낚시 장소와 계절을 보려면 지식 레벨을 높여라...)",C_L_GRAY,1)
	ELSE
		CALL FISHING_HINT(ARG)
	ENDIF
	CALL FISHING_EXPLANATION(ARG)
ELSE
	PRINTPLAINFORM [{ARG}] ?????????????
	CALL FISHING_HINT(ARG)
ENDIF
WAIT
