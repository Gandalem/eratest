@オプション切り替え(ARGS, ARG)
FLAG:ARGS ++
SIF FLAG:ARGS > ARG
	FLAG:ARGS = 0

@OPTION_オート喘ぎ一括設定
CALL ASK_M("None",1,"Everyone (No ahegao)",1,"Everyone (Ahegao)",1, "Cancel",1)
IF INRANGE(RESULT, 0, 2)
	FOR LOCAL,1,CHARANUM
		CFLAG:LOCAL:オート喘ぎ = RESULT
	NEXT
	PRINTFORMW Batch setting completed.
ENDIF

@登場キャラ切り替え
PRINTL 　Characters that are disabled and will not appear in the game. (Characters with a * have dialog)
DRAWLINE
SIF FLAG:並び替え
	CALL CHARASORT_EX
FOR LOCAL:1, 0, EX_CHARANUM
	IF FLAG:並び替え
		LOCAL = RESULT:(LOCAL:1)
		SIF LOCAL < 0
			CONTINUE
	ELSE
		LOCAL = LOCAL:1
		SIF LOCAL >= CHARANUM
			BREAK
	ENDIF
	SIF TALENT:LOCAL:行きずり
		CONTINUE
	SIF IsDead:LOCAL:0
		CONTINUE
	SIF CFLAG:LOCAL:出禁
		SETCOLOR C_D_RED
	RESULT = 0
	TRYCALLFORM M_KOJO_K{NO:LOCAL}
	PRINTFORMLC [{LOCAL, 3}] %COND_STR(@"*", RESULT)%%CALLNAME:LOCAL%
	RESETCOLOR
NEXT
PRINTL 　
DRAWLINE
;qol custom code
LOCAL:10 = FLAG:出禁人数 - CMATCH(CFLAG:出禁, 2, 1, CHARANUM-1)
PRINTFORML [999] Finish (disabled: {LOCAL:10} %PLURALIZER("character", LOCAL:10)%))　[998] Reset  [900] Disable petites  [901] Disable men [997] Disable all characters without dialogue
$LOOP
INPUT
IF RESULT >= 0 && RESULT <= CHARANUM
	IF CFLAG:RESULT:出禁 && FLAG:なりきり != RESULT
		IF (DAY:0+StartingDay) < charaArrive:RESULT:0
			C = RESULT
			SETCOLOR C_RED
			PRINTFORML WARNING: %CALLNAME:C% is meant to arrive %PRINT_DATE_F(charaArrive:C:0-StartingDay+1,0)% (You are currently %PRINT_DATE_F(DAY,0)%)...
			PRINTFORML Enabling this character may result in lore inconsistencies.
			RESETCOLOR
			PRINTL Confirm?
			CALL ASK_YN ;custom code
			IF RESULT == 0
				CFLAG:C:出禁 = 0
				SIF CFLAG:C:現在位置 == CFLAG:C:初期位置 && CFLAG:C:睡眠
					LOCK:(CFLAG:C:初期位置) = 1
				FLAG:出禁人数 --
			ELSE
				CLEARLINE 7
				RESTART
			ENDIF
		ELSE
			CFLAG:RESULT:出禁 = 0
			SIF CFLAG:RESULT:現在位置 == CFLAG:RESULT:初期位置 && CFLAG:RESULT:睡眠
				LOCK:(CFLAG:RESULT:初期位置) = 1
			FLAG:出禁人数 --
		ENDIF
	ELSEIF TALENT:RESULT:行きずり || RESULT == MASTER
		PRINTFORMW %CALLNAME:RESULT% cannot be disabled.
		GOTO LOOP
	ELSEIF FLAG:なりきり == RESULT
		IF CFLAG:(FLAG:なりきり):出禁 == 1
			PRINTFORML Since %CALLNAME:RESULT% already exists, becoming %HIM_HER(RESULT)% will cause there to be two %CALLNAME:RESULT%...
			PRINTL Confirm?
			CALL ASK_YN ;custom code
			IF RESULT == 0
				CFLAG:(FLAG:なりきり):出禁 = 0
				SIF CFLAG:(FLAG:なりきり):現在位置 == CFLAG:(FLAG:なりきり):初期位置 && CFLAG:(FLAG:なりきり):睡眠
					LOCK:(CFLAG:(FLAG:なりきり):初期位置) = 1
				FLAG:出禁人数 --
				PRINTFORMW %CALLNAME:(FLAG:なりきり)% will appear in the game.
			ELSE
				GOTO LOOP
			ENDIF
		ELSE
			CFLAG:(FLAG:なりきり):出禁 = 1
			SIF LOCK:(CFLAG:(FLAG:なりきり):初期位置) && CFLAG:(FLAG:なりきり):初期位置 < 100
				LOCK:(CFLAG:(FLAG:なりきり):初期位置) = 0
			FLAG:出禁人数 ++
		ENDIF
	ELSE
		CFLAG:RESULT:出禁 = 1
		SIF LOCK:(CFLAG:RESULT:初期位置) && CFLAG:RESULT:初期位置 < 100
			LOCK:(CFLAG:RESULT:初期位置) = 0
		FLAG:出禁人数 ++
	ENDIF
	RESTART
ELSEIF RESULT == 999
	PRINTW Settings applied.
ELSEIF RESULT == 900
	FOR LOCAL,1,CHARANUM
		SIF FLAG:なりきり == LOCAL
			CONTINUE
		SIF TALENT:LOCAL:行きずり
			CONTINUE
		SIF (TALENT:LOCAL:100 > -1 && !GROUPMATCH(LOCAL,3,30,38,49,60,84,86,89,100,107,108,114,120,122,123,136,139)) || GROUPMATCH(LOCAL,70)
			CONTINUE
		SIF !CFLAG:LOCAL:出禁
			FLAG:出禁人数 ++
		CFLAG:LOCAL:出禁 = 1
	NEXT
	RESTART
ELSEIF RESULT == 901
	FOR LOCAL,1,CHARANUM
		SIF FLAG:なりきり == LOCAL
			CONTINUE
		SIF TALENT:LOCAL:行きずり
			CONTINUE
		SIF !IS_MALE(LOCAL)
			CONTINUE
		SIF !CFLAG:LOCAL:出禁
			FLAG:出禁人数 ++
		CFLAG:LOCAL:出禁 = 1
	NEXT
	RESTART
ELSEIF RESULT == 998
	FOR LOCAL,1,CHARANUM
		SIF FLAG:なりきり == LOCAL
			CONTINUE
		SIF TALENT:LOCAL:行きずり
			CONTINUE
		CFLAG:LOCAL:出禁 = 0
	NEXT
	FLAG:出禁人数 = CMATCH(CFLAG:出禁, 2, 1, CHARANUM-1) ;qol custom code
	RESTART
ELSEIF RESULT == 997
	FOR LOCAL,1,CHARANUM
		SIF FLAG:なりきり == LOCAL
			CONTINUE
		SIF TALENT:LOCAL:行きずり
			CONTINUE
		TRYCCALLFORM M_KOJO_K{NO:LOCAL}
			CATCH
				IF CFLAG:LOCAL:出禁 == 0
					CFLAG:LOCAL:出禁 = 1
					FLAG:出禁人数 ++
				ENDIF
			ENDCATCH
;			PRINTFORM %CALLNAME:LOCAL% {FLAG:出禁人数} ／
	NEXT
	RESTART
ELSE
	GOTO LOOP
ENDIF
