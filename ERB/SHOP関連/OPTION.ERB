@登場キャラ切り替え
PRINTL 　게임에 등장하지 않으며 비활성화된 캐릭터들. (*가 붙은 캐릭터는 대사가 있음)
DRAWLINE
SIF FLAG:並び替え
	CALL CHARASORT_EX
FOR LOCAL:1, 0, EX_CHARANUM
IF FLAG:並び替え
	LOCAL = RESULT:(LOCAL:1)
	SIF LOCAL < 0
		CONTINUE
ELSE
	LOCAL = LOCAL:1
	SIF LOCAL >= CHARANUM
		BREAK
ENDIF
SIF TALENT:LOCAL:行きずり
	CONTINUE
SIF IsDead:LOCAL:0
	CONTINUE
SIF CFLAG:LOCAL:出禁
	SETCOLOR C_D_RED
RESULT = 0
TRYCALLFORM M_KOJO_K{NO:LOCAL}
PRINTFORMLC [{LOCAL, 3}] %COND_STR(@"*", RESULT)%%CALLNAME:LOCAL%
RESETCOLOR
NEXT
PRINTL 　
DRAWLINE
;qol custom code
LOCAL:10 = FLAG:出禁人数 - CMATCH(CFLAG:出禁, 2, 1, CHARANUM-1)
PRINTFORML [999] 종료 (비활성화됨: {LOCAL:10} %PLURALIZER("character", LOCAL:10)%) [998] 초기화 [900] 작은 캐릭터 비활성화 [901] 남성 비활성화 [997] 대사 없는 모든 캐릭터 비활성화
$LOOP
INPUT
IF RESULT >= 0 && RESULT <= CHARANUM
	IF CFLAG:RESULT:出禁 && FLAG:なりきり != RESULT
		IF (DAY:0+StartingDay) < charaArrive:RESULT:0
			C = RESULT
			SETCOLOR C_RED
			PRINTFORML 경고: %CALLNAME:C%이 도착할 예정입니다 %PRINT_DATE_F(charaArrive:C:0-StartingDay+1,0)% (현재 당신은 %PRINT_DATE_F(DAY,0)% 상태입니다)...
			PRINTFORML 이 캐릭터를 활성화하면 설정 모순이 발생할 수 있습니다.
			RESETCOLOR
			PRINTL 확인해?
			CALL ASK_YN ;custom code
			IF RESULT == 0
				CFLAG:C:出禁 = 0
				SIF CFLAG:C:現在位置 == CFLAG:C:初期位置 && CFLAG:C:睡眠
					LOCK:(CFLAG:C:初期位置) = 1
				FLAG:出禁人数 --
			ELSE
				CLEARLINE 7
				RESTART
			ENDIF
		ELSE
			CFLAG:RESULT:出禁 = 0
			SIF CFLAG:RESULT:現在位置 == CFLAG:RESULT:初期位置 && CFLAG:RESULT:睡眠
				LOCK:(CFLAG:RESULT:初期位置) = 1
			FLAG:出禁人数 --
		ENDIF
	ELSEIF TALENT:RESULT:行きずり || RESULT == MASTER
		PRINTFORMW %CALLNAME:RESULT%은(는) 비활성화할 수 없다.
		GOTO LOOP
	ELSEIF FLAG:なりきり == RESULT
		IF CFLAG:(FLAG:なりきり):出禁 == 1
			PRINTFORML 이미 %CALLNAME:RESULT%이 존재하기 때문에, %HIM_HER(RESULT)%가 되면 두 개의 %CALLNAME:RESULT%이 생기게 됩니다...
			PRINTL 확인하시겠습니까?
			CALL ASK_YN ;custom code
			IF RESULT == 0
				CFLAG:(FLAG:なりきり):出禁 = 0
				SIF CFLAG:(FLAG:なりきり):現在位置 == CFLAG:(FLAG:なりきり):初期位置 && CFLAG:(FLAG:なりきり):睡眠
					LOCK:(CFLAG:(FLAG:なりきり):初期位置) = 1
				FLAG:出禁人数 --
				PRINTFORMW %CALLNAME:(FLAG:なりきり)%이(가) 게임에 등장한다.
			ELSE
				GOTO LOOP
			ENDIF
		ELSE
			CFLAG:(FLAG:なりきり):出禁 = 1
			SIF LOCK:(CFLAG:(FLAG:なりきり):初期位置) && CFLAG:(FLAG:なりきり):初期位置 < 100
				LOCK:(CFLAG:(FLAG:なりきり):初期位置) = 0
			FLAG:出禁人数 ++
		ENDIF
	ELSE
		CFLAG:RESULT:出禁 = 1
		SIF LOCK:(CFLAG:RESULT:初期位置) && CFLAG:RESULT:初期位置 < 100
			LOCK:(CFLAG:RESULT:初期位置) = 0
		FLAG:出禁人数 ++
	ENDIF
	RESTART
ELSEIF RESULT == 999
	PRINTW 설정이 적용되었다.
ELSEIF RESULT == 900
	FOR LOCAL,1,CHARANUM
	SIF FLAG:なりきり == LOCAL
		CONTINUE
	SIF TALENT:LOCAL:行きずり
		CONTINUE
	SIF (TALENT:LOCAL:100 > -1 && !GROUPMATCH(LOCAL,3,30,38,49,60,84,86,89,100,107,108,114,120,122,123,136,139)) || GROUPMATCH(LOCAL,70)
		CONTINUE
	SIF !CFLAG:LOCAL:出禁
		FLAG:出禁人数 ++
	CFLAG:LOCAL:出禁 = 1
	NEXT
	RESTART
ELSEIF RESULT == 901
	FOR LOCAL,1,CHARANUM
	SIF FLAG:なりきり == LOCAL
		CONTINUE
	SIF TALENT:LOCAL:行きずり
		CONTINUE
	SIF !IS_MALE(LOCAL)
		CONTINUE
	SIF !CFLAG:LOCAL:出禁
		FLAG:出禁人数 ++
	CFLAG:LOCAL:出禁 = 1
	NEXT
	RESTART
ELSEIF RESULT == 998
	FOR LOCAL,1,CHARANUM
	SIF FLAG:なりきり == LOCAL
		CONTINUE
	SIF TALENT:LOCAL:行きずり
		CONTINUE
	CFLAG:LOCAL:出禁 = 0
	NEXT
	FLAG:出禁人数 = CMATCH(CFLAG:出禁, 2, 1, CHARANUM-1) ;qol custom code
	RESTART
ELSEIF RESULT == 997
	FOR LOCAL,1,CHARANUM
	SIF FLAG:なりきり == LOCAL
		CONTINUE
	SIF TALENT:LOCAL:行きずり
		CONTINUE
	TRYCCALLFORM M_KOJO_K{NO:LOCAL}
	CATCH
	IF CFLAG:LOCAL:出禁 == 0
		CFLAG:LOCAL:出禁 = 1
		FLAG:出禁人数 ++
	ENDIF
	ENDCATCH
	;			PRINTFORM %CALLNAME:LOCAL% {FLAG:出禁人数} ／
	NEXT
	RESTART
ELSE
	GOTO LOOP
ENDIF
