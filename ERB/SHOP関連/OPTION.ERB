; Modular ERB: OPTION.ERB
;オプション設定処理

@OPTION(ARG) ;com custom code, ARG = 1: during training (not in the shop)
#DIM L_COUNT
#DIM L_FEED
#DIM TEMP
#DIM nTab = 80 ;custom code
#DIM FIRST_LINE
VARSET LOCAL
L_FEED = LINECOUNT
FIRST_LINE = LINECOUNT
TOOLTIP_SETDELAY 100
TEMP = CURRENTREDRAW()
REDRAW 0
PRINTBUTTON "★★", 1467
PRINT 옵션을 선택한다
PRINTBUTTON "★★", 1467	
PRINTL
DRAWLINEFORM =
FOR L_COUNT, 0, 91
CALL OPTION_SETNAME(L_COUNT)
SIF !RESULT
	CONTINUE
LOCAL:L_COUNT = 1
IF RESULTS:2 == ""
	PRINTFORML [{L_COUNT, 2}] - %OPTIONS_TR(RESULTS:0), nTab, LEFT%：　%OPTIONS_TR(RESULTS:1)%
ELSE
	HTML_PRINT @"<button value='{L_COUNT}' title='%HTML_ESCAPE(OPTIONS_TR(RESULTS:2))%'>[{L_COUNT, 2}] - %OPTIONS_TR(RESULTS:0), nTab, LEFT%：　%OPTIONS_TR(RESULTS:1)%</button>"
ENDIF
NEXT
PRINTFORML 옵션 위에 마우스를 올리면 해당 도구 설명이 표시된다.
DRAWLINEFORM －
PRINTFORML [91] - 자동 신음 소리
PRINTFORML [92] - 필터 설정
PRINTFORML [93] - 이미지 표시 설정
PRINTFORML [94] - 캐릭터 비활성화
PRINTFORML [95] - 명령어 필터
;#;PRINTFORML [96] - Counter actions filter (Debug)
;PRINTFORML [97] - Cooking settings
;custom code
PRINTFORML [100] - 모드 기능 설정
;addition custom code
PRINTFORML [101] - 대화 비활성화
;nas replacement for atw controverscial content toggle
PRINTFORML [900] - 페티시 토글
;atw edit, hardcore content toggle
;PRINTFORML [102] - Disable controversial content
DRAWLINE
IF (SaveIsEZB ? LegendModeStage >= 4 # DAY > YearLength) && !ARG
	HTML_PRINT @"<button value='200' title='경고: 더 이상 읽지 마시오'>[200] - 먼지가 되다/NG+ </button>"
ENDIF
PRINTFORML [999] - 완료
INPUT
SELECTCASE RESULT
	CASE 0 TO 90
		SIF LOCAL:RESULT
			CLEARLINE LINECOUNT - FIRST_LINE
		CALL OPTION_SETTING(RESULT)
		CLEARLINE LINECOUNT - L_FEED
	CASE 900
		CALL OPTION_MOD_FETISH
	CASE 91
		CALL OPTION_オート喘ぎ一括設定
	CASE 92
		CALL 簡易フィルタ一括設定
	CASE 93
		CALL OPTION_画像表示詳細設定
	CASE 94
		CALL 登場キャラ切り替え
	CASE 95
		CALL OPTION_COMMAND_FILTER
		[IF_DEBUG]
	CASE 96
		CALL OPTION_COUNTER_FILTER
		[ENDIF]
		;CASE 97
		;	CALL SET_OPTION_COOKING
	CASE 100 ;custom code
		CALL OPTION_MOD
	CASE 101 ;addition custom code
		CALL Add_Ban_Dialogue
	CASE 102 ;atw edit, hardcore content toggle
		CALL HARDCORECONTENT_MENU
	CASE 1467 ;cheat custom code
		CALL CHEAT_MENU()
	CASE 200
		TOOLTIP_SETDELAY 500
		IF (SaveIsEZB ? LegendModeStage > 4 # DAY > YearLength) || ARG
			REDRAW TEMP
			RETURN
		ENDIF
		PRINTFORML 시간을 날리고 첫날로 돌아가겠습니까?
		PRINTL 
		PRINTL [0] 그가 「스위치」를 누르도록 두지 마라——— !!!
		PRINTL [1] 아니, 나는 한계에 도달했다! 내가 밀어버리겠다! 지금!
		INPUT
		IF RESULT == 1
			CALL 強くてニューゲーム
		ELSE
			;		PRINTW 「スイッチ」を押すのは止められなかったが、幸運にもオプション選択までしか戻らなかった。
		ENDIF
	CASEELSE
		TOOLTIP_SETDELAY 500
		REDRAW TEMP
		RETURN
ENDSELECT
REDRAW TEMP
RESTART

@OPTION_SETNAME(ARG)
;RESULT:2	ツールチップ表記内容
#DIM 係数
VARSET RESULTS
RESULT = 1
SELECTCASE ARG
	; preggo now global
	; CASE 0
	; 	RESULTS:0 = 妊娠の有無
	; 	IF FLAG:妊娠スイッチ
	; 		RESULTS:1 = 妊娠する
	; 		RESULTS:2 = ※ 女あなたの妊娠機能は未実装 ※
	; 	ELSE
	; 		RESULTS:1 = 妊娠しない
	; 	ENDIF
	CASE 1
		RESULTS:0 = 子供の性別
		SELECTCASE FLAG:子供の性別
			CASE 0
				RESULTS:1 = ランダム
			CASE 1
				RESULTS:1 = 女の子
			CASE 2
				RESULTS:1 = 男の子
		ENDSELECT
		SIF !nPreggo ; preggo now global
			RESULT = 0
	CASE 2
		RESULTS:0 = 子供の描写
		IF FLAG:子供描写
			RESULTS:1 = あり
		ELSE
			RESULTS:1 = なし
		ENDIF
		SIF !nPreggo ; preggo now global
			RESULT = 0
	CASE 3
		RESULTS:0 = 住み込みイベント
		IF FLAG:住み込みイベント
			RESULTS:1 = なし
		ELSE
			RESULTS:1 = あり
			RESULTS:2 = 親しいキャラが自宅地域に引っ越してきます
		ENDIF
	CASE 4
		RESULTS:0 = 宴会の発生
		IF FLAG:宴会の有無
			RESULTS:1 = あり
		ELSE
			RESULTS:1 = なし
		ENDIF
	CASE 5
		RESULTS:0 = 相手からの告白
		IF FLAG:告白禁止
			RESULTS:1 = 告白してこない
		ELSE
			RESULTS:1 = 告白してくる
		ENDIF
	CASE 6
		RESULTS:0 = セフレ系から恋慕系への陥落変化
		IF FLAG:陥落路線変化
			RESULTS:1 = 変化する
		ELSE
			RESULTS:1 = 変化しない
		ENDIF
	CASE 7
		RESULTS:0 = イベントによる[無知]喪失
		IF FLAG:無知自動喪失禁止
			RESULTS:1 = 喪失しない
		ELSE
			RESULTS:1 = 喪失する
		ENDIF
	CASE 8
		RESULTS:0 = テキスト設定
		IF FLAG:情景テキスト設定 == 1 && FLAG:口上テキスト設定 == 2
			RESULTS:1 = 口上＋情景テキスト
		ELSEIF FLAG:情景テキスト設定 == 1 && FLAG:口上テキスト設定 == -1
			RESULTS:1 = 情景テキストのみ
		ELSEIF FLAG:情景テキスト設定 == 0 && FLAG:口上テキスト設定 == -1
			RESULTS:1 = テキストを表示しない
		ENDIF
	CASE 9
		RESULTS:0 = 口上色
		IF FLAG:口上色
			RESULTS:1 = あり
		ELSE
			RESULTS:1 = なし
		ENDIF
	CASE 10
		RESULTS:0 = 汚れ度表示
		IF FLAG:ゴミ表示OFF
			RESULTS:1 = しない
		ELSE
			RESULTS:1 = する
		ENDIF
	CASE 11
		RESULTS:0 = カウンターの地の文
		IF FLAG:カウンター地の文制御
			RESULTS:1 = 素質で変化する
		ELSE
			RESULTS:1 = 変化しない
		ENDIF
	CASE 12
		RESULTS:0 = おっぱいテキスト
		IF FLAG:Look表示用乳房 == 1 && FLAG:Look表示用乳首 == 1
			RESULTS:1 = 全て固定
		ELSEIF FLAG:Look表示用乳房 == 1 && FLAG:Look表示用乳首 == 0
			RESULTS:1 = 乳房のみ固定
		ELSEIF FLAG:Look表示用乳房 == 0 && FLAG:Look表示用乳首 == 1
			RESULTS:1 = 乳首のみ固定
		ELSEIF FLAG:Look表示用乳房 == 0 && FLAG:Look表示用乳首 == 0
			RESULTS:1 = 固定しない
		ENDIF
	CASE 13
		RESULTS:0 = 好意/理性の壁の表示
		IF FLAG:好意理性短縮
			RESULTS:1 = 短縮する
		ELSE
			RESULTS:1 = 短縮しない
		ENDIF
		;RESULTS:2 = ※現在未機能※
		;qol custom code add description to previously not implemented option
		RESULTS:2 = Shortens the reason/favor display to numbers
	CASE 14
		RESULTS:0 = 能力表示の表記
		IF FLAG:能力表記
			RESULTS:1 = 数字表記
		ELSE
			RESULTS:1 = 記号表記
		ENDIF
		RESULTS:2 = ※現在未機能※
	CASE 15
		RESULTS:0 = ターン毎のABLUP
		IF FLAG:ABLUP省略
			RESULTS:1 = 省略する
		ELSE
			RESULTS:1 = 省略しない
		ENDIF
	CASE 16
		RESULTS:0 = ファーストキスの記録
		SELECTCASE FLAG:ＦＫ判定
			CASE 0
				RESULTS:1 = キスのみ・自覚のみ
			CASE 1
				RESULTS:1 = キスのみ・未自覚あり
			CASE 2
				RESULTS:1 = フェラあり・自覚のみ
			CASE 3
				RESULTS:1 = フェラあり・未自覚あり
		ENDSELECT
	CASE 17
		RESULTS:0 = 移動時立ち止まり
		SELECTCASE FLAG:立ち止まり
			CASE 0
				RESULTS:1 = 無条件で立ち止まる
			CASE 1
				RESULTS:1 = 口上が存在する場合のみ
			CASE 2
				RESULTS:1 = 立ち止まらない
		ENDSELECT
	CASE 18
		RESULTS:0 = 遭遇時の依頼提示
		IF FLAG:依頼スルー
			RESULTS:1 = 表示しない
		ELSE
			RESULTS:1 = 表示する
		ENDIF
	CASE 19
		RESULTS:0 = 消耗品の自動購入
		IF FLAG:消耗品自動購入
			RESULTS:1 = する
			RESULTS:2 = 購入するのはローションのみ
		ELSE
			RESULTS:1 = しない
		ENDIF
	CASE 20
		RESULTS:0 = 自動時止め移動
		SELECTCASE FLAG:瞬間移動
			CASE 0
				RESULTS:1 = ＯＦＦ
			CASE 1
				RESULTS:1 = 外出先の散策時のみ
			CASE 2
				RESULTS:1 = 拠点内の移動時のみ
			CASE 3
				RESULTS:1 = 外出先/拠点内両方
		ENDSELECT
	CASE 21
		RESULTS:0 = 押し倒されなくなる判定
		IF FLAG:押し倒し
			RESULTS:1 = あり
		ELSE
			RESULTS:1 = なし
		ENDIF
	CASE 22
		RESULTS:0 = 注意札使用
		IF FLAG:注意札使用
			RESULTS:1 = あり
		ELSE
			RESULTS:1 = なし
		ENDIF
		;custom code, always show tooltip
		RESULTS:2 = 度が過ぎたセクハラ等で発行され貯まるとゲームオーバーになります
	CASE 23
		RESULTS:0 = 来訪モード
		SELECTCASE FLAG:交流来訪モード
			CASE 0
				RESULTS:1 = 通常
			CASE 1
				RESULTS:1 = 好感度50以下は来訪しない
			CASE 2
				RESULTS:1 = 陥落したキャラのみ
			CASE 3
				RESULTS:1 = 来訪しない
		ENDSELECT
		RESULTS:2 = 自宅地域にキャラが訪れる条件
	CASE 24
		RESULTS:0 = 脱衣コマンドの扱い
		SELECTCASE FLAG:脱衣選択
			CASE 0
				RESULTS:1 = 毎回選択
			CASE 1
				RESULTS:1 = 全裸
			CASE 2
				RESULTS:1 = 半脱ぎ
		ENDSELECT
	CASE 25
		RESULTS:0 = 時間停止脱衣コマンドの扱い
		SELECTCASE FLAG:パンツ泥棒
			CASE 0
				RESULTS:1 = 毎回選択
			CASE 1
				RESULTS:1 = 常にくすねる
			CASE 2
				RESULTS:1 = 常に脱がすだけ
		ENDSELECT
	CASE 26
		RESULTS:0 = 一部キャラのニーソックス着用
		IF FLAG:ニーソックス着用
			RESULTS:1 = あり
		ELSE
			RESULTS:1 = なし
		ENDIF
	CASE 27
		RESULTS:0 = エッチな下着の追加
		IF FLAG:セクシーパンツ追加
			RESULTS:1 = 追加する
		ELSE
			RESULTS:1 = 追加しない
		ENDIF
		;addition custom code, handled in the collection menu
		; CASE 28
		; RESULTS:0 = パンツ収集状況表示
		; IF FLAG:パンツ収集状況タイプB
		; RESULTS:1 = 未入手でも表示する
		; ELSE
		; RESULTS:1 = 未入手は表示しない
		; ENDIF
	CASE 29
		RESULTS:0 = 地図の表示タイプ
		IF RECOLOREDMAPS
			IF ANIMATERECOLOREDMAPS
				RESULTS:1 = カラーマップ + 動画モード
			ELSE
				RESULTS:1 = カラーマップ
			ENDIF
		ELSE
			RESULTS:1 = クラシック
		ENDIF
	CASE 30
		RESULTS:0 = キャラリストの表示順
		IF FLAG:並び替え
			RESULTS:1 = 原作順
		ELSE
			RESULTS:1 = ＴＷ順
		ENDIF
	CASE 32
		RESULTS:0 = 採集時の再抽選機能
		IF FLAG:採集再抽選
			RESULTS:1 = 有効
		ELSE
			RESULTS:1 = 無効
		ENDIF
	CASE 33
		RESULTS:0 = 日時天候による背景色推移
		IF FLAG:背景色推移
			RESULTS:1 = 有効
		ELSE
			RESULTS:1 = 無効
		ENDIF
	CASE 34
		RESULTS:0 = カウンターのお仕置き
		SELECTCASE FLAG:カウンター制裁
			CASE 0
				RESULTS:1 = あり
				RESULTS:2 = 弱みを握られるとまれに発生してうふふが中断します
			CASE 1
				RESULTS:1 = 過激なお仕置きはしない
				RESULTS:2 = 道具を使ったお仕置きを控えてくれます
			CASE 2
				RESULTS:1 = なし
		ENDSELECT
	CASE 35
		RESULTS:0 = 自動アナル開発許可
		SELECTCASE FLAG:アナル開発無効
			CASE 0
				RESULTS:1 = 許可
			CASE 1
				RESULTS:1 = あなた禁止
				RESULTS:2 = あなたに快Ａソースが入るカウンター行動を禁止します
			CASE 2
				RESULTS:1 = 相手禁止
				RESULTS:2 = 相手に快Ａソースが入るカウンター行動を禁止します
			CASE 3
				RESULTS:1 = あなた・相手禁止
				RESULTS:2 = 快Ａソースが入るカウンター行動を禁止します
		ENDSELECT
	CASE 36
		RESULTS:0 = 日常行動中の風チラ発生
		IF FLAG:風チラ発生
			RESULTS:1 = 有効
		ELSE
			RESULTS:1 = 無効
		ENDIF
	CASE 37
		RESULTS:0 = 誤爆挿入の発生
		IF FLAG:誤爆無効
			RESULTS:1 = 無効
			RESULTS:2 = 押し倒し中に相手が誤って挿入することがなくなります
		ELSE
			RESULTS:1 = 有効
			RESULTS:2 = 押し倒し中に相手が誤って挿入することがあります
		ENDIF
	CASE 38
		RESULTS:0 = 妊娠期間設定
		係数 = 1 + FLAG:妊娠日程倍率
		SELECTCASE 係数
			CASE 1
				RESULTS:1 = 通常
			CASEELSE
				RESULTS:1 '= @"%TOSTR(係数)%배속"
		ENDSELECT
	CASEELSE
		RESULT = 0
ENDSELECT
RETURN RESULT

@OPTION_SETTING(ARG)
CALL OPTION_SETNAME(ARG)
SELECTCASE RESULTS:0
	CASE "妊娠の有無"
		FLAG:妊娠スイッチ = !FLAG:妊娠スイッチ
	CASE "テキスト設定"
		IF FLAG:情景テキスト設定 == 1 && FLAG:口上テキスト設定 == 2
			FLAG:情景テキスト設定 = 1
			FLAG:口上テキスト設定 = -1
		ELSEIF FLAG:情景テキスト設定 == 1 && FLAG:口上テキスト設定 == -1
			FLAG:情景テキスト設定 = 0
			FLAG:口上テキスト設定 = -1
		ELSEIF FLAG:情景テキスト設定 == 0 && FLAG:口上テキスト設定 == -1
			FLAG:情景テキスト設定 = 1
			FLAG:口上テキスト設定 = 2
		ENDIF
	CASE "消耗品の自動購入"
		FLAG:消耗品自動購入 = !FLAG:消耗品自動購入
	CASE "汚れ度表示"
		FLAG:ゴミ表示OFF = !FLAG:ゴミ表示OFF
	CASE "移動時立ち止まり"
		CALL オプション切り替え("立ち止まり", 2)
	CASE "押し倒されなくなる判定"
		FLAG:押し倒し = !FLAG:押し倒し
	CASE "自動時止め移動"
		CALL オプション切り替え("瞬間移動", 3)
	CASE "住み込みイベント"
		FLAG:住み込みイベント = !FLAG:住み込みイベント
	CASE "注意札使用"
		FLAG:注意札使用 = !FLAG:注意札使用
	CASE "一部キャラのニーソックス着用"
		FLAG:ニーソックス着用 = !FLAG:ニーソックス着用
	CASE "宴会の発生"
		FLAG:宴会の有無 = !FLAG:宴会の有無
		SIF !FLAG:宴会の有無 ;addition custom code
			CALL ADD_BANQUET_RESET_ALL
	CASE "来訪モード"
		CALL オプション切り替え("交流来訪モード", 3)
	CASE "脱衣コマンドの扱い"
		CALL オプション切り替え("脱衣選択", 2)
	CASE "時間停止脱衣コマンドの扱い"
		CALL オプション切り替え("パンツ泥棒", 2)
	CASE "口上色"
		FLAG:口上色 = !FLAG:口上色
	CASE "おっぱいテキスト"
		IF FLAG:Look表示用乳房 == 1 && FLAG:Look表示用乳首 == 1
			FLAG:Look表示用乳房 = 1
			FLAG:Look表示用乳首 = 0
		ELSEIF FLAG:Look表示用乳房 == 1 && FLAG:Look表示用乳首 == 0
			FLAG:Look表示用乳房 = 0
			FLAG:Look表示用乳首 = 1
		ELSEIF FLAG:Look表示用乳房 == 0 && FLAG:Look表示用乳首 == 1
			FLAG:Look表示用乳房 = 0
			FLAG:Look表示用乳首 = 0
		ELSEIF FLAG:Look表示用乳房 == 0 && FLAG:Look表示用乳首 == 0
			FLAG:Look表示用乳房 = 1
			FLAG:Look表示用乳首 = 1
		ENDIF
	CASE "能力表示の表記"
		FLAG:能力表記 = !FLAG:能力表記
	CASE "カウンターの地の文"
		FLAG:カウンター地の文制御 = !FLAG:カウンター地の文制御
	CASE "エッチな下着の追加"
		FLAG:セクシーパンツ追加 = !FLAG:セクシーパンツ追加
		IF !FLAG:セクシーパンツ追加
			PRINTFORMW 이상한 속옷의 붐은 모모야에서 끝났다.
			PRINTL 
			PRINTFORML 가지고 있는 야한 속옷을 없앨까요?
			PRINTFORML 이것은 다음을 제거합니다: 팬티, 펀도시, G-스트링, 시스루 팬티, 오픈 크로치 팬티, 푸시 반창고, 그리고 밑위 없는 브리프.
			PRINTL 
			PRINTL [0] 더 이상 그런 건 필요 없어
			PRINTL [1] 그래도 그것들을 계속 갖고 싶어
			INPUT
			IF RESULT == 0
				CALL DELETE_SEXYPANTS
				CLEARLINE 10
			ELSE
				CLEARLINE 8
			ENDIF
		ENDIF
	CASE "セフレ系から恋慕系への陥落変化"
		FLAG:陥落路線変化 = !FLAG:陥落路線変化
	CASE "相手からの告白"
		FLAG:告白禁止 = !FLAG:告白禁止
	CASE "ターン毎のABLUP"
		FLAG:ABLUP省略 = !FLAG:ABLUP省略
	CASE "イベントによる[無知]喪失"
		FLAG:無知自動喪失禁止 = !FLAG:無知自動喪失禁止
	CASE "好意/理性の壁の表示"
		FLAG:好意理性短縮 = !FLAG:好意理性短縮
	CASE "子供の描写"
		FLAG:子供描写 = !FLAG:子供描写
	CASE "子供の性別"
		CALL オプション切り替え("子供の性別", 2)
	CASE "パンツ収集状況表示"
		FLAG:パンツ収集状況タイプB = !FLAG:パンツ収集状況タイプB
	CASE "ファーストキスの記録"
		CALL オプション切り替え("ＦＫ判定", 3)
	CASE "遭遇時の依頼提示"
		FLAG:依頼スルー = !FLAG:依頼スルー
	CASE "地図の表示タイプ"
		IF RECOLOREDMAPS
			IF ANIMATERECOLOREDMAPS
				;RECOLOREDMAPS = 0 ;custom code, disabled
				ANIMATERECOLOREDMAPS = 0
			ELSE
				ANIMATERECOLOREDMAPS = 1000
			ENDIF
		ELSE
			RECOLOREDMAPS = 1
		ENDIF
	CASE "キャラリストの表示順"
		FLAG:並び替え = !FLAG:並び替え
	CASE "採集時の再抽選機能"
		FLAG:採集再抽選 = !FLAG:採集再抽選
	CASE "日時天候による背景色推移"
		FLAG:背景色推移 = !FLAG:背景色推移
	CASE "カウンターのお仕置き"
		CALL オプション切り替え("カウンター制裁", 2)
	CASE "自動アナル開発許可"
		CALL オプション切り替え("アナル開発無効", 3)
	CASE "日常行動中の風チラ発生"
		FLAG:風チラ発生 = !FLAG:風チラ発生
