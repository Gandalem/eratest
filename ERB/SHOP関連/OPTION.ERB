;オプション設定処理
@OPTION(ARG) ;com custom code, ARG = 1: during training (not in the shop)
#DIM L_COUNT
#DIM L_FEED
#DIM TEMP

#DIM nTab = 80 ;custom code
#DIM FIRST_LINE
VARSET LOCAL
L_FEED = LINECOUNT
FIRST_LINE = LINECOUNT
TOOLTIP_SETDELAY 100
TEMP = CURRENTREDRAW()
REDRAW 0
PRINTBUTTON "★★", 1467
PRINT Select An Option
PRINTBUTTON "★★", 1467	
PRINTL
DRAWLINEFORM =
FOR L_COUNT, 0, 91
	CALL OPTION_SETNAME(L_COUNT)
	SIF !RESULT
		CONTINUE
	LOCAL:L_COUNT = 1
	IF RESULTS:2 == "" 
		PRINTFORML [{L_COUNT, 2}] - %OPTIONS_TR(RESULTS:0), nTab, LEFT%：　%OPTIONS_TR(RESULTS:1)%
	ELSE
		HTML_PRINT @"<button value='{L_COUNT}' title='%HTML_ESCAPE(OPTIONS_TR(RESULTS:2))%'>[{L_COUNT, 2}] - %OPTIONS_TR(RESULTS:0), nTab, LEFT%：　%OPTIONS_TR(RESULTS:1)%</button>"
	ENDIF
NEXT
PRINTFORML (Hover the mouse onto an option to see its tooltip)
DRAWLINEFORM －
PRINTFORML [91] - Automatic moans
PRINTFORML [92] - Filter settings
PRINTFORML [93] - Image display settings
PRINTFORML [94] - Disable characters
PRINTFORML [95] - Command filters
;#;PRINTFORML [96] - Counter actions filter (Debug)
;PRINTFORML [97] - Cooking settings
;custom code
PRINTFORML [100] - Mod feature configuration
;addition custom code
PRINTFORML [101] - Disable dialogue
;nas replacement for atw controverscial content toggle
PRINTFORML [900] - Fetish Toggles
;atw edit, hardcore content toggle
;PRINTFORML [102] - Disable controversial content
DRAWLINE

IF (SaveIsEZB ? LegendModeStage >= 4 # DAY > YearLength) && !ARG
	HTML_PRINT @"<button value='200' title='WARNING: Do not read any further'>[200] - Bite the Dust/NG+</button>"
ENDIF
PRINTFORML [999] - Finished
INPUT
SELECTCASE RESULT
CASE 0 TO 90
	SIF LOCAL:RESULT
		CLEARLINE LINECOUNT - FIRST_LINE
		CALL OPTION_SETTING(RESULT)
	CLEARLINE LINECOUNT - L_FEED
CASE 900
	CALL OPTION_MOD_FETISH
CASE 91
	CALL OPTION_オート喘ぎ一括設定
CASE 92
	CALL 簡易フィルタ一括設定
CASE 93
	CALL OPTION_画像表示詳細設定
CASE 94
	CALL 登場キャラ切り替え
CASE 95
	CALL OPTION_COMMAND_FILTER
[IF_DEBUG]
CASE 96
	CALL OPTION_COUNTER_FILTER
[ENDIF]
;CASE 97
;	CALL SET_OPTION_COOKING
CASE 100 ;custom code
	CALL OPTION_MOD
CASE 101 ;addition custom code
	CALL Add_Ban_Dialogue
CASE 102 ;atw edit, hardcore content toggle
	CALL HARDCORECONTENT_MENU
CASE 1467 ;cheat custom code
	CALL CHEAT_MENU()
CASE  200
	TOOLTIP_SETDELAY 500
	IF (SaveIsEZB ? LegendModeStage > 4 # DAY > YearLength) || ARG
		REDRAW TEMP
		RETURN
	ENDIF
	PRINTFORML Blow away time and return to the first day?
	PRINTL 
	PRINTL [0] Don't let him push the「Switch」——— !!!
	PRINTL [1] No, I've reached my limit! I'm going to push it! Now!
	INPUT
	IF RESULT == 1
		CALL 強くてニューゲーム
	ELSE
;		PRINTW 「スイッチ」を押すのは止められなかったが、幸運にもオプション選択までしか戻らなかった。
	ENDIF
CASEELSE
	TOOLTIP_SETDELAY 500
	REDRAW TEMP
	RETURN
ENDSELECT
REDRAW TEMP
RESTART

