@SHOW_SP_DISH_LIST
#DIM C_ID
#DIM START,10
#DIM ページ
#DIM 最後のページ
#DIM P調整
#DIM L調整
#DIM LASTNUM
#DIM CONST MAXLINE = 20
#DIM DYNAMIC nDishCount ;qol custom code
#DIM DYNAMIC nLearnedDishes ;qol custom code
;各ページの頭番を設定する
IF !START
	P調整 = 0
	L調整 = 0
	LASTNUM = 0
	FOR LOCAL, 1, CHARANUM
		RESULT = 0
		;addition custom code, for custom charadata special menu
		CALL KOJO_CHECK(LOCAL, "CHARADATA" , "SPECIAL_MENU")
		IF !RESULT 
		TRYCALLFORM SPECIAL_MENU_{NO:LOCAL}
		ENDIF 
		SIF !RESULT
			CONTINUE
		L調整 ++
		IF L調整 > MAXLINE
			P調整 ++
			START:P調整 = LOCAL
			L調整 = 1
		ENDIF
		LASTNUM = LOCAL
		;qol custom code
		SIF LEARNED_MENU:LOCAL >= 100
			nLearnedDishes ++
		nDishCount ++
	NEXT
	START = 1
	ページ = 1
	;最後のページと最後のページの頭番を設定
	最後のページ = P調整 + 1
	START:最後のページ = LASTNUM + 1
ENDIF

