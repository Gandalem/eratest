@SHOW_SP_DISH_LIST
#DIM C_ID
#DIM START,10
#DIM ページ
#DIM 最後のページ
#DIM P調整
#DIM L調整
#DIM LASTNUM
#DIM CONST MAXLINE = 20
#DIM DYNAMIC nDishCount ;qol custom code
#DIM DYNAMIC nLearnedDishes ;qol custom code
;各ページの頭番を設定する
IF !START
	P調整 = 0
	L調整 = 0
	LASTNUM = 0
	FOR LOCAL, 1, CHARANUM
	RESULT = 0
	;addition custom code, for custom charadata special menu
	CALL KOJO_CHECK(LOCAL, "CHARADATA" , "SPECIAL_MENU")
	IF !RESULT
		TRYCALLFORM SPECIAL_MENU_{NO:LOCAL}
	ENDIF
	SIF !RESULT
		CONTINUE
	L調整 ++
	IF L調整 > MAXLINE
		P調整 ++
		START:P調整 = LOCAL
		L調整 = 1
	ENDIF
	LASTNUM = LOCAL
	;qol custom code
	SIF LEARNED_MENU:LOCAL >= 100
		nLearnedDishes ++
	nDishCount ++
	NEXT
	START = 1
	ページ = 1
	;最後のページと最後のページの頭番を設定
	最後のページ = P調整 + 1
	START:最後のページ = LASTNUM + 1
ENDIF
VARSET LOCAL
PRINTFORML ◆특별 요리 목록 PAGE.{ページ}
DRAWLINE
REDRAW 0
FOR LOCAL, START, START:ページ
RESULT = 0
;addition custom code, for custom charadata special menu
CALL KOJO_CHECK(LOCAL, "CHARADATA" , "SPECIAL_MENU")
IF !RESULT
	TRYCALLFORM SPECIAL_MENU_{NO:LOCAL}
ENDIF
SIF !RESULT
	CONTINUE
SIF LEARNED_MENU:LOCAL >= 100 ;custom code
	SETCOLOR C_YELLOW
PRINTFORM  [{LOCAL, 3}] %CALLNAME:LOCAL, 16, LEFT%
PRINTFORML %DISHNAME_TR(DISH_NAME)% （%DISHTYPE_TR(RESULTS)%）
LOCAL:1 ++
RESETCOLOR
NEXT
WHILE LOCAL:1 < MAXLINE
PRINTL 
LOCAL:1 ++
WEND
DRAWLINE
;qol custom code
PRINTFORML 학습한 레시피: {nLearnedDishes}/{nDishCount}
PRINTL [888] 맛으로 요리 검색
;---------------
PRINTL
PRINTL [999] 다음 페이지
PRINTL [998] 이전 페이지
PRINTL [  0] 돌아가기
INPUT
;戻る
IF !RESULT
	VARSET START
	RETURN
ELSEIF RESULT == 888 ;qol custom code
	LOCAL:9 = LINECOUNT
	CALL Qol_DishTaste
	CLEARLINE LINECOUNT - LOCAL:9
	;次のページ
ELSEIF RESULT == 999
	ページ ++
	IF ページ > 最後のページ
		ページ = 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
	;前のページ
ELSEIF RESULT == 998
	ページ --
	IF ページ < 1
		ページ = 最後のページ
		START = START:(最後のページ - 1)
	ELSEIF ページ == 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
ELSEIF INRANGE(RESULT, 1, CHARANUM)
	C_ID = RESULT
	RESULT = 0
	;addition custom code, for custom charadata special menu
	CALL KOJO_CHECK(C_ID, "CHARADATA" , "SPECIAL_MENU")
	IF !RESULT
		TRYCALLFORM SPECIAL_MENU_{NO:C_ID}
	ENDIF
	IF RESULT
		;custom code, show description again
		LOCALS = 【%DISHNAME_TR(DISH_NAME)%】%DISHCOMMENT_TR(DISH_COMMENT)%
		LOCAL = LINECOUNT
		PRINTFORML %BREAKENG(LOCALS, 0, "\n" + BL(STRLENS(@"【%DISHNAME_TR(DISH_NAME)%】")))%
		;contingency (only one extra line)
		IF LINECOUNT - LOCAL > 1
		ELSE
			PRINTL
		ENDIF
		CALL SHOW_TASTE(DISH_TASTE, "DISH_DATA")
		PRINTFORMW 
		CLEARLINE 4
	ENDIF
ENDIF
CALL RESET_DISH
CLEARLINE (MAXLINE + 10) ;qol custom code
RESTART
