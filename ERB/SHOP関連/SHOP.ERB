NEXT
WHILE LOCAL:1 < MAXLINE
	PRINTL 
	LOCAL:1 ++
WEND
DRAWLINE
;qol custom code
PRINTFORML Recipes learned: {nLearnedDishes}/{nDishCount}
PRINTL [888] Search dishes by taste
;---------------
PRINTL
PRINTL [999] Next page
PRINTL [998] Previous page
PRINTL [  0] Return
INPUT

;戻る
IF !RESULT
	VARSET START
	RETURN
ELSEIF RESULT == 888 ;qol custom code
	LOCAL:9 = LINECOUNT
	CALL Qol_DishTaste
	CLEARLINE LINECOUNT - LOCAL:9
;次のページ
ELSEIF RESULT == 999
	ページ ++
	IF ページ > 最後のページ
		ページ = 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
;前のページ
ELSEIF RESULT == 998
	ページ --
	IF ページ < 1
		ページ = 最後のページ
		START = START:(最後のページ - 1)
	ELSEIF ページ == 1
		START = 1
	ELSE
		START = START:(ページ - 1)
	ENDIF
ELSEIF INRANGE(RESULT, 1, CHARANUM)
	C_ID = RESULT
	RESULT = 0
	;addition custom code, for custom charadata special menu
	CALL KOJO_CHECK(C_ID, "CHARADATA" , "SPECIAL_MENU")
	IF !RESULT 
	TRYCALLFORM SPECIAL_MENU_{NO:C_ID}
	ENDIF 
	IF RESULT
		;custom code, show description again
		LOCALS = 【%DISHNAME_TR(DISH_NAME)%】%DISHCOMMENT_TR(DISH_COMMENT)%
		LOCAL = LINECOUNT
		PRINTFORML %BREAKENG(LOCALS, 0, "\n" + BL(STRLENS(@"【%DISHNAME_TR(DISH_NAME)%】")))%
		;contingency (only one extra line)
		IF LINECOUNT - LOCAL > 1
		ELSE
			PRINTL
		ENDIF
		CALL SHOW_TASTE(DISH_TASTE, "DISH_DATA")
		PRINTFORMW 
		CLEARLINE 4
	ENDIF
ENDIF
CALL RESET_DISH
CLEARLINE (MAXLINE + 10) ;qol custom code
RESTART