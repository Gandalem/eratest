; Modular ERB: キャラメイク.ERB
;FileName_SHOP_CUSTOM.ERB -------------------------- Rev1.00
;名前の設定
;CALL		USER
;ARG		MASTERキャラNO
;RETURN		VOID
;COMMENT
;-----------------------------------------------------------

@NAME_CUSTOM(ARG)
PRINTL 이름(을) 입력해 주세요.
IF STRLENS(NAME:ARG)
	PRINTFORM %@"현재 이름: %NAME:ARG%", 40, LEFT%
	PRINTBUTTON "[변경하지 말 것]",""
	PRINTL
ENDIF
INPUTS
IF RESULTS == ""
	NAME:ARG = %NAME:ARG%
ELSE
	NAME:ARG = %RESULTS%
ENDIF
PRINTL 닉네임을 입력해 주세요 - 사람들이 당신을 부를 이름입니다.
IF STRLENS(CALLNAME:ARG)
	PRINTFORM %@"현재 닉네임: %CALLNAME:ARG%", 40, LEFT%
	PRINTBUTTON "[변경하지 마시오]",""
	PRINTL
ENDIF
INPUTS
IF RESULTS == ""
	CALLNAME:ARG = %CALLNAME:ARG%
ELSE
	CALLNAME:ARG = %RESULTS%
ENDIF
IF TALENT:ARG:行きずり ;cheat custom code to support random characters
	SPLIT CSTR:ARG:モブ子プロフィール１, ":", LOCALS
	CSTR:ARG:モブ子プロフィール１ = %CALLNAME:ARG%:%LOCALS:1%
ENDIF
