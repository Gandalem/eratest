@CONDITION_面識ボーナス(ARG, ARG:1)
;ARG:1が真ならボーナス取れるか返す
#FUNCTION
#DIM 必要数
SELECTCASE ARG
	CASE 1
		必要数 = 10
	CASE 2
		必要数 = 30
	CASE 3
		必要数 = 50
	CASE 4
		必要数 = 80
	CASE 5
		必要数 = 120
ENDSELECT
IF ARG:1
	IF 面識カウント() >= 必要数 || GETBIT (GLOBAL_BONUS:4, ARG)
		RETURNF 1
	ELSE
		RETURNF 0
	ENDIF
ELSE
	RETURNF 必要数
ENDIF

