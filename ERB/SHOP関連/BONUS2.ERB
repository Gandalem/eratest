; Modular ERB: BONUS2.ERB

@BONUS
#DIM PAGE
#DIM CONST MAXPAGE = 6
;PAGE 0=面識 1=好感度 2=パンツ 3=陥落 4=孕ませ 5=技能 6=弾幕勝負
CALL 実績フラグ移行
CALL ボーナス素質判定
;addition custom code
IF PAGE <= MAXPAGE
	TRYCALLFORM PRINT_BONUS_{PAGE}
ELSE
	CALL ADD_ACHIEVEMENTS_PRINT_CUSTOM_PAGE(PAGE-MAXPAGE)
ENDIF
DRAWLINE
PRINTFORML 
PRINTFORMC [998] 이전 페이지
;addition custom code
PRINTFORMC 페이지 {PAGE + 1} / {MAXPAGE + ADD_ACHIEVEMENT_PAGES}
PRINTFORMC [999] 다음 페이지
PRINTL 
PRINTC  
;addition custom code
PRINTFORMC [0] 반환 [1000] 글로벌 업적 상태
INPUT
SELECTCASE RESULT
	CASE 0
		RETURN
	CASE 998
		PAGE --
	CASE 999
		PAGE ++
	CASE 1000 ;addition custom code, edited
		PRINTFORML [100] 보존
		PRINTFORML [200] 초기화
		PRINTFORML [999] 취소
		INPUT
		SELECTCASE RESULT
			CASE 100
				PRINTFORML 현재 업적 진행 상황을 전역 저장 파일에 저장한다.
				PRINTFORML 계속 진행할까요?
				CALL ASK_YN
				IF !RESULT
					FOR LOCAL, 3, 10
					GLOBAL_BONUS:LOCAL = FLAG:(LOCAL + 700)
					SAVEGLOBAL
					NEXT
					CALL ADD_ACHIEVEMENT_SAVE_GLOBAL() ;addition custom code
					PRINTFORMW 완료했다.
				ENDIF
			CASE 200
				PRINTFORML 전역 저장 데이터에서 업적 상태를 삭제할 것이다.
				PRINTFORML ※현재 업적 상태가 영향을 받을 수도 있고 받지 않을 수도 있다.
				PRINTFORML 진행하시겠습니까?
				CALL ASK_YN
				IF !RESULT
					FOR LOCAL, 3, 10
					GLOBAL_BONUS:LOCAL = 0
					SAVEGLOBAL
					NEXT
					CALL ADD_ACHIEVEMENT_RESET_GLOBAL() ;addition custom code
					PRINTFORMW 완료했다.
				ENDIF
			CASEELSE
		ENDSELECT
	CASEELSE
		IF PAGE <= MAXPAGE ;addition custom code
			TRYCALLFORM REWARD_BONUS_{PAGE}(RESULT)
		ELSE
			CALL ADD_ACHIEVEMENTS_TOGGLE_ACHIEVEMENT(RESULT)
		ENDIF
ENDSELECT
SIF PAGE >= MAXPAGE + ADD_ACHIEVEMENT_PAGES ;addition custom code
	PAGE = 0
SIF PAGE < 0
	PAGE = MAXPAGE + ADD_ACHIEVEMENT_PAGES - 1 ;addition custom code
RESTART

