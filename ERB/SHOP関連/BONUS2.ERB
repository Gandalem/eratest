	IF GETBIT (FLAG:弾幕勝負ボーナス取得状況, LOCAL)
		IF !REMOVABLE_BONUS_6(LOCAL)
			SETCOLOR 100, 100, 100
			PRINTPLAINFORM [{LOCAL}] - {CONDITION_弾幕勝負ボーナス(LOCAL)}명 이상의 단막 승리 보너스【완료】%BONUS_NAME_6(LOCAL)%
		ELSE
			IF !CONDITION_弾幕勝負ボーナス(LOCAL, 1)
				SETCOLOR C_ORANGE
			ELSE
				SETCOLOR C_P_BLUE
			ENDIF
			IF LOCAL != 6
				PRINTFORM [{LOCAL}] - {CONDITION_弾幕勝負ボーナス(LOCAL)}명 이상과의 단막 승리 보너스【완료】%BONUS_NAME_6(LOCAL)%
			ELSE
				PRINTFORM [{LOCAL}] 【완료】단막 보너스에서 요리히메와 헤카티아를 모두 격파했습니다. %BONUS_NAME_6(LOCAL)%
			ENDIF
		ENDIF
	ELSE
		SETCOLOR C_AQUA
		IF LOCAL != 6
			PRINTFORM [{LOCAL}] - {CONDITION_弾幕勝負ボーナス(LOCAL)}명 이상의 인물과의 탄막 승리 보너스
		ELSE
			PRINTFORM [{LOCAL}] - 요리히메와 헤카티아를 모두 단마쿠 보너스에서 처치함
		ENDIF
	ENDIF
	RESETCOLOR
ENDIF
PRINTL 
NEXT

@CONDITION_弾幕勝負ボーナス(ARG, ARG:1)
;ARG:1が真ならボーナス取れるか返す
#FUNCTION
#DIM 必要数
SELECTCASE ARG
	CASE 1
		必要数 = 10
	CASE 2
		必要数 = 25
	CASE 3
		必要数 = 50
	CASE 4
		必要数 = 75
	CASE 5
		必要数 = 100
ENDSELECT
IF ARG:1
	IF GETBIT (GLOBAL_BONUS:9, ARG)
		RETURNF 1
	ELSEIF 弾幕勝負勝利カウント() >= 必要数 && ARG < 6
		RETURNF 1
	ELSEIF CFLAG:98:弾幕勝負勝利 && CFLAG:113:弾幕勝負勝利 && ARG == 6
		RETURNF 1
	ELSE
		RETURNF 0
	ENDIF
ELSE
	RETURNF 必要数
ENDIF

@REWARD_BONUS_6(ARG)
SIF GETBIT (FLAG:弾幕勝負ボーナス取得状況, ARG)
	RETURN
IF !CONDITION_弾幕勝負ボーナス(ARG, 1)
	;周回後、満たしていないが取得している状態
	IF GETBIT (FLAG:弾幕勝負ボーナス取得状況, ARG)
		CALL BONUS_CAUTION
		SIF RESULT
			RETURN
	ELSE
		RETURN
	ENDIF
ENDIF
INVERTBIT FLAG:弾幕勝負ボーナス取得状況, ARG
SIF !GETBIT (FLAG:弾幕勝負ボーナス取得状況, ARG)
	RETURN
SELECTCASE ARG
	CASE 1 ;addition custom code
		PRINTW 전투경험을 얻었고 최대 스태미너가 증가했다!
		EXP:MASTER:戦闘経験 += 50
		MAXBASE:MASTER:体力 += 100
	CASE 2
		PRINTL 당신은 [그레이즈능숙함]을 획득했다!
		PRINTW 단마쿠 중, [회피에 집중하기]를 선택하면 피해가 더욱 감소한다!
	CASE 3
		PRINTW 최대 스태미나가 증가했다!
		MAXBASE:MASTER:体力 += 300
	CASE 4
		PRINTL 당신은 [영력충전]을 얻었다!
		PRINTW 단막 중, [회피에 집중하기]를 선택하면 주사위 값이 증가한다!
	CASE 5
		PRINTL 당신은 「익스텐드」를 획득했다!
		PRINTW 단막(Danmaku) 중에는 생명 하나를 추가로 가지고 시작한다.
	CASE 6
		PRINTL 루나슈터를 획득했다!
		PRINTW 단마쿠 동안 시작 시 추가 폭탄을 얻는다! 폭탄 효율도 증가했다!
	CASEELSE
		RETURN
ENDSELECT

@BONUS_NAME_6(ARG)
#FUNCTIONS
SELECTCASE ARG
	CASE 1 ;addition custom code
		RETURNF "Combat Exp+50&Max STA +100"
	CASE 2
		RETURNF "【Good Grazing】"
	CASE 3
		RETURNF "Max STA +300"
	CASE 4
		RETURNF "【Full Spirit Power】"
	CASE 5
		RETURNF "【Extend】"
	CASE 6
		RETURNF "【Luna Shooter】"
ENDSELECT

@REMOVABLE_BONUS_6(ARG)
#FUNCTION
;全て1
RETURNF 1
SELECTCASE ARG
	CASE 0
		RETURNF 0
	CASEELSE
ENDSELECT

@弾幕勝負勝利カウント
#FUNCTION
#DIM 弾幕勝負勝利カウント
弾幕勝負勝利カウント = 0
FOR LOCAL,1,CHARANUM
SIF CFLAG:LOCAL:弾幕勝負勝利
	弾幕勝負勝利カウント ++
NEXT
RETURNF 弾幕勝負勝利カウント
