@CHANGE_MONTH
#DIM おみくじ代
#DIM IFS_COST
;easy day change
FOR LOCAL, 0, CHARANUM
IF TALENT:LOCAL:BornChild
	;no aging after 2
	;this cap will be increased once life stages are released
	SIF CharaAge:LOCAL:0 >= 2
		CONTINUE
	;born child aging
	SELECTCASE CharaAge:LOCAL:0
		CASE 10 TO 17
			D = 34
			Y = 4
		CASE 7 TO 10
			D = 30
			Y = 3
		CASE 3 TO 7
			;toddler
			D = 30
			Y = 4
		CASE 1 TO 2
			;infant
			D = 4
			Y = 1
		CASE 0
			;newborn
			D = 25
			Y = 1
		CASEELSE
			;15+
			D = YearLength
			Y = 1
	ENDSELECT
	C = (YearLength*100)
	Q = (C)/D * Y
	SIF Q-(Q/100*100) > 50
		Q += 100
	Q = Q/100
	CharaAge:LOCAL:4 += Q
ELSE
	CharaAge:LOCAL:4 ++
ENDIF
IF CharaAge:LOCAL:4 >= YearLength
	$HappyBirthday
	SIF CanAge(LOCAL)
		CharaAge:LOCAL:0 ++
	CharaAge:LOCAL:4 = 0
	PRINTFORML 생일 축하해 %CALLNAME:LOCAL%!
	PRINTFORML %NAME:LOCAL%은(는) 이제 {CharaAge:LOCAL:0} ({CharaAge:LOCAL:1})이다. 
	SIF CanAge(LOCAL)
		CALL BirthdayAilment(LOCAL, 1)
ENDIF
;chronological
IF !((DAY+CharaAge:LOCAL:2) % YearLength)
	CharaAge:LOCAL:1 ++
ENDIF
IF (DAY:0+StartingDay) >= charaArrive:LOCAL:0 && CFLAG:LOCAL:出禁 == 99
	CFLAG:LOCAL:出禁 = 0
	PRINTFORML %NAME:LOCAL%이(가) 명단에 추가되었다.
ENDIF
NEXT
;Reset potty chart
IF DAY % 7 == 0
	VARSET PottyChartStatus
	VARSET PottyChartNightStatus
	VARSET PottyChartToileting
	VARSET PottyChartAccident
ENDIF
;日付が月を跨いだら月変更
IF DAY:3 > 31
	DAY:3 = 1
	DAY:2 ++
	;冬の次は春
	IF DAY:2 > 4
		DAY:2 = 1
		FLAG:年始貸付金 = FLAG:地主貸付金
		;(天候パッチ)長期予報を行う
		CALL WEATHER_FORECAST_1YEAR
	ENDIF
	;夏になったらバレンタインフラグリセット
	SIF DAY:2 == 2
		CVARSET CFLAG, 383
	;徴収発生
	SIF FLAG:地主
		FLAG:年貢 = 1
	IF FLAG:水やり代行
		FLAG:水やり代行 = 0
		PRINTFORMW 물 주기 대행 서비스와의 계약이 종료되었다.
		;custom qol
		PRINTFORMW 갱신 요청을 보낼까요?
		PRINTFORML 돈:%金額表示(MONEY)%, 카리스마:CM%三桁区切(MONEY:2)%
		CALL ASK_M("취소",1,"갱신(¥15000)",MONEY >= 15000,"재생(매력 70)",MONEY:2 >= 70)
		IF RESULT > 0
			SELECTCASE RESULT
				CASE 1
					MONEY -= 15000
				CASE 2
					MONEY:2 -= 70
			ENDSELECT
			FLAG:水やり代行 = 1
			PRINTFORMW 물 주기 대행 서비스가 갱신되었다.
		ENDIF
	ENDIF
	IF FLAG:新聞購読
		IF MONEY < 3000 && MONEY:2 < 10
			PRINTFORML 돈이 떨어져서 분분마루 구독이 종료되었다.
		ELSE
			PRINTL
			PRINTFORML 번분마루 구독을 갱신할까요? (%金額表示(3000)% 또는 매달 카리스마 10)
			;custom code, show current balance
			PRINTFORML 돈:%金額表示(MONEY)%, 카리스마:CM%三桁区切(MONEY:2)%
			CALL ASK_M("구독을 취소한다",1,@"갱신 (%金額表示(3000)%을)",MONEY >= 3000,"갱신한다 (카리스마 10 소모)",MONEY:2 >= 10)
			SELECTCASE RESULT
				CASE 0
					PRINTFORML 구독을 중단했다.
					FLAG:新聞購読 = 0
				CASE 1
					CALL PAY_MONEY_YEN(3000, 2)
					PRINTFORML 구독을 갱신했다.
				CASE 2
					CALL PAY_MONEY_CM(10, 2)
					PRINTFORML 구독을 갱신했다.
			ENDSELECT
		ENDIF
	ENDIF
	IF FLAG:おみくじ契約
		おみくじ代 = 50
		SIF !MAIN_MAP
			おみくじ代 = 30
		IF MONEY:2 < おみくじ代
			PRINTFORML 카리스마가 소진되어, 오미쿠지 계약이 종료되었다.
			FLAG:おみくじ契約 = 0
		ELSE
			;custom code, show cm cost and current charisma
			PRINTFORML 오미쿠지 계약을 갱신할까요? (CM{おみくじ代}, 현재 카리스마:CM%三桁区切(MONEY:2)%)
			CALL ASK_YN
			IF !RESULT
				PRINTFORML 계약이 갱신되었습니다.
				CALL PAY_MONEY_CM(おみくじ代, 2)
			ELSE
				FLAG:おみくじ契約 = 0
				PRINTFORML 계약은 해지될 것이다.
			ENDIF
		ENDIF
	ENDIF
	CALL IFS_SUBSCRIBE
	;addition custom code
	FOR LOCAL, 0, CHARANUM
	CALL KOJO_MESSAGE_SEND("EVENT", 0, LOCAL,,, "MONTH_CHANGE")
	NEXT
ENDIF
;異常値を固定修正
SIF DAY:3 < 1
	DAY:3 = 1
SIF DAY:2 < 1 || DAY:2 > 4
	DAY:2 = 1
