@GET_WEATHER
#FUNCTIONS
#DIMS 表示_異常気象,15
;(天候パッチ)台風・猛吹雪は表示しない
IF FLAG:異常気象 && FLAG:異常気象 != 9 && FLAG:異常気象 != 10
	SPLIT " /Ｃ敏感/Ｖ敏感/Ａ敏感/Ｂ敏感/Ｍ敏感/スカート/パンツ/桃色の風/台風/猛吹雪", "/", 表示_異常気象
	RETURNF 表示_異常気象:(FLAG:異常気象)
ENDIF
;(天候パッチ)豪雨・ひょうを追加
SIF !STRLENS(LOCALS)
	SPLIT "晴れ/快晴/薄曇/曇り/雨/大雨/霧雨/霧/雪/大雪/細雪/霧雪/みぞれ/あられ/豪雨/ひょう", "/", LOCALS
RETURNF LOCALS:(TIME:5)
;-------------------------------------------------
;平日判定(ARG)
;DAYを渡して月～金曜日なら1
;-------------------------------------------------

@IS_WEEKDAY(ARG)
#FUNCTION
SIF !ARG
	ARG = DAY
RETURNF INRANGE(ARG % 7, 1, 5)
;-------------------------------------------------
;週末判定(ARG)
;DAYを渡して土日なら1
;-------------------------------------------------

@IS_WEEKEND(ARG)
#FUNCTION
SIF !ARG
	ARG = DAY
RETURNF !INRANGE(ARG % 7, 1, 5)
;-------------------------------------------------
;曜日一致判定(ARG)
;DAYと文字列を渡し、一致していれば1
;判定用文字列は日月火水木金土で各曜日を表す（＝複数指定可能）
;-------------------------------------------------

@YOUBI_MATCH(ARG, CHECK_STR)
#FUNCTION
#DIMS  CHECK_STR
SIF !ARG
	ARG = DAY
SIF STRCOUNT(CHECK_STR, GET_DAY(ARG))
	RETURNF 1
RETURNF 0
;-------------------------------------------------
;関数名:GET_DAY
;概　要:曜日を表す文字列を取得する関数
;引　数:引数がない場合DAY
;戻り値:曜日を表す文字列(日/月/火/水/木/金/土)
;備　考:文中関数
;-------------------------------------------------

@GET_DAY(ARG)
#FUNCTIONS
#DIMS CONST YOUBI = "日", "月", "火", "水", "木", "金", "土"
SIF !ARG
	ARG = DAY
RETURNF YOUBI:(ARG % 7)
