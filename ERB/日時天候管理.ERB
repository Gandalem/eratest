@CHANGE_TIMEZONE
#DIM 現在時間帯
;SELECTCASE TIME
;	CASE 240 TO 599
;		LOCAL = 1
;	CASE 600 TO 1139
;		LOCAL = 2
;	CASE 1140 TO 1440 , 0 TO 239
;		LOCAL = 3
;ENDSELECT
SELECTCASE TIME
	;AM4~6　早朝
	CASE 240 TO 359
		LOCAL = 1
		;AM6~12　正午前
	CASE 360 TO 719
		LOCAL = 2
		;PM12~3　昼
	CASE 720 TO 899
		LOCAL = 3
		;PM3~6　昼下がり
	CASE 900 TO 1079
		LOCAL = 4
		;PM6~8　夕
	CASE 1080 TO 1199
		LOCAL = 5
		;PM8~11　夜
	CASE 1200 TO 1379
		LOCAL = 6
		;PM11~AM4　深夜
	CASE 0 TO 239, IS >= 1380
		LOCAL = 7
ENDSELECT
;(天候パッチ)天候システム上の時間帯管理
SELECTCASE TIME
	;AM0~3　未明
	CASE 0 TO 179
		現在時間帯 = 1
		;AM3~6　明け方
	CASE 180 TO 359
		現在時間帯 = 2
		;AM6~9　朝
	CASE 360 TO 539
		現在時間帯 = 3
		;AM9~12　昼前
	CASE 540 TO 719
		現在時間帯 = 4
		;PM0~3　昼過ぎ
	CASE 720 TO 899
		現在時間帯 = 5
		;PM3~6　夕方
	CASE 900 TO 1079
		現在時間帯 = 6
		;PM6~9　夜のはじめ頃
	CASE 1080 TO 1259
		現在時間帯 = 7
		;PM9~12　夜遅く
	CASE IS >= 1260
		現在時間帯 = 8
ENDSELECT
;(天候パッチ)現在の天候傾向を判定
CALL CHANGE_WEATHER_SYSTEM
IF LOCAL != TIME:2
	TIME:2 = LOCAL
	TRYCALLFORM MOB_PLACE_{MAIN_MAP}
	CALL TIMEZONE_MOVE
ENDIF
;(天候パッチ)天候システム上の時間帯変動・天候変化
IF WEATHER_TIMEZOME != 現在時間帯
	WEATHER_TIMEZOME = 現在時間帯
	CALL CHANGE_WEATHER
ENDIF
;(天候パッチ)時刻・天候に応じて背景色を変更
CALL SET_MAP_WEATHER_BGCOLOR
