@CHANGE_WEATHER
#DIM 地底
#DIM 入手パンツ
#DIM 持ち主
#DIM ループ開始
#DIM ループ終了
#DIM ループ加算
DEBUGPRINTL 【CHANGE_WEATHER】변화_날씨 호출
;天候管理にメッセージ表示処理させてすみましぇん＞＜；
;うふふ中は空気を読む程度の能力
;天候変化しなくても虹は消える
地底 = 0
IF CFLAG:MASTER:デート中 == 9
	地底 = 1
ELSEIF CFLAG:MASTER:現在位置 == OMANEKIBEYA() && GROUPMATCH(CFLAG:MASTER:お招き, 36, 37, 38, 49, 60, 64, 83, 84)
	地底 = 1
ENDIF
TIME:7 = 0
IF !地底
	SELECTCASE FLAG:異常気象
		CASE 7
			;こうでもしないとまたノーパンが飛んできてしまうと思うの
			DO
			CALL RAND_CHARASELECT("主人公以外のキャラリスト")
			持ち主 = RESULT
			入手パンツ = 今日のぱんつ(持ち主)
			LOOP !入手パンツ
			SIF CFLAG:持ち主:(入手パンツ + パンツ管理) == 0
				SETCOLOR C_PINK
			PRINTFORML 회오리가 지나가면서 %CALLNAME:持ち主%의 %PANTSNAME(入手パンツ,持ち主)%을 들고 간다.
			RESETCOLOR
			CALL ASK_YN("그것들을 집어라","그들을 내버려 두어라")
			IF !RESULT
				PRINTFORMW 당신은 %CALLNAME:持ち主%의 %PANTSNAME(入手パンツ,持ち主)%를 집어든다.
				CALL PANTS_GETTING(持ち主, 入手パンツ)
				;addition custom code, grant some grace period for girls in the same room
				FOR LOCAL, 1, CHARANUM
				SIF CFLAG:LOCAL:現在位置 != CFLAG:MASTER:現在位置
					CONTINUE
				CFLAG:LOCAL:ディレイ = 10
				NEXT
				;------------------------------------------------------------------------
			ELSE
				PRINTFORML 입수한 팬티(%PANTSNAME(入手パンツ,持ち主)%PANTSNAME)가 날아가 버렸다.
			ENDIF
		CASE 8
			CALL PINK_WIND(1) ;addition custom code, apply through function for consistency
			GOTO SKIPWE
			SETCOLOR 255,100,255
			FONTBOLD
			PRINTFORMW 분홍빛 바람이 이상향을 휘감는다!
			FOR LOCAL,1,CHARANUM
			SIF CFLAG:LOCAL:出禁 ;addition custom code, prevent disabled characters from receiving pink wind effect
				CONTINUE
			IF !RAND:8 && !TALENT:LOCAL:妊娠
				PRINTFORML %CALLNAME:LOCAL%은 분홍색 바람에 휩싸여 이상함을 느낀다...
				CFLAG:LOCAL:溜まってる度 += LIMIT((10 + RAND:20 + RAND:20 + RAND:20) * ABL:LOCAL:欲望,200,1000)
				SIF !TALENT:LOCAL:人形
					TCVAR:LOCAL:発情 = 1
			ENDIF
			NEXT
			RESETCOLOR
			FONTREGULAR
			$SKIPWE
	ENDSELECT
ENDIF
SIF FLAG:異常気象 >= 1 && FLAG:異常気象 <= 8
	RETURN
SIF TIME:5 > 15
	TIME:5 = 0
;(天候パッチ)天候変更禁止ならば処理終了
SIF FORBIDDEN_CHANGE_WEATHER == 1
	RETURN
;(天候パッチ)新しい天候管理システムへ
TRYCALLFORM CHANGE_WEATHER_SYSTEM_{NOW_WEATHER_CONTROL}
;addition custom code, add shooting star
CALL Add_ShootingStar
;定時遭遇位置再設定

@TIMEZONE_MOVE
#DIMS 移動前
#DIMS 移動後
#DIM nGotChara
FOR LOCAL,1,CHARANUM
SIF NO:LOCAL == MASTER ;addition custom code, player duplication
	CONTINUE
SIF 出現状態(LOCAL) != 1
	CONTINUE
SIF !CHARA_HOLIDAY(LOCAL)
	CONTINUE
SIF CFLAG:LOCAL:お招き
	CONTINUE
SIF CFLAG:LOCAL:同行 || CHK_DATENOW(CFLAG:LOCAL:デート中)
	CONTINUE
SIF !CFLAG:LOCAL:前ターン位置
	CONTINUE
SIF CFLAG:LOCAL:睡眠
	CONTINUE
;あなたと同じ場所にいるときは確率が下がる
IF CFLAG:MASTER:現在位置 == CFLAG:LOCAL:現在位置
	IF TALENT:LOCAL:恋慕
		;恋慕は5分の1
		SIF RAND:5
			CONTINUE
	ELSEIF TALENT:LOCAL:思慕
		;思慕は4分の1
		SIF RAND:4
			CONTINUE
	ELSE
		;それ以外は3分の1
		SIF RAND:3
			CONTINUE
	ENDIF
ELSE
	;見てない場所なら2分の1
	SIF RAND:2
		CONTINUE
ENDIF
CALL 遭遇フラグ決定(LOCAL)
NEXT
;全キャラ決定後、連動キャラを設定する
FOR LOCAL, 1, CHARANUM
SIF NO:LOCAL == MASTER ;addition custom code, player duplication
	CONTINUE
VARSET RESULT
;addition custom code, for custom charadata movement
CALL KOJO_CHECK(LOCAL, "CHARADATA", "MOVE", 1)
IF RESULT == -1 ;do nothing
	VARSET RESULT
ELSEIF RESULT || RESULT:1 ;use these values
ELSE
	;addition custom code, duplicated characters
	TRYCALLFORM CHARAMOVE_DATA_{NO:LOCAL}(1)
ENDIF
;依存連動
IF RESULT
	CFLAG:LOCAL:遭遇位置 = CFLAG:RESULT:遭遇位置
	;対等連動
ELSEIF RESULT:1
	;連動設定する
	;NAS: nonexistant characters
	nGotChara = 連動キャラ設定(RESULT:1, RESULT:2, RESULT:3)
	SIF nGotChara >= CHARANUM
		CONTINUE
	CFLAG:LOCAL:遭遇位置 = CFLAG:nGotChara:遭遇位置
ENDIF
NEXT
