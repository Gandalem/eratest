;グラフィック表示簡易化ライブラリ
;なんかややこしいグラフィック表示関連を簡単に表示できるようにまとめたもの。
;HTMLもどきだし、可読性悪いし、冗長なので「もう画像指定したらheightとか勝手に揃えろよ」っていうことで作りました。
;********************************************************************************************
;********************************************************************************************
;COMPOSE_IMAGE関数
;指定したgraphicIDにリソース画像を重ねて合成する関数
;graphicIDが0の変数を渡すと勝手に使用可能なgraphicIDを走査してその変数に渡す
;その場合は初めに合成されたリソースのサイズに合わせてグラフィックを作成する
;widthかheightに0が入っている場合には自動でリソース画像のサイズを取得してサイズを合わせる
;ブレンド名はリソースを合成する際に適用するカラーブレンドの名称を入れる　例="赤"
;NAS NOTE: USE THIS WHEN 画像合成() IS CALLED
;********************************************************************************************

@COMPOSE_IMAGE(graphicID, resourceName, POS_X = 0, POS_Y = 0, width = 0, height = 0, カラーブレンド名 = "")
#DIM REF graphicID		;合成先のgraphicID 参照渡し
#DIMS resourceName			;合成元のリソースID
#DIM POS_X					;リソースを配置するX座標
#DIM POS_Y					;リソースを配置するY座標
#DIM width					;合成するリソースのwidth
#DIM height					;合成するリソースのheight
#DIMS カラーブレンド名		;カラーブレンドの名称
#DIM カラーマトリクス, 5, 5	;カラーブレンドに使用するマトリクス
VARSET カラーマトリクス
SIF !SPRITECREATED(resourceName)
	RETURN 0
IF width == 0 || height == 0
	width = SPRITEWIDTH(resourceName)
	height = SPRITEHEIGHT(resourceName)
ENDIF
IF graphicID == 0
	;前回呼び出されていれば続きから始める
	graphicID = NEXT_GID
	WHILE GCREATED(graphicID)
	;空いているgraphicIDを走査する
	graphicID ++
	WEND
	;次回は続きから走査するように設定
	NEXT_GID = graphicID + 1
	GCREATE graphicID, width, height
ENDIF
IF カラーブレンド名 == ""
	GDRAWSPRITE graphicID, resourceName, POS_X, POS_Y,  width, height
	SIF IMG_DEBUG ;don't pollute the debug console unless enabled
		DEBUGPRINTFORML COMPOSE_IMAGE：%resourceName%:{graphicID},{POS_X},{POS_Y},{width},{height}
ELSE
	;カラーブレンドが設定されている場合、適用して合成
	CALL カラーブレンド取得(カラーマトリクス, カラーブレンド名)
	GDRAWSPRITE graphicID, resourceName, POS_X, POS_Y,  width, height, カラーマトリクス:0:0
	SIF IMG_DEBUG ;don't pollute the debug console unless enabled
		DEBUGPRINTFORML COMPOSE_IMAGE：%resourceName%:{graphicID},{POS_X},{POS_Y},{width},{height},%カラーブレンド名%
ENDIF
SIF RESULT == 0
	RETURN 0
RETURN 1
;********************************************************************************************
;リソース新規作成関数
;引数に渡した名称のスプライトリソースを、第二引数に渡したgraphicIDで作成する
;NAS NOTE: USE THIS WHEN リソース登録() IS CALLED
;********************************************************************************************

@RESOURCE_REGISTER(resourceName, graphicID)
#DIMS resourceName
#DIM graphicID
SIF SPRITECREATED(resourceName)
	RETURN 0
SIF !GCREATED(graphicID)
	RETURN 0
SPRITECREATE resourceName, graphicID
RETURN 1
;********************************************************************************************
;カラーブレンド取得関数
;カラーブレンド名を取得する関数
;カラーマトリクスの初期化関数はこの下にあります
;********************************************************************************************

@カラーブレンド取得(カラーマトリクス, カラーブレンド名)
#DIM REF カラーマトリクス, 0, 0	;使用するカラーマトリクスを格納する変数 参照渡し
#DIMS カラーブレンド名			;カラーブレンドの名称
SIF !カラーマトリクス初期化フラグ
	CALL カラーマトリクス初期化
;カラーマトリクス参照変数にベースから取得したマトリクスを代入する
SELECTCASE カラーブレンド名
	CASE "青"
		CALL カラーマトリクス取得(カラーマトリクス, 0)
	CASE "紫"
		CALL カラーマトリクス取得(カラーマトリクス, 1)
	CASE "赤"
		CALL カラーマトリクス取得(カラーマトリクス, 2)
	CASE "黄"
		CALL カラーマトリクス取得(カラーマトリクス, 3)
	CASE "緑"
		CALL カラーマトリクス取得(カラーマトリクス, 4)
	CASE "水"
		CALL カラーマトリクス取得(カラーマトリクス, 5)
	CASE "白"
		CALL カラーマトリクス取得(カラーマトリクス, 6)
	CASE "灰"
		CALL カラーマトリクス取得(カラーマトリクス, 7)
	CASE "黒"
		CALL カラーマトリクス取得(カラーマトリクス, 8)
	CASE "栗"
		CALL カラーマトリクス取得(カラーマトリクス, 9)
	CASE "桃"
		CALL カラーマトリクス取得(カラーマトリクス, 10)
	CASE "橙"
		CALL カラーマトリクス取得(カラーマトリクス, 11)
	CASE "普通"
		CALL カラーマトリクス取得(カラーマトリクス, 12)
	CASE "褐色"
		CALL カラーマトリクス取得(カラーマトリクス, 13)
	CASE "黄色"
		CALL カラーマトリクス取得(カラーマトリクス, 14)
	CASE "日焼け"
		CALL カラーマトリクス取得(カラーマトリクス, 15)
	CASE "不健康"
		CALL カラーマトリクス取得(カラーマトリクス, 16)
	CASE "悪魔"
		CALL カラーマトリクス取得(カラーマトリクス, 17)
	CASE "朱色"
		CALL カラーマトリクス取得(カラーマトリクス, 18)
	CASE "銀"
		CALL カラーマトリクス取得(カラーマトリクス, 19)
	CASE "金"
		CALL カラーマトリクス取得(カラーマトリクス, 20)
	CASE "土気色"
		CALL カラーマトリクス取得(カラーマトリクス, 21)
	CASEELSE
		CALL カラーマトリクス取得(カラーマトリクス, 12)
ENDSELECT
RETURN 1
;********************************************************************************************
;カラーマトリクス取得関数
;ディクショナリーライブラリから引用
;********************************************************************************************

@カラーマトリクス取得(カラーマトリクス, MID)
#DIM REF カラーマトリクス, 0, 0
#DIM MID ;マトリクスID
FOR LOCAL, 0, 5
FOR LOCAL:1, 0, 5
カラーマトリクス:LOCAL:(LOCAL:1) = カラーマトリクスベース:MID:LOCAL:(LOCAL:1)
NEXT
NEXT
RETURN 1
