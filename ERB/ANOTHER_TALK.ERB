;FileName_ANOTHER_TALK.ERB ------------------------- Rev1.01
;TARGET以外メンバー会話
;CALL		USER
;ARG		VOID
;RETURN		VOID
;COMMENT	
;-----------------------------------------------------------
@ANOTHERTARGET_TALK
#DIM TALKER,2
#DIM HATAKE
VARSET LOCAL
VARSET HATAKE
;DEBUGPRINTL 【ANOTHERTARGET_TALK】CALL ANOTHERTARGET_TALK

;CHARA_ARRAYフォルト対策
SIF CHARANUM > キャラクタ数上限
	RETURN 0

;話者の決定処理
CALL ANOTHER_TALK_SET_TALKER(TALKER)
HATAKE = INT_NOUMIN(FLAG:地主, "場所ID")

;DEBUGPRINTFORML 【ANOTHERTARGET_TALK】会話者１ = {TALKER:0} 会話者２ = {TALKER:1}
		;Custom code, add additional messages during Lunatic Survival.
TRYCALL LS_MESSAGE_TALK
	;Custom code, work sites for commissions.
RESULT = 0
LOCAL:1 = 0
TRYCALL COMMISSION_WORK_SITE(CFLAG:MASTER:現在位置)
SIF RESULT
	LOCAL:1 = 1
IF (TCVAR:TARGET:仕事開始 - TIME:0 <= 30 && TCVAR:TARGET:仕事開始 - TIME:0 > 0) && !FLAG:70
	CALL MESSAGE_TALK(12)
ELSEIF CFLAG:TARGET:睡眠
	CALL MESSAGE_TALK(3)
;ELSEIF GETBIT(FLAG:潜伏,0)
;	CALL MESSAGE_TALK(16)
ELSEIF TFLAG:描写中の子供 || EXP:MASTER:出産経験
	CALL MESSAGE_TALK(14)
ELSEIF ((CFLAG:TARGET:就寝時間 - TIME:0 <= 30 && CFLAG:TARGET:就寝時間 - TIME:0 > 0) || (TCVAR:睡眠薬強度 >= 2 && !RAND:3)) && !FLAG:70
	CALL MESSAGE_TALK(13)
ELSEIF TALKER:0 && TALKER:1 && (!FLAG:70 || CFLAG:TARGET:344 == 1)
	CALL MESSAGE_TALK(2, TALKER:0, TALKER:1)
ELSEIF 宴会場所在判定(MASTER)
	CALL MESSAGE_TALK(1)
ELSEIF TALENT:MASTER:形状 == 4 && TIME > 1140 && CFLAG:MASTER:デート中 && (CFLAG:MASTER:現在位置 % 100) % 10 && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
	CALL MESSAGE_TALK(5,0,0)
ELSEIF CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(HATAKE) && FLAG:地主
	CALL MESSAGE_TALK(8)
;畑拡張実装までは暫定的に畑0で決め打ち
ELSEIF 家庭菜園可(CFLAG:MASTER:現在位置) && PLANT_COUNT("growing") ;custom code
	;家庭菜園情景描写
	;CALL MESSAGE_TALK(10)
	;qol custom code - replace
	CALL Qol_FieldList
ELSEIF 物干し可(CFLAG:MASTER:現在位置) && TIME:5 < 2
	CALL MESSAGE_TALK(11)
ELSE
		;Custom code, suppress normal mob messages if the work site specifies.
	IF !LOCAL:1
		RESULT = 0
		TRYCALLFORM MAP_UNIQUEMESSAGE_{GET_MAPID(CFLAG:MASTER:現在位置)} ;addition custom code
	ENDIF
	;どれにも引っかからなければ天気
	SIF OUTROOF(CFLAG:MASTER:現在位置) && !RESULT && !GROUPMATCH(TIME:5, 0, 2, 3, 6, 7, 10, 11)
		CALL MESSAGE_TALK(4)
	;SIF+コメント行は不具合を起こすので調整
	;SIF OUTROOF(CFLAG:MASTER:現在位置) && !RESULT
	;どれにも引っかからなければ天気
	;	CALL MESSAGE_TALK(4)
ENDIF
;NAS STuffs
SIF (clothing_DiapieBulgie(MASTER) || (SoiledSelf:MASTER:0 || SoiledSelf:MASTER:1)) && !FLAG:70 && GET_TARGETNUM() > 0 && SHIRAHU(TARGET) && EQUIP:MASTER:6 && !TALENT:TARGET:NonSentient ;diapie bulgie
	HTML_PRINT @"◆%PANTY_SEE(MASTER,TARGET)%"
SIF (WetBed || MessyBed || BedWetterPadID:(BedProtectSettings:1)) && CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置
	CALL MESSAGE_TALK(131)
SIF !RAND:4 && !CFLAG:TARGET:睡眠 && !FLAG:70 && GET_TARGETNUM() > 0 && SHIRAHU(TARGET) && nSmellFetish ;target bath
	CALL MESSAGE_TALK(132)
SIF FacionPropagandaSign:(CFLAG:MASTER:300) > -1
	CALL MESSAGE_TALK(133)
SIF PottyLinePosition(TARGET) > -1 || PottyLinePosition(MASTER) > -1
	CALL MESSAGE_TALK(134)
;===============================	
SIF GETBIT(FLAG:潜伏,0) ;custom code, show concealment status even if other things are up
	CALL MESSAGE_TALK(16)
	;Custom code, fertilized eggs in a layer's home.
CALL NESTING_MESSAGE
CALL QOL_DISTANT_WATCHERS() ;qol custom code
	
;##########QOL NOTE: Don't forget to address 描写中の子供 flag at the very bottom in case you want the description to disable child interactions

;graveyards
SIF IS_GRAVEYARD(CFLAG:MASTER:現在位置)
	CALL MESSAGE_TALK(31)
SIF CFLAG:MASTER:現在位置 == 拠点_酒虫 && VAR_FERMENT != "" ;qol custom code, show the contents of sake bug
	CALL MESSAGE_TALK(99)

	;Custom code, Tupai in the mansion's parlor.
SIF MAIN_MAP == 3 && CFLAG:MASTER:現在位置 == 315
	CALL MESSAGE_TALK(94)

	;Custom code, fertilized eggs in a layer's home.
CALL NESTING_MESSAGE
	
IF !(FLAG:70 || CFLAG:うふふ || CFLAG:イタズラ || CFLAG:添い寝中) ;qol custom code, show radio hint, supposed to be in your room originally but it can be accessed anywhere now
	SELECTCASE TIME:0
		CASE 345 TO 359, 375 TO 389, 405 TO 419, 435 TO 449, 465 TO 479, 525 TO 539, 585 TO 599, 705 TO 719, 735 TO 749, 825 TO 839, 885 TO 899, 945 TO 959, 1005 TO 1019, 1065 TO 1079, 1125 TO 1139, 1185 TO 1199, 1245 TO 1259, 1305 TO 1319, 1365 TO 1379
		;天気予報(15分間)(05:45 06:15 06:45 07:15 07:45 08:45 09:45 11:45 12:15 13:45 14:45 15:45 16:45 17:45 18:45 19:45 20:45 21:45 22:45)
			CALL MESSAGE_TALK(97, 0)
		CASE 300 TO 329, 360 TO 374, 420 TO 434, 540 TO 554, 600 TO 614, 660 TO 674, 720 TO 734, 780 TO 794, 840 TO 854, 900 TO 914, 1020 TO 1034, 1140 TO 1184, 1200 TO 1214, 1260 TO 1274, 1380 TO 1394, 0 TO 14, 60 TO 74, 120 TO 134, 180 TO 194, 240 TO 254
		;ニュース(原則15分間)(05:00~05:29 06:00 07:00 09:00 10:00 11:00 12:00 13:00 14:00 15:00 17:00 19:00~19:44 20:00 21:00 23:00 24:00 01:00 02:00 03:00 04:00)
			CALL MESSAGE_TALK(97, 1)
		CASE 960 TO 989
		;気象通報(16:00~16:29)
			CALL MESSAGE_TALK(97, 2)
	ENDSELECT
ENDIF
;qol, describe sweating characters, make sure to keep in line with CHECK_SWEAT
IF DAY:2 == 2 && 時間帯 == 3 && INRANGE(天候, 0, 1)
	FOR LOCAL, 1, GET_TARGETNUM() + 1
		IF (OUTROOF(CFLAG:(TARGET:LOCAL):現在位置) || GET_MAPID(CFLAG:(TARGET:LOCAL):現在位置) == 9)
			CALL MESSAGE_TALK(96)
			BREAK
		ENDIF
	NEXT
ENDIF
	
;addition custom code
SIF ADD_ACTIVE_BANQUET_AT_LOCATION(CFLAG:MASTER:現在位置) >= 0
	CALL MESSAGE_TALK(95)
;qol custom code, show working/idling charas
FOR LOCAL, 1, GET_TARGETNUM() + 1
	IF WORKING(TARGET:LOCAL, 1) || Activity_Duration:(TARGET:LOCAL)
		CALL MESSAGE_TALK(98)
		BREAK
	ENDIF
NEXT
RETURN 0



;話者の決定処理
;渡されたTALKERを直接書き換える
@ANOTHER_TALK_SET_TALKER(TALKER)
#DIM REF     TALKER
#DIM DYNAMIC CHARA, キャラクタ数上限
#DIM DYNAMIC CNT_CHARA
VARSET TALKER
;対象キャラ選定
FOR LOCAL, 0, GET_TARGETNUM() + 1
	;MASTERの相手をしていたらスキップ
	SIF LOCAL == MASTER ;NAS: Non 0 Master
		CONTINUE
	SIF TARGET:LOCAL == TARGET:0
		CONTINUE
	SIF CFLAG:(TARGET:LOCAL):現在位置 != CFLAG:MASTER:現在位置
		CONTINUE
	;qol custom code, block during sex
	SIF CFLAG:(TARGET:LOCAL):うふふ
		CONTINUE
	;対象キャラID取得
	CHARA:(CNT_CHARA) = TARGET:LOCAL
	CNT_CHARA ++
NEXT
SIF CNT_CHARA < 2
	RETURN

LOCAL = RAND:(CNT_CHARA)
TALKER:0 = CHARA:LOCAL
ARRAYREMOVE CHARA, LOCAL, 1
CNT_CHARA --

;対象キャラ間の相性チェック
FOR LOCAL, 0, CNT_CHARA
	;相性の良いキャラが同室か
	SIF !RELATION:(TALKER:0):(CHARA:LOCAL) || RELATION:(TALKER:0):(CHARA:LOCAL) == 100 ;NAS: 100% Relation fix
		CONTINUE
	;相性を見て会話者２以上なら会話者を更新
	SIF TALKER:1 && RELATION:(TALKER:0):(TALKER:1) >= RELATION:(TALKER:0):(CHARA:LOCAL)
		CONTINUE
	TALKER:1 = CHARA:LOCAL
NEXT



;FileName_ANOTHER_TALK.ERB ------------------------- Rev1.03
;Info枠内メッセージ表示処理
;CALL		USER
;ARG		0:メッセージNO, 1:会話者１, 2:会話者２（メンバー会話時のみ）
;RETURN		VOID
;COMMENT	CASEの番号が若いほど出力優先度が高い
;-----------------------------------------------------------
@MESSAGE_TALK(ARG,ARG:1,ARG:2)
#DIMS 会場
#DIMS 子供の名前
#DIMS 子供の行動
#DIM CHARA
#DIM CHILDNUM
#DIM 同室
#DIM FilthThreshold, 5
;機能チェック
;SIF !GETBIT(FLAG:3,2)
	;RETURN 0
PRINTFORM ◆
;#; PRINTFORM (ID {ARG}) 
SELECTCASE ARG
	CASE 99 ;qol custom code
		PRINTFORML The Sake Bug jar is filled with %VAR_FERMENT_TR(VAR_FERMENT)%...\@ ABL:MASTER:教養 >= UniversalRank("B") && DAY:10 > 0 ? %" "%You can tell it went through %PRINT_PLUR("day", DAY:10)% worth of brewing.#\@
	CASE 98 ;qol custom code
		CALL QOL_PRINT_NPC_ACTIVITIES
	CASE 97 ;qol custom code
		LOCALS =
		SELECTCASE ARG:1
			CASE 0
			;天気予報(15分間)(05:45 06:15 06:45 07:15 07:45 08:45 09:45 11:45 12:15 13:45 14:45 15:45 16:45 17:45 18:45 19:45 20:45 21:45 22:45)
				LOCALS = The weather forecast
			CASE 1
			;ニュース(原則15分間)(05:00~05:29 06:00 07:00 09:00 10:00 11:00 12:00 13:00 14:00 15:00 17:00 19:00~19:44 20:00 21:00 23:00 24:00 01:00 02:00 03:00 04:00)
				LOCALS = News
			CASE 2
			;気象通報(16:00~16:29)
				LOCALS = The weather report
			CASEELSE
		ENDSELECT
		SIF STRLENS(LOCALS)
			PRINTFORML You hear the radio crackling... %LOCALS% seems to be on right now.
	CASE 96 ;qol custom code
		LOCALS =
		FOR LOCAL, 1, GET_TARGETNUM() + 1
			LOCALS += @"%CALLNAME:(TARGET:LOCAL)%、"
		NEXT
		IF OUTROOF(CFLAG:(TARGET:LOCAL):現在位置)
			PRINTFORML %BREAKENG(@"%LIST_IN_STRING(LOCALS)% \@ GET_TARGETNUM() == 1 ? is # are\@ sweating profusely under the hot summer sun...")%
		ELSEIF GET_MAPID(CFLAG:(TARGET:LOCAL):現在位置)
			PRINTFORML %BREAKENG(@"%LIST_IN_STRING(LOCALS)% \@ GET_TARGETNUM() == 1 ? is # are\@ sweating profusely in the sweltering summer climate of the Underworld...")%
		ENDIF
	CASE 95 ;addition custom code, replacement for CASE 1
		CALL ADD_BANQUET_MESSAGE_TALK
	CASE 94
			;Custom code, Tupai in the mansion's parlor.
		PRINTFORML Tupai \@ TIME <= 360 || TIME >= 1080 ? %SPLIT_G("sits in:watches you from")% # sleeps in\@ a hanging cage.
	CASE 95 ;qol custom code
		CALL QOL_DISTANT_WATCHERS
	CASE 1
		IF CHK_DATENOW(CFLAG:MASTER:デート中) && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
			会場 = %DATENAME_PLACE()%
		ELSE
			;custom code
			会場 = %NAME_FROM_PLACE_THE(TFLAG:宴会場)%
		ENDIF
		;参加者が居なければ表示されない
		IF FLAG:参加人数 > 0
			;宴会の規模に応じて分岐
			IF FLAG:宴会規模 <= 1500 || FLAG:参加人数 <= 3
				PRINTFORML The modest banquet being held in %会場% has only \@ FLAG:参加人数 == 1 ? one participant # around %PRINT_PLUR("participant", FLAG:参加人数)%\@...
			ELSE
				PRINTFORML The banquet being held in %会場% currently has around %PRINT_PLUR("participant", FLAG:参加人数)%...
			ENDIF
			;日を跨いだ場合
			IF DAY > FLAG:開始日
				;経過時間に応じて分岐
				IF TIME >= (FLAG:開始時間 + 240) - 1440 * (DAY - FLAG:開始日)
					IF FLAG:参加人数 <= 3
						PRINTFORML Seems like there's just a few die-hards left here...
					ELSE
						PRINTFORML Looks like some people have started to leave...
					ENDIF
				ELSEIF TIME >= (FLAG:開始時間 + 180) - 1440 * (DAY - FLAG:開始日)
					PRINTFORML Seems like it's rounding off soon...
				ELSEIF TIME >= (FLAG:開始時間 + 60) - 1440 * (DAY - FLAG:開始日)
					PRINTFORML The banquet is in full force, judging by the unceasing laughter and noise...
				;まだ始まったばかり
				ELSE
					PRINTFORML It's pretty crowded here...
				ENDIF
			ELSE
				;経過時間に応じて分岐
				IF TIME >= (FLAG:開始時間 + 240)
					IF FLAG:参加人数 <= 3
						PRINTFORML Seems like there's just a few die-hards left here...
					ELSE
						PRINTFORML Looks like some people have started to leave...
					ENDIF
				ELSEIF TIME >= (FLAG:開始時間 + 180)
					PRINTFORML Seems like it's rounding off soon...
				ELSEIF TIME >= (FLAG:開始時間 + 60)
					PRINTFORML The banquet is in full force, judging by the unceasing laughter and noise...
				;まだ始まったばかり
				ELSE
					PRINTFORML It's pretty crowded here...
				ENDIF
			ENDIF
		ELSE
			PRINTFORML The veteran (drunkards) finally fell asleep.
			;custom code
			PRINTFORML %NAME_FROM_PLACE_THE(TFLAG:宴会場)% has been ruined by the banquet...
		ENDIF
	CASE 2
		;対話表示
		;どっちも相性高め
		IF RELATION:(ARG:1):(ARG:2) > 100 && RELATION:(ARG:2):(ARG:1) > 100
			IF SignificantRelationship(ARG:1) && SignificantRelationship(ARG:2)
				PRINTFORML %CALLNAME:(ARG:1)% and %CALLNAME:(ARG:2)% stare at you absentmindedly.
			ELSEIF SignificantRelationship(ARG:1) || SignificantRelationship(ARG:2)
				PRINTFORML \@ SignificantRelationship(ARG:1) ? %CALLNAME:(ARG:1)% # %CALLNAME:(ARG:2)%\@ looks at you with passionate eyes despite being engaged in smalltalk with \@ SignificantRelationship(ARG:1) ? %CALLNAME:(ARG:2)% # %CALLNAME:(ARG:1)%\@.
			ELSE
				IF RAND:2
					PRINTFORML \@ CFLAG:(ARG:1):310 > CFLAG:(ARG:2):310 ? %CALLNAME:(ARG:1)% # %CALLNAME:(ARG:2)%\@ gently strokes \@ CFLAG:(ARG:1):310 > CFLAG:(ARG:2):310 ?%CALLNAME:(ARG:2)% # %CALLNAME:(ARG:1)%\@'s head.
				ELSE
					PRINTFORML %CALLNAME:(ARG:1)% and %CALLNAME:(ARG:2)% are having a pleasant chat with each other.
				ENDIF
			ENDIF
		;どちらかが相性高め
		ELSEIF (RELATION:(ARG:1):(ARG:2) > 100 && RELATION:(ARG:2):(ARG:1) < 100) || (RELATION:(ARG:1):(ARG:2) < 100 && RELATION:(ARG:2):(ARG:1) > 100)
			IF SignificantRelationship(ARG:1) && SignificantRelationship(ARG:2)
				PRINTFORML %CALLNAME:(ARG:1)% and %CALLNAME:(ARG:2)% are engaged in small talk, but look at you with feverish stares...
			ELSEIF SignificantRelationship(ARG:1) || SignificantRelationship(ARG:2)
				PRINTFORML \@ SignificantRelationship(ARG:1) ? %CALLNAME:(ARG:1)% # %CALLNAME:(ARG:2)%\@ glances at you despite being engaged in smalltalk with \@ SignificantRelationship(ARG:1) ? %CALLNAME:(ARG:2)% # %CALLNAME:(ARG:1)%\@.
			ELSE
				PRINTFORM \@ RELATION:(ARG:1):(ARG:2) > 100 ? %CALLNAME:(ARG:1)% tells %CALLNAME:(ARG:2)% # %CALLNAME:(ARG:2)% tells %CALLNAME:(ARG:1)% \@ a story
				PRINTDATAL
					DATAFORM  but the look of displeasure on \@RELATION:(ARG:1):(ARG:2) > 100 ? %CALLNAME:(ARG:2)%#%CALLNAME:(ARG:1)%\@'s face is clear...
					DATAFORM  but %HE_SHE(RELATION:(ARG:1):(ARG:2) > 100 ? ARG:2 # ARG:1)% isn't even looking at %HIM_HER(RELATION:(ARG:1):(ARG:2) > 100 ? ARG:1 # ARG:2)%...
					DATAFORM , but %HE_SHE(RELATION:(ARG:1):(ARG:2) > 100 ? ARG:2 # ARG:1)% just nods in agreement...
				ENDDATA
			ENDIF
		;どちらも相性低め
		ELSEIF RELATION:(ARG:1):(ARG:2) < 100 && RELATION:(ARG:2):(ARG:1) < 100
			IF SignificantRelationship(ARG:1) && SignificantRelationship(ARG:2)
				PRINTFORML %CALLNAME:(ARG:1)% and %CALLNAME:(ARG:2)% quarrel, but at times they look at you while smiling.
			ELSEIF SignificantRelationship(ARG:1) || SignificantRelationship(ARG:2)
				PRINTFORML \@ SignificantRelationship(ARG:1) ? %CALLNAME:(ARG:1)% pays no attention to %CALLNAME:(ARG:2)% # %CALLNAME:(ARG:2)% pays no attention to %CALLNAME:(ARG:1)% \@'s story and waves at you.
			ELSE
				PRINTFORM %CALLNAME:(ARG:1)% and %CALLNAME:(ARG:2)% are 
				PRINTDATAL
					DATAFORM quarreling about something...
					DATAFORM looking at each other with sullen expressions...
					DATAFORM fighting...
				ENDDATA
			ENDIF
		ENDIF
		;PRINTL
	CASE 3
		IF IsDead:TARGET:0
		PRINTFORML %CALLNAME:TARGET%'s lifeless corpse lays dormant on the ground...
		LOCALS '= @"%GET_STR(KilledBy:TARGET:0, "Weapon", TOINT(KilledWith:TARGET:0), "Ammo")%"
		SELECTCASE LOCALS
		CASE "12.7x99mm"
		PRINTFORML Heavy damage from front to back indicates %HE_SHE(TARGET)% was shot by an anti-material rifle...
		CASE "Arrow"
		PRINTFORML An arrow sticks out from the bloody corpse that is %CALLNAME:TARGET%...
		CASE "7.62x39mm", "7.62x51mm", "10.9x29mmR"
		PRINTFORML A moderate entry and exit wound indicates %HE_SHE(TARGET)% was shot by an full-caliber rifle...
		CASE "5.56x45mm", "5.7x28mm", "5.45x39mm"
		PRINTFORML A light entry and exit wound indicates %HE_SHE(TARGET)% was shot by an intermediate-caliber rifle...		
		CASE "9x19mm", "18.5x70mm", "9x29mmR", "9x33mmR", "9x18mm"
		PRINTFORML A light entry wound indicates %HE_SHE(TARGET)% was shot by a pistol or shotgun...
		CASEELSE
			IF GET_STR(KilledBy:TARGET:0, "Weapon", TOINT(KilledWith:TARGET:0), "Type") == "Explosive"
				PRINTFORML The body is charred black from the explosion...
			ELSEIF STRCOUNT(GET_STR(KilledBy:TARGET:0, "Weapon", TOINT(KilledWith:TARGET:0), "Class"), "Blade")
				PRINTFORML A stab wound is present on %CALLNAME:TARGET%'s corpse...
			ELSE
				PRINTFORML The corpse is perfectly intact...
			ENDIF		
		ENDSELECT
		ELSE
		PRINTFORML %CALLNAME:TARGET% is sound asleep...
		ENDIF
	CASE 4
		PRINTS "   "
		IF TIME:7
			SELECTCASE TIME:7
				;虹
				CASE 1
					IF FLAG:70
						PRINTL A monochrome rainbow hangs in the sky...
					ELSE
						PRINTL A rainbow hangs in the sky...
					ENDIF
				;ダイヤモンドダスト
				CASE 2
					PRINTL The snow crystals sparkle and shine in the sunlight... Your breathing leaves a white mist...
				;流れ星
				CASE 3
					IF FLAG:70
						PRINTL Falling stars are frozen in the night sky...
					ELSE
						PRINTL Falling stars occasionally streak across the night sky...
					ENDIF
				;流星群
				CASE 4
					IF FLAG:70
						PRINTL A meteor shower is frozen in the night sky...
					ELSE
						PRINTL The night sky is filled with a swarm of falling stars...
					ENDIF
			ENDSELECT
		ELSE
			SELECTCASE TIME:5
				;お天道様
				CASE 1
					IF TIME:2 >= 2 && TIME:2 <= 4
						IF DAY:2 == 2
							PRINTL The sun shines down mercilessly from the cloudless sky...
						ELSE
							PRINTL The sky is refreshingly clear.
						ENDIF
					ELSEIF TIME:2 >= 5 && TIME:2 <= 7 ;custom code
						PRINTL The stars are twinkling in the sky.
					ENDIF
				;雨
				;(天候パッチ)強風時の文章追加
				CASE 4
					IF FLAG:70
						PRINTL Small droplets are suspended in the air...
					ELSEIF WIND_VELOCITY >= 1
						PRINTL It's raining sideways.
					ELSE
						PRINTL Rain is falling...
					ENDIF
				;大雨
				;(天候パッチ)強風時の文章追加
				CASE 5
					IF FLAG:70
						PRINTL Raindrops are suspended in the air...
					ELSEIF WIND_VELOCITY >= 1
						PRINTL A heavy downpour is raging...
					ELSE
						PRINTL Rain is pouring down...
					ENDIF
				;大雨
				;(天候パッチ)豪雨時の文章追加
				CASE 14
					IF FLAG:70
						PRINTL Large raindrops are suspended in the air...
					ELSEIF WIND_VELOCITY >= 1
						PRINTL The wind and rain is so strong that you can hardly breathe...
					ELSE
						PRINTL The rain is so strong it feels oppressive... Makes it really hard to see what's ahead...
					ENDIF
				;霧・霧雨・霧雪
				;(天候パッチ)濃霧時の文章追加
				CASE 6, 7, 11
					PRINTL It's all white with fog...
				;雪
				;(天候パッチ)強風時の文章追加
				CASE 8
					IF FLAG:70
						PRINTL Snowflakes are suspended in the air...
					ELSEIF WIND_VELOCITY >= 1
						PRINTL A freezing blizzard is raging... Even your hot breaths just turn white...
					ELSE
						PRINTL Snow flutters around lazily in the air... Your breathing leaves a white mist...
					ENDIF
				;大雪
				;(天候パッチ)強風時の文章追加・大雪に変更
				CASE 9
					IF FLAG:70
						PRINTL Countless snowflakes are suspended in the air...
					ELSEIF WIND_VELOCITY >= 1
						PRINTL A heavy blizzard is blowing hard... One must pay attention to not get lost...
					ELSE
						PRINTL It's a snowstorm alright! Makes it really hard to see what's ahead...
					ENDIF
				;みぞれ
				CASE 12
					IF FLAG:70
						PRINTL The sleet is suspended...
					ELSE
						PRINTL Cold sleet is falling... Breathing leaves a white mist...
					ENDIF
				;あられ
				CASE 13
					IF FLAG:70
						PRINTL Even the hail is at a standstill...
					ELSE
						PRINTL A strong hail is raging...
					ENDIF
				;(天候パッチ)ひょう
				CASE 15
					IF FLAG:70
						PRINTL Even the heavy hailstorm is at a standstill...
					ELSE
