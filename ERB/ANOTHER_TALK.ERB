					LOCALS += "slight streaks of jelly、"
				CASE IS < 500
					LOCALS += "a blue stain、"
				CASE IS < 1000
					LOCALS += "dried pieces of gelatin around a large stain、"
				CASE IS < 1500
					LOCALS += "dried pieces of gelatin around a large stain、"
				CASE IS < 2000
					LOCALS += "dried pieces of gelatin around a large stain、"
				CASE IS < 3000
					LOCALS += "dried pieces of gelatin around a large stain、"
				CASE IS < 5000
					LOCALS += "dried pieces of gelatin around a large stain、"
				CASEELSE
					LOCALS += "jelly layered all over the bed、"
			ENDSELECT
		ENDIF
		SIF STRLENS(LOCALS:1)
			PRINTFORMSL LOCALS:1
		SIF STRLENS(LOCALS)
			PRINTFORML 당신의 침대는 %LIST_IN_STRING(LOCALS)% ({BEDWETTER_FIND_OUT_CHANCE()}\% 발각될 확률)
	CASE 132
		SELECTCASE GetFilthLevel(ARG)
			CASE 0
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% %HES_SHES(TARGET)%이(가) 하수구에서 헤엄쳐 온 듯한 역겨운 악취를 풍긴다.
			CASE 1
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 체취가 심하다.
			CASE 2
				PRINTFORML %조사처리(CALLNAME:TARGET,"에게")% 약간의 체취가 난다.
			CASE 3
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 별다른 냄새가 나지 않는다.
			CASE 4
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 잔향의 향기를 풍긴다.
			CASE 5
				PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 햇살과 장미 향이 난다, 마치 %HE_SHE(TARGET)%가 최근에 목욕한 것 같다.
		ENDSELECT
	CASE 133
		PRINTFORML %FactionAbriv(FacionPropagandaSign:(CFLAG:MASTER:300))% 표지판이 세워져 있다.
	CASE 134
		SIF PottyLinePosition(TARGET) > -1 && TARGET != MASTER
			PRINTFORM %조사처리(CALLNAME:TARGET,"는")%(는) 줄에서 %ORDINAL(PottyLinePosition(TARGET)+1)%번째 사람이다. 
		SIF PottyLinePosition(MASTER) > -1
			PRINTFORM 당신은 줄에서 %ORDINAL(PottyLinePosition(MASTER)+1)%번째 사람이다.
		PRINTL
ENDSELECT
