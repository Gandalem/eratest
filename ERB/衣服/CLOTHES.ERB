@SET_UNDERWEAR(C_ID, TIME_TYPE)
#DIM  C_ID
#DIMS TIME_TYPE
#DIM DYNAMIC TOP_OVERRIDDEN
#DIM DYNAMIC BOTTOM_OVERRIDDEN
;addition custom code
CALL ADD_CUSTOM_UNDERWEAR_CHECK_CHARA(C_ID)
IF TIME_TYPE != "今日のパジャマ"
