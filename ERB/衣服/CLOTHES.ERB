@上半身下着表示(C_ID)
#FUNCTION
#DIM C_ID
SIF IsDead:C_ID:0
	RETURNF 0
SIF C_ID == MASTER
	RETURNF 1
SIF !CFLAG:C_ID:睡眠 && CFLAG:C_ID:上半身下着確認
	RETURNF 1
SIF CFLAG:C_ID:睡眠 && CFLAG:C_ID:パジャマ上半身下着確認
	RETURNF 1
RETURNF 0

@下半身下着表示(C_ID)
#FUNCTION
#DIM C_ID
SIF C_ID == MASTER
	RETURNF 1
SIF C_ID == MASTER ;qol custom code
	RETURNF 1
SIF IsDead:C_ID:0
	RETURNF 0
SIF !CFLAG:C_ID:睡眠 && CFLAG:C_ID:下半身下着確認
	RETURNF 1
SIF CFLAG:C_ID:睡眠 && CFLAG:C_ID:パジャマ下半身下着確認
	RETURNF 1
RETURNF 0

@上半身下着チェック(C_ID)
#FUNCTION
#DIM C_ID
SIF IsDead:C_ID:0
	RETURNF
IF !CFLAG:C_ID:睡眠
	CFLAG:C_ID:上半身下着確認 = 1
ELSE
	CFLAG:C_ID:パジャマ上半身下着確認 = 1
ENDIF

@下半身下着チェック(C_ID)
#FUNCTION
#DIM C_ID
SIF IsDead:C_ID:0
	RETURNF
IF !CFLAG:C_ID:睡眠
	CFLAG:C_ID:下半身下着確認 = 1
ELSE
	CFLAG:C_ID:パジャマ下半身下着確認 = 1
ENDIF

@下着確認リセット(C_ID)
#DIM C_ID
CFLAG:C_ID:上半身下着確認 = 0
CFLAG:C_ID:下半身下着確認 = 0
CFLAG:C_ID:パジャマ上半身下着確認 = 0
CFLAG:C_ID:パジャマ下半身下着確認 = 0
RETURN
