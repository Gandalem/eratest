CALL SET_PANTS(C_ID, TIME_TYPE, BOTTOM_OVERRIDDEN)
CALL SET_BRA(C_ID, TIME_TYPE, TOP_OVERRIDDEN)
;パンツセッティング関数
;CFLAGに設定された衣装を上書きする
;パンツ指定がある場合には下半身下着１を解除し
;下半身下着１が指定されている場合にはパンツよりもそれを優先する

@SET_PANTS(C_ID, TIME_TYPE, OVERRIDDEN)
#DIM  C_ID
#DIMS TIME_TYPE
#DIM  P_ID
#DIM  OVERRIDDEN
IF TIME_TYPE == "今日のパジャマ"
	IF C_ID == MASTER && BedProtectSettings:0
		;NAS bedwetter protection settings
		IF BedProtectSettings:0 == -1
			P_ID = 0
		ELSE
			P_ID = BedProtectSettings:0
		ENDIF
		RETURN
	ELSEIF CFLAG:C_ID:指定パンツ == 100
		P_ID =  0
		CFLAG:C_ID:245 = 0
	ELSEIF CFLAG:C_ID:指定パンツ
		P_ID = CFLAG:C_ID:指定パンツ
		CFLAG:C_ID:245 = 0
	ELSEIF CFLAG:C_ID:245
		CFLAG:C_ID:246 = 0
		CFLAG:C_ID:DiapeSet = 0
		RETURN
	ELSEIF CFLAG:C_ID:246
		CFLAG:C_ID:245 = 0
		CFLAG:C_ID:パジャマパンツ = CFLAG:C_ID:246
		CFLAG:C_ID:DiapeSet = 0
		RETURN
		;ELSEIF !GETBIT(TALENT:C_ID:2, 0)
		;	P_ID = CLOTHES_ID("下半身下着２", "トランクス")
	ELSEIF !CFLAG:C_ID:245
		P_ID = 今日のぱんつ(C_ID)
	ENDIF
	;PRINTFORMW %CALLNAME:C_ID%のぱじゃまぱんつ：%GET_STR(C_ID, "下半身下着_ずらし可能", P_ID, "名前")%
	CFLAG:C_ID:パジャマパンツ = P_ID
	CFLAG:C_ID:246 = P_ID
	;addition custom code (by anon)
	SIF TALENT:MASTER:パンティーセンス && !CFLAG:C_ID:出禁 && CFLAG:C_ID:神社在住 && CFLAG:C_ID:睡眠 && C_ID > 0 && !TALENT:C_ID:行きずり && P_ID > 0 && CFLAG:(NO:C_ID):(P_ID + パンツ管理) == 0
		CALL COLORMESSAGE(@"잠들어 있는 %CALLNAME:C_ID%는 지금 %ARTICLE_PANTIES(PANTSNAME(P_ID, C_ID, 1))%를 입고 있다!",C_YELLOW, 1, 1)
	CFLAG:C_ID:DiapeSet = 0
	CALLF DiapeStats(C_ID,P_ID)
	[IF_DEBUG]
	DEBUGPRINTFORML %CALLNAME:C_ID% 나이트웨어 팬티: %CLOTHES_TR(GET_STR(C_ID, "下半身下着_ずらし可能", P_ID, "名前"),1)% (%TOSTR(P_ID)%, %PeeProtectType(C_ID,2)%, %TOSTR(DiapeCharges:C_ID:0)%ml)
	[ENDIF]
	RETURN
ENDIF
IF OVERRIDDEN
	IF CFLAG:C_ID:205
		CFLAG:C_ID:206 = 0
		RETURN
	ELSE
		CFLAG:C_ID:205 = 0
		CFLAG:C_ID:きょうのぱんつ = CFLAG:C_ID:206
		RETURN
	ENDIF
ELSEIF CFLAG:C_ID:指定パンツ == 100
	;ノーパン指定
	P_ID =  0
	CFLAG:C_ID:205 = 0
	;qol custom code
ELSEIF CFLAG:C_ID:指定パンツ == 101
	LOCAL = LINECOUNT
	$SELECT_PANTY
	CLEARLINE LINECOUNT - LOCAL
	PRINTFORMDL 오늘 무엇을 입을지 \@ C_ID == MASTER ? 당신은 # %CALLNAME:C_ID%이(가) \@ 착용할 것인가?
	CALL QOL_PANTY_SELECTION_MENU(C_ID)
	PRINTL
	PRINTFORMDL [-1] 무작위로 선택한다.
	INPUT
	SELECTCASE RESULT
		CASE -1
			; IF IS_MALE(C_ID)
			; 	GOTO RANDOM_MALE
			; ELSE
			; 	GOTO RANDOM_FEMALE
			; ENDIF
			;NAS custom code, we have pantsu for men in the normal function
			;also omutsu too.
			GOTO RANDOM_FEMALE
		CASEELSE
			SIF !QOL_PANTY_VALID(C_ID, RESULT)
				GOTO SELECT_PANTY
			P_ID = RESULT
	ENDSELECT
ELSEIF CFLAG:C_ID:指定パンツ
	;指定パンツがあるなら下半身下着１を剥ぐ
	CFLAG:C_ID:205 = 0
	P_ID = CFLAG:C_ID:指定パンツ
ELSEIF CFLAG:C_ID:205
	;下半身下着１が指定ならパンツは無し
	CFLAG:C_ID:206 = 0
	CFLAG:C_ID:DiapeSet = 0
	RETURN
ELSEIF CFLAG:C_ID:206
	;下半身下着２が指定ならパンツ抽選は無し
	CFLAG:C_ID:205 = 0
	CFLAG:C_ID:きょうのぱんつ = CFLAG:C_ID:206
	CFLAG:C_ID:DiapeSet = 0
	RETURN
ELSEIF !GETBIT(TALENT:C_ID:2, 0)
	;オトコならとりあえずトランクスで
	$RANDOM_MALE
	;qol custom code, allow other types of underwear for men
	SELECTCASE RAND:3
		CASE 0
			P_ID = CLOTHES_ID("下半身下着２", "トランクス")
		CASE 1
			P_ID = CLOTHES_ID("下半身下着２", "ブリーフ")
		CASE 2
			P_ID = CLOTHES_ID("下半身下着２", "ふんどし")
	ENDSELECT
ELSEIF !CFLAG:C_ID:205
	;上記以外でパンツ抽選
	$RANDOM_FEMALE
	P_ID = 今日のぱんつ(C_ID)
ENDIF
CFLAG:C_ID:きょうのぱんつ = P_ID
CFLAG:C_ID:206 = P_ID
;addition custom code (by anon)
SIF TALENT:MASTER:パンティーセンス && !CFLAG:C_ID:出禁 && (CFLAG:C_ID:神社在住 || CFLAG:C_ID:翌日来訪)&& C_ID > 0 && !TALENT:C_ID:行きずり && P_ID > 0 && CFLAG:(NO:C_ID):(P_ID + パンツ管理) == 0
	CALL COLORMESSAGE(@"%CALLNAME:C_ID%가 오늘 \@ TIME_TYPE == "明日の衣装" ? %" "%은 ~을 계획하고 있다. #  \@에게 %ARTICLE_PANTIES(PANTSNAME(P_ID, C_ID, 1))%를 입히고 있다!",C_YELLOW, 1, 1)
CFLAG:C_ID:DiapeSet = 0
CALLF DiapeStats(C_ID,P_ID,1,1)
[IF_DEBUG]
DEBUGPRINTFORML %CALLNAME:C_ID% 팬티: %CLOTHES_TR(GET_STR(C_ID, "下半身下着_ずらし可能", P_ID, "名前"),1)% (%TOSTR(P_ID)%, %PeeProtectType(C_ID,2)%, {RESULT:1}ml)
[ENDIF]

@SET_BRA(C_ID, TIME_TYPE, OVERRIDDEN)
