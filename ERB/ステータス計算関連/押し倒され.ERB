; Modular ERB: 押し倒され.ERB

@押し倒され
#DIM 人の気配
#DIM 押し倒され判定
#DIM 抱きつき値
#DIM 押し倒され値
#DIM 抱きつき優先
#DIM C_ID
SIF !nSex
	RETURN 0
SIF PushDownFilter:TARGET:0
	RETURN 0
IF !CFLAG:うふふ ;Custom code, only do this if the player is the one being pushed down.
	IF FLAG:時間停止 ;Don't process during stopped time.
		TFLAG:102 = 1
		RETURN
	ENDIF
	IF nForcePushDown:TARGET ;Bypass conditions if forced pushdown is set.
		nForcePushDown:TARGET = 0
		TFLAG:102 = 3
		GOTO PUSHDOWN
	ENDIF
	IF IS_LS_BOSS(TARGET) && !CFLAG:TARGET:ディレイ && SHIRAHU(TARGET)
		;Bosses bypass most conditions.
		TFLAG:102 = 3
		GOTO PUSHDOWN
	ENDIF
ENDIF
IF FLAG:押し倒し && !LS_LUNATIC_TIME() ;Custom code, no pushdown guard during lunatic time in Lunatic Survival.
	押し倒され判定 = 0
	押し倒され判定 += ABL:TARGET:戦闘能力 - ABL:MASTER:戦闘能力
	押し倒され判定 += TALENT:TARGET:体型 - TALENT:MASTER:体型
	IF CFLAG:TARGET:恥じらい > 0
		押し倒され判定 += 1
	ELSEIF CFLAG:TARGET:恥じらい < 0
		押し倒され判定 -= 1
	ENDIF
	IF CFLAG:TARGET:誘惑 > 0
		押し倒され判定 += 1
	ELSEIF CFLAG:TARGET:誘惑 < 0
		押し倒され判定 -= 1
	ENDIF
	IF CFLAG:TARGET:積極性 > 0
		押し倒され判定 += 1
	ELSEIF CFLAG:TARGET:積極性 < 0
		押し倒され判定 -= 1
	ENDIF
	IF CFLAG:TARGET:タチ > 0
		押し倒され判定 += 1
	ELSEIF CFLAG:TARGET:タチ < 0
		押し倒され判定 -= 1
	ENDIF
	IF GROUPMATCH(CFLAG:TARGET:性格傾向,1,3)
		押し倒され判定 += 1
	ELSEIF GROUPMATCH(CFLAG:TARGET:性格傾向,2,4)
		押し倒され判定 -= 1
	ENDIF
	;押し倒され判定 += ABL:TARGET:サドっ気 + ABL:MASTER:マゾっ気
	;押し倒され判定 -= TALENT:MASTER:度胸 + TALENT:MASTER:態度 + TALENT:MASTER:応答 + TALENT:MASTER:プライド + TALENT:MASTER:一線越えない + TALENT:MASTER:抵抗 + TALENT:MASTER:貞操
	;押し倒され判定 += (CFLAG:TARGET:弱み握り * 2) + (TALENT:TARGET:サド * 3) + (TALENT:MASTER:マゾ * 3) + (TCVAR:TARGET:発情 * 3)
	IF CFLAG:TARGET:溜まってる度 < 600
		押し倒され判定 = 0
	ELSEIF CFLAG:TARGET:溜まってる度 < 800
		押し倒され判定 += 1
	ELSEIF CFLAG:TARGET:溜まってる度 < 1000
		押し倒され判定 += 2
	ELSE
		押し倒され判定 += 3
	ENDIF
	SIF TCVAR:TARGET:Common_Sense_Alteration_Status > 50  || FLAG:催眠強度 > 50 ;hypnosis patch
		押し倒され判定 -= 1
	;addition custom code, strong muscles
	押し倒され判定 += TALENT:TARGET:力持ち - TALENT:MASTER:力持ち
ENDIF
IF CFLAG:うふふ == 1
	TFLAG:102 = 2
ELSEIF CFLAG:うふふ == 2
	TFLAG:102 = 3
ELSEIF TFLAG:102 == 3 && CFLAG:MASTER:うふふ == 2
	;既に処理済みなのでスキップ
ELSE
	TFLAG:102 = 1
ENDIF
IF !(TFLAG:102 == 3 && CFLAG:MASTER:うふふ == 2)
	TFLAG:抱きつきモード = 0
ENDIF
;抱きつきor押し倒されの処理
;デート中は発生しない
IF !CHK_DATENOW(CFLAG:TARGET:デート中)
	;抱きつきと押し倒され、どちらが優先して実行されるかを判定。抱きつきは女同士限定
	IF (TALENT:MASTER:性別 & 1) && (TALENT:性別 & 1)
		抱きつき値 = 抱きつき判定(TARGET)
	ELSE
		抱きつき値 = 0
	ENDIF
	押し倒され値 = ENDURE(TARGET)
	;Custom code, lessen composure factor according to incompetent mode intensity and sexual frustration.
	抱きつき優先 = (抱きつき値 >= 1 && 抱きつき値 > 押し倒され値 + 40 && !(押し倒され値 >= 600 && BASE:理性-(MAX(CFLAG:溜まってる度/3,201)*FLAG:甲斐性無) <= 300))
	;抱きつきが優先の場合
	IF 抱きつき優先
		IF !CFLAG:うふふ && TFLAG:102 != 3 && 抱きつき値 >= RAND:250 + 250 && TCVAR:抱きつき禁止時間 <= 0
			SIF LS_LUNATIC_TIME() ;Custom code, embrace becomes push down during lunatic time in Lunatic Survival.
				GOTO PUSHDOWN
			;室外では抱きつかれない
			IF (!HITOKE() && INROOM(CFLAG:MASTER:現在位置) && AT_HOME(MASTER)) || CFLAG:MASTER:現在位置 == OMANEKIBEYA() || nRapeAnywhere
				;同室にいるのが1人のみの場合(抱きつきは複数人不可)
				IF GET_TARGETNUM() == 1
					PRINTL
					PRINTFORMW 당신은 %조사처리(CALLNAME:TARGET,"에게")% 포옹당한다!
					IF nRapeAnywhere && !INROOM(CFLAG:PLAYER:現在位置)
						PRINTFORML 하지만 이곳은 공공장소다...
					ENDIF
					CALL KOJO_MESSAGE_SEND("EVENT",10,TARGET,1,1)
					TFLAG:抱きつき解放ポイント = 2 + RAND:(MIN(ABL:欲望, 10) / 2 + 2) + MIN(CFLAG:溜まってる度, 1000) / 200
					CFLAG:うふふ = 2
					CFLAG:LAST_SEX_DAY = DAY ;qol custom code
					CFLAG:MASTER:うふふ = 2
					TFLAG:102 = 3
					TFLAG:抱きつきモード = 1
					IF !TCVAR:発情 && !TCVAR:媚薬 && !GETBIT(CFLAG:既成事実 , 1) && !TALENT:合意誤認 ;hypnosis patch
						SETBIT CFLAG:既成事実 , 1
						CALL COLORMESSAGE(@"당신은 %조사처리(CALLNAME:TARGET,"의")% 동의를 받는다.",C_YELLOW,2)
					ELSE
						CFLAG:ヤラせちゃった = 1
					ENDIF
				ENDIF
			ENDIF
		ENDIF
		;押し倒されが優先の場合
	ELSE
		IF ((!CFLAG:うふふ && TFLAG:102 != 3) || (TFLAG:102 == 3 && TFLAG:抱きつきモード)) && 押し倒され値 >= RAND:300 + 300
			SIF LS_LUNATIC_TIME() ;Custom code, skip extra conditions during lunatic time in Lunatic Survival.
				GOTO PUSHDOWN
			;室外では押し倒されない
			IF (!HITOKE() && INROOM(CFLAG:MASTER:現在位置)) || CFLAG:MASTER:現在位置 == OMANEKIBEYA() || nRapeAnywhere
				;同室にいるのが1人のみの場合または複数人に押し倒されたとき
				IF GET_TARGETNUM() == 1 || 複数押し倒され() == 1
					;押し倒されない効果
					IF FLAG:押し倒し && 押し倒され判定 <= 0
						PRINTL
						PRINTFORML 갑자기, %PARSE("you are")%은/는 %조사처리(CALLNAME:TARGET,"에게")% 안긴다!
						IF nRapeAnywhere && !INROOM(CFLAG:PLAYER:現在位置)
							PRINTFORML 하지만 이곳은 공공장소다...
						ENDIF
						LOCALS:0 = 
						IF PALAM:TARGET:欲情 >= PALAMLV:10
							LOCALS:0 '= @"빛나는"
						ELSE
							LOCALS:0 '= @"축축함"
						ENDIF
						PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) %LOCALS:0% 눈으로 %PARSE("you",5)%를 응시한다.
						;ディレイ中は襲い掛かってこない
					ELSEIF CFLAG:TARGET:ディレイ > 0
						;甲斐性無しモードの時、まれに押し倒させてくる
						;Lust mode custom code
					ELSEIF FLAG:甲斐性無 && REVERSE_MIRADA(TARGET) && !FLAG:LUSTMODE
						PRINTL
						PRINTFORML 갑자기 당신은 %조사처리(CALLNAME:TARGET,"에게")% 포옹당한다!
						PRINTFORML %HE_SHE(TARGET,1)%는 %HIS_HER(TARGET)%의 주머니에서 작은 돌을 꺼내 당신에게 보여준다.
						PRINTL
						CALL COLORMESSAGE(@"그런 다음 %HIS_HER(TARGET)%의 손아귀가 그것을 단단히 움켜쥐고 돌이 매혹적인 광채를 발하기 시작한다...", C_PINK, 2, 1)
						PRINTL 　・
						PRINTL 　・
						PRINTL 　・
						PRINTFORMW 네가 무슨 일이 일어났는지 깨닫기도 전에 이미 너는 %CALLNAME:TARGET%%COND_STR(@" and the others", GET_TARGETNUM() > 1)%를 밀치고 있다!
						IF !UFUFU_START_TIME
							UFUFU_START_TIME = TIME
							UFUFU_START_DAY = DAY
						ENDIF
						;本体に取り込まれて、このタイミングで口上を差し込みたい人が現れるまで封印
						;CALL KOJO_MESSAGE_SEND("EVENT",10,TARGET,5,0)
						FOR LOCAL, 1, GET_TARGETNUM() + 1
						C_ID = TARGET:LOCAL
						CFLAG:C_ID:うふふ = 1
						IF !TCVAR:C_ID:発情 && !TCVAR:C_ID:媚薬 && !GETBIT (CFLAG:C_ID:既成事実 , 1)
							SETBIT CFLAG:C_ID:既成事実 , 1
							CALL COLORMESSAGE(@"당신은 %CALLNAME:C_ID%의 동의를 받는다.",C_YELLOW,2)
						ELSE
							CFLAG:C_ID:ヤラせちゃった = 1
						ENDIF
						NEXT
						CFLAG:MASTER:うふふ = 1
						TFLAG:102 = 2
						TFLAG:抱きつきモード = 0
						;added if condition below to prevent push-down / rage-quit loop
					ELSEIF !CFLAG:TARGET:不機嫌
						$PUSHDOWN ;Custom code, Lunatic Survival.
						CALL LS_PUSH_DOWN(TARGET)
						IF RESULT
							TFLAG:102 = 1
							RETURN
						ENDIF
						PRINTL
						PRINTFORMW %PARSE("You are")% 밀쳐 버렸다!
						IF nRapeAnywhere && !INROOM(CFLAG:PLAYER:現在位置)
							PRINTFORML 하지만 이곳은 공공장소다...
						ENDIF
						IF !UFUFU_START_TIME
							UFUFU_START_TIME = TIME
							UFUFU_START_DAY = DAY
						ENDIF
						;CALL KOJO_EVENT(12, TARGET)
						CALL KOJO_MESSAGE_SEND("EVENT",10,TARGET,1,0)
						CALL CheckSinsForSex(TARGET, MASTER)
						FOR LOCAL, 1, GET_TARGETNUM() + 1
						C_ID = TARGET:LOCAL
						IF GETBIT(NASFeature,8)
							CFLAG:C_ID:うふふ = 1
						ELSE
							CFLAG:C_ID:うふふ = 2
						ENDIF
						CFLAG:C_ID:LAST_SEX_DAY = DAY ;qol custom code
						CFLAG:C_ID:行動 = 0 ;Custom code, remove working status.
						IF !TCVAR:C_ID:発情 && !TCVAR:C_ID:媚薬 && !GETBIT (CFLAG:C_ID:既成事実 , 1) && !TALENT:C_ID:合意誤認 ;hypnosis patch
							SETBIT CFLAG:C_ID:既成事実 , 1
							CALL COLORMESSAGE(@"당신은 %CALLNAME:C_ID%의 동의를 받는다.",C_YELLOW,2)
						ELSE
							;NAS: Non Con Warning
							CALL NAS_NonConWarning(C_ID, 2)
							SIF RESULT == -1
								RETURN -1
							;--------------------------
							CFLAG:C_ID:ヤラせちゃった = 1
							CALL CharacterSinned(TARGET,"Rape",@"%조사처리(CALLNAME:MASTER,"를")% 밀어붙여 성관계를 갖게 했다.", -3, -1)
						ENDIF
						CALL UWAKI_RECORD(C_ID,1) ;qol custom code, set known relationships
						NEXT
						;CFLAG:MASTER:うふふ = 2
						IF GETBIT(NASFeature,8)
							LOCAL = MASTER
							TempUfufuBecome:1 = TARGET
							CFLAG:MASTER:うふふ = 1
							CFLAG:TARGET:うふふ = 1
							CALLF SimultaneousMasterSwap(TempUfufuBecome:1)
							TARGET = LOCAL
							TFLAG:102 = 3
							TFLAG:抱きつきモード = 0
							TFLAG:押し倒され開始時間 = TIME + DAY * 1440
							PRINTFORML 당신은 이제 일시적으로 %조사처리(CALLNAME:MASTER,"가")% 되었다. 당신은 이제 %조사처리(CALLNAME:TARGET,"에게")% 어떤 성적인 상호작용이라도 할 수 있다.
							PRINTFORMW 만약 빠져나가면, 당신은 다시 %NAME:TempUfufuBecome%로 돌아갈 것이다. 
						ELSE
							CFLAG:MASTER:うふふ = 2
							TFLAG:102 = 3
							TFLAG:抱きつきモード = 0
							TFLAG:押し倒され開始時間 = TIME + DAY * 1440
						ENDIF
					ENDIF
				ENDIF
				IF INROOM(CFLAG:MASTER:現在位置) == 2
					CALL DATUI_SHOES(MASTER,0)
					CALL DATUI_SHOES(TARGET,0)
				ENDIF
				;室外(連れ込み宿とラブホ除く)で押し倒され条件を満たした場合
			ELSEIF CFLAG:MASTER:現在位置 != 260 && CFLAG:MASTER:現在位置 != 950 && !FREE_USE_ACTIVE() && BASE:怒り <= 50 ;custom code, don't do this in Free Use mode or if they're too angry to let you in their room
				PRINTL
				SELECTCASE CFLAG:TARGET:溜まってる度
					CASE IS < 600
						PRINTFORML %조사처리(CALLNAME:TARGET,"가")%/가 당신의 소매를 잡아당긴다.
						PRINTFORMW %HE_SHE(TARGET)%은(는) 좀 더 사적인 곳에 가고 싶어 하는 것 같다...
					CASE IS < 800
						PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 다음으로 몸을 일으켜 당신을 올려다본다...
					CASE IS < 1000
						PRINTFORML %조사처리(CALLNAME:TARGET,"는")%(는) 당신에게 파고들며 부드럽게 당신의 \@ BATHROOM(CFLAG:現在位置) ? 맨 사타구니 # 옷을 통해 사타구니를 쓰다듬는다 \@.
						PRINTFORMW %조사처리(CALLNAME:TARGET,"는")%(는) 갈망으로 가득 찬 눈빛으로 당신에게 재촉한다...
						IF TCVAR:TARGET:誘惑時刻 != TIME
							PALAM:TARGET:潤滑 += 500
							TCVAR:TARGET:誘惑時刻 = TIME
						ENDIF
					CASEELSE
						PRINTFORML %조사처리(CALLNAME:TARGET,"는")% 탐욕스러운 눈빛으로 당신에게 기대며, 당신의 손을 %HIS_HER(TARGET)%의 흥건하게 젖은 사타구니로 이끈다...
						PRINTFORMW %조사처리(CALLNAME:TARGET,"는")% 지금 당장 당신과 성관계를 갖고 싶은 거부할 수 없는 충동을 느낀다.
						IF TCVAR:TARGET:誘惑時刻 != TIME
							PALAM:TARGET:潤滑 += 2000
							TCVAR:TARGET:誘惑時刻 = TIME
						ENDIF
				ENDSELECT
				CALL KOJO_MESSAGE_SEND("EVENT",10,TARGET,4, CFLAG:TARGET:溜まってる度)
			ENDIF
		ENDIF
	ENDIF
ENDIF
;複数押し倒されの判定

@複数押し倒され()
#FUNCTION
#DIM 判定値
#DIM キャラ別判定値
#DIM 相性補正
#DIM NUM_TARGET
#DIM C_ID
判定値 = 0
NUM_TARGET = GET_TARGETNUM()
SIF NUM_TARGET <= 1
	RETURNF 0
FOR LOCAL, 1, NUM_TARGET + 1
C_ID = TARGET:LOCAL
SIF CFLAG:C_ID:同室 != 1
	CONTINUE
SIF ENDURE(C_ID) < 450
	RETURNF 0
;判定を通ったらキャラ別判定値に入れる
キャラ別判定値 = ENDURE(C_ID)
DEBUGPRINTFORML 보정 전: ({C_ID}) {ENDURE(C_ID)}
;ここからキャラ別判定値を補正していく
;レズっ気での補正(3未満にはペナルティ)
IF !TCVAR:C_ID:発情 && !TCVAR:C_ID:媚薬 ;qol custom code, skip lesbianism penalties if in heat/aphrodisiac
	SIF ABL:(C_ID):レズっ気 == 0
		TIMES キャラ別判定値, 0.20 ;qol custom code, allow small chance with zero lesbianism
	SIF ABL:(C_ID):レズっ気 == 1
		TIMES キャラ別判定値, 0.50
	SIF ABL:(C_ID):レズっ気 == 2
		TIMES キャラ別判定値, 0.80
ENDIF
;3以上では(1+0.1*(レズっ気 - 3))倍
SIF ABL:(C_ID):レズっ気 >= 3
	キャラ別判定値 = キャラ別判定値 * (100 + 10 * (ABL:(C_ID):レズっ気 - 3)) / 100
DEBUGPRINTFORML 레즈 성향 보정 후:({C_ID}) {キャラ別判定値}
;レズ中毒での補正 (1+0.1*レズ中毒)倍
キャラ別判定値 = キャラ別判定値 * (100 + 10 * ABL:(C_ID):レズ中毒) / 100
DEBUGPRINTFORML レズ中毒補正後：({C_ID}) {キャラ別判定値}
;相性での補正
;仲のいいキャラがいると一緒にMASTERを押し倒しやすく(完全に趣味)
相性補正 = 0
;同室のキャラを探り各キャラに対して相性値を見ていく
FOR LOCAL:1, 1, NUM_TARGET + 1
SIF CFLAG:(TARGET:(LOCAL:1)):同室 != 1
	CONTINUE
SIF LOCAL == LOCAL:1
	CONTINUE
;相性補正 += RELATION:LOCAL:(LOCAL:2)
;ほんとは上の一文だけで済ませたいんだけど......
;_Replace.csvのRELATIONの初期値が働かない(泣)
;なので苦肉の策として0は100とみなす(暴論)
相性補正 += RELATION:(C_ID):(TARGET:(LOCAL:1))
SIF RELATION:(C_ID):(TARGET:(LOCAL:1)) == 0
	相性補正 += 100
NEXT
;平均値をとる(小数点以下切捨て) 当人を除いた(GET_TARGETNUM() - 1)人で割る
;0除算注意(無いと思うけど)
相性補正 /= NUM_TARGET - 1
キャラ別判定値 = キャラ別判定値 * 相性補正 / 100
DEBUGPRINTFORML 相性補正後：({(C_ID)}) {キャラ別判定値}
;補正後のキャラ別判定値を全体の判定値に入れる
判定値 += キャラ別判定値
NEXT
;平均値をとる(小数点以下切捨て)
;0除算がこわいぃ
判定値 /= NUM_TARGET
DEBUGPRINTFORML 판정치: {判定値}
;判定値が最大だとして、確率は「(400+200*同室の人数)分の150」に設定(人数増えると難易度上昇)
SIF RAND:(400 + 200 * NUM_TARGET) + 450 <= 判定値
	RETURNF 1
RETURNF 0
