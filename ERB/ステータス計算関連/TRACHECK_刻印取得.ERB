; Modular ERB: TRACHECK_刻印取得.ERB
;FileName_TRACHECK.ERB ----------------------------- Rev1.00
;刻印取得のチェック
;CALL		USER
;ARG		0:キャラNO
;RETURN		VOID
;COMMENT	21/08/27 反発刻印取得仕様を一部変更
;-----------------------------------------------------------

@MARK_GOT_CHECK(ARG)
#DIM 刻印取得値
;NAS: limiters
SIF IsDead:ARG:0
	RETURN
SIF ARG == MASTER
	RETURN
SIF IS_BABY(ARG)
	RETURN
;------------------------
;-------------------------------------------------
;Custom Code
;Force Marks
;-------------------------------------------------
SELECTCASE SOURCE_FORCE(ARG)
	CASE IS >= ForceMarkThreshold:5
		SIF !EXISTVAR("NAS_VERSION")
			GOTO FORCE3
		IF MARK:ARG:MARK_FORCE <= 4
			MARK:ARG:MARK_FORCE = 5
			TFLAG:TFLAG_FORCE_GET = 5
			EXP:ARG:異常経験 += 5
		ENDIF
	CASE IS >= ForceMarkThreshold:4
		SIF !EXISTVAR("NAS_VERSION")
			GOTO FORCE3
		IF MARK:ARG:MARK_FORCE <= 3
			MARK:ARG:MARK_FORCE = 4
			TFLAG:TFLAG_FORCE_GET = 4
			EXP:ARG:異常経験 += 4
		ENDIF
	CASE IS >= ForceMarkThreshold:3
		$FORCE3
		IF MARK:ARG:MARK_FORCE <= 2
			MARK:ARG:MARK_FORCE = 3
			TFLAG:TFLAG_FORCE_GET = 3
			EXP:ARG:異常経験 += 3
		ENDIF
	CASE IS >= ForceMarkThreshold:2
		IF MARK:ARG:MARK_FORCE <= 1
			MARK:ARG:MARK_FORCE = 2
			TFLAG:TFLAG_FORCE_GET = 2
			EXP:ARG:異常経験 += 2
		ENDIF
	CASE IS >= ForceMarkThreshold:1
		IF MARK:ARG:MARK_FORCE <= 0
			MARK:ARG:MARK_FORCE = 1
			TFLAG:TFLAG_FORCE_GET = 1
			EXP:ARG:異常経験 += 1
		ENDIF
ENDSELECT
;-------------------------------------------------
;苦痛刻印
;-------------------------------------------------
SELECTCASE CUP:ARG:苦痛
	CASE IS >= PainMarkThreshold:5
		IF MARK:ARG:苦痛刻印 <= 4
			MARK:ARG:苦痛刻印 = 5
			TFLAG:苦痛刻印取得 = 5
			;感情乏しいの場合は不埒刻印による従順アップはなし
			IF ABL:ARG:従順 <= 7 && !TALENT:ARG:感情乏しい
				ABL:ARG:従順 = 8
				TFLAG:刻印従順変化 = 1
			ENDIF
			IF TALENT:PLAYER:サド
				EXP:ARG:異常経験 += 2
			ELSEIF TALENT:PLAYER:針さばき && SELECTCOM == 103
				EXP:ARG:異常経験 += 2
			ELSE
				EXP:ARG:異常経験 += 1
			ENDIF
		ENDIF
	CASE IS >= PainMarkThreshold:4
		IF MARK:ARG:苦痛刻印 <= 3
			MARK:ARG:苦痛刻印 = 4
			TFLAG:苦痛刻印取得 = 4
			;感情乏しいの場合は不埒刻印による従順アップはなし
			IF ABL:ARG:従順 <= 4 && !TALENT:ARG:感情乏しい
				ABL:ARG:従順 = 5
				TFLAG:刻印従順変化 = 1
			ENDIF
			IF TALENT:PLAYER:サド
				EXP:ARG:異常経験 += 2
			ELSEIF TALENT:PLAYER:針さばき && SELECTCOM == 103
				EXP:ARG:異常経験 += 2
			ELSE
				EXP:ARG:異常経験 += 1
			ENDIF
		ENDIF
	CASE IS >= PainMarkThreshold:3
		IF MARK:ARG:苦痛刻印 <= 2
			MARK:ARG:苦痛刻印 = 3
			TFLAG:苦痛刻印取得 = 3
			;気丈・感情乏しいの場合は苦痛刻印による従順アップはなし
			IF !ABL:ARG:従順 && TALENT:ARG:度胸 > 0 && !TALENT:ARG:感情乏しい
				ABL:ARG:従順 = 1
				TFLAG:刻印従順変化 = 1
			ENDIF
			IF TALENT:PLAYER:サド
				EXP:ARG:異常経験 += 2
			ELSEIF TALENT:PLAYER:針さばき && SELECTCOM == 103
				EXP:ARG:異常経験 += 2
			ELSE
				EXP:ARG:異常経験 += 1
			ENDIF
		ENDIF
	CASE IS >= PainMarkThreshold:2
		IF MARK:ARG:苦痛刻印 <= 1
			MARK:ARG:苦痛刻印 = 2
			TFLAG:苦痛刻印取得 = 2
			;気丈・感情乏しいの場合は苦痛刻印による従順アップはなし
			IF !ABL:ARG:従順 && TALENT:ARG:度胸 > 0 && !TALENT:ARG:感情乏しい
				ABL:ARG:従順 = 1
				TFLAG:刻印従順変化 = 1
			ENDIF
		ENDIF
	CASE IS >= PainMarkThreshold:1
		IF MARK:ARG:苦痛刻印 <= 0
			MARK:ARG:苦痛刻印 = 1
			TFLAG:苦痛刻印取得 = 1
		ENDIF
ENDSELECT
;-------------------------------------------------
;時姦刻印
;-------------------------------------------------
IF TCVAR:ARG:時姦刻印取得用 == 1 && MARK:ARG:時姦刻印 <= 0
	MARK:ARG:時姦刻印 = 1
	TFLAG:時姦刻印取得 = 1
ELSEIF TCVAR:ARG:時姦刻印取得用 == 2 && MARK:ARG:時姦刻印 <= 1
	MARK:ARG:時姦刻印 = 2
	TFLAG:時姦刻印取得 = 2
ELSEIF TCVAR:ARG:時姦刻印取得用 == 3 && MARK:ARG:時姦刻印 <= 2
	MARK:ARG:時姦刻印 = 3
	TFLAG:時姦刻印取得 = 3
ELSEIF TCVAR:ARG:時姦刻印取得用 == 4 && MARK:ARG:時姦刻印 <= 3
	MARK:ARG:時姦刻印 = 4
	TFLAG:時姦刻印取得 = 4
ELSEIF TCVAR:ARG:時姦刻印取得用 == 5 && MARK:ARG:時姦刻印 <= 4
	MARK:ARG:時姦刻印 = 5
	TFLAG:時姦刻印取得 = 5
ENDIF
;-------------------------------------------------
;快楽刻印
;-------------------------------------------------
IF TCVAR:ARG:快楽強度 == 1 && MARK:ARG:快楽刻印 <= 0
	MARK:ARG:快楽刻印 = 1
	TFLAG:23 = 1
ELSEIF TCVAR:快楽強度 == 2 && MARK:ARG:快楽刻印 <= 1
	MARK:ARG:快楽刻印 = 2
	TFLAG:23 = 2
ELSEIF TCVAR:快楽強度 == 3 && MARK:ARG:快楽刻印 <= 2
	MARK:ARG:快楽刻印 = 3
	TFLAG:23 = 3
	;自制心・感情乏しいの場合は快楽刻印による従順アップはなし
	IF !ABL:ARG:従順 && !TALENT:ARG:自制心 && !TALENT:ARG:感情乏しい
		ABL:ARG:従順 = 1
		TFLAG:刻印従順変化 = 1
	ENDIF
ELSEIF TCVAR:快楽強度 == 4 && MARK:ARG:快楽刻印 <= 3
	MARK:ARG:快楽刻印 = 4
	TFLAG:23 = 4
	;自制心・感情乏しいの場合は快楽刻印による従順アップはなし
	IF !ABL:ARG:従順 && !TALENT:ARG:自制心 && !TALENT:ARG:感情乏しい
		ABL:ARG:従順 = 5
		TFLAG:刻印従順変化 = 1
	ENDIF
ELSEIF TCVAR:快楽強度 == 5 && MARK:ARG:快楽刻印 <= 4
	MARK:ARG:快楽刻印 = 5
	TFLAG:23 = 5
	;自制心・感情乏しいの場合は快楽刻印による従順アップはなし
	IF !ABL:ARG:従順 && !TALENT:ARG:自制心 && !TALENT:ARG:感情乏しい
		ABL:ARG:従順 = 8
		TFLAG:刻印従順変化 = 1
	ENDIF
	;ELSEIF  TCVAR:快楽強度 == 3 && TALENT:幼稚 && !TALENT:初潮
	;		TALENT:初潮 = 1
	;		TFLAG:23 = 4
ENDIF
;-------------------------------------------------
;不埒刻印
;-------------------------------------------------
IF FLAG:70 == 1 || CFLAG:ARG:イタズラ
ELSE
	;addition custom code, reenabled (for dialogue purposes), edited
	A = CUP:ARG:快Ｃ + CUP:ARG:快Ｖ + CUP:ARG:快Ｂ + CUP:ARG:快Ａ
	;快楽によるLvUPは10番+取得した不埒刻印のレベルのTFLAGを与える
	IF A >= 3000 && MARK:ARG:快楽刻印 > MARK:ARG:不埒刻印 && MARK:ARG:不埒刻印 == 0
		MARK:ARG:不埒刻印 = 1
		TFLAG:24 = 11
	ELSEIF A >= 5000 && MARK:ARG:快楽刻印 > MARK:ARG:不埒刻印 && MARK:ARG:不埒刻印 == 1
		MARK:ARG:不埒刻印 = 2
		TFLAG:24 = 12
		;感情乏しいの場合は不埒刻印による従順アップはなし
		IF !ABL:ARG:従順 && !TALENT:ARG:感情乏しい
			ABL:ARG:従順 = 1
			TFLAG:刻印従順変化 = 1
		ENDIF
	ELSEIF A >= 9000 && MARK:ARG:快楽刻印 > MARK:ARG:不埒刻印 && MARK:ARG:不埒刻印 == 2
		MARK:ARG:不埒刻印 = 3
		TFLAG:24 = 13
		;感情乏しいの場合は不埒刻印による従順アップはなし
		IF ABL:ARG:従順 <= 1 && !TALENT:ARG:感情乏しい
			ABL:ARG:従順 = 2
			TFLAG:刻印従順変化 = 1
		ENDIF
	ELSEIF A >= 18000 && MARK:ARG:快楽刻印 > MARK:ARG:不埒刻印 && MARK:ARG:不埒刻印 == 3
		MARK:ARG:不埒刻印 = 4
		TFLAG:24 = 14
		;感情乏しいの場合は不埒刻印による従順アップはなし
		IF ABL:ARG:従順 <= 4 && !TALENT:ARG:感情乏しい
			ABL:ARG:従順 = 5
			TFLAG:刻印従順変化 = 1
		ENDIF
	ELSEIF A >= 30000 && MARK:ARG:快楽刻印 > MARK:ARG:不埒刻印 && MARK:ARG:不埒刻印 == 4
		MARK:ARG:不埒刻印 = 5
		TFLAG:24 = 15
		;感情乏しいの場合は不埒刻印による従順アップはなし
		IF ABL:ARG:従順 <= 7 && !TALENT:ARG:感情乏しい
			ABL:ARG:従順 = 8
			TFLAG:刻印従順変化 = 1
		ENDIF
	ENDIF
	A = CUP:ARG:恭順 + CUP:ARG:屈服
	;恭順と屈服によるLvUPは30番+取得した不埒刻印のレベルのTFLAGを与える
	;addition custom code
	;revamped for switch cases
	SELECTCASE A
		CASE IS >= LewdMarkThreshold2:5
			IF MARK:ARG:不埒刻印 <= 4
				MARK:ARG:不埒刻印 = 5
				TFLAG:24 = 35
				;感情乏しいの場合は不埒刻印による従順アップはなし
				IF ABL:ARG:従順 <= 7 && !TALENT:ARG:感情乏しい
					ABL:ARG:従順 = 8
					TFLAG:刻印従順変化 = 1
				ENDIF
			ENDIF
		CASE IS >= LewdMarkThreshold2:4
			IF MARK:ARG:不埒刻印 <= 3
				MARK:ARG:不埒刻印 = 4
				TFLAG:24 = 34
				;感情乏しいの場合は不埒刻印による従順アップはなし
				IF ABL:ARG:従順 <= 4 && !TALENT:ARG:感情乏しい
					ABL:ARG:従順 = 5
					TFLAG:刻印従順変化 = 1
				ENDIF
			ENDIF
		CASE IS >= LewdMarkThreshold2:3
			IF MARK:ARG:不埒刻印 <= 2
				MARK:ARG:不埒刻印 = 3
				TFLAG:24 = 33
				;感情乏しいの場合は不埒刻印による従順アップはなし
				IF ABL:ARG:従順 <= 1 && !TALENT:ARG:感情乏しい
					ABL:ARG:従順 = 2
					TFLAG:刻印従順変化 = 1
				ENDIF
			ENDIF
		CASE IS >= LewdMarkThreshold2:2
			IF MARK:ARG:不埒刻印 <= 1
				MARK:ARG:不埒刻印 = 2
				TFLAG:24 = 32
				;感情乏しいの場合は不埒刻印による従順アップはなし
				IF !ABL:ARG:従順 && !TALENT:ARG:感情乏しい
					ABL:ARG:従順 = 1
					TFLAG:刻印従順変化 = 1
				ENDIF
			ENDIF
		CASE IS >= LewdMarkThreshold2:1
			IF MARK:ARG:不埒刻印 == 0
				MARK:ARG:不埒刻印 = 1
				TFLAG:24 = 31
			ENDIF
	ENDSELECT
	;-------------------------------------------------
	;反発刻印
	;-------------------------------------------------
	;MASTERは除外
	SIF CFLAG:ARG:イタズラ
		RETURN 0
	SIF ARG == MASTER
		RETURN 0
	SIF TFLAG:150
		RETURN 0
	;NAS: Must be in a negative emotion
	SIF GET_EMOTION() < 0
		RETURN 0
	;NAS: Cheat
	SIF NASCheat:1
		RETURN 0
	刻印取得値 = CUP:ARG:反感+CUP:ARG:不快
	;反発履歴残している場合、少しだけ反発刻印を付きづらくする
	;同レベル以下の刻印が付かないだと強すぎるので、刻印レベルを１段階引き下げに
	CALL HMF_Thresholds(刻印取得値, ARG) ;addition custom code
	;revamped for switchcases
	SELECTCASE 刻印取得値
		CASE IS > HateMarkThreshold:5
			IF MARK:ARG:反発刻印 < 5
				MARK:ARG:反発刻印 = 5
				TFLAG:反発刻印取得 = 5
				MARK:ARG:反発取得履歴 = MAX(MARK:ARG:反発取得履歴,5)
				CFLAG:ARG:不機嫌 = 5
				CFLAG:ARG:ブチギレ = 1
				TALENT:ARG:機嫌 = -1
				IF MARK:ARG:反発取得履歴 < 5 || 刻印取得値 >= 2400
					;感情乏しいの場合は反発刻印による従順ダウンはなし
					TFLAG:刻印従順変化 = 2
				ENDIF
			ENDIF
		CASE IS > HateMarkThreshold:4
			IF MARK:ARG:反発刻印 < 4
				MARK:ARG:反発刻印 = 4
				TFLAG:反発刻印取得 = 4
				MARK:ARG:反発取得履歴 = MAX(MARK:ARG:反発取得履歴,4)
				CFLAG:ARG:不機嫌 = 4
				CFLAG:ARG:ブチギレ = 1
				TALENT:ARG:機嫌 = -1
				IF MARK:ARG:反発取得履歴 < 4 || 刻印取得値 >= 2400
					;感情乏しいの場合は反発刻印による従順ダウンはなし
					IF INRANGE(ABL:ARG:従順,1,5) && !TALENT:ARG:感情乏しい
						ABL:ARG:従順 = MAX(ABL:ARG:従順 - 2, 0)
						ABL:ARG:親密 = MAX(ABL:ARG:親密 - 2, 0)
						TFLAG:刻印従順変化 = 1
					ELSEIF ABL:ARG:従順 > 5 && !TALENT:ARG:感情乏しい
						ABL:ARG:従順 = MAX(ABL:ARG:従順 - 1, 0)
						ABL:ARG:親密 = MAX(ABL:ARG:親密 - 1, 0)
						TFLAG:刻印従順変化 = 2
					ENDIF
				ENDIF
			ENDIF
		CASE IS > HateMarkThreshold:3
			IF MARK:ARG:反発刻印 < 3
				MARK:ARG:反発刻印 = 3
				TFLAG:反発刻印取得 = 3
				MARK:ARG:反発取得履歴 = MAX(MARK:ARG:反発取得履歴,3)
				CFLAG:ARG:不機嫌 = 3
				CFLAG:ARG:ブチギレ = 1
				TALENT:ARG:機嫌 = -1
				IF MARK:ARG:反発取得履歴 < 3 || 刻印取得値 >= 2400
					;感情乏しいの場合は反発刻印による従順ダウンはなし
					IF INRANGE(ABL:ARG:従順,1,5) && !TALENT:ARG:感情乏しい
						ABL:ARG:従順 = MAX(ABL:ARG:従順 - 2, 0)
						ABL:ARG:親密 = MAX(ABL:ARG:親密 - 2, 0)
						TFLAG:刻印従順変化 = 1
					ELSEIF ABL:ARG:従順 > 5 && !TALENT:ARG:感情乏しい
						ABL:ARG:従順 = MAX(ABL:ARG:従順 - 1, 0)
						ABL:ARG:親密 = MAX(ABL:ARG:親密 - 1, 0)
						TFLAG:刻印従順変化 = 2
					ENDIF
				ENDIF
			ENDIF
		CASE IS > HateMarkThreshold:2
			IF MARK:ARG:反発刻印 < 2
				MARK:ARG:反発刻印 = 2
				TFLAG:反発刻印取得 = 2
				MARK:ARG:反発取得履歴 = MAX(MARK:ARG:反発取得履歴,2)
				CFLAG:ARG:不機嫌 = 2
				CFLAG:ARG:ブチギレ = 1
				TALENT:ARG:機嫌 = -1
				IF MARK:ARG:反発取得履歴 < 2 || 刻印取得値 >= 1200
					;感情乏しいの場合は反発刻印による従順ダウンはなし
					IF INRANGE(ABL:ARG:従順,1,5) && !TALENT:ARG:感情乏しい
						ABL:ARG:従順 = MAX(ABL:ARG:従順 - 1, 0)
						ABL:ARG:親密 = MAX(ABL:ARG:親密 - 1, 0)
						TFLAG:刻印従順変化 = 1
					ELSEIF ABL:ARG:従順 > 5 && !TALENT:ARG:感情乏しい
						ABL:ARG:従順 = MAX(ABL:ARG:従順 - 1, 0)
						TFLAG:刻印従順変化 = 2
					ENDIF
				ENDIF
			ENDIF
		CASE IS > HateMarkThreshold:1
			IF MARK:ARG:反発刻印 < 1
				MARK:ARG:反発刻印 = 1
				MARK:ARG:反発取得履歴 = MAX(MARK:ARG:反発取得履歴,1)
				TFLAG:反発刻印取得 = 1
				CFLAG:ARG:不機嫌 = 1
				CFLAG:ARG:ブチギレ = 1
				TALENT:ARG:機嫌 = -1
			ENDIF
	ENDSELECT
ENDIF
;-------------------------------------------------
;Regression Mark
;-------------------------------------------------
A = CUP:ARG:Regression
;addition custom code
SELECTCASE A
	CASE IS >= RegressionMarkThreshold:5
		IF MARK:ARG:RegressionMark < 5
			MARK:ARG:RegressionMark = 5
			TFLAG:RegressionMark = 5
			;感情乏しいの場合は不埒刻印による従順アップはなし
			IF ABL:ARG:欲望 <= 10 && !TALENT:ARG:感情乏しい
				ABL:ARG:欲望 = 10
				TFLAG:刻印従順変化 = 1
			ENDIF
		ENDIF
	CASE IS >= RegressionMarkThreshold:4
		IF MARK:ARG:RegressionMark < 4
			MARK:ARG:RegressionMark = 4
			TFLAG:RegressionMark = 4
			;感情乏しいの場合は不埒刻印による従順アップはなし
			IF ABL:ARG:欲望 <= 5 && !TALENT:ARG:感情乏しい
				ABL:ARG:欲望 = 5
				TFLAG:刻印従順変化 = 1
			ENDIF
		ENDIF
	CASE IS >= RegressionMarkThreshold:3
		IF MARK:ARG:RegressionMark < 3
			MARK:ARG:RegressionMark = 3
			TFLAG:RegressionMark = 3
			;感情乏しいの場合は不埒刻印による従順アップはなし
			IF ABL:ARG:欲望 <= 2 && !TALENT:ARG:感情乏しい
				ABL:ARG:欲望 = 2
				TFLAG:刻印従順変化 = 1
			ENDIF
		ENDIF
	CASE IS >= RegressionMarkThreshold:2
		IF MARK:ARG:RegressionMark < 2
			MARK:ARG:RegressionMark = 2
			TFLAG:RegressionMark = 2
			;感情乏しいの場合は不埒刻印による従順アップはなし
			IF !ABL:ARG:欲望 && !TALENT:ARG:感情乏しい
				ABL:ARG:欲望 = 1
				TFLAG:刻印従順変化 = 1
			ENDIF
		ENDIF
	CASE IS >= RegressionMarkThreshold:1
		IF MARK:ARG:RegressionMark < 1
			MARK:ARG:RegressionMark = 1
			TFLAG:RegressionMark = 1
		ENDIF
ENDSELECT
;-------------------------------------------------
;Trauma
;-------------------------------------------------
CharaTrauma:ARG:1 = CharaTrauma:ARG:0
;addition custom code
SELECTCASE CharaTraumaExp:ARG:0
	CASE IS >= EXP_DEMAND_24(0,0,0,0,5)
		CharaTrauma:ARG:0 = 5
		IF CharaTrauma:ARG:1 < 5
			TFLAG:TraumaMark = 5
		ENDIF
	CASE IS >= EXP_DEMAND_24(0,0,0,0,4)
		IF CharaTrauma:ARG:0 < 4 && CharaTrauma:ARG:1 < 5
			CharaTrauma:ARG:0 = 4
			TFLAG:TraumaMark = 4
		ENDIF
	CASE IS >= EXP_DEMAND_24(0,0,0,0,3)
		IF CharaTrauma:ARG:0 < 3 && CharaTrauma:ARG:1 < 4
			CharaTrauma:ARG:0 = 3
			TFLAG:TraumaMark = 3
		ENDIF
	CASE IS >= EXP_DEMAND_24(0,0,0,0,2)
		IF CharaTrauma:ARG:0 < 2
			CharaTrauma:ARG:0 = 2
			TFLAG:TraumaMark = 2
		ENDIF
	CASE IS >= EXP_DEMAND_24(0,0,0,0,1)
		IF CharaTrauma:ARG:0 < 1
			CharaTrauma:ARG:0 = 1
			TFLAG:TraumaMark = 1
		ENDIF
	CASEELSE
		CharaTrauma:ARG:0 = 0
		TFLAG:TraumaMark = 0
ENDSELECT
TALENT:ARG:503 = CharaTrauma:ARG:0
;注意札発行チェック
SIF !TALENT:ARG:恋慕 || RAND:(ABL:ARG:親密 + 1) == 0 || MARK:ARG:反発刻印 == 3 && FLAG:18
	CALL CARD_GOT_CHECK(ARG)
TFLAG:150 = 0
