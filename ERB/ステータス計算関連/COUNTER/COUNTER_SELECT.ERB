; Modular ERB: COUNTER/COUNTER_SELECT.ERB

@カウンター呼び出し処理
#DIM NUM_TARGET
NUM_TARGET = GET_TARGETNUM()
;--------------------------------------------------------------------
;TCVAR:相手:20　コマンド番号　内容の大筋
;TCVAR:相手:21　派生　内容の詳細
;--------------------------------------------------------------------
IF ( TFLAG:102 == 3 || TFLAG:102 == 2 ) && !CFLAG:TARGET:添い寝中
	;IF !CFLAG:TARGET:添い寝中
	;カウンター履歴作成
	ARRAYCOPY "SELECTCCOM", "PREVCCOM"
	VARSET SELECTCCOM
	;カウンター
	FOR LOCAL, 1, NUM_TARGET + 1
	SIF TARGET:LOCAL <= 0
		CONTINUE
	;NAS: if touhou is ded
	SIF IsDead:(TARGET:LOCAL):0
		RETURN 0
	CALL EVENT_COUNTER(TARGET:LOCAL,LOCAL)
	;CALL EVENT_COUNTER_COMBINATION
	NEXT
	FOR LOCAL, 1, NUM_TARGET + 1
	SIF TARGET:LOCAL <= 0
		CONTINUE
	;NAS: if touhou is ded
	SIF IsDead:(TARGET:LOCAL):0
		RETURN 0
	IF TCVAR:(TARGET:LOCAL):20
		CALL KOJO_MESSAGE_SEND_COUNTER(1,TARGET:LOCAL,0,0)
	ENDIF
	NEXT
ENDIF

@EVENT_COUNTER(ARG,ARG:1)
#DIM 候補, CCOM_MAXNUM
#DIM 基本値
VARSET LOCAL
VARSET 候補
;----------------------------------------------------
;キャンセル
;----------------------------------------------------
;ARG 対象キャラ
;ARG:1 行動順
;bug-fix SIF => IF and added the TCVAR:ARG:20 = 0 to prevent multiple counter messages
;bugfix custom code, added CFLAG:ARG:うふふ != 2 to ensure processing happens after being pushed down
;qol custom code, add 356, 482, and 464 to prevent messages after Take To Secluded Spot, Follow [X], Move To Another Area
IF CFLAG:ARG:うふふ != 2 && (GROUPMATCH(SELECTCOM, 350, 355, 400, 402, 404, 405, 420, 604, 699, 850, 356, 482, 464) || (SELECTCOM == ADD_CUSTOM_COM && GROUPMATCH(ADD_SELECTCUSTOMCOM, 10)))
	TCVAR:ARG:20 = 0
	RETURN 0
ENDIF
SIF NO:ARG <= 0 ;addition custom code, include duplicates
	RETURN 0
SIF !SHIRAHU(ARG)
	RETURN 0
;NAS: if touhou is ded
SIF IsDead:ARG:0
	RETURN 0
SIF FLAG:70 == 1 && CFLAG:ARG:344 == 0
	RETURN 0
SIF CFLAG:ARG:行動 == 5
	RETURN 0
;NAS: bug fix as touhous can now push you down without enough favor due to them being desperate to fuck
;Touhous would stare at you and wouldn't do anything to get off
; SIF TCVAR:ARG:馴れ合い < 1
; 	RETURN 0
SIF TCVAR:ARG:馴れ合い < 1 && !CFLAG:ARG:うふふ
	RETURN 0
SIF TEQUIP:ARG:シックスナイン == 1
	CALL EVENT_COUNTER_POSE_69(ARG,0)
TCVAR:ARG:30 ++
SIF TCVAR:ARG:30 > 1
	RETURN 0
;----------------------------------------------------
;特殊な処理
;----------------------------------------------------
;うふふ中
IF CFLAG:ARG:うふふ == 1 || FREE_USE_ACTIVE() ;custom code
	DEBUGPRINT 카운터 액션
	CALL EVENT_COUNTER_REACTION(ARG,ARG:1)
	CALL EVENT_COUNTER_SOURCE(ARG,ARG:1)
	RETURN 0
ENDIF
;弱味握り制裁
;要調整 ENDUREとRANDで茶を濁す
;2023/01/10 オプション選択制に移行,終了処理をENDUFUFU_ALLに一任
IF ARG:1 == 1 && DECIDE_PUNISHMENT(ARG)
	CALL EVENT_COUNTER_PUNISHMENT(ARG,ARG:1)
	CALL ENDUFUFU_ALL
	TFLAG:102 = 1
	RETURN 0
ENDIF
;----------------------------------------------------
;通常
;----------------------------------------------------
; 低いほどキャラ能力が顕著に反映される。高くすればするほどただの均等ランダムに近付く。デフォは10
基本値 = 10
;------------------------------------------
;2019/08/09 新規判定実装
;2023/01/10 簡易フィルタ実装
;各番号帯に於ける処理を、現行のコマンド処理に沿うようにカウンターコマンドとして分離。
;詳細については各コマンド(CCOM)ファイル内に集約。
;------------------------------------------
FOR LOCAL, 1, CCOM_MAXNUM
[IF_DEBUG]
SIF CCOM_FILTER:LOCAL
	CONTINUE
[ENDIF]
;各コマンドの実行可否を確認
TRYCALLFORM CCOM_ABLE{LOCAL}(ARG)
IF RESULT
	;各コマンドの実行判定値を算出
	TRYCALLFORM CCOM_ORDER{LOCAL}(LOCAL, ARG, 基本値)
	LOCAL:10 = RESULT
	;addition custom code
	CALL KOJO_CHECK(ARG, "CCOM_ORDER", ,LOCAL, LOCAL:10)
	SIF RESULT
		LOCAL:10 = MAX(RESULT, 0)
	IF LOCAL:10
		候補:LOCAL = LOCAL:10
		DEBUGPRINTFORML 카운터{LOCAL}가 후보에(판정치{LOCAL:10})
	ENDIF
ENDIF
RESULT = 0
NEXT
;------------------------------------------
;実行判定・登録
;------------------------------------------
LOCAL:4 = ARRAY_HIT(候補, CCOM_MAXNUM)
SIF TCVAR:ARG:次回カウンター ;&& 候補:(TCVAR:ARG:次回カウンター) > 0 ;custom code, make next com flag work always
	LOCAL:4 = TCVAR:ARG:次回カウンター
TCVAR:ARG:次回カウンター = 0
; 決定
IF LOCAL:4 > 0
	TCVAR:ARG:カウンター行動 = LOCAL:4
	;実行中コマンドとして登録
	FOR LOCAL:2, 0, 最大押し倒され人数 - 1
	IF SELECTCCOM:(LOCAL:2):0 == 0
		SELECTCCOM:(LOCAL:2):0 = ARG
		SELECTCCOM:(LOCAL:2):1 = (TCVAR:ARG:カウンター行動)
		BREAK
	ENDIF
	NEXT
	;com custom code, comment this out and enable the section at source.erb
	;コマンドを実行
	DEBUGPRINTFORML 카운터: {ARG}-{TCVAR:ARG:カウンター行動}
	TRYCALLFORM CCOMF{TCVAR:ARG:カウンター行動}(ARG)
	SIF !RESULT
		DEBUGPRINTFORML CCOMF{TCVAR:ARG:カウンター行動}({ARG})의 호출에 실패했습니다.
ENDIF
