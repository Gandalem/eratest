; Modular ERB: COUNTER/COUNTER_PUNISHMENT.ERB

@EVENT_COUNTER_PUNISHMENT(ARG,ARG:1)
#DIM CONST 制裁種類 = 9
#DIM LOOP_C
CALLF FUNC_FISHER_YATES_SHAFFLE(LOCAL, 制裁種類)
RESULT = 0
FOR LOOP_C, 0, 制裁種類
TRYCALLFORM PUNISHMENT_{LOCAL:LOOP_C}(ARG,ARG:1)
SIF RESULT
	BREAK
NEXT
CFLAG:ARG:弱み握り = MAX(CFLAG:ARG:弱み握り, 0)
SIF !CFLAG:ARG:弱み握り
	PRINTFORML  이 %CALLNAME:ARG%는 당신을 용서한다...
DRAWLINE
WAIT
;パンツを脱がせる

@PUNISHMENT_0(ARG,ARG:1)
SIF !CFLAG:PLAYER:206
	RETURN 0
CFLAG:PLAYER:206 = 0
PRINTFORML %CALLNAME:ARG%은(는) 당신의 속옷을 훔친다.
PRINTFORML 당신은 하루 동안 아무것도 없이 지내야 한다.
CFLAG:ARG:弱み握り -= 1
EXP:ARG:嗜虐快楽経験 += 1
RETURN 1
;ローター挿入

@PUNISHMENT_1(ARG,ARG:1)
SIF !(TALENT:PLAYER:性別 & 1)
	RETURN 0
SIF FLAG:カウンター制裁 == 1
	RETURN 0
CFLAG:PLAYER:ローター挿入 = 240
PRINTFORML %CALLNAME:ARG%은(는) 당신의 질에 회전체를 삽입한다.
PRINTFORML %HE_SHE(ARG,1)%은(는) 당신에게 그렇게 있으라고 명령한다...
CFLAG:ARG:弱み握り -= 2
EXP:ARG:嗜虐快楽経験 += 10
RETURN 1
;ローターA挿入

@PUNISHMENT_2(ARG,ARG:1)
;応急処置としてコメントアウトしておきます
;SIF CFLAG:PLAYER:ローターA挿入
;	RETURN 0
SIF FLAG:カウンター制裁 == 1
	RETURN 0
SIF TFLAG:パール期限
	RETURN 0
CFLAG:PLAYER:ローターA挿入 = 240
PRINTFORML %CALLNAME:ARG%은(는) 당신의 항문에 로터를 삽입한다.
PRINTFORML %HE_SHE(ARG,1)%은(는) 당신에게 그대로 있으라고 명령한다...
CFLAG:ARG:弱み握り -= 2
EXP:ARG:嗜虐快楽経験 += 10
RETURN 1
;キスマーク

@PUNISHMENT_3(ARG,ARG:1)
SIF TFLAG:キスマーク
	RETURN 0
SIF !TALENT:ARG:恋慕
	RETURN 0
PRINTFORML %CALLNAME:ARG%은(는) 당신을 껴안고 목에 강렬한 키스를 남긴다...
PRINTFORML 그것이 사라지기 전에 다른 사람들을 만나는 것은 나쁜 생각일 것이다...
TFLAG:キスマーク = ARG
CFLAG:ARG:弱み握り -= 1
EXP:ARG:嗜虐快楽経験 += 2
RETURN 1
;ほほを抓る

@PUNISHMENT_4(ARG,ARG:1)
PRINTFORML %CALLNAME:ARG%은 모든 %HIS_HER(ARG)%의 힘으로 네 뺨을 잡아당긴다.
PRINTFORML 흐읍...
CFLAG:ARG:弱み握り -= 1
EXP:ARG:嗜虐快楽経験 += 2
BASE:MASTER:気力 -= 50
RETURN 1
;足を踏む

@PUNISHMENT_5(ARG,ARG:1)
PRINTFORML %CALLNAME:ARG%이 네 발을 세게 밟는다.
PRINTFORML IT HURTZ!!
CFLAG:ARG:弱み握り -= 1
EXP:ARG:嗜虐快楽経験 += 2
BASE:MASTER:体力 -= 50
RETURN 1
;3回回ってワンと鳴け

@PUNISHMENT_6(ARG,ARG:1)
PRINTFORML %CALLNAME:ARG%은(는) 너에게 세 번 원을 그리며 개처럼 짖으라고 명령한다.
PRINTFORMW 돌자...
PRINTFORMW 돌자...
PRINTFORMW 돌자...
PRINTFORMW 멍!
PRINTFORMW %CALLNAME:ARG%은(는) 너를 보고 그저 웃는다.
CFLAG:ARG:弱み握り -= 1
EXP:ARG:嗜虐快楽経験 += 5
BASE:MASTER:気力 -= 200
RETURN 1
;アナルパール装着

@PUNISHMENT_7(ARG,ARG:1)
SIF FLAG:カウンター制裁 == 1
	RETURN 0
SIF EXP:PLAYER:Ａ経験 < 10
	RETURN 0
SIF ABL:ARG:サドっ気 < 2
	RETURN 0
SIF TFLAG:パール期限
	RETURN 0
LOCAL = 4 + RAND:4
CALL PEARL_INSERT(ARG, LOCAL)
PRINTFORML %CALLNAME:ARG%이 몇 개의 항문 구슬을 너의 항문에 밀어 넣는다.
PRINTFORML 당신은 옷을 고치는 동안 그것들을 거기에 {TFLAG:パール期限 - TIME}분 동안 두라는 말을 듣는다.
CFLAG:ARG:弱み握り -= 3
EXP:ARG:嗜虐快楽経験 += 15
RETURN 1

@PUNISHMENT_8(ARG,ARG:1)
PRINTFORML %CALLNAME:ARG%가 너의 얼굴을 때린다.
PRINTFORML IT HURTZ!!
CFLAG:ARG:弱み握り -= 3
EXP:ARG:Melee += 3
CALLF BroadDamage(MASTER,"head",ABL:ARG:Melee*50,6,ARG,"fists")
BASE:MASTER:体力 -= ABL:ARG:Melee*50
;カウンター制裁発動判定関数
;発生率はRANDとENDUREを使った未調整のままです

@DECIDE_PUNISHMENT(ARG)
#FUNCTION
SIF CFLAG:ARG:うふふ != 2 || FLAG:カウンター制裁 == 2
	RETURNF 0
SIF !CFLAG:ARG:弱み握り || TCVAR:ARG:好きにして
	RETURNF 0
SIF (ENDURE(ARG) >= (400 + RAND:400)) || RAND:3
	RETURNF 0
RETURNF 1
