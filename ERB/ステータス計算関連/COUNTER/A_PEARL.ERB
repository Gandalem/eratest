@PEARL_CHK_MASTER
#DIM INSERTER
#DIM CONST INTERVAL = 30
#DIM KAKUNIN
#DIM LAPSE

SIF !TFLAG:パール期限
	RETURN

INSERTER = TFLAG:パール入れた人

;流石に他人がいるとチェックしない
KAKUNIN = 1
SIF CFLAG:INSERTER:現在位置 != CFLAG:MASTER:現在位置
	KAKUNIN = 0
SIF GET_TARGETNUM() > 1
	KAKUNIN = 0
SIF !SHIRAHU(INSERTER)
	KAKUNIN = 0

IF TFLAG:パール挿入個数
	SOURCE:MASTER:快Ａ += TIME_PROGRESS(TIME:1) * TFLAG:パール挿入個数
	SOURCE:MASTER:苦痛 += TIME_PROGRESS(TIME:1) * TFLAG:パール挿入個数 * 2
	DOWNBASE:MASTER:体力 += TIME_PROGRESS(TIME:1)
ENDIF

IF TFLAG:パール期限 < TIME && TFLAG:パール期限 > 0 && TFLAG:パール挿入個数
	PRINTFORML You have survived the promised time.
	;qol custom code, notify
	IF !KAKUNIN
		PRINTFORML %PARSE("You have")% to find a deserted spot away from prying eyes for %CALLNAME:INSERTER% to relieve %PARSE("you",5)%...
	ELSE
		PRINTFORML %CALLNAME:INSERTER% will remove the anal beads for %PARSE("you",5)%.
	ENDIF
	TFLAG:パール期限 = -1
ENDIF
IF KAKUNIN
	IF TFLAG:パール期限 == -1
		PRINTFORMW %CALLNAME:INSERTER% strokes your head comfortingly as %HE_SHE(INSERTER)% slowly pulls the anal beads out one at a time, glad you endured it.
		CALL PEARL_EJECT("引っこ抜き")
		RETURN
	ELSEIF TFLAG:パール期限 == -2
		PRINTFORML %CALLNAME:INSERTER% notices the anal beads have come out, and once again, pushes them into you one by one!
		CALL PEARL_INSERT(INSERTER,5)
	ENDIF
ENDIF

LAPSE = (TIME - TFLAG:パール排出チェック) / INTERVAL

IF LAPSE && TFLAG:パール期限 > 0
	TFLAG:パール排出チェック = TIME
	IF KAKUNIN
		PRINTFORML %CALLNAME:INSERTER% puts %HIS_HER(INSERTER)% hand on your ass and confirms the beads are still inside...
		PRINTFORML Seeing they're still hanging out from your anus, %CALLNAME:INSERTER% smiles softly as %HE_SHE(INSERTER)% tugs on the ring, telling you to endure a bit more.
		SOURCE:MASTER:快Ａ += 50
	ENDIF
	FOR LOCAL, 0, LAPSE
		CALL PEARL_PATIENCE
		SIF TFLAG:パール挿入個数 <= 0 ;bug fix custom code
			BREAK
	NEXT
ENDIF

