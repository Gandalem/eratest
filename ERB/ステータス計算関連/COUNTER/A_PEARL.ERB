; Modular ERB: COUNTER/A_PEARL.ERB

@PEARL_CHK_MASTER
#DIM INSERTER
#DIM CONST INTERVAL = 30
#DIM KAKUNIN
#DIM LAPSE
SIF !TFLAG:パール期限
	RETURN
INSERTER = TFLAG:パール入れた人
;流石に他人がいるとチェックしない
KAKUNIN = 1
SIF CFLAG:INSERTER:現在位置 != CFLAG:MASTER:現在位置
	KAKUNIN = 0
SIF GET_TARGETNUM() > 1
	KAKUNIN = 0
SIF !SHIRAHU(INSERTER)
	KAKUNIN = 0
IF TFLAG:パール挿入個数
	SOURCE:MASTER:快Ａ += TIME_PROGRESS(TIME:1) * TFLAG:パール挿入個数
	SOURCE:MASTER:苦痛 += TIME_PROGRESS(TIME:1) * TFLAG:パール挿入個数 * 2
	DOWNBASE:MASTER:体力 += TIME_PROGRESS(TIME:1)
ENDIF
IF TFLAG:パール期限 < TIME && TFLAG:パール期限 > 0 && TFLAG:パール挿入個数
	PRINTFORML 당신은 약속된 시간을 살아남았다.
	;qol custom code, notify
	IF !KAKUNIN
		PRINTFORML %PARSE("You have")%이 눈에 띄지 않는 곳에서 %CALLNAME:INSERTER%가 %PARSE("you",5)%을 풀기 위해 버려진 장소를 찾으러 간다...
	ELSE
		PRINTFORML %CALLNAME:INSERTER%은 %PARSE("you",5)%의 애널 비즈를 제거할 것이다.
	ENDIF
	TFLAG:パール期限 = -1
ENDIF
IF KAKUNIN
	IF TFLAG:パール期限 == -1
		PRINTFORMW %CALLNAME:INSERTER%는 당신의 머리를 위로 쓰다듬으며, %HE_SHE(INSERTER)%가 하나씩 항문 비즈를 천천히 빼내는 동안 안심하는 듯하다.
		CALL PEARL_EJECT("引っこ抜き")
		RETURN
	ELSEIF TFLAG:パール期限 == -2
		PRINTFORML %CALLNAME:INSERTER%는 항문 비즈가 빠져나온 것을 알아차리고, 다시 한번 하나씩 당신 안으로 밀어 넣는다!
		CALL PEARL_INSERT(INSERTER,5)
	ENDIF
ENDIF
LAPSE = (TIME - TFLAG:パール排出チェック) / INTERVAL
IF LAPSE && TFLAG:パール期限 > 0
	TFLAG:パール排出チェック = TIME
	IF KAKUNIN
		PRINTFORML %CALLNAME:INSERTER%이/가 당신의 엉덩이에 손을 대고 구슬들이 아직 안에 있는지 확인한다...
		PRINTFORML 그것들이 여전히 당신의 항문에서 나와 있는 것을 보자, %CALLNAME:INSERTER%은 부드럽게 미소 지으며 %HE_SHE(INSERTER)%이/가 반지(링)를 잡아당기며 잠시만 더 참으라고 말한다.
		SOURCE:MASTER:快Ａ += 50
	ENDIF
	FOR LOCAL, 0, LAPSE
	CALL PEARL_PATIENCE
	SIF TFLAG:パール挿入個数 <= 0 ;bug fix custom code
		BREAK
	NEXT
ENDIF

@PEARL_EJECT(ARGS)
#DIM INSERTER
#DIM OTOSIDAMA
INSERTER = TFLAG:パール入れた人
IF ARGS == "自然排出"
	IF PooBarStage(MASTER) >= 6 && GETBIT(nScat,2)
		PRINTFORMW 항문 비즈가 빠진다 ({TFLAG:パール挿入個数} 남음).
		PRINTFORML 하지만 막을 수 없는 듯, 오히려 압력은 점점 더 강해지고 있다...
		PRINTFORMW 그리고 비즈들이 한 번에 떨어지기 시작하며, 매우 지저분한 사고를 치는 것 외에는 선택의 여지가 없게 된다... 
		PRINTL
		PRINTFORMW 당신은 등을 살짝 구부리고 비즈를 밀어내려고 하지만 대신 따뜻한 더러움과 맞이하게 된다...
		PRINTFORMW 모든 항문 비즈가 당신의 %PeeProtectType(MASTER,1)% 안으로 쏟아져 나온다. 왜냐하면 당신의 %PeeAndPoo(0, 1, , "poop")% 전체가 쉽게 비즈를 밀어낼 수 있기 때문이다..
		PRINTFORMW 스스로 통제 불능 상태에 빠지면서, 항문 비즈가 당신의 매우 더러워진 %PeeProtectType(MASTER,1)% 안에서 새로운 보금자리를 찾는 것에 안도감을 느낄 수밖에 없었다.
		CALL OMORASHI_END(MASTER,,1)
		TFLAG:パール期限 = -2
	ELSE
		SOURCE:MASTER:快Ａ += 100
		EXP:MASTER:Ａ経験 += 1
		TFLAG:パール挿入個数 -= 1
		PRINTFORMW 항문에 구슬이 빠져나왔다 ({TFLAG:パール挿入個数} 남음).
		IF TFLAG:パール挿入個数 <= 0 ;bug fix custom code
			PRINTFORMW 모든 구슬이 이제 떨어져 버렸다...
			TFLAG:パール期限 = -2
		ENDIF
	ENDIF
ELSEIF ARGS == "引っこ抜き"
	SOURCE:MASTER:快Ａ += TFLAG:パール挿入個数 * 200
	EXP:MASTER:Ａ経験 += TFLAG:パール挿入個数
	EXP:MASTER:苦痛快楽経験 += TFLAG:パール挿入個数 * 3
	EXP:INSERTER:嗜虐快楽経験 += TFLAG:パール挿入個数 * 3
	SOURCE:INSERTER:加虐 += TFLAG:パール挿入個数 * 100
	TFLAG:パール挿入個数 = 0
	TFLAG:パール期限 = 0
	TFLAG:パール入れた人 = 0
	TFLAG:パール排出チェック = 0
	IF FESTIVAL() == "元日"
		SELECTCASE RAND:3
			CASE 0
				OTOSIDAMA = 10000
			CASE 1
				OTOSIDAMA = 30000
			CASE 2
				OTOSIDAMA = 50000
		ENDSELECT
		PRINTFORMW ...?
		PRINTFORMW 그 끝에 당신은 기억하지 못하는 황금 구슬이 있다.
		CALL COLORMESSAGE(@"새해 선물 보너스! 당신은 %金額表示(OTOSIDAMA)%을 받습니다!",C_YELLOW,2)
		MONEY += OTOSIDAMA
	ENDIF
ENDIF

@PEARL_INSERT(ARG,ARG:1)
TFLAG:パール挿入個数 = ARG:1
TFLAG:パール期限 = TIME + TFLAG:パール挿入個数 * 30 + RAND:30 + RAND:30
TFLAG:パール入れた人 = ARG
SOURCE:MASTER:快Ａ += TFLAG:パール挿入個数 * 10
TFLAG:パール排出チェック = TIME
;qol custom code, add exp (your hole is developing after all)
EXP:MASTER:Ａ経験 ++
EXP:MASTER:苦痛快楽経験 ++

@PEARL_PATIENCE
;qol custom code, add exp every time you struggle
SOURCE:MASTER:快Ａ += 100
EXP:MASTER:Ａ経験 ++
EXP:MASTER:苦痛快楽経験 ++
PRINTFORML 항문에 있는 분석 구슬이 당신의 항문에서 흘러나오려 한다...
CALL ASK_M("견딘다(50 ENE)",BASE:MASTER:気力 >= 50, "견디다(200 ENE)",BASE:MASTER:気力 >= 100, "편안히 있어라",1)
SELECTCASE RESULT
	CASE 0
		DOWNBASE:MASTER:気力 += 50
		IF !RAND:2
			PRINTFORMW 당신은 배설의 느낌을 견딘다.
		ELSE
			PRINTFORMW 너는 배설의 감정을 견디지 못한다.
			CALL PEARL_EJECT("自然排出")
		ENDIF
	CASE 1
		PRINTFORMW 당신은 배설되는 느낌을 필사적으로 견딘다.
		DOWNBASE:MASTER:気力 += 200
	CASE 2
		CALL PEARL_EJECT("自然排出")
ENDSELECT
