; Modular ERB: COUNTER/REACTION/COUNTER_REACTION.ERB
;************************************************************************
;コマンド実行の際にキャラ側でリアクションを返す処理
;押し倒されとは関係が無く、カウンターと同列に扱われててややこしかったので分離
;************************************************************************

@EVENT_COUNTER_REACTION(ARG,ARG:1)
IF MASTER_POSE(SET_V,SET_P) == ARG && TCVAR:ARG:無理矢理
	LOCAL = RAND:2 + 1
	SELECTCASE LOCAL
		CASE 1
			TCVAR:ARG:21 = 1
		CASE 2
			SIF POSE_FACING(TEQUIP:ARG:体位) ;qol custom code
				TCVAR:ARG:21 = 2
	ENDSELECT
	TCVAR:ARG:20 = 506
	;膣挿入
ELSEIF MASTER_POSE(SET_V,SET_P) == ARG
	LOCAL = RAND:7 + 1
	SELECTCASE LOCAL
		CASE 1
			SIF ABL:ARG:膣 < 2
				RETURN 0
			TCVAR:ARG:21 = 1
			;だいしゅきホールド
		CASE 2
			SIF !TALENT:ARG:恋慕
				RETURN 0
			SIF POSE_FACING(TEQUIP:ARG:体位) ;qol custom code
				TCVAR:ARG:21 = 2
			;性交見せつけ
		CASE 3
			SIF ABL:ARG:露出癖 < 2
				RETURN 0
			SIF TEQUIP:ARG:体位 == POSE_COWGIRL
				TCVAR:ARG:21 = 3
		CASE 4
			SIF EXP:ARG:子宮口開発経験 < 50 || TEQUIP:ARG:子宮
				RETURN 0
			SIF ABL:ARG:膣 < 2
				RETURN 0
			TEQUIP:ARG:子宮 = 1
			TCVAR:ARG:21 = 4
		CASE 5
			SIF !TALENT:ARG:恋慕
				RETURN 0
			SIF ABL:ARG:Ｖ感覚 < 5
				RETURN 0
			TCVAR:ARG:21 = 5
		CASE 6
			SIF EXP:ARG:子宮口開発経験 < 100
				RETURN 0
			SIF ABL:ARG:膣 < 3
				RETURN 0
			SIF !TEQUIP:ARG:子宮
				RETURN 0
			TEQUIP:ARG:子宮 = 2
			TCVAR:ARG:21 = 6
		CASE 7
			SIF TEQUIP:ARG:指接触部位
				RETURN 0
			SIF !TALENT:ARG:恋慕
				RETURN 0
			SIF !POSE_FACING(TEQUIP:ARG:体位) || POSE_HUGGING(TEQUIP:ARG:体位) ;qol custom code
				RETURN 0
			TCVAR:ARG:21 = 7
	ENDSELECT
	SIF TCVAR:ARG:21
		TCVAR:ARG:20 = 500
	;アナル挿入
ELSEIF MASTER_POSE(SET_A,SET_P) == ARG
	LOCAL = RAND:2 + 1
	SELECTCASE LOCAL
		CASE 1
			SIF ABL:ARG:アナル < 2
				RETURN 0
			TCVAR:ARG:21 = 1
		CASE 2
			SIF TEQUIP:ARG:指接触部位
				RETURN 0
			SIF !TALENT:ARG:恋慕
				RETURN 0
			SIF !POSE_FACING(TEQUIP:ARG:体位) || POSE_HUGGING(TEQUIP:ARG:体位) ;qol custom code
				RETURN 0
			TCVAR:ARG:21 = 7
	ENDSELECT
	SIF TCVAR:ARG:21
		TCVAR:ARG:20 = 501
	;手淫
ELSEIF MASTER_POSE(SET_YUBI, SET_P) == ARG
	LOCAL = RAND:3 + 1
	SELECTCASE LOCAL
		CASE 1
			SIF ABL:ARG:指 < 2
				RETURN 0
			TCVAR:ARG:21 = 1
			;玉揉み
		CASE 2
			SIF ABL:ARG:指 < 2
				RETURN 0
			SIF ARG == TARGET && SELECTCOM == 80
				TCVAR:ARG:21 = 4 ;com custom code
		CASE 3
			SIF BASE:PLAYER:勃起 < 1000
				RETURN 0
			SIF ARG == TARGET && SELECTCOM == 80 && ABL:ARG:サドっ気 >= 3 && CFLAG:ARG:アナル開発許可 ;com custom code
				TCVAR:ARG:20 = 601
	ENDSELECT
	SIF TCVAR:ARG:21 ;com custom code
		TCVAR:ARG:20 = TCVAR:ARG:21 == 4 ? 600 # 502
	;フェラチオ
ELSEIF MASTER_POSE(SET_M,SET_P) == ARG
	LOCAL = RAND:3 + 1
	SELECTCASE LOCAL
		CASE 1
			SIF ABL:ARG:舌 < 2
				RETURN 0
			TCVAR:ARG:21 = 1
			;玉舐め
		CASE 2
			SIF ABL:ARG:舌 < 2
				RETURN 0
			SIF ABL:ARG:奉仕精神 < 5
				RETURN 0
			SIF ARG == TARGET
				RETURN 0
			TCVAR:ARG:21 = 2
			;ディープスロート
		CASE 3
			SIF ABL:ARG:舌 < 3
				RETURN 0
			SIF BASE:PLAYER:勃起 < 1000
				RETURN 0
			SIF ARG == TARGET && SELECTCOM == 81
				TCVAR:ARG:21 = 3
			;フェラ自慰
		CASE 4
			SIF ABL:ARG:露出癖 < 2
				RETURN 0
			TCVAR:ARG:21 = 4
	ENDSELECT
	SIF TCVAR:ARG:21 ;com custom code
		TCVAR:ARG:20 = TCVAR:ARG:21 == 2 ? 600 # 503
	;パイズリ
ELSEIF ARG == TARGET && SELECTCOM == 82
	LOCAL = RAND:5 + 1 ;addition custom code
	SELECTCASE LOCAL
		CASE 1
			SIF ARG == TARGET || SELECTCOM == 82
				RETURN 0
			SIF ABL:ARG:胸 < 2
				RETURN 0
			TCVAR:ARG:21 = 1
			;縦パイズリ
		CASE 2
			SIF ABL:ARG:胸 < 3
				RETURN 0
			SIF TALENT:ARG:バストサイズ < 1
				RETURN 0
			TCVAR:ARG:21 = 2
			;頑張って谷間をつくる
		CASE 3
			SIF ABL:ARG:胸 < 3
				RETURN 0
			SIF ARG == TARGET && SELECTCOM == 82
				TCVAR:ARG:21 = 3
		CASE 4
			SIF ABL:ARG:胸 < 2
				RETURN 0
			SIF ABL:ARG:胸 < 2
				RETURN 0
			SIF ABL:ARG:奉仕精神 < 5
				RETURN 0
			SIF TALENT:ARG:バストサイズ < 0 ;qol custom code, too small
				RETURN 0
			SIF TALENT:PLAYER:形状 < (TALENT:ARG:バストサイズ + 2) || (GROUPMATCH(TALENT:PLAYER:形状, 4, 5) && TALENT:ARG:バストサイズ > 1) ;qol custom code, too large comparatively
				RETURN 0
			TCVAR:ARG:21 = LOCAL
		CASE 5 ;addition custom code
			SIF ABL:ARG:胸 < 3
				RETURN 0
			SIF TALENT:ARG:バストサイズ < 0
				RETURN 0
			SIF TALENT:PLAYER:形状 >= (TALENT:ARG:バストサイズ + 2) || (GROUPMATCH(TALENT:PLAYER:形状, 4, 5) && TALENT:ARG:バストサイズ < 2)
				RETURN 0
			TCVAR:ARG:21 = LOCAL
	ENDSELECT
	SIF TCVAR:ARG:21
		TCVAR:ARG:20 = 504
	;素股
ELSEIF MASTER_POSE(SET_C,SET_P) == ARG
	LOCAL = RAND:2 + 1
	SELECTCASE LOCAL
		CASE 1
			SIF ABL:ARG:腰 < 2
				RETURN 0
			TCVAR:ARG:21 = 1
			;手淫追加
		CASE 2
			SIF ABL:ARG:腰 < 2
				RETURN 0
			SIF ABL:ARG:指 < 2
				RETURN 0
			SIF ARG == TARGET && SELECTCOM == 83
				TCVAR:ARG:21 = 2
	ENDSELECT
	SIF TCVAR:ARG:21
		TCVAR:ARG:20 = 505
	;MASTERの胸がお留守の場合
ELSEIF !FLAG:アナル開発無効 && !MASTER_POSE(0,SET_B) && !TEQUIP:ARG:縄 && ABL:ARG:サドっ気 >= 3 && !RAND:4 ;com custom code, uncommented
	IF !TEQUIP:ARG:指接触部位 && !POSE_BEHIND(ADD_TOUCH_CURRENT_POSE(PLAYER, ARG)) ;qol custom code
		TCVAR:ARG:21 = 1
	ELSEIF !TEQUIP:ARG:口接触部位 && !POSE_BEHIND(ADD_TOUCH_CURRENT_POSE(PLAYER, ARG)) ;qol custom code
		TCVAR:ARG:21 = 2
	ENDIF
	SIF TCVAR:ARG:21
		TCVAR:ARG:20 = 510
ELSEIF !nContentSwitch:Content_MaleNipple && MASTER_POSE(SET_YUBI, SET_A) == ARG ;com custom code, anal caress
	SIF ABL:ARG:サドっ気 >= 3 && CFLAG:ARG:アナル開発許可 &&  !POSE_BEHIND(ADD_TOUCH_CURRENT_POSE(PLAYER, ARG)) ;qol custom code
		TCVAR:ARG:21 = 1
	SIF TCVAR:ARG:21
		TCVAR:ARG:20 = 601
ENDIF
