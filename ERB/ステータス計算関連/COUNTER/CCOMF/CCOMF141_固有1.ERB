; Modular ERB: COUNTER/CCOMF/CCOMF141_固有1.ERB
;*********************************************************************************************
;カウンターコマンド：固有１
;ARG = 対象のキャラ番号
;*********************************************************************************************

@CCOMF141(ARG)
;addition custom code, duplicated characters
LOCAL = TARGET
TARGET = ARG
CALL KOJO_ACTIVE_INFO(ARG)
TRYCALLFORM UNIQUE_COUNTER1_SOURCE_K{NO:ARG}%RESULTS%
TARGET = LOCAL
RETURN 1
;*********************************************************************************************
;カウンター実行可否出力関数
;ARG = 対象のキャラ番号
;*********************************************************************************************

@CCOM_ABLE141(ARG)
CALL KOJO_ACTIVE_INFO(ARG)
RESULT = 0
LOCAL = TARGET
TARGET = ARG
TRYCALLFORM UNIQUE_COUNTER1_ABLE_K{NO:ARG}%RESULTS%
TARGET = LOCAL
RETURN RESULT
;*********************************************************************************************
;カウンター実行判定値算出関数
;ARG = 対象のキャラ番号
;*********************************************************************************************

@CCOM_ORDER141(コマンド番号, ARG, 基本値)
#DIM コマンド番号
#DIM 基本値
CALL KOJO_ACTIVE_INFO(ARG)
LOCALS '= RESULTS
RESULT = 0
RESULTS =
LOCAL = TARGET
TARGET = ARG
TRYCALLFORM UNIQUE_COUNTER1_FREQUENCY_K{NO:ARG}%LOCALS%
TARGET = LOCAL
;=============================
LOCAL = 基本値 + RESULT
;カウンタータイプ別計算処理 実質実行判定処理を含む
;=============================
LOCAL *= COUNTER_TYPE(RESULTS, ARG)
RETURN LOCAL
