;*********************************************************************************************
;カウンターコマンド：固有4
;ARG = 対象のキャラ番号
;*********************************************************************************************
@CCOMF144(ARG)
;addition custom code, duplicated characters
LOCAL = TARGET
TARGET = ARG
CALL KOJO_ACTIVE_INFO(ARG)
TRYCALLFORM UNIQUE_COUNTER4_SOURCE_K{NO:ARG}%RESULTS%
TARGET = LOCAL
RETURN 1

;*********************************************************************************************
;カウンター実行可否出力関数
;ARG = 対象のキャラ番号
;*********************************************************************************************
@CCOM_ABLE144(ARG)
CALL KOJO_ACTIVE_INFO(ARG)
RESULT = 0
LOCAL = TARGET
TARGET = ARG
TRYCALLFORM UNIQUE_COUNTER4_ABLE_K{NO:ARG}%RESULTS%
TARGET = LOCAL
RETURN RESULT

;*********************************************************************************************
;カウンター実行判定値算出関数
;ARG = 対象のキャラ番号
;*********************************************************************************************
@CCOM_ORDER144(コマンド番号, ARG, 基本値)
#DIM コマンド番号
#DIM 基本値

CALL KOJO_ACTIVE_INFO(ARG)
LOCALS '= RESULTS
RESULT = 0
RESULTS =
LOCAL = TARGET
TARGET = ARG
TRYCALLFORM UNIQUE_COUNTER4_FREQUENCY_K{NO:ARG}%LOCALS%
TARGET = LOCAL

	;=============================
	LOCAL = 基本値 + RESULT
	;カウンタータイプ別計算処理 実質実行判定処理を含む
	;=============================
	LOCAL *= COUNTER_TYPE(RESULTS, ARG)
RETURN LOCAL
