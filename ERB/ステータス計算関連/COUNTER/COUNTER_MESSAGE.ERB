@素質計算(ARG)
#FUNCTION
#DIM 気弱系
#DIM 強気系
#DIM 素直系
#DIM 真面目系
気弱系 = 0
強気系 = 0
素直系 = 0
真面目系 = 0
;臆病
IF TALENT:ARG:度胸 == -1
	気弱系 += 5
	;気丈
ELSEIF TALENT:ARG:度胸 == 1
	強気系 += 1
ENDIF
;素直
IF TALENT:ARG:態度 == -1
	素直系 += 2
	;反抗的
ELSEIF TALENT:ARG:態度 == 1
	強気系 += 1
ENDIF
;大人しい
IF TALENT:ARG:応答 == -1
	気弱系 += 1
	;生意気
ELSEIF TALENT:ARG:応答 == 1
	強気系 += 1
ENDIF
;プライド低い
IF TALENT:ARG:プライド == -1
	気弱系 += 1
	;プライド高い
ELSEIF TALENT:ARG:プライド == 1
	強気系 += 1
ENDIF
;ツンデレ
IF TALENT:ARG:ツンデレ
	IF TALENT:ARG:恋慕 || TALENT:ARG:淫乱 || TALENT:ARG:服従
		素直系 += 1
	ELSE
		強気系 += 1
	ENDIF
ENDIF
;自制心
SIF TALENT:ARG:自制心
	真面目系 += 1
;保守的
IF TALENT:ARG:性的興味 == -1
	真面目系 += 1
	;好奇心
ELSEIF TALENT:ARG:性的興味 == 1
	素直系 += 1
ENDIF
;陰気
IF TALENT:ARG:陽気／陰気 == -1
	気弱系 += 1
	;陽気
ELSEIF TALENT:ARG:陽気／陰気 == 1
	素直系 += 1
ENDIF
;貞操無頓着
IF TALENT:ARG:貞操 == -1
	素直系 += 1
	;貞操観念
ELSEIF TALENT:ARG:貞操 == 1
	真面目系 += 1
ENDIF
;抑圧
IF TALENT:ARG:自己愛 == -1
	気弱系 += 1
	;解放
ELSEIF TALENT:ARG:自己愛 == 1
	素直系 += 1
ENDIF
;恥薄い
IF TALENT:ARG:羞恥心 == -1
	素直系 += 1
	;恥じらい
ELSEIF TALENT:ARG:羞恥心 == 1
	気弱系 += 1
ENDIF
;献身的
SIF TALENT:ARG:献身的
	真面目系 += 2
;快感の否定
IF TALENT:ARG:快感応答 == -1
	真面目系 += 1
	;快感に素直
ELSEIF TALENT:ARG:快感応答 == 1
	素直系 += 1
ENDIF
;サド
SIF TALENT:ARG:サド
	強気系 += 2
;マゾ
SIF TALENT:ARG:マゾ
	気弱系 += 2
;気弱系
IF 気弱系 > 強気系 && 気弱系 > 素直系 && 気弱系 > 真面目系 && !(TALENT:ARG:性別嗜好 == 1 && TALENT:MASTER:性別 == 2) && !(TALENT:ARG:性別嗜好 == 2 && TALENT:MASTER:性別 == 1) && TALENT:ARG:性別嗜好 != 3
	RETURNF 1
	;強気系
ELSEIF 強気系 > 素直系 && 強気系 > 気弱系 && 強気系 > 真面目系 && !(TALENT:ARG:性別嗜好 == 1 && TALENT:MASTER:性別 == 2) && !(TALENT:ARG:性別嗜好 == 2 && TALENT:MASTER:性別 == 1) && TALENT:ARG:性別嗜好 != 3
	RETURNF 2
	;素直系
ELSEIF 素直系 > 強気系 && 素直系 > 気弱系 && 素直系 > 真面目系 && !(TALENT:ARG:性別嗜好 == 1 && TALENT:MASTER:性別 == 2) && !(TALENT:ARG:性別嗜好 == 2 && TALENT:MASTER:性別 == 1) && TALENT:ARG:性別嗜好 != 3
	RETURNF 3
	;真面目系
ELSEIF 真面目系 > 強気系 && 真面目系 > 気弱系 && 真面目系 > 素直系 && !(TALENT:ARG:性別嗜好 == 1 && TALENT:MASTER:性別 == 2) && !(TALENT:ARG:性別嗜好 == 2 && TALENT:MASTER:性別 == 1) && TALENT:ARG:性別嗜好 != 3
	RETURNF 4
ELSE
	;その他
	RETURNF 5
ENDIF

