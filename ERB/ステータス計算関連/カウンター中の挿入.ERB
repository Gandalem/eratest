; Modular ERB: カウンター中の挿入.ERB

@SHIBORITORI(射精キャラ番号, 被射精キャラ番号)
#DIM 射精キャラ番号
#DIM 被射精キャラ番号
#DIMS 射精箇所1
#DIMS 射精箇所2
;Custom code, override
CALL SHIBORITORI_TR(射精キャラ番号, 被射精キャラ番号)
RETURN
;なんかDIMとか使って微妙に分かりにくいかもしれないけど、これは最初に射精確定後処理に入れようとしてやっぱり止めた時の名残なので
;気にしなくていいです　地の文が最初に表示されちゃう
IF 射精キャラ番号 == MASTER
	;あなたが突っ込んでる場合
	IF Ｓ度判定(被射精キャラ番号,射精キャラ番号) < RAND:(MAX((100 - ABL:被射精キャラ番号:欲望 * 5), 20))
		IF TALENT:被射精キャラ番号:献身的 && BASE:射精キャラ番号:気力 == 0
			PRINTFORMW %CALLNAME:被射精キャラ番号%은(는) %CALLNAME:射精キャラ番号%의 컨디션을 염려하며, %CALLNAME:射精キャラ番号%의 페니스를 해방했다...
		ELSE
			PRINTFORMW %CALLNAME:被射精キャラ番号%은(는) %CALLNAME:射精キャラ番号%가 사정하고 끝나자 만족스러운 듯 미소 지으며 %CALLNAME:射精キャラ番号%의 페니스를 빼냈다……
		ENDIF
		CALL 挿入解除(被射精キャラ番号)
		TFLAG:106 = 0
	ELSE
		IF TALENT:被射精キャラ番号:サド
			IF TALENT:射精キャラ番号:マゾ
				IF BASE:被射精キャラ番号:気力 > 0
					IF BASE:射精キャラ番号:気力 == 0
						PRINTFORML %CALLNAME:被射精キャラ番号%는 %CALLNAME:射精キャラ番号%를 해방할 기분은 전혀 없는 것 같다.
						PRINTFORMW %CALLNAME:被射精キャラ番号%의 질살이 %CALLNAME:射精キャラ番号%의 페니스에 감기며, 더욱한 사정을 갈망하며 연동하기 시작하고 있다…….
					ELSE
						PRINTFORMW %CALLNAME:被射精キャラ番号%는 %CALLNAME:射精キャラ番号%의 팔을 놓치지 않으려고 꽉 붙잡고, 내리찍듯이 허리를 흔들기 시작했다……
					ENDIF
				ELSEIF BASE:射精キャラ番号:気力 == 0
					PRINTFORMW %CALLNAME:被射精キャラ番号%는 축 늘어진 채 %CALLNAME:射精キャラ番号%를 누르고, 내리치는 듯 허리를 흔들기 시작했다…….
				ELSE
					PRINTFORMW %CALLNAME:被射精キャラ番号%는 %CALLNAME:射精キャラ番号%가 사정하고 끝나는 것을 확인하자, 지체 없이 허리를 흔들기 시작했다…….
				ENDIF
			ELSEIF BASE:被射精キャラ番号:気力 > 0
				PRINTFORMW %CALLNAME:被射精キャラ番号%는 %CALLNAME:射精キャラ番号%에게서 더욱 정액을 짜내려고 다시 허리를 흔들기 시작했다...
			ELSEIF BASE:射精キャラ番号:気力 == 0
				PRINTFORMW %CALLNAME:被射精キャラ番号%는 축 늘어진 채 %CALLNAME:射精キャラ番号%를 짓누르고, 다시 허리를 흔들기 시작했다……
			ELSE
				PRINTFORMW %CALLNAME:被射精キャラ番号%는 %CALLNAME:射精キャラ番号%가 사정하고 끝나는 것을 확인하자, 지체 없이 다시 허리를 흔들기 시작했다……
			ENDIF
		ELSE
			IF TALENT:被射精キャラ番号:献身的 && BASE:射精キャラ番号:気力 == 0
				PRINTFORMW %CALLNAME:被射精キャラ番号%는 아직 만족하지 못한 건지, %CALLNAME:射精キャラ番号%에게 사죄한 뒤 다시 허리를 흔들기 시작했다...
			ELSE
				PRINTFORMW 한번 %CALLNAME:射精キャラ番号%의 사정이 끝나자, %CALLNAME:被射精キャラ番号%는 %HIM_HER(射精キャラ番号)%의 볼에 키스하고 다시 %HIS_HER(被射精キャラ番号)%의 허리를 흔들기 시작했다...
			ENDIF
		ENDIF
	ENDIF
ELSE
	;あなたに突っ込んでる場合
	IF TCVAR:TARGET:射精した箇所フラグ == 1
		射精箇所1 = 膣内
		射精箇所2 = 膣
	ELSE
		射精箇所1 = アナル
		射精箇所2 = アナル
	ENDIF
	IF Ｓ度判定(射精キャラ番号, 被射精キャラ番号) - 引き抜き精力補正(射精キャラ番号) < RAND:(MAX((100 - ABL:被射精キャラ番号:欲望 * 5), 20))
		IF TALENT:射精キャラ番号:献身的 && BASE:被射精キャラ番号:気力 == 0
			PRINTFORMW %CALLNAME:射精キャラ番号%은(는) %CALLNAME:被射精キャラ番号%의 컨디션을 염려하며, %CALLNAME:被射精キャラ番号%의 %射精箇所2%에서 페니스를 빼냈다...
		ELSE
			PRINTFORMW %CALLNAME:射精キャラ番号%은(는) %CALLNAME:被射精キャラ番号%의 %射精箇所1%에 정액을 다 부어 넣고 만족스러운 듯 미소 지으며 페니스를 빼냈다……
		ENDIF
		CALL 挿入解除(被射精キャラ番号)
		CALL TOUCH_SET(0, 0, 射精キャラ番号, 1)
	ELSE
		IF TALENT:射精キャラ番号:サド
			IF TALENT:被射精キャラ番号:マゾ
				IF BASE:射精キャラ番号:気力 > 0
					IF BASE:被射精キャラ番号:気力 == 0
						PRINTFORML %CALLNAME:射精キャラ番号%은(는) %CALLNAME:被射精キャラ番号%를 해방할 생각은 전혀 없는 것 같다
						PRINTFORMW %CALLNAME:射精キャラ番号%의 페니스는 순식간에 경도와 크기를 되찾고, %CALLNAME:被射精キャラ番号%의 %射精箇所2%를 파고들기 시작했다……
					ELSE
						PRINTFORMW %CALLNAME:射精キャラ番号%는 %CALLNAME:被射精キャラ番号%의 팔을 놓치지 않으려고 단단히 붙잡고, 내리꽂듯이 허리를 밀어넣기 시작했다……
					ENDIF
				ELSEIF BASE:射精キャラ番号:気力 == 0
					PRINTFORMW %CALLNAME:射精キャラ番号%는 지친 %CALLNAME:被射精キャラ番号%를 짓누르며, 내리치듯이 허리를 밀어 넣기 시작했다...
				ELSE
					PRINTFORMW %CALLNAME:射精キャラ番号%는 사정을 마치면, 기대듯이 %CALLNAME:被射精キャラ番号%에게 매달려 다시 허리를 흔들기 시작했다……
				ENDIF
			ELSEIF BASE:射精キャラ番号:気力 > 0
				PRINTFORMW %CALLNAME:射精キャラ番号%는 %CALLNAME:被射精キャラ番号%의 %射精箇所1%에 더욱 정액을 쏟아붓고자 다시 허리를 흔들기 시작했다…….
			ELSEIF BASE:被射精キャラ番号:気力 == 0
				PRINTFORMW %CALLNAME:射精キャラ番号%는 축 늘어진 %CALLNAME:被射精キャラ番号%를 짓누르고, 다시 허리를 흔들기 시작했다...
			ELSE
				PRINTFORMW %CALLNAME:射精キャラ番号%는 사정을 마치자, 기댄 듯 %CALLNAME:被射精キャラ番号%에게 매달리며 다시 허리를 흔들기 시작했다...
			ENDIF
		ELSE
			IF TALENT:射精キャラ番号:献身的 && BASE:被射精キャラ番号:気力 == 0
				PRINTFORMW %CALLNAME:射精キャラ番号%는 아직 만족하지 못한 건가, %CALLNAME:被射精キャラ番号%에게 사과한 후에 다시 허리를 흔들기 시작했다…….
			ELSE
				PRINTFORMW %CALLNAME:射精キャラ番号%은(는) %CALLNAME:被射精キャラ番号%의 %射精箇所1%으로 사정하고 끝나자, %CALLNAME:被射精キャラ番号%의 뺨에 키스한 후 다시 허리를 흔들기 시작했다……
			ENDIF
		ENDIF
	ENDIF
ENDIF

@Ｓ度判定(攻め,受け)
#FUNCTION
#DIM 攻め
#DIM 受け
VARSET LOCAL
LOCAL += ABL:攻め:サドっ気 * 5
LOCAL -= ABL:攻め:マゾっ気 * 5
LOCAL += ABL:受け:マゾっ気 * 5
LOCAL -= ABL:受け:サドっ気 * 5
IF TALENT:攻め:サド
	IF TALENT:受け:マゾ
		IF BASE:攻め:気力 > 0
			IF BASE:受け:気力 <= 0
				LOCAL += 999
			ELSE
				LOCAL += 90
			ENDIF
		ELSEIF BASE:受け:気力 <= 0
			LOCAL += 75
		ELSE
			LOCAL += 60
		ENDIF
	ELSEIF BASE:攻め:気力 > 0
		IF BASE:受け:気力 <= 0
			LOCAL += 50
		ELSE
			LOCAL += 30
		ENDIF
	ELSEIF BASE:受け:気力 <= 0
		LOCAL += 20
	ELSE
		LOCAL += 10
	ENDIF
ELSE
	IF TALENT:受け:マゾ
		IF BASE:攻め:気力 > 0
			IF BASE:受け:気力 <= 0
				LOCAL += 75
			ELSE
				LOCAL += 60
			ENDIF
		ELSEIF BASE:受け:気力 <= 0
			LOCAL += 50
		ELSE
			LOCAL += 35
		ENDIF
	ELSE
		SIF BASE:受け:気力 <= 0
			LOCAL += 10
		SIF BASE:攻め:気力 > 0
			LOCAL += 10
	ENDIF
ENDIF
;反抗的
SIF TALENT:攻め:態度 == 1
	LOCAL += 5
;自制心
SIF TALENT:攻め:自制心
	LOCAL -= 10
;快感に素直
IF TALENT:攻め:快感応答 == -1
	LOCAL += 10
	;快感に素直
ELSEIF TALENT:攻め:快感応答 == 1
	LOCAL -= 5
ENDIF
SIF TALENT:攻め:献身的 && BASE:受け:気力 <= 0
	LOCAL /= 5
SIF TALENT:受け:サド
	LOCAL /= 2
RETURNF MAX(LOCAL, 0)

@引き抜き精力補正(ARG)
#FUNCTION
RETURNF MAX(MAXBASE:ARG:精力 - BASE:ARG:精力,1) * 50 / MAX(MAXBASE:ARG:精力,1) + 5
