@SHOW_JUEL

@SHOW_ABLUP_SELECT
#DIM ABL_INCREASING
#DIM C_ID
#DIM INSUFFICIENT_JUEL
#DIM INSUFFICIENT_EXP
#DIM INSUFFICIENT_QOL

FOR C_ID,0,CHARANUM
	FOR LOCAL:11,0,40
		SELECTCASE LOCAL:11
			;多くの要素が必要な能力から上げてゆく
			;自慰中毒
			CASE 0
				ABL_INCREASING= 30
			;膣射中毒
			CASE 1
				ABL_INCREASING= 34
			;肛射中毒
			CASE 2
				ABL_INCREASING= 35
			;精液中毒
			CASE 3
				ABL_INCREASING= 31
			;レズ中毒
			CASE 4
				ABL_INCREASING= 32
			;ゲイ中毒
			CASE 5
				ABL_INCREASING= 33
			;奉仕精神
			CASE 6
				ABL_INCREASING= 13
			;レズっ気
			CASE 7
				ABL_INCREASING= 17
			;ホモっ気
			CASE 8
				ABL_INCREASING= 18
			;マゾっ気
			CASE 9
				ABL_INCREASING= 15
			;サドっ気
			CASE 10
				ABL_INCREASING= 16
			;露出癖
			CASE 11
				ABL_INCREASING= 14
			;親密
			CASE 12
				ABL_INCREASING= 9
			;従順
			CASE 13
				ABL_INCREASING= 10
			;欲望
			CASE 14
				ABL_INCREASING= 11
			;技巧
			CASE 15
				ABL_INCREASING= 12
			;Ｃ感覚
			CASE 16
				ABL_INCREASING= 0
			;Ｖ感覚
			CASE 17
				ABL_INCREASING= 1
			;Ａ感覚
			CASE 18
				ABL_INCREASING= 2
			;Ｂ感覚
			CASE 19
				ABL_INCREASING= 3
			;Ｍ感覚
			CASE 20
				ABL_INCREASING= 4
			;Wetting Addict
			CASE 22
				ABL_INCREASING= 36
			;u sense
			CASE 23
				ABL_INCREASING= 5
			;u creampie addict
			CASE 24
				ABL_INCREASING= 38
			;hypnosis addict
			CASE 25
				ABL_INCREASING= 39				
			;Scat Addict
			CASE 26
				ABL_INCREASING= 62
			;Urine Addict
			CASE 27
				ABL_INCREASING= 61
			;Messing Addict
			CASE 28
				ABL_INCREASING= 37
			;Diaper Attraction
			CASE 29
				ABL_INCREASING= 63
			CASEELSE
				CONTINUE
		ENDSELECT
		FOR LOCAL,0,4
			$AGAIN
			INSUFFICIENT_JUEL = 0
			INSUFFICIENT_EXP = 0
			INSUFFICIENT_QOL = 0
			SIF JUEL_DEMAND(ABL_INCREASING,LOCAL,0,C_ID) == -2
				BREAK
			SIF JUEL_DEMAND(ABL_INCREASING,LOCAL,0,C_ID) < 0
				CONTINUE
			;NAS: Max level of 500
			SIF ABL:(C_ID):(ABL_INCREASING) >= 500
				BREAK
			;必要な宝珠を探す
			FOR LOCAL:1,0,VARSIZE("JUEL")
				IF JUEL_DEMAND(ABL_INCREASING,LOCAL,LOCAL:1,C_ID) > 0
					IF JUEL:(C_ID):(LOCAL:1) < JUEL_DEMAND(ABL_INCREASING,LOCAL,LOCAL:1,C_ID)
						INSUFFICIENT_JUEL ++
						BREAK
					ENDIF
				ENDIF
			NEXT
			SIF INSUFFICIENT_JUEL
				CONTINUE
			;必要な経験を探す
			FOR LOCAL:1,0,VARSIZE("EXP")
				IF EXP_DEMAND(ABL_INCREASING,LOCAL,LOCAL:1,C_ID) > 0
					IF  EXP:(C_ID):(LOCAL:1) < EXP_DEMAND(ABL_INCREASING,LOCAL,LOCAL:1,C_ID)
						INSUFFICIENT_EXP ++
						BREAK
					ENDIF
				ENDIF
			NEXT
			SIF INSUFFICIENT_EXP
				CONTINUE
			;NAS Customs: QOL Demand
			FOR LOCAL:1,0,VARSIZE("Qol_Info_Count_Array")
				IF QOL_COUNT_DEMAND(ABL_INCREASING,LOCAL,LOCAL:1,C_ID) > 0
					IF Qol_Info_Count_Array:(C_ID):(LOCAL:1) < QOL_COUNT_DEMAND(ABL_INCREASING,LOCAL,LOCAL:1,C_ID)
						INSUFFICIENT_QOL ++
						BREAK
					ENDIF
				ENDIF
			NEXT
			SIF INSUFFICIENT_QOL
				CONTINUE
			FOR LOCAL:1,0,50
				JUEL:(C_ID):(LOCAL:1) -= JUEL_DEMAND(ABL_INCREASING,LOCAL,LOCAL:1,C_ID)
			NEXT
			;custom code
			IF !LOCAL:5
				PRINTFORM %CALLNAME:(C_ID),16,RIGHT% … 
				LOCAL:5 ++
			ELSE
				;18文字空白を挿入
				PRINTFORM %" "*20%
			ENDIF
			PRINTFORM %ABL_TR(ABL_INCREASING),18,RIGHT%LVUP
			PRINTFORM  (
			;成長前
			CALL PRINT_RANK(ABL:C_ID:ABL_INCREASING, "MAX_99")
			PRINTFORM {ABL:(C_ID):(ABL_INCREASING),2,RIGHT} → 
			;成長はここで
			ABL:(C_ID):(ABL_INCREASING) += 1
			;成長後
			CALL PRINT_RANK(ABL:C_ID:ABL_INCREASING, "MAX_99")
			PRINTFORMW {ABL:(C_ID):(ABL_INCREASING),2,RIGHT}) 
			;BREAK
			GOTO AGAIN
		NEXT
	NEXT
	;値の初期化
	LOCAL:5 = 0
NEXT
IF benchMarkStart && !ISSKIP()
CALL BENCHMARK_ADVANCE_STAGE
ENDIF
PRINT [100] - Confirm

@USERABLUP
IF RESULT == 100
	CALL JUJUN_UP_CHECK
	CALL YOKUBO_UP_CHECK
	BEGIN TURNEND
	RETURN 1
ENDIF
RETURN 0

;ABLの上限
@MAXABL(ARG)
;恋慕はMAXLV99
IF ABL:ARG >= 99
	PRINTW 既にMAXです
	RETURN 1
ELSEIF ABL:ARG >= 5 && !TALENT:恋慕
	PRINTW 既にMAXです
	RETURN 1
ENDIF
RETURN 0
