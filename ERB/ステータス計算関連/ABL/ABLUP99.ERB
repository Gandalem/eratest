; Modular ERB: ABL/ABLUP99.ERB
;屈服刻印を消してみるテスト
;使う場合は↓をABL.ERBの「PRINTL [100] 能力値アップの終了」の前に挿入すること
;PRINTFORML [99]%MARKNAME:3%-{MARK:3}LV
;
;TRACHECK.ERBも弄ると再度屈服刻印が付いたりしないので吉
;●改変前
;IF A >= 500 && A < 1200 && MARK:3 <= 0
;	MARK:3 = 1
;●改変後
;IF A >= 500 && A < 1200 && MARK:4 <= 0
;	MARK:3 = 1
;	MARK:4 = 1
;●以上の内容を3LVの3箇所にすること
;上記の解らないor解ってもやらない場合に再度屈服刻印付いた場合の弊害は保証しかねます

@ISABLUP99
IF MARK:反発刻印 <= 0
	RETURN 0
ENDIF
CALL DECIDE_ABLUP99
IF Z == 0
	RETURN 0
ELSE
	RETURN 1
ENDIF

@ABLUP99
DRAWLINE
IF MARK:反発刻印 <= 0
	PRINTW 반발 각인은 없습니다
	RETURN 0
ENDIF
CALL DECIDE_ABLUP99
;反発刻印Lvと同じLvの屈服刻印が必要
PRINTS MARKNAME:2
PRINTV MARK:反発刻印
PRINTL 레벨 이상이고, 그리고
;反発刻印Lvと同じLvの従順が必要
PRINTS ABLNAME:0
PRINTV MARK:反発刻印
PRINTL 레벨 이상이고, 그리고
PRINTFORM [0] - %PALAMNAME:7%의 보주 × {A}…….
IF I == 0
	PRINT ＯＫ
ELSE
	SIF I & 1
		PRINT 보주 부족 
	SIF I & 2
		PRINT 각인 부족 
	SIF I & 4
		PRINT 능력 부족 
ENDIF
PRINTL 
PRINTL [100] 그만두다
INPUT
IF RESULT == 100
	RETURN 0
ELSE
	PRINTFORMW 그런 행동을 해버리는 아저씨가 옵니다.
	RETURN 0
ENDIF
MARK:3 -= 1
JUEL:7 -= A
PRINTS MARKNAME:3
PRINT 의 레벨이
PRINTV MARK:3
PRINTW ~가 되었다
;

@DECIDE_ABLUP99
;条件別にＯＫかダメかを記録する
I = 0
;能力アップ可能なら1にする
Z = 0
IF MARK:3 == 1
	A = 1000
ELSEIF MARK:3 == 2
	A = 3000
ELSEIF MARK:3 == 3
	A = 5000
ENDIF
;反発刻印Lvと同じLvの屈服刻印が必要
SIF MARK:3 > MARK:2
	I |= 2
;反発刻印Lvと同じLvの従順が必要
SIF MARK:3 > ABL:0
	I |= 4
;屈服の宝珠で減らす
SIF JUEL:7 < A
	I |= 1
IF I == 0
	Z = 1
ENDIF
