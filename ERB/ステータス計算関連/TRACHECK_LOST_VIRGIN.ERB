; Modular ERB: TRACHECK_LOST_VIRGIN.ERB
;FileName_TRACHECK.ERB ----------------------------- Rev1.00
;処女喪失時の処理
;CALL		USER
;ARG		0:キャラNO
;RETURN		VOID
;COMMENT
;-----------------------------------------------------------

@LOST_VIRGIN(ARG)
#DIM DYNAMIC 喪失者No
#DIMS DYNAMIC 喪失者名
#DIM DYNAMIC 取得者No
#DIMS DYNAMIC 取得者名
#DIMS 修飾語
;Custom code, replaced function, this is practically hard coded to be third person, will be rewritten heavily
CALL LOST_VIRGIN_TR(ARG)
RETURN
;-------------------------------------------------
;処女喪失のチェック
;-------------------------------------------------
IF TALENT:ARG:処女 == 1 && EXP_UP(1,ARG) > 0 && !TFLAG:2 && GETBIT(TALENT:ARG:性別,0) ;まずＶがないと！みんな有るけど…念の為。
	修飾語 = ""
	IF ARG == MASTER
		CFLAG:ARG:処女喪失相手 = TARGET
		喪失者No = MASTER
		喪失者名 = %CALLNAME:MASTER%
		取得者No = MASTER_POSE(SET_P,SET_V)
		;Ｐ以外で喪失した場合、MASTER_POSE(SET_P,SET_V)は0となり、結果的に取得者名まであなたになってしまう
		;よって取得者No=0ならTARGETを代入
		SIF !取得者No
			取得者No = TARGET
		取得者名 = %CALLNAME:取得者No%
	ELSE
		CFLAG:ARG:処女喪失相手 = PLAYER
		喪失者名 = %CALLNAME:ARG%
		喪失者No = ARG
		取得者名 = %CALLNAME:MASTER%
		取得者No = MASTER
	ENDIF
	IF ARG != MASTER
		;貞操観念
		IF TALENT:ARG:貞操 > 0
			IF !TALENT:ARG:恋慕
				TIMES SOURCE:ARG:情愛 , 0.60
				TIMES SOURCE:ARG:反感 , 10.00
			ENDIF
			;貞操無頓着
		ELSEIF TALENT:ARG:貞操 < 0
			TIMES SOURCE:ARG:情愛 , 0.60
			TIMES SOURCE:ARG:反感 , 0.50
		ELSEIF TALENT:ARG:SexKnow == -1
			TIMES SOURCE:ARG:情愛 , 0.30
			TIMES SOURCE:ARG:反感 , 0.75
			SOURCE:ARG:恐怖 += 3000
		ENDIF
		IF CFLAG:ARG:うふふ == 2
			TIMES SOURCE:ARG:情愛 , 1.50
			TIMES SOURCE:ARG:反感 , 0.25
		ENDIF
	ENDIF
	SETCOLOR 247,171,166
	PRINTFORMW 【처녀 상실】
	IF TEQUIP:ARG:50 == MASTER && GROUPMATCH(TALENT:MASTER:形状,5,6)
		PRINTFORMW %取得者名%의 흉악한 성기가, %喪失者名%의 순결을 가차 없이 갈기갈겼다…….
		TIMES SOURCE:ARG:苦痛, 3.00
		TIMES SOURCE:ARG:恐怖, 3.00
	ENDIF
	IF FLAG:70
		IF ARG == MASTER
			PRINTFORMW %取得者名%은 의식이 없는 채, \@ TALENT:ARG:行きずり == 1 ? 막 만난 #  \@%喪失者名%의 처녀를 빼앗겼다……
		ELSE
			PRINTFORMW %喪失者名%은 의식이 없는 채, \@ TALENT:ARG:行きずり == 1 ? 막 만난 #  \@%取得者名%에게 처녀를 빼앗겼다……
		ENDIF
	ELSE
		;陥落素質による処理
		;MASTER喪失
		IF ARG == MASTER
			IF TCVAR:TARGET:泥酔
				PRINTFORMW 혼탁한 채로 %取得者名%는, %喪失者名%의 처녀를 빼앗겼다……
				;睡眠姦、お前がパパになるんだよ！
			ELSEIF CFLAG:TARGET:睡眠
				PRINTFORMW 잠들어 있는 %取得者名%는, %喪失者名%에게 강제로 처녀를 빼앗겼다
				;無知ふたろり（ショタ）で処女喪失とか最高……いや、再考
			ELSEIF TALENT:TARGET:無知
				;IF GROUPMATCH(TALENT:MASTER:形状,5,6)
				;無知な相手のちんちんが入ってる場合
				IF TEQUIP:MASTER:50 == 取得者No
					PRINTFORMW 성지식이 부족한 %取得者名%은(는) 무엇을 당했는지 모르고, \@ TALENT:取得者No:2 & 2 ? 강렬한 쾌감과 #  \@%喪失者名%이 흘리는 피에 떨고 있다……
					;ちんちん以外
				ELSE
					PRINTFORMW 파괴된 혈을 본 %取得者名%은(는) 자신이 %喪失者名%에게 상처를 입혔다고 생각하며 허둥대고 있다.
				ENDIF
				PRINTFORMW %喪失者名%은 파과(破瓜)의 통증을 음미하며 %取得者名%를 진정시켰다.
				;素質恋人
			ELSEIF TALENT:TARGET:恋人  || TALENT:TARGET:恋慕 > 1
				PRINTFORMW %取得者名%은(는) 황홀한 표정으로, %喪失者名%의 비밀스러운 곳에서 흘러나오는 선혈을 바라보고 있다……
				TFLAG:150 = 2
				TIMES SOURCE:TARGET:情愛 , 3.00
				TIMES SOURCE:TARGET:反感 , 0.10
				;恋慕
			ELSEIF TALENT:TARGET:恋慕
				PRINTFORMW %取得者名%은 기쁜 미소를 지으며, 처녀를 바친 %喪失者名%을 바라보고 있다…….
				TFLAG:150 = 2
				TIMES SOURCE:TARGET:情愛 , 2.00
				TIMES SOURCE:TARGET:反感 , 0.30
				EXP:TARGET:愛情経験 += 30
				CFLAG:ARG:処女喪失対象 |= 喪失_恋慕
			ELSEIF TALENT:TARGET:思慕
				IF TCVAR:TARGET:無理矢理 == 1
					PRINTFORMW %取得者名%은(는) 쾌감에 당황하며, %喪失者名%에게 눈물에 젖은 눈동자를 향한다...
					TIMES SOURCE:TARGET:情愛 , 0.80
					TIMES SOURCE:TARGET:反感 , 1.50
					CFLAG:ARG:処女喪失対象 |= 喪失_無理矢理
				ELSEIF TALENT:TARGET:貞操 >= 0
					PRINTFORMW %取得者名%은(는) 당황하면서도 어딘가 기쁜 듯이 %喪失者名%을 바라보고 있다.
					TIMES SOURCE:TARGET:情愛 , 1.30
					TIMES SOURCE:TARGET:反感 , 0.50
				ENDIF
				CFLAG:ARG:処女喪失対象 |= 喪失_思慕
			ELSE
				IF TCVAR:TARGET:無理矢理 == 1
					TIMES SOURCE:TARGET:情愛 , 0.10
					TIMES SOURCE:TARGET:反感 , 3.00
					PRINTFORMW %取得者名%은 분노와 당혹감을 드러내며 %喪失者名%을 노려보았다...
					CFLAG:ARG:処女喪失対象 |= 喪失_無理矢理
				ELSE
					PRINTFORMW %取得者名%은(는) 무언가 말하고 싶다는 표정을 지으며, %喪失者名%과의 결합부를 응시하고 있다.
				ENDIF
			ENDIF
			;MASTERがTARGETの膣に挿入している
		ELSEIF TEQUIP:ARG:50 == MASTER
			IF TCVAR:ARG:泥酔
				PRINTFORMW %喪失者名%은 혼탁한 의식 속에서 처녀를 빼앗겼다……
				;睡眠姦　良い子は眠っている間にママにしちゃおうね～
			ELSEIF CFLAG:ARG:睡眠
				PRINTFORMW %喪失者名%의 처음은 자는 사이에 빼앗겨 버렸다……
			ELSEIF TALENT:ARG:無知
				PRINTFORMW 성지식이 부족한 %喪失者名%은(는) \@ TCVAR:ARG:誤爆挿入フラグ ? 무슨 일이 일어났는지 # 무엇을 당했는지 \@ 모르고, 처녀 상실의 고통에 당황하며 떨고 있다...
				PRINTFORMW %取得者名%은(%喪失者名%)을 진정시켰다
				;親愛かつ相手が主人(現在親愛がないので、恋人で代用
			ELSEIF TALENT:ARG:恋人 || TALENT:ARG:恋慕 > 1
				SIF TCVAR:ARG:誤爆挿入フラグ
					PRINT 계기는 사고라고는 하지만,
				PRINTFORMW %喪失者名%는 %取得者名%가 첫 상대라는 사실에 더할 나위 없이 행복해하는 것 같다……
				TFLAG:150 = 2
				TIMES SOURCE:ARG:情愛 , 3.00
				TIMES SOURCE:ARG:反感 , 0.10
				CFLAG:ARG:処女喪失対象 |= 喪失_恋慕
				;恋慕かつ相手が主人
			ELSEIF TALENT:ARG:恋慕
				SIF TCVAR:ARG:誤爆挿入フラグ
					PRINT 계기는 사고라고는 해도,
				PRINTFORMW %喪失者名%은(는) %取得者名%에게 처녀를 바쳐진 것에 행복을 느끼고 있는 것 같다...
				TFLAG:150 = 2
				TIMES SOURCE:ARG:情愛 , 2.00
				TIMES SOURCE:ARG:反感 , 0.30
				EXP:ARG:愛情経験 += 30
				CFLAG:ARG:処女喪失対象 |= 喪失_恋慕
			ELSEIF TALENT:ARG:思慕
				IF TCVAR:ARG:無理矢理 == 1
					PRINTFORMW 호의를 갖고 있던 상대에게 배신당한 %喪失者名%는, 커다란 눈물을 흘리기 시작했다……
					TIMES SOURCE:ARG:情愛 , 0.80
					TIMES SOURCE:ARG:反感 , 1.50
					CFLAG:ARG:処女喪失対象 |= 喪失_無理矢理
				ELSEIF TCVAR:ARG:誤爆挿入フラグ
					PRINTFORMW 호의를 가지고 있었다고는 해도, %喪失者名%은(는) %取得者名%에게 사고로 정조를 바친 것을 조금 후회했다...
					TIMES SOURCE:ARG:情愛 , 1.30
					TIMES SOURCE:ARG:反感 , 0.80
				ELSEIF TALENT:ARG:貞操 >= 0
					PRINTFORMW 호의를 가지고 있었다고는 해도, %喪失者名%은(는) %取得者名%에게 정조까지 허락해버린 것에 당황하고 있다……
					TIMES SOURCE:ARG:情愛 , 1.30
					TIMES SOURCE:ARG:反感 , 0.80
				ENDIF
				CFLAG:ARG:処女喪失対象 |= 喪失_思慕
			ELSE
				IF TCVAR:ARG:無理矢理 == 1
					TIMES SOURCE:ARG:情愛 , 0.10
					TIMES SOURCE:ARG:反感 , 3.00
					IF CFLAG:ARG:負け犬
						PRINTFORMW %喪失者名%은 패배의 대가로, %取得者名%에게 처녀를 빼앗겼다……
					ELSE
						PRINTFORMW %喪失者名%의 저항은 허사였고, %取得者名%에게 처녀를 빼앗겨 버렸다...
					ENDIF
					CFLAG:ARG:処女喪失対象 |= 喪失_無理矢理
					IF TALENT:ARG:行きずり == 1
						CSTR:ARG:モブ子プロフィール２ = %REPLACE(@"%CSTR:ARG:モブ子プロフィール２%","され今はもう大人しい","され、処女を奪われた")%
						CSTR:ARG:モブ子プロフィール２ = %REPLACE(@"%CSTR:ARG:モブ子プロフィール２%","アナル処女を奪われた","処女を奪われた")%
					ENDIF
				ELSEIF TALENT:ARG:行きずり == 1
					PRINTFORMW 비밀스러운 곳에서 새어 나오는 피를 본 %喪失者名%는, 만난 지 얼마 안 된 %取得者名%에게 처녀를 바쳤다는 것을 깨닫고 약간 후회했다……
				ELSEIF TCVAR:ARG:誤爆挿入フラグ
					PRINTFORMW %喪失者名%은 실수로 %取得者名%에게 처녀를 바쳐버렸다...
				ELSE
					PRINTFORMW %喪失者名%은 흘러가는 대로 %取得者名%에게 처녀를 빼앗겼다...
				ENDIF
			ENDIF
		ENDIF
	ENDIF
	IF CSTR:ARG:処女喪失履歴 == ""
		IF GROUPMATCH(TCVAR:喪失者No:カウンター行動, 80, 83, 85)
			CALL SET_HISTORY_LOST_V(喪失者No, 取得者No, "ペニス")
		ELSEIF TCVAR:取得者No:カウンター行動 == 57
			CALL SET_HISTORY_LOST_V(喪失者No, 取得者No, "指")
		ELSEIF SELECTCOM == 44
			CALL SET_HISTORY_LOST_V(喪失者No, 取得者No, "バイブ")
		ELSE
			CALL SET_HISTORY_LOST_V(喪失者No, 取得者No, "ペニス")
		ENDIF
	ENDIF
ENDIF
RESETCOLOR
;-------------------------------------------------
;再生処女喪失のチェック
;-------------------------------------------------
IF TALENT:ARG:処女 == 2 && EXP_UP(1,ARG)
	TCVAR:ARG:破瓜 = 2
	;ビデオ撮影
	IF TEQUIP:28
		;性交
		IF TEQUIP:ARG:50
			LOCALS = LV1/
		ELSEIF TEQUIP:ARG:13
			LOCALS = LV3/
			;その他
		ELSE
			LOCALS = LV4/
		ENDIF
		TSTR:1 += LOCALS
	ENDIF
	PRINTW 재생 처녀 상실
ENDIF
;-------------------------------------------------
;無自覚処女喪失のチェック
;-------------------------------------------------
IF TALENT:ARG:処女 == -1 && EXP_UP(1,ARG) && CFLAG:ARG:292 == 1 && !FLAG:70 && !TCVAR:ARG:泥酔 && !CFLAG:MASTER:イタズラ
	TCVAR:ARG:破瓜 = -1
	CFLAG:ARG:292 = 0
	PRINTW 처녀 상실?
	SETCOLOR 247,171,166
	PRINTFORMW %CALLNAME:ARG%는 고통인 듯한 고통을 느끼지 못한 것에 당황하고 있다...
	RESETCOLOR
ENDIF

@童貞キス未経験喪失(ARG)
#DIM シチュエーション
;シチュエーション	 0:通常
;					 1:デート帰り
;					 2:オナバレ
;					 4:ペニスに
;					 8:自発的に
;					16:無自覚
;					32:買春
シチュエーション = 0
SIF TCVAR:ARG:906
	RETURN -1
;anti-delusion failsafe
SIF TFLAG:妄想中 && ARG == MASTER
	RETURN 0
VARSET LOCALS
FONTBOLD
SETCOLOR 255,100,255
IF !TALENT:ARG:非童貞 && TALENT:ARG:性別 & 2
	IF TCVAR:ARG:童貞喪失 == 1
		;custom code
		CALL SET_HISTORY_LOST_DT(ARG, ARG == MASTER ? TARGET # MASTER)
		PRINTFORMW 비동정 상태 상실(%CALLNAME:ARG%)
		TALENT:ARG:非童貞 = 1
	ENDIF
ENDIF
;キス未経験喪失
IF ARG == MASTER && TALENT:ARG:キス未経験 && GROUPMATCH(SELECTCOM,2,20,312)
	シチュエーション |= 8
	IF GROUPMATCH(SELECTCOM,20,312) && (TFLAG:193 != 99 && PREVCOM != 309)
		CALL SET_FIRSTKISS(MASTER, ARG, シチュエーション)
	ELSEIF GROUPMATCH(SELECTCOM,2) && TALENT:TARGET:性別 & 2
		シチュエーション |= 4
		CALL SET_FIRSTKISS(ARG, TARGET, シチュエーション)
	ENDIF
ELSEIF TALENT:MASTER:キス未経験 && GROUPMATCH(TCVAR:ARG:カウンター行動,30,39,60,71,91)
	IF GROUPMATCH(TCVAR:ARG:カウンター行動,30,39,60)
		CALL SET_FIRSTKISS(MASTER, ARG, シチュエーション)
	ELSEIF GROUPMATCH(TCVAR:ARG:カウンター行動,71,91) && TALENT:ARG:性別 & 2
		シチュエーション |= 4
		CALL SET_FIRSTKISS(MASTER, ARG, シチュエーション)
	ENDIF
ENDIF
IF TALENT:ARG:キス未経験 && (TCVAR:ARG:ＦＫ喪失 || GROUPMATCH(TCVAR:ARG:カウンター行動,30,39,60,51))
	;無自覚
	SIF CFLAG:ARG:睡眠 || FLAG:70
		シチュエーション |= 16
	;自発的に
	SIF GROUPMATCH(TCVAR:ARG:カウンター行動,30,39,60,51)
		シチュエーション |= 8
	;ペニスに
	SIF TCVAR:ARG:ＦＫ喪失 == 2 || GROUPMATCH(TCVAR:ARG:カウンター行動,51)
		シチュエーション |= 4
	IF GROUPMATCH(SELECTCOM,20,312) && (TFLAG:193 != 99 && PREVCOM != 309)
		;デコチューを除外する
		CALL SET_FIRSTKISS(ARG, MASTER, シチュエーション)
	ELSEIF GROUPMATCH(SELECTCOM,81,88,140,337) || GROUPMATCH(TCVAR:ARG:カウンター行動,30,60,51)
		CALL SET_FIRSTKISS(ARG, MASTER, シチュエーション)
	ELSEIF TCVAR:ARG:カウンター行動 == 39
		CALL SET_FIRSTKISS(ARG, MASTER, シチュエーション, "飴と一緒に")
	ENDIF
ENDIF
;アナル処女喪失
IF CFLAG:ARG:アナル処女喪失対象 & 喪失_時間停止 || !CFLAG:ARG:アナル処女喪失記念日
	IF TCVAR:ARG:Ａ喪失発生
		;時間停止中に経験済み
		IF !FLAG:70 && ARG && CFLAG:ARG:アナル処女喪失対象 & 喪失_時間停止
			SIF FIRSTTIME("Ａ破瓜",0)
				CALL PRINT_STRL(@"HEX{C_DIM_PINK}항문 처녀성 상실? (%CALLNAME:ARG%)")
			TCVAR:ARG:Ａ破瓜 = -1
			;完全に初めて
		ELSEIF !CFLAG:ARG:アナル処女喪失記念日
			CALL PRINT_STRW(@"BOLDHEX{C_DIM_PINK}항문 처녀성 상실 (%CALLNAME:ARG%)")
			IF CSTR:ARG:モブ子プロフィール２ != ""
				CSTR:ARG:モブ子プロフィール２ = %REPLACE(@"%CSTR:ARG:モブ子プロフィール２%","され今はもう大人しい","され、アナル処女を奪われた")%
			ENDIF
			IF SELECTCOM == 45 || SELECTCOM == 745
				LOCALS = アナルバイブ
			ELSEIF SELECTCOM == 46
				LOCALS = アナルビーズ
			ELSE
				LOCALS = ペニス
			ENDIF
			IF !FLAG:70
				TCVAR:ARG:Ａ破瓜 = 1
			ELSE
				TCVAR:ARG:Ａ破瓜 = 2 ;bug fix
			ENDIF
			IF ARG == TARGET || (CFLAG:MASTER:うふふ == 2 && ARG != TARGET && ARG != MASTER)
				CALL SET_HISTORY_LOST_A(ARG, PLAYER, @"%LOCALS%")
			ELSE
				CALL SET_HISTORY_LOST_A(ARG, TARGET, @"%LOCALS%")
			ENDIF
		ENDIF
	ENDIF
ENDIF
;custom code
IF CFLAG:ARG:LostVirginUObject & 喪失_時間停止 || !CFLAG:ARG:LostVirginUDay
	IF TCVAR:ARG:LostVirginU
		;時間停止中に経験済み
		IF !FLAG:70 && ARG && CFLAG:ARG:LostVirginUObject & 喪失_時間停止
			SIF FIRSTTIME("UHaka",0)
				CALL PRINT_STRW(@"볼드헥스{C_DIM_PINK}요도 처녀성 상실 (%CALLNAME:ARG%)")
			TCVAR:ARG:UHaka = -1
			;完全に初めて
		ELSEIF !CFLAG:ARG:LostVirginUDay
			CALL PRINT_STRW(@"BOLDHEX{C_DIM_PINK}요도처녀성 상실(%CALLNAME:ARG%)")
			IF SELECTCOM == 163
				LOCALS = UrethralSound
			ELSE
				LOCALS = ペニス
			ENDIF
			IF !FLAG:70
				TCVAR:ARG:UHaka = 1
			ELSE
				TCVAR:ARG:UHaka = 2 ;bug fix
			ENDIF
			IF ARG == TARGET || (CFLAG:MASTER:うふふ == 2 && ARG != TARGET && ARG != MASTER)
				CALL SET_HISTORY_LOST_U(ARG, PLAYER, @"%LOCALS%")
			ELSE
				CALL SET_HISTORY_LOST_U(ARG, TARGET, @"%LOCALS%")
			ENDIF
		ENDIF
	ENDIF
ENDIF
FONTREGULAR
