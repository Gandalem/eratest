@LOST_VIRGIN_STOP(ARG)
SIF !SHIRAHU(ARG)
	RETURN
SIF ARG == MASTER
	RETURN
SIF ISSKIP()
	SKIPDISP 0
IF CFLAG:ARG:破瓜キャンセル口上有
	;口上側から干渉可能に
	CALL SET_KOJO_COLOR(ARG) ;custom code
	CALL KOJO_MESSAGE_SEND("LOST_VIRGIN_STOP", 0, ARG)
	IF RESULT == 1
		RETURN -1
	ELSE
		RETURN 0
	ENDIF
	RESETCOLOR
ELSEIF TALENT:ARG:SexKnow > -1 && !TALENT:ARG:恋慕 && !TALENT:ARG:愛欲 && !TALENT:ARG:恋人 && !TCVAR:ARG:待たぬ && !CFLAG:イタズラ
	;貞操観念持ちor貞操普通かつ思慕なし
	IF TALENT:ARG:貞操 > 0 || (!TALENT:ARG:貞操 && !TALENT:ARG:思慕)
		PRINTFORMW %CALLNAME:ARG%는 %HE_SHE(TARGET)%가 기다리고 싶다고 말한다.
		IF (EXP:ARG:60 + EXP:ARG:61 + EXP:ARG:62 + EXP:ARG:63 + EXP:ARG:64) == 0
			IF TALENT:ARG:貞操 > 0
				PRINTFORMW 그리고 %HE_SHE(ARG)%는 힘든 싸움을 하고 있다...
			ELSE
				PRINTFORMW 그리고 %HE_SHE(ARG)%은 놀라울 정도로 힘든 저항을 하고 있다...
			ENDIF
		ELSE
			PRINTFORMW 참 귀찮게...
		ENDIF
		CALL ASK_YN("포기해라","밀어 넣어라")
		IF RESULT == 1
			IF TALENT:ARG:貞操 > 0 && ABL:ARG:Melee > ABL:MASTER:Melee && !TCVAR:ARG:無理矢理
				PRINTFORMW 당신은 조금 눌러보지만 %CALLNAME:ARG%이(가) 너무 강하게 저항해서 포기한다.
				;bug fix
				RETURN -1
			ELSEIF TCVAR:ARG:無理矢理
				;NAS: Conscious Rape
				PRINTFORMW 눈물이 %HIS_HER(TARGET)%의 눈에서 흘러내린다. %HE_SHE(TARGET)%는 아무것도 할 수 없이 %HIS_HER(TARGET)%의 순결을 빼앗기는 것뿐이다...
				TCVAR:ARG:待たぬ = 1
				RETURN 0
			ELSEIF TALENT:ARG:貞操 > 0 && TCVAR:Common_Sense_Alteration_Status <= 75 && FLAG:催眠強度 <= 75 ;hypnosis patch
				PRINTFORMW %CALLNAME:ARG%은 %HIS_HER(TARGET)% 눈에 눈물이 고이고 있고, %HE_SHE(TARGET)%은 거절했다.
				PRINTFORML [0] %HE_SHE(TARGET)%이 정말로 그것을 싫어하는 것 같으니 포기해라.
				SIF GETBIT(nRape,3)
					PRINTFORML [1] 해라 (강간이 시작될 것이다)
				INPUT
				IF !RESULT
					PRINTFORMW %CALLNAME:ARG%는 안심한다...
					PRINTFORMW 너는 조금 다쳤다...
					;bug fix
					RETURN -1
				ELSE
					PRINTFORMW 당신은 조금 저항하며 %CALLNAME:ARG%를 밀어 넘긴다...
					TCVAR:ARG:待たぬ = 1
					TCVAR:ARG:無理矢理 = 1
					RETURN 0
				ENDIF
			ELSE
				PRINTFORMW 당신은 재빠른 말솜씨로 %HIM_HER(ARG)%을 설득하는 데 성공한다...
				TCVAR:ARG:待たぬ = 1
				RETURN 0
			ENDIF
		ELSE
			PRINTFORMW %CALLNAME:ARG%는 안심한다...
			RETURN -1
		ENDIF
	ENDIF
ENDIF

@SET_FIRSTKISS(ARG, キス相手, シチュエーション, 修飾語)
#DIM キス相手
;シチュエーション	 0:通常
;					 1:デート帰り
;					 2:オナバレ
;					 4:ペニスに
;					 8:自発的に
;					16:無自覚
;					32:買春
#DIM 無理矢理シチュ
#DIM シチュエーション
#DIMS 修飾語
#DIM 自分で
VARSET LOCALS
;Custom code, replaced function
CALL SET_FIRSTKISS_TR(ARG, キス相手, シチュエーション, 修飾語)
RETURN
自分で = 0
無理矢理シチュ = (TCVAR:ARG:無理矢理 && !(TALENT:ARG:愛欲 || TALENT:ARG:セフレ || TALENT:ARG:恋慕 || TALENT:ARG:思慕))
;無理矢理状態で、キス合意はつかない。無理矢理だから！！！唇を許すわけ無いでしょ！！　ただし、陥落素質があればギリギリセーフ。
;キス経験済み
IF TALENT:ARG:キス未経験 == 0
	RETURN
	;無自覚キス経験済み
ELSEIF TALENT:ARG:キス未経験 < 0
	;無自覚キス同士では重複しない
	SIF シチュエーション & 16
		RETURN
ENDIF
;FLAG:ＦＫ判定によっては帰る
SIF !(FLAG:ＦＫ判定 & 1) && シチュエーション & 16
	RETURN
SIF !(FLAG:ＦＫ判定 & 2) && シチュエーション & 4
	RETURN
IF ARG == キス相手
	IF ARG == MASTER
		キス相手 = TARGET
	ELSE
		キス相手 = MASTER
	ENDIF
ENDIF
SETCOLOR 247,171,166
PRINTFORM 키스 미경험 상실
SIF シチュエーション & 16
	PRINT ？
PRINTFORMW (%CALLNAME:ARG%)
RESETCOLOR
CFLAG:ARG:ファーストキス喪失記念日 = DAY
TALENT:ARG:キス未経験 = 0
CFLAG:ARG:ファーストキス喪失相手 = キス相手
;対象と修飾語決定
IF TALENT:ARG:思慕
	自分で = 1
	LOCALS:0 '= @"마음을 품고 있었다"
ELSEIF ARG == MASTER && TALENT:(キス相手):恋人
	自分で = 1
	LOCALS:0 '= @"사랑하는"
ELSEIF TALENT:ARG:恋人 || TALENT:ARG:恋慕
	自分で = 1
	LOCALS:0 '= @"사랑하는"
ENDIF
IF シチュエーション & 2
	IF ARG != MASTER
		LOCALS:2 '= @"자위하는 도중에 침입해 들어왔다."
	ELSE
		LOCALS:2 '= @"자위하고 있었다."
		自分で = 1
	ENDIF
ENDIF
IF シチュエーション & 4
	LOCALS:1 '= @"의 페니스"
	CFLAG:ARG:ファーストキス喪失対象 = 1
ENDIF
SIF シチュエーション & 8
	自分で = 1
IF シチュエーション & 16
	IF FLAG:70
		LOCALS:2 '= @"시간 정지 중에"
	ELSEIF CFLAG:ARG:睡眠
		LOCALS:2 '= @"자고 있는 사이에"
	ELSE
		LOCALS:2 '= @"나 자신도 알지 못하는 사이에"
	ENDIF
	CFLAG:ARG:ファーストキス喪失対象 = 2
	TALENT:ARG:キス未経験 = -1
ENDIF
SIF TALENT:ARG:SexKnow == -1 && シチュエーション & 4
	LOCALS:2 = %LOCALS:2%그 의미도 알 수 없는 채로
SIF 無理矢理シチュ
	LOCALS:2 = %LOCALS:2%억지로
;場所決定
IF シチュエーション & 1
	CSTR:ARG:ファーストキス位置 = デートからの帰り道
	SIF ARG != MASTER
		自分で = 1
ELSEIF シチュエーション & 2
	IF ARG != MASTER
		CSTR:ARG:ファーストキス位置 = 自室
	ELSE
		CSTR:ARG:ファーストキス位置 = %CALLNAME:キス相手%宅
	ENDIF
ELSE
	IF CHK_DATENOW(CFLAG:ARG:デート中) && CFLAG:ARG:現在位置 != OMANEKIBEYA()
		CSTR:ARG:ファーストキス位置 = %DATENAME_SPOT()%
	ELSEIF CHK_DATENOW(CFLAG:MASTER:デート中) && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
		CSTR:ARG:ファーストキス位置 = %DATENAME_PLACE()%の%DATENAME_SPOT()%
	ELSE
		CSTR:ARG:ファーストキス位置 = %NAME_FROM_PLACE(CFLAG:ARG:現在位置)%
	ENDIF
ENDIF
;動詞決定
IF 修飾語 == "飴と一緒に"
	LOCALS:1 += "와"
	LOCALS:3 '= @"나누었다"
ELSEIF 自分で
	LOCALS:1 += "에"
	LOCALS:3 '= @"바쳤다"
ELSEIF シチュエーション & 32
	LOCALS:1 += "에"
	LOCALS:3 '= @"빼앗겼다"
ELSE
	LOCALS:1 += "에"
	LOCALS:3 '= @"빼앗겼다"
ENDIF
IF CSTR:ARG:ファーストキス喪失履歴 == ""
	CSTR:ARG:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%、%CSTR:ARG:ファーストキス位置%で%LOCALS:2%%LOCALS:0%%CALLNAME:キス相手%%LOCALS:1%%修飾語%ファーストキスを%LOCALS:3%
ELSE
	;無自覚キスがある場合のみ重複する
	CSTR:ARG:ファーストキス喪失履歴 = %PRINT_DATE_F(DAY)%、%CSTR:ARG:ファーストキス位置%で%LOCALS:2%%LOCALS:0%%CALLNAME:キス相手%%LOCALS:1%%修飾語%ファーストキスを%LOCALS:3%￥ＢＲ%CSTR:ARG:ファーストキス喪失履歴%
ENDIF
;既成事実もつけておく
SIF ARG != MASTER && !(シチュエーション & 16) && !無理矢理シチュ
	SETBIT CFLAG:ARG:既成事実, 0
;愛情経験もここで入れることにする
SIF ARG != MASTER && !(シチュエーション & 16) && !無理矢理シチュ
	EXP:ARG:愛情経験 += 5
