@HISTORY_LOST_TEXT(ARG,相手,対象,場所,修飾語,喪失したもの)
#FUNCTIONS
#DIM 相手
#DIMS 対象
#DIMS 場所
#DIMS 修飾語
#DIMS 喪失したもの
#DIMS 状況
#DIM 自分で
;Custom code, replaced function
RETURNF HISTORY_LOST_TEXT_TR(ARG,相手,対象,場所,修飾語,喪失したもの)
VARSET LOCALS
自分で = 0
IF ARG == MASTER || (CFLAG:MASTER:うふふ != 2 && ARG != MASTER && ARG != TARGET)
	LOCALS:0 =
ELSEIF TALENT:ARG:思慕
	自分で = 1
	LOCALS:0 = 思いを寄せていた
ELSEIF TALENT:ARG:恋人 || TALENT:ARG:恋慕
	自分で = 1
	LOCALS:0 = 愛する
ELSEIF !CFLAG:ARG:面識 && ARG != MASTER
	LOCALS:0 = 見ず知らずの
ELSEIF TALENT:ARG:行きずり == 1
	LOCALS:0 = 初対面の
ENDIF
SIF !SHIRAHU(ARG)
	自分で = 0
SIF 対象 == ""
	対象 = ペニス
IF FLAG:70
	状況 = 時間停止中に
ELSEIF TCVAR:ARG:泥酔
	状況 = 酔いつぶれているときに
ELSEIF CFLAG:ARG:睡眠
	状況 = 眠っている間に
ELSEIF ARG != MASTER && ARG != TARGET && CFLAG:MASTER:うふふ != 2
	状況 = %CALLNAME:MASTER%の望みのままに
ELSE
	状況 =
ENDIF
SIF ARG == MASTER && TALENT:相手:SexKnow == -1
	状況 += "何もわかっていない"
IF 対象 == "ペニス"
	IF GETBIT(TALENT:相手:2,1)
		LOCALS:1 = %CALLNAME:相手%の%TINKO_SIMPLE(相手)%に
	ELSE
		LOCALS:1 = %CALLNAME:相手%にペニスバンドで
	ENDIF
ELSEIF 対象 == "指"
	LOCALS:1 = %CALLNAME:相手%の指に
ELSE
	LOCALS:1 = %CALLNAME:相手%に%対象%で
ENDIF
SIF 場所 == ""
	場所 = %PLACE_NAME(ARG)%
IF 修飾語 == ""  && SHIRAHU(ARG)
	IF TCVAR:ARG:無理矢理 && CFLAG:ARG:負け犬
		修飾語 = 敗北の代償として
		自分で = 0
	ELSEIF TCVAR:ARG:無理矢理
		修飾語 = 力ずくで
		自分で = 0
	ELSEIF TALENT:ARG:SexKnow == -1
		修飾語 = 何もわからないまま
		自分で = 0
	ELSEIF ARG != MASTER && ARG != TARGET && CFLAG:MASTER:うふふ != 2
		修飾語 = 不満を感じつつ
	ELSEIF TALENT:ARG:恋人
		修飾語 = 幸福感の中で
	ELSEIF CFLAG:ARG:うふふ == 2
		修飾語 = 自ら
		自分で = 1
	ENDIF
ENDIF
IF 自分で
	LOCALS:3 = 捧げた
ELSEIF ARG == MASTER || 修飾語 == "治療と称して"
	LOCALS:3 = 与えた
ELSEIF 修飾語 == "お金を払って"
	LOCALS:3 = 奪ってもらった
ELSE
	LOCALS:3 = 奪われた
ENDIF
LOCALS:10 = %PRINT_DATE_F(DAY)%、%状況%%場所%で%LOCALS:0%%LOCALS:1%%修飾語%%喪失したもの%を%LOCALS:3%
RETURNF LOCALS:10
