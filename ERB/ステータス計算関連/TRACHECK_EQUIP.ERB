
;-------------------------------------------------
;バイブなど付けっぱなしアイテムのチェック
;-------------------------------------------------
@EQUIP_CHECK(ARG)
;クリキャップ装着中
SIF TEQUIP:ARG:クリキャップ
	CALLFORM EQUIP_COM{COMクリキャップ}(ARG)

;オナホール装着中
SIF TEQUIP:ARG:オナホール
	CALLFORM EQUIP_COM{COMオナホール}(ARG)

;バイブ装着中
SIF TEQUIP:ARG:バイブ
	CALLFORM EQUIP_COM{COMバイブ}(ARG)

;アナルバイブ装着中
SIF TEQUIP:ARG:アナルバイブ
	CALLFORM EQUIP_COM{COMアナルバイブ}(ARG)

;アナルビーズ使用中
SIF TEQUIP:ARG:アナルビーズ
	CALLFORM EQUIP_COM{COMアナルビーズ}(ARG)

;ニプルキャップ装着中
SIF TEQUIP:ARG:ニプルキャップ
	CALLFORM EQUIP_COM{COMニプルキャップ}(ARG)

;搾乳器装着中
SIF TEQUIP:ARG:搾乳機
	CALLFORM EQUIP_COM{COM搾乳機}(ARG)

;アイマスク装着中
SIF TEQUIP:ARG:アイマスク
	CALLFORM EQUIP_COM{COMアイマスク}(ARG)

;縄で緊縛中
SIF TEQUIP:ARG:縄
	CALLFORM EQUIP_COM{COM縄}(ARG)

;ボールギャグ装着中
SIF TEQUIP:ARG:ボールギャグ
	CALLFORM EQUIP_COM{COMボールギャグ}(ARG)

;浣腸＋アナルプラグ装着中
SIF TEQUIP:ARG:浣腸
	CALLFORM EQUIP_COM{COM浣腸}(ARG)

;拡張バルーン装着中
SIF TEQUIP:ARG:拡張バルーン
	CALLFORM EQUIP_COM{COM拡張バルーン}(ARG)

;ビデオ撮影中
SIF ARG > 0 && TEQUIP:MASTER:ビデオ撮影
	CALLFORM EQUIP_COM{COMビデオ撮影}(ARG)

;羞恥プレイ中
;addition custom code, enable for shame play
SIF TEQUIP:ARG:30
	CALL EQUIP_COM186(ARG)

;お風呂場プレイ中
SIF TEQUIP:ARG:お風呂場プレイ
	CALLFORM EQUIP_COM{COMお風呂場プレイ}(ARG)

;シャワー使用中
SIF TEQUIP:ARG:シャワー
	CALLFORM EQUIP_COM{COMシャワー}(ARG)

;新妻プレイ中
SIF TEQUIP:ARG:新妻プレイ
	CALLFORM EQUIP_COM{COM新妻プレイ}(ARG)

;custom
SIF TEQUIP:ARG:UrethralSound
	CALLFORM ADD_CUSTOM_EQUIP_COM163(ARG)

;custom
SIF TEQUIP:ARG:EStimClit
	TRYCALLFORM ADD_CUSTOM_EQUIP_COM164(ARG)	

;custom
SIF TEQUIP:ARG:EStimVag
	TRYCALLFORM ADD_CUSTOM_EQUIP_COM165(ARG)	

;アナル電極装着中
SIF TEQUIP:ARG:アナル電極
	CALLFORM EQUIP_COM{COMアナル電極}(ARG)	

;custom
SIF TEQUIP:ARG:EStimNipples
	TRYCALLFORM ADD_CUSTOM_EQUIP_COM167(ARG)	
;custom
SIF TEQUIP:ARG:EStimMouth
	TRYCALLFORM ADD_CUSTOM_EQUIP_COM168(ARG)			

;custom
SIF TEQUIP:ARG:EStimUrethra
	TRYCALLFORM ADD_CUSTOM_EQUIP_COM169(ARG)		

	;custom
SIF TEQUIP:ARG:FaceSitting
	TRYCALLFORM ADD_CUSTOM_EQUIP_COM170(ARG)

;U sex
SIF TEQUIP:ARG:USex >= 0 && !SOURCE:ARG:UPleas
	CALL EQUIP_INCERT_U(ARG)

;Ｖ挿入中
SIF TEQUIP:ARG:50 >= 0 && !SOURCE:ARG:快Ｖ
	CALL EQUIP_INCERT_V(ARG)

;Ａ挿入中
SIF TEQUIP:ARG:51 >= 0 && !SOURCE:ARG:快Ａ
	CALL EQUIP_INCERT_A(ARG)

;qol custom code, double penetration
IF TEQUIP:ARG:50 >= 0 && TEQUIP:ARG:51 >= 0
	TCVAR:ARG:射精箇所 = 50
	SIF TEQUIP:ARG:50 == TEQUIP:ARG:51
		TCVAR:(TEQUIP:ARG:50):射精箇所 = 50
ENDIF

;相合い傘中
SIF TEQUIP:ARG:相合い傘 && OUTROOF(CFLAG:ARG:現在位置) && ARG == TARGET
	CALLFORM EQUIP_COM{COM相合い傘}(ARG)
RETURN 1
