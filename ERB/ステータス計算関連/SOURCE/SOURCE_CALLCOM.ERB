; Modular ERB: SOURCE/SOURCE_CALLCOM.ERB
;FileName_SOURCE_CALLCOM.ERB ----------------------- Rev1.00
;@COM呼出統括
;CALL		USER
;ARG		キャラNO
;RETURN		VOID
;COMMENT	@COMを呼び出す。コンボ発生判定もここ
;-----------------------------------------------------------

@CALL_COM(ARG)
;=== ウフフ系コンボ ===
;addition custom code, reworked checks
LOCAL = ADD_SCOM_CHECKS(ARG)
SIF LOCAL
	TFLAG:50 = LOCAL
;addition custom code
CALL Add_Custom_CALL_COM(ARG)
RESULT = 0
;bugfix custom code, disabled
; SIF TFLAG:前回のコマンド結果 <= 0
; 	TFLAG:50 = 0
IF TFLAG:50
	CALLFORM COM_ABLE{500 + TFLAG:50}
	IF RESULT
		TRYCALLFORM CAN_SCOM{TFLAG:50}(1)
		IF RESULT
			TRYCCALLFORM CAN_SCOM{TFLAG:50}
			CATCH
			;Custom code
			PRINTFORML %STR_TR(1500 + TFLAG:50)%
			ENDCATCH
			;Custom code
			IF TFLAG:50 == ADD_CUSTOM_SCOM
				STR:0 '= Add_Custom_SCOM_Name(ADD_SELECTED_SCOM)
			ELSE
				STR:0 = %STR_TR(1500 + TFLAG:50)%
			ENDIF
			TRYCALLFORM SCOM{TFLAG:50}
		ENDIF
	ENDIF
ENDIF
SIF RESULT
	RETURN RESULT
TFLAG:50 = 0
;LOCALS = %STR:(1000 + SELECTCOM)%
;LOCALS = %TRAINNAME:(SELECTCOM)%
;TRYCCALLFORM CAN_COM{SELECTCOM}
;CATCH
;	PRINTFORML %LOCALS%
;ENDCATCH
;kojo com
IF INRANGE(SELECTCOM, 270, 299)
	CALL KOJO_MESSAGE_SEND("COM", 0, TARGET, SELECTCOM - 270)
	LOCALS '= RESULTS
	CALLFORM CAN_COM{SELECTCOM}
	SIF RESULT == -1
		PRINTFORML %LOCALS%
ELSE
	;Custom code
	LOCALS = %TRAINNAME_TR(SELECTCOM)%
	;NAS: Non 0 MASTER
	TRYCCALLFORM CAN_COM{SELECTCOM}(TARGET != MASTER)
	CATCH
	PRINTFORML %LOCALS%
	ENDCATCH
ENDIF
;NAS: Reset stray SKIPDISPs
SKIPDISP 0
STR:0 = %LOCALS%
CALL KOJO_MESSAGE_SEND("SUCCESS",-1,TARGET,-1,-1)
TRYCALLFORM COM{SELECTCOM}
RETURN RESULT
