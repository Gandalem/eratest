;────────────────────────────────────
;絶頂系の処理など
;────────────────────────────────────
;-------------------------------------------------
;絶頂処理
;-------------------------------------------------
@ORGASM_ADD(ARG)
#DIM 合計絶頂数
#DIM 焦らし中
#DIM MultipleEc
#DIM Multiplier
#DIM PleasureRequired
#DIM RequredForMark

VARSET LOCAL
焦らし中 = 0
PleasureRequired = PleasureRequired(ARG)

SIF IsDead:ARG:0
	RETURN

LOCAL = ((CUP:ARG:快Ｃ + PALAM:ARG:快Ｃ) >= PleasureRequired) + (CUP:ARG:快Ｖ + PALAM:ARG:快Ｖ >= PleasureRequired) + (CUP:ARG:快Ａ + PALAM:ARG:快Ａ >= PleasureRequired) + (CUP:ARG:快Ｂ + PALAM:ARG:快Ｂ >= PleasureRequired) + (CUP:ARG:快Ｍ + PALAM:ARG:快Ｍ >= PleasureRequired) + (CUP:ARG:UPleas + PALAM:ARG:UPleas >= PleasureRequired)
SELECTCASE LOCAL
	CASE 6
		LOCAL:1 = 10000
	CASE 5
		LOCAL:1 = 5000
	CASE 4
		LOCAL:1 = 3000
	CASE 3
		LOCAL:1 = 2000
	CASE 2
		LOCAL:1 = 1500
	CASE 1
		LOCAL:1 = 1000
ENDSELECT

;視認性の問題で残しておく
C = 0
V = 0
A = 0
B = 0
M = 0
U = 0
;絶頂Ｃ
;うっかり絶頂
CALL 絶頂強度判定(ARG,0,LOCAL:1)
C = RESULT
;絶頂Ｖ
CALL 絶頂強度判定(ARG,1,LOCAL:1)
V = RESULT

;絶頂Ａ
CALL 絶頂強度判定(ARG,2,LOCAL:1)
A = RESULT

;絶頂Ｂ
CALL 絶頂強度判定(ARG,3,LOCAL:1)
B = RESULT
	
;絶頂Ｍ
CALL 絶頂強度判定(ARG,4,LOCAL:1)
M = RESULT

;絶頂Ｕ
CALL 絶頂強度判定(ARG,5,LOCAL:1)
U = RESULT
IF TEQUIP:ARG:焦らしモード || CFLAG:ARG:Hypno_Orgasm_Denial ;custom code
	IF 焦らし発生(ARG,C + V + A + B + M + U)
		EX:ARG:Ｃ寸止め += C
		EX:ARG:Ｖ寸止め += V
		EX:ARG:Ａ寸止め += A
		EX:ARG:Ｂ寸止め += B
		EX:ARG:Ｍ寸止め += M
		EX:ARG:UEdge += U
		TCVAR:ARG:焦らし回数 ++
		焦らし中 = 1
	ENDIF
ENDIF
SIF 焦らし中 || CFLAG:ARG:Hypno_Orgasm_Denial ;custom code
	GOTO JIRASI
IF CUP:ARG:快Ｃ
	C += EX:ARG:Ｃ寸止め
	EX:ARG:Ｃ寸止め = 0
ENDIF
IF CUP:ARG:快Ｖ
	V += EX:ARG:Ｖ寸止め
	EX:ARG:Ｖ寸止め = 0
ENDIF
IF CUP:ARG:快Ａ
	A += EX:ARG:Ａ寸止め
	EX:ARG:Ａ寸止め = 0
ENDIF
IF CUP:ARG:快Ｂ
	B += EX:ARG:Ｂ寸止め
	EX:ARG:Ｂ寸止め = 0
ENDIF
IF CUP:ARG:快Ｍ
	M += EX:ARG:Ｍ寸止め
	EX:ARG:Ｍ寸止め = 0
ENDIF
IF CUP:ARG:UPleas
	U += EX:ARG:UEdge
	EX:ARG:UEdge = 0
ENDIF
;-------------------------------------------------
;絶頂時の追加処理
;-------------------------------------------------
SIF FLAG:時間停止
	EX:ARG:時間停止TotalEX_TRACKER = EX:ARG:時間停止TotalEX_TRACKER + C + V + A + B + M + U
NOWEX:ARG:TotalEX = C + V + A + B + M  + U
EX:ARG:TotalEX += C + V + A + B + M + U ;com custom code
MultipleEc = MIN(C, 1) + MIN(V, 1) + MIN(A, 1) + MIN(B, 1) + MIN(M, 1) + MIN(U, 1) - 1
POWER Multiplier, 2, MultipleEc
;custom code, commented
;PRINTFORML {C + V + A + B + M + U} ec {MultipleEc} {Multiplier}
POWER Multiplier, 2, MultipleEc
IF C && V && A && B && M && U
	NOWEX:ARG:SextOrgasm = 1
ELSEIF C && V && A && B && M
	NOWEX:ARG:五重絶頂 = 1
ELSEIF V && A && B && M && U
	NOWEX:ARG:五重絶頂 = 2
ELSEIF C && A && B && M && U
	NOWEX:ARG:五重絶頂 = 3
ELSEIF C && V && B && M && U
	NOWEX:ARG:五重絶頂 = 4
ELSEIF C && V && A && B && U
	NOWEX:ARG:五重絶頂 = 5
ELSEIF C && V && A && B
	NOWEX:ARG:四重絶頂 = 1
ELSEIF C && V && A && M
	NOWEX:ARG:四重絶頂 = 2
ELSEIF C && V && B && M
	NOWEX:ARG:四重絶頂 = 3
ELSEIF C && A && B && M
	NOWEX:ARG:四重絶頂 = 4
ELSEIF V && A && B && M
	NOWEX:ARG:四重絶頂 = 5
ELSEIF U && V && A && B
	NOWEX:ARG:四重絶頂 = 6
ELSEIF U && V && A && M
	NOWEX:ARG:四重絶頂 = 7
ELSEIF C && U && B && M
	NOWEX:ARG:四重絶頂 = 8
ELSEIF C && A && U && M
	NOWEX:ARG:四重絶頂 = 9
ELSEIF V && A && B && U
	NOWEX:ARG:四重絶頂 = 10
ELSEIF C && V && A && U
	NOWEX:ARG:四重絶頂 = 11
ELSEIF C && V && M && U
	NOWEX:ARG:四重絶頂 = 12
ELSEIF C && V && A
	NOWEX:ARG:三重絶頂 = 1
ELSEIF B && V && A
	NOWEX:ARG:三重絶頂 = 2
ELSEIF C && B && A
	NOWEX:ARG:三重絶頂 = 3
ELSEIF C && V && B
	NOWEX:ARG:三重絶頂 = 4
ELSEIF C && V && M
	NOWEX:ARG:三重絶頂 = 5
ELSEIF B && V && M
	NOWEX:ARG:三重絶頂 = 6
ELSEIF A && V && M
	NOWEX:ARG:三重絶頂 = 7
ELSEIF B && C && M
	NOWEX:ARG:三重絶頂 = 8
ELSEIF A && B && M
	NOWEX:ARG:三重絶頂 = 9
ELSEIF C && A && M
	NOWEX:ARG:三重絶頂 = 10
ELSEIF B && V && U
	NOWEX:ARG:三重絶頂 = 11
ELSEIF A && V && U
	NOWEX:ARG:三重絶頂 = 12
ELSEIF B && C && U
	NOWEX:ARG:三重絶頂 = 13
ELSEIF A && B && U
	NOWEX:ARG:三重絶頂 = 14
ELSEIF C && A && U
	NOWEX:ARG:三重絶頂 = 15
ELSEIF V && M && U
	NOWEX:ARG:三重絶頂 = 16
ELSEIF B && M && U
	NOWEX:ARG:三重絶頂 = 17
ELSEIF A && M && U
	NOWEX:ARG:三重絶頂 = 18
ELSEIF C && V
	NOWEX:ARG:二重絶頂 = 1
ELSEIF C && A
	NOWEX:ARG:二重絶頂 = 2
ELSEIF V && A
	NOWEX:ARG:二重絶頂 = 3
ELSEIF C && B
	NOWEX:ARG:二重絶頂 = 4
ELSEIF V && B
	NOWEX:ARG:二重絶頂 = 5
ELSEIF A && B
	NOWEX:ARG:二重絶頂 = 6
ELSEIF A && M
	NOWEX:ARG:二重絶頂 = 7
ELSEIF V && M
	NOWEX:ARG:二重絶頂 = 8
ELSEIF C && M
	NOWEX:ARG:二重絶頂 = 9
ELSEIF B && M
	NOWEX:ARG:二重絶頂 = 10
ELSEIF A && U
	NOWEX:ARG:二重絶頂 = 11
ELSEIF V && U
	NOWEX:ARG:二重絶頂 = 12
ELSEIF C && U
	NOWEX:ARG:二重絶頂 = 13
ELSEIF B && U
	NOWEX:ARG:二重絶頂 = 14
ELSEIF M && U
	NOWEX:ARG:二重絶頂 = 15
ENDIF
C *= Multiplier
V *= Multiplier
A *= Multiplier
B *= Multiplier
M *= Multiplier
U *= Multiplier

IF (C + V + A + B + M + U) > LIMIT(OrgasmDeny:ARG:0,0,5)
	TCVAR:ARG:焦らし回数 = 0
	TEQUIP:ARG:焦らしモード = 0
ENDIF
合計絶頂数 = C + V + A + B + M + U
;時姦刻印
IF FLAG:70 && ARG != MASTER
	FOR LOCAL, 5, 0, -1
		IF 合計絶頂数 >= TSPRapeMarkThreshold:LOCAL && MARK:ARG:時姦刻印 < LOCAL
			TCVAR:ARG:時姦刻印取得用 = LOCAL
			BREAK
		ENDIF
	NEXT
ELSE
;快楽刻印の処理
;絶頂の部位と強度の合計が一定以上で刻印を取得する
;合計絶頂数が8以上で快楽刻印３に相当
	FOR LOCAL, 5, 0, -1
		IF 合計絶頂数 >= PleasureMarkThreshold:LOCAL && MARK:ARG:快楽刻印 < LOCAL
			TCVAR:ARG:快楽強度 = LOCAL
			BREAK
		ENDIF
	NEXT
ENDIF
IF FLAG:70 == 1
ELSE
	IF C
		SOURCE:ARG:露出 += 500 * C
		SOURCE:ARG:屈従 += 200 * C * (SYNCED_ORGASM(ARG) ? 120 # 100) / 100
		;SOURCE:ARG:反感 += 40 * C * (CFLAG:ARG:うふふ ? 1 # 3)
		SOURCE:ARG:Terror += 40 * C * (!TCVAR:ARG:無理矢理 ? 1 # 3) ;terror custom code
		DOWNBASE:ARG:体力 += 20
		DOWNBASE:ARG:気力 += 10
	ENDIF
	IF V
		SOURCE:ARG:欲情 += 800 * V
		SOURCE:ARG:恭順 += 500 * V * (SYNCED_ORGASM(ARG) ? 120 # 100) / 100
		SOURCE:ARG:露出 += 700 * V
		SOURCE:ARG:屈従 += 400 * V * (SYNCED_ORGASM(ARG) ? 120 # 100) / 100
		;SOURCE:ARG:反感 += 80 * V * (CFLAG:ARG:うふふ ? 1 # 3)
		SOURCE:ARG:Terror += 80 * V * (!TCVAR:ARG:無理矢理 ? 1 # 3) ;terror custom code
		DOWNBASE:ARG:体力 += 30
		DOWNBASE:ARG:気力 += 20
	ENDIF
	IF A
		SOURCE:ARG:欲情 += 500 * A
		SOURCE:ARG:恭順 += 700 * A * (SYNCED_ORGASM(ARG) ? 120 # 100) / 100
		SOURCE:ARG:露出 += 900 * A
		SOURCE:ARG:屈従 += 500 * A * (SYNCED_ORGASM(ARG) ? 120 # 100) / 100
		;SOURCE:ARG:反感 += 120 * A * (CFLAG:ARG:うふふ ? 1 # 3)
		SOURCE:ARG:Terror += 120 * A * (!TCVAR:ARG:無理矢理 ? 1 # 3) ;terror custom code

		DOWNBASE:ARG:体力 += 40
		DOWNBASE:ARG:気力 += 20
	ENDIF
	IF B
		SOURCE:ARG:露出 += 500 * B
		SOURCE:ARG:屈従 += 200 * B * (SYNCED_ORGASM(ARG) ? 120 # 100) / 100
		;SOURCE:ARG:反感 += 50 * B * (CFLAG:ARG:うふふ ? 1 # 3)
		SOURCE:ARG:Terror += 50 * B * (!TCVAR:ARG:無理矢理 ? 1 # 3) ;terror custom code
		DOWNBASE:ARG:体力 += 20
		DOWNBASE:ARG:気力 += 10
	ENDIF
	IF M
		SOURCE:ARG:情愛 += 1500 * M * (SYNCED_ORGASM(ARG) ? 120 # 100) / 100
		SOURCE:ARG:恭順 += 1000 * M * (SYNCED_ORGASM(ARG) ? 120 # 100) / 100
		DOWNBASE:ARG:体力 += 10
		DOWNBASE:ARG:気力 += 5
	ENDIF
	IF U
		SOURCE:ARG:露出 += 500 * U
		SOURCE:ARG:屈従 += 200 * U * (SYNCED_ORGASM(ARG) ? 120 # 100) / 100
		;SOURCE:ARG:反感 += 40 * U * (CFLAG:ARG:うふふ ? 1 # 3)
		DOWNBASE:ARG:体力 += 20
		DOWNBASE:ARG:気力 += 10
	ENDIF
	IF MultipleEc == 6
		DOWNBASE:ARG:体力 -= 120
		DOWNBASE:ARG:気力 -= 100
	ELSEIF MultipleEc == 5
		DOWNBASE:ARG:体力 -= 80
		DOWNBASE:ARG:気力 -= 70
	ELSEIF MultipleEc == 4
		DOWNBASE:ARG:体力 -= 40
		DOWNBASE:ARG:気力 -= 30
	ELSEIF MultipleEc == 3
		DOWNBASE:ARG:体力 -= 20
		DOWNBASE:ARG:気力 -= 10
	ENDIF
ENDIF
SIF ARG != MASTER && (CFLAG:ARG:うふふ == 2 || TCVAR:ARG:20) ;addition custom code, characters are less mad if they were the ones to initiate it
	TIMES SOURCE:ARG:反感, 0.5

;NOWEXにデータを入れる（絶頂時口上に使う）
NOWEX:ARG:Ｃ絶頂 = C
NOWEX:ARG:Ｖ絶頂 = V
NOWEX:ARG:Ａ絶頂 = A
NOWEX:ARG:Ｂ絶頂 = B
NOWEX:ARG:Ｍ絶頂 = M
NOWEX:ARG:UOrgasm = U
;絶頂回数を増やす
EX:ARG:Ｃ絶頂 += C
EX:ARG:Ｖ絶頂 += V
EX:ARG:Ａ絶頂 += A
EX:ARG:Ｂ絶頂 += B
EX:ARG:Ｍ絶頂 += M
EX:ARG:UOrgasm += U

IF NOWEX:ARG:Ｖ絶頂 && TCVAR:ARG:破瓜 == 1
	CALL QoL_Info_Write(ARG, Qol_Dates_DeflowerOrgasm) ;qol custom code
	;IF !ADD_ACHIEVEMENT_OBTAINFLAG:Achievement_PainInsight && ARG != MASTER
	IF !SaveAchievementCompleted("insightPain")
		;CALL ANIMATION_ROLL_TEXT( @"Achievement Unlocked：[Pain Insight]!", 0 ) ;addition custom code
		;ADD_ACHIEVEMENT_OBTAINFLAG:Achievement_PainInsight = 1
		CALL AL_NOTIFY_ACHIEVEMENT_COMPLETION("insightPain") ;achievement menu rework custom code
	ENDIF
ENDIF

;custom code, rape expansion
IF TCVAR:ARG:無理矢理 && MultipleEc > -1
	EXP:ARG:FallenRape += MultipleEc+1
	SETBIT FALL_RAPE:ARG:0, 1 
	IF MultipleEc > 1
		SETBIT FALL_RAPE:ARG:0, 2
	ENDIF
ENDIF

;時間停止中もしくは睡眠中なら、無自覚絶頂回数を増やす（ただし、あなたを除く）
IF FLAG:70 > 0 || CFLAG:ARG:睡眠 && ARG
	EX:ARG:無自覚Ｃ絶頂 += C
	EX:ARG:無自覚Ｖ絶頂 += V
	EX:ARG:無自覚Ａ絶頂 += A
	EX:ARG:無自覚Ｂ絶頂 += B
	EX:ARG:無自覚Ｍ絶頂 += M
	EX:ARG:UnawareUOrgasm += U
ENDIF

;絶頂経験を増やす
EXP:ARG:絶頂経験 += 合計絶頂数
Z = TCVAR:ARG:無理矢理 ? 1 # 3
CALLF ChangeEndurance(ARG,"orgasmdeny",(合計絶頂数/Z))

IF TALENT:ARG:行きずり == 1 && 合計絶頂数
	IF ABL:ARG:Ｃ感覚 < 3 && C
		CALL ChangeABL(ARG, "Ｃ感覚", 1)
	ENDIF
	IF ABL:ARG:Ｂ感覚 < 3 && B
		CALL ChangeABL(ARG, "Ｂ感覚", 1)
	ENDIF
	IF ABL:ARG:Ｖ感覚 < 3 && V
		CALL ChangeABL(ARG, "Ｖ感覚", 1)
	ENDIF
	IF ABL:ARG:Ａ感覚 < 3 && A
		CALL ChangeABL(ARG, "Ａ感覚", 1)
	ENDIF
	IF ABL:ARG:Ｍ感覚 < 3 && M
		CALL ChangeABL(ARG, "Ｍ感覚", 1)
	ENDIF
	IF ABL:ARG:USens < 3 && U
		CALL ChangeABL(ARG, "USens", 1)
	ENDIF
	IF MAX(GETPALAMLV(PALAM:欲情,5), 合計絶頂数) > ABL:ARG:欲望 + 1
		CALL ChangeABL(ARG, "欲望", 1)
	ENDIF
ENDIF

;体位別絶頂経験
; IF TEQUIP:ARG:50 > -1
; 	LOCAL:3 = TEQUIP:ARG:体位
; ELSEIF TEQUIP:ARG:51 > -1
; 	LOCAL:3 = TEQUIP:ARG:体位 + 5
; ELSE
; 	LOCAL:3 = 0
; ENDIF
;qol custom code, expanded
LOCAL:3 = QOL_FAV_POSITION_CHECK(ARG)
SIF LOCAL:3
	EXP:ARG:QOL_FAV_POSITION_TO_EXP(LOCAL:3) += 1 ;qol custom code, expanded

;絶頂経験の追加、無自覚のみあなたに加算されない
SIF !SHIRAHU(ARG) && ARG
	EXP:ARG:無自覚絶頂経験 += C + V + A + B + M + U
EXP:ARG:Ｃ絶頂経験 += C
EXP:ARG:Ｖ絶頂経験 += V
EXP:ARG:Ａ絶頂経験 += A
EXP:ARG:Ｂ絶頂経験 += B
EXP:ARG:Ｍ絶頂経験 += M
EXP:ARG:UOrgasm += U

;ビデオ
IF TEQUIP:ARG:28
	IF NOWEX:ARG:8
		LOCALS = O2/O3/O4/
		TSTR:1 += LOCALS
	ENDIF
	IF NOWEX:ARG:7
		LOCALS = O2/O3/
		TSTR:1 += LOCALS
	ENDIF
	IF NOWEX:ARG:6
		LOCALS = O2/
		TSTR:1 += LOCALS
	ENDIF
	IF NOWEX:ARG:0 == 2
		LOCALS = C/C/
		TSTR:1 += LOCALS
	ELSEIF NOWEX:ARG:0 == 1
		LOCALS = C/
		TSTR:1 += LOCALS
	ENDIF
	IF NOWEX:ARG:1 == 2
		LOCALS = V/V/
		TSTR:1 += LOCALS
	ELSEIF NOWEX:ARG:1 == 1
		LOCALS = V/
		TSTR:1 += LOCALS
	ENDIF
	IF NOWEX:ARG:2 == 2
		LOCALS = A/A/
		TSTR:1 += LOCALS
	ELSEIF NOWEX:ARG:2 == 1
		LOCALS = A/
		TSTR:1 += LOCALS
	ENDIF
	IF NOWEX:ARG:3 == 2
		LOCALS = B/B/
		TSTR:1 += LOCALS
	ELSEIF NOWEX:ARG:3 == 1
		LOCALS = B/
		TSTR:1 += LOCALS
	ENDIF
ENDIF

;絶頂時、利尿剤orおもらし癖で漏らす
; superceeded by TARGET_PEE_CHECK
[SKIPSTART]
IF nPee > 0 && MultipleEc > 0 && ( TCVAR:利尿剤 > 0 || TALENT:おもらし癖 > 0 )
	NOWEX:ARG:放尿 = MultipleEc
	EX:ARG:放尿 += MultipleEc
	EXP:ARG:放尿経験 += Multiplier
	;獲得経験値*5 だけ利尿剤の持続時間を短縮
	TCVAR:利尿剤 = MAX( TCVAR:利尿剤 - (Multiplier * 5) , 0)
