    AlcoholResistance:ARG:0 --
    IF ARG == 0
        PRINTFORMW %PARSE(&quot;Your&quot;)% body is now less resiliant to drugs.
    ELSE
        PRINTFORMW %CALLNAME:ARG%'s body is now less resiliant to drugs.
    ENDIF
ENDIF
</nowiki>

