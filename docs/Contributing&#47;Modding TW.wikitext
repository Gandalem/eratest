 <nowiki>
CASE 54; Alcohol Resistance
    LOCALS '= &quot;How strong drugs affect you.\n&quot;
    LOCALS += &quot;Progress towards next stage (addict):\n&quot;
    IF AlcoholResistance:C_ID:0 &gt;= 5
