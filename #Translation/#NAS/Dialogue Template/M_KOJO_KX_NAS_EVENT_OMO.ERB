	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
        SELECTCASE ARG:1
        CASE 0
        CASE 1
        CASE 2
        CASE 3
        CASE 4
        CASE 5
        CASE 6
        CASE 7
        CASE 8
        CASE 9
        CASE 10
        ENDSELECT
		RETURN 1
	ENDIF
ENDIF