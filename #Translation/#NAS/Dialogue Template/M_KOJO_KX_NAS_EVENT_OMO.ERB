;==================================================
;Diarrhea Roulete
;ARG:0 = Scene
;ARG:1 = Item
;==================================================
@M_KOJO_PMONSTERGAME_KX_0(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;--------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Intro
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == -99
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Desperation
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == -80
        IF PeeBarStage(MASTER) > PottyMonsterGame_LastDesp:0
            SELECTCASE PeeBarStage(MASTER)
            CASE 6
            CASE 5
            CASE 4
            ENDSELECT
        ENDIF
        IF PooBarStage(MASTER) > PottyMonsterGame_LastDesp:1
            SELECTCASE PooBarStage(MASTER)
            CASE 6
            CASE 5
            CASE 4
            ENDSELECT
        ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Accident
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == -900

        IF PottyMonsterGame_Stats:4 >= PottyMonsterGame_Stats:6
            SELECTCASE PottyMonsterGame_Stats:4
            CASE IS >= 2600
            CASE IS >= 2000
            CASE IS >= 1500
            CASE IS >= 800
            CASEELSE
            ENDSELECT
        ELSEIF PeeBarStage(MASTER) > PottyMonsterGame_LastDesp:0
            SELECTCASE PottyMonsterGame_Stats:3
            CASE IS >= 2600
            CASE IS >= 2000
            CASE IS >= 1500
            CASE IS >= 1000
            CASE IS >= 800
            CASEELSE
            ENDSELECT
        ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;Bladder Wheel
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
        SELECTCASE ARG:1
        CASE 0,1
        CASE 2
        CASE 3
        CASE 4
        CASE 5
        CASE 6
        CASE 7
        CASE 8
        CASE 9
        ENDSELECT
		RETURN 1
	ENDIF
