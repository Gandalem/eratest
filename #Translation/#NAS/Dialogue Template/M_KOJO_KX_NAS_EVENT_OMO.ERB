;==================================================
;Diaper Checks
;==================================================
@M_KOJO_EVENT_KX_100(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;Clean
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 0
		RETURN 1
	ENDIF


	;-------------------------------------------------
	;Inappropiate Underwear
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		CALLF UnderwearOffPoints(MASTER)
		LOCALS = %RESULTS:1%
		SELECTCASE TOLOWER(LOCALS)
		CASE "pull-up"
		CASE "diaper"
		CASE "thick diaper", "bulky diaper"
		ENDSELECT
		PRINTFORML
		RETURN 1
	ENDIF

	;-------------------------------------------------
	;Wet
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2 
		IF IsPadded(MASTER, "diaper")		
		ELSEIF IsPadded(MASTER, "pull-up")
			SELECTCASE SoiledDiaper(MASTER,1,1)
			CASE IS >= 90
			CASEELSE
			ENDSELECT
		ELSEIF EQUIP:MASTER:6
		ENDIF
		RETURN 1
	ENDIF	

	;-------------------------------------------------
	;Messy
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		$Messy
		IF IsPadded(MASTER, "diaper")
		ELSEIF IsPadded(MASTER, "pull-up")
		ELSE
		ENDIF
		RETURN 1
	ENDIF	

	;-------------------------------------------------
	;Love Juice
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		PRINTFORML
		RETURN 1
	ENDIF	

	;-------------------------------------------------
	;Wet & Messy
	;-------------------------------------------------
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 5	
		PRINTFORML
		RETURN 1
	ENDIF	
	PRINTFORML  
ENDIF
RETURN 1

