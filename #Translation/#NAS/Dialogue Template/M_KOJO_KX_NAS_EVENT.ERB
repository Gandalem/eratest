;==================================================
;Character Dying
;==================================================
@M_KOJO_EVENT_KX_101(ARG,ARG:1)
;TARGET talking to the player
;--------------------------------------------------
;Showing Check=0, Don't show、1, Show）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;Subparts
	;-------------------------------------------------
	;Death by gunshot
	;Showing Check=0, Don't show、1, Show）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORML
		RETURN 1
	ENDIF 

	;-------------------------------------------------
	;Cut to death
	;Showing Check=0, Don't show、1, Show）
