;ARG=banquet_id
;ARGS=scene
@M_KOJO_EVENT_KX_BANQUET(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIMS TERM
#DIM BANQUET_ID
#DIM PRESENT ;check if player is there, only show dialogue if true, but custom code and other settings should still be possible even if player isn't there
PRESENT = IS_HERE(TARGET)
RESULT = 0

TRYCALLFORM M_KOJO_EVENT_KX_BANQUET_{BANQUET_ID}(SCENE,ARG)
SIF RESULT
    RETURN 1

TERM '= TOUPPER(GET_STR(0, "ADD_BANQUET", BANQUET_ID, "CATEGORY"))
TRYCALLFORM M_KOJO_EVENT_KX_BANQUET_TYPE_%TERM%(SCENE,BANQUET_ID,ARG)
SIF RESULT
    RETURN 1

;generic, use with care
SELECTCASE SCENE
    CASE "BANQUET_START"
    CASE "MEET_PLAYER"
    CASE "CHARA_LEAVES"
    CASE "BANQUET_END"
    CASE "IDLE"
ENDSELECT
RETURN 1

;reimu spontaneous party
@M_KOJO_EVENT_KX_BANQUET_1(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
PRESENT = IS_HERE(TARGET)
SELECTCASE SCENE
    CASE "BANQUET_START"
        IF PRESENT
        ENDIF
        RETURN 0 ;return 1 if dialogue is set
    CASE "MEET_PLAYER"
        IF PRESENT
        ENDIF
        RETURN 0
    CASE "CHARA_LEAVES"
    CASE "BANQUET_END"
    CASE "IDLE"
ENDSELECT

;lake party
@M_KOJO_EVENT_KX_BANQUET_22(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
#DIMS SWIMWEAR_NAME
SWIMWEAR_NAME '= TOLOWER(LISTING_TR(GET_STR(TARGET, "衣装セット", CFLAG:基本服装セット, "名前")))
SWIMWEAR_NAME '= REPLACE(SWIMWEAR_NAME, " set", "")

PRESENT = IS_HERE(TARGET)
SELECTCASE SCENE
    CASE "BANQUET_START"
        IF PRESENT
        ENDIF
        RETURN 0
    CASE "MEET_PLAYER"
        IF PRESENT && CFLAG:好感度 >= 1000
        ENDIF
        RETURN 0
    CASE "CHARA_LEAVES"
        RETURN 0
    CASE "BANQUET_END"
        RETURN 0
    CASE "IDLE"
ENDSELECT

;general drinking banquets
@M_KOJO_EVENT_KX_BANQUET_TYPE_BANQUET(SCENE,BANQUET_ID,ARG)
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
PRESENT = IS_HERE(TARGET)
SELECTCASE SCENE
    CASE "BANQUET_START"
        IF PRESENT
        ENDIF
    CASE "MEET_PLAYER"
        IF PRESENT
        ENDIF
    CASE "CHARA_LEAVES"
        IF PRESENT
        ENDIF
    CASE "BANQUET_END"
        IF PRESENT
        ENDIF
    CASE "IDLE"
        IF PRESENT
        ENDIF
ENDSELECT
RETURN 0
