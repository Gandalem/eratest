;custom code
;==================================================
;朝イベント（うふふ）
;==================================================
@M_KOJO_SPEVENT_MESSAGECHECK_KX_4(ARG,ARG:1)
RETURN 0

@M_KOJO_SPEVENT_KX_4(ARG,ARG:1)
;口上主はTARGET
;共通メッセージ出力
;-------------------------------------------------
;フェラ、クンニで起こされる
;記入チェック
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARG == 1
ENDIF

;--------------------------------------------------
;パイズリで起こされる
;記入チェック
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARG == 2
	IF TALENT:恋人 || (TALENT:妄信 && TALENT:MASTER:追加種族 == 4)
	ELSE
	ENDIF
ENDIF

;--------------------------------------------------
;騎乗位、貝合わせ (ARG:1が１の場合、ウフフに突入するか否か回答後の口上)
;記入チェック
LOCAL:1 = 0
;-------------------------------------------------
IF LOCAL:1 && ARG == 3
	;騎乗位、貝合わせ描写
	IF ARG:1 == 0
	;そのままウフフモードに突入するか
	ELSE
		;そのまま押し倒した
		IF TFLAG:193 == 1
        ELSE
		ENDIF
	ENDIF
ENDIF

