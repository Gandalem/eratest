;shows commentary when a player enters one of the options for wedding preparations
@M_KOJO_EVENT_KX_WEDDING_PREPARATIONS(ARGS,ARG,ARG:1)
SELECTCASE ARGS
    CASE "TYPE"
    CASE "SIZE"
    CASE "DATE"
    CASE "GUESTS"
ENDSELECT

;the custom wedding event itself
@M_KOJO_EVENT_KX_CUSTOM_WEDDING(ARGS,ARG,ARG:1)
#DIM DYNAMIC GUEST_COUNT
IF EXISTVAR("WEDDING_GUESTS")
    FOR LOCAL, 0, CHARANUM
        SIF GETVAR(@"WEDDING_GUESTS:{LOCAL}")
            GUEST_COUNT++
    NEXT
ENDIF
;put on outfits (standard wedding dress and suit for this one)
CALL OKIGAE(MASTER, OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "ウェディングスーツセット"))
CALL OKIGAE([[X]], OBJNAME_TO_ID([[X]], "GET", "衣装セット", "ウェディングセット"))

;increase time as needed
TIME += 180
RETURN 1


@M_KOJO_EVENT_KX_WEDDING(ARGS,ARG,ARG:1)
SELECTCASE VARS_OR_DEFAULT("WEDDING_TYPE")
    CASE "WESTERN"
        SELECTCASE ARGS
            CASE "AISLE_WALK"
            CASE "I_DO"
            CASE "KISS"
        ENDSELECT
        RETURN 1
ENDSELECT

@M_KOJO_CHECK_KX_CUSTOM_WEDDING(ARGS,ARG,ARG:1)
SELECTCASE ARGS
    CASE "EXISTS"
        RESULTS = Custom wedding name
        ;if this returns 1, the custom wedding is considered valid
        RETURN 1
    CASE "COST"
        RETURN 1500000
    CASE "LOCATION"
        RETURN P1鳥居
ENDSELECT

@M_KOJO_CHECK_KX_WEDDING_GUESTS(ARGS,ARG,ARG:1)
;fill up RESULT with a list of ids, starting from index 1
;these should be in order of priority, as the wife only gets x amount of forced invites
; RESULT:1 = [[霊夢]]
; RESULT:2 = [[魔理沙]]
RETURN 1

