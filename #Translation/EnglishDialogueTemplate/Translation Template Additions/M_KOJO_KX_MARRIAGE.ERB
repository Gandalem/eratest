;custom dialogue and checks for marriage-related content
@M_KOJO_SUCCESS_CUSTOM_COM_KX_11
TFLAG:192 = 0

@M_KOJO_MESSAGE_CUSTOM_COM_KX_11
IF TFLAG:193 == 0 ;failure
ELSE ;success
