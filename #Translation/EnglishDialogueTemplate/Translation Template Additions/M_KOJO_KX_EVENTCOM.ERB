;triggers on every command before the command itself is processed
@M_KOJO_EVENT_KX_EVENTCOM(ARGS,ARG,ARG:1)
;do whatever
	
;triggers on every command after the command itself is processed, but before other EVENTCOMEND triggers
@M_KOJO_EVENT_KX_EVENTCOMEND_PRI(ARGS,ARG,ARG:1)
;do whatever

;triggers on every command after the command itself is processed
@M_KOJO_EVENT_KX_EVENTCOMEND(ARGS,ARG,ARG:1)
;do whatever

;overlaps with event 31, but does not require the player to have met the character
;clear trailing flags/etc
@M_KOJO_EVENT_KX_AFTERTRAIN_BEGIN(ARGS,ARG,ARG:1)
;do whatever

@M_KOJO_EVENT_KX_AFTERTRAIN_END(ARGS,ARG,ARG:1)
;do whatever

@M_KOJO_EVENT_KX_BEFORETRAIN_END(ARGS,ARG,ARG:1)
;do whatever

;triggers on a new month
@M_KOJO_EVENT_KX_MONTH_CHANGE(ARGS,ARG,ARG:1)
