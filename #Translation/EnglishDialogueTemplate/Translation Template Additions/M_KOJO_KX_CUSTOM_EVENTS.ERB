@M_KOJO_EVENT_KX_STONEBATTLE(ARGS,ARG,ARG:1)
IF ARGS == "beginning"
	PRINTFORMDW 「」
	PRINTFORMW
ELSEIF ARGS == "win"
ELSEIF ARGS == "lose"
ENDIF
RETURN 1

@M_KOJO_EVENT_KX_FAIRY_PRANK(ARGS,ARG,ARG:1)
#DIMS SELECTED_PRANK
#DIM CULPRIT
SELECTCASE ARGS
	CASE "scenarios"
		SELECTCASE RAND:2
			CASE 0
				SELECTED_PRANK = example_name1
			CASE 1
				SELECTED_PRANK = example_name2
		ENDSELECT
		RETURN 2
	CASE "prank"
		CULPRIT = VAR_OR_DEFAULT("Add_CULPRIT")
		SELECTCASE SELECTED_PRANK
			CASE "example_name1"
			CASE "example_name2"
		ENDSELECT
		RETURN 1
	CASE "failure"
		CULPRIT = VAR_OR_DEFAULT("Add_CULPRIT")
		SELECTCASE SELECTED_PRANK
			CASE "example_name1"
			CASE "example_name2"
		ENDSELECT
		RETURN 1
	CASE "punishment"
		RETURN 1
ENDSELECT
